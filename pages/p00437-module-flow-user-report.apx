    region module-flow-user-report-2 (
        name: Module Flow User Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by a.ModuleFlowNo) SerialNo,
                	c.ModuleName,
                	a.ModuleFlowNo,
                	b.ModuleFlowNo AS ParentModuleFlowNo,
                	a.Tno,
                	a.OnPassingOfMODULEFLOWTNO,
                	a.OnGettingOfPassMarks,
                	a.ReboundFailMarks,
                	d.DocumentStatusName,               
                    dsd2.DocumentStatusName as ModuleFlowStatus,
                	bu.BossUserName,
                    emp.EmployeeName,
                    GetEmployeeLocationName(bu.EmployeeCode,trunc(sysdate)) as EmployeeLocation,
                    modf.ModuleFlowNo as OnModuleFlow
                From ModuleFlow a, ModuleFlow b, Module c, DocumentStatus d, DocumentStatusDetail dsd, DocumentStatus dsd2, 
                ModuleFlowUser mfu, BossUser bu, Employee emp, ModuleFlow modf
                Where a.OnPassingOfModuleFlowTNo = b.TNo(+)
                	and a.ModuleCode = c.ModuleCode
                	and a.DocumentStatusCode = d.DocumentStatusCode(+)
                	and a.TNo = dsd.ModuleTNo
                	and dsd.DocumentStatusCode = dsd2.DocumentStatusCode
                	and a.TNo = mfu.TNo
                	and mfu.BossUserCode = bu.BossUserCode
                    ------------------------- --
                    -- 16-nov-2024 
                    and bu.EmployeeCode = emp.EmployeeCode(+)
                    and a.OnPassingOfModuleFlowTno = modf.Tno(+)
                    ------------------------- --
                	--and a.CompanyCode = :p_CompanyCode
                  and ( :P437_COMPANY IS NULL OR instr(':'||:P437_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                --   and :P437_COMPANY = a.CompanyCode
                  and ( :P437_BOSSUSER IS NULL OR instr(':'||:P437_BOSSUSER||':',':'||mfu.BossUserCode||':') > 0 )  
                  and ( :P437_MODULE IS NULL OR instr(':'||:P437_MODULE||':',':'||c.ModuleCode||':') > 0 ) 
                
                ```
            pageItemsToSubmit: [
                P437_COMPANY
                P437_BOSSUSER
                P437_MODULE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
