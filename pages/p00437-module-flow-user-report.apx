    pageItem P437_BOSSUSER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Boss User
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                 Select Distinct
                	b.BossUserName d,
                   b.BossuserCode r
                 From ModuleFlow aa,ModuleFlowUser a, BossUser b
                 Where aa.Tno = a.Tno
                  and a.BossUserCode = b.BossUserCode
                Order by 1
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @module-flow-user-report
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Creator Name
        }
    )

    pageItem P437_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                    a.CompanyName d,
                    a.CompanyCode r
                From Company a
                Where exists
                (Select 
                  b.CompanyCode
                  From ModuleFlow b
                  Where b.CompanyCode = a.CompanyCode)
                Order by 1
                  ;
                ```
        }
        layout {
            sequence: 10
            region: @module-flow-user-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
