                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                 c.ModuleName d,
                 c.ModuleCode r
                From Module c
                Where exists(
                     Select
                        a.ModuleCode 
                       From ModuleFlow a
                       Where a.ModuleCode = c.ModuleCode
                ) 
                Order by 1;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @module-flow-user-report
            slot: regionBody
