    dynamicAction new (
        name: New_1
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P437_NEXTPROCESS
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @module-flow-user-report-2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P437_INDENTNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P437_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P437_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 51257985189782999
        }
        serverSideCondition {
            type: never
        }
    )

)

