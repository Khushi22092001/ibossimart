page 62 (
    name: Salary + OT Summary
    alias: SALARY-OT-SUMMARY
    title: Salary + OT Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region salary-ot-summary (
        name: Salary + OT Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region salary-ot-summary-report (
        name: Salary + OT Summary Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                Select
                     dp.DepartmentCode,
                     RPAD(' . ',(LEVEL-1)*2)||z.DEPARTMENTNAME AS TREE,
                     round(z.SalaryAmount,2) as SalaryAmount,
                     round(z.OTAmount,2) as OTAmount,
                     round(z.TotalSALOTAmount,2) as TotalSALOTAmount,
                     round(z.PMSalaryAmount,2) as PMSalaryAmount,
                     round(z.PMOTAmount,2) as PMOTAmount,
                     round(z.PMTotalSALOTAmount,2) as PMTotalSALOTAmount,
                     z.Difference
                From 
                (Select
                    y.DepartmentCode,
                    GetDepartmentName(y.DepartmentCode) DepartmentName,
                    y.SalaryAmount,
                    y.OTAmount,
                    (y.SalaryAmount + y.OTAmount) as TotalSALOTAmount,
                    y.PMSalaryAmount,
                    y.PMOTAmount,
                    (y.PMSalaryAmount + y.PMOTAmount) as PMTotalSALOTAmount,
                    (y.SalaryAmount + y.OTAmount) - (y.PMSalaryAmount + y.PMOTAmount) as Difference
                From 
                (Select
                      x.DepartmentCode,
                      nvl(sum(x.SalaryAmount),0) as SalaryAmount,
                      nvl(sum(x.OTAmount),0)as OTAmount,
                      nvl(sum(x.PMSalaryAmount),0) as PMSalaryAmount,
                      nvl(sum(x.PMOTAmount),0) as PMOTAmount
                From (
                Select
                      m.DepartmentCode,
                      sum(a.NetEarning) - Sum(a.otamount) as SalaryAmount,
                      sum(a.otamount) as OTAmount,
                      null as PMSalaryAmount,
                      null as PMOTAmount
                From  SalaryEngineDetail a, MyEmployeeInclude m
                where a.SalaryFromDate = :P62_FromDate
                  and a.StaffType != 'HAMAL'
                  and instr(':'||:P62_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P62_LOCATION||':',':'||a.LocationCode||':') > 0
                  and a.EmployeeCode = m.ChildCode
                Group BY m.DepartmentCode
                Union All
                Select
                      m.DepartmentCode,
                	  Null As SalaryAmount,
                	  Null As OTamount,
                      sum(a.NetEarning) - nvl(Sum(a.otamount),0) as PMSalaryAmount,
                      sum(a.otamount) as PMOTAmount
                From  SalaryEngineDetail a, MyEmployeeInclude m
                where a.SalaryFromDate = add_months(to_date(:P62_FromDate,'DD-Mon-RRRR'),- 1 )
                  and a.StaffType != 'HAMAL'
                  and instr(':'||:P62_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P62_LOCATION||':',':'||a.LocationCode||':') > 0
                  and a.EmployeeCode = m.ChildCode
                Group BY m.DepartmentCode)x
                Group by x.DepartmentCode
                )y
                )z, Department dp
                Where z.DepartmentCode = dp.DepartmentCode
                Start with dp.ParentCode is null
                Connect by Prior dp.DepartmentCode = dp.ParentCode
                
                
                
                
                /*Select
                     dp.DepartmentCode,
                     RPAD(' . ',(LEVEL-1)*2)||z.DEPARTMENTNAME AS TREE,
                     z.SalaryAmount ,
                     z.OTAmount,
                     z.TotalSALOTAmount,
                     z.PMSalaryAmount,
                     z.PMOTAmount,
                     z.PMTotalSALOTAmount,
                     z.Difference
                From 
                (Select
                    y.DepartmentCode,
                    GetDepartmentName(y.DepartmentCode) DepartmentName,
                    y.SalaryAmount,
                    y.OTAmount,
                    (y.SalaryAmount + y.OTAmount) as TotalSALOTAmount,
                    y.PMSalaryAmount,
                    y.PMOTAmount,
                    (y.PMSalaryAmount + y.PMOTAmount) as PMTotalSALOTAmount,
                    (y.SalaryAmount + y.OTAmount) - (y.PMSalaryAmount + y.PMOTAmount) as Difference
                From 
                (Select
                      x.DepartmentCode,
                      nvl(sum(x.SalaryAmount),0) as SalaryAmount,
                      nvl(sum(x.OTAmount),0)as OTAmount,
                      nvl(sum(x.PMSalaryAmount),0) as PMSalaryAmount,
                      nvl(sum(x.PMOTAmount),0) as PMOTAmount
                From (
                Select
                      m.DepartmentCode,
                      sum(a.NetEarning) as SalaryAmount,
                      null as OTAmount,
                      null as PMSalaryAmount,
                      null as PMOTAmount
                From  SalaryEngineDetail a, MyEmployeeInclude m
                where a.SalaryFromDate = :P62_FromDate
                  and a.StaffType != 'HAMAL'
                  and instr(':'||:P62_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P62_LOCATION||':',':'||a.LocationCode||':') > 0
                  and a.EmployeeCode = m.ChildCode
                Group BY m.DepartmentCode
                Union All
                Select
                      n.DepartmentCode,
                      null as SalaryAmount,
                      sum(b.NetAmount) as OTAmount,
                      null as PMSalaryAmount,
                      null as PMOTAmount
                From OTEngineDetail b, MyEmployeeInclude n
                Where b.FromDate = :P62_FromDate
                  and instr(':'||:P62_COMPANY||':',':'||b.CompanyCode||':') > 0
                  and instr(':'||:P62_LOCATION||':',':'||b.LocationCode||':') > 0
                  and b.EmployeeCode = n.ChildCode
                Group BY n.DepartmentCode
                Union All
                Select
                      o.DepartmentCode,
                      null as SalaryAmount,
                      null as OTAmount,
                      sum(c.NetEarning) as PMSalaryAmount,
                      null as PMOTAmount
                From  SalaryEngineDetail c, MyEmployeeInclude o
                where To_Char(c.SalaryFromDate,'MON-YYYY') in (Select To_Char(xx.SalaryFromDate -12 ,'MON-YYYY') From SalaryEngineDetail xx Where xx.SalaryFromDate = :P62_FromDate)
                  and c.StaffType != 'HAMAL'
                  and instr(':'||:P62_COMPANY||':',':'||c.CompanyCode||':') > 0
                  and instr(':'||:P62_LOCATION||':',':'||c.LocationCode||':') > 0
                  and c.EmployeeCode = o.ChildCode
                Group BY o.DepartmentCode
                Union All
                Select
                      p.DepartmentCode,
                      null as SalaryAmount,
                      null as OTAmount,
                      null as PMSalaryAmount,
                      sum(d.NetAmount) as PMOTAmount
                From OTEngineDetail d, MyEmployeeInclude p
                Where To_Char(d.FromDate,'MON-YYYY') in (Select To_Char(xx.FromDate -12 ,'MON-YYYY') From OTEngineDetail xx Where xx.FromDate = :P62_FromDate)
                  and instr(':'||:P62_COMPANY||':',':'||d.CompanyCode||':') > 0
                  and instr(':'||:P62_LOCATION||':',':'||d.LocationCode||':') > 0
                  and d.EmployeeCode = p.ChildCode
                Group BY p.DepartmentCode
                )x
                Group by x.DepartmentCode
                )y
                )z, Department dp
                Where z.DepartmentCode = dp.DepartmentCode
                Start with dp.ParentCode is null
                Connect by Prior dp.DepartmentCode = dp.ParentCode
                */
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
