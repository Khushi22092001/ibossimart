    region related-documents (
        name: Related Documents
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* The document trail this ERP actually records. There is no approval
                   workflow stored against an issue (DocumentStatusCode is unpopulated),
                   so this lists the real linked documents and their dates instead of
                   inventing approval steps. */
                Select 'Requisition'                            As DOCUMENT,
                       nvl(r.RequisitionNo,'(unnumbered)')      As DOCUMENT_NO,
                       to_char(r.RequisitionDate,'DD-MM-RRRR')  As DOCUMENT_DATE,
                       nvl(dp.DepartmentName,'-')               As CONTEXT,
                       r.Tno                                    As REQTNO,
                       10                                       As SRT
                  From Issue i
                  Join Requisition r     On r.Tno = i.RequisitionTno
                  Left Join Department dp On dp.DepartmentCode = r.DepartmentCode
                 Where i.Tno = :P686_ISSUETNO
                Union All
                Select 'Issue', nvl(i.IssueNo,'(unnumbered)'), to_char(i.IssueDate,'DD-MM-RRRR'),
                       'Created by '||nvl(i.Creator,'-'), Null, 20
                  From Issue i Where i.Tno = :P686_ISSUETNO
                Union All
                Select 'Issue Return', nvl(ir.IssueReturnNo,'(unnumbered)'),
                       to_char(ir.IssueReturnDate,'DD-MM-RRRR'), 'Material returned to store', Null, 30
                  From IssueReturn ir Where ir.IssueTno = :P686_ISSUETNO
                 Order By 6, 3
                ```
            pageItemsToSubmit: P686_ISSUETNO
        }
        layout {
            sequence: 35
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-register
                ds-dense
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P686_ISSUETNO
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column CONTEXT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Context
            }
            layout {
                sequence: 40
            }
        )

        column DOCUMENT (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Document
            }
            layout {
                sequence: 10
            }
        )

        column DOCUMENT_DATE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Date
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column DOCUMENT_NO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Number
            }
            layout {
                sequence: 20
            }
        )

        column REQTNO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: link
            heading {
                heading: Open
                alignment: center
            }
            layout {
                sequence: 50
            }
            link {
                target: {
                    page: 687
                    items: {
                        P687_REQTNO: #REQTNO#
                    }
                    clearCache: 687
                }
                linkText: <span class="fa fa-external-link" aria-hidden="true"></span>
            }
        )

        column SRT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Sort
            }
            layout {
                sequence: 60
            }
            serverSideCondition {
                type: never
            }
        )

    )

