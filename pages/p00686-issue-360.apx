    region issue-lines (
        name: Issue Lines
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.SNo                                     As SNO,
                       a.SerialNo                                As SERIALNO,
                       a.ItemCode                                As ITEMCODE,
                       nvl(a.ItemName, a.ItemCode)               As ITEMNAME,
                       nvl(sp.ItemSpecificationName,'-')         As SPECIFICATION,
                       nvl(a.Description,'-')                    As DESCRIPTION,
                       nvl(i.MeasuringUnitCode1,'-')             As UOM,
                       Round(nvl(a.Quantity1,0),3)               As QUANTITY,
                       Round(nvl(a.Rate,0),2)                    As RATE,
                       Round(nvl(a.Amount,0),2)                  As AMOUNT,
                       Round(nvl(a.IssueReturnQuantity1,0),3)    As RETURN_QTY,
                       Round(nvl(a.NetAmount,0),2)               As NET_AMOUNT,
                       nvl(a.CostCentreName,'-')                 As COST_CENTRE,
                       nvl(a.DepartmentName,'-')                 As DEPARTMENT,
                       nvl(a.IssueToEmployee,'-')                As ISSUED_TO,
                       nvl(a.GRNNo,'-')                          As SOURCE_GRN
                  From IssueRegister a
                  Left Join Item i               On i.ItemCode = a.ItemCode
                  Left Join ItemSpecification sp On sp.ItemSpecificationCode = a.ItemSpecificationCode
                 Where a.Tno = :P686_ISSUETNO
                 Order By a.SNo
                ```
            pageItemsToSubmit: P686_ISSUETNO
        }
        layout {
            sequence: 20
            slot: body
        }
