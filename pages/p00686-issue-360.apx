    region finder-header (
        name: Issue 360
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-store-head">
                  <div class="ds-store-eyebrow">Store &middot; Material Issue</div>
                  <h1 class="ds-store-title">Issue 360</h1>
                  <div class="ds-store-sub">Find a material issue on the filters below, then open it to see the whole document &mdash; lines, cost centres, the stock layers it consumed and the requisition it fulfils.</div>
                </div>
                ```
        }
