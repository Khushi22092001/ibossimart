    region issue-finder (
        name: Matching Issues
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* The finder that makes this page usable on its own. Reached with no
                   P686_ISSUETNO, it lists the issue DOCUMENTS the filters match;
                   picking one sets P686_ISSUETNO and the page becomes the document
                   view it has always been.
                
                   GRAIN. IssueRegister is one row per issue LINE, so the filters are
                   applied at line level and then rolled up to the document. A document
                   therefore qualifies when ANY of its lines match the Item or
                   Specification filter - and the amounts shown are the WHOLE
                   document's, not just the matching lines'. Showing part of a document
                   under its own issue number would misstate it, so the Lines column
                   also reports how many of its lines matched.
                
                   COST CENTRE. Verified on 11-08-2026: 21 documents draw against more
                   than one cost centre, while department, employee, location and
                   company never vary within a document. A Max() would silently pick one
                   of them, so a multi-cost-centre document says so instead.
                
                   PANEL is not on the IssueRegister view. It lives on Issue.Panel, and
                   every IssueRegister row has a matching Issue row (checked: zero
                   orphans), so the scalar subquery below neither drops nor duplicates
                   a row. Same shape page 680 uses. */
                With F As (
                  Select a.Tno, a.IssueNo, a.IssueDate, a.CompanyCode, a.LocationCode,
                         a.LocationName, a.DocTypeName, a.CostCentreName,
                         a.DepartmentName, a.IssueToEmployee, a.RequisitionNo,
                         Case When (:P686_ITEM Is Null Or a.ItemCode = :P686_ITEM)
                               And (:P686_ITEMSPEC Is Null Or a.ItemSpecificationCode = :P686_ITEMSPEC)
                              Then 1 Else 0 End Matched
                    From IssueRegister a
                   /* Null-tolerant on purpose, even though both dates are marked
                      required on the filter bar. Arriving from page 684, 687 or 688
                      the link does clearCache 686, so every filter item is empty and
                      the filter bar is not rendered at all - its defaults cannot be
                      relied on having run. A bare >= against a null date returns
                      nothing, so "Choose another issue" would land on an empty list.
                      Treating an empty date as "no lower bound" shows the whole
                      register instead, which is the honest reading of an unset
                      filter. */
                   Where (:P686_FROMDATE Is Null
                          Or a.IssueDate >= to_date(:P686_FROMDATE,'DD-MM-RRRR'))
                     And (:P686_TODATE Is Null
                          Or a.IssueDate <  to_date(:P686_TODATE,'DD-MM-RRRR') + 1)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno)
                             = (Select GetUserPanelAB_apex() From dual))
                     And (:P686_PANEL Is Null
                          Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P686_PANEL)
                     And (:P686_COMPANY    Is Null Or a.CompanyCode    = :P686_COMPANY)
                     And (:P686_LOCATION   Is Null Or a.LocationCode   = :P686_LOCATION)
                     And (:P686_EMPLOYEE   Is Null Or a.IssueToEmployee = :P686_EMPLOYEE)
                     And (:P686_COSTCENTRE Is Null Or a.CostCentreCode = :P686_COSTCENTRE)
                     And (:P686_DEPARTMENT Is Null Or a.DepartmentCode = :P686_DEPARTMENT)),
                     D As (
                  Select Tno,
                         Max(IssueNo)         IssueNo,
                         Max(IssueDate)       IssueDate,
                         Max(DocTypeName)     DocTypeName,
                         Max(LocationName)    LocationName,
                         Max(DepartmentName)  DepartmentName,
                         Max(IssueToEmployee) Emp,
                         Max(RequisitionNo)   RequisitionNo,
                         Count(*)             Lines,
                         Sum(Matched)         MatchedLines,
                         Count(Distinct CostCentreName) Ccn,
                         Max(CostCentreName)  CostCentre
                    From F
                   Group By Tno
                  Having Sum(Matched) > 0)
                Select d.Tno                                       As TNO,
                       d.IssueNo                                   As ISSUE_NO,
                       d.IssueDate                                 As ISSUE_DATE,
                       d.DocTypeName                               As DOC_TYPE,
                       d.LocationName                              As LOCATION,
                       Case When d.Ccn > 1
                            Then d.Ccn || ' cost centres'
                            Else d.CostCentre End                  As COST_CENTRE,
                       d.DepartmentName                            As DEPARTMENT,
                       d.Emp                                       As EMPLOYEE,
                       d.RequisitionNo                             As REQUISITION_NO,
                       d.Lines                                     As LINES,
                       Case When d.MatchedLines < d.Lines
                            Then d.MatchedLines || ' of ' || d.Lines
                            Else 'all' End                         As LINES_MATCHED,
                       Round(t.Amount,2)                           As AMOUNT,
                       Round(t.NetAmount,2)                        As NET_AMOUNT
                  From D d
                  Join (Select Tno, Sum(Amount) Amount, Sum(NetAmount) NetAmount
                          From IssueRegister Group By Tno) t On t.Tno = d.Tno
                 Order By d.IssueDate Desc, d.IssueNo Desc
                ```
            pageItemsToSubmit: [
                P686_FROMDATE
                P686_TODATE
                P686_COMPANY
                P686_LOCATION
                P686_PANEL
                P686_ITEM
                P686_ITEMSPEC
                P686_EMPLOYEE
                P686_COSTCENTRE
                P686_DEPARTMENT
            ]
        }
        layout {
            sequence: 8
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        serverSideCondition {
            type: itemIsNull
            item: P686_ISSUETNO
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No material issue matches these filters. Widen the dates, or clear a filter in More Filters.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        advanced {
            savedReportMappingIdentifier: 31357198930505283
        }

