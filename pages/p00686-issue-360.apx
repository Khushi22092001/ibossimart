    region kpi-strip (
        name: Issue Totals
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Totals are taken from IssueRegister so this document agrees exactly
                   with the Issue Register report. NetAmount is already Amount less
                   IssueReturnAmount inside the view. */
                With A As (
                  Select Count(*) Lines,
                         Count(Distinct a.ItemCode) Items,
                         nvl(Sum(a.Quantity1),0) Qty,
                         nvl(Sum(a.Amount),0) Amt,
                         nvl(Sum(a.NetAmount),0) Net,
                         nvl(Sum(a.IssueReturnQuantity1),0) RetQty
                    From IssueRegister a Where a.Tno = :P686_ISSUETNO)
                Select '<div class="ds-kpi ds-kpi--value" title="Sum of IssueRegister.Amount for this document">'
                    || '<span class="ds-kpi-ic fa fa-inr"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">ISSUE VALUE</div><div class="ds-kpi-n">&#8377;'
                    || Case When a.Amt >= 10000000 Then to_char(a.Amt/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When a.Amt >= 100000   Then to_char(a.Amt/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(a.Amt,'FM99G99G990D00') End || '</div>'
                    || '<div class="ds-kpi-sub">Gross value before returns</div>'
                    || '</div></div>' As KPI1,
                
                       '<div class="ds-kpi ds-kpi--cap" title="Amount less IssueReturnAmount - the value actually consumed">'
                    || '<span class="ds-kpi-ic fa fa-exchange"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">NET CONSUMPTION</div><div class="ds-kpi-n">&#8377;'
                    || Case When a.Net >= 10000000 Then to_char(a.Net/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When a.Net >= 100000   Then to_char(a.Net/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(a.Net,'FM99G99G990D00') End || '</div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When a.Amt > 0 And a.Amt <> a.Net
                              Then to_char((a.Amt-a.Net)/a.Amt*100,'FM990D0')||'% returned'
                              Else 'Nothing returned' End||'</div>'
                    || '</div></div>' As KPI2,
                
                       '<div class="ds-kpi ds-kpi--bill" title="Number of item lines on this issue">'
                    || '<span class="ds-kpi-ic fa fa-list-ol"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">LINES</div><div class="ds-kpi-n">'
                    || to_char(a.Lines,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.Items,'FM999G990')||' distinct items</div>'
                    || '</div></div>' As KPI3,
                
                       '<div class="ds-kpi ds-kpi--input" title="Total issued quantity in primary unit of measure">'
                    || '<span class="ds-kpi-ic fa fa-cubes"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">QUANTITY ISSUED</div><div class="ds-kpi-n">'
                    || to_char(a.Qty,'FM999G999G990D000') || '</div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When a.RetQty > 0 Then to_char(a.RetQty,'FM999G999G990D000')||' returned'
                              Else 'No return recorded' End||'</div>'
                    || '</div></div>' As KPI4
                From A a
                ```
            pageItemsToSubmit: P686_ISSUETNO
        }
        layout {
