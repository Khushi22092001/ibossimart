    region stock-drawn (
        name: Stock Layers Consumed
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* UsedStock rows booked by this issue, joined back to the layer they
                   drew from. This is the audit trail from the issue to the original
                   receipt - the same join the IssueRegister view uses to value a line. */
                Select u.ModuleSNo                             As LINE_SNO,
                       s.ItemCode                              As ITEMCODE,
                       nvl(i.ItemName, s.ItemCode)             As ITEMNAME,
                       to_char(s.StockDate,'DD-MM-RRRR')       As RECEIVED_ON,
                       nvl(s.StockModuleCode,'-')              As RECEIVED_VIA,
                       nvl(sl.StorageLocationName, nvl(s.StorageLocationCode,'-')) As STORAGE_LOCATION,
                       nvl(s.LotNo,'-')                        As LOTNO,
                       Round(nvl(u.UsedStockQuantity1,0),3)    As DRAWN_QTY,
                       Round(nvl(s.Rate,0),2)                  As LAYER_RATE,
                       Round(nvl(u.UsedStockQuantity1,0)*nvl(s.Rate,0),2) As DRAWN_VALUE,
                       to_char(u.UsedStockDate,'DD-MM-RRRR')   As DRAWN_ON
                  From UsedStock u
                  Join Stock s                 On s.Tno = u.StockTno
                  Left Join Item i             On i.ItemCode = s.ItemCode
                  Left Join StorageLocation sl On sl.StorageLocationCode = s.StorageLocationCode
                 Where u.ModuleCode = 'ISSUE'
                   And u.ModuleTno  = :P686_ISSUETNO
                 Order By u.ModuleSNo, s.StockDate
                ```
            pageItemsToSubmit: P686_ISSUETNO
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-register
                ds-dense
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P686_ISSUETNO
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column DRAWN_ON (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Drawn On
                alignment: center
            }
            layout {
                sequence: 110
            }
        )

        column DRAWN_QTY (
