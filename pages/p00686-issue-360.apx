page 686 (
    name: Issue 360
    alias: ISSUE-360
    title: Issue 360
    pageGroup: @store-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Document level view of a single material issue, reached from the Store Command Centre (page 684) or the Material Issue Command Centre. P686_ISSUETNO is the Issue.Tno of the document. Values come from the IssueRegister view so they agree line for line with the Issue Register report - Amount is the gross issue value and NetAmount is Amount less IssueReturnAmount. Note that IssueDetail.DocumentStatusCode is not populated in this database, so no approval status is shown; the document trail is built from the timestamps that do exist (requisition date, issue date, creation time) rather than from an approval workflow that the ERP does not record.
    }

    region command-header (
        name: Issue Document
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-store-head">'
                    || '<div class="ds-store-eyebrow">Store &middot; Material Issue Document</div>'
                    || '<h1 class="ds-store-title">Issue '
                    || apex_escape.html(nvl(i.IssueNo,'(unnumbered)')) || '</h1>'
                    || '<div class="ds-store-sub">Complete issue record with lines, cost centres, source receipts and the requisition it fulfils</div>'
                    || '<div class="ds-store-context">'
                    || '<span class="ds-store-chip"><span class="fa fa-calendar"></span>Issue Date <b>'
                       || to_char(i.IssueDate,'DD-MM-RRRR') || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl(c.CompanyName, i.CompanyCode)) || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl(l.LocationName, i.LocationCode)) || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-file-text-o"></span>Doc Type <b>'
                       || apex_escape.html(nvl(i.DocTypeCode,'-')) || '</b></span>'
                    || Case When d.DepartmentName Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-sitemap"></span>Department <b>'
                            || apex_escape.html(d.DepartmentName) || '</b></span>' End
                    || Case When r.RequisitionNo Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-list-alt"></span>Requisition <b>'
                            || apex_escape.html(r.RequisitionNo) || '</b></span>' End
                    || '<span class="ds-store-chip"><span class="fa fa-user"></span>Raised By <b>'
                       || apex_escape.html(nvl(i.Creator,'-')) || '</b></span>'
                    || Case When i.LotNo Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-barcode"></span>Lot <b>'
                            || apex_escape.html(i.LotNo) || '</b></span>' End
                    || '<span class="ds-store-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || apex_escape.html(nvl(i.Panel,'-')) || '</b></span>'
                    || Case When i.Remark Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-comment-o"></span>Remark <b>'
                            || apex_escape.html(i.Remark) || '</b></span>' End
                    || '</div></div>' As HEAD
                  From Issue i
                  Left Join Company c     On c.CompanyCode     = i.CompanyCode
                  Left Join Location l    On l.LocationCode    = i.LocationCode
                  Left Join Requisition r On r.Tno             = i.RequisitionTno
                  Left Join Department d  On d.DepartmentCode  = r.DepartmentCode
                 Where i.Tno = :P686_ISSUETNO
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or i.Panel = (Select GetUserPanelAB_apex() From dual))
                ```
            pageItemsToSubmit: P686_ISSUETNO
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-store-headregion
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P686_ISSUETNO
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

