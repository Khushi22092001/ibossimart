            label: Item
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nvl(i.ItemName, a.ItemCode) d, a.ItemCode r
                  From IssueRegister a
                  Left Join Item i On i.ItemCode = a.ItemCode
                 Where a.ItemCode Is Not Null
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno)
                           = (Select GetUserPanelAB_apex() From dual))
                 Group By a.ItemCode, i.ItemName
                 Order By 1
                ```
