page 301 (
    name: Truck Wise Diesel Report
    alias: TRUCK-WISE-DIESEL-REPORT
    title: Truck Wise Diesel Report
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region truck-wise-diesel-report (
        name: Truck Wise Diesel Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by x.DriverName) SerialNo,
                   x.Transportercode,
                   x.TransporterName, 
                   x.VehicleNo,
                   x.VehicleTypeName,
                   x.VehicleTYpeCode,
                   x.DriverCode,
                   x.DriverName,
                   x.TransportAreaCode,
                   x.TransportAreaName,
                   sum(x.Quantity1) as Quantity1,
                   sum(x.NoOfTrip) as NoOfTrip,
                   round(sum(x.AverageTrip) / count(x.Tno), 2) as AverageTrip,
                   Round(sum(x.Amount),2) as Amounts, 
                   Round(sum(x.Amount) / sum(x.Quantity1),2) as Rate 
                From 
                   (Select
                          a.Tno,
                          a.CompanyCode,
                          a.LocationCode,
                          a.TransporterCode,
                          a.NecessitySlipNo,
                          a.NecessitySlipDate,
                          a.EquipmentId as VehicleNo,
                          vt.VehicleTypeName,
                          v.VehicleTYpeCode,
                          a.DriverCode,
                          a.DriverName,
                          v.TransportAreaCode,
                          ta.TransportAreaName,
                          b.Quantity1,
                          Case When b.Amount is not null then b.Amount
                          When d.Amount is not null then d.Amount
                          Else c.Amount end as Amount,
                          a.NoOfTrip,
                          ts.TransporterName,
                          Case 
                            When a.NoOfTrip = 0 Then
                              a.NoOfTrip
                            Else
                          Round((b.Quantity1/a.NoOfTrip),2)
                          End as AverageTrip
                   From NecessitySlip a , NecessitySlipDetail b,Transporter ts, CompanyVehicle v ,Vehicletype vt, TransportArea ta,
                   (
                    Select
                        a.ModuleTno,
                        c.Amount
                    From Issue a,Voucher b, VoucherDetail c
                    Where a.Tno = b.ModuleTno
                      and b.tno = c.tno
                      and a.CompanyCode = b.CompanyCode
                      and c.Amount > 0) c,
                   (
                    Select
                          a.ModuleTno,
                          b.Amount
                    From Voucher a, VoucherDetail b
                    Where a.Tno = b.Tno
                      and b.Amount > 0) d
                    where a.tno = b.tno(+)
                      and a.TransporterCode = ts.TransporterCode(+)
                      and a.Tno = c.ModuleTno(+)
                      and a.Tno = d.ModuleTno(+)
                      and a.necessitySlipNo is not null
                      and b.VehicleNecessityCode = 'DIESEL'
                      and a.EquipmentId = v.CompanyVehicleNo
                      and v.VehicleTypeCode = vt.VehicleTypeCode
                      and v.TransportAreaCode = ta.TransportAreaCode(+)
                     ) x
                Where x.NecessitySlipDate Between :P301_FROMDATE and :P301_TODATE
                   and ( :P301_VEHICLETYPE IS NULL OR instr(':'||:P301_VEHICLETYPE||':',':'||x.VehicleTypeCode||':') > 0 )
                   and ( :P301_COMPANY IS NULL OR instr(':'||:P301_COMPANY||':',':'||x.CompanyCode||':') > 0 )
                   and ( :P301_VEHICLE IS NULL OR instr(':'||:P301_VEHICLE||':',':'||x.VehicleNo||':') > 0 )
                   and ( :P301_DRIVER IS NULL OR instr(':'||:P301_DRIVER||':',':'||x.DriverCode||':') > 0 ) 
                   and ( :P301_LOCATION IS NULL OR instr(':'||:P301_lOCATION||':',':'||x.LocationCode||':') > 0 )
                   and ( :P301_TRANSPORTER IS NULL OR instr(':'||:P301_TRANSPORTER||':',':'||x.TransporterCode||':') > 0 )
                   and ( :P301_TRANSPORTAREA IS NULL OR instr(':'||:P301_TRANSPORTAREA||':',':'||x.TransportAreaCode||':') > 0 )
                Group by
                   x.Transportercode,
                   x.TransporterName,
                   x.VehicleNo,
                   x.VehicleTypeName,
                   x.VehicleTYpeCode,
                   x.DriverCode,
                   x.DriverName,
                   x.TransportAreaCode,
                   x.TransportAreaName
                ```
        }
        layout {
            sequence: 110
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 18741452881068339
        }

        column AMOUNTS (
            type: plainText
            heading {
                heading: " Diesel Amount"
