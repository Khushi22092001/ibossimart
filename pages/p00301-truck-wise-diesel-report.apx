        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    distinct c.VehicleTypeName d , 
                    c.VehicleTypeCode r  
                from CompanyVehicle a, NecessitySlip b , VehicleType c
                where a.COMPANYVEHICLENO = b.EQUIPMENTID
                  and a.VehicleTypeCode = c.VehicleTypeCode
                ```
            nullDisplayValue: -Select-
