page 365 (
    name: Bank Balance Details
    alias: BANK-BALANCE-DETAILS
    title: Bank Balance Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/Bank Balance Details.xdo';
              var outputFormat = 'pdf';
              var asonDate = new Date($('#P365_ASONDATE').val());
            
            var reportParams =  
                  '&P365_ASONDATE=' +$('#P365_ASONDATE').val() + 
                  '&P365_COMPANY=' +$('#P365_COMPANY').val() +
                  '&P365_ACCOUNT=' +$('#P365_ACCOUNT').val() +
                  '&P365_ACCOUNTGROUP=' +$('#P365_ACCOUNTGROUP').val()
                  ;
             
                  
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              var reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bank-balance-detail (
        name: Bank Balance Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.PartyCode) SerialNo, 
                d.CompanyName,
                b.PartyName as AccountGroupName,
                a.PartyName as AccountName,
                round(decode(GetAccountClosing(a.PartyCode, :P365_ASONDATE, null, c.CompanyCode) - abs(GetAccountClosing(a.PartyCode, :P365_ASONDATE, null, c.CompanyCode)), 0, null, abs(GetAccountClosing(a.PartyCode, :P365_ASONDATE, null, c.CompanyCode))), 2) as DRBalance,
                round(decode(GetAccountClosing(a.PartyCode, :P365_ASONDATE, null, c.CompanyCode) - abs(GetAccountClosing(a.PartyCode, :P365_ASONDATE, null, c.CompanyCode)), 0, GetAccountClosing(a.PartyCode, :P365_ASONDATE, null, c.CompanyCode), null), 2) as CRBalance
                From Party a, party b, PartyCompany c, Company d
                Where a.ParentCode = b.PartyCode(+)
                and a.Tno = c.Tno(+)
                and c.CompanyCode = d.CompanyCode(+)
                --and nvl(a.IsCompanyAccount, 'NO') = 'YES'
                and a.ParentCode in ('BANKACCOUNTS','BANKODACCOUNTS')
                and :P365_ASONDATE = NVL(:P365_ASONDATE,TRUNC(SYSDATE))
                and ( :P365_COMPANY IS NULL OR instr(':'||:P365_COMPANY||':',':'||c.CompanyCode||':') > 0)
                and ( :P365_ACCOUNTGROUP IS NULL OR instr(':'||:P365_ACCOUNTGROUP||':',':'||a.ParentCode||':') > 0)
                and ( :P365_ACCOUNT IS NULL OR instr(':'||:P365_ACCOUNT||':',':'||a.PartyCode||':') > 0)
                and :P365_ASONDATE is not null
                --and b.PartyName !='BRANCH & DIVISIONS'
                and abs(GetAccountClosing(a.PartyCode, :P365_ASONDATE, null, c.CompanyCode)) > 0
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 95486178589674108
        }

        column ACCOUNTGROUPNAME (
            type: plainText
            heading {
                heading: Account Group Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column ACCOUNTNAME (
            type: plainText
            heading {
                heading: Account Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COMPANYNAME (
            type: plainText
            heading {
                heading: Company Name
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column CRBALANCE (
            type: plainText
            heading {
                heading: CR Balance
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column DRBALANCE (
            type: plainText
            heading {
                heading: DR Balance
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            size: a4
            units: centimeters
            width: 310
            height: 220
            borderWidth: 1
            borderColor: #030304
        }
        pageHeader {
            font: times
            fontWeight: bold
            fontSize: 14
            pageHeaderText: "     Bank Balance Report"
        }
        columnHeadings {
            fontSize: 12
            backgroundColor: #f4f284
        }
        columns {
            fontSize: 11
        }

        savedReport 956554 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTGROUPNAME (
                sequence: 2
            )

            displayColumn ACCOUNTNAME (
                sequence: 3
            )

            displayColumn COMPANYNAME (
                sequence: 1
            )

            displayColumn CRBALANCE (
                sequence: 5
            )

            displayColumn DRBALANCE (
                sequence: 4
            )

            sort (
                column: ACCOUNTGROUPNAME
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: DRBALANCE
            )

            aggregate (
                column: CRBALANCE
            )

            controlBreak (
                column: COMPANYNAME
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P365_ACCOUNT (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Account Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                DISTINCT
                a.PartyName d,
                a.PartyCode r
                From Party a
                 WHERE A.PARENTCODE IN ('BANKACCOUNTS','BANKODACCOUNTS')
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @bank-balance-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P365_ACCOUNTGROUP (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Account Group Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                b.PartyName d,
                b.PartyCode r
                From Party a,  Party b
                Where a.ParentCode = b.PartyCode
                and a.ParentCode in ('BANKACCOUNTS','BANKODACCOUNTS')
                Order by 1
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @bank-balance-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P365_ASONDATE (
        type: datePicker
        label {
            label: As On Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @bank-balance-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P365_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: "Company "
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.CompanyName d,
                a.CompanyCode r
                From Company a
                Where exists(
                   Select
                      aa.CompanyCode
                   From Party b, PartyCompany aa
                   Where b.Tno =  aa.Tno
                   and aa.CompanyCode = a.CompanyCode
                )
                Order by 1
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @bank-balance-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 70
            region: @bank-balance-detail
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction generate-pdf (
        name: Generate Pdf
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

