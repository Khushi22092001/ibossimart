            displayColumn EQUIPMENTNAME (
                sequence: 1
            )

            displayColumn STARTINGHMR (
                sequence: 6
            )

            displayColumn TOTALAVAILABILITYHRS (
                sequence: 7
            )

            displayColumn TOTALRUNNINGHRS (
                sequence: 8
            )

            displayColumn UTILIZATIONPERCENTAGE (
                sequence: 9
            )

        )

    )

    pageItem P250_EQUIPMENTCATEGORY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Equipment Category
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                A.EQUIPMENTCATEGORYNAME D,
                A.EQUIPMENTCATEGORYCODE R
                FROM EQUIPMENTCATEGORY A,EQUIPMENT B
                WHERE A.EQUIPMENTCATEGORYCODE = B.EQUIPMENTCATEGORYCODE
                ```
        }
        layout {
            sequence: 40
            region: @monthavailabilityreport-discarded
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

