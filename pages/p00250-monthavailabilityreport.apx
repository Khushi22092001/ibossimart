page 250 (
    name: MonthAvailabilityReport
    alias: MONTHAVAILABILITYREPORT
    title: MonthAvailabilityReport
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region monthavailabilityreport-discarded (
        name: MonthAvailabilityReport Discarded
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report-discarded (
        name: Report Discarded
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                aa.totalavailabilityhrs,
                aa.tno,
                aa.equipmentid,
                aa.equipmentname,
                aa.equipmentcategoryname,
                aa.breakdownhrs,
                --aa.closingmeterreading,
                --aa.openingmeterreading,
                --aa.closingworkinghrs,
                --aa.openingworkinghrs,
                aa.openingworkinghrs || aa.openingmeterreading as startinghmr,
                aa.closingworkinghrs || aa.closingmeterreading as endinghmr,
                aa.totalrunninghrs,
                (totalrunninghrs / aa.totalavailabilityhrs)*100 as utilizationpercentage,
                AA.CREATIONDATE
                from
                (Select 
                a.availabilityhrs,
                a.tno,
                a.equipmentid,
                a.equipmentname,
                a.equipmentcategoryname,
                a.breakdownhrs,
                a.closingmeterreading,
                a.openingmeterreading,
                a.openingworkinghrs,
                a.closingworkinghrs,
                a.totalrunninghrs,
                A.CREATIONDATE,
                Case when a.totalworkinghours - nvl(a.availabilityhrs,0) != 0 then
                          a.totalworkinghours
                     when a.totalworkinghours - nvl(a.availabilityhrs,0) = 0 then
                         a.totalworkinghours - (a.totalworkinghours - nvl(a.availabilityhrs,0)) 
                         end as totalavailabilityhrs
                From
                (select
                elb.availabilityhrs,
                e.tno,
                e.equipmentid,
                e.equipmentname,
                elb.closingworkinghrs,
                elb.openingworkinghrs,
                vlb.openingmeterreading,
                vlb.closingmeterreading,
                ec.equipmentcategoryname,
                abs(to_DATE(:P250_TODATE,'DD-MON-YYYY') - TO_DATE(:P250_FROMDATE,'DD-MON-YYYY') + 1)*22 as totalworkinghours, 
                
                Case when elb.availabilityhrs is null then 
                0
                 when elb.availabilityhrs is not null then 
                ((abs(to_DATE(:P250_TODATE,'DD-MON-YYYY') - TO_DATE(:P250_FROMDATE,'DD-MON-YYYY') + 1)*22)
                - nvl(elb.availabilityhrs,0)) end as breakdownhrs,
                ABS(abs(nvl(elb.closingworkinghrs,0) - nvl(elb.openingworkinghrs,0)) -
                (nvl(vlb.closingmeterreading,0) - nvl(vlb.openingmeterreading,0))) as totalrunninghrs,
                TO_CHAR(E.CREATIONTIME,'YYYY-MM-DD') AS CREATIONDATE 
                from 
                equipment e,
                equipmentlogbook elb,
                vehiclelogbook vlb,
                equipmentcategory ec
                where e.tno = elb.equipmenttno(+)
                and e.tno = vlb.equipmenttno(+)
                and e.equipmentcategorycode = ec.equipmentcategorycode(+)
                and elb.equipmentlogbookdate between :P250_FROMDATE AND :P250_TODATE
                and vlb.vehiclelogbookdate between :P250_FROMDATE AND :P250_TODATE
                and (:P250_EQUIPMENTID IS NULL OR instr(':'||:P250_EQUIPMENTID||':',':'||E.EQUIPMENTID||':') > 0)
                and (:P250_EQUIPMENTNAME IS NULL OR instr(':'||:P250_EQUIPMENTNAME||':',':'||E.EQUIPMENTNAME||':') > 0 ) 
                and (:P250_EQUIPMENTCATEGORY IS NULL OR instr(':'||:P250_EQUIPMENTCATEGORY||':',':'||E.EQUIPMENTCATEGORYCODE||':') > 0)) a
                )  aa;
                
                
                
                
                
                
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 8498543772523202
        }

