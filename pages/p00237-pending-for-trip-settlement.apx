page 237 (
    name: Pending For Trip Settlement
    alias: PENDING-FOR-TRIP-SETTLEMENT
    title: Pending For Trip Settlement
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region pending-for-trip-settelment (
        name: Pending For Trip Settelment
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                --	&p_groupby as GroupField,
                --	&p_orderby as OrderField,
                	Rownum as MySNo,
                	a.TNO,
                	a.LRNo,
                	a.GPNo,
                	a.VehicleNo,
                	a.Quantity1,
                	a.Nos,
                	dl.DestinationLocationName,
                	pl.CreationTime as InTime,
                	a.CreationTime as OutTime,
                	(a.CreationTime - pl.CreationTime ) as DifferenceDays,
                	a.ConsigneeName,
                	t.TransporterName || ' ( Contact No ' || t.OfficePhoneNo || ' )' as TransporterName,
                	e.ItemName,
                	a.PartyRefNo,
                	a.PartyRefDate,
                	lo.LoadingOrderNo,
                    sl.SourceLocationName,
                    a.BiltyCommission,
                    a.InvoiceNo,
                    c.PartyName,
                    ls.PODStatus,
                    ls.FreightAdviceStatus,
                    ls.ServiceBillStatus,
                    ls.FreightAmount,
                    a.DriverName
                from LR a, Party c ,Item e, ItemSpecification ee, MeasuringUnit mu1,
                DestinationLocation dl, SourceLocation sl, Placement pl, Transporter t,
                LoadingOrder lo, LRStatus ls, DocumentStatusDetail dsd
                where a.PartyCode = c.PartyCode
                	and a.ItemCode = e.ItemCode
                	and a.ItemSpecificationCode = ee.ItemSpecificationCode
                	and e.MeasuringUnitCode1 = mu1.MeasuringUnitCode
                	and a.DestinationLocationTNO = dl.TNo(+)
                	and a.SourceLocationTNO = sl.TNo(+)
                	and a.PlacementTNO = pl.TNo(+)
                	and a.TransporterCode  = t.TransporterCode(+)
                	and a.LoadingOrderTNo = lo.TNo(+)
                    and a.TNO = ls.LRTNo(+)
                    and a.TNO = dsd.ModuleTNo
                    and dsd.DocumentStatusCode like nvl(:P237_DOCUMENTSTATUSCODE,null)
                    and a.CompanyCode  like nvl(:P237_COMPANY,null)
                    and dsd.ModuleCode = 'LR'
                    and a.TransporterCode = 'SELF'
                                and not exists(
                                        select
                                              aa.TNo
                                         from TripSettlementRAndP aa 
                                         where aa.PlacementTNO = a.PlacementTNo
                                )
                --	and ( &P_REPORTCONDITION )
                --    and a.CompanyCode = :p_CompanyCode
                --	and GetLocationPrivilege(a.LocationCode, :P_Modulecode, a.companycode) ='YES'
                --	and GetDoctypePrivilege(a.doctypecode,:P_Modulecode, a.companycode) = 'YES'
                --	and GetAccountPrivilege(a.partycode,:P_Modulecode, a.companycode) = 'YES'
                --	and GetItemPrivilege(a.ItemCode, :P_Modulecode, a.companycode) ='YES'
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 22812642656376413
        }

