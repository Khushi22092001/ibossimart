page 381 (
    name: Vehicle Performance
    alias: VEHICLE-PERFORMANCE-FAST
    title: Vehicle Performance Fast
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var lSpinner$;
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region tab (
        name: Tab
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vehicle-performance-report (
        name: Vehicle Performance Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-collapsed
                t-Region--accent1
                t-Region--noBorder
                t-Region--hiddenOverflow
            ]
        }
    )

    region vehicle-performance-summary (
        name: "Vehicle Performance Summary "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  a.CompanyCode,
                  a.CompanyName,
                  sum(a.OpenBilledQuantity) as OpenBilledQuantity,
                  sum(a.OpenBilledNoOfTrip) as OpenBilledNoOfTrip,
                  sum(a.OpenBilledAmount) as OpenBilledAmount,
                  sum(a.CloseBilledQuantity) as CloseBilledQuantity,
                  sum(a.CloseBilledNoOfTrip) as CloseBilledNoOfTrip,
                  sum(a.CloseBilledAmount) as CloseBilledAmount,
                  sum(a.ITBilledQuantity) as ITBilledQuantity,
                  sum(a.ITBilledNoOfTrip) as ITBilledNoOfTrip,
                  sum(a.ITBilledAmount) as ITBilledAmount,
                  sum(a.OpenUnbilledQuantity) as OpenUnbilledQuantity,
                  sum(a.OpenUnbilledNoOfTrip) as OpenUnbilledNoOfTrip,
                  sum(a.OpenUnbilledAmount) as OpenUnbilledAmount,
                  sum(a.CloseUnbilledQuantity) as CloseUnbilledQuantity,
                  sum(a.CloseUnbilledNoOfTrip) as CloseUnbilledNoOfTrip,
                  sum(a.CloseUnbilledAmount) as CloseUnbilledAmount,
                  sum(a.ITUnbilledQuantity) as ITUnbilledQuantity,
                  sum(a.ITUnbilledNoOfTrip) as ITUnbilledNoOfTrip,
                  sum(a.ITUnbilledAmount) as ITUnbilledAmount,
                  sum(a.TotalQuantity) as TotalQuantity,
                  sum(a.TotalNoOfTrip) as TotalNoOfTrip,
                  sum(a.TotalAmount) as TotalAmount,
                  sum(a.TyreAmount) as TyreAmount,
                  sum(a.DieselAmount) as DieselAmount,
                  decode(nvl(sum(a.TotalAmount), 0), 0, 0, 
                  round((sum(a.DieselAmount) * 100) / sum(a.TotalAmount), 2) 
                  ) as DieselPercent,
                  sum(a.SpareAmount) as SpareAmount,
                  sum(a.DAAmount) as DAAmount,
                  sum(a.SalaryAmount) as SalaryAmount,
                  sum(a.BatteryAmount) as BatteryAmount,
                  sum(a.TripExpensesAmount) as TripExpensesAmount,
                  sum(a.TollAmount) as TollAmount,
                  sum(a.EMIAmount) as EMIAmount,
                  sum(a.OtherAmount) as OtherAmount,
                  sum(a.ExpenseAmount) as ExpenseAmount,
                  sum(a.ProfitAndLossAmount) as ProfitAndLossAmount
                From VehiclePerformanceTable a
                Where a.Creator = :APP_USER
                  and :P381_FROMDATE IS NOT NULL
                Group By
                  a.CompanyCode,
                  a.CompanyName
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tab
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            htmlDomId: vehicleperformance
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 450
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 154159036381113199
        }

