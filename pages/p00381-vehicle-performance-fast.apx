                Distinct
                    b.CompanyVehicleNo d,
                    b.CompanyVehicleNo r
                From CompanyVehicle b
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @vehicle-performance-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
