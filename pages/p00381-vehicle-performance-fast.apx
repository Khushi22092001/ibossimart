    dynamicAction preparerecord (
        name: PrepareRecord
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 50
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    /*
                    if :APP_USER != 'BOSS' then
                        raise_application_error(-20000, 'Sorry temporarily stopped for maintenance.');
                    end if;
                    */
                    PrepareVPOpenBilled(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPCloseBilled(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPITBilled(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPOpenUnbilled(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPCloseUnbilled(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPITUnbilled(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPTyreAmount(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPDieselAmount(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPSpareAmount(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPDAAmount(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPBatteryAmount(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPTripExpenseAmount(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPTollAmount(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPEMIAmount(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVPOtherAmount(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    PrepareVehiclePerformanceFast(:P381_COMPANY, :P381_VEHICLENO,:P381_VEHICLETYPE, :P381_TRANSPORTAREA, :P381_FROMDATE,:P381_TODATE, :APP_USER);
                    ```
                itemsToSubmit: [
                    P381_COMPANY
                    P381_FROMDATE
                    P381_TODATE
                    P381_TRANSPORTAREA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#apex_wait_overlay").remove();
                    $(".u-Processing").remove();
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vehicle-performance-summary
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vehicle-performance-vehicle-wise
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction show-spinner (
        name: Show Spinner
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var lSpinner$ = apex.util.showSpinner( $( "#vehicleperformance" ) );
                    //var spinner = apex.util.showSpinner("", {size:"big",color:"blue"})
                    
                    //spinner.remove();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

