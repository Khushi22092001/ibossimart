    region exEvidenceLOGISTICS (
        name: Vehicle movement and freight register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), E as (select 'ENTRY' metric,'Inbound material' purpose,h.TNo,h.MaterialInNo doc_no,h.GateInTime event_date,h.CompanyCode,h.LocationCode,h.TransporterCode,h.VehicleNo, cast(null as number) amount,cast(null as number) net_payable,h.GateInTime gate_in,h.GateOutTime gate_out from MaterialIn h left join DS ds on ds.ModuleCode='MATERIALIN' and ds.ModuleTNo=h.TNo cross join B b where h.GateInTime>=b.f and h.GateInTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') union all select 'EXIT' metric,'Inbound material' purpose,h.TNo,h.MaterialInNo doc_no,h.GateOutTime event_date,h.CompanyCode,h.LocationCode,h.TransporterCode,h.VehicleNo, cast(null as number) amount,cast(null as number) net_payable,h.GateInTime gate_in,h.GateOutTime gate_out from MaterialIn h left join DS ds on ds.ModuleCode='MATERIALIN' and ds.ModuleTNo=h.TNo cross join B b where h.GateOutTime>=b.f and h.GateOutTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') union all select 'ENTRY' metric,'Outbound dispatch' purpose,h.TNo,h.MaterialOutNo doc_no,h.GateInTime event_date,h.CompanyCode,h.LocationCode,h.TransporterCode,h.VehicleNo, cast(null as number) amount,cast(null as number) net_payable,h.GateInTime gate_in,h.GateOutTime gate_out from MaterialOut h left join DS ds on ds.ModuleCode='MATERIALOUT' and ds.ModuleTNo=h.TNo cross join B b where h.GateInTime>=b.f and h.GateInTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') union all select 'EXIT' metric,'Outbound dispatch' purpose,h.TNo,h.MaterialOutNo doc_no,h.GateOutTime event_date,h.CompanyCode,h.LocationCode,h.TransporterCode,h.VehicleNo, cast(null as number) amount,cast(null as number) net_payable,h.GateInTime gate_in,h.GateOutTime gate_out from MaterialOut h left join DS ds on ds.ModuleCode='MATERIALOUT' and ds.ModuleTNo=h.TNo cross join B b where h.GateOutTime>=b.f and h.GateOutTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') union all select 'FREIGHT','Freight advice',h.TNo,h.FreightAdviceNo,h.FreightAdviceDate,h.CompanyCode,h.LocationCode,h.TransporterCode,cast(null as varchar2(100)),h.FreightAdviceAmount,h.SumOfNetPayableAmount,cast(null as date),cast(null as date) from FreightAdvice h left join DS ds on ds.ModuleCode='FREIGHTADVICE' and ds.ModuleTNo=h.TNo cross join B b where h.FreightAdviceDate>=b.f and h.FreightAdviceDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')) select e.metric ACTIVITY,e.purpose PURPOSE,e.doc_no DOCUMENT_NO,e.event_date EVENT_DATE,(select CompanyName from Company where CompanyCode=e.CompanyCode) COMPANY,nvl((select LocationName from Location where LocationCode=e.LocationCode),e.LocationCode) LOCATION,nvl((select PartyName from Party where PartyCode=e.TransporterCode),e.TransporterCode) TRANSPORTER,e.VehicleNo VEHICLE_NO,e.amount FREIGHT_AMOUNT,e.net_payable NET_PAYABLE,e.gate_in GATE_IN,e.gate_out GATE_OUT, case when e.VehicleNo is not null then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>732,p_clear_cache=>'732',p_items=>'P732_VEHICLE,P732_FROMDATE,P732_TODATE,P732_COMPANY,P732_LOCATION,P732_PANEL',p_values=>e.VehicleNo||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL))||'">Vehicle 360</a>' end RELATED_360 from E e where :P735_FAMILY='LOGISTICS' and (:P735_METRIC='ALL' or e.metric=:P735_METRIC) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='MONTH' and to_char(e.event_date,'YYYY-MM')=:P735_DIMVALUE) or (:P735_DIMTYPE='PARTY' and e.TransporterCode=:P735_DIMVALUE))
            pageItemsToSubmit: [
