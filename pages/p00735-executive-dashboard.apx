    region exEvidenceMOVEMENT (
        name: Stock additions and deductions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), E as ( select 'IN' direction,s.TNo movement_id,s.StockModuleCode module_code,s.StockModuleTNo doc_id,s.StockDate event_date,s.CompanyCode,s.LocationCode,s.ItemCode,s.ItemSpecificationCode,s.StockQuantity1 quantity,s.Rate,s.StockQuantity1*s.Rate amount from Stock s left join DS ds on ds.ModuleCode=s.StockModuleCode and ds.ModuleTNo=s.StockModuleTNo cross join B b where s.StockDate>=b.f and s.StockDate<b.t and s.StockModuleCode not in ('ITEMOPENING','OPENING') and (:P735_COMPANY is null or s.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or s.LocationCode=:P735_LOCATION) and (b.enforced is null or s.Panel=b.enforced) and (:P735_PANEL is null or s.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') union all select 'OUT',u.TNo,u.ModuleCode,u.ModuleTNo,u.UsedStockDate,u.CompanyCode,u.LocationCode,s.ItemCode,s.ItemSpecificationCode,u.UsedStockQuantity1,s.Rate,u.UsedStockQuantity1*s.Rate from UsedStock u join Stock s on s.TNo=u.StockTNo left join DS ds on ds.ModuleCode=u.ModuleCode and ds.ModuleTNo=u.ModuleTNo cross join B b where u.UsedStockDate>=b.f and u.UsedStockDate<b.t and (:P735_COMPANY is null or u.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or u.LocationCode=:P735_LOCATION) and (b.enforced is null or u.Panel=b.enforced) and (:P735_PANEL is null or u.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')), M as (select e.*,i.ItemName,sp.ItemSpecificationName,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1, nvl((select ModuleName from Module where ModuleCode=e.module_code),e.module_code) module_name from E e join Item i on i.ItemCode=e.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=e.ItemSpecificationCode where (:P735_ITEM is null or e.ItemCode=:P735_ITEM) and (:P735_SPEC is null or e.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)) select m.direction STOCK_DIRECTION,m.module_name MODULE,case m.module_code when 'INSPECTION' then (select InspectionNo from Inspection where TNo=m.doc_id) when 'FREIGHTADVICE' then (select FreightAdviceNo from FreightAdvice where TNo=m.doc_id) when 'PBPASS' then (select PBPassNo from PBPass where TNo=m.doc_id) when 'PRODUCTION' then (select ProductionNo from Production where TNo=m.doc_id) when 'STOCKJOURNAL' then (select StockJournalNo from StockJournal where TNo=m.doc_id) when 'STOCKTRANSFER' then (select StockTransferNo from StockTransfer where TNo=m.doc_id) when 'JOININSPECTION' then (select JoinInspectionNo from JoinInspection where TNo=m.doc_id) when 'ISSUE' then (select IssueNo from Issue where TNo=m.doc_id) when 'CCINVOICE' then (select CCInvoiceNo from CCInvoice where TNo=m.doc_id) else to_char(m.doc_id) end DOCUMENT_NO,m.doc_id SOURCE_ID,m.event_date MOVEMENT_DATE,(select CompanyName from Company where CompanyCode=m.CompanyCode) COMPANY,nvl((select LocationName from Location where LocationCode=m.LocationCode),m.LocationCode) LOCATION, m.ItemName ITEM,m.ItemSpecificationName SPECIFICATION,m.quantity QUANTITY,nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=m.MeasuringUnitCode1),'Unit not recorded') UNIT,m.Rate STOCK_RATE,m.amount STOCK_VALUE, case m.module_code when 'ISSUE' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>686,p_clear_cache=>'686',p_items=>'P686_ISSUETNO',p_values=>m.doc_id))||'">Issue 360</a>' when 'CCINVOICE' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>m.doc_id))||'">Invoice 360</a>' when 'INSPECTION' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>740,p_clear_cache=>'740',p_items=>'P740_METRIC,P740_DOC',p_values=>'GRN,'||(select GRNTNo from Inspection where TNo=m.doc_id)))||'">Receipt 360</a>' when 'GRN' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>740,p_clear_cache=>'740',p_items=>'P740_METRIC,P740_DOC',p_values=>'GRN,'||m.doc_id))||'">Receipt 360</a>' when 'PRODUCTION' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>740,p_clear_cache=>'740',p_items=>'P740_METRIC,P740_DOC',p_values=>'PRODUCTION,'||m.doc_id))||'">Production 360</a>' end RELATED_360 from M m where :P735_FAMILY='MOVEMENT' and (:P735_METRIC='ALL' or m.direction=:P735_METRIC) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='MODULE' and m.module_code=:P735_DIMVALUE) or (:P735_DIMTYPE='UNIT' and m.MeasuringUnitCode1=:P735_DIMVALUE) or (:P735_DIMTYPE='MONTH' and to_char(m.event_date,'YYYY-MM')=:P735_DIMVALUE))
            pageItemsToSubmit: [
                P735_COMPANY
                P735_LOCATION
