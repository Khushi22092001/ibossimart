                union all
                select 'REJECTED' metric,h.TNo doc_id,d.SNo line_no,cast(h.GRNNo as varchar2(400)) doc_no,h.GRNDate event_date,h.CompanyCode company_code,h.LocationCode location_code,
                 h.PartyCode party_code,cast(null as number) amount,d.RejectedQuantity1 quantity,
                 i.MeasuringUnitCode1 unit_code,(b.clock-h.GRNDate)*24 age_hours,
                 cast(substr(i.ItemName||'; '||sp.ItemSpecificationName||'; received '||d.ReceivedQuantity1,1,400) as varchar2(400)) note
                 from GRN h join GRNDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='GRN' and ds.ModuleTNo=h.TNo cross join B b
                 where h.GRNDate>=b.f and h.GRNDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and d.RejectedQuantity1>0 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)
                
