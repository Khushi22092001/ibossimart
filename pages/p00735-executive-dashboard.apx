    region exEvidenceCOST (
        name: Invoice cost coverage
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), I as (select /*+ materialize */ h.TNo,h.CCInvoiceNo,h.CCInvoiceDate,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,d.Quantity1,d.Amount from CCInvoice h join CCInvoiceDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='CCINVOICE' and ds.ModuleTNo=h.TNo cross join B b where h.CCInvoiceDate>=b.f and h.CCInvoiceDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and nvl(h.CurrencyValue,1)=1 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)), U as (select u.ModuleTNo,u.ModuleSNo,sum(u.UsedStockQuantity1*s.Rate) cost,sum(case when s.Rate is not null then u.UsedStockQuantity1 end) rated_qty from UsedStock u join Stock s on s.TNo=u.StockTNo cross join B b where u.ModuleCode='CCINVOICE' and u.UsedStockDate<b.t and exists(select 1 from I where I.TNo=u.ModuleTNo and I.SNo=u.ModuleSNo) group by u.ModuleTNo,u.ModuleSNo), C as (select i.*,u.cost,u.rated_qty,case when i.Quantity1>0 and abs(u.rated_qty-i.Quantity1)<.000001 then 'MATCHED' else 'UNMATCHED' end coverage from I left join U u on u.ModuleTNo=i.TNo and u.ModuleSNo=i.SNo) select c.CCInvoiceNo INVOICE_NO,c.CCInvoiceDate INVOICE_DATE,nvl((select PartyName from Party where PartyCode=c.PartyCode),c.PartyCode) CUSTOMER,nvl((select LocationName from Location where LocationCode=c.LocationCode),c.LocationCode) LOCATION, (select ItemName from Item where ItemCode=c.ItemCode) ITEM,(select ItemSpecificationName from ItemSpecification where ItemSpecificationCode=c.ItemSpecificationCode) SPECIFICATION, c.Quantity1 INVOICE_QTY,c.rated_qty RATED_STOCK_QTY,c.Amount LINE_VALUE,c.cost LINKED_STOCK_COST,c.coverage COST_COVERAGE, case when c.coverage='MATCHED' then c.Amount-c.cost end MATCHED_CONTRIBUTION,'<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>c.TNo))||'">Invoice 360</a>' RELATED_360 from C c where :P735_FAMILY='COST' and (:P735_METRIC='ALL' or :P735_METRIC=c.coverage)
            pageItemsToSubmit: [
                P735_COMPANY
                P735_LOCATION
                P735_FROMDATE
                P735_TODATE
                P735_PANEL
                P735_ITEM
                P735_SPEC
                P735_CATEGORY
                P735_FAMILY
                P735_METRIC
                P735_DIMTYPE
                P735_DIMVALUE
                P735_DOC
            ]
        }
