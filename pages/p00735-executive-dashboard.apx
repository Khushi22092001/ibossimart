    process establish-executive-visibility (
        name: Establish executive visibility
        type: executeCode
        source {
            plsqlCode: begin if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if; end;
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900735083100018
        }
    )

    process exec-activity (
        name: EXEC_ACTIVITY
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare v clob;a clob;j apex_json.t_values;begin
                 if apex_application.g_x01 is not null then apex_json.parse(j,apex_application.g_x01);:P735_COMPANY:=apex_json.get_varchar2(p_path=>'COMPANY',p_values=>j);
                :P735_LOCATION:=apex_json.get_varchar2(p_path=>'LOCATION',p_values=>j);
                :P735_FROMDATE:=apex_json.get_varchar2(p_path=>'FROMDATE',p_values=>j);
                :P735_TODATE:=apex_json.get_varchar2(p_path=>'TODATE',p_values=>j);
                :P735_PANEL:=apex_json.get_varchar2(p_path=>'PANEL',p_values=>j);
                :P735_ITEM:=apex_json.get_varchar2(p_path=>'ITEM',p_values=>j);
                :P735_SPEC:=apex_json.get_varchar2(p_path=>'SPEC',p_values=>j);
                :P735_CATEGORY:=apex_json.get_varchar2(p_path=>'CATEGORY',p_values=>j);end if;
                 if :P735_FROMDATE is null or :P735_TODATE is null or to_date(:P735_TODATE,'DD-MM-RRRR')<to_date(:P735_FROMDATE,'DD-MM-RRRR') or to_date(:P735_TODATE,'DD-MM-RRRR')-to_date(:P735_FROMDATE,'DD-MM-RRRR')>365 or to_date(:P735_TODATE,'DD-MM-RRRR')>trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) then raise_application_error(-20001,'Choose valid dates through today, up to 366 days.');end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if;
                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), E as (select 'BILLING' metric,h.TNo doc_id,d.SNo line_no,cast(h.CCInvoiceNo as varchar2(400)) doc_no,h.CCInvoiceDate event_date,h.CreationTime logged_at,
                 h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code,
                 d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code,
                 case when nvl(h.CurrencyValue,1)=1 then d.Amount end amount,d.Quantity1 quantity,
                 case when nvl(h.CurrencyValue,1)<>1 then 1 else 0 end currency_gap,
                 h.Creator creator,nvl(ds.status,'Not recorded') document_status,
                 'Taxable line value before taxes and credit notes' note
                 from CCInvoice h join CCInvoiceDetail d on d.TNo=h.TNo
                 left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='CCINVOICE' and ds.ModuleTNo=h.TNo cross join B b
                 where h.CCInvoiceDate>=least(b.f-(b.t-b.f),b.t-7) and h.CCInvoiceDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                 and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) 
                union all
                select 'SALES_ORDER' metric,h.TNo doc_id,d.SNo line_no,cast(h.SalesOrderNo as varchar2(400)) doc_no,h.SalesOrderDate event_date,h.CreationTime logged_at,
                 h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code,
                 d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code,
                 case when nvl(h.CurrencyValue,1)=1 then d.Amount end amount,d.Quantity1 quantity,
                 case when nvl(h.CurrencyValue,1)<>1 then 1 else 0 end currency_gap,
                 h.Creator creator,nvl(ds.status,'Not recorded') document_status,
                 'Order line value before footer charges' note
                 from SalesOrder h join SalesOrderDetail d on d.TNo=h.TNo
                 left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='SALESORDER' and ds.ModuleTNo=h.TNo cross join B b
                 where h.SalesOrderDate>=least(b.f-(b.t-b.f),b.t-7) and h.SalesOrderDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                 and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) 
                union all
                select 'PO' metric,h.TNo doc_id,d.SNo line_no,cast(h.PurchaseOrderNo as varchar2(400)) doc_no,h.PurchaseOrderDate event_date,h.CreationTime logged_at,
                 h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code,
                 d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code,
                 case when nvl(h.CurrencyValue,1)=1 then d.Amount end amount,d.Quantity1 quantity,
                 case when nvl(h.CurrencyValue,1)<>1 then 1 else 0 end currency_gap,
                 h.Creator creator,nvl(ds.status,'Not recorded') document_status,
                 'Purchase order line value' note
                 from PurchaseOrder h join PurchaseOrderDetail d on d.TNo=h.TNo
                 left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='PURCHASEORDER' and ds.ModuleTNo=h.TNo cross join B b
                 where h.PurchaseOrderDate>=least(b.f-(b.t-b.f),b.t-7) and h.PurchaseOrderDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                 and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) 
                union all
                select 'PURCHASE' metric,h.TNo doc_id,d.SNo line_no,cast(h.PurchaseBillNo as varchar2(400)) doc_no,h.PurchaseBillDate event_date,h.CreationTime logged_at,
                 h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code,
                 d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code,
                 case when nvl(h.CurrencyValue,1)=1 then d.Amount end amount,d.Quantity1 quantity,
                 case when nvl(h.CurrencyValue,1)<>1 then 1 else 0 end currency_gap,
                 h.Creator creator,nvl(ds.status,'Not recorded') document_status,
                 'Purchase bill line value before footer charges' note
                 from PurchaseBill h join PurchaseBillDetail d on d.TNo=h.TNo
                 left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='PURCHASEBILL' and ds.ModuleTNo=h.TNo cross join B b
                 where h.PurchaseBillDate>=least(b.f-(b.t-b.f),b.t-7) and h.PurchaseBillDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                 and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) 
                union all
                select 'GRN' metric,h.TNo doc_id,d.SNo line_no,cast(h.GRNNo as varchar2(400)) doc_no,h.GRNDate event_date,h.CreationTime logged_at,
                 h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code,
                 d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code,
                 d.Amount amount,d.ReceivedQuantity1 quantity,
                 0 currency_gap,
                 h.Creator creator,nvl(ds.status,'Not recorded') document_status,
                 'Recorded receipt line value; quantities stay within their unit' note
                 from GRN h join GRNDetail d on d.TNo=h.TNo
                 left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='GRN' and ds.ModuleTNo=h.TNo cross join B b
                 where h.GRNDate>=least(b.f-(b.t-b.f),b.t-7) and h.GRNDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                 and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') 
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) 
                union all
                select 'PRODUCTION' metric,h.TNo doc_id,d.SNo line_no,cast(h.ProductionNo as varchar2(400)) doc_no,h.ProductionDate event_date,h.CreationTime logged_at,
                 h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,cast(null as varchar2(400)) party_code,
                 d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code,
                 d.StockValue amount,d.Quantity1 quantity,
                 0 currency_gap,
                 h.Creator creator,nvl(ds.status,'Not recorded') document_status,
                 'Recorded output; stock value is not revenue' note
                 from Production h join ProductionFinished d on d.TNo=h.TNo
                 left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='PRODUCTION' and ds.ModuleTNo=h.TNo cross join B b
                 where h.ProductionDate>=least(b.f-(b.t-b.f),b.t-7) and h.ProductionDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                 and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') 
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) 
                union all
                select 'QUALITY' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.QualityTestNo as varchar2(400)) doc_no,h.QualityTestDate event_date,h.CreationTime logged_at,
                 h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,cast(null as varchar2(400)) party_code,
                 cast(null as varchar2(400)) item_code,cast(null as varchar2(400)) spec_code,cast(null as varchar2(400)) category_code,cast(null as varchar2(400)) unit_code,
                 cast(null as number) amount,cast(null as number) quantity,
                 0 currency_gap,
                 h.Creator creator,nvl(ds.status,'Not recorded') document_status,
                 'Tests recorded, not tests passed' note
                 from QualityTest h 
                
                 left join DS ds on ds.ModuleCode='QUALITYTEST' and ds.ModuleTNo=h.TNo cross join B b
                 where h.QualityTestDate>=least(b.f-(b.t-b.f),b.t-7) and h.QualityTestDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                 and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') 
                 and (:P735_ITEM is null or cast(null as varchar2(400))=:P735_ITEM) and (:P735_SPEC is null or cast(null as varchar2(400))=:P735_SPEC) and (:P735_CATEGORY is null or cast(null as varchar2(400))=:P735_CATEGORY) 
                union all
                select 'ISSUE' metric,h.TNo doc_id,d.SNo line_no,cast(h.IssueNo as varchar2(400)) doc_no,h.IssueDate event_date,h.CreationTime logged_at,
                 h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,cast(null as varchar2(400)) party_code,
                 d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code,
                 (select sum(u.UsedStockQuantity1*s.Rate) from UsedStock u join Stock s on s.TNo=u.StockTNo where u.ModuleCode='ISSUE' and u.ModuleTNo=h.TNo and u.ModuleSNo=d.SNo) amount,d.Quantity1 quantity,
                 0 currency_gap,
                 h.Creator creator,nvl(ds.status,'Not recorded') document_status,
                 'Used stock quantity multiplied by its actual stock-layer rate' note
                 from Issue h join IssueDetail d on d.TNo=h.TNo
                 left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='ISSUE' and ds.ModuleTNo=h.TNo cross join B b
                 where h.IssueDate>=least(b.f-(b.t-b.f),b.t-7) and h.IssueDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                 and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) 
                union all
                select 'REQUISITION' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.RequisitionNo as varchar2(400)) doc_no,h.RequisitionDate event_date,h.CreationTime logged_at,
                 h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code,
                 cast(null as varchar2(400)) item_code,cast(null as varchar2(400)) spec_code,cast(null as varchar2(400)) category_code,cast(null as varchar2(400)) unit_code,
                 cast(null as number) amount,cast(null as number) quantity,
                 0 currency_gap,
                 h.Creator creator,nvl(ds.status,'Not recorded') document_status,
                 'Recorded material requests' note
                 from Requisition h 
                
                 left join DS ds on ds.ModuleCode='REQUISITION' and ds.ModuleTNo=h.TNo cross join B b
