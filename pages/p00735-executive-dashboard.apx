    region exEvidenceFLOW (
        name: Cash coming in and going out
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), V as ( select /*+ materialize */ d.TNo,d.LocationCode,d.CompanyCode,v.VoucherNo,v.DocTypeCode,min(d.VoucherDate) event_date,-sum(d.Amount) movement, sum(case when d.Amount<0 then -d.Amount else 0 end) gross_in,sum(case when d.Amount>0 then d.Amount else 0 end) gross_out from VoucherDetail d join Voucher v on v.TNo=d.TNo join Party p on p.PartyCode=d.AccountCode left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b where d.VoucherDate>=b.f and d.VoucherDate<b.t and nvl(v.VoucherNo,'~')<>'OPENING' and p.PartyTypeCode in ('CASH','BANK') and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') group by d.TNo,d.LocationCode,d.CompanyCode,v.VoucherNo,v.DocTypeCode), C as (select d.TNo,d.CompanyCode,d.LocationCode,count(distinct d.AccountCode) accounts,min(d.AccountCode) account_code, listagg(distinct p.PartyName,', ' on overflow truncate '…' without count) within group(order by p.PartyName) counterparts from VoucherDetail d join Party p on p.PartyCode=d.AccountCode cross join B b where nvl(p.PartyTypeCode,'~') not in ('CASH','BANK') and exists(select 1 from V where V.TNo=d.TNo) and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) group by d.TNo,d.CompanyCode,d.LocationCode), F as (select v.*,case when abs(v.movement)<=.005 then 'TRANSFER' when v.movement>0 then 'IN' else 'OUT' end direction, case when c.accounts=1 then c.account_code end counter_code,nvl(c.counterparts,'Cash / bank transfer or no counterpart in scope') counterparts, case when c.accounts=1 then nvl((select PartyName from Party where PartyCode=c.account_code),c.account_code) when c.accounts>1 then 'Multiple accounts — see voucher' else 'Cash / bank transfer' end counter_group from V v left join C c on c.TNo=v.TNo and c.CompanyCode=v.CompanyCode and nvl(c.LocationCode,'~')=nvl(v.LocationCode,'~')) select f.direction CASH_DIRECTION,f.VoucherNo VOUCHER_NO,f.event_date POSTING_DATE,(select CompanyName from Company where CompanyCode=f.CompanyCode) COMPANY,nvl((select LocationName from Location where LocationCode=f.LocationCode),f.LocationCode) LOCATION, f.counterparts COUNTERPART_ACCOUNTS,f.DocTypeCode VOUCHER_TYPE,case when f.movement>0 then f.movement else 0 end INFLOW,case when f.movement<0 then -f.movement else 0 end OUTFLOW,f.movement NET_MOVEMENT,least(f.gross_in,f.gross_out) OFFSET_BANK_LEGS, '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>f.TNo))||'">Voucher 360</a>' RELATED_360 from F f where :P735_FAMILY='FLOW' and (:P735_METRIC='ALL' or f.direction=:P735_METRIC) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='MONTH' and to_char(f.event_date,'YYYY-MM')=:P735_DIMVALUE) or (:P735_DIMTYPE='COUNTERPART' and f.counter_group=:P735_DIMVALUE))
            pageItemsToSubmit: [
                P735_COMPANY
                P735_LOCATION
                P735_FROMDATE
                P735_TODATE
                P735_PANEL
                P735_ITEM
                P735_SPEC
                P735_CATEGORY
                P735_FAMILY
                P735_METRIC
                P735_DIMTYPE
                P735_DIMVALUE
                P735_DOC
            ]
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ex-evidence
        }
        advanced {
            htmlDomId: exEvidenceFLOW
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No records match this selection and report filters.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 900735083100206
        }

