page 735 (
    name: Executive Dashboard
    alias: EXECUTIVE-DASHBOARD
    title: Executive Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_IMAGES#executive735.js?v=309e61fe93
        executeWhenPageLoads: window.ibossExecutive735Init();
    }
    css {
        fileUrls: #APP_IMAGES#executive735.css?v=988ca07555
    }
    security {
        formAutoComplete: false
    }

    region exDashboard (
        name: Enterprise Position
        type: staticContent
        source {
            htmlCode:
                ```html
                <main id="exApp" aria-label="Executive Dashboard">
                 <header class="ex-hero">
                  <div class="ex-top"><div><div class="ex-eyebrow">EXECUTIVE DASHBOARD</div><h1>Executive Command Centre</h1><p>Company performance. Money coming in and going out. Decisions that need your attention.</p></div><div class="ex-hero-actions"><button type="button" class="ex-btn" id="exFilterOpen">Filters <span aria-hidden="true">☷</span></button><button type="button" class="ex-btn ex-primary" id="exRefresh">Refresh data</button></div></div>
                  <div class="ex-periods" aria-label="Quick period"><button type="button" data-period="TODAY">Today</button><button type="button" data-period="YESTERDAY">Yesterday</button><button type="button" data-period="MTD">MTD</button><button type="button" data-period="QTD">QTD</button><button type="button" data-period="YTD">YTD</button><button type="button" data-period="FY">This FY</button><span id="exPeriodLabel"></span></div>
                  <div class="ex-context"><span id="exScope"></span><span id="exFreshness" role="status">Loading source data…</span></div>
                  <p class="ex-interaction-help">Select a card, chart point or highlighted value to view its supporting records below. Optional related 360 links open in a new tab; this dashboard and its filters stay unchanged.</p>
                 </header>
                 <nav class="ex-tabs ex-owner-nav" aria-label="Executive sections"><a href="#exOwnerProfit">Profitability</a><a href="#exIncomeSources">Income sources</a><a href="#exExpenseBreakdown">Expense breakdown</a><a href="#exOwnerCash">Cash flow</a><a href="#exOwnerMovement">Stock &amp; logistics</a><a href="#exTab-commercial">Sales &amp; capital</a><a href="#exTab-leaders">Customers &amp; suppliers</a><a href="#exAttentionSection">Exceptions</a></nav>
                 <div id="exErrors" role="alert"></div>
                 <section aria-label="Executive scorecard"><div id="exScore" class="ex-score"></div></section>
                 <section class="ex-brief"><div><span class="ex-eyebrow">MANAGEMENT BRIEF</span><p id="exNarrative">Preparing a summary from the selected scope.</p></div><button type="button" data-family="COVERAGE" data-metric="ALL" class="ex-trust-link"><strong>Data trust &amp; definitions</strong><span>Check target, cost and production coverage →</span></button></section>
                
                 <section id="exOwnerProfit" class="ex-owner-section"><div class="ex-section-heading"><div><span class="ex-eyebrow">01 · COMPANY PERFORMANCE</span><h2>Profitability, income &amp; expenses</h2><p>Understand the book result and the accounts driving it. Every value opens the underlying postings.</p></div><span class="ex-tag">Posted financial position</span></div>
                 <div class="ex-panel"><div id="exProfitBridge" class="ex-profit-layout"></div><div id="exProfitWarning"></div></div>
                 <div class="ex-grid ex-owner-grid"><section id="exIncomeSources" class="ex-panel"><div class="ex-panel-head"><div><h2>Where our income comes from</h2><p>Posted income by account · chart and account register</p></div></div><div id="exIncomeMix"></div><h3 class="ex-register-caption">Income account register</h3><div id="exIncomeDrivers"></div></section><section id="exExpenseBreakdown" class="ex-panel"><div class="ex-panel-head"><div><h2>Where our expenses go</h2><p>Recorded expense by account · chart and account register</p></div></div><div id="exExpenseMix"></div><p class="ex-note">Includes Variation A/C in full. This is booked expense, not cash paid. Hide a legend category to inspect the remaining chart; the register and totals stay unchanged.</p><h3 class="ex-register-caption">Expense account register</h3><div id="exExpenseDrivers"></div></section></div>
                 <div class="ex-grid"><section class="ex-panel"><div class="ex-panel-head"><div><h2>Income, expenses &amp; profit trend</h2><p>Monthly book values · select a point for vouchers</p></div></div><div class="ex-chart" id="exPnlTrend"></div></section><section class="ex-panel"><div class="ex-panel-head"><div><h2>Location contribution</h2><p>Posted income less expenses at each location</p></div></div><div id="exProfitLocations"></div></section></div></section>
                 <section id="exOwnerCash" class="ex-owner-section"><div class="ex-section-heading"><div><span class="ex-eyebrow">02 · CASH FLOW</span><h2>Cash coming in &amp; going out</h2><p>Actual voucher movements, separate from income and expense recognition.</p></div></div><div class="ex-panel ex-owner-cashline"><div id="exFlowTotals"></div><div id="exOwnerCashChart" class="ex-chart"></div></div><div class="ex-grid ex-owner-grid"><section class="ex-panel"><h2>Cash sources</h2><div id="exCashSources"></div></section><section class="ex-panel"><h2>Cash uses</h2><div id="exCashUses"></div></section></div></section>
                 <section id="exOwnerMovement" class="ex-owner-section"><div class="ex-section-heading"><div><span class="ex-eyebrow">03 · STOCK &amp; LOGISTICS</span><h2>Stock, vehicle movement &amp; freight</h2><p>See material postings, gate events and transporter cost without leaving this dashboard.</p></div></div><div class="ex-grid"><section class="ex-panel"><h2>Stock coming in &amp; going out</h2><div id="exMovementTotals"></div><div class="ex-chart" id="exMovementChart"></div><div id="exMovementSources"></div></section><section class="ex-panel"><h2>Vehicles &amp; freight</h2><div id="exLogisticsTotals"></div><details><summary>Monthly entry and exit counts</summary><div id="exVehicleChart"></div></details><h3>Top transporters by freight</h3><div id="exFreightDrivers"></div></section></div></section>
                  <section class="ex-lifecycle"><div class="ex-section-heading"><div><h2>Period business movement</h2><p>Independent stages, not one document cohort. Select a stage for current records, or its comparison for the preceding equal period. Related controls use their own date basis.</p></div></div><div id="exLifecycle" class="ex-stages"></div></section>
                
                 <div class="ex-tab-panel" id="exTab-commercial">
                  <div class="ex-grid ex-balanced-commercial"><section class="ex-panel"><div class="ex-panel-head"><div><h2>Sales &amp; purchase trend</h2><p>Taxable billing and purchase line value · monthly</p></div><button type="button" data-family="ACTIVITY" data-metric="BILLING" class="ex-text-btn">Billing records →</button></div><div id="exRevenueChart" class="ex-chart"></div><details><summary>Invoice-linked stock-cost coverage</summary><div id="exProfit"></div></details></section>
                  <section class="ex-panel"><div class="ex-panel-head"><div><h2>Working capital</h2><p>Open items after allocations · at the selected To Date</p></div></div><div id="exAgeing"></div><p class="ex-note">Credits and advances are shown separately. Missing due dates are not counted as overdue. Item filters do not alter ledger balances.</p></section></div>
                  <details class="ex-panel" style="margin-bottom:18px"><summary>Monthly working capital &amp; inventory history</summary><p class="ex-note">Reconstruct month-end positions using current source records, dated allocations and stock consumption. This is a restated view, not an archived financial close. Select a point for the same date’s supporting records.</p><button type="button" class="ex-btn" id="exHistoryLoad" style="margin-top:12px">Load monthly position history</button><div id="exCapitalHistory" class="ex-chart"></div></details><div class="ex-grid"><section class="ex-panel"><div class="ex-panel-head"><div><h2>Cash &amp; treasury</h2><p>Book position, not bank-reconciled available funds</p></div></div><div id="exCash"></div><details><summary>Monthly cash movement</summary><div id="exCashChart" class="ex-chart"></div></details></section>
                  <section class="ex-panel"><div class="ex-panel-head"><div><h2>Customer commitments &amp; forward view</h2><p>Current open counters and recorded due dates</p></div></div><div id="exOrders"></div><div id="exForward"></div></section></div>
                 </div>
                 <details class="ex-tab-panel ex-panel ex-deep-operations" id="exTab-operations"><summary>Production, quality, inventory health &amp; maintenance — expand analysis</summary>
                  <div class="ex-grid"><section class="ex-panel"><div class="ex-panel-head"><div><h2>Production &amp; quality</h2><p>Recorded output and explicit rejected receipts</p></div></div><div id="exProduction"></div></section><section class="ex-panel"><div class="ex-panel-head"><div><h2>Inventory health</h2><p>Stock layers in the as-of financial year</p></div></div><div id="exInventory"></div></section></div>
                  <div class="ex-grid"><section class="ex-panel"><div class="ex-panel-head"><div><h2>Procurement &amp; supplier risk</h2><p>Open purchase commitments, receipt and billing gaps</p></div></div><div id="exProcurement"></div></section><section class="ex-panel"><div class="ex-panel-head"><div><h2>Reliability, gate &amp; logistics</h2><p>Observable requests, movements and source coverage</p></div></div><div id="exReliability"></div></section></div>
                 </details>
                 <div class="ex-tab-panel" id="exTab-leaders">
                  <div class="ex-ranking-controls"><span>Ranked by recorded value. Select a row to view exact source lines.</span><label>Show <select id="exRankOrder"><option value="hi">Top 10</option><option value="lo">Bottom 10</option></select></label></div>
                  <div class="ex-grid"><section class="ex-panel"><div class="ex-panel-head"><div><h2>Customers</h2><p>Taxable billing · 7-day mini trends ending at To Date</p></div></div><div id="exCustomerMix"></div><div id="exCustomers"></div></section><section class="ex-panel"><div class="ex-panel-head"><div><h2>Suppliers</h2><p>Purchase line value · same trend basis</p></div></div><div id="exSupplierMix"></div><div id="exSuppliers"></div></section></div>
                  <div class="ex-grid"><section class="ex-panel"><div class="ex-panel-head"><div><h2>Products</h2><p>Item sales; specification and category filters stay applied</p></div></div><div id="exProducts"></div></section><section class="ex-panel"><div class="ex-panel-head"><div><h2>Item categories</h2><p>Specification category, then item category where absent</p></div></div><div id="exCategories"></div></section></div>
                  <p class="ex-note">Rankings measure value, not profitability. Customer margin, product margin and supplier OTIF need complete cost and promised-delivery data.</p>
                 </div>
                 <section id="exAttentionSection" class="ex-attention"><div class="ex-section-heading"><div><span class="ex-eyebrow">EXECUTIVE CONTROL CENTRE</span><h2>Attention required</h2><p>Document backlogs cover the as-of financial year; gate waiting is live now. Select a control for exact records. Counts and exposures overlap.</p></div><span class="ex-tag ex-warning">Defined exceptions</span></div><div id="exAttention" class="ex-controls"></div><div id="exExceptionActions"></div></section>
                 <div class="ex-grid ex-bottom-grid"><section class="ex-panel"><div class="ex-panel-head"><div><h2>Location performance</h2><p>Select a location for its in-page view and source records.</p></div></div><div id="exLocations"></div><div id="exLocationDetail" hidden></div></section><section class="ex-panel"><div class="ex-panel-head"><div><h2>Executive risk matrix</h2><p>Observed controls and evidence gaps; unknown is not healthy</p></div></div><div id="exRisk"></div></section></div>
                 <section class="ex-panel ex-recent"><div class="ex-recent-head"><div class="ex-recent-title"><span class="ex-recent-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 12h4l2-7 4 14 2-7h6"/></svg></span><div><div class="ex-recent-heading"><h2>Recent Activity</h2><span class="ex-live-badge"><i></i>Live</span></div><p>Latest transactions recorded in the system</p></div></div><button type="button" class="ex-btn ex-recent-all" data-family="ACTIVITY" data-metric="ALL_ACTIVITY" data-title="All activity in the applied scope">View all activity <span aria-hidden="true">→</span></button></div><p class="ex-recent-help">Latest records follow the applied filters. Select a transaction number to open its 360, or select its type badge to view matching records here.</p><div id="exRecent" class="ex-activity-grid"></div></section>
                 <details class="ex-panel ex-definitions"><summary>Definitions, data coverage &amp; unavailable measures</summary><div id="exCoverage"></div><p class="ex-note">INR amounts use recorded base-currency values. Non-base-currency commercial amounts are excluded and flagged; an absent conversion factor uses the source base value. The dashboard never converts unknown figures to a successful result. Budgets, margin, OEE, OTIF, downtime and future commitments appear only when their required source data is supported.</p></details>
                 <section id="exEvidenceHead" class="ex-evidence-head" hidden><div><span class="ex-eyebrow">SUPPORTING RECORDS</span><h2 id="exEvidenceTitle"></h2><p id="exEvidenceScope"></p></div><button type="button" class="ex-btn" id="exClearSelection">Clear selection ×</button></section>
                 <div id="exEvidenceSlot"></div>
                 <details class="ex-panel ex-shortcuts"><summary>Dashboard shortcuts · opens another dashboard</summary><p class="ex-note">Optional navigation only. All Executive figures and supporting records are available above.</p><nav aria-label="Dashboard shortcuts"><a class="ex-dashboard-shortcut" href="f?p=&APP_ID.:739:&SESSION.::NO:739">Today Enterprise Command Centre ↗</a><a class="ex-dashboard-shortcut" href="f?p=&APP_ID.:653:&SESSION.::NO:653">Sales Command Centre ↗</a><a class="ex-dashboard-shortcut" href="f?p=&APP_ID.:668:&SESSION.::NO:668">Purchase Command Centre ↗</a><a class="ex-dashboard-shortcut" href="f?p=&APP_ID.:684:&SESSION.::NO:684">Inventory Command Centre ↗</a><a class="ex-dashboard-shortcut" href="f?p=&APP_ID.:690:&SESSION.::NO:690">Receivables Command Centre ↗</a><a class="ex-dashboard-shortcut" href="f?p=&APP_ID.:710:&SESSION.::NO:710">Payables Command Centre ↗</a></nav></details>
                 <div id="exDrawer" class="ex-drawer-backdrop" hidden><section class="ex-drawer" role="dialog" aria-modal="true" aria-labelledby="exFilterTitle"><div class="ex-panel-head"><div><h2 id="exFilterTitle">Scope &amp; period</h2><p>Choose your scope and dates, then select Apply filters.</p></div><button type="button" class="ex-btn" id="exFilterClose" aria-label="Close filters">×</button></div><div id="exFilterSlot"></div><div class="ex-drawer-footer"><p>For Item or Specification, type in the search box and press Enter, then select a result. Item, specification and category apply to material records. Financial balances and gate controls use company, location and panel.</p><div><button type="button" class="ex-btn" id="exReset">Reset filters</button><button type="button" class="ex-btn ex-primary" id="exApply">Apply filters</button></div><p id="exFilterError" role="alert"></p></div></section></div>
                </main>
                
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader
                t-Region--noUI
            ]
        }
        advanced {
            htmlDomId: exDashboard
        }
    )

    region exEvidenceACTIVITY (
        name: Activity source register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), E as (select 'BILLING' metric,h.TNo doc_id,d.SNo line_no,cast(h.CCInvoiceNo as varchar2(400)) doc_no,h.CCInvoiceDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code, d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code, case when nvl(h.CurrencyValue,1)=1 then d.Amount end amount,d.Quantity1 quantity, case when nvl(h.CurrencyValue,1)<>1 then 1 else 0 end currency_gap, h.Creator creator,nvl(ds.status,'Not recorded') document_status, 'Taxable line value before taxes and credit notes' note from CCInvoice h join CCInvoiceDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='CCINVOICE' and ds.ModuleTNo=h.TNo cross join B b where h.CCInvoiceDate>=least(b.f-(b.t-b.f),b.t-7) and h.CCInvoiceDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) union all select 'SALES_ORDER' metric,h.TNo doc_id,d.SNo line_no,cast(h.SalesOrderNo as varchar2(400)) doc_no,h.SalesOrderDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code, d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code, case when nvl(h.CurrencyValue,1)=1 then d.Amount end amount,d.Quantity1 quantity, case when nvl(h.CurrencyValue,1)<>1 then 1 else 0 end currency_gap, h.Creator creator,nvl(ds.status,'Not recorded') document_status, 'Order line value before footer charges' note from SalesOrder h join SalesOrderDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='SALESORDER' and ds.ModuleTNo=h.TNo cross join B b where h.SalesOrderDate>=least(b.f-(b.t-b.f),b.t-7) and h.SalesOrderDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) union all select 'PO' metric,h.TNo doc_id,d.SNo line_no,cast(h.PurchaseOrderNo as varchar2(400)) doc_no,h.PurchaseOrderDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code, d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code, case when nvl(h.CurrencyValue,1)=1 then d.Amount end amount,d.Quantity1 quantity, case when nvl(h.CurrencyValue,1)<>1 then 1 else 0 end currency_gap, h.Creator creator,nvl(ds.status,'Not recorded') document_status, 'Purchase order line value' note from PurchaseOrder h join PurchaseOrderDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='PURCHASEORDER' and ds.ModuleTNo=h.TNo cross join B b where h.PurchaseOrderDate>=least(b.f-(b.t-b.f),b.t-7) and h.PurchaseOrderDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) union all select 'PURCHASE' metric,h.TNo doc_id,d.SNo line_no,cast(h.PurchaseBillNo as varchar2(400)) doc_no,h.PurchaseBillDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code, d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code, case when nvl(h.CurrencyValue,1)=1 then d.Amount end amount,d.Quantity1 quantity, case when nvl(h.CurrencyValue,1)<>1 then 1 else 0 end currency_gap, h.Creator creator,nvl(ds.status,'Not recorded') document_status, 'Purchase bill line value before footer charges' note from PurchaseBill h join PurchaseBillDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='PURCHASEBILL' and ds.ModuleTNo=h.TNo cross join B b where h.PurchaseBillDate>=least(b.f-(b.t-b.f),b.t-7) and h.PurchaseBillDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) union all select 'GRN' metric,h.TNo doc_id,d.SNo line_no,cast(h.GRNNo as varchar2(400)) doc_no,h.GRNDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,h.PartyCode party_code, d.ItemCode item_code,d.ItemSpecificationCode spec_code,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1 unit_code, d.Amount amount,d.ReceivedQuantity1 quantity, 0 currency_gap, h.Creator creator,nvl(ds.status,'Not recorded') document_status, 'Recorded receipt line value; quantities stay within their unit' note from GRN h join GRNDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='GRN' and ds.ModuleTNo=h.TNo cross join B b where h.GRNDate>=least(b.f-(b.t-b.f),b.t-7) and h.GRNDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCEL