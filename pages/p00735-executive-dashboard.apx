                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), O as (select 'SO' kind,h.TNo,h.SalesOrderNo doc_no,h.SalesOrderDate event_date,h.DeliveryDate due_date,h.CompanyCode,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,i.MeasuringUnitCode1,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,
                 d.Quantity1 ordered,nvl(d.CCInvoiceQuantity1,0) fulfilled,greatest(d.Quantity1-nvl(d.CCInvoiceQuantity1,0),0) remaining,
                 case when nvl(h.CurrencyValue,1)=1 then d.Amount*greatest(d.Quantity1-nvl(d.CCInvoiceQuantity1,0),0)/nullif(d.Quantity1,0) end amount,
                 nvl(d.DocumentStatusCode,'Not recorded') status,
                 cast(null as date) first_receipt
                 from SalesOrder h join SalesOrderDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
