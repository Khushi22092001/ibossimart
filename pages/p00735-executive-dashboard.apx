tail d join Voucher v on v.TNo=d.TNo left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b where d.VoucherDate>=least(b.f-(b.t-b.f),b.t-7) and d.VoucherDate<b.t and v.DocTypeCode in ('PAYMENT','CASHPAYMENT','BANKPAYMENT') and -1*d.Amount>0 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode) and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')), C as (select /*+ materialize */ e.* from E e cross join B b where e.event_date>=b.f) select case e.metric when 'BILLING' then 'Sales billing' when 'SALES_ORDER' then 'Sales orders' when 'PO' then 'Purchase orders' when 'PURCHASE' then 'Purchase bills' when 'GRN' then 'Material receipts' when 'PRODUCTION' then 'Production output' when 'QUALITY' then 'Quality tests' when 'DISPATCH' then 'Gate dispatches' when 'COLLECTION' then 'Customer collections' when 'PAYMENT' then 'Supplier payments' when 'ISSUE' then 'Store issues' when 'REQUISITION' then 'Material requisitions' when 'PASS' then 'Bills passed' when 'GATE_IN' then 'Inbound vehicles' when 'SERVICE' then 'Service bills' when 'FREIGHT' then 'Freight advice' end MODULE,e.doc_id DOCUMENT_ID,e.line_no LINE_NO,e.doc_no DOCUMENT_NO,e.event_date DOCUMENT_DATE,(select CompanyName from Company where CompanyCode=e.company_code) COMPANY, nvl((select LocationName from Location where LocationCode=e.location_code),e.location_code) LOCATION,nvl((select PartyName from Party where PartyCode=e.party_code),e.party_code) PARTY,i.ItemName ITEM,sp.ItemSpecificationName SPECIFICATION,cat.ItemCategoryName CATEGORY, e.quantity QUANTITY,case when e.quantity is not null then nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=e.unit_code),'Unit not recorded') end UNIT,e.amount AMOUNT,e.document_status STATUS,e.logged_at RECORDED_AT,e.creator RECORDED_BY, case when e.currency_gap=1 then 'Non-base currency amount excluded from INR totals. ' end||e.note NOTES, case when e.metric not in ('QUALITY','FREIGHT') then '<a href="'||apex_escape.html_attribute(case e.metric when 'BILLING' then apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>e.doc_id) when 'PURCHASE' then apex_page.get_url(p_page=>680,p_clear_cache=>'680',p_items=>'P680_TNO',p_values=>e.doc_id) when 'PO' then apex_page.get_url(p_page=>682,p_clear_cache=>'682',p_items=>'P682_TNO',p_values=>e.doc_id) when 'SALES_ORDER' then apex_page.get_url(p_page=>734,p_clear_cache=>'734',p_items=>'P734_SOTNO',p_values=>e.doc_id) when 'COLLECTION' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>e.doc_id) when 'PAYMENT' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>e.doc_id) when 'REQUISITION' then apex_page.get_url(p_page=>687,p_clear_cache=>'687',p_items=>'P687_REQTNO',p_values=>e.doc_id) when 'ISSUE' then apex_page.get_url(p_page=>686,p_clear_cache=>'686',p_items=>'P686_ISSUETNO',p_values=>e.doc_id) else apex_page.get_url(p_page=>740,p_clear_cache=>'740',p_items=>'P740_METRIC,P740_DOC,P740_FROMDATE,P740_TODATE,P740_COMPANY,P740_LOCATION,P740_PANEL',p_values=>e.metric||','||e.doc_id||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL) end)||'">Transaction 360</a>' end|| case when e.party_code is not null and e.metric in ('BILLING','SALES_ORDER','COLLECTION') then ' '||'<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>693,p_clear_cache=>'693',p_items=>'P693_PARTY,P693_FROMDATE,P693_TODATE,P693_COMPANY,P693_LOCATION,P693_PANEL',p_values=>e.party_code||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL))||'">Customer 360</a>' when e.party_code is not null and e.metric in ('PURCHASE','PO','GRN','PASS','PAYMENT') then ' '||'<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>669,p_clear_cache=>'669',p_items=>'P669_SUPPLIER,P669_FROMDATE,P669_TODATE,P669_COMPANY,P669_LOCATION,P669_PANEL',p_values=>e.party_code||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL))||'">Supplier 360</a>' end|| case when e.item_code is not null then ' '||'<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>679,p_clear_cache=>'679',p_items=>'P679_ITEMCODE,P679_FROMDATE,P679_TODATE,P679_COMPANY,P679_LOCATION,P679_PANEL',p_values=>e.item_code||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL))||'">Item 360</a>' end RELATED_360 from C e left join Item i on i.ItemCode=e.item_code left join ItemSpecification sp on sp.ItemSpecificationCode=e.spec_code left join ItemCategory cat on cat.ItemCategoryCode=e.category_code where :P735_FAMILY='ACTIVITY' and (:P735_METRIC in ('ALL','ALL_ACTIVITY') or e.metric=:P735_METRIC) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='PARTY' and e.party_code=:P735_DIMVALUE) or (:P735_DIMTYPE='OTHER_PARTY' and (e.party_code is null or e.party_code not in (select column_value from table(apex_string.split(:P735_DIMVALUE,'|'))))) or (:P735_DIMTYPE='LOCATION' and nvl(e.location_code,'~')=:P735_DIMVALUE) or (:P735_DIMTYPE='ITEM' and e.item_code=:P735_DIMVALUE) or (:P735_DIMTYPE='SPEC' and e.spec_code=:P735_DIMVALUE) or (:P735_DIMTYPE='CATEGORY' and nvl(e.category_code,'~')=:P735_DIMVALUE) or (:P735_DIMTYPE='MONTH' and to_char(e.event_date,'YYYY-MM')=:P735_DIMVALUE) or (:P735_DIMTYPE='DAY' and to_char(e.event_date,'YYYY-MM-DD')=:P735_DIMVALUE) or (:P735_DIMTYPE='UNIT' and nvl(e.unit_code,'~')=:P735_DIMVALUE)) and (:P735_DOC is null or e.doc_id=to_number(:P735_DOC default null on conversion error))
            pageItemsToSubmit: [
                P735_COMPANY
                P735_LOCATION
                P735_FROMDATE
                P735_TODATE
                P735_PANEL
                P735_ITEM
                P735_SPEC
                P735_CATEGORY
                P735_FAMILY
                P735_METRIC
                P735_DIMTYPE
                P735_DIMVALUE
                P735_DOC
            ]
        }
