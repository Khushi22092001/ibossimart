                union all
                select 'ASSETS' domain,'Asset' source,'Fixed-asset transactions' label,count(*) records,min(h.AssetDate) first_date,max(h.AssetDate) latest_date,'Asset value, depreciation and utilisation need populated asset transactions and validated accounting schedules.' limitation
                 from Asset h cross join B b where h.AssetDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                
                union all
                select 'INVENTORY','ItemSpecification','Specifications with reorder levels',count(*),cast(null as date),cast(null as date),'Positive reorder or minimum levels are needed to certify shortage and excess.' from ItemSpecification where ReorderLevel>0 or MinimumLevel>0 or MaximumLevel>0
                union all
                select 'ASSETS','Equipment','Equipment with rated capacity',count(*),cast(null as date),cast(null as date),'Capacity, equipment-linked runtime and output are required for utilisation.' from Equipment h cross join B b where h.Capacity>0 and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION)  and :P735_ALLOW_MAINT='Y'
                union all
                select 'MINING','MiningCategory','Mining category master',count(*),cast(null as date),max(CreationTime),'Category master records do not establish recorded mining or overburden output; no mining production KPI is inferred.' from MiningCategory
                union all
                select 'WORKFLOW','ONTHETABLE_APEX','Personal approval queue scope',count(*),min(q.QueueDate),max(q.QueueDate),'Personal authorised queue only. A selected panel suppresses this unverified panel mapping; zero then means unavailable for that panel, not no pending approvals.' from ONTHETABLE_APEX q where :P735_PANEL is null and (:P735_COMPANY is null or q.CompanyCode=:P735_COMPANY)) select json_arrayagg(json_object('domain' value domain,'source' value source,'label' value label,'records' value records,'first' value to_char(first_date,'YYYY-MM-DD'),'latest' value to_char(latest_date,'YYYY-MM-DD'),'note' value limitation) returning clob) payload from C);
                 select json_object('data' value nvl(a,case when 'COVERAGE' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
                ```
