    region exEvidenceCOMMITMENTS (
        name: Order commitment register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), O as (select 'SO' kind,h.TNo,h.SalesOrderNo doc_no,h.SalesOrderDate event_date,h.DeliveryDate due_date,h.CompanyCode,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,i.MeasuringUnitCode1,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code, d.Quantity1 ordered,nvl(d.CCInvoiceQuantity1,0) fulfilled,greatest(d.Quantity1-nvl(d.CCInvoiceQuantity1,0),0) remaining, case when nvl(h.CurrencyValue,1)=1 then d.Amount*greatest(d.Quantity1-nvl(d.CCInvoiceQuantity1,0),0)/nullif(d.Quantity1,0) end amount, nvl(d.DocumentStatusCode,'Not recorded') status, cast(null as date) first_receipt from SalesOrder h join SalesOrderDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='SALESORDER' and ds.ModuleTNo=h.TNo cross join B b where h.SalesOrderDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED','CLOSED') and d.Quantity1>0 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) union all select 'PO' kind,h.TNo,h.PurchaseOrderNo doc_no,h.PurchaseOrderDate event_date,h.DeliveryDate due_date,h.CompanyCode,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,i.MeasuringUnitCode1,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code, d.Quantity1 ordered,nvl(d.ReceivedQuantity1,0) fulfilled,greatest(d.Quantity1-nvl(d.ReceivedQuantity1,0),0) remaining, case when nvl(h.CurrencyValue,1)=1 then d.Amount*greatest(d.Quantity1-nvl(d.ReceivedQuantity1,0),0)/nullif(d.Quantity1,0) end amount, nvl(d.DocumentStatusCode,'Not recorded') status, (select min(g.GRNDate) from GRN g where g.PurchaseOrderTNo=h.TNo) first_receipt from PurchaseOrder h join PurchaseOrderDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='PURCHASEORDER' and ds.ModuleTNo=h.TNo cross join B b where h.PurchaseOrderDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED','CLOSED') and d.Quantity1>0 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)) select case o.kind when 'SO' then 'Sales order' else 'Purchase order' end MODULE,o.doc_no DOCUMENT_NO,o.event_date DOCUMENT_DATE,o.due_date PROMISED_DATE,(select CompanyName from Company where CompanyCode=o.CompanyCode) COMPANY,nvl((select LocationName from Location where LocationCode=o.LocationCode),o.LocationCode) LOCATION,nvl((select PartyName from Party where PartyCode=o.PartyCode),o.PartyCode) PARTY, (select ItemName from Item where ItemCode=o.ItemCode) ITEM,(select ItemSpecificationName from ItemSpecification where ItemSpecificationCode=o.ItemSpecificationCode) SPECIFICATION, (select ItemCategoryName from ItemCategory where ItemCategoryCode=o.category_code) CATEGORY,o.ordered ORDERED_QTY,o.fulfilled FULFILLED_QTY,o.remaining REMAINING_QTY,nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=o.MeasuringUnitCode1),'Unit not recorded') UNIT,o.amount OPEN_VALUE,o.status STATUS,o.first_receipt FIRST_RECEIPT, case when o.kind='SO' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>734,p_clear_cache=>'734',p_items=>'P734_SOTNO',p_values=>o.TNo))||'">Sales Order 360</a>' else '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>682,p_clear_cache=>'682',p_items=>'P682_TNO',p_values=>o.TNo))||'">Purchase Order 360</a>' end RELATED_360 from O o cross join B b where :P735_FAMILY='COMMITMENTS' and (:P735_METRIC='ALL' or :P735_METRIC=o.kind) and ((:P735_DIMTYPE='OVERFILLED' and o.fulfilled>o.ordered) or (nvl(:P735_DIMTYPE,'~')<>'OVERFILLED' and o.remaining>0)) and (:P735_DIMTYPE is null or :P735_DIMTYPE='OVERFILLED' or (:P735_DIMTYPE='OVERDUE' and o.due_date<b.t-1) or (:P735_DIMTYPE='UNKNOWN' and o.due_date is null) or (:P735_DIMTYPE='PARTY' and o.PartyCode=:P735_DIMVALUE) or (:P735_DIMTYPE='UNIT' and o.MeasuringUnitCode1=:P735_DIMVALUE) or (:P735_DIMTYPE='FORWARD' and o.due_date>=b.t-1 and o.due_date<b.t-1+to_number(:P735_DIMVALUE default null on conversion error)))
            pageItemsToSubmit: [
                P735_COMPANY
                P735_LOCATION
                P735_FROMDATE
                P735_TODATE
                P735_PANEL
                P735_ITEM
                P735_SPEC
                P735_CATEGORY
                P735_FAMILY
                P735_METRIC
                P735_DIMTYPE
                P735_DIMVALUE
                P735_DOC
            ]
