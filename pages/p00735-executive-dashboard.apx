                :P735_CATEGORY:=apex_json.get_varchar2(p_path=>'CATEGORY',p_values=>j);end if;
                 if :P735_FROMDATE is null or :P735_TODATE is null or to_date(:P735_TODATE,'DD-MM-RRRR')<to_date(:P735_FROMDATE,'DD-MM-RRRR') or to_date(:P735_TODATE,'DD-MM-RRRR')-to_date(:P735_FROMDATE,'DD-MM-RRRR')>365 or to_date(:P735_TODATE,'DD-MM-RRRR')>trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) then raise_application_error(-20001,'Choose valid dates through today, up to 366 days.');end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if;
                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), E as (
                 select 'IN' direction,s.TNo movement_id,s.StockModuleCode module_code,s.StockModuleTNo doc_id,s.StockDate event_date,s.CompanyCode,s.LocationCode,s.ItemCode,s.ItemSpecificationCode,s.StockQuantity1 quantity,s.Rate,s.StockQuantity1*s.Rate amount
                 from Stock s left join DS ds on ds.ModuleCode=s.StockModuleCode and ds.ModuleTNo=s.StockModuleTNo cross join B b
                 where s.StockDate>=b.f and s.StockDate<b.t and s.StockModuleCode not in ('ITEMOPENING','OPENING') and (:P735_COMPANY is null or s.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or s.LocationCode=:P735_LOCATION) and (b.enforced is null or s.Panel=b.enforced) and (:P735_PANEL is null or s.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 union all select 'OUT',u.TNo,u.ModuleCode,u.ModuleTNo,u.UsedStockDate,u.CompanyCode,u.LocationCode,s.ItemCode,s.ItemSpecificationCode,u.UsedStockQuantity1,s.Rate,u.UsedStockQuantity1*s.Rate
                 from UsedStock u join Stock s on s.TNo=u.StockTNo left join DS ds on ds.ModuleCode=u.ModuleCode and ds.ModuleTNo=u.ModuleTNo cross join B b
                 where u.UsedStockDate>=b.f and u.UsedStockDate<b.t and (:P735_COMPANY is null or u.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or u.LocationCode=:P735_LOCATION) and (b.enforced is null or u.Panel=b.enforced) and (:P735_PANEL is null or u.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')),
                 M as (select e.*,i.ItemName,sp.ItemSpecificationName,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,i.MeasuringUnitCode1,
                 nvl((select ModuleName from Module where ModuleCode=e.module_code),e.module_code) module_name
                 from E e join Item i on i.ItemCode=e.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=e.ItemSpecificationCode
                 where (:P735_ITEM is null or e.ItemCode=:P735_ITEM) and (:P735_SPEC is null or e.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)), T as (select direction,sum(amount) amount,count(*) lines,count(distinct module_code||':'||doc_id) documents,count(case when rate is null then 1 end) unpriced from M group by direction),
                 G as (select direction,module_code,module_name,sum(amount) amount,count(*) lines from M group by direction,module_code,module_name),
                 U as (select direction,MeasuringUnitCode1 code,sum(quantity) quantity from M group by direction,MeasuringUnitCode1),
                 D as (select to_char(event_date,'YYYY-MM') month,sum(case when direction='IN' then amount else 0 end) incoming,sum(case when direction='OUT' then amount else 0 end) outgoing from M group by to_char(event_date,'YYYY-MM'))
                 select json_object('totals' value (select json_arrayagg(json_object('key' value direction,'amount' value amount,'lines' value lines,'documents' value documents,'unpriced' value unpriced) returning clob) from T) format json,
                 'sources' value (select json_arrayagg(json_object('key' value direction,'code' value module_code,'name' value module_name,'amount' value amount,'lines' value lines) order by abs(amount) desc returning clob) from G) format json,
                 'units' value (select json_arrayagg(json_object('key' value direction,'code' value code,'name' value nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=U.code),'Unit not recorded'),'quantity' value quantity) returning clob) from U) format json,
                 'trend' value (select json_arrayagg(json_object('month' value month,'incoming' value incoming,'outgoing' value outgoing) order by month returning clob) from D) format json returning clob) payload from dual);
                 select json_object('data' value nvl(a,case when 'MOVEMENT' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
