    region exEvidenceCASH (
        name: Cash and bank postings
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), FY as (select max(FinancialYearBegin) fy from FinancialYear cross join B b where b.t-1 between FinancialYearBegin and FinancialYearEnd), C as (select o.TNo,cast(null as number) SNo,'Opening balance' doc_no,o.OpeningDate entry_date,o.CompanyCode,o.LocationCode,o.AccountCode,o.OpeningAmount amount,'FY carry forward; Panel A' note from Opening o join Party p on p.PartyCode=o.AccountCode cross join B b cross join FY where o.OpeningDate=FY.fy and p.PartyTypeCode in ('CASH','BANK') and (:P735_COMPANY is null or o.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or o.LocationCode=:P735_LOCATION) and (b.enforced is null or b.enforced='A') and (:P735_PANEL is null or :P735_PANEL='A') union all select d.TNo,d.SNo,v.VoucherNo,d.VoucherDate,d.CompanyCode,d.LocationCode,d.AccountCode,d.Amount,substr(d.Narration,1,400) from VoucherDetail d join Voucher v on v.TNo=d.TNo join Party p on p.PartyCode=d.AccountCode left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b cross join FY where d.VoucherDate>=FY.fy and d.VoucherDate<b.t and nvl(v.VoucherNo,'~')<>'OPENING' and p.PartyTypeCode in ('CASH','BANK') and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')) select nvl((select PartyName from Party where PartyCode=c.AccountCode),c.AccountCode) ACCOUNT,c.doc_no DOCUMENT_NO,c.entry_date POSTING_DATE,(select CompanyName from Company where CompanyCode=c.CompanyCode) COMPANY,nvl((select LocationName from Location where LocationCode=c.LocationCode),c.LocationCode) LOCATION,-c.amount BOOK_AMOUNT, case when c.amount<0 then -c.amount end INFLOW,case when c.amount>0 then c.amount end OUTFLOW,c.note NOTES,case when c.SNo is not null then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>c.TNo))||'">Voucher 360</a>' end RELATED_360 from C c cross join B b where :P735_FAMILY='CASH' and (:P735_METRIC='ALL' or (:P735_METRIC='MOVEMENT' and c.SNo is not null and c.entry_date>=b.f) or (:P735_METRIC='IN' and c.SNo is not null and c.entry_date>=b.f and c.amount<0) or (:P735_METRIC='OUT' and c.SNo is not null and c.entry_date>=b.f and c.amount>0)) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='ACCOUNT' and c.AccountCode=:P735_DIMVALUE) or (:P735_DIMTYPE='MONTH' and c.SNo is not null and c.entry_date>=b.f and to_char(c.entry_date,'YYYY-MM')=:P735_DIMVALUE))
            pageItemsToSubmit: [
                P735_COMPANY
                P735_LOCATION
                P735_FROMDATE
                P735_TODATE
                P735_PANEL
                P735_ITEM
                P735_SPEC
                P735_CATEGORY
                P735_FAMILY
                P735_METRIC
                P735_DIMTYPE
                P735_DIMVALUE
                P735_DOC
            ]
        }
        layout {
            sequence: 32
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ex-evidence
        }
