                 'trend' value (select json_arrayagg(json_object('month' value month,'entries' value entries,'exits' value exits,'freight' value freight) order by month returning clob) from M) format json,
                 'transporters' value (select json_arrayagg(json_object('code' value code,'name' value nvl((select PartyName from Party where PartyCode=P.code),P.code),'amount' value amount,'documents' value documents) order by rn returning clob) from P where rn<=10) format json returning clob) payload from dual);
                 select json_object('data' value nvl(a,case when 'LOGISTICS' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
