                select 'COLLECTION',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime,d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),cast(null as varchar2(400)),cast(null as varchar2(400)),cast(null as varchar2(400)),1*d.Amount,cast(null as number),0,v.Creator,nvl(ds.status,'Not recorded'),cast(substr(d.Narration,1,400) as varchar2(400))
                 from VoucherDetail d join Voucher v on v.TNo=d.TNo left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b
                 where d.VoucherDate>=least(b.f-(b.t-b.f),b.t-7) and d.VoucherDate<b.t and v.DocTypeCode in ('RECEIPT') and 1*d.Amount>0
                 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode)
                 and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')
                union all
                select 'PAYMENT',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime,d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),cast(null as varchar2(400)),cast(null as varchar2(400)),cast(null as varchar2(400)),-1*d.Amount,cast(null as number),0,v.Creator,nvl(ds.status,'Not recorded'),cast(substr(d.Narration,1,400) as varchar2(400))
                 from VoucherDetail d join Voucher v on v.TNo=d.TNo left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b
                 where d.VoucherDate>=least(b.f-(b.t-b.f),b.t-7) and d.VoucherDate<b.t and v.DocTypeCode in ('PAYMENT','CASHPAYMENT','BANKPAYMENT') and -1*d.Amount>0
                 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode)
                 and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')), C as (select /*+ materialize */ e.* from E e cross join B b where e.event_date>=b.f), M as (select metric,count(distinct case when event_date>=b.f then doc_id end) docs,sum(case when event_date>=b.f then amount end) amount,
                 count(distinct case when event_date>=b.f-(b.t-b.f) and event_date<b.f then doc_id end) prior_docs,sum(case when event_date>=b.f-(b.t-b.f) and event_date<b.f then amount end) prior_amount,max(event_date) latest,sum(case when event_date>=b.f then currency_gap end) currency_gap from E cross join B b group by metric),
                 D as (select metric,trunc(event_date,'MM') month,sum(amount) amount,count(distinct doc_id) docs from C group by metric,trunc(event_date,'MM')),
                 L as (select metric,location_code,count(distinct doc_id) docs,sum(amount) amount from C group by metric,location_code),
                 U as (select metric,unit_code,sum(quantity) quantity,sum(amount) amount from C where quantity is not null group by metric,unit_code),
                 P0 as (select metric,'PARTY' dim,party_code code,sum(amount) amount,count(distinct doc_id) docs from C where party_code is not null and metric in ('BILLING','PURCHASE') group by metric,party_code
                 union all select metric,'ITEM',item_code,sum(amount),count(distinct doc_id) from C where item_code is not null and metric='BILLING' group by metric,item_code
                 union all select metric,'CATEGORY',category_code,sum(amount),count(distinct doc_id) from C where category_code is not null and metric='BILLING' group by metric,category_code),
                 P as (select p0.*,count(*) over(partition by metric,dim) total,row_number() over(partition by metric,dim order by amount desc nulls last,code) hi,row_number() over(partition by metric,dim order by amount asc nulls last,code) lo from P0),
                 PT as (select e.metric,e.party_code,trunc(e.event_date) day,sum(e.amount) amount from E e cross join B b where e.event_date>=b.t-7 and e.metric in ('BILLING','PURCHASE') and exists(select 1 from P where P.metric=e.metric and P.dim='PARTY' and P.code=e.party_code and (hi<=10 or lo<=10)) group by e.metric,e.party_code,trunc(e.event_date)),
                 T as (select metric,doc_id,doc_no,max(logged_at) logged_at,max(event_date) event_date,sum(amount) amount,row_number() over(order by max(logged_at) desc nulls last,doc_id desc) rn from C group by metric,doc_id,doc_no)
                 select json_object('asof' value to_char(b.clock,'DD Mon YYYY HH24:MI:SS'),
                 'metrics' value (select json_arrayagg(json_object('key' value metric,'docs' value docs,'amount' value amount,'prior_docs' value prior_docs,'prior_amount' value prior_amount,'latest' value to_char(latest,'DD Mon YYYY'),'currency_gap' value currency_gap) returning clob) from M) format json,
                 'trend' value (select json_arrayagg(json_object('key' value metric,'month' value to_char(month,'YYYY-MM'),'amount' value amount,'docs' value docs) order by month returning clob) from D) format json,
                 'locations' value (select json_arrayagg(json_object('key' value metric,'code' value location_code,'name' value nvl((select LocationName from Location where LocationCode=L.location_code),L.location_code),'amount' value amount,'docs' value docs) returning clob) from L) format json,
                 'units' value (select json_arrayagg(json_object('key' value metric,'code' value unit_code,'name' value nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=U.unit_code),'Unit not recorded'),'qty' value quantity,'amount' value amount) returning clob) from U) format json,
                 'ranks' value (select json_arrayagg(json_object('key' value metric,'dim' value dim,'code' value code,'name' value case dim when 'PARTY' then nvl((select PartyName from Party where PartyCode=P.code),P.code) when 'ITEM' then (select ItemName from Item where ItemCode=P.code) else (select ItemCategoryName from ItemCategory where ItemCategoryCode=P.code) end,'amount' value amount,'docs' value docs,'total' value total,'hi' value hi,'lo' value lo) returning clob) from P where hi<=10 or lo<=10) format json,
                 'sparks' value (select json_arrayagg(json_object('key' value metric,'code' value party_code,'day' value to_char(day,'YYYY-MM-DD'),'amount' value amount) order by day returning clob) from PT) format json,
                 'recent' value (select json_arrayagg(json_object('key' value metric,'id' value to_char(doc_id),'doc' value doc_no,'url' value case when metric in ('QUALITY','FREIGHT') then null else case metric when 'BILLING' then apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>doc_id) when 'PURCHASE' then apex_page.get_url(p_page=>680,p_clear_cache=>'680',p_items=>'P680_TNO',p_values=>doc_id) when 'PO' then apex_page.get_url(p_page=>682,p_clear_cache=>'682',p_items=>'P682_TNO',p_values=>doc_id) when 'SALES_ORDER' then apex_page.get_url(p_page=>734,p_clear_cache=>'734',p_items=>'P734_SOTNO',p_values=>doc_id) when 'COLLECTION' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>doc_id) when 'PAYMENT' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>doc_id) when 'REQUISITION' then apex_page.get_url(p_page=>687,p_clear_cache=>'687',p_items=>'P687_REQTNO',p_values=>doc_id) when 'ISSUE' then apex_page.get_url(p_page=>686,p_clear_cache=>'686',p_items=>'P686_ISSUETNO',p_values=>doc_id) else apex_page.get_url(p_page=>740,p_clear_cache=>'740',p_items=>'P740_METRIC,P740_DOC,P740_FROMDATE,P740_TODATE,P740_COMPANY,P740_LOCATION,P740_PANEL',p_values=>metric||','||doc_id||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL) end end,'recorded' value to_char(logged_at,'DD Mon HH24:MI'),'dated' value to_char(event_date,'DD Mon YYYY'),'amount' value amount) order by rn returning clob) from T where rn<=12) format json returning clob) payload from B b);
                 select json_object('data' value nvl(a,case when 'ACTIVITY' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
