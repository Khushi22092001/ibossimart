                union all
                select 'MAINT_OPEN' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaintenanceRequestNo as varchar2(400)) doc_no,h.MaintenanceRequestDate event_date,h.CompanyCode company_code,h.LocationCode location_code,
                 cast(null as varchar2(400)) party_code,cast(null as number) amount,cast(null as number) quantity,
                 cast(null as varchar2(400)) unit_code,(b.clock-h.MaintenanceRequestDate)*24 age_hours,
                 cast(substr('Equipment: '||(select EquipmentName from Equipment where TNo=h.EquipmentTNo)||'; '||h.NotificationShortText||'; owner '||h.PersonResponsible,1,400) as varchar2(400)) note
                 from MaintenanceRequest h  left join DS ds on ds.ModuleCode='MAINTENANCEREQUEST' and ds.ModuleTNo=h.TNo cross join B b
                 where h.MaintenanceRequestDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION)  and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and not exists(select 1 from EquipmentMaintenanceOrder mo join MaintenanceOrderCompletion c on c.EquipmentMaintenanceOrderTNo=mo.TNo where mo.MaintenanceRequestTNo=h.TNo)
                 and :P735_ALLOW_MAINT='Y'
                union all
                select 'EQUIPMENT_DOWN' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaintenanceRequestNo as varchar2(400)) doc_no,h.MalfunctionStartDateAndTime event_date,h.CompanyCode company_code,h.LocationCode location_code,
                 cast(null as varchar2(400)) party_code,cast(null as number) amount,cast(null as number) quantity,
                 cast(null as varchar2(400)) unit_code,(b.clock-h.MalfunctionStartDateAndTime)*24 age_hours,
                 cast(substr('Equipment: '||(select EquipmentName from Equipment where TNo=h.EquipmentTNo)||'; '||h.NotificationShortText,1,400) as varchar2(400)) note
                 from MaintenanceRequest h  left join DS ds on ds.ModuleCode='MAINTENANCEREQUEST' and ds.ModuleTNo=h.TNo cross join B b
                 where h.MaintenanceRequestDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION)  and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and h.IsEquipmentInBreakdownStatus='YES' and h.MalfunctionEndDateAndTime is null
                 and :P735_ALLOW_MAINT='Y'
                union all
                select 'APPROVAL',q.TNo,cast(null as number),cast(q.MenuLabel as varchar2(400)),nvl(o.ModuleDate,sc.SalesConfirmDate),q.CompanyCode,nvl(o.LocationCode,sc.LocationCode),nvl(o.PartyCode,sc.PartyCode),nvl(o.ModuleAmount,sc.SalesConfirmAmount),cast(null as number),cast(null as varchar2(400)),(b.clock-q.QueueDate)*24,
                 cast(substr(q.ModuleName||'; token '||q.TokenNo||'; '||o.Particulars,1,400) as varchar2(400))
                 from ONTHETABLE_APEX q left join ONTHETABLEALL o on o.TNo=q.TNo left join SalesConfirm sc on q.ModuleCode='SALESCONFIRM' and sc.TNo=q.ModuleTNo cross join B b
                 where (:P735_COMPANY is null or q.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or nvl(o.LocationCode,sc.LocationCode)=:P735_LOCATION)
                 and :P735_PANEL is null), T as (select metric,count(distinct doc_id) docs,count(*) lines,sum(amount) amount,max(age_hours) oldest,avg(age_hours) avg_hours from A group by metric),
                 U as (select metric,unit_code,sum(quantity) quantity from A where quantity is not null group by metric,unit_code),
                 L as (select location_code,count(*) exceptions from A where metric not in ('GATE_COMPLETED','APPROVAL') group by location_code)
                 select json_object('controls' value (select json_arrayagg(json_object('key' value metric,'docs' value docs,'lines' value lines,'amount' value amount,'oldest' value oldest,'avg_hours' value avg_hours) returning clob) from T) format json,
                 'units' value (select json_arrayagg(json_object('key' value metric,'unit' value nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=U.unit_code),'Unit not recorded'),'code' value unit_code,'qty' value quantity) returning clob) from U) format json,
                 'locations' value (select json_arrayagg(json_object('code' value location_code,'name' value nvl((select LocationName from Location where LocationCode=L.location_code),L.location_code),'exceptions' value exceptions) returning clob) from L) format json returning clob) payload from dual);
                 select json_object('data' value nvl(a,case when 'OPERATIONS' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
