    region exEvidencePROFIT (
        name: Company P&L — source postings
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: "with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), W as ( select PartyCode code,connect_by_root NatureOfAccountCode root_nature,connect_by_root PartyCode root_code, regexp_substr(sys_connect_by_path(PartyCode,'~'),'[^~]+',1,2) l2,regexp_substr(sys_connect_by_path(PartyCode,'~'),'[^~]+',1,3) l3,sys_connect_by_path(PartyCode,'~')||'~' path from Party start with ParentCode is null connect by prior PartyCode=ParentCode), E as (select /*+ materialize */ d.TNo,d.SNo,d.VoucherDate,d.AccountCode,d.CompanyCode,d.LocationCode,v.VoucherNo,v.ModuleCode,v.ModuleTNo,d.Amount,substr(d.Narration,1,400) note, case when w.root_code='BALANCESHEET' or w.root_nature in ('ASSETS','LIABILITIES') then 'BALANCE_SHEET' when w.root_nature='INCOME' or w.l2='INCOME' then 'INCOME' when w.root_nature='EXPENSES' or w.l2='EXPENDITURES' then 'EXPENSES' else 'UNCLASSIFIED' end classification, case when d.AccountCode='4274' then 'VARIATION' when instr(w.path,'~DIRECTCOST~')>0 then 'DIRECT' when instr(w.path,'~DEPRECIATION~')>0 then 'DEPRECIATION' when instr(w.path,'~5213~')>0 or instr(w.path,'~5513~')>0 or d.AccountCode in ('5041','30001') then 'FINANCE' else 'OVERHEAD' end cost_bucket from VoucherDetail d join Voucher v on v.TNo=d.TNo left join W w on w.code=d.AccountCode left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b where d.VoucherDate>=b.f and d.VoucherDate<b.t and nvl(v.VoucherNo,'~')<>'OPENING' and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')), P as (select e.*,case when classification='INCOME' then 'INCOME' when classification='EXPENSES' then cost_bucket else classification end bucket from E e) select p.classification CLASSIFICATION,p.bucket COST_CATEGORY,nvl((select PartyName from Party where PartyCode=p.AccountCode),p.AccountCode) ACCOUNT,p.VoucherNo DOCUMENT_NO,p.VoucherDate POSTING_DATE, nvl((select ModuleName from Module where ModuleCode=p.ModuleCode),p.ModuleCode) SOURCE_MODULE, case p.ModuleCode when 'CCINVOICE' then (select CCInvoiceNo from CCInvoice where TNo=p.ModuleTNo) when 'INVOICE' then (select InvoiceNo from Invoice where TNo=p.ModuleTNo) when 'ISSUE' then (select IssueNo from Issue where TNo=p.ModuleTNo) when 'PRODUCTION' then (select ProductionNo from Production where TNo=p.ModuleTNo) when 'PBPASS' then (select PBPassNo from PBPass where TNo=p.ModuleTNo) else to_char(p.ModuleTNo) end SOURCE_DOCUMENT, (select CompanyName from Company where CompanyCode=p.CompanyCode) COMPANY,nvl((select LocationName from Location where LocationCode=p.LocationCode),p.LocationCode) LOCATION,p.Amount SIGNED_AMOUNT, case when p.Amount<0 then -p.Amount else 0 end DEBIT,case when p.Amount>0 then p.Amount else 0 end CREDIT,p.note NOTES,'<a href=\"'||apex_escape.html_attribute(apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>p.TNo))||'\">Voucher 360</a>'||case when p.ModuleCode='CCINVOICE' then ' · '||'<a href=\"'||apex_escape.html_attribute(apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>p.ModuleTNo))||'\">Invoice 360</a>' end RELATED_360 from P p where :P735_FAMILY='PROFIT' and (:P735_METRIC='ALL' or :P735_METRIC=p.classification or (:P735_METRIC='RESULT' and p.classification in ('INCOME','EXPENSES'))) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='BUCKET' and p.bucket=:P735_DIMVALUE) or (:P735_DIMTYPE='VOUCHER' and to_char(p.TNo)=:P735_DIMVALUE) or (:P735_DIMTYPE='ACCOUNT' and p.AccountCode=:P735_DIMVALUE) or (:P735_DIMTYPE='MONTH' and to_char(p.VoucherDate,'YYYY-MM')=:P735_DIMVALUE) or (:P735_DIMTYPE='LOCATION' and p.LocationCode=:P735_DIMVALUE) or (:P735_DIMTYPE='OTHER_ACCOUNT' and p.AccountCode not in (select column_value from table(apex_string.split(:P735_DIMVALUE,'|')))))"
            pageItemsToSubmit: [
                P735_COMPANY
                P735_LOCATION
                P735_FROMDATE
                P735_TODATE
                P735_PANEL
                P735_ITEM
                P735_SPEC
                P735_CATEGORY
