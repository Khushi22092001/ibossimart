    process exec-finance (
        name: EXEC_FINANCE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare v clob;a clob;j apex_json.t_values;begin
                 if apex_application.g_x01 is not null then apex_json.parse(j,apex_application.g_x01);:P735_COMPANY:=apex_json.get_varchar2(p_path=>'COMPANY',p_values=>j);
                :P735_LOCATION:=apex_json.get_varchar2(p_path=>'LOCATION',p_values=>j);
                :P735_FROMDATE:=apex_json.get_varchar2(p_path=>'FROMDATE',p_values=>j);
                :P735_TODATE:=apex_json.get_varchar2(p_path=>'TODATE',p_values=>j);
                :P735_PANEL:=apex_json.get_varchar2(p_path=>'PANEL',p_values=>j);
                :P735_ITEM:=apex_json.get_varchar2(p_path=>'ITEM',p_values=>j);
                :P735_SPEC:=apex_json.get_varchar2(p_path=>'SPEC',p_values=>j);
                :P735_CATEGORY:=apex_json.get_varchar2(p_path=>'CATEGORY',p_values=>j);end if;
                 if :P735_FROMDATE is null or :P735_TODATE is null or to_date(:P735_TODATE,'DD-MM-RRRR')<to_date(:P735_FROMDATE,'DD-MM-RRRR') or to_date(:P735_TODATE,'DD-MM-RRRR')-to_date(:P735_FROMDATE,'DD-MM-RRRR')>365 or to_date(:P735_TODATE,'DD-MM-RRRR')>trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) then raise_application_error(-20001,'Choose valid dates through today, up to 366 days.');end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if;
                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), AC as (
                 select PartyCode code,'AR' kind,-1 sign from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode
                 union all select PartyCode,'AP',1 from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode),
                 VD as (select /*+ materialize */ d.*,v.VoucherNo,v.ModuleCode source_module,v.ModuleTNo source_id,v.DocTypeCode,a.kind,a.sign
                 from VoucherDetail d join Voucher v on v.TNo=d.TNo join AC a on a.code=d.AccountCode
                 left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b where d.VoucherDate<b.t and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')),
                 A0 as (select x.DrVoucherTNo tno,x.DrVoucherSNo sno,-sum(x.Amount) amount from DrCrAllocation x join Voucher dv on dv.TNo=x.DrVoucherTNo join Voucher cv on cv.TNo=x.CrVoucherTNo cross join B b
                 where dv.VoucherDate<b.t and cv.VoucherDate<b.t and exists(select 1 from VD where VD.TNo=x.DrVoucherTNo and VD.SNo=x.DrVoucherSNo) group by x.DrVoucherTNo,x.DrVoucherSNo
                 union all select x.CrVoucherTNo,x.CrVoucherSNo,sum(x.Amount) from DrCrAllocation x join Voucher dv on dv.TNo=x.DrVoucherTNo join Voucher cv on cv.TNo=x.CrVoucherTNo cross join B b
                 where dv.VoucherDate<b.t and cv.VoucherDate<b.t and exists(select 1 from VD where VD.TNo=x.CrVoucherTNo and VD.SNo=x.CrVoucherSNo) group by x.CrVoucherTNo,x.CrVoucherSNo),
                 AL as (select tno,sno,sum(amount) amount from A0 group by tno,sno),
                 O0 as (select d.kind,d.TNo,d.SNo,d.VoucherNo,d.VoucherDate,d.CompanyCode,d.LocationCode,d.AccountCode,d.source_module,d.source_id,
                 coalesce(i.InvoiceNo,pb.PBPassNo,sb.ServiceBillNo,ao.BillNo,d.VoucherNo) source_no,
                 coalesce(i.InvoiceDate,pb.PBPassDate,sb.ServiceBillDate,ao.BillDate,d.VoucherDate) document_date,
                 coalesce(i.DueDate,pb.DueDate,sb.DueDate,ao.BillDueDate) due_date,
                 d.sign*d.Amount original_amount,d.sign*nvl(al.amount,0) allocated,d.sign*(d.Amount-nvl(al.amount,0)) residual,d.DocTypeCode
                 from VD d left join AL al on al.tno=d.TNo and al.sno=d.SNo
                 left join Invoice i on d.source_module='INVOICE' and i.TNo=d.source_id
                 left join PBPass pb on d.source_module='PBPASS' and pb.TNo=d.source_id
                 left join ServiceBill sb on d.source_module='SERVICEBILL' and sb.TNo=d.source_id
                 left join AccountOpening ao on d.VoucherNo='OPENING' and ao.TNo=d.ModuleTNo),
                 O as (select o0.*,case when residual<0 then 'CREDIT' when due_date is null then 'UNKNOWN' when due_date>=b.t-1 then 'NOT_DUE'
                 when b.t-1-trunc(due_date)<=30 then 'D1_30' when b.t-1-trunc(due_date)<=60 then 'D31_60' when b.t-1-trunc(due_date)<=90 then 'D61_90' when b.t-1-trunc(due_date)<=180 then 'D91_180' else 'D180' end bucket,
                 case when due_date is not null then greatest(b.t-1-trunc(due_date),0) end days_overdue from O0 cross join B b where abs(residual)>.005), T as (select kind,sum(case when residual>0 then residual else 0 end) gross,sum(case when residual<0 then -residual else 0 end) credits,sum(residual) net,
                 sum(case when residual>0 and days_overdue>0 then residual else 0 end) overdue,sum(case when residual>0 and days_overdue>90 then residual else 0 end) overdue90,
                 sum(case when residual>0 and due_date is null then residual else 0 end) unknown_due,
                 count(*) lines,count(distinct case when residual>0 and days_overdue>0 then TNo end) overdue_docs,
                 sum(case when residual>0 and due_date>=b.t-1 and due_date<b.t-1+7 then residual else 0 end) next7,
                 sum(case when residual>0 and due_date>=b.t-1 and due_date<b.t-1+30 then residual else 0 end) next30 from O cross join B b group by kind),
                 G as (select kind,bucket,sum(residual) amount,count(*) lines from O group by kind,bucket),
                 L as (select kind,LocationCode code,sum(case when residual>0 then residual else 0 end) amount,sum(residual) net from O group by kind,LocationCode),
                 P as (select kind,AccountCode code,sum(case when residual>0 then residual else 0 end) amount,sum(case when residual<0 then -residual else 0 end) credit,row_number() over(partition by kind order by sum(case when residual>0 then residual else 0 end) desc) rn from O group by kind,AccountCode)
                 select json_object('totals' value (select json_arrayagg(json_object('kind' value kind,'gross' value gross,'credits' value credits,'net' value net,'overdue' value overdue,'overdue90' value overdue90,'unknown' value unknown_due,'lines' value lines,'overdue_docs' value overdue_docs,'next7' value next7,'next30' value next30) returning clob) from T) format json,
                 'buckets' value (select json_arrayagg(json_object('kind' value kind,'bucket' value bucket,'amount' value amount,'lines' value lines) returning clob) from G) format json,
                 'locations' value (select json_arrayagg(json_object('kind' value kind,'code' value code,'name' value nvl((select LocationName from Location where LocationCode=L.code),L.code),'amount' value amount,'net' value net) returning clob) from L) format json,
                 'parties' value (select json_arrayagg(json_object('kind' value kind,'code' value code,'name' value nvl((select PartyName from Party where PartyCode=P.code),P.code),'amount' value amount,'credit' value credit) order by rn returning clob) from P where rn<=10) format json returning clob) payload from dual);
                 select json_object('data' value nvl(a,case when 'FINANCE' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 900735083100020
        }
    )

    process exec-flow (
        name: EXEC_FLOW
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare v clob;a clob;j apex_json.t_values;begin
                 if apex_application.g_x01 is not null then apex_json.parse(j,apex_application.g_x01);:P735_COMPANY:=apex_json.get_varchar2(p_path=>'COMPANY',p_values=>j);
                :P735_LOCATION:=apex_json.get_varchar2(p_path=>'LOCATION',p_values=>j);
                :P735_FROMDATE:=apex_json.get_varchar2(p_path=>'FROMDATE',p_values=>j);
                :P735_TODATE:=apex_json.get_varchar2(p_path=>'TODATE',p_values=>j);
                :P735_PANEL:=apex_json.get_varchar2(p_path=>'PANEL',p_values=>j);
                :P735_ITEM:=apex_json.get_varchar2(p_path=>'ITEM',p_values=>j);
                :P735_SPEC:=apex_json.get_varchar2(p_path=>'SPEC',p_values=>j);
                :P735_CATEGORY:=apex_json.get_varchar2(p_path=>'CATEGORY',p_values=>j);end if;
                 if :P735_FROMDATE is null or :P735_TODATE is null or to_date(:P735_TODATE,'DD-MM-RRRR')<to_date(:P735_FROMDATE,'DD-MM-RRRR') or to_date(:P735_TODATE,'DD-MM-RRRR')-to_date(:P735_FROMDATE,'DD-MM-RRRR')>365 or to_date(:P735_TODATE,'DD-MM-RRRR')>trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) then raise_application_error(-20001,'Choose valid dates through today, up to 366 days.');end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if;
                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), V as (
                 select /*+ materialize */ d.TNo,d.LocationCode,d.CompanyCode,v.VoucherNo,v.DocTypeCode,min(d.VoucherDate) event_date,-sum(d.Amount) movement,
                 sum(case when d.Amount<0 then -d.Amount else 0 end) gross_in,sum(case when d.Amount>0 then d.Amount else 0 end) gross_out
                 from VoucherDetail d join Voucher v on v.TNo=d.TNo join Party p on p.PartyCode=d.AccountCode
                 left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b
                 where d.VoucherDate>=b.f and d.VoucherDate<b.t and nvl(v.VoucherNo,'~')<>'OPENING' and p.PartyTypeCode in ('CASH','BANK') and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 group by d.TNo,d.LocationCode,d.CompanyCode,v.VoucherNo,v.DocTypeCode),
                 C as (select d.TNo,d.CompanyCode,d.LocationCode,count(distinct d.AccountCode) accounts,min(d.AccountCode) account_code,
                 listagg(distinct p.PartyName,', ' on overflow truncate '…' without count) within group(order by p.PartyName) counterparts
                 from VoucherDetail d join Party p on p.PartyCode=d.AccountCode cross join B b
                 where nvl(p.PartyTypeCode,'~') not in ('CASH','BANK') and exists(select 1 from V where V.TNo=d.TNo) and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL)
                 group by d.TNo,d.CompanyCode,d.LocationCode), F as (select v.*,case when abs(v.movement)<=.005 then 'TRANSFER' when v.movement>0 then 'IN' else 'OUT' end direction,
                 case when c.accounts=1 then c.account_code end counter_code,nvl(c.counterparts,'Cash / bank transfer or no counterpart in scope') counterparts,
                 case when c.accounts=1 then nvl((select PartyName from Party where PartyCode=c.account_code),c.account_code) when c.accounts>1 then 'Multiple accounts — see voucher' else 'Cash / bank transfer' end counter_group from V v left join C c on c.TNo=v.TNo and c.CompanyCode=v.CompanyCode and nvl(c.LocationCode,'~')=nvl(v.LocationCode,'~')), T as (select direction,sum(abs(movement)) amount,count(*) documents,sum(least(gross_in,gross_out)) offset_amount from F group by direction),
                 G as (select direction,counter_group name,sum(abs(movement)) amount,count(*) documents,row_number() over(partition by direction order by sum(abs(movement)) desc) rn from F where direction<>'TRANSFER' group by direction,counter_group),
                 M as (select to_char(event_date,'YYYY-MM') month,sum(case when movement>0 then movement else 0 end) inflow,sum(case when movement<0 then -movement else 0 end) outflow,sum(movement) net from F group by to_char(event_date,'YYYY-MM')),
                 D as (select greatest(b.f,b.t-7)+level-1 day from B b connect by level<=least(7,b.t-b.f)),
                 S as (select g.direction,g.name,d.day,nvl(sum(abs(f.movement)),0) amount from G g cross join D d left join F f on f.direction=g.direction and f.counter_group=g.name and f.event_date>=d.day and f.event_date<d.day+1 where g.rn<=8 group by g.direction,g.name,d.day)
                 select json_object('totals' value (select json_arrayagg(json_object('key' value direction,'amount' value amount,'documents' value documents,'offset' value offset_amount) returning clob) from T) format json,
                 'drivers' value (select json_arrayagg(json_object('key' value direction,'name' value name,'amount' value amount,'documents' value documents) order by rn returning clob) from G where rn<=8) format json,
                 'sparks' value (select json_arrayagg(json_object('key' value direction,'name' value name,'day' value to_char(day,'YYYY-MM-DD'),'amount' value amount) order by direction,name,day returning clob) from S) format json,
                 'trend' value (select json_arrayagg(json_object('month' value month,'inflow' value inflow,'outflow' value outflow,'net' value net) order by month returning clob) from M) format json returning clob) payload from dual);
                 select json_object('data' value nvl(a,case when 'FLOW' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
                ```
        }
