                :P735_CATEGORY:=apex_json.get_varchar2(p_path=>'CATEGORY',p_values=>j);end if;
                 if :P735_FROMDATE is null or :P735_TODATE is null or to_date(:P735_TODATE,'DD-MM-RRRR')<to_date(:P735_FROMDATE,'DD-MM-RRRR') or to_date(:P735_TODATE,'DD-MM-RRRR')-to_date(:P735_FROMDATE,'DD-MM-RRRR')>365 or to_date(:P735_TODATE,'DD-MM-RRRR')>trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) then raise_application_error(-20001,'Choose valid dates through today, up to 366 days.');end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if;
                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), E as (select 'ENTRY' metric,'Inbound material' purpose,h.TNo,h.MaterialInNo doc_no,h.GateInTime event_date,h.CompanyCode,h.LocationCode,h.TransporterCode,h.VehicleNo,
                 cast(null as number) amount,cast(null as number) net_payable,h.GateInTime gate_in,h.GateOutTime gate_out from MaterialIn h left join DS ds on ds.ModuleCode='MATERIALIN' and ds.ModuleTNo=h.TNo cross join B b where h.GateInTime>=b.f and h.GateInTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')
                union all
                select 'EXIT' metric,'Inbound material' purpose,h.TNo,h.MaterialInNo doc_no,h.GateOutTime event_date,h.CompanyCode,h.LocationCode,h.TransporterCode,h.VehicleNo,
                 cast(null as number) amount,cast(null as number) net_payable,h.GateInTime gate_in,h.GateOutTime gate_out from MaterialIn h left join DS ds on ds.ModuleCode='MATERIALIN' and ds.ModuleTNo=h.TNo cross join B b where h.GateOutTime>=b.f and h.GateOutTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')
                union all
                select 'ENTRY' metric,'Outbound dispatch' purpose,h.TNo,h.MaterialOutNo doc_no,h.GateInTime event_date,h.CompanyCode,h.LocationCode,h.TransporterCode,h.VehicleNo,
                 cast(null as number) amount,cast(null as number) net_payable,h.GateInTime gate_in,h.GateOutTime gate_out from MaterialOut h left join DS ds on ds.ModuleCode='MATERIALOUT' and ds.ModuleTNo=h.TNo cross join B b where h.GateInTime>=b.f and h.GateInTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')
                union all
