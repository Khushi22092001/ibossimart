    region exEvidencePERFORMANCE (
        name: Quality, receipt timing and rate evidence
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), R as ( select h.TNo,h.GRNNo doc_no,h.GRNDate event_date,h.CompanyCode,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,i.MeasuringUnitCode1, coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,nvl(d.ReceivedQuantity1,0) received,nvl(d.RejectedQuantity1,0) rejected,d.Amount from GRN h join GRNDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='GRN' and ds.ModuleTNo=h.TNo cross join B b where h.GRNDate>=b.f and h.GRNDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)), F as (select h.TNo,h.ProductionNo doc_no,h.ProductionDate event_date,h.CompanyCode,h.LocationCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,i.MeasuringUnitCode1,i.ItemNatureCode,d.Quantity1 quantity from Production h join ProductionFinished d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='PRODUCTION' and ds.ModuleTNo=h.TNo cross join B b where h.ProductionDate>=b.f and h.ProductionDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)), G as (select g.PurchaseOrderTNo,min(g.GRNDate) first_receipt from GRN g left join DS ds on ds.ModuleCode='GRN' and ds.ModuleTNo=g.TNo cross join B b where g.GRNDate<b.t and (:P735_COMPANY is null or g.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or g.LocationCode=:P735_LOCATION) and (b.enforced is null or g.Panel=b.enforced) and (:P735_PANEL is null or g.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and ((:P735_ITEM is null and :P735_SPEC is null and :P735_CATEGORY is null) or exists(select 1 from GRNDetail gd left join Item gi on gi.ItemCode=gd.ItemCode left join ItemSpecification gs on gs.ItemSpecificationCode=gd.ItemSpecificationCode where gd.TNo=g.TNo and (:P735_ITEM is null or gd.ItemCode=:P735_ITEM) and (:P735_SPEC is null or gd.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(gs.ItemCategoryCode,gi.ItemCategoryCode)=:P735_CATEGORY))) group by g.PurchaseOrderTNo), D as (select h.TNo,h.PurchaseOrderNo doc_no,h.PurchaseOrderDate event_date,h.DeliveryDate,h.CompanyCode,h.LocationCode,h.PartyCode,g.first_receipt, g.first_receipt-h.PurchaseOrderDate lead_days,case when h.DeliveryDate is not null and g.first_receipt<=h.DeliveryDate then 1 else 0 end on_time, case when nvl(h.CurrencyValue,1)=1 then (select sum(d.Amount) from PurchaseOrderDetail d left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode where d.TNo=h.TNo and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)) end order_value from PurchaseOrder h join G g on g.PurchaseOrderTNo=h.TNo left join DS ds on ds.ModuleCode='PURCHASEORDER' and ds.ModuleTNo=h.TNo cross join B b where g.first_receipt>=b.f and g.first_receipt<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and exists(select 1 from PurchaseOrderDetail d left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode where d.TNo=h.TNo and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY))), PL as (select d.TNo,d.ItemCode,d.ItemSpecificationCode,min(d.Rate) rate,min(d.RateMeasuringUnitCode) unit_code,count(*) candidates from PurchaseOrderDetail d where upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') group by d.TNo,d.ItemCode,d.ItemSpecificationCode), PV as (select h.TNo,h.PurchaseBillNo doc_no,h.PurchaseBillDate event_date,h.CompanyCode,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,d.Quantity1 quantity,d.Rate actual_rate,pl.rate order_rate,(d.Rate-pl.rate)*d.Quantity1 variance, i.MeasuringUnitCode1,po.PurchaseOrderNo po_no,po.TNo po_id from PurchaseBill h join PurchaseBillDetail d on d.TNo=h.TNo join PL pl on pl.TNo=d.PurchaseOrderTNo and pl.ItemCode=d.ItemCode and nvl(pl.ItemSpecificationCode,'~')=nvl(d.ItemSpecificationCode,'~') and pl.candidates=1 join PurchaseOrder po on po.TNo=pl.TNo join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='PURCHASEBILL' and ds.ModuleTNo=h.TNo cross join B b where h.PurchaseBillDate>=b.f and h.PurchaseBillDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and nvl(h.CurrencyValue,1)=1 and nvl(po.CurrencyValue,1)=1 and d.RateMeasuringUnitCode=pl.unit_code and pl.unit_code=i.MeasuringUnitCode1 and d.Quantity1>0 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)), E as ( select 'RECEIPTS' metric,r.TNo,r.SNo,r.doc_no,r.event_date,r.LocationCode,r.PartyCode,r.ItemCode,r.ItemSpecificationCode,r.MeasuringUnitCode1,r.received quantity,r.rejected second_quantity, r.Amount amount,cast(null as number) rate,cast(null as number) reference_rate,cast(null as date) reference_date,'Received quantity / rejected quantity' note,'<a href="'||apex_escape.html_attribute(case 'GRN' when 'BILLING' then apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>r.TNo) when 'PURCHASE' then apex_page.get_url(p_page=>680,p_clear_cache=>'680',p_items=>'P680_TNO',p_values=>r.TNo) when 'PO' then apex_page.get_url(p_page=>682,p_clear_cache=>'682',p_items=>'P682_TNO',p_values=>r.TNo) when 'SALES_ORDER' then apex_page.get_url(p_page=>734,p_clear_cache=>'734',p_items=>'P734_SOTNO',p_values=>r.TNo) when 'COLLECTION' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>r.TNo) when 'PAYMENT' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>r.TNo) when 'REQUISITION' then apex_page.get_url(p_page=>687,p_clear_cache=>'687',p_items=>'P687_REQTNO',p_values=>r.TNo) when 'ISSUE' then apex_page.get_url(p_page=>686,p_clear_cache=>'686',p_items=>'P686_ISSUETNO',p_values=>r.TNo) else apex_page.get_url(p_page=>740,p_clear_cache=>'740',p_items=>'P740_METRIC,P740_DOC,P740_FROMDATE,P740_TODATE,P740_COMPANY,P740_LOCATION,P740_PANEL',p_values=>'GRN'||','||r.TNo||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL) end)||'">Receipt 360</a>' related from R r union all select 'PRODUCTION',f.TNo,f.SNo,f.doc_no,f.event_date,f.LocationCode,cast(null as varchar2(400)),f.ItemCode,f.ItemSpecificationCode,f.MeasuringUnitCode1,f.quantity,case when f.ItemNatureCode='SCRAP' then f.quantity else 0 end,null,null,null,null,'Output quantity / classified scrap output; not process loss','<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>740,p_clear_cache=>'740',p_items=>'P740_METRIC,P740_DOC',p_values=>'PRODUCTION,'||f.TNo))||'">Production 360</a>' from F f union all select 'DELIVERY',d.TNo,null,d.doc_no,d.event_date,d.LocationCode,d.PartyCode,null,null,null,null,null,d.order_value,null,null,d.first_receipt,'Promise date: '||to_char(d.DeliveryDate,'DD Mon YYYY')||'; first receipt lead days: '||round(d.lead_days,1)||case when d.DeliveryDate is null then '; missing promise' when d.on_time=1 then '; on time' else '; late' end,'<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>682,p_clear_cache=>'682',p_items=>'P682_TNO',p_values=>d.TNo))||'">Purchase Order 360</a>' from D d union all select 'PRICE',p.TNo,p.SNo,p.doc_no,p.event_date,p.LocationCode,p.PartyCode,p.ItemCode,p.ItemSpecificationCode,p.MeasuringUnitCode1,p.quantity,null,p.variance,p.actual_rate,p.order_rate,null,'Matched PO '||p.po_no||'; same rate/quantity unit; line-rate difference before footer charges','<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>680,p_clear_cache=>'680',p_items=>'P680_TNO',p_values=>p.TNo))||'">Purchase Bill 360</a>'||' '||'<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>682,p_clear_cache=>'682',p_items=>'P682_TNO',p_values=>p.po_id))||'">Purchase Order 360</a>' from PV p) select e.metric ANALYSIS,e.doc_no DOCUMENT_NO,e.event_date DOCUMENT_DATE,nvl((select LocationName from Location where LocationCode=e.LocationCode),e.LocationCode) LOCATION,nvl((select PartyName from Party where PartyCode=e.PartyCode),e.PartyCode) PARTY, (select ItemName from Item where ItemCode=e.ItemCode) ITEM,(select ItemSpecificationName from ItemSpecification where ItemSpecificationCode=e.ItemSpecificationCode) SPECIFICATION, e.quantity QUANTITY,e.second_quantity REJECTED_OR_SCRAP_QTY,nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=e.MeasuringUnitCode1),'Unit not recorded') UNIT,e.amount AMOUNT_OR_VARIANCE,e.rate ACTUAL_RATE,e.reference_rate ORDER_RATE,e.reference_date FIRST_RECEIPT,e.note NOTES,e.related RELATED_360 from E e where :P735_FAMILY='PERFORMANCE' and (:P735_METRIC='ALL' or :P735_METRIC=e.metric) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='UNIT' and nvl(e.MeasuringUnitCode1,'~')=:P735_DIMVALUE) or (:P735_DIMTYPE='PARTY' and e.PartyCode=:P735_DIMVALUE) or (:P735_DIMTYPE='ADVERSE' and e.metric='PRICE' and e.amount>0) or (:P735_DIMTYPE in ('QMONTH','QPARTY','QITEM') and e.metric='RECEIPTS' and nvl(e.MeasuringUnitCode1,'~')=substr(:P735_DIMVALUE,1,instr(:P735_DIMVALUE,'|')-1) and ((:P735_DIMTYPE='QMONTH' and to_char(e.event_date,'YYYY-MM')=substr(:P735_DIMVALUE,instr(:P735_DIMVALUE,'|')+1)) or (:P735_DIMTYPE='QPARTY' and e.PartyCode=substr(:P735_DIMVALUE,instr(:P735_DIMVALUE,'|')+1)) or (:P735_DIMTYPE='QITEM' and e.ItemCode=substr(:P735_DIMVALUE,instr(:P735_DIMVALUE,'|')+1)))))
            pageItemsToSubmit: [
