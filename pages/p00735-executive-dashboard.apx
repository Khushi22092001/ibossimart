    region exEvidenceSTOCK (
        name: Stock layers and movements
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual), FY as (select max(FinancialYearBegin) fy from FinancialYear cross join B b where b.t-1 between FinancialYearBegin and FinancialYearEnd), S0 as (select /*+ materialize */ s.TNo,s.StockDate,s.CompanyCode,s.LocationCode,s.ItemCode,s.ItemSpecificationCode,s.StorageLocationCode,s.StockQuantity1,s.Rate,i.ItemName,i.ItemNatureCode,i.MeasuringUnitCode1,sp.ItemSpecificationName,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code from Stock s left join Item i on i.ItemCode=s.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=s.ItemSpecificationCode cross join B b cross join FY where s.StockDate>=FY.fy and s.StockDate<b.t and (:P735_COMPANY is null or s.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or s.LocationCode=:P735_LOCATION) and (b.enforced is null or s.Panel=b.enforced) and (:P735_PANEL is null or s.Panel=:P735_PANEL) and (:P735_ITEM is null or s.ItemCode=:P735_ITEM) and (:P735_SPEC is null or s.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)), U as (select u.StockTNo,sum(u.UsedStockQuantity1) used,max(u.UsedStockDate) last_used from UsedStock u cross join B b where u.UsedStockDate<b.t and exists(select 1 from S0 where S0.TNo=u.StockTNo) group by u.StockTNo), S as (select s0.*,nvl(u.used,0) used_qty,s0.StockQuantity1-nvl(u.used,0) qty,(s0.StockQuantity1-nvl(u.used,0))*s0.Rate amount, greatest(s0.StockDate,nvl(u.last_used,s0.StockDate)) last_movement, b.t-1-trunc(greatest(s0.StockDate,nvl(u.last_used,s0.StockDate))) idle_days from S0 left join U u on u.StockTNo=s0.TNo cross join B b) select s.TNo STOCK_LAYER,s.StockDate STOCK_DATE,(select CompanyName from Company where CompanyCode=s.CompanyCode) COMPANY,nvl((select LocationName from Location where LocationCode=s.LocationCode),s.LocationCode) LOCATION,s.ItemName ITEM,s.ItemSpecificationName SPECIFICATION, (select ItemCategoryName from ItemCategory where ItemCategoryCode=s.category_code) CATEGORY,nvl((select ItemNatureName from ItemNature where ItemNatureCode=s.ItemNatureCode),s.ItemNatureCode) NATURE,s.StockQuantity1 ORIGINAL_QTY,s.used_qty USED_QTY,s.qty STOCK_QTY,nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=s.MeasuringUnitCode1),'Unit not recorded') UNIT,s.Rate RATE,s.amount STOCK_VALUE,s.last_movement LAST_MOVEMENT,s.idle_days INACTIVE_DAYS, '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>679,p_clear_cache=>'679',p_items=>'P679_ITEMCODE,P679_FROMDATE,P679_TODATE,P679_COMPANY,P679_LOCATION,P679_PANEL',p_values=>s.ItemCode||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL))||'">Item 360</a>'||' '||'<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>681,p_clear_cache=>'681',p_items=>'P681_ITEMCODE,P681_SPEC,P681_FROMDATE,P681_TODATE,P681_COMPANY,P681_LOCATION,P681_PANEL',p_values=>s.ItemCode||','||nvl(s.ItemSpecificationCode,'~NONE~')||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL))||'">Specification 360</a>' RELATED_360 from S s where :P735_FAMILY='STOCK' and abs(s.qty)>.000001 and (:P735_METRIC='ALL' or (:P735_METRIC='NEGATIVE' and s.qty<0) or (:P735_METRIC='UNPRICED' and s.Rate is null) or (:P735_METRIC='IDLE90' and s.qty>0 and s.idle_days>=90) or (:P735_METRIC='IDLE180' and s.qty>0 and s.idle_days>=180)) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='NATURE' and nvl(s.ItemNatureCode,'Unclassified')=:P735_DIMVALUE) or (:P735_DIMTYPE='LOCATION' and s.LocationCode=:P735_DIMVALUE) or (:P735_DIMTYPE='ITEM' and s.ItemCode=:P735_DIMVALUE))
            pageItemsToSubmit: [
