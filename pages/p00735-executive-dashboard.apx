                 cast(null as number) amount,cast(null as number) net_payable,h.GateInTime gate_in,h.GateOutTime gate_out from MaterialOut h left join DS ds on ds.ModuleCode='MATERIALOUT' and ds.ModuleTNo=h.TNo cross join B b where h.GateOutTime>=b.f and h.GateOutTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')
                union all
                select 'FREIGHT','Freight advice',h.TNo,h.FreightAdviceNo,h.FreightAdviceDate,h.CompanyCode,h.LocationCode,h.TransporterCode,cast(null as varchar2(100)),h.FreightAdviceAmount,h.SumOfNetPayableAmount,cast(null as date),cast(null as date) from FreightAdvice h left join DS ds on ds.ModuleCode='FREIGHTADVICE' and ds.ModuleTNo=h.TNo cross join B b where h.FreightAdviceDate>=b.f and h.FreightAdviceDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')), T as (select metric,count(*) documents,sum(amount) amount,sum(net_payable) payable,count(distinct VehicleNo) vehicles from E group by metric),
                 M as (select to_char(event_date,'YYYY-MM') month,sum(case when metric='ENTRY' then 1 else 0 end) entries,sum(case when metric='EXIT' then 1 else 0 end) exits,sum(case when metric='FREIGHT' then amount else 0 end) freight from E group by to_char(event_date,'YYYY-MM')),
                 P as (select TransporterCode code,sum(amount) amount,count(*) documents,row_number() over(order by sum(amount) desc) rn from E where metric='FREIGHT' group by TransporterCode)
