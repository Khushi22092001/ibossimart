                 h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity,
                 cast(null as varchar2(400)) unit_code,(h.GateOutTime-h.GateInTime)*24 age_hours,
                 cast('MaterialIn; vehicle '||h.VehicleNo||'; gate in '||to_char(h.GateInTime,'DD Mon YYYY HH24:MI') as varchar2(400)) note
