                 if :P735_FROMDATE is null or :P735_TODATE is null or to_date(:P735_TODATE,'DD-MM-RRRR')<to_date(:P735_FROMDATE,'DD-MM-RRRR') or to_date(:P735_TODATE,'DD-MM-RRRR')-to_date(:P735_FROMDATE,'DD-MM-RRRR')>365 or to_date(:P735_TODATE,'DD-MM-RRRR')>trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) then raise_application_error(-20001,'Choose valid dates through today, up to 366 days.');end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if;
                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), R as (
                 select h.TNo,h.GRNNo doc_no,h.GRNDate event_date,h.CompanyCode,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,i.MeasuringUnitCode1,
                 coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,nvl(d.ReceivedQuantity1,0) received,nvl(d.RejectedQuantity1,0) rejected,d.Amount
                 from GRN h join GRNDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='GRN' and ds.ModuleTNo=h.TNo cross join B b
                 where h.GRNDate>=b.f and h.GRNDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)),
                 F as (select h.TNo,h.ProductionNo doc_no,h.ProductionDate event_date,h.CompanyCode,h.LocationCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,i.MeasuringUnitCode1,i.ItemNatureCode,d.Quantity1 quantity
                 from Production h join ProductionFinished d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='PRODUCTION' and ds.ModuleTNo=h.TNo cross join B b
                 where h.ProductionDate>=b.f and h.ProductionDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)),
                 G as (select g.PurchaseOrderTNo,min(g.GRNDate) first_receipt from GRN g left join DS ds on ds.ModuleCode='GRN' and ds.ModuleTNo=g.TNo cross join B b where g.GRNDate<b.t and (:P735_COMPANY is null or g.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or g.LocationCode=:P735_LOCATION) and (b.enforced is null or g.Panel=b.enforced) and (:P735_PANEL is null or g.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 and ((:P735_ITEM is null and :P735_SPEC is null and :P735_CATEGORY is null) or exists(select 1 from GRNDetail gd left join Item gi on gi.ItemCode=gd.ItemCode left join ItemSpecification gs on gs.ItemSpecificationCode=gd.ItemSpecificationCode where gd.TNo=g.TNo and (:P735_ITEM is null or gd.ItemCode=:P735_ITEM) and (:P735_SPEC is null or gd.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(gs.ItemCategoryCode,gi.ItemCategoryCode)=:P735_CATEGORY))) group by g.PurchaseOrderTNo),
                 D as (select h.TNo,h.PurchaseOrderNo doc_no,h.PurchaseOrderDate event_date,h.DeliveryDate,h.CompanyCode,h.LocationCode,h.PartyCode,g.first_receipt,
                 g.first_receipt-h.PurchaseOrderDate lead_days,case when h.DeliveryDate is not null and g.first_receipt<=h.DeliveryDate then 1 else 0 end on_time,
                 case when nvl(h.CurrencyValue,1)=1 then (select sum(d.Amount) from PurchaseOrderDetail d left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode where d.TNo=h.TNo and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)) end order_value
                 from PurchaseOrder h join G g on g.PurchaseOrderTNo=h.TNo left join DS ds on ds.ModuleCode='PURCHASEORDER' and ds.ModuleTNo=h.TNo cross join B b
                 where g.first_receipt>=b.f and g.first_receipt<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 and exists(select 1 from PurchaseOrderDetail d left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode where d.TNo=h.TNo and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY))),
                 PL as (select d.TNo,d.ItemCode,d.ItemSpecificationCode,min(d.Rate) rate,min(d.RateMeasuringUnitCode) unit_code,count(*) candidates from PurchaseOrderDetail d where upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') group by d.TNo,d.ItemCode,d.ItemSpecificationCode),
                 PV as (select h.TNo,h.PurchaseBillNo doc_no,h.PurchaseBillDate event_date,h.CompanyCode,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,d.Quantity1 quantity,d.Rate actual_rate,pl.rate order_rate,(d.Rate-pl.rate)*d.Quantity1 variance,
                 i.MeasuringUnitCode1,po.PurchaseOrderNo po_no,po.TNo po_id
                 from PurchaseBill h join PurchaseBillDetail d on d.TNo=h.TNo join PL pl on pl.TNo=d.PurchaseOrderTNo and pl.ItemCode=d.ItemCode and nvl(pl.ItemSpecificationCode,'~')=nvl(d.ItemSpecificationCode,'~') and pl.candidates=1
                 join PurchaseOrder po on po.TNo=pl.TNo join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='PURCHASEBILL' and ds.ModuleTNo=h.TNo cross join B b
                 where h.PurchaseBillDate>=b.f and h.PurchaseBillDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED')
                 and nvl(h.CurrencyValue,1)=1 and nvl(po.CurrencyValue,1)=1 and d.RateMeasuringUnitCode=pl.unit_code and pl.unit_code=i.MeasuringUnitCode1 and d.Quantity1>0
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)), RU as (select MeasuringUnitCode1 code,sum(received) received,sum(rejected) rejected,count(distinct TNo) docs from R group by MeasuringUnitCode1),
                 QM as (select MeasuringUnitCode1 unit_code,to_char(event_date,'YYYY-MM') month,sum(received) received,sum(rejected) rejected from R group by MeasuringUnitCode1,to_char(event_date,'YYYY-MM')),
                 QP as (select MeasuringUnitCode1 unit_code,PartyCode code,sum(received) received,sum(rejected) rejected,row_number() over(partition by MeasuringUnitCode1 order by sum(rejected) desc,PartyCode) rn from R group by MeasuringUnitCode1,PartyCode),
                 QI as (select MeasuringUnitCode1 unit_code,ItemCode code,sum(received) received,sum(rejected) rejected,row_number() over(partition by MeasuringUnitCode1 order by sum(rejected) desc,ItemCode) rn from R group by MeasuringUnitCode1,ItemCode),
                 FU as (select MeasuringUnitCode1 code,sum(quantity) quantity,sum(case when ItemNatureCode='SCRAP' then quantity else 0 end) scrap from F group by MeasuringUnitCode1),
                 SP as (select PartyCode code,count(*) receipts,count(DeliveryDate) eligible,sum(on_time) on_time,avg(case when lead_days>=0 then lead_days end) lead_days,sum(order_value) order_value,
                 row_number() over(order by sum(order_value) desc) rn from D group by PartyCode),
                 PR as (select count(*) matched_lines,count(case when variance>0 then 1 end) higher_lines,sum(variance) net_variance,sum(case when variance>0 then variance else 0 end) adverse from PV)
                 select json_object('receipts' value (select json_arrayagg(json_object('code' value code,'unit' value nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=RU.code),'Unit not recorded'),'received' value received,'rejected' value rejected,'docs' value docs) returning clob) from RU) format json,
                 'production' value (select json_arrayagg(json_object('code' value code,'unit' value nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=FU.code),'Unit not recorded'),'quantity' value quantity,'scrap' value scrap) returning clob) from FU) format json,
                 'suppliers' value (select json_arrayagg(json_object('code' value code,'name' value nvl((select PartyName from Party where PartyCode=SP.code),SP.code),'receipts' value receipts,'eligible' value eligible,'on_time' value on_time,'lead_days' value lead_days,'order_value' value order_value) order by rn returning clob) from SP where rn<=30) format json,
                 'qualityTrend' value (select json_arrayagg(json_object('unit' value unit_code,'month' value month,'received' value received,'rejected' value rejected) order by month returning clob) from QM) format json,
                 'qualitySuppliers' value (select json_arrayagg(json_object('unit' value unit_code,'code' value code,'name' value nvl((select PartyName from Party where PartyCode=QP.code),QP.code),'received' value received,'rejected' value rejected) order by rn returning clob) from QP where rn<=8 and rejected>0) format json,
                 'qualityItems' value (select json_arrayagg(json_object('unit' value unit_code,'code' value code,'name' value (select ItemName from Item where ItemCode=QI.code),'received' value received,'rejected' value rejected) order by rn returning clob) from QI where rn<=8 and rejected>0) format json,
                 'price' value (select json_object('matched' value matched_lines,'higher' value higher_lines,'net' value net_variance,'adverse' value adverse returning clob) from PR) format json returning clob) payload from dual);
                 select json_object('data' value nvl(a,case when 'PERFORMANCE' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 900735083100028
        }
    )

    process exec-profit (
        name: EXEC_PROFIT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare v clob;a clob;j apex_json.t_values;begin
                 if apex_application.g_x01 is not null then apex_json.parse(j,apex_application.g_x01);:P735_COMPANY:=apex_json.get_varchar2(p_path=>'COMPANY',p_values=>j);
                :P735_LOCATION:=apex_json.get_varchar2(p_path=>'LOCATION',p_values=>j);
                :P735_FROMDATE:=apex_json.get_varchar2(p_path=>'FROMDATE',p_values=>j);
                :P735_TODATE:=apex_json.get_varchar2(p_path=>'TODATE',p_values=>j);
                :P735_PANEL:=apex_json.get_varchar2(p_path=>'PANEL',p_values=>j);
                :P735_ITEM:=apex_json.get_varchar2(p_path=>'ITEM',p_values=>j);
                :P735_SPEC:=apex_json.get_varchar2(p_path=>'SPEC',p_values=>j);
                :P735_CATEGORY:=apex_json.get_varchar2(p_path=>'CATEGORY',p_values=>j);end if;
                 if :P735_FROMDATE is null or :P735_TODATE is null or to_date(:P735_TODATE,'DD-MM-RRRR')<to_date(:P735_FROMDATE,'DD-MM-RRRR') or to_date(:P735_TODATE,'DD-MM-RRRR')-to_date(:P735_FROMDATE,'DD-MM-RRRR')>365 or to_date(:P735_TODATE,'DD-MM-RRRR')>trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) then raise_application_error(-20001,'Choose valid dates through today, up to 366 days.');end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if;
                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), W as (
                 select PartyCode code,connect_by_root NatureOfAccountCode root_nature,connect_by_root PartyCode root_code,
                 regexp_substr(sys_connect_by_path(PartyCode,'~'),'[^~]+',1,2) l2,regexp_substr(sys_connect_by_path(PartyCode,'~'),'[^~]+',1,3) l3,sys_connect_by_path(PartyCode,'~')||'~' path
                 from Party start with ParentCode is null connect by prior PartyCode=ParentCode),
                 E as (select /*+ materialize */ d.TNo,d.SNo,d.VoucherDate,d.AccountCode,d.CompanyCode,d.LocationCode,v.VoucherNo,v.ModuleCode,v.ModuleTNo,d.Amount,substr(d.Narration,1,400) note,
                 case when w.root_code='BALANCESHEET' or w.root_nature in ('ASSETS','LIABILITIES') then 'BALANCE_SHEET'
                 when w.root_nature='INCOME' or w.l2='INCOME' then 'INCOME'
                 when w.root_nature='EXPENSES' or w.l2='EXPENDITURES' then 'EXPENSES' else 'UNCLASSIFIED' end classification,
                 case when d.AccountCode='4274' then 'VARIATION' when instr(w.path,'~DIRECTCOST~')>0 then 'DIRECT' when instr(w.path,'~DEPRECIATION~')>0 then 'DEPRECIATION'
                 when instr(w.path,'~5213~')>0 or instr(w.path,'~5513~')>0 or d.AccountCode in ('5041','30001') then 'FINANCE' else 'OVERHEAD' end cost_bucket
                 from VoucherDetail d join Voucher v on v.TNo=d.TNo left join W w on w.code=d.AccountCode
                 left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b
                 where d.VoucherDate>=b.f and d.VoucherDate<b.t and nvl(v.VoucherNo,'~')<>'OPENING' and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')),
                 P as (select e.*,case when classification='INCOME' then 'INCOME' when classification='EXPENSES' then cost_bucket else classification end bucket from E e), T as (select bucket,sum(Amount) signed_amount,count(*) lines,count(distinct TNo) documents from P group by bucket),
                 A as (select classification,AccountCode code,sum(Amount) amount,count(distinct TNo) documents,row_number() over(partition by classification order by abs(sum(Amount)) desc) rn from P where classification in ('INCOME','EXPENSES','UNCLASSIFIED') group by classification,AccountCode),
                 M as (select to_char(VoucherDate,'YYYY-MM') month,sum(case when classification='INCOME' then Amount else 0 end) income,-sum(case when classification='EXPENSES' then Amount else 0 end) expense,
                 sum(case when classification in ('INCOME','EXPENSES') then Amount else 0 end) result,-sum(case when bucket='VARIATION' then Amount else 0 end) variation from P group by to_char(VoucherDate,'YYYY-MM')),
                 L as (select LocationCode code,sum(case when classification='INCOME' then Amount else 0 end) income,-sum(case when classification='EXPENSES' then Amount else 0 end) expense,sum(case when classification in ('INCOME','EXPENSES') then Amount else 0 end) result from P group by LocationCode),
                 V as (select TNo,VoucherNo,min(VoucherDate) dated,-sum(Amount) amount,row_number() over(order by abs(sum(Amount)) desc) rn from P where bucket='VARIATION' group by TNo,VoucherNo)
                 select json_object('buckets' value (select json_arrayagg(json_object('key' value bucket,'signed' value signed_amount,'documents' value documents,'lines' value lines) returning clob) from T) format json,
                 'accounts' value (select json_arrayagg(json_object('kind' value classification,'code' value code,'name' value nvl((select PartyName from Party where PartyCode=A.code),A.code),'amount' value amount,'documents' value documents) order by rn returning clob) from A where rn<=12) format json,
                 'trend' value (select json_arrayagg(json_object('month' value month,'income' value income,'expense' value expense,'result' value result,'variation' value variation) order by month returning clob) from M) format json,
                 'locations' value (select json_arrayagg(json_object('code' value code,'name' value nvl((select LocationName from Location where LocationCode=L.code),L.code),'income' value income,'expense' value expense,'result' value result) order by income desc returning clob) from L) format json,
                 'valuation_review' value (select json_arrayagg(json_object('id' value to_char(TNo),'doc' value VoucherNo,'dated' value to_char(dated,'DD Mon YYYY'),'amount' value amount) order by rn returning clob) from V where rn<=3) format json returning clob) payload from dual);
                 select json_object('data' value nvl(a,case when 'PROFIT' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 900735083100026
        }
    )

    process exec-source-dates (
        name: EXEC_SOURCE_DATES
        type: executeCode
