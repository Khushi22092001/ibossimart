        source {
            plsqlCode:
                ```plsql
                declare a clob;s clob;v clob;j apex_json.t_values;f date;t date;d date;saved_to varchar2(40);ar number;ap number;stock number;
                begin apex_json.parse(j,apex_application.g_x01);:P735_COMPANY:=apex_json.get_varchar2(p_path=>'COMPANY',p_values=>j);
                :P735_LOCATION:=apex_json.get_varchar2(p_path=>'LOCATION',p_values=>j);
                :P735_FROMDATE:=apex_json.get_varchar2(p_path=>'FROMDATE',p_values=>j);
                :P735_TODATE:=apex_json.get_varchar2(p_path=>'TODATE',p_values=>j);
                :P735_PANEL:=apex_json.get_varchar2(p_path=>'PANEL',p_values=>j);
                :P735_ITEM:=apex_json.get_varchar2(p_path=>'ITEM',p_values=>j);
                :P735_SPEC:=apex_json.get_varchar2(p_path=>'SPEC',p_values=>j);
                :P735_CATEGORY:=apex_json.get_varchar2(p_path=>'CATEGORY',p_values=>j);
                if :P735_FROMDATE is null or :P735_TODATE is null or to_date(:P735_TODATE,'DD-MM-RRRR')<to_date(:P735_FROMDATE,'DD-MM-RRRR') or to_date(:P735_TODATE,'DD-MM-RRRR')-to_date(:P735_FROMDATE,'DD-MM-RRRR')>365 or to_date(:P735_TODATE,'DD-MM-RRRR')>trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) then raise_application_error(-20001,'Choose valid dates through today, up to 366 days.');end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if; saved_to:=:P735_TODATE;f:=to_date(:P735_FROMDATE,'DD-MM-RRRR');t:=to_date(:P735_TODATE,'DD-MM-RRRR');d:=trunc(f,'MM');
                apex_json.initialize_clob_output;apex_json.open_object;apex_json.open_array('data');
                while d<=t loop
                 :P735_TODATE:=to_char(least(last_day(d),t),'DD-MM-RRRR');
                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), AC as (
                 select PartyCode code,'AR' kind,-1 sign from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode
                 union all select PartyCode,'AP',1 from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode),
                 VD as (select /*+ materialize */ d.*,v.VoucherNo,v.ModuleCode source_module,v.ModuleTNo source_id,v.DocTypeCode,a.kind,a.sign
                 from VoucherDetail d join Voucher v on v.TNo=d.TNo join AC a on a.code=d.AccountCode
                 left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b where d.VoucherDate<b.t and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')),
                 A0 as (select x.DrVoucherTNo tno,x.DrVoucherSNo sno,-sum(x.Amount) amount from DrCrAllocation x join Voucher dv on dv.TNo=x.DrVoucherTNo join Voucher cv on cv.TNo=x.CrVoucherTNo cross join B b
                 where dv.VoucherDate<b.t and cv.VoucherDate<b.t and exists(select 1 from VD where VD.TNo=x.DrVoucherTNo and VD.SNo=x.DrVoucherSNo) group by x.DrVoucherTNo,x.DrVoucherSNo
                 union all select x.CrVoucherTNo,x.CrVoucherSNo,sum(x.Amount) from DrCrAllocation x join Voucher dv on dv.TNo=x.DrVoucherTNo join Voucher cv on cv.TNo=x.CrVoucherTNo cross join B b
                 where dv.VoucherDate<b.t and cv.VoucherDate<b.t and exists(select 1 from VD where VD.TNo=x.CrVoucherTNo and VD.SNo=x.CrVoucherSNo) group by x.CrVoucherTNo,x.CrVoucherSNo),
                 AL as (select tno,sno,sum(amount) amount from A0 group by tno,sno),
                 O0 as (select d.kind,d.TNo,d.SNo,d.VoucherNo,d.VoucherDate,d.CompanyCode,d.LocationCode,d.AccountCode,d.source_module,d.source_id,
                 coalesce(i.InvoiceNo,pb.PBPassNo,sb.ServiceBillNo,ao.BillNo,d.VoucherNo) source_no,
                 coalesce(i.InvoiceDate,pb.PBPassDate,sb.ServiceBillDate,ao.BillDate,d.VoucherDate) document_date,
                 coalesce(i.DueDate,pb.DueDate,sb.DueDate,ao.BillDueDate) due_date,
                 d.sign*d.Amount original_amount,d.sign*nvl(al.amount,0) allocated,d.sign*(d.Amount-nvl(al.amount,0)) residual,d.DocTypeCode
                 from VD d left join AL al on al.tno=d.TNo and al.sno=d.SNo
                 left join Invoice i on d.source_module='INVOICE' and i.TNo=d.source_id
                 left join PBPass pb on d.source_module='PBPASS' and pb.TNo=d.source_id
                 left join ServiceBill sb on d.source_module='SERVICEBILL' and sb.TNo=d.source_id
                 left join AccountOpening ao on d.VoucherNo='OPENING' and ao.TNo=d.ModuleTNo),
                 O as (select o0.*,case when residual<0 then 'CREDIT' when due_date is null then 'UNKNOWN' when due_date>=b.t-1 then 'NOT_DUE'
                 when b.t-1-trunc(due_date)<=30 then 'D1_30' when b.t-1-trunc(due_date)<=60 then 'D31_60' when b.t-1-trunc(due_date)<=90 then 'D61_90' when b.t-1-trunc(due_date)<=180 then 'D91_180' else 'D180' end bucket,
                 case when due_date is not null then greatest(b.t-1-trunc(due_date),0) end days_overdue from O0 cross join B b where abs(residual)>.005), T as (select kind,sum(case when residual>0 then residual else 0 end) gross,sum(case when residual<0 then -residual else 0 end) credits,sum(residual) net,
                 sum(case when residual>0 and days_overdue>0 then residual else 0 end) overdue,sum(case when residual>0 and days_overdue>90 then residual else 0 end) overdue90,
                 sum(case when residual>0 and due_date is null then residual else 0 end) unknown_due,
                 count(*) lines,count(distinct case when residual>0 and days_overdue>0 then TNo end) overdue_docs,
                 sum(case when residual>0 and due_date>=b.t-1 and due_date<b.t-1+7 then residual else 0 end) next7,
                 sum(case when residual>0 and due_date>=b.t-1 and due_date<b.t-1+30 then residual else 0 end) next30 from O cross join B b group by kind),
                 G as (select kind,bucket,sum(residual) amount,count(*) lines from O group by kind,bucket),
                 L as (select kind,LocationCode code,sum(case when residual>0 then residual else 0 end) amount,sum(residual) net from O group by kind,LocationCode),
                 P as (select kind,AccountCode code,sum(case when residual>0 then residual else 0 end) amount,sum(case when residual<0 then -residual else 0 end) credit,row_number() over(partition by kind order by sum(case when residual>0 then residual else 0 end) desc) rn from O group by kind,AccountCode)
                 select json_object('totals' value (select json_arrayagg(json_object('kind' value kind,'gross' value gross,'credits' value credits,'net' value net,'overdue' value overdue,'overdue90' value overdue90,'unknown' value unknown_due,'lines' value lines,'overdue_docs' value overdue_docs,'next7' value next7,'next30' value next30) returning clob) from T) format json,
                 'buckets' value (select json_arrayagg(json_object('kind' value kind,'bucket' value bucket,'amount' value amount,'lines' value lines) returning clob) from G) format json,
                 'locations' value (select json_arrayagg(json_object('kind' value kind,'code' value code,'name' value nvl((select LocationName from Location where LocationCode=L.code),L.code),'amount' value amount,'net' value net) returning clob) from L) format json,
                 'parties' value (select json_arrayagg(json_object('kind' value kind,'code' value code,'name' value nvl((select PartyName from Party where PartyCode=P.code),P.code),'amount' value amount,'credit' value credit) order by rn returning clob) from P where rn<=10) format json returning clob) payload from dual);select payload into s from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual), FY as (select max(FinancialYearBegin) fy from FinancialYear cross join B b where b.t-1 between FinancialYearBegin and FinancialYearEnd),
                 S0 as (select /*+ materialize */ s.TNo,s.StockDate,s.CompanyCode,s.LocationCode,s.ItemCode,s.ItemSpecificationCode,s.StorageLocationCode,s.StockQuantity1,s.Rate,i.ItemName,i.ItemNatureCode,i.MeasuringUnitCode1,sp.ItemSpecificationName,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code
                 from Stock s left join Item i on i.ItemCode=s.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=s.ItemSpecificationCode cross join B b cross join FY
                 where s.StockDate>=FY.fy and s.StockDate<b.t and (:P735_COMPANY is null or s.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or s.LocationCode=:P735_LOCATION) and (b.enforced is null or s.Panel=b.enforced) and (:P735_PANEL is null or s.Panel=:P735_PANEL) and (:P735_ITEM is null or s.ItemCode=:P735_ITEM) and (:P735_SPEC is null or s.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)),
                 U as (select u.StockTNo,sum(u.UsedStockQuantity1) used,max(u.UsedStockDate) last_used from UsedStock u cross join B b where u.UsedStockDate<b.t and exists(select 1 from S0 where S0.TNo=u.StockTNo) group by u.StockTNo),
                 S as (select s0.*,nvl(u.used,0) used_qty,s0.StockQuantity1-nvl(u.used,0) qty,(s0.StockQuantity1-nvl(u.used,0))*s0.Rate amount,
                 greatest(s0.StockDate,nvl(u.last_used,s0.StockDate)) last_movement,
                 b.t-1-trunc(greatest(s0.StockDate,nvl(u.last_used,s0.StockDate))) idle_days
                 from S0 left join U u on u.StockTNo=s0.TNo cross join B b), V as (select * from S where abs(qty)>.000001),
                 N as (select ItemNatureCode nature,sum(amount) amount,count(*) layers from V group by ItemNatureCode),
                 L as (select LocationCode code,sum(amount) amount from V group by LocationCode),
                 I as (select ItemCode code,ItemName name,sum(amount) amount,row_number() over(order by sum(amount) desc) rn from V group by ItemCode,ItemName),
                 T as (select sum(amount) value,count(*) layers,count(case when qty<0 then 1 end) negative,count(case when Rate is null then 1 end) unpriced,
                 sum(case when qty>0 and idle_days>=90 then amount else 0 end) idle90,sum(case when qty>0 and idle_days>=180 then amount else 0 end) idle180,min(StockDate) earliest from V)
                 select json_object('value' value value,'layers' value layers,'negative' value negative,'unpriced' value unpriced,
                 'idle90' value idle90,'idle180' value idle180,'earliest' value to_char(earliest,'DD Mon YYYY'),
                 'natures' value (select json_arrayagg(json_object('code' value nvl(nature,'Unclassified'),'name' value nvl((select ItemNatureName from ItemNature where ItemNatureCode=N.nature),nvl(nature,'Unclassified')),'amount' value amount,'layers' value layers) returning clob) from N) format json,
                 'locations' value (select json_arrayagg(json_object('code' value code,'name' value nvl((select LocationName from Location where LocationCode=L.code),L.code),'amount' value amount) returning clob) from L) format json,
                 'items' value (select json_arrayagg(json_object('code' value code,'name' value name,'amount' value amount) order by rn returning clob) from I where rn<=10) format json returning clob) payload from T);
                 select nvl(sum(case when kind='AR' then net end),0),nvl(sum(case when kind='AP' then net end),0) into ar,ap from json_table(a,'$.totals[*]' columns(kind varchar2(10) path '$.kind',net number path '$.net'));
                 select json_value(s,'$.value' returning number) into stock from dual;
                 apex_json.open_object;apex_json.write('month',to_char(d,'YYYY-MM'));apex_json.write('asof',:P735_TODATE);apex_json.write('ar',ar);apex_json.write('ap',ap);apex_json.write('stock',stock);apex_json.write('capital',ar+nvl(stock,0)-ap);apex_json.close_object;
                 d:=add_months(d,1);
                end loop;
                :P735_TODATE:=saved_to;apex_json.close_array;apex_json.close_object;v:=apex_json.get_clob_output;
                for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;apex_json.free_output;
                exception when others then :P735_TODATE:=saved_to;apex_json.free_output;raise;end;
                ```
        }
