    region exEvidenceOPERATIONS (
        name: Operational control register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), BilledDispatch as (select /*+ materialize */ distinct c.DespatchAdviceTNo from CCInvoice c cross join B b where c.CCInvoiceDate<b.t and c.DespatchAdviceTNo is not null), A as (select 'GRN_UNBILLED' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.GRNNo as varchar2(400)) doc_no,h.GRNDate event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,(select sum(Amount) from GRNDetail where TNo=h.TNo) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,greatest(b.t-1-h.GRNDate,0)*24 age_hours, cast('Receipt date through the selected as-of; no linked purchase bill.' as varchar2(400)) note from GRN h left join DS ds on ds.ModuleCode='GRN' and ds.ModuleTNo=h.TNo cross join B b where h.GRNDate>=(select max(FinancialYearBegin) from FinancialYear where b.t-1 between FinancialYearBegin and FinancialYearEnd) and h.GRNDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and not exists(select 1 from PurchaseBillGRNDetail x join PurchaseBill pb on pb.TNo=x.TNo where x.GRNTNo=h.TNo and pb.PurchaseBillDate<b.t) union all select 'BILL_UNPASSED' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.PurchaseBillNo as varchar2(400)) doc_no,h.PurchaseBillDate event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,(select sum(Amount) from PurchaseBillDetail where TNo=h.TNo) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,greatest(b.t-1-h.PurchaseBillDate,0)*24 age_hours, cast('Purchase bills without a pass document.' as varchar2(400)) note from PurchaseBill h left join DS ds on ds.ModuleCode='PURCHASEBILL' and ds.ModuleTNo=h.TNo cross join B b where h.PurchaseBillDate>=(select max(FinancialYearBegin) from FinancialYear where b.t-1 between FinancialYearBegin and FinancialYearEnd) and h.PurchaseBillDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and not exists(select 1 from PBPass p where p.PurchaseBillTNo=h.TNo and p.PBPassDate<b.t) union all select 'IN_NO_GRN' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateOutTime event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.GateOutTime)*24 age_hours, cast('Vehicle '||h.VehicleNo||'; inbound '||h.MaterialInNo as varchar2(400)) note from MaterialIn h left join DS ds on ds.ModuleCode='MATERIALIN' and ds.ModuleTNo=h.TNo cross join B b where h.GateOutTime>=(select max(FinancialYearBegin) from FinancialYear where b.t-1 between FinancialYearBegin and FinancialYearEnd) and h.GateOutTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and not exists(select 1 from GRN g where g.MaterialInTNo=h.TNo and g.GRNDate<b.t) union all select 'GATE_UNBILLED' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateOutTime event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.GateOutTime)*24 age_hours, cast('Vehicle '||h.VehicleNo||'; advice '||da.DespatchAdviceNo as varchar2(400)) note from MaterialOut h join DespatchAdvice da on da.TNo=h.ReferenceTNo left join BilledDispatch bd on bd.DespatchAdviceTNo=da.TNo left join DS ds on ds.ModuleCode='MATERIALOUT' and ds.ModuleTNo=h.TNo cross join B b where h.GateOutTime>=(select max(FinancialYearBegin) from FinancialYear where b.t-1 between FinancialYearBegin and FinancialYearEnd) and h.GateOutTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and bd.DespatchAdviceTNo is null union all select 'GATE_INSIDE' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.GateInTime)*24 age_hours, cast('MaterialIn; vehicle '||h.VehicleNo||'; gate in '||to_char(h.GateInTime,'DD Mon YYYY HH24:MI') as varchar2(400)) note from MaterialIn h left join DS ds on ds.ModuleCode='MATERIALIN' and ds.ModuleTNo=h.TNo cross join B b where h.GateInTime>b.clock-2 and h.GateInTime<=b.clock and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and h.GateOutTime is null and h.GateInTime<b.clock-8/24 union all select 'GATE_STALE' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.GateInTime)*24 age_hours, cast('MaterialIn; vehicle '||h.VehicleNo||'; gate in '||to_char(h.GateInTime,'DD Mon YYYY HH24:MI') as varchar2(400)) note from MaterialIn h left join DS ds on ds.ModuleCode='MATERIALIN' and ds.ModuleTNo=h.TNo cross join B b where h.GateInTime<=b.clock-2 and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and h.GateOutTime is null union all select 'GATE_COMPLETED' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateOutTime event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(h.GateOutTime-h.GateInTime)*24 age_hours, cast('MaterialIn; vehicle '||h.VehicleNo||'; gate in '||to_char(h.GateInTime,'DD Mon YYYY HH24:MI') as varchar2(400)) note from MaterialIn h left join DS ds on ds.ModuleCode='MATERIALIN' and ds.ModuleTNo=h.TNo cross join B b where h.GateOutTime>=b.f and h.GateOutTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and h.GateOutTime>=h.GateInTime union all select 'GATE_INSIDE' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateInTime event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.GateInTime)*24 age_hours, cast('MaterialOut; vehicle '||h.VehicleNo||'; gate in '||to_char(h.GateInTime,'DD Mon YYYY HH24:MI') as varchar2(400)) note from MaterialOut h left join DS ds on ds.ModuleCode='MATERIALOUT' and ds.ModuleTNo=h.TNo cross join B b where h.GateInTime>b.clock-2 and h.GateInTime<=b.clock and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and h.GateOutTime is null and h.GateInTime<b.clock-8/24 union all select 'GATE_STALE' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateInTime event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.GateInTime)*24 age_hours, cast('MaterialOut; vehicle '||h.VehicleNo||'; gate in '||to_char(h.GateInTime,'DD Mon YYYY HH24:MI') as varchar2(400)) note from MaterialOut h left join DS ds on ds.ModuleCode='MATERIALOUT' and ds.ModuleTNo=h.TNo cross join B b where h.GateInTime<=b.clock-2 and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and h.GateOutTime is null union all select 'GATE_COMPLETED' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateOutTime event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(h.GateOutTime-h.GateInTime)*24 age_hours, cast('MaterialOut; vehicle '||h.VehicleNo||'; gate in '||to_char(h.GateInTime,'DD Mon YYYY HH24:MI') as varchar2(400)) note from MaterialOut h left join DS ds on ds.ModuleCode='MATERIALOUT' and ds.ModuleTNo=h.TNo cross join B b where h.GateOutTime>=b.f and h.GateOutTime<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and h.GateOutTime>=h.GateInTime union all select 'WEIGH_PENDING' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.WeighmentNo as varchar2(400)) doc_no,h.WeighmentDate event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.WeighmentDate)*24 age_hours, cast('Vehicle '||h.VehicleNo||'; first weight '||h.FirstWeight||'; time '||to_char(h.FirstWeightTime,'DD Mon HH24:MI') as varchar2(400)) note from Weighment h left join DS ds on ds.ModuleCode='WEIGHMENT' and ds.ModuleTNo=h.TNo cross join B b where h.WeighmentDate>=(select max(FinancialYearBegin) from FinancialYear where b.t-1 between FinancialYearBegin and FinancialYearEnd) and h.WeighmentDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and nvl(h.IsCanceled,'NO')<>'YES' and h.FirstWeightTime is not null and h.SecondWeightTime is null union all select 'REJECTED' metric,h.TNo doc_id,d.SNo line_no,cast(h.GRNNo as varchar2(400)) doc_no,h.GRNDate event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,d.RejectedQuantity1 quantity, i.MeasuringUnitCode1 unit_code,(b.clock-h.GRNDate)*24 age_hours, cast(substr(i.ItemName||'; '||sp.ItemSpecificationName||'; received '||d.ReceivedQuantity1,1,400) as varchar2(400)) note from GRN h join GRNDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode left join DS ds on ds.ModuleCode='GRN' and ds.ModuleTNo=h.TNo cross join B b where h.GRNDate>=b.f and h.GRNDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and d.RejectedQuantity1>0 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) union all select 'QC_FLAGS' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.QCSampleNo as varchar2(400)) doc_no,h.QCSampleDate event_date,h.CompanyCode company_code,h.LocationCode location_code, h.PartyCode party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.QCSampleDate)*24 age_hours, cast('Test record exists but sample flag says NO.' as varchar2(400)) note from QCSample h left join DS ds on ds.ModuleCode='QCSAMPLE' and ds.ModuleTNo=h.TNo cross join B b where h.QCSampleDate>=(select max(FinancialYearBegin) from FinancialYear where b.t-1 between FinancialYearBegin and FinancialYearEnd) and h.QCSampleDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and h.IsTested='NO' and exists(select 1 from QualityTest t where t.QCSampleTNo=h.TNo) union all select 'MAINT_OPEN' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaintenanceRequestNo as varchar2(400)) doc_no,h.MaintenanceRequestDate event_date,h.CompanyCode company_code,h.LocationCode location_code, cast(null as varchar2(400)) party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.MaintenanceRequestDate)*24 age_hours, cast(substr('Equipment: '||(select EquipmentName from Equipment where TNo=h.EquipmentTNo)||'; '||h.NotificationShortText||'; owner '||h.PersonResponsible,1,400) as varchar2(400)) note from MaintenanceRequest h left join DS ds on ds.ModuleCode='MAINTENANCEREQUEST' and ds.ModuleTNo=h.TNo cross join B b where h.MaintenanceRequestDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and not exists(select 1 from EquipmentMaintenanceOrder mo join MaintenanceOrderCompletion c on c.EquipmentMaintenanceOrderTNo=mo.TNo where mo.MaintenanceRequestTNo=h.TNo) and :P735_ALLOW_MAINT='Y' union all select 'EQUIPMENT_DOWN' metric,h.TNo doc_id,cast(null as number) line_no,cast(h.MaintenanceRequestNo as varchar2(400)) doc_no,h.MalfunctionStartDateAndTime event_date,h.CompanyCode company_code,h.LocationCode location_code, cast(null as varchar2(400)) party_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code,(b.clock-h.MalfunctionStartDateAndTime)*24 age_hours, cast(substr('Equipment: '||(select EquipmentName from Equipment where TNo=h.EquipmentTNo)||'; '||h.NotificationShortText,1,400) as varchar2(400)) note from MaintenanceRequest h left join DS ds on ds.ModuleCode='MAINTENANCEREQUEST' and ds.ModuleTNo=h.TNo cross join B b where h.MaintenanceRequestDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and h.IsEquipmentInBreakdownStatus='YES' and h.MalfunctionEndDateAndTime is null and :P735_ALLOW_MAINT='Y' union all select 'APPROVAL',q.TNo,cast(null as number),cast(q.MenuLabel as varchar2(400)),nvl(o.ModuleDate,sc.SalesConfirmDate),q.CompanyCode,nvl(o.LocationCode,sc.LocationCode),nvl(o.PartyCode,sc.PartyCode),nvl(o.ModuleAmount,sc.SalesConfirmAmount),cast(null as number),cast(null as varchar2(400)),(b.clock-q.QueueDate)*24, cast(substr(q.ModuleName||'; token '||q.TokenNo||'; '||o.Particulars,1,400) as varchar2(400)) from ONTHETABLE_APEX q left join ONTHETABLEALL o on o.TNo=q.TNo left join SalesConfirm sc on q.ModuleCode='SALESCONFIRM' and sc.TNo=q.ModuleTNo cross join B b where (:P735_COMPANY is null or q.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or nvl(o.LocationCode,sc.LocationCode)=:P735_LOCATION) and :P735_PANEL is null) select case a.metric when 'GRN_UNBILLED' then 'Receipts without bills' when 'BILL_UNPASSED' then 'Bills awaiting passing' when 'IN_NO_GRN' then 'Inbound exits without GRN' when 'GATE_UNBILLED' then 'Dispatch exits without invoice' when 'GATE_INSIDE' then 'Vehicles inside over 8 hours' when 'GATE_STALE' then 'Older unclosed gate records' when 'WEIGH_PENDING' then 'Incomplete weighments' when 'REJECTED' then 'Receipts with rejected quantity' when 'QC_FLAGS' then 'Tested samples still marked untested' when 'MAINT_OPEN' then 'Open maintenance requests' when 'EQUIPMENT_DOWN' then 'Equipment flagged in breakdown' when 'GATE_COMPLETED' then 'Completed gate visits' when 'APPROVAL' then 'My pending approvals' end CONTROL,a.doc_no DOCUMENT_NO,a.event_date DOCUMENT_DATE,(select CompanyName from Company where CompanyCode=a.company_code) COMPANY,nvl((select LocationName from Location where LocationCode=a.location_code),a.location_code) LOCATION,nvl((select PartyName from Party where PartyCode=a.party_code),a.party_code) PARTY,a.amount AMOUNT,a.quantity QUANTITY,case when a.quantity is not null then nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=a.unit_code),'Unit not recorded') end UNIT,round(a.age_hours,1) AGE_HOURS,a.note NOTES, case when a.metric='BILL_UNPASSED' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>680,p_clear_cache=>'680',p_items=>'P680_TNO',p_values=>a.doc_id))||'">Purchase Bill 360</a>' end RELATED_360 from A a where :P735_FAMILY='OPERATIONS' and (:P735_METRIC='ALL' or a.metric=:P735_METRIC) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='LOCATION' and a.location_code=:P735_DIMVALUE) or (:P735_DIMTYPE='UNIT' and a.unit_code=:P735_DIMVALUE))
            pageItemsToSubmit: [
