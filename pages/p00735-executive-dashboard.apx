    region exEvidenceCOVERAGE (
        name: Source coverage and definitions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual), C as (select 'BUDGET' domain,'AnnualAdminBudget' source,'Administration budget' label,count(*) records,min(h.AnnualAdminBudgetDate) first_date,max(h.AnnualAdminBudgetDate) latest_date,'Targets and variances require approved, applicable budgets; no values are invented.' limitation from AnnualAdminBudget h cross join B b where h.AnnualAdminBudgetDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) union all select 'BUDGET' domain,'AnnualOperationBudget' source,'Operating budget' label,count(*) records,min(h.AnnualOperationBudgetDate) first_date,max(h.AnnualOperationBudgetDate) latest_date,'Targets and variances require approved, applicable budgets; no values are invented.' limitation from AnnualOperationBudget h cross join B b where h.AnnualOperationBudgetDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) union all select 'BUDGET' domain,'AnnualRecruitmentBudget' source,'Recruitment budget' label,count(*) records,min(h.AnnualRecruitmentBudgetDate) first_date,max(h.AnnualRecruitmentBudgetDate) latest_date,'Targets and variances require approved, applicable budgets; no values are invented.' limitation from AnnualRecruitmentBudget h cross join B b where h.AnnualRecruitmentBudgetDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) union all select 'BUDGET' domain,'ProjectBudget' source,'Project budget' label,count(*) records,min(h.ProjectBudgetDate) first_date,max(h.ProjectBudgetDate) latest_date,'Targets and variances require approved, applicable budgets; no values are invented.' limitation from ProjectBudget h cross join B b where h.ProjectBudgetDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) union all select 'PLAN' domain,'DailyProductionPlan' source,'Daily production plan' label,count(*) records,min(h.DailyProductionPlanDate) first_date,max(h.DailyProductionPlanDate) latest_date,'Achievement and production forecasts require populated plans and linkage to output.' limitation from DailyProductionPlan h cross join B b where h.DailyProductionPlanDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) union all select 'PLAN' domain,'ProductionPlan' source,'Production plan' label,count(*) records,min(h.ProductionPlanDate) first_date,max(h.ProductionPlanDate) latest_date,'Achievement and production forecasts require populated plans and linkage to output.' limitation from ProductionPlan h cross join B b where h.ProductionPlanDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) union all select 'PRODUCTION' domain,'Production' source,'Recorded production' label,count(*) records,min(h.ProductionDate) first_date,max(h.ProductionDate) latest_date,'OEE requires equipment, scheduled time, actual runtime, ideal throughput and good output. Recorded shifts alone are insufficient.' limitation from Production h cross join B b where h.ProductionDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) union all select 'QUALITY' domain,'QualityTest' source,'Quality tests' label,count(*) records,min(h.QualityTestDate) first_date,max(h.QualityTestDate) latest_date,'A NO workflow flag is not a certified quality failure. Use actual parameters and explicit receipt rejection.' limitation from QualityTest h cross join B b where h.QualityTestDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) union all select 'QUALITY' domain,'QCSample' source,'Quality samples' label,count(*) records,min(h.QCSampleDate) first_date,max(h.QCSampleDate) latest_date,'A NO workflow flag is not a certified quality failure. Use actual parameters and explicit receipt rejection.' limitation from QCSample h cross join B b where h.QCSampleDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) union all select 'MAINTENANCE' domain,'MaintenanceRequest' source,'Maintenance requests' label,count(*) records,min(h.MaintenanceRequestDate) first_date,max(h.MaintenanceRequestDate) latest_date,'No recorded breakdown does not establish 100% availability. Reliability ratios need complete event history.' limitation from MaintenanceRequest h cross join B b where h.MaintenanceRequestDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and :P735_ALLOW_MAINT='Y' union all select 'MAINTENANCE' domain,'EquipmentMaintenanceOrder' source,'Maintenance orders' label,count(*) records,min(h.EquipmentMaintenanceOrderDate) first_date,max(h.EquipmentMaintenanceOrderDate) latest_date,'No recorded breakdown does not establish 100% availability. Reliability ratios need complete event history.' limitation from EquipmentMaintenanceOrder h cross join B b where h.EquipmentMaintenanceOrderDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and :P735_ALLOW_MAINT='Y' union all select 'MAINTENANCE' domain,'MaintenanceOrderCompletion' source,'Maintenance completion' label,count(*) records,min(h.MaintenanceOrderCompletionDate) first_date,max(h.MaintenanceOrderCompletionDate) latest_date,'No recorded breakdown does not establish 100% availability. Reliability ratios need complete event history.' limitation from MaintenanceOrderCompletion h cross join B b where h.MaintenanceOrderCompletionDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and :P735_ALLOW_MAINT='Y' union all select 'TREASURY' domain,'FixedDeposit' source,'Fixed deposits' label,count(*) records,min(h.FixedDepositDate) first_date,max(h.FixedDepositDate) latest_date,'Only actual instrument records can establish exposure and maturity schedules.' limitation from FixedDeposit h cross join B b where h.FixedDepositDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) union all select 'TREASURY' domain,'LetterOfCredit' source,'Letters of credit' label,count(*) records,min(h.LetterOfCreditDate) first_date,max(h.LetterOfCreditDate) latest_date,'Only actual instrument records can establish exposure and maturity schedules.' limitation from LetterOfCredit h cross join B b where h.LetterOfCreditDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) union all select 'WORKFORCE' domain,'AttendencePeriodical' source,'Periodical attendance' label,count(*) records,min(h.AttendencePeriodicalDate) first_date,max(h.AttendencePeriodicalDate) latest_date,'Periodical attendance is not a daily present/absent headcount.' limitation from AttendencePeriodical h cross join B b where h.AttendencePeriodicalDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and :P735_ALLOW_HR='Y' union all select 'SALES' domain,'CCInvoice' source,'Sales billing history' label,count(*) records,min(h.CCInvoiceDate) first_date,max(h.CCInvoiceDate) latest_date,'No prior records means comparison unavailable, not zero historical sales.' limitation from CCInvoice h cross join B b where h.CCInvoiceDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) union all select 'ASSETS' domain,'Asset' source,'Fixed-asset transactions' label,count(*) records,min(h.AssetDate) first_date,max(h.AssetDate) latest_date,'Asset value, depreciation and utilisation need populated asset transactions and validated accounting schedules.' limitation from Asset h cross join B b where h.AssetDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) union all select 'INVENTORY','ItemSpecification','Specifications with reorder levels',count(*),cast(null as date),cast(null as date),'Positive reorder or minimum levels are needed to certify shortage and excess.' from ItemSpecification where ReorderLevel>0 or MinimumLevel>0 or MaximumLevel>0 union all select 'ASSETS','Equipment','Equipment with rated capacity',count(*),cast(null as date),cast(null as date),'Capacity, equipment-linked runtime and output are required for utilisation.' from Equipment h cross join B b where h.Capacity>0 and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and :P735_ALLOW_MAINT='Y' union all select 'MINING','MiningCategory','Mining category master',count(*),cast(null as date),max(CreationTime),'Category master records do not establish recorded mining or overburden output; no mining production KPI is inferred.' from MiningCategory union all select 'WORKFLOW','ONTHETABLE_APEX','Personal approval queue scope',count(*),min(q.QueueDate),max(q.QueueDate),'Personal authorised queue only. A selected panel suppresses this unverified panel mapping; zero then means unavailable for that panel, not no pending approvals.' from ONTHETABLE_APEX q where :P735_PANEL is null and (:P735_COMPANY is null or q.CompanyCode=:P735_COMPANY)) select domain DOMAIN,source SOURCE_TABLE,label SOURCE_DESCRIPTION,records RECORDS,first_date EARLIEST_DATE,latest_date LATEST_DATE,limitation DATA_LIMITATION from C where :P735_FAMILY='COVERAGE' and (:P735_METRIC='ALL' or :P735_METRIC=domain)
            pageItemsToSubmit: [
