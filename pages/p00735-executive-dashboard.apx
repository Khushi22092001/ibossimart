                 where h.SalesOrderDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED','CLOSED') and d.Quantity1>0
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY) union all select 'PO' kind,h.TNo,h.PurchaseOrderNo doc_no,h.PurchaseOrderDate event_date,h.DeliveryDate due_date,h.CompanyCode,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,i.MeasuringUnitCode1,coalesce(sp.ItemCategoryCode,i.ItemCategoryCode) category_code,
                 d.Quantity1 ordered,nvl(d.ReceivedQuantity1,0) fulfilled,greatest(d.Quantity1-nvl(d.ReceivedQuantity1,0),0) remaining,
                 case when nvl(h.CurrencyValue,1)=1 then d.Amount*greatest(d.Quantity1-nvl(d.ReceivedQuantity1,0),0)/nullif(d.Quantity1,0) end amount,
                 nvl(d.DocumentStatusCode,'Not recorded') status,
                 (select min(g.GRNDate) from GRN g where g.PurchaseOrderTNo=h.TNo) first_receipt
                 from PurchaseOrder h join PurchaseOrderDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='PURCHASEORDER' and ds.ModuleTNo=h.TNo cross join B b
                 where h.PurchaseOrderDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED','CLOSED') and d.Quantity1>0
                 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)), T as (select kind,count(distinct case when remaining>0 then TNo end) docs,sum(amount) amount,
                 count(distinct case when remaining>0 and due_date<b.t-1 then TNo end) overdue_docs,sum(case when due_date<b.t-1 then amount else 0 end) overdue,
                 count(distinct case when remaining>0 and due_date is null then TNo end) unknown_due,count(case when fulfilled>ordered then 1 end) overfilled,
                 sum(case when due_date>=b.t-1 and due_date<b.t-1+7 then amount else 0 end) next7,sum(case when due_date>=b.t-1 and due_date<b.t-1+30 then amount else 0 end) next30,
                 count(distinct case when first_receipt is not null and due_date is not null then TNo end) delivery_eligible,count(distinct case when first_receipt<=due_date then TNo end) on_time,
                 max(case when remaining>0 then b.t-1-trunc(event_date) end) oldest_days from O cross join B b group by kind),
                 U as (select kind,MeasuringUnitCode1 unit_code,sum(ordered) ordered,sum(fulfilled) fulfilled,sum(remaining) remaining from O where remaining>0 group by kind,MeasuringUnitCode1),
                 P as (select kind,PartyCode code,sum(amount) amount,count(distinct case when remaining>0 then TNo end) docs,count(distinct case when first_receipt is not null and due_date is not null then TNo end) eligible,
                 count(distinct case when first_receipt<=due_date then TNo end) on_time,avg(case when first_receipt is not null then first_receipt-event_date end) lead_days,row_number() over(partition by kind order by sum(amount) desc) rn from O group by kind,PartyCode)
                 select json_object('totals' value (select json_arrayagg(json_object('kind' value kind,'docs' value docs,'amount' value amount,'overdue_docs' value overdue_docs,'overdue' value overdue,'unknown_due' value unknown_due,'overfilled' value overfilled,'next7' value next7,'next30' value next30,'eligible' value delivery_eligible,'on_time' value on_time,'oldest_days' value oldest_days) returning clob) from T) format json,
                 'units' value (select json_arrayagg(json_object('kind' value kind,'unit' value nvl((select MeasuringUnitName from MeasuringUnit where MeasuringUnitCode=U.unit_code),'Unit not recorded'),'code' value unit_code,'ordered' value ordered,'fulfilled' value fulfilled,'remaining' value remaining) returning clob) from U) format json,
                 'parties' value (select json_arrayagg(json_object('kind' value kind,'code' value code,'name' value nvl((select PartyName from Party where PartyCode=P.code),P.code),'amount' value amount,'docs' value docs,'eligible' value eligible,'on_time' value on_time,'lead_days' value lead_days) order by rn returning clob) from P where rn<=10) format json returning clob) payload from dual);
                 select json_object('data' value nvl(a,case when 'COMMITMENTS' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
