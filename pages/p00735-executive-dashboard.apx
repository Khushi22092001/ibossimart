    process exec-cash (
        name: EXEC_CASH
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare v clob;a clob;j apex_json.t_values;begin
                 if apex_application.g_x01 is not null then apex_json.parse(j,apex_application.g_x01);:P735_COMPANY:=apex_json.get_varchar2(p_path=>'COMPANY',p_values=>j);
                :P735_LOCATION:=apex_json.get_varchar2(p_path=>'LOCATION',p_values=>j);
                :P735_FROMDATE:=apex_json.get_varchar2(p_path=>'FROMDATE',p_values=>j);
                :P735_TODATE:=apex_json.get_varchar2(p_path=>'TODATE',p_values=>j);
                :P735_PANEL:=apex_json.get_varchar2(p_path=>'PANEL',p_values=>j);
                :P735_ITEM:=apex_json.get_varchar2(p_path=>'ITEM',p_values=>j);
                :P735_SPEC:=apex_json.get_varchar2(p_path=>'SPEC',p_values=>j);
                :P735_CATEGORY:=apex_json.get_varchar2(p_path=>'CATEGORY',p_values=>j);end if;
                 if :P735_FROMDATE is null or :P735_TODATE is null or to_date(:P735_TODATE,'DD-MM-RRRR')<to_date(:P735_FROMDATE,'DD-MM-RRRR') or to_date(:P735_TODATE,'DD-MM-RRRR')-to_date(:P735_FROMDATE,'DD-MM-RRRR')>365 or to_date(:P735_TODATE,'DD-MM-RRRR')>trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) then raise_application_error(-20001,'Choose valid dates through today, up to 366 days.');end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P735_ALLOW_MAINT:='Y';else :P735_ALLOW_MAINT:='N';end if;if GetApexReportPrivilege('1','49',:APP_USER) then :P735_ALLOW_HR:='Y';else :P735_ALLOW_HR:='N';end if;
                 select payload into a from (with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t,
                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), FY as (select max(FinancialYearBegin) fy from FinancialYear cross join B b where b.t-1 between FinancialYearBegin and FinancialYearEnd),
                 C as (select o.TNo,cast(null as number) SNo,'Opening balance' doc_no,o.OpeningDate entry_date,o.CompanyCode,o.LocationCode,o.AccountCode,o.OpeningAmount amount,'FY carry forward; Panel A' note
                 from Opening o join Party p on p.PartyCode=o.AccountCode cross join B b cross join FY where o.OpeningDate=FY.fy and p.PartyTypeCode in ('CASH','BANK') and (:P735_COMPANY is null or o.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or o.LocationCode=:P735_LOCATION)  and (b.enforced is null or b.enforced='A') and (:P735_PANEL is null or :P735_PANEL='A')
                 union all select d.TNo,d.SNo,v.VoucherNo,d.VoucherDate,d.CompanyCode,d.LocationCode,d.AccountCode,d.Amount,substr(d.Narration,1,400)
                 from VoucherDetail d join Voucher v on v.TNo=d.TNo join Party p on p.PartyCode=d.AccountCode left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b cross join FY
                 where d.VoucherDate>=FY.fy and d.VoucherDate<b.t and nvl(v.VoucherNo,'~')<>'OPENING' and p.PartyTypeCode in ('CASH','BANK') and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')), A as (select AccountCode code,-sum(amount) balance,sum(case when entry_date>=b.f and amount<0 and SNo is not null then -amount else 0 end) inflow,sum(case when entry_date>=b.f and amount>0 and SNo is not null then amount else 0 end) outflow from C cross join B b group by AccountCode),
                 M as (select trunc(entry_date,'MM') month,sum(case when amount<0 then -amount else 0 end) inflow,sum(case when amount>0 then amount else 0 end) outflow from C cross join B b where SNo is not null and entry_date>=b.f group by trunc(entry_date,'MM'))
                 select json_object('accounts' value (select json_arrayagg(json_object('code' value code,'name' value nvl((select PartyName from Party where PartyCode=A.code),A.code),'balance' value balance,'inflow' value inflow,'outflow' value outflow) order by abs(balance) desc returning clob) from A) format json,
                 'trend' value (select json_arrayagg(json_object('month' value to_char(month,'YYYY-MM'),'inflow' value inflow,'outflow' value outflow) order by month returning clob) from M) format json returning clob) payload from dual);
                 select json_object('data' value nvl(a,case when 'CASH' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
                 for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop;
                 end;
                ```
        }
