                 trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), I as (select /*+ materialize */ h.TNo,h.CCInvoiceNo,h.CCInvoiceDate,h.LocationCode,h.PartyCode,d.SNo,d.ItemCode,d.ItemSpecificationCode,d.Quantity1,d.Amount
                 from CCInvoice h join CCInvoiceDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode left join ItemSpecification sp on sp.ItemSpecificationCode=d.ItemSpecificationCode
                 left join DS ds on ds.ModuleCode='CCINVOICE' and ds.ModuleTNo=h.TNo cross join B b where h.CCInvoiceDate>=b.f and h.CCInvoiceDate<b.t and (:P735_COMPANY is null or h.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or h.LocationCode=:P735_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P735_PANEL is null or h.Panel=:P735_PANEL)
                 and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED') and upper(nvl(d.DocumentStatusCode,'ACTIVE')) not in ('CANCELED','CANCELLED') and nvl(h.CurrencyValue,1)=1 and (:P735_ITEM is null or d.ItemCode=:P735_ITEM) and (:P735_SPEC is null or d.ItemSpecificationCode=:P735_SPEC) and (:P735_CATEGORY is null or coalesce(sp.ItemCategoryCode,i.ItemCategoryCode)=:P735_CATEGORY)),
                 U as (select u.ModuleTNo,u.ModuleSNo,sum(u.UsedStockQuantity1*s.Rate) cost,sum(case when s.Rate is not null then u.UsedStockQuantity1 end) rated_qty
                 from UsedStock u join Stock s on s.TNo=u.StockTNo cross join B b where u.ModuleCode='CCINVOICE' and u.UsedStockDate<b.t and exists(select 1 from I where I.TNo=u.ModuleTNo and I.SNo=u.ModuleSNo) group by u.ModuleTNo,u.ModuleSNo),
                 C as (select i.*,u.cost,u.rated_qty,case when i.Quantity1>0 and abs(u.rated_qty-i.Quantity1)<.000001 then 'MATCHED' else 'UNMATCHED' end coverage from I left join U u on u.ModuleTNo=i.TNo and u.ModuleSNo=i.SNo) select json_object('lines' value count(*),'matched' value count(case when coverage='MATCHED' then 1 end),'linked' value count(cost),'sales' value sum(Amount),
                 'matched_sales' value sum(case when coverage='MATCHED' then Amount end),'matched_cost' value sum(case when coverage='MATCHED' then cost end) returning clob) payload from C);
                 select json_object('data' value nvl(a,case when 'COST' in ('COVERAGE','PROFIT') then '[]' else '{}' end) format json,'scope' value ('Permitted panel: '||nvl(GetUserPanelAB_apex(),'A+B')),'fy' value (select max(FinancialYearCode) from FinancialYear where to_date(:P735_TODATE,'DD-MM-RRRR') between FinancialYearBegin and FinancialYearEnd),'asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS') returning clob) into v from dual;
