    region exEvidenceFINANCE (
        name: Open items and allocations
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select to_date(:P735_FROMDATE,'DD-MM-RRRR') f,to_date(:P735_TODATE,'DD-MM-RRRR')+1 t, trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,cast(systimestamp at time zone 'Asia/Kolkata' as date) clock,(select GetUserPanelAB_apex() from dual) enforced from dual),DS as (select ModuleCode,ModuleTNo,max(DocumentStatusCode) keep(dense_rank last order by StatusTime nulls first,TNo) status from DocumentStatusDetail group by ModuleCode,ModuleTNo), AC as ( select PartyCode code,'AR' kind,-1 sign from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode union all select PartyCode,'AP',1 from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode), VD as (select /*+ materialize */ d.*,v.VoucherNo,v.ModuleCode source_module,v.ModuleTNo source_id,v.DocTypeCode,a.kind,a.sign from VoucherDetail d join Voucher v on v.TNo=d.TNo join AC a on a.code=d.AccountCode left join DS ds on ds.ModuleCode='VOUCHER' and ds.ModuleTNo=v.TNo cross join B b where d.VoucherDate<b.t and (:P735_COMPANY is null or d.CompanyCode=:P735_COMPANY) and (:P735_LOCATION is null or d.LocationCode=:P735_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P735_PANEL is null or d.Panel=:P735_PANEL) and upper(nvl(ds.status,'ACTIVE')) not in ('CANCELED','CANCELLED')), A0 as (select x.DrVoucherTNo tno,x.DrVoucherSNo sno,-sum(x.Amount) amount from DrCrAllocation x join Voucher dv on dv.TNo=x.DrVoucherTNo join Voucher cv on cv.TNo=x.CrVoucherTNo cross join B b where dv.VoucherDate<b.t and cv.VoucherDate<b.t and exists(select 1 from VD where VD.TNo=x.DrVoucherTNo and VD.SNo=x.DrVoucherSNo) group by x.DrVoucherTNo,x.DrVoucherSNo union all select x.CrVoucherTNo,x.CrVoucherSNo,sum(x.Amount) from DrCrAllocation x join Voucher dv on dv.TNo=x.DrVoucherTNo join Voucher cv on cv.TNo=x.CrVoucherTNo cross join B b where dv.VoucherDate<b.t and cv.VoucherDate<b.t and exists(select 1 from VD where VD.TNo=x.CrVoucherTNo and VD.SNo=x.CrVoucherSNo) group by x.CrVoucherTNo,x.CrVoucherSNo), AL as (select tno,sno,sum(amount) amount from A0 group by tno,sno), O0 as (select d.kind,d.TNo,d.SNo,d.VoucherNo,d.VoucherDate,d.CompanyCode,d.LocationCode,d.AccountCode,d.source_module,d.source_id, coalesce(i.InvoiceNo,pb.PBPassNo,sb.ServiceBillNo,ao.BillNo,d.VoucherNo) source_no, coalesce(i.InvoiceDate,pb.PBPassDate,sb.ServiceBillDate,ao.BillDate,d.VoucherDate) document_date, coalesce(i.DueDate,pb.DueDate,sb.DueDate,ao.BillDueDate) due_date, d.sign*d.Amount original_amount,d.sign*nvl(al.amount,0) allocated,d.sign*(d.Amount-nvl(al.amount,0)) residual,d.DocTypeCode from VD d left join AL al on al.tno=d.TNo and al.sno=d.SNo left join Invoice i on d.source_module='INVOICE' and i.TNo=d.source_id left join PBPass pb on d.source_module='PBPASS' and pb.TNo=d.source_id left join ServiceBill sb on d.source_module='SERVICEBILL' and sb.TNo=d.source_id left join AccountOpening ao on d.VoucherNo='OPENING' and ao.TNo=d.ModuleTNo), O as (select o0.*,case when residual<0 then 'CREDIT' when due_date is null then 'UNKNOWN' when due_date>=b.t-1 then 'NOT_DUE' when b.t-1-trunc(due_date)<=30 then 'D1_30' when b.t-1-trunc(due_date)<=60 then 'D31_60' when b.t-1-trunc(due_date)<=90 then 'D61_90' when b.t-1-trunc(due_date)<=180 then 'D91_180' else 'D180' end bucket, case when due_date is not null then greatest(b.t-1-trunc(due_date),0) end days_overdue from O0 cross join B b where abs(residual)>.005) select o.kind ACCOUNT_GROUP,nvl((select PartyName from Party where PartyCode=o.AccountCode),o.AccountCode) PARTY,o.source_module MODULE,o.source_no DOCUMENT_NO,o.document_date DOCUMENT_DATE,o.due_date DUE_DATE,o.VoucherNo VOUCHER_NO, (select CompanyName from Company where CompanyCode=o.CompanyCode) COMPANY,nvl((select LocationName from Location where LocationCode=o.LocationCode),o.LocationCode) LOCATION,o.original_amount ORIGINAL_AMOUNT,o.allocated ALLOCATED,o.residual OUTSTANDING,o.bucket AGE_BUCKET,o.days_overdue DAYS_OVERDUE, '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>o.TNo))||'">Voucher 360</a>'||' '||case o.kind when 'AR' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>693,p_clear_cache=>'693',p_items=>'P693_PARTY,P693_FROMDATE,P693_TODATE,P693_COMPANY,P693_LOCATION,P693_PANEL',p_values=>o.AccountCode||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL))||'">Customer 360</a>' else '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>713,p_clear_cache=>'713',p_items=>'P713_PARTY,P713_FROMDATE,P713_TODATE,P713_COMPANY,P713_LOCATION,P713_PANEL',p_values=>o.AccountCode||','||:P735_FROMDATE||','||:P735_TODATE||','||:P735_COMPANY||','||:P735_LOCATION||','||:P735_PANEL))||'">Supplier 360</a>' end RELATED_360 from O o cross join B b where :P735_FAMILY='FINANCE' and (:P735_METRIC='ALL' or :P735_METRIC=o.kind) and (:P735_DIMTYPE is null or (:P735_DIMTYPE='BUCKET' and o.bucket=:P735_DIMVALUE) or (:P735_DIMTYPE='OVERDUE' and o.residual>0 and o.days_overdue>0) or (:P735_DIMTYPE='OVER90' and o.residual>0 and o.days_overdue>90) or (:P735_DIMTYPE='GROSS' and o.residual>0) or (:P735_DIMTYPE='CREDIT' and o.residual<0) or (:P735_DIMTYPE='PARTY' and o.AccountCode=:P735_DIMVALUE) or (:P735_DIMTYPE='LOCATION' and o.LocationCode=:P735_DIMVALUE) or (:P735_DIMTYPE='FORWARD' and o.residual>0 and o.due_date>=b.t-1 and o.due_date<b.t-1+to_number(:P735_DIMVALUE default null on conversion error)))
            pageItemsToSubmit: [
                P735_COMPANY
                P735_LOCATION
                P735_FROMDATE
                P735_TODATE
                P735_PANEL
                P735_ITEM
                P735_SPEC
                P735_CATEGORY
                P735_FAMILY
                P735_METRIC
                P735_DIMTYPE
                P735_DIMVALUE
                P735_DOC
            ]
        }
