page 215 (
    name: Necessity Slip Status
    alias: NECESSITY-SLIP-STATUS
    title: Necessity Slip Status
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region necessity-slip-status (
        name: Necessity Slip Status
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.NecessitySlipNo,
                      t.TransporterName,
                      w.LrNo,
                      a.VehicleNo,
                      l.LocationName as Location,
                      c.CompanyName as Company,
                      Nc.Necessitycompletionno,
                      Pa.Paymentadviceno,
                      i.Issueno,
                      vn.VehicleNecessityName, 
                      p.PartyName as PetrolPump,
                      round(B.Quantity1,3) as Quantity
                      From  NecessitySlip a, NecessitySlipDetail b, Company c, Party p , VehicleNecessity vn,
                      Location l, NecessityCompletion nc, Necessitycompletiondetail ncd, Lr w,  
                      paymentAdvice pa, Paymentadvicereference par, Requisition r ,Issue i,
                      Transporter t
                Where a.tno = b.tno(+)
                and   a.LrTno = w.Tno(+)
                and   a.CompanyCode = c.CompanyCode(+)
                and   a.PartyCode = p.PartyCode(+)
                and   b.VehiclenecessityCode = vn.VehicleNecessityCode(+)
                and   a.LocationCode = l.LocationCode(+)
                and   a.tno  = Ncd.Necessitysliptno(+)
                and   ncd.tno = nc.tno(+)
                and   a.tno = Par.Referencemoduletno(+)
                and   Par.Tno = pa.tno(+)
                and   a.Tno = r.ModuleTno(+)
                and   r.TNo = i.RequisitionTno(+)
                and   w.TransporterCode = t.TransporterCode (+)
                and a.NecessitySlipDate Between :P215_FROMDATE and :P215_TODATE
                and (:P215_LOCATION is Null Or Instr (':' || :P215_LOCATION || ':' , ':' || l.LocationName || ':') > 0)
                and (:P215_COMPANY is Null Or Instr (':' || :P215_COMPANY || ':' , ':' || C.CompanyName || ':') > 0)
                and (:P215_PUMP is Null Or Instr (':' || :P215_PUMP || ':' , ':' || p.PartyName || ':') > 0)
                and (:P215_transporter is Null Or Instr (':' || :P215_transporter || ':' , ':' || t.TransporterName || ':') > 0)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 30097329420626831
        }

