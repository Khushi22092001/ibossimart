page 678 (
    name: Voucher Analysis
    alias: VOUCHER-ANALYSIS
    title: Voucher Analysis
    pageGroup: @financial-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: The bottom of the Trial Balance drill-down: one voucher, every line, and the source document reference that raised it. Voucher.ModuleCode and ModuleTno identify the originating module - this ERP posts from more than thirty of them - and are shown as traceability text rather than as a link, because there is no single source-document page that could be linked to without inventing one. The header shows this voucher's own edit and deletion audit from VoucherLog and VoucherDLog.
    }

    region command-header (
        name: Voucher Analysis
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With V As (
                       Select v.Tno, v.VoucherNo, v.DocTypeCode, v.VoucherDate, v.CompanyCode, v.LocationCode,
                              v.FinancialYearCode, v.ModuleCode, v.ModuleTno, v.Creator, v.CreationTime,
                              v.Updater, v.UpdationTime, v.Narration, v.Panel
                         From Voucher v
                        Where v.Tno = to_number(:P678_TNO)
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or v.Panel = (Select GetUserPanelAB_apex() From dual))),
                     L As (
                       Select nvl(Sum(Case When nvl(d.Amount,0) < 0 Then -d.Amount Else 0 End),0) Dr,
                              nvl(Sum(Case When nvl(d.Amount,0) > 0 Then  d.Amount Else 0 End),0) Cr,
                              Count(*) Lines
                         From VoucherDetail d Where d.Tno = to_number(:P678_TNO)),
                     Ed As (Select Count(*) N From VoucherLog g Where g.Tno = to_number(:P678_TNO))
                Select '<div class="ds-fin-head">'
                    || '<div class="ds-fin-eyebrow">Finance &middot; General Ledger &middot; Voucher</div>'
                    || '<h1 class="ds-fin-title">' || apex_escape.html(nvl(v.VoucherNo,'Voucher not found')) || '</h1>'
                    || '<div class="ds-fin-sub">Every line of this entry, the accounts it touched, and the module that raised it</div>'
                    || '<div class="ds-fin-context">'
                    || '<span class="ds-fin-chip"><span class="fa fa-tag"></span>Type <b>' || apex_escape.html(nvl(v.DocTypeCode,'-')) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-calendar"></span>Voucher date <b>' || nvl(to_char(v.VoucherDate,'DD-MM-RRRR'),'-') || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-calendar-check-o"></span>Financial year <b>' || apex_escape.html(nvl(v.FinancialYearCode,'-')) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = v.CompanyCode), nvl(v.CompanyCode,'-'))) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = v.LocationCode), nvl(v.LocationCode,'-'))) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-cube"></span>Source <b>'
                       || apex_escape.html(nvl(v.ModuleCode,'Direct entry'))
                       || Case When v.ModuleTno Is Not Null Then ' #' || to_char(v.ModuleTno) End || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-shield"></span>Panel <b>' || apex_escape.html(nvl(v.Panel,'-')) || '</b></span>'
                    /* Integrity is stated in the header, not buried in a column: an
                       out-of-balance voucher is the single most serious thing a reader
                       can find here. */
                    || Case When Abs(l.Dr - l.Cr) < 0.005
                            Then '<span class="ds-fin-chip ds-fin-chip--live"><span class="fa fa-check"></span>Debits equal credits <b>&#8377;'
                                 || to_char(l.Dr,'FM999G99G99G990D00') || '</b></span>'
                            Else '<span class="ds-fin-chip ds-fin-chip--warn"><span class="fa fa-exclamation-triangle"></span>Out of balance by <b>&#8377;'
                                 || to_char(Abs(l.Dr - l.Cr),'FM999G99G99G990D00') || '</b></span>' End
                    || '<span class="ds-fin-chip"><span class="fa fa-user"></span>Created by <b>'
                       || apex_escape.html(nvl(v.Creator,'-'))
                       || Case When v.CreationTime Is Not Null Then ' on ' || to_char(v.CreationTime,'DD-MM-RRRR HH24:MI') End || '</b></span>'
                    || Case When v.Updater Is Not Null Then
                            '<span class="ds-fin-chip"><span class="fa fa-pencil"></span>Last edited by <b>'
                            || apex_escape.html(v.Updater)
                            || Case When v.UpdationTime Is Not Null Then ' on ' || to_char(v.UpdationTime,'DD-MM-RRRR HH24:MI') End
                            || '</b></span>' End
                    || Case When e.N > 0 Then
                            '<span class="ds-fin-chip ds-fin-chip--warn"><span class="fa fa-history"></span>Edit history <b>'
                            || to_char(e.N,'FM999G990') || ' logged change(s)</b></span>' End
                    || '</div></div>' As HEAD
                  From V v Cross Join L l Cross Join Ed e
                ```
            pageItemsToSubmit: P678_TNO
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-fin-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: This voucher does not exist, or it is outside the panel this login may see.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region history (
        name: Change History
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* VoucherLog is the ERP's own before-image audit. It is the only record
                   of a voucher having been altered after posting, and there is no
                   reversal or cancellation flag anywhere in this ledger. */
                Select g.UpdationTime  As CHANGED_ON,
                       g.Updater       As CHANGED_BY,
                       g.VoucherNo     As VOUCHER_NO_THEN,
                       g.VoucherDate   As VOUCHER_DATE_THEN,
                       substr(g.Narration,1,140) As NARRATION_THEN,
                       g.UpdateRemark  As REMARK
                  From VoucherLog g
                 Where g.Tno = to_number(:P678_TNO)
                 Order By g.UpdationTime Desc Nulls Last
                ```
            pageItemsToSubmit: P678_TNO
        }
        layout {
            sequence: 24
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: This voucher has never been edited since it was created.
        }

        column CHANGED_BY (
            derivedColumn: N
            heading {
                heading: Changed By
            }
            layout {
                sequence: 20
            }
        )

        column CHANGED_ON (
            derivedColumn: N
            heading {
                heading: Changed On
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD-MM-RRRR HH24:MI
            }
        )

        column NARRATION_THEN (
            derivedColumn: N
            heading {
                heading: Narration (before)
            }
            layout {
                sequence: 50
            }
        )

        column REMARK (
            derivedColumn: N
            heading {
                heading: Remark
            }
            layout {
                sequence: 60
            }
        )

        column VOUCHER_DATE_THEN (
            derivedColumn: N
            heading {
                heading: Date (before)
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD-MM-RRRR
            }
        )

        column VOUCHER_NO_THEN (
            derivedColumn: N
            heading {
                heading: Voucher No (before)
            }
            layout {
                sequence: 30
            }
        )

    )

    region lines (
        name: Voucher Lines
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Cost centre is aggregated to the line BEFORE it is joined:
                   VoucherCostCentreDetail can hold several rows per (Tno, Sno) and
                   joining it raw would duplicate the line and double its amount. */
                With Cc As (
                       Select c.Tno, c.Sno, listagg(Distinct c.CostCentreCode,', ')
                              Within Group (Order By c.CostCentreCode) Codes
                         From VoucherCostCentreDetail c
                        Where c.Tno = to_number(:P678_TNO)
                        Group By c.Tno, c.Sno)
                Select d.SerialNo                              As LINE_NO,
                       '<a href="' || apex_page.get_url(p_page => 677, p_clear_cache => '677',
                                p_items => 'P677_ACCOUNT', p_values => d.AccountCode)
                       || '">' || apex_escape.html(nvl(p.PartyName, d.AccountCode)) || '</a>' As ACCOUNT,
                       d.AccountCode                           As ACCOUNT_CODE,
                       apex_escape.html(nvl(g.PartyName,'&mdash;')) As ACCOUNT_GROUP,
                       Case p.BasicNature When 'DR' Then 'Debit' When 'CR' Then 'Credit' Else 'Not declared' End As EXPECTED_SIDE,
                       Round(Case When nvl(d.Amount,0) < 0 Then -d.Amount Else 0 End,2) As DEBIT,
                       Round(Case When nvl(d.Amount,0) > 0 Then  d.Amount Else 0 End,2) As CREDIT,
                       apex_escape.html(nvl(c.CompanyName, d.CompanyCode))   As COMPANY,
                       apex_escape.html(nvl(lo.LocationName, d.LocationCode)) As LOCATION,
                       cc.Codes                                As COST_CENTRE,
                       d.BillNo                                As BILL_REFERENCE,
                       nvl(d.ModuleCode,'-')                   As LINE_SOURCE,
                       substr(d.Narration,1,200)               As NARRATION,
                       Case When d.Amount Is Null
                                 Then '<span class="ds-finchip ds-finchip--bad">Null amount</span>'
                            When d.Amount = 0
                                 Then '<span class="ds-finchip ds-finchip--watch">Zero</span>'
                            When d.Amount < 0
                                 Then '<span class="ds-finchip ds-finchip--dr">Debit</span>'
                            Else      '<span class="ds-finchip ds-finchip--cr">Credit</span>' End As SIDE
                  From VoucherDetail d
                  Left Join Party p     On p.PartyCode = d.AccountCode
                  Left Join Party g     On g.PartyCode = p.ParentCode
                  Left Join Company c   On c.CompanyCode = d.CompanyCode
                  Left Join Location lo On lo.LocationCode = d.LocationCode
                  Left Join Cc cc       On cc.Tno = d.Tno And cc.Sno = d.Sno
                 Where d.Tno = to_number(:P678_TNO)
                 Order By d.SerialNo, d.Sno
                ```
            pageItemsToSubmit: P678_TNO
        }
        layout {
            sequence: 12
            slot: body
        }
