    region siblings (
        name: Other Vouchers From the Same Source Document
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Me As (Select v.ModuleCode Mc, v.ModuleTno Mt From Voucher v Where v.Tno = to_number(:P678_TNO)),
                     L As (Select d.Tno,
                                  Sum(Case When nvl(d.Amount,0) < 0 Then -d.Amount Else 0 End) Dr,
                                  Sum(Case When nvl(d.Amount,0) > 0 Then  d.Amount Else 0 End) Cr
                             From VoucherDetail d
                            Where d.Tno In (Select s.Tno From Voucher s, Me
                                             Where s.ModuleCode = Me.Mc And s.ModuleTno = Me.Mt)
                            Group By d.Tno)
                Select '<a href="' || apex_page.get_url(p_page => 678, p_clear_cache => '678',
                                p_items => 'P678_TNO', p_values => to_char(s.Tno))
                       || '">' || apex_escape.html(s.VoucherNo) || '</a>' As VOUCHER_NO,
                       s.DocTypeCode        As VOUCHER_TYPE,
                       s.VoucherDate        As VOUCHER_DATE,
                       Round(nvl(l.Dr,0),2) As DEBIT,
                       Round(nvl(l.Cr,0),2) As CREDIT,
                       Case When s.Tno = to_number(:P678_TNO)
                            Then '<span class="ds-finchip ds-finchip--ok">This voucher</span>' End As MARKER
                  From Voucher s
                  Join Me m On s.ModuleCode = m.Mc And s.ModuleTno = m.Mt
                  Left Join L l On l.Tno = s.Tno
                 Where ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                 Order By s.VoucherDate, s.VoucherNo
                ```
            pageItemsToSubmit: P678_TNO
        }
        layout {
            sequence: 22
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: This voucher was entered directly, not raised from a source document, so it has no siblings.
        }

