    region voucher-note (
        name: Voucher Basis
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-finnote">
                  <span class="fa fa-info-circle"></span>
                  <b>Source document.</b> The header names the module that raised this voucher and its document id.
                  It is shown as text, not as a link: <code>ModuleCode</code> spans more than thirty modules in this
                  ERP and there is no single source-document page that every one of them could open, so a link would
                  be broken for most vouchers. Use the module and id to find the document in its own register.
                  <b>Cost centre</b> is aggregated per line &mdash; a line can carry several &mdash; and never joined
                  raw, which would duplicate the line and double its amount.
                </div>
                ```
        }
        layout {
            sequence: 13
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-fin-sectionregion
        }
    )

