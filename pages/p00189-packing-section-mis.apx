    region oil-stock-summary (
        name: OIL STOCK SUMMARY
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.STORAGELOCATIONNAME,
                       ROUND(GetSLItemOpeningQuantity1(A.STORAGELOCATIONCODE,
                                                A.ITEMCODE,
                                                Null,
                                                '1',
                                                TO_DATE(:P189_FROMDATE,'DD-MON-RRRR')+1, null, null, null,null),3) As Stock
                  From Storagelocation A
                 Where a.parentcode='FILLING' 
                   and Nvl(GetSLItemOpeningQuantity1(A.STORAGELOCATIONCODE,
                                                    A.ITEMCODE,
                                                    Null,
                                                    '1',
                                                    TO_DATE(:P189_FROMDATE,'DD-MON-RRRR')+1, null,null,null,null),
                           0) > 0
                Order By Abs(Replace(STORAGELOCATIONSHORTNAME, 'F', ''))
                ```
        }
        layout {
            sequence: 20
            slot: body
            column: 1
            columnSpan: 4
