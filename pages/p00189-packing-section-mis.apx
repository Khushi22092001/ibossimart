    region specification-wise-packed-material-stock-position (
        name: SPECIFICATION WISE PACKED MATERIAL STOCK POSITION
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM (
                Select A.ITEMCODE,A.ITEMNAME, B.ITEMSPECIFICATIONCODE,  B.ITEMSPECIFICATIONNAME,
                   getslitemopeningquantity1(Null,
                                                 A.ITEMCODE,
                                                 B.ITEMSPECIFICATIONCODE,
                                                 '1',
                                                 :P189_FROMDATE,null,null,null,null) As OPENING,
                       GETSLITEMPRODUCTIONQUANTITY1(Null,
                                                    A.ITEMCODE,
                                                    B.ITEMSPECIFICATIONCODE,
                                                    '1',
                                                    :P189_FROMDATE,
                                                    :P189_FROMDATE) As PRODUCTION,
                       getslitempurchasequantity1(Null,
                                                  A.ITEMCODE,
                                                  B.ITEMSPECIFICATIONCODE,
                                                  '1',
                                                  :P189_FROMDATE,
                                                  :P189_FROMDATE) As PURCHASE,
                       getslitemconsumptionquantity1(Null,
                                                     A.ITEMCODE,
                                                     B.ITEMSPECIFICATIONCODE,
                                                     '1',
                                                     :P189_FROMDATE,
                                                     :P189_FROMDATE) As consumption,
                       getslitemDespatchquantity1(Null,
                                                  A.ITEMCODE,
                                                  B.ITEMSPECIFICATIONCODE,
                                                  '1',
                                                  :P189_FROMDATE,
                                                  :P189_FROMDATE) As despatch,
                    GetSLItemLeakageQuantity1(Null,
                                                          A.ITEMCODE,
                                                          B.ITEMSPECIFICATIONCODE,
                                                          '1',
                                                          :P189_FROMDATE,
                                                          :P189_FROMDATE) As Leakage,  
                               GetSLItemSaleReturnQuantity1(Null,
                                                          A.ITEMCODE,
                                                          B.ITEMSPECIFICATIONCODE,
                                                          '1',
                                                          :P189_FROMDATE,
                                                          :P189_FROMDATE) As SaleReturn,  
                       getslitemopeningquantity1(Null,
                                                 A.ITEMCODE,
                                                 B.ITEMSPECIFICATIONCODE,
                                                 '1',
                                                 TO_DATE(:P189_FROMDATE,'DD-MON-RRRR')+1,null,null,null,null ) As closing
                  From ITEM A, ITEMSPECIFICATION B
                 Where A.TNO = B.TNO
                   AND A.ITEMNATURECODE In
                       ('FINISHEDITEM', 'SEMIFINISHEDITEM', 'BYPRODUCTS')
                   AND A.ITEMCLASSCODE='PACKED'
                ) X
                WHERE NVL(X.OPENING,0) > 0 
                   OR NVL(X.CLOSING,0) > 0
                   OR NVL(X.SaleReturn,0) > 0
                   OR NVL(X.Leakage,0) > 0
                   OR NVL(X.despatch,0) > 0
                   OR NVL(X.consumption,0) > 0
                   OR NVL(X.PRODUCTION,0) > 0
                   OR NVL(X.PURCHASE,0) > 0
                 ORDER BY X.ITEMNAME, X.ITEMSPECIFICATIONNAME
                ```
            pageItemsToSubmit: P189_FROMDATE
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            column: 5
        }
