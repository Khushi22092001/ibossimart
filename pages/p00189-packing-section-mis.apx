    region item-wise-stock-position (
        name: ITEM WISE  STOCK POSITION
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM 
                (Select A.ITEMCODE,A.ITEMNAME, 
                   getslitemopeningquantity1(Null,
                                                 A.ITEMCODE,
                                                 Null,
                                                 '1',
                                                 :P189_FROMDATE,null,null,null,null) As OPENING,
                       GETSLITEMPRODUCTIONQUANTITY1(Null,
                                                    A.ITEMCODE,
                                                    Null,
                                                    '1',
                                                    :P189_FROMDATE,
                                                    :P189_FROMDATE) As PRODUCTION,
                       getslitempurchasequantity1(Null,
                                                  A.ITEMCODE,
                                                  Null,
                                                  '1',
                                                  :P189_FROMDATE,
                                                  :P189_FROMDATE) As PURCHASE,
                       getslitemconsumptionquantity1(Null,
                                                     A.ITEMCODE,
                                                     Null,
                                                     '1',
                                                     :P189_FROMDATE,
                                                     :P189_FROMDATE) As consumption,
                       getslitemDespatchquantity1(Null,
                                                  A.ITEMCODE,
                                                  Null,
                                                  '1',
                                                  :P189_FROMDATE,
                                                  :P189_FROMDATE) As despatch,
                    GetSLItemLeakageQuantity1(Null,
                                                          A.ITEMCODE,
                                                          Null,
                                                          '1',
                                                          :P189_FROMDATE,
                                                          :P189_FROMDATE) As Leakage,  
                               GetSLItemSaleReturnQuantity1(Null,
                                                          A.ITEMCODE,
                                                          Null,
                                                          '1',
                                                          :P189_FROMDATE,
                                                          :P189_FROMDATE) As SaleReturn,  
                       getslitemopeningquantity1(Null,
                                                 A.ITEMCODE,
                                                 Null,
                                                 '1',
                                                 TO_DATE(:P189_FROMDATE,'DD-MON-RRRR')+1,null,null,null,null ) As closing
                  From ITEM A
                 Where A.ITEMNATURECODE In
                       ('FINISHEDITEM', 'SEMIFINISHEDITEM', 'BYPRODUCTS')
                   AND A.ITEMCLASSCODE='PACKED'
                ) X
                WHERE NVL(X.OPENING,0) > 0 
                   OR NVL(X.CLOSING,0) > 0
                   OR NVL(X.SaleReturn,0) > 0
                   OR NVL(X.Leakage,0) > 0
                   OR NVL(X.despatch,0) > 0
                   OR NVL(X.consumption,0) > 0
                   OR NVL(X.PRODUCTION,0) > 0
                   OR NVL(X.PURCHASE,0) > 0
                 ORDER BY X.ITEMNAME
                ```
            pageItemsToSubmit: P189_FROMDATE
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            column: 5
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: STOCK POSITION
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        heading {
            fixedTo: region
            maxReportHeight: 350
        }
        advanced {
            savedReportMappingIdentifier: 23787691012006522
        }

