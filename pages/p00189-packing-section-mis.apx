    region stock-position (
        name: STOCK POSITION
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select ITEMCODE,
                       ITEMNAME,
                       Sum(OPENING) As OPENING,
                       Sum(PRODUCTION) As PRODUCTION,
                      -- SUM(SALERETURN) As SALERETURN,
                       Sum(PURCHASE) As PURCHASE,
                       Sum(CONSUMPTION) As CONSUMPTION,
                       Sum(DESPATCH) As DESPATCH,
                     --  SUM(LEAKAGE) As LEAKAGE,
                       Sum(CLOSING) As CLOSING
                  From (Select A.ITEMCODE,
                               A.ITEMNAME,
                               getslitemopeningquantity1(Null,
                                                         A.ITEMCODE,
                                                         Null,
                                                         '1',
                                                         :P189_FROMDATE,
                                                         Null,
                                                         Null,
                                                         Null,
                                                         Null) As OPENING,
                               GETSLITEMPRODUCTIONQUANTITY1(Null,
                                                            A.ITEMCODE,
                                                            Null,
                                                            '1',
                                                            :P189_FROMDATE,
                                                            :P189_FROMDATE) As PRODUCTION,
                               getslitempurchasequantity1(Null,
                                                          A.ITEMCODE,
                                                          Null,
                                                          '1',
                                                          :P189_FROMDATE,
                                                          :P189_FROMDATE) As PURCHASE,
                               getslitemconsumptionquantity1(Null,
                                                             A.ITEMCODE,
                                                             Null,
                                                             '1',
                                                             :P189_FROMDATE,
                                                             :P189_FROMDATE) As consumption,
                               getslitemDespatchquantity1(Null,
                                                          A.ITEMCODE,
                                                          Null,
                                                          '1',
                                                          :P189_FROMDATE,
                                                          :P189_FROMDATE) As despatch,                      
                               getslitemopeningquantity1(Null,
                                                         A.ITEMCODE,
                                                         Null,
                                                         '1',
                                                         TO_DATE(:P189_FROMDATE,
                                                                 'DD-MON-RRRR') + 1,
                                                         Null,
                                                         Null,
                                                         Null,
                                                         Null) As closing
                        
                          From ITEM A, STORAGELOCATION B
                         Where A.ITEMCODE = B.ITEMCODE
                           And B.PARENTCODE = 'FILLING'
                         Order By Abs(Replace(B.STORAGELOCATIONSHORTNAME, 'F', ''))
                        
                        ) X
                
                 Where Nvl(X.OPENING, 0) > 0
                    Or Nvl(X.PRODUCTION, 0) > 0
                    Or Nvl(X.PURCHASE, 0) > 0
                    Or Nvl(X.CONSUMPTION, 0) > 0
                    Or Nvl(X.DESPATCH, 0) > 0
                    Or Nvl(X.CLOSING, 0) > 0
                GROUP BY ITEMCODE,
                       ITEMNAME
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            column: 5
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: STOCK POSITION
        }
