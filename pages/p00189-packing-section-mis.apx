    region dip-reading (
        name: DIP Reading
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.storagelocationname,
                        b.quantityinmt
                  From dipreading       a,
                       dipreadingdetail  b,
                       storagelocation   c,
                       item              d,
                       itemspecification e
                 Where a.tno = b.tno
                   And b.storagelocationcode = c.storagelocationcode(+)
                   And b.itemcode = d.itemcode(+)
                   And b.itemspecificationcode = e.itemspecificationcode(+)
                   And a.DIPReadingDate = nvl(:P189_FROMDATE,trunc(sysdate)) 
                
                ```
            pageItemsToSubmit: P189_FROMDATE
        }
        layout {
            sequence: 40
            slot: body
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: STOCK AS DIP
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 75815523942280528
        }

