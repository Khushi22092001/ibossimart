page 256 (
    name: ItemDetail
    alias: ITEMDETAIL
    title: ItemDetail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region itemdetail (
        name: ItemDetail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C.TNO,
                C.SNO,
                H.ITEMNAME,
                C.quantity1,
                C.lastpurchaserate,
                C.amount,
                C.remark
                FROM MAINTENANCEORDERITEMDETAIL c,equipmentmaintenanceorderdtl a,item h,EQUIPMENTMAINTENANCEORDER AA
                where c.tno=a.tno
                and c.sno=a.sno
                and c.itemcode = h.itemcode
                AND AA.TNO= :P256_TNO
                AND A.SNO=:P256_SNO
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 4450578375688749
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column ITEMNAME (
            type: plainText
            heading {
                heading: Itemname
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column LASTPURCHASERATE (
            type: plainText
            heading {
                heading: Lastpurchaserate
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Quantity1
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column SNO (
            type: plainText
            heading {
                heading: Sno
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: ItemDetail
        }

        savedReport 50956 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 4
            )

            displayColumn ITEMNAME (
                sequence: 1
            )

            displayColumn LASTPURCHASERATE (
                sequence: 3
            )

            displayColumn QUANTITY1 (
                sequence: 2
            )

            displayColumn REMARK (
                sequence: 5
            )

        )

    )

    pageItem P256_SNO (
        type: hidden
        layout {
            sequence: 20
            slot: body
        }
    )

    pageItem P256_TNO (
        type: hidden
        layout {
            sequence: 30
            slot: body
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 255
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

