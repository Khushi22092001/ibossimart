page 9999 (
    name: Login Page
    alias: LOGIN
    title: iBoss - Sign In
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            apex.jQuery(function ($) {
                var EYE_OFF = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18"/><path d="M10.6 6.2A9.7 9.7 0 0 1 12 6c6 0 9.5 6 9.5 6a16 16 0 0 1-3.3 4M6.4 8.1A16 16 0 0 0 2.5 12S6 18 12 18a9.4 9.4 0 0 0 4-.9"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>';
                var EYE_ON  = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 12S6 6 12 6s9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/><circle cx="12" cy="12" r="3"/></svg>';
                $('#P9999_USERNAME').closest('.t-Form-fieldContainer').prepend('<span class="hg-flabel">Username</span>');
                $('#P9999_PASSWORD').closest('.t-Form-fieldContainer').prepend('<span class="hg-flabel">Password</span>');
                var $pw = $('#P9999_PASSWORD');
                if ($pw.length) {
                    var $eye = $('<button type="button" class="hg-eye" tabindex="-1" aria-label="Show password"></button>').html(EYE_OFF);
                    $pw.parent().append($eye);
                    $eye.on('click', function () {
                        var show = $pw.attr('type') === 'password';
                        $pw.attr('type', show ? 'text' : 'password');
                        $eye.html(show ? EYE_ON : EYE_OFF).attr('aria-label', show ? 'Hide password' : 'Show password');
                        $pw.trigger('focus');
                    });
                }
                var $rem = $('#P9999_REMEMBER_CONTAINER'), $row = $('<div class="hg-row"></div>');
                if ($rem.length) { $rem.after($row); $row.append($rem); }
                else { $('#P9999_PASSWORD').closest('.t-Form-fieldContainer').after($row); }
                $row.find('label').each(function () { if ($.trim($(this).text()).toLowerCase().indexOf('remember') === 0) { $(this).text('Remember sign-in'); } });
                var rememberKey = 'hspl.rememberSignIn';
                var rememberAllowed = false;
                try { rememberAllowed = localStorage.getItem(rememberKey) === 'Y'; } catch (ignore) {}
                $('#P9999_USERNAME').attr('autocomplete', rememberAllowed ? 'username' : 'off');
                $pw.attr('autocomplete', rememberAllowed ? 'current-password' : 'off');
                if (!rememberAllowed) $pw.val('');
                var $rememberBox = $('#P9999_REMEMBER_CONTAINER input[type="checkbox"]').first();
                $rememberBox.prop('checked', rememberAllowed && $rememberBox.prop('checked'));
                $('#B_LOGIN, .t-Login-buttons .t-Button').first().on('click.hgRemember', function () {
                    var keep = $rememberBox.prop('checked');
                    try { if (keep) localStorage.setItem(rememberKey, 'Y'); else localStorage.removeItem(rememberKey); } catch (ignore) {}
                    $('#P9999_USERNAME').attr('autocomplete', keep ? 'username' : 'off');
                    $pw.attr('autocomplete', keep ? 'current-password' : 'off');
                });
                $('#P9999_USERNAME').on('keydown', function (e) {
                    if (e.key === 'Tab' && !e.shiftKey) {
                        e.preventDefault();
                        $pw.trigger('focus');
                    }
                });
                var $btn = $('#B_LOGIN, .t-Login-buttons .t-Button').first();
                if ($btn.length && $btn.find('.hg-btn-ico').length === 0) {
                    $btn.prepend('<span class="hg-btn-ico"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5M15 12H3"/></svg></span>');
                }
                if ($('#P9999_USERNAME').val()) { $('#P9999_PASSWORD').trigger('focus'); } else { $('#P9999_USERNAME').trigger('focus'); }
            });
            ```
    }
    css {
        inline:
            ```css
            @font-face{
              font-family:'Inter';
              font-style:normal;font-weight:100 900;font-display:swap;
              src:url("#APP_FILES#Inter.woff2") format("woff2");
            }
            @font-face{
              font-family:'Manrope';
              font-style:normal;font-weight:200 800;font-display:swap;
              src:url("#APP_FILES#Manrope.woff2") format("woff2");
            }
            :root{
              --hg-navy:#0B1F42;          /* hero overlay */
              --hg-primary:#163A76;       /* primary button */
              --hg-primary-hi:#204A94;    /* primary button hover */
              --hg-focus:#2E6BE6;         /* focus outline - the only blue accent */
              --hg-accent:#F58220;        /* brand orange */
              --hg-ink:#16233B;
              --hg-muted:#64748B;
              --hg-border:#D8DFEA;
              --hg-font:'Inter','Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
              --hg-display:'Manrope','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
              --hg-curve:38px;
            }
            *{box-sizing:border-box}
            html,body{height:100%}
            /* Pure white. This is what shows through the hero's rounded inner edge, so it
               MUST be white - any tint here reads as the grey divider we are removing. */
            body{margin:0;height:100vh;overflow:hidden;background:#F1F5F9;
              font-family:var(--hg-font);color:var(--hg-ink);-webkit-font-smoothing:antialiased}
            .t-Body,.t-Body-main,.t-Body-content,#t_Body_content{padding:0;margin:0;max-width:none;background:transparent}
            .t-Login-container{max-width:none;width:100%;height:100vh;overflow:hidden;margin:0;padding:0;
              row-gap:0;gap:0;background:
                radial-gradient(circle at 12% 16%,rgba(22,58,118,.08),transparent 25%),
                radial-gradient(circle at 88% 82%,rgba(245,130,32,.07),transparent 24%),#F1F5F9}
            .t-Login-containerHeader,.t-Login-containerFooter,.t-Login-bg,.t-Login-bgImg{display:none}
            
            /* Centred reference-style login shell. */
            .t-Login-containerBody{
              display:grid;grid-template-columns:52fr 48fr;grid-template-rows:1fr auto;
              height:min(82vh,900px);min-height:620px;overflow:visible;width:min(90vw,1380px);
              max-width:1380px;margin:auto;padding:0;background:#fff;border-radius:var(--hg-curve);
              box-shadow:0 28px 70px rgba(15,35,70,.16);position:absolute;inset:0;
            }
            /* APEX wraps every region in .container>.row>.col - flatten so the regions
               become direct grid items. */
            .t-Login-containerBody>.container,
            .t-Login-containerBody>.container>.row,
            .t-Login-containerBody>.container>.row>.col{display:contents}
            .t-Login-containerBody .col{padding:0;margin:0;max-width:none}
            
            
            /* =========================== LEFT : HERO =========================== */
            .hg-brand{
              grid-column:1;grid-row:1/-1;align-self:stretch;min-height:0;position:relative;overflow:hidden;
              display:flex;flex-direction:column;justify-content:center;
              padding:64px 98px;color:#fff;
              border:0;border-radius:var(--hg-curve) 0 0 var(--hg-curve);
              background-image:
                radial-gradient(circle at 18% 12%,transparent 0 38px,rgba(255,255,255,.16) 39px 40px,transparent 41px),
                radial-gradient(circle at 76% 17%,transparent 0 53px,rgba(245,130,32,.34) 54px 55px,transparent 56px),
                radial-gradient(circle at 82% 72%,rgba(255,255,255,.10) 0 66px,rgba(255,255,255,.05) 67px,transparent 68px),
                radial-gradient(circle at 9% 87%,transparent 0 105px,rgba(255,255,255,.13) 106px 107px,transparent 108px),
                radial-gradient(circle,rgba(255,255,255,.11) 0 1px,transparent 1.5px),
                linear-gradient(145deg,#173F7B 0%,#102F61 48%,#09244D 100%);
              background-size:auto,auto,auto,auto,18px 18px,auto;
            }
            .hg-brand::before{content:"";position:absolute;left:-90px;bottom:-125px;width:290px;height:290px;
              border:1px solid rgba(255,255,255,.18);border-radius:50%;pointer-events:none}
            .hg-brand::after{content:"";position:absolute;right:28%;bottom:20%;width:124px;height:124px;
              border-radius:50%;background:rgba(255,255,255,.065);border:1px solid rgba(255,255,255,.06);pointer-events:none}
            .hg-brand>*{position:relative;z-index:1}
            .hg-divider{position:absolute!important;z-index:4!important;right:-2px;top:0;width:230px;height:100%;
              overflow:visible;filter:drop-shadow(-14px 0 16px rgba(7,28,62,.12));pointer-events:none}
            
            .hg-lockup{display:flex;flex-direction:column;align-items:flex-start;width:max-content;max-width:78%;
              margin-bottom:42px;padding:12px 18px 10px;border:1px solid rgba(255,255,255,.62);border-radius:18px;
              background:rgba(255,255,255,.93);box-shadow:0 14px 30px rgba(3,20,47,.18),inset 0 1px 0 #fff;
              backdrop-filter:blur(7px)}
            .hg-brandlogo{display:block;width:min(250px,68%);height:auto;max-height:126px;object-fit:contain;object-position:left center;
              filter:drop-shadow(0 7px 14px rgba(0,0,0,.13))}
            .hg-lockmark{display:flex;align-items:center;gap:12px}
            .hg-lockchip{display:inline-flex;align-items:center;justify-content:center;background:#fff;border-radius:9px;padding:5px;box-shadow:0 4px 14px rgba(0,0,0,.22)}
            .hg-lockimg{width:30px;height:30px;object-fit:contain;display:block}
            .hg-cardimg{width:46px;height:46px;object-fit:contain;margin-bottom:8px}
            .hg-lockname{font-family:var(--hg-display);font-size:34px;font-weight:800;letter-spacing:-.03em;line-height:1;color:#fff}
            .hg-locktag{margin-top:7px;display:block;width:196px;text-align:center;padding:4px 0;border-radius:4px;
              background:var(--hg-accent);color:#fff;font-family:var(--hg-display);
              font-size:11px;font-weight:700;letter-spacing:.46em;text-indent:.46em;line-height:1.2}
            
            .hg-title{margin:0;font-family:var(--hg-display);font-size:clamp(26px,2.05vw,34px);line-height:1.14;
              font-weight:800;letter-spacing:-.032em;color:#fff}
            .hg-title span{display:block;color:#9EC3F4}
            .hg-title::after{content:"";display:block;width:58px;height:4px;border-radius:4px;background:var(--hg-accent);margin-top:22px}
            .hg-sub{margin:18px 0 0;font-size:15px;line-height:1.55;font-weight:400;color:#C3D2EC;max-width:32em}
            
            /* feature list - thin outline icons, no cards, no boxes */
            .hg-feats{list-style:none;margin:32px 0 0;padding:0;display:flex;flex-direction:column;gap:14px}
            .hg-feats li{display:flex;align-items:center;gap:14px;font-size:15.5px;font-weight:500;color:#E8EEF9}
            .hg-feats svg{flex:none;width:20px;height:20px;color:#fff;opacity:.92}
            
            
            /* ====================== RIGHT : WHITE CANVAS ======================
               Pure white, no card, no border, no shadow. Anything painted between the
               two columns would re-create the divider we are removing. */
            .t-Login-containerBody .t-Login-region,
            .t-Login-containerBody .hg-extras{
              grid-column:2;justify-self:stretch;width:auto;max-width:none;
              background:#fff!important;box-sizing:border-box;
              margin:0;border:0;border-radius:0;box-shadow:none;
            }
            .t-Login-containerBody .t-Login-region{
              grid-row:1;align-self:stretch;padding:40px 86px 24px 112px;
              display:flex;flex-direction:column;justify-content:center;
              border-radius:0 var(--hg-curve) var(--hg-curve) 0;
              background-color:#fff!important;
              background-image:
                radial-gradient(circle at 88% 12%,transparent 0 58px,rgba(22,58,118,.09) 59px 60px,transparent 61px),
                radial-gradient(circle at 18% 14%,rgba(245,130,32,.055) 0 34px,transparent 35px),
                radial-gradient(circle at 78% 72%,rgba(22,58,118,.035) 0 48px,transparent 49px),
                radial-gradient(circle at 102% 93%,transparent 0 105px,rgba(22,58,118,.09) 106px 107px,transparent 108px),
                radial-gradient(circle,rgba(22,58,118,.055) 0 1px,transparent 1.5px)!important;
              background-size:auto,auto,auto,auto,20px 20px!important;
              /* UT's loginFade leaves the region at scale(.95) */
              animation:none!important;transform:none!important;
            }
            .t-Login-containerBody .hg-extras{position:absolute;z-index:6;left:0;right:0;bottom:22px;padding:0 32px;
              background:transparent!important}
            
            /* strip UT's own login chrome */
            .t-Login-region .t-Login-header,.t-Login-region .t-Login-logo,.t-Login-region .t-Login-title,
            .t-Login-region .t-Login-icon,.t-Login-region .t-Login-regionHeading{display:none!important}
            .t-Login-region .t-Login-body{padding:0;max-width:none;width:100%}
            .t-Login-region .t-Login-links,.t-Login-region .t-Login-subRegions{display:none}
            /* one strict column, centred - keeps the fields off the full 45% width */
            .t-Login-region .hg-cardhead,
            .t-Login-region .hg-welcome,
            .t-Login-region .hg-welcome-sub,
            .t-Login-region .t-Login-body,
            .t-Login-region .t-Login-buttons{width:100%;max-width:400px;margin-left:auto;margin-right:auto}
            .t-Login-region .t-Login-buttons{padding:0;border:0;background:transparent}
            
            .hg-cardhead{display:none}
            .hg-cardlogo{display:none}
            .hg-cardhead .cn{font-family:var(--hg-display);font-size:30px;font-weight:800;letter-spacing:-.03em;color:#12315F;line-height:1}
            .hg-cardhead .ct{margin-top:7px;display:block;width:178px;text-align:center;padding:4px 0;border-radius:4px;
              background:var(--hg-accent);color:#fff;font-family:var(--hg-display);
              font-size:10.5px;font-weight:700;letter-spacing:.46em;text-indent:.46em;line-height:1.2}
            .hg-welcome{margin:0;text-align:left;font-family:var(--hg-display);
              font-size:30px;font-weight:800;letter-spacing:-.03em;color:var(--hg-ink)}
            .hg-welcome-sub{margin:10px 0 36px;text-align:left;font-size:14.5px;color:var(--hg-muted);font-weight:400}
            
            /* ---------- fields ---------- */
            .t-Login-region .t-Form-fieldContainer{margin-bottom:20px;width:100%}
            .t-Login-region .t-Form-labelContainer{display:none}
            .t-Login-region .t-Form-inputContainer{width:100%;max-width:none;flex:1 1 100%}
            /* APEX positions the item icon outside the field and wraps password inputs in an
               extra .apex-item-group--password; override both so the icon and the eye toggle
               sit INSIDE the input. */
            .t-Login-region .t-Form-itemWrapper{position:relative!important;display:block!important;width:100%!important}
            .t-Login-region .t-Form-itemWrapper>.apex-item-icon,
            .t-Login-region .t-Form-itemWrapper>.fa,
            .t-Login-region .t-Form-itemWrapper>.t-Icon{
              position:absolute!important;left:18px!important;right:auto!important;top:50%!important;
              transform:translateY(-50%)!important;margin:0!important;width:auto!important;height:auto!important;
              z-index:2!important;font-size:17px!important;color:#98A3B6!important;
              pointer-events:none!important;background:none!important}
            .t-Login-region .apex-item-group--password{width:100%!important;display:block!important;margin:0!important}
            .t-Login-region .apex-item-group--password>input{width:100%!important}
            /* APEX ships its own password-visibility button inside that group; it steals
               width from the field. We render our own .hg-eye overlay instead. */
            .t-Login-region .t-Button--passwordVisibility{display:none!important}
            
            .hg-flabel{display:block;font-size:13px;font-weight:500;margin-bottom:8px;color:#46536A}
            
            .t-Login-region input#P9999_USERNAME,
            .t-Login-region input#P9999_PASSWORD{
              width:100%;height:54px;border-radius:14px;border:1px solid var(--hg-border);background:#fff;
              padding:0 18px 0 48px;font:400 15px/1 var(--hg-font);color:var(--hg-ink);box-shadow:none;
              transition:border-color .18s ease;
            }
            .t-Login-region input#P9999_USERNAME::placeholder,
            .t-Login-region input#P9999_PASSWORD::placeholder{color:#9AA7BC;font-weight:400}
            .t-Login-region input#P9999_USERNAME:hover,
            .t-Login-region input#P9999_PASSWORD:hover{border-color:#C4CFDF}
            /* a plain 2px blue outline - no glow, no ring stack */
            .t-Login-region input#P9999_USERNAME:focus,
            .t-Login-region input#P9999_PASSWORD:focus{
              border-color:var(--hg-focus);box-shadow:none;
              outline:2px solid var(--hg-focus);outline-offset:1px;
            }
            .t-Login-region .t-Form-itemWrapper:focus-within>.apex-item-icon,
            .t-Login-region .t-Form-itemWrapper:focus-within>.fa,
            .t-Login-region .t-Form-itemWrapper:focus-within>.t-Icon{color:var(--hg-focus)!important}
            .hg-eye{position:absolute!important;right:10px;top:50%;transform:translateY(-50%);width:34px;height:34px;border:0;
              border-radius:10px;background:transparent;display:grid;place-items:center;color:#9AA7BC;cursor:pointer;z-index:3;
              transition:color .18s ease,background .18s ease}
            .hg-eye:hover{color:var(--hg-focus);background:#F3F6FC}
            
            .hg-row{display:flex;align-items:center;justify-content:flex-start;margin:4px 0 28px}
            .hg-row .t-Form-fieldContainer{margin:0}
            .t-Login-region .apex-item-checkbox+label,.t-Login-region .checkbox_group label{
              font-size:14px;font-weight:500;color:var(--hg-ink);margin:0 0 0 10px;cursor:pointer}
            .t-Login-region input[type="checkbox"]{width:18px;height:18px;border-radius:5px;accent-color:var(--hg-focus);cursor:pointer}
            
            /* ---------- primary button ---------- */
            .t-Login-region .t-Login-buttons .t-Button{
              position:relative;width:100%;height:56px;border:0;border-radius:14px;
              background:var(--hg-primary);color:#fff;
              font-family:var(--hg-display);font-size:15.5px;font-weight:600;letter-spacing:0;
              display:flex;align-items:center;justify-content:center;gap:10px;
              box-shadow:0 1px 2px rgba(11,31,66,.14);text-shadow:none;cursor:pointer;
              transition:background .18s ease,box-shadow .18s ease}
            .t-Login-region .t-Login-buttons .t-Button:hover{
              background:var(--hg-primary-hi);box-shadow:0 4px 14px -4px rgba(11,31,66,.34)}
            .t-Login-region .t-Login-buttons .t-Button:active{box-shadow:0 1px 2px rgba(11,31,66,.14)}
            .t-Login-region .t-Login-buttons .t-Button:focus-visible{outline:2px solid var(--hg-focus);outline-offset:2px}
            .t-Login-region .t-Login-buttons .t-Button .hg-btn-ico{display:inline-flex;align-items:center}
            
            /* one quiet line, no rule above it */
            .hg-foot{margin:0;padding:0;display:flex;align-items:center;justify-content:center;gap:10px;
              flex-wrap:wrap;font-size:12px;letter-spacing:.01em;color:#8491A6}
            .hg-foot span{white-space:nowrap}
            .hg-foot strong{font-weight:700;color:#183A70}
            .hg-foot i{font-style:normal;color:#D8DFEA;margin:0 7px}
            
            
            /* =========================== RESPONSIVE =========================== */
            @media (max-width:1240px){
              .hg-brand{padding:48px 58px}
              .t-Login-containerBody .t-Login-region{padding:32px 52px 20px 88px}
            }
            @media (max-width:900px){
              html,body,.t-Login-container{height:auto;min-height:100%;overflow:auto}
              .t-Login-containerBody{position:relative;inset:auto;width:calc(100% - 28px);height:auto;min-height:0;
                margin:14px auto;grid-template-columns:1fr;grid-template-rows:auto auto auto;border-radius:24px}
              /* stacked: curve the bottom edge instead of the right */
              .hg-brand{grid-column:1;grid-row:1;min-height:0;padding:40px 26px;
                border-radius:24px 24px 0 0}
              .hg-divider{display:none}
              .hg-lockup{margin-bottom:32px}
              .hg-feats{margin-top:30px;gap:14px}
              .t-Login-containerBody .t-Login-region{grid-column:1;grid-row:2;align-self:auto;padding:36px 26px 16px}
              .t-Login-containerBody .hg-extras{position:static;grid-column:1;grid-row:3;align-self:auto;padding:0 26px 26px;background:#fff!important;
                border-radius:0 0 24px 24px}
            }
            /* short desktop viewports: compress so it still fits with no scroll */
            @media (min-width:901px) and (max-height:800px){
              .hg-brand{padding:44px 56px}
              .hg-lockup{margin-bottom:34px}
              .hg-title{font-size:clamp(27px,2.2vw,34px)}
              .hg-sub{font-size:15px;margin-top:16px}
              .hg-feats{margin-top:28px;gap:13px}
              .hg-feats li{font-size:14.5px}
              .hg-cardhead .cn{font-size:26px}
              .hg-welcome{margin-top:22px;font-size:26px}
              .hg-welcome-sub{margin:8px 0 22px}
              .t-Login-region .t-Form-fieldContainer{margin-bottom:14px}
              .t-Login-region input#P9999_USERNAME,.t-Login-region input#P9999_PASSWORD{height:50px}
              .hg-row{margin:2px 0 20px}
              .t-Login-region .t-Login-buttons .t-Button{height:52px}
              .t-Login-containerBody .t-Login-region{padding:26px 56px 16px}
              .t-Login-containerBody .hg-extras{padding:0 56px 20px}
            }
            @media (min-width:901px) and (max-height:660px){
              .hg-welcome{font-size:23px;margin-top:14px}
              .hg-feats{gap:10px}
              .hg-sub{display:none}
              .t-Login-region input#P9999_USERNAME,.t-Login-region input#P9999_PASSWORD{height:46px}
              .t-Login-region .t-Login-buttons .t-Button{height:48px}
              .t-Login-region .t-Form-fieldContainer{margin-bottom:10px}
            }
            @media (prefers-reduced-motion:reduce){
              .t-Login-region,.hg-extras,.t-Login-region .t-Login-buttons .t-Button{
                animation:none!important;transition-duration:.01ms!important}
            }
            ```
    }
    security {
        authentication: public
        formAutoComplete: false
    }

    region auth-extras (
        name: Security And Footer
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hg-foot">
                  <span>Powered by <strong>Infomatics Technologies</strong></span>
                </div>
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hg-extras
        }
    )

    region brand-panel (
        name: Brand Panel
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hg-lockup">
                  <img class="hg-brandlogo" src="#APP_FILES#infomatics-logo-black.png" alt="iBoss">
                </div>
                
                <h1 class="hg-title">Transforming Operations.<span>Through Technology.</span></h1>
                <p class="hg-sub">Empowering businesses with intelligent solutions to drive growth, efficiency and excellence.</p>
                <ul class="hg-feats">
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V9l5 3V9l5 3V9l4 2v10"/><path d="M9 21v-4h3v4"/></svg><span>Integrated Manufacturing</span></li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="19" r="1.8"/><circle cx="17" cy="19" r="1.8"/></svg><span>Smart Supply Chain</span></li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.7-3.3 8-8 9-4.7-1-8-4.3-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg><span>Quality Assurance</span></li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 16l4-5 3 3 5-7"/></svg><span>Enterprise Analytics</span></li>
