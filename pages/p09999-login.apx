                  <path fill="#CFDBEA" opacity=".72" d="M220 0H116C79 43 65 91 78 143c13 50 66 81 62 137-5 61-66 96-70 154-5 67 59 103 68 164 10 67-55 119-62 176-7 49 8 88 30 126H220V0Z"/>
                  <path fill="#EAF0F7" opacity=".97" d="M220 0H132C94 45 81 94 94 146c13 49 63 79 59 134-5 62-65 97-68 155-4 64 56 101 66 162 10 66-52 118-59 176-6 48 9 89 28 127H220V0Z"/>
                  <path fill="#FFFFFF" d="M220 0H149C111 47 98 97 111 149c12 47 59 77 56 130-4 63-62 99-65 157-3 62 54 99 64 160 11 65-49 117-56 176-6 48 8 90 27 128H220V0Z"/>
