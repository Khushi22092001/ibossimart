                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hg-brand
        }
    )

    region dashboard (
        name: DASHBOARD
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="hg-cardhead">
                  <img class="hg-cardlogo" src="#APP_FILES#infomatics-logo-black.png" alt="iBoss">
                </div>
                <h1 class="hg-welcome">Welcome Back</h1>
                <p class="hg-welcome-sub">Sign in to continue to your account</p>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
            cssClasses: hg-authcard
            renderComponents: belowContent
        }
    )

    pageItem P9999_PAGENO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @dashboard
            slot: regionBody
        }
    )

    pageItem P9999_PASSWORD (
        type: password
        label {
            label: Password
            alignment: right
        }
        layout {
            sequence: 20
            region: @dashboard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-lock
            width: 40
            valuePlaceholder: Enter your password
        }
        validation {
            maxLength: 100
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9999_REMEMBER (
        type: checkboxGroup
        label {
            label: Remember Me
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @login-remember-username
            displayExtraValues: false
        }
        layout {
            sequence: 30
            region: @dashboard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_authentication.persistent_cookies_enabled
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9999_USERNAME (
        type: textField
        label {
            label: Username
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 10
            region: @dashboard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-user
            width: 40
            valuePlaceholder: Enter your username
        }
        validation {
            maxLength: 100
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    button login (
        buttonName: LOGIN
        label: Sign In
        layout {
            sequence: 40
            region: @dashboard
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process clear-page-s-cache (
        name: Clear Page(s) Cache
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 3474935394867149
        }
    )

    process get-username-cookie (
        name: Get Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P9999_USERNAME := apex_authentication.get_login_username_cookie;
                :P9999_REMEMBER := case when :P9999_USERNAME is not null then 'Y' end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3474561154867149
        }
    )

    process login (
        name: Login
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_authentication.login(
                    p_username => :P9999_USERNAME,
                    p_password => :P9999_PASSWORD );
                
                Select B.COMPANYCODE INTO :GLOBAL_COMPANYCODE
                  From BOSSUSER A, BOSSUSERROLE B
                 Where A.BOSSUSERCODE = B.BOSSUSERROLECODE
                   And B.ISDEFAULT = 'YES'
                   And A.BOSSUSERNAME = :P9999_USERNAME
                   ;
                
                SELECT LOGINNAME INTO :GLOBAL_LOGINNAME FROM BOSSUSER A WHERE UPPER(BOSSUSERNAME)=UPPER(:P9999_USERNAME);
                
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3473789422867148
        }
    )

    process set-username-cookie (
        name: Set Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_authentication.send_login_username_cookie (
                    p_username => lower(:P9999_USERNAME),
                    p_consent  => :P9999_REMEMBER = 'Y' );
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3474210471867148
        }
    )

)

