    pageItem P418_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                a.CompanyName d,
                a.CompanyCode r
                From Company a
                Where exists
                (
                   Select 
                        aa.Tno
                     From NecessitySlip aa
                     Where aa.CompanyCode = a.CompanyCode
                )
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 30
            region: @truck-wise-diesel-report-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

