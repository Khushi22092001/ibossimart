        label {
            label: Vehicle Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    distinct c.VehicleTypeName d , 
                    c.VehicleTypeCode r  
                from CompanyVehicle a, NecessitySlip b , VehicleType c
                where a.COMPANYVEHICLENO = b.EQUIPMENTID
                  and a.VehicleTypeCode = c.VehicleTypeCode
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 80
            region: @truck-wise-diesel-report-2
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 1
