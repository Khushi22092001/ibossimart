page 418 (
    name: Truck Wise Driver Wise
    alias: TRUCK-WISE-DRIVER-WISE
    title: Truck Wise Driver Wise
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region truck-wise-diesel-report (
        name: Truck Wise Diesel Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by x.NecessitySlipDate) SerialNo,
                   x.Tno,
                   x.CompanyCode,
                   x.LocationCode,
                   x.TransporterCode,
                   x.NecessitySlipNo,
                   x.NecessitySlipDate,
                   x.VehicleNo,
                   x.VehicleTypeName,
                   x.VehicleTYpeCode,
                   x.DriverName,
                   x.TransportAreaCode,
                   x.TransportAreaName,
                   x.Quantity1,
                   x.NoOfTrip,
                   x.TransporterName,
                   x.AverageTrip,
                   Round(x.Amount,2) as Amounts, 
                   Round((x.Amount /x.Quantity1),2) as Rate 
                From 
                   (Select
                          a.Tno,
                          a.CompanyCode,
                          a.LocationCode,
                          a.TransporterCode,
                          a.NecessitySlipNo,
                          a.NecessitySlipDate,
                          a.EquipmentId as VehicleNo,
                          vt.VehicleTypeName,
                          v.VehicleTYpeCode,
                          a.DriverCode,
                          a.DriverName,
                          v.TransportAreaCode,
                          ta.TransportAreaName,
                          b.Quantity1,
                          Case When b.Amount is not null then b.Amount
                          When d.Amount is not null then d.Amount
                          Else c.Amount end as Amount,
                          a.NoOfTrip,
                          ts.TransporterName,
                          Case 
                            When a.NoOfTrip = 0 Then
                              a.NoOfTrip
                            Else
                          Round((b.Quantity1/a.NoOfTrip),2)
                          End as AverageTrip
                   From NecessitySlip a , NecessitySlipDetail b,Transporter ts, CompanyVehicle v ,Vehicletype vt, TransportArea ta,
                   (
                    Select
                        a.ModuleTno,
                        c.Amount
                    From Issue a,Voucher b, VoucherDetail c
                    Where a.Tno = b.ModuleTno
                      and b.tno = c.tno
                      and a.CompanyCode = b.CompanyCode
                      and c.Amount > 0) c,
                   (
                    Select
                          a.ModuleTno,
                          b.Amount
                    From Voucher a, VoucherDetail b
                    Where a.Tno = b.Tno
                      and b.Amount > 0) d
                    where a.tno = b.tno(+)
                      and a.TransporterCode = ts.TransporterCode(+)
                      and a.Tno = c.ModuleTno(+)
                      and a.Tno = d.ModuleTno(+)
                      and a.necessitySlipNo is not null
                      and b.VehicleNecessityCode = 'DIESEL'
                      and a.EquipmentId = v.CompanyVehicleNo
                      and v.VehicleTypeCode = vt.VehicleTypeCode
                      and v.TransportAreaCode = ta.TransportAreaCode(+)
                --and A.dRIVERnAME = 'TARACHAND DEORAO KATKAR'
                --and a.NecessitySlipNo = 'CMPL/UMR/2023/000257'  
                     ) x
                Where x.NecessitySlipDate Between :P418_FROMDATE and :P418_TODATE
                   and ( :P418_VEHICLETYPE IS NULL OR instr(':'||:P418_VEHICLETYPE||':',':'||x.VehicleTypeCode||':') > 0 )
                   and ( :P418_COMPANY IS NULL OR instr(':'||:P418_COMPANY||':',':'||x.CompanyCode||':') > 0 )
                   and ( :P418_VEHICLE IS NULL OR instr(':'||:P418_VEHICLE||':',':'||x.VehicleNo||':') > 0 )
                   and ( :P418_DRIVER IS NULL OR instr(':'||:P418_DRIVER||':',':'||x.DriverCode||':') > 0 ) 
                   and ( :P418_LOCATION IS NULL OR instr(':'||:P418_lOCATION||':',':'||x.LocationCode||':') > 0 )
                   and ( :P418_TRANSPORTER IS NULL OR instr(':'||:P418_TRANSPORTER||':',':'||x.TransporterCode||':') > 0 )
                   and ( :P418_TRANPORTAREA IS NULL OR instr(':'||:P418_TRANPORTAREA||':',':'||x.TransportAreaCode||':') > 0 )
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                /*select 
                        a.Tno,
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.NecessitySlipDate
                         Else
                          Null
                         End NecessitySlipDate, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.vehicleno
                         Else
                          Null
                         End vehicleno, 
                       
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.Drivername
                         Else
                          Null
                         End Drivername, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          round(a.DieselQuantity,3)
                         Else
                          Null
                         End DieselQuantity, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.DieselRate
                         Else
                          Null
                         End DieselRate, 
                        
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          round(a.DieselAmount,2)
                         Else
                          Null
                         End DieselAmount, 
                        
                         Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.TotalTrips
                         Else
                          Null
                         End TotalTrips,
                        a.RouteName as "Route Name",
                        a.SourceLocationName,
                        a.DestinationLocationName,
                        a.CmoduleTno as Trips,
                        a.Creator
                     From 
                     (Select  
                        Count(b.ModuleTno) as CmoduleTno,
                        a.Tno,
                        j.RouteName,
                        l.SourceLocationName,
                        m.DestinationLocationName,
                        a.Creator,
                        a.NecessitySlipDate,
                        a.vehicleno,
                        a.Drivername,
                        round(aa.Quantity1,3) as DieselQuantity,
                        aa.MarketRate as DieselRate,
                        round((aa.Quantity1 * aa.MarketRate),2) as DieselAmount, 
                        Count(b.ModuleTno) as TotalTrips
                From  NecessitySlip a, NecessitySlipDetail aa, NecessitySlipTrip b,   Poddetail i,
                      Route j, Lr k, SourceLocation l, DestinationLocation m
                Where  a.Tno = aa.Tno 
                        and a.Tno = b.Tno(+) 
                    --   and b.moduleCode = 'LR'
                        and b.ModuleTno = i.LrTno(+)
                        and i.RouteCode = j.RouteCode(+)
                        and b.ModuleTno = k.Tno(+)
                        and k.SourcelocationTno = l.Tno(+)
                        and k.DestinationLocationTno = m.Tno(+)
                      and a.necessitySlipDate Between :P418_FROMDATE and :P418_TODATE
                      and ( :P418_COMPANY IS NULL OR instr(':'||:P418_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                      and ( :P418_VEHICLENO IS NULL OR instr(':'||:P418_VEHICLENO||':',':'||a.VehicleNo||':') > 0 )
                     and ( :P418_DRIVER IS NULL OR instr(':'||:P418_DRIVER||':',':'||a.DriverName||':') > 0 ) 
                      and ( :P418_LOCATION IS NULL OR instr(':'||:P418_lOCATION||':',':'||a.LocationCode||':') > 0 )
                Group by a.Tno,
                         j.RouteName,
                         l.SourceLocationName,
                         m.DestinationLocationName,
                         a.Creator,
                         a.NecessitySlipDate,
                        a.vehicleno,
                        a.Drivername,
                        round(aa.Quantity1,3),
                        aa.MarketRate,
                        round((aa.Quantity1 * aa.MarketRate),2)) a
                
                UNION ALL
                
                Select 
                        a.Tno,
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.NecessitySlipDate
                         Else
                          Null
                         End NecessitySlipDate, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.VehicleNo
                         Else
                          Null
                         End VehicleNo, 
                       
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.Drivername
                         Else
                          Null
                         End Drivername, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          round(a.DieselQuantity,3)
                         Else
                          Null
                         End DieselQuantity, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.DieselRate
                         Else
                          Null
                         End DieselRate, 
                        
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          round(a.DieselAmount,2)
                         Else
                          Null
                         End DieselAmount, 
                        
                         Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.TotalTrips
                         Else
                          Null
                         End TotalTrips,
                        a.RouteName as "Route Name",
                        a.SourceLocationName,
                        a.DestinationLocationName,
                        a.CmoduleTno as Trips,
                        a.Creator
                     From 
                     (Select  
                        Count(b.ModuleTno) as CmoduleTno,
                        b.Tno,
                        j.RouteName,
                        l.SourceLocationName,
                        m.DestinationLocationName,
                        a.Creator,
                        a.NecessitySlipDate,
                        a.VehicleNo,
                        a.Drivername,
                        round(aa.Quantity1,3) as DieselQuantity,
                        aa.MarketRate as DieselRate,
                        round((aa.Quantity1 * aa.Marketrate),2) as DieselAmount, 
                        Count(b.ModuleTno) as TotalTrips
                From  NecessitySlip a, NecessitySlipDetail aa, NecessitySlipTrip b,
                      Route j, InternalTransfer k, SourceLocation l, DestinationLocation m
                Where  a.Tno = aa.Tno 
                        and a.Tno = b.Tno(+) 
                      and b.moduleCode = 'INTERNALTRANSFER'
                        and k.RouteCode = j.RouteCode(+)
                        and b.ModuleTno = k.Tno(+)
                        and k.SourcelocationTno = l.Tno(+)
                        and k.DestinationLocationTno = m.Tno(+)
                    and a.necessitySlipDate Between :P418_FROMDATE and :P418_TODATE
                    and ( :P418_COMPANY IS NULL OR instr(':'||:P418_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and ( :P418_VEHICLENO IS NULL OR instr(':'||:P418_VEHICLENO||':',':'||a.VehicleNo||':') > 0 )
                   and ( :P418_DRIVER IS NULL OR instr(':'||:P418_DRIVER||':',':'||a.DriverName||':') > 0 ) 
                    and ( :P418_LOCATION IS NULL OR instr(':'||:P418_lOCATION||':',':'||a.LocationCode||':') > 0 )
                Group by b.Tno,
                         j.RouteName,
                         l.SourceLocationName,
                         m.DestinationLocationName,
                         a.Creator,
                         a.NecessitySlipDate,
                        a.VehicleNo,
                        a.Drivername,
                        aa.Quantity1,
                        aa.Marketrate,
                        (aa.Quantity1 * aa.Marketrate)) a  */
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                /*select 
                        b.Tno,
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.NecessitySlipDate
                         Else
                          Null
                         End NecessitySlipDate, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.VehicleNo
                         Else
                          Null
                         End VehicleNo, 
                       
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.Drivername
                         Else
                          Null
                         End Drivername, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          round(b.DieselQuantity,3)
                         Else
                          Null
                         End DieselQuantity, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.DieselRate
                         Else
                          Null
                         End DieselRate, 
                        
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          round(b.DieselAmount,2)
                         Else
                          Null
                         End DieselAmount, 
                        
                         Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.TotalTrips
                         Else
                          Null
                         End TotalTrips,
                        a.RouteName as "Route Name",
                        a.SourceLocationName,
                        a.DestinationLocationName,
                        a.CmoduleTno as Trips,
                        a.Creator
                     From 
                     (Select  
                        Count(b.ModuleTno) as CmoduleTno,
                        b.Tno,
                        j.RouteName,
                        l.SourceLocationName,
                        m.DestinationLocationName,
                        a.Creator
                From  NecessitySlip a, NecessitySlipDetail aa, NecessitySlipTrip b,   Poddetail i,
                      Route j, Lr k, SourceLocation l, DestinationLocation m
                Where  a.Tno = aa.Tno (+)
                        and a.Tno = b.Tno 
                        and (a.VehicleGroupCode = 'SELF'
                         or
                         a.EquipmentTno is not null)
                        and b.moduleCode = 'LR'
                        and b.ModuleTno = i.LrTno(+)
                        and i.RouteCode = j.RouteCode(+)
                        and b.ModuleTno = k.Tno(+)
                        and k.SourcelocationTno = l.Tno(+)
                        and k.DestinationLocationTno = m.Tno(+)
                      and a.necessitySlipDate Between :P418_FROMDATE and :P418_TODATE
                      and ( :P418_COMPANY IS NULL OR instr(':'||:P418_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                      and ( :P418_VEHICLENO IS NULL OR instr(':'||:P418_VEHICLENO||':',':'||a.VehicleNo||':') > 0 )
                      and ( :P418_DRIVER IS NULL OR instr(':'||:P418_DRIVER||':',':'||a.DriverName||':') > 0 ) 
                      and ( :P418_LOCATION IS NULL OR instr(':'||:P418_lOCATION||':',':'||a.LocationCode||':') > 0 )
                Group by b.Tno,
                         j.RouteName,
                         l.SourceLocationName,
                         m.DestinationLocationName,
                         a.Creator) a, 
                         (Select
                        a.Tno,
                        a.NecessitySlipDate,
                        a.VehicleNo,
                        a.Drivername,
                        round(aa.Quantity1,3) as DieselQuantity,
                        aa.Marketrate as DieselRate,
                        round((aa.Quantity1 * aa.Marketrate),2) as DieselAmount, 
                        Count(b.ModuleTno) as TotalTrips
                From  NecessitySlip a, NecessitySlipDetail aa, NecessitySlipTrip b,Location g, Poddetail i
                Where  a.Tno = aa.Tno (+)
                       and (a.VehicleGroupCode = 'SELF'
                         or
                         a.EquipmentTno is not null)
                        and a.LocationCode = g.LocationCode(+)
                        and a.Tno = b.Tno 
                        and b.moduleCode = 'LR'
                        and b.ModuleTno = i.LrTno(+)
                    Group by
                        a.NecessitySlipDate,
                        a.VehicleNo,
                        a.Drivername,
                        aa.Quantity1,
                        aa.Marketrate,
                        aa.Quantity1,
                        aa.Marketrate,
                        a.Tno) b
                  where a.Tno = b.Tno(+)
                UNION ALL
                Select 
                        b.Tno,
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.NecessitySlipDate
                         Else
                          Null
                         End NecessitySlipDate, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.VehicleNo
                         Else
                          Null
                         End VehicleNo, 
                       
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.Drivername
                         Else
                          Null
                         End Drivername, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          round(b.DieselQuantity,3)
                         Else
                          Null
                         End DieselQuantity, 
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.DieselRate
                         Else
                          Null
                         End DieselRate, 
                        
                        
                        Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          round(b.DieselAmount,2)
                         Else
                          Null
                         End DieselAmount, 
                        
                         Case
                         When ROW_NUMBER()
                          Over(Partition By b.TNo Order By b.TNo) = 1 Then
                          b.TotalTrips
                         Else
                          Null
                         End TotalTrips,
                        a.RouteName as "Route Name",
                        a.SourceLocationName,
                        a.DestinationLocationName,
                        a.CmoduleTno as Trips,
                        a.Creator
                     From 
                     (Select  
                        Count(b.ModuleTno) as CmoduleTno,
                        b.Tno,
                        j.RouteName,
                        l.SourceLocationName,
                        m.DestinationLocationName,
                        a.Creator
                From  NecessitySlip a, NecessitySlipDetail aa, NecessitySlipTrip b,
                      Route j, InternalTransfer k, SourceLocation l, DestinationLocation m
                Where  a.Tno = aa.Tno (+)
                        and a.Tno = b.Tno 
                        and (a.VehicleGroupCode = 'SELF'
                         or
                         a.EquipmentTno is not null)
                        and b.moduleCode = 'INTERNALTRANSFER'
                        and k.RouteCode = j.RouteCode(+)
                        and b.ModuleTno = k.Tno(+)
                        and k.SourcelocationTno = l.Tno(+)
                        and k.DestinationLocationTno = m.Tno(+)
                       and a.necessitySlipDate Between :P418_FROMDATE and :P418_TODATE
                       and ( :P418_COMPANY IS NULL OR instr(':'||:P418_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                       and ( :P418_VEHICLENO IS NULL OR instr(':'||:P418_VEHICLENO||':',':'||a.VehicleNo||':') > 0 )
                       and ( :P418_DRIVER IS NULL OR instr(':'||:P418_DRIVER||':',':'||a.DriverName||':') > 0 ) 
                       and ( :P418_LOCATION IS NULL OR instr(':'||:P418_lOCATION||':',':'||a.LocationCode||':') > 0 )
                Group by b.Tno,
                         j.RouteName,
                         l.SourceLocationName,
                         m.DestinationLocationName,
                         a.Creator) a, 
                         (Select
                        a.Tno,
                        a.NecessitySlipDate,
                        a.VehicleNo,
                        a.Drivername,
                        round(aa.Quantity1,3) as DieselQuantity,
                        aa.Marketrate as DieselRate,
                        round((aa.Quantity1 * aa.Marketrate),2) as DieselAmount, 
                        Count(b.ModuleTno) as TotalTrips
                From  NecessitySlip a, NecessitySlipDetail aa, NecessitySlipTrip b,Location g
                Where  a.Tno = aa.Tno (+)
                       and (a.VehicleGroupCode = 'SELF'
                         or
                         a.EquipmentTno is not null)
                        and a.LocationCode = g.LocationCode(+)
                        and a.Tno = b.Tno 
                        and b.moduleCode = 'INTERNALTRANSFER'
                    Group by
                        a.NecessitySlipDate,
                        a.VehicleNo,
                        a.Drivername,
                        aa.Quantity1,
                        aa.Marketrate,
                        aa.Quantity1,
                        aa.Marketrate,
                        a.Tno) b
                        
                        where a.Tno = b.Tno(+); */
                ```
        }
        layout {
