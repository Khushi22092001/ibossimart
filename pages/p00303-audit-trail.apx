page 303 (
    name: Audit Trail
    alias: AUDIT-TRAIL
    title: Audit Trail
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region search (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @search-results
        }
        layout {
            sequence: 10
            slot: leftColumn
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
            displayChartForTopNValues: 10
        }

        facet P303_ACTIONTYPE (
            type: checkboxGroup
            label {
                label: Actiontype
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 50
            }
            listEntries {
                zeroCountEntries: disable
                sortByTopCounts: false
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: ACTIONTYPE
            }
        )

        facet P303_ACTIONUSER (
            type: selectList
            label {
                label: Actionuser
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ACTIONUSER
            }
        )

        facet P303_COMPANYNAME (
            type: checkboxGroup
            label {
                label: "Company "
            }
            lov {
                type: distinctValues
                includeNullOption: true
                nullDisplayValue: All
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: COMPANYNAME
            }
        )

        facet P303_HOSTNAME (
            type: checkboxGroup
            label {
                label: Hostname
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 80
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: HOSTNAME
            }
        )

        facet P303_IP_ADDRESS (
            type: checkboxGroup
            label {
                label: Ip Address
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 100
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: IP_ADDRESS
            }
        )

        facet P303_MODULECODE (
            type: checkboxGroup
            label {
                label: Modulecode
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 60
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: MODULECODE
            }
        )

        facet P303_MODULENAME (
            type: checkboxGroup
            label {
                label: Modulename
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 70
            }
            listEntries {
                showSelectedFirst: true
                maxDisplayedEntries: 7
                displayFilterInitially: true
            }
            source {
                databaseColumn: MODULENAME
            }
        )

        facet P303_OS_USER (
            type: selectList
            label {
                label: Os User
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: OS_USER
            }
        )

        facet P303_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: ACTIONUSER,ACTIONTYPE,MODULECODE,MODULENAME,HOSTNAME,OS_USER,IP_ADDRESS,TRANSACTIONNO
            }
        )

        facet P303_TRANSACTIONNO (
            type: checkboxGroup
            label {
                label: Transactionno
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 120
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: TRANSACTIONNO
            }
        )

    )

    region search-results (
        name: Search Results
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.ActionTime,
                       a.ActionUser,
                       a.ActionType,
                       a.ModuleCode,
                       m.ModuleName,
                       a.ModuleTNo,
                       a.HostName,
                       a.OS_User,
                       a.IP_Address,
                       a.TransactionNo,
                       a.UserLocation,
                       getCOmpanyName(GetModuleCompanyCode(A.MODULECODE, A.MODULETNO)) As COMPANYNAME,
                       GetLocationName(GetModuleLocationCode(A.MODULECODE, A.MODULETNO)) As LocationName,
                       GetModuleFYearCode(A.MODULECODE, A.MODULETNO) As FYearCode
                  From ActionLog a, Module m
                 Where a.ModuleCode = m.ModuleCode
                
                /*  and Trunc(a.ActionTime) Between :P30_FROMDATE and :P30_TODATE
                  and ( :P30_ACTIONUSER IS NULL OR instr(','||:P30_ACTIONUSER||',',','||a.ActionUser||',') > 0 ) 
                  --and a.ModuleCode :P30_ModuleCode
                  and ( :P30_MODULE IS NULL OR instr(','||:P30_MODULE||',',','||a.ModuleCode||',') > 0 ) 
                  and a.ActionType like nvl(:P30_ACTIONTYPE,'%')
                  and a.TransactionNo like nvl(:P30_TNO,'%')
                  */
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: no data found
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }
        printing {
            enabled: true
        }
        output {
            linkText: Print
            format: pdf
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Search Results
        }

        column ACTIONTIME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Actiontime
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
        )

        column ACTIONTYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Actiontype
            }
            layout {
                sequence: 3
            }
        )

        column ACTIONUSER (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Actionuser
            }
            layout {
                sequence: 2
            }
        )

        column COMPANYNAME (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Companyname
                alignment: center
            }
            layout {
                sequence: 51
            }
        )

        column FYEARCODE (
            reportColumnQueryId: 14
            derivedColumn: N
            heading {
                heading: Fyearcode
                alignment: center
            }
            layout {
                sequence: 41
            }
        )

        column HOSTNAME (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Hostname
            }
            layout {
                sequence: 7
            }
        )

        column IP_ADDRESS (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Ip Address
            }
            layout {
                sequence: 9
            }
        )

        column LOCATIONNAME (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Locationname
                alignment: center
            }
            layout {
                sequence: 61
            }
        )

        column MODULECODE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Modulecode
            }
            layout {
                sequence: 4
            }
        )

        column MODULENAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Modulename
            }
            layout {
                sequence: 5
            }
        )

        column MODULETNO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Moduletno
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
        )

        column OS_USER (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Os User
            }
            layout {
                sequence: 8
            }
        )

        column TRANSACTIONNO (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Transactionno
            }
            layout {
                sequence: 10
            }
        )

        column USERLOCATION (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 11
            }
        )

    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 303
                clearCache: 303
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

