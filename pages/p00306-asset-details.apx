page 306 (
    name: Asset Details Report
    alias: ASSET-DETAILS
    title: Asset Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region assetdetails (
        name: AssetDetails
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                row_number() over(order by A.ASSETdate) SerialNo,
                p.PartyName as AssetAccount,
                i.ItemName as NameofAssets,
                isp.ItemSpecificationName as Specification,
                a.AssetDate,
                a.AssetNo,
                abs(round(a.RemainingUsefuLLifeInMonths/12,0)) as Life,
                a.PurchaseDate,
                a.OriginalPurchaseDate as PutToUse,
                a.AssetValue,
                nvl(a.DepreciatedAmount,0) as DepUtilized,
                (a.AssetValue - nvl(a.DepreciatedAmount,0)) as AssetWDV
                From 
                 Asset a,
                 AssetCategory ac,
                 Item i,
                 Assetdepreciation ad,
                 Party p,
                 ItemSpecification isp
                Where
                  a.AssetCategoryCode = ac.AssetCategoryCode(+)
                  and a.ItemCode = i.ItemCode(+)
                  and a.tno = ad.AssetTno(+)
                  and a.AccountCode = p.PartyCode(+)
                  and a.ItemSpecificationCode = isp.ItemSpecificationCode(+)
                
                  -- 22-APR-2025
                and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                and a.Assetdate between :P306_FROMDATE and :P306_TODATE
                and (:P306_AssetAccount IS NULL OR instr(':'||:P306_AssetAccount||':',':'||p.partycode||':') > 0)
                and (:P306_NAMEOFASSETS IS NULL OR instr(':'||:P306_NAMEOFASSETS||':',':'||i.itemcode||':') > 0)
                --and (:P306_LOCATION IS NULL OR instr(':'||:P306_LOCATION||':',':'||l.locationcode||':') > 0)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 26243361416557128
        }

        column ASSETACCOUNT (
            type: plainText
            heading {
                heading: Asset Account
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column ASSETDATE (
            type: plainText
            heading {
                heading: Asset Date
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
        )

        column ASSETNO (
            type: plainText
            heading {
                heading: Asset No
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ASSETVALUE (
            type: plainText
            heading {
                heading: Asset Value
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column ASSETWDV (
            type: plainText
            heading {
                heading: Asset WDV
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column DEPUTILIZED (
            type: plainText
            heading {
                heading: Dep Utilized
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column LIFE (
            type: plainText
            heading {
                heading: Life
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column NAMEOFASSETS (
            type: plainText
            heading {
                heading: Name of Assets
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PURCHASEDATE (
            type: plainText
            heading {
                heading: Purchase Date
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column PUTTOUSE (
            type: plainText
            heading {
                heading: Put To Use
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column SPECIFICATION (
            type: plainText
            heading {
                heading: Specification
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 288931 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ASSETACCOUNT (
                sequence: 2
            )

            displayColumn ASSETNO (
                sequence: 5
            )

            displayColumn ASSETVALUE (
                sequence: 9
            )

            displayColumn ASSETWDV (
                sequence: 11
            )

            displayColumn DEPUTILIZED (
                sequence: 10
            )

            displayColumn LIFE (
                sequence: 6
            )

            displayColumn NAMEOFASSETS (
                sequence: 3
            )

            displayColumn PURCHASEDATE (
                sequence: 7
            )

            displayColumn PUTTOUSE (
                sequence: 8
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SPECIFICATION (
                sequence: 4
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: ASSETVALUE
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P306_ASSETACCOUNT (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Asset A/C
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT distinct
                p.PartyName d,
                p.PartyCode r  
                from Party p,Asset a   
                where p.partycode = a.accountcode(+)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @assetdetails
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P306_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @assetdetails
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 25
        }
    )

    pageItem P306_NAMEOFASSETS (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Name of Assets
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT distinct
                a.ITEMNAME D,
                a.ITEMCODE  R  
                FROM ITEM a,Asset b
                where a.ItemCode = b.ItemCode
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @assetdetails
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 35
        }
    )

    pageItem P306_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @assetdetails
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 50
            region: @assetdetails
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

