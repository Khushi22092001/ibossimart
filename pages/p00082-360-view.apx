page 82 (
    name: 360 View
    alias: 360-VIEW
    title: 360 View
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region 360-view-list (
        name: 360 View List
        type: list
        source {
            list: @dashboard-360-view
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: ds-portlet-tiles
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--basic
                t-Cards--displayIcons
                t-Cards--3cols
                t-Cards--iconsRounded
                t-Cards--animRaiseCard
            ]
        }
    )

)

