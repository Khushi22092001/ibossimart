    region tds-payable-summary (
        name: "TDS Payable Summary "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P443_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                a.CompanyName d,
                a.CompanyCode r                                                
                From Voucher b,Company a
                 Where b.CompanyCode = a.CompanyCode;
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @tds-payable-summary
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P443_FROMDATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @tds-payable-summary
            slot: regionBody
        }
    )

    pageItem P443_MONTH (
        type: datePicker
        label {
            label: Month
            alignment: left
        }
        layout {
            sequence: 20
            region: @tds-payable-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: MON-RRRR
            width: 15
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)-7
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P443_PARTY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Party
            alignment: left
