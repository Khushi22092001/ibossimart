page 443 (
    name: TDS Payable Summary Copy
    alias: TDS-PAYABLE-SUMMARY-COPY
    title: TDS Payable Summary Copy
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT  
                    TO_CHAR(max(b.VoucherDate),('MON-YY')) AS Month,
                    GETPARTYNAME(A.PARTYCODE) AS PARTY,
                    F.TDSNATURENAME,
                    F.TDSNATURECODE,
                    co.CompanyName,
                    A.PANNO,
                    b.companycode,
                    A.PARTYCODE,
                    ROUND(sum(A.TDSDEDUCTEDON),2) AS BASICAMOUNT,
                    sum(A.TDSAMOUNT) as TDSAmount,
                    'DETAIL'
                FROM VOUCHERTDSDEDUCTED  A,VOUCHER B,JBPASS C, EXTERNALSERVICESENTRY D,PAYMENTADVICE E,TDSTAXCATEGORY G,PARTY H,COMPANY CO, TDSNature F,
                         (SELECT A.CHALLANNO,
                               A.CHALLANDATE,
                               E.BSRCODE,
                               D.MODULETNO,
                               A.CHALLANAMOUNT
                          FROM CHALLAN                  A,
                               TDSCHALLAN               C,
                               TDSCHALLANDEDUCTEEDETAIL D,
                               BANK                     E
                         WHERE  A.DOCTYPECODE = 'TDSCHALLAN'
                           AND A.MODULETNO = C.TNO
                           AND C.TNO = D.TNO
                           AND A.TAXSECTIONCODE = D.TAXSECTIONCODE
                           AND A.DEPOSITEDINBANKCODE = E.BANKCODE
                       ) CHLN,
                       (
                          Select
                                a.Tno
                         From Voucher a
                         Where exists(
                                     Select
                                        aa.Tno
                                     From VoucherDetail aa, TDSNature bb
                                     Where aa.AccountCode = bb.TDSAccountCode
                                       and aa.Tno = a.Tno
                                     )) x
                WHERE A.TNO = B.TNO
                   AND B.MODULETNO = C.TNO(+)
                   AND B.MODULETNO = D.TNO(+)
                   AND B.MODULETNO = E.TNO(+)
                   AND A.TDSTAXCATEGORYCODE = G.TDSTAXCATEGORYCODE(+)
                  and A.PARTYCODE = H.PARTYCODE
                  and B.COMPANYCODE = CO.COMPANYCODE
                  and a.TDSNatureCode = f.TDSNatureCode
                  AND B.MODULETNO = CHLN.MODULETNO(+)
                  AND A.TNO = X.TNO
                
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and TO_CHAR(TO_DATE(b.VoucherDate),('MON-RRRR')) = :P443_MONTH
                -- and ( :P443_LOCATION IS NULL OR instr(':'||:P443_LOCATION||':',':'||B.LocationCode||':') > 0)
                  and ( :P443_COMPANY IS NULL OR instr(':'||:P443_COMPANY||':',':'||b.CompanyCode||':') > 0 )
                  and ( :P443_PARTY IS NULL OR instr(':'||:P443_PARTY||':',':'||h.partycode||':') > 0 )
                -- and B.ModuleCode like nvl(:P443_MODULECODE,'%')
                  and ( :P443_SECTION IS NULL OR instr(':'||:P443_SECTION||':',':'||F.TAXSECTIONCODE||':') > 0 )
                  and ( :P443_TDSNATURE IS NULL OR instr(':'||:P443_TDSNATURE||':',':'||F.TDSNATURECODE||':') > 0 )
                
                Group by a.PANNO,
                        A.PARTYCODE,
                        F.TDSNATURENAME,
                        F.TDSNATURECODE,
                        b.companycode,
                        co.CompanyName
                
                ORDER BY 1,2,3,4
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 66354952357767746
        }

        column 'DETAIL' (
            type: link
            heading {
                heading: DETAIL
                alignment: center
            }
            layout {
                sequence: 70
            }
            link {
                target: {
                    page: 444
                    items: {
                        P444_PARTY: #PARTYCODE#
                        P444_MONTH: &P443_MONTH.
                        P444_COMPANY: #COMPANYCODE#
                        P444_TDSNATURE: #TDSNATURECODE#
                    }
                    clearCache: 444
                }
                linkText: DETAIL
                linkAttributes: class="t-Button t-Button--simple t-Button--hot t-Button--stretch"
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column BASICAMOUNT (
            type: plainText
            heading {
                heading: Basic Amount
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column COMPANYCODE (
