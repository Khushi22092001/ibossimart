        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 167286 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn 'DETAIL' (
                sequence: 7
            )

            displayColumn BASICAMOUNT (
                sequence: 5
            )

            displayColumn MONTH (
                sequence: 1
            )

            displayColumn PANNO (
                sequence: 4
            )

            displayColumn PARTY (
                sequence: 2
            )

            displayColumn TDSAMOUNT (
                sequence: 6
            )

            displayColumn TDSNATURENAME (
                sequence: 3
            )

            aggregate (
                column: BASICAMOUNT
            )

            aggregate (
                column: TDSAMOUNT
            )

