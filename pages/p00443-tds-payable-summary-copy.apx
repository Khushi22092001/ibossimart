            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                B.TAXSECTIONCODE D,
                B.TAXSECTIONCODE R
                From VOUCHERTDSDEDUCTED   A,TDSNATURE   B
                Where a.TDSNATURECODE = B.TDSNATURECODE
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @tds-payable-summary
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P443_TDSNATURE (
