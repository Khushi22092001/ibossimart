    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 90
            region: @tds-payable-summary
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-date-value (
        name: Set Date Value
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P443_MONTH
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select TO_DATE(:P443_MONTH, 'MON-RRRR'), TRUNC(LAST_DAY(TO_DATE(:P443_MONTH, 'MON-RRRR'))) From DUAL
                    
                    ```
                itemsToSubmit: P443_MONTH
            }
            affectedElements {
                selectionType: items
                items: [
                    P443_FROMDATE
                    P443_TODATE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

