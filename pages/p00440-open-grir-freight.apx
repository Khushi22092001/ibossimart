    region open-grir-freight-2 (
        name: Open GRIR Freight
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by a.VoucherDate) SerialNo,
                   a.VoucherNo,
                   a.VoucherDate,
                   a.Amount,
                   a.GRNNo,
                   a.VehicleNo,
                   a.PartyName,
                   a.TransporterName,
                   a.FreightVoucherNo,
                   a.FreightVoucherDate,
                   a.PartyBillNo,
                   a.Status,
                   b.CompanyName,
                   c.LocationName,
                   d.DoctypeName
                From OpenGRIRFreight a, Company b, Location c, Doctype d
                Where a.CompanyCode = b.CompanyCode
                 and a.LocationCode = c.LocationCode
                 and a.DoctypeCode = d.DoctypeCode
                 and a.VoucherDate Between :P440_FROMDATE and :P440_TODATE
                 and ( :P440_COMPANY IS NULL OR instr(':'||:P440_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                 and ( :P440_LOCATION IS NULL OR instr(':'||:P440_LOCATION||':',':'||a.LocationCode||':') > 0 )
                 and ( :P440_VOUCHER IS NULL OR instr(':'||:P440_VOUCHER||':',':'||a.Tno||':') > 0 );
                ```
            pageItemsToSubmit: P440_COMPANY
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
