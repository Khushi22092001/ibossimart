page 79 (
    name: moduleflowusertree
    alias: MODULEFLOWUSERTREE
    title: moduleflowusertree
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region moduleflowusertree (
        name: moduleflowusertree
        type: tree
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Level As lev,
                               modulecode,
                               moduleflowno,
                               documentstatuscode,
                               tno
                          From moduleflow a
                         Start With a.onpassingofmoduleflowtno Is Null
                        Connect By Prior tno = onpassingofmoduleflowtno
                         Order Siblings By moduleflowno
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            nodeLabelColumn: MODULECODE
            nodeValueColumn: TNO
            hierarchy: notComputed
            nodeStatusColumn: MODULEFLOWNO
            hierarchyLevelColumn: LEV
            defaultIconCssClass: icon-tree-folder
            iconTypeCssClass: a-Icon
        }
    )

    button contract-all (
        buttonName: CONTRACT_ALL
        label: Collapse All
        layout {
            sequence: 10
            region: @moduleflowusertree
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button expand-all (
        buttonName: EXPAND_ALL
        label: Expand All
        layout {
            sequence: 10
            region: @moduleflowusertree
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction contract-all (
        name: CONTRACT_ALL
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @contract-all
        }

        action native-tree-collapse (
            action: collapseTree
            affectedElements {
                selectionType: region
                region: @moduleflowusertree
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction expand-all (
        name: EXPAND_ALL
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @expand-all
        }

        action native-tree-expand (
            action: expandTree
            affectedElements {
                selectionType: region
                region: @moduleflowusertree
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

