            /* Recent Activity follows the user's supplied card-grid reference. */
            .te-root .te-table tbody tr,.te-root .te-table tbody tr:nth-child(even),.te-root .te-table tbody tr:nth-child(odd),.te-root .te-table tbody td{background:#fff!important;background-image:none!important}.te-root .te-table tbody tr:hover td{background:#f8faff!important}:is(#teEvidenceACTIVITY,#teEvidenceLEDGER,#teEvidenceALERT,#teEvidenceSTOCK) .a-IRR-table tbody tr td{background:#fff!important;background-image:none!important;border-bottom:1px solid #e5eaf2!important}:is(#teEvidenceACTIVITY,#teEvidenceLEDGER,#teEvidenceALERT,#teEvidenceSTOCK) .a-IRR-table tbody tr:hover td{background:#f8faff!important}
            .te-recent{padding:24px;border:1px solid #e1e7f2;border-radius:16px;background:linear-gradient(120deg,#fff,#fcfdff);box-shadow:0 6px 20px #344c7310}.te-recent-head{display:flex;align-items:center;gap:15px;margin-bottom:5px}.te-recent-head>div{flex:1}.te-recent-head h2{display:flex;gap:14px;align-items:center;font-size:23px;font-weight:750;color:#263044;margin:0 0 5px}.te-recent-head p{font-size:12px;color:#7d88a0;margin:0}.te-recent-icon{display:grid;place-items:center;width:49px;height:49px;border-radius:50%;background:#f0edfe;color:#5d4fd2;font-size:23px;flex-shrink:0}.te-live{display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border:1px solid #e2f1e2;border-radius:20px;background:#f1faf2;font-size:11px;font-weight:500;color:#57705d}.te-live i{width:6px;height:6px;border-radius:50%;background:#469849}.te-recent-guide{margin:10px 0 17px;font-size:11px;color:#8793a7}.te-recent .te-timeline{gap:14px 18px}.te-recent .te-event{background:#fff;border:1px solid #e2e8f2;border-radius:13px;box-shadow:0 2px 3px #263b5907;padding:17px;min-width:0}.te-recent .te-event time{display:flex;align-items:center;gap:7px;font-size:11px;color:#7c89a2;margin:0 0 13px}.te-recent .te-event time .fa{font-size:13px}.te-recent .te-event-doc{font-size:13px;line-height:1.5;margin:0 0 13px;color:#5346c1;font-weight:700;overflow-wrap:anywhere}.te-recent .te-event-doc:after{display:none}.te-event-meta{display:flex;flex-wrap:wrap;align-items:center;gap:7px;min-width:0}.te-event-type{display:inline-flex;gap:7px;align-items:center;padding:5px 7px;border:1px solid color-mix(in srgb,var(--te-accent) 14%,white);border-radius:6px;background:color-mix(in srgb,var(--te-accent) 7%,white);color:var(--te-accent);font-size:10px!important;white-space:nowrap;font-weight:600!important}.te-event-type .fa{font-size:13px}.te-event-dated{font-size:10px!important;color:#7d88a0!important;white-space:nowrap}.te-event-amount{font-size:13px!important;margin-left:auto;color:#56627a!important;font-variant-numeric:tabular-nums;white-space:nowrap}.te-recent .te-event:hover{border-color:#d5dcf1;box-shadow:0 4px 12px #33456f0e}@media(max-width:1100px){.te-recent .te-timeline{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.te-recent{padding:16px}.te-recent-head{flex-wrap:wrap}.te-recent-head h2{font-size:20px}.te-recent-head>.te-button{margin-left:64px}.te-recent .te-timeline{grid-template-columns:1fr}}
            
            /* One page heading, with a manufacturing-focused overview and section links. */
            body:has(#todayEnterprise) #t_Body_title{display:none!important}
            #teDashboard{border:0!important;box-shadow:none!important;background:transparent!important}
            #teDashboard>.t-Region-bodyWrap>.t-Region-body{padding:0!important}
            .te-root .te-hero{position:relative;isolation:isolate;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:34px;padding:34px 36px;border:1px solid #dcdff4;border-radius:20px;background:radial-gradient(ellipse at 95% 5%,#dfecefa6,transparent 48%),linear-gradient(115deg,#ebe9fc 0%,#f4f3ff 48%,#f2fafb 100%);box-shadow:0 5px 22px #414a7010;color:#29345a;align-items:center}
            .te-hero:before{content:"";position:absolute;left:0;top:25px;bottom:25px;width:5px;border-radius:0 5px 5px 0;background:linear-gradient(#7770e3,#38a7aa)}
            .te-hero .te-eyebrow{display:flex;align-items:center;gap:9px;font-size:11px;font-weight:750;letter-spacing:.11em;color:#6860ad}.te-eyebrow .fa{font-size:18px;padding:9px;border:1px solid #d9d5f5;border-radius:11px;background:#ffffffa6;color:#6860c8}
            .te-hero h1{color:#2a2851;font-size:32px;line-height:1.18;font-weight:750;letter-spacing:-.035em;margin:16px 0 12px}.te-hero h1 span{display:block;font-size:24px;letter-spacing:-.02em;font-weight:650;color:#49456e;margin-top:5px}.te-hero p{font-size:13px;line-height:1.65;color:#75758d;margin:0}
            .te-hero-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.te-hero-links a{display:inline-flex;gap:12px;align-items:center;padding:8px 12px;background:#ffffffb8;border:1px solid #dcdef0;border-radius:8px;text-decoration:none;color:#635ba0;font-size:11px;font-weight:650}.te-hero-links a:hover{background:#fff;border-color:#9e97d5}
            .te-hero .te-date{display:flex;flex-direction:column;gap:12px;min-width:295px;padding:23px 25px;text-align:left;white-space:normal;background:#ffffffc7;border:1px solid #ffffff;border-radius:15px;box-shadow:0 6px 20px #4b597509;color:#66758b}.te-date-label{display:flex;align-items:center;gap:9px;font-size:11px;text-transform:uppercase;letter-spacing:.07em;font-weight:650;color:#6b7a91}.te-date-label .fa{color:#5b999c;font-size:16px}.te-hero .te-date strong{font-size:20px;line-height:1.45;color:#3c466c;font-weight:700;max-width:320px}.te-freshness{display:flex;align-items:center;gap:7px;color:#62817a;font-size:11px}.te-freshness i{width:6px;height:6px;flex:none;background:#32a28a;border-radius:50%}.te-timezone{font-size:10px;color:#909aae;border-top:1px solid #e7ecf3;padding-top:12px}
            .te-root .te-kpi .te-card-action{color:var(--te-accent);font-size:10px;font-weight:650;margin-top:9px}.te-root .te-toolbar{padding:13px 0 8px;margin:0}.te-root [id]{scroll-margin-top:95px}
            @media(max-width:1000px){.te-root .te-hero{gap:20px;padding:27px}.te-hero .te-date{min-width:255px;padding:20px}.te-hero h1{font-size:29px}.te-hero h1 span{font-size:21px}}
            @media(max-width:760px){.te-root .te-hero{grid-template-columns:1fr;padding:23px;gap:22px}.te-hero .te-date{width:100%;min-width:0;padding:17px}.te-hero h1{font-size:29px}.te-hero h1 span{font-size:21px}.te-hero p br{display:none}.te-hero-links{gap:7px;margin-top:17px}.te-hero-links a{font-size:10px;padding:8px 10px}.te-hero .te-date strong{font-size:18px;max-width:none}}
            
            .te-root .te-kpi{padding:12px 13px 12px 16px;min-height:126px;gap:10px;flex-direction:row;border-radius:12px}
            .te-root .te-kpi-icon{width:32px;height:32px;flex-basis:32px;border-radius:9px}.te-root .te-kpi-icon .fa{font-size:17px}
            .te-root .te-kpi .te-kpi-label{font-size:10px;letter-spacing:.025em;line-height:1.35}.te-root .te-kpi strong{font-size:25px;margin:6px 0 4px}.te-root .te-kpi small{font-size:10px;line-height:1.35}.te-root .te-kpi .te-card-action{margin-top:5px;font-size:10px}.te-root .te-kpi .te-delta{margin-top:5px;font-size:9px}.te-compare-bars{display:none}
            .te-root .te-mini{gap:8px;grid-template-columns:repeat(3,minmax(0,1fr))}.te-root .te-mini .te-kpi{padding:11px 10px 11px 13px;min-height:108px;gap:8px}.te-root .te-mini .te-kpi strong{font-size:22px}.te-root .te-mini .te-kpi-icon{width:27px;height:27px;flex-basis:27px}.te-root .te-mini .te-kpi-icon .fa{font-size:14px}.te-root .te-mini .te-kpi .te-kpi-label{font-size:9px}
            .te-root .te-kpi.attention{padding:12px 16px;min-height:126px}.te-root .te-kpi.attention strong{margin:6px 0}.te-root .te-flow button{padding:10px 12px;min-height:86px}.te-root .te-flow strong{font-size:17px;margin:5px 0 2px}.te-root .te-finance button{padding:12px 14px}.te-root .te-finance strong{font-size:21px;margin:4px 0}
            .te-rank-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:19px 0 8px}.te-rank-heading h3{font-size:15px;font-weight:700;color:#30375e;margin:0}.te-rank-heading p{font-size:11px;color:#7a879f;margin:4px 0}.te-rank-heading>.te-link{font-size:11px;white-space:nowrap}
            .te-ranked-list{border-top:1px solid #e8ecf4}.te-ranked-row{display:grid;grid-template-columns:29px minmax(120px,1fr) minmax(45px,.6fr) 90px;gap:11px;align-items:center;padding:12px 0;width:100%;border:0;border-bottom:1px solid #e9edf5;background:#fff!important;text-align:left;color:#354563}.te-ranked-row:hover{background:#fafbfe!important}.te-rank-number{display:grid;place-items:center;width:27px;height:29px;border-radius:8px;background:color-mix(in srgb,var(--rank-color) 14%,white);color:var(--rank-color);font-size:12px;font-weight:750}.te-rank-name{font-size:11px;line-height:1.45;overflow-wrap:anywhere}.te-rank-meter{height:4px;border-radius:4px;background:#e6eaf2;overflow:hidden}.te-rank-meter i{display:block;height:100%;background:var(--rank-color);border-radius:4px}.te-rank-value{text-align:right;font-variant-numeric:tabular-nums}.te-rank-value strong{display:block;font-size:14px;color:#2a3658}.te-rank-value small{display:block;font-size:10px;color:#8a95aa;margin-top:2px}.te-rank-footer{display:flex;justify-content:space-between;gap:10px;padding-top:12px;font-size:10px;color:#8793a9}
            .te-exception-cards{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:13px}.te-exception-card{display:flex;flex-direction:column;text-align:left;background:#fff;border:1px solid color-mix(in srgb,var(--exception-color) 18%,#e5eaf3);border-radius:13px;padding:15px 15px 0;min-height:209px;overflow:hidden;box-shadow:0 3px 9px #263a6010;color:#303d60}.te-exception-card:hover{border-color:var(--exception-color);box-shadow:0 5px 14px #263a601a}.te-exception-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.te-exception-rank{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:var(--exception-color);color:#fff;font-size:11px;font-weight:750}.te-exception-icon{display:grid;place-items:center;width:35px;height:35px;font-size:20px;border-radius:10px;background:color-mix(in srgb,var(--exception-color) 11%,white);color:var(--exception-color)}.te-exception-label{font-size:13px;font-weight:650;line-height:1.4;min-height:37px}.te-exception-card>strong{font-size:33px;line-height:1.2;color:var(--exception-color);margin:8px 0 2px;font-variant-numeric:tabular-nums}.te-exception-docs{font-size:10px;color:#8692a8;margin:0 0 14px}.te-exception-footer{display:flex;gap:6px;justify-content:space-between;align-items:center;background:color-mix(in srgb,var(--exception-color) 6%,white);color:var(--exception-color);padding:10px 13px;margin:auto -15px 0;font-size:10px}.te-exception-footer b{text-transform:capitalize;background:color-mix(in srgb,var(--exception-color) 9%,white);border-radius:5px;padding:3px 6px}.te-exception-summary{display:flex;gap:32px;align-items:center;padding:17px 20px;background:#f8f9fc;border-radius:11px;margin-top:15px}.te-exception-summary small{display:block;color:#8190a7;font-size:11px;white-space:nowrap}.te-exception-summary strong{font-size:23px;color:#354263}.te-exception-summary p{font-size:11px;color:#8190a7;max-width:470px;margin-left:auto}
            .te-root .te-table tbody tr,.te-root .te-table tbody td{background:#fff!important}.te-root .te-table tbody tr:hover td{background:#fafbfe!important}
            @media(max-width:1100px){.te-root .te-mini{grid-template-columns:1fr}.te-root .te-mini .te-kpi{min-height:95px}.te-exception-cards{grid-template-columns:repeat(3,minmax(0,1fr))}.te-ranked-row{grid-template-columns:26px minmax(100px,1fr) 75px}.te-rank-meter{display:none}}
            @media(max-width:760px){.te-exception-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.te-exception-summary{gap:18px;flex-wrap:wrap}.te-exception-summary p{margin:0;max-width:none}.te-root .te-mini{grid-template-columns:repeat(3,minmax(0,1fr))}.te-root .te-mini .te-kpi{display:block;min-height:121px}.te-root .te-mini .te-kpi-icon{display:none}.te-ranked-row{grid-template-columns:27px minmax(110px,1fr) minmax(30px,.5fr) 80px}.te-rank-meter{display:block}}
            @media(max-width:480px){.te-root .te-mini{grid-template-columns:1fr}.te-root .te-mini .te-kpi{min-height:100px;display:flex}.te-root .te-mini .te-kpi-icon{display:grid}.te-exception-cards{grid-template-columns:1fr 1fr}.te-exception-card{padding:12px 10px 0;min-height:205px}.te-exception-label{font-size:12px}.te-exception-footer{margin-left:-10px;margin-right:-10px;padding:9px;font-size:9px}.te-rank-heading{align-items:flex-start}.te-rank-heading h3{font-size:14px}.te-rank-heading>.te-link{font-size:10px}.te-ranked-row{grid-template-columns:25px minmax(110px,1fr) 75px}.te-rank-meter{display:none}.te-rank-footer{flex-wrap:wrap}}
            .te-ranked-row,.te-rank-columnhead{grid-template-columns:30px minmax(130px,1fr) minmax(100px,.9fr) 85px;gap:12px}
            .te-ranked-list .te-ranked-row,.te-root .te-rank-columnhead{grid-template-columns:30px minmax(135px,1fr) minmax(70px,.7fr) 60px 79px;gap:11px}
            .te-rank-columnhead{display:grid;align-items:end;padding:12px 0 10px;border-bottom:1px solid #e1e6f0;font-size:10px;color:#7b88a0;font-weight:650}.te-rank-columnhead>span:last-child{text-align:right}.te-ranked-list{border-top:0}
            .te-rank-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;overflow-wrap:normal;font-size:12px}.te-ranked-row{padding:12px 0;min-height:58px}
            .te-rank-number{width:28px;height:31px;border-radius:8px;font-size:12px;background:#edf1ff;color:#5273c8}.te-ranked-list:not(.is-supplier) .te-ranked-row:first-child .te-rank-number{background:#4778e7;color:white}.te-ranked-list.is-supplier .te-rank-number{background:#e0f7ef;color:#128b74}
            .te-rank-progress{display:flex;gap:6px;align-items:center;min-width:0}.te-rank-progress>b{display:block;width:6px;height:6px;flex:0 0 6px;border-radius:50%;background:var(--rank-color)}.te-rank-progress .te-rank-meter{display:block;flex:1;height:3px;background:#dce2ee;border-radius:3px}.te-rank-progress .te-rank-meter i{height:3px;border-radius:3px}
            .te-rank-spark{display:block;width:60px;height:30px;border-radius:8px;background:color-mix(in srgb,var(--rank-color) 7%,white)}.te-rank-spark svg{display:block;width:60px;height:30px;overflow:visible}.te-rank-spark polyline{fill:none;stroke:var(--rank-color);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.te-rank-spark circle{fill:var(--rank-color)}.te-rank-trend-note{font-size:10px;color:#8793a9;line-height:1.5;margin:10px 0 0}.te-rank-value small{margin-top:2px}
            @media(max-width:1250px) and (min-width:761px){.te-ranked-row,.te-rank-columnhead{grid-template-columns:27px minmax(90px,1fr) 70px 68px;gap:8px}.te-ranked-list .te-ranked-row,.te-root .te-rank-columnhead{grid-template-columns:27px minmax(90px,1fr) 53px 45px 65px;gap:7px}.te-rank-spark,.te-rank-spark svg{width:45px}.te-rank-columnhead{font-size:9px}.te-rank-name{font-size:11px}}
            @media(max-width:600px){.te-ranked-row,.te-rank-columnhead{grid-template-columns:25px minmax(100px,1fr) 70px 65px;gap:7px}.te-ranked-list .te-ranked-row,.te-root .te-rank-columnhead{grid-template-columns:25px minmax(90px,1fr) 45px 42px 62px;gap:6px}.te-rank-spark,.te-rank-spark svg{width:42px}.te-rank-columnhead{font-size:9px}.te-rank-name{font-size:11px}.te-rank-heading h3{font-size:13px}}
            @media(max-width:420px){.te-ranked-list .te-ranked-row,.te-root .te-rank-columnhead{grid-template-columns:23px minmax(72px,1fr) 32px 35px 57px;gap:5px}.te-ranked-row,.te-rank-columnhead{grid-template-columns:23px minmax(80px,1fr) 55px 60px;gap:6px}.te-rank-spark,.te-rank-spark svg{width:35px}.te-rank-value strong{font-size:12px}.te-rank-progress{gap:4px}.te-rank-progress>b{width:5px;height:5px;flex-basis:5px}.te-rank-columnhead{font-size:8px}}
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region teDashboard (
        name: Today Enterprise Command Centre
        type: staticContent
        source {
            htmlCode:
                ```html
                <main class="te-root" id="todayEnterprise">
                 <header class="te-hero"><div class="te-hero-copy"><div class="te-eyebrow"><span class="fa fa-industry" aria-hidden="true"></span> Enterprise · Daily business overview</div><h1>Today <span>Enterprise Command Centre</span></h1><p>Sales, purchases, production and money movements.<br>Your business activity and pending work, in one place.</p><nav class="te-hero-links" aria-label="Jump to a dashboard section"><a href="#te-pulse">Business activity <span aria-hidden="true">↓</span></a><a href="#te-financial">Money &amp; stock <span aria-hidden="true">↓</span></a><a href="#te-attention-section">Pending work <span aria-hidden="true">↓</span></a><a href="#te-timeline">Recent transactions <span aria-hidden="true">↓</span></a></nav></div><div class="te-date"><span class="te-date-label"><span class="fa fa-calendar" aria-hidden="true"></span> Selected activity period</span><strong id="te-day">Today</strong><span class="te-freshness"><i aria-hidden="true"></i><span id="te-asof">Loading latest records</span></span><span class="te-timezone">India Standard Time · Amounts in INR</span></div></header>
                 <div class="te-toolbar"><div class="te-periods" aria-label="Activity period"><button type="button" data-period="TODAY" class="is-active">Today</button><button type="button" data-period="YESTERDAY">Yesterday</button><button type="button" data-period="7D">7 days</button><button type="button" data-period="MTD">MTD</button></div><button type="button" class="te-button" id="te-filter-toggle">Filters <span aria-hidden="true">⌄</span></button><button type="button" class="te-button is-primary" id="te-refresh">Refresh data</button></div>
                 <div id="te-filter-slot"></div>
                 <div id="te-scope" class="te-note"></div><div id="te-status" class="te-status" role="status" aria-live="polite">Loading today's business…</div>
                 <div class="te-how"><strong>How to use this dashboard</strong><span><b>1</b> Choose dates, company and location, then Apply filters.</span><span><b>2</b> Click any card, chart or value to open its records below.</span><span><b>3</b> Click a transaction number for its 360. Clear selection closes the register.</span></div><section class="te-section"><div class="te-heading"><div><h2>Business pulse</h2><p>Click a card to view its supporting records on this dashboard.</p></div><span class="te-tag">Activity in selected period</span></div><div id="te-pulse" class="te-kpis"><div class="te-skeleton"></div><div class="te-skeleton"></div><div class="te-skeleton"></div><div class="te-skeleton"></div></div></section>
                 <section class="te-section te-chart-section"><div class="te-grid"><div class="te-panel te-chart-panel"><div class="te-panel-head"><div><h3>Sales &amp; purchase movement</h3><p id="te-trend-period" class="te-note"></p></div><span class="te-tag">7-day trend</span></div><div id="te-trend" class="te-panel-body"></div></div><div class="te-panel te-chart-panel"><div class="te-panel-head"><h3>Business activity mix</h3><span class="te-tag">Selected period</span></div><div id="te-mix" class="te-panel-body"></div></div></div></section><section class="te-section"><div class="te-heading"><h2>Today's business lifecycle</h2><p>Click a stage to view its register. Each stage counts the transactions recorded in the selected period.</p></div><div id="te-lifecycle" class="te-flow"></div></section>
                 <section class="te-section" id="te-financial"><div class="te-heading"><div><h2>Money & current position</h2><p>Click a funds card or account balance to view its ledger entries. These are current book balances, even when you select an earlier activity period.</p></div><span class="te-tag now">Position as of now</span></div><div id="te-finance-loading" class="te-status">Loading ledger and inventory…</div><div id="te-funds" class="te-finance"></div><div class="te-grid"><div class="te-panel"><div class="te-panel-head"><h3>Cash / bank by account</h3><span class="te-tag now">Current ledger</span></div><div id="te-bank" class="te-panel-body"></div></div><div class="te-panel"><div class="te-panel-head"><h3>Working capital & stock</h3></div><div id="te-position" class="te-panel-body"></div></div></div></section>
                 <section class="te-section"><div class="te-heading"><h2>Commercial & procurement</h2><span class="te-tag">Activity in selected period</span></div><div class="te-grid"><div class="te-panel"><div class="te-panel-head"><h3>Sales & customer movement</h3></div><div class="te-panel-body"><div id="te-sales-kpis" class="te-mini"></div><div id="te-customers"></div></div></div><div class="te-panel"><div class="te-panel-head"><h3>Buying & supplier movement</h3></div><div class="te-panel-body"><div id="te-purchase-kpis" class="te-mini"></div><div id="te-suppliers"></div></div></div></div></section>
                 <section class="te-section"><div class="te-heading"><h2>Production, stores & materials</h2><p>Click a card, material name or quantity to view its records below. Quantities are grouped by unit.</p></div><div class="te-grid"><div class="te-panel"><div class="te-panel-head"><h3>Operational output & movement</h3></div><div class="te-panel-body"><div id="te-operations-kpis" class="te-mini"></div><div id="te-units"></div></div></div><div class="te-panel"><div class="te-panel-head"><h3>Highest-value material movements</h3></div><div id="te-materials" class="te-panel-body"></div></div></div></section>
                 <section class="te-section"><div class="te-heading"><h2>Logistics, assets & services</h2><span class="te-tag">Actual recorded activity</span></div><div class="te-grid"><div class="te-panel"><div class="te-panel-head"><h3>Gate & dispatch activity</h3></div><div class="te-panel-body"><div id="te-logistics-kpis" class="te-mini"></div><p class="te-note">Click Inbound Vehicles to view gate entries. Click Vehicles Dispatched to view gate exits. Click Transfer Orders to view orders raised between units.</p></div></div><div class="te-panel"><div class="te-panel-head"><h3>Maintenance, services & workforce</h3></div><div class="te-panel-body"><div id="te-other-kpis" class="te-mini"></div><p class="te-note">Click Maintenance Requests, Service Bills or Attendance Records Posted to view those records below. Attendance shows periodical postings.</p></div></div></div></section>
                 <section class="te-section" id="te-attention-section"><div class="te-heading"><div><h2>Attention required</h2><p>Click an issue, count or value to view the pending documents. The same document may need attention for more than one reason.</p></div><span class="te-tag warn">Exceptions as of now</span></div><div class="te-panel"><div id="te-control-chart" class="te-panel-body"></div><div id="te-alerts" class="te-panel-body"><div class="te-status">Loading control checks…</div></div></div><div class="te-grid" style="margin-top:16px"><div class="te-panel"><div class="te-panel-head"><h3>My pending approvals</h3><span class="te-tag now">Assigned to you</span></div><div id="te-approvals" class="te-panel-body"></div></div><div class="te-panel"><div class="te-panel-head"><h3>Items to review</h3></div><div id="te-insights" class="te-panel-body"></div></div></div></section>
                 <section class="te-section"><div class="te-heading"><h2>Location MIS</h2><p>Click a value to view that location’s transactions for the applied filters.</p></div><div class="te-grid"><div class="te-panel"><div class="te-panel-head"><h3>Billing by location</h3><span class="te-tag">INR</span></div><div id="te-location-chart" class="te-panel-body"></div></div><div class="te-panel"><div class="te-panel-head"><h3>Business movement by location</h3></div><div id="te-location-mis" class="te-panel-body"></div></div></div></section>
                 <section class="te-section te-recent"><div class="te-recent-head"><span class="te-recent-icon fa fa-line-chart" aria-hidden="true"></span><div><h2>Recent Activity <span class="te-live"><i></i> Live data</span></h2><p>Latest transactions recorded in the system</p></div><button type="button" class="te-button" data-metric="ALL_ACTIVITY" data-kind="ACTIVITY">View all activity →</button></div><p class="te-recent-guide">Click a transaction number to open its 360, or its coloured type badge to see its lines below. View all activity shows all transaction types for the applied dates, company, location and panel. Dates filter the transaction’s document date; Recorded shows when it was entered.</p><div id="te-timeline" class="te-timeline"></div></section>
                 <aside class="te-coverage"><details><summary>Definitions, data coverage & reconciliation</summary><p>Sales and purchase billing use line amounts. Service bills and PB Pass use document amounts and are labelled separately. GRN uses stored line values. Stock issued value uses issued quantity × source stock-layer rate, matching Issue Register. Cash/bank opening uses the financial-year Opening table plus subsequent ledger movement, excluding OPENING vouchers. All figures are INR base values; no currency conversion or cross-unit quantity totals are invented.</p><p>Operational controls cover current-financial-year documents except gate age checks (48-hour live visits; 2–400-day stale records). Only recorded ERP transactions and balances are shown; targets and forecasts are not calculated here. Owner labels identify the responsible department. Approval visibility follows the existing workflow queue; it is not panel-partitioned. Maintenance and attendance visibility follows their existing report privileges.</p><p>Refresh takes a new live snapshot. The activity and position sections show their own completion times. Records may change after a refresh; opening a register reads the latest saved records.</p></details></aside>
                 <div id="te-selection" class="te-selection"><div><strong id="te-selection-title"></strong><small id="te-selection-scope"></small></div><button type="button" id="te-clear-selection" aria-label="Clear drill selection">Clear selection ×</button></div>
                </main>
                
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader
                t-Region--noUI
            ]
        }
        advanced {
            htmlDomId: teDashboard
        }
    )

    region teEvidenceACTIVITY (
        name: Activity source register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with B as (select case when :P739_DIMTYPE='DAY' then to_date(:P739_DIMVALUE,'YYYY-MM-DD') else to_date(:P739_FROMDATE,'DD-MM-RRRR') end f,case when :P739_DIMTYPE='DAY' then to_date(:P739_DIMVALUE,'YYYY-MM-DD') else to_date(:P739_TODATE,'DD-MM-RRRR') end+1 t, (select GetUserPanelAB_apex() from dual) enforced from dual), E as (select 'BILLING' metric,h.TNo doc_id,d.SNo line_no, cast(h.CCInvoiceNo as varchar2(400)) doc_no,h.CCInvoiceDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity, i.MeasuringUnitCode1 unit_code, h.Creator creator,'Taxable invoice line value; excludes footer taxes.' note from CCInvoice h join CCInvoiceDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode cross join B b where h.CCInvoiceDate >= b.f and h.CCInvoiceDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='BILLING') union all select 'SALES_ORDER' metric,h.TNo doc_id,d.SNo line_no, cast(h.SalesOrderNo as varchar2(400)) doc_no,h.SalesOrderDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity, i.MeasuringUnitCode1 unit_code, h.Creator creator,'Order line amounts, before footer charges.' note from SalesOrder h join SalesOrderDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode cross join B b where h.SalesOrderDate >= b.f and h.SalesOrderDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='SALES_ORDER') union all select 'PO' metric,h.TNo doc_id,d.SNo line_no, cast(h.PurchaseOrderNo as varchar2(400)) doc_no,h.PurchaseOrderDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity, i.MeasuringUnitCode1 unit_code, h.Creator creator,'Purchase order line amounts, before footer charges.' note from PurchaseOrder h join PurchaseOrderDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode cross join B b where h.PurchaseOrderDate >= b.f and h.PurchaseOrderDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='PO') union all select 'PURCHASE' metric,h.TNo doc_id,d.SNo line_no, cast(h.PurchaseBillNo as varchar2(400)) doc_no,h.PurchaseBillDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity, i.MeasuringUnitCode1 unit_code, h.Creator creator,'Purchase bill line value; excludes footer charges.' note from PurchaseBill h join PurchaseBillDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode cross join B b where h.PurchaseBillDate >= b.f and h.PurchaseBillDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='PURCHASE') union all select 'GRN' metric,h.TNo doc_id,d.SNo line_no, cast(h.GrnNo as varchar2(400)) doc_no,h.GrnDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.ReceivedQuantity1 quantity, i.MeasuringUnitCode1 unit_code, h.Creator creator,'Stored GRN line amounts; quantity is reported by unit.' note from Grn h join GrnDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode cross join B b where h.GrnDate >= b.f and h.GrnDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='GRN') union all select 'PRODUCTION' metric,h.TNo doc_id,d.SNo line_no, cast(h.ProductionNo as varchar2(400)) doc_no,h.ProductionDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, cast(null as varchar2(400)) party_code,d.ItemCode item_code,d.StockValue amount,d.Quantity1 quantity, i.MeasuringUnitCode1 unit_code, h.Creator creator,'Production documents with finished-output lines; quantities below by unit.' note from Production h join ProductionFinished d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode cross join B b where h.ProductionDate >= b.f and h.ProductionDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='PRODUCTION') union all select 'ISSUE' metric,h.TNo doc_id,d.SNo line_no, cast(h.IssueNo as varchar2(400)) doc_no,h.IssueDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, cast(null as varchar2(400)) party_code,d.ItemCode item_code,(select sum(u.UsedStockQuantity1*s.Rate) from UsedStock u join Stock s on s.TNo=u.StockTNo where u.ModuleCode='ISSUE' and u.ModuleTNo=h.TNo and u.ModuleSNo=d.SNo) amount,d.Quantity1 quantity, i.MeasuringUnitCode1 unit_code, h.Creator creator,'Issued stock quantity × source layer rate, reconciled with Issue Register; gross issue value before returns.' note from Issue h join IssueDetail d on d.TNo=h.TNo left join Item i on i.ItemCode=d.ItemCode cross join B b where h.IssueDate >= b.f and h.IssueDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='ISSUE') union all select 'REQUISITION' metric,h.TNo doc_id,cast(null as number) line_no, cast(h.RequisitionNo as varchar2(400)) doc_no,h.RequisitionDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,h.ItemCode item_code,cast(null as number) amount,cast(null as number) quantity, i.MeasuringUnitCode1 unit_code, h.Creator creator,'Requisition documents dated in the selected period.' note from Requisition h left join Item i on i.ItemCode=h.ItemCode cross join B b where h.RequisitionDate >= b.f and h.RequisitionDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='REQUISITION') union all select 'PASS' metric,h.TNo doc_id,cast(null as number) line_no, cast(h.PBPassNo as varchar2(400)) doc_no,h.PBPassDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, (select x.PartyCode from PurchaseBill x where x.TNo=h.PurchaseBillTNo) party_code,cast(null as varchar2(400)) item_code,h.PBPassAmount amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code, h.Creator creator,'Purchase bill: '||(select x.PurchaseBillNo from PurchaseBill x where x.TNo=h.PurchaseBillTNo) note from PBPass h cross join B b where h.PBPassDate >= b.f and h.PBPassDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='PASS') union all select 'DISPATCH' metric,h.TNo doc_id,cast(null as number) line_no, cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateOutTime event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code, h.Creator creator,'Vehicle: '||h.VehicleNo||'; gate in: '||to_char(h.GateInTime,'DD-Mon-YYYY HH24:MI') note from MaterialOut h cross join B b where h.GateOutTime >= b.f and h.GateOutTime<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='DISPATCH') union all select 'GATE_IN' metric,h.TNo doc_id,cast(null as number) line_no, cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code, h.Creator creator,'Vehicle: '||h.VehicleNo||'; source reference: '||h.RefDocNo note from MaterialIn h cross join B b where h.GateInTime >= b.f and h.GateInTime<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='GATE_IN') union all select 'SERVICE' metric,h.TNo doc_id,cast(null as number) line_no, cast(h.ServiceBillNo as varchar2(400)) doc_no,h.ServiceBillDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,h.ItemCode item_code,h.ServiceBillAmount amount,cast(null as number) quantity, i.MeasuringUnitCode1 unit_code, h.Creator creator,'Gross service bill amount, shown separately from material billing.' note from ServiceBill h left join Item i on i.ItemCode=h.ItemCode cross join B b where h.ServiceBillDate >= b.f and h.ServiceBillDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='SERVICE') union all select 'TRANSFER' metric,h.TNo doc_id,cast(null as number) line_no, cast(h.InterUnitTransferNo as varchar2(400)) doc_no,h.InterUnitTransferDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code, h.Creator creator,'Transfer order only; destination: '||h.ToLocationCode note from InterUnitTransfer h cross join B b where h.InterUnitTransferDate >= b.f and h.InterUnitTransferDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='TRANSFER') union all select 'ISSUE_RETURN' metric,h.TNo doc_id,cast(null as number) line_no, cast(h.IssueReturnNo as varchar2(400)) doc_no,h.IssueReturnDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel, h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code, h.Creator creator,'Recorded issue-return documents.' note from IssueReturn h cross join B b where h.IssueReturnDate >= b.f and h.IssueReturnDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='ISSUE_RETURN') union all select 'MAINTENANCE' metric,h.TNo doc_id,cast(null as number) line_no, cast(h.MaintenanceRequestNo as varchar2(400)) doc_no,h.MaintenanceRequestDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,cast(null as varchar2(10)) panel, cast(null as varchar2(400)) party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code, h.Creator creator,substr('Equipment: '||(select e.EquipmentName from Equipment e where e.TNo=h.EquipmentTNo)||'; '||h.NotificationShortText||'; responsible: '||h.PersonResponsible,1,400) note from MaintenanceRequest h cross join B b where h.MaintenanceRequestDate >= b.f and h.MaintenanceRequestDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and :P739_ALLOW_MAINT='Y' and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='MAINTENANCE') union all select 'WORKFORCE' metric,h.TNo doc_id,cast(null as number) line_no, cast(h.AttendencePeriodicalNo as varchar2(400)) doc_no,h.AttendencePeriodicalDate event_date,h.CreationTime logged_at, h.CompanyCode company_code,h.LocationCode location_code,cast(null as varchar2(10)) panel, cast(null as varchar2(400)) party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity, cast(null as varchar2(400)) unit_code, h.Creator creator,'Employee: '||h.EmployeeCode||'; attendance period: '||to_char(h.FromDate,'DD-Mon-YYYY')||' to '||to_char(h.ToDate,'DD-Mon-YYYY')||'; not a daily attendance count' note from AttendencePeriodical h cross join B b where h.AttendencePeriodicalDate >= b.f and h.AttendencePeriodicalDate<b.t and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and :P739_ALLOW_HR='Y' and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='WORKFORCE') union all select 'COLLECTION',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime, d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),1*d.Amount,cast(null as number),cast(null as varchar2(400)),v.Creator, cast(substr(d.Narration,1,400) as varchar2(400)) from VoucherDetail d join Voucher v on v.TNo=d.TNo cross join B b where d.VoucherDate>=b.f and d.VoucherDate<b.t and v.DocTypeCode in ('RECEIPT') and 1*d.Amount>0 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode) and (:P739_COMPANY is null or d.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or d.LocationCode=:P739_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P739_PANEL is null or d.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='COLLECTION') union all select 'PAYMENT',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime, d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),-1*d.Amount,cast(null as number),cast(null as varchar2(400)),v.Creator, cast(substr(d.Narration,1,400) as varchar2(400)) from VoucherDetail d join Voucher v on v.TNo=d.TNo cross join B b where d.VoucherDate>=b.f and d.VoucherDate<b.t and v.DocTypeCode in ('PAYMENT','CASHPAYMENT','BANKPAYMENT') and -1*d.Amount>0 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode) and (:P739_COMPANY is null or d.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or d.LocationCode=:P739_LOCATION) and (b.enforced is null or d.Panel=b.enforced) and (:P739_PANEL is null or d.Panel=:P739_PANEL) and (:P739_METRIC is null or :P739_METRIC='ALL_ACTIVITY' or :P739_METRIC='PAYMENT')) select case e.metric when 'BILLING' then 'Sales invoice' when 'COLLECTION' then 'Customer receipt' when 'PAYMENT' then 'Supplier payment' when 'PURCHASE' then 'Purchase bill' when 'GRN' then 'Goods receipt' when 'PRODUCTION' then 'Production entry' when 'DISPATCH' then 'Outbound gate visit' when 'SALES_ORDER' then 'Sales order' when 'PO' then 'Purchase order' when 'PASS' then 'Bill pass' when 'REQUISITION' then 'Material requisition' when 'ISSUE' then 'Stock issue' when 'GATE_IN' then 'Inbound gate visit' when 'SERVICE' then 'Service bill' when 'TRANSFER' then 'Transfer order' when 'ISSUE_RETURN' then 'Issue return' when 'MAINTENANCE' then 'Maintenance request' when 'WORKFORCE' then 'Attendance posting' end ACTIVITY,e.doc_id DOCUMENT_ID,e.line_no LINE_NO,e.doc_no DOCUMENT_NO,e.event_date DOCUMENT_DATE, nvl(c.CompanyName,e.company_code) COMPANY,nvl(l.LocationName,e.location_code) LOCATION, nvl(pa.PartyName,e.party_code) PARTY,nvl(i.ItemName,e.item_code) ITEM,e.quantity QUANTITY, nvl(mu.MeasuringUnitName,e.unit_code) UNIT,e.amount AMOUNT,e.logged_at RECORDED_AT,e.creator RECORDED_BY,e.note NOTES,'<a href="'||apex_escape.html_attribute(case e.metric when 'BILLING' then apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>e.doc_id) when 'PURCHASE' then apex_page.get_url(p_page=>680,p_clear_cache=>'680',p_items=>'P680_TNO',p_values=>e.doc_id) when 'PO' then apex_page.get_url(p_page=>682,p_clear_cache=>'682',p_items=>'P682_TNO,P682_FROMDATE,P682_TODATE,P682_COMPANY,P682_LOCATION',p_values=>e.doc_id||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION) when 'SALES_ORDER' then apex_page.get_url(p_page=>734,p_clear_cache=>'734',p_items=>'P734_SOTNO,P734_FROMDATE,P734_TODATE,P734_COMPANY,P734_LOCATION,P734_PANEL',p_values=>e.doc_id||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL) when 'REQUISITION' then apex_page.get_url(p_page=>687,p_clear_cache=>'687',p_items=>'P687_REQTNO,P687_FROMDATE,P687_TODATE,P687_COMPANY,P687_LOCATION',p_values=>e.doc_id||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION) when 'ISSUE' then apex_page.get_url(p_page=>686,p_clear_cache=>'686',p_items=>'P686_ISSUETNO,P686_FROMDATE,P686_TODATE,P686_COMPANY,P686_LOCATION,P686_PANEL',p_values=>e.doc_id||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL) when 'COLLECTION' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>e.doc_id) when 'PAYMENT' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>e.doc_id) else apex_page.get_url(p_page=>740,p_clear_cache=>'740',p_items=>'P740_METRIC,P740_DOC,P740_FROMDATE,P740_TODATE,P740_COMPANY,P740_LOCATION,P740_PANEL',p_values=>e.metric||','||e.doc_id||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(e.event_date,'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL) end)||'">Transaction 360</a> '||case when e.party_code is not null then case when e.metric in ('PURCHASE','PO','GRN','PASS','PAYMENT') then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>669,p_clear_cache=>'669',p_items=>'P669_SUPPLIER,P669_FROMDATE,P669_TODATE,P669_COMPANY,P669_LOCATION,P669_PANEL',p_values=>e.party_code||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL))||'">Supplier 360</a> ' when e.metric in ('BILLING','SALES_ORDER','COLLECTION') then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>693,p_clear_cache=>'693',p_items=>'P693_PARTY,P693_FROMDATE,P693_TODATE,P693_COMPANY,P693_LOCATION,P693_PANEL',p_values=>e.party_code||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL))||'">Customer 360</a> ' end end||case when e.item_code is not null then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>679,p_clear_cache=>'679',p_items=>'P679_ITEMCODE,P679_FROMDATE,P679_TODATE,P679_COMPANY,P679_LOCATION,P679_PANEL',p_values=>e.item_code||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL))||'">Item 360</a> ' end RELATED_360 from E e left join Company c on c.CompanyCode=e.company_code left join Location l on l.LocationCode=e.location_code left join Party pa on pa.PartyCode=e.party_code left join Item i on i.ItemCode=e.item_code left join MeasuringUnit mu on mu.MeasuringUnitCode=e.unit_code where :P739_METRIC is not null and (:P739_DIMTYPE is null or :P739_DIMTYPE='DAY' or (:P739_DIMTYPE='PARTY' and e.party_code=:P739_DIMVALUE) or (:P739_DIMTYPE='LOCATION' and nvl(e.location_code,'~')=:P739_DIMVALUE) or (:P739_DIMTYPE='ITEM' and e.item_code=:P739_DIMVALUE) or (:P739_DIMTYPE='UNIT' and nvl(e.unit_code,'~')=:P739_DIMVALUE)) and (:P739_DOC is null or e.doc_id=to_number(:P739_DOC default null on conversion error))
            pageItemsToSubmit: [
                P739_FROMDATE
