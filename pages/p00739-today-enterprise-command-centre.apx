            .te-how{display:flex;align-items:center;flex-wrap:wrap;gap:12px 20px;padding:14px 17px;background:#eef3fe;border:1px solid #dae4fa;border-radius:10px;margin:13px 0 0;font-size:11px;color:#687996}.te-how strong{color:#3d5c90;font-size:12px}.te-how span{display:flex;gap:7px;align-items:center}.te-how b{display:inline-grid;place-items:center;width:20px;height:20px;flex-shrink:0;border-radius:50%;background:#dbe6fc;color:#42649a}.te-selection button{font-size:12px;font-weight:700;color:#6653ba;background:#fff;border:1px solid #d7d3ec;border-radius:7px;white-space:nowrap}
            .te-root .te-kpi.attention{display:block}.te-root .te-kpi.attention strong{margin:12px 0}.te-event-doc:after{content:"Open 360";display:inline-block;font-size:9px;font-weight:700;margin-left:7px;padding:1px 5px;background:#e9e5fa;border-radius:4px;color:#6751a5}
            .te-root .te-kpi{--te-accent:#526cc6;display:flex;gap:13px;align-items:flex-start;padding:20px 18px 18px 21px;border:1px solid color-mix(in srgb,var(--te-accent) 22%,#e8ecf4);background:linear-gradient(115deg,color-mix(in srgb,var(--te-accent) 10%,white),white 85%);border-radius:14px;min-height:170px;box-shadow:0 5px 16px #243d6810;overflow:hidden}
            .te-root .te-kpi:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--te-accent)}
            .te-root .te-kpi:after{color:var(--te-accent);top:13px;right:13px;opacity:.7}
            .te-kpi-icon{flex:0 0 43px;width:43px;height:43px;border-radius:12px;display:grid;place-items:center;background:color-mix(in srgb,var(--te-accent) 15%,white);color:var(--te-accent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--te-accent) 12%,transparent)}
