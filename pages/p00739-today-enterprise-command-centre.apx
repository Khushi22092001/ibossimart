page 739 (
    name: Today Enterprise Command Centre
    alias: TODAY-ENTERPRISE-COMMAND-CENTRE
    title: Today Enterprise Command Centre
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_IMAGES#dashboard-fast-charts.js?today=20260831
        executeWhenPageLoads:
            ```javascript-browser
            (function () {
             'use strict';
             var $=apex.jQuery, root=document.getElementById('todayEnterprise');
             if(!root)return;
             document.getElementById('te-filter-slot').appendChild(document.getElementById('teFilters'));
            
             var catalogue=[{"key":"BILLING","label":"Sales billing","group":"Sales","format":"INR","note":"Taxable invoice line value; excludes footer taxes.","permission":653},{"key":"COLLECTION","label":"Customer collections","group":"Finance","format":"INR","note":"Positive receipt postings to debtor accounts.","permission":700},{"key":"PAYMENT","label":"Supplier payments","group":"Finance","format":"INR","note":"Creditor payment debit postings, displayed as money out.","permission":720},{"key":"PURCHASE","label":"Purchase bills","group":"Procurement","format":"INR","note":"Purchase bill line value; excludes footer charges.","permission":668},{"key":"GRN","label":"Material received","group":"Procurement","format":"INR","note":"Stored GRN line amounts; quantity is reported by unit.","permission":668},{"key":"PRODUCTION","label":"Production output","group":"Operations","format":"COUNT","note":"Production documents with finished-output lines; quantities below by unit.","permission":652},{"key":"DISPATCH","label":"Vehicles dispatched","group":"Logistics","format":"COUNT","note":"Outbound visits with an actual gate-out timestamp.","permission":738},{"key":"SALES_ORDER","label":"Sales orders","group":"Sales","format":"INR","note":"Order line amounts, before footer charges.","permission":653},{"key":"PO","label":"Purchase orders","group":"Procurement","format":"INR","note":"Purchase order line amounts, before footer charges.","permission":668},{"key":"PASS","label":"Bills passed","group":"Procurement","format":"INR","note":"PB Pass document amounts; not a payment measure.","permission":668},{"key":"REQUISITION","label":"Material requisitions","group":"Store","format":"COUNT","note":"Requisition documents dated in the selected period.","permission":684},{"key":"ISSUE","label":"Stock issued value","group":"Store","format":"INR","note":"Issued stock quantity × source layer rate, reconciled with Issue Register; gross issue value before returns.","permission":684},{"key":"GATE_IN","label":"Inbound vehicles","group":"Logistics","format":"COUNT","note":"Inbound visits with an actual gate-in timestamp.","permission":738},{"key":"SERVICE","label":"Service bills","group":"Service","format":"INR","note":"Gross service bill amount, shown separately from material billing.","permission":186},{"key":"TRANSFER","label":"Transfer orders","group":"Store","format":"COUNT","note":"Inter-unit transfer orders raised; not completed physical transfers.","permission":684},{"key":"ISSUE_RETURN","label":"Issue returns","group":"Store","format":"COUNT","note":"Recorded issue-return documents.","permission":684},{"key":"MAINTENANCE","label":"Maintenance requests","group":"Maintenance","format":"COUNT","note":"Recorded requests, not equipment availability or completed repairs.","permission":252},{"key":"WORKFORCE","label":"Attendance records posted","group":"Workforce","format":"COUNT","note":"Periodical attendance documents posted; not daily present/absent headcount.","permission":49}], alerts=[{"key":"PO_OVERDUE","label":"Overdue POs without receipts","severity":"Warning","owner":"Procurement","note":"Current FY; delivery date passed and no GRN recorded."},{"key":"GRN_UNBILLED","label":"Receipts without purchase bills","severity":"Watch","owner":"Purchase accounts","note":"Current FY GRNs without a purchase-bill GRN link."},{"key":"BILL_UNPASSED","label":"Purchase bills awaiting pass","severity":"Warning","owner":"Purchase accounts","note":"Current FY bills with no PB Pass document."},{"key":"GATE_UNBILLED","label":"Dispatched vehicles not invoiced","severity":"Warning","owner":"Sales billing","note":"Current FY outbound gate exits with advice but no linked CC invoice."},{"key":"IN_NO_GRN","label":"Inbound exits without GRN","severity":"Watch","owner":"Stores","note":"Current FY inbound visits that exited without a GRN."},{"key":"GATE_INSIDE","label":"Vehicles inside over 8 hours","severity":"Warning","owner":"Gate operations","note":"Open inbound/outbound visits from the last 48 hours; older records separated."},{"key":"GATE_STALE","label":"Older unclosed gate records","severity":"Watch","owner":"Gate operations","note":"Unclosed visits aged 2–400 days; verify data before treating them as live vehicles."},{"key":"APPROVAL","label":"My pending approvals","severity":"Action","owner":"My workflow queue","note":"Existing user-scoped approval queue; not a company-wide unfiltered backlog."}], transactionLabels={"BILLING":"Sales invoice","COLLECTION":"Customer receipt","PAYMENT":"Supplier payment","PURCHASE":"Purchase bill","GRN":"Goods receipt","PRODUCTION":"Production entry","DISPATCH":"Outbound gate visit","SALES_ORDER":"Sales order","PO":"Purchase order","PASS":"Bill pass","REQUISITION":"Material requisition","ISSUE":"Stock issue","GATE_IN":"Inbound gate visit","SERVICE":"Service bill","TRANSFER":"Transfer order","ISSUE_RETURN":"Issue return","MAINTENANCE":"Maintenance request","WORKFORCE":"Attendance posting"}, current=null, positions=null, busy=false, appliedScope='', usable=false;
             var map={};catalogue.forEach(function(x){map[x.key]=x;});
             function esc(x){return apex.util.escapeHTML(String(x==null?'':x));}
             function number(x){return new Intl.NumberFormat('en-IN',{maximumFractionDigits:2}).format(Number(x)||0);}
             function money(x){if(x==null)return 'Not valued';var a=Math.abs(x),s=x<0?'−':'';return s+'₹ '+number(a>=1e7?a/1e7:a>=1e5?a/1e5:a)+(a>=1e7?' Cr':a>=1e5?' L':'');}
             function val(id){return apex.item('P739_'+id).getValue();}
             function set(id,v){apex.item('P739_'+id).setValue(v==null?'':v,null,true);}
             function put(id,html){document.getElementById(id).innerHTML=html;}
             function empty(text){return '<div class="te-empty">'+esc(text||'No recorded activity in this scope.')+'</div>';}
             function attrs(key,kind,dimtype,dimvalue,doc){return ' data-metric="'+esc(key)+'" data-kind="'+(kind||'ACTIVITY')+'"'+(dimtype?' data-dimtype="'+esc(dimtype)+'" data-dimvalue="'+esc(dimvalue==null?'~':dimvalue)+'"':'')+(doc?' data-doc="'+esc(doc)+'"':'');}
             function link(text,key,kind,dimtype,dimvalue,doc){return '<button type="button" class="te-link"'+attrs(key,kind,dimtype,dimvalue,doc)+'>'+esc(text)+'</button>';}
              var tones={BILLING:['#326fe3','fa-line-chart'],COLLECTION:['#15976c','fa-arrow-circle-down'],PAYMENT:['#dc7940','fa-arrow-circle-up'],PURCHASE:['#7855d9','fa-shopping-cart'],GRN:['#148f9d','fa-truck'],PRODUCTION:['#4d5bc4','fa-industry'],DISPATCH:['#c47e18','fa-road'],SALES_ORDER:['#326fe3','fa-file-text-o'],PO:['#7855d9','fa-file-text-o'],PASS:['#8d50aa','fa-check-circle'],REQUISITION:['#4d5bc4','fa-list-alt'],ISSUE:['#148f9d','fa-cubes'],GATE_IN:['#c47e18','fa-sign-in'],TRANSFER:['#c47e18','fa-exchange'],MAINTENANCE:['#59728b','fa-wrench'],SERVICE:['#15976c','fa-briefcase'],WORKFORCE:['#8d50aa','fa-users'],ISSUE_RETURN:['#148f9d','fa-undo']};
             var chartPalette=['#4179e7','#19a78d','#8c64db','#e8a145','#d7658b','#55a9c7','#606bc6'];
             function glyph(key){return '<span class="te-kpi-icon" aria-hidden="true"><span class="fa '+(tones[key]||[])[1]+'"></span></span>';}
             function comparisonBars(d,m){var v=m.format==='INR'?d.amount:d.docs,p=m.format==='INR'?d.prior_amount:d.prior_docs,max=Math.max(Math.abs(v||0),Math.abs(p||0),1);return '<div class="te-compare-bars" aria-hidden="true"><span style="width:'+Math.abs(p||0)/max*100+'%"></span><b style="width:'+Math.abs(v||0)/max*100+'%"></b></div>';}
             function svgStart(w,h,label){return '<svg class="te-chart-svg" viewBox="0 0 '+w+' '+h+'" role="group" aria-label="'+esc(label)+'">';}
             function chartDays(){var p=val('TODATE').split('-'),end=new Date(+p[2],+p[1]-1,+p[0],12),days=[];for(var i=6;i>=0;i--){var d=new Date(end);d.setDate(d.getDate()-i);days.push({key:d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2),label:d.getDate()+' '+d.toLocaleDateString('en-GB',{month:'short'})});}return days;}
             function chartAction(key,kind,dimtype,dimvalue,label){return {item:'P739_CHART_PICK',key:JSON.stringify({key:key,kind:kind||'ACTIVITY',dimtype:dimtype||'',dimvalue:dimvalue==null?'~':dimvalue,label:label||''})};}
             function sharedChart(type,payload,height){return '<div class="ds-fast-chart" data-chart-type="'+type+'" data-chart-height="'+(height||350)+'" data-json="'+esc(JSON.stringify(payload))+'"></div>';}
             function redrawSharedCharts(){$(root).trigger('apexafterrefresh');}
             function renderCharts(data){var days=chartDays(),rows=days.map(function(day){return {l:day.label,values:['BILLING','PURCHASE'].map(function(k){var x=(data.trend||[]).find(function(r){return r.key===k&&r.day===day.key;});return x?(Number(x.amount)||0)/1e5:0;}),actions:['BILLING','PURCHASE'].map(function(k){return chartAction(k,'ACTIVITY','DAY',day.key,day.label);})};});put('te-trend',sharedChart('line',{unit:'Rs lakh',series:['Sales billing','Purchase bills'],rows:rows},350)+'<p class="te-note">Click a date point to see that day’s sales invoices or purchase bills below.</p>');document.getElementById('te-trend-period').textContent='7 days ending '+val('TODATE');var mix=['SALES_ORDER','PO','GRN','BILLING','DISPATCH','REQUISITION'].map(function(k){return Object.assign({l:map[k].label,values:[metric(k).docs]},chartAction(k,'ACTIVITY',null,null,map[k].label));}).filter(function(r){return r.values[0]>0;});put('te-mix',sharedChart('donut',{unit:'documents',series:['Documents'],rows:mix},350)+'<p class="te-note">Click a segment to open that transaction type’s register below. Counts are separate for each type.</p>');redrawSharedCharts();}
            
             function partySparkline(key,code){
              var days=chartDays(),records=(current.party_trends||[]).filter(function(r){return r.key===key&&String(r.code)===String(code);});
              var values=days.map(function(day){var r=records.find(function(x){return x.day===day.key;});return r?(Number(r.amount)||0):0;});
              var low=Math.min.apply(null,[0].concat(values)),high=Math.max.apply(null,[0].concat(values)),range=high-low||1;
              var points=values.map(function(v,i){return (4+i*8.5).toFixed(1)+','+(24-(v-low)/range*18).toFixed(1);}).join(' ');
              var measure=key==='PURCHASE'?'purchase value':'taxable billing',label='Daily '+measure+': '+days.map(function(d,i){return d.label+' '+money(values[i]);}).join('; ');
              return '<span class="te-rank-spark" role="img" aria-label="7-day '+measure+' trend ending '+esc(val('TODATE'))+'" title="'+esc(label)+'"><svg viewBox="0 0 60 30" aria-hidden="true"><polyline points="'+points+'"/><circle cx="55" cy="'+(24-(values[6]-low)/range*18).toFixed(1)+'" r="1.8"/></svg></span>';
             }
             function rankedParties(rows,key){
              var supplier=key==='PURCHASE',label=supplier?'suppliers':'customers',total=Number(metric(key).amount)||0,kind=supplier?'Supplier':'Customer';
              var heading='<div class="te-rank-heading"><div><h3>Top '+label+' by '+(supplier?'purchase line value':'taxable billing')+'</h3><p>Ranked by value (₹ lakh)</p></div>'+link('View all records →',key)+'</div>';
              if(!rows.length)return heading+empty('No '+label+' recorded for the applied filters.');
              var count=Number(rows[0].party_count)||rows.length,days=chartDays(),palette=supplier?['#18ac96','#609bef','#9162dd','#e670a6','#f09965','#dca650','#2ab58d']:['#467bef','#20bfd1','#9560df','#e55ea2','#fb945a','#efb54f','#29b892'];
              var head='<div class="te-rank-columnhead'+(supplier?' is-supplier':'')+'" aria-hidden="true"><span>Rank</span><span>'+kind+'</span><span>Share of value</span>'+'<span>7-day trend</span>'+'<span>Value (₹ lakh)</span></div>';
              return heading+head+'<div class="te-ranked-list'+(supplier?' is-supplier':'')+'">'+rows.map(function(r,i){var amount=Number(r.amount)||0,share=total>0&&amount>=0?amount/total*100:null,color=palette[i%palette.length];
               return '<button type="button" class="te-ranked-row" data-label="'+esc(r.name)+'" style="--rank-color:'+color+'" title="View '+esc(r.name)+(supplier?' purchase bills':' sales invoices')+' below"'+attrs(key,'ACTIVITY','PARTY',r.code)+'><span class="te-rank-number">'+(i+1)+'</span><span class="te-rank-name">'+esc(r.name)+'</span><span class="te-rank-progress" aria-hidden="true"><b></b><span class="te-rank-meter"><i style="width:'+Math.max(0,Math.min(100,share||0))+'%"></i></span></span>'+partySparkline(key,r.code)+'<span class="te-rank-value"><strong>'+number(amount/1e5)+'</strong><small>'+(share==null?'':number(share)+'%')+'</small></span></button>';
              }).join('')+'</div><div class="te-rank-footer"><span>Showing '+rows.length+' of '+number(count)+' '+label+'</span><span>Click a row to view its records ↓</span></div>'+'<p class="te-rank-trend-note">Mini charts: daily '+(supplier?'purchase value':'taxable billing')+', '+esc(days[0].label)+'–'+esc(days[6].label)+'. Company, location and panel follow your filters. Hover a chart for daily values.</p>';
             }
             function renderControlChart(data){
              var all=(data.alerts||[]).filter(function(x){return x.key!=='APPROVAL';}),total=all.reduce(function(n,r){return n+(Number(r.docs)||0);},0),active=all.filter(function(r){return r.docs>0;});
              var rows=active.sort(function(a,b){return b.docs-a.docs;}).slice(0,5),icons=['fa-file-text-o','fa-clock-o','fa-truck','fa-list-alt','fa-exclamation-circle'];
              if(!rows.length){put('te-control-chart',empty('No pending documents in these exception checks.'));return;}
              put('te-control-chart','<div class="te-exception-cards">'+rows.map(function(r,i){var a=alerts.find(function(x){return x.key===r.key;})||{label:r.key,owner:'Review',severity:'Review'},color=['#7956d8','#e19a2b','#cc557e','#239cac','#5653cc'][i];
               return '<button type="button" class="te-exception-card" style="--exception-color:'+color+'"'+attrs(r.key,'ALERT')+' title="View pending documents: '+esc(a.label)+'"><span class="te-exception-top"><span class="te-exception-rank">'+(i+1)+'</span><span class="te-exception-icon fa '+icons[i]+'" aria-hidden="true"></span></span><span class="te-exception-label">'+esc(a.label)+'</span><strong>'+number(r.docs)+'</strong><span class="te-exception-docs">documents · View records →</span><span class="te-exception-footer"><span>'+esc(a.owner)+'</span><b>'+esc(a.severity)+'</b></span></button>';
              }).join('')+'</div><div class="te-exception-summary"><span><small>Total exception flags</small><strong>'+number(total)+'</strong></span><span><small>Checks with pending work</small><strong>'+number(active.length)+'</strong></span><p>A document can appear in more than one check. These flags are not a count of unique documents.</p></div>');
             }
            
             function metric(key){var d=(current.metrics||[]).find(function(x){return x.key===key;})||{docs:0,amount:0,prior_docs:0,prior_amount:0};return Object.assign({},d,{amount:d.docs===0?0:d.amount,prior_amount:d.prior_docs===0?0:d.prior_amount});}
             function tile(key,mini){var m=map[key],d=metric(key),v=m.format==='INR'?d.amount:d.docs,prior=m.format==='INR'?d.prior_amount:d.prior_docs;
              if((key==='MAINTENANCE'&&!current.allowMaint)||(key==='WORKFORCE'&&!current.allowHR))return '<div class="te-kpi"><span class="te-kpi-label">'+esc(m.label)+'</span><strong>Restricted</strong><small>Existing report access required</small></div>';
              var delta=prior?((v-prior)/Math.abs(prior)*100):null;
              return '<button type="button" class="te-kpi ds-kpi" style="--te-accent:'+(tones[key]||['#62748b'])[0]+'" title="'+esc(m.note)+'"'+attrs(key)+'>'+glyph(key)+'<span class="te-kpi-body"><span class="te-kpi-label">'+esc(m.label)+'</span><strong>'+esc(m.format==='INR'?money(v):number(v))+'</strong><small>'+number(d.docs)+' '+(d.docs===1?'document':'documents')+(m.format==='COUNT'?' · '+esc(m.group):'')+'</small><small class="te-card-action">View records →</small>'+(!mini?'<small class="te-delta"><span class="te-delta-badge">'+(delta==null?'No prior activity':(delta>=0?'↑ ':'↓ ')+number(Math.abs(delta))+'%')+'</span>'+(delta==null?'':' vs prior equal period')+'</small>':'')+'</span></button>';
             }
             function table(headers,rows){return rows.length?'<div class="te-table-wrap"><table class="te-table"><thead><tr>'+headers.map(function(x){return '<th>'+esc(x)+'</th>';}).join('')+'</tr></thead><tbody>'+rows.join('')+'</tbody></table></div>':empty();}
             function bars(rows,key,dim){if(!rows.length)return empty();return sharedChart('hbar',{unit:'Rs lakh',series:[map[key].label],rows:rows.map(function(r){return Object.assign({l:r.name,values:[(Number(r.amount)||0)/1e5]},chartAction(key,'ACTIVITY',dim,r.code,r.name));})},360)+'<p class="te-note">Click a bar to see its '+(key==='PURCHASE'?'purchase bills':'sales invoices')+' below.</p>';}
             function renderActivity(data){current=data;var pulse=['BILLING','COLLECTION','PAYMENT','PURCHASE','GRN','PRODUCTION','DISPATCH'];put('te-pulse',pulse.map(function(k){return tile(k);}).join('')+'<button type="button" id="te-attention-card" class="te-kpi attention"><span class="te-kpi-label">Attention required · now</span><strong id="te-attention-count">…</strong><small>Pending checks across departments</small><small class="te-delta">View pending work below ↓</small></button>');
              var flow=['SALES_ORDER','PO','GRN','PRODUCTION','DISPATCH','BILLING','COLLECTION'];put('te-lifecycle',flow.map(function(k){var m=map[k],d=metric(k);return '<button type="button"'+attrs(k)+'><span>'+esc(m.label)+'</span><strong>'+esc(m.format==='INR'?money(d.amount):number(d.docs))+'</strong><small>'+number(d.docs)+' documents</small></button>';}).join(''));
              [['te-sales-kpis',['SALES_ORDER','BILLING','COLLECTION']],['te-purchase-kpis',['PO','PURCHASE','PASS']],['te-operations-kpis',['PRODUCTION','REQUISITION','ISSUE']],['te-logistics-kpis',['GATE_IN','DISPATCH','TRANSFER']],['te-other-kpis',['MAINTENANCE','SERVICE','WORKFORCE']]].forEach(function(row){put(row[0],row[1].map(function(k){return tile(k,true);}).join(''));});
              put('te-customers',rankedParties((data.parties||[]).filter(function(x){return x.key==='BILLING';}).sort(function(a,b){return b.amount-a.amount;}),'BILLING','PARTY'));
              put('te-suppliers',rankedParties((data.parties||[]).filter(function(x){return x.key==='PURCHASE';}).sort(function(a,b){return b.amount-a.amount;}),'PURCHASE','PARTY'));
              put('te-units',table(['Movement','Unit','Quantity'],(data.units||[]).filter(function(x){return ['GRN','PRODUCTION','ISSUE'].indexOf(x.key)>=0;}).map(function(x){return '<tr><td>'+esc(map[x.key].label)+'</td><td>'+esc(x.name)+'</td><td class="num">'+link(number(x.quantity),x.key,'ACTIVITY','UNIT',x.code)+'</td></tr>';}))+'<p class="te-note">'+link(number(metric('ISSUE_RETURN').docs)+' issue-return documents','ISSUE_RETURN')+' · '+link(number(metric('TRANSFER').docs)+' transfer orders','TRANSFER')+'</p>');
              put('te-materials',table(['Movement / material','Quantity','Value'],(data.items||[]).filter(function(x){return ['GRN','ISSUE','PRODUCTION'].indexOf(x.key)>=0;}).map(function(x){return '<tr><td>'+link(x.name,x.key,'ACTIVITY','ITEM',x.code)+'<br><small>'+esc(map[x.key].label)+'</small></td><td class="num">'+number(x.quantity)+' '+esc(x.unit)+'</td><td class="num">'+link(money(x.amount),x.key,'ACTIVITY','ITEM',x.code)+'</td></tr>';})));
              var locations={};(data.locations||[]).forEach(function(x){var k=x.code||'~';if(!locations[k])locations[k]={name:x.name,code:x.code,values:{}};locations[k].values[x.key]=x;});
              put('te-location-chart',bars((data.locations||[]).filter(function(x){return x.key==='BILLING';}).sort(function(a,b){return b.amount-a.amount;}),'BILLING','LOCATION'));
              put('te-location-mis',table(['Location','Billing','Purchase','Collection','Dispatches'],Object.values(locations).map(function(r){return '<tr><td>'+esc(r.name)+'</td>'+['BILLING','PURCHASE','COLLECTION','DISPATCH'].map(function(k){var v=r.values[k]||{amount:0,docs:0};return '<td class="num">'+link(k==='DISPATCH'?number(v.docs):money(v.amount),k,'ACTIVITY','LOCATION',r.code)+'</td>';}).join('')+'</tr>';})));
              put('te-timeline',(data.timeline||[]).length?(data.timeline||[]).map(function(r){var colors={BILLING:'#258127',PO:'#da7918',SALES_ORDER:'#914dc7',ISSUE:'#6653d0',GATE_IN:'#168d98',DISPATCH:'#168d98'},color=colors[r.key]||(tones[r.key]||['#477ce0'])[0];return '<article class="te-event" style="--te-accent:'+color+'"><time><span class="fa fa-clock-o" aria-hidden="true"></span> '+(r.recorded?'Recorded '+esc(r.recorded):'Recording time unavailable')+'</time><a class="te-event-doc" href="'+esc(r.url||'#')+'" title="Open '+esc(transactionLabels[r.key]||map[r.key].label)+' in its 360 view">'+esc(r.doc||'Document number missing')+'</a><div class="te-event-meta"><button type="button" class="te-event-type" title="View this transaction’s source records here"'+attrs(r.key,'ACTIVITY',null,null,r.id)+'><span class="fa '+(tones[r.key]||['','fa-file-text-o'])[1]+'" aria-hidden="true"></span>'+esc(transactionLabels[r.key]||map[r.key].label)+'</button><span class="te-event-dated">· dated '+esc(r.dated)+'</span>'+(r.amount!=null?'<span class="te-event-amount">'+esc(money(r.amount))+'</span>':'')+'</div></article>';}).join(''):empty());
              renderCharts(data);
              document.getElementById('te-asof').textContent='Updated '+data.asof;
             }
             function renderPositions(data){positions=data;var ledger=data.ledger||[],funds=ledger.filter(function(x){return x.kind==='FUNDS';});var totals={opening:0,inflow:0,outflow:0,closing:0};funds.forEach(function(x){Object.keys(totals).forEach(function(k){totals[k]+=Number(x[k])||0;});});
              put('te-funds',[['Opening funds · today','opening','FUNDS_OPEN'],['+ Ledger inflows · today','inflow','FUNDS_IN'],['− Ledger outflows · today','outflow','FUNDS_OUT'],['Current book funds','closing','FUNDS']].map(function(x){return '<button type="button"'+attrs(x[2],'LEDGER')+'><small>'+esc(x[0])+'</small><strong>'+esc(money(totals[x[1]]))+'</strong><small>View supporting postings ↗</small></button>';}).join(''));
              put('te-bank',table(['Cash / bank account','Book balance'],funds.sort(function(a,b){return b.closing-a.closing;}).map(function(x){return '<tr><td>'+link(x.name,'FUNDS','LEDGER','ACCOUNT',x.code)+'</td><td class="num">'+link(money(x.closing),'FUNDS','LEDGER','ACCOUNT',x.code)+'</td></tr>';})));
              var ar=ledger.filter(function(x){return x.kind==='AR';}).reduce(function(s,x){return s+(x.closing||0);},0),ap=ledger.filter(function(x){return x.kind==='AP';}).reduce(function(s,x){return s+(x.closing||0);},0),stock=data.stock||{};
              put('te-position',table(['Position','Amount / count'],[['Customer ledger · net',money(ar),'AR','LEDGER'],['Supplier ledger · net',money(ap),'AP','LEDGER'],['Rated stock on hand',money(stock.value),'STOCK','STOCK'],['Negative stock layers',number(stock.negative_layers),'NEGATIVE_STOCK','STOCK'],['Unpriced stock layers',number(stock.unpriced_layers),'UNPRICED_STOCK','STOCK']].map(function(x){return '<tr><td>'+esc(x[0])+'</td><td class="num">'+link(x[1],x[2],x[3])+'</td></tr>';}))+'<p class="te-note">Click an amount or count to open its ledger or stock records. Stock without a rate is shown separately.</p>');
              var counts={};(data.alerts||[]).forEach(function(x){counts[x.key]=x;});
              put('te-alerts',table(['Control / current scope','Owner','Priority','Documents','Value','Oldest'],alerts.filter(function(a){return a.key!=='APPROVAL';}).map(function(a){var d=counts[a.key]||{docs:0,amount:0};return '<tr class="te-alert-row"><td><strong>'+link(a.label,a.key,'ALERT')+'</strong><small>'+esc(a.note)+'</small></td><td>'+esc(a.owner)+'</td><td><span class="te-severity '+esc(a.severity)+'">'+esc(a.severity)+'</span></td><td class="num">'+link(number(d.docs),a.key,'ALERT')+'</td><td class="num">'+(d.amount==null?'—':link(money(d.amount),a.key,'ALERT'))+'</td><td class="num">'+(d.oldest_hours==null?'—':link(number(d.oldest_hours/24)+' days',a.key,'ALERT'))+'</td></tr>';})));
              var approval=counts.APPROVAL||{docs:0,amount:0};put('te-approvals','<div class="te-heading"><h2>'+link(number(approval.docs)+' waiting work items','APPROVAL','ALERT')+'</h2><span>'+link(money(approval.amount),'APPROVAL','ALERT')+'</span></div><div class="te-age">'+[['<2 hours','under2','UNDER2'],['2–8 hours','h2_8','H2_8'],['8–24 hours','h8_24','H8_24'],['>24 hours','over24','OVER24']].map(function(x){return '<button type="button"'+attrs('APPROVAL','ALERT','AGE',x[2])+'><span>'+esc(x[0])+'</span><strong>'+number(approval[x[1]])+'</strong></button>';}).join('')+'</div><p class="te-note">Click a count to view your pending approvals by age. This dashboard does not approve or reject documents.</p>');
              var flags=(data.alerts||[]).filter(function(a){return a.key!=='APPROVAL';}).reduce(function(s,a){return s+a.docs;},0);document.getElementById('te-attention-count').textContent=number(flags);
              var insights=[];['GATE_UNBILLED','BILL_UNPASSED','PO_OVERDUE'].forEach(function(k){var d=counts[k];if(d&&d.docs)insights.push('<p>'+link(number(d.docs)+' '+alerts.find(function(a){return a.key===k;}).label.toLowerCase()+(d.amount!=null?' · '+money(d.amount):''),k,'ALERT')+'</p>');});
              put('te-insights',insights.length?insights.join('')+'<p class="te-note">Click an item above to view the documents that need checking.</p>':empty('No flags in the displayed purchase and dispatch controls.'));
              renderControlChart(data);
              document.getElementById('te-finance-loading').textContent='Position snapshot: '+data.asof+' IST';
             }
             function scopeText(){return val('FROMDATE')+' to '+val('TODATE')+' · '+(apex.item('P739_COMPANY').displayValueFor(val('COMPANY'))||'All companies')+' · '+(apex.item('P739_LOCATION').displayValueFor(val('LOCATION'))||'All locations')+' · Panel '+(val('PANEL')||'permitted scope');}
             function items(){return ['FROMDATE','TODATE','COMPANY','LOCATION','PANEL'].map(function(k){return '#P739_'+k;}).join(',');}
             function scopeKey(){return JSON.stringify(['FROMDATE','TODATE','COMPANY','LOCATION','PANEL'].map(val));}
             function validRange(){function date(s){var m=/^(\d{2})-(\d{2})-(\d{4})$/.exec(s);if(!m)return NaN;var d=new Date(+m[3],+m[2]-1,+m[1],12);return fmt(d)===s?d.getTime():NaN;}var f=date(val('FROMDATE')),t=date(val('TODATE')),days=(t-f)/86400000;return Number.isFinite(days)&&days>=0&&days<=30;}
             function lockScope(lock){root.querySelectorAll('.te-periods button,#te-refresh,#teFilters input,#teFilters select,#teFilters button').forEach(function(b){b.disabled=lock;});}
             async function load(){if(busy)return;apex.message.clearErrors();if(!validRange()){usable=false;document.getElementById('te-status').textContent='Choose valid From and To dates, in order, covering no more than 31 days. Displayed data has not been refreshed.';apex.message.showErrors([{type:'error',location:'page',message:'Choose a valid activity period of up to 31 days.',unsafe:false}]);return;}busy=true;usable=false;appliedScope=scopeKey();lockScope(true);document.getElementById('te-status').textContent='Refreshing source activity…';document.getElementById('te-scope').textContent=scopeText();document.getElementById('te-day').textContent=val('FROMDATE')===val('TODATE')?val('FROMDATE'):val('FROMDATE')+' — '+val('TODATE');clearSelection();
              try{var a=await apex.server.process('TODAY_ACTIVITY',{pageItems:items()},{dataType:'json'});renderActivity(a);document.getElementById('te-status').textContent='Activity ready. Refreshing current positions and control checks…';var p=await apex.server.process('TODAY_POSITIONS',{pageItems:items()},{dataType:'json'});renderPositions(p);document.getElementById('te-status').textContent='Up to date. Click a card or chart to view records below. Transaction numbers open their 360.';}
              catch(error){document.getElementById('te-status').textContent='Refresh did not finish. Please retry; previously loaded values may be stale.';document.getElementById('te-finance-loading').textContent='Refresh incomplete — retry before relying on positions.';apex.message.showErrors([{type:'error',location:'page',message:'Could not refresh the complete Today dashboard. Please retry.',unsafe:false}]);}
              finally{busy=false;usable=document.getElementById('te-status').textContent.indexOf('Up to date.')===0;lockScope(false);}
             }
             function clearSelection(){['ACTIVITY','LEDGER','ALERT','STOCK'].forEach(function(k){var r=document.getElementById('teEvidence'+k);if(r)r.classList.remove('is-visible');});document.getElementById('te-selection').classList.remove('is-visible');set('METRIC','');set('DOC','');set('DIMTYPE','');set('DIMVALUE','');}
             function drill(button){if(busy)return;if(!usable||scopeKey()!==appliedScope){document.getElementById('te-status').textContent='Apply your changed filters or refresh before opening source records.';document.getElementById('teFilters').classList.remove('te-hidden-filters');document.getElementById('teFilters').scrollIntoView({behavior:'smooth',block:'center'});return;}var key=button.getAttribute('data-metric'),kind=button.getAttribute('data-kind')||'ACTIVITY',id='teEvidence'+kind;clearSelection();set('METRIC',key);set('MODE',kind);set('DIMTYPE',button.getAttribute('data-dimtype'));set('DIMVALUE',button.getAttribute('data-dimvalue'));set('DOC',button.getAttribute('data-doc'));
              var title=map[key]?map[key].label:(alerts.find(function(x){return x.key===key;})||{}).label||key.replace(/_/g,' ');document.getElementById('te-selection-title').textContent=title+(val('DIMVALUE')?' · '+(val('DIMTYPE')==='DAY'?val('DIMVALUE'):(button.getAttribute('data-label')||button.textContent.trim())):'');document.getElementById('te-selection-scope').textContent=(kind==='ACTIVITY'?(val('DIMTYPE')==='DAY'?'Chart day '+val('DIMVALUE')+' · '+scopeText().split(' · ').slice(1).join(' · '):scopeText()):'Current position / control scope · '+scopeText().split(' · ').slice(1).join(' · '));document.getElementById('te-selection').classList.add('is-visible');var region=document.getElementById(id);region.classList.add('is-visible');$(region).one('apexafterrefresh.teDrill',function(){document.getElementById('te-selection').scrollIntoView({behavior:'smooth',block:'start'});});apex.region(id).refresh();
             }
             function indianToday(){var parts=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Kolkata',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date()),p={};parts.forEach(function(x){p[x.type]=x.value;});return new Date(Number(p.year),Number(p.month)-1,Number(p.day),12);}
             function fmt(d){return ('0'+d.getDate()).slice(-2)+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+d.getFullYear();}
             root.addEventListener('click',function(e){var b=e.target.closest('[data-metric]');if(b){drill(b);return;}var period=e.target.closest('[data-period]');if(period&&!busy){var end=indianToday(),start=new Date(end),k=period.getAttribute('data-period');if(k==='YESTERDAY'){start.setDate(start.getDate()-1);end=new Date(start);}if(k==='7D')start.setDate(start.getDate()-6);if(k==='MTD')start.setDate(1);set('FROMDATE',fmt(start));set('TODATE',fmt(end));root.querySelectorAll('[data-period]').forEach(function(x){x.classList.toggle('is-active',x===period);});load();}if(e.target.closest('#te-refresh'))load();if(e.target.closest('#te-clear-selection'))clearSelection();if(e.target.closest('#te-attention-card'))document.getElementById('te-attention-section').scrollIntoView({behavior:'smooth'});if(e.target.closest('#te-filter-toggle'))document.getElementById('teFilters').classList.toggle('te-hidden-filters');});
             $(document).on('click.teApply','#teApply',function(e){e.preventDefault();load();});
             $('#P739_CHART_PICK').on('change.teChart',function(){try{var action=JSON.parse(this.value),b=document.createElement('button');b.setAttribute('data-metric',action.key);b.setAttribute('data-kind',action.kind||'ACTIVITY');if(action.dimtype){b.setAttribute('data-dimtype',action.dimtype);b.setAttribute('data-dimvalue',action.dimvalue);}b.textContent=action.label||'';drill(b);}catch(ignore){document.getElementById('te-status').textContent='Could not open chart selection. Please refresh and retry.';}});
             $(document).on('click.teReset','#teReset',function(e){e.preventDefault();if(busy)return;set('COMPANY','');set('LOCATION','');set('PANEL','');set('FROMDATE',fmt(indianToday()));set('TODATE',fmt(indianToday()));root.querySelectorAll('[data-period]').forEach(function(x){x.classList.toggle('is-active',x.getAttribute('data-period')==='TODAY');});load();});
             root.addEventListener('keydown',function(e){var b=e.target.closest('svg [data-metric]');if(b&&(e.key==='Enter'||e.key===' ')){e.preventDefault();drill(b);}});
             // Changing company must not leave a location from the previous company.
             $('#P739_COMPANY').on('change.teCompany',function(){set('LOCATION','');});
             load();
            }());
            
