    region teEvidenceSTOCK (
        name: Stock layer register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with N as (select cast(systimestamp at time zone 'Asia/Kolkata' as date) asof,trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today, (select FinancialYearBegin from FinancialYear where trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) between FinancialYearBegin and FinancialYearEnd fetch first 1 row only) fy, (select GetUserPanelAB_apex() from dual) enforced from dual), U as (select u.StockTNo,sum(u.UsedStockQuantity1) used from UsedStock u cross join N n where u.UsedStockDate<=n.asof group by u.StockTNo), S as (select s.TNo,s.StockDate,s.CompanyCode,s.LocationCode,s.ItemCode,s.ItemSpecificationCode,s.StorageLocationCode, s.StockQuantity1-nvl(u.used,0) qty,s.Rate,(s.StockQuantity1-nvl(u.used,0))*s.Rate amount from Stock s left join U u on u.StockTNo=s.TNo cross join N n where s.StockDate>=n.fy and s.StockDate<=n.asof and (:P739_COMPANY is null or s.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or s.LocationCode=:P739_LOCATION) and (n.enforced is null or s.Panel=n.enforced) and (:P739_PANEL is null or s.Panel=:P739_PANEL)) select s.TNo STOCK_LAYER,s.StockDate STOCK_DATE,c.CompanyName COMPANY,l.LocationName LOCATION, i.ItemName ITEM,nvl((select x.ItemSpecificationName from ItemSpecification x where x.ItemSpecificationCode=s.ItemSpecificationCode),s.ItemSpecificationCode) SPECIFICATION, nvl((select x.StorageLocationName from StorageLocation x where x.StorageLocationCode=s.StorageLocationCode),s.StorageLocationCode) STORAGE_LOCATION,s.qty QUANTITY, mu.MeasuringUnitName UNIT,s.Rate RATE,s.amount AMOUNT,'<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>679,p_clear_cache=>'679',p_items=>'P679_ITEMCODE,P679_FROMDATE,P679_TODATE,P679_COMPANY,P679_LOCATION,P679_PANEL',p_values=>s.ItemCode||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL))||'">Item 360</a> ' RELATED_360 from S s left join Company c on c.CompanyCode=s.CompanyCode left join Location l on l.LocationCode=s.LocationCode left join Item i on i.ItemCode=s.ItemCode left join MeasuringUnit mu on mu.MeasuringUnitCode=i.MeasuringUnitCode1 where abs(s.qty)>.000001 and (:P739_METRIC='STOCK' or (:P739_METRIC='NEGATIVE_STOCK' and s.qty<0) or (:P739_METRIC='UNPRICED_STOCK' and s.Rate is null))
            pageItemsToSubmit: [
                P739_FROMDATE
                P739_TODATE
                P739_COMPANY
                P739_LOCATION
                P739_PANEL
                P739_METRIC
                P739_MODE
                P739_DIMTYPE
                P739_DIMVALUE
                P739_DOC
            ]
        }
        layout {
            sequence: 33
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: te-evidence
        }
        advanced {
            htmlDomId: teEvidenceSTOCK
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No records match this selection and report filters.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 900739083100068
        }

