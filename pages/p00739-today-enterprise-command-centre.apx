    region teEvidenceLEDGER (
        name: Ledger posting register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with N as (select cast(systimestamp at time zone 'Asia/Kolkata' as date) asof,trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today, (select FinancialYearBegin from FinancialYear where trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) between FinancialYearBegin and FinancialYearEnd fetch first 1 row only) fy, (select GetUserPanelAB_apex() from dual) enforced from dual), Accounts as ( select PartyCode account_code,'FUNDS' kind from Party where PartyTypeCode in ('CASH','BANK') union all select PartyCode,'AR' from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode union all select PartyCode,'AP' from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode), LL as ( select a.kind,o.AccountCode account_code,o.TNo doc_id,cast(null as number) line_no,'Opening balance' doc_no,o.OpeningDate entry_date, o.CompanyCode company_code,o.LocationCode location_code,o.OpeningAmount signed_amount,'FY carry forward' note from Opening o join Accounts a on a.account_code=o.AccountCode cross join N n where o.OpeningDate=n.fy and (n.enforced is null or n.enforced='A') and (:P739_PANEL is null or :P739_PANEL='A') and (:P739_COMPANY is null or o.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or o.LocationCode=:P739_LOCATION) union all select a.kind,d.AccountCode,d.TNo,d.SNo,v.VoucherNo,d.VoucherDate,d.CompanyCode,d.LocationCode,d.Amount,substr(d.Narration,1,400) from VoucherDetail d join Voucher v on v.TNo=d.TNo join Accounts a on a.account_code=d.AccountCode cross join N n where d.VoucherDate>=n.fy and d.VoucherDate<=n.asof and nvl(v.VoucherNo,'~')<>'OPENING' and (:P739_COMPANY is null or d.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or d.LocationCode=:P739_LOCATION) and (n.enforced is null or d.Panel=n.enforced) and (:P739_PANEL is null or d.Panel=:P739_PANEL) ), LB as (select kind,account_code, sum(case when entry_date<n.today then signed_amount else 0 end) opening_signed, sum(case when entry_date>=n.today and signed_amount<0 then -signed_amount else 0 end) debit_today, sum(case when entry_date>=n.today and signed_amount>0 then signed_amount else 0 end) credit_today, sum(signed_amount) closing_signed from LL cross join N n group by kind,account_code) select kind ACCOUNT_GROUP,account_code ACCOUNT_CODE, nvl((select PartyName from Party p where p.PartyCode=LL.account_code),account_code) ACCOUNT, doc_id DOCUMENT_ID,line_no LINE_NO,doc_no DOCUMENT_NO,entry_date POSTING_DATE, (select CompanyName from Company c where c.CompanyCode=LL.company_code) COMPANY, (select LocationName from Location l where l.LocationCode=LL.location_code) LOCATION, case when kind='AP' or :P739_METRIC='FUNDS_OUT' then signed_amount else -signed_amount end AMOUNT,note NOTES,case when line_no is not null then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>doc_id))||'">Voucher 360</a> ' end RELATED_360 from LL cross join N n where :P739_METRIC in ('FUNDS','FUNDS_OPEN','FUNDS_IN','FUNDS_OUT','AR','AP') and kind=case when :P739_METRIC like 'FUNDS%' then 'FUNDS' else :P739_METRIC end and (:P739_DIMVALUE is null or account_code=:P739_DIMVALUE) and (:P739_METRIC<>'FUNDS_OPEN' or entry_date<n.today) and (:P739_METRIC<>'FUNDS_IN' or (entry_date>=n.today and signed_amount<0)) and (:P739_METRIC<>'FUNDS_OUT' or (entry_date>=n.today and signed_amount>0))
            pageItemsToSubmit: [
                P739_FROMDATE
                P739_TODATE
                P739_COMPANY
                P739_LOCATION
                P739_PANEL
                P739_METRIC
                P739_MODE
                P739_DIMTYPE
                P739_DIMVALUE
                P739_DOC
            ]
        }
