    process establish-server-visibility (
        name: Establish server visibility
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin if GetApexReportPrivilege('1','49',:APP_USER) then :P739_ALLOW_HR:='Y';else :P739_ALLOW_HR:='N';end if;
                if GetApexReportPrivilege('1','252',:APP_USER) then :P739_ALLOW_MAINT:='Y';else :P739_ALLOW_MAINT:='N';end if; end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900739083100016
        }
    )

    process today-activity (
        name: TODAY_ACTIVITY
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare v clob; a clob;begin if to_date(:P739_TODATE,'DD-MM-RRRR')<to_date(:P739_FROMDATE,'DD-MM-RRRR') or to_date(:P739_TODATE,'DD-MM-RRRR')-to_date(:P739_FROMDATE,'DD-MM-RRRR')>30 or :P739_FROMDATE is null or :P739_TODATE is null then raise_application_error(-20001,'Choose a valid period of up to 31 days.');end if; if GetApexReportPrivilege('1','49',:APP_USER) then :P739_ALLOW_HR:='Y';else :P739_ALLOW_HR:='N';end if;
                if GetApexReportPrivilege('1','252',:APP_USER) then :P739_ALLOW_MAINT:='Y';else :P739_ALLOW_MAINT:='N';end if;
                select payload into a from (with B as (select to_date(:P739_FROMDATE,'DD-MM-RRRR') f,to_date(:P739_TODATE,'DD-MM-RRRR')+1 t,
                    (select GetUserPanelAB_apex() from dual) enforced from dual), E as (select 'BILLING' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.CCInvoiceNo as varchar2(400)) doc_no,h.CCInvoiceDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Taxable invoice line value; excludes footer taxes.' note
                      from CCInvoice h join CCInvoiceDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.CCInvoiceDate >= least(b.f-(b.t-b.f),b.t-7) and h.CCInvoiceDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'SALES_ORDER' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.SalesOrderNo as varchar2(400)) doc_no,h.SalesOrderDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Order line amounts, before footer charges.' note
                      from SalesOrder h join SalesOrderDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.SalesOrderDate >= least(b.f-(b.t-b.f),b.t-7) and h.SalesOrderDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'PO' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.PurchaseOrderNo as varchar2(400)) doc_no,h.PurchaseOrderDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Purchase order line amounts, before footer charges.' note
                      from PurchaseOrder h join PurchaseOrderDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.PurchaseOrderDate >= least(b.f-(b.t-b.f),b.t-7) and h.PurchaseOrderDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'PURCHASE' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.PurchaseBillNo as varchar2(400)) doc_no,h.PurchaseBillDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Purchase bill line value; excludes footer charges.' note
                      from PurchaseBill h join PurchaseBillDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.PurchaseBillDate >= least(b.f-(b.t-b.f),b.t-7) and h.PurchaseBillDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'GRN' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.GrnNo as varchar2(400)) doc_no,h.GrnDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.ReceivedQuantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Stored GRN line amounts; quantity is reported by unit.' note
                      from Grn h join GrnDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.GrnDate >= least(b.f-(b.t-b.f),b.t-7) and h.GrnDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'PRODUCTION' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.ProductionNo as varchar2(400)) doc_no,h.ProductionDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      cast(null as varchar2(400)) party_code,d.ItemCode item_code,d.StockValue amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Production documents with finished-output lines; quantities below by unit.' note
                      from Production h join ProductionFinished d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.ProductionDate >= least(b.f-(b.t-b.f),b.t-7) and h.ProductionDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'ISSUE' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.IssueNo as varchar2(400)) doc_no,h.IssueDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      cast(null as varchar2(400)) party_code,d.ItemCode item_code,(select sum(u.UsedStockQuantity1*s.Rate) from UsedStock u join Stock s on s.TNo=u.StockTNo where u.ModuleCode='ISSUE' and u.ModuleTNo=h.TNo and u.ModuleSNo=d.SNo) amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Issued stock quantity × source layer rate, reconciled with Issue Register; gross issue value before returns.' note
                      from Issue h join IssueDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.IssueDate >= least(b.f-(b.t-b.f),b.t-7) and h.IssueDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'REQUISITION' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.RequisitionNo as varchar2(400)) doc_no,h.RequisitionDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,h.ItemCode item_code,cast(null as number) amount,cast(null as number) quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Requisition documents dated in the selected period.' note
                      from Requisition h 
                      left join Item i on i.ItemCode=h.ItemCode cross join B b
                      where h.RequisitionDate >= least(b.f-(b.t-b.f),b.t-7) and h.RequisitionDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'PASS' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.PBPassNo as varchar2(400)) doc_no,h.PBPassDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      (select x.PartyCode from PurchaseBill x where x.TNo=h.PurchaseBillTNo) party_code,cast(null as varchar2(400)) item_code,h.PBPassAmount amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Purchase bill: '||(select x.PurchaseBillNo from PurchaseBill x where x.TNo=h.PurchaseBillTNo) note
                      from PBPass h 
                       cross join B b
                      where h.PBPassDate >= least(b.f-(b.t-b.f),b.t-7) and h.PBPassDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'DISPATCH' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateOutTime event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Vehicle: '||h.VehicleNo||'; gate in: '||to_char(h.GateInTime,'DD-Mon-YYYY HH24:MI') note
                      from MaterialOut h 
                       cross join B b
                      where h.GateOutTime >= least(b.f-(b.t-b.f),b.t-7) and h.GateOutTime<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'GATE_IN' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Vehicle: '||h.VehicleNo||'; source reference: '||h.RefDocNo note
                      from MaterialIn h 
                       cross join B b
                      where h.GateInTime >= least(b.f-(b.t-b.f),b.t-7) and h.GateInTime<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'SERVICE' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.ServiceBillNo as varchar2(400)) doc_no,h.ServiceBillDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,h.ItemCode item_code,h.ServiceBillAmount amount,cast(null as number) quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Gross service bill amount, shown separately from material billing.' note
                      from ServiceBill h 
                      left join Item i on i.ItemCode=h.ItemCode cross join B b
                      where h.ServiceBillDate >= least(b.f-(b.t-b.f),b.t-7) and h.ServiceBillDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'TRANSFER' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.InterUnitTransferNo as varchar2(400)) doc_no,h.InterUnitTransferDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Transfer order only; destination: '||h.ToLocationCode note
                      from InterUnitTransfer h 
                       cross join B b
                      where h.InterUnitTransferDate >= least(b.f-(b.t-b.f),b.t-7) and h.InterUnitTransferDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'ISSUE_RETURN' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.IssueReturnNo as varchar2(400)) doc_no,h.IssueReturnDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Recorded issue-return documents.' note
                      from IssueReturn h 
                       cross join B b
                      where h.IssueReturnDate >= least(b.f-(b.t-b.f),b.t-7) and h.IssueReturnDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL)
                
                
                union all
                select 'MAINTENANCE' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.MaintenanceRequestNo as varchar2(400)) doc_no,h.MaintenanceRequestDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,cast(null as varchar2(10)) panel,
                      cast(null as varchar2(400)) party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,substr('Equipment: '||(select e.EquipmentName from Equipment e where e.TNo=h.EquipmentTNo)||'; '||h.NotificationShortText||'; responsible: '||h.PersonResponsible,1,400) note
                      from MaintenanceRequest h 
                       cross join B b
                      where h.MaintenanceRequestDate >= least(b.f-(b.t-b.f),b.t-7) and h.MaintenanceRequestDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and :P739_ALLOW_MAINT='Y'
                
                
                union all
                select 'WORKFORCE' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.AttendencePeriodicalNo as varchar2(400)) doc_no,h.AttendencePeriodicalDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,cast(null as varchar2(10)) panel,
                      cast(null as varchar2(400)) party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Employee: '||h.EmployeeCode||'; attendance period: '||to_char(h.FromDate,'DD-Mon-YYYY')||' to '||to_char(h.ToDate,'DD-Mon-YYYY')||'; not a daily attendance count' note
                      from AttendencePeriodical h 
                       cross join B b
                      where h.AttendencePeriodicalDate >= least(b.f-(b.t-b.f),b.t-7) and h.AttendencePeriodicalDate<b.t
                      and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                      and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                      and :P739_ALLOW_HR='Y'
                
                
                union all
                select 'COLLECTION',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime,
                      d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),1*d.Amount,cast(null as number),cast(null as varchar2(400)),v.Creator,
                      cast(substr(d.Narration,1,400) as varchar2(400))
                      from VoucherDetail d join Voucher v on v.TNo=d.TNo cross join B b
                      where d.VoucherDate>=least(b.f-(b.t-b.f),b.t-7) and d.VoucherDate<b.t and v.DocTypeCode in ('RECEIPT')
                      and 1*d.Amount>0 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode)
                      and (:P739_COMPANY is null or d.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or d.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or d.Panel=b.enforced) and (:P739_PANEL is null or d.Panel=:P739_PANEL)
                
                union all
                select 'PAYMENT',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime,
                      d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),-1*d.Amount,cast(null as number),cast(null as varchar2(400)),v.Creator,
                      cast(substr(d.Narration,1,400) as varchar2(400))
                      from VoucherDetail d join Voucher v on v.TNo=d.TNo cross join B b
                      where d.VoucherDate>=least(b.f-(b.t-b.f),b.t-7) and d.VoucherDate<b.t and v.DocTypeCode in ('PAYMENT','CASHPAYMENT','BANKPAYMENT')
                      and -1*d.Amount>0 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode)
                      and (:P739_COMPANY is null or d.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or d.LocationCode=:P739_LOCATION)
                      and (b.enforced is null or d.Panel=b.enforced) and (:P739_PANEL is null or d.Panel=:P739_PANEL)
                      ), M as (select metric,
                 count(distinct case when event_date>=b.f then doc_id end) docs,
                 sum(case when event_date>=b.f then amount end) amount,
                 count(distinct case when event_date<b.f and event_date>=b.f-(b.t-b.f) then doc_id end) prior_docs,
                 sum(case when event_date<b.f and event_date>=b.f-(b.t-b.f) then amount end) prior_amount from E cross join B b group by metric),
                 C as (select /*+ materialize */ e.* from E e cross join B b where e.event_date>=b.f),
                 L as (select metric,location_code,count(distinct doc_id) docs,sum(amount) amount from C group by metric,location_code),
                 P as (select metric,party_code,count(distinct doc_id) docs,sum(amount) amount,count(*) over(partition by metric) party_count,
                 row_number() over(partition by metric order by sum(amount) desc nulls last) rn from C where party_code is not null group by metric,party_code),
                 PT as (select e.metric,e.party_code,trunc(e.event_date) day,sum(e.amount) amount
                 from E e cross join B b where e.event_date>=b.t-7 and e.metric in ('BILLING','PURCHASE')
                 and exists(select 1 from P p where p.metric=e.metric and p.party_code=e.party_code and p.rn<=10)
                 group by e.metric,e.party_code,trunc(e.event_date)),
                 U as (select metric,unit_code,sum(quantity) quantity,count(distinct doc_id) docs from C where quantity is not null group by metric,unit_code),
                 I as (select metric,item_code,unit_code,sum(quantity) quantity,sum(amount) amount,
                 row_number() over(partition by metric order by sum(abs(amount)) desc nulls last) rn from C where item_code is not null group by metric,item_code,unit_code),
                 D as (select metric,trunc(event_date) day,sum(amount) amount,count(distinct doc_id) docs from E cross join B b where event_date>=b.t-7 and metric in ('BILLING','PURCHASE') group by metric,trunc(event_date)),
                 T as (select metric,doc_id,doc_no,max(logged_at) logged_at,max(event_date) event_date,sum(amount) amount,
                 row_number() over(order by max(logged_at) desc nulls last,doc_id desc) rn from C group by metric,doc_id,doc_no)
                 select json_object(
                 'asof' value to_char(systimestamp at time zone 'Asia/Kolkata','DD Mon YYYY HH24:MI:SS'),
                 'trend' value (select json_arrayagg(json_object('key' value metric,'day' value to_char(day,'YYYY-MM-DD'),'amount' value amount,'docs' value docs) order by day returning clob) from D) format json,
                 'party_trends' value (select json_arrayagg(json_object('key' value metric,'code' value party_code,'day' value to_char(day,'YYYY-MM-DD'),'amount' value amount) order by party_code,day returning clob) from PT) format json,
                 'metrics' value (select json_arrayagg(json_object('key' value metric,'docs' value docs,'amount' value amount,'prior_docs' value prior_docs,'prior_amount' value prior_amount) returning clob) from M) format json,
                 'locations' value (select json_arrayagg(json_object('key' value metric,'code' value location_code,'name' value nvl((select LocationName from Location x where x.LocationCode=L.location_code),'Unassigned'),'docs' value docs,'amount' value amount) returning clob) from L) format json,
                 'parties' value (select json_arrayagg(json_object('key' value metric,'code' value party_code,'name' value nvl((select PartyName from Party x where x.PartyCode=P.party_code),party_code),'docs' value docs,'amount' value amount,'party_count' value party_count) returning clob) from P where rn<=10) format json,
                 'units' value (select json_arrayagg(json_object('key' value metric,'code' value unit_code,'name' value nvl((select MeasuringUnitName from MeasuringUnit x where x.MeasuringUnitCode=U.unit_code),'Unit not recorded'),'quantity' value quantity,'docs' value docs) returning clob) from U) format json,
                 'items' value (select json_arrayagg(json_object('key' value metric,'code' value item_code,'name' value nvl((select ItemName from Item x where x.ItemCode=I.item_code),item_code),'unit' value nvl((select MeasuringUnitName from MeasuringUnit x where x.MeasuringUnitCode=I.unit_code),'Unspecified'),'quantity' value quantity,'amount' value amount) returning clob) from I where rn<=6) format json,
                 'timeline' value (select json_arrayagg(json_object('key' value metric,'id' value doc_id,'doc' value doc_no,'url' value case metric when 'BILLING' then apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>doc_id) when 'PURCHASE' then apex_page.get_url(p_page=>680,p_clear_cache=>'680',p_items=>'P680_TNO',p_values=>doc_id) when 'PO' then apex_page.get_url(p_page=>682,p_clear_cache=>'682',p_items=>'P682_TNO,P682_FROMDATE,P682_TODATE,P682_COMPANY,P682_LOCATION',p_values=>doc_id||','||:P739_FROMDATE||','||:P739_TODATE||','||:P739_COMPANY||','||:P739_LOCATION) when 'SALES_ORDER' then apex_page.get_url(p_page=>734,p_clear_cache=>'734',p_items=>'P734_SOTNO,P734_FROMDATE,P734_TODATE,P734_COMPANY,P734_LOCATION,P734_PANEL',p_values=>doc_id||','||:P739_FROMDATE||','||:P739_TODATE||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL) when 'REQUISITION' then apex_page.get_url(p_page=>687,p_clear_cache=>'687',p_items=>'P687_REQTNO,P687_FROMDATE,P687_TODATE,P687_COMPANY,P687_LOCATION',p_values=>doc_id||','||:P739_FROMDATE||','||:P739_TODATE||','||:P739_COMPANY||','||:P739_LOCATION) when 'ISSUE' then apex_page.get_url(p_page=>686,p_clear_cache=>'686',p_items=>'P686_ISSUETNO,P686_FROMDATE,P686_TODATE,P686_COMPANY,P686_LOCATION,P686_PANEL',p_values=>doc_id||','||:P739_FROMDATE||','||:P739_TODATE||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL) when 'COLLECTION' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>doc_id) when 'PAYMENT' then apex_page.get_url(p_page=>678,p_clear_cache=>'678',p_items=>'P678_TNO',p_values=>doc_id) else apex_page.get_url(p_page=>740,p_clear_cache=>'740',p_items=>'P740_METRIC,P740_DOC,P740_FROMDATE,P740_TODATE,P740_COMPANY,P740_LOCATION,P740_PANEL',p_values=>metric||','||doc_id||','||:P739_FROMDATE||','||:P739_TODATE||','||:P739_COMPANY||','||:P739_LOCATION||','||:P739_PANEL) end,'recorded' value to_char(logged_at,'DD Mon HH24:MI'),'dated' value to_char(event_date,'DD Mon YYYY'),'amount' value amount) order by rn returning clob) from T where rn<=15) format json
                 returning clob) payload from dual);
                select json_mergepatch(a,json_object('allowHR' value (case :P739_ALLOW_HR when 'Y' then 'true' else 'false' end) format json,'allowMaint' value (case :P739_ALLOW_MAINT when 'Y' then 'true' else 'false' end) format json) returning clob) into v from dual;
                for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop; end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 900739083100017
        }
    )

    process today-positions (
        name: TODAY_POSITIONS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare v clob;l clob;a clob;s clob;begin if to_date(:P739_TODATE,'DD-MM-RRRR')<to_date(:P739_FROMDATE,'DD-MM-RRRR') or to_date(:P739_TODATE,'DD-MM-RRRR')-to_date(:P739_FROMDATE,'DD-MM-RRRR')>30 or :P739_FROMDATE is null or :P739_TODATE is null then raise_application_error(-20001,'Choose a valid period of up to 31 days.');end if; if GetApexReportPrivilege('1','49',:APP_USER) then :P739_ALLOW_HR:='Y';else :P739_ALLOW_HR:='N';end if;
                if GetApexReportPrivilege('1','252',:APP_USER) then :P739_ALLOW_MAINT:='Y';else :P739_ALLOW_MAINT:='N';end if;
                select payload into l from (with N as (select cast(systimestamp at time zone 'Asia/Kolkata' as date) asof,trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,
                 (select FinancialYearBegin from FinancialYear where trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) between FinancialYearBegin and FinancialYearEnd fetch first 1 row only) fy,
                 (select GetUserPanelAB_apex() from dual) enforced from dual), Accounts as (
                 select PartyCode account_code,'FUNDS' kind from Party where PartyTypeCode in ('CASH','BANK')
                 union all select PartyCode,'AR' from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode
                 union all select PartyCode,'AP' from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode),
                 LL as (
                 select a.kind,o.AccountCode account_code,o.TNo doc_id,cast(null as number) line_no,'Opening balance' doc_no,o.OpeningDate entry_date,
                 o.CompanyCode company_code,o.LocationCode location_code,o.OpeningAmount signed_amount,'FY carry forward' note
                 from Opening o join Accounts a on a.account_code=o.AccountCode cross join N n
                 where o.OpeningDate=n.fy and (n.enforced is null or n.enforced='A') and (:P739_PANEL is null or :P739_PANEL='A') and (:P739_COMPANY is null or o.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or o.LocationCode=:P739_LOCATION)
                
                 union all
                 select a.kind,d.AccountCode,d.TNo,d.SNo,v.VoucherNo,d.VoucherDate,d.CompanyCode,d.LocationCode,d.Amount,substr(d.Narration,1,400)
                 from VoucherDetail d join Voucher v on v.TNo=d.TNo join Accounts a on a.account_code=d.AccountCode cross join N n
                 where d.VoucherDate>=n.fy and d.VoucherDate<=n.asof and nvl(v.VoucherNo,'~')<>'OPENING' and (:P739_COMPANY is null or d.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or d.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or d.Panel=n.enforced) and (:P739_PANEL is null or d.Panel=:P739_PANEL)
                 ), LB as (select kind,account_code,
                 sum(case when entry_date<n.today then signed_amount else 0 end) opening_signed,
                 sum(case when entry_date>=n.today and signed_amount<0 then -signed_amount else 0 end) debit_today,
                 sum(case when entry_date>=n.today and signed_amount>0 then signed_amount else 0 end) credit_today,
                 sum(signed_amount) closing_signed from LL cross join N n group by kind,account_code) select json_arrayagg(json_object('kind' value kind,'code' value account_code,
                 'name' value nvl((select PartyName from Party p where p.PartyCode=LB.account_code),account_code),
                 'opening' value (case when kind='AP' then opening_signed else -opening_signed end),
                 'inflow' value debit_today,'outflow' value credit_today,
                 'closing' value (case when kind='AP' then closing_signed else -closing_signed end)) returning clob) payload from LB);
                select payload into a from (with N as (select cast(systimestamp at time zone 'Asia/Kolkata' as date) asof,trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,
                 (select FinancialYearBegin from FinancialYear where trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) between FinancialYearBegin and FinancialYearEnd fetch first 1 row only) fy,
                 (select GetUserPanelAB_apex() from dual) enforced from dual), A as (select 'PO_OVERDUE' metric,h.TNo doc_id,cast(h.PurchaseOrderNo as varchar2(400)) doc_no,h.PurchaseOrderDate document_date,
                 h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code,
                 (select sum(d.Amount) from PurchaseOrderDetail d where d.TNo=h.TNo) amount,cast('Current FY; delivery date passed and no GRN recorded.' as varchar2(400)) note,
                 h.DeliveryDate age_from
                 from PurchaseOrder h  cross join N n
                 where h.PurchaseOrderDate>=n.fy and h.PurchaseOrderDate<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.DeliveryDate<n.today and not exists(select 1 from Grn g where g.PurchaseOrderTNo=h.TNo) and exists(select 1 from PurchaseOrderDetail d where d.TNo=h.TNo)
                union all
                select 'GRN_UNBILLED' metric,h.TNo doc_id,cast(h.GrnNo as varchar2(400)) doc_no,h.GrnDate document_date,
                 h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code,
                 (select sum(d.Amount) from GrnDetail d where d.TNo=h.TNo) amount,cast('Current FY GRNs without a purchase-bill GRN link.' as varchar2(400)) note,
                 h.GrnDate age_from
                 from Grn h  cross join N n
                 where h.GrnDate>=n.fy and h.GrnDate<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and not exists(select 1 from PurchaseBillGRNDetail d where d.GRNTno=h.TNo) and exists(select 1 from GrnDetail d where d.TNo=h.TNo)
                union all
                select 'BILL_UNPASSED' metric,h.TNo doc_id,cast(h.PurchaseBillNo as varchar2(400)) doc_no,h.PurchaseBillDate document_date,
                 h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code,
                 (select sum(d.Amount) from PurchaseBillDetail d where d.TNo=h.TNo) amount,cast('Current FY bills with no PB Pass document.' as varchar2(400)) note,
                 h.PurchaseBillDate age_from
                 from PurchaseBill h  cross join N n
                 where h.PurchaseBillDate>=n.fy and h.PurchaseBillDate<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and not exists(select 1 from PBPass p where p.PurchaseBillTNo=h.TNo)
                union all
                select 'GATE_UNBILLED' metric,h.TNo doc_id,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateOutTime document_date,
                 h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code,
                 cast(null as number) amount,cast('Vehicle: '||h.VehicleNo||'; dispatch advice: '||da.DespatchAdviceNo as varchar2(400)) note,
                 h.GateOutTime age_from
                 from MaterialOut h join DespatchAdvice da on da.TNo=h.ReferenceTNo cross join N n
                 where h.GateOutTime>=n.fy and h.GateOutTime<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and not exists(select 1 from CCInvoice c where c.DespatchAdviceTNo=da.TNo)
                union all
                select 'IN_NO_GRN' metric,h.TNo doc_id,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateOutTime document_date,
                 h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code,
                 cast(null as number) amount,cast('Vehicle: '||h.VehicleNo||'; inbound: '||h.MaterialInNo as varchar2(400)) note,
                 h.GateOutTime age_from
                 from MaterialIn h  cross join N n
                 where h.GateOutTime>=n.fy and h.GateOutTime<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and not exists(select 1 from Grn g where g.MaterialInTNo=h.TNo)
                union all
                select 'GATE_INSIDE' metric,h.TNo doc_id,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime document_date,
                 h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code,
                 cast(null as number) amount,cast('MaterialIn; vehicle: '||h.VehicleNo as varchar2(400)) note,
                 h.GateInTime age_from
                 from MaterialIn h  cross join N n
                 where h.GateInTime>n.asof-2 and h.GateInTime<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.GateOutTime is null and h.GateInTime<n.asof-8/24
                union all
                select 'GATE_STALE' metric,h.TNo doc_id,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime document_date,
                 h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code,
                 cast(null as number) amount,cast('MaterialIn; vehicle: '||h.VehicleNo as varchar2(400)) note,
                 h.GateInTime age_from
                 from MaterialIn h  cross join N n
                 where h.GateInTime<=n.asof-2 and h.GateInTime>n.asof-400 and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.GateOutTime is null
                union all
                select 'GATE_INSIDE' metric,h.TNo doc_id,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateInTime document_date,
                 h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code,
                 cast(null as number) amount,cast('MaterialOut; vehicle: '||h.VehicleNo as varchar2(400)) note,
                 h.GateInTime age_from
                 from MaterialOut h  cross join N n
                 where h.GateInTime>n.asof-2 and h.GateInTime<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.GateOutTime is null and h.GateInTime<n.asof-8/24
                union all
                select 'GATE_STALE' metric,h.TNo doc_id,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateInTime document_date,
                 h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code,
                 cast(null as number) amount,cast('MaterialOut; vehicle: '||h.VehicleNo as varchar2(400)) note,
                 h.GateInTime age_from
                 from MaterialOut h  cross join N n
                 where h.GateInTime<=n.asof-2 and h.GateInTime>n.asof-400 and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.GateOutTime is null
                union all
                select 'APPROVAL',q.TNo,cast(q.MenuLabel as varchar2(400)),nvl(o.ModuleDate,sc.SalesConfirmDate),q.CompanyCode,
                 nvl(o.LocationCode,sc.LocationCode),nvl(o.PartyCode,sc.PartyCode),nvl(o.ModuleAmount,sc.SalesConfirmAmount),
                 cast(substr(q.ModuleName||'; token '||q.TokenNo||'; '||o.Particulars,1,400) as varchar2(400)),q.QueueDate
                 from ONTHETABLE_APEX q left join ONTHETABLEALL o on o.TNo=q.TNo
                 left join SalesConfirm sc on q.ModuleCode='SALESCONFIRM' and sc.TNo=q.ModuleTNo
                 where (:P739_COMPANY is null or q.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or nvl(o.LocationCode,sc.LocationCode)=:P739_LOCATION)) select json_arrayagg(json_object('key' value metric,'docs' value docs,'amount' value amount,'oldest_hours' value age_hours,
                 'under2' value under2,'h2_8' value h2_8,'h8_24' value h8_24,'over24' value over24) returning clob) payload
                 from (select metric,count(*) docs,sum(amount) amount,max((n.asof-age_from)*24) age_hours,
                 sum(case when (n.asof-age_from)*24<2 then 1 else 0 end) under2,
                 sum(case when (n.asof-age_from)*24>=2 and (n.asof-age_from)*24<8 then 1 else 0 end) h2_8,
                 sum(case when (n.asof-age_from)*24>=8 and (n.asof-age_from)*24<24 then 1 else 0 end) h8_24,
                 sum(case when (n.asof-age_from)*24>=24 then 1 else 0 end) over24 from A cross join N n group by metric));
                select payload into s from (with N as (select cast(systimestamp at time zone 'Asia/Kolkata' as date) asof,trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today,
                 (select FinancialYearBegin from FinancialYear where trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) between FinancialYearBegin and FinancialYearEnd fetch first 1 row only) fy,
                 (select GetUserPanelAB_apex() from dual) enforced from dual), U as (select u.StockTNo,sum(u.UsedStockQuantity1) used from UsedStock u cross join N n where u.UsedStockDate<=n.asof group by u.StockTNo),
                 S as (select s.TNo,s.StockDate,s.CompanyCode,s.LocationCode,s.ItemCode,s.ItemSpecificationCode,s.StorageLocationCode,
                 s.StockQuantity1-nvl(u.used,0) qty,s.Rate,(s.StockQuantity1-nvl(u.used,0))*s.Rate amount
                 from Stock s left join U u on u.StockTNo=s.TNo cross join N n where s.StockDate>=n.fy and s.StockDate<=n.asof and (:P739_COMPANY is null or s.CompanyCode=:P739_COMPANY)
                 and (:P739_LOCATION is null or s.LocationCode=:P739_LOCATION)
                 and (n.enforced is null or s.Panel=n.enforced) and (:P739_PANEL is null or s.Panel=:P739_PANEL)) select json_object('value' value sum(amount),'layers' value count(*),
                 'negative_layers' value sum(case when qty<0 then 1 else 0 end),'unpriced_layers' value sum(case when Rate is null then 1 else 0 end) returning clob) payload from S where abs(qty)>.000001);
                select json_object('asof' value to_char(cast(systimestamp at time zone 'Asia/Kolkata' as date),'DD Mon YYYY HH24:MI:SS'),'ledger' value nvl(l,'[]') format json,'alerts' value nvl(a,'[]') format json,'stock' value s format json returning clob) into v from dual;
                for i in 0..trunc((dbms_lob.getlength(v)-1)/16000) loop sys.htp.prn(dbms_lob.substr(v,16000,i*16000+1));end loop; end;
                ```
        }
