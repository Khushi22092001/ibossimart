    region teEvidenceALERT (
        name: Attention source register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: with N as (select cast(systimestamp at time zone 'Asia/Kolkata' as date) asof,trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) today, (select FinancialYearBegin from FinancialYear where trunc(cast(systimestamp at time zone 'Asia/Kolkata' as date)) between FinancialYearBegin and FinancialYearEnd fetch first 1 row only) fy, (select GetUserPanelAB_apex() from dual) enforced from dual), A as (select 'PO_OVERDUE' metric,h.TNo doc_id,cast(h.PurchaseOrderNo as varchar2(400)) doc_no,h.PurchaseOrderDate document_date, h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code, (select sum(d.Amount) from PurchaseOrderDetail d where d.TNo=h.TNo) amount,cast('Current FY; delivery date passed and no GRN recorded.' as varchar2(400)) note, h.DeliveryDate age_from from PurchaseOrder h cross join N n where h.PurchaseOrderDate>=n.fy and h.PurchaseOrderDate<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.DeliveryDate<n.today and not exists(select 1 from Grn g where g.PurchaseOrderTNo=h.TNo) and exists(select 1 from PurchaseOrderDetail d where d.TNo=h.TNo) union all select 'GRN_UNBILLED' metric,h.TNo doc_id,cast(h.GrnNo as varchar2(400)) doc_no,h.GrnDate document_date, h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code, (select sum(d.Amount) from GrnDetail d where d.TNo=h.TNo) amount,cast('Current FY GRNs without a purchase-bill GRN link.' as varchar2(400)) note, h.GrnDate age_from from Grn h cross join N n where h.GrnDate>=n.fy and h.GrnDate<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and not exists(select 1 from PurchaseBillGRNDetail d where d.GRNTno=h.TNo) and exists(select 1 from GrnDetail d where d.TNo=h.TNo) union all select 'BILL_UNPASSED' metric,h.TNo doc_id,cast(h.PurchaseBillNo as varchar2(400)) doc_no,h.PurchaseBillDate document_date, h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code, (select sum(d.Amount) from PurchaseBillDetail d where d.TNo=h.TNo) amount,cast('Current FY bills with no PB Pass document.' as varchar2(400)) note, h.PurchaseBillDate age_from from PurchaseBill h cross join N n where h.PurchaseBillDate>=n.fy and h.PurchaseBillDate<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and not exists(select 1 from PBPass p where p.PurchaseBillTNo=h.TNo) union all select 'GATE_UNBILLED' metric,h.TNo doc_id,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateOutTime document_date, h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code, cast(null as number) amount,cast('Vehicle: '||h.VehicleNo||'; dispatch advice: '||da.DespatchAdviceNo as varchar2(400)) note, h.GateOutTime age_from from MaterialOut h join DespatchAdvice da on da.TNo=h.ReferenceTNo cross join N n where h.GateOutTime>=n.fy and h.GateOutTime<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and not exists(select 1 from CCInvoice c where c.DespatchAdviceTNo=da.TNo) union all select 'IN_NO_GRN' metric,h.TNo doc_id,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateOutTime document_date, h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code, cast(null as number) amount,cast('Vehicle: '||h.VehicleNo||'; inbound: '||h.MaterialInNo as varchar2(400)) note, h.GateOutTime age_from from MaterialIn h cross join N n where h.GateOutTime>=n.fy and h.GateOutTime<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and not exists(select 1 from Grn g where g.MaterialInTNo=h.TNo) union all select 'GATE_INSIDE' metric,h.TNo doc_id,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime document_date, h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code, cast(null as number) amount,cast('MaterialIn; vehicle: '||h.VehicleNo as varchar2(400)) note, h.GateInTime age_from from MaterialIn h cross join N n where h.GateInTime>n.asof-2 and h.GateInTime<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.GateOutTime is null and h.GateInTime<n.asof-8/24 union all select 'GATE_STALE' metric,h.TNo doc_id,cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime document_date, h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code, cast(null as number) amount,cast('MaterialIn; vehicle: '||h.VehicleNo as varchar2(400)) note, h.GateInTime age_from from MaterialIn h cross join N n where h.GateInTime<=n.asof-2 and h.GateInTime>n.asof-400 and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.GateOutTime is null union all select 'GATE_INSIDE' metric,h.TNo doc_id,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateInTime document_date, h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code, cast(null as number) amount,cast('MaterialOut; vehicle: '||h.VehicleNo as varchar2(400)) note, h.GateInTime age_from from MaterialOut h cross join N n where h.GateInTime>n.asof-2 and h.GateInTime<=n.asof and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.GateOutTime is null and h.GateInTime<n.asof-8/24 union all select 'GATE_STALE' metric,h.TNo doc_id,cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateInTime document_date, h.CompanyCode company_code,h.LocationCode location_code,h.PartyCode party_code, cast(null as number) amount,cast('MaterialOut; vehicle: '||h.VehicleNo as varchar2(400)) note, h.GateInTime age_from from MaterialOut h cross join N n where h.GateInTime<=n.asof-2 and h.GateInTime>n.asof-400 and (:P739_COMPANY is null or h.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or h.LocationCode=:P739_LOCATION) and (n.enforced is null or h.Panel=n.enforced) and (:P739_PANEL is null or h.Panel=:P739_PANEL) and h.GateOutTime is null union all select 'APPROVAL',q.TNo,cast(q.MenuLabel as varchar2(400)),nvl(o.ModuleDate,sc.SalesConfirmDate),q.CompanyCode, nvl(o.LocationCode,sc.LocationCode),nvl(o.PartyCode,sc.PartyCode),nvl(o.ModuleAmount,sc.SalesConfirmAmount), cast(substr(q.ModuleName||'; token '||q.TokenNo||'; '||o.Particulars,1,400) as varchar2(400)),q.QueueDate from ONTHETABLE_APEX q left join ONTHETABLEALL o on o.TNo=q.TNo left join SalesConfirm sc on q.ModuleCode='SALESCONFIRM' and sc.TNo=q.ModuleTNo where (:P739_COMPANY is null or q.CompanyCode=:P739_COMPANY) and (:P739_LOCATION is null or nvl(o.LocationCode,sc.LocationCode)=:P739_LOCATION)) select a.metric CONTROL,a.doc_id DOCUMENT_ID,a.doc_no DOCUMENT_NO,a.document_date DOCUMENT_DATE, nvl(c.CompanyName,a.company_code) COMPANY,nvl(l.LocationName,a.location_code) LOCATION, nvl(p.PartyName,a.party_code) PARTY,a.amount AMOUNT,round((n.asof-a.age_from)*24,1) AGE_HOURS,a.note NOTES,case a.metric when 'PO_OVERDUE' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>682,p_clear_cache=>'682',p_items=>'P682_TNO,P682_FROMDATE,P682_TODATE,P682_COMPANY,P682_LOCATION',p_values=>a.doc_id||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_FROMDATE end||','||case when :P739_DIMTYPE='DAY' then to_char(to_date(:P739_DIMVALUE,'YYYY-MM-DD'),'DD-MM-RRRR') else :P739_TODATE end||','||:P739_COMPANY||','||:P739_LOCATION))||'">Purchase Order 360</a> ' when 'BILL_UNPASSED' then '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>680,p_clear_cache=>'680',p_items=>'P680_TNO',p_values=>a.doc_id))||'">Purchase Bill 360</a> ' end RELATED_360 from A a cross join N n left join Company c on c.CompanyCode=a.company_code left join Location l on l.LocationCode=a.location_code left join Party p on p.PartyCode=a.party_code where :P739_METRIC=a.metric and (:P739_DIMVALUE is null or (:P739_DIMVALUE='UNDER2' and (n.asof-a.age_from)*24<2) or (:P739_DIMVALUE='H2_8' and (n.asof-a.age_from)*24>=2 and (n.asof-a.age_from)*24<8) or (:P739_DIMVALUE='H8_24' and (n.asof-a.age_from)*24>=8 and (n.asof-a.age_from)*24<24) or (:P739_DIMVALUE='OVER24' and (n.asof-a.age_from)*24>=24))
            pageItemsToSubmit: [
                P739_FROMDATE
                P739_TODATE
                P739_COMPANY
                P739_LOCATION
                P739_PANEL
                P739_METRIC
                P739_MODE
                P739_DIMTYPE
                P739_DIMVALUE
                P739_DOC
            ]
        }
