egion-body{padding:10px 15px}.te-filter-region .t-Form-label{font-size:11px}.te-root details summary{cursor:pointer;font-weight:650}.te-root details p{font-size:12px;color:#758096}@keyframes te-load{to{background-position:-200% 0}}@media(prefers-reduced-motion:reduce){.te-skeleton{animation:none}.te-kpi{transition:none}}@media(max-width:1100px){.te-flow{grid-template-columns:repeat(4,minmax(0,1fr))}.te-mini{grid-template-columns:repeat(2,minmax(0,1fr))}.te-timeline{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){body:has(.te-root) .t-Body-contentInner{padding:10px}.te-hero{align-items:flex-start;padding:19px;flex-direction:column}.te-date{text-align:left}.te-hero h1{font-size:21px}.te-kpis,.te-finance{grid-template-columns:repeat(2,minmax(0,1fr))}.te-grid{grid-template-columns:1fr}.te-flow{grid-template-columns:repeat(2,minmax(0,1fr))}.te-heading{align-items:flex-start;flex-direction:column;gap:3px}.te-timeline{grid-template-columns:1fr}.te-kpi strong{font-size:23px}}@media(max-width:420px){.te-kpis{grid-template-columns:1fr}.te-periods button{padding:8px 10px}}
            
            /* Purchase Command Centre reference: icon block, accent rail, prominent value,
