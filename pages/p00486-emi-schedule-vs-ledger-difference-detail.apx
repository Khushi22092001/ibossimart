page 486 (
    name: EMI Schedule VS Ledger Difference Detail
    alias: EMI-SCHEDULE-VS-LEDGER-DIFFERENCE-DETAIL
    title: EMI Schedule VS Ledger Difference Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region emi-schedule-vs-ledger-difference-detail (
        name: EMI Schedule VS Ledger Difference Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region emi-schedule-vs-ledger-difference-detail-2 (
        name: EMI Schedule VS Ledger Difference Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   Rownum as SerialNo,
                   a.PartyName,
                   a.BalanceAsPerSchedule,
                   a.BalanceAsPerLedger,
                   a.Difference,
                   a.LoanNo,
                   a.EquipmentName,
                   a.Status
                From 
                (
                    Select
                        c.PartyName,
                        a.LoanNo,
                        e.EquipmentName,
                        round(b.PrincipleBalanceAmount,2) as BalanceAsPerSchedule,
                        round(GetAccountClosing(a.PartyCode,:P486_ASONDATE,null,a.CompanyCode),2) as BalanceAsPerLedger,
                        round(GetAccountClosing(a.PartyCode,:P486_ASONDATE,null,a.CompanyCode) - nvl(sum(b.PrincipleBalanceAmount),0),2) as Difference,
                        Case when nvl(sum(b.PrincipleBalanceAmount),0) - GetAccountClosing(a.PartyCode,:P486_ASONDATE,null,a.CompanyCode) != 0 then 'DIFFERENCE'
                        End as Status 
                    From Loan a, LoanDetail b, Party c, Equipment e
                    Where a.Tno = b.Tno
                    and a.PartyCode = c.PartyCode
                    and a.EquipmentTno = e.Tno
                    and to_char(b.DueDate, 'MON-RRRR') =
                  (
                   Select
                      to_char(max(b.DueDate), 'MON-RRRR') as DueDate
                    From Loan a, LoanDetail b, Party c
                    Where a.Tno = b.Tno
                    and a.PartyCode = c.PartyCode
                --and a.PartyCode = '2854'
                    and ( :P486_ACCOUNT IS NULL OR instr(':'||:P486_ACCOUNT||':',':'||a.PartyCode||':') > 0 )
                    and ( :P486_COMPANY IS NULL OR instr(':'||:P486_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and b.DueDate <= :P486_ASONDATE
                )
                and ( :P486_ACCOUNT IS NULL OR instr(':'||:P486_ACCOUNT||':',':'||a.PartyCode||':') > 0 )
                and ( :P486_COMPANY IS NULL OR instr(':'||:P486_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                Group by c.PartyName,
                a.LoanNo,
                e.EquipmentName,
                b.PrincipleBalanceAmount,
                GetAccountClosing(a.PartyCode,:P486_ASONDATE,null,a.CompanyCode)
                ) a
                Where (:P486_STATUS IS NULL OR instr(':'||:P486_STATUS||':',':'||a.Status||':') > 0 )
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
