page 131 (
    name: Pending Requisition Detail
    alias: PENDING-REQUISITION-DETAIL
    title: Pending Requisition Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region parameter (
        name: Parameter
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pending-requisition-detail (
        name: Pending Requisition Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.companycode,
                       a.locationcode,
                       a.requisitionno,
                       a.requisitiondate,
                       a.departmentcode,
                       getdepartmentname(a.departmentcode) As DepartmentName,
                       b.Quantity1,
                       b.Quantity2,
                       a.issuetoemployeecode As IssuetoEmployeeCode,
                       getEmployeeName(a.issuetoemployeecode) As IssuetoEmployeeName,
                       b.itemcode,
                       b.Itemspecificationcode
                  From requisition a, RequisitionDetail b
                 Where a.tno = b.tno
                   and a.companycode = :Global_companycode
                   And Not Exists
                 (Select 1
                          From Issue x, Issuedetail y
                         Where x.tno = y.tno
                           And x.requisitiontno = a.tno
                           And y.Itemcode = b.Itemcode
                           And y.Itemspecificationcode = b.Itemspecificationcode)
                   And nvl(getitemopeningquantity1(b.itemcode,
                                               b.itemspecificationcode,
                                               a.companycode,
                                               a.requisitiondate + 1),0) <= 0
                   And ( :P131_ItemCode Is Null Or b.itemcode = :P131_ItemCode )
                	 And ( :P131_ItemSpecificationCode Is Null Or b.ItemSpecificationCode = :P131_ItemSpecificationCode)
                	 --And a.requisitiondate < :P131_ASONDATE
                ```
            pageItemsToSubmit: [
                P131_ASONDATE
                P131_ITEMCODE
                P131_ITEMSPECIFICATIONCODE
            ]
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 8754226987513789
        }

