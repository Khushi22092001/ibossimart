page 399 (
    name: LR Pending For ServiceBill
    alias: LR-PENDING-FOR-SERVICEBILL
    title: LR Pending For ServiceBill
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lr-pending-for-servicebill (
        name: LR  PENDING  FOR SERVICEBILL
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lr-pending-for-servicebill-2 (
        name: LR Pending For ServiceBill
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    row_number() over(order by b.PartyName) SerialNo,
                    b.PartyName as BillAccount,
                    a.PartyRefNo as DONo,
                    a.WorkOrderNo,
                    c.SourceLocationName as SupplyFrom,
                    d.DestinationLocationName,
                    count(a.Tno) as TotalTrip,
                    sum(a.Quantity1) as LRQuantity
                From LR a, Party b, SourceLocation c, DestinationLocation d
                where not exists
                (Select 
                     aa.LRTno
                    From ServiceBillLR aa
                    Where aa.LRTno = a.Tno)
                and a.PartyCode = b.PartyCode
                and a.SourceLocationTno = c.Tno
                and a.DestinationLocationTno = d.Tno
                and (:P399_COMPANY is Null Or Instr (':' || :P399_COMPANY|| ':' , ':' || a.CompanyCode || ':') > 0)
                and a.GPDate between :P399_FROMDATE and :P399_TODATE
                and (:P399_PARTY is Null Or Instr (':' || :P399_PARTY|| ':' , ':' || a.PartyCode || ':') > 0)
                and (:P399_WORKORDER is Null Or Instr (':' || :P399_WORKORDER|| ':' , ':' || a.Tno || ':') > 0)
                and (:P399_PARTYDONO is Null Or Instr (':' || :P399_PARTYDONO|| ':' , ':' || a.Tno || ':') > 0)
                Group by b.PartyName,
                    a.PartyRefNo,
                    a.WorkOrderNo,
                    c.SourceLocationName,
                    d.DestinationLocationName;
                
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 119660426533084228
        }

        column BILLACCOUNT (
            type: plainText
            heading {
                heading: Bill Account
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DESTINATIONLOCATIONNAME (
