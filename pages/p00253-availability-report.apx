page 253 (
    name: Availability Report Discarded
    alias: AVAILABILITY-REPORT
    title: Availability Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region availability-report-discarded (
        name: Availability Report  Discarded
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.equipmentid,
                       a.equipmentcategorycode,
                       Nvl(eq.opening, v.opening) As Opening,
                       Nvl(eq.closing, v.closing) As Closing,
                       Nvl(eq.runninghrs, v.runningkm) As runningkm,
                       (TO_DATE(:P253_TODATE) - TO_DATE(:P253_FROMDATE) + 1) * 22 As "TotalHrs",
                        Nvl(eq.breakdowninhr, v.breakdowninhr) As BreakDownhr,
                        --- Available Hrs.
                        ( (TO_DATE(:P253_TODATE) - TO_DATE(:P253_FROMDATE) + 1) * 22 
                          - 
                           nvl(Nvl(eq.breakdowninhr, v.breakdowninhr),0)
                        ) as AvailableHRs,
                        --- Utilization Percent
                        case when  Nvl(eq.runninghrs, v.runningkm) > 0  and
                                  ( (TO_DATE(:P253_TODATE) - TO_DATE(:P253_FROMDATE) + 1) * 22 
                                      - 
                                       nvl(Nvl(eq.breakdowninhr, v.breakdowninhr),0)
                                    ) > 0 then
                              round((Nvl(eq.runninghrs, v.runningkm) /
                              ( (TO_DATE(:P253_TODATE) - TO_DATE(:P253_FROMDATE) + 1) * 22 
                                      - 
                                       nvl(Nvl(eq.breakdowninhr, v.breakdowninhr),0)
                                    )) * 100, 2)
                              else 0
                         end UtilizationPercent
                
                  From equipment a,
                       (Select a.equipmenttno,
                               Min(a.openingworkinghrs) opening,
                               Max(a.closingworkinghrs) closing,
                               Max(a.closingworkinghrs) - Min(a.openingworkinghrs) As RunningHrs,
                               Sum(((d.breakdownouttime - d.breakdownintime) * 24)) As Breakdowninhr
                          From equipmentlogbook          a,
                               Equipment                 b,
                               Equipmentcategory         c,
                               equipmentlogbookbreakdown d
                         Where a.equipmentlogbookdate Between :P253_FROMDATE And :P253_TODATE
                           And a.equipmenttno = b.tno
                           And b.equipmentcategorycode = c.Equipmentcategorycode
                           And a.tno = d.tno(+)
                           And c.equipmentcategorycode = 'EQ1'
                         Group By a.equipmenttno) eq,
                       (Select a.equipmenttno,
                               Min(a.openingmeterreading) opening,
                               Max(a.closingmeterreading) closing,
                               Max(a.closingmeterreading) - Min(a.openingmeterreading) As RunningKM,
                               Sum(((d.breakdownouttime - d.breakdownintime) * 24)) As Breakdowninhr
                          From vehiclelogbook                a,
                               Equipment                     b,
                               Equipmentcategory             c,
                               vehiclelogbookbreakdowndetail d
                         Where a.vehiclelogbookdate Between :P253_FROMDATE And :P253_TODATE
                           And a.equipmenttno = b.tno
                           And b.equipmentcategorycode = c.Equipmentcategorycode
                           And a.tno = d.tno(+)
                           And c.equipmentcategorycode = '9'
                         Group By a.equipmenttno) v
                 Where a.tno = eq.equipmenttno(+)
                   And a.tno = v.equipmenttno(+)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 9584757986356412
        }

        column AVAILABLEHRS (
            type: plainText
            heading {
                heading: Availablehrs
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column BREAKDOWNHR (
            type: plainText
            heading {
                heading: Breakdownhr
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column CLOSING (
            type: plainText
            heading {
                heading: Closing
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column EQUIPMENTCATEGORYCODE (
            type: plainText
            heading {
                heading: Equipmentcategorycode
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EQUIPMENTID (
            type: plainText
            heading {
                heading: Equipmentid
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column OPENING (
            type: plainText
            heading {
                heading: Opening
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column RUNNINGKM (
            type: plainText
            heading {
                heading: Runningkm
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column TotalHrs (
            type: plainText
            heading {
                heading: Totalhrs
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column UTILIZATIONPERCENT (
            type: plainText
            heading {
                heading: Utilizationpercent
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Availability Report  Discarded
        }

        savedReport 96206 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AVAILABLEHRS (
                sequence: 8
            )

            displayColumn BREAKDOWNHR (
                sequence: 7
            )

            displayColumn CLOSING (
                sequence: 4
            )

            displayColumn EQUIPMENTCATEGORYCODE (
                sequence: 2
            )

            displayColumn EQUIPMENTID (
                sequence: 1
            )

            displayColumn OPENING (
                sequence: 3
            )

            displayColumn RUNNINGKM (
                sequence: 5
            )

            displayColumn "TotalHrs" (
                sequence: 6
            )

            displayColumn UTILIZATIONPERCENT (
                sequence: 9
            )

        )

    )

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P253_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT TRUNC(SYSDATE) FROM DUAL;
        }
    )

    pageItem P253_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT TRUNC(SYSDATE) FROM DUAL;
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 30
            region: @filter
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

