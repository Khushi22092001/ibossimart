page 362 (
    name: CCInvoice Register For InterUnit
    alias: CCINVOICE-REGISTER-FOR-INTERUNIT
    title: CCInvoice Register For InterUnit
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region ccinvoice-register-for-interunit (
        name: CCInvoice Register For InterUnit
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                Rownum,
                h.DocTypeName,
                a.GRNNo,
                a.GRNDate,
                d.CCInvoiceNo,
                d.CCInvoiceDate,
                g.MaterialInNo,
                g.MaterialInDate,
                i.InspectionNo,
                i.InspectionDate,
                l.IssueNo,
                l.IssueDate,
                e.ItemName || ' - ' || f.ItemSpecificationName as ItemName,
                c.CompanySerialNo,
                m.LocationName,
                n.InterUnitTransferNo,
                o.LocationName as ToLocationName
                From GRN a, GRNDetail b, GRNSerialNo c, CCInvoice d, Item e, ItemSpecification f, MaterialIn g, DocType h, Inspection i, Stock j, IssueStockStorageDetail k, Issue l,
                Location m, InterUnitTransfer n, Location o
                Where a.Tno = b.Tno
                and b.Tno = c.Tno(+)
                and b.Sno = c.Sno(+)
                and a.InterUnitTransferCCInvoiceTno = d.Tno
                and b.ItemCode = e.ItemCode
                and b.ItemSpecificationCode = f.ItemSpecificationCode
                and a.MaterialInTno = g.Tno(+)
                and a.DocTypeCode = h.DocTypeCode(+)
                and a.Tno = i.GRNTno(+)
                and i.Tno = j.StockModuleTno(+)
                and j.Tno = k.StockTno(+)
                and k.Tno = l.Tno(+)
                and d.LocationCode = m.LocationCode(+)
                and d.InterUnitTransferTno = n.Tno(+)
                and n.LocationCode = o.LocationCode(+)
                and d.ccinvoiceDate between :P362_FROMDATE and :P362_TODATAE
                and ( :P362_COMPANY IS NULL OR instr(':'||:P362_COMPANY||':',':'||a.CompanyCode||':') > 0)
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                and exists(
                Select
                aa.Tno
                From GRNDetail aa
                Where aa.ItemCode = 'TYRE'
                and aa.Tno = a.Tno
                )
                Order by a.GRNDate, a.GRNNo
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 91526176022098920
        }

