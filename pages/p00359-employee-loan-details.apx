page 359 (
    name: Employee Loan Details
    alias: EMPLOYEE-LOAN-DETAILS
    title: Employee Loan Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region details (
        name: Details
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region employee-details (
        name: Employee Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                row_number() over(order by a.LoanSanctionDate) SerialNo,
                a.LoanSanctionDate,
                a.LoanSanctionNo,
                abs(GetAccountOPENING(ela.EmployeeLoanAccountCode,TO_DATE(:P358_FROMDATE,'DD-MM-RRRR'),null, a.companycode)) AS Opening,
                a.TotalAmount as ReceivedAmount,
                abs(nvl(e.SalaryHeadAmount,0)) AS Repayment,
                abs(GetAccountOPENING(ela.EmployeeLoanAccountCode,TO_DATE(:P358_FROMDATE,'DD-MM-RRRR'),null, a.companycode)) + a.TotalAmount 
                - abs(nvl(e.SalaryHeadAmount,0)) as BalanceAmount
                From LoanSanction a, LoanRequest b, EmployeeLoanAccount ela,Employee c, LoanType d,
                (Select
                  a.EmployeeCode,
                  b.SalaryHeadCode,
                  --GetSalarySalaryHeadAmount(a.TNo,'SALARYADVANCE') as SalaryAdvance,
                  --GetSalarySalaryHeadAmount(a.TNo,'RUNNINGADVANCE') as RunningAdvance
                  b.SalaryHeadAmount
                  From Salary a, SalaryDetail b
                  Where a.Tno = b.Tno(+)
                  and a.SalaryDate between :P358_FROMDATE and :P358_TODATE) e
                Where a.LoanRequestTno = b.Tno
                and b.EmployeeCode = ela.EmployeeCode
                and b.EmployeeCode = c.EmployeeCode
                and ela.LoanTypeCode = d.LoanTypeCode
                and a.LoanTypeCode = d.LoanTypeCode
                and b.EmployeeCode = e.EmployeeCode(+)
                and a.LoanTypeCode = e.SalaryHeadCode(+)
                and :P359_LOANTYPE = a.LoanTypeCode
                and :P359_EMPLOYEE = b.EmployeeCode
                and a.LoanSanctionDate between :P359_FROMDATE and :P359_TODATE
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                /*Select 
                a.LoanSanctionDate,
                abs(GetAccountOPENING(b.EmployeeCode,a.loansanctionDate,null, a.companycode)) AS Opening,
                a.TotalAmount as ReceivedAmount,
                abs(GetAccountCREDITDuring(b.EmployeeCode,a.CompanyCode,a.LoanSanctionDate,a.loansanctiondate)) AS Repayment,
                abs(GetAccountOPENING(b.EmployeeCode,a.loansanctionDate,null, a.companycode))+
                a.TotalAmount - 
                abs(GetAccountCREDITDuring(b.EmployeeCode,a.CompanyCode,a.LoanSanctionDate,a.loansanctiondate)) as BalanceAmount   
                From LoanSanction a, LoanSanctionDetail aa, LoanRequest b, Voucher c, VoucherDetail d
                Where aa.Tno = a.Tno
                and a.LoanRequestTno = b.Tno
                and aa.VoucherTno = c.Tno
                and c.Tno = d.Tno
                and d.Amount > 0
                and :P359_LOANTYPE = a.LoanTypeCode
                and :P359_EMPLOYEE = b.EmployeeCode
                and a.LoanSanctionDate between :P359_FROMDATE and :P359_TODATE*/
                
                
                
                
                
                
                
                
                
                
                
                /*Select 
                a.LoanSanctionDate,
                abs(GetAccountOPENING(ela.EmployeeLoanAccountCode,a.LoanSanctionDate,null, a.companycode)) AS Opening,
                a.TotalAmount as ReceivedAmount,
                abs(GetAccountCREDITDuring(ela.EmployeeLoanAccountCode,a.CompanyCode,a.LoanSanctionDate,a.LoanSanctionDate)) AS Repayment,
                abs(GetAccountOPENING(ela.EmployeeLoanAccountCode,a.LoanSanctionDate,null, a.companycode)) + a.TotalAmount
                - abs(GetAccountCREDITDuring(ela.EmployeeLoanAccountCode,a.CompanyCode,a.LoanSanctionDate,a.LoanSanctionDate)) as BalanceAmount
                From LoanSanction a, LoanRequest b, EmployeeLoanAccount ela
                Where a.LoanRequestTno = b.Tno
                and b.EmployeeCode = ela.EmployeeCode
                and a.LoanSanctionDate between :P359_FROMDATE and :P359_TODATE
                and :P359_EMPLOYEE = ela.EmployeeLoanAccountCode
                ;*/
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 78328264546369036
        }

        column BALANCEAMOUNT (
            type: plainText
            heading {
                heading: Balance Amount
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column LOANSANCTIONDATE (
            type: plainText
            heading {
                heading: Loan Sanction Date
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column LOANSANCTIONNO (
            type: plainText
            heading {
                heading: Loansanctionno
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column OPENING (
            type: plainText
            heading {
                heading: Opening Amount
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column RECEIVEDAMOUNT (
            type: plainText
            heading {
                heading: Received Amount
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column REPAYMENT (
            type: plainText
            heading {
                heading: Repayment  Amount
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Employee Details
        }

        savedReport 795454 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BALANCEAMOUNT (
                sequence: 6
            )

            displayColumn LOANSANCTIONDATE (
                sequence: 2
            )

            displayColumn OPENING (
                sequence: 3
            )

            displayColumn RECEIVEDAMOUNT (
                sequence: 4
            )

            displayColumn REPAYMENT (
                sequence: 5
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: RECEIVEDAMOUNT
            )

            aggregate (
                column: OPENING
            )

            aggregate (
                column: REPAYMENT
            )

            aggregate (
                column: BALANCEAMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P359_COMPANY (
        type: hidden
        layout {
            sequence: 40
            region: @details
            slot: regionBody
        }
    )

    pageItem P359_EMPLOYEE (
        type: hidden
        layout {
            sequence: 50
            region: @details
            slot: regionBody
        }
    )

    pageItem P359_FROMDATE (
        type: hidden
        layout {
            sequence: 10
            region: @details
            slot: regionBody
        }
    )

    pageItem P359_LOANTYPE (
        type: hidden
        layout {
            sequence: 60
            region: @details
            slot: regionBody
        }
    )

    pageItem P359_TODATE (
        type: hidden
        layout {
            sequence: 30
            region: @details
            slot: regionBody
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 70
            region: @details
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 358
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

