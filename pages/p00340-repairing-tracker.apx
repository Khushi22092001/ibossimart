    pageItem P340_STATUS (
        type: selectList
        label {
            label: STATUS
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Pending For Repairing','Pending For Repairing' as status from dual
                union all
                select  'Pending For Sending For Repair','Pending For Sending For Repair' as status from dual
                union all
                select 'In Reparing Process','In Reparing Process' as status from dual
                union all
                select 'Repaired But Not used','Repaired But Not used' as status from dual
                union all
                select 'Repaired and Used','Repaired and Used' as status from dual
                ```
            displayExtraValues: false
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 60
            region: @repairing-tracking
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P340_TODATE (
        type: datePickerJquery
        label {
            label: To Date
            alignment: left
        }
        settings {
            show: both
            navigationListFor: monthAndYear
        }
        layout {
            sequence: 50
            region: @repairing-tracking
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 28
            valuePlaceholder: To Date
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 30
            region: @repairing-tracking-2
            slot: topAndBottom
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 120
            region: @repairing-tracking
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction print-report (
        name: Print Report
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

