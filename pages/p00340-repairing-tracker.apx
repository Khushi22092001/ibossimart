            displayColumn JOBORDERAMOUNT (
                sequence: 14
            )

            displayColumn JOBORDERDATE (
                sequence: 12
            )

            displayColumn JOBORDERNO (
                sequence: 11
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn MATERIALINDATE (
                sequence: 16
            )

            displayColumn MATERIALINNO (
                sequence: 15
            )

            displayColumn PARTY (
                sequence: 13
            )

            displayColumn PARTYNAME (
                sequence: 3
            )

            displayColumn REPAIRINGREQUISITIONDATE (
                sequence: 6
            )

            displayColumn REPAIRINGREQUISITIONNO (
                sequence: 5
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SERVICESAMOUNT (
                sequence: 28
            )

            displayColumn SPAREAMOUNT (
                sequence: 27
            )

            displayColumn STATUS (
                sequence: 30
            )

            displayColumn STOREINREPAIRINGITEMDATE (
                sequence: 8
            )

            displayColumn STOREINREPAIRINGITEMNO (
                sequence: 7
            )

            displayColumn STOREOUTREPAIREDITEMDATE (
                sequence: 22
            )

            displayColumn STOREOUTREPAIREDITEMNO (
                sequence: 21
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: JOBORDERAMOUNT
            )

        )

    )

    pageItem P340_BREAKUP (
        type: hidden
        layout {
            sequence: 20
            region: @repairing-tracking
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P340_BREAKUPAS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @repairing-tracking
            slot: regionBody
        }
        default {
            type: static
            staticValue: DAILY
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P340_EQUIPMENT (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Equipment
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     e.EquipmentName||' ~ '||e.EquipmentID d,
                     e.TNo r
                From Equipment e
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @repairing-tracking
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 105
            valuePlaceholder: Equipment Name
        }
    )

    pageItem P340_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @repairing-tracking
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: From Date
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)-7
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P340_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select    Distinct
                         l.LocationName d,
                         l.LocationCode r
                
                From GRN a,Location l
                Where a.LocationCode = l.LocationCode
                ```
            nullDisplayValue: --Select Location--
        }
        layout {
            sequence: 70
            region: @repairing-tracking
            slot: regionBody
            alignment: left
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P340_ORDERNO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Order No.
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select    
                Distinct
                     jo.JobOrderNo d,
                     jo.TNo r
                From RepairingRequisitionDetail a,JobOrder jo
                Where a.TNo = jo.RepairingRequisitionTNo(+)
                ```
            nullDisplayValue: --Select Order No--
        }
        layout {
            sequence: 110
            region: @repairing-tracking
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P340_PARTY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vendor
