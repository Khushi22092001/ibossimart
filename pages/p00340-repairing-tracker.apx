        }
    )

    region repairing-tracking-2 (
        name: Repairing Tracking
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select xx.* FROM
                (
                Select
                      ROWNUM AS SerialNo,
                      l.Locationname,
                      To_Char(To_Date(:P340_FROMDATE,'DD-MM-RRRR'),'DD-MM-RRRR') as FromDate,
                      To_Char(To_Date(:P340_TODATE,'DD-MM-RRRR'),'DD-MM-RRRR') as ToDate,
                      Case
                         When SI.TNO Is Null Then
                          'Pending For Repairing'
                         When gp.tno Is Null Then
                          'Pending For Sending For Repair'
                         When mi.tno Is Null Then
                          'In Reparing Process'
                         When sto.tno Is Null Then
                          'Repaired But Not used'
                         When sto.tno Is Not Null Then
                          'Repaired and Used'
                       End Status,
                      CASE
                          WHEN :P340_BREAKUPAS = 'DAILY' THEN TO_CHAR(A.REPAIRINGREQUISITIONDATE,'DD-MM-YYYY')
                          WHEN :P340_BREAKUPAS = 'WEEKLY' THEN  (SELECT DISTINCT PERIODTYPE FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE  AND PERIODTYPE LIKE ( 'WEEK-%'))
                          WHEN :P340_BREAKUPAS = 'MONTHLY' THEN  TO_CHAR(A.REPAIRINGREQUISITIONDATE,'MON-RRRR')
                          WHEN :P340_BREAKUPAS = 'QUARTERLY' THEN  (SELECT DISTINCT PERIODTYPE FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE  AND PERIODTYPE LIKE ( 'QUARTER%'))
                          WHEN :P340_BREAKUPAS = 'HALFYEARLY' THEN (SELECT DISTINCT PERIODTYPE FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE  AND PERIODTYPE LIKE ( 'HALFYEAR%'))
                          WHEN :P340_BREAKUPAS = 'YEARLY' THEN (SELECT DISTINCT PERIODTYPE FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE  AND PERIODTYPE LIKE ( 'YEAR%') )
                      END BREAKUP,      
                      CASE
                          WHEN :P340_BREAKUPAS = 'DAILY' THEN  TO_CHAR(A.REPAIRINGREQUISITIONDATE,'DD-MM-YYYY')
                          WHEN :P340_BREAKUPAS = 'WEEKLY' THEN  (SELECT DISTINCT TO_CHAR(FROMDATE,'DD-MM-RRRR') FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE  AND PERIODTYPE LIKE ( 'WEEK-%'))
                          WHEN :P340_BREAKUPAS = 'MONTHLY' THEN '01-'||TO_CHAR(A.REPAIRINGREQUISITIONDATE,'MM-RRRR')
                          WHEN :P340_BREAKUPAS = 'QUARTERLY' THEN (SELECT DISTINCT TO_CHAR(FROMDATE,'DD-MM-RRRR') FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE AND PERIODTYPE LIKE ( 'QUARTER%'))
                          WHEN :P340_BREAKUPAS = 'HALFYEARLY' THEN (SELECT DISTINCT TO_CHAR(FROMDATE,'DD-MM-RRRR') FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE AND PERIODTYPE LIKE ( 'HALFYEAR%'))
                          WHEN :P340_BREAKUPAS = 'YEARLY' THEN (SELECT DISTINCT TO_CHAR(FROMDATE,'DD-MM-RRRR') FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE AND PERIODTYPE LIKE ( 'YEAR%') )
                      END STARTDATE,
                      CASE
                          WHEN :P340_BREAKUPAS = 'DAILY' THEN  TO_CHAR(A.REPAIRINGREQUISITIONDATE,'DD-MM-YYYY')
                          WHEN :P340_BREAKUPAS = 'WEEKLY' THEN  (SELECT DISTINCT TO_CHAR(TODATE,'DD-MM-RRRR') FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE  AND PERIODTYPE LIKE ( 'WEEK-%'))
                          WHEN :P340_BREAKUPAS = 'MONTHLY' THEN  TO_CHAR(LAST_DAY(A.REPAIRINGREQUISITIONDATE),'DD-MM-RRRR')
                          WHEN :P340_BREAKUPAS = 'QUARTERLY' THEN (SELECT DISTINCT TO_CHAR(TODATE,'DD-MM-RRRR') FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE  AND PERIODTYPE LIKE ( 'QUARTER%'))
                          WHEN :P340_BREAKUPAS = 'HALFYEARLY' THEN (SELECT DISTINCT TO_CHAR(TODATE,'DD-MM-RRRR') FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE  AND PERIODTYPE LIKE ( 'HALFYEAR%'))
                          WHEN :P340_BREAKUPAS = 'YEARLY' THEN (SELECT DISTINCT TO_CHAR(TODATE,'DD-MM-RRRR') FROM PERIODLIST X WHERE A.REPAIRINGREQUISITIONDATE BETWEEN X.FROMDATE AND X.TODATE AND PERIODTYPE LIKE ( 'YEAR%') )
                      END ENDDATE,
                      a.RepairingRequisitionNo,
                      a.RepairingRequisitionDate,
                      p.PartyName,
                      eq.EquipmentName,
                      eq.EquipmentID,
                      si.StoreInRepairingItemNo,
                      si.StoreInRepairingItemDate,
                      gp.GatePassNo,
                      gp.GatePassDate,
                      jo.JobOrderNo,
                      jo.JObOrderDate,
                      GetPartyName(jo.PartyCode) as Party,
                      JO.JOBORDERAMOUNT,
                     /* rs.RepairingSanctionNo,
                      rs.RepairingSanctionDate,
                      rs.SanctionAmount,
                      */
                      mi.MaterialInNo,
                      mi.MaterialINDate,
                      g.GRNNo,
                      g.GRNDate,
                      i.InspectionNo,
                      i.InspectionDate,
                      sto.StoreOutRepairedItemNo,
                      sto.StoreOutRepairedItemDate,
                      ese.ExternalServicesEntryNo,
                      ese.ExternalServicesEntryDate,
                      ese.SpareAmount,
                      ese.ServicesAmount,
                      ese.ExternalServicesEntryAmount,
                      ese.BillNo,
                      ese.BillDate
                From  RepairingRequisition a, RepairingRequisitionDetail b, Location l, Party p , Equipment eq, ExternalServicesEntry ese,
                      (Select
                             si.TNo,
                             si.StoreInRepairingItemNo,
                             si.StoreInRepairingItemDate,
                             si.RepairingRequisitionTNo,
                             sid.EquipmentTNo
                       From  StoreInRepairingItem si, StoreInRepairingItemDetail sid
                       Where si.TNo = sid.TNo
                      )si,
                      (Select
                             g.TNo,
                             g.GatePassNo,
                             g.GatePassDate,
                             g.PartyCode,
                             g.StoreInRepairingItemTNo
                       From  Gatepass g, GatePassDetail gd
                       Where g.TNo = gd.TNo
                      )gp,
                      JobOrder jo,
                      (Select 
                             rps.TNo,
                             rps.RepairingSanctionNo,
                             rps.RepairingSanctionDate,
                             rps.PartyCode,
                             rps.DepartmentCode,
                             rpsd.EquipmentTNo,
                             rpsd.SanctionAmount,
                             rpsd.RepairingRequisitionTNo
                       From  RepairingSanction rps, RepairingSanctionDetail rpsd
                       Where rps.TNo = rpsd.TNo
                      )rs,
                      (Select
                             m.TNo,
                             m.MaterialInNo,
                             m.MaterialInDate,
                             m.PartyCode,
                             m.GatePassTNo,
                             md.ItemCode,
                             md.ItemSpecificationCode
                       From  MaterialIn m, MaterialInDetail md
                       Where m.TNo = md.TNo
                      )mi,
                      (Select
                             gr.TNo,
                             gr.GRNNo,
                             gr.GRNDate,
                             gr.PartyCode,
                             gr.MaterialInTNo,
                             gr.GatePassTNo,
                             grd.ItemCode,
                             grd.ItemSPecificationCode
                       From  GRN gr, GRNDetail grd
                       Where gr.TNo = grd.TNo
                      )g,
                      Inspection i,
                      (Select
                             so.TNo,
                             so.StoreOutRepairedItemNo,
                             so.StoreOutRepairedItemDate,
                             sod.EquipmentTNo,
                             sod.RepairingRequisitionTNo
                       From  StoreOutRepairedItem so, StoreOutRepairedItemDetail sod
                       Where so.TNo = sod.TNo
                      )sto
                Where a.TNo = b.TNo
                  and a.PartyCode = p.PartyCode
                  and b.EquipmentTNo = eq.TNo(+)
                  and a.Tno = ese.RequisitionTno(+)
                  and ese.LocationCode = l.LocationCode
                  and b.TNo = si.RepairingRequisitionTNo(+)
                  and b.EquipmentTNo = si.EquipmentTNo(+)
                  and si.TNo = gp.StoreInRepairingItemTNo(+)
                  and b.TNo = jo.RepairingRequisitionTNo(+)
                  and b.TNo = rs.RepairingRequisitionTNo(+)
                  and b.EquipmentTNo = rs.EquipmentTNo(+)
                  and gp.TNo = mi.GatePassTNo(+)
                  and mi.TNo = g.MaterialInTNo(+)
                  and mi.GatepassTNo = g.GatePassTNo(+)
                  and mi.ItemCode = g.ItemCode(+)
                  and mi.ItemSpecificationCode = g.ItemSpecificationCode(+)
                  and g.TNo = i.GRNTNo(+)
                  and b.TNo = sto.RepairingRequisitionTNo(+)
                  and b.EquipmentTNo = sto.EquipmentTNo(+)
                  --and eq.TNo = 263488794
                  AND a.RepairingRequisitionDate BETWEEN :P340_FROMDATE and :P340_TODATE
                  and ( :P_340_LOCATION is null or instr(':'||:P340_LOCATION||':',':'||a.LocationCode||':') > 0 )
                  and ( :P340_PARTY is null or instr(':'||:P340_PARTY||':',':'||a.PartyCode||':') > 0 )
                  and ( :P340_EQUIPMENT is null or instr(':'||:P340_EQUIPMENT||':',':'||eq.TNo||':') > 0 )             
                  and nvl(jo.TNo,0) like nvl(:P340_ORDERNO,'%')
                ) XX
                Where XX.Breakup Like '%'||:P340_BREAKUP  
                  and (:P340_STATUS is null or xx.status = :P340_STATUS)
                order by xx.startdate
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
