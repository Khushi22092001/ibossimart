    dynamicAction equipment-change (
        name: Equipment Change
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P461_EQUIPMENTCATEGORY
        }
        clientSideCondition {
            type: item=value
            item: P461_EQUIPMENTCATEGORY
            value: VEHICLELOGBOOK
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P461_EQUIPMENTID
                    P461_EQUIPMENTNAME
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P461_VEHICLENO
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction equipment-change-2 (
        name: Equipment Change_1
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P461_EQUIPMENTCATEGORY
        }
        clientSideCondition {
            type: item!=value
            item: P461_EQUIPMENTCATEGORY
            value: VEHICLELOGBOOK
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P461_VEHICLENO
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P461_EQUIPMENTID
                    P461_EQUIPMENTNAME
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction null-hide (
        name: Null hide
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P461_EQUIPMENTCATEGORY
        }
        clientSideCondition {
            type: itemIsNull
            item: P461_EQUIPMENTCATEGORY
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P461_EQUIPMENTID
                    P461_EQUIPMENTNAME
                    P461_VEHICLENO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

)

