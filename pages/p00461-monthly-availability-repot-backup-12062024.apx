    region month-availability-report (
        name: Month Availability Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  
                ROWNUM AS SERIALNO,
                A.* 
                From
                	(
                	Select 
                		b.EquipmentId as "Door No",
                		Min(d.Opening)  as "Opening Working Hrs",
                		Max(e.Closing) as "Closing Working Hrs",
                		((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22as TotalHrs,
                		Nvl(Sum(c.BDHrs),0) as BDHrs,
                		(((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22) - Nvl(Sum(c.BDHrs),0) as TotalAvaliabilityHrs,
                		(Max(e.Closing) - Min(d.Opening)) as TotalRunningHrs,
                		(Max(e.Closing) - Min(d.Opening)) / (((((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22))/100) Utilization,
                		((((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22) - (Nvl(Sum(c.BDHrs),0))) /(((((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22))/100) as Availability
                		From EquipmentLogBook a,(Select Tno From EquipmentLogBookDetail b
                		Group by Tno) aa, Equipment b, (Select c.Tno,
                		Sum((Round(((c.BREAKDOWNOUTTIME - c.BREAKDOWNINTIME) * 24),2))) as BDHrs
                	From EquipmentLogBookBreakDown c Group by c.Tno) c,
                		(
                		Select 
                			a.Tno,
                			a.OpeningWorkingHrs as Opening,
                			a.EquipmentTno
                		From EquipmentLogBook a, Equipment b
                		where a.EquipmentTno = b.Tno(+)
                		and a.Tno in (
                				Select 
                					Min(a.Tno)
                				From EquipmentLogBook a, Equipment b
                				where a.EquipmentTno = b.Tno(+)
                					and a.EquipmentLogBookDate Between :P461_FromDATE and :P461_TODATE
                					and (:P461_COMPANY IS NULL OR instr(':'||:P461_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                					and (:P461_LOCATION IS NULL OR instr(':'||:P461_LOCATION||':',':'||a.LocationCode||':') > 0)
                					and (:P461_EQUIPMENTID IS NULL OR instr(':'||:P461_EQUIPMENTID||':',':'||b.Equipmentid||':') > 0 ) 
                					and (:P461_EQUIPMENTNAME IS NULL OR instr(':'||:P461_EQUIPMENTNAME||':',':'||b.EquipmentNAME||':') > 0)
                				Group by Equipmenttno
                				)
                		) d,
                		(
                		Select 
                			a.Tno,
                			Nvl(a.ClosingWorkingHrs,a.OpeningWorkingHrs) as Closing,
                			a.EquipmentLogBookDate,
                			a.EquipmentTno
                		From EquipmentLogBook a, Equipment b
                		where a.EquipmentTno = b.Tno(+)
                			and a.Tno in (
                				Select 
                					Max(a.Tno)
                				From EquipmentLogBook a, Equipment b
                				where a.EquipmentTno = b.Tno(+)
                					and a.EquipmentLogBookDate Between :P461_FromDATE and :P461_TODATE
                					and (:P461_COMPANY IS NULL OR instr(':'||:P461_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                					and (:P461_LOCATION IS NULL OR instr(':'||:P461_LOCATION||':',':'||a.LocationCode||':') > 0)
                					and (:P461_EQUIPMENTID IS NULL OR instr(':'||:P461_EQUIPMENTID||':',':'||b.Equipmentid||':') > 0 ) 
                					and (:P461_EQUIPMENTNAME IS NULL OR instr(':'||:P461_EQUIPMENTNAME||':',':'||b.EquipmentNAME||':') > 0)
                				Group By a.EquipmentTno 
                				)
                		) e
                	Where a.Tno = aa.Tno(+)
                		and a.EquipmentTno = b.Tno
                		and a.Tno = c.Tno(+)
                		and a.EquipmentLogBookDate Between :P461_FromDATE and :P461_TODATE
                		and (:P461_EQUIPMENTID IS NULL OR instr(':'||:P461_EQUIPMENTID||':',':'||b.Equipmentid||':') > 0 ) 
                		and (:P461_EQUIPMENTNAME IS NULL OR instr(':'||:P461_EQUIPMENTNAME||':',':'||b.EquipmentNAME||':') > 0)
                		and (:P461_COMPANY IS NULL OR instr(':'||:P461_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                		and (:P461_LOCATION IS NULL OR instr(':'||:P461_LOCATION||':',':'||a.LocationCode||':') > 0)
                		and a.Tno = d.Tno (+)
                		and a.Tno = e.Tno (+)
                		and :P461_EQUIPMENTCATEGORY = 'EQUIPMENTLOGBOOK'
                	Group by
                		b.EquipmentId
                	UNION ALL
                	Select 
                		d.VehicleNo as "Door No",
                		Min(e.Opening) as "Opening Working Hmr",
                		Max(f.Closing) as "Closing Working Hmr",
                		((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22 as TotalHrs,
                		Nvl(Sum(d.BreakDownHrs),0) as BDHrs,
                		(((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22) - Nvl(Sum(d.BreakDownHrs),0)  as TotalAvaliabilityHrs,
                		Nvl(Sum(d.Shifthour),0) - Nvl(Sum(d.BreakDownHrs),0) - Nvl(Sum(d.IdleHrs),0) as TotalRunningHrs,
                		(((((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22) - Nvl(Sum(d.BreakDownHrs),0) - Nvl(Sum(d.IdleHrs),0)) / ((((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22)/100)) Utilization,
                		--((Nvl(Sum(d.Shifthour),0) - Nvl(Sum(d.BreakDownHrs),0) - Nvl(Sum(d.IdleHrs),0)) / ((((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) +1) * 22)/100))) Utilization,
                		(((((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22) - Nvl(Sum(d.BreakDownHrs),0)) /(((((To_Date(:P461_TODATE) - To_Date(:P461_FromDATE) )+1) * 22)/100))) as Availability
                	From
                		(
                		Select 
                			a.Tno,
                			a.ShiftCode,
                			a.VehiclelogBookDate,
                			a.OpeningMeterReading,
                			a.IdleHrs,
                			a.BreakDownHrs,
                			c.ShiftHour,
                			a.CompanyCode,
                			a.LocationCode,
                			a.VehicleNo,
                			a.ClosingMeterReading
                		From VehicleLogBook a , 
                			(
                			Select 
                				b.Tno
                			From VehicleLogBookDetail b 
                			Group by  b.Tno
                			) b, 
                			Shift c 
                		Where a.Tno = b.tno(+)
                			and a.ShiftCode = c.ShiftCode(+)
                		) d,
                		(
                		Select 
                			a.Tno,
                			a.OpeningMeterReading as Opening ,
                			a.VehicleLogBookDate,
                			a.Vehicleno
                		From VehicleLogBook a
                		where a.Tno in (
                				Select 
                					min(a.Tno)
                				From VehicleLogBook a
                				where a.VehicleLogBookDate Between :P461_FromDATE and :P461_TODATE
                					and (:P461_VEHICLENO IS NULL OR instr(':'||:P461_VEHICLENO||':',':'||a.VehicleNo||':') > 0 ) 
                					and (:P461_COMPANY IS NULL OR instr(':'||:P461_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                					and (:P461_LOCATION IS NULL OR instr(':'||:P461_LOCATION||':',':'||a.LocationCode||':') > 0)
                				Group By a.Vehicleno
                				)
                		) e,
                		(
                		Select 
                			a.Tno,
                			Nvl(a.ClosingMeterReading,a.OpeningMeterReading) as Closing,
                			a.VehicleLogBookDate,a.Vehicleno
                		From VehicleLogBook a
                		where a.Tno in (
                				Select 
                					max(a.Tno)
                				From VehicleLogBook a
                				where a.VehicleLogBookDate Between :P461_FromDATE and :P461_TODATE
                					and (:P461_VEHICLENO IS NULL OR instr(':'||:P461_VEHICLENO||':',':'||a.VehicleNo||':') > 0 ) 
                					and (:P461_COMPANY IS NULL OR instr(':'||:P461_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                					and (:P461_LOCATION IS NULL OR instr(':'||:P461_LOCATION||':',':'||a.LocationCode||':') > 0)
                				Group By a.Vehicleno
                				)
                		) f
                	Where d.Tno = e.Tno(+)
                		and d.Tno = f.Tno(+)
                		and d.VehicleLogBookDate Between :P461_FromDATE and :P461_TODATE
                		and (:P461_VEHICLENO IS NULL OR instr(':'||:P461_VEHICLENO||':',':'||d.VehicleNo||':') > 0 ) 
                		and (:P461_COMPANY IS NULL OR instr(':'||:P461_COMPANY||':',':'||d.CompanyCode||':') > 0 ) 
                		and (:P461_LOCATION IS NULL OR instr(':'||:P461_LOCATION||':',':'||d.LocationCode||':') > 0)
                		and :P461_EQUIPMENTCATEGORY = 'VEHICLELOGBOOK'
                	Group by
                		d.VehicleNo
                	) A
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
