        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     distinct
                     b.CompanyName d,
                     b.CompanyCode r
                From EquipmentLogBook a, Company b
                Where a.CompanyCode = b.CompanyCode(+)
                
                
                
                
                
                
                
                
                
