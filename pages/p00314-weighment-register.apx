    region weighment-register-2 (
        name: Weighment Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    a.Tno,
                    a.WeighmentNo,
                    a.WeighmentDate,
                    b.LocationName,
                    a.VehicleNo,
                    x.ReferenceModuleNo,
                    c.VehicletypeName,
                    d.ItemName ||' - '|| e.ItemSpecificationName as Item, 
                    f.PartyName,
                    g.PartyName as TransporterName,
                    a.ChallanGrossWeight,
                    a.ChallanTareWeight,
                    a.ChallanNetWeight,
                    a.AcceptedWeight,
                    a.FirstWeight,
                    a.SecondWeight,
                    a.NetWeight,
                    a.ChallanNetweight - a.Netweight as Difference,
                    h.DoctypeName,
                    GetDateDifference(a.CreationTime,a.SecondWeightTime) as TimeTakenForBill
                From Weighment a, Location b,Vehicletype c, Item d, ItemSpecification e, Party f, Party g, Doctype h,
                (Select
                    a.Tno,
                    a.DespatchAdviceNo as ReferenceModuleNo
                 From DespatchAdvice a
                 UNION 
                 Select
                    a.Tno,
                    a.MaterialInNo as ReferenceModuleNo
                 From MaterialIN a
                 ) x, DocumentStatusDetail dsd
                Where a.LocationCode = b.LocationCode(+)
                  and a.ReferenceTno = x.Tno(+)
                  and a.VehicletypeCode = c.VehicletypeCode(+)
                  and a.ItemCode = d.ItemCode(+)
                  and a.ItemSpecificationCode = e.ItemSpecificationCode(+)
                  and a.PartyCode = f.PartyCode(+)
                  and a.TransporterCode = g.PartyCode(+)
                  and a.DoctypeCode = h.DoctypeCode(+)
                  and a.Tno = dsd.ModuleTno(+)
                  and a.WeighmentDate Between :P314_FROMDATE and :P314_TODATE
                  and ( :P314_COMPANY IS NULL OR INSTR(':'||:P314_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                  and ( :P314_LOCATION IS NULL OR INSTR(':'||:P314_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                  and ( :P314_DOCTYPE IS NULL OR INSTR(':'||:P314_DOCTYPE||':',':'||a.DoctypeCode||':') > 0 ) 
                  and ( :P314_STATUS IS NULL OR INSTR(':'||:P314_STATUS||':',':'||dsd.DocumentStatusCode||':') > 0 ) 
                  AND ( :P314_ITEM IS NULL OR INSTR(':'||:P314_ITEM||':',':'||a.ItemCode||':') > 0 ) 
                 AND ( :P314_ITEMSPECIFICATION IS NULL OR INSTR(':'||:P314_ITEMSPECIFICATION||':',':'||a.ItemSpecificationCode||':') > 0 ) 
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
