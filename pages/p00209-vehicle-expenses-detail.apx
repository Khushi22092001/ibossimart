    }
    security {
        formAutoComplete: false
    }

    region vehicle-expenses-detail (
        name: Vehicle Expenses Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vehicle-expenses-detail-2 (
        name: Vehicle Expenses Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    xx.VehicleNo,
                    xx.Module,
                    xx.CompletionNo,
                    xx.CompletionDate,
                    xx.Necessity,
                    xx.SlipNo,
                    xx.NextDueDate,
                    xx.WarrantyDays,
                    xx.MeterReading,
                    round(xx.Quantity,3) as Quantity,
                    round(xx.Amount,2) as Amount,
                    xx.Party,
                    xx.Company,
                    xx.Tno,
                    xx.ComponentSerialNo,
                    xx.OldComponentSerialNo    
                From
                (
                Select
                    NULL as Tno,
                    b.VehicleNo,
                    i.ModuleName as Module,
                    a.NecessityCompletionNo as CompletionNo,
                    a.NecessityCompletionDate as CompletionDate,
                    e.VehicleNecessityName as Necessity,
                    f.NecessitySlipNo as SlipNo,
                    b.NextDueMeterReading as NextDueDate,
                    b.WarrantyDays,
                    b.MeterReading,
                    b.Quantity1 as Quantity,
                    b.TotalAmount as Amount,
                    g.PartyName as Party,
                    h.CompanyName as Company,
                    b.ComponentSerialNo,
                    b.OldComponentSerialNo
                From NecessityCompletion a, NecessityCompletionDetail b, VehicleNecessity e, NecessitySlip f, Party g,
                Company h, Module i
                Where 1 = 2
                and a.Tno = b.Tno(+)
                and b.VehicleNecessityCode = e.VehicleNecessityCode(+)
                and b.NecessitySlipTno = f.Tno(+)
                and a.PartyCode = g.PartyCode(+)
                and a.CompanyCode = h.CompanyCode(+)
                --and a.ModuleTno = i.Tno(+)
                and a.ModuleCode = i.ModuleCode(+)
                --and i.ModuleCode = 'NECESSITYCOMPLETION'
                --and b.VehicleNo = 'CG13AR3356';
                
                UNION ALL
                
                Select
                    a.Tno,
                    h.CostCentreName as VehicleNo,
                    j.ModuleName as Module,
                    a.IssueNo as CompletionNo,
                    a.IssueDate as CompletionDate,
                    f.ItemName as Necessity,
                    k.RequisitionNo as SlipNo,
                    NULL AS NextDueDate,
                    NULL as WarrantyDays,
                    NULL as MeterReading,
                    round(g.Quantity1,3) as Quantity,
                   round(x.Amount,3) as Amount,
                    NULL as Party,
                    l.CompanyName as Company,
                    NULL as ComponentSerialNo,
                    NULL as OldComponentSerialNo
                From Issue a, IssueDetail b, Requisition d, Department e, Item f, IssueCostCentreDetail g,
                CostCentre h, MeasuringUnit i, Module j, Requisition k, Company l,
                (
                    Select
                        a.Tno,
                        a.Sno,
                        Round(Sum(Nvl(a.Quantity1, 0) * Nvl(b.Rate, 0)),2) as Amount
                    From IssueStockDetail a, Stock b
                    Where a.StockTno = b.Tno
                    Group By
                    a.Tno,
                    a.Sno
                )x
                Where a.Tno = b.Tno(+)
                and a.RequisitionTno = d.Tno(+)
                and d.DepartmentCode = e.DepartmentCode(+)
                and b.ItemCode = f.ItemCode(+)
                and a.Tno = g.Tno(+)
                and g.CostCentreCode = h.CostCentreCode(+)
                and f.MeasuringUnitCode1 = i.MeasuringUnitCode(+)
                and a.ModuleCode = j.ModuleCode(+)
                and a.CompanyCode = l.CompanyCode(+)
                and b.Tno = x.Tno(+)
                and b.Sno = x.Sno(+)
                and b.RequisitionTno = k.Tno(+)
                --and a.ModuleCode = 'ISSUE'
                ) xx,
                (
                    Select
                    d.Tno,
                    b.ComponentSerialNo,
                    c.ManufacturerSerialNo as OldComponentSerialNo
                From ComponentUsedStock a, ComponentStock b, Equipment c, IssueDetail d, IssueCostCentreDetail e
                Where a.ComponentStockTno = b.Tno(+)
                and a.OldComponentStockTno = c.Tno(+)
                and a.ModuleCode = 'ISSUE'
                and a.ModuleTno = d.Tno
                and a.ModuleSno = d.Sno
                and d.Tno = e.Tno
                and d.Sno = e.Sno
                and a.ModuleSerialNo = e.SN
                ) aa
                Where xx.Tno = aa.Tno(+)
                and xx.CompletionDate Between :P209_FromDate and :P209_TODATE
                and (:P209_VehicleNo is NULL OR INSTR (':' || :P209_VehicleNo || ':' , ':' || xx.VehicleNo|| ':') > 0)
                and (:P209_COMPANY is NULL OR INSTR (':' || :P209_COMPANY || ':' , ':' || xx.Company|| ':') > 0)
                --and (:P209_NECESSITY is NULL OR INSTR (':' || :P209_NECESSITY || ':' , ':' || xx.Necessity|| ':') > 0)
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
