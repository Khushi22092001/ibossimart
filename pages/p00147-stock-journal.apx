    region stock-journal (
        name: Stock Journal
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       ROWNUM,
                       a.stockjournalno,
                       a.stockjournaldate,
                       a.doctypecode,
                       d.itemname              As FromItem,
                       e.ItemSpecificationName As FromSpec,
                       d.measuringunitcode1    As FROMUOM1,
                       d.Measuringunitcode2    As FROMUOM2,
                       round(b.quantity1,3)    As FromQuantity1,
                       round(b.Quantity2,0)    As FromQuantity2,
                       f.ItemName              As ToItem,
                       g.itemspecificationName As ToSpec,
                       f.measuringunitcode1    As ToUOM1,
                       f.measuringunitcode2    As TOUOM2,
                       round(c.Quantity1,3)    As ToQuantity1,
                       round(c.Quantity2,3)    As ToQuantity2,
                        a.creator,
                        a.creationtime
                  From stockjournal         a,
                       stockjournalraw      b,
                       stockjournalfinished c,
                       item                 d,
                       itemspecification    e,
                       item                 f,
                       itemspecification    g
                 Where a.tno = b.tno
                   And a.tno = c.tno
                   And b.itemcode = d.itemcode
                   And b.itemspecificationcode = e.itemspecificationcode
                   And c.itemcode = f.itemcode
                   And c.itemspecificationcode = g.itemspecificationcode
                  and a.StockJournalDate between :P147_FROMDATE and :P147_TODATE
                  and instr(':'||:P147_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P147_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P147_ITEM IS NULL OR instr(':'||:P147_ITEM||':',':'||D.ItemCode||':') > 0 ) 
                  and ( :P147_ITEMSPECIFICATION IS NULL OR instr(':'||:P147_ITEMSPECIFICATION||':',':'||E.ItemSpecificationCode||':') > 0 ) 
                  and ( :P147_FINISHEDITEMNATURE IS NULL OR instr(':'||:P147_FINISHEDITEMNATURE||':',':'||f.ItemNatureCode||':') > 0 ) 
                  and a.StockJournalNo like nvl(:P147_SJNO,'%')
                    -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
