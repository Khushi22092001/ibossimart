                ```sql
                Select Distinct
                CompanyName d,
                CompanyCode r
                From company;
                ```
        }
        layout {
            sequence: 10
            region: @vehicle-necessity-summary
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 1
        }
