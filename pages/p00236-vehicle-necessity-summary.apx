page 236 (
    name: Vehicle Necessity Summary
    alias: VEHICLE-NECESSITY-SUMMARY
    title: Vehicle Necessity Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region vehicle-necessity-summary (
        name: Vehicle Necessity Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vehicle-necessity-summary-2 (
        name: Vehicle Necessity Summary
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                   row_number() over(order by vg.VehicleGroupName) SerialNo,
                	a.VehicleNo,
                	vg.VehicleGroupName,
                	vt.VehicleTypeName,
                    a.VehicleNecessityname,
                	round(sum(a.TotalAmount),2) as TotalAmount,
                	round(sum(a.AmountApr),2) as AmountApr,
                	round(sum(a.AmountMay),2) as AmountMay,
                	round(sum(a.AmountJun),2) as AmountJun,
                	round(sum(a.AmountJul),2) as AmountJul,
                	round(sum(a.AmountAug),2) as AmountAug,
                	round(sum(a.AmountSep),2) as AmountSep,
                	round(sum(a.AmountOct),2) as AmountOct,
                	round(sum(a.AmountNov),2) as AmountNov,
                	round(sum(a.AmountDec),2) as AmountDec,
                	round(sum(a.AmountJan),2) as AmountJan,
                	round(sum(a.AmountFeb),2) as AmountFeb,
                	round(sum(a.AmountMar),2) as AmountMar
                from VEHICLENECESSITYSUMMARY a, CompanyVehicle cv, VehicleGroup vg, VehicleType vt
                where a.VehicleNo = cv.CompanyVehicleNo
                	and cv.VehicleGroupCode = vg.VehicleGroupCode
                	and cv.VehicleTypeCode = vt.VehicleTypeCode
                	and a.CompanyCode = :P236_COMPANY
                   and a.FinancialYearCode = :P236_FINANCIALYEAR
                Group By
                	a.VehicleNo,
                	vg.VehicleGroupName,
                	vt.VehicleTypeName,
                    a.VehicleNecessityname;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 22446459392305738
        }

