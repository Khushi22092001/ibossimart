page 91 (
    name: Customer Inactive Invoices
    alias: CUSTOMER-INACTIVE-INVOICES
    title: Customer Inactive Invoices
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region customer-inactive-invoices (
        name: Customer Inactive Invoices
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       COMPANYNAME,
                       LOCATIONCODE,
                       LOCATIONNAME,
                       DOCTYPECODE,
                       DOCTYPENAME,
                       CCINVOICENO,
                       CCINVOICEDATE,
                       DESPATCHADVICETNO,
                       DESPATCHADVICENO,
                       DESPATCHADVICEDATE,
                       SALESORDERTNO,
                       SALESORDERNO,
                       SALESORDERDATE,
                       PARTYCODE,
                       PARTYNAME,
                       CONSIGNEECODE,
                       CONSIGNEENAME,
                       TRANSPORTERCODE,
                       TRANSPORTERNAME,
                       VEHICLENO,
                       LORRYNO,
                       LORRYDATE,
                       FREIGHTTYPECODE,
                       FREIGHTTYPENAME,
                       FREIGHTRATE,
                       FREIGHTUNITCODE,
                       ITEMCODE,
                       ITEMNAME,
                       MATERIALDESCRIPTION,
                       UOM1,
                       QUANTITY1,
                       RATE,
                       AMOUNT,
                       CGST,
                       SGST,
                       IGST,
                       TCS,
                       FOOTERAMOUNT,
                       OTHERAMOUNT,
                       TOTALAMOUNT,
                       CREATOR,
                       CREATIONTIME,
                       AGENTCODE,
                       AGENTNAME,
                       CITYCODE,
                       CITYNAME,
                       STATECODE,
                       STATENAME,
                       REGIONCODE,
                       REGIONNAME,
                       AGEOFINVOICE,
                       SALESPERSONCODE,
                       SALESPERSONNAME
                  from D_CUSTOMER_360VIEW_INACTIVEINVOICE
                  Where PartyCode = :P91_CUSTOMERCODE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            compute: false
            flashback: false
            saveReport: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 11418124213637958
        }

