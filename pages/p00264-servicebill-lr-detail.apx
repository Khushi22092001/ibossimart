    region transportation (
        name: Transportation
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                ROWNUM AS SerialNo,
                b.tno,
                a.LrNo,
                a.LrDate,
                a.VehicleNo,
                a.GPNo,
                c.SourceLocationName,
                d.DestinationLocationName,
                a.Quantity1 as ChallanQty,
                e.Quantity1 as ReceivedQty,
                b.Quantity1 as BalanceQty,
                b.FreightRate,
                b.FreightAmount,
                aa.ServiceBillNo,
                sb.Amount,
                sb.TotalAmount
                From Lr a,ServicebillLr b, SourceLocation c,DestinationLocation d, PODDetail e, ServiceBill aa, Party f,
                ServiceBillDetail sb
                Where a.Tno = b.LrTno(+)
                and b.Tno = aa.Tno(+)
                and a.SourceLocationTno = c.Tno(+)
                and a.DestinationLocationTno = d.Tno(+)
                and b.PODTno = e.Tno(+)
                and b.PODSnO = e.Sno(+)
                and aa.PartyCode = f.PartyCode(+)
                and aa.Tno = sb.Tno(+)
                and aa.DocTypeCode in ('TRANSPORTATION')
                and :P264_TNO = b.Tno
                
                
                
                
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
