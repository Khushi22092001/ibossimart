page 264 (
    name: ServiceBill LR Detail
    alias: SERVICEBILL-LR-DETAIL
    title: ServiceBill LR Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region internal-transfer (
        name: "Internal  Transfer "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                ROWNUM AS SerialNo,
                b.tno,
                a.InternalTransferNo,
                a.InternalTransferDate,
                a.VehicleNo,
                a.GPNo,
                c.SourceLocationName,
                d.DestinationLocationName,
                a.LoadingQuantity1,
                a.UnloadingQuantity1,
                b.Quantity1 as BalanceQty,
                b.FreightRate,
                b.FreightAmount,
                aa.ServiceBillNo,
                Sb.Quantity1 as qty,
                sb.Amount,
                sb.TotalAmount
                From InternalTransfer a,ServicebillInterNalTransfer b, SourceLocation c,DestinationLocation d, ServiceBill aa, Party f,
                ServiceBillDetail sb
                Where a.Tno = b.InternalTransferTno(+)
                and b.Tno = aa.Tno(+)
                and a.SourceLocationTno = c.Tno(+)
                and a.DestinationLocationTno = d.Tno(+)
                and aa.PartyCode = f.PartyCode(+)
                and aa.Tno = sb.Tno(+)
                and AA.DocTypeCode in ('INTERNALTRANSFER')
                and :P264_TNO = aa.Tno
                
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 14872680394412623
        }

