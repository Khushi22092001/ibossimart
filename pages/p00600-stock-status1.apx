                From   ItemSpecification a, ItemCategory b
                Where a.ItemCategoryCode = b.ItemCategoryCode 
                Order By 1
                ```
            nullDisplayValue: --Select List--
        }
        layout {
            sequence: 70
            region: @stock-status
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
    )

    pageItem P600_ITEMNATURE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Item Nature
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct 
                       a.ItemNatureName d,
                       a.ItemNatureCode r  
                From   ItemNature a
                Where a.ItemNatureCode not in ('STOREITEM','SERVICES','ASSET','SCRAP') 
                Order By 1
                ```
            nullDisplayValue: --Select List--
        }
        layout {
            sequence: 30
            region: @stock-status
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P600_ITEMSPECIFICATION (
        type: plugin/pretiusApexEnhancedLovItem
