            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct 
                       a.ItemspecificationName d,
                       a.ItemspecificationCode r  
                From   Itemspecification a 
                Order By 1
                ```
            nullDisplayValue: --Select List--
        }
        cascadingLov {
            parentItems: P600_ITEM
            itemsToSubmit: P600_ITEMSPECIFICATION
        }
        layout {
            sequence: 90
            region: @stock-status
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
    )

