    region stock-journal-plus-minus-2 (
        name: Stock Journal Plus Minus
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                   row_number() over(order by a.StockJournalDate) SerialNo,
                   a.StockJournalNo,
                   a.StockJournalDate,
                   a.QuantityMinus,
                   a.QuantityPlus,
                  nvl(a.QuantityPlus ,0) - nvl(a.QuantityMinus, 0) as DifferenceQty,
                   b.CompanyName,
                   c.LocationName,
                   d.DoctypeName
                From StockJournalPlusMinus a, Company b, Location c, Doctype d
                Where a.CompanyCode = b.CompanyCode
                  and a.LocationCode = c.LocationCode
                  and a.DoctypeCode = d.DoctypeCode
                  and a.StockJournalDate Between :P446_FROMDATE and :P446_TODATE
                  and ( :P446_COMPANY IS NULL OR instr(':'||:P446_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                 and ( :P446_LOCATION IS NULL OR instr(':'||:P446_LOCATION||':',':'||a.LocationCode||':') > 0 )
                 and ( :P441_DOCTYPE IS NULL OR instr(':'||:P441_DOCTYPE||':',':'||a.DoctypeCode||':') > 0 )
                -- and ( :P441_COMPANY IS NULL OR instr(':'||:P441_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                -- and ( :P441_LOCATION IS NULL OR instr(':'||:P441_LOCATION||':',':'||a.LocationCode||':') > 0 )
                -- and ( :P441_VOUCHER IS NULL OR instr(':'||:P441_VOUCHER||':',':'||a.Tno||':') > 0 );
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
