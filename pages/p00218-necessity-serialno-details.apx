page 218 (
    name: Necessity SerialNo Details
    alias: NECESSITY-SERIALNO-DETAILS
    title: Necessity SerialNo Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 600
        height: 300
        maxWidth: 1000
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region serial-no (
        name: Serial No
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        a.COMPANYSERIALNO,
                        a.METERREADING,
                        a.WARRANTYUPTODATE,
                        a.WARRANTYPROVIDERCODE,
                        a.REMARK
                From
                      COMPANYVEHICLESERIALNO a
                Where a.SNO=:P218_SNO
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 50498177452932039
        }

        savedReport 104404 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @COMPANYSERIALNO
                layout {
                    width: 166
                    sequence: 1
                }
            )

            displayColumn (
                column: @METERREADING
                layout {
                    width: 115
                    sequence: 2
                }
            )

            displayColumn (
                column: @WARRANTYUPTODATE
                layout {
                    width: 152
                    sequence: 3
                }
            )

            displayColumn (
                column: @WARRANTYPROVIDERCODE
                layout {
                    width: 165
                    sequence: 4
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 5
                }
            )

        )

        column COMPANYSERIALNO (
            type: textField
            heading {
                heading: Tyre Serial No
            }
            layout {
                sequence: 10
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: COMPANYSERIALNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column METERREADING (
            type: numberField
            heading {
                heading: Meter Reading
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                databaseColumn: METERREADING
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column REMARK (
            type: textarea
            heading {
                heading: Remark
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column WARRANTYPROVIDERCODE (
            type: textField
            heading {
                heading: Warranty Provider Code
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: WARRANTYPROVIDERCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column WARRANTYUPTODATE (
            type: datePickerJquery
            heading {
                heading: Warranty upto Date
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                databaseColumn: WARRANTYUPTODATE
                dataType: date
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    pageItem P218_SNO (
        type: hidden
        layout {
            sequence: 10
            region: @serial-no
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 10
            region: @serial-no
            slot: top
            horizontalAlignment: left
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 216
                items: {
                    P216_SNO: &P218_SNO.
                }
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

