page 183 (
    name: test emp
    alias: TEST-EMP
    title: test emp
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region dept (
        name: Dept
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region emp (
        name: emp
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select * from test_emp
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region empdetail (
        name: empdetail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                 B.EMPID,B.EMPNAME ,C.DEPTNAME,A.DESIGNATION,A.SALARY
                from test_empdetail a,
                     test_emp b,
                     test_dept c
                where a.empid = b.empid
                  and a.deptid = c.deptid
                  and (a.deptid = :P183_DEPTID OR :P183_DEPTID IS NULL )
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 13988136134933903
        }

        column DEPTNAME (
            type: plainText
            heading {
                heading: Deptname
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column DESIGNATION (
            type: plainText
            heading {
                heading: Designation
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column EMPID (
            type: plainText
