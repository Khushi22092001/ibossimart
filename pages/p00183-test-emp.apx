            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction empidchange (
        name: EMPIDCHANGE
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P183_EMPID
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT EMPNAME FROM TEST_EMP WHERE EMPID=:P183_EMPID
                itemsToSubmit: P183_EMPID
            }
            affectedElements {
                selectionType: items
                items: P183_EMPNAME
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P183_DEPTID
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select DEPTNAME FROM TEST_DEPT WHERE DEPTID=:P183_DEPTID
                itemsToSubmit: P183_DEPTID
            }
            affectedElements {
                selectionType: items
                items: P183_SELECTED
            }
            execution {
                sequence: 10
            }
        )

    )

    process initialize-form-test-emp (
        name: Initialize form test emp
        type: formInitialization
        formRegion: @emp
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15416067272147910
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                Insert Into test_empDETAIL
                (
                  empid       ,
                  deptid      ,
                  designation ,
                  salary     
                ) VALUES 
                (
                 :P183_EMPID,
                 :P183_DEPTID,
                 :P183_DESIGNATION,
                 :P183_SALARY
                ) ;
                COMMIT;
                END;
                /*
                DECLARE
                   vRow BINARY_INTEGER;
                BEGIN
                   :p95_selected := NULL;
                
                   FOR i IN 1 .. apex_application.g_f01.COUNT
                   LOOP
                      vRow := apex_application.g_f01(i);
                      :p95_text :=
                            :p95_text
                         || CHR (10)
                         || vRow
                         || '. '
                         || apex_application.g_f02 (vRow)
                         || ' / '
                         || apex_application.g_f03 (vRow)
                         || ' / '
                         || apex_application.g_f04 (vRow)
                         || ' / '
                         || apex_application.g_f05 (vRow)
                         || ' / '
                         || apex_application.g_f06 (vRow)
                         || ' / '
                         || apex_application.g_f07 (vRow);
                   END LOOP;
                END;
                */
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 15415909913147908
        }
    )

)

