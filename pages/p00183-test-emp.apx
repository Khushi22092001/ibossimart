                heading: Empname
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column SALARY (
            type: plainText
            heading {
                heading: Salary
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: empdetail
        }

        savedReport 139992 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEPTNAME (
