            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     Distinct
                     pp.partyName||' ( '||pp.PartyTypeCode||' )' as d,
                     pp.PartyCode r
                From Accountopening a, party p, Party  pp
                Where a.AccountCode = p.partyCode
                  and p.ParentCode = pp.partyCode
                Order By 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @account-opening-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
            valuePlaceholder: Parent Accounts List
        }
    )

    button refresh (
