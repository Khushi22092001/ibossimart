page 40 (
    name: Account Opening Register
    alias: ACCOUNT-OPENING-REGISTER
    title: Account Opening Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region account-opening-register (
        name: Account Opening Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region account-opening-report (
        name: Account Opening Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     a.*,
                     Rownum as SerialNo 
                   From (Select
                      l.Locationname,
                      p.PartyCode,
                      p.PartyName,
                      p.PartyTypeCode,
                      GetpartyName(p.ParentCode) as ParentName,
                      sum(a.OpeningAmount)*-1 as DR,
                      null as CR,
                      GetEmployeeName(bu.EmployeeCode)||' ( '||a.Creator||' )' as Creator,
                      a.CreationTime
                From  AccountOpening a, Party p, Location l, BossUser bu
                Where a.AccountCode = p.PartyCode(+)
                  and a.LocationCode = l.LocationCode
                  and a.OpeningAmount < 0
                  and a.Creator = bu.LoginName(+)
                  and instr(':'||:P40_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P40_LOCATION||':',':'||a.LocationCode||':') > 0
                  --and a.LocationCode  like nvl(:P40_LOCATION,'%')
                  and ( :P40_ACCOUNT IS NULL OR instr(':'||:P40_ACCOUNT||':',':'||a.AccountCode||':') > 0 ) 
                  and ( :P40_PARENT IS NULL OR instr(':'||:P40_PARENT||':',':'||p.ParentCode||':') > 0 ) 
                  and p.PartytypeCode like nvl(:P40_ACCOUNTTYPE,'%')
                Group by 
                      l.Locationname,
                      p.PartyCode,
                      p.PartyName,
                      p.PartyTypeCode,
                      GetpartyName(p.ParentCode),
                      GetEmployeeName(bu.EmployeeCode)||' ( '||a.Creator||' )' ,
                      a.CreationTime
                Union All
                Select
                      l.Locationname,
                      p.PartyCode,
                      p.PartyName,
                      p.PartyTypeCode,
                      GetpartyName(p.ParentCode) as ParentName,
                      null as DR,
                      sum(a.OpeningAmount) as CR,
                      GetEmployeeName(bu.EmployeeCode)||' ( '||a.Creator||' )' as Creator,
                      a.CreationTime
                From  AccountOpening a, Party p, Location l, BossUser bu
                Where a.AccountCode = p.PartyCode(+)
                  and a.LocationCode = l.LocationCode
                  and a.OpeningAmount > 0
                  and a.Creator = bu.LoginName(+)
                  and instr(':'||:P40_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and a.LocationCode  like nvl(:P40_LOCATION,'%')
                  and ( :P40_ACCOUNT IS NULL OR instr(':'||:P40_ACCOUNT||':',':'||a.AccountCode||':') > 0 ) 
                  and ( :P40_PARENT IS NULL OR instr(':'||:P40_PARENT||':',':'||p.ParentCode||':') > 0 ) 
                  --and a.AccountCode like nvl(:P40_ACCOUNT,'%')
                  --and p.ParentCode like nvl(:P40_PARENT,'%')
                  and p.PartyTypeCode like nvl(:P40_ACCOUNTTYPE,'%')
                Group by 
                      l.Locationname,
                      p.PartyCode,
                      p.PartyName,
                      p.PartyTypeCode,
                      GetpartyName(p.ParentCode),
                      GetEmployeeName(bu.EmployeeCode)||' ( '||a.Creator||' )',
                      a.CreationTime) a
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 17818377010236129
        }

