page 336 (
    name: EMI Detail
    alias: EMI-DETAIL
    title: EMI Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #emi .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region emi-detail (
        name: EMI Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Select
                   Rownum as SerialNo,
                	a.CompanyCode,
                   a.LoanNo,
                	a.LoanDate,
                	b.DueDate as EMIDate,
                	d.CompanyVehicleNo as VehicleNo,
                	nvl(b.PrincipleAmount, 0) + nvl(b.InterestAmount, 0) as Amount
                From Loan a, LoanDetail b, Equipment c, CompanyVehicle d, DocumentStatusDetail dsd
                Where a.Tno = b.Tno
                	and a.EquipmentTno = c.Tno
                	and c.Tno = d.ModuleTno
                	and c.EquipmentGroupCode = 'CT'
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and b.DueDate between :P336_FROMDATE and :P336_TODATE
                	and a.CompanyCode = :P336_COMPANYCODE
                  and d.CompanyVehicleNo like nvl(:P336_VEHICLENO, '%')
                */
                
                Select
                  row_number() over(order by a.ModuleDate) SerialNo,
                	a.ModuleName,
                	a.ModuleNo,
                	a.ModuleDate,
                	a.VehicleNo,
                  b.VehicleTypeName,
                  c.TransportAreaName,
                	a.Amount
                From VehicleExpenseTable a, VehicleType b, TransportArea c
                Where a.VehicleTypeCode = b.VehicleTypeCode(+)
                    and a.TransportAreaCode = c.TransportAreaCode(+)
                    and a.ModuleDate between :P336_FROMDATE and :P336_TODATE
                		and a.VehicleNo like nvl(:P336_VEHICLENO, '%')
                		and a.CompanyCode = :P336_COMPANYCODE
                    and a.Creator = :APP_USER
                    and a.Categories = 'EMI'
                    and (:P336_VEHICLENO2 is null
                       or exists(
                         Select
                            aa.VehicleNo
                          From VPVehicleNo aa
                          Where aa.VehicleNo = a.VehicleNo
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P336_VEHICLETYPE is null
                       or exists(
                         Select
                            aa.VehicleTypeCode
                          From VPVehicleType aa
                          Where aa.VehicleTypeCode = a.VehicleTypeCode
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P336_TRANSPORTAREA is null
                       or exists(
                         Select
                            aa.TransportAreaCode
                          From VPTransportArea aa
                          Where aa.TransportAreaCode = a.TransportAreaCode
                              and aa.Creator = :APP_USER
                       )
                   )
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                ```
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: emi
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 353780903941308785
        }

