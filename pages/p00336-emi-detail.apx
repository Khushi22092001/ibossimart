                    sequence: 1
                }
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                function: count
                column: NECESSITYSLIPDATE
            )

            aggregate (
                function: count
                column: SITEEXPENSEDATE
            )

            aggregate (
