page 315 (
    name: bypasslogin
    alias: BYPASSLOGIN
    title: bypasslogin
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        formAutoComplete: false
    }

    region new (
        name: NEW
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P315_PAGE (
        type: textField
        label {
            label: Page
            alignment: left
        }
        layout {
            sequence: 30
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        default {
            type: static
            staticValue: 1
        }
        sessionState {
            storage: request
        }
    )

    pageItem P315_PASSWORD (
        type: textField
        label {
            label: Password
            alignment: left
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    pageItem P315_USERNAME (
        type: textField
        label {
            label: Username
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    branch (
        name: GO TO 9999
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            target: {
                page: 9999
                items: {
                    P9999_USERNAME: &P315_USERNAME.
                    P9999_PASSWORD: &P315_PASSWORD.
                    P9999_PAGENO: &P315_PAGE.
                    GLOBAL_PAGENO: &P315_PAGE.
                }
                clearCache: 9999
                request: BRANCH_TO_PAGE_ACCEPT
            }
        }
    )

)

