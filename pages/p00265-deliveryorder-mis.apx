    region mis (
        name: "MIS "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                x.Tno,
                x.CompanyCode,
                x.CompanyName,
                x.DoctypeCode,
                x.DoctypeName,
                x.DeliveryOrderNo,
                x.DeliveryOrderDate,
                x.SourceLocationTno,
                x.DestinationLocationTno,
                x.PartyCode,
                x.PartyName,
                x.PartyDoNo,
                x.NoOfTrip,
                x.ASONDATE,
                x.Mines,
                NULL AS GPDATE,
                X.INTERNALTRANSFERDate,
                x.FromDate,
                x.ToDate,
                x.DOQuantity,
                x.TodaysLifting,
                x.TillDateLifting,
                x.LapsedQty,
                nvl(x.DOQuantity, 0) - nvl(x.TillDateLifting, 0) - nvl(x.LapsedQty, 0) as BalanceQty,
                round(((nvl(x.DOQuantity, 0) - nvl(x.TillDateLifting, 0) - nvl(x.LapsedQty, 0)) / nvl(x.BalanceDays, 1)),3)as AskingRate,
                x.PercentLifting,
                x.BalanceDays
                From
                (Select
                a.Tno,
                a.PartyCode,
                a.DoctypeCode,
                a.CompanyCode,
                GetCompanyName(a.CompanyCode) as CompanyName,
                dc.DoctypeName,
                a.DeliveryOrderNo,
                pa.PartyName,
                a.PartyDoNo,
                t.NoOfTrip,
                :P265_ASONDATE AS ASONDATE,
                case when a.DeliveryOrderDate = do.fromdate then a.deliveryorderdate
                else a.deliveryorderdate 
                end as deliveryorderdate,
                do.FromDate,
                do.ToDate,
                t.InternalTransferDate,
                NULL AS GPDATE,
                a.SourceLocationTno,
                a.DestinationLocationTno,
                sl.SourceLocationName || '-' || dl.DestinationLocationName as Mines,
                a.DOQuantity,
                nvl(t.TodaysLifting,0) as TodaysLifting,
                nvl(t.TillDateLifting,0) as TillDateLifting,
                Case When  do.ToDate < nvl(TO_DATE(:P265_ASONDATE,'dd-mm-rrrr'), TRUNC(SYSDATE)) then a.DoQuantity - t.TillDateLifting  
                else null 
                end as LapsedQty,
                round(DECODE(a.DoQuantity,0,0,((t.TillDateLifting/a.DoQuantity)*100)),2) as PercentLifting,
                Case When do.ToDate > nvl(TO_DATE(:P265_ASONDATE,'dd-mm-rrrr'), TRUNC(SYSDATE)) then
                do.ToDate - nvl(TO_DATE(:P265_ASONDATE,'dd-mm-rrrr'), TRUNC(SYSDATE))
                ELSE null 
                end as BalanceDays
                From DeliveryOrderReport a, SourceLocation sl, DestinationLocation dl,DeliveryOrder do,Party pa,Doctype dc,
                (Select 
                B.partydono,
                a.sourcelocationtno,
                a.destinationlocationtno,
                sum(A.loadingquantity1) as TillDatelifting,
                nvl((
                Select
                sum(aa.Loadingquantity1)
                from internaltransfer aa, DeliveryOrder do
                where aa.DeliveryOrderTno = do.Tno
                and do.PartydoNo = B.PartyDONo
                and aa.sourcelocationtno = a.sourcelocationtno
                and aa.destinationlocationtno = a.destinationlocationtno
                and nvl(aa.internaltransferDate, do.deliveryorderdate) = nvl(:P265_ASONDATE, TRUNC(SYSDATE))
                group by
                do.partydono,
                aa.sourcelocationtno,
                aa.destinationlocationtno
                ),0) Todayslifting,
                nvl((
                Select
                Count(aa.InternalTransferno) as NoOfTrip
                from InternalTransfer aa, DeliveryOrder DO
                where aa.DeliveryOrderTno = DO.tNO
                AND DO.PartydoNo = b.PartyDONo
                and aa.sourcelocationtno = a.sourcelocationtno
                and aa.destinationlocationtno = a.destinationlocationtno
                and nvl(aa.InternalTransferDate, do.deliveryorderdate) = nvl(:P265_ASONDATE, TRUNC(SYSDATE))
                group by
                do.partydono,
                aa.sourcelocationtno,
                aa.destinationlocationtno
                ),0) NoOfTrip,
                (
                Select
                aa.InternalTransferDate
                from InternalTransfer aa, DeliveryOrder do
                where aa.DeliveryOrderTno = do.Tno
                and DO.PartyDoNo = B.PartyDONo
                and aa.sourcelocationtno = a.sourcelocationtno
                and aa.destinationlocationtno = a.destinationlocationtno
                and nvl(aa.InternalTransferDate, do.deliveryorderdate) = nvl(:P265_ASONDATE, TRUNC(SYSDATE))
                group by
                DO.partyDOno,
                aa.sourcelocationtno,
                aa.destinationlocationtno,
                aa.InternalTransferDATE
                ) internalTransferDate
                from InternalTransfer A, DeliveryOrder B
                where A.DeliveryOrderTno = B.Tno(+)
                and NVL(a.InternalTransferDate,B.DELIVERYORDERDATE) <= nvl(:P265_ASONDATE, TRUNC(SYSDATE))
                and B.PartyDoNo is not null
                group by
                B.partyDOno,
                A.sourcelocationtno,
                A.destinationlocationtno) t
                Where a.SourceLocationTno = sl.Tno(+)
                and a.DestinationLocationTno = dl.Tno(+)
                and a.Tno = do.Tno
                and a.PartyCode = pa.PartyCode(+)
                and a.DoctypeCode = dc.DoctypeCode(+)
                and a.PartyDoNo = t.PartyDONo(+)
                and a.SourceLocationTno = t.SourcelocationTno(+)
                and a.DestinationLocationTno = t.DestinationLocationTno(+))x
                WHERE ( :P265_COMPANY IS NULL OR INSTR(':'||:P265_COMPANY||':',':'||x.CompanyCode||':') > 0 )
                and ( :P265_DELIVERYORDERNO IS NULL OR INSTR(':'||:P265_DELIVERYORDERNO||':',':'||x.TNo||':') > 0 )
                and ( :P265_PARTYDONO IS NULL OR INSTR(':'||:P265_PARTYDONO||':',':'||x.TNo||':') > 0 )
                and ( :P265_PARTY IS NULL OR INSTR(':'||:P265_PARTY||':',':'||x.PartyCode||':') > 0 )
                and ( :P265_DOCTYPE IS NULL OR INSTR(':'||:P265_DOCTYPE||':',':'||x.DoctypeCode||':') > 0 )
                and ( :P265_SOURCE IS NULL OR INSTR(':'||:P265_SOURCE||':',':'||x.SourceLocationTno||':') > 0 )
                and ( :P265_DESTINATION IS NULL OR INSTR(':'||:P265_DESTINATION||':',':'||x.DestinationLocationTno||':') > 0 )
                and((nvl(x.DOQuantity, 0) - nvl(x.TillDateLifting, 0) - nvl(x.LapsedQty, 0) > 0
                   and :P265_BALANCEQTY = 'ONLYBALANCEQUANTITY'
                   )
                   or 
                   (
                   nvl(x.DOQuantity, 0) - nvl(x.TillDateLifting, 0) - nvl(x.LapsedQty, 0) = 0
                   and :P265_BALANCEQTY = 'ZEROBALANCEQUANTITY'
                   )
                  or :P265_BALANCEQTY is null
                  )
                and x.doctypecode = 'INTERNALTRANSFER' 
                and :P265_ASONDATE BETWEEN X.FROMDATE AND X.TODATE
                
                UNION ALL
                
                Select
                x.Tno,
                x.CompanyCode,
                x.CompanyName,
                x.DoctypeCode,
                x.DoctypeName,
                x.DeliveryOrderNo,
                x.DeliveryOrderDate,
                x.SourceLocationTno,
                x.DestinationLocationTno,
                x.PartyCode,
                x.PartyName,
                x.PartyDoNo,
                x.NoOfTrip,
                x.ASONDATE,
                x.Mines,
                X.gpDate,
                NULL AS INTERNALTRANSFERDATE,
                x.FromDate,
                x.ToDate,
                x.DOQuantity,
                x.TodaysLifting,
                x.TillDateLifting,
                x.LapsedQty,
                nvl(x.DOQuantity, 0) - nvl(x.TillDateLifting, 0) - nvl(x.LapsedQty, 0) as BalanceQty,
                round(((nvl(x.DOQuantity, 0) - nvl(x.TillDateLifting, 0) - nvl(x.LapsedQty, 0)) / nvl(x.BalanceDays, 1)),3)as AskingRate,
                x.PercentLifting,
                x.BalanceDays
                From
                (Select
                a.Tno,
                a.PartyCode,
                a.DoctypeCode,
                a.CompanyCode,
                GetCompanyName(a.CompanyCode) as CompanyName,
                dc.DoctypeName,
                a.DeliveryOrderNo,
                pa.PartyName,
                a.PartyDoNo,
                t.NoOfTrip,
                :P265_ASONDATE AS ASONDATE,
                case when a.DeliveryOrderDate = do.fromdate then a.deliveryorderdate
                else a.deliveryorderdate 
                end as deliveryorderdate,
                NULL AS INTERNALTRANSFERDATE,
                t.GPDate,
                do.FromDate,
                do.ToDate,
                a.SourceLocationTno,
                a.DestinationLocationTno,
                sl.SourceLocationName || '-' || dl.DestinationLocationName as Mines,
                a.DOQuantity,
                nvl(t.TodaysLifting,0) as TodaysLifting,
                nvl(t.TillDateLifting,0) as TillDateLifting,
                Case When  do.ToDate < nvl(TO_DATE(:P265_ASONDATE,'dd-mm-rrrr'), TRUNC(SYSDATE)) then a.DoQuantity - t.TillDateLifting  
                else null 
                end as LapsedQty,
                round(DECODE(a.DoQuantity,0,0,((t.TillDateLifting/a.DoQuantity)*100)),2) as PercentLifting,
                Case When do.ToDate > nvl(TO_DATE(:P265_ASONDATE,'dd-mm-rrrr'), TRUNC(SYSDATE)) then
                do.ToDate - nvl(TO_DATE(:P265_ASONDATE,'dd-mm-rrrr'), TRUNC(SYSDATE))
                ELSE null 
                end as BalanceDays
                From DeliveryOrderReport a, SourceLocation sl, DestinationLocation dl,DeliveryOrder do,Party pa,Doctype dc,
                (Select 
                a.partyrefno,
                a.sourcelocationtno,
                a.destinationlocationtno,
                sum(A.quantity1) as TillDatelifting,
                nvl((
                Select
                sum(aa.quantity1) 
                from lr aa, DeliveryOrder do
                where aa.DeliveryOrderTno = do.Tno
                and aa.PartyRefNo = a.PartyRefNo
                and aa.sourcelocationtno = a.sourcelocationtno
                and aa.destinationlocationtno = a.destinationlocationtno
                and nvl(aa.GPDate,do.DeliveryOrderDate) = nvl(:P265_ASONDATE, TRUNC(SYSDATE))
                group by
                aa.partyrefno,
                aa.sourcelocationtno,
                aa.destinationlocationtno
                ),0) Todayslifting,
                nvl((
                Select
                Count(aa.Lrno) as NoOfTrip
                from lr aa, DeliveryOrder do
                where aa.DeliveryOrderTno = do.Tno
                and aa.PartyRefNo = a.PartyRefNo
                and aa.sourcelocationtno = a.sourcelocationtno
                and aa.destinationlocationtno = a.destinationlocationtno
                and nvl(aa.GPDate, do.DeliveryOrderDate) = nvl(:P265_ASONDATE, TRUNC(SYSDATE))
                group by
                aa.partyrefno,
                aa.sourcelocationtno,
                aa.destinationlocationtno
                ),0) NoOfTrip,
                (
                Select
                aa.GPDate
                from lr aa, DeliveryOrder do
                where aa.DeliveryOrderTno = do.Tno 
                and aa.PartyRefNo = a.PartyRefNo
                and aa.sourcelocationtno = a.sourcelocationtno
                and aa.destinationlocationtno = a.destinationlocationtno
                and nvl(aa.GPDate, do.DeliveryOrderDate) = nvl(:P265_ASONDATE, TRUNC(SYSDATE))
                group by
                aa.partyrefno,
                aa.sourcelocationtno,
                aa.destinationlocationtno,
                aa.GPDATE
                ) GPDate
                from lr A, DeliveryOrder do
                where a.DeliveryOrderTno = do.Tno
                and nvl(a.GPDate,do.DeliveryOrderDate) <= nvl(:P265_ASONDATE, TRUNC(SYSDATE))
                and a.Partyrefno is not null
                group by
                A.partyrefno,
                A.sourcelocationtno,
                A.destinationlocationtno) t
                Where a.SourceLocationTno = sl.Tno(+)
                and a.DestinationLocationTno = dl.Tno(+)
                and a.Tno = do.Tno
                and a.PartyCode = pa.PartyCode(+)
                and a.DoctypeCode = dc.DoctypeCode(+)
                and a.PartyDoNo = t.PartyRefNo(+)
                and a.SourceLocationTno = t.SourcelocationTno(+)
                and a.DestinationLocationTno = t.DestinationLocationTno(+))x
                WHERE ( :P265_COMPANY IS NULL OR INSTR(':'||:P265_COMPANY||':',':'||x.CompanyCode||':') > 0 )
                and ( :P265_DELIVERYORDERNO IS NULL OR INSTR(':'||:P265_DELIVERYORDERNO||':',':'||x.TNo||':') > 0 )
                and ( :P265_PARTYDONO IS NULL OR INSTR(':'||:P265_PARTYDONO||':',':'||x.TNo||':') > 0 )
                and ( :P265_PARTY IS NULL OR INSTR(':'||:P265_PARTY||':',':'||x.PartyCode||':') > 0 )
                and ( :P265_DOCTYPE IS NULL OR INSTR(':'||:P265_DOCTYPE||':',':'||x.DoctypeCode||':') > 0 )
                and ( :P265_SOURCE IS NULL OR INSTR(':'||:P265_SOURCE||':',':'||x.SourceLocationTno||':') > 0 )
                and ( :P265_DESTINATION IS NULL OR INSTR(':'||:P265_DESTINATION||':',':'||x.DestinationLocationTno||':') > 0 )
                and((nvl(x.DOQuantity, 0) - nvl(x.TillDateLifting, 0) - nvl(x.LapsedQty, 0) > 0
                   and :P265_BALANCEQTY = 'ONLYBALANCEQUANTITY'
                  )
                   or 
                   (
                   nvl(x.DOQuantity, 0) - nvl(x.TillDateLifting, 0) - nvl(x.LapsedQty, 0) = 0
                   and :P265_BALANCEQTY = 'ZEROBALANCEQUANTITY'
                   )
                   or :P265_BALANCEQTY is null
                   )
                and x.doctypecode != 'INTERNALTRANSFER' 
                and :P265_ASONDATE BETWEEN X.FROMDATE AND X.TODATE;
                
                
                
                
                   
                
                ```
        }
