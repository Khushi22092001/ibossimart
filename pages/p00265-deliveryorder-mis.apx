    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @mis
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 140
            region: @delivery-order-mis
            slot: regionBody
            column: 10
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

