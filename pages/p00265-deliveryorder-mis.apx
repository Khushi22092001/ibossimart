    pageItem P265_BALANCEQTY (
        type: popupLov
        label {
            label: Balance Qty
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                'Zero Balance Quantity' as d,
                'ZEROBALANCEQUANTITY' as r
                From Dual
                UNION ALL
                Select
                'Only Balance Quantity' as d,
                'ONLYBALANCEQUANTITY' as r
                From Dual
                ```
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 120
            region: @delivery-order-mis
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
            columnAttributes: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Balance Qty Type
        }
    )

    pageItem P265_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.CompanyName d,
                a.CompanyCode r
                From Company a
                Where exists(
                   Select
                      aa.Tno
                   From Deliveryorder aa
                   Where aa.companyCode = a.companyCode
                )
                Order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @delivery-order-mis
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Company Name
        }
    )

