page 419 (
    name: Trip Driver Wise Detail
    alias: TRIP-DRIVER-WISE-DETAIL
    title: Trip Driver Wise Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report-detail (
        name: Report Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  row_number() over(order by x.GPDate) SerialNo,
                  x.LocationName,
                  x.PartyDONo,
                  x.GPDate,
                  x.GPNo,
                  x.LoadingQuantity1,
                  x.UnloadingDate,
                  x.UnloadingQuantity1,
                  x.SourceLocationName,
                  x.DestinationLocationName,
                  x.DriverName,
                  x.VehicleNo,
                  x.PartyName
                From
                (
                Select 
                	a.Tno,
                	c.LocationName,
                	b.PartyRefNo as PartyDONo,
                	b.GPDate,
                	b.GPNo,
                	b.Quantity1 as LoadingQuantity1,
                	f.PODDate as UnloadingDate,
                	e.Quantity1 as UnloadingQuantity1,
                	g.SourceLocationName,
                	h.DestinationLocationName,
                	i.EmployeeName as DriverName,
                	b.VehicleNo,
                	j.PartyName,
                  d.DriverCode
                From NecessitySlipTrip a, LR b, Location c, Placement d,PODDetail e, POD f, SourceLocation g, DestinationLocation h, Employee i,
                Party j, CompanyVehicle k, VehicleType l
                Where a.ModuleTno = b.Tno
                	and b.LocationCode = c.LocationCode(+)
                	and b.PlacementTno = d.Tno(+)
                	and b.Tno = e.LRTno(+)
                	and e.Tno = f.Tno(+)
                	and b.SourceLocationTno = g.Tno(+) 
                	and b.DestinationLOcationTno = h.Tno(+)
                	and d.DriverCode = i.EmployeeCode(+)
                	and b.PartyCode = j.PartyCode (+)
                	and b.VehicleNo = k.CompanyVehicleNo(+)
                	and k.VehicleTypeCode = l.VehicleTypeCode(+)
                  and b.PartyCode = :P419_PARTY
                  and d.DriverCode = :P419_DRIVER
                  and b.LocationCode = :P419_LOCATION
                UNION ALL
                Select 
                	a.Tno,
                	c.LocationName,
                	h.PartyDONo,
                	b.LoadingDate as GPDate,
                	b.GPNo,
                	b.LoadingQuantity1,
                	b.UnloadingDate,
                	b.UnloadingQuantity1,
                	d.SourceLocationName,
                	e.DestinationLocationName,
                	f.EmployeeName as DriverName,
                	b.VehicleNo,
                	i.PartyName,
                  b.DriverCode
                From NecessitySlipTrip a, InternalTransfer b, Location c, SourceLocation d, DestinationLocation e, Employee f, DeliveryOrderDetail g,
                DeliveryOrder h, Party i, CompanyVehicle j, VehicleType k
                Where a.ModuleTno = b.Tno
                	and b.LocationCode = c.LocationCode(+)
                	and b.SourceLocationTno = d.Tno(+)
                	and b.DestinationLocationTno = e.Tno(+)
                	and b.DriverCode = f.EmployeeCode(+)
                	and b.DeliveryOrderTno = g.Tno(+)
                	and b.DeliveryOrderSno = g.Sno(+)
                	and g.Tno = h.Tno(+)
                	and b.PartyCode = i.PartyCode(+)
                	and b.VehicleNo = j.CompanyVehicleNo(+)
                	and j.VehicleTypeCode = k.VehicleTypeCode(+)
                  and b.PartyCode = :P419_PARTY
                  and b.DriverCode = :P419_DRIVER
                  and b.LocationCode = :P419_LOCATION
                  --and ( :P419_DRIVER IS NULL OR instr(':'||:P419_DRIVER||':',':'||b.DriverCode||':') > 0)
                  --and ( :P419_PARTY IS NULL OR instr(':'||:P419_PARTY||':',':'||b.PartyCode||':') > 0)
                  --and ( :P419_LOCATION IS NULL OR instr(':'||:P419_LOCATION||':',':'||b.LocationCode||':') > 0)
                ) x
                Where :P408_FILTERFROM = 'PARENT'
                and exists(
                Select
                aa.Tno
                From TruckDieselReportTable aa
                Where ( :P419_COMPANY IS NULL OR instr(':'||:P419_COMPANY||':',':'||aa.CompanyCode||':') > 0)
                and ( :P419_VEHICLE IS NULL OR instr(':'||:P419_VEHICLE||':',':'||aa.VehicleNO||':') > 0)
                and aa.Creator = :APP_USER
                and aa.PageNo = 400
                and aa.Tno = x.Tno
                )
                UNION ALL
                Select
                  row_number() over(order by x.GPDate) SerialNo,
                  x.LocationName,
                  x.PartyDONo,
                  x.GPDate,
                  x.GPNo,
                  x.LoadingQuantity1,
                  x.UnloadingDate,
                  x.UnloadingQuantity1,
                  x.SourceLocationName,
                  x.DestinationLocationName,
                  x.DriverName,
                  x.VehicleNo,
                  x.PartyName
                From
                (
                Select 
                	a.Tno,
                	c.LocationName,
                	b.PartyRefNo as PartyDONo,
                	b.GPDate,
                	b.GPNo,
                	b.Quantity1 as LoadingQuantity1,
                	f.PODDate as UnloadingDate,
                	e.Quantity1 as UnloadingQuantity1,
                	g.SourceLocationName,
                	h.DestinationLocationName,
                	i.EmployeeName as DriverName,
                	b.VehicleNo,
                	j.PartyName,
                  d.DriverCode
                From NecessitySlipTrip a, LR b, Location c, Placement d,PODDetail e, POD f, SourceLocation g, DestinationLocation h, Employee i,
                Party j, CompanyVehicle k, VehicleType l
                Where a.ModuleTno = b.Tno
                	and b.LocationCode = c.LocationCode(+)
                	and b.PlacementTno = d.Tno(+)
                	and b.Tno = e.LRTno(+)
                	and e.Tno = f.Tno(+)
                	and b.SourceLocationTno = g.Tno(+) 
                	and b.DestinationLOcationTno = h.Tno(+)
                	and d.DriverCode = i.EmployeeCode(+)
                	and b.PartyCode = j.PartyCode (+)
                	and b.VehicleNo = k.CompanyVehicleNo(+)
                	and k.VehicleTypeCode = l.VehicleTypeCode(+)
                  and b.PartyCode = :P419_PARTY
                  and d.DriverCode = :P419_DRIVER
                  and b.LocationCode = :P419_LOCATION
                UNION ALL
                Select 
                	a.Tno,
                	c.LocationName,
                	h.PartyDONo,
                	b.LoadingDate as GPDate,
                	b.GPNo,
                	b.LoadingQuantity1,
                	b.UnloadingDate,
                	b.UnloadingQuantity1,
                	d.SourceLocationName,
                	e.DestinationLocationName,
                	f.EmployeeName as DriverName,
                	b.VehicleNo,
                	i.PartyName,
                  b.DriverCode
                From NecessitySlipTrip a, InternalTransfer b, Location c, SourceLocation d, DestinationLocation e, Employee f, DeliveryOrderDetail g,
                DeliveryOrder h, Party i, CompanyVehicle j, VehicleType k
                Where a.ModuleTno = b.Tno
                	and b.LocationCode = c.LocationCode(+)
                	and b.SourceLocationTno = d.Tno(+)
                	and b.DestinationLocationTno = e.Tno(+)
                	and b.DriverCode = f.EmployeeCode(+)
                	and b.DeliveryOrderTno = g.Tno(+)
                	and b.DeliveryOrderSno = g.Sno(+)
                	and g.Tno = h.Tno(+)
                	and b.PartyCode = i.PartyCode(+)
                	and b.VehicleNo = j.CompanyVehicleNo(+)
                	and j.VehicleTypeCode = k.VehicleTypeCode(+)
                  and b.PartyCode = :P419_PARTY
                  and b.DriverCode = :P419_DRIVER
                  and b.LocationCode = :P419_LOCATION
                  --and ( :P419_DRIVER IS NULL OR instr(':'||:P419_DRIVER||':',':'||b.DriverCode||':') > 0)
                  --and ( :P419_PARTY IS NULL OR instr(':'||:P419_PARTY||':',':'||b.PartyCode||':') > 0)
                  --and ( :P419_LOCATION IS NULL OR instr(':'||:P419_LOCATION||':',':'||b.LocationCode||':') > 0)
                ) x
                Where nvl(:P408_FILTERFROM, 'PARENT2') = 'PARENT2'
                and exists(
                Select
                aa.Tno
                From TruckDieselReportTable aa
                Where ( :P419_COMPANY IS NULL OR instr(':'||:P419_COMPANY||':',':'||aa.CompanyCode||':') > 0)
                and ( :P419_VEHICLE IS NULL OR instr(':'||:P419_VEHICLE||':',':'||aa.VehicleNO||':') > 0)
                and aa.Creator = :APP_USER
                and aa.PageNo = 480
                and aa.Tno = x.Tno
                )
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 32748824630015580
        }

        column DESTINATIONLOCATIONNAME (
            type: plainText
            heading {
                heading: Destination Location Name
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column DRIVERNAME (
            type: plainText
            heading {
                heading: Driver Name
                alignment: center
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column GPDATE (
            type: plainText
            heading {
                heading: GP Date
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column GPNO (
            type: plainText
            heading {
                heading: GP No
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column LOADINGQUANTITY1 (
            type: plainText
            heading {
                heading: Loading Quantity
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location Name
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column PARTYDONO (
            type: plainText
            heading {
                heading: Partydono
                alignment: center
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column PARTYNAME (
            type: plainText
            heading {
                heading: Party Name
                alignment: center
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column SOURCELOCATIONNAME (
            type: plainText
            heading {
                heading: Source Location Name
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column UNLOADINGDATE (
            type: plainText
            heading {
                heading: Unloading Date
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column UNLOADINGQUANTITY1 (
            type: plainText
            heading {
                heading: "Unloading  Quantity "
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: Vehicleno
                alignment: center
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report Detail
        }

        savedReport 143540 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESTINATIONLOCATIONNAME (
                sequence: 10
            )

            displayColumn DRIVERNAME (
                sequence: 8
            )

            displayColumn GPDATE (
                sequence: 3
            )

            displayColumn GPNO (
                sequence: 4
            )

            displayColumn LOADINGQUANTITY1 (
                sequence: 5
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn PARTYNAME (
                sequence: 11
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SOURCELOCATIONNAME (
                sequence: 9
            )

            displayColumn UNLOADINGDATE (
                sequence: 6
            )

            displayColumn UNLOADINGQUANTITY1 (
                sequence: 7
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: LOADINGQUANTITY1
            )

            aggregate (
                column: UNLOADINGQUANTITY1
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region trip-detail (
        name: "Trip Detail "
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
            column: 1
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P419_COMPANY (
        type: hidden
        layout {
            sequence: 10
            region: @trip-detail
            slot: regionBody
        }
    )

    pageItem P419_DRIVER (
        type: hidden
        layout {
            sequence: 60
            region: @trip-detail
            slot: regionBody
        }
    )

    pageItem P419_FILTERFROM (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @trip-detail
            slot: regionBody
        }
    )

    pageItem P419_FROMDATE (
        type: hidden
        layout {
            sequence: 20
            region: @trip-detail
            slot: regionBody
        }
    )

    pageItem P419_LOCATION (
        type: hidden
        layout {
            sequence: 40
            region: @trip-detail
            slot: regionBody
        }
    )

    pageItem P419_PARTY (
        type: hidden
        layout {
            sequence: 70
            region: @trip-detail
            slot: regionBody
        }
    )

    pageItem P419_TODATE (
        type: hidden
        layout {
            sequence: 30
            region: @trip-detail
            slot: regionBody
        }
    )

    pageItem P419_TRANSPORTER (
        type: hidden
        layout {
            sequence: 50
            region: @trip-detail
            slot: regionBody
        }
    )

    pageItem P419_VEHICLE (
        type: hidden
        layout {
            sequence: 80
            region: @trip-detail
            slot: regionBody
        }
    )

    pageItem P419_VEHICLETYPE (
        type: hidden
        layout {
            sequence: 90
            region: @trip-detail
            slot: regionBody
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

