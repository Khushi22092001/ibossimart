page 339 (
    name: Vehicle Performance Vehicle Wise (DO)
    alias: VEHICLE-PERFORMANCE-VEHICLE-DO
    title: Vehicle Performance Vehicle (DO)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region vehicle-performance-vehicle-wise (
        name: Vehicle Performance Vehicle Wise
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With t_OpenBilled as (
                Select
                	a.CompanyCode,
                	a.VehicleNo,
                	sum(a.Quantity1) as OpenBilledQuantity,
                	count(a.Tno) as OpenBilledNoOfTrip,
                	round(sum(nvl(a.Quantity1,0)* nvl(e.NetFreightRate,0)), 2) as OpenBilledAmount
                From LR a, LoadingOrder b, DeliveryOrderDetail c, DeliveryOrder d, DOExpensesDetail e, DocumentStatusDetail dsd
                Where a.LoadingOrderTno = b.Tno
                	and b.DeliveryOrderTno = c.Tno
                	and b.DeliveryOrderSno = c.Sno
                  and c.Tno = d.Tno
                  and c.Tno = e.DeliveryOrderTno(+)
                  and c.Sno = e.DeliveryOrderSno(+)
                	and a.Tno = dsd.ModuleTno
                	and d.DocTypeCode = 'OPEN'
                	and a.VehicleGroupCode = 'SELF'
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and exists(
                		Select
                			aa.Tno
                		From ServiceBillLR aa
                		Where aa.LRTno = a.Tno
                		)
                	and nvl(a.GPDate, a.LRDate) between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	a.VehicleNo
                ), t_CloseBilled as (
                Select
                	a.CompanyCode,
                	a.VehicleNo,
                	sum(a.Quantity1) as CloseBilledQuantity,
                	count(a.Tno) as CloseBilledNoOfTrip,
                	round(sum(nvl(a.Quantity1,0)* nvl(e.NetFreightRate,0)), 2) as CloseBilledAmount
                From LR a, LoadingOrder b, DeliveryOrderDetail c, DeliveryOrder d, DOExpensesDetail e, DocumentStatusDetail dsd
                Where a.LoadingOrderTno = b.Tno
                	and b.DeliveryOrderTno = c.Tno
                	and b.DeliveryOrderSno = c.Sno
                  and c.Tno = d.Tno
                  and c.Tno = e.DeliveryOrderTno(+)
                  and c.Sno = e.DeliveryOrderSno(+)
                	and a.Tno = dsd.ModuleTno
                	and d.DocTypeCode = 'CLOSE'
                	and a.VehicleGroupCode = 'SELF'
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and exists(
                		Select
                			aa.Tno
                		From ServiceBillLR aa
                		Where aa.LRTno = a.Tno
                		)
                	and nvl(a.GPDate, a.LRDate) between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	a.VehicleNo
                ), t_InternalTransforBilled as (
                Select
                	a.CompanyCode,
                	a.VehicleNo,
                	sum(a.LoadingQuantity1) as ITBilledQuantity,
                	count(a.Tno) as ITBilledNoOfTrip,
                	round(sum(nvl(a.LoadingQuantity1,0)* nvl(e.NetFreightRate,0)), 2) as ITBilledAmount
                From InternalTransfer a, DeliveryOrderDetail c, DeliveryOrder d, DOExpensesDetail e, DocumentStatusDetail dsd
                Where a.DeliveryOrderTno = c.Tno
                	and a.DeliveryOrderSno = c.Sno
                	and c.Tno = d.Tno
                	and c.Tno = e.DeliveryOrderTno(+)
                	and c.Sno = e.DeliveryOrderSno(+)
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and d.DocTypeCode = 'INTERNALTRANSFER'
                	and a.VehicleGroupCode = 'SELF'
                	and exists(
                			Select
                				aa.Tno
                			From ServiceBillInternalTransfer aa
                			Where aa.InternalTransferTno = a.Tno
                			)
                	and a.InternalTransferDate between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	a.VehicleNo
                ), t_OpenUnbilled as (
                Select
                	a.CompanyCode,
                	a.VehicleNo,
                	sum(a.Quantity1) as OpenUnbilledQuantity,
                	count(a.Tno) as OpenUnbilledNoOfTrip,
                	sum(nvl(a.Quantity1, 0) * nvl(e.NetFreightRate, 0)) as OpenUnbilledAmount
                From LR a, LoadingOrder b, DeliveryOrderDetail c, DeliveryOrder d, DOExpensesDetail e, DocumentStatusDetail dsd
                Where a.LoadingOrderTno = b.Tno
                	and b.DeliveryOrderTno = c.Tno
                	and b.DeliveryOrderSno = c.Sno
                	and c.Tno = d.Tno
                	and c.Tno = e.DeliveryOrderTno(+)
                	and c.Sno = e.DeliveryOrderSno(+)
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and d.DocTypeCode = 'OPEN'
                	and a.VehicleGroupCode = 'SELF'
                	and not exists(
                			Select
                				aa.Tno
                			From ServiceBillLR aa
                			Where aa.LRTno = a.Tno
                			)
                	and nvl(a.GPDate, a.LRDate) between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	a.VehicleNo
                ), t_CloseUnbilled as (
                Select
                	a.CompanyCode,
                	a.VehicleNo,
                	sum(a.Quantity1) as CloseUnbilledQuantity,
                	count(a.Tno) as CloseUnbilledNoOfTrip,
                	sum(nvl(a.Quantity1, 0) * nvl(e.NetFreightRate, 0)) as CloseUnbilledAmount
                From LR a, LoadingOrder b, DeliveryOrderDetail c, DeliveryOrder d, DOExpensesDetail e, DocumentStatusDetail dsd
                Where a.LoadingOrderTno = b.Tno
                	and b.DeliveryOrderTno = c.Tno
                	and b.DeliveryOrderSno = c.Sno
                	and c.Tno = d.Tno
                	and c.Tno = e.DeliveryOrderTno(+)
                	and c.Sno = e.DeliveryOrderSno(+)
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and d.DocTypeCode = 'CLOSE'
                	and a.VehicleGroupCode = 'SELF'
                	and not exists(
                			Select
                				aa.Tno
                			From ServiceBillLR aa
                			Where aa.LRTno = a.Tno
                			)
                	and nvl(a.GPDate, a.LRDate) between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	a.VehicleNo
                ), t_InternalTransforUnbilled as (
                Select
                	a.CompanyCode,
                	a.VehicleNo,
                	sum(a.UnloadingQuantity1) as ITUnbilledQuantity,
                	count(a.Tno) as ITUnbilledNoOfTrip,
                	sum(nvl(a.UnloadingQuantity1, 0) * nvl(e.NetFreightRate, 0)) as ITUnbilledAmount
                From InternalTransfer a, DeliveryOrderDetail c, DeliveryOrder d, DOExpensesDetail e, DocumentStatusDetail dsd
                Where a.DeliveryOrderTno = c.Tno
                	and a.DeliveryOrderSno = c.Sno
                	and c.Tno = d.Tno
                	and c.Tno = e.DeliveryOrderTno(+)
                	and c.Sno = e.DeliveryOrderSno(+)
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and d.DocTypeCode = 'INTERNALTRANSFER'
                	and a.VehicleGroupCode = 'SELF'
                	and not exists(
                			Select
                				aa.Tno
                			From ServiceBillInternalTransfer aa
                			Where aa.InternalTransferTno = a.Tno
                			)
                	and a.InternalTransferDate between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	a.VehicleNo
                ), t_TyreAmount as (
                Select
                	a.CompanyCode,
                	x.CostCentreCode as VehicleNo,
                	sum(round(nvl(c.Quantity1, 0) * nvl(d.Rate, 0), 2)) as Amount
                From Issue a, IssueDetail b, IssueStockStorageDetail c, Stock d, Item f, DocumentStatusDetail dsd,
                (
                Select
                	a.Tno,
                	a.Sno,
                	a.CostCentreCode
                From IssueCostCentreDetail a
                ) x
                Where a.Tno = b.Tno
                	and b.Tno = c.Tno
                    and b.Sno = c.Sno
                	and b.Tno = x.Tno
                	and b.Sno = x.Sno
                   and c.StockTno = d.Tno
                   and b.ItemCode = f.ItemCode
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and b.ItemCode = 'TYRE'
                	and exists(
                		Select
                			aa.Tno
                		From IssueCostCentreDetail aa
                		Where GetVehicleGroupCode(aa.CostCentreCode, :P339_FROMDATE) = 'SELF'
                			and aa.Tno = a.Tno
                		UNION ALL
                		Select
                			aa.Tno
                		From IssueCostCentreDetail aa, Equipment bb
                		Where aa.CostCentreCode = bb.CostCentreCode
                			and aa.Tno = a.Tno
                		)
                    and a.IssueDate between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	x.CostCentreCode
                ), t_DieselAmount as (
                Select
                x.CompanyCode,
                x.VehicleNo,
                round(sum(x.Amount), 2) as Amount
                From
                	(
                	Select
                		a.CompanyCode,
                		a.VehicleNo,
                		nvl(b.Quantity1, 0) * nvl(b.DieselRate, 0) as Amount
                	From NecessitySlip a, NecessitySlipDetail b, DocumentStatusDetail dsd
                	Where a.Tno = b.Tno
                		and a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.PartyCode is not null
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                		and b.VehicleNecessityCode in (Select a.VehicleNecessityCode From VehicleNecessityForFuel a)
                        and a.NecessitySlipDate between :P339_FROMDATE and :P339_TODATE
                	UNION ALL
                	Select
                		a.CompanyCode,
                		a.VehicleNo,
                		g.Amount
                	From NecessitySlip a, NecessitySlipDetail b, Requisition c, Issue d, Voucher e, VoucherDetail f, VoucherCostCentreDetail g, DocumentStatusDetail dsd
                	Where a.Tno = b.Tno
                		and a.Tno = c.ModuleTno
                		and c.Tno = d.RequisitionTno
                		and d.Tno = e.ModuleTno
                		and e.Tno = f.Tno
                		and f.Tno = g.Tno
                		and f.Sno = g.Sno
                		and a.VehicleNo = g.CostCentreCode
                		and a.VehicleGroupCode = 'SELF'
                		and b.VehicleNecessityCode in (Select a.VehicleNecessityCode From VehicleNecessityForFuel a)
                		and a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                        and a.NecessitySlipDate between :P339_FROMDATE and :P339_TODATE
                	) x
                Group by
                	x.CompanyCode,
                	x.VehicleNo
                ), t_SpareAmount as (
                /*Select
                	a.CompanyCode,
                	sum(e.Amount) as Amount
                From Issue a, IssueDetail b, Voucher c, VoucherDetail d, VoucherCostCentreDetail e, Item f, DocumentStatusDetail dsd
                Where a.Tno = b.Tno
                	and a.Tno = c.ModuleTno
                	and c.Tno = d.Tno
                	and d.Tno = e.Tno
                	and d.Sno = e.Sno
                    and b.ItemCode = f.ItemCode
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and f.ParentCode = '19145'
                    and a.IssueDate between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode
                */
                Select
                	a.CompanyCode,
                	x.VehicleNo,
                	sum(nvl(c.Quantity1, 0) * nvl(d.Rate, 0)) as Amount
                From Issue a, IssueDetail b, IssueStockStorageDetail c, Stock d, Item f, DocumentStatusDetail dsd,
                (
                Select
                	a.Tno,
                	a.Sno,
                	a.CostCentreCode as VehicleNo
                From IssueCostCentreDetail a
                ) x
                Where a.Tno = b.Tno
                	and b.Tno = c.Tno
                    and b.Sno = c.Sno
                	and b.Tno = x.Tno
                	and b.Sno = x.Sno
                    and c.StockTno = d.Tno
                    and b.ItemCode = f.ItemCode
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and f.ParentCode = '19145'
                	and exists(
                		Select
                			aa.Tno
                		From IssueCostCentreDetail aa
                		Where GetVehicleGroupCode(aa.CostCentreCode, :P339_FROMDATE) = 'SELF'
                			and aa.Tno = a.Tno
                		UNION ALL
                		Select
                			aa.Tno
                		From IssueCostCentreDetail aa, Equipment bb
                		Where aa.CostCentreCode = bb.CostCentreCode
                			and aa.Tno = a.Tno
                		)
                    and a.IssueDate between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	x.VehicleNo
                ), t_DAAmount as (
                Select
                	x.CompanyCode,
                	x.VehicleNo,
                sum(x.Amount) as Amount
                From
                	(
                	Select
                		a.CompanyCode,
                		a.VehicleNo,
                		a.Amount
                	From FreightAdvance a, DocumentStatusDetail dsd
                	Where a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.DrAccountCode = 'ALLOWANCETODRIVER'
                		and nvl(a.Amount, 0) > 0
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                        and a.FreightAdvanceDate between :P339_FROMDATE and :P339_TODATE
                	UNION ALL
                	Select
                		a.CompanyCode,
                		a.VehicleNo,
                		a.Amount2 as Amount
                	From FreightAdvance a, DocumentStatusDetail dsd
                	Where a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.DrAccountCode2 = 'ALLOWANCETODRIVER'
                		and nvl(a.Amount2, 0) > 0
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                        and a.FreightAdvanceDate between :P339_FROMDATE and :P339_TODATE
                	) x
                Group by
                	x.CompanyCode,
                	x.VehicleNo
                ), t_BatteryAmount as (
                /*
                Select
                	a.CompanyCode,
                	sum(e.Amount) as Amount
                From Issue a, IssueDetail b, Voucher c, VoucherDetail d, VoucherCostCentreDetail e, Item f, DocumentStatusDetail dsd
                Where a.Tno = b.Tno
                	and a.Tno = c.ModuleTno
                	and c.Tno = d.Tno
                	and d.Tno = e.Tno
                	and d.Sno = e.Sno
                    and b.ItemCode = f.ItemCode
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and f.ParentCode = 'BATTERY'
                    and a.IssueDate between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode
                */
                Select
                	a.CompanyCode,
                	x.VehicleNo,
                	sum(nvl(c.Quantity1, 0) * nvl(d.Rate, 0)) as Amount
                From Issue a, IssueDetail b, IssueStockStorageDetail c, Stock d, Item f, DocumentStatusDetail dsd,
                (
                Select
                	a.Tno,
                	a.Sno,
                	a.CostCentreCode as VehicleNo
                From IssueCostCentreDetail a
                ) x
                Where a.Tno = b.Tno
                	and b.Tno = c.Tno
                    and b.Sno = c.Sno
                	and b.Tno = x.Tno
                	and b.Sno = x.Sno
                    and c.StockTno = d.Tno
                    and b.ItemCode = f.ItemCode
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and f.ParentCode = 'BATTERY'
                	and exists(
                		Select
                			aa.Tno
                		From IssueCostCentreDetail aa
                		Where GetVehicleGroupCode(aa.CostCentreCode, :P339_FROMDATE) = 'SELF'
                			and aa.Tno = a.Tno
                		UNION ALL
                		Select
                			aa.Tno
                		From IssueCostCentreDetail aa, Equipment bb
                		Where aa.CostCentreCode = bb.CostCentreCode
                			and aa.Tno = a.Tno
                		)
                    and a.IssueDate between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	x.VehicleNo
                ), t_TripExpenseAmount as (
                Select
                	x.CompanyCode,
                	x.VehicleNo,
                sum(x.Amount) as Amount
                From
                	(
                	Select
                		a.CompanyCode,
                		a.VehicleNo,
                		a.Amount
                	From FreightAdvance a, DocumentStatusDetail dsd
                	Where a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.DrAccountCode = 'TRIPEXPENSES'
                		and nvl(a.Amount, 0) > 0
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                        and a.FreightAdvanceDate between :P339_FROMDATE and :P339_TODATE
                	UNION ALL
                	Select
                		a.CompanyCode,
                		a.VehicleNo,
                		a.Amount2 as Amount
                	From FreightAdvance a, DocumentStatusDetail dsd
                	Where a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.DrAccountCode2 = 'TRIPEXPENSES'
                		and nvl(a.Amount2, 0) > 0
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                        and a.FreightAdvanceDate between :P339_FROMDATE and :P339_TODATE
                	) x
                Group by
                	x.CompanyCode,
                	x.VehicleNo
                ), t_TollAmount as (
                Select
                	x.CompanyCode,
                	x.VehicleNo,
                	sum(x.Amount) as Amount
                From
                	(
                	Select
                		a.CompanyCode,
                		a.VehicleNo,
                		b.Amount
                	From FreightAdvance a, FATollTaxSlipIssue b, DocumentStatusDetail dsd
                	Where a.Tno = b.Tno
                		and a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                        and a.FreightAdvanceDate between :P339_FROMDATE and :P339_TODATE
                	UNION ALL
                	Select
                		a.CompanyCode,
                		a.VehicleNo,
                		b.Amount
                	From LR a, LRTollTaxSlipIssue b, DocumentStatusDetail dsd
                	Where a.Tno = b.Tno
                		and a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                        and nvl(a.GPDate, a.LRDate) between :P339_FROMDATE and :P339_TODATE
                	) x
                Group by
                	x.CompanyCode,
                	x.VehicleNo
                ), tEMIAmount as (
                Select
                	a.CompanyCode,
                	d.CompanyVehicleNo as VehicleNo,
                	sum(b.InterestAmount) as Amount
                From Loan a, LoanDetail b, Equipment c, CompanyVehicle d, DocumentStatusDetail dsd
                Where a.Tno = b.Tno
                	and a.EquipmentTno = c.Tno
                	and c.Tno = d.ModuleTno
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and b.DueDate between :P339_FROMDATE and :P339_TODATE
                Group by
                	a.CompanyCode,
                	d.CompanyVehicleNo
                ), t_OtherAmount as (
                Select
                	x.CompanyCode,
                	x.VehicleNo,
                	sum(x.Amount) as Amount
                From
                	(
                	Select
                		a.CompanyCode,
                		x.VehicleNo,
                		sum(round(nvl(c.Quantity1, 0) * nvl(d.Rate, 0), 2)) as Amount
                	From Issue a, IssueDetail b, IssueStockStorageDetail c, Stock d, Item f, DocumentStatusDetail dsd,
                	(
                	Select
                		a.Tno,
                		a.Sno,
                		a.CostCentreCode as VehicleNo
                	From IssueCostCentreDetail a
                	) x
                	Where a.Tno = b.Tno
                		and b.Tno = c.Tno
                	    and b.Sno = c.Sno
                		and b.Tno = x.Tno
                		and b.Sno = x.Sno
                	    and c.StockTno = d.Tno
                	    and b.ItemCode = f.ItemCode
                		and a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and f.ParentCode not in ('BATTERY', '19145')
                    and exists(
                		Select
                			aa.Tno
                		From IssueCostCentreDetail aa
                		Where GetVehicleGroupCode(aa.CostCentreCode, :P339_FROMDATE) = 'SELF'
                			and aa.Tno = a.Tno
                		UNION ALL
                		Select
                			aa.Tno
                		From IssueCostCentreDetail aa, Equipment bb
                		Where aa.CostCentreCode = bb.CostCentreCode
                			and aa.Tno = a.Tno
                		)
                		and not exists(
                			Select
                				aa.Tno
                			From NecessitySlip aa, NecessitySlipDetail bb, Requisition cc
                			Where aa.Tno = bb.Tno
                				and bb.VehicleNecessityCode in (Select vn.VehicleNecessityCode From VehicleNecessityForFuel vn)
                				and aa.Tno = cc.ModuleTno
                        and cc.Tno = a.RequisitionTno
                			)
                	    and a.IssueDate between :P339_FROMDATE and :P339_TODATE
                	Group by
                		a.CompanyCode,
                		x.VehicleNo
                	UNION ALL
                	Select
                		a.CompanyCode,
                		nvl(a.VehicleNo, b.VehicleNo) as VehicleNo,
                		round(sum(b.TotalAmount), 2) as Amount
                	From NecessityCompletion a, NecessityCompletionDetail b, DocumentStatusDetail dsd
                	Where a.Tno = b.Tno
                		and a.Tno = dsd.ModuleTno
                		and b.NecessitySlipTno is null
                    and a.NecessityCompletionDate between :P339_FROMDATE and :P339_TODATE
                    and nvl(a.VehicleNo, b.VehicleNo) is not null
                	Group by 
                		a.CompanyCode,
                		nvl(a.VehicleNo, b.VehicleNo)
                	) x
                Group by
                	x.CompanyCode,
                	x.VehicleNo
                )
                Select
                	x.CompanyCode,
                	x.CompanyName,
                  x.VehicleNo,
                	x2.OpenBilledQuantity,
                	x2.OpenBilledNoOfTrip,
                	round(nvl(x2.OpenBilledAmount, 0), 2) as OpenBilledAmount,
                	x3.CloseBilledQuantity,
                	x3.CloseBilledNoOfTrip,
                	round(nvl(x3.CloseBilledAmount, 0), 2) as CloseBilledAmount,
                	x4.ITBilledQuantity,
                	x4.ITBilledNoOfTrip,
                	round(nvl(x4.ITBilledAmount, 0), 2) as ITBilledAmount,
                	----
                	x5.OpenUnbilledQuantity,
                	x5.OpenUnbilledNoOfTrip,
                	round(nvl(x5.OpenUnbilledAmount, 0), 2) as OpenUnbilledAmount,
                	x6.CloseUnbilledQuantity,
                	x6.CloseUnbilledNoOfTrip,
                	round(nvl(x6.CloseUnbilledAmount, 0), 2) as CloseUnbilledAmount,
                	x7.ITUnbilledQuantity,
                	x7.ITUnbilledNoOfTrip,
                	round(nvl(x7.ITUnbilledAmount, 0), 2) as ITUnbilledAmount,
                	round(nvl(x2.OpenBilledQuantity, 0), 2) + round(nvl(x3.CloseBilledQuantity, 0), 2) + round(nvl(x4.ITBilledQuantity, 0), 2) + round(nvl(x5.OpenUnbilledQuantity, 0), 2) + round(nvl(x6.CloseUnbilledQuantity, 0), 2) + round(nvl(x7.ITUnbilledQuantity, 0), 2) as TotalQuantity,
                	round(nvl(x2.OpenBilledNoOfTrip, 0), 2) + round(nvl(x3.CloseBilledNoOfTrip, 0), 2) + round(nvl(x4.ITBilledNoOfTrip, 0), 2) + round(nvl(x5.OpenUnbilledNoOfTrip, 0), 2) + round(nvl(x6.CloseUnbilledNoOfTrip, 0), 2) + round(nvl(x7.ITUnbilledNoOfTrip, 0), 2) as TotalNoOfTrip,
                	round(nvl(x2.OpenBilledAmount, 0), 2) + round(nvl(x3.CloseBilledAmount, 0), 2) + round(nvl(x4.ITBilledAmount, 0), 2) + round(nvl(x5.OpenUnbilledAmount, 0), 2) + round(nvl(x6.CloseUnbilledAmount, 0), 2) + round(nvl(x7.ITUnbilledAmount, 0), 2) as TotalAmount,
                	round(nvl(x9.Amount, 0), 2) as TyreAmount,
                	round(nvl(x10.Amount, 0), 2) as DieselAmount,
                	round(decode(round(nvl(x2.OpenBilledAmount, 0), 2) + round(nvl(x3.CloseBilledAmount, 0), 2) + round(nvl(x4.ITBilledAmount, 0), 2) + round(nvl(x5.OpenUnbilledAmount, 0), 2) + round(nvl(x6.CloseUnbilledAmount, 0), 2) + round(nvl(x7.ITUnbilledAmount, 0), 2), 0, 0, (nvl(x10.Amount, 0) * 100) / (round(nvl(x2.OpenBilledAmount, 0), 2) + round(nvl(x3.CloseBilledAmount, 0), 2) + round(nvl(x4.ITBilledAmount, 0), 2) + round(nvl(x5.OpenUnbilledAmount, 0), 2) + round(nvl(x6.CloseUnbilledAmount, 0), 2) + round(nvl(x7.ITUnbilledAmount, 0), 2))), 2) as DieselPercent,
                	round(nvl(x11.Amount, 0), 2) as SpareAmount,
                	round(nvl(x12.Amount, 0), 2) as DAAmount,
                	0 as SalaryAmount,
                	round(nvl(x13.Amount, 0), 2) as BatteryAmount,
                	round(nvl(x14.Amount, 0), 2) as TripExpensesAmount,
                	round(nvl(x15.Amount, 0), 2) as TollAmount,
                	round(nvl(x16.Amount, 0), 2) as EMIAmount,
                	round(nvl(x17.Amount, 0), 2) as OtherAmount,
                	(round(nvl(x2.OpenBilledAmount, 0), 2) + round(nvl(x3.CloseBilledAmount, 0), 2) + round(nvl(x4.ITBilledAmount, 0), 2) + round(nvl(x5.OpenUnbilledAmount, 0), 2) + round(nvl(x6.CloseUnbilledAmount, 0), 2) + round(nvl(x7.ITUnbilledAmount, 0), 2)) -
                	(
                	round(nvl(x9.Amount, 0), 2) + 
                	round(nvl(x10.Amount, 0), 2) + 
                	round(nvl(x11.Amount, 0), 2) + 
                	round(nvl(x12.Amount, 0), 2) +
                	round(nvl(x13.Amount, 0), 2) +
                	round(nvl(x14.Amount, 0), 2) +
                	round(nvl(x15.Amount, 0), 2) +
                	round(nvl(x16.Amount, 0), 2) +
                	round(nvl(x17.Amount, 0), 2) 
                	) as ProfitAndLossAmount
                From 
                (
                Select
                	a.CompanyCode,
                	a.CompanyName,
                	b.VehicleNo
                From Company a,
                (
                Select
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                From Placement a
                Where a.VehicleGroupCode = 'SELF'
                and a.VehicleNo is not null
                and a.VehicleCompanyCode is not null
                Group by
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                UNION
                Select
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                From LR a
                Where a.VehicleGroupCode = 'SELF'
                and a.VehicleNo is not null
                and a.VehicleCompanyCode is not null
                Group by
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                UNION
                Select
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                From FreightAdvance a
                Where a.VehicleGroupCode = 'SELF'
                and a.VehicleNo is not null
                and a.VehicleCompanyCode is not null
                Group by
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                UNION
                Select
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                From InternalTransfer a
                Where a.VehicleGroupCode = 'SELF'
                and a.VehicleNo is not null
                and a.VehicleCompanyCode is not null
                Group by
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                UNION
                Select
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                From NecessitySlip a
                Where a.VehicleGroupCode = 'SELF'
                and a.VehicleNo is not null
                and a.VehicleCompanyCode is not null
                Group by
                	a.VehicleCompanyCode,
                	a.VehicleGroupCode,
                	a.VehicleNo
                ) b
                Where a.CompanyCode = b.VehicleCompanyCode(+)
                ) x, t_OpenBilled x2, t_CloseBilled x3, t_InternalTransforBilled x4, t_OpenUnbilled x5, t_CloseUnbilled x6, t_InternalTransforUnbilled x7, t_TyreAmount x9, t_DieselAmount x10, t_SpareAmount x11, t_DAAmount x12, t_BatteryAmount x13, t_TripExpenseAmount x14, t_TollAmount x15,
                tEMIAmount x16, t_OtherAmount x17
                Where x.CompanyCode = x2.CompanyCode(+)
                	and x.VehicleNo = x2.VehicleNo(+)
                	and x.CompanyCode = x3.CompanyCode(+)
                	and x.VehicleNo = x3.VehicleNo(+)
                	and x.CompanyCode = x4.CompanyCode(+)
                	and x.VehicleNo = x4.VehicleNo(+)
                	and x.CompanyCode = x5.CompanyCode(+)
                	and x.VehicleNo = x5.VehicleNo(+)
                	and x.CompanyCode = x6.CompanyCode(+)
                	and x.VehicleNo = x6.VehicleNo(+)
                	and x.CompanyCode = x7.CompanyCode(+)
                	and x.VehicleNo = x7.VehicleNo(+)
                	and x.CompanyCode = x9.CompanyCode(+)
                	and x.VehicleNo = x9.VehicleNo(+)
                	and x.CompanyCode = x10.CompanyCode(+)
                	and x.VehicleNo = x10.VehicleNo(+)
                	and x.CompanyCode = x11.CompanyCode(+)
                	and x.VehicleNo = x11.VehicleNo(+)
                	and x.CompanyCode = x12.CompanyCode(+)
                	and x.VehicleNo = x12.VehicleNo(+)
                	and x.CompanyCode = x13.CompanyCode(+)
                	and x.VehicleNo = x13.VehicleNo(+)
                	and x.CompanyCode = x14.CompanyCode(+)
                	and x.VehicleNo = x14.VehicleNo(+)
                	and x.CompanyCode = x15.CompanyCode(+)
                	and x.VehicleNo = x15.VehicleNo(+)
                	and x.CompanyCode = x16.CompanyCode(+)
                	and x.VehicleNo = x16.VehicleNo(+)
                	and x.CompanyCode = x17.CompanyCode(+)
                	and x.VehicleNo = x17.VehicleNo(+)
                  -- and x.CompanyCode = :P339_COMPANYCODE
                   and :P339_FROMDATE IS NOT NULL
                   and (:P339_COMPANYCODE is Null Or Instr (':' || :P339_COMPANY || ':' , ':' || x.CompanyCode || ':') > 0)
                ```
        }
