    pageItem P339_VEHICLETYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vehicle Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    b.VehicleTypeName d,
                    b.VehicleTYpeCode R
                From CompanyVehicle a, VehicleType b
                Where a.VehicleTypeCode = b.VehicleTypeCode 
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @vehicle-performance-vehicle-wise-2
