    )

    pageItem P492_BOSSUSER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Boss User
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  Distinct
                        b.BossUserName d,
                        b.BossUserCode r
                From    PassFail a,BossUser b
                Where   a.BossUserCode = b.BossUserCode(+)
                Order By 1
                ```
        }
        layout {
            sequence: 30
            region: @on-the-table-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P492_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @on-the-table-detail
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
