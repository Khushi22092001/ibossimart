        }

        savedReport 74597 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BOSSUSERNAME (
                sequence: 1
            )

            displayColumn FAILED (
                sequence: 9
            )

            displayColumn MENULABEL (
                sequence: 3
            )

            displayColumn MODULEFLOWNO (
                sequence: 5
            )

            displayColumn MODULENAME (
                sequence: 2
            )

            displayColumn ONTHETABLE (
                sequence: 10
            )

            displayColumn PASSED (
                sequence: 8
