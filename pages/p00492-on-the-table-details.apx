page 492 (
    name: On The Table Details
    alias: ON-THE-TABLE-DETAILS
    title: On The Table Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region on-the-table-detail (
        name: On The Table Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
    )

    region on-the-table-details (
        name: On The Table Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    bu.BossUserName,
                    c.ModuleName,
                    a.ModuleTNo,
                    a.IsPass,
                    a.IsFail,
                    a.MenuLabel,
                    a.TokenNo,
                    decode( nvl(a.IsPass, 'NULL'), 'YES', 1, 0) as Passed,
                    decode( nvl(a.IsFail, 'NULL'), 'YES', 1, 0) as Failed,
                    round( decode( nvl(a.IsPass, 'NULL'), 'YES', 0, 0.4)  + decode( nvl(a.IsFail, 'NULL'), 'YES', 0, 0.4) ) as OnTheTable,
                    to_char(a.QUEUEDATE,'dd-mm-yyyy hh24:mi:ss') QueueDate,
                    to_char(a.PASSFAILDATE,'dd-mm-yyyy hh24:mi:ss') PassFailDate,
                    getdatedifference(a.PASSFAILDATE,a.QUEUEDATE) as ProcessTime,
                    to_char(( a.PASSFAILDATE - a.QUEUEDATE) * 86400,'99999999.99') as SecondsTaken ,
                    a.Remark ,
                    a.TNo ,
                    c.LABELCOLUMNNAME,
                    c.MasterTableName,
                    b.ModuleFlowNo
                FROM PASSFAIL a, MODULEFLOW b, MODULE c, BOSSUSER bu
                WHERE a.ModuleFlowTNo = b.TNo(+)
                AND b.ModuleCode = c.ModuleCode(+)
                AND a.bossUsercode = bu.BossUserCode(+)
                and to_date(a.QUEUEDATE) between :P492_FROMDATE and :P492_TODATE
                and ( :P492_BOSSUSER IS NULL OR instr(':'||:P492_BOSSUSER||':',':'||a.BOSSUSERCODE||':') > 0 )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 7446803029437201
        }

        column BOSSUSERNAME (
            type: plainText
            heading {
                heading: Boss User
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column FAILED (
            type: plainText
            heading {
                heading: Failed
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column ISFAIL (
            type: plainText
            heading {
