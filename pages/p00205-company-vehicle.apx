                heading: Vehicle Type
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: VEHICLETYPE
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Company Vehicle Details
        }
    )

    pageItem P205_TNO (
        type: hidden
        layout {
            sequence: 30
            region: @company-vehicle-details-2
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: TNO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P205_TRANSPORTER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vehicle Group
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                a.TransporterName d,
                a.TransporterCode r
                From Transporter a, CompanyVehicle b
                Where a.TransporterCode = b.TransporterCode(+)
                ```
        }
        layout {
            sequence: 30
            region: @company-vehicle-details
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 5
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
            ]
            width: 30
            valuePlaceholder: Select Vehicle Group
        }
        validation {
            valueRequired: true
        }
    )

