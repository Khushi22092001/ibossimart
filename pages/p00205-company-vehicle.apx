page 205 (
    name: Company Vehicle Details
    alias: COMPANY-VEHICLE
    title: Company Vehicle Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region company-vehicle-details (
        name: Company Vehicle Details
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region company-vehicle-details-2 (
        name: Company Vehicle Details
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.TNO,
                Rownum as SerialNo,
                a.VehicleOperatorCode,
                p.PartyName as Operator,
                a.VehicleGroupCode,
                a.vehicleno , 
                gettransportername(a.ownercode) as owner,
                gettransportername(a.transportercode) as transporter,
                getvehicletypename(a.vehicletypecode) as Vehicletype,
                a.ManufacturingYear,
                a.ChassisNo,  
                a.ENGINENO,
                a.MODELNO,
                a.TareWeight,
                A.TANKSIZE,
                A.PURCHASEDATE,
                getPartyName(gca.AccountCode) AS GPSCONTROLACCOUNT,
                a.DRIVERNAME,
                a.REMARK,
                e.EquipmentID,
                GetCheckNecessityforVehicle('6',a.vehicleno) as TYRE,
                GetCheckNecessityforVehicle('2',a.vehicleno) as INSURANCE,
                GetCheckNecessityforVehicle('3',a.vehicleno) as "RTO - FITNESS",
                GetCheckNecessityforVehicle('4',a.vehicleno) as "RTO - Permit (CG State)",
                GetCheckNecessityforVehicle('5',a.vehicleno) as "RTO - Quarterly Road Tax",
                GetCheckNecessityforVehicle('10',a.vehicleno) as Battery,
                getcompanyname(a.companycode) as company,
                f.EquipmentGroupName,
                cc.Costcentrename
                from 
                    COMPANYVEHICLE a , GPSControlAccount gca, party p, Equipment e, equipmentgroup f, Costcentre cc
                WHERE
                a.GPSControlAccountCode = gca.GPSControlAccountCode(+)
                and a.VehicleOperatorCode = p.PartyCode(+)
                and e.EquipmentGroupCode = f.EquipmentGroupCode(+)
                and a.ModuleTno = e.Tno(+)
                and e.Costcentrecode = cc.costcentrecode(+)
                --and :P205_VEHICLENO  = a.vehicleNo
                and ( :P205_VEHICLENO IS NULL OR instr(':'||:P205_VEHICLENO||':',':'||a.vehicleNo||':') > 0 )
                and ( :P205_VEHICLEGROUP IS NULL OR instr(':'||:P205_VEHICLEGROUP||':',':'||a.vehiclegroupcode||':') > 0 )
                and ( :P205_TRANSPORTER IS NULL OR instr(':'||:P205_TRANSPORTER||':',':'||a.transportercode||':') > 0 )
                and ( :P205_VEHICLETYPE IS NULL OR instr(':'||:P205_VEHICLETYPE||':',':'||a.vehicletypecode||':') > 0 )
                AND :P205_VEHICLEGROUP IS NOT NULL
                --and ( :P205_OPERATOR IS NULL OR instr(':'||:P205_OPERATOR||':',':'||a.VehicleOperatorCode||':') > 0 );
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                   
                ```
        }
        advanced {
            savedReportMappingIdentifier: 50129491661007695
        }

