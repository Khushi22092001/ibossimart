    process establish-transaction-visibility (
        name: Establish transaction visibility
        type: executeCode
        source {
            plsqlCode: begin if GetApexReportPrivilege('1','49',:APP_USER) then :P740_ALLOW_HR:='Y';else :P740_ALLOW_HR:='N';end if;if GetApexReportPrivilege('1','252',:APP_USER) then :P740_ALLOW_MAINT:='Y';else :P740_ALLOW_MAINT:='N';end if;end;
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900740083100017
        }
    )

)

