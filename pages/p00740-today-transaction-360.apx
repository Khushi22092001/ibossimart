page 740 (
    name: Today Transaction 360
    alias: TODAY-TRANSACTION-360
    title: Today Transaction 360
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            (function(){
             'use strict';
             var config={"page":740,"filter":"txFilters","regions":["txMaster","txLines"]},$=apex.jQuery,running=false;
             var filters=document.getElementById(config.filter),status=document.createElement('div');
             if(!filters)return;
             // Keep the APEX item nodes (and their handlers) but remove empty grid rows.
             var grid=document.createElement('div'),toolbar=document.createElement('div');grid.className='ds360-fields';toolbar.className='ds360-actions';
             Array.prototype.forEach.call(filters.querySelectorAll('.t-Form-fieldContainer'),function(node){grid.appendChild(node);});
             Array.prototype.forEach.call(filters.querySelectorAll('button.t-Button,a.t-Button'),function(node){if(!node.closest('.t-Form-fieldContainer'))toolbar.appendChild(node);});
             Array.prototype.forEach.call(filters.querySelectorAll('.container,.row'),function(node){if(!node.querySelector('input,select,button,a,textarea'))node.style.display='none';});
             var title=document.createElement('div');title.className='ds360-filter-title';title.textContent='Filters';filters.appendChild(title);filters.appendChild(grid);filters.appendChild(toolbar);
             status.className='ds360-status';status.setAttribute('role','status');status.setAttribute('aria-live','polite');
             status.textContent='Select a record and Apply to update all sections.';toolbar.appendChild(status);
             function hideEmptyRecordLinks(){if(config.page!==686)return;document.querySelectorAll('.a-IRR a[href*="p687_reqtno=&"]').forEach(function(link){link.hidden=true;});}
             $(document).on('apexafterrefresh.ds360Links',hideEmptyRecordLinks);hideEmptyRecordLinks();
             function refreshOne(id){return new Promise(function(resolve,reject){var node=document.getElementById(id);if(!node){resolve();return;}var done=false;
              function end(error){if(done)return;done=true;clearTimeout(timer);$(node).off('.ds360Refresh');error?reject(error):resolve();}
              var timer=setTimeout(function(){end(new Error('A report did not finish. Please retry.'));},45000);
              $(node).one('apexafterrefresh.ds360Refresh',function(){end();}).one('apexrefresherror.ds360Refresh',function(){end(new Error('A report could not refresh.'));});
              try{apex.region(id).refresh();}catch(e){end(e);}
             });}
             async function apply(button){if(running)return;apex.message.clearErrors();if(apex.page&&apex.page.validate&&!apex.page.validate())return;
              running=true;button.disabled=true;button.setAttribute('aria-busy','true');status.textContent='Updating the master card and registers…';
              try{for(var i=0;i<config.regions.length;i+=2){await Promise.all(config.regions.slice(i,i+2).map(refreshOne));}status.textContent='Updated. All sections now use the selected record and applied filters.';}
              catch(e){status.textContent='Some sections could not update. Please Apply again before relying on the displayed records.';apex.message.showErrors([{type:'error',location:'page',message:status.textContent,unsafe:false}]);}
              finally{button.disabled=false;button.removeAttribute('aria-busy');running=false;}
             }
             // Capture at window before the shared dashboard handler: that handler skips
             // initially empty reports because their table markup does not yet exist.
             window.addEventListener('click',function(event){var button=event.target.closest('button,a.t-Button');if(!button||!filters.contains(button))return;
              var action=String(button.getAttribute('data-otel-label')||button.textContent||'').trim();
              if(!/^\s*(APPLY|APPLY FILTERS|REFRESH|UPDATE VIEW)\b/i.test(action))return;
              event.preventDefault();event.stopImmediatePropagation();apply(button);
             },true);
            }());
            
            ```
    }
    css {
        inline:
            ```css
            .tx-master{padding:27px;background:linear-gradient(110deg,#e4e4ff,#f3effc);border:1px solid #d1d0f3;border-radius:16px;margin-bottom:18px;color:#2e355a}.tx-master h2{font-size:24px;margin:0 0 7px;color:#333062}.tx-master .tx-number{font-size:19px;font-weight:700;color:#594bb4;margin:0 0 18px;overflow-wrap:anywhere}.tx-master .tx-facts{display:flex;gap:10px;flex-wrap:wrap}.tx-facts span{padding:9px 12px;background:#ffffffb8;border:1px solid #dcdcf3;border-radius:9px;font-size:12px}.tx-facts b{display:block;font-size:14px;color:#343d63}.tx-guide{padding:14px 18px;background:#eff4fd;border-left:4px solid #6f8acb;border-radius:8px;color:#667895;margin:0 0 15px;font-size:12px}.tx-guide a{font-weight:700}.tx-filter .t-Region-body{padding:18px}.tx-filter .t-Form-fieldContainer{padding:0 8px 12px}.tx-filter .t-Form-label{font-weight:650;font-size:12px}.tx-lines .a-IRR-header{background:#e8edfd!important}.tx-lines .a-IRR-table tbody tr td{background:#fff!important;border-bottom:1px solid #e4e9f3}.tx-lines .a-IRR-table tbody tr:hover td{background:#f8faff!important}.tx-lines .a-IRR-toolbar{background:#f1f2fd}.ds360-status{padding:10px 16px;color:#69788f;font-size:12px;line-height:1.5;clear:both}
            .ds360-filters .t-Form-fieldContainer{padding:6px 10px 12px!important}.ds360-filters .t-Form-labelContainer{padding-bottom:7px!important;text-align:left!important}.ds360-filters .t-Form-inputContainer{min-width:0}.ds360-filters .t-Form-itemWrapper{width:100%;min-width:0}.ds360-filters input:not([type=hidden]),.ds360-filters select{min-height:45px!important}.ds360-filters .a-DatePicker{width:100%}.ds360-filters .t-Form-label{font-size:12px;font-weight:650}.ds360-placeholder{padding:26px 28px;margin-bottom:18px;background:linear-gradient(110deg,#eeebff,#f1f7ff);border:1px solid #dcdcf2;border-radius:16px;color:#5b6685}.ds360-placeholder h2{font-size:23px;color:#393565;margin:0 0 10px}.ds360-placeholder p{margin:0;font-size:13px}
            .ds360-register .a-IRR-table tbody td{background:#fff!important;border-bottom:1px solid #e3e8f2!important}.ds360-register .a-IRR-table tbody tr:hover td{background:#f8faff!important}.ds360-register .a-IRR-header{background:#e8eafa!important}.ds360-register .a-IRR-toolbar{background:#f4f3ff!important}
            .ds360-filters{padding:12px 16px!important;min-height:0!important}.ds360-fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px 16px}.ds360-fields .t-Form-fieldContainer{display:block!important;margin:0!important;padding:0!important;min-height:0!important;width:100%!important}.ds360-fields .t-Form-labelContainer{margin:0!important;padding:0 0 4px!important;min-height:0!important;line-height:18px!important}.ds360-fields .t-Form-label{font-size:12px!important;line-height:18px!important}.ds360-fields .t-Form-inputContainer{padding:0!important;margin:0!important;width:100%!important;min-height:0!important}.ds360-fields .t-Form-itemWrapper{margin:0!important;min-height:0!important;width:100%!important}.ds360-fields input:not([type=hidden]),.ds360-fields select,.ds360-fields .apex-item-popup-lov{height:39px!important;min-height:39px!important;padding-top:7px!important;padding-bottom:7px!important;font-size:13px!important}.ds360-fields .a-Button{height:39px!important;min-height:39px!important}.ds360-fields .apex-item-group--popup-lov,.ds360-fields .apex-item-group{min-height:39px!important}.ds360-actions{display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-top:11px}.ds360-actions .t-Button{margin:0!important;min-height:35px!important;height:35px!important;padding:6px 13px!important;font-size:12px!important}.ds360-actions .ds360-status{padding:0 5px;margin-left:5px;font-size:11px;flex:1;min-width:170px}.ds360-filters:before{margin-bottom:9px!important}.ds360-fields .t-Form-itemText--post,.ds360-fields .t-Form-itemText--pre{padding:0!important}
            @media(max-width:850px){.ds360-fields{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.ds360-fields{grid-template-columns:1fr}.ds360-actions .ds360-status{flex-basis:100%;margin:2px 0 0}}
            .ds360-filters:before,.ds360-filters:after{display:none!important}.ds360-filter-title{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#737499;margin:0 0 8px}.ds360-fields .apex-item-group{width:100%!important;max-width:none!important}.ds360-fields .apex-item-popup-lov{width:100%!important;max-width:none!important;min-width:0!important}.ds360-kpi .nodatafound,.ds360-kpi .t-Report-noData,.ds360-kpi .a-Report-noData{display:none!important}
            .ds360-filters > .t-Region-header{display:none!important}.ds360-fields .a-DatePicker{width:100%!important;max-width:none!important}.ds360-fields .a-DatePicker-input{width:100%!important}
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region transaction-filters (
        name: Transaction filters
        type: staticContent
        source {
            htmlCode: <div class="tx-guide">Choose company, location and dates, then transaction type and number. Apply updates both the master card and line register below. Use report search and column filters to inspect the lines.</div><button type="button" class="t-Button t-Button--hot" id="txApply">Apply transaction</button>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                tx-filter
                ds360-filters
            ]
        }
        advanced {
            htmlDomId: txFilters
        }
    )

    region transaction-master (
        name: Transaction master details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with B as (select case when :P740_DIMTYPE='DAY' then to_date(:P740_DIMVALUE,'YYYY-MM-DD') else to_date(:P740_FROMDATE,'DD-MM-RRRR') end f,case when :P740_DIMTYPE='DAY' then to_date(:P740_DIMVALUE,'YYYY-MM-DD') else to_date(:P740_TODATE,'DD-MM-RRRR') end+1 t,
                    (select GetUserPanelAB_apex() from dual) enforced from dual), E as (select 'BILLING' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.CCInvoiceNo as varchar2(400)) doc_no,h.CCInvoiceDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Taxable invoice line value; excludes footer taxes.' note
                      from CCInvoice h join CCInvoiceDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.CCInvoiceDate >= b.f and h.CCInvoiceDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='BILLING')
                
                union all
                select 'SALES_ORDER' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.SalesOrderNo as varchar2(400)) doc_no,h.SalesOrderDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Order line amounts, before footer charges.' note
                      from SalesOrder h join SalesOrderDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.SalesOrderDate >= b.f and h.SalesOrderDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='SALES_ORDER')
                
                union all
                select 'PO' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.PurchaseOrderNo as varchar2(400)) doc_no,h.PurchaseOrderDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Purchase order line amounts, before footer charges.' note
                      from PurchaseOrder h join PurchaseOrderDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.PurchaseOrderDate >= b.f and h.PurchaseOrderDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PO')
                
                union all
                select 'PURCHASE' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.PurchaseBillNo as varchar2(400)) doc_no,h.PurchaseBillDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Purchase bill line value; excludes footer charges.' note
                      from PurchaseBill h join PurchaseBillDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.PurchaseBillDate >= b.f and h.PurchaseBillDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PURCHASE')
                
                union all
                select 'GRN' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.GrnNo as varchar2(400)) doc_no,h.GrnDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.ReceivedQuantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Stored GRN line amounts; quantity is reported by unit.' note
                      from Grn h join GrnDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.GrnDate >= b.f and h.GrnDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='GRN')
                
                union all
                select 'PRODUCTION' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.ProductionNo as varchar2(400)) doc_no,h.ProductionDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      cast(null as varchar2(400)) party_code,d.ItemCode item_code,d.StockValue amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Production documents with finished-output lines; quantities below by unit.' note
                      from Production h join ProductionFinished d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.ProductionDate >= b.f and h.ProductionDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PRODUCTION')
                
                union all
                select 'ISSUE' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.IssueNo as varchar2(400)) doc_no,h.IssueDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      cast(null as varchar2(400)) party_code,d.ItemCode item_code,(select sum(u.UsedStockQuantity1*s.Rate) from UsedStock u join Stock s on s.TNo=u.StockTNo where u.ModuleCode='ISSUE' and u.ModuleTNo=h.TNo and u.ModuleSNo=d.SNo) amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Issued stock quantity × source layer rate, reconciled with Issue Register; gross issue value before returns.' note
                      from Issue h join IssueDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.IssueDate >= b.f and h.IssueDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='ISSUE')
                
                union all
                select 'REQUISITION' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.RequisitionNo as varchar2(400)) doc_no,h.RequisitionDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,h.ItemCode item_code,cast(null as number) amount,cast(null as number) quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Requisition documents dated in the selected period.' note
                      from Requisition h 
                      left join Item i on i.ItemCode=h.ItemCode cross join B b
                      where h.RequisitionDate >= b.f and h.RequisitionDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='REQUISITION')
                
                union all
                select 'PASS' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.PBPassNo as varchar2(400)) doc_no,h.PBPassDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      (select x.PartyCode from PurchaseBill x where x.TNo=h.PurchaseBillTNo) party_code,cast(null as varchar2(400)) item_code,h.PBPassAmount amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Purchase bill: '||(select x.PurchaseBillNo from PurchaseBill x where x.TNo=h.PurchaseBillTNo) note
                      from PBPass h 
                       cross join B b
                      where h.PBPassDate >= b.f and h.PBPassDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PASS')
                
                union all
                select 'DISPATCH' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateOutTime event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Vehicle: '||h.VehicleNo||'; gate in: '||to_char(h.GateInTime,'DD-Mon-YYYY HH24:MI') note
                      from MaterialOut h 
                       cross join B b
                      where h.GateOutTime >= b.f and h.GateOutTime<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='DISPATCH')
                
                union all
                select 'GATE_IN' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Vehicle: '||h.VehicleNo||'; source reference: '||h.RefDocNo note
                      from MaterialIn h 
                       cross join B b
                      where h.GateInTime >= b.f and h.GateInTime<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='GATE_IN')
                
                union all
                select 'SERVICE' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.ServiceBillNo as varchar2(400)) doc_no,h.ServiceBillDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,h.ItemCode item_code,h.ServiceBillAmount amount,cast(null as number) quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Gross service bill amount, shown separately from material billing.' note
                      from ServiceBill h 
                      left join Item i on i.ItemCode=h.ItemCode cross join B b
                      where h.ServiceBillDate >= b.f and h.ServiceBillDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='SERVICE')
                
                union all
                select 'TRANSFER' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.InterUnitTransferNo as varchar2(400)) doc_no,h.InterUnitTransferDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Transfer order only; destination: '||h.ToLocationCode note
                      from InterUnitTransfer h 
                       cross join B b
                      where h.InterUnitTransferDate >= b.f and h.InterUnitTransferDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='TRANSFER')
                
                union all
                select 'ISSUE_RETURN' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.IssueReturnNo as varchar2(400)) doc_no,h.IssueReturnDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Recorded issue-return documents.' note
                      from IssueReturn h 
                       cross join B b
                      where h.IssueReturnDate >= b.f and h.IssueReturnDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='ISSUE_RETURN')
                
                union all
                select 'MAINTENANCE' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.MaintenanceRequestNo as varchar2(400)) doc_no,h.MaintenanceRequestDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,cast(null as varchar2(10)) panel,
                      cast(null as varchar2(400)) party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,substr('Equipment: '||(select e.EquipmentName from Equipment e where e.TNo=h.EquipmentTNo)||'; '||h.NotificationShortText||'; responsible: '||h.PersonResponsible,1,400) note
                      from MaintenanceRequest h 
                       cross join B b
                      where h.MaintenanceRequestDate >= b.f and h.MaintenanceRequestDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and :P740_ALLOW_MAINT='Y'
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='MAINTENANCE')
                
                union all
                select 'WORKFORCE' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.AttendencePeriodicalNo as varchar2(400)) doc_no,h.AttendencePeriodicalDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,cast(null as varchar2(10)) panel,
                      cast(null as varchar2(400)) party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Employee: '||h.EmployeeCode||'; attendance period: '||to_char(h.FromDate,'DD-Mon-YYYY')||' to '||to_char(h.ToDate,'DD-Mon-YYYY')||'; not a daily attendance count' note
                      from AttendencePeriodical h 
                       cross join B b
                      where h.AttendencePeriodicalDate >= b.f and h.AttendencePeriodicalDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and :P740_ALLOW_HR='Y'
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='WORKFORCE')
                
                union all
                select 'COLLECTION',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime,
                      d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),1*d.Amount,cast(null as number),cast(null as varchar2(400)),v.Creator,
                      cast(substr(d.Narration,1,400) as varchar2(400))
                      from VoucherDetail d join Voucher v on v.TNo=d.TNo cross join B b
                      where d.VoucherDate>=b.f and d.VoucherDate<b.t and v.DocTypeCode in ('RECEIPT')
                      and 1*d.Amount>0 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode)
                      and (:P740_COMPANY is null or d.CompanyCode=:P740_COMPANY) and (:P740_LOCATION is null or d.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or d.Panel=b.enforced) and (:P740_PANEL is null or d.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='COLLECTION')
                union all
                select 'PAYMENT',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime,
                      d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),-1*d.Amount,cast(null as number),cast(null as varchar2(400)),v.Creator,
                      cast(substr(d.Narration,1,400) as varchar2(400))
                      from VoucherDetail d join Voucher v on v.TNo=d.TNo cross join B b
                      where d.VoucherDate>=b.f and d.VoucherDate<b.t and v.DocTypeCode in ('PAYMENT','CASHPAYMENT','BANKPAYMENT')
                      and -1*d.Amount>0 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode)
                      and (:P740_COMPANY is null or d.CompanyCode=:P740_COMPANY) and (:P740_LOCATION is null or d.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or d.Panel=b.enforced) and (:P740_PANEL is null or d.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PAYMENT')) select '<div class="tx-master"><h2>'||apex_escape.html(m.kind)||'</h2><div class="tx-number">'||apex_escape.html(m.doc_no)||'</div><div class="tx-facts"><span>Date<b>'||to_char(m.event_date,'DD Mon YYYY')||'</b></span><span>Company<b>'||apex_escape.html((select CompanyName from Company c where c.CompanyCode=m.company_code))||'</b></span><span>Location<b>'||apex_escape.html((select LocationName from Location l where l.LocationCode=m.location_code))||'</b></span><span>Party<b>'||apex_escape.html(nvl((select PartyName from Party p where p.PartyCode=m.party_code),'Not applicable'))||'</b></span><span>Document value<b>'||case when m.amount is null then 'Not valued' else '&#8377; '||to_char(m.amount,'FM999G999G999G990D00') end||'</b></span><span>Source lines<b>'||to_char(m.line_count)||'</b></span><span>Recorded<b>'||nvl(to_char(m.logged_at,'DD Mon YYYY HH24:MI'),'Not recorded')||'</b></span></div><p>'||apex_escape.html(m.note)||'</p></div>' CARD from (select case e.metric when 'BILLING' then 'Sales invoice' when 'COLLECTION' then 'Customer receipt' when 'PAYMENT' then 'Supplier payment' when 'PURCHASE' then 'Purchase bill' when 'GRN' then 'Goods receipt' when 'PRODUCTION' then 'Production entry' when 'DISPATCH' then 'Outbound gate visit' when 'SALES_ORDER' then 'Sales order' when 'PO' then 'Purchase order' when 'PASS' then 'Bill pass' when 'REQUISITION' then 'Material requisition' when 'ISSUE' then 'Stock issue' when 'GATE_IN' then 'Inbound gate visit' when 'SERVICE' then 'Service bill' when 'TRANSFER' then 'Transfer order' when 'ISSUE_RETURN' then 'Issue return' when 'MAINTENANCE' then 'Maintenance request' when 'WORKFORCE' then 'Attendance posting' end kind,e.doc_no,max(e.event_date) event_date,max(e.company_code) company_code,max(e.location_code) location_code,max(e.party_code) party_code,sum(e.amount) amount,count(*) line_count,max(e.logged_at) logged_at,max(e.note) note from E e where :P740_DOC is not null and e.doc_id=to_number(:P740_DOC default null on conversion error) and e.metric=:P740_METRIC group by e.metric,e.doc_no) m
                ```
            pageItemsToSubmit: [
                P740_FROMDATE
                P740_TODATE
                P740_COMPANY
                P740_LOCATION
                P740_PANEL
                P740_METRIC
                P740_DOC
                P740_DIMTYPE
                P740_DIMVALUE
            ]
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hspl-register-empty-disabled
        }
        advanced {
            htmlDomId: txMaster
        }
        reportLayout {
            numberOfRows: 1
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Select a transaction type and number below, then Apply to show its master details and lines.
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region transaction-source-lines (
        name: Transaction source lines — search or filter columns below
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with B as (select case when :P740_DIMTYPE='DAY' then to_date(:P740_DIMVALUE,'YYYY-MM-DD') else to_date(:P740_FROMDATE,'DD-MM-RRRR') end f,case when :P740_DIMTYPE='DAY' then to_date(:P740_DIMVALUE,'YYYY-MM-DD') else to_date(:P740_TODATE,'DD-MM-RRRR') end+1 t,
                    (select GetUserPanelAB_apex() from dual) enforced from dual), E as (select 'BILLING' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.CCInvoiceNo as varchar2(400)) doc_no,h.CCInvoiceDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Taxable invoice line value; excludes footer taxes.' note
                      from CCInvoice h join CCInvoiceDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.CCInvoiceDate >= b.f and h.CCInvoiceDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='BILLING')
                
                union all
                select 'SALES_ORDER' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.SalesOrderNo as varchar2(400)) doc_no,h.SalesOrderDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Order line amounts, before footer charges.' note
                      from SalesOrder h join SalesOrderDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.SalesOrderDate >= b.f and h.SalesOrderDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='SALES_ORDER')
                
                union all
                select 'PO' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.PurchaseOrderNo as varchar2(400)) doc_no,h.PurchaseOrderDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Purchase order line amounts, before footer charges.' note
                      from PurchaseOrder h join PurchaseOrderDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.PurchaseOrderDate >= b.f and h.PurchaseOrderDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PO')
                
                union all
                select 'PURCHASE' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.PurchaseBillNo as varchar2(400)) doc_no,h.PurchaseBillDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Purchase bill line value; excludes footer charges.' note
                      from PurchaseBill h join PurchaseBillDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.PurchaseBillDate >= b.f and h.PurchaseBillDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PURCHASE')
                
                union all
                select 'GRN' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.GrnNo as varchar2(400)) doc_no,h.GrnDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,d.ItemCode item_code,d.Amount amount,d.ReceivedQuantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Stored GRN line amounts; quantity is reported by unit.' note
                      from Grn h join GrnDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.GrnDate >= b.f and h.GrnDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='GRN')
                
                union all
                select 'PRODUCTION' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.ProductionNo as varchar2(400)) doc_no,h.ProductionDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      cast(null as varchar2(400)) party_code,d.ItemCode item_code,d.StockValue amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Production documents with finished-output lines; quantities below by unit.' note
                      from Production h join ProductionFinished d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.ProductionDate >= b.f and h.ProductionDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PRODUCTION')
                
                union all
                select 'ISSUE' metric,h.TNo doc_id,d.SNo line_no,
                      cast(h.IssueNo as varchar2(400)) doc_no,h.IssueDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      cast(null as varchar2(400)) party_code,d.ItemCode item_code,(select sum(u.UsedStockQuantity1*s.Rate) from UsedStock u join Stock s on s.TNo=u.StockTNo where u.ModuleCode='ISSUE' and u.ModuleTNo=h.TNo and u.ModuleSNo=d.SNo) amount,d.Quantity1 quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Issued stock quantity × source layer rate, reconciled with Issue Register; gross issue value before returns.' note
                      from Issue h join IssueDetail d on d.TNo=h.TNo
                      left join Item i on i.ItemCode=d.ItemCode cross join B b
                      where h.IssueDate >= b.f and h.IssueDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='ISSUE')
                
                union all
                select 'REQUISITION' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.RequisitionNo as varchar2(400)) doc_no,h.RequisitionDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,h.ItemCode item_code,cast(null as number) amount,cast(null as number) quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Requisition documents dated in the selected period.' note
                      from Requisition h 
                      left join Item i on i.ItemCode=h.ItemCode cross join B b
                      where h.RequisitionDate >= b.f and h.RequisitionDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='REQUISITION')
                
                union all
                select 'PASS' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.PBPassNo as varchar2(400)) doc_no,h.PBPassDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      (select x.PartyCode from PurchaseBill x where x.TNo=h.PurchaseBillTNo) party_code,cast(null as varchar2(400)) item_code,h.PBPassAmount amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Purchase bill: '||(select x.PurchaseBillNo from PurchaseBill x where x.TNo=h.PurchaseBillTNo) note
                      from PBPass h 
                       cross join B b
                      where h.PBPassDate >= b.f and h.PBPassDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PASS')
                
                union all
                select 'DISPATCH' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.MaterialOutNo as varchar2(400)) doc_no,h.GateOutTime event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Vehicle: '||h.VehicleNo||'; gate in: '||to_char(h.GateInTime,'DD-Mon-YYYY HH24:MI') note
                      from MaterialOut h 
                       cross join B b
                      where h.GateOutTime >= b.f and h.GateOutTime<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='DISPATCH')
                
                union all
                select 'GATE_IN' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.MaterialInNo as varchar2(400)) doc_no,h.GateInTime event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Vehicle: '||h.VehicleNo||'; source reference: '||h.RefDocNo note
                      from MaterialIn h 
                       cross join B b
                      where h.GateInTime >= b.f and h.GateInTime<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='GATE_IN')
                
                union all
                select 'SERVICE' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.ServiceBillNo as varchar2(400)) doc_no,h.ServiceBillDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,h.ItemCode item_code,h.ServiceBillAmount amount,cast(null as number) quantity,
                      i.MeasuringUnitCode1 unit_code,
                      h.Creator creator,'Gross service bill amount, shown separately from material billing.' note
                      from ServiceBill h 
                      left join Item i on i.ItemCode=h.ItemCode cross join B b
                      where h.ServiceBillDate >= b.f and h.ServiceBillDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='SERVICE')
                
                union all
                select 'TRANSFER' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.InterUnitTransferNo as varchar2(400)) doc_no,h.InterUnitTransferDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Transfer order only; destination: '||h.ToLocationCode note
                      from InterUnitTransfer h 
                       cross join B b
                      where h.InterUnitTransferDate >= b.f and h.InterUnitTransferDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='TRANSFER')
                
                union all
                select 'ISSUE_RETURN' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.IssueReturnNo as varchar2(400)) doc_no,h.IssueReturnDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,h.Panel panel,
                      h.PartyCode party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Recorded issue-return documents.' note
                      from IssueReturn h 
                       cross join B b
                      where h.IssueReturnDate >= b.f and h.IssueReturnDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or h.Panel=b.enforced) and (:P740_PANEL is null or h.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='ISSUE_RETURN')
                
                union all
                select 'MAINTENANCE' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.MaintenanceRequestNo as varchar2(400)) doc_no,h.MaintenanceRequestDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,cast(null as varchar2(10)) panel,
                      cast(null as varchar2(400)) party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,substr('Equipment: '||(select e.EquipmentName from Equipment e where e.TNo=h.EquipmentTNo)||'; '||h.NotificationShortText||'; responsible: '||h.PersonResponsible,1,400) note
                      from MaintenanceRequest h 
                       cross join B b
                      where h.MaintenanceRequestDate >= b.f and h.MaintenanceRequestDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and :P740_ALLOW_MAINT='Y'
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='MAINTENANCE')
                
                union all
                select 'WORKFORCE' metric,h.TNo doc_id,cast(null as number) line_no,
                      cast(h.AttendencePeriodicalNo as varchar2(400)) doc_no,h.AttendencePeriodicalDate event_date,h.CreationTime logged_at,
                      h.CompanyCode company_code,h.LocationCode location_code,cast(null as varchar2(10)) panel,
                      cast(null as varchar2(400)) party_code,cast(null as varchar2(400)) item_code,cast(null as number) amount,cast(null as number) quantity,
                      cast(null as varchar2(400)) unit_code,
                      h.Creator creator,'Employee: '||h.EmployeeCode||'; attendance period: '||to_char(h.FromDate,'DD-Mon-YYYY')||' to '||to_char(h.ToDate,'DD-Mon-YYYY')||'; not a daily attendance count' note
                      from AttendencePeriodical h 
                       cross join B b
                      where h.AttendencePeriodicalDate >= b.f and h.AttendencePeriodicalDate<b.t
                      and (:P740_COMPANY is null or h.CompanyCode=:P740_COMPANY)
                      and (:P740_LOCATION is null or h.LocationCode=:P740_LOCATION)
                      and :P740_ALLOW_HR='Y'
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='WORKFORCE')
                
                union all
                select 'COLLECTION',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime,
                      d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),1*d.Amount,cast(null as number),cast(null as varchar2(400)),v.Creator,
                      cast(substr(d.Narration,1,400) as varchar2(400))
                      from VoucherDetail d join Voucher v on v.TNo=d.TNo cross join B b
                      where d.VoucherDate>=b.f and d.VoucherDate<b.t and v.DocTypeCode in ('RECEIPT')
                      and 1*d.Amount>0 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYDEBTORS' connect by prior PartyCode=ParentCode)
                      and (:P740_COMPANY is null or d.CompanyCode=:P740_COMPANY) and (:P740_LOCATION is null or d.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or d.Panel=b.enforced) and (:P740_PANEL is null or d.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='COLLECTION')
                union all
                select 'PAYMENT',v.TNo,d.SNo,cast(v.VoucherNo as varchar2(400)),d.VoucherDate,v.CreationTime,
                      d.CompanyCode,d.LocationCode,d.Panel,d.AccountCode,cast(null as varchar2(400)),-1*d.Amount,cast(null as number),cast(null as varchar2(400)),v.Creator,
                      cast(substr(d.Narration,1,400) as varchar2(400))
                      from VoucherDetail d join Voucher v on v.TNo=d.TNo cross join B b
                      where d.VoucherDate>=b.f and d.VoucherDate<b.t and v.DocTypeCode in ('PAYMENT','CASHPAYMENT','BANKPAYMENT')
                      and -1*d.Amount>0 and d.AccountCode in (select PartyCode from Party start with PartyCode='SUNDRYCREDITORS' connect by prior PartyCode=ParentCode)
                      and (:P740_COMPANY is null or d.CompanyCode=:P740_COMPANY) and (:P740_LOCATION is null or d.LocationCode=:P740_LOCATION)
                      and (b.enforced is null or d.Panel=b.enforced) and (:P740_PANEL is null or d.Panel=:P740_PANEL)
                      and (:P740_METRIC is null or :P740_METRIC='ALL_ACTIVITY' or :P740_METRIC='PAYMENT'))
                 select case e.metric when 'BILLING' then 'Sales invoice' when 'COLLECTION' then 'Customer receipt' when 'PAYMENT' then 'Supplier payment' when 'PURCHASE' then 'Purchase bill' when 'GRN' then 'Goods receipt' when 'PRODUCTION' then 'Production entry' when 'DISPATCH' then 'Outbound gate visit' when 'SALES_ORDER' then 'Sales order' when 'PO' then 'Purchase order' when 'PASS' then 'Bill pass' when 'REQUISITION' then 'Material requisition' when 'ISSUE' then 'Stock issue' when 'GATE_IN' then 'Inbound gate visit' when 'SERVICE' then 'Service bill' when 'TRANSFER' then 'Transfer order' when 'ISSUE_RETURN' then 'Issue return' when 'MAINTENANCE' then 'Maintenance request' when 'WORKFORCE' then 'Attendance posting' end ACTIVITY,e.doc_id DOCUMENT_ID,e.line_no LINE_NO,e.doc_no DOCUMENT_NO,e.event_date DOCUMENT_DATE,
                 nvl(c.CompanyName,e.company_code) COMPANY,nvl(l.LocationName,e.location_code) LOCATION,
                 nvl(pa.PartyName,e.party_code) PARTY,nvl(i.ItemName,e.item_code) ITEM,e.quantity QUANTITY,
                 nvl(mu.MeasuringUnitName,e.unit_code) UNIT,e.amount AMOUNT,e.logged_at RECORDED_AT,e.creator RECORDED_BY,e.note NOTES
                 from E e left join Company c on c.CompanyCode=e.company_code left join Location l on l.LocationCode=e.location_code
                 left join Party pa on pa.PartyCode=e.party_code left join Item i on i.ItemCode=e.item_code
                 left join MeasuringUnit mu on mu.MeasuringUnitCode=e.unit_code
                 where :P740_METRIC is not null
                 and (:P740_DIMTYPE is null or :P740_DIMTYPE='DAY' or (:P740_DIMTYPE='PARTY' and e.party_code=:P740_DIMVALUE)
                 or (:P740_DIMTYPE='LOCATION' and nvl(e.location_code,'~')=:P740_DIMVALUE)
                 or (:P740_DIMTYPE='ITEM' and e.item_code=:P740_DIMVALUE)
                 or (:P740_DIMTYPE='UNIT' and nvl(e.unit_code,'~')=:P740_DIMVALUE))
                 and (:P740_DOC is null or e.doc_id=to_number(:P740_DOC default null on conversion error)) and :P740_DOC is not null
                ```
            pageItemsToSubmit: [
                P740_FROMDATE
                P740_TODATE
