    pageItem P740_DOC (
        type: popupLov
        label {
            label: Transaction Number
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery: with H(metric,doc_id,doc_no,event_date,company_code,location_code,panel) as (select 'GRN',TNo,GrnNo,GrnDate,CompanyCode,LocationCode,Panel from Grn union all select 'PRODUCTION',TNo,ProductionNo,ProductionDate,CompanyCode,LocationCode,Panel from Production union all select 'PASS',TNo,PBPassNo,PBPassDate,CompanyCode,LocationCode,Panel from PBPass union all select 'DISPATCH',TNo,MaterialOutNo,GateOutTime,CompanyCode,LocationCode,Panel from MaterialOut union all select 'GATE_IN',TNo,MaterialInNo,GateInTime,CompanyCode,LocationCode,Panel from MaterialIn union all select 'SERVICE',TNo,ServiceBillNo,ServiceBillDate,CompanyCode,LocationCode,Panel from ServiceBill union all select 'TRANSFER',TNo,InterUnitTransferNo,InterUnitTransferDate,CompanyCode,LocationCode,Panel from InterUnitTransfer union all select 'ISSUE_RETURN',TNo,IssueReturnNo,IssueReturnDate,CompanyCode,LocationCode,Panel from IssueReturn union all select 'MAINTENANCE',TNo,MaintenanceRequestNo,MaintenanceRequestDate,CompanyCode,LocationCode,cast(null as varchar2(10)) from MaintenanceRequest union all select 'WORKFORCE',TNo,AttendencePeriodicalNo,AttendencePeriodicalDate,CompanyCode,LocationCode,cast(null as varchar2(10)) from AttendencePeriodical) select doc_no d,to_char(doc_id) r from H where metric=:P740_METRIC and event_date>=to_date(:P740_FROMDATE,'DD-MM-RRRR') and event_date<to_date(:P740_TODATE,'DD-MM-RRRR')+1 and (:P740_COMPANY is null or company_code=:P740_COMPANY) and (:P740_LOCATION is null or location_code=:P740_LOCATION) and ((metric='WORKFORCE' and :P740_ALLOW_HR='Y') or (metric='MAINTENANCE' and :P740_ALLOW_MAINT='Y') or (metric not in ('WORKFORCE','MAINTENANCE') and ((select GetUserPanelAB_apex() from dual) is null or panel=(select GetUserPanelAB_apex() from dual)) and (:P740_PANEL is null or panel=:P740_PANEL))) order by event_date desc,doc_no desc
            nullDisplayValue: Choose transaction number
        }
        cascadingLov {
            parentItems: [
                P740_COMPANY
                P740_LOCATION
                P740_FROMDATE
                P740_TODATE
                P740_METRIC
                P740_PANEL
            ]
            itemsToSubmit: [
                P740_COMPANY
                P740_LOCATION
                P740_FROMDATE
                P740_TODATE
                P740_METRIC
                P740_PANEL
            ]
        }
        layout {
            sequence: 60
            region: @transaction-filters
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

