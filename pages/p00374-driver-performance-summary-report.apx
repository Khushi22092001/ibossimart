page 374 (
    name: Driver Performance Summary Report
    alias: DRIVER-PERFORMANCE-SUMMARY-REPORT
    title: Driver Performance Summary Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region driver-performance-summary-report (
        name: Driver Performance Summary Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select Rownum ,x.* , y.* from (select * from (Select 
                    distinct
                    d.LocationName,
                    e.DepartmentName,
                    c.EmployeeID,
                    c.EmployeeName,
                    b.VehicleNo,
                   -- to_number(To_char(a.VehicleDriverDate,'DD'),'99') day,
                    c.employeecode,
                    b.drivercode,
                    j.NoOfTrip as TotalNoOfTrips
                   -- nvl(j.NoOfTrip,0)+nvl(k.NoOfTrips,0)+nvl(l.NoOfTripss,0) as TotalNoOfTrips
                From VehicleDriver a,VehicleDriverDetail b, Employee c, Location d, Department e,
                (Select
                x.VehicleNo,
                x.DriverCode,
                sum(x.NoOfTrip) as NoOfTrip
                From
                (
                Select
                c.EquipmentID as VehicleNo,
                c.DriverCode,
                count(a.ModuleTno) as NoOfTrip
                From NecessitySlipTrip a, LR b, NecessitySlip c
                Where a.ModuleTno = b.Tno
                and a.Tno = c.Tno
                and c.VehicleGroupCode = 'SELF'
                --and a.DistanceInKM is not null
                --and a.DieselQuantity is not null
                and c.NecessitySlipDate between :P374_FROMDATE and :P374_TODATE
                --and c.EquipmentID = :P374_VEHICLE
                Group by
                c.EquipmentID,
                c.DriverCode
                UNION ALL
                Select
                c.EquipmentID as VehicleNo,
                c.DriverCode,
                count(a.ModuleTno) as NoOfTrip
                From NecessitySlipTrip a, InternalTransfer b, NecessitySlip c
                Where a.ModuleTno = b.Tno
                and a.Tno = c.Tno
                and c.VehicleGroupCode = 'SELF'
                --and a.DistanceInKM is not null
                --and a.DieselQuantity is not null
                and c.NecessitySlipDate between :P374_FROMDATE and :P374_TODATE
                --and c.EquipmentID = :P374_VEHICLE
                Group by
                c.EquipmentID,
                c.DriverCode
                Order by 1
                ) x
                Group by
                x.VehicleNo,
                x.DriverCode)j
                Where a.Tno = b.Tno
                and b.DriverCode = c.EmployeeCode
                and c.locationCode = d.LocationCode
                and c.DepartmentCode = e.DepartmentCode
                and b.VehicleNo = j.VehicleNo(+)
                and b.DriverCode = j.DriverCode(+)
                and ( :P374_COMPANY IS NULL OR instr(':'||:P374_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                and a.VehicleDriverDate BETWEEN  :P374_FROMDATE AND :P374_TODATE
                and ( :P374_SITE IS NULL OR instr(':'||:P374_SITE||':',':'||c.DepartmentCode||':') > 0 )
                and ( :P374_EMPLOYEEID IS NULL OR instr(':'||:P374_EMPLOYEEID||':',':'||c.EmployeeID||':') > 0 )
                and ( :P374_EMPLOYEE IS NULL OR instr(':'||:P374_EMPLOYEE||':',':'||c.EmployeeCode||':') > 0 )
                and ( :P374_VEHICLE IS NULL OR instr(':'||:P374_VEHICLE||':',':'||b.VehicleNo||':') > 0 )
                
                    
                ))x,
                (Select b.drivercode as dvcode,
                      b.vehicleno as vcno,
                      Count( a.vehicledriverdate) As P
                      From vehicledriver a, vehicledriverdetail b
                       Where a.tno = b.tno(+)
                       and a.VehicleDriverDate BETWEEN  :P374_FROMDATE AND :P374_TODATE
                            --   And b.drivercode = '340'
                        --- and ( :P370_MONTH IS NULL OR instr(':'||:P370_MONTH||':',':'||To_char(a.VehicleDriverDate,'MON-RRRR')||':') > 0 )
                
                       Group By b.drivercode,
                          b.vehicleno
                  )y
                  Where x.drivercode = y.Dvcode(+) 
                    and x.vehicleno = y.vcno(+)--;
                 --   AND X.EMPLOYEEID = 'CMPL10109';
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 108184141505245319
        }

