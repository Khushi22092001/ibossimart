    pageItem P374_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                b.CompanyName d,
                b.CompanyCode r                                                
                From VehicleDriver a, Company b
                Where a.CompanyCode = b.CompanyCode
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @driver-performance-summary-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
