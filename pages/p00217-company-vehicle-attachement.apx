page 217 (
    name: Company vehicle Attachement
    alias: COMPANY-VEHICLE-ATTACHEMENT
    title: Company vehicle Attachement
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region company-vehicle-attachment (
        name: Company Vehicle Attachment
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P217_FILENAME (
        type: displayOnly
        label {
            label: File Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @company-vehicle-attachment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                Select a.filename
                from companyvehicleattachment a
                where a.sno=:P217_SNO
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P217_NEW (
        type: displayImage
        label {
            label: File :
            alignment: left
        }
        settings {
            basedOn: blobColSql
            sqlQuery:
                ```sql
                Select a.ATTACHMENTBLOB
                from CompanyVehicleAttachment a
                Where a.SNO=:P217_SNO
                ```
        }
        layout {
            sequence: 20
            region: @company-vehicle-attachment
            slot: regionBody
            alignment: left
            column: 1
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: "\" height=\"1000\" width=\"800\""
        }
    )

    pageItem P217_SNO (
        type: hidden
        layout {
            sequence: 30
            region: @company-vehicle-attachment
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 10
            region: @company-vehicle-attachment
            slot: previous
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 216
                action: resetPagination
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

