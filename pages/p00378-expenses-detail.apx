                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    c.VehicleTypeName d,
                    c.VehicleTypeCode r
                From VehicleType c
                Where exists
                (Select
                		aa.VehicleTypeCode
                From CompanyVehicle aa, Equipment bb
                Where aa.ModuleTno = bb.Tno
                  and bb.EquipmentGroupCode = 'CT' 
                  and aa.VehicleTypeCode = c.VehicleTypeCode)
                
                
                
                
                
                
                
                
                ```
            displayNullValue: false
        }
        layout {
