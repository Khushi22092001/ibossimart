    pageItem P378_CATEGORY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Category
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    'TYRE' as d,
                    'TYRE' as r
                From Dual
                UNION ALL
                Select
                    'DIESEL' as d,
                    'DIESEL' as r
                From Dual
                UNION ALL
                Select
                   'SPARE' as d,
                   'SPARE' as r
                From Dual
                UNION ALL
                Select
                   'DA' as d,
                   'DA' as r
                From Dual
                UNION ALL
                Select
                   'BATTERY' as d,
                   'BATTERY' as r
                From Dual
                UNION ALL
                Select
                   'TRIP' as d,
                   'TRIP' as r
                From Dual
                UNION ALL
                Select
                   'TOLLTAX' as d,
                   'TOLLTAX' as r
                From Dual
                UNION ALL
                Select
                   'EMI' as d,
                   'EMI' as r
                From Dual
                UNION ALL
                Select
                   'OTHER' as d,
                   'OTHER' as r
                From Dual
                
                
                
                ```
            displayNullValue: false
        }
        layout {
