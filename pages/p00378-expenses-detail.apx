page 378 (
    name: Vehicle Expenses Detail
    alias: EXPENSES-DETAIL
    title: Vehicle Expenses Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var lSpinner$;
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region expenses-detail (
        name: Expenses Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                a.Categories,
                a.ModuleName,
                a.ModuleNo,
                a.ModuleDate,
                a.VehicleNo,
                c.TransportAreaCode,
                sum(a.Quantity) as Quantity,
                sum(a.Amount) as Amount,
                b.VehicleTypeName
                From VehicleExpenseTable a, VehicleType b, TransportArea c
                Where a.Creator = :APP_USER
                and a.VehicleTypeCode = b.VehicleTypeCode(+)
                and a.TransportAreaCode = c.TransportAreaCode(+)
                and a.ModuleDate between :P378_FROMDATE and :P378_TODATE
                and (:P378_COMPANYCODE is Null Or Instr (':' || :P378_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P378_VEHICLENO is Null Or Instr (':' || :P378_VEHICLENO || ':' , ':' || a.VehicleNo || ':') > 0)
                and (:P378_CATEGORY is Null Or Instr (':' || :P378_CATEGORY || ':' , ':' || a.Categories || ':') > 0)
                and (:P378_VEHICLETYPE is Null Or Instr (':' || :P378_VEHICLETYPE || ':' , ':' || a.VehicleTypeCode || ':') > 0)
                and (:P378_VEHICLENO2 is null
                       or exists(
                         Select
                            aa.VehicleNo
                          From VPVehicleNo aa
                          Where aa.VehicleNo = a.VehicleNo
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P378_VEHICLETYPE2 is null
                       or exists(
                         Select
                            aa.VehicleTypeCode
                          From VPVehicleType aa
                          Where aa.VehicleTypeCode = a.VehicleTypeCode
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P378_TRANSPORTAREA is null
                       or exists(
                         Select
                            aa.TransportAreaCode
                          From VPTransportArea aa
                          Where aa.TransportAreaCode = a.TransportAreaCode
                              and aa.Creator = :APP_USER
                       )
                   )
                Group by
                a.Categories,
                a.ModuleName,
                a.ModuleNo,
                a.ModuleDate,
                a.VehicleNo,
                b.VehicleTypeName,
                c.TransportAreaCode
                ```
        }
        layout {
            sequence: 110
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: expensesdetail
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 108795854128780542
        }

