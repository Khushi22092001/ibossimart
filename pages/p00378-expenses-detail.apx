    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction preparerecord (
        name: PrepareRecord
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 50
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: PrepareVehicleExpense(:P378_COMPANY,:P378_VEHICLENO,:P378_VEHICLETYPE,:P378_FROMDATE,:P378_TODATE, :APP_USER);
                itemsToSubmit: [
                    P378_COMPANY
                    P378_FROMDATE
                    P378_TODATE
                    P378_VEHICLENO
                    P378_VEHICLETYPE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#apex_wait_overlay").remove();
                    $(".u-Processing").remove();
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @expenses-detail
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction show-spinner (
        name: Show Spinner
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var lSpinner$ = apex.util.showSpinner( $( "#expensesdetail" ) );
                    //var spinner = apex.util.showSpinner("", {size:"big",color:"blue"})
                    
                    //spinner.remove();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

