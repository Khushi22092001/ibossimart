page 361 (
    name: Employee Salary Structure Report
    alias: EMPLOYEE-SALARY-STRUCTURE-REPORT
    title: Employee Salary Structure Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employee-salary (
        name: "Employee Salary "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                row_number() over(order by a.EffectiveDate) SerialNo,
                GetEmployeeName(a.EmployeeCode) as EmployeeName,
                GetCompanyName(a.Companycode) as CompanyName,
                GetLocationName(a.LocationCode) as LocationName,
                a.EffectiveDate,
                null as PreviousBasic,
                nvl( (Select
                aa.SalaryHeadFormula
                from EmployeeSalaryDetail aa
                where aa.SalaryHeadCode='BASIC'
                and aa.Tno = a.Tno),0) as CurrentBasic,
                null as PreviousGOVBasic,
                NVL((Select
                aa.SalaryHeadFormula
                from EmployeeSalaryDetail aa
                where aa.SalaryHeadCode='GOVBASIC'
                AND AA.TNO=A.TNO),0) as CurrentGOVBasic,
                null as PreviousPaidDays,
                NVL((Select
                aa.SalaryHeadFormula
                from EmployeeSalaryDetail aa
                where aa.SalaryHeadCode='CALCULATEPAIDDAYS'
                AND AA.TNO=A.TNO),0) as CurrentPaidDays,
                null as PreviousFoodAllow,
                NVL((Select
                aa.SalaryHeadFormula
                from EmployeeSalaryDetail aa
                where aa.SalaryHeadCode='FOODALLOWANCE'
                AND AA.TNO=A.TNO),0) as CurrentFoodAllow,
                GetEmployeeEmployeeid(a.Employeecode,a.EmployeeSalaryDate) as EmployeeId,
                NVL((Select
                aa.SalaryHeadFormula
                from EmployeeSalaryDetail aa
                where aa.SalaryHeadCode='BONUS'
                AND AA.TNO=A.TNO),0) as Bonus,
                b.SalarySchemeName,
                nvl(d.DepartmentName,f.DepartmentName) as Department
                From EmployeeSalary a, SalaryScheme b, Employee c, Department d, ChangeInEmployee e, Department f
                where a.SalarySchemeCode = b.SalarySchemeCode(+)
                 and a.EmployeeCode = c.EmployeeCode(+)
                 and c.DepartmentCode = d.DepartmentCode(+)
                 and a.EmployeeCode = e.EmployeeCode(+)
                 and e.NewDepartmentCode = f.DepartmentCode(+)
                and a.EffectiveDate between :P361_FROMDATE and :P361_TODATE
                and ( :P361_COMPANY IS NULL OR instr(':'||:P361_COMPANY||':',':'||a.CompanyCode||':') > 0)
                and ( :P361_LOCATION IS NULL OR instr(':'||:P361_LOCATION||':',':'||a.LocationCode||':') > 0)
                and ( :P361_EMPLOYEE IS NULL OR instr(':'||:P361_EMPLOYEE||':',':'||a.EmployeeCode||':') > 0);
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 79528543364410447
        }

