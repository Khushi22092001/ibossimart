            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region quality-test-register (
        name: Quality Test  Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region quality-test-register-2 (
        name: Quality Test  Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.TNo,
                       l.LocationName,
                       p.PartyName,
                       a.QualityTestNo,
                       a.QualityTestDate,
                       a.QCSampleTNo,
                       c.QCsampleNo,
                       c.QCSampleDate,
                       e.ItemCode,
                       e.ItemName || ' ~ ' || ee.ItemSpecificationName As item,
                       e.MeasuringUnitCode1 As UOM,
                       'QUALITY' As QUALILTY,
                       q.qualityname,
                       qt.billedtestvalue,
                       qt.testvalue
                  From QualityTest       a,
                       QCSample          c,
                       Item              e,
                       itemSPecification ee,
                       party             p,
                       Location          l,
                       qualitytestdetail qt,
                       quality           q
                 Where a.QCSampleTNo = c.TNo
                   And c.ItemCode = e.ItemCode
                   And c.ItemSpecificationCode = ee.ItemSpecificationCode
                   And c.PartyCode = p.PartyCode
                   And a.LocationCode = l.LocationCode
                   And a.tno = qt.tno(+)
                   And qt.qualitycode = q.qualitycode(+)
                   and a.QualityTestDate between :P150_FROMDATE and :P150_TODATE
                  and instr(':'||:P150_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P150_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and ( :P150_ITEM IS NULL OR instr(':'||:P150_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P150_SPECIFICATION IS NULL OR instr(':'||:P150_SPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                  and ( :P150_PARTYNAME IS NULL OR instr(':'||:P150_PARTYNAME||':',':'||p.PartyCode||':') > 0 ) 
                  and c.QCSampleNo like nvl(:P150_QCSNO,'%')
                  and a.QualityTestNo like nvl(:P150_QTNO,'%')
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                /*Select
                      a.TNo,
                      l.LocationName,
                      p.PartyName,
                      a.QualityTestNo,
                      a.QualityTestDate,
                      a.QCSampleTNo,
                      c.QCsampleNo,
                      c.QCSampleDate,
                      e.ItemCode,
                      e.ItemName||' ~ '||ee.ItemSpecificationName as item,
                      e.MeasuringUnitCode1 as UOM,
                      'QUALITY' AS QUALILTY
                From  QualityTest a, QCSample c, Item e, itemSPecification ee, party p, Location l
                Where  a.QCSampleTNo = c.TNo
                  and c.ItemCode = e.ItemCode
                  and c.ItemSpecificationCode = ee.ItemSpecificationCode
                  and c.PartyCode = p.PartyCode
                  and a.LocationCode = l.LocationCode
                  and a.QualityTestDate between :P150_FROMDATE and :P150_TODATE
                  and instr(':'||:P150_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P150_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and ( :P150_ITEM IS NULL OR instr(':'||:P150_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P150_SPECIFICATION IS NULL OR instr(':'||:P150_SPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                  and ( :P150_PARTYNAME IS NULL OR instr(':'||:P150_PARTYNAME||':',':'||p.PartyCode||':') > 0 ) 
                  and c.QCSampleNo like nvl(:P150_QCSNO,'%')
                  and a.QualityTestNo like nvl(:P150_QTNO,'%')
                  */
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
