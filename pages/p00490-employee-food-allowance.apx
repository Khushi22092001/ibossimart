page 490 (
    name: Employee Food Allowance
    alias: EMPLOYEE-FOOD-ALLOWANCE
    title: Employee Food Allowance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employee-food-allowance (
        name: Employee Food Allowance
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region employee-food-allowance-2 (
        name: Employee Food Allowance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.LocationName,
                       a.EmployeeFoodAllowanceDate,
                       a.EmployeeFoodAllowanceNo,
                       c.EmployeeName,
                       a.DeductionApplicable
                From   EmployeeFoodAllowance a,Location b,Employee c
                Where  a.LocationCode = b.LocationCode(+)
                  and  a.EmployeeCode = c.EmployeeCode(+)
                  and  a.EmployeeFoodAllowanceDate Between :P490_FROMDATE And :P490_TODATE
                  and  (:P490_COMPANY IS NULL OR instr(':'||:P490_COMPANY||':',':'||a.CompanyCode||':') > 0)
                  and  (:P490_LOCATION IS NULL OR instr(':'||:P490_LOCATION||':',':'||a.LocationCode||':') > 0)
                  and  (:P490_EMPLOYEE IS NULL OR instr(':'||:P490_EMPLOYEE||':',':'||a.EmployeeCode||':') > 0)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 43437674768212663
        }

        column DEDUCTIONAPPLICABLE (
            type: plainText
            heading {
                heading: Deduction Applicable
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column EMPLOYEEFOODALLOWANCEDATE (
            type: plainText
            heading {
                heading: Employee Food Allowance Date
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column EMPLOYEEFOODALLOWANCENO (
            type: plainText
            heading {
                heading: Employee Food Allowance No
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column EMPLOYEENAME (
            type: plainText
            heading {
                heading: Employee Name
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Employee Food Allowance
        }

        savedReport 434462 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEDUCTIONAPPLICABLE (
                sequence: 5
            )

            displayColumn EMPLOYEEFOODALLOWANCEDATE (
                sequence: 2
            )

            displayColumn EMPLOYEEFOODALLOWANCENO (
                sequence: 3
            )

            displayColumn EMPLOYEENAME (
                sequence: 4
            )

            displayColumn LOCATIONNAME (
                sequence: 1
            )

            sort (
                column: EMPLOYEEFOODALLOWANCEDATE
                sort {
                    sequence: 1
                }
            )

        )

    )

    pageItem P490_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  Distinct 
                        b.CompanyName d,
                        b.CompanyCode r
                From    EmployeeFoodAllowance a,Company b
                Where   a.CompanyCode = b.CompanyCode(+)
                Order By 1
                ```
        }
        layout {
            sequence: 30
            region: @employee-food-allowance
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P490_EMPLOYEE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Employee
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  Distinct 
                        b.EmployeeName d,
                        b.EmployeeCode r
                From    EmployeeFoodAllowance a,Employee b
                Where   a.EmployeeCode = b.EmployeeCode(+)
                Order By 1
                ```
        }
        layout {
            sequence: 50
            region: @employee-food-allowance
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P490_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @employee-food-allowance
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P490_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  Distinct 
                        b.LocationName d,
                        b.LocationCode r
                From    EmployeeFoodAllowance a,Location b
                Where   a.LocationCode = b.LocationCode(+)
                Order By 1
                ```
        }
        layout {
            sequence: 40
            region: @employee-food-allowance
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P490_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @employee-food-allowance
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 50
            region: @employee-food-allowance
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

