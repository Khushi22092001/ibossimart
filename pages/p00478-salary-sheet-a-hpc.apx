page 478 (
    name: Salary Sheet (A/HPC)
    alias: SALARY-SHEET-A-HPC
    title: Salary Sheet (A/HPC)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region salary-sheet-a-hpc (
        name: Salary Sheet (A/HPC)
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region salary-sheet-a-hpc-2 (
        name: Salary Sheet (A/HPC)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName,
                       SUM(decode(c.salaryheadcode, 'PR', c.SALARYHEADAMOUNT))    AS P,
                       SUM(decode(c.salaryheadcode, 'WD', c.SALARYHEADAMOUNT))    AS OFF,
                       --------24-01-2025 -------HIDE OT COLUMN-----------
                       --SUM(decode(c.salaryheadcode, 'OT', c.SALARYHEADAMOUNT))    AS OT,
                       SUM(decode(c.salaryheadcode, 'APD', c.SALARYHEADAMOUNT))   AS Actual_Paid_Days,
                       SUM(decode(c.salaryheadcode, 'MAP', c.SALARYHEADAMOUNT))   AS Present_Age_Days,
                       SUM(decode(c.salaryheadcode, 'PD', c.SALARYHEADAMOUNT))    AS Total_Present_Days,
                       SUM(decode(c.salaryheadcode, 'BASIC', c.SALARYHEADAMOUNT)) AS Wage_Rate,
                       SUM(decode(c.salaryheadcode, 'EARNEDBASIC', c.SALARYHEADAMOUNT)) AS Gross_Earning,
                       SUM(decode(c.salaryheadcode, 'CANTEENDED', c.SALARYHEADAMOUNT)) AS Food_Etc,
                       SUM(decode(c.salaryheadcode, 'PFEMPLOYEE', c.SALARYHEADAMOUNT)) AS PF,
                       SUM(decode(c.salaryheadcode, 'ESICEMPLOYEECONTRIBUTION', c.SALARYHEADAMOUNT)) AS ESIC,
                       SUM(decode(c.salaryheadcode, 'PTAX', c.SALARYHEADAMOUNT)) AS PT,
                       SUM(decode(c.salaryheadcode, 'RUNNINGADVANCEDED', c.SALARYHEADAMOUNT)) AS Running_Advance,
                       SUM(decode(c.salaryheadcode, 'SALARYADVANCEDED', c.SALARYHEADAMOUNT)) AS Salary_Advance,
                       SUM(decode(c.salaryheadcode, 'GROSSDEDUCTION', c.SALARYHEADAMOUNT)) AS Total_Deduction,
                       SUM(decode(c.salaryheadcode, 'OTHER INCOME', c.SALARYHEADAMOUNT)) AS Other_Income,
                       SUM(decode(c.salaryheadcode, 'OTHERDEDUCTION', c.SALARYHEADAMOUNT)) AS Other_Deduction,
                       SUM(decode(c.salaryheadcode, 'NETEARNING', c.SALARYHEADAMOUNT)) AS Net_Earning,
                       GetLocationName(a.LocationCode) Location,
                       a.SalaryNo Entry_No
                From   Salary a,Employee b,SalaryDetail c,Designation d,EmployeeSalary e,SalaryScheme f
                Where  a.EmployeeCode = b.EmployeeCode(+)
                  and  a.TNo = c.TNo(+)
                  and  b.DesignationCode = d.DesignationCode(+)
                  and  a.EmployeeSalaryTno = e.Tno(+)
                  and  e.Salaryschemecode = f.SalarySchemeCode(+)
                  and  f.SalarySchemeCode = '99999999'
                  and  to_char(a.SalaryFromDate,'MON-RRRR') = :P478_MONTH
                  and  (:P478_COMPANY IS NULL OR instr(':'||:P478_COMPANY||':',':'||b.CompanyCode||':') > 0)
                  and  (:P478_LOCATION IS NULL OR instr(':'||:P478_LOCATION||':',':'||a.LocationCode||':') > 0)
                  and  (:P478_EMPLOYEE IS NULL OR instr(':'||:P478_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0)
                Group By b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName,
                       GetLocationName(a.LocationCode) ,
                       a.SalaryNo
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 43106592588347108
        }

