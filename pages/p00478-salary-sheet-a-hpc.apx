    pageItem P478_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  Distinct
                        c.CompanyName d,
                        c.CompanyCode r
                From    Salary a,Employee b,Company c
                Where   a.EmployeeCode = b.EmployeeCode(+)
                  and   b.CompanyCode = c.CompanyCode(+)
                  Order By 1
                ```
        }
        layout {
            sequence: 20
            region: @salary-sheet-a-hpc
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

