                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @firstpage
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.region("MYID").widget.setCurrentPage(1);
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-3 (
        name: New_2
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @lastpage
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var report = apex.region("MYID").widget;
                    apex.server.process(
                      "GET_LAST_PAGE", 
                      {
                        x01: report.widget().interactiveGrid("getViews", "grid").model.totalRowCount
                      },
                      {
                        success: function(data) {
                          report.widget().interactiveGrid("setOption", "currentPage", data.page);
                        }
                      }
                    );
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-4 (
        name: New_3
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P397_INDENTNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P397_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P397_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 9770266961128252
        }
    )

)

