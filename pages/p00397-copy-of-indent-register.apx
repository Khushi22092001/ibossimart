    region indent-register-report (
        name: Indent Register Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select * from 
                (Select
                      a.TNo,
                      b.SNo,
                      l.LocationName,
                      dt.DocTypeName,
                      dp.DepartmentName,
                      a.IndentNo,
                      a.IndentDate,
                      a.Remark,
                      e.ParentCode||' ~ '||GetItemname(e.ParentCode) as MaterialGroup,
                      b.ItemCode,
                      e.ItemName||' ~ '||ee.ItemSpecificationName as Material,
                      e.MeasuringUnitCode1 as UOM1,
                      round(b.IndentQuantity1,3) as IndentQuantity1,
                      e.MeasuringUnitCode2 as UOM2,
                      round(b.IndentQuantity2,3) as IndentQuantity2,
                      round(c.Quantity1,3) as SanctionQuantity1,
                      round(c.Quantity2,3) as SanctionQuantity2,
                      round(b.IndentQuantity1 - b.Quantity1,3)  as DiffSanctionandIndent,
                      b.Remark as Purpose,
                      b.DocumentStatusCode as DocumentStatus,
                      case when po.indenttno = a.tno then
                                'PREPARED'
                           when cp.Indenttno = a.tno then
                                'CASHPURCHASE'
                           when po.indenttno is null or cp.indenttno is null then
                                'PENDING'
                       end POStatus,
                      --nvl(decode(po.IndentTNo,a.TNo,'PREPARED'),'PENDING') as POStatus,
                      po.Tno as POTNO,
                      po.PurchaseOrderNo,
                      po.PurchaseOrderDate,
                      po.PartyName,
                      round(po.POQuantity1,3) as POQuantity1,
                      round(po.POQuantity2,3) as POQuantity2,
                      round(b.Quantity1 - po.POQuantity1,3) as Variance1,
                      round(b.Quantity2 - po.POQuantity2,3) as Variance2,
                      bue.EmployeeName||' ( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      cc.CostCentreName,
                      case When b.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When b.DocumentStatusCode is null Then 'NON-ACTIVE'
                           When b.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When b.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When b.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When b.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When b.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When b.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When b.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When b.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When b.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End as DocStatus
                From  Indent a, IndentDetail b, IndentCostCentreDetail c, CostCentre cc, Location l , Doctype dt, Department dp, Item e, ItemSpecification ee, MeasuringUnit mu, BossUser bu, Employee bue,
                      (Select
                            pp.TNo,
                            qq.IndentTNo,
                            pp.PurchaseOrderNo,
                            pp.PurchaseOrderDate,
                            ppp.PartyName,
                            ppp.PartyCode,
                            qq.ItemCode,
                            qq.ItemSpecificationCode,
                            qq.Quantity1 as POQuantity1,
                            qq.Quantity2 as POQuantity2
                      From  PurchaseOrder pp, PurchaseOrderDetailIndent qq, Party ppp
                      Where pp.TNo = qq.TNo
                        and pp.PartyCode = ppp.PartyCode ) po,
                       (Select pp.TNo,
                            qq.IndentTNo,
                            ppp.PartyName,
                            ppp.PartyCode,
                            qq.ItemCode,
                            qq.ItemSpecificationCode,
                            qq.Quantity1             As POQuantity1,
                            qq.Quantity2             As POQuantity2
                        From CashPurchase pp, CashPurchaseDetail qq, Party ppp
                        Where pp.TNo = qq.TNo
                        And pp.PartyCode = ppp.PartyCode(+) ) CP
                Where a.TNo = b.TNo(+)
                  and b.TNo = c.TNo(+)
                  and b.SNo = c.SNo(+)
                  and c.CostCentreCode = cc.CostCentreCode(+)
                  and a.LocationCode = l.LocationCode(+)
                  and a.DocTypeCode = dt.DocTypeCode(+)
                  and a.DepartmentCode = dp.DepartmentCode(+)
                  and b.ItemCode = e.ItemCode(+)
                  and B.Itemspecificationcode = ee.ItemSpecificationCode(+)
                  and E.Measuringunitcode1 = Mu.Measuringunitcode(+)
                  and b.Tno = po.IndentTNo(+)
                  and b.ItemCode = Po.Itemcode(+)
                  and b.Itemspecificationcode = po.ItemSpecificationCode(+)
                
                  and b.Tno = cp.IndentTNo(+)
                  and b.ItemCode = cp.Itemcode(+)
                  and b.Itemspecificationcode = cp.ItemSpecificationCode(+)
                
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)
                  and a.IndentDate between :P397_FROMDATE and :P397_TODATE
                  and instr(':'||:P397_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                  and instr(':'||:P397_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P397_COMPANY||':',':'||a.CompanyCode||':') > 0
                 -- and nvl(decode(po.IndentTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P397_POSTATUS,'%')
                  and ( :P397_ITEM IS NULL OR instr(':'||:P397_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P397_ITEMSPECIFICATION IS NULL OR instr(':'||:P397_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                 -- and ( :P397_GROUP IS NULL OR instr(':'||:P397_GROUP||':',':'||e.ParentCode||':') > 0 ) 
                  and ( :P397_DEPARTMENT IS NULL OR instr(':'||:P397_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0 ) 
                  and ( :P397_COSTCENTRE IS NULL OR instr(':'||:P397_COSTCENTRE||':',':'||cc.CostCentreCode||':') > 0 ) 
                  and a.IndentNo like nvl(:P397_INDENTNO,'%')
                  -- Added on 28-May-2022
                  and ( :P397_GROUP IS NULL
                      or
                      exists (select 1 from (Select ITEMCODE,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                               Level,
                               CONNECT_BY_ROOT itemcode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From item a
                         Start With parentcode in ( select itemcode from item xx where
                                                    instr(':'||:P397_GROUP||':',':'||xx.ItemCode||':') > 0)
                                                    
                        Connect By parentcode = Prior itemcode
                         Order Siblings By itemcode) x where x.itemcode = e.itemcode
                        )
                  )
                 
                  and case When b.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When b.DocumentStatusCode is null Then 'NON-ACTIVE'
                           When b.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When b.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When b.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When b.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When b.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When b.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When b.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When b.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When b.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End  like nvl(:P397_STATUS,'%') 
                ) xx
                where xx.postatus like nvl(:P397_POSTATUS,'%')
                /*case when xx.indenttno = a.tno then 'PREPARED'
                               when cp.Indenttno = a.tno then  'CASH PURCHASE'
                               when (po.indenttno is null or cp.indenttno is null) then 'PENDING'
                          End like nvl(:P397_POSTATUS,'%')*/
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
