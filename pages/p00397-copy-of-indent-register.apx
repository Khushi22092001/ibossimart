                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                  Select Upper(a.ItemName || ' ( ' || a.ItemCode || ' )') As d,
                       a.ItemCode As r
                  From Item a
                 Where a.ItemType = 'GROUP'
                 order by 2
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
