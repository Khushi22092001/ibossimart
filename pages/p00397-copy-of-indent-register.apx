    pageItem P397_GROUP (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: "Group "
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
