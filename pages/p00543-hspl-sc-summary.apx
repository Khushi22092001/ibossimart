page 543 (
    name: HSPL SC Summary
    alias: HSPL-SC-SUMMARY
    title: HSPL SC Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hspl-sc-summary (
        name: HSPL SC Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    Sum(x.Scqty) As Scqty,
                    Sum(x.Newscqty) As Newscqty,
                    Sum(x.Despqy) As Despqy,
                    Sum(x.Scqty) + Sum(x.Newscqty) - Sum(x.Despqy) As Closing
                From
                (
                    Select
                        Sum(A.Scqty) As Scqty,
                        Null As Newscqty,
                        Null As Despqy
                    From Scbalance A
                    Where A.Salesconfirmdate < Trunc(To_Date(:P543_ASONDATE, 'DD-MM-YYYY')) - 1
                      And Getdocumentstatuscode('SALESCONFIRM', A.Tno) = 'ACTIVE'
                      and ( :P543_PARTY IS NULL OR instr(':'||:P543_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                
                    Union All
                
                    Select
                        Null As Scqty,
                        Sum(A.Scqty) As Newscqty,
                        Sum(A.Ccqty) As Despqy
                    From Scbalance A
                    Where A.Salesconfirmdate = Trunc(To_Date(:P543_ASONDATE, 'DD-MM-YYYY')) - 1
                      And Getdocumentstatuscode('SALESCONFIRM', A.Tno) = 'ACTIVE'
                      and ( :P543_PARTY IS NULL OR instr(':'||:P543_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                ) x
                
                ```
            pageItemsToSubmit: [
                P543_ASONDATE
                P543_PARTY
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 31905503197558596
        }

        column CLOSING (
            type: plainText
            heading {
                heading: SC BAL QTY
                alignment: end
            }
            layout {
                sequence: 190
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AA
            }
        )

        column DESPQY (
            type: plainText
            heading {
                heading: SC OUT QTY
                alignment: end
            }
            layout {
                sequence: 180
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Z
            }
        )

        column NEWSCQTY (
            type: plainText
            heading {
                heading: SC NEW QTY
                alignment: end
            }
            layout {
                sequence: 170
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Y
            }
        )

        column SCQTY (
            type: plainText
            heading {
                heading: TOTAL SC OPENING QTY
                alignment: end
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 16
            pageHeaderText: "   Freight Advance Report"
        }

        savedReport 126330 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CLOSING (
                sequence: 4
            )

            displayColumn DESPQY (
                sequence: 2
            )

            displayColumn NEWSCQTY (
                sequence: 3
            )

            displayColumn SCQTY (
                sequence: 1
            )

        )

    )

    pageItem P543_ASONDATE (
        type: datePicker
        label {
            label: As On Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @hspl-sc-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 5
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: From Date
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE) - 1
        }
    )

    pageItem P543_PARTY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Party Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   a.PartyName d,
                   a.PartyCode r
                From Party a
                Where exists
                (Select
                     aa.Tno
                    From SalesConfirm aa
                    Where aa.PartyCode = a.PartyCode);
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @hspl-sc-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Select Party Name
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 120
            region: @hspl-sc-summary
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

