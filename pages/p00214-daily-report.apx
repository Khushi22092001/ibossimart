                -- and (:P214_COMPANY is Null Or Instr (':' || :P214_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                -- and (:P214_PARTY is Null Or Instr (':' || :P214_PARTY || ':' , ':' || z.PartyCode || ':') > 0)
