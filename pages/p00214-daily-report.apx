page 214 (
    name: Daily Report
    alias: DAILY-REPORT
    title: Daily Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region daily-report (
        name: Daily Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                ROWNUM AS SerialNo,
                d.CompanyName,
                z.PartyName,
                aa.PartyDoNo,
                x.SourceLocationName,
                y.DestinationLocationName,
                count(a.Tno) as NoofLR,
                Count(decode(b.Tno, null, null, b.Tno)) as NoofPOD,
                count(a.Tno) - Count(decode(b.Tno, null, null, b.Tno)) as NoOfNonPOD,
                round(Sum(decode(b.Quantity1, null, null, b.Quantity1)),3)as PODQuantity,
                round(Sum(a.Quantity1),3) as TotalWeightMT,
                round(Sum(a.Quantity1) - Sum(decode(b.Quantity1, null, null, b.Quantity1,a.Quantity1)),3) as NoOfNonPODQuantity,
                Count(p.VehicleNo) as SelfVehicle,
                Count(o.VehicleNo) as OtherVehicle,
                c.LocationName,
                a.Creator
                from DeliveryOrder aa,lr a, PODDetail b, Location c, Company d, SourceLocation x, DestinationLocation y,Party z,
                (
                Select
                a.Tno,
                a.vehicleno
                from LR a, companyVehicle b
                where a.VehicleNo = b.CompanyVehicleNo(+)
                and b.VehicleGroupCode != 'SELF'
                ) o,
                (
                Select
                a.Tno,
                a.vehicleno
                from LR a,companyVehicle b
                where a.VehicleNo = b.CompanyVehicleNo(+)
                and b.VehicleGroupCode = 'SELF'
                ) p
                Where a.DeliveryOrderTno = aa.Tno(+)
                and a.Tno = b.LRTno(+)
                and   a.LocationCode = c.LocationCode(+)
                and a.CompanyCode = d.CompanyCode(+)
                and a.SourceLocationTno = x.Tno(+)
                and a.DestinationLocationTno = y.Tno(+)
                and a.PartyCode = z.PartyCode(+)
                and a.Tno = o.Tno(+)
                and a.Tno = p.Tno(+)
                and a.lrdate Between :P214_FROMDATE and :P214_TODATE
                and (:P214_LOCATION is Null Or Instr (':' || :P214_LOCATION || ':' , ':' || c.LocationCode || ':') > 0)
                and (:P214_COMPANY is Null Or Instr (':' || :P214_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P214_PARTY is Null Or Instr (':' || :P214_PARTY || ':' , ':' || z.PartyCode || ':') > 0)
                and (:P214_PARTYDONO is Null Or Instr (':' || :P214_PARTYDONO || ':' , ':' || aa.Tno || ':') > 0)
                Group By
                c.LocationName,
                x.SourceLocationName,
                y.DestinationLocationName,
                aa.PartyDoNo,
                z.PartyName,
                d.CompanyName,
                a.Creator,
                ROWNUM
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
