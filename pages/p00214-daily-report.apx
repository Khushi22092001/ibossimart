                -- GetCompanyName(a.CompanyCode) as CompanyName,
                -- z.PartyName,
                -- x.SourceLocationName,
                -- y.DestinationLocationName,
                -- count(a.Tno) as NoofLR,
                -- Count(b.Tno) as NoofPOD,
                -- NVL(count(a.Tno),0) - NVL(Count(b.Tno),0) as NoOfNonPOD,
                -- Sum(b.Quantity1)as PODQuantity,
                -- --Sum(a.DieselQuantity) as DieselLiter,
                -- Sum(a.Quantity1) as TotalWeightMT,
                -- --Sum(n.Quantity1) as DieselQuantity,
                -- --Round(Sum(n.Amount),2) as DieselAmount,
                -- Count(p.VehicleNo) as SelfVehicle,
                -- Count(o.VehicleNo) as OtherVehicle,
                -- c.LocationName
                -- from lr a, PODDetail b, Location c,SourceLocation x, DestinationLocation y,Party z,
                -- /*(
                --         Select w.TNo,
                --                B.Quantity1,
                --                ncd.TotalAmount as Amount
                --         From  NecessitySlip a, NecessitySlipDetail b, VehicleNecessity vn,
                --         NecessityCompletion nc, Necessitycompletiondetail ncd, Lr w
                --         Where a.tno = b.tno(+)
                --             and   a.LrTno = w.Tno(+) 
                --             and   b.VehiclenecessityCode = vn.VehicleNecessityCode(+)
                --             and   nc.tno = ncd.tno(+)
                --             and   Ncd.Necessitysliptno = a.tno
                
                -- Union all
                
                --     Select w.TNo,
                --           B.Quantity1,
                --           Par.Amount
                --     From  NecessitySlip a, NecessitySlipDetail b,VehicleNecessity vn, 
                --            paymentAdvice pa, Paymentadvicereference par, LR w
                --     Where a.tno = b.tno(+)
                --         and   a.LrTno = w.Tno(+)
                --         and   b.VehiclenecessityCode = vn.VehicleNecessityCode(+)
                --         and   pa.tno = Par.Tno(+)
                --         and   Par.Referencemoduletno = a.tno
                
                -- UNION All
                
                --   Select w.TNo,
                --       Us.UsedStockQuantity1 as Quantity1,
                --       (Us.UsedStockQuantity1 * s.Rate) Amount
                --      from NecessitySlip a,NecessitySlipDetail b, VehicleNecessity vn, 
                --       Issue pa,UsedStock Us, Stock s , Lr w
                --     Where a.tno = b.tno
                --         and   a.LrTno = w.Tno(+)
                --         and   b.VehicleNecessityCode = vn.VehicleNecessityCode(+)
                --         and   pa.ModuleTno = a.Tno
                --         and   pa.Tno = Us.ModuleTno
                --         and   Us.StockTno = s.Tno) n,*/
                        
                --         (Select a.Tno, a.vehicleno from LR a,companyVehicle b
                --         where a.VehicleNo = b.CompanyVehicleNo(+)
                --         and b.VehicleGroupCode != '2') o,
                        
                --         (Select a.Tno, a.vehicleno from LR a,companyVehicle b
                --         where a.VehicleNo = b.CompanyVehicleNo(+)
                --         and b.VehicleGroupCode = '2'
                --         ) p
                -- Where a.Tno = b.LRTno(+)
                -- --and   a.Tno = n.Tno(+)
                -- and   a.LocationCode = c.LocationCode(+)
                -- and a.SourceLocationTno = x.Tno(+)
                -- and a.DestinationLocationTno = y.Tno(+)
                -- and a.PartyCode = z.PartyCode(+)
                -- and a.Tno = o.Tno(+)
                -- and a.Tno = p.Tno(+)
                -- and a.lrdate Between :P214_FROMDATE and :P214_TODATE
                -- and (:P214_LOCATION is Null Or Instr (':' || :P214_LOCATION || ':' , ':' || C.LocationName || ':') > 0)
                -- and (:P214_COMPANY is Null Or Instr (':' || :P214_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                -- and (:P214_PARTY is Null Or Instr (':' || :P214_PARTY || ':' , ':' || z.PartyCode || ':') > 0)
                -- Group By 
                -- c.LocationName,
                -- x.SourceLocationName,
                -- y.DestinationLocationName,
                -- z.PartyName,
                -- a.CompanyCode
                -- ;
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                -- Select
                -- GetCompanyName(a.CompanyCode) as CompanyName,
                -- z.PartyName,
                -- x.SourceLocationName,
                -- y.DestinationLocationName,
                -- count(a.Tno) as NoofLR,
                -- Count(b.Tno) as NoofPOD,
                -- NVL(count(a.Tno),0) - NVL(Count(b.Tno),0) as NoOfNonPOD,
                -- Sum(b.Quantity1)as PODQuantity,
                -- --Sum(a.DieselQuantity) as DieselLiter,
                -- Sum(a.Quantity1) as TotalWeightMT,
                -- --Sum(n.Quantity1) as DieselQuantity,
                -- --Round(Sum(n.Amount),2) as DieselAmount,
                -- Count(p.VehicleNo) as SelfVehicle,
                -- Count(o.VehicleNo) as OtherVehicle,
                -- c.LocationName
                -- from lr a, PODDetail b, Location c,SourceLocation x, DestinationLocation y,Party z,
                -- /*(
                --         Select w.TNo,
                --                B.Quantity1,
                --                ncd.TotalAmount as Amount
                --         From  NecessitySlip a, NecessitySlipDetail b, VehicleNecessity vn,
                --         NecessityCompletion nc, Necessitycompletiondetail ncd, Lr w
                --         Where a.tno = b.tno(+)
                --             and   a.LrTno = w.Tno(+) 
                --             and   b.VehiclenecessityCode = vn.VehicleNecessityCode(+)
                --             and   nc.tno = ncd.tno(+)
                --             and   Ncd.Necessitysliptno = a.tno
                
                -- Union all
                
                --     Select w.TNo,
                --           B.Quantity1,
                --           Par.Amount
                --     From  NecessitySlip a, NecessitySlipDetail b,VehicleNecessity vn, 
                --            paymentAdvice pa, Paymentadvicereference par, LR w
                --     Where a.tno = b.tno(+)
                --         and   a.LrTno = w.Tno(+)
                --         and   b.VehiclenecessityCode = vn.VehicleNecessityCode(+)
                --         and   pa.tno = Par.Tno(+)
                --         and   Par.Referencemoduletno = a.tno
                
                -- UNION All
                
                --   Select w.TNo,
                --       Us.UsedStockQuantity1 as Quantity1,
                --       (Us.UsedStockQuantity1 * s.Rate) Amount
                --      from NecessitySlip a,NecessitySlipDetail b, VehicleNecessity vn, 
                --       Issue pa,UsedStock Us, Stock s , Lr w
                --     Where a.tno = b.tno
                --         and   a.LrTno = w.Tno(+)
                --         and   b.VehicleNecessityCode = vn.VehicleNecessityCode(+)
                --         and   pa.ModuleTno = a.Tno
                --         and   pa.Tno = Us.ModuleTno
                --         and   Us.StockTno = s.Tno) n,*/
                        
                --         (Select a.Tno, a.vehicleno from LR a,companyVehicle b
                --         where a.VehicleNo = b.CompanyVehicleNo(+)
                --         and b.VehicleGroupCode != '2') o,
                        
                --         (Select a.Tno, a.vehicleno from LR a,companyVehicle b
                --         where a.VehicleNo = b.CompanyVehicleNo(+)
                --         and b.VehicleGroupCode = '2'
                --         ) p
                -- Where a.Tno = b.LRTno(+)
                -- --and   a.Tno = n.Tno(+)
                -- and   a.LocationCode = c.LocationCode(+)
                -- and a.SourceLocationTno = x.Tno(+)
                -- and a.DestinationLocationTno = y.Tno(+)
                -- and a.PartyCode = z.PartyCode(+)
                -- and a.Tno = o.Tno(+)
                -- and a.Tno = p.Tno(+)
                -- and a.lrdate Between :P214_FROMDATE and :P214_TODATE
