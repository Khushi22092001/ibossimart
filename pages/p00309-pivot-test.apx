page 309 (
    name: PIVOT TEST
    alias: PIVOT-TEST
    title: PIVOT TEST
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: interactiveGrid
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  jobtype_list varchar2(4000);
                  query_str    varchar2(4000);
                BEGIN
                  SELECT '''' || LISTAGG(jobtypecode || ''',''') WITHIN GROUP (ORDER BY jobtypecode) || '''' AS concatenated_string
                  INTO jobtype_list
                  FROM (SELECT DISTINCT jobtypecode FROM jobcarddetail);
                
                  query_str := 'SELECT *
                    FROM jobcarddetail a
                    PIVOT (
                      COUNT(jobtypecode)
                      FOR jobtypecode IN (' || jobtype_list || ')
                    )';
                
                  RETURN query_str;
                END;
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 24738895346653504
        }

