        column EQUIPMENTNAME (
            type: textarea
            heading {
                heading: Equipmentname
            }
            layout {
                sequence: 760
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: EQUIPMENTNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column MAINTENANCEREQUESTDATE (
            type: datePicker
            heading {
                heading: Maintenancerequestdate
                alignment: center
            }
            layout {
                sequence: 770
                columnAlignment: center
            }
            source {
                databaseColumn: MAINTENANCEREQUESTDATE
                dataType: date
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: New
        }
    )

    pageItem P309_NEW (
        type: textField
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 20
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button new (
        buttonName: New
        label: New
        layout {
            sequence: 10
            region: @new-2
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @new
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      jobtype_list varchar2(4000);
                      query_str    varchar2(4000);
                    BEGIN
                      SELECT '''' || LISTAGG(jobtypecode || ''',''') WITHIN GROUP (ORDER BY jobtypecode) || '''' AS concatenated_string
                      INTO jobtype_list
                      FROM (SELECT DISTINCT jobtypecode FROM jobcarddetail);
                    
                      query_str := 'SELECT *
                        FROM jobcarddetail a
                        PIVOT (
                          COUNT(jobtypecode)
                          FOR jobtypecode IN (' || jobtype_list || ')
                        )';
                    
                      RETURN query_str;
                    END;
                    ```
            }
