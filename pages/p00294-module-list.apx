page 294 (
    name: Module List
    alias: MODULE-LIST
    title: Module List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region module-list (
        name: "Module List "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                a.ModuleCode,
                a.ModuleName,
                b.ModuleGroupCode,
                b.ModuleGroupName,
                Case When a.TransactionDateColumn is not null 
                then 'TRANSACTION' 
                ELSE 'MASTER' END as TransactionDone,
                a.IsActive
                From Module a, ModuleGroup b
                Where a.IsActive = 'YES' 
                and a.ModuleGroupCode = b.ModuleGroupCode;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 20475055752900415
        }

        column ISACTIVE (
            type: plainText
            heading {
                heading: Is Active
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: Module Code
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column MODULEGROUPCODE (
            type: plainText
            heading {
                heading: Module Group Code
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column MODULEGROUPNAME (
            type: plainText
            heading {
                heading: Module Group Name
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: Module Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TRANSACTIONDONE (
            type: plainText
            heading {
                heading: Transaction / Master
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: "Module List "
        }

        savedReport 205103 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ISACTIVE (
                sequence: 6
            )

            displayColumn MODULECODE (
                sequence: 1
            )

            displayColumn MODULEGROUPCODE (
                sequence: 3
            )

            displayColumn MODULEGROUPNAME (
                sequence: 4
            )

            displayColumn MODULENAME (
                sequence: 2
            )

            displayColumn TRANSACTIONDONE (
                sequence: 5
            )

        )

    )

)

