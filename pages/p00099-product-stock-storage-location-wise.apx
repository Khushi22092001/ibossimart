page 99 (
    name: Product Stock Storage Location wise
    alias: PRODUCT-STOCK-STORAGE-LOCATION-WISE
    title: Product Stock Storage Location wise
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region product-stock-storage-location-wise (
        name: Product Stock Storage Location wise
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       STOCKMODULECODE,
                       STOCKMODULETNO,
                       STOCKMODULENO,
                       STORAGELOCATIONCODE,
                       STORAGELOCATIONNAME,
                       STOCKQUANTITY1,
                       USEDSTOCKQUANTITY1,
                       RESERVESTOCKQUANTITY1,
                       BALANCEQUANTITY1,
                       STOCKQUANTITY2,
                       USEDSTOCKQUANTITY2,
                       RESERVESTOCKQUANTITY2,
                       BALANCEQUANTITY2,
                       STOCKVALUE,
                       AGEOFSTOCK
                  from D_PRODUCT360VIEW_STOCKSTORAGELOCATIONWISE
                  where  ITEMSPECIFICATIONCODE like nvl(:P99_ITEMSPECIFICATIONCODE,'%')
                    and StorageLocationCode like nvl(:P99_STORAGELOCATION,'%')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            compute: false
            flashback: false
            saveReport: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 65101221051733206
        }

        column AGEOFSTOCK (
            type: plainText
            heading {
                heading: Age of Stock
                alignment: center
            }
            layout {
                sequence: 420
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
