page 179 (
    name: Voucher Dr Cr Detail
    alias: VOUCHER-DR-CR-DETAIL
    title: Voucher Dr Cr Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region voucher-dr-cr-detail (
        name: Voucher Dr Cr Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                a.tno,
                a.serialno,
                b.partyname as AcountName ,
                DECODE(a.AMOUNT + ABS(a.AMOUNT), 0, ROUND(a.AMOUNT * -1, 0)) AS DRAMOUNT,
                DECODE(a.AMOUNT + ABS(a.AMOUNT), 2 * a.AMOUNT, ROUND(a.AMOUNT, 0)) AS CRAMOUNT
                from voucherdetail a, party b
                where a.accountcode = b.partycode
                  and a.tno = NVL(:P179_TNO,255190462)
                order by a.serialno
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 82504960391814636
        }

        column ACOUNTNAME (
            type: plainText
            heading {
                heading: ACOUNT NAME
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CRAMOUNT (
            type: plainText
            heading {
                heading: CR AMOUNT
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column DRAMOUNT (
            type: plainText
            heading {
                heading: DR AMOUNT
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        savedReport 134233 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACOUNTNAME (
                sequence: 2
            )

            displayColumn CRAMOUNT (
                sequence: 4
            )

            displayColumn DRAMOUNT (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            aggregate (
                column: DRAMOUNT
            )

            aggregate (
                column: CRAMOUNT
            )

        )

    )

    pageItem P179_SNO (
        type: hidden
        layout {
            sequence: 20
            region: @voucher-dr-cr-detail
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P179_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @voucher-dr-cr-detail
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

