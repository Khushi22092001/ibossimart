    region equipment-transfer-register (
        name: Equipment Transfer Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region equipment-transfer-register-2 (
        name: Equipment Transfer Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  a.Tno,
                  row_number() over(order by a.Tno) SerialNo,
                  a.EquipmentTransferNo,
                  a.EquipmentTransferDate,
                  b.LocationName as FromLocation,
                  c.LocationName as ToLocation,
                  d.EquipmentName,
                  d.ManufacturerModelNo,
                  d.ManufacturerSerialNo,
                  d.AssetNo,
                  e.LastMaintenanceDate,
                  a.Remark as ReasonForTransfer,
                  f.EmployeeName as DriverName,
                  a.ChasisNo,
                  a.DieselQuantity,
                  a.HMR,
                  a.KMR,
                  a.Creator,
                  to_char(a.CreationTime,'DD-MM-RRRR') as CreationTime
                From EquipmentTransfer a, Location b, Location c, Equipment d, 
                ( Select
                    a.EquipmentTno,
                    Max(a.MaintenanceOrderCompletionDate) as LastMaintenanceDate
                  From MaintenanceOrderCompletion a
                  Group By a.EquipmentTno)e, Employee f
                Where a.LocationCode = b.LocationCode(+)
                  and a.ToLocationCode = c.LocationCode(+)
                  and a.EquipmentTno = d.Tno(+)
                  and d.Tno = e.EquipmentTno(+)
                  and a.DriverCode = f.EmployeeCode(+)
                  and a.EquipmentTransferDate Between :P470_FROMDATE and :P470_TODATE
                  and ( :P470_COMPANY IS NULL OR instr(':'||:P470_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                  and ( :P470_LOCATION IS NULL OR instr(':'||:P470_LOCATION||':',':'||a.LocationCode||':') > 0 )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 39401990879405382
        }

