    pageItem P463_ACCOUNTGROUP (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Account Group
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName as d ,
                a.PartyCode as r
                from Party a   
                where a.PartyTypeCode = 'ACCOUNTGROUP'
                order by 1
                ```
        }
        layout {
            sequence: 120
            region: @sundry-creditors-ageing-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
