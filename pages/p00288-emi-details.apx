page 288 (
    name: Emi Details
    alias: EMI-DETAILS
    title: Emi Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region emi-details (
        name: Emi Details
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region emi-details-2 (
        name: Emi Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                row_number() over(order by a.LoanDate) SerialNo,
                a.Tno,
                a.LoanNo as AgreementNo,
                a.LoanStartDate as AgreementDate,
                b.EmiLoantypeName as LoanType,
                a.LoanGroupNo,
                c.EquipmentName as EquipmentNo,
                d.ItemName as AssetType,
                e.ItemSpecificationName as AssetDetails,
                f.PartyName  as FinancerName,
                a.LoanAmount as FinancerAmount,
                a.InterestAmount as IntrestAmount,
                a.BalanceAmount as TotalAmount,
                a.ROI as IntrestRate,
                a.Emi as EMIAmount,
                a.NoOfEmi,
                To_Char(a.DueDate,'MON-YY') as StartDate,
                To_Char(h.MaturityDate,'MON-yy') as Maturity,
                a.LoanDate as DueDate,
                To_Char(h.PaymentAdviceDate,'MON-YY') as LastMonthPayment,
                h.PaidNoOfEmi,
                a.NoOfEmi - h.PaidNoOfEmi as BalanceNoOfEmi,
                h.PaidNoOfEmi * h.Emi as PaidAmount,
                a.BalanceAmount - (h.PaidNoOfEmi * h.Emi) as BalanceAmount,
                a.InterestAmount - h.IntrestAmounts as BalanceIntrestAmount,
                a.PrincipleBalanceAmount - h.pricipleAmounts as BalancePrincpleAmount,
                g.LoanPreCloserDate as PreCloserDate,
                g.InterestAmount as PreCloserCharges,
                lo.LocationName as Groups,
                co.CompanyName as Owner,
                i.EffectiveDate,
                k.BankName as BankName,
                a.Creator,
                eg.EquipmentGroupName,
                getlocationname(getequipmentlocationcode(c.tno,:P288_TODATE)) as EquipmentLocation
                From loan a, EmiLoantype b, Equipment c, Item d, ItemSpecification e,Party f, Company co, Location lo,
                loanprecloser g, EquipmentGroup eg,
                (Select
                lo.Tno,
                Max(ld.DueDate) as MaturityDate,
                Case When Max(ld.PaymentAdviceTno) is Not Null
                Then Count(ld.PaymentAdviceTno) end as PaidNoOfEmi,
                Case When Max(ld.PaymentAdviceTno) is Null
                Then SUM(nvl(ld.InterestAmount,0)) end as IntrestAmounts,
                Case When Max(ld.PaymentAdviceTno) is Null
                Then SUM(nvl(ld.principleAmount,0)) end as pricipleAmounts,
                Max(pa.PaymentAdviceDate) as PaymentAdviceDate,
                Max(ld.Emi) as Emi
                From loan lo,LoanDetail ld, Paymentadvice Pa
                where lo.Tno = ld.Tno(+)
                and ld.PaymentAdviceTno = pa.Tno(+)
                Group by lo.Tno) h, LoanBankAccount i, Party j, Bank k
                Where a.EmiLoantypeCode = b.EmiloanTypeCode(+)
                and a.EquipmentTno = c.Tno(+)
                and c.ItemCode = d.ItemCode(+)
                and c.ItemSpecificationCode = e.ItemspecificationCode(+)
                and a.PartyCode = f.PartyCode(+)
                and a.CompanyCode = co.CompanyCode(+)
                and a.LocationCode = lo.LocationCode(+)
                and a.Tno = g.LoanTno(+)
                and c.EquipmentGroupCode = eg.EquipmentGroupCode(+)
                and a.Tno = h.Tno(+)
                and a.Tno = i.Tno(+)
                and a.BankAccountCode = j.PartyCode(+)
                and f.BankCode = k.BankCode(+)
                
                -- 22-APR-2025
                and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                and exists(
                Select
                aa.Tno
                From LoanDetail aa
                Where aa.Tno = a.Tno
                )
                and a.LoanStartDate between :P288_FROMDATE and :P288_TODATE 
                and (:P288_LOAN is Null Or Instr (':' || :P288_LOAN || ':' , ':' ||a.Tno|| ':') > 0)
                and (:P288_DOCTYPE is Null Or Instr (':' || :P288_DOCTYPE || ':' , ':' ||a.DocTypeCode|| ':') > 0)
                and (:P288_PARTY is Null Or Instr (':' || :P288_PARTY || ':' , ':' ||f.PartyCode|| ':') > 0)
                and (:P288_COMPANY is Null Or Instr (':' || :P288_COMPANY || ':' , ':' ||co.CompanyCode|| ':') > 0)
                and (:P288_LOCATION is Null Or Instr (':' || :P288_LOCATION || ':' , ':' ||lo.LocationCode|| ':') > 0)
                and (:P288_GROUP is Null Or Instr (':' || :P288_GROUP || ':' , ':' ||a.LoanGroupNo|| ':') > 0)
                and (:P288_EQUIPMENTGROUP is Null Or Instr (':' || :P288_EQUIPMENTGROUP || ':' , ':' ||eg.EquipmentGroupCode|| ':') > 0);
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 14379922026942537
        }

