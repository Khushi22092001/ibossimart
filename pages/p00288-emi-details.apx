        layout {
            sequence: 70
            region: @emi-details
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P288_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                b.LocationName d,
                b.LocationCode r
                From Loan a, Location b
                Where a.LocationCode = b.LocationCode(+)
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @emi-details
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

