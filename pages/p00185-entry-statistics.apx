page 185 (
    name: Entry Statistics
    alias: ENTRY-STATISTICS
    title: Entry Statistics
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/Stock+Journal.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P185_FROMDATE').val());
              var toDate = new Date($('#P185_TODATE').val());
            
            var reportParams = 
                  '&P_FROMDATE='+ $('#P185_FROMDATE').val() +  
                  '&P_TODATE=' + $('#P185_TODATE').val() +  
                  '&P_MODULE=' +$('#P185_MODULE').val() 
                  ;
             
                  
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              var reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            ```
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region entry-statistics (
        name: Entry Statistics
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region entry-statistics-2 (
        name: Entry Statistics
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       row_number() over(order by C.DAYDATE) SerialNo,
                       b.modulecode,
                       b.modulename,
                       C.DAYDATE,
                       GetModuleRecordsEntered(b.modulecode, c.daydate, c.daydate, '1') As Entry
                  From datelist c, Module b
                 Where b.mastertablename Is Not Null
                     And b.transactiondatecolumn Is Not Null
                     --And C.DAYDATE Between nvl(:P185_FROMDATE,TRUNC(SYSDATE-1)) And NVL(:P185_TODATE,TRUNC(SYSDATE))
                     AND C.DAYDATE BETWEEN :P185_FROMDATE AND :P185_TODATE
                     and ( :P185_MODULE IS NULL OR instr(':'||:P185_MODULE||':',':'||B.MODULECODE||':') > 0 ) 
                     And Nvl(GetModuleRecordsEntered(b.modulecode, c.daydate, c.daydate, '1'),
                            0) > 0
                  And Exists
                 (Select 1
                          From MODULEPRIVILEGE AA, BOSSUSER BB
                         Where AA.MODULECODE = B.MODULECODE
                           And AA.BOSSUSERCODE = BB.BOSSUSERCODE
                           And BB.BOSSUSERNAME = '&APP_USER.'
                           And (AA.VIEWPRIVILEGE = 'YES' Or AA.INSERTPRIVILEGE = 'YES'))
                 Order By 1
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 40511338477796191
        }

        column DAYDATE (
            type: plainText
            heading {
