            }
            advanced {
                endUserAlias: AN
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Entry Statistics
        }

        savedReport 175020 (
            visibility: primaryDefault
            view {
                pivot: true
                default: pivot
                rowsPerPage: 50
            }

            displayColumn DAYDATE (
                sequence: 3
            )

            displayColumn ENTRY (
                sequence: 4
            )

            displayColumn MODULECODE (
                sequence: 1
            )

            displayColumn MODULENAME (
                sequence: 2
            )

            sort (
                column: STOCKJOURNALDATE
                sort {
                    sequence: 1
                }
            )

            pivotColumn (
                column: DAYDATE
                layout {
                    sequence: 1
                }
            )

            pivotRowColumn (
                column: MODULENAME
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg (
                heading: No
                aggregate {
                    function: sum
                    column: ENTRY
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

        )

