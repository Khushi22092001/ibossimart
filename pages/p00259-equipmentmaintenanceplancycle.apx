page 259 (
    name: MaintenancePlanDetails
    alias: EQUIPMENTMAINTENANCEPLANCYCLE
    title: EquipmentMaintenancePlanCycle
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region equipment-maintenance-plan (
        name: "Equipment Maintenance Plan "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region equipment-maintenance-plandetails (
        name: Equipment Maintenance planDetails
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                row_number() over(order by a.equipmentmaintenanceplandate) SerialNo, 
                a.equipmentmaintenanceplandate,
                a.equipmentmaintenanceplanno,
                a.maintenanceplancategory,
                g.equipmentname,
                g.equipmentid,
                a.executioncycle,
                a.remark,
                e.cyclenos as cycleno,
                e.CycleUnit,
                e.cycletext,
                b.companyname,
                c.maintenancestrategyname,
                d.doctypename,
                l.locationname,
                f.equipmenttasklistno,
                q.priorityname,
                w.workcentrename,
                h.controlkey,
                k.joborderno as workorderno,
                p.PartyName as Partner,
                h.contactperson,
                h.contactno,
                i.callhorizonpercent,
                i.startofcycledate,
                i.schedulingindicator,
                j.equipmentgroupname,
                a.creator,
                to_char(a.creationtime,'dd-mm-yyyy') AS creationtime
                from equipmentmaintenanceplan a,company b,maintenancestrategy c,doctype d,location l,
                equipmenttasklist f,equipmentmaintenanceplancycle e,equipmentmaintenanceplanning h,
                equipmentmaintenancescheduling i,equipmentgroup j,joborder k,party p,workcentre w,priority q,equipment g
                where a.companycode = b.companycode(+)
                and a.maintenancestrategycode = c.maintenancestrategycode(+)
                and a.tno = d.tno(+)
                and a.doctypecode = d.doctypecode(+)
                and a.locationcode= l.locationcode(+)
                and a.equipmenttasklisttno = f.tno(+)
                and a.equipmentgroupcode = j.equipmentgroupcode(+)
                and a.equipmenttno = g.tno(+)
                and a.tno = e.tno(+)
                and a.tno = h.tno(+)
                and a.tno = i.tno(+)
                and a.tno = k.workordertno(+)
                and h.partycode = p.partycode(+)
                and h.jobordertno = k.jobordertno(+)
                and h.workcentrecode = w.workcentrecode(+)
                and h.prioritycode = q.prioritycode(+)
                and a.equipmentmaintenanceplandate between :P259_FROMDATE and :P259_TODATE
                and (:P259_DOCTYPE IS NULL OR instr(':'||:P259_DOCTYPE||':',':'||a.DocTypeCode||':') > 0 ) 
                and (:P259_LOCATION IS NULL OR instr(':'||:P259_LOCATION||':',':'||a.locationcode||':') > 0)
                and (:P259_COMPANYNAME IS NULL OR instr(':'||:P259_COMPANYNAME||':',':'||a.companycode||':') > 0) 
                and (:P259_PRIORITY IS NULL OR instr(':'||:P259_PRIORITY||':',':'||q.prioritycode||':') > 0)
                and (:P259_STRATEGYNAME IS NULL OR instr(':'||:P259_STRATEGYNAME||':',':'||c.maintenancestrategycode||':') > 0)
                and (:P259_EQUIPMENTGROUP IS NULL OR instr(':'||:P259_EQUIPMENTGROUP||':',':'||j.equipmentgroupcode||':') > 0)
                and (:P259_EQUIPMENTNAME IS NULL OR instr(':'||:P259_EQUIPMENTNAME||':',':'||g.equipmentno||':') > 0) 
                 
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 5445346495966447
        }

