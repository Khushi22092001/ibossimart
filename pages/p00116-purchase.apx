page 116 (
    name: Purchase
    alias: PURCHASE
    title: Purchase
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region item-group-purchase (
        name: Item Group Purchase
        type: chart
        layout {
            sequence: 30
            slot: body
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent9
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
            fontSize: 8
        }

        series item-group-revenue-bar-chart (
            name: Item Group Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select x.root_id,
                           getitemname(x.root_id) As RootName,
                           Sum(a.totalamount) Amount
                      From bi_prevenue a,
                           bi_datetime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                  -- '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       and a.PbpassDate = c.Fin_Date  
                       and To_Char(a.PbpassDate,'YYYYMM') like nvl(:P116_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P116_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P116_FINYEAR,'%')
                    
                    --   And :P116_ITEMGROUP Is Null
                    --    Or X.ROOT_ID = &P116_ITEMGROUP
                    --   And (&P116_ITEMGROUP Is Null Or
                    --instr(':' || &P116_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By x.root_id
                    ```
                pageItemsToSubmit: [
                    P116_ITEMGROUP
                    P116_ITEM
                ]
            }
            columnMapping {
                seriesName: ROOTNAME
                label: ROOTNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P116_ITEMGROUP',&ROOT_ID.);
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

    region item-group-supplier-purchase (
        name: Item Group Supplier Purchase
        type: chart
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent10
                t-Region--hiddenOverflow
            ]
        }
        chartLayout {
            height: 400
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series item-revenue-bar-chart (
            name: Item Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select TO_CHAR(to_date(:P116_MONTH,'YYYYMM'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(:P116_MONTH,'YYYYMM')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE,B.PARTYCODE, B.PARTYNAME, Sum(a.totalamount) Amount
                      From bi_prevenue a,
                           PARTY B,
                           BI_DateTime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   --'-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       And A.PARTYCODE = B.PARTYCODE
                       and a.pbpassDate = c.Fin_Date  
                       and To_Char(a.pbpassDate,'YYYYMM') like nvl(:P116_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P116_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P116_FINYEAR,'%')
                    
                       And (:P116_ITEMGROUP Is Null  Or X.ROOT_ID = :P116_ITEMGROUP)
                    --   And (&P116_ITEMGROUP Is Null Or
                    --instr(':' || &P116_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By B.PARTYCODE, B.PARTYNAME
                     order by 6 desc
                    
                    /*
                    Select
                          b.PartyCode,
                          GetPartyName(b.PartyCode) PartyName,
                          sum(b.TotalAmount)Amount
                    From  BI_DateTime a, BI_SRevenue b
                    Where a.Fin_Date = b.CCInvoiceDate
                      and b.ItemCode like nvl(:P116_ITEM,'%')
                      and To_Char(b.CCInvoiceDate,'YYYYMM') like nvl(:P116_MONTH,'%')
                      and a.Fin_Qtr like nvl(:P116_FIN_QTR,'%')
                      and replace(a.Fin_year,'-','') like nvl(:P116_FINYEAR,'%')
                    Group by b.PartyCode
                    */
                    ```
                pageItemsToSubmit: [
                    P116_ITEM
                    P116_MONTH
                    P116_QUARTER
                ]
            }
            columnMapping {
                label: PARTYNAME
                value: AMOUNT
            }
            link {
                type: redirectThisApp
                target: {
                    page: 75
                    items: {
                        P75_COMPANY: 1
                        P75_FROMDATE: &FROMDATE.
                        P75_TODATE: &TODATE.
                        P75_ITEMGROUP: &P116_ITEMGROUP.
                        P75_LOCATION: &LOCATIONCODE.
                    }
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region item-purchase (
        name: Item Purchase
        type: chart
        layout {
            sequence: 50
            slot: body
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent9
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
            fontSize: 8
        }

        series item-revenue-bar-chart (
            name: Item Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select Nvl(X.PARENTCODE, X.ITEMCODE) As PARENTCODE,
                           getitemname(Nvl(X.PARENTCODE, X.ITEMCODE)) As RootName,
                           Sum(a.totalamount) Amount
                      From bi_prevenue a,
                           bi_datetime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                  -- '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       and a.PBPassDate = c.Fin_Date  
                       and To_Char(a.PBPassDate,'YYYYMM') like nvl(:P116_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P116_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P116_FINYEAR,'%')
                    
                       And (:P116_ITEMGROUP Is Null
                        Or X.ROOT_ID = :P116_ITEMGROUP)
                    --   And (&P116_ITEMGROUP Is Null Or
                    --instr(':' || &P116_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By Nvl(X.PARENTCODE, X.ITEMCODE)
                    
                    ```
                pageItemsToSubmit: [
                    P116_ITEM
                    P116_ITEMGROUP
                ]
            }
            columnMapping {
                seriesName: ROOTNAME
                label: ROOTNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P116_ITEM',&PARENTCODE.);
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

    region item-spec-supplier-purchase (
        name: item spec Supplier Purchase
        type: chart
        layout {
            sequence: 80
            slot: body
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent10
                t-Region--hiddenOverflow
            ]
        }
        chartLayout {
            height: 400
        }
        legend {
            show: false
        }

        series item-revenue-bar-chart (
            name: Item Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select TO_CHAR(to_date(:P116_MONTH,'YYYYMM'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(:P116_MONTH,'YYYYMM')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE,B.PARTYCODE, B.PARTYNAME, Sum(a.totalamount) Amount
                      From bi_prevenue a,
                           PARTY B,
                           BI_DateTime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                  -- '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       And A.PARTYCODE = B.PARTYCODE
                       and a.PBPassDate = c.Fin_Date  
                       and To_Char(a.PBPassDate,'YYYYMM') like nvl(:P116_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P116_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P116_FINYEAR,'%')
                       And (:P116_ITEMGROUP Is Null    Or X.ROOT_ID = :P116_ITEMGROUP)
                       And (:P116_ITEM Is Null Or NVL(X.PARENTCODE,X.ITEMCODE) = :P116_ITEM)
                       and (:P116_ITEMSPECIFICATION IS NULL OR A.ITEMSPECIFICATIONCODE = :P116_ITEMSPECIFICATION)
                     Group By B.PARTYCODE, B.PARTYNAME
                     order by 6 desc
                    ```
                pageItemsToSubmit: P116_ITEMSPECIFICATION
            }
            columnMapping {
                label: PARTYNAME
                value: AMOUNT
            }
            link {
                type: redirectThisApp
                target: {
                    page: 75
                    items: {
                        P75_COMPANY: 1
                        P75_FROMDATE: &FROMDATE.
                        P75_TODATE: &TODATE.
                        P75_ITEMGROUP: &P116_ITEMGROUP.
                        P75_PARTYNAME: &PARTYCODE.
                        P75_ITEM: &P116_ITEM.
                        P75_ITEMSPECIFICATION: &P116_ITEMSPECIFICATION.
                    }
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region item-specification-purchase (
        name: Item Specification Purchase
        type: chart
        layout {
            sequence: 70
            slot: body
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent9
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
            fontSize: 8
        }

        series item-revenue-bar-chart (
            name: Item Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select A.ITEMSPECIFICATIONCODE As ITEMSPECIFICATIONCODE,
                           --getitemSPECIFICATIONNAME(A.ITEMCODE, A.ITEMSPECIFICATIONCODE) As ItemSpecificationName,
                           A.ITEMSPECIFICATIONCODE As ITEMSPECIFICATIONNAME,
                           Sum(a.totalamount) Amount
                      From bi_prevenue a,
                           bi_datetime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   --'-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       and a.PBPassDate = c.Fin_Date  
                       and To_Char(a.PBPassDate,'YYYYMM') like nvl(:P116_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P116_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P116_FINYEAR,'%')
                    
                       And (:P116_ITEMGROUP Is Null
                        Or X.ROOT_ID = :P116_ITEMGROUP)
                       And (:P116_ITEM Is Null
                        Or NVL(X.PARENTCODE,X.ITEMCODE) = :P116_ITEM)
                    --   And (&P116_ITEMGROUP Is Null Or
                    --instr(':' || &P116_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By a.itemcode, a.itemspecificationcode
                    
                    ```
                pageItemsToSubmit: [
                    P116_ITEMSPECIFICATION
                    P116_ITEMGROUP
                    P116_ITEM
                ]
            }
            columnMapping {
                seriesName: ITEMSPECIFICATIONNAME
                label: ITEMSPECIFICATIONNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P116_ITEMSPECIFICATION',&ITEMSPECIFICATIONCODE.);
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

    region item-supplier-purchase (
        name: Item Supplier Purchase
        type: chart
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            columnSpan: 8
        }
