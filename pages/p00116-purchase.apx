    region purchase (
        name: Purchase
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent14
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-sm
                margin-left-sm
                margin-right-sm
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region purchase-by-months (
        name: Purchase by Months
        type: chart
        layout {
            sequence: 30
            parentRegion: @purchase
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent7
                t-Region--hiddenOverflow
            ]
        }
        chartLayout {
            height: 250
        }
        legend {
            show: false
        }

        series months-bar-chart (
            name: Months Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                          b.Fin_Qtr,
                          b.Fin_Month,
                          To_Char(a.PBPassDate,'MON-YYYY') as Month,
                          To_Char(a.PBPassDate,'YYYYMM') as Monthyy,
                          sum(a.TotalAmount)Amount
                    From  BI_PRevenue a, BI_DateTime b
                    Where a.PBPassDate = b.Fin_date
                      --and b.Fin_Qtr like nvl(:P116_FIN_QTR,'%')
                      --and b.Fin_year like nvl(:P116_FINYEAR,'%')
                        and (b.Fin_Qtr = :P116_FIN_QTR or :P116_FIN_QTR is null)
                        and (replace(b.Fin_year,'-','') = :P116_FINYEAR or :P116_FINYEAR is null)
                    Group by b.Fin_Qtr,
                             b.Fin_Month,
                             To_Char(a.PBPassDate,'MON-YYYY'),
                             To_Char(a.PBPassDate,'YYYYMM')
                    Order by  2 --To_Char(a.PBPassDate,'YYYYMM')
                    ```
                pageItemsToSubmit: [
                    P116_MONTH
                    P116_FIN_QTR
                    P116_FINYEAR
                ]
            }
            columnMapping {
                label: MONTH
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P116_MONTH',&MONTHYY.);
            }
            label {
                show: true
                position: outsideBarEdge
                fontSize: 10
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region purchase-by-quarters (
        name: Purchase by Quarters
        type: chart
        layout {
            sequence: 20
            parentRegion: @purchase
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent5
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 250
        }
        dataCursor {
            cursor: true
            behavior: smooth
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
        }

        series quater-pie-chart (
            name: Quater Pie Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                          a.Fin_Qtr_Name,
                          a.Fin_Qtr,
                          sum(c.TotalAmount)Amount
                    From  BI_DateTime a, BI_Prevenue c
                    Where a.Fin_Date = c.PBPassDate
                      and replace(a.Fin_Year,'-','') like nvl(:P116_FINYEAR,'%')
                    Group by a.Fin_Qtr_Name,
                             a.Fin_Qtr
                    Order by 2
                    ```
                pageItemsToSubmit: P116_FINYEAR
            }
            columnMapping {
                label: FIN_QTR_NAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P116_FIN_QTR',&FIN_QTR.);
            }
            label {
                show: true
                position: outsideSlice
                displayAs: percentageValue
                fontSize: 10
            }
        )

    )

    region yearly-purchase (
        name: Yearly Purchase
        type: chart
        layout {
            sequence: 10
            parentRegion: @purchase
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 250
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
        }

        series yearly-revenue (
            name: Yearly Revenue
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                          a.Fin_Year FYNAME,
                          REPLACE(a.Fin_Year,'-','') FYCODE,
                          sum(TotalAmount)Amount
                    From  BI_DateTime a, BI_PRevenue b
                    Where a.Fin_Date = b.PBPassDate
                    Group by a.Fin_Year
                    ```
            }
            columnMapping {
                label: FYNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: JavaScript:$s('P116_FINYEAR' ,&FYCODE. );
            }
            label {
                show: true
                position: outsideSlice
                displayAs: percentageValue
            }
        )

    )

    pageItem P116_FINYEAR (
        type: hidden
        layout {
            sequence: 10
            region: @yearly-purchase
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P116_FIN_QTR (
        type: hidden
        layout {
            sequence: 10
            region: @purchase-by-quarters
