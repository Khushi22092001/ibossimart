page 431 (
    name: Material Issue With FOC GRN
    alias: MATERIAL-ISSUE-WITH-FOC-GRN
    title: Material Issue With FOC GRN
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region material-issue-with-foc-grn (
        name: Material Issue With FOC GRN
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: REPORT
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                  ROWNUM,
                  a.IssueDate,
                  a.IssueNo,
                  b.RequisitionNo,
                  g.EmployeeName as IssueTo,
                  GetCostCentreName(f.CostCentreCode) as CostCentreName,
                  i.ComponentSerialNo,
                  d.ItemName ||' - '|| e.ItemSpecificationName as MaterialDes,
                  c.Quantity1 as Qty,
                  h.DoctypeName,
                  h.GRNNo,
                  ROUND(h.Rate,2) as Rate,
                  (c.Quantity1 * h.Rate) as Amount,
                  f.KMMeterReading,
                  f.HourMeterReading,
                  k.EmployeeName||'('||a.Creator||')'as Users,
                  TO_CHAR(a.CreationTime,'DD-MON-YYYY HH:MM AM') as TimeStampdetail
                From Issue a, Requisition b, IssueDetail c, Item d, ItemSpecification e, IssueCostCentreDetail f, Employee g,
                (
                 Select
                    x.ModuleTno,
                    x.ModuleSno,
                    z.GRNNo,
                    z.Tno as GRNTno,
                    AVG(x.Rate) as Rate,
                    do.DoctypeName
                 From UsedStock x, Stock y, GRN z, PurchaseOrder po, Doctype do
                 Where x.ModuleCode = 'ISSUE'
                    and x.StockTno = Y.TNO(+)
                    and y.GRNTNO = Z.TNO
                    and z.PurchaseOrderTno = po.Tno
                    and z.DoctypeCode = do.DoctypeCode
                   -- and z.DoctypeCode = 'FOC'
                    and po.DoctypeCode = 'FOC'
                 Group By x.ModuleTno,
                    z.GRNNo,
                    z.Tno,
                    do.DoctypeName,
                    x.ModuleSno)h,
                    (Select
                           x.Tno,
                           x.Sno,
                           sl.StorageLocationCode,
                           sl.StorageLocationName,
                           cs.ComponentSerialNo,
                           1 as Quantity
                        From IssueDetailSerialNo x,StorageLocation sl, ComponentStock cs
                        Where x.StorageLocationCode = sl.StorageLocationCode
                          and x.ComponentStockTno = cs.Tno)i, BossUser j, Employee k
                Where a.RequisitionTno = b.Tno
                  and a.Tno = c.Tno
                  and c.ItemCode = d.ItemCode
                  and c.ItemSpecificationCode = e.ItemSpecificationCode
                  and c.Tno = f.Tno
                  and c.Sno = f.Sno
                  and b.IssueToEmployeeCode = g.EmployeeCode
                  and c.Tno = h.ModuleTno
                  and c.Sno = h.ModuleSno
                  and c.Tno = i.Tno(+)
                  and c.Sno = i.Sno(+)
                  and a.Creator = j.LoginName
                  and j.EmployeeCode = k.EmployeeCode
                  and a.IssueDate Between :P431_FROMDATE and :P431_TODATE
                  and ( :P431_COMPANY IS NULL OR INSTR(':'||:P431_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                  and ( :P431_LOCATION IS NULL OR INSTR(':'||:P431_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                  and ( :P431_DOCTYPE IS NULL OR INSTR(':'||:P431_DOCTYPE||':',':'||a.DoctypeCode||':') > 0 ) 
                  and ( :P431_ITEM IS NULL OR INSTR(':'||:P431_ITEM||':',':'||c.ItemCode||':') > 0 )
                    -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex());
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 35779467705417629
        }

