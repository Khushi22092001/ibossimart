        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                        Distinct
                        e.ItemName||' ( '||e.ItemCode||' )' as d,
                        e.ItemCode r
                From IssueDetail a, Item e
                Where a.ItemCode = e.ItemCode
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P427_COMPANY
            itemsToSubmit: P427_DEPARTMENT
        }
        layout {
