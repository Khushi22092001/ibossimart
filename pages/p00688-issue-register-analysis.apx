    region issue-lines (
        name: Issue Transactions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Line level register. WORK_CENTRE comes through CostCentre.WorkCentreCode
                   because no issue table carries a work centre directly; note only one
                   distinct work centre is populated across the whole database, so the
                   column is present for traceability rather than as an analytic axis.
                   Requested By resolves through the linked requisition; Issued By is the
                   user who created the issue document. */
                Select a.Tno                                       As ISSUETNO,
                       nvl(a.IssueNo,'(unnumbered)')               As ISSUE_NO,
                       to_char(a.IssueDate,'DD-MM-RRRR')           As ISSUE_DATE,
                       nvl(c.CompanyName, a.CompanyCode)           As COMPANY,
                       nvl(i9.Panel,'-')                           As PANEL,
                       nvl(a.LocationName, a.LocationCode)         As LOCATION,
                       nvl(sl.StorageLocationName,'-')             As STORAGE_LOCATION,
                       nvl(a.DepartmentName, a.DepartmentCode)     As DEPARTMENT,
                       nvl(a.CostCentreName, a.CostCentreCode)     As COST_CENTRE,
                       nvl(wc.WorkCentreName, nvl(cc.WorkCentreCode,'-')) As WORK_CENTRE,
                       nvl(a.DocTypeCode,'-')                      As DOC_TYPE,
                       Case When a.DocTypeCode = 'CAPITAL' Then 'Capital' Else 'Revenue' End As CLASSIFICATION,
                       a.ItemCode                                  As ITEMCODE,
                       nvl(a.ItemName, a.ItemCode)                 As ITEM,
                       nvl(sp.ItemSpecificationName,'-')           As SPECIFICATION,
                       Round(nvl(a.Quantity1,0),3)                 As QUANTITY,
                       nvl(it.MeasuringUnitCode1,'-')              As UNIT,
                       Round(nvl(a.Rate,0),2)                      As RATE,
                       Round(nvl(a.Amount,0),2)                    As ISSUE_VALUE,
                       Round(nvl(a.NetAmount,0),2)                 As NET_VALUE,
                       nvl(nvl(er.EmployeeName, r.EmployeeCode),'-') As REQUESTED_BY,
                       nvl(a.IssueToEmployee,'-')                  As ISSUED_TO,
                       nvl(a.UserRaisedBy,'-')                     As ISSUED_BY,
                       nvl(a.RequisitionNo,'-')                    As REQUISITION_NO,
                       nvl(a.GRNNo,'-')                            As SOURCE_GRN
                  From IssueRegister a
                  Left Join Issue i9              On i9.Tno = a.Tno
                  Left Join Company c             On c.CompanyCode = a.CompanyCode
                  Left Join Requisition r         On r.Tno = a.RequisitionTno
                  Left Join Employee er           On er.EmployeeCode = r.EmployeeCode
                  Left Join CostCentre cc         On cc.CostCentreCode = a.CostCentreCode
                  Left Join WorkCentre wc         On wc.WorkCentreCode = cc.WorkCentreCode
                  Left Join Item it               On it.ItemCode = a.ItemCode
                  Left Join ItemSpecification sp  On sp.ItemSpecificationCode = a.ItemSpecificationCode
                  Left Join StorageLocation sl    On sl.StorageLocationCode = (Select Max(s2.StorageLocationCode)
                                                                                 From UsedStock u2 Join Stock s2 On s2.Tno = u2.StockTno
                                                                                Where u2.ModuleCode = 'ISSUE'
                                                                                  And u2.ModuleTno = a.Tno
                                                                                  And u2.ModuleSNo = a.SNo)
                 Where a.IssueDate >= to_date(:P688_FROMDATE,'DD-MM-RRRR')
                   And a.IssueDate <  to_date(:P688_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or (Select i8.Panel From Issue i8 Where i8.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                   And (:P688_PANEL      Is Null Or (Select i8.Panel From Issue i8 Where i8.Tno = a.Tno) = :P688_PANEL)
                   And (:P688_COMPANY    Is Null Or a.CompanyCode    = :P688_COMPANY)
                   And (:P688_LOCATION   Is Null Or a.LocationCode   = :P688_LOCATION)
                   And (:P688_DEPARTMENT Is Null Or a.DepartmentCode = :P688_DEPARTMENT)
                   And (:P688_COSTCENTRE Is Null Or a.CostCentreCode = :P688_COSTCENTRE)
                   And (:P688_ITEM       Is Null Or a.ItemCode       = :P688_ITEM)
                   And (:P688_DOCTYPE    Is Null Or a.DocTypeCode    = :P688_DOCTYPE)
                 Order By a.IssueDate Desc, a.Tno, a.SNo
                ```
            pageItemsToSubmit: [
                P688_FROMDATE
                P688_TODATE
                P688_COMPANY
                P688_LOCATION
                P688_PANEL
                P688_DEPARTMENT
                P688_COSTCENTRE
                P688_ITEM
                P688_DOCTYPE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 200000
        }
        advanced {
            savedReportMappingIdentifier: 31369356242505313
        }

