    button back-to-cc (
        buttonName: BACKTOCC
        label: Command Centre
        layout {
            sequence: 110
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 684
                items: {
                    P684_FROMDATE: &P688_FROMDATE.
                    P684_TODATE: &P688_TODATE.
                    P684_COMPANY: &P688_COMPANY.
                    P684_LOCATION: &P688_LOCATION.
                    P684_PANEL: &P688_PANEL.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

