page 688 (
    name: Issue Register
    alias: ISSUE-REGISTER-ANALYSIS
    title: Issue Register
    pageGroup: @store-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Transaction level issue register, reached from the Department and Cost Centre analytics on the Store Command Centre (page 684) with the clicked dimension already applied. Every filter is a real page item, so the selection stays active until the user changes it. The spine is the IssueRegister view, so figures agree line for line with the Issue Register report and with the analytics that linked here. Four columns named in the original specification are absent because this ERP does not record them: Warehouse and Store have no master (Location and StorageLocation are the only place dimensions), Project has no link to any issue (Requisition.ProjectTno is unpopulated on every row), and Approved By and Status have no stored value (DocumentStatusCode is null on every issue line, so there is no approval workflow to report).
    }

    region command-header (
        name: Issue Register
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-store-head">'
                    || '<div class="ds-store-eyebrow">Store &middot; Issue Register</div>'
                    || '<h1 class="ds-store-title">Issue Register</h1>'
                    || '<div class="ds-store-sub">Every issue line matching the current selection, traceable to its document</div>'
                    || '<div class="ds-store-context">'
                    || '<span class="ds-store-chip"><span class="fa fa-calendar"></span>Period <b>'
                       || :P688_FROMDATE || ' &rarr; ' || :P688_TODATE || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P688_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P688_LOCATION),'All locations')) || '</b></span>'
                    || Case When :P688_DEPARTMENT Is Not Null Then
                            '<span class="ds-store-chip ds-store-chip--live"><span class="fa fa-sitemap"></span>Department <b>'
                            || apex_escape.html(nvl((Select d.DepartmentName From Department d Where d.DepartmentCode = :P688_DEPARTMENT),:P688_DEPARTMENT))
                            || '</b></span>' End
                    || Case When :P688_COSTCENTRE Is Not Null Then
                            '<span class="ds-store-chip ds-store-chip--live"><span class="fa fa-pie-chart"></span>Cost Centre <b>'
                            || apex_escape.html(nvl((Select cc.CostCentreName From CostCentre cc Where cc.CostCentreCode = :P688_COSTCENTRE),:P688_COSTCENTRE))
                            || '</b></span>' End
                    || Case When :P688_DOCTYPE Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-tag"></span>Type <b>'
                            || apex_escape.html(:P688_DOCTYPE) || '</b></span>' End
                    || Case When :P688_ITEM Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-cube"></span>Item <b>'
                            || apex_escape.html(nvl((Select i.ItemName From Item i Where i.ItemCode = :P688_ITEM),:P688_ITEM))
                            || '</b></span>' End
                    || '<span class="ds-store-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                               Then (Select GetUserPanelAB_apex() From dual) || ' (enforced)'
                               When :P688_PANEL Is Not Null Then :P688_PANEL
                               Else 'A + B' End || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
            pageItemsToSubmit: [
                P688_FROMDATE
                P688_TODATE
                P688_COMPANY
                P688_LOCATION
                P688_PANEL
                P688_DEPARTMENT
                P688_COSTCENTRE
                P688_ITEM
                P688_DOCTYPE
            ]
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-store-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

