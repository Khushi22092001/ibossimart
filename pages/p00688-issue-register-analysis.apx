    pageItem P688_COMPANY (
        type: popupLov
        label {
            label: Company
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From Issue i Where i.CompanyCode = c.CompanyCode)
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P688_COSTCENTRE (
        type: popupLov
        label {
            label: Cost Centre
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nvl(cc.CostCentreName, a.CostCentreCode) d, a.CostCentreCode r
                  From IssueRegister a Left Join CostCentre cc On cc.CostCentreCode = a.CostCentreCode
                 Where a.CostCentreCode Is Not Null
                 Group By nvl(cc.CostCentreName, a.CostCentreCode), a.CostCentreCode
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All cost centres
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P688_DEPARTMENT (
        type: popupLov
        label {
            label: Department
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nvl(d.DepartmentName, a.DepartmentCode) d, a.DepartmentCode r
                  From IssueRegister a Left Join Department d On d.DepartmentCode = a.DepartmentCode
                 Where a.DepartmentCode Is Not Null
                 Group By nvl(d.DepartmentName, a.DepartmentCode), a.DepartmentCode
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All departments
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

