    region totals-strip (
        name: Selection Totals
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With A As (
                  Select Count(Distinct a.Tno) Docs, Count(*) Lines,
                         Count(Distinct a.ItemCode) Items,
                         Count(Distinct a.DepartmentCode) Depts,
                         Count(Distinct a.CostCentreCode) CCs,
                         nvl(Sum(a.Quantity1),0) Qty,
                         nvl(Sum(a.Amount),0) Amt,
                         nvl(Sum(a.NetAmount),0) Net
                    From IssueRegister a
                   Where a.IssueDate >= to_date(:P688_FROMDATE,'DD-MM-RRRR')
                     And a.IssueDate <  to_date(:P688_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                     And (:P688_PANEL      Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P688_PANEL)
                     And (:P688_COMPANY    Is Null Or a.CompanyCode    = :P688_COMPANY)
                     And (:P688_LOCATION   Is Null Or a.LocationCode   = :P688_LOCATION)
                     And (:P688_DEPARTMENT Is Null Or a.DepartmentCode = :P688_DEPARTMENT)
                     And (:P688_COSTCENTRE Is Null Or a.CostCentreCode = :P688_COSTCENTRE)
                     And (:P688_ITEM       Is Null Or a.ItemCode       = :P688_ITEM)
                     And (:P688_DOCTYPE    Is Null Or a.DocTypeCode    = :P688_DOCTYPE))
                Select '<div class="ds-kpi ds-kpi--value" title="Sum of IssueRegister.Amount for the current selection">'
                    || '<span class="ds-kpi-ic fa fa-inr"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">ISSUE VALUE</div><div class="ds-kpi-n">&#8377;'
                    || Case When a.Amt >= 10000000 Then to_char(a.Amt/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When a.Amt >= 100000   Then to_char(a.Amt/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(a.Amt,'FM99G99G990D00') End || '</div>'
                    || '<div class="ds-kpi-sub">Net of returns &#8377;'
                       ||Case When a.Net >= 100000 Then to_char(a.Net/100000,'FM99G990D00')||'L'
                              Else to_char(a.Net,'FM99G99G990') End||'</div>'
                    || '</div></div>' As KPI1,
                
                       '<div class="ds-kpi ds-kpi--bill" title="Distinct issue documents and lines in the selection">'
                    || '<span class="ds-kpi-ic fa fa-file-text-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">DOCUMENTS</div><div class="ds-kpi-n">'
                    || to_char(a.Docs,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.Lines,'FM999G990')||' lines</div>'
                    || '</div></div>' As KPI2,
                
                       '<div class="ds-kpi ds-kpi--input" title="Total issued quantity in primary unit of measure">'
                    || '<span class="ds-kpi-ic fa fa-cubes"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">QUANTITY</div><div class="ds-kpi-n">'
                    || to_char(a.Qty,'FM999G999G990D000') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.Items,'FM999G990')||' distinct items</div>'
                    || '</div></div>' As KPI3,
                
                       '<div class="ds-kpi ds-kpi--ok" title="Departments and cost centres represented in the selection">'
                    || '<span class="ds-kpi-ic fa fa-sitemap"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">DEPARTMENTS</div><div class="ds-kpi-n">'
                    || to_char(a.Depts,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.CCs,'FM999G990')||' cost centres</div>'
                    || '</div></div>' As KPI4
                From A a
                ```
            pageItemsToSubmit: [
                P688_FROMDATE
                P688_TODATE
                P688_COMPANY
                P688_LOCATION
                P688_PANEL
                P688_DEPARTMENT
                P688_COSTCENTRE
                P688_ITEM
                P688_DOCTYPE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

