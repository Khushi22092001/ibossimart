    pageItem P688_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
    )

