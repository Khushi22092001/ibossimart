        }
        layout {
            sequence: 70
            region: @maintenancevehicleout
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Vehicle Out No
        }
    )

    pageItem P304_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
