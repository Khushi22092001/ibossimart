page 304 (
    name: Maintenance Vehicle Out Register
    alias: MAINTENANCEVEHICLEOUTREGISTER
    title: Maintenance Vehicle Out Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenancevehicleout (
        name: MaintenanceVehicleOut
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                row_number() over(order by moc.maintenanceordercompletiondate) SerialNo,
                co.companyname as company,
                l.locationname as location,
                d.doctypename as doctype,
                mvo.maintenancevehicleoutdate,
                mvo.maintenancevehicleoutno,
                moc.maintenanceordercompletionno,
                moc.maintenanceordercompletiondate,
                CASE
                when moc.maintenanceordercompletiondate is null then 'Pending'
                WHEN moc.maintenanceordercompletiondate is not null then 'Completed'
                end as STATUS,
                e.equipmentname,
                em.employeename as drivername,
                mvo.hrreading,
                mvo.kmreading
                FROM
                     maintenancevehicleout mvo,
                     company co,
                     location l,
                     doctype d,
                     maintenanceordercompletion moc,
                     equipment e,
                     employee em
                WHERE  
                    mvo.companycode = co.companycode(+)
                    and mvo.locationcode = l.locationcode(+)
                    and mvo.doctypecode = d.doctypecode(+)
                    and mvo.maintenanceordercompletiontno = moc.tno(+)
                    and mvo.equipmenttno = e.tno(+)
                    and mvo.drivercode = em.employeecode(+)
                    and MVO.MAINTENANCEVEHICLEOUTDATE between :P304_FROMDATE and :P304_TODATE
                and ( :P304_COMPANY IS NULL OR instr(':'||:P304_COMPANY||':',':'||co.companycode||':') > 0 ) 
                and (:P304_LOCATION IS NULL OR instr(':'||:P304_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P304_MAINTENANCEVEHICLEOUTNO IS NULL OR instr(':'||:P304_MAINTENANCEVEHICLEOUTNO||':',':'||MVO.MAINTENANCEVEHICLEOUTNO||':') > 0 ) 
                and (:P304_EQUIPMENTNAME IS NULL OR instr(':'||:P304_EQUIPMENTNAME||':',':'||E.EQUIPMENTNAME||':') > 0)
                and (:P304_DRIVERNAME IS NULL OR instr(':'||:P304_DRIVERNAME||':',':'||EM.EMPLOYEEcode||':') > 0)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 24460744833398309
        }

        column COMPANY (
            type: plainText
            heading {
                heading: Company
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
