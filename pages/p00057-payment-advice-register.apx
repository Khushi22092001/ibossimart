page 57 (
    name: Payment Advice Register
    alias: PAYMENT-ADVICE-REGISTER
    title: Payment Advice Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region payment-advice (
        name: Filters
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Rownum as SerialNo,a.*,bk.bankname as partybankname,
                   pb.ifsccode,
                   pb.accountno from
                (Select
                   a.Tno,
                   a.partybanktno,
                   a.partybanksno,
                   a.PaymentAdviceNo,
                   a.PaymentAdviceDate,
                   e.PartyName as Party,
                   d.DoctypeName,
                   i.TDSPayeeCategoryName,
                   j.TDSNatureName,
                   a.TDSLowerRate,
                   a.TDSCertificateNo as CertificateNo,
                   a.TDSOnOverAndAbove,
                   l.LoanNo as EMILoanNo,
                   'PURCHASEORDER' as Reference,
                   h.PurchaseOrderNo as ReferenceNo,
                   h.PurchaseOrderDate as ReferenceDate,
                   a.Amount,
                   --a.AmountDR,
                   --a.AmountCR,
                   b.Amount As AmountDR,
                   b.Amount As AmountCR,
                   a.TaxRate as TDSRate,
                   a.TaxAmount as TDSAmount,
                   a.RoundingAmount as RoundOff,
                   g.MoneyTransferReferenceNo as ChecknoorDDno,
                   Initcap(g.MoneyTransferModeCode) as Modeoftransaction,
                   f.PartyName as BankAccount,
                   GetLocationName(nvl(h.LocationCode,a.LocationCode)) as ReferenceLocation,
                   g.VoucherNo,
                   g.VoucherDate,
                   a.Creator,
                   c.LocationName,
                   k.CompanyName,
                   a.Narration,
                   n.DocumentStatusName,
                   '' BillNo
                From PaymentAdvice a, PaymentAdviceReference b, Location c, Doctype d, Party e, Party f,
                Voucher g, PurchaseOrder h, TDSPayeeCategory i, TDSNature j, Company k, Loan l, DocumentStatusDetail m,
                DocumentStatus n
                Where a.Tno = b.Tno(+)
                    and a.LocationCode = c.LocationCode
                    and a.DoctypeCode = d.DoctypeCode
                    and a.PartyCode = e.PartyCode
                    and a.AccountCode = f.PartyCode(+)
                    and a.Tno = g.ModuleTno(+)
                    and b.ReferenceModuleTno = h.Tno(+)
                    and a.TDSPayeeCategoryCode = i.TDSPayeeCategoryCode(+)
                    and a.TDSNatureCode = j.TDSNatureCode(+)
                    and a.CompanyCode = k.CompanyCode
                    and a.LoanTno = l.Tno(+)
                    and a.Tno = m.ModuleTno(+)
                    and m.DocumentStatusCode = n.DocumentStatusCode(+)
                    and b.ReferenceModuleCode = 'PURCHASEORDER'
                      -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_COMPANY IS NULL OR instr(':'||:P57_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_LOCATION IS NULL OR instr(':'||:P57_LOCATION||':',':'||a.LocationCode||':') > 0 )
                    and (:P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    --and ( :P57_TODOLIST = 'NO' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    and ( :P57_DOCTYPE IS NULL OR instr(':'||:P57_DOCTYPE||':',':'||a.DoctypeCode||':') > 0 )
                    and ( :P57_STATUSS IS NULL OR instr(':'||:P57_STATUSS||':',':'||m.DocumentStatusCode||':') > 0 )
                    and ( :P57_PARTY IS NULL OR instr(':'||:P57_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P57_BANK IS NULL OR instr(':'||:P57_BANK||':',':'||a.AccountCode||':') > 0 )
                    and case When b.ReferenceModuleCode = 'PURCHASEORDER' Then 'PURCHASEORDER'
                    When b.ReferenceModuleCode = 'JOBORDER' Then 'JOBORDER'
                    When b.ReferenceModuleCode = 'JOBBILL' Then 'JOBBILL'
                    When b.ReferenceModuleCode = 'PURCHASEBILL' Then 'PURCHASEBILL'
                    When b.ReferenceModuleCode = 'ACCOUNTOPENING' Then 'ACCOUNTOPENING'
                    When b.ReferenceModuleCode = 'EXTERNALSERVICESENTRY' Then 'EXTERNALSERVICESENTRY'
                    When b.ReferenceModuleCode is null  Then 'OTHER'
                    End like nvl(:P57_REFERENCECODE,'%')
                
                UNION ALL
                
                Select
                   a.Tno,
                   a.partybanktno,
                   a.partybanksno,
                   a.PaymentAdviceNo,
                   a.PaymentAdviceDate,
                   e.PartyName as Party,
                   d.DoctypeName,
                   i.TDSPayeeCategoryName,
                   j.TDSNatureName,
                   a.TDSLowerRate,
                   a.TDSCertificateNo as CertificateNo,
                   a.TDSOnOverAndAbove,
                   l.LoanNo as EMILoanNo,
                   'JOBORDER' as Reference,
                   h.JobOrderNo as ReferenceNo,
                   h.JobOrderDate as ReferenceDate,
                   a.Amount,
                   --a.AmountDR,
                   --a.AmountCR,
                   b.Amount As AmountDR,
                   b.Amount As AmountCR,
                   a.TaxRate as TDSRate,
                   a.TaxAmount as TDSAmount,
                   a.RoundingAmount as RoundOff,
                   g.MoneyTransferReferenceNo as ChecknoorDDno,
                   Initcap(g.MoneyTransferModeCode) as Modeoftransaction,
                   f.PartyName as BankAccount,
                   GetLocationName(nvl(h.LocationCode,a.LocationCode)) as ReferenceLocation,
                   g.VoucherNo,
                   g.VoucherDate,
                   a.Creator,
                   c.LocationName,
                   k.CompanyName,
                   a.Narration,
                   n.DocumentStatusName,
                   '' BillNo
                From PaymentAdvice a, PaymentAdviceReference b, Location c, Doctype d, Party e, Party f,
                Voucher g, JobOrder h, TDSPayeeCategory i, TDSNature j, Company k, Loan l, DocumentStatusDetail m,
                DocumentStatus n
                Where a.Tno = b.Tno(+)
                    and a.LocationCode = c.LocationCode
                    and a.DoctypeCode = d.DoctypeCode
                    and a.PartyCode = e.PartyCode
                    and a.AccountCode = f.PartyCode(+)
                    and a.Tno = g.ModuleTno(+)
                    and b.ReferenceModuleTno = h.Tno(+)
                    and a.TDSPayeeCategoryCode = i.TDSPayeeCategoryCode(+)
                    and a.TDSNatureCode = j.TDSNatureCode(+)
                    and a.CompanyCode = k.CompanyCode
                    and a.LoanTno = l.Tno(+)
                    and a.Tno = m.ModuleTno(+)
                    and m.DocumentStatusCode = n.DocumentStatusCode(+)
                    and b.ReferenceModuleCode = 'JOBORDER'
                      -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_COMPANY IS NULL OR instr(':'||:P57_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_LOCATION IS NULL OR instr(':'||:P57_LOCATION||':',':'||a.LocationCode||':') > 0 )
                    and (:P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    --and ( :P57_TODOLIST = 'NO' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    and ( :P57_DOCTYPE IS NULL OR instr(':'||:P57_DOCTYPE||':',':'||a.DoctypeCode||':') > 0 )
                    and ( :P57_STATUSS IS NULL OR instr(':'||:P57_STATUSS||':',':'||m.DocumentStatusCode||':') > 0 )
                    and ( :P57_PARTY IS NULL OR instr(':'||:P57_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P57_BANK IS NULL OR instr(':'||:P57_BANK||':',':'||a.AccountCode||':') > 0 )
                    and case When b.ReferenceModuleCode = 'PURCHASEORDER' Then 'PURCHASEORDER'
                    When b.ReferenceModuleCode = 'JOBORDER' Then 'JOBORDER'
                    When b.ReferenceModuleCode = 'JOBBILL' Then 'JOBBILL'
                    When b.ReferenceModuleCode = 'PURCHASEBILL' Then 'PURCHASEBILL'
                    When b.ReferenceModuleCode = 'ACCOUNTOPENING' Then 'ACCOUNTOPENING'
                    When b.ReferenceModuleCode = 'EXTERNALSERVICESENTRY' Then 'EXTERNALSERVICESENTRY'
                    When b.ReferenceModuleCode is null  Then 'OTHER'
                    End like nvl(:P57_REFERENCECODE,'%')
                
                UNION ALL
                
                Select
                   a.Tno,
                    a.partybanktno,
                   a.partybanksno,
                   a.PaymentAdviceNo,
                   a.PaymentAdviceDate,
                   e.PartyName as Party,
                   d.DoctypeName,
                   i.TDSPayeeCategoryName,
                   j.TDSNatureName,
                   a.TDSLowerRate,
                   a.TDSCertificateNo as CertificateNo,
                   a.TDSOnOverAndAbove,
                   l.LoanNo as EMILoanNo,
                   'JOBBILL' as Reference,
                   h.JobBillNo as ReferenceNo,
                   h.JobBillDate as ReferenceDate,
                   a.Amount,
                   --a.AmountDR,
                   --a.AmountCR,
                   b.Amount As AmountDR,
                   b.Amount As AmountCR,
                   a.TaxRate as TDSRate,
                   a.TaxAmount as TDSAmount,
                   a.RoundingAmount as RoundOff,
                   g.MoneyTransferReferenceNo as ChecknoorDDno,
                   Initcap(g.MoneyTransferModeCode) as Modeoftransaction,
                   f.PartyName as BankAccount,
                   GetLocationName(nvl(h.LocationCode,a.LocationCode)) as ReferenceLocation,
                   g.VoucherNo,
                   g.VoucherDate,
                   a.Creator,
                   c.LocationName,
                   k.CompanyName,
                   a.Narration,
                   n.DocumentStatusName,
                   h.PartyBillNo As BillNo
                From PaymentAdvice a, PaymentAdviceReference b, Location c, Doctype d, Party e, Party f,
                Voucher g, JobBill h, TDSPayeeCategory i, TDSNature j, Company k, Loan l, DocumentStatusDetail m,
                DocumentStatus n
                Where a.Tno = b.Tno(+)
                    and a.LocationCode = c.LocationCode
                    and a.DoctypeCode = d.DoctypeCode
                    and a.PartyCode = e.PartyCode
                    and a.AccountCode = f.PartyCode(+)
                    and a.Tno = g.ModuleTno(+)
                    and b.ReferenceModuleTno = h.Tno(+)
                    and a.TDSPayeeCategoryCode = i.TDSPayeeCategoryCode(+)
                    and a.TDSNatureCode = j.TDSNatureCode(+)
                    and a.CompanyCode = k.CompanyCode
                    and a.LoanTno = l.Tno(+)
                    and a.Tno = m.ModuleTno(+)
                    and m.DocumentStatusCode = n.DocumentStatusCode(+)
                    and b.ReferenceModuleCode = 'JOBBILL'
                      -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_COMPANY IS NULL OR instr(':'||:P57_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_LOCATION IS NULL OR instr(':'||:P57_LOCATION||':',':'||a.LocationCode||':') > 0 )
                    and (:P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    --and ( :P57_TODOLIST = 'NO' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    and ( :P57_DOCTYPE IS NULL OR instr(':'||:P57_DOCTYPE||':',':'||a.DoctypeCode||':') > 0 )
                    and ( :P57_STATUSS IS NULL OR instr(':'||:P57_STATUSS||':',':'||m.DocumentStatusCode||':') > 0 )
                    and ( :P57_PARTY IS NULL OR instr(':'||:P57_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P57_BANK IS NULL OR instr(':'||:P57_BANK||':',':'||a.AccountCode||':') > 0 )
                    and case When b.ReferenceModuleCode = 'PURCHASEORDER' Then 'PURCHASEORDER'
                    When b.ReferenceModuleCode = 'JOBORDER' Then 'JOBORDER'
                    When b.ReferenceModuleCode = 'JOBBILL' Then 'JOBBILL'
                    When b.ReferenceModuleCode = 'PURCHASEBILL' Then 'PURCHASEBILL'
                    When b.ReferenceModuleCode = 'ACCOUNTOPENING' Then 'ACCOUNTOPENING'
                    When b.ReferenceModuleCode = 'EXTERNALSERVICESENTRY' Then 'EXTERNALSERVICESENTRY'
                    When b.ReferenceModuleCode is null  Then 'OTHER'
                    End like nvl(:P57_REFERENCECODE,'%')
                
                UNION ALL
                
                Select
                   a.Tno,
                   a.partybanktno,
                   a.partybanksno,
                   a.PaymentAdviceNo,
                   a.PaymentAdviceDate,
                   e.PartyName as Party,
                   d.DoctypeName,
                   i.TDSPayeeCategoryName,
                   j.TDSNatureName,
                   a.TDSLowerRate,
                   a.TDSCertificateNo as CertificateNo,
                   a.TDSOnOverAndAbove,
                   l.LoanNo as EMILoanNo,
                   'PURCHASEBILL' as Reference,
                   h.PurchaseBillNo as ReferenceNo,
                   h.PurchaseBillDate as ReferenceDate,
                   a.Amount,
                   --a.AmountDR,
                   --a.AmountCR,
                   b.Amount As AmountDR,
                   b.Amount As AmountCR,
                   a.TaxRate as TDSRate,
                   a.TaxAmount as TDSAmount,
                   a.RoundingAmount as RoundOff,
                   g.MoneyTransferReferenceNo as ChecknoorDDno,
                   Initcap(g.MoneyTransferModeCode) as Modeoftransaction,
                   f.PartyName as BankAccount,
                   GetLocationName(nvl(h.LocationCode,a.LocationCode)) as ReferenceLocation,
                   g.VoucherNo,
                   g.VoucherDate,
                   a.Creator,
                   c.LocationName,
                   k.CompanyName,
                   a.Narration,
                   n.DocumentStatusName,
                   h.PartyBillNo As BillNo
                From PaymentAdvice a, PaymentAdviceReference b, Location c, Doctype d, Party e, Party f,
                Voucher g, PurchaseBill h, TDSPayeeCategory i, TDSNature j, Company k, Loan l, DocumentStatusDetail m,
                DocumentStatus n
                Where a.Tno = b.Tno(+)
                    and a.LocationCode = c.LocationCode
                    and a.DoctypeCode = d.DoctypeCode
                    and a.PartyCode = e.PartyCode
                    and a.AccountCode = f.PartyCode(+)
                    and a.Tno = g.ModuleTno(+)
                    and b.ReferenceModuleTno = h.Tno(+)
                    and a.TDSPayeeCategoryCode = i.TDSPayeeCategoryCode(+)
                    and a.TDSNatureCode = j.TDSNatureCode(+)
                    and a.CompanyCode = k.CompanyCode
                    and a.LoanTno = l.Tno(+)
                    and a.Tno = m.ModuleTno(+)
                    and m.DocumentStatusCode = n.DocumentStatusCode(+)
                    and b.ReferenceModuleCode = 'PURCHASEBILL'
                      -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_COMPANY IS NULL OR instr(':'||:P57_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_LOCATION IS NULL OR instr(':'||:P57_LOCATION||':',':'||a.LocationCode||':') > 0 )
                    and (:P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    --and ( :P57_TODOLIST = 'NO' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    and ( :P57_DOCTYPE IS NULL OR instr(':'||:P57_DOCTYPE||':',':'||a.DoctypeCode||':') > 0 )
                    and ( :P57_STATUSS IS NULL OR instr(':'||:P57_STATUSS||':',':'||m.DocumentStatusCode||':') > 0 )
                    and ( :P57_PARTY IS NULL OR instr(':'||:P57_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P57_BANK IS NULL OR instr(':'||:P57_BANK||':',':'||a.AccountCode||':') > 0 )
                    and case When b.ReferenceModuleCode = 'PURCHASEORDER' Then 'PURCHASEORDER'
                    When b.ReferenceModuleCode = 'JOBORDER' Then 'JOBORDER'
                    When b.ReferenceModuleCode = 'JOBBILL' Then 'JOBBILL'
                    When b.ReferenceModuleCode = 'PURCHASEBILL' Then 'PURCHASEBILL'
                    When b.ReferenceModuleCode = 'ACCOUNTOPENING' Then 'ACCOUNTOPENING'
                    When b.ReferenceModuleCode = 'EXTERNALSERVICESENTRY' Then 'EXTERNALSERVICESENTRY'
                    When b.ReferenceModuleCode is null  Then 'OTHER'
                    End like nvl(:P57_REFERENCECODE,'%')
                
                UNION ALL
                
                Select
                   a.Tno,
                   a.partybanktno,
                   a.partybanksno,
                   a.PaymentAdviceNo,
                   a.PaymentAdviceDate,
                   e.PartyName as Party,
                   d.DoctypeName,
                   i.TDSPayeeCategoryName,
                   j.TDSNatureName,
                   a.TDSLowerRate,
                   a.TDSCertificateNo as CertificateNo,
                   a.TDSOnOverAndAbove,
                   l.LoanNo as EMILoanNo,
                   'ACCOUNTOPENING' as Reference,
                   h.AccountOpeningNo as ReferenceNo,
                   h.AccountOpeningDate as ReferenceDate,
                   a.Amount,
                   --a.AmountDR,
                   --a.AmountCR,
                   b.Amount As AmountDR,
                   b.Amount As AmountCR,
                   a.TaxRate as TDSRate,
                   a.TaxAmount as TDSAmount,
                   a.RoundingAmount as RoundOff,
                   g.MoneyTransferReferenceNo as ChecknoorDDno,
                   Initcap(g.MoneyTransferModeCode) as Modeoftransaction,
                   f.PartyName as BankAccount,
                   GetLocationName(nvl(h.LocationCode,a.LocationCode)) as ReferenceLocation,
                   g.VoucherNo,
                   g.VoucherDate,
                   a.Creator,
                   c.LocationName,
                   k.CompanyName,
                   a.Narration,
                   n.DocumentStatusName,
                   '' BillNo
                From PaymentAdvice a, PaymentAdviceReference b, Location c, Doctype d, Party e, Party f,
                Voucher g, AccountOpening h, TDSPayeeCategory i, TDSNature j, Company k, Loan l, DocumentStatusDetail m,
                DocumentStatus n
                Where a.Tno = b.Tno(+)
                    and a.LocationCode = c.LocationCode
                    and a.DoctypeCode = d.DoctypeCode
                    and a.PartyCode = e.PartyCode
                    and a.AccountCode = f.PartyCode(+)
                    and a.Tno = g.ModuleTno(+)
                    and b.ReferenceModuleTno = h.Tno(+)
                    and a.TDSPayeeCategoryCode = i.TDSPayeeCategoryCode(+)
                    and a.TDSNatureCode = j.TDSNatureCode(+)
                    and a.CompanyCode = k.CompanyCode
                    and a.LoanTno = l.Tno(+)
                    and a.Tno = m.ModuleTno(+)
                    and m.DocumentStatusCode = n.DocumentStatusCode(+)
                    and b.ReferenceModuleCode = 'ACCOUNTOPENING'
                      -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_COMPANY IS NULL OR instr(':'||:P57_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_LOCATION IS NULL OR instr(':'||:P57_LOCATION||':',':'||a.LocationCode||':') > 0 )
                    and (:P57_TODOLIST ='YES' OR :P57_NEXTPROCESS = 'YES' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    --and ( :P57_TODOLIST = 'NO' OR (a.PaymentAdviceDate between :P57_FROMDATE and :P57_TODATE))
                    and ( :P57_DOCTYPE IS NULL OR instr(':'||:P57_DOCTYPE||':',':'||a.DoctypeCode||':') > 0 )
                    and ( :P57_STATUSS IS NULL OR instr(':'||:P57_STATUSS||':',':'||m.DocumentStatusCode||':') > 0 )
                    and ( :P57_PARTY IS NULL OR instr(':'||:P57_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P57_BANK IS NULL OR instr(':'||:P57_BANK||':',':'||a.AccountCode||':') > 0 )
                    and case When b.ReferenceModuleCode = 'PURCHASEORDER' Then 'PURCHASEORDER'
                    When b.ReferenceModuleCode = 'JOBORDER' Then 'JOBORDER'
                    When b.ReferenceModuleCode = 'JOBBILL' Then 'JOBBILL'
                    When b.ReferenceModuleCode = 'PURCHASEBILL' Then 'PURCHASEBILL'
                    When b.ReferenceModuleCode = 'ACCOUNTOPENING' Then 'ACCOUNTOPENING'
                    When b.ReferenceModuleCode = 'EXTERNALSERVICESENTRY' Then 'EXTERNALSERVICESENTRY'
                    When b.ReferenceModuleCode is null  Then 'OTHER'
                    End like nvl(:P57_REFERENCECODE,'%')
                
