    pageItem P57_BANK (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Bank
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       Distinct
                       p.PartyName d,
                       p.PartyCode r
                From PaymentAdvice a, Party p
                Where a.AccountCode = p.PartyCode
                  and p.PartyTypeCode IN ('BANK','CASH');
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @payment-advice
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

