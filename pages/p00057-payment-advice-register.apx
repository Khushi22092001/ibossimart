        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P57_STATUSS (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Status
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                DISTINCT
                C.DOCUMENTSTATUSNAME d,
                C.DOCUMENTSTATUSCODE r
                FROM DOCUMENTSTATUSDETAIL B, DOCUMENTSTATUS C,PAYMENTADVICE A
                WHERE B.DOCUMENTSTATUSCODE = C.DOCUMENTSTATUSCODE(+)
                AND B.MODULETNO = A.TNO(+)
                AND B.MODULECODE = 'PAYMENTADVICE'
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @payment-advice
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 6
            labelColumnSpan: 1
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

