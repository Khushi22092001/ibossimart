                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_COMPANY IS NULL OR instr(':'||:P57_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and ( :P57_TODOLIST = 'YES' OR :P57_NEXTPROCESS = 'YES' OR :P57_LOCATION IS NULL OR instr(':'||:P57_LOCATION||':',':'||a.LocationCode||':') > 0 )
