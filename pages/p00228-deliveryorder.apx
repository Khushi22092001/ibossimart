    pageItem P228_ALLOTMENTSCHEME (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Allotment Scheme
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                minimalInputLength
                rapidSelection
            ]
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                b.AllotmentSchemeName d,
                b.AllotmentSchemeCode r
                From DeliveryOrder a, AllotmentScheme b
                where a.AllotmentSchemeCode = b.AllotmentSchemeCode(+)
                ;
