    pageItem P228_WORKORDERNO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Work Order No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.WorkOrderNo d,
                to_char(a.Tno) as r
                From FreightRateList a
                Where exists(
                Select
                aa.Tno
                From DeliveryOrder aa
                Where aa.FreightRateListTno = a.Tno
                )
                Order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @delivery-order
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 2
