    region delivery-order (
        name: "DELIVERY ORDER "
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region delivery-order-report (
        name: DELIVERY ORDER  REPORT
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 Select
                row_number() over(order by a.DeliveryOrderDate) SerialNo,
                co.CompanyName,
                a.DeliveryOrderNo,
                a.DeliveryOrderDate,
                a.PartyDONo,
                a.PartyDODate,
                fr.WorkOrderNo,
                fr.WorkOrderDate,
                a.partypono,
                a.PartyPoDate,
                a.FromDate,
                a.ToDate,
                p.PartyName,
                k.locationName as Location,
                do.DoctypeName,
                al.AllotmentSchemeName,
                sz.SizesName,
                gr.GradeName,
                gr.FromGCVBand,
                gr.ToGCVBand,
                a.AuctionDate,
                a.LineItem,
                b.SourceLocationName as SourceLocation,
                c.DestinationLocationName as DestinationLocation,
                i.ItemName ||'-'|| j.ItemSpecificationName as ItemName,
                round(lo.Quantity1,3) as LoadingOrderQuantity,
                round(aa.Quantity1,3) as DeliveryOrderQuantity,
                round(it.LoadingQuantity1,3) as InternaltransferQty,
                round(abs(nvl(aa.Quantity1,0) - nvl(lo.Quantity1,0)- nvl(it.LoadingQuantity1,0)),3) as BalanceQuantity,
                a.Creator
                from DeliveryOrder a,DeliveryOrderDetail aa, SourceLocation b, DestinationLocation c, 
                    Party p, Item i, ItemSpecification j, Location k, Doctype do, FreightRateList fr,
                    (Select Sum(z.Quantity1) as Quantity1,z.PartyRefNo ,z.DeliveryOrderSno,z.DeliveryOrderTno,
                    z.PartyRefdate ,z.WorkOrderNo,z.WorkOrderDate
                    From loadingOrder z
                    Group by z.PartyRefNo,z.PartyRefdate ,z.WorkOrderNo,z.WorkOrderDate,z.DeliveryOrderSno,z.DeliveryOrderTno) lo,
                    (Select Sum(it.LoadingQuantity1) as LoadingQuantity1, it.DeliveryOrderTno 
                      from InternalTransfer it Group by it.DeliveryOrderTno) it, Company co, AllotmentScheme al, Sizes sz, Grade gr
                Where a.Tno = aa.Tno
                and aa.Tno = lo.DeliveryOrderTno(+)
                and aa.Sno = lo.DeliveryOrderSno(+)
                and a.LocationCode = k.LocationCode (+)
                and a.DoctypeCode = do.DoctypeCode(+)
                and a.FreightRateListTno = fr.Tno(+)
                and aa.SourceLocationTno = b.Tno(+)
                and aa.DestinationLocationTno = c.Tno(+)
                and a.PartyCode = p.PartyCode(+)
                and aa.ItemCode = i.ItemCode(+)
                and aa.ItemSpecificationCode = j.ItemSpecificationCode(+)
                and a.Tno = it.DeliveryOrderTno(+)
                and a.CompanyCode = co.CompanyCode(+)
                and a.AllotmentSchemeCode = al.AllotmentSchemeCode(+)
                and a.SizesCode = sz.SizesCode(+)
                and a.GradeCode = gr.GradeCode(+)
                and (:P228_COMPANYNAME is null or instr(':'||:P228_COMPANYNAME||':',':'||a.Companycode||':') > 0)
                and a.DeliveryOrderDate between :P228_FROMDATE and :P228_TODATE
                and (:P228_LOCATIONNAME is null or instr(':'||:P228_LOCATIONNAME||':',':'||k.Locationcode||':') > 0)
                and (:P228_DOCTYPE is null or instr(':'||:P228_DOCTYPE||':',':'||do.Doctypecode||':') > 0)
                and (:P228_PARTY is null or instr(':'||:P228_PARTY||':',':'||P.Partycode||':') > 0)
                and (:P228_DELIVERYORDERNO is null or instr(':'||:P228_DELIVERYORDERNO||':',':'||a.Tno||':') > 0)
                and (:P228_WORKORDERNO is null or instr(':'||:P228_WORKORDERNO||':',':'||fr.TNo||':') > 0)
                and (:P228_PARTYDONO is null or instr(':'||:P228_PARTYDONO||':',':'||a.PartyDoNo||':') > 0)
                and (:P228_ALLOTMENTSCHEME is null or instr(':'||:P228_ALLOTMENTSCHEME||':',':'||al.AllotmentSchemeCode||':') > 0)
                and (:P228_SIZES is null or instr(':'||:P228_SIZES||':',':'||sz.SizesCode||':') > 0)
                and (:P228_GRADE is null or instr(':'||:P228_GRADE||':',':'||gr.GradeCode||':') > 0)
                and ( ( NVL(aa.Quantity1, 0) - NVL(lo.Quantity1, 0) - NVL(it.LoadingQuantity1, 0) > 0 AND :P228_BALANCEQTY = 'Only Balance Quantity' )
                    OR ( NVL(aa.Quantity1, 0) - NVL(lo.Quantity1, 0) - NVL(it.LoadingQuantity1, 0) = 0 AND :P228_BALANCEQTY = 'Zero Balance Quantity' )
                              OR :P228_BALANCEQTY IS NULL )
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                ```
        }
