page 377 (
    name: Payment Follow-up Action
    alias: PAYMENT-FOLLOW-UP-ACTION1
    title: Payment Follow-up Action
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payment-follow-up-action (
        name: Payment Follow-up Action
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    a.TNO,
                    a.PARTYCODE,
                    p.PartyName,
                    a.INVOICETNO,
                    (SELECT LISTAGG(i.INVOICENO, ':' ON OVERFLOW TRUNCATE '...') WITHIN GROUP (ORDER BY i.INVOICENO)
                     FROM Invoice i
                     WHERE INSTR(':' || a.INVOICETNO || ':', ':' || i.TNO || ':') > 0) AS INVOICENO_LIST,
                    a.INVOICEBALANCE,
                    a.CALLINGPERSON,
                    e.EmployeeName AS CallingPersonName,
                    a.CALLINGDATE,
                    DECODE(a.CALLINGSTATUS, 'A', 'ANSWERED', 'NA', 'NOT ANSWERED', a.CALLINGSTATUS) AS CALLINGSTATUS, -- Added fallback
                    a.NEXTFOLLOWUPDATE,
                    a.COMMENTS,
                    a.COMMITEDAMOUNT,
                    a.REMARK
                FROM PAYMENTFOLLOWUPACTION a
                LEFT JOIN party p 
                    ON p.partycode = a.PARTYCODE  
                LEFT JOIN Employee e 
                    ON e.employeecode = a.CALLINGPERSON;
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 381
                items: {
                    P381_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 40459133216635651
        }

        column CALLINGDATE (
            type: plainText
            heading {
                heading: CALLING DATE
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column CALLINGPERSON (
            type: plainTextBasedOnLov
            heading {
                heading: CALLING PERSON
                alignment: center
            }
            lov {
                lov: @employee-employeecode
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            columnFilter {
                type: defaultBasedOnColumnType
            }
            advanced {
                endUserAlias: E
            }
        )

