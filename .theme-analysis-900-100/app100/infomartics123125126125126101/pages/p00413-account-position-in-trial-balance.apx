    region master (
        name: Master
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,
                       a.partycode,
                			 rpad(' ',5 * (b.AccountLevel -1 ),'.')  || a.PartyName As accountname,
                			 a.TrialBalancePosition,
                			 getTrialBalancePosition(a.PartyCode) As currentposition
                  From Party a, AccountWithLevel b
                 Where a.PartyCode = b.AccountCode
                   And (Exists
                        (Select aa.AccountCode
                           From AccountInclude aa
                          Where aa.AccountCode = :P413_PARTYCODE
                            And aa.ChildCode = a.PartyCode) Or :P413_PARTYCODE Is Null)
                
                ```
            pageItemsToSubmit: [
                P413_ACCOUNTLEVEL
                P413_PARTYCODE
            ]
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: regionBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
        toolbar {
            controls: [
                searchField
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 450
        }
        advanced {
            savedReportMappingIdentifier: 17587149455619823
        }

