    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P413_TNO is null then
                    :P413_TNO := GlobalTNo.nextval;
                    :P413_FORMSTATUS := 'NEWRECORD';
                
                  
                else
                    :P413_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P413_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P413_TNO), 'Status');
                ```
        }
        execution {
            sequence: 80
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 19810131720778654
        }
    )

    process intialize-ma-acceptance (
        name: intialize ma_acceptance
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  TMP NUMBER;
                BEGIN
                SELECT COUNT(*) into tmp FROM ma_acceptance A WHERE A.TNO = :p413_tno;
                if nvl(tmp,0) > 0 then
                        select 
                        TNO                 ,
                        MODULECODE,
                        MODULETNO,
                        MODULESNO,
                        ACCEPTANCE,
                        ACCEPTANCEDATE,
                        PERSONACCOUNTABLE,
                        DELIVERYDATE,
                        DESIGNATION,
                        MOBILENO,
                        EXPIRYTIME
                        into 
                        :P413_TNO_1,
                        :P413_MODULECODE,
                        :P413_MODULETNO,
                        :P413_MODULESNO,
                        :P413_ACCEPTANCE,
                        :P413_ACCEPTANCEDATE,
                        :P413_PERSONACCOUNTABLE,
                        :P413_DELIVERYDATE_1,
                        :P413_DESIGNATION,
                        :P413_MOBILENO,
                        :P413_EXPIRYTIME
                        from ma_acceptance
                        WHERE MODULETNO = :P413_TNO
                        ;
                
                    END IF;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 19809704782778653
        }
        serverSideCondition {
            type: never
        }
    )

