    dynamicAction insert-into-detail (
        name: Insert into detail
        execution {
            sequence: 230
        }
        when {
            event: focusout
            selectionType: items
            items: P413_INDENTTNO
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                        DELETE FROM purchaseorderdetail WHERE TNO = :P413_TNO;
                        insert into purchaseorderdetail
                        (
                            tno,
                            sno,
                            INDENTTNO,
                            ITEMCODE,
                            ITEMSPECIFICATIONCODE,
                            QUANTITY1,
                            QUANTITY2,
                            RATE,
                            AMOUNT , 
                            RATEMEASURINGUNITCODE
                        )
                        (
                            select 
                                :P413_TNO,
                                globaltno.nextval,
                                :P413_INDENTTNO,
                                a.ITEMCODE , 
                                a.ITEMSPECIFICATIONCODE , 
                               round( nvl(a.QUANTITY1,0) - nvl(a.ORDEREDQUANTITY1,0) , getuomdecimal(b.measuringunitcode1)), 
                               round( nvl(a.QUANTITY2,0) - nvl(a.ORDEREDQUANTITY2,0) , getuomdecimal(b.measuringunitcode2)), 
                                null , 
                                null ,
                                GetMeasuringUnitCodeFromItem(a.itemcode) 
                            from indentdetail a , item b
                            where a.itemcode = b.itemcode
                            and a.tno = :P413_INDENTTNO
                    
                            AND NVL(QUANTITY1,0)-NVL(ORDEREDQUANTITY1,0)>0
                            
                       );
                    end;
                    ```
                itemsToSubmit: [
                    P413_TNO
                    P413_INDENTTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

