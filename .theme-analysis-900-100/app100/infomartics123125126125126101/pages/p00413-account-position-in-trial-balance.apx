    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 100
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P413_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P413_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P413_TNO,:P413_STATUS);
                    
                    declare
                        tpaymentadvice number;
                    
                    begin
                        SELECT COUNT(A.TNO) INTO tpaymentadvice
                    	FROM PAYMENTADVICE A
                    	WHERE A.MODULETNO = :P413_TNO ;
                    
                        if nvl(tpaymentadvice, 0) = 0 then
                            if :P413_STATUS = 'ACTIVE' then
                            
                                CREATEPAYMENTADVICEFORPO(:P413_TNO);
                    
                            end if;
                    
                        end if;
                    
                    end;
                    ```
                itemsToSubmit: P413_STATUS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P413_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @buttons
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P413_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

