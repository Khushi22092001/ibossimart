    dynamicAction check-advance-amount (
        name: check advance amount
        execution {
            sequence: 440
        }
        when {
            event: focusout
            selectionType: items
            items: P413_POADVANCEAMOUNT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    
                    
                    if to_number(NVL(:P413_POADVANCEAMOUNT,0)) > to_number(NVL(:P413_PURCHASEORDERAMOUNT,0)) then
                        raise_application_error(-20000,'Advance Amount Cannot Be greater than PO Amount');
                    end if;
                    ```
                itemsToSubmit: [
                    P413_POADVANCEAMOUNT
                    P413_PURCHASEORDERAMOUNT
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @cancel
