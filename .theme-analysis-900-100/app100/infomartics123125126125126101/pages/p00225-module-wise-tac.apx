    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 50
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P225_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P225_TNO,:P225_STATUS);
                itemsToSubmit: [
                    P225_TNO
                    P225_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#STATUS span').text($v('P225_STATUS'));
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P225_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction fail (
        name: Fail
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @fail
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    		cursor cPassFail is
                    				select
                    						a.TNo,
                    						a.TokenNo										
                    				from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    				where a.ModuleFlowTNo = b.TNo
                    						and b.TNo = c.TNo
                    						and a.BossUserCode = c.BossUserCode
                    						and c.BossUserCode = d.BossUserCode
                    						and a.ModuleTNo = :P225_TNO1
                    						AND D.BOSSUSERNAME = :APP_USER
                    						and a.isPass is null
                    						and a.IsFail is null
                    						and a.IsForwarded is null
                    						and a.IsRebounded is null																				
                    		;
                    		vPassFail cPassFail%rowtype;
                        
                        tTokenNo NUMBER;
                        TMP VARCHAR2(100);
                        tModulecode Varchar2(30);
                    begin
                    
                        select DISTINCT 
                        	d.ModuleCode, :P130_JOBBILLNO
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                            AND d.modulecode = GetModuleCodeForPageNo(:APP_PAGE_ID)
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    		open cPassFail;
                    		fetch cPassFail into vPassFail;
                    		if cPassFail%FOUND then
                    				tTokenNo := vPassFail.TokenNo;
                    				close cPassFail;
                    
                               	
                    				update PassFail a
                    				set a.IsFail = 'YES',
                    						a.remark = :P225_PASSFAILREMARK
                    				where a.TNo = vPassFail.TNo;
                    				
                    				SendBackPassFail(tTokenNo , TMP );
                    		    		
                    				
                    				commit;
                    		else
                    				close cPassFail;
                    		end if;
                    
                    	
                    end;
                    ```
                itemsToSubmit: [
                    P225_PASSFAILREMARK
                    P225_TNO1
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P225_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction initialise-sno (
        name: Initialise SNO
        execution {
            sequence: 20
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @detail-2
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    Declare
                    mysno number;
                    Begin
                    If :SNO is null then
                        Select GlobalTNo.nextval into mysno from dual;
                    else MYSNO := :SNO;
                    end if;
                    return mysno;
                    end;
                    ```
                itemsToSubmit: SNO
            }
            affectedElements {
                selectionType: columns
                columns: SNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30) := GetModuleCodeForPageNo(:APP_PAGE_ID);
                      TMP          vARCHAR2(100) ;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = :P225_TNO1
                    				AND D.BOSSUSERNAME = :APP_USER
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select DISTINCT 
                        	d.ModuleCode, :P130_JOBBILLNO
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                            AND d.modulecode = GetModuleCodeForPageNo(:APP_PAGE_ID)
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = :P225_PASSFAILRREMARK
                    			where a.TNo = vPassFail.TNo;
                    			COMMIT;
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, :P225_TNO1 , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P225_PASSFAILREMARK
                    P225_TNO1
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

