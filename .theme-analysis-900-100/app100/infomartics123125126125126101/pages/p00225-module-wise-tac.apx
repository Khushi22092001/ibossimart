    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P225_TNO is null then
                            :P225_FORMSTATUS := 'NEWRECORD';
                        else
                            :P225_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P225_TNO is null then
                
                        select globaltno.nextval into :P225_TNO from dual;
                
                    end if; 
                end;
                ```
