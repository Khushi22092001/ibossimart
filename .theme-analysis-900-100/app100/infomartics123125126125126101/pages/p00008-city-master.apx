            valueProtected: false
        }
        layout {
            sequence: 220
            region: @fields
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P8_TNO), 'Status')
        }
        sessionState {
            storage: request
        }
    )

