            region: @fields
            slot: regionBody
        }
    )

    pageItem P8_LEADTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @city-master
            slot: regionBody
        }
        source {
            formRegion: @city-master
