page 8 (
    name: City Master
    alias: CITY-MASTER
    title: City Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            
            .t-Alert--page.t-Alert--success  {
            
            
                position: relative;
            
            
               // top: 300px;
                top:0px;
            
                left: 0px;
            
            
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region city-master (
        name: City Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       CITYCODE,
                       CITYNAME,
                       STATECODE,
                       STDCODE,
                       PINCODE,
                       REMARK,
                       CREATOR,
                       DISTANCE,
                       CLASSOFCITYCODE,
                       REGIONCODE,
                       CREATIONTIME,
                       LEADTIME,
                       MODULECODE,
                       MODULETNO
                  from CITY
                 
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P8_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P8_CITYCODE (
        type: textField
        label {
            label: City Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @city-master
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @city-master
            column: CITYCODE
            dataType: varchar2
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'CITY'
                       and a.CodeScheme = 'AUTO'
                ```
        }
    )

    pageItem P8_CITYNAME (
        type: textField
        label {
            label: City Name
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @city-master
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @city-master
            column: CITYNAME
            dataType: varchar2
        }
    )

    pageItem P8_CLASSOFCITYCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @city-master
            slot: regionBody
        }
        source {
            formRegion: @city-master
            column: CLASSOFCITYCODE
            dataType: varchar2
        }
    )

    pageItem P8_CREATIONTIME (
        type: textField
        label {
            label: Creation Time
            alignment: left
        }
        layout {
            sequence: 120
            region: @city-master
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH:MIPM
            width: 30
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @city-master
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MM-YYYY HH24:MI:SS') from dual
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_CITYCODE
        }
    )

    pageItem P8_CREATOR (
        type: textField
        label {
            label: CREATOR
            alignment: left
        }
        layout {
            sequence: 80
            region: @city-master
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 30
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @city-master
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select :GLOBAL_LOGINNAME from Dual
        }
    )

    pageItem P8_DISTANCE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @city-master
            slot: regionBody
        }
        source {
            formRegion: @city-master
            column: DISTANCE
            dataType: number
        }
    )

    pageItem P8_FORMSTATUS (
