    process get-doc-no (
        name: Get Doc No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'CITY';
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P8_CITYCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P8_CITYCODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 134392854487478525
        }
    )

    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P8_TNO is null then
                            :P8_FORMSTATUS := 'NEWRECORD';
                        else
                            :P8_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P8_TNO is null then
                
                        select globaltno.nextval into :P8_TNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 134390977186478506
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P8_MODULEFLOW := 'YES';
                   else
                       :P8_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P8_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P8_ONTHETABLE := 'YES' ;
                   else
                       :P8_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 134509439182382486
        }
    )

