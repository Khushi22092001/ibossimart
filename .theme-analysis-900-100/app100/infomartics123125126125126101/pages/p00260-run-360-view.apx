page 260 (
    name: Run 360 View
    alias: RUN-360-VIEW
    title: Run 360 View
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region run-360-view (
        name: Run 360 View
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P260_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'INDENT'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and upper(bu.BossUserName) =  upper('&APP_USER.')
                  and getcompanyprivilege(C.COMPANYCODE,GETMODULECODEFORPAGENO(:APP_PAGE_ID),:GLOBAL_LOGINNAME)='YES'
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 10
            region: @run-360-view
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 35
        }
    )

    pageItem P260_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @run-360-view
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 35
        }
    )

    pageItem P260_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'INDENT'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                 /* and a.CompanyCode = :P107_COMPANY */
                 and instr(':'||:P260_COMPANY||':',':'||a.CompanyCode||':') > 0
                Order By 1
                ;
                
                ```
            nullDisplayValue: -Select-
        }
        cascadingLov {
            parentItems: P260_COMPANY
            itemsToSubmit: P260_COMPANY
            parentRequired: false
        }
        layout {
            sequence: 20
            region: @run-360-view
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 35
        }
    )

    pageItem P260_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @run-360-view
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 35
        }
    )

    button run (
        buttonName: Run
        label: Run
        layout {
            sequence: 50
            region: @run-360-view
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction call-d-create-360view (
        name: call d_Create_360View
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @run
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: d_Create_360View(:P260_FROMDATE,:P260_TODATE,:P260_COMPANY,:P260_LOCATION);
                itemsToSubmit: [
                    P260_FROMDATE
                    P260_TODATE
                    P260_COMPANY
                    P260_LOCATION
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: alert('Done');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

