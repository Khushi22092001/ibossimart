page 206 (
    name: Production Centre
    alias: PRODUCTION-CENTRE
    title: Production Centre
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    region production-centre (
        name: Production Centre
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       PRODUCTIONCENTRECODE,
                       PRODUCTIONCENTRENAME,
                       PRODUCTIONCENTRESHORTNAME,
                       REMARK,
                       LOCATIONCODE,
                       ISUSEDFORGROUPING,
                       MODULECODE,
                       MODULETNO,
                       CREATIONTIME,
                       CREATOR
                  from PRODUCTIONCENTRE
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P206_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P206_CREATIONTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @production-centre
            slot: regionBody
        }
        source {
            formRegion: @production-centre
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: item
            item: GLOBAL_SYSDATE
        }
    )

    pageItem P206_CREATOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @production-centre
            slot: regionBody
        }
        source {
            formRegion: @production-centre
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: item
            item: GLOBAL_LOGINNAME
        }
    )

    pageItem P206_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 210
            region: @fields
            slot: regionBody
        }
    )

    pageItem P206_ISUSEDFORGROUPING (
        type: checkbox
        label {
            label: Is Used For Grouping
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: YES
            uncheckedValue: NO
        }
        layout {
            sequence: 60
            region: @production-centre
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @production-centre
