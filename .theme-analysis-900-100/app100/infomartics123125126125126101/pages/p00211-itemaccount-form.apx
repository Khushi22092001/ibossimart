page 211 (
    name: Item Account
    alias: ITEMACCOUNT-FORM
    title: Item Account
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region commonfields (
        name: CommonFields
        type: staticContent
        layout {
            sequence: 30
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region flow-buttons (
        name: Flow Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region item-account (
        name: Item Account
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       MODULECODE,
                       ITEMCODE,
                       ACCOUNTCODE,
                       REMARK,
                       ITEMACCOUNTCODE,
                       ITEMSPECIFICATIONCODE,
                       COMPANYCODE,
                       PARTYCODE,
                       CREATOR,
                       DESPATCHCATEGORYCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       PANDLACCOUNTCODE,
                       INCOMEACCOUNTCODE,
                       TRANSACTIONTYPECODE,
                       NATUREOFSUPPLYCODE,
                       CREATIONTIME
                  from ITEMACCOUNT
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P211_ACCOUNTCODE (
        type: popupLov
        label {
            label: Account
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select partyname, partycode from party;
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @item-account
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @item-account
            column: ACCOUNTCODE
            dataType: varchar2
        }
    )

    pageItem P211_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @commonfields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 209
        }
        sessionState {
            storage: request
        }
    )

