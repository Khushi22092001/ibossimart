    dynamicAction set-quantity-2 (
        name: Set Quantity1
        execution {
            sequence: 270
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail
            columns: QUANTITY2
        }
        clientSideCondition {
            type: itemColumnIsNotNull
            column: UNIT2
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                        mfactor number;
                    begin
                        select MULTIPLYINGFACTOR into mfactor from ITEMSPECIFICATION where ITEMSPECIFICATIONCODE = :ITEMSPECIFICATIONCODE;
                        if  mfactor != 0 then
                            return nvl(:QUANTITY2,0)/nvl(mfactor,0);
                        else 
                            return nvl(:QUANTITY1,0);
                        end if;
                        exception when others then  
                            null;
                    end;
                    ```
                itemsToSubmit: [
                    ITEMSPECIFICATIONCODE
                    QUANTITY2
                    QUANTITY1
                ]
            }
            affectedElements {
                selectionType: columns
                columns: QUANTITY1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn>value
                column: QUANTITY2
                value: 0
            }
        )

    )

