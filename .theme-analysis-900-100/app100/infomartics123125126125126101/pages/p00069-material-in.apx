                        where FINANCIALYEARCODE = :P69_FINANCIALYEARCODE
                        and PARTYCODE = :P69_PARTYCODE
                        and REFDOCTYPECODE = :P69_REFDOCTYPECODE
                        and REFDOCNO = :P69_REFDOCNO;
                    
                        if nvl(tmp , 0)> 0   then 
                            raise_application_error(-20000,'REF DOC NO is already used in Matrial In.');
                        end if;
                        if nvl(tmp1 , 0)> 0   then 
                            raise_application_error(-20000,'REF DOC NO is already used in GRN.');
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P69_FINANCIALYEARCODE
                    P69_PARTYCODE
                    P69_REFDOCTYPECODE
                    P69_REFDOCNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: delete unsaved data
        execution {
            sequence: 420
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
