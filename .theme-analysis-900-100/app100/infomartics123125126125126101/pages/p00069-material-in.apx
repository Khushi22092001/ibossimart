    dynamicAction get-item-from-ccinv (
        name: Get item from CCInv
        execution {
            sequence: 160
        }
        when {
            event: click
            selectionType: button
            button: @getitem
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P69_CCINVOICETNO
        }
        config {
            buildOption: @commented-out
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --raise_application_error(-20003,:P118_DOCTYPECODE);
                    begin
                        if :P69_CCINVOICETNO is not null then 
                    
                            delete from MATERIALINDETAIL where tno = :P69_TNO;
                    
                    
                             --raise_application_error(-20003,:P69_CCINVOICETNO);
                            for vloop in (
                            select 
                            			:P69_TNO as tno,
                            			b.itemcode,
                            			b.itemspecificationcode,
                            			globaltno.nextval as sno,
                                        b.quantity1,
                                        A.TNO AS PTNO
                            from 
                            			ccinvoice a, 
                            			ccinvoicedetail b,
                            			item e,
                            			itemspecification ee
                            where
                            			a.tno = b.tno
                            			and b.itemcode = e.itemcode
                                        and b.itemcode not in (Select itemcode from item where itemnaturecode = 'SERVICES')
                            			and b.itemspecificationcode = ee.itemspecificationcode
                            			and a.tno = :P69_CCINVOICETNO
                            			
                            		
                            ) loop
                                insert into MATERIALINDETAIL
                                    (
                                        TNO,
                                        ITEMCODE,
                                        ITEMSPECIFICATIONCODE,
                                        SNO,
                                        Quantity1,
                                        PURCHASEORDERTNO
                                    ) values
                                    (
                                        vloop.tno,
                                         vloop.itemcode,
                                         vloop.itemspecificationcode,
                                         vloop.sno,
                                         vloop.quantity1,
                                         null
                                    );
                            end loop;
                            --end if;
                        end if;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P69_TNO
                    P69_PURCHASEORDERTNO
                    P69_DELIVERYANDPAYMENTSCHEDULETNO
                    P69_CCINVOICETNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

