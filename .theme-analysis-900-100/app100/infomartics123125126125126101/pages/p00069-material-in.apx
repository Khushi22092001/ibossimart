    region attachment (
        name: Attachment
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       --A.SNO,
                       --DESCRIPTION,
                       B.PARTYATTRIBUTENAME,
                       A.ATTRIBUTEVALUE,
                       A.ATTACHMENTBLOB,
                       A.FILENAME,
                       A.ATTRIBUTECODE,
                       A.moduletno,
                       A.modulesno
                  from MODULEATTACHMENT A, PARTYATTRIBUTE B
                  Where A.ATTRIBUTECODE = PARTYATTRIBUTECODE
                    AND A.moduletno = :P69_TNO;
                ```
            pageItemsToSubmit: P69_TNO
        }
        layout {
            sequence: 50
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 63
                items: {
                    P63_MODULESNO: #MODULESNO##SNO#
                }
                clearCache: 63
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        heading {
            fixedTo: region
            maxReportHeight: 350
        }
        advanced {
            savedReportMappingIdentifier: 586365409536963467
        }

