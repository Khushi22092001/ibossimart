            settings {
                plsqlCode:
                    ```plsql
                    begin
                        if :P69_JOBORDERTNO is not null then 
                            insert into materialindetail
                            (
                                tno,
                                sno,
                                itemcode,
                                itemspecificationcode,
                                description,
                                quantity1,
                                quantity2,
                                JOBORDERTNO
                            )
