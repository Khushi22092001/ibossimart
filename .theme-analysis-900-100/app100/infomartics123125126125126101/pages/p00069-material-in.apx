    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       PACKINGTYPECODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       ISWEIGHTTAKEN,
                       PURCHASEORDERTNO,
                       JOBORDERTNO,
                       PACKINGNOS,
                       ISEXCISABLE,
                       REMARK,
                       ' ' as EQ,
                       GetMeasuringUnitNameFromItem(itemcode) as Unit1,
                       GetMeasuringUnit2NameFromItem(itemcode) as Unit2,
                       null as balance
                  from MATERIALINDETAIL
                  where tno = :P69_TNO
                ```
            pageItemsToSubmit: P69_TNO
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
