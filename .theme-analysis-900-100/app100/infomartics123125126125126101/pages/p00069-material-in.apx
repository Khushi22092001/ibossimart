                                select 
                                    :P69_TNO,
                                    globaltno.nextval,
                                    itemcode,
                                    itemspecificationcode,
                                    description,
                                    quantity1,
                                    quantity2,
                                    :P69_JOBORDERTNO
                                from joborderdetail
                                where tno = :P69_JOBORDERTNO
                                and itemcode not in (Select itemcode from item where itemnaturecode = 'SERVICES')
                            );
                    
                            insert into materialindetail
                            (
                                tno,
                                sno,
                                itemcode,
                                itemspecificationcode,
                                quantity1,
                                quantity2
                            )
                            (
