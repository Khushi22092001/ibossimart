        column UNIT (
            type: selectList
            heading {
                heading: Unit
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                        mu.measuringunitname,
                        mu.measuringunitcode
                    FROM measuringunit mu
                    JOIN (
                        SELECT measuringunitcode1 AS unitcode
                        FROM item
                        WHERE itemcode = :ITEMCODE
                    
                        UNION
                    
                        SELECT measuringunitcode2
                        FROM item
                        WHERE itemcode = :ITEMCODE
                    ) x
                    ON mu.measuringunitcode = x.unitcode;
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ITEMCODE
                itemsToSubmit: ITEMCODE
                parentRequired: false
            }
            layout {
                sequence: 180
            }
            source {
                databaseColumn: UNIT
                dataType: varchar2
                queryOnly: true
            }
            advanced {
                customAttributes: readonly=true
            }
        )

