    process raw-stock-detail-save-interactive-grid-data (
        name: Raw Stock Detail - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @raw-stock-detail
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                BEGIN
                    
                    CASE :APEX$ROW_STATUS
                        WHEN 'C' THEN -- Create (Insert) logic
                            INSERT INTO STOCKJOURNALRAWSTOCKDETAIL (
                                TNO, SNO, SN, STORAGELOCATIONCODE, STOCKTNO, 
                                QUANTITY1, REMARK, APEX_SESSION_ID
                            ) VALUES (
                                :TNO, :SNO, GlobalTNo.Nextval, :STORAGELOCATIONCODE, :STOCKTNO, 
                                :QUANTITY1,  :REMARK , :APEX_SESSION_ID
                            ) RETURNING ROWID INTO :ROWID; -- Rowid return
                
                        WHEN 'U' THEN -- Update logic
                            UPDATE STOCKJOURNALRAWSTOCKDETAIL
                            SET STORAGELOCATIONCODE = :STORAGELOCATIONCODE,
                                STOCKTNO = :STOCKTNO,
                                QUANTITY1 = :QUANTITY1,
                                REMARK = :REMARK
                            WHERE ROWID = :ROWID; -- Update based on ROWID
                
                        WHEN 'D' THEN -- Delete logic
                            DELETE FROM STOCKJOURNALRAWSTOCKDETAIL
                            WHERE ROWID = :ROWID;
                    END CASE;
                END;
                
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 31617431307246784
        }
    )

    process raw-stock-save-interactive-grid-data (
        name: Raw Stock - Save Interactive Grid Data
        type: executeCode
        editableRegion: @raw-stock
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into STOCKJOURNALRAW   (                 
                                    TNO,
                                   SNO,
                                   SERIALNO,
                                   ITEMCODE,
                                   DESCRIPTION,
                                   QUANTITY1,
                                   LOSSPERCENT,
                                   LOSSQUANTITY1,
                                   REMARK,
                                   STORAGELOCATIONCODE,
                                   FEEDTOKILN,
                                   CREATOR,
                                   DATEOFENTRY,
                                   ITEMSPECIFICATIONCODE          
                            )
                            Values (
                                :P181_TNO                   ,
                                :SNO                   ,
                                :SERIALNO              ,
                                :ITEMCODE           ,
                                :DESCRIPTION             ,
                                :QUANTITY1                  ,
                                :LOSSPERCENT                ,
                                :LOSSQUANTITY1          ,
                                :REMARK           ,
                                :STORAGELOCATIONCODE,
                               :FEEDTOKILN,
                               :CREATOR,
                               :DATEOFENTRY ,
                               :ITEMSPECIFICATIONCODE
                
                            );
                        
                        when 'U' then
                            update STOCKJOURNALRAW  Set
                                TNO = :P181_TNO,
                                   SNO = :SNO,
                                   SERIALNO = :SERIALNO,
                                   ITEMCODE = :ITEMCODE,
                                   DESCRIPTION   =:DESCRIPTION,
                                   QUANTITY1  = :QUANTITY1,
                                   LOSSPERCENT = :LOSSPERCENT,
                                   LOSSQUANTITY1 = :LOSSQUANTITY1,
                                   REMARK  = :REMARK,
                                   STORAGELOCATIONCODE  = :STORAGELOCATIONCODE ,
                                   FEEDTOKILN  = :FEEDTOKILN  ,
                                   CREATOR  = :CREATOR  ,
                                   DATEOFENTRY = :DATEOFENTRY     ,
                                   ITEMSPECIFICATIONCODE = :ITEMSPECIFICATIONCODE            
                            WHERE TNO = :P181_TNO;
                
                        when 'D' then
                            Delete From STOCKJOURNALRAW 
                            Where TNo = :P181_TNO;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
