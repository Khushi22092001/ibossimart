    region raw-stock-detail (
        name: Raw Stock Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       SN,
                       STOCKTNO,
                       STORAGELOCATIONCODE,
                       QUANTITY1,
                       AMOUNT,
                       REMARK,
                       APEX_SESSION_ID
                       
                  from STOCKJOURNALRAWSTOCKDETAIL
                  where tno =   :P181_TNO
                    and sno =   :P181_RAW_SNO
                ```
            pageItemsToSubmit: [
                P181_TNO
                P181_RAW_SNO
            ]
        }
        layout {
            sequence: 40
            slot: body
