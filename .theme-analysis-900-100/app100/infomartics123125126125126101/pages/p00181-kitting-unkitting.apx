    button p181-auto-stock-allocate-raw (
        buttonName: P181_AUTO_STOCK_ALLOCATE_RAW
        label: Auto Stock Allocate for Raw
        layout {
            sequence: 70
            region: @raw-stock-detail
            slot: regionBody
            columnAttributes: [
                style="padding-left:10px;
                padding-bottom:10px;"
            ]
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--tiny
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    v_check number;
                begin
                    select count(v.tno)
                      into v_check
                      from Voucher v
                     where v.ModuleTNo = :P181_TNO;
                
                    if v_check > 0 then
                        return false;
                    else
                        return true;
                    end if;
                end;
                ```
        }
    )

