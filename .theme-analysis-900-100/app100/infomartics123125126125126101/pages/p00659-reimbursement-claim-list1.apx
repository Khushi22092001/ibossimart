    region reimbursement-claim-list (
        name: Reimbursement Claim List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       TOUREXPENSENO,
                       TOUREXPENSEDATE,
                       TOURREQUESTTNO,
                       HOTELNAME,
                       HOTELDETAIL,
                       TOTALEXPENSEAMOUNT,
                       BALANCEAMOUNT,
                       TOTALSELFAMOUNT,
                       TOTALCOMPANYAMOUNT,
                       REMARK,
                       CREATOR,
                       CREATIONTIME,
                       POLICYFORCODE,
                       MODULECODE,
                       MONEYTRANSFERMODECODE,
                       MONEYTRANSFERREFERENCENO,
                       ACCOUNTCODE,
                       IMPRESTACCOUNTCODE,
                       TRANSACTIONTYPECODE,
                       NATUREOFSUPPLYCODE,
                                   '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||9993||':'||:APP_SESSION||'::::'||'P9993_TNO,P9993_REPNAME'||':'||Tno||','||'ReimbursementClaim'||':NO')||'"><span aria-label="Action"><span class="fa fa-print"  aria-hidden="true" title="Action"></span</span></a>' AS Print
                
                  from TOUREXPENSE
                    where ( :P659_LOCATION IS NULL OR instr(':'||:P659_LOCATION||':',':'||LOCATIONCODE||':') > 0 )
                and ( :P659_DOCTYPE IS NULL OR instr(':'||:P659_DOCTYPE||':',':'||DOCTYPECODE||':') > 0 )
                and ( :P659_COMPANY IS NULL OR instr(':'||:P659_COMPANY||':',':'||COMPANYCODE||':') > 0 )
                and TOUREXPENSEDATE  between :P659_FROMDATE and :P659_TODATE
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 660
                items: {
                    P660_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 26977294267965219
        }

