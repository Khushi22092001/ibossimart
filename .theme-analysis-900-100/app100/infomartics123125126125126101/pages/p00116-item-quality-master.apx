                t-Button--pill
            ]
            icon: fa-workflow
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                items: {
                    P162_TNO: &P2_TNO1.
                }
                clearCache: 162
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
