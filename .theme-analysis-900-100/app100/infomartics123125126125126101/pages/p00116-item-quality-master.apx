page 116 (
    name: Item Quality Master
    alias: ITEM-QUALITY-MASTER
    title: Item Quality Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region item-quality-master (
        name: Item Quality Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       SNO,
                       SERIALNO,
                       QUALITYCODE,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       MINIMUMVALUE,
                       MAXIMUMVALUE,
                       TOLERANCE,
                       DEDUCTIONONFREIGHT,
                       DEDUCTIONONBILL,
                       DEDUCTIONVARIATIONTYPE,
                       DEDUCTIONMETHODCODE,
                       BONUSONBILL,
                       MEASURINGUNITCODE,
                       PARAMETERSPECIFICATION,
                       CREATOR,
                       CREATIONTIME,
                       REMARK
                  from ITEMQUALITY
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P116_BONUSONBILL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 140
            region: @item-quality-master
            slot: regionBody
        }
        source {
            formRegion: @item-quality-master
            column: BONUSONBILL
            dataType: varchar2
        }
    )

    pageItem P116_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P116_CREATIONTIME (
        type: textField
        label {
            label: Creation Time
            alignment: left
        }
        layout {
            sequence: 190
            region: @item-quality-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH24:MI:SS
            width: 32
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @item-quality-master
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MON-YYYY HH24:MI:SS') from dual
        }
        serverSideCondition {
            type: item=value
            item: P116_FORMSTATUS
            value: EDITRECORD
        }
    )

    pageItem P116_CREATOR (
        type: textField
        label {
            label: Creator
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 180
            region: @item-quality-master
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
