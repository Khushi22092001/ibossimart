        lov {
            type: sqlQuery
            sqlQuery: Select A.ItemSpecificationName, A.ItemSpecificationCode from ItemSpecification A where A.TnO = :P116_ITEMCODE
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P116_TNO
            itemsToSubmit: P116_ITEMCODE
        }
        layout {
            sequence: 60
            region: @item-quality-master
            slot: regionBody
            alignment: left
