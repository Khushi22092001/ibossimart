    pageItem P116_ITEMCODE (
        type: popupLov
        label {
            label: Item Code
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery: Select A.ItemName, A.TNO from Item A Order By A.tno
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @item-quality-master
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
