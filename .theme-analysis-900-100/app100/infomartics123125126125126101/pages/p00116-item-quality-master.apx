    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P116_TNO is null then
                            :P116_FORMSTATUS := 'NEWRECORD';
                        else
                            :P116_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P116_TNO is null then
                
                        select globaltno.nextval into :P116_TNO from dual;
                        select globaltno.nextval into :P116_SNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 148538441555473936
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P116_MODULEFLOW := 'YES';
                   else
                       :P116_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P116_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P116_ONTHETABLE := 'YES' ;
                   else
                       :P116_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 148538757161474598
        }
    )

