page 123 (
    name: Bank List
    alias: BANK-LIST
    title: Bank List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bank-list (
        name: Bank List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.BANKCODE,
                       A.BANKNAME,
                       A.ADDRESS1,
                       A.ADDRESS2,
                       A.ADDRESS3,
                       A.CITYCODE,
                       A.STATECODE,
                       A.PINCODE,
                       A.REMARK,
                       A.BRANCHCODE,
                       A.BSRCODE,
                       A.CREATOR,
                       to_char(A.CREATIONTIME,'DD-MON-YYYY HH24:MI:SS') CREATIONTIME
                  from BANK A
                  Order By A.TNO Desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 124
                items: {
                    P124_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 153195573208459060
        }

        column ADDRESS1 (
            type: plainText
            heading {
                heading: Address 1
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ADDRESS2 (
            type: plainText
            heading {
                heading: Address 2
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ADDRESS3 (
            type: plainText
            heading {
                heading: Address 3
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column BANKCODE (
            type: plainText
            heading {
                heading: Bank Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column BANKNAME (
            type: plainText
            heading {
                heading: Bank Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column BRANCHCODE (
            type: plainText
            heading {
                heading: Branch Code
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column BSRCODE (
            type: plainText
            heading {
                heading: BSR Code
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column CITYCODE (
            type: plainText
            heading {
                heading: City Code
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 23
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column PINCODE (
            type: plainText
            heading {
                heading: Pin Code
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column STATECODE (
            type: plainText
            heading {
                heading: State Code
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Bank List
        }

        savedReport 1532480 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ADDRESS1 (
                sequence: 4
            )

            displayColumn ADDRESS2 (
                sequence: 5
            )

            displayColumn ADDRESS3 (
                sequence: 6
            )

            displayColumn BANKCODE (
                sequence: 2
            )

            displayColumn BANKNAME (
                sequence: 3
            )

            displayColumn BRANCHCODE (
                sequence: 11
            )

            displayColumn BSRCODE (
                sequence: 12
            )

            displayColumn CITYCODE (
                sequence: 7
            )

            displayColumn CREATIONTIME (
                sequence: 14
            )

            displayColumn CREATOR (
                sequence: 13
            )

            displayColumn PINCODE (
                sequence: 9
            )

            displayColumn REMARK (
                sequence: 10
            )

            displayColumn STATECODE (
                sequence: 8
            )

            displayColumn TNO (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @bank-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 124
                clearCache: 124
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @bank-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @bank-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @bank-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @bank-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

