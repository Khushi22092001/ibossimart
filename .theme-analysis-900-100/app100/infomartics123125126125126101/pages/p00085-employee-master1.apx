    region changes (
        name: Changes
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                d.TNo,
                A.EFFECTIVEDATE,
                a.employeecode,
                a.CHANGEINEMPLOYEEDATE,
                a.NEWEMPLOYEEID,
                j.SHIFTNAME,
                f.DESIGNATIONNAME,
                e.DEPARTMENTNAME,
                h.LOCATIONNAME,
                d.employeename
                from 
                ChangeInEmployee a, location b, doctype c , Employee d, Department e,Designation f, category g, 
                --employeenature h, 
                stafftype i, shift j, LOCATION h
                where
                a.LocationCode = b.LocationCode
                AND A.EmployeeCODE = d.EmployeeCODE
                and a.newdepartmentcode = e.departmentcode(+)
                and a.newdesignationcode = f.designationcode(+)
                and a.newcategorycode = g.categorycode(+)
                --and a.newemployeenaturecode = h.employeenaturecode(+)
                and a.newstafftypecode = i.stafftypecode(+)
                and a.newshiftcode = j.shiftcode(+)
                and a.newLOCATIONcode = h.LOCATIONcode(+)
                and a.DocTypeCode = c.DocTypeCode
                and a.employeecode = :P85_EMPLOYEECODE
                
                
                /*select ROWID,
                       TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       CHANGEINEMPLOYEENO,
                       CHANGEINEMPLOYEEDATE,
                       EMPLOYEECODE,
                       EFFECTIVEDATE,
                       NEWDEPARTMENTCODE,
                       NEWDESIGNATIONCODE,
                       NEWCATEGORYCODE,
                       NEWSTAFFTYPECODE,
                       NEWEMPLOYEENATURECODE,
                       NEWSHIFTCODE,
                       NEWWEEKLYOFFDAY,
                       NEWCOMPANYCODE,
                       MODULECODE,
                       MODULETNO,
                       REMARK,
                       CREATOR,
                       NEWLOCATIONCODE,
                       NEWEMPLOYEEID,
                       NEWINCENTIVESCHEMECODE,
                       NEWBRANCHCODE,
                       CREATIONTIME,
                       MODULESNO,
                       MODULESN,
                       NEWBONUSSCHEMECODE
                  from CHANGEINEMPLOYEE
                  where tno = :P85_TNO
                  */
                ```
            pageItemsToSubmit: [
                P85_TNO
                P85_EMPLOYEECODE
            ]
        }
        layout {
            sequence: 110
            parentRegion: @new-2
            slot: tabs
        }
