        column EMPLOYEELOANACCOUNTCODE (
            type: popupLov
            heading {
                heading: Loan Account
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select  a.PartyName,
                    	a.PartyCode
                    	
                    from Party a, PartyCompany b
                    where a.PartyTypeCode = 'EMPLOYEE'
                    	and a.TNo = b.TNo
                    	and b.CompanyCode = :global_CompanyCode
                    order by a.PartyName
                    
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: EMPLOYEELOANACCOUNTCODE
                dataType: varchar2
            }
            columnFilter {
