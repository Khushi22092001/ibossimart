    dynamicAction validate-no (
        name: "validate no "
        execution {
            sequence: 170
        }
        when {
            event: focusout
            selectionType: items
            items: P85_OFFICEMOBILENO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        v_item_value VARCHAR2(100); -- Change the size according to your item's data type and size
                    BEGIN
                        -- Get the value of the page item
                        SELECT :P85_OFFICEMOBILENO -- Replace P1_ITEM with the actual name of your page item
                        INTO v_item_value
                        FROM DUAL;
                    
                        -- Check if the value contains any alphabet characters
                        IF REGEXP_LIKE(v_item_value, '[[:alpha:]]')  OR LENGTH(v_item_value) != 10 THEN
                            -- Raise an error
                            :P85_OFFICEMOBILENO := 0;
                            --RAISE_APPLICATION_ERROR(-20000, 'The value should not contain any alphabet characters or length should be 10.');
                        END IF;
                    END;
                    
                    ```
                itemsToSubmit: P85_OFFICEMOBILENO
                itemsToReturn: P85_OFFICEMOBILENO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    RAISE_APPLICATION_ERROR(-20000, 'The value should not contain any alphabet characters or length should be 10.');
                    
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P85_OFFICEMOBILENO
                value: 0
            }
        )

    )

