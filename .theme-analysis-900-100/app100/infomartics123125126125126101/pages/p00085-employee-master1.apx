    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    b.employeesalarydate,
                    b.effectivedate,
                    c.salaryschemename,
                    d.salaryheadformula AS basic
                FROM
                    employee             a,
                    employeesalary       b,
                    salaryscheme         c,
                    employeesalarydetail d
                WHERE
                        a.employeecode = b.employeecode
                    AND b.salaryschemecode = c.salaryschemecode
                    AND b.tno = d.tno
                    and a.employeecode = :P85_EMPLOYEECODE
                ```
            pageItemsToSubmit: P85_EMPLOYEECODE
        }
        layout {
            sequence: 10
            parentRegion: @salary
            slot: subRegions
        }
