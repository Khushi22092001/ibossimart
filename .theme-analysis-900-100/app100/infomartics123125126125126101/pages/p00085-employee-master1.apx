    region earned-salary (
        name: Earned Salary
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a1.tno, 
                      TO_CHAR(A.SALARYFROMDATE, 'Mon-rrrr'),
                       b.SalaryHeadAmount AS "Gross Earning",
                       c.SalaryHeadAmount as "Gross Deduction",
                       d.SalaryHeadAmount as "Net Payble"
                  From Employee     a1,
                       Salary       a,
                       SalaryDetail b,
                       SalaryDetail c,
                       SalaryDetail d
                 Where a1.EmployeeCode = a.EmployeeCode
                   And a.TNO = b.TNo
                   And a.TNO = c.TNo
                   And a.TNO = d.TNo
                   And b.SalaryHeadCode = 'GROSSEARNING'
                   And c.SalaryHeadCode = 'GROSSDEDUCTION'
                   And d.SalaryHeadCode = 'NETEARNING'
                   And a1.tno = :P85_TNO
                ```
            pageItemsToSubmit: P85_TNO
        }
        layout {
            sequence: 100
            parentRegion: @new-2
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 283926262895647937
        }

