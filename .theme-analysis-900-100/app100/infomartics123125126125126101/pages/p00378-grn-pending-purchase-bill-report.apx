    )

    pageItem P378_ITEM (
        type: selectOne
        label {
            label: Item
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      e.ItemName||' ( '||e.ItemCode||' )' as d,
                      e.ItemCode r
                From GRNDetail a, Item e
                Where a.ItemCode = e.ItemCode
                Order by 2
                ```
        }
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Item Name
        }
    )

    pageItem P378_ITEM_SPECIFICATION (
        type: selectOne
        label {
            label: Item Specification
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                     ee.ItemSpecificationName as d,
                     ee.ItemSpecificationCode as r
                From Item e, ItemSpecification ee
                Where e.ItemCode = :P378_ITEM
                  and e.TNo = ee.TNo
                ```
        }
        cascadingLov {
            parentItems: P378_ITEM
            itemsToSubmit: P378_ITEM_SPECIFICATION
        }
        layout {
            sequence: 80
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Item Specification Name
        }
    )

    pageItem P378_LOCATION (
        type: selectOne
        label {
            label: Location
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'GRN'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order By 1
                ;
                
                ```
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Location Name
        }
    )

    pageItem P378_PARTY (
        type: selectOne
        label {
            label: Party
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       Distinct
                       p.PartyName d,
                       p.PartyCode r
                From GRN a, Party p
                Where a.PartyCode = p.PartyCode
                Order by 1
                ```
        }
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
            alignment: left
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Party Name
        }
    )

    button p378-refresh-btn (
        buttonName: P378_REFRESH_BTN
        label: Refresh
        layout {
            sequence: 90
            region: @filter
            slot: regionBody
            startNewRow: false
            column: 11
            columnAttributes: [
                style=
                "margin-top:
                8px;"
            ]
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            customAttributes: style="padding-top: 2px;     padding-bottom: 2px;    "
        }
    )

    dynamicAction hide-navigation-menu (
        name: Hide navigation menu
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    process get-default-values (
        name: Get Default Values
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P378_FY_BEGIN      := :GLOBAL_FINANCIALYEARBEGIN;
                    :P378_FY_END        := :GLOBAL_FINANCIALYEAREND;
                    IF  :P378_DATE_RANGE IS NULL THEN
                        -- :P378_DATE_RANGE    :=  :P378_FY_BEGIN||' - '||:P378_FY_END;
                        :P378_DATE_RANGE    :=  TO_CHAR(SYSDATE, 'DD-MM-YYYY') || ' - ' || TO_CHAR(SYSDATE, 'DD-MM-YYYY');
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 41719503287263920
        }
    )

)

