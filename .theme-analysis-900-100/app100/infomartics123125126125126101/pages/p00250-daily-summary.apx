        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                       rtvalue varchar2(30);
                       tfromdate date;
                       ttodate date;
                       tPartyCode varchar2(30);
                    begin
                    --RAISE_APPLICATION_ERROR(-20003,'P '||V('P401_ACCODE'));
                    select v('P401_ACCODE') into tPartyCode from dual;
                    
                     if tPartyCode is null then
                        select v('P252_PARTYCODE') into tPartyCode from dual;
                     end if;
                     --raise_application_error(-20000,:p401_accode);
                      --SELECT v('P401_ACCODE') INTO RTVALUE FROM DUAL;
                       rtvalue := tPartyCode;
                    
                       RETURN(RTVALUE);
                    end;
                    ```
                itemsToSubmit: [
                    P401_ACCODE
                    P252_PARTYCODE
                ]
            }
            affectedElements {
                selectionType: items
                items: P250_PARTY
            }
            execution {
                sequence: 30
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                       rtvalue date;
                       tfromdate date;
                       ttodate date;
                       tPartyCode varchar2(30);
                    begin
                    --RAISE_APPLICATION_ERROR(-20003,'P '||V('P401_ACCODE'));
                    select v('P401_ACCODE') into tPartyCode from dual;
                    
                     if tPartyCode is null then
                        select '01-'||TO_CHAR(v('P252_ASONDATE'),'MM-YYYY') into tFromDate from dual;
                     else
                        select v('P401_FROMDATE') into tFromDate from dual;
                     end if;
                     --raise_application_error(-20000,:p401_accode);
                      --SELECT v('P401_ACCODE') INTO RTVALUE FROM DUAL;
                       rtvalue := tFromDate;
                    
                       RETURN(RTVALUE);
                    end;
                    ```
                itemsToSubmit: [
                    P401_ACCODE
                    P252_PARTYCODE
                    P401_FROMDATE
                    P252_ASONDATE
                ]
            }
            affectedElements {
                selectionType: items
                items: P250_FROMDATE
            }
            execution {
                sequence: 40
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                       rtvalue date;
                       tfromdate date;
                       ttodate date;
                       tPartyCode varchar2(30);
                    begin
                    --RAISE_APPLICATION_ERROR(-20003,'P '||V('P401_ACCODE'));
                    select v('P401_ACCODE') into tPartyCode from dual;
                    
                     if tPartyCode is null then
                        select LAST_DAY(v('P252_ASONDATE')) into tToDate from dual;
                     else
                        select v('P401_TODATE') into tToDate from dual;
                     end if;
                     --raise_application_error(-20000,ttodate);
                      --SELECT v('P401_ACCODE') INTO RTVALUE FROM DUAL;
                       rtvalue := ttodate;
                    
                       RETURN(RTVALUE);
                    end;
                    ```
