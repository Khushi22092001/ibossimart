page 301 (
    name: Cheque Receipt
    alias: CHEQUE-RECEIPT
    title: Cheque Receipt
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cheque-receipt (
        name: Cheque Receipt
        type: form
        source {
            location: localDatabase
            tableName: CHEQUERECEIPT
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region commonfields (
        name: CommonFields
        type: staticContent
        layout {
            sequence: 20
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       CHEQUECLEARENCEDATE,
                       CHEQUEISSUEDATE,
                       CHEQUENO,
                       REMARK,
                       SERIALNO,
                       STATUS,
                       TNO,
                       ACCOUNTCODE,
                       INHANDOFBOSSUSERCODE,
                       ISLOCKED,
                       COMPANYCODE,
                       BANKCODE,
                       apex_GetVoucherNoForCheque(:P301_BANKCODE , CHEQUENO) as voucherno,
                       apex_GetPartyNameForCheque(:P301_BANKCODE , CHEQUENO) as partyname
                  from CHEQUERECEIPTDETAIL
                  where tno = :P301_TNO
                ```
            pageItemsToSubmit: P301_TNO
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 31921928144861724
        }

        savedReport 322026 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @VOUCHERNO
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @PARTYNAME
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @CHEQUECLEARENCEDATE
                layout {
                    show: false
                    sequence: 11
                }
            )

            displayColumn (
                column: @CHEQUEISSUEDATE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @CHEQUENO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @SERIALNO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @STATUS
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 12
                }
            )

            displayColumn (
                column: @ACCOUNTCODE
                layout {
                    show: false
                    sequence: 13
                }
            )

            displayColumn (
                column: @INHANDOFBOSSUSERCODE
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @ISLOCKED
                layout {
                    show: false
                    sequence: 14
                }
            )

            displayColumn (
                column: @COMPANYCODE
                layout {
                    show: false
                    sequence: 15
                }
            )

            displayColumn (
                column: @BANKCODE
                layout {
                    show: false
                    sequence: 16
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column ACCOUNTCODE (
            type: textField
            heading {
                heading: Account
            }
            layout {
                sequence: 110
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ACCOUNTCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column BANKCODE (
