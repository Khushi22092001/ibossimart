    pageItem P301_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @commonfields
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P301_TNO), 'Status')
        }
    )

    pageItem P301_STATUSRIGHT (
        type: hidden
        layout {
            sequence: 10
            region: @commonfields
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select B.STATUSPRIVILEGE
                  From module a, moduleprivilege b, bossuser c
                 Where a.modulecode = b.modulecode
                   And b.bossusercode = c.bossusercode
                   And c.loginname = :GLOBAL_LOGINNAME
                   And A.ENTRYPAGENO = :APP_PAGE_ID
                   AND B.COMPANYCODE = :GLOBAL_COMPANYCODE
                ```
        }
    )

