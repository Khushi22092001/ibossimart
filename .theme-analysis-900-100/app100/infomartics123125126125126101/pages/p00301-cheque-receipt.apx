                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column PARTYNAME (
            type: popupLov
            heading {
                heading: Issued to Party
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery: select partyname , partycode from party
            }
            layout {
                sequence: 170
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: PARTYNAME
                dataType: varchar2
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
