    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P301_TNO
                    P301_COMPANYCODE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P301_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction populate-detail (
        name: Populate detail
        execution {
            sequence: 110
        }
        when {
            event: focusout
            selectionType: items
            items: P301_FORMATSTRING
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if length(:P301_FORMATSTRING) < length(:P301_CHEQUENOSTART) and :P301_FORMATSTRING is not null then
                      raise_application_error(-20002,'Length of Format String Should Equal or Greater than Length of Ch. Start No');
                    end if;
                    ```
                itemsToSubmit: [
                    P301_FORMATSTRING
                    P301_CHEQUENOSTART
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        tStartNo     Number;
                        tTotalNo     NUmber;
                        i            Number;
                        chno         varchar2(30);
                        J            Number;
                        tCHEQUEno Varchar2(100);
                    begin
                        if NVL(:P301_CHEQUENOSTART,0) = 0 then
                            raise_application_error(
                                        -20000,
                                        'Please Enter CHEQUE Start No'
                                    );
                         else
                             tStartNo := :P301_CHEQUENOSTART ;
                        end if;
                    
                        if NVL(:P301_TOTALCHEQUE,0) = 0 then
                            raise_application_error(
                                        -20000,
                                        'Please Enter Total CHEQUE No'
                                    );
                        else
                            tTotalNo := :P301_TOTALCHEQUE ;
                        end if;
                      /*
                      If Not
                          apex_collection.collection_exists(p_collection_name => 'CHEQUERECEIPT') Then
                        apex_collection.create_collection(p_collection_name => 'CHEQUERECEIPT');
                      Else
                        apex_collection.truncate_collection(p_collection_name => 'CHEQUERECEIPT');
                      End If;
                      ----
                      */
                      DELETE FROM CHEQUERECEIPTDETAIL
                      WHERE TNO = :P301_TNO;
                    
                      i := to_char(tStartNo, :P301_formatstring);
                      chno := to_char(tStartNo, :P301_formatstring);
                      J := 0;
                      loop
                           chno := to_char(i, :P301_formatstring);
                            tCHEQUENo := :P301_CHEQUENOPREFIX||chno||:P301_CHEQUENOSUFFIX ;
                    
                           /*apex_collection.add_member(p_collection_name => 'CHEQUERECEIPT',
                                                   p_N001            => :P301_TNO,
                                                   P_N002            => GLOBALTNO.NEXTVAL,
                                                   p_C001            => tCHEQUENo
                                                   ) ;
                            */ 
                            J := J+1;
                             insert into CHEQUEreceiptdetail
                             ( tno,SERIALNO,CHEQUEno)
                             values ( :P301_TNO,J,tCHEQUENo)       
                             ;
                    
                    	  i := to_char(i + 1, :P301_FORMATSTRING);
                          exit  when i > tStartNo + tTotalNo - 1;                        
                    
                    
                      end loop;
                    end ;
                    ```
                itemsToSubmit: [
                    P301_TNO
                    P301_CHEQUENOPREFIX
                    P301_CHEQUENOSTART
                    P301_TOTALCHEQUE
                    P301_CHEQUENOSUFFIX
                    P301_FORMATSTRING
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

