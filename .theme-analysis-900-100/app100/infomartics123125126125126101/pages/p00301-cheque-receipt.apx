            plsqlCode:
                ```plsql
                declare
                    --tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tModuleCode varchar2(30) := 'MATERIALIN';
                    tmp         number ;
                begin
                     if :P301_TNO is null then
                        Select GlobalTno.NextVal into :P301_TNO From Dual;
                     end if;
                    ----
                    if :P301_CHEQUERECEIPTCODE is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					null,
                					null,
                					NULL,
                					TO_DATE(:P301_CHEQUERECEIPTDATE, 'DD-MM-RRRR')
                				);
                        :P301_CHEQUERECEIPTCODE := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    null,
                                    null,
                                    NULL,
                                    TO_DATE(:P301_CHEQUERECEIPTDATE, 'DD-MM-RRRR')
                                    );
