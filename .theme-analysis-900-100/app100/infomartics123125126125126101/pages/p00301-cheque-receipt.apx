    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P301_MODULEFLOW := 'YES';
                   else
                       :P301_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P301_ONTHETABLE := 'YES' ;
                   else
                       :P301_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32165247396594968
        }
    )

    process gettno (
        name: gettno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P301_TNO IS NULL then
                    :P301_FORMSTATUS := 'NEWRECORD';
                    select globaltno.nextval into :P301_TNO from dual;
                  else 
                    :P301_FORMSTATUS := 'EDITRECORD';
                end if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
