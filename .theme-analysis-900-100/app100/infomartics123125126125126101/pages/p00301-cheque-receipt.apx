                type: sqlQuery
                sqlQuery: select voucherno , tno from voucher
            }
            layout {
                sequence: 160
            }
            source {
                databaseColumn: VOUCHERNO
                dataType: number
                queryOnly: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Detail
        }
    )

    region flow-buttons (
        name: Flow Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
