    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P356_FORMSTATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P356_STATUSRIGHT
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P356_TNO,:P356_STATUS);
                itemsToSubmit: P356_TNO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P356_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    location.reload()
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P356_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction fail (
        name: Fail
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @fail
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    		cursor cPassFail is
                    				select
                    						a.TNo,
                    						a.TokenNo										
                    				from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    				where a.ModuleFlowTNo = b.TNo
                    						and b.TNo = c.TNo
                    						and a.BossUserCode = c.BossUserCode
                    						and c.BossUserCode = d.BossUserCode
                    						and a.ModuleTNo = ':P'||to_char(:APP_PAGE_ID)||'_TNo'
                    						and d.LoginName = User
                    						and a.isPass is null
                    						and a.IsFail is null
                    						and a.IsForwarded is null
                    						and a.IsRebounded is null																				
                    		;
                    		vPassFail cPassFail%rowtype;
                        
                        tTokenNo NUMBER;
                        TMP VARCHAR2(100) := :P60_TNO;
                    begin
                    		open cPassFail;
                    		fetch cPassFail into vPassFail;
                    		if cPassFail%FOUND then
                    				tTokenNo := vPassFail.TokenNo;
                    				close cPassFail;
                    
                               	
                    				update PassFail a
                    				set a.IsFail = 'YES',
                    						a.remark = ':P'||to_char(:APP_PAGE_ID)||'_PASSFAILREMARK'
                    				where a.TNo = vPassFail.TNo;
                    				
                    				SendBackPassFail(tTokenNo , TMP );
                    		    		
                    				
                    				commit;
                    		else
                    				close cPassFail;
                    		end if;
                    
                    	
                    end;
                    ```
                itemsToSubmit: [
                    P356_TNO
                    P356_COMPANYCODE
                    P356_PURCHASEORDERNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P356_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction go-back-to-called-form (
        name: Go Back To Called Form
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P356_CALLEDFROMPAGE').getValue();
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P356_TNO
                    P356_COMPANYCODE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P356_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process gettno (
        name: gettno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P356_TNO IS NULL then
                    :P356_FORMSTATUS := 'NEWRECORD';
                    select globaltno.nextval into :P356_TNO from dual;
                  else 
                    :P356_FORMSTATUS := 'EDITRECORD';
                end if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13251578056188599
        }
    )

