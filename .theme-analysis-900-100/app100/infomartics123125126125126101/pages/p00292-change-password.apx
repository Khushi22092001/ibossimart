page 292 (
    name: Change Password
    alias: CHANGE-PASSWORD
    title: Change Password
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region change-password (
        name: Change Password
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
    )

    pageItem P292_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 1
        }
    )

    pageItem P292_CONFIRMNEWPASSWORD (
        type: textField
        label {
            label: Confirm New Password
            alignment: left
        }
        layout {
            sequence: 30
            region: @change-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
    )

    pageItem P292_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 210
            region: @fields
            slot: regionBody
        }
    )

    pageItem P292_MODULEFLOW (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 200
            region: @fields
            slot: regionBody
        }
    )

    pageItem P292_NEWPASSWORD (
        type: password
        label {
            label: New Password
            alignment: left
        }
        layout {
            sequence: 20
            region: @change-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P292_OLDPASSWORD (
        type: password
        label {
            label: Old Password
            alignment: left
        }
        layout {
            sequence: 10
            region: @change-password
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P292_ONTHETABLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 190
            region: @fields
            slot: regionBody
        }
    )

    pageItem P292_PASSFAILREMARK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @fields
            slot: regionBody
        }
    )

    pageItem P292_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 220
            region: @fields
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P292_TNO), 'Status')
        }
        sessionState {
            storage: request
        }
    )

    pageItem P292_STATUSRIGHT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 170
            region: @fields
            slot: regionBody
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 60
            region: @change-password
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 90
            region: @change-password
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: never
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 70
            region: @change-password
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P292_FORMSTATUS
            value: EDITRECORD
        }
    )

    button fail (
        buttonName: Fail
        label: Fail
        layout {
            sequence: 20
            region: @change-password
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-thumbs-o-down
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 163
                clearCache: 163
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P292_FORMSTATUS
            value: EDITRECORD
        }
    )

    button flow (
        buttonName: Flow
        label: Flow
        layout {
            sequence: 30
            region: @change-password
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pill
            ]
            icon: fa-workflow
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                items: {
                    P162_TNO: &P2_TNO1.
                }
                clearCache: 162
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P292_FORMSTATUS
            value: EDITRECORD
        }
    )

    button pass (
        buttonName: Pass
        label: Pass
        layout {
            sequence: 10
            region: @change-password
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-thumbs-o-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 163
                clearCache: 163
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P292_FORMSTATUS
            value: EDITRECORD
        }
    )

    button print (
        buttonName: Print
        label: Print
        layout {
            sequence: 50
            region: @change-password
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pill
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P292_FORMSTATUS
            value: EDITRECORD
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 80
            region: @change-password
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
    )

    button status (
        buttonName: Status
        label: Status
        layout {
            sequence: 40
            region: @change-password
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-comments-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 164
                clearCache: 164
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P292_FORMSTATUS
            value: EDITRECORD
        }
    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P292_CALLEDFROMPAGE').getValue();
                    var y = apex.item('P292_CALLEDFROMTNO').getValue();
                    
                    //var url = "f?p=#APP_ID#:80:#SESSION#::NO:RP,80:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    
                    url = url.replace("#P2002_TNO#", y);
                    //window.alert(x);
                    //window.alert(y);
                    //window.alert(url);
                    
                    
                    //call
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process update-password (
        name: Update password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                vPassword Varchar2(100);
                begin
                    Select a.bosspassword into vPassword From bossuser a
                     Where a.loginname = :GLOBAL_LOGINNAME;
                
                     if vpassword = :P292_OLDPASSWORD then
                        if :P292_NEWPASSWORD = :P292_CONFIRMNEWPASSWORD then
                            update bossuser a set bosspassword = :P292_NEWPASSWORD
                            Where a.loginname = :GLOBAL_LOGINNAME;
                        else
                            raise_application_error(-20001,'New Password Given is not Matched, Pl. Confirm');
                        end if;
                    else
                        raise_application_error(-20001,'Old Password Given is not correct, Pl. Confirm');
                    end if;
                end ;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 21389062550198218
        }
    )

    branch (
        name: go to 1
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 1
            }
        }
    )

)

