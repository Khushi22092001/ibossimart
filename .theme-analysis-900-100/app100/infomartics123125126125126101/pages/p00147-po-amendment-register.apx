    pageItem P147_PONO (
        type: textFieldWithAutocomplete
        label {
            label: PoNo
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select PurchaseOrderNo 
                From PurchaseOrder 
                Where instr(':'||:P147_LOCATION||':',':'||LocationCode||':') > 0
                  and PurchaseOrderDate Between :P147_FROMDATE and :P147_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P147_LOCATION
            itemsToSubmit: P147_PONO
        }
