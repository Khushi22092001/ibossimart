    pageItem P125_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.LocationName d,
                	a.LocationCode r
                From Location a, ModuleLocationDetail b , ModuleLocation c
                Where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = (Select ModuleCode from Module Where EntryPageNo = :APP_PAGE_ID)
                	and c.CompanyCode = :GLOBAL_COMPANYCODE
                	and (
                		not exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = (Select ModuleCode from Module Where EntryPageNo = :APP_PAGE_ID)
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                		or
                		exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = (Select ModuleCode from Module Where EntryPageNo = :APP_PAGE_ID)
                			and bb.LocationCode = a.LocationCode
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                	)
                Order by a.LocationName
                ```
            displayExtraValues: false
            nullDisplayValue: -Select-
        }
