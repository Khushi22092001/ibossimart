    pageItem P125_ACCOUNT (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Account
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct nvl(getpartyname(b.accountcode),b.accountcode) d, b.accountcode r
                from voucher a, voucherDetail B
                where a.tno = b.tno
                  and ( :P125_FROMDATE is null or a.voucherdate >= :P125_FROMDATE )
                  and ( :P125_TODATE is null or a.voucherdate <= :P125_TODATE )
                order by 1
                ```
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: [
                P125_FROMDATE
                P125_TODATE
            ]
            itemsToSubmit: [
                P125_FROMDATE
                P125_TODATE
            ]
            parentRequired: false
