    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P668_TNO is null then
                            :P668_FORMSTATUS := 'NEWRECORD';
                        else
                            :P668_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P668_TNO is null then
                
                        select globaltno.nextval into :P668_TNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 30785634903888203
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P668_MODULEFLOW := 'YES';
                   else
                       :P668_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P668_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P668_ONTHETABLE := 'YES' ;
                   else
                       :P668_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 30786034702888203
        }
    )

    process get-party-attribute-code (
        name: Get Party Attribute Code
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getmodulecodeforpageno(:APP_PAGE_ID);
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P668_ASSETCATEGORYCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P668_ASSETCATEGORYCODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 30786437426888203
        }
    )

    process initialize-form-partyattribute (
