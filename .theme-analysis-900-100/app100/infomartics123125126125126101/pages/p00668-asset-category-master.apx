page 668 (
    name: Asset Category Master
    alias: ASSET-CATEGORY-MASTER
    title: Asset Category Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        height: 500
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asset-categpry-master (
        name: ASSET CATEGPRY MASTER
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       ASSETCATEGORYCODE,
                       ASSETCATEGORYNAME,
                       PARENTCODE,
                       REMARK,
                       creator,
                       creationtime
                  from ASSETCATEGORY
                ```
            pageItemsToSubmit: P668_TNO
        }
        layout {
            sequence: 20
            slot: contentBody
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
            startNewRow: false
            column: 7
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    region flow-buttons (
        name: Flow Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: BEFORE_NAVIGATION_BAR
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region tree (
        name: Tree
        type: tree
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case when connect_by_isleaf = 1 then 0
                            when level = 1             then 1
                            else                           -1
                       end as status, 
                       level, 
                       AssetCategoryName as title, 
                       null as icon, 
                       tno as value, 
                       null as tooltip,
                        'javascript:$s(''P668_SELECTEDNODE'', '''||TNO||''')' as link 
                 from AssetCategory 
                start with parentcode is null
                connect by prior AssetCategorycode = parentcode
                order siblings by AssetCategoryName
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
            startNewRow: false
            column: 7
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        headerAndFooter {
            headerText: <div style="height:350px">
            footerText: </div>
        }
        settings {
            nodeLabelColumn: TITLE
            nodeValueColumn: VALUE
            hierarchy: notComputed
            nodeStatusColumn: STATUS
            hierarchyLevelColumn: LEVEL
            tooltip: databaseCol
            tooltipColumn: TOOLTIP
            activateNodeLinkWith: doubleClick
            linkColumn: LINK
            defaultIconCssClass: icon-tree-folder
        }
    )

