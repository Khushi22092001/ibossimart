    dynamicAction check-designation-name (
        name: Check Designation Name
        execution {
            sequence: 100
        }
        when {
            event: focusout
            selectionType: items
            items: P668_DESIGNATIONNAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P668_DESIGNATIONNAME")).length===0 ) {
                        showError("Designation Name Should Not Empty", 'P668_DESIGNATIONNAME');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

