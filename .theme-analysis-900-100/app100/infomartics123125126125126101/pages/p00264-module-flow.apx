    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P264_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P264_TNO,:P264_STATUS);
                itemsToSubmit: [
                    P264_TNO
                    P264_STATUS
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
