page 264 (
    name: Module Flow
    alias: MODULE-FLOW
    title: Module Flow
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        height: 1000
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region flow-condition (
        name: Flow Condition
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: MODULEFLOWCONDITION
            whereClause: TNO = :P264_TNO
            orderByClause: SNO
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
        }
        toolbar {
            controls: actionsMenu
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        heading {
            fixedTo: region
            fixedReportHeight: 200
        }
        advanced {
            savedReportMappingIdentifier: 230336179583135281
        }

        savedReport 584490 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @COLUMNCODE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @LOGICALOPERATOR
                layout {
                    width: 112.5
                    sequence: 5
                }
            )

            displayColumn (
                column: @COLUMNVALUE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 52.5
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column COLUMNCODE (
            type: popupLov
            heading {
                heading: Column
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                    DISTINCT
                    b.TableName || '.' || a.ColumnDescriptiveName as ColumnName,
                    a.ColumnCode
                    from TableColumn a, ModuleTable b
                    where a.TableName = b.TableName
                    and b.Modulecode = :P264_ModuleCode
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: P264_MODULECODE
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: COLUMNCODE
                dataType: varchar2
            }
        )

        column COLUMNVALUE (
            type: textField
            heading {
                heading: Column Value
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: COLUMNVALUE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column LOGICALOPERATOR (
            type: selectList
            heading {
                heading: Logical Operator
            }
            lov {
                type: staticValues
                staticValues: STATIC:=;=,!=;!=,<;<,<=;<=,>;>,>=;>=,IN;IN,NOT IN;NOT IN,LIKE;LIKE,NOT LIKE;NOT LIKE
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: LOGICALOPERATOR
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column SNO (
            type: textField
            heading {
                heading: Sno
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SNO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            columnFilter {
                lovType: none
            }
        )

        column TNO (
            type: textField
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P264_TNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

    )

    region module-flow (
        name: Module Flow
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.MODULECODE,
                       a.MODULEFLOWNO,
                       a.DOCUMENTSTATUSCODE,
                       a.ONPASSINGOFMODULEFLOWTNO,
                       a.ONGETTINGOFPASSMARKS,
                       a.REBOUNDFAILMARKS,
                       a.COMPANYCODE,
                       a.REMARK,
                       a.CREATOR,
                       a.COLUMNCODE,
                       a.BACKMODULEFLOWTNO,
                       a.ACTIVEDATE,
                       a.CREATIONTIME,
                       a.TTC,
                       a.SHOWONMOBILEAPPS,
                       nvl(GetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID), a.Tno), 'Status') AS Status
                  from MODULEFLOW a
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region module-flow-user (
        name: Module Flow User
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: MODULEFLOWUSER
            whereClause: TNO = :P264_TNO
            orderByClause: SNO
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 250
        }
        advanced {
            savedReportMappingIdentifier: 230337273956135292
        }

