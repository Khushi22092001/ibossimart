    pageItem P264_ONPASSINGOFMODULEFLOWTNO (
        type: popupLov
        label {
            label: On Module Flow No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                a.ModuleFlowNo d,
                a.TNo r
                from ModuleFlow a
                where 
                a.CompanyCode = :global_CompanyCode
                and not a.TNo = :P264_TNo
                AND A.ModuleCode = :P264_MODULECODE
                order by a.ModuleFlowNo
                ```
        }
        cascadingLov {
            parentItems: P264_MODULECODE
            itemsToSubmit: [
                P264_TNO
                P264_MODULECODE
            ]
        }
        layout {
            sequence: 60
            region: @module-flow
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 40
        }
        validation {
            maxLength: 255
        }
        source {
