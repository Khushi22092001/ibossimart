            column: MODULECODE
            dataType: varchar2
        }
    )

    pageItem P264_MODULEFLOWNO (
        type: numberField
        label {
            label: Module Flow No
            alignment: left
        }
        settings {
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 20
            region: @module-flow
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 40
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @module-flow
            column: MODULEFLOWNO
            dataType: number
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'MODULEFLOW'
                       and a.CodeScheme = 'AUTO'
                ```
        }
    )

