    pageItem P264_DOCUMENTSTATUSCODE (
        type: popupLov
        label {
            label: Document Status
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: Select DocumentStatusName d, DocumentStatusCode r from DocumentStatus order by 1
        }
        layout {
            sequence: 50
            region: @module-flow
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 40
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @module-flow
            column: DOCUMENTSTATUSCODE
            dataType: varchar2
        }
    )

    pageItem P264_MODULECODE (
        type: popupLov
        label {
            label: Module
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                sELECT ModuleName d, Modulecode from Module 
                where pageno != '1'
                ```
        }
        layout {
            sequence: 30
            region: @module-flow
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 40
