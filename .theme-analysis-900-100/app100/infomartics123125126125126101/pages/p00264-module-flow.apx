    region passfailbuttons (
        name: PassFailButtons
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
    )

    pageItem P264_ACTIVEDATE (
        type: hidden
        layout {
            sequence: 170
            region: @module-flow
            slot: regionBody
        }
        source {
            formRegion: @module-flow
            column: ACTIVEDATE
            dataType: date
        }
    )

