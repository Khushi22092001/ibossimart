            staticValue: NO
        }
    )

    pageItem P264_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 190
            region: @module-flow
            slot: regionBody
        }
        source {
            formRegion: @module-flow
            column: STATUS
            dataType: varchar2
            queryOnly: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P264_STATUSRIGHT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @passfailbuttons
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select B.STATUSPRIVILEGE
                  From module a, moduleprivilege b, bossuser c
                 Where a.modulecode = b.modulecode
                   And b.bossusercode = c.bossusercode
                   And c.loginname = :GLOBAL_LOGINNAME
                   And A.ENTRYPAGENO = :APP_PAGE_ID
                   AND B.COMPANYCODE = :GLOBAL_COMPANYCODE
                
                
                ```
        }
    )

    pageItem P264_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @module-flow
            slot: regionBody
        }
        source {
            formRegion: @module-flow
            column: TNO
            dataType: number
            primaryKey: true
        }
    )

    pageItem P264_TTC (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @module-flow
            slot: regionBody
        }
        source {
            formRegion: @module-flow
            column: TTC
            dataType: varchar2
        }
