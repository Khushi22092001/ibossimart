        }
        source {
            formRegion: @module-flow
            column: BACKMODULEFLOWTNO
            dataType: number
        }
    )

    pageItem P264_COLUMNCODE (
        type: popupLov
        label {
            label: Column Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                DISTINCT
                b.TableName || '.' || a.ColumnDescriptiveName as ColumnName,
                a.ColumnCode
                from TableColumn a, ModuleTable b
                where a.TableName = b.TableName
                and b.Modulecode = :P264_ModuleCode
                order by 1
                ```
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: P264_MODULECODE
            itemsToSubmit: [
                P264_TNO
                P264_MODULECODE
            ]
        }
        layout {
            sequence: 100
            region: @module-flow
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
