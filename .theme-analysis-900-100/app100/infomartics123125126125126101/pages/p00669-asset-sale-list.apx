    region asset-opening (
        name: Asset Opening
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       getlocationname(LOCATIONCODE) locationname,
                       getdoctypename(DOCTYPECODE) doctypename,
                       ASSETSALENO,
                       ASSETSALEDATE,
                       ASSETTNO,
                       getpartyname(PARTYCODE) partyname,
                       PLACCOUNTCODE,
                       SALEAMOUNT,
                       PROFITAMOUNT,
                       REMARK,
                       CREATIONTIME,
                       CREATOR,
                         '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||9993||':'||:APP_SESSION||'::::'||'P9993_TNO,P9993_REPNAME'||':'||TNO||','||'AssetSale'||':NO')||'"><span aria-label="Action"><span class="fa fa-print"  aria-hidden="true" title="Action"></span</span></a>' AS Print
                
                  from ASSETSALE
                  where ASSETSALEDATE between :P669_FROMDATE and :P669_TODATE
                  and   ( :P669_COMPANY IS NULL OR instr(':'||:P669_COMPANY||':',':'||companycode||':') > 0 )
                  --and   instr(':'||:P669_COMPANY||':',':'||companycode||':') > 0
                  and   ( :P669_LOCATION IS NULL OR instr(':'||:P669_LOCATION||':',':'||LOCATIONCODE||':') > 0 )
                  and   ( :P669_DOCTYPE IS NULL OR instr(':'||:P669_DOCTYPE||':',':'||DOCTYPECODE||':') > 0 )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
