page 126 (
    name: On The table
    alias: ON-THE-TABLE
    title: On The table
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region search (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @search-results
        }
        layout {
            sequence: 10
            slot: leftColumn
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        accessibility {
            landmarkLabel: Filters
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
            displayChartForTopNValues: 10
        }

        facet P126_MODULENAME (
            type: checkboxGroup
            label {
                label: Module Name
                showLabelForCurrentFacet: false
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: MODULENAME
            }
        )

        facet P126_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: COMPANYCODE,QUEUEDATE,MODULECODE,MENULABEL,MODULENAME,USERNAME,LOGINNAME,PASS
            }
        )

    )

    region search-results (
        name: Search Results
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.SERIALNO,
                       A.COMPANYCODE,
                       A.MODULETNO,
                       A.TOKENNO,
                       TO_CHAR(A.QUEUEDATE,'DD-MM-RRRR HH24:MI AM') AS QueueDate,
                       A.MODULECODE,
                       A.MENULABEL,
                       A.MODULENAME,
                       A.USERNAME,
                       A.LOGINNAME,
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||to_char(b.entrypageno)||':'||:APP_SESSION||'::::'||'P'||to_char(b.entrypageno)||'_TNO,P'||to_char(b.entrypageno)||'_CALLEDFROMPAGE,P'||to_char(b.entrypageno)||'_FORMSTATUS'||':'||A.MODULETNO||','||:APP_PAGE_ID||','||'CALLED'||':NO')||'"><span aria-hidden="true" class="fa fa-check-square-o"></span></a>' AS Pass
                  from ONTHETABLE_APEX a, Module b
                  where a.modulecode = b.modulecode
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        breakFormatting {
            breakColumns: col1
        }

        column COMPANYCODE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column LOGINNAME (
            reportColumnQueryId: 11
            derivedColumn: N
            type: hidden
            layout {
                sequence: 120
            }
        )

        column MENULABEL (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Transaction No
            }
            layout {
                sequence: 90
            }
        )

        column MODULECODE (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 70
            }
        )

        column MODULENAME (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Module Name
            }
            layout {
                sequence: 80
            }
        )

        column MODULETNO (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column PASS (
            reportColumnQueryId: 12
            derivedColumn: N
            heading {
                heading: Pass
            }
            layout {
                sequence: 130
            }
            security {
                escapeSpecialChars: false
            }
        )

        column QUEUEDATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Queue Date & Time
            }
            layout {
                sequence: 100
            }
        )

        column SERIALNO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column TNO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column TOKENNO (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column USERNAME (
            reportColumnQueryId: 10
            derivedColumn: N
            type: hidden
            layout {
                sequence: 110
            }
        )

    )

    button reset (
        buttonName: RESET
        label: Reset
        layout {
            sequence: 10
            region: @button-bar
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--noUI
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 126
                clearCache: 126
                action: resetRegions
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

