    dynamicAction validate-quantity-from-issue (
        name: validate quantity from Issue
        execution {
            sequence: 240
        }
        when {
            selectionType: columns
            interactiveGrid: @asset-detail
            columns: QUANTITY1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      tquantity1 number;
                    begin
                       select sum(quantity1) into tquantity1 from issuedetail a
                       where a.tno = :ISSUETNO
                         and a.itemcode = :ITEMCODE
                         and a.itemspecificationcode = :ITEMSPECIFICATIONCODE;
                        
                        if nvl(:quantity1,0) > nvl(tquantity1,0) then
                            raise_application_error(-20004, 'Quantity1 Should Not Greater Than Issued Quantity, Pl. Check');
                        end if; 
                    end;
                    ```
                itemsToSubmit: [
                    TNO
                    ISSUETNO
                    ITEMCODE
                    ITEMSPECIFICATIONCODE
                    QUANTITY1
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

