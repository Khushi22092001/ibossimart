    dynamicAction insert-into-asset-account-credit-detail (
        name: insert into asset account credit detail
        execution {
            sequence: 280
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @asset-credit-account
            columns: ACCOUNTCODE
        }
        serverSideCondition {
            type: item!=value
            item: P675_STATUS
            value: ACTIVE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                        delete from assetcreditaccountdetail where tno = :P675_TNO and sno = :sno;
                        --raise_application_error(-20000 , :P675_TNO ||'-'||:SNO ||'-'||:ACCOUNTCODE ||'-'||:global_companycode||'-'||:P675_LOCATIONCODE||'-'||:P675_ASSETDATE);
                        insert into assetcreditaccountdetail
                        (
                            TNO,
                            SNO,
                            SERIALNO,
                            VOUCHERTNO,
                            VOUCHERSNO,
                            AMOUNT,
                            REMARK
                        )
                        (
                            select :P675_TNO , :SNO, globaltno.nextval, a.tno , b.sno , abs(b.amount) , null
                            from voucher a , voucherdetail b
                            where a.tno = b.tno
                            and b.ACCOUNTCODE = :ACCOUNTCODE
                            and b.companycode = :global_companycode
                            and b.locationcode = :P675_LOCATIONCODE
                            and b.voucherdate <= :P675_ASSETDATE
                            and b.amount < 0
                        );
                        commit;
                    
                    ```
                itemsToSubmit: [
                    P675_FORMSTATUS
                    P675_TNO
                    SNO
                    P675_LOCATIONCODE
                    P675_ASSETDATE
                    ACCOUNTCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @assetcreditaccountdetail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction insert-into-asset-code-detail (
        name: Insert into asset code detail
        execution {
            sequence: 190
        }
        when {
            event: click
            selectionType: button
            button: @setcode
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    		startno number := :P675_Assetcodestartno;
                    		i number := 1;
                    		pAssetCode varchar2(30);
                    begin
                    		--go_block('CODEBLOCK');
                    		--first_record;
                            --raise_application_error(-20000 , :P675_ASSETCODESTARTNO);
                    
                            if :P675_ASSETCODESTARTNO is not null then
                    
                                delete from AssetCodeDetail where tno = :P675_TNO;
                        		loop						
                        				if :P675_AssetCodePrefix is null then
                        						pAssetCode := to_char(startno);
                        				else
                        						pAssetCode := :P675_AssetCodePrefix || '/' || to_char(startno);
                        				end if;
                    
                                        --raise_application_error(-20000 , pAssetCode);
                        				
                        				insert into AssetCodeDetail 
                        				(
                        					tno,
                        					sno,
                        					AssetCode,
                        					AssetValue,
                        					ItcAvailedAmount,
                        					DepreciatedAmount,
                        					ResidualValue,
                        					REMAININGUSEFULLIFEINMONTHS,
                        					SerialNO
                        				)
                        				values
                        				(
                        					:P675_TNO,
                        					globaltno.nextval,
                        					pAssetCode,
                        					round(:P675_AssetValue / :P675_Quantity1, 2),
                        					round(:P675_ItcAvailedAmount / :P675_Quantity1, 2),
                        					round( :P675_DepreciatedAmount / :P675_Quantity1, 2 ),
                        					:P675_RESIDUALVALUE,
                        					:P675_RemainingusefulLifeInMonths,
                        					i
                        				);
                                        
                        				if (i = :P675_Quantity1) then 
                        					exit;
                        				end if;
                        				startno := startno + 1;
                        				i := i + 1;
                        				
                        				
                        				
                        				
                        		end loop;
                            end if;
                    		
                    end;
                    ```
                itemsToSubmit: [
                    P675_TNO
                    P675_ASSETCODEPREFIX
                    P675_ASSETVALUE
                    P675_QUANTITY1
                    P675_ITCAVAILEDAMOUNT
                    P675_RESIDUALVALUE
                    P675_REMAININGUSEFULLIFEINMONTHS
                    P675_ASSETCODESTARTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @asset-code-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

