    dynamicAction set-p675-assetvalue (
        name: set P675_ASSETVALUE
        execution {
            sequence: 310
        }
        when {
            selectionType: columns
            interactiveGrid: @asset-credit-account
            columns: AMOUNT
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Assetcreditaccount").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("AMOUNT");
                    model.forEach(function(igrow,index, id) {
                    
                    meta = model.getRecordMetadata(id);
                        n_amt = parseFloat(igrow[col_amt], 10);
                    
                        if (!isNaN(n_amt) && !meta.agg) {
                            n_totamt += n_amt;
                        }
                    
                    });
                    apex.item("P675_ASSETVALUE").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

