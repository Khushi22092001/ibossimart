    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P675_Tno is null then
                        Select GlobalTno.NextVal into :P675_Tno From Dual;
                     end if;
                    ----
                    if :P675_ASSETNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P675_LocationCode,
                					:P675_DocTypeCode,
                					NULL,
                					TO_DATE(:P675_ASSETDATE, 'DD-MM-RRRR')
                				);
                        :P675_ASSETNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P675_LocationCode,
                                    :P675_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P675_ASSETDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 32763829547373140
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P675_TNO is null then
                    :P675_TNO := GlobalTNo.nextval;
                    :P675_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P675_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P675_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P675_TNO), 'Status');
                
                begin
                select TNO , voucherno into :P675_VOUCHERTNO , :P675_VOUCHERNO from voucher 
                        where moduletno = :P675_TNO;
                exception when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32763035682373140
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P675_MODULEFLOW := 'YES';
                   else
                       :P675_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P675_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P675_ONTHETABLE := 'YES' ;
                   else
                       :P675_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32763440499373140
        }
    )

