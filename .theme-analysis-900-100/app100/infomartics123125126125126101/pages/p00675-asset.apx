            type: popupLov
            heading {
                heading: Voucher no
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select a.voucherno ,a.tno 
                            from voucher a , voucherdetail b
                            where a.tno = b.tno
                            and b.ACCOUNTCODE = :P675_ACCOUNTCODE1
                            and b.companycode = :global_companycode
                            and b.locationcode = :P675_LOCATIONCODE
                            and b.voucherdate < :P675_ASSETDATE
                            and b.amount < 0
                    union all
                    select voucherno , tno from voucher    
                    where tno = :VOUCHERTNO
                    ```
                nullDisplayValue: -Select-
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    P675_ACCOUNTCODE1
                    P675_LOCATIONCODE
                    P675_ASSETDATE
                    VOUCHERTNO
                ]
                parentRequired: false
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: VOUCHERTNO
                dataType: number
            }
        )

