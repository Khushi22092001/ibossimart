    process asset-credit-account-save-interactive-grid-data (
        name: Asset Credit Account - Save Interactive Grid Data
        type: executeCode
        editableRegion: @asset-credit-account
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into ASSETCREDITACCOUNT (                 
                                    TNO,
                SNO,
                ACCOUNTCODE,
                AMOUNT,
                REMARK
                            )
                            Values (
                                :TNO,
                :SNO,
                :ACCOUNTCODE,
                :AMOUNT,
                :REMARK
                
                            );
                        
                        when 'U' then
                            update ASSETCREDITACCOUNT Set
                                  TNO=:TNO,
                SNO=:SNO,
                ACCOUNTCODE=:ACCOUNTCODE,
                AMOUNT=:AMOUNT,
                REMARK=:REMARK
                            WHERE TNO = :P675_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From ASSETCREDITACCOUNT
                            Where TNo = :P675_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 32673343228970516
        }
    )

