    process set-allowed-date (
        name: Set Allowed Date
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P675_FORMSTATUS = 'NEWRECORD' THEN 
                
                select
                		trunc(sysdate) - nvl(b.AllowedBackDays, 0) as AllowedBack,
                		trunc(sysdate) + nvl(b.AllowedForwardDays, 0) AllowedForward	
                		--a.FreezeDate
                        INTO :P675_ALLOWEDBACK,:P675_ALLOWEDFORWARD
                from Module a, ModulePrivilege b, BossUser c
                where a.ModuleCode = GetModuleCodeForpageNo(:APP_PAGE_ID)
                		and a.ModuleCode = b.ModuleCode
                		and b.BossUsercode = c.BossUserCode
                		and c.LoginName = :GLOBAL_LOGINNAME
                		and b.CompanyCode = :GLOBAL_CompanyCode
                        ;
                
                else
                     :P675_ALLOWEDBACK       := :P675_GRNDATE ; 
                    :P675_ALLOWEDFORWARD    := :P675_GRNDATE ;
                 end if;
                ```
        }
        execution {
            sequence: 100
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 81457641209608575
        }
    )

