    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @account-opening-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 67
                clearCache: 67
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
