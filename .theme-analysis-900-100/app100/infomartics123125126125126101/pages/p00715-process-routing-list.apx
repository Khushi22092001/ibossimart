page 715 (
    name: Process Routing List
    alias: PROCESS-ROUTING-LIST
    title: Process Routing List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
            overflow: auto !important;
            }
            
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region process-routing-master (
        name: Process Routing Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       PROCESSROUTINGCODE,
                       PROCESSROUTINGNAME,
                       PROCESSTYPE,
                       ITEMCLASS,
                       REMARK,
                       CREATOR,
                       to_char(CREATIONTIME,'DD-MM-YYYY HH24:MI') CREATIONTIME
                  from PROCESSROUTING
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 716
                items: {
                    P716_TNO: #TNO#
                }
                clearCache: 716
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 708161301824815975
        }

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 310
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BQ
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 300
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Y
            }
        )

        column ITEMCLASS (
            type: plainText
            heading {
                heading: Item Class
            }
            layout {
                sequence: 280
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BP
            }
        )

        column PROCESSROUTINGCODE (
            type: plainText
            heading {
                heading: Process Routing Code
            }
            layout {
                sequence: 250
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BM
            }
        )

        column PROCESSROUTINGNAME (
            type: plainText
            heading {
                heading: Process Routing Name
            }
            layout {
                sequence: 260
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BN
            }
        )

        column PROCESSTYPE (
            type: plainText
            heading {
                heading: Process Type
            }
            layout {
                sequence: 270
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BO
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 290
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 170
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Location Master
        }

        savedReport 153825 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn CREATOR (
                sequence: 5
            )

            displayColumn ITEMCLASS (
                sequence: 4
            )

            displayColumn PROCESSROUTINGCODE (
                sequence: 1
            )

            displayColumn PROCESSROUTINGNAME (
                sequence: 2
            )

            displayColumn PROCESSTYPE (
                sequence: 3
            )

            displayColumn REMARK (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @process-routing-master
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 716
                clearCache: 716
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @process-routing-master
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

