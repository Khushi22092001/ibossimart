page 302 (
    name: Cheque Book Issue List
    alias: CHEQUE-BOOK-ISSUE-LIST
    title: Cheque Book Issue List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cheque-book-issue-list (
        name: Cheque Book Issue List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.COMPANYCODE,
                       a.FINANCIALYEARCODE,
                       getlocationname(a.LOCATIONCODE) locationname,
                       getdoctypename(a.DOCTYPECODE) doctypename,
                       a.CHEQUEBOOKISSUENO,
                       a.CHEQUEBOOKISSUEDATE,
                       a.BANKCODE,
                       a.BOOKNO,
                       a.BOSSUSERCODE,
                       a.ISLOCKED,
                       a.REMARK,
                       a.CREATOR,
                       a.CREATIONTIME
                  from CHEQUEBOOKISSUE a
                  where a.CHEQUEBOOKISSUEDATE between :P302_FROMDATE and :P302_TODATE
                  and ( :P302_DOCTYPE IS NULL OR instr(':'||:P302_DOCTYPE||':',':'||a.DocTypeCode||':') > 0 ) 
                  and ( :P302_LOCATION IS NULL OR instr(':'||:P302_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                  and ( :P302_COMPANY IS NULL OR instr(':'||:P302_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 303
                items: {
                    P303_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 32242715746175969
        }

        column BANKCODE (
            type: plainText
            heading {
                heading: Bank
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column BOOKNO (
            type: plainText
            heading {
                heading: Book no
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column BOSSUSERCODE (
            type: plainText
            heading {
                heading: Boss user code
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column CHEQUEBOOKISSUEDATE (
            type: plainText
            heading {
                heading: Cheque book issue date
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column CHEQUEBOOKISSUENO (
            type: plainText
            heading {
                heading: Cheque book issue no
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation time
            }
            layout {
                sequence: 14
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: N
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column DOCTYPENAME (
            type: plainText
            heading {
                heading: Doctype
            }
            layout {
                sequence: 34
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column FINANCIALYEARCODE (
            type: plainText
            heading {
                heading: Financialyearcode
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ISLOCKED (
            type: plainText
            heading {
                heading: Is locked
            }
