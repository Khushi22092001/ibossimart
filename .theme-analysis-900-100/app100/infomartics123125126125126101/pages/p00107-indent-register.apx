        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Indent Register Report
        }

        savedReport 36976 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATIONTIME (
                sequence: 27
            )

            displayColumn CREATOR (
                sequence: 26
            )

            displayColumn DEPARTMENTNAME (
                sequence: 5
            )

            displayColumn DIFFSANCTIONANDINDENT (
                sequence: 16
            )

            displayColumn DOCSTATUS (
                sequence: 2
            )

            displayColumn DOCTYPENAME (
                sequence: 4
            )

            displayColumn INDENTDATE (
                sequence: 6
            )

            displayColumn INDENTNO (
                sequence: 7
            )

            displayColumn INDENTQUANTITY1 (
                sequence: 11
            )

            displayColumn INDENTQUANTITY2 (
                sequence: 14
            )

            displayColumn ITEMCODE (
                sequence: 8
            )

            displayColumn LOCATIONNAME (
                sequence: 3
            )

            displayColumn MATERIAL (
                sequence: 9
            )

            displayColumn PARTYNAME (
                sequence: 21
            )

            displayColumn POQUANTITY1 (
                sequence: 22
            )

            displayColumn POSTATUS (
                sequence: 18
            )

            displayColumn PRINT (
                sequence: 1
            )

            displayColumn PURCHASEORDERDATE (
                sequence: 20
            )

            displayColumn PURCHASEORDERNO (
                sequence: 19
            )

            displayColumn PURPOSE (
                sequence: 17
            )

            displayColumn REMARK (
                sequence: 25
            )

            displayColumn SANCTIONQUANTITY1 (
                sequence: 12
            )

            displayColumn SANCTIONQUANTITY2 (
                sequence: 15
            )

            displayColumn UOM1 (
                sequence: 10
            )

            displayColumn UOM2 (
                sequence: 13
            )

            displayColumn VARIANCE1 (
                sequence: 23
            )

            displayColumn VARIANCE2 (
                sequence: 24
            )

            sort (
                column: INDENTDATE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: DEPARTMENTNAME
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: INDENTQUANTITY1
            )

            aggregate (
                column: SANCTIONQUANTITY
            )

            aggregate (
                column: POQUANTITY
            )

            aggregate (
                column: SANCTIONQUANTITY1
            )

            aggregate (
                column: INDENTQUANTITY2
            )

            aggregate (
                column: SANCTIONQUANTITY2
            )

            aggregate (
                column: DIFFSANCTIONANDINDENT
            )

            aggregate (
                column: POQUANTITY1
            )

            aggregate (
                column: VARIANCE1
            )

            aggregate (
                column: VARIANCE2
            )

            highlight ir-condition (
                name: Short
                condition {
                    column: DIFFSANCTIONANDINDENT
                    operator: >
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FF2946
                    text: #FFFFFF
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: Equal
                condition {
                    column: DIFFSANCTIONANDINDENT
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #4AFF7A
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Excess Sanction
                condition {
                    column: DIFFSANCTIONANDINDENT
                    operator: <
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FF24FF
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    pageItem P107_BIREPORTURL (
        type: hidden
