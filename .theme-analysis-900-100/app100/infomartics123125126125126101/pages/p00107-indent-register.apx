            type: sqlQuery
            sqlQuery:
                ```sql
                Select IndentNo 
                From Indent 
                Where instr(':'||:P107_LOCATION||':',':'||LocationCode||':') > 0
                  and indentDate Between :P107_FROMDATE and :P107_TODATE
                Order by 1
