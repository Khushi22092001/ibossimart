    dynamicAction check-measuring-unit-name (
        name: Check Measuring Unit name
        execution {
            sequence: 110
        }
        when {
            event: focusout
            selectionType: items
            items: P51_MEASURINGUNITNAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P51_MEASURINGUNITNAME")).length===0 ) {
                        showError("Measuring Unit Name Should Not be Empty", 'P51_MEASURINGUNITNAME');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P51_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
        execution {
            sequence: 90
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @print
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.PRINTPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @print
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.PRINTPRIVILEGE= 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-save-button-for-updateprivillege (
        name: DISABLE SAVE BUTTON FOR UPDATEPRIVILLEGE
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @save
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1 FROM MODULEFLOW A , MODULEFLOWUSER B , bossuser C
                    WHERE A.TNO = B.TNO
                    AND A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                    AND B.BOSSUSERCODE = C.BOSSUSERCODE
                    AND C.BOSSUSERNAME = :APP_USER
                    AND B.UPDATEPRIVILEGE = 'NO'
                    UNION ALL
                    Select 1
                      From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.UPDATEPRIVILEGE = 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @save
            }
            execution {
                sequence: 50
            }
            serverSideCondition {
                type: item=value
                item: P51_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @save
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1 FROM MODULEFLOW A , MODULEFLOWUSER B , bossuser C
                    WHERE A.TNO = B.TNO
                    AND A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                    AND B.BOSSUSERCODE = C.BOSSUSERCODE
                    AND C.BOSSUSERNAME = :APP_USER
                    AND B.UPDATEPRIVILEGE = 'YES'
                    UNION ALL
                    Select 1
                      From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.UPDATEPRIVILEGE = 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-status-button (
        name: Disable Status Button
        execution {
            sequence: 80
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
