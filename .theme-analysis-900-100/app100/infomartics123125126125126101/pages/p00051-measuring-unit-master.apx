page 51 (
    name: Measuring Unit Master
    alias: MEASURING-UNIT-MASTER
    title: Measuring Unit Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region measuring-unit-master (
        name: Measuring Unit Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       MEASURINGUNITCODE,
                       MEASURINGUNITNAME,
                       DECIMALPLACE,
                       DATECRATED,
                       DATEMODIFY,
                       ISWEIGHMENTREQUIRED,
                       DIVISORFACTOR,
                       MULTIPLYINGFACTOR,
                       GSTUQCCODE,
                       FORMANPOWER,
                       REMARK,
                       CREATIONTIME,
                       CREATOR
                  from MEASURINGUNIT
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P51_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P51_CREATIONTIME (
        type: datePicker
        label {
            label: Creation Time
            alignment: left
        }
        settings {
            showTime: true
        }
        layout {
            sequence: 150
            region: @measuring-unit-master
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH:MIPM
            width: 32
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @measuring-unit-master
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MM-YYYY HH24:MI:SS') from dual
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P51_MEASURINGUNITCODE
        }
    )

    pageItem P51_CREATOR (
        type: textField
        label {
            label: Creator
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 140
            region: @measuring-unit-master
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @measuring-unit-master
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select :GLOBAL_LOGINNAME from Dual
        }
    )

