    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P51_TNO is null then
                            :P51_FORMSTATUS := 'NEWRECORD';
                        else
                            :P51_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P51_TNO is null then
                
                        select globaltno.nextval into :P51_TNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 139565032414941930
        }
    )

    process get-measuring-unit-code (
        name: Get Measuring Unit Code
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'MEASURINGUNIT';
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P51_MEASURINGUNITCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P51_MEASURINGUNITCODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 139612858439122292
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P51_MODULEFLOW := 'YES';
                   else
                       :P51_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P51_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P51_ONTHETABLE := 'YES' ;
                   else
                       :P51_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 139565357888943115
        }
    )

