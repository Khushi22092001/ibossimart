    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P51_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
