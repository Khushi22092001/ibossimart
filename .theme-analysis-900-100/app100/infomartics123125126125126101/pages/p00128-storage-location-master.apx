        source {
            formRegion: @storage-location-master
            column: STORAGELOCATIONCODE
            dataType: varchar2
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'STORAGELOCATION'
                       and a.CodeScheme = 'AUTO'
                ```
        }
    )

