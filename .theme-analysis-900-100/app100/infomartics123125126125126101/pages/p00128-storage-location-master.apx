page 128 (
    name: Storage Location Master
    alias: STORAGE-LOCATION-MASTER
    title: Storage Location Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 950
        height: 300
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region storage-location-master (
        name: Storage Location Master
        type: form
        source {
            location: localDatabase
            tableName: STORAGELOCATION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P128_ALLOCATIONINCCINVOICEALLOWED (
        type: checkbox
        label {
            label: Allocation In cc Invoice Allowed
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: YES
            uncheckedValue: NO
        }
        layout {
            sequence: 110
            region: @storage-location-master
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @storage-location-master
            column: ALLOCATIONINCCINVOICEALLOWED
            dataType: varchar2
        }
    )

    pageItem P128_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P128_CREATOR (
        type: textField
        label {
            label: Creator
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @storage-location-master
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @storage-location-master
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select :GLOBAL_LOGINNAME from Dual
        }
