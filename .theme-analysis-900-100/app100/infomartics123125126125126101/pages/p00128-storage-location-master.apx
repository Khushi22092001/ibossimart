    process check-delete-validation (
        name: check delete validation
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                    pstatus varchar2(30);
                begin
                    select getdocumentstatuscode('PARTY',TNO) into pstatus from party 
                    where partyshortname = :P128_STORAGELOCATIONcode;
                    if pstatus = 'ACTIVE' then 
                        raise_application_error(-20000,'Party is ACTIVE. Cannot Delete.');
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 17261832620499829
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

