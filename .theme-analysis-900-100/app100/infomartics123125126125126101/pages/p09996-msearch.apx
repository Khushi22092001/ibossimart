page 9996 (
    name: Module Search
    alias: MSEARCH
    title: Module Search
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        height: 700
        resizable: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline: .ui-dialog-titlebar-close {display:block !important;}
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
