    pageItem P9996_MODULESEARCH (
        type: popupLov
        label {
            label: Module&nbsp
            alignment: left
        }
        settings {
            fetchOnSearch: true
            popupWidth: 400
            popupHeight: 400
            additionalOutputs: PAGENO:P9996_PAGENO
        }
        lov {
            type: sharedComponent
            lov: @p9994-module
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P9996_PAGENO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @new
            slot: regionBody
        }
    )

    button close (
        buttonName: Close
        label: Close
        layout {
            sequence: 10
            slot: contentBody
            startNewRow: false
            column: 12
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--danger
                t-Button--pillStart
                t-Button--padLeft
                t-Button--padRight
            ]
            icon: fa-window-close
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button go (
        buttonName: Go
        label: Go
        layout {
            sequence: 40
            region: @new
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--success
                t-Button--pillStart
                t-Button--padRight
            ]
            icon: fa-traffic-light-go
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @close
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @go
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @close
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P9996_PAGENO
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @close
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNull
                item: P9996_PAGENO
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @go
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P9996_PAGENO
            }
        )

    )

    dynamicAction open-module (
        name: Open Module_1
        execution {
            sequence: 10
        }
        when {
            event: focusout
            selectionType: items
            items: P9996_MODULESEARCH
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P9996_MODULESEARCH
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //alert('fired');
                    var x = apex.item('P9996_PAGENO').getValue();
                    
                    
                    var url = "f?p=#APP_ID#:#PAGENO#:#SESSION#::NO:RP:";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#PAGENO#", x);
                    
                    
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
