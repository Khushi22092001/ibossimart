    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P622_Tno is null then
                        Select GlobalTno.NextVal into :P622_Tno From Dual;
                     end if;
                    ----
                    if :P622_EMPLOYEESALARYNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P622_LocationCode,
                					:P622_DocTypeCode,
                					NULL,
                					TO_DATE(:P622_EMPLOYEESALARYDATE, 'DD-MM-RRRR')
                				);
                        :P622_EMPLOYEESALARYNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P622_LocationCode,
                                    :P622_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P622_EMPLOYEESALARYDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16202609142090360
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P622_TNO is null then
                    :P622_TNO := GlobalTNo.nextval;
                    :P622_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P622_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P622_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P622_TNO), 'Status');
                
                --- Delete Unsaved Data
                -- delete from EMPLOYEESALARYDETAIL a
                --     where not exists (
                --         select 1 from EMPLOYEESALARY aa  
                --         where aa.tno = a.tno
                --     );
                -----
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16201470289087286
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P622_MODULEFLOW := 'YES';
                   else
                       :P622_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P622_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P622_ONTHETABLE := 'YES' ;
                   else
                       :P622_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16201748083088122
        }
    )

