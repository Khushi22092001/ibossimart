        column SALARYHEADCODE (
            type: popupLov
            heading {
                heading: Salary Head
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    
                    Select 
                    a.SALARYHEADNAME,
                    a.SALARYHEADCODE--,
                    
                    --a.SALARYHEADSHORTNAME,
                    --b.ManualEntryNo
                    from Salaryhead a, SalarySchemeDetail b, SalaryScheme c
                    where a.SalaryHeadCode =  b.SalaryHeadCode
                    and b.TNO = c.TNo
                    and c.SalarySchemeCode = :P622_SalarySchemeCode
                    --and :P622_FORMSTATUS = 'EDITRECORD'
                    order by 1
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: P622_SALARYSCHEMECODE
            }
            layout {
