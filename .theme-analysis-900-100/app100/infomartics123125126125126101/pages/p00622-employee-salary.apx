        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var index = $('#SERIALNO').val();
                    
                    var model = this.data.model;
                    
                    var meta = model.getRecordMetadata(this.data.recordId);
                    
                    if ( meta.inserted && !meta.updated ) {
                    
                    
                        index =  $v("P622_NEXT_SERIALNO");
                    
                        index +++ 1;
                    
                        $s("P622_NEXT_SERIALNO", index);
                    
                        $s("SERIALNO",index );
                    
                    
                    }
                    
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

