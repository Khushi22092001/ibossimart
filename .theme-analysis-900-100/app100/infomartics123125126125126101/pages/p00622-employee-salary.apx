    region employee-salary (
        name: EMPLOYEE SALARY
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.LOCATIONCODE,
                       a.DOCTYPECODE,
                       a.COMPANYCODE,
                       a.FINANCIALYEARCODE,
                       a.EMPLOYEESALARYNO,
                       a.EMPLOYEESALARYDATE,
                       a.EFFECTIVEDATE,
                       a.EMPLOYEECODE,
                       a.DESIGNATIONCODE,
                       a.SALARYSCHEMECODE,
                       a.WEEKLYOFFDAY,
                       a.OTATTENDENCEHEADCODE,
                       a.LEAVESCHEMECODE,
                       a.ATTENDENCESCHEMECODE,
                       a.REMARK,
                       a.SALARYSLIPSCHEMECODE,
                       a.MODULECODE,
                       a.MODULETNO,
                       a.CREATOR,
                       a.DATEOFENTRY,
                       a.ENTRYDATE,
                       NVL(getdocumentstatuscode(getmodulecodeforpageno(:APP_PAGE_ID),A.TNO),'STATUS') AS STATUS
                  from EMPLOYEESALARY a
                ```
        }
