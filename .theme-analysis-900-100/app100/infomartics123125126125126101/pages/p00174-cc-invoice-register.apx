                P174_DOCTYPE
                P174_ITEM
                P174_CCINO
                P174_ITEMSPECIFICATION
                P174_ITEMGROUP
                P174_VEHICLENO
                P174_AGENTCODE
                P174_TRADETYPE
                P174_BIREPORTURL
                P174_TNO
            ]
        }
