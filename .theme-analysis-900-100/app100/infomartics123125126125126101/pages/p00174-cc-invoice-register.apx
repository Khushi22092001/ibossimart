    pageItem P174_CCINO (
        type: textFieldWithAutocomplete
        label {
            label: Invoice No
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select CCInvoiceNo 
                From CCInvoice 
                Where instr(':'||:P174_LOCATION||':',':'||LocationCode||':') > 0
                  and CCInvoiceDate Between :P174_FROMDATE and :P174_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P174_LOCATION
            itemsToSubmit: P174_CCINO
        }
        layout {
            sequence: 110
            region: @cc-invoice-register
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 28
            valuePlaceholder: Enter CCInvoice No
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P174_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'CCINVOICE'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                 and getcompanyprivilege(C.COMPANYCODE,GETMODULECODEFORPAGENO(:APP_PAGE_ID),:GLOBAL_LOGINNAME)='YES'
                Order by 1
                  ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @cc-invoice-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Company Name
        }
    )

    pageItem P174_CONSIGNEE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Consignee
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       Distinct
                       p.PartyName d,
                       p.PartyCode r
                From ccinvoice a, Party p
                Where a.ConsigneeCode = p.PartyCode
                Order by 1
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 70
            region: @cc-invoice-register
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
