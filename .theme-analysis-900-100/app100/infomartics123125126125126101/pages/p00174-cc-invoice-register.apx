        }
    )

    pageItem P174_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: DocType
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      dt.DocTypeName d,
                      dt.DocTypeCode r
                From  ModulePrivilege a, ModulePrivilegeDocType b, DocType dt, BossUser bu, ModuleDocType md, ModuleDocTypeDetail mdd
                Where a.TNo = b.TNo(+)
                  and (b.DocTypeCode = dt.DocTypeCode or b.DocTypeCode is null)
                  and a.ModuleCode = md.ModuleCode
                  and md.TNo = mdd.TNo
                  and mdd.DocTypeCode = dt.DocTypeCode
                  and a.ModuleCode = 'CCINVOICE'
                  and a.ViewPrivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order by 1
                ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @cc-invoice-register
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter DocType Name
        }
    )

