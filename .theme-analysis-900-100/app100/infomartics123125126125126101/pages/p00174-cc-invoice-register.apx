            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /*javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/ccinvoiceregister.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P174_COMPANY.","_paramsP_LOCATION":"&P174_LOCATION.","_paramsP_FROMDATE":"&P174_FROMDATE.","_paramsP_TODATE":"&P174_TODATE.","_paramsP_DOCTYPE":"&P174_DOCTYPE.","_paramsP_STATUS":"&P174_STATUS.","_paramsP_ITEM":"&P174_ITEM.","_paramsP_ITEMSPECIFICATION":"&P174_ITEMSPECIFICATION.","_paramsP_TRANSPORTER":"&P174_TRANSPORTER.","_paramsP_PARTY":"&P174_PARTY.","_paramsP_VEHICLENO":"&P174_VEHICLENO.","_paramsP_CCINO":"&P174_CCINO."}');
