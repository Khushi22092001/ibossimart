    region detail-footer (
        name: Detail Footer
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       a.TNO,
                       a.SNO,
                       a.SN,
                       a.SERIALNO,
                       a.FOOTERHEADCODE,
                       a.FOOTERPERCENT,
                       a.FOOTERVALUE,
                       a.LEGENDSCODE , 
                       b.includewithtaxableamount
                  from creditnotedetailfooter a , footerhead b
                  Where a.TNo = :P166_TNO
                    and a.sno = :P166_SNO
                    and a.footerheadcode = b.footerheadcode
                ```
            pageItemsToSubmit: [
                P166_TNO
                P166_SNO
            ]
        }
