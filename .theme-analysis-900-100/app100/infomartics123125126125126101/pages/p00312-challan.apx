    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P312_Tno is null then
                        Select GlobalTno.NextVal into :P312_Tno From Dual;
                     end if;
                    ----
                    if :P312_CHALLANNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P312_LocationCode,
                					:P312_DocTypeCode,
                					NULL,
                					TO_DATE(:P312_CHALLANDATE, 'DD-MM-RRRR')
                				);
                        :P312_CHALLANNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P312_LocationCode,
                                    :P312_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P312_CHALLANDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 21557727849854818
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P312_TNO is null then
                    :P312_TNO := GlobalTNo.nextval;
                    :P312_FORMSTATUS := 'NEWRECORD';
                   
                  
                else
                    :P312_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P312_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P312_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21527765774821314
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P312_MODULEFLOW := 'YES';
                   else
                       :P312_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P312_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P312_ONTHETABLE := 'YES' ;
                   else
                       :P312_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21528016649822242
        }
    )

