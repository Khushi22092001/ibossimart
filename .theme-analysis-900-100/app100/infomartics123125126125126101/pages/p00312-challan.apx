    )

    pageItem P312_DOCTYPECODE (
        type: popupLov
        label {
            label: Doctype
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.DocTypeName as d,
                	a.DocTypeCode as r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c, Module d
                where a.DocTypeCode = b.DocTypeCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode
                    and c.CompanyCode = :global_CompanyCode
                    and d.EntryPageNo = :APP_PAGE_ID
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @challan
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @challan
            column: DOCTYPECODE
            dataType: varchar2
        }
    )

