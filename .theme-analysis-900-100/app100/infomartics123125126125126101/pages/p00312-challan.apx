page 312 (
    name: Challan
    alias: CHALLAN
    title: Challan
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region challan (
        name: Challan
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ACCOUNTCODE,
                       CHALLANAMOUNT,
                       CHALLANDATE,
                       CHALLANNO,
                       COMPANYCODE,
                       DOCTYPECODE,
                       FINANCIALYEARCODE,
                       FROMDATE,
                       LOCATIONCODE,
                       MONEYTRANSFERMODECODE,
                       MONEYTRANSFERREFERENCEDATE,
                       MONEYTRANSFERREFERENCENO,
                       PAYMENTDONE,
                       REMARK,
                       TNO,
                       TODATE,
                       DEPOSITEDINBANKCODE,
                       DEPOSITORCODE,
                       NARRATION,
                       COVERINGLETTERNO,
                       TAXSECTIONCODE,
                       CREATOR,
                       MODULECODE,
                       MODULETNO,
                       FILENAME,
                       CREATIONTIME
                  from CHALLAN
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region challan-account-detail (
        name: Challan Account Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       ACCOUNTCODE,
                       AMOUNT,
                       REMARK,
                       SERIALNO,
                       SNO,
                       TNO
                  from CHALLANACCOUNTDETAIL
                  where tno = :P312_TNO
                ```
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 20954480072943827
        }

        savedReport 215864 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ACCOUNTCODE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @AMOUNT
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @SERIALNO
                layout {
                    show: false
                    sequence: 6
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 7
                }
            )

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 8
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column ACCOUNTCODE (
            type: popupLov
            heading {
                heading: Account
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                    	distinct
                    	c.PartyName as ParentName,
                    	b.ParentCode
                    from Location a, (
                    	select
                    		aa.PartyCode as partyCode,
                    		aa.PartyName as AccountName,
                    		aa.ParentCode
                    	from Party aa
                    	where aa.PartyTypeCode = 'ACCOUNT'
                    	start with aa.PartyCode = 'TDSALLPLA'
                    	connect by prior aa.PartyCode = aa.ParentCode
                    ) b, Party c
                    where a.IsDivision = 'YES'
                    		and b.ParentCode = c.PartyCode
                    order by 1, 2
                    
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ACCOUNTCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column AMOUNT (
            type: numberField
            heading {
                heading: Amount
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: AMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column REMARK (
            type: textField
            heading {
                heading: Remark
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SERIALNO (
            type: numberField
            heading {
                heading: Serialno
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: SERIALNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SNO (
            type: numberField
