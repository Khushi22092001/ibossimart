    process send-pass-fail (
        name: "Send Pass Fail "
        type: executeCode
        source {
            plsqlCode: sendpassfailforward(getModuleCodeForPageNo(:APP_PAGE_ID) , :P312_TNO, :P312_CHALLANNO||' :', :GLOBAL_COMPANYCODE);
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 21558005038855879
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        name: Go To Page 311
