                columnAlignment: end
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TNO (
            type: numberField
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P312_TNO
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

