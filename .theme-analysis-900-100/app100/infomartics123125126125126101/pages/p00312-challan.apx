                type: item=value
                item: P312_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P312_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P312_TNO,:P312_STATUS);
                    
                    declare
                        tpaymentadvice number;
                    
                    begin
                        SELECT COUNT(A.TNO) INTO tpaymentadvice
                    	FROM PAYMENTADVICE A
                    	WHERE A.MODULETNO = :P312_TNO ;
                    
                        if nvl(tpaymentadvice, 0) = 0 then
                            if :P312_STATUS = 'ACTIVE' then
                            
                                CREATEPAYMENTADVICEFORPO(:P312_TNO);
                            end if;
                    
                        end if;
                    --- 06-aug-2024
                        if :P312_STATUS = 'ACTIVE' and :P312_DOCTYPECODE = 'TRADINGPURCHASE' then
                            createindentfromPO(:P312_TNO);
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P312_TNO
                    P312_STATUS
                    P312_INDENTTNO
                    P312_DOCTYPECODE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
