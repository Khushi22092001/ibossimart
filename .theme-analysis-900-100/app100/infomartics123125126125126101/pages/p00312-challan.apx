    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                                 if :P312_STATUS = 'ACTIVE' then
                            
                                    CREATEPAYMENTADVICEFORPO(:P312_TNO);
                    
                                  end if;
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P312_TNO
                    P312_COMPANYCODE
                    P312_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P312_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-pf-detail (
        name: set PF Detail
        execution {
            sequence: 150
        }
        when {
            event: click
            selectionType: button
            button: @pendingpfchallan
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from challandetail where tno = :P312_TNO;
                    
                    for vAccount
                    		in (
                    				select
                    						c.PartyName as ParentName,
                    						b.ParentCode,
                    						--b.AccountName,
                    						b.PartyName as AccountName,
                    						--b.AccountCode,
                    						y.AccountCode,
                    						a.LocationCode,
                    						a.LocationName,
                    						sum(y.Amount) as Amount
                    				from Voucher x, VoucherDetail y, PFChallan z, Location a, Party b,
                    						/*(
                    						select
                    								aa.PartyCode as AccountCode,
                    								aa.PartyName as AccountName,
                    								aa.ParentCode
                    						from Party aa
                    						where aa.PartyTypeCode = 'ACCOUNT'
                    						start with aa.PartyCode = 'PROVISIONS'
                    						connect by prior aa.PartyCode = aa.ParentCode
                    						) b, */
                    						Party c										
                    				where x.Tno = y.Tno
                    						and x.ModuleTNo = z.TNo
                    						and y.Amount > 0
                    						and y.CompanyCode = :global_CompanyCode												
                    						and z.Tno = :P312_ModuleTno
                    						and :P312_ModuleCode = 'PFCHALLAN'
                    						--
                    						and y.LocationCode = a.LocationCode
                    						--and y.AccountCode = b.AccountCode
                    						--and b.ParentCode = c.PartyCode
                    						and y.AccountCode = b.PartyCode
                    						and b.ParentCode = c.PartyCode
                    						--
                    				group by												
                    						c.PartyName,
                    						b.ParentCode,
                    						b.PartyName,
                    						y.AccountCode,
                    						a.LocationCode,
                    						a.LocationName
                    				UNION ALL
                    				Select
                    						e.PartyName as ParentName,
                    						d.ParentCode,
                    						d.PartyName as AccountName,
                    						c.AccountCode,
                    						a.LocationCode as LocationCode,
                    						g.LocationName as LocationName,
                    						sum(b.SalaryHeadAmount) as Amount
                    				From Salary a, SalaryDetail b, SalaryHeadAccount c, Party d, Party e, Location g 					
                    				Where a.Tno = b.Tno
                    						and b.SalaryHeadCode = 'PFEMPLOYEECONTRIBUTION'
                    						and b.SalaryHeadCode = c.SalaryHeadCode
                    						and c.AccountCode = d.PartyCode
                    						And getemployeestafftypecode(a.employeecode,a.salaryfromdate) = c.stafftypecode
                    						and a.SalaryFromDate = :P312_FromDate
                    						and a.SalaryToDate = :P312_ToDate
                    						and d.ParentCode = e.PartyCode
                    						and a.LocationCode = g.LocationCode
                    						and nvl(b.SalaryHeadAmount, 0) > 0
                    				Group by
                    						e.PartyName,
                    						d.ParentCode,
                    						d.PartyName,
                    						c.AccountCode,
                    						a.LocationCode,
                    						g.LocationName
                    				order by 1, 3
                    		)
                    loop
                    		
                    		
                               insert into challandetail
                            (
                                tno,
                                sno,
                                AccountCode ,
                    		    LocationCode ,
                    		    Amount
                            )
                            values
                            (
                                :P312_TNO,
                                globaltno.nextval,
                                vAccount.AccountCode,
                    		    vAccount.LocationCode,
                    		    vAccount.Amount
                            );
                    
                    end loop;
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

