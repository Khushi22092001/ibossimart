    pageItem P312_LOCATIONCODE (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.LocationName as d,
                	a.LocationCode as r
                from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                	and c.CompanyCode = :global_CompanyCode
                    and d.EntryPageNo = :APP_PAGE_ID
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @challan
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @challan
            column: LOCATIONCODE
            dataType: varchar2
        }
    )

