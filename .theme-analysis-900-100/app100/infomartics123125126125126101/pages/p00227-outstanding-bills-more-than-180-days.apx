                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn VOUCHERDATE (
                sequence: 7
            )

            displayColumn VOUCHERNO (
                sequence: 6
            )

            aggregate (
                column: PENDINGAMT
            )

            aggregate (
                column: BALANCEAMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region outstanding-bills-more-than-180-days-2 (
        name: Outstanding Bills More Than 180 Days
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: Creditors Aging Detail Report
            regionDisplaySelector: true
        }
    )

    pageItem P227_ACCOUNTGROUP (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Account Group
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName as d ,
                a.PartyCode as r
                from Party a   
                where a.PartyTypeCode = 'ACCOUNTGROUP'
                order by 1
                ```
        }
        layout {
            sequence: 120
            region: @outstanding-bills-more-than-180-days-2
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P227_ASONDATE (
        type: datePickerJquery
        label {
            label: As On Date
            alignment: left
        }
        settings {
            show: both
            navigationListFor: monthAndYear
        }
        layout {
            sequence: 20
            region: @outstanding-bills-more-than-180-days-2
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 15
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P227_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
