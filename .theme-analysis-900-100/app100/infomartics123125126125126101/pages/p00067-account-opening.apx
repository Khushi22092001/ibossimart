    dynamicAction calculate-opening-amount (
        name: calculate opening amount
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P67_BALANCETYPE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                     if :P67_BALANCETYPE = 'Dr' then
                              :P67_OPENINGAMOUNT := :P67_OPENINGAMOUNT_TEMP * (-1);
                        else
                            :P67_OPENINGAMOUNT := :P67_OPENINGAMOUNT_TEMP;
                        end if;
                    ```
                itemsToSubmit: [
                    P67_BALANCETYPE
                    P67_OPENINGAMOUNT_TEMP
                ]
                itemsToReturn: P67_OPENINGAMOUNT
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

