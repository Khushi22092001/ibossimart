    process getaccountopening (
        name: GetAccountOpening
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P67_TNO is not null then
                
                    :P67_FORMSTATUS := 'EDITRECORD';
                
                    select openingamount into :P67_OPENINGAMOUNT_TEMP from accountopening
                    where tno = :P67_TNO; 
                    if :P67_OPENINGAMOUNT_TEMP < 0 then
                        :P67_OPENINGAMOUNT_TEMP := :P67_OPENINGAMOUNT_TEMP*(-1);
                        :P67_BALANCETYPE := 'Dr';
                    else
                        :P67_BALANCETYPE := 'Cr';
                    end if;
                
                else
                    :P67_FORMSTATUS := 'NEWRECORD';
                    
                end if;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 140401224481239678
        }
    )

    process getdocno (
        name: getdocno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'ACCOUNTOPENING' ; --GetModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P67_Tno is null then
                        Select GlobalTno.NextVal into :P67_Tno From Dual;
                    end if;
                    ----
                    if :P67_AccountOpeningNo is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P67_LocationCode,
                					:P67_DocTypeCode,
                					NULL,
                					TO_DATE(:P67_AccountOpeningDate, 'DD-MM-RRRR')
                				);
                        :P67_AccountOpeningNo := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P67_LocationCode,
                                    :P67_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P67_AccountOpeningDate, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 140399682106239677
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P67_MODULEFLOW := 'YES';
                   else
                       :P67_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P67_ONTHETABLE := 'YES' ;
                   else
                       :P67_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 140401695980239678
        }
    )

