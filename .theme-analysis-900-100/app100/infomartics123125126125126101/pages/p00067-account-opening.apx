    process insert-validation (
        name: "insert validation "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                   TMP NUMBER;
                   TMP2 NUMBER;
                BEGIN
                     IF :P67_STATENAME IS NOT NULL THEN
                			select 
                					count(*) into tmp 
                			from state a
                			where Translate(
                					upper(a.StateName),
                					'A!@#$%^&*()_+|-=\;<>?,./ ',
                					'A'
                			) = Translate(
                					upper(:P67_STATENAME),
                					'A!@#$%^&*()_+|-=\;<>?,./ ',
                					'A'
                			)
                			AND (A.TNO != :P67_TNO OR :P67_TNO IS NULL)
                		;
                		if tmp > 0 then
                        APEX_ERROR.ADD_ERROR(P_MESSAGE=> 'StateName already found in Database',
                            p_display_location => apex_error.c_inline_in_notification) ;
                
                     elsif  :P67_STATESHORTNAME IS NOT NULL THEN
                			select 
                					count(*) into tmp2 
                			from state a
                			where Translate(
                					upper(a.StateShortName),
                					'A!@#$%^&*()_+|-=\;<>?,./ ',
                					'A'
                			) = Translate(
                					upper(:P67_STATESHORTNAME),
                					'A!@#$%^&*()_+|-=\;<>?,./ ',
                					'A'
                			)
                			AND (A.TNO != :P67_TNO OR :P67_TNO IS NULL)
                		;
                		if tmp2 > 0 then
                        APEX_ERROR.ADD_ERROR(P_MESSAGE=> 'StateShortName already found in Database',
                            p_display_location => apex_error.c_inline_in_notification) ;
                		end if;	
                     end if;
                     end if;
                END ;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 140400017018239677
        }
        serverSideCondition {
            whenButtonPressed: @create
            type: never
        }
    )

    process prepare-url (
        name: PREPARE_URL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   result varchar2(2000);
                begin
                   result:=apex_util.prepare_url(apex_application.g_x01);
                   apex_json.open_object;
                   apex_json.write('success', true);
                   apex_json.write('url', result);
                   apex_json.close_object;
                exception
                 when others then
                   apex_json.open_object;
                   apex_json.write('success', false);
                   apex_json.write('message', sqlerrm);
                   apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 60
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 140402409321239678
        }
    )

