page 67 (
    name: Account Opening
    alias: ACCOUNT-OPENING
    title: Account Opening
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 950
        height: 380
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            .Mandatory .t-Form-label{
                color: #720606;
            }
            
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region account-opening (
        name: Account Opening
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       ACCOUNTOPENINGNO,
                       ACCOUNTOPENINGDATE,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       ACCOUNTCODE,
                       OPENINGAMOUNT,
                       REMARK,
                       MODULECODE,
                       MODULETNO,
                       CREATOR,
                       JOBTYPECODE,
                       ITEMCODE,
                       BILLNO,
                       BILLDATE,
                       BILLAMOUNT,
                       EXCISEDOCTYPECODE,
                       PAIDAMOUNT,
                       DEDUCTEDAMOUNT,
                       DESPATCHCATEGORYCODE,
                       CREATIONDATE,
                       AGENTCODE,
                       MODULESNO,
                       BILLDUEDATE,
                       BILLQUANTITY1,
                       CREATIONTIME,
                       CONSIGNEECODE,
                       NVL(getdocumentstatuscode('ACCOUNTOPENING',TNO),'STATUS') AS Status
                  from ACCOUNTOPENING 
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region commonfields (
        name: CommonFields
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    pageItem P67_ACCOUNTCODE (
        type: popupLov
        label {
            label: Account Name
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery: select partyname , partycode from party
            displayNullValue: false
        }
        layout {
            sequence: 200
            region: @account-opening
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @account-opening
            column: ACCOUNTCODE
            dataType: varchar2
        }
    )

    pageItem P67_ACCOUNTOPENINGDATE (
        type: datePicker
        label {
            label: Opening Date
            alignment: left
        }
        layout {
            sequence: 150
            region: @account-opening
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            formatMask: DD-MM-RRRR
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @account-opening
            column: ACCOUNTOPENINGDATE
            dataType: date
        }
        default {
            type: item
            item: GLOBAL_FINANCIALYEARBEGIN
        }
    )

    pageItem P67_ACCOUNTOPENINGNO (
        type: textField
        label {
            label: Opening No
            alignment: left
        }
        layout {
            sequence: 160
            region: @account-opening
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @account-opening
            column: ACCOUNTOPENINGNO
            dataType: varchar2
        }
    )

