page 81 (
    name: BOSS User Master
    alias: BOSS-USER-MASTER
    title: BOSS User Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region boss-user-master (
        name: BOSS User Master
        type: form
        source {
            location: localDatabase
            tableName: BOSSUSER
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.COMPANYCODE,
                       A.BOSSUSERROLECODE,
                       A.ISDEFAULT,
                       A.SNO
                  from BOSSUSERROLE A
                  WHERE A.TNO = :P81_TNO
                ```
            pageItemsToSubmit: P81_TNO
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 144099492111480305
        }

        savedReport 1442187 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @COMPANYCODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @BOSSUSERROLECODE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ISDEFAULT
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column BOSSUSERROLECODE (
            type: textField
            heading {
                heading: Boss User Role
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: BOSSUSERROLECODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            advanced {
                customAttributes: readonly=true
            }
        )

        column COMPANYCODE (
            type: popupLov
            heading {
                heading: Company
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select 
                            A.CompanyName, 
                            A.CompanyCode 
                            from Company A 
                            Order By A.Tno DESC
                    ```
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: COMPANYCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ISDEFAULT (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ISDEFAULT
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SNO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P81_TNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Detail
        }
    )

