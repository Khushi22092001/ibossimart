    dynamicAction setloginpassword (
        name: setLoginPassword
        execution {
            sequence: 110
        }
        when {
            selectionType: items
            items: P81_LOGINNAME
        }
        clientSideCondition {
            type: itemIsNull
            item: P81_LOGINPASSWORD
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      rtvalue varchar2(30);
                    begin
                            :P81_LoginName := Translate(	upper(:P81_loginName),		'A!@#$%^&*()_+|-=\;<>?,./ ',	'A');
                    		if :P81_LoginPassword is null then
                    				rtvalue := 'BOSS' || TO_CHAR(SYSDATE, 'DDSS');
                    		end if;
                            RETURN(RTVALUE);
                    end;
                    ```
                itemsToSubmit: [
                    P81_LOGINNAME
                    P81_LOGINPASSWORD
                ]
            }
            affectedElements {
                selectionType: items
                items: P81_LOGINPASSWORD
            }
            execution {
                sequence: 10
            }
        )

    )

    validation validating-email-address (
        name: Validating Email  Address
        execution {
            sequence: 10
        }
        validation {
            type: itemMatchesRegexp
            item: P81_EMAILADDRESS
            regexp: "^[A-Za-z]+[A-Za-z0-9.]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,4}$"
            alwaysExecute: true
        }
        error {
            errorMessage: Enter a Valid Email Address
            associatedItem: @P81_EMAILADDRESS
        }
    )

