            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span style="display:block; width: 100px;">#CCINVOICENO#</span>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREDITDAYS (
            type: plainText
            heading {
                heading: CREDIT DAYS
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column DUE_DATE (
            type: plainText
            heading {
                heading: DUE DATE
                alignment: center
            }
            layout {
                sequence: 130
            }
            columnFormatting {
                htmlExpression: <span style="display:block; width: 100px;">#DUE_DATE#</span>
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: M
            }
        )

        column OVERDUEDAYS (
            type: plainText
