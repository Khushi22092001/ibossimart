                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column PAYMENT_RECEIVED (
            type: plainText
            heading {
                heading: PAYMENT RECEIVED
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column SALESORDERAMOUNT (
            type: plainText
            heading {
                heading: SALES ORDER AMOUNT
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column SALESPERSON (
            type: plainText
            heading {
                heading: SALES PERSON
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column SO_CCI_AMOUNT (
            type: plainText
            heading {
                heading: SO CCI AMOUNT
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column VOUCHERDATE (
            type: plainText
            heading {
