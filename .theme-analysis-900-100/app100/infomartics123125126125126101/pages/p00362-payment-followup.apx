page 362 (
    name: Payment Followup
    alias: PAYMENT-FOLLOWUP
    title: Payment Followup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    region report-region (
        name: Report Region
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                     CCI.CCINVOICEDATE,
                     CCI.CCINVOICENO,
                     P.PARTYNAME,
                     V.VOUCHERNO,
                     V.VOUCHERDATE,
                     E.EMPLOYEENAME AS SALESPERSON,
                     SO.CREDITDAYS,
                     SO.SALESORDERAMOUNT,
                     CCI.CCINVOICEAMOUNT,
                     SO.SALESORDERAMOUNT - CCI.CCINVOICEAMOUNT AS SO_CCI_AMOUNT,
                     NVL(BR.AMOUNT,0) AS PAYMENT_RECEIVED,
                     NVL(CCI.CCINVOICEAMOUNT,0) - NVL(BR.AMOUNT,0) AS BALANCE_AMOUNT,
                     (CCI.CCINVOICEDATE + SO.CREDITDAYS) AS DUE_DATE,
                     TRUNC(SYSDATE) - (CCI.CCINVOICEDATE + SO.CREDITDAYS) AS OVERDUEDAYS
                FROM CCINVOICE CCI
                LEFT JOIN  SALESORDER SO ON CCI.SALESORDERTNO = SO.TNO
                LEFT JOIN VOUCHER V ON V.MODULETNO = (SELECT TNO FROM INVOICE WHERE MODULETNO = CCI.TNO)
                LEFT JOIN PARTY P ON P.PARTYCODE = SO.PARTYCODE
                LEFT JOIN EMPLOYEE E ON E.EMPLOYEECODE = SO.SALESEXECUTIVECODE
                LEFT JOIN DFREIGHTBILLRECEIPTDETAIL BR ON BR.MODULETNO = (SELECT TNO FROM INVOICE WHERE MODULETNO = CCI.TNO)
                
                WHERE CCI.SALESORDERTNO IS NOT NULL
                  AND V.VOUCHERNO IS NOT NULL
                  AND NVL(CCI.CCINVOICEAMOUNT,0) - NVL(BR.AMOUNT,0) > 0  -- Full Payment Invices will not appear
                  AND CCI.CCINVOICEDATE BETWEEN :P362_FROMDATE AND :P362_TODATE
                  AND ( :P362_PARTY IS NULL OR instr(':'||:P362_PARTY||':',':'||P.PARTYCODE||':') > 0 ) 
                
                ORDER BY CCI.CCINVOICEDATE DESC
                ```
            pageItemsToSubmit: [
                P362_PARTY
                P362_TODATE
                P362_FROMDATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 27355044904869545
        }

        column BALANCE_AMOUNT (
            type: plainText
            heading {
                heading: BALANCE AMOUNT
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column CCINVOICEAMOUNT (
            type: plainText
            heading {
                heading: CCINVOICE AMOUNT
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column CCINVOICEDATE (
            type: plainText
            heading {
                heading: CCINVOICE DATE
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <span style="display:block; width: 100px;">#CCINVOICEDATE#</span>
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
