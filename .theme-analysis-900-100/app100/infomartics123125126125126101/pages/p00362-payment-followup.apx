                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <span style="display:block; width: 100px;">#VOUCHERDATE#</span>
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column VOUCHERNO (
            type: plainText
            heading {
