        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 305671 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BALANCE_AMOUNT (
                sequence: 11
            )

            displayColumn CCINVOICEAMOUNT (
                sequence: 9
            )

            displayColumn CCINVOICEDATE (
                sequence: 1
            )

            displayColumn CCINVOICENO (
                sequence: 2
            )

            displayColumn CREDITDAYS (
                sequence: 6
            )

            displayColumn DUE_DATE (
                sequence: 7
            )

            displayColumn OVERDUEDAYS (
                sequence: 8
            )

            displayColumn PARTYNAME (
                sequence: 3
            )

            displayColumn PAYMENT_RECEIVED (
                sequence: 10
            )

            displayColumn SALESPERSON (
                sequence: 12
            )

            displayColumn VOUCHERDATE (
                sequence: 5
            )

            displayColumn VOUCHERNO (
                sequence: 4
            )

        )

    )

    pageItem P362_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
    )

    pageItem P362_PARTY (
        type: selectOne
        label {
            label: Party
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT P.PARTYNAME, P.PARTYCODE
                
                FROM CCINVOICE C
                LEFT JOIN PARTY P ON P.PARTYCODE = C.PARTYCODE
                ```
        }
        layout {
            sequence: 30
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
    )

    pageItem P362_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
    )

    dynamicAction refresh-the-report-region (
        name: Refresh the Report Region
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P362_FROMDATE
                P362_TODATE
                P362_PARTY
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report-region
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

