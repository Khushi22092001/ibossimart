page 119 (
    name: Cost Centre List
    alias: COST-CENTRE-LIST
    title: Cost Centre List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cost-centre-list (
        name: Cost Centre List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.COSTCENTRECODE,
                       A.COSTCENTRENAME,
                       A.PARENTCODE,
                       A.COMPANYCODE,
                       A.REMARK,
                       A.CREATOR,
                        to_char(A.CREATIONTIME,'DD-MON-YYYY HH24:MI:SS') CREATIONTIME
                  from COSTCENTRE A
                  Order By A.TNO Desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 120
                items: {
                    P120_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 148895117201747903
        }

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Company Code
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column COSTCENTRECODE (
            type: plainText
            heading {
                heading: Cost Centre Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COSTCENTRENAME (
            type: plainText
            heading {
                heading: Cost Centre Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 17
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column PARENTCODE (
            type: plainText
            heading {
                heading: Parent Code
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cost Centre List
        }

        savedReport 1489464 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMPANYCODE (
                sequence: 5
            )

            displayColumn COSTCENTRECODE (
                sequence: 2
            )

            displayColumn COSTCENTRENAME (
                sequence: 3
            )

            displayColumn CREATOR (
                sequence: 7
            )

            displayColumn PARENTCODE (
                sequence: 4
            )

            displayColumn REMARK (
                sequence: 6
            )

            displayColumn TNO (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @cost-centre-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 120
                clearCache: 120
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @cost-centre-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cost-centre-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @cost-centre-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cost-centre-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

