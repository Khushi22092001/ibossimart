        name: CHANGE WORKCENTRECODE
        execution {
            sequence: 100
        }
        when {
            selectionType: items
            items: P520_WORKCENTRECODE
        }
    )

    dynamicAction clear-all-item-available-on-page (
        name: Clear All Item available on PAGE
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @clear
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P520_DEPARTMENTCODE
                    P520_COSTCENTERCODE
                    P520_DEPTMONTH
                    P520_CCMONTH
                    P520_PARTYCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

