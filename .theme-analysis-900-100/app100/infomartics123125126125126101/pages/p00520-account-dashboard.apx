    region tds-payble (
        name: TDS PAYBLE
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select L.FINANCIALYEARBEGIN,
                       TO_DATE('01-'||to_char(to_date(:P520_ASONDATE,'DD-MM-yyyy'),'MM-YYYY'),'DD-MM-YYYY') As FROMDATE,
                       '₹  '||Sum(A.TDSAMOUNT) As TOTALTAX,
                       'TDS PAYBLE' AS TEXT,
                'u-color-15' As card_color
                
                   FROM VOUCHERTDSDEDUCTED    A,
                       VOUCHER               B,
                       JBPASS                C,
                       EXTERNALSERVICESENTRY D,
                       PAYMENTADVICE         E,
                       TDSNATURE             F,
                       TDSTAXCATEGORY        G,
                       PARTY                 H,
                       FinancialYear         L,
                       (SELECT A.CHALLANNO,
                               A.CHALLANDATE,
                               E.BSRCODE,
                               D.MODULETNO,
                               A.CHALLANAMOUNT
                          FROM CHALLAN                  A,
                               TDSCHALLAN               C,
                               TDSCHALLANDEDUCTEEDETAIL D,
                               BANK                     E
                         WHERE  A.DOCTYPECODE = 'TDSCHALLAN'
                           AND A.MODULETNO = C.TNO
                           AND C.TNO = D.TNO
                           AND A.TAXSECTIONCODE = D.TAXSECTIONCODE
                           AND A.DEPOSITEDINBANKCODE = E.BANKCODE
                       ) CHLN
                   
                 WHERE A.TNO = B.TNO(+)
                   AND B.MODULETNO = C.TNO(+)
                   AND B.MODULETNO = D.TNO(+)
                   AND B.MODULETNO = E.TNO(+)
                   AND A.TDSNATURECODE = F.TDSNATURECODE(+)
                   AND A.TDSTAXCATEGORYCODE = G.TDSTAXCATEGORYCODE(+)
                   AND A.PARTYCODE = H.PARTYCODE(+)
                   AND B.MODULETNO = CHLN.MODULETNO(+)
                
                   And Nvl(:P520_ASONDATE, Sysdate) Between l.FINANCIALYEARBEGIN And l.FINANCIALYEAREND
                  and B.VoucherDate between TO_DATE('01-'||to_char(to_date(:P520_ASONDATE,'DD-MM-yyyy'),'MM-YYYY'),'DD-MM-YYYY')  and :P520_ASONDATE
                 
                
                 Group By l.FINANCIALYEARBEGIN ,
                        TO_DATE('01-'||to_char(to_date(:P520_ASONDATE,'DD-MM-yyyy'),'MM-YYYY'),'DD-MM-YYYY')
                
                
                /*Select 'No Of Party  : ' || to_char(Count(Distinct A.partyCode)) As NoofParty,
                       'No of Bills  : ' || to_char(Count(Distinct A.ReferenceModuleTno)) As NoofBills,
                       '₹ ' || to_number(Round(Sum(a.creditnoteamount) / 100000, 2),
                                         '99999999999.99') || ' Lac' Value,
                       'Total Debit Note' As Text,
                       'u-color-30' As card_color
                
                  From CREDITNOTE A
                 Where a.creditnotedate <= Nvl(:P520_ASONDATE, Trunc(Sysdate));
                 */
                ```
        }
        layout {
            sequence: 210
            slot: body
            column: 1
            columnSpan: 4
            columnCssClasses: mycardsize
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            layout: horizontal
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: TOTALTAX
            cssClasses: mycardsize
        }
        secondaryBody {
            cssClasses: mycardsize
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 405
                    items: {
                        P405_FROMDATE: &FROMDATE.
                        P405_TODATE: &P520_ASONDATE.
                        P405_LOCATION: HO
                    }
                    clearCache: 405
                    action: resetPagination
                }
            }
        )

    )

    region tds-receivable (
        name: TDS RECEIVABLE
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select e.FINANCIALYEARBEGIN,
                       TO_DATE('01-'||to_char(to_date(:P520_ASONDATE,'DD-MM-yyyy'),'MM-YYYY'),'DD-MM-YYYY') As FROMDATE,
                       '₹  '||Sum(A.TDSAMOUNT) As TOTALTAX,
                       'TDS RECEIVABLE' AS TEXT,
                'u-color-17' As card_color
                
                   FROM DFREIGHTBILLRECEIPT       A,
                       DFREIGHTBILLRECEIPTDETAIL B,
                       VOUCHER                   C,
                       PARTY                     D,
                       FinancialYear             e
                 WHERE A.TNO = B.TNO
                   AND A.TNO = C.MODULETNO(+)
                   AND A.DEPOCODE = D.PARTYCODE(+)
                   AND NVL(B.TDSAMOUNT, 0) > 0
                
                   And Nvl(:P520_ASONDATE, Sysdate) Between e.FINANCIALYEARBEGIN And e.FINANCIALYEAREND
                  and C.VoucherDate between TO_DATE('01-'||to_char(to_date(:P520_ASONDATE,'DD-MM-yyyy'),'MM-YYYY'),'DD-MM-YYYY')  and :P520_ASONDATE
                 
                
                 Group By e.FINANCIALYEARBEGIN ,
                        TO_DATE('01-'||to_char(to_date(:P520_ASONDATE,'DD-MM-yyyy'),'MM-YYYY'),'DD-MM-YYYY')
                
                
                ```
        }
        layout {
            sequence: 220
            slot: body
            startNewRow: false
            column: 5
            columnSpan: 4
            columnCssClasses: mycardsize
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            layout: horizontal
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: TOTALTAX
            cssClasses: mycardsize
        }
        secondaryBody {
            cssClasses: mycardsize
        }
        pagination {
            type: page
        }
        messages {
            whenNoDataFound: "No Record Found For TDS Receivable "
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 406
                    items: {
                        P406_FROMDATE: &FROMDATE.
                        P406_TODATE: &P520_ASONDATE.
                        P406_LOCATION: HO
                    }
                    clearCache: 406
                    action: resetPagination
                }
            }
        )

    )

    pageItem P520_ASONDATE (
        type: datePicker
        label {
            label: As on Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @button
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 2
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: As on Date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT TRUNC(SYSDATE) FROM DUAL;
        }
        security {
            encryptSessionState: false
        }
    )

    button clear (
        buttonName: CLEAR
        label: Clear
        layout {
            sequence: 10
            region: @button
            slot: regionBody
            column: 1
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button submit (
        buttonName: Submit
        label: Submit
        layout {
            sequence: 30
            region: @button
            slot: regionBody
            startNewRow: false
            newColumn: false
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-arrow-right-alt
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction change-region-name (
        name: Change Region Name
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P520_CC
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (orig == "x")
                        orig = $('#MYID h1').text();
                    
                    $('#MYID h1').text(orig + ' (' + $('#P520_CC option:selected').text() + ')');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

