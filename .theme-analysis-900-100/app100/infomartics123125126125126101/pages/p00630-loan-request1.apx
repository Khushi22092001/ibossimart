                    regexp
                ]
                lovType: useLov
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Detail
        }
    )

    region loan-request (
        name: LOAN  REQUEST
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       LOANREQUESTNO,
                       LOANREQUESTDATE,
                       EMPLOYEECODE,
                       LOANTYPECODE,
                       LOANAMOUNT,
                       MERGEDAMOUNT,
                       TOTALAMOUNT,
                       INSTALLMENTAMOUNT,
                       NOOFINSTALLMENT,
                       DEDUCTIONSTARTDATE,
                       REMARK,
                       MONEYTRANSFERMODECODE,
                       MODULETNO,
                       MODULECODE,
                       MODULESNO,
                       CREATOR,
                       NVL(GETDOCUMENTSTATUSCODE(GETMODULECODEFORPAGENO(:APP_PAGE_ID),A.TNO),'STATUS') AS STATUS
                  from LOANREQUEST A
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

