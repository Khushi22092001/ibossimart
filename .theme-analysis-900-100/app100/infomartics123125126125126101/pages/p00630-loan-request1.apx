    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P630_TNO is null then
                    :P630_TNO := GlobalTNo.nextval;
                    :P630_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P630_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P630_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P630_TNO), 'Status');
