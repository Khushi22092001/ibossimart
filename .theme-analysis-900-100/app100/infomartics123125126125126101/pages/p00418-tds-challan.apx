    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                   
                    case :APEX$ROW_STATUS
                        when 'C' then
                             /*if nvl(:Quantity1,0) = 0 then
                        raise_application_error(-20001, ' Please Enter Primary Quantity-'||:ITEMCODE) ;
                    end if; */
                            Insert Into TDSCHALLANDETAIL                 
                                 (
                                  tno                      ,
                                  sno                      ,
                                  taxsectioncode           ,
                                  amount                   ,
                                  moneytransfermodecode    ,
                                  accountcode              ,
                                  moneytransferreferenceno ,
                                  depositorcode            ,
                                  depositedinbankcode      ,
                                  coverletterno            ,
                                  narration               
                                )
                            Values (
                                  :tno                      ,
                                  :sno                      ,
                                  :taxsectioncode           ,
                                  :amount                   ,
                                  :moneytransfermodecode    ,
                                  :accountcode              ,
                                  :moneytransferreferenceno ,
                                  :depositorcode            ,
                                  :depositedinbankcode      ,
                                  :coverletterno            ,
                                  :narration               
                                );
                        
                        when 'U' then
                        /* if nvl(:Quantity1,0) = 0 then
                        raise_application_error(-20001, ' Please Enter Primary Quantity-'||:ITEMCODE) ;
                    end if; */
                    
                            update TDSCHALLANDETAIL Set
                                tno                      	=	:tno                       ,
                                sno                         =	:sno                       ,
                                taxsectioncode              =	:taxsectioncode            ,
                                amount                      =	:amount                    ,
                                moneytransfermodecode       =	:moneytransfermodecode     ,
                                accountcode                 =	:accountcode               ,
                                moneytransferreferenceno    =	:moneytransferreferenceno  ,
                                depositorcode               =	:depositorcode             ,
                                depositedinbankcode         =	:depositedinbankcode       ,
                                coverletterno               =	:coverletterno             ,
                                narration                   =	:narration                 
                            WHERE TNO = :P418_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From TDSCHALLANDETAIL
                            Where TNo = :P418_TNO
                              and SNO = :P418_SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 20644783404166069
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P418_MODULEFLOW := 'YES';
                   else
                       :P418_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P418_ONTHETABLE := 'YES' ;
                   else
                       :P418_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 20716122987166113
        }
    )

