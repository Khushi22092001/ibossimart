    dynamicAction initialize-sno-sequence (
        name: Initialize SNO Sequence
        execution {
            sequence: 110
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @detail
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    Declare
                    mysno number;
                    Begin
                    If :SNO is null then
                        Select GlobalTNo.nextval into mysno from dual;
                    else MYSNO := :SNO;
                    end if;
                    return mysno;
                    end;
                    ```
