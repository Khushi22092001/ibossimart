    process set-allowed-date (
        name: Set Allowed Date
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P418_FORMSTATUS = 'NEWRECORD' THEN 
                for vloop in (
                select
                		trunc(sysdate) - nvl(b.AllowedBackDays, 0) as AllowedBack,
                		trunc(sysdate) + nvl(b.AllowedForwardDays, 0) AllowedForward	
                		--a.FreezeDate
                        INTO :P418_ALLOWEDBACK,:P418_ALLOWEDFORWARD
                from Module a, ModulePrivilege b, BossUser c
                where a.ModuleCode = GetModuleCodeForpageNo(:APP_PAGE_ID)
                		and a.ModuleCode = b.ModuleCode
                		and b.BossUsercode = c.BossUserCode
                		and c.LoginName = :GLOBAL_LOGINNAME
                		and b.CompanyCode = :GLOBAL_CompanyCode
                ) loop
                     :P418_ALLOWEDBACK       := vloop.AllowedBack ; 
                    :P418_ALLOWEDFORWARD    := vloop.AllowedForward ;
                end loop;
                else
                    :P418_ALLOWEDBACK       := :P418_TDSCHALLANDATE ; 
                    :P418_ALLOWEDFORWARD    := :P418_TDSCHALLANDATE ;
                
                 end if;
                ```
        }
        execution {
            sequence: 140
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 20714190006166112
        }
    )

