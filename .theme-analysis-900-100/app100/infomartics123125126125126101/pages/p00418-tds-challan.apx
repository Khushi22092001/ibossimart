        column DEPOSITORCODE (
            type: popupLov
            heading {
                heading: Depositor
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                    	a.EmployeeName,
                    	a.EmployeeCode
                    from Employee a
                    where a.CompanyCode = :global_CompanyCode
                    	and not exists(
                    		select
                    			aa.tno
                    		from Resignation aa
                    		where aa.EmployeeCode = a.EmployeeCode
                    	)
                    	
                    order by 1	
                    ```
            }
            layout {
