    dynamicAction check-codescheme (
        name: check codescheme
        execution {
            sequence: 400
        }
        when {
            event: focusout
            selectionType: items
            items: P418_MATERIALINDATE
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P418_PARTYCODE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P418_CODESCHEME
                value: AUTO
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select CODESCHEME  from codescheme
                        where companycode = :global_companycode
                        and modulecode = GetModuleCodeForPageNo(:APP_PAGE_ID)
                        and FINANCIALYEARCODE = :global_FINANCIALYEARCODE;
                    ```
            }
            affectedElements {
                selectionType: items
                items: P418_CODESCHEME
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-lr (
        name: Check LR
        execution {
            sequence: 380
        }
        when {
            event: focusout
            selectionType: items
            items: P418_LRNO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        tmp number;
                        tmp1 number;
                    begin
                    
                    
                        select count(*) into tmp from materialin
                        where FINANCIALYEARCODE = :P418_FINANCIALYEARCODE
                        and TRANSPORTERCODE = :P418_TRANSPORTERCODE
                        and LRNO = :P418_LRNO;
                    
                       
                    
                        if nvl(tmp , 0)> 0   then 
                            raise_application_error(-20000,'LR NO is already used in Matrial In.');
                        end if;
                       
                    end;
                    ```
                itemsToSubmit: [
                    P418_FINANCIALYEARCODE
                    P418_PARTYCODE
                    P418_REFDOCTYPECODE
                    P418_REFDOCNO
                    P418_LRNO
                    P418_TRANSPORTERCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-ref-no (
        name: Check ref no
        execution {
            sequence: 370
        }
        when {
            event: focusout
            selectionType: items
            items: P418_REFDOCNO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        tmp number;
                        tmp1 number;
                    begin
                    
                    
                        select count(*) into tmp from materialin
                        where FINANCIALYEARCODE = :P418_FINANCIALYEARCODE
                        and PARTYCODE = :P418_PARTYCODE
                        and REFDOCTYPECODE = :P418_REFDOCTYPECODE
                        and REFDOCNO = :P418_REFDOCNO;
                    
                        select count(*) into tmp1 from grn    
                        where FINANCIALYEARCODE = :P418_FINANCIALYEARCODE
                        and PARTYCODE = :P418_PARTYCODE
                        and REFDOCTYPECODE = :P418_REFDOCTYPECODE
                        and REFDOCNO = :P418_REFDOCNO;
                    
                        if nvl(tmp , 0)> 0   then 
                            raise_application_error(-20000,'REF DOC NO is already used in Matrial In.');
                        end if;
                        if nvl(tmp1 , 0)> 0   then 
                            raise_application_error(-20000,'REF DOC NO is already used in GRN.');
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P418_FINANCIALYEARCODE
                    P418_PARTYCODE
                    P418_REFDOCTYPECODE
                    P418_REFDOCNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
