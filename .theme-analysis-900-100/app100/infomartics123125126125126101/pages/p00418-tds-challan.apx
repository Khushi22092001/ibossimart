    dynamicAction insert-into-details (
        name: insert into details
        execution {
            sequence: 460
        }
        when {
            event: click
            selectionType: button
            button: @prepare
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    tmp number;			
                    begin
                    
                    delete from TDSChallanDeducteeDetail a where a.TNo = :P418_TNo;
                    
                    Insert into	TDSChallanDeducteeDetail(
                    TNo,
                    SNo,
                    TaxSectionCode,
                    PartyCode,
                    ModuleCode,
                    ModuleTNo,
                    VoucherTNo,
                    AmountOfPaymentOrCredit,
                    TDSDeductedOnAmount,	
                    TDSPercent,
                    TDSAmount,
                    SurchargeAmount,
                    CessAmount,
                    HAndSCessAmount,
                    TotalTDSAmount
                    ) select
                    :P418_TNo,
                    globaltno.nextval,
                    x.TaxSectionCode,
                    x.PartyCode,
                    x.ModuleCode,
                    x.ModuleTNo,
                    x.VoucherTNo,
                    x.AmountOfPaymentOrCredit,
                    x.TDSDeductedOnAmount,	
                    x.TDSPercent,
                    x.TDSAmount,
                    x.SurchargeAmount,
                    x.CessAmount,
                    x.HAndSCessAmount,
                    nvl(x.TDSAmount,0) +	nvl(x.SurchargeAmount, 0) + nvl(x.CessAmount, 0) + nvl(x.HAndSCessAmount, 0)
                    from (
                    select
                    	b.VoucherDate,
                    	b.TNo as VoucherTNo,
                    	c.TaxSectionCode,
                    	a.PartyCode,
                    	b.ModuleCode,
                    	b.ModuleTNo,						
                    	a.AmountDr as AmountOfPaymentOrCredit,
                    	a.TDSDEDUCTABLEAMOUNT as TDSDeductedOnAmount,
                    	a.TDSPERCENT as TDSPercent,
                    	sum( decode( d.FooterHeadCode, '.TDS.', d.FooterValue, 0 ) ) as TDSAmount,
                    	sum( decode( d.FooterHeadCode, '.SURCHARGEONTDS.', d.FooterValue, 0 ) ) as SurchargeAmount,
                    	sum( decode( d.FooterHeadCode, '.CESSONTDS.', d.FooterValue, 0 ) ) as CessAmount,
                    	sum( decode( d.FooterHeadCode, '.HANDSCESSONTDS.', d.FooterValue, 0 ) ) as HAndSCessAmount
                    from PaymentAdvice a, Voucher b, tdstaxcategory c, PaymentAdviceDetail d, Party z
                    where a.TNo = b.ModuleTNO
                    	and a.tdstaxcategoryCode =c.tdstaxcategoryCode
                    	and a.TNO = d.TNo
                    	and b.VoucherDate between :P418_FromDate and :P418_ToDate
                    	and a.CompanyCode = :global_CompanyCode
                    	
                    	and a.PartyCode = z.PartyCode
                    	--and z.IsCompany = :P418_ForCompany 
                    group by
                    	b.VoucherDate,
                    	b.TNo,
                    	c.TaxSectionCode,
                    	a.PartyCode,
                    	b.ModuleCode,
                    	b.ModuleTNo,						
                    	a.AmountDr,
                    	a.TDSDEDUCTABLEAMOUNT,
                    	a.TDSPERCENT
                    union all
                    select
                    	b.VoucherDate,
                    	b.TNo as VoucherTNo,
                    	c.TaxSectionCode,
                    	a1.PartyCode,
                    	b.ModuleCode,
                    	b.ModuleTNo,						
                    	a.JBPassAmount as AmountOfPaymentOrCredit,
                    	a.TDSDEDUCTABLEAMOUNT as TDSDeductedOnAmount,
                    	d.FOOTERPERCENT as TDSPercent,
                    	sum( decode( d.FooterHeadCode, '.TDS.', d.FooterValue, 0 ) ) as TDSAmount,
                    	sum( decode( d.FooterHeadCode, '.SURCHARGEONTDS.', d.FooterValue, 0 ) ) as SurchargeAmount,
                    	sum( decode( d.FooterHeadCode, '.CESSONTDS.', d.FooterValue, 0 ) ) as CessAmount,
                    	sum( decode( d.FooterHeadCode, '.HANDSCESSONTDS.', d.FooterValue, 0 ) ) as HAndSCessAmount
                    from JBPass a, JobBill a1, Voucher b, tdstaxcategory c, JBPassTDSDetail d, Party z
                    where a.JobBillTNO = a1.TNo
                    	and a.TNo = b.ModuleTNO
                    	and a.tdstaxcategoryCode =c.tdstaxcategoryCode
                    	and a.TNO = d.TNo
                    	and b.VoucherDate between :P418_FromDate and :P418_ToDate
                    	and a.CompanyCode = :global_CompanyCode
                    
                    	and a1.PartyCode = z.PartyCode
                    							
                    group by
                    	b.VoucherDate,
                    	b.TNo,
                    	c.TaxSectionCode,
                    	a1.PartyCode,
                    	b.ModuleCode,
                    	b.ModuleTNo,						
                    	a.JBPassAmount,
                    	a.TDSDEDUCTABLEAMOUNT,
                    	d.FOOTERPERCENT
                    UNION ALL
                    Select
                    a.SalaryFromDate as VoucherDate,
                    null as VoucherTNo,
                    '192B' as TaxSectionCode,
                    null as PartyCode,
                    'SALARY' as ModuleCode,
                    null as ModuleTNo,						
                    null as AmountOfPaymentOrCredit,
                    null as TDSDeductedOnAmount,
                    null as TDSPercent,
                    sum(b.SalaryHeadAmount) as TDSAmount,
                    null as SurchargeAmount,
                    null as CessAmount,
                    null as HAndSCessAmount
                    From Salary a, SalaryDetail b
                    Where a.Tno = b.Tno
                    and b.SalaryHeadCode = 'TDS'
                    and a.SalaryFromDate between :P418_FromDate and :P418_ToDate
                    and a.SalaryToDate between :P418_FromDate and :P418_ToDate
                    and a.CompanyCode = :global_CompanyCode 
                    -----------------------------------------
                    Group by
                    	a.SalaryFromDate,
                    	'192B'
                    Order by 1, 2
                    ) x
                    where nvl(x.TDSAmount,0) +	nvl(x.SurchargeAmount, 0) + nvl(x.CessAmount, 0) + nvl(x.HAndSCessAmount, 0) > 0
                    ;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P418_TNO
                    P418_FROMDATE
                    P418_TODATE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from TDSChallanDetail where tno = :P418_TNO;
                    
                    Insert into  TDSChallanDetail (
                    						TNo,
                    						SNo,
                    						TaxSectionCode,
                    						Amount
                    				) select
                    						:P418_TNo,
                    						globaltno.nextval,
                    						x.TaxSectionCode,
                    						x.Amount
                    				from (
                    						select
                    								a.TaxSectionCode,
                    								sum(a.TotalTDSAmount) as Amount
                    						from TDSChallanDeducteeDetail a
                    						where a.TNo = :P418_TNo
                    						group by a.TaxSectionCode
                    				) x;
                    ```
                itemsToSubmit: P418_TNO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tds-deductee-detail
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P418_TNO
                    P418_COMPANYCODE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P418_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

