    region creditors-aging-detail-report-2 (
        name: Creditors Aging Detail Report
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: Creditors Aging Detail Report
            regionDisplaySelector: true
        }
    )

    pageItem P523_ASONDATE (
        type: datePickerJquery
        label {
            label: As On Date
            alignment: left
        }
        settings {
            show: both
            navigationListFor: monthAndYear
        }
        layout {
            sequence: 20
            region: @creditors-aging-detail-report-2
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P523_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                  Select
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'PAYMENTADVICE'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order by 1
                ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @creditors-aging-detail-report-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Location Name
        }
    )

    pageItem P523_PARTY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vendor
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 3
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       p.PartyName d,
                       p.PartyCode r
                From  Party p 
                Where P.PARTYTYPECODE IN ('CONTRACTOR','SUPPLIER','CUSTOMER','TRANSPORTER')
                Order By 1
                ```
        }
        layout {
            sequence: 60
            region: @creditors-aging-detail-report-2
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 75
            valuePlaceholder: Vendor List
        }
    )

    pageItem P523_PARTYTYPE (
        type: selectList
        label {
            label: Party Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                DISTINCT PARTYTYPECODE AS NAME,
                PARTYTYPECODE
                FROM PARTY where partytypecode in 
                ('CONTRACTOR','SUPPLIER','TRANSPORTER','CUSTOMER')
                ORDER BY 1
                ```
            nullDisplayValue: -- Select Party Type --
        }
        layout {
            sequence: 50
            region: @creditors-aging-detail-report-2
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

