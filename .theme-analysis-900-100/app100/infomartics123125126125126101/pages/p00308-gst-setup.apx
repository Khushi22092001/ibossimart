        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                	begin
                	If :P308_TNO is null then
                		return('NEWRECORD');
                	else
                		return('EDITRECORD');
                	End if;
                	end ;
                ```
