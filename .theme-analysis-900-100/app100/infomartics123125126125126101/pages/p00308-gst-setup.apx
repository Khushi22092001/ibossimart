page 308 (
    name: GST Setup
    alias: GST-SETUP
    title: GST Setup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 30
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region gst-setup (
        name: GST Setup
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       CGSTINPUTACCOUNTCODE,
                       SGSTINPUTACCOUNTCODE,
                       CGSTOUTPUTACCOUNTCODE,
                       SGSTOUTPUTACCOUNTCODE,
                       IGSTINPUTACCOUNTCODE,
                       IGSTOUTPUTACCOUNTCODE,
                       CGSTRCMPAYABLEACCOUNTCODE,
                       CGSTPAYABLEACCOUNTCODE,
                       SGSTPAYABLEACCOUNTCODE,
                       IGSTPAYABLEACCOUNTCODE,
                       IGSTRCMPAYABLEACCOUNTCODE,
                       SGSTRCMPAYABLEACCOUNTCODE,
                        cgstrcminputaccountcode   ,
                        sgstrcminputaccountcode   ,
                        igstrcminputaccountcode ,  
                cgstrcmoutputaccountcode  ,
                  sgstrcmoutputaccountcode ,
                  igstrcmoutputaccountcode  ,
                       CREATOR,
                       CREATIONTIME
                  from GSTSETUP
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region input (
        name: INPUT
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @gst-setup
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region output (
        name: OUTPUT
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @gst-setup
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region payble (
        name: PAYBLE
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @gst-setup
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region rcm-input (
        name: RCM INPUT
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @gst-setup
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region rcm-output (
        name: RCM OUTPUT
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @gst-setup
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region rcm-payble (
        name: RCM PAYBLE
