    pageItem P308_CGSTINPUTACCOUNTCODE (
        type: popupLov
        label {
            label: "CGST Account "
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select partyname , partycode from party  
                order by 1
                ```
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            region: @input
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
