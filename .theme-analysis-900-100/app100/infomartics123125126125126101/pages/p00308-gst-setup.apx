    pageItem P308_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @common-fields
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P308_TNO), 'Status')
        }
        sessionState {
            storage: request
        }
    )

    pageItem P308_STATUSRIGHT (
        type: hidden
        layout {
            sequence: 10
            region: @common-fields
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select B.STATUSPRIVILEGE
                  From module a, moduleprivilege b, bossuser c
                 Where a.modulecode = b.modulecode
                   And b.bossusercode = c.bossusercode
                   And c.loginname = :GLOBAL_LOGINNAME
                   And A.ENTRYPAGENO = :APP_PAGE_ID
                   AND B.COMPANYCODE = :GLOBAL_COMPANYCODE
                ```
        }
    )

    pageItem P308_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @gst-setup
            slot: regionBody
        }
        source {
            formRegion: @gst-setup
            column: TNO
            dataType: number
            primaryKey: true
        }
    )

    button addnew (
        buttonName: AddNew
        label: Add New
        layout {
            sequence: 210
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pillEnd
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
            }
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Want to Add New Record?
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  tModuleFlow number;
                  tmp         number;
                  tmp1        number;
                BEGIN
                   select count(*) into tmp1 from ModuleFlow a where a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID);
                   if nvl(tmp1,0) > 0 then
                        select 
                            count(*) into tModuleFlow
                        from ModuleFlow a, ModuleFlowUser b, Bossuser c
                        where a.tno = b.tno
                          and b.bossusercode = c.bossusercode
                          and a.Modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                          and c.bossusername = :APP_USER
                          ;
                
                          if nvl(tModuleFlow,0) > 0 then
                             return(TRUE) ;
                          else
                             return(FALSE);
                          end if;
                     else
                            Select
                            	COUNT(*) into tmp 
                            From Module a, ModulePrivilege b, BossUser c
                            Where a.ModuleCode = b.ModuleCode
                            	and b.BossUsercode = c.BossUserCode
                            	and c.LoginName = :GLOBAL_LOGINNAME
                                and a.ModuleCode= getmodulecodeforpageno(:APP_PAGE_ID)
                            	and b.CompanyCode = :GLOBAL_COMPANYCODE
                            	and b.InsertPrivilege = 'YES' ;
                            if nvl(tmp,0) > 0 then
                               return(TRUE);
                            else
                               return(FALSE);
                            end if;
                      end if;
                              
                END;
                ```
        }
    )

