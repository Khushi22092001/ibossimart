page 284 (
    name: Employee Gate Pass List
    alias: EMPLOYEE-GATE-PASS-LIST
    title: Employee Gate Pass List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employee-gate-pass-list (
        name: Employee Gate Pass List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       getcompanyname(COMPANYCODE) company,
                       FINANCIALYEARCODE,
                       getlocationname(LOCATIONCODE) location,
                       getdoctypename(DOCTYPECODE) doctype,
                       EMPLOYEEGATEPASSNO,
                       EMPLOYEEGATEPASSDATE,
                       BRANCHCODE,
                       getemployeename(EMPLOYEECODE) employee,
                       getemployeename(REPORTTOEMPLOYEECODE) reporttoemployee,
                       PURPOSE,
                       OUTPASSTYPECODE,
                       COMMINGBACK,
                       to_char(REQUESTEDOUTTIME,'DD-MM-YYYY HH:MI:SS') REQUESTEDOUTTIME,
                       to_char(REQUESTEDINTIME,'DD-MM-YYYY HH:MI:SS') REQUESTEDINTIME,
                       to_char(ACTUALOUTTIME,'DD-MM-YYYY HH:MI:SS') ACTUALOUTTIME,
                       to_char(ACTUALINTIME,'DD-MM-YYYY HH:MI:SS') ACTUALINTIME,
                       
                       REMARK,
                       CREATOR,
                       CREATIONTIME
                  from EMPLOYEEGATEPASS
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 285
                items: {
                    P285_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 9679523472596001
        }

