    pageItem P349_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @vendor-list
            slot: regionBody
        }
    )

    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 20
            region: @vendor-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 350
                items: {
                    P350_FORMSTATUS: NEWRECORD
                }
                clearCache: 350
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  tModuleFlow number;
                  tmp         number;
                  tmp1        number;
                BEGIN
                   select count(*) into tmp1 from ModuleFlow a where a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID);
                   if nvl(tmp1,0) > 0 then
                        select 
                            count(*) into tModuleFlow
                        from ModuleFlow a, ModuleFlowUser b, Bossuser c
                        where a.tno = b.tno
                          and b.bossusercode = c.bossusercode
                          and a.Modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                          and c.bossusername = :APP_USER
                          ;
                
                          if nvl(tModuleFlow,0) > 0 then
                             return(TRUE) ;
                          else
                             return(FALSE);
                          end if;
                     else
                            Select
                            	COUNT(*) into tmp 
                            From Module a, ModulePrivilege b, BossUser c
                            Where a.ModuleCode = b.ModuleCode
                            	and b.BossUsercode = c.BossUserCode
                            	and c.LoginName = :GLOBAL_LOGINNAME
                                and a.ModuleCode= getmodulecodeforpageno(:APP_PAGE_ID)
                            	and b.CompanyCode = :GLOBAL_COMPANYCODE
                            	and b.InsertPrivilege = 'YES' ;
                            if nvl(tmp,0) > 0 then
                               return(TRUE);
                            else
                               return(FALSE);
                            end if;
                      end if;
                              
                END;
                ```
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @vendor-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

)

