page 506 (
    name: Purchase Dashboard
    alias: PURCHASE-DASHBOARD
    title: Purchase Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .mycardtext{color:white;}
            .mycardsize{font-size: 15px;font-weight:bold;}
            ```
    }
    security {
        formAutoComplete: false
    }

    region parameters (
        name: Parameters
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-collapsed
                t-Region--noBorder
                t-Region--hiddenOverflow
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region posted (
        name: Posted
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                '₹ '||to_char(Round(sum(a.PBPassAmount)/100000,2),'99,99,99,99,999.99') ||' Lac' Value,
                'Posted' as Text,
                'u-color-18' as card_color
                From  PBPass a, Financialyear b
                Where to_Char(a.PBPassDate,'YYYY') = to_Char(To_Date(:P506_DATE,'DD-MM-YYYY'),'YYYY')
                  and exists (Select 1 from Voucher v where v.ModuleTNo = a.TNo)
                  and a.FinancialYearCode = b.FinancialyearCode
                  and :P506_DATE between b.FinancialYearBegin and b.FinancialyearEnd
                  and a.PBPassDate <= :P506_DATE
                ```
            pageItemsToSubmit: P506_DATE
        }
        layout {
            sequence: 30
            parentRegion: @top-kpi-trends
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardsize
            ]
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 151
                    items: {
                        P151_COMPANY: &GLOBAL_COMPANYCODE.
                        P151_VSTATUS: PREPARED
                        P151_FROMDATE: &P506_FROMDATE.
                        P151_TODATE: &P506_DATE.
                    }
                    clearCache: 151
                }
            }
        )

    )

    region purchase-per-day (
        name: Purchase Per Day
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                '₹ '||to_char(Round(sum(a.PBPassAmount)/100000 /
                GetDayofYear(To_Date(:P506_DATE,'DD-MM-YYYY'))
                ,2),'99,99,99,99,999.99')
                ||' Lac' Value,
                'Purchase per Day' as Text,
                'u-color-5' as card_color
                From PBPass a, financialyear b
                 Where a.financialyearcode = b.financialyearcode
                   And :P506_DATE Between b.financialyearbegin And b.financialyearend
                   And to_Char(a.PBPassDate, 'YYYY') = to_Char(To_Date(:P506_DATE, 'DD-MM-YYYY'), 'YYYY')
                   And a.PBPassDate <= :P506_DATE
                ```
            pageItemsToSubmit: P506_DATE
        }
        layout {
            sequence: 50
            parentRegion: @top-kpi-trends
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardsize
                mycardtext
            ]
        }
    )

    region purchase-trends (
        name: Purchase Trends
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    x.LabelName,
                    x.ValueName,
                    Case When rownum = 1 then '#76B947'
                         When rownum = 2 then '#2E8BC0'
                         When rownum = 3 then '#FFA384'
                         When rownum = 4 then '#FF8300'
                         When rownum = 5 then '#B7AC44'
                         When rownum = 6 then '#FF4500'
                         When rownum = 7 then '#DF362D'
                         When rownum = 8 then '#FAD02C'
                         When rownum = 9 then '#333652'
                         When rownum = 10 then '#90ADC6'
                         When rownum = 11 then '#94C973'
                         When rownum = 12 then 'u-color-12'
                    End as Color
                
                From
                (Select
                      
                      Decode(nvl(:P506_COMPARE,'MONTH'),
                              'MONTH',
                              to_char(a.PBPassdate, 'MON-YY'),
                              to_char(a.PBPassdate, 'YYYY')) LabelName,
                      Decode(nvl(:P506_COMPARE,'MONTH'),
                               'MONTH',
                               to_char(a.PBPassdate, 'YYYYMM'),
                               to_char(a.PBPassdate, 'YYYY')) OrderName,       
                      Round(sum(TotalAmount),2)as ValueName
                From  BI_PRevenue a, FinancialYear b
                Where a.PBPassDate <= NVL(:P506_DATE,TRUNC(SYSDATE))
                  and a.FinancialyearCode = b.Financialyearcode
                  and :P506_DATE between b.FinancialyearBegin and b.FinancialyearEnd
                Group by Decode(nvl(:P506_COMPARE,'MONTH'),
                              'MONTH',
                              to_char(a.PBPassdate, 'MON-YY'),
                              to_char(a.PBPassdate, 'YYYY')) ,
                      Decode(nvl(:P506_COMPARE,'MONTH'),
                               'MONTH',
                               to_char(a.PBPassdate, 'YYYYMM'),
                               to_char(a.PBPassdate, 'YYYY'))
                Order by Decode(nvl(:P506_COMPARE,'MONTH'),
                               'MONTH',
                               to_char(a.PBPassdate, 'YYYYMM'),
                               to_char(a.PBPassdate, 'YYYY')) desc
                )x
                Where Rownum <= NVL(:P506_VALUE,1)
                ```
            pageItemsToSubmit: [
                P506_VALUE
                P506_DATE
                P506_COMPARE
            ]
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 400
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        legend {
            show: false
        }

        series jet_chart_series (
            name: 1
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABELNAME
                value: VALUENAME
            }
            appearance {
                color: &COLOR.
            }
            label {
                show: true
                position: outsideBarEdge
                fontStyle: italic
                fontSize: 10
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

