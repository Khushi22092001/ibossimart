            sequence: 30
            region: @parameters
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P506_VALUE (
        type: numberField
        label {
            label: Value (1-12)
            alignment: left
        }
        settings {
            minValue: 1
            maxValue: 12
            numberAlignment: end
            virtualKeyboard: text
        }
        layout {
            sequence: 70
            region: @parameters
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 7
            valuePlaceholder: Value ( 1-3)
        }
        default {
            type: static
            staticValue: 1
        }
        security {
            encryptSessionState: false
        }
    )

    button clear (
        buttonName: CLEAR
        label: Clear
        layout {
            sequence: 10
            region: @parameters
            slot: regionBody
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 80
            region: @parameters
            slot: regionBody
            startNewRow: false
