    region top-kpi-trends (
        name: Top KPI Trends
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent1
                t-Region--scrollBody
            ]
            icon: fa-credit-card
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region total-purchase (
        name: Total Purchase
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                '₹ '||to_char(Round(sum(a.PBPassAmount)/100000,2),'99,99,99,99,999.99') ||' Lac' Value,
                'Total Purchase' as Text,
                'u-color-22' as card_color
                From PBPass a, financialyear b
                 Where a.financialyearcode = b.financialyearcode
                   And :P506_DATE Between b.financialyearbegin And b.financialyearend
                   And to_Char(a.PBPassDate, 'YYYY') = to_Char(To_Date(:P506_DATE, 'DD-MM-YYYY'), 'YYYY')
                   And a.PBPassDate <= :P506_DATE
                   
                ```
            pageItemsToSubmit: P506_DATE
        }
        layout {
            sequence: 20
            parentRegion: @top-kpi-trends
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardsize
            ]
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 507
                    items: {
                        P507_DATE: &P506_DATE.
                    }
                    clearCache: 507
                }
            }
        )

    )

    region total-quantity (
        name: Total Quantity
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                to_char(Round(sum(a.Quantity1),2),'99,99,99,999.99') ||' MT' Value,
                'Total Quantity' as Text,
                'u-color-11' as card_color
                From  BI_PRevenue a, Item e, FinancialYear f
                Where to_Char(a.PBPassDate,'YYYY') = to_Char(To_Date(:P506_DATE,'DD-MM-YYYY'),'YYYY')
                  and e.MeasuringUnitCode1 = 'MT'
                  and a.ItemCode = e.ItemCode
                  and a.financialyearcode = f.financialyearCode
                  and :P506_DATE between f.financialyearbegin and f.financialyearend
                  and a.PBPassDate <= :P506_DATE
                ```
            pageItemsToSubmit: P506_DATE
        }
        layout {
            sequence: 60
            parentRegion: @top-kpi-trends
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardtext
                mycardsize
            ]
        }
    )

    region total-transactions (
        name: Total Transactions
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                count(a.TNo),
                'Total Transaction' as Text,
                'u-color-14' as card_color
                From PBPass a, financialyear b
                 Where a.financialyearcode = b.financialyearcode
                   And a.PBPassDate Between b.financialyearbegin And :P506_DATE
                   And to_Char(a.PBPassDate, 'YYYY') = to_Char(To_Date(:P506_DATE, 'DD-MM-YYYY'), 'YYYY')
                   
                
                ```
            pageItemsToSubmit: P506_DATE
        }
        layout {
            sequence: 10
            parentRegion: @top-kpi-trends
            slot: subRegions
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: COUNT(A.TNO)
            cssClasses: [
                u-color-13-text
                mycardsize
            ]
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 151
                    items: {
                        P151_COMPANY: &GLOBAL_COMPANYCODE.
                        P151_FROMDATE: &P506_FROMDATE.
                        P151_TODATE: &P506_DATE.
                    }
                    clearCache: 151
                }
            }
        )

    )

    region un-posted (
        name: Un-Posted
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                '₹ '||to_char(Round(sum(a.PBPassAmount)/100000,2),'99,99,99,99,999.99') ||' Lac' Value,
                'Un-Posted' as Text,
                'u-color-9' as card_color
                From  PBPass a, Financialyear b
                Where to_Char(a.PBPassDate,'YYYY') = to_Char(To_Date(:P506_DATE,'DD-MM-YYYY'),'YYYY')
                  and not exists (Select 1 from Voucher v where v.ModuleTNo = a.TNo)
                  and a.FinancialyearCode = b.Financialyearcode
                  and :P506_DATE between b.Financialyearbegin and b.FinancialyearEnd
                  and a.PBPassDate <= :P506_DATE
                ```
            pageItemsToSubmit: P506_DATE
        }
        layout {
            sequence: 40
            parentRegion: @top-kpi-trends
            slot: subRegions
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardsize
            ]
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 151
                    items: {
                        P151_COMPANY: &GLOBAL_COMPANYCODE.
                        P151_FROMDATE: &P506_FROMDATE.
                        P151_VSTATUS: PENDING
                        P151_TODATE: &P506_DATE.
                    }
                    clearCache: 151
                    action: resetPagination
                }
            }
        )

    )

    pageItem P506_COMPARE (
        type: radioGroup
        label {
            label: Compare
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:MONTH;MONTH,YEAR;YEAR
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @parameters
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: MONTH
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P506_DATE (
        type: datePicker
        label {
            label: Month/Year
            alignment: left
        }
        layout {
            sequence: 50
            region: @parameters
            slot: regionBody
            alignment: left
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P506_FROMDATE (
        type: hidden
        layout {
            sequence: 20
            region: @parameters
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select a.financialyearbegin
                From financialyear a 
                Where nvl(:P506_DATE,TRUNC(SYSDATE)) Between a.financialyearbegin And a.financialyearend
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P506_LOCATION (
        type: hidden
        layout {
            sequence: 40
            region: @parameters
            slot: regionBody
        }
        default {
            type: static
            staticValue: CO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P506_STATUS (
        type: textField
        label {
            label: Status
            alignment: left
        }
