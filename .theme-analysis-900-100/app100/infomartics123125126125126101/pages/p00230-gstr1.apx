    region transaction (
        name: Transaction
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,
                       a.sno,
                       B.TRANSACTIONNO,
                       d.ModuleName,
                       B.TRANSACTIONDATE,
                       C.PARTYNAME,
                       B.TRANSACTIONAMOUNT,
                       A.MODULETNO,
                       A.MODULECODE,
                       A.REMARK
                  From GSTR1TRANSACTION A, TRANSACTIONFORGSTR1 B, PARTY C, Module d
                 Where A.MODULETNO = B.MODULETNO(+)
                   And B.PARTYCODE = C.PARTYCODE(+)
                   And b.ModuleCode = d.ModuleCode
                   and a.TNO = :P230_TNO
                 Order By B.TRANSACTIONDATE, B.TRANSACTIONNO
                
                ```
            pageItemsToSubmit: P230_TNO
        }
        layout {
            sequence: 10
            parentRegion: @gstr1-detail
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
