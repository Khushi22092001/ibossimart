    dynamicAction get-record (
        name: get record
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @getrecord
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    
                    if nvl(getMyParameterValue('GSTRETURNSSTATEWISE'), 'NO') = 'YES' then
                    	insert into GSTR1Transaction(TNo, SNO, ModuleCode, ModuleTNo) 
                    			select
                    					:P230_TNo,
                    					globaltno.nextval,
                    					a.ModuleCode,
                    					a.ModuleTNo
                    			from TRANSACTIONFORGSTR1 a, Location b, Location c
                    			where A.TRANSACTIONDATE BETWEEN :P230_FROMDATE AND :P230_TODATE
                    					and a.CompanyCode = :global_CompanyCode
                    					and a.Locationcode = b.LocationCode
                    					and c.LocationCode = :P230_LocationCode		   							
                    					and b.StateCode = c.StateCode
                    					and (a.LocationCode = :P230_LocationCode or :P230_LocationWise = 'NO' )		   							
                    				    AND NOT EXISTS ( SELECT AA.MODULETNO FROM GSTR1TRANSACTION AA WHERE AA.MODULETNO = A.MODULETNO)
                    		;   				
                    else
                    	insert into GSTR1Transaction(TNo, SNO, ModuleCode, ModuleTNo) 
                    			select
                    					:P230_TNo,
                    					globaltno.nextval,
                    					a.ModuleCode,
                    					a.ModuleTNo
                    			from TRANSACTIONFORGSTR1 a
                    			where A.TRANSACTIONDATE BETWEEN :P230_FROMDATE AND :P230_TODATE
                    					and a.CompanyCode = :global_CompanyCode
                    					and (a.LocationCode = :P230_LocationCode or nvl(:P230_LocationWise,'NO') = 'NO' )		   							
                    						AND NOT EXISTS ( SELECT AA.MODULETNO FROM GSTR1TRANSACTION AA WHERE AA.MODULETNO = A.MODULETNO)
                    		;
                    end if;
                    			
                    ```
                itemsToSubmit: [
                    P230_TNO
                    P230_LOCATIONCODE
                    P230_FORMSTATUS
                    P230_FROMDATE
                    P230_TODATE
                    P230_LOCATIONWISE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @transaction
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 350
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                                 if :P230_STATUS = 'ACTIVE' then
                            
                                    CREATEPAYMENTADVICEFORPO(:P230_TNO);
                    
                                  end if;
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P230_TNO
                    P230_COMPANYCODE
                    P230_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P230_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

