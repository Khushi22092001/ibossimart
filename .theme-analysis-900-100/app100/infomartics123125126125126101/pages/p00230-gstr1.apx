    process delete-records-from-child-table (
        name: delete records from child table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Delete From GSTR1B2B Where tno = :P230_TNO;
                Delete From gstr1at Where tno = :P230_TNO;
                Delete From gstr1atadj Where tno = :P230_TNO;
                Delete From gstr1b2cl Where tno = :P230_TNO;
                Delete From gstr1b2cs Where tno = :P230_TNO;
                Delete From gstr1cdnr Where tno = :P230_TNO;
                Delete From gstr1cdnur Where tno = :P230_TNO;
                Delete From gstr1docs Where tno = :P230_TNO;
                Delete From gstr1exemp Where tno = :P230_TNO;
                Delete From gstr1exp Where tno = :P230_TNO;
                Delete From gstr1hsn Where tno = :P230_TNO;
                Delete From gstr1transaction Where tno = :P230_TNO;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 75607549150098160
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process delete-unsaved-data-from-gstr1detail (
        name: delete unsaved data from gstr1detail
        type: executeCode
        source {
            plsqlCode: "delete from GSTR1TRANSACTION a where not exists ( select 1 from gstr1 aa where a.tno = aa.tno); "
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 75607178945098159
        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P230_Tno is null then
                        Select GlobalTno.NextVal into :P230_Tno From Dual;
                     end if;
                    ----
                    if :P230_GSTR1NO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P230_LocationCode,
                					:P230_DocTypeCode,
                					NULL,
                					TO_DATE(:P230_GSTR1DATE, 'DD-MM-RRRR')
                				);
                        :P230_GSTR1NO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P230_LocationCode,
                                    :P230_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P230_GSTR1DATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 75606722072098159
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P230_TNO is null then
                    :P230_TNO := GlobalTNo.nextval;
                    :P230_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P230_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P230_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P230_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 75605508273098159
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P230_MODULEFLOW := 'YES';
                   else
                       :P230_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P230_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P230_ONTHETABLE := 'YES' ;
                   else
                       :P230_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 75605964290098159
        }
    )

