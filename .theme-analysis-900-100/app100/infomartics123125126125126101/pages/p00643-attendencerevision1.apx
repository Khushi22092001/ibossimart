    process insert-into-attendencerevisiondetail (
        name: insert into ATTENDENCEREVISIONDETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                delete from ATTENDENCEREVISIONDETAIL where tno = :P643_TNO;
                for i in (
                    select 
                        tno,
                        sno
                    from ATTENDENCEREVISIONATTENDENCE
                    where tno = :P643_TNO
                    and NEWATTENDENCEHEADCODE is not null
                )
                loop
                    insert into ATTENDENCEREVISIONDETAIL
                    (
                        tno,
                        sno,
                        ATTENDENCEHEADCODE,
                        ATTENDENCEVALUE,
                        remark
                    )
                    (
                        select x.tno , globaltno.nextval , x.a, x.b, x.remark from 
                        (
                        SELECT
                            tno as tno,
                            oldattendenceheadcode as a,
                            - 1 * oldattendencevalue as b,
                            remark
                        FROM
                            attendencerevisionattendence
                        WHERE
                            tno = i.tno  
                            and sno = i.sno
                        UNION ALL
                        SELECT
                            tno as tno,
                            newattendenceheadcode as a,
                            newattendencevalue as b,
                            remark 
                        FROM
                            attendencerevisionattendence
                        WHERE
                            tno = i.tno  
                            and sno = i.sno 
                        ) x
                    );
                end loop;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 46577696433804607
        }
    )

