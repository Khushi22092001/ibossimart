    process attendencerevisiondetail-save-interactive-grid-data (
        name: ATTENDENCEREVISIONDETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @attendencerevisiondetail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                           IF :SNO IS NULL then
                                select globaltno.nextval into :SNO from dual;
                           end if;
                            Insert Into ATTENDENCEREVISIONDETAIL ( 
                                        TNO,      
                                        SNO,
                                        SERIALNO,
                                        ATTENDENCEHEADCODE,
                                        ATTENDENCEVALUE,
                                        REMARK 
                            )
                            Values (
                                        :TNO,        
                                        :SNO,
                                        :SERIALNO,
                                        :ATTENDENCEHEADCODE,
                                        :ATTENDENCEVALUE,
                                        :REMARK  
                             );
                  
                        when 'U' then
                            update  ATTENDENCEREVISIONDETAIL Set
                                        TNO = :TNO,      
                                        SNO  = :SNO,
                                        SERIALNO = :SERIALNO,
                                        ATTENDENCEHEADCODE = :ATTENDENCEHEADCODE,
                                        ATTENDENCEVALUE = :ATTENDENCEVALUE,
                                        REMARK = :REMARK
                            WHERE TNO = :P643_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From  ATTENDENCEREVISIONDETAIL
                            Where TNo = :P643_TNO
                              and SNO = :SNO
                              ;
                    
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 24083401179815214
        }
    )

