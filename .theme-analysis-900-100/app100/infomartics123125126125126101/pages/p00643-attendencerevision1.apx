    dynamicAction get-attnrevision (
        name: GET_ATTNREVISION
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
            button: @get-attendancerev
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    INSERT INTO ATTENDENCEREVISIONATTENDENCE
                                (
                                TNO,
                                SNO,
                                ATTENDENCEDATE,
                                OLDATTENDENCEHEADCODE,
                                OLDATTENDENCEVALUE
                                )
                    SELECT  
                            :P643_TNO,
                            globaltno.nextval,
                            H.ATTENDENCEDATE,
                            D.ATTENDENCEHEADCODE,
                            D.ATTENDENCEVALUE
                    FROM  ATTENDENCE H,ATTENDENCEDETAIL D
                    WHERE H.TNO=D.TNO
                    AND H.LOCATIONCODE=:P643_LOCATIONCODE
                    AND H.DOCTYPECODE=:P643_DOCTYPECODE
                    AND D.EMPLOYEECODE = :P643_EMPLOYEECODE
                    AND H.ATTENDENCEDATE BETWEEN :P643_REVISIONFORFROMDATE AND :P643_REVISIONFORTODATE
                    AND D.ATTENDENCEHEADCODE IS NOT NULL;
                    ```
                itemsToSubmit: [
                    P643_LOCATIONCODE
                    P643_DOCTYPECODE
                    P643_TNO
                    P643_REVISIONFORFROMDATE
                    P643_REVISIONFORTODATE
                    P643_EMPLOYEECODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attendencerevisionattendence
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

