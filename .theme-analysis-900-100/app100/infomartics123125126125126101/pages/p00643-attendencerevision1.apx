    dynamicAction delete-detail-data (
        name: Delete detail data
        execution {
            sequence: 160
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from ATTENDENCEREVISIONDETAIL a
                        where not exists (
                            select 1 from ATTENDENCEREVISION  aa  
                            where aa.tno = a.tno
                        );
                        
                    delete from ATTENDENCEREVISIONATTENDENCE a
                        where not exists (
                            select 1 from ATTENDENCEREVISION  aa  
                            where aa.tno = a.tno
                        );
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

