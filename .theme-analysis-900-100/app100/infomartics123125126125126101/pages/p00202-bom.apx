    dynamicAction set-page-item-value (
        name: Set Page item Value
        execution {
            sequence: 150
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail
            columns: VALUEPERCENT
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("VALUEPERCENT");
                    
                    var totalAmt = 0;
                    
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                     
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                    
                    });
                    
                    $s("P202_TOTALVALUE", totalAmt);
                    
                    	
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :VALUEPERCENT
                itemsToSubmit: VALUEPERCENT
            }
            affectedElements {
                selectionType: items
                items: P202_TOTALVALUE
            }
            execution {
                sequence: 10
            }
        )

    )

