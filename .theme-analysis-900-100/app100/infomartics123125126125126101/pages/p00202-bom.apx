                sequence: 150
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: BOMCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column HIGHERTOLERANCEPERCENT (
