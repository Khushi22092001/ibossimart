                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

            displayColumn (
                column: @UNIT1
                layout {
                    width: 73
                    sequence: 10
                }
            )

            displayColumn (
                column: @UNIT2
                layout {
                    width: 75
                    sequence: 12
                }
            )

        )

        columnGroup primary (
            heading: Primary
        )

        columnGroup secondary (
            heading: Secondary
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
