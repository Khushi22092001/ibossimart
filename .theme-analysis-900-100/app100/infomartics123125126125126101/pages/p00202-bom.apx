    dynamicAction fail (
        name: Fail
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @fail
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    		cursor cPassFail is
                    				select
                    						a.TNo,
                    						a.TokenNo										
                    				from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    				where a.ModuleFlowTNo = b.TNo
                    						and b.TNo = c.TNo
                    						and a.BossUserCode = c.BossUserCode
                    						and c.BossUserCode = d.BossUserCode
                    						and a.ModuleTNo = ':P'||to_char(:APP_PAGE_ID)||'_TNo'
                    						and d.LoginName = User
                    						and a.isPass is null
                    						and a.IsFail is null
                    						and a.IsForwarded is null
                    						and a.IsRebounded is null																				
                    		;
                    		vPassFail cPassFail%rowtype;
                        
                        tTokenNo NUMBER;
                        TMP VARCHAR2(100) := :P60_TNO;
                    begin
                    		open cPassFail;
                    		fetch cPassFail into vPassFail;
                    		if cPassFail%FOUND then
                    				tTokenNo := vPassFail.TokenNo;
                    				close cPassFail;
                    
                               	
                    				update PassFail a
                    				set a.IsFail = 'YES',
                    						a.remark = ':P'||to_char(:APP_PAGE_ID)||'_PASSFAILREMARK'
                    				where a.TNo = vPassFail.TNo;
                    				
                    				SendBackPassFail(tTokenNo , TMP );
                    		    		
                    				
                    				commit;
                    		else
                    				close cPassFail;
                    		end if;
                    
                    	
                    end;
                    ```
                itemsToSubmit: [
                    P202_TNO
                    P202_COMPANYCODE
                    P202_PURCHASEORDERNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @buttons
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P202_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction go-back-to-called-form (
        name: Go Back To Called Form
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P202_CALLEDFROMPAGE').getValue();
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction initialize-sno (
        name: Initialize SNO
        execution {
            sequence: 130
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @detail
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    Declare
                    mysno number;
                    Begin
                    If :SNO is null then
                        Select GlobalTNo.nextval into mysno from dual;
                    else MYSNO := :SNO;
                    end if;
                    return mysno;
                    end;
                    ```
                itemsToSubmit: SNO
            }
            affectedElements {
                selectionType: columns
                columns: SNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

