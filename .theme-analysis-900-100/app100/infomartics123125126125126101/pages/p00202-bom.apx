page 202 (
    name: BOM
    alias: BOM
    title: BOM
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bom (
        name: BOM
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       BOMCODE,
                       BOMNAME,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       REMARK,
                       CREATOR,
                       MAJORITEMCODE,
                       MAJORITEMSPECIFICATIONCODE,
                       PROJECTTNO,
                       MAJORTASKSNO,
                       WBDSCODE,
                       TASKNATURECODE,
                       BOMTYPECODE,
                       LOCATIONCODE,
                       EFFECTIVEDATE,
                       REFERENCEBOMCODE,
                       CREATIONTIME,
                       COMPANYCODE,
                       VALUEPERCENT
                  from BOM
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 20
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       SERIALNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       QUANTITY1,
                       QUANTITY2,
                       REMARK,
                       LOWERTOLERANCEPERCENT,
                       HIGHERTOLERANCEPERCENT,
                       VALUEPERCENT,
                       BOMCODE,
                       GetMeasuringUnitNameFromItem(ITEMCODE) as Unit1,
                       GetMeasuringUnit2NameFromItem(ITEMCODE) as Unit2
                  from BOMDETAIL
                  where tno = :P202_TNO
                ```
            pageItemsToSubmit: P202_TNO
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 4228701964915644
        }

        savedReport 46529 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
