    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into BOMDETAIL (                 
                                    TNO,
                                    SNO,
                                    SERIALNO,
                                    ITEMCODE,
                                    ITEMSPECIFICATIONCODE,
                                    QUANTITY1,
                                    QUANTITY2,
                                    REMARK,
                                    LOWERTOLERANCEPERCENT,
                                    HIGHERTOLERANCEPERCENT,
                                    VALUEPERCENT,
                                    BOMCODE
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :SERIALNO,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :QUANTITY1,
                                :QUANTITY2,
                                :REMARK,
                                :LOWERTOLERANCEPERCENT,
                                :HIGHERTOLERANCEPERCENT,
                                :VALUEPERCENT,
                                :BOMCODE
                
                            );
                        
                        when 'U' then
                            update BOMDETAIL Set
                                    TNO=:TNO,
                                    SNO=:SNO,
                                    SERIALNO=:SERIALNO,
                                    ITEMCODE=:ITEMCODE,
                                    ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                    QUANTITY1=:QUANTITY1,
                                    QUANTITY2=:QUANTITY2,
                                    REMARK=:REMARK,
                                    LOWERTOLERANCEPERCENT=:LOWERTOLERANCEPERCENT,
                                    HIGHERTOLERANCEPERCENT=:HIGHERTOLERANCEPERCENT,
                                    VALUEPERCENT=:VALUEPERCENT,
                                    BOMCODE=:BOMCODE
                
                
                            WHERE TNO = :P202_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From BOMDETAIL
                            Where TNo = :P202_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 4648174362305810
        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'BOM';
                    tmp         number ;
                begin
                     if :P202_Tno is null then
                        Select GlobalTno.NextVal into :P202_Tno From Dual;
                     end if;
                    ----
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P202_BOMCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P202_BOMCODE := getCode(tModuleCode) ;
                     end if;
                    
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 4601290518070353
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P202_TNO is null then
                    :P202_TNO := GlobalTNo.nextval;
                    :P202_FORMSTATUS := 'NEWRECORD';
                else
                    :P202_FORMSTATUS := 'EDITRECORD';
                End if;
                
                :P202_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P202_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4574660640028325
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P202_MODULEFLOW := 'YES';
                   else
                       :P202_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P202_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P202_ONTHETABLE := 'YES' ;
                   else
                       :P202_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4574963899029219
        }
    )

