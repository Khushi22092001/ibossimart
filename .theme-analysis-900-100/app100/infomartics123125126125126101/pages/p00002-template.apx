page 2 (
    name: Template
    alias: TEMPLATE
    title: Template
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region flow-button (
        name: Flow Button
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    pageItem P2_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @flow-button
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P2_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @flow-button
            slot: regionBody
        }
    )

    pageItem P2_MODULEFLOW (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @flow-button
            slot: regionBody
        }
    )

    pageItem P2_ONTHETABLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @flow-button
            slot: regionBody
        }
    )

    pageItem P2_PASSFAILREMARK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @flow-button
            slot: regionBody
        }
    )

    pageItem P2_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @flow-button
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P2_TNO1), 'Status')
        }
    )

    pageItem P2_STATUSRIGHT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @flow-button
            slot: regionBody
        }
    )

    pageItem P2_TNO1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @flow-button
            slot: regionBody
        }
    )

    button cancel (
        buttonName: Cancel
        label: Cancel
        layout {
            sequence: 70
            region: @flow-button
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: Create
        label: Create
        layout {
            sequence: 110
            region: @flow-button
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: item=value
            item: P2_FORMSTATUS
            value: NEWRECORD
        }
    )

    button delete (
        buttonName: Delete
        label: Delete
        layout {
            sequence: 90
            region: @flow-button
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-trash-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: Are you sure?
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P2_FORMSTATUS
            value: EDITRECORD
        }
    )

    button fail (
        buttonName: Fail
        label: Fail
        layout {
            sequence: 20
            region: @flow-button
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-thumbs-o-down
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: item=value
            item: P2_FORMSTATUS
            value: EDITRECORD
        }
    )

    button flow (
        buttonName: Flow
        label: Flow
        layout {
            sequence: 30
            region: @flow-button
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pill
            ]
            icon: fa-workflow
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                items: {
                    P162_TNO: &P2_TNO1.
                }
                clearCache: 162
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P2_FORMSTATUS
            value: EDITRECORD
        }
    )

    button pass (
        buttonName: Pass
        label: Pass
        layout {
            sequence: 10
            region: @flow-button
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-thumbs-o-up
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: item=value
            item: P2_FORMSTATUS
            value: EDITRECORD
        }
    )

    button print (
        buttonName: Print
        label: Print
        layout {
            sequence: 60
            region: @flow-button
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pill
            ]
            icon: fa-print
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: item=value
            item: P2_FORMSTATUS
            value: EDITRECORD
        }
    )

    button save (
        buttonName: Save
        label: Apply Changes
        layout {
            sequence: 100
            region: @flow-button
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P2_FORMSTATUS
            value: EDITRECORD
        }
    )

    button status (
        buttonName: Status
        label: Status
        layout {
            sequence: 40
            region: @flow-button
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-comments-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 164
                clearCache: 164
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P2_FORMSTATUS
            value: EDITRECORD
        }
    )

    dynamicAction alert (
        name: alert
        execution {
            sequence: 110
        }
        when {
            event: click
            selectionType: button
            button: @print
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.message.alert("Your alert message goes here.");
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction alert-2 (
        name: alert_1
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: button
            button: @print
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                      -- Your PL/SQL logic here
                      
                      -- Display an alert using JavaScript
                      htp.p('apex.message.alert("Your alert message goes here.");');
                    END;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction back-page (
        name: Back Page
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P2_CALLEDFROMPAGE').getValue();
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

