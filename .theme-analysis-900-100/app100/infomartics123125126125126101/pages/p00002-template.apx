    process get-form-status-and-tno (
        name: Get Form Status and TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :APP_PAGE_ID = 2 then
                        :P2_TNO1 := 2;
                    else
                        :P2_TNO1 := null;
                    end if;
                
                    -- select :P100_TNO into :P2_TNO1 from Dual;   Storing value of Page TNO Into Template TNO1.
                
                    if :P2_TNO1 is null then
                        :P2_FORMSTATUS := 'NEWRECORD';
                    else
                        :P2_FORMSTATUS := 'EDITRECORD';
                    end if;
                
                    /*if :p100_tno is null then
                
                        select globaltno.nextval into :p100_tno from dual;
                
                    end if; */
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 133717820407714607
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P2_MODULEFLOW := 'YES';
                   else
                       :P2_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P2_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P2_ONTHETABLE := 'YES' ;
                   else
                       :P2_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 133717971760714608
        }
    )

    process prepare-url (
        name: PREPARE_URL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   result varchar2(2000);
                begin
                   result:=apex_util.prepare_url(apex_application.g_x01);
                   apex_json.open_object;
                   apex_json.write('success', true);
                   apex_json.write('url', result);
                   apex_json.close_object;
                exception
                 when others then
                   apex_json.open_object;
                   apex_json.write('success', false);
                   apex_json.write('message', sqlerrm);
                   apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 133720427363714633
        }
    )

