    dynamicAction validate-stock-quantity (
        name: validate  stock quantity
        execution {
            sequence: 200
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @stock-detail
            columns: QUANTITY1
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      stockqty  number;
                      allocateqty number;
                    begin
                        allocateqty := :quantity1;
                         select sum(stockquantity1) - sum(usedstockquantity1) into stockqty 
                         from stock where tno = :STOCKTNO;
                    
                         if nvl(stockqty,0) > allocateqty then
                              :QUANTITY1 := allocateqty ;
                         else
                              :quantity1 := stockqty ;
                              raise_application_error ( -20000,' Stock Quantity is Less Than Allocated Quantity');
                         end if;
                    end;
                    ```
                itemsToSubmit: [
                    STOCKTNO
                    QUANTITY1
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

