    process validate-stock-transfer-quantity-and-stock-allocated-quantity (
        name: Validate Stock Transfer Quantity and Stock Allocated Quantity
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tmp number;
                    tmp1 number;
                    tmp2 number;
                begin
                --raise_application_error(-20001 , 'Input Quantity and Stock Quantity Not Matching.');
                  for vloop in ( select tno,sno,sum(quantity1) as Quantity1 from STOCKTRANSFERDETAIL  where tno = :P187_TNO GROUP BY TNO,SNO) LOOP
                           tmp1 := vloop.Quantity1 ;
                     
                           select sum(quantity1) into tmp2  from STOCKTRANSFERSTOCKSTDETAIL where tno = vloop.tno and sno = vloop.sno ;
                 
                        if nvl(tmp1,0) <> nvl(tmp2,0) then
                               raise_application_error(-20000 , 'Transfer Detail Quantity Not Matching with Allocated Quantity');
                       end if;
                  END LOOP;
                  
                end;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 10354119623968814
        }
        serverSideCondition {
            type: requestIsNotContainedInValue
            value: DELETE
        }
    )

