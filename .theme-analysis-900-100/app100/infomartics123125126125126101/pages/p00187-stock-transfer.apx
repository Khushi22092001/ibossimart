    process detail-save-interactive-grid-data (
        name: DETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into STOCKTRANSFERDETAIL  (                 
                                    TNO,
                                    SNO,
                                    SERIALNO,
                                    ITEMCODE,
                                    ITEMSPECIFICATIONCODE,
                                    DESCRIPTION,
                                    COMPANYCODE,
                                    STORAGELOCATIONCODE,
                                    WORKORDERTNO,
                                    QUANTITY1,
                                    QUANTITY2,
                                    REMARK,
                                    INITIALDIP,
                                    FINALDIP
                
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :SERIALNO,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :DESCRIPTION,
                                :COMPANYCODE,
                                :STORAGELOCATIONCODE,
                                :WORKORDERTNO,
                                :QUANTITY1,
                                :QUANTITY2,
                                :REMARK,
                                :INITIALDIP,
                                :FINALDIP
                
                            );
                        
                        when 'U' then
                            update STOCKTRANSFERDETAIL  Set
                                 TNO=:TNO,
                                SNO=:SNO,
                                SERIALNO=:SERIALNO,
                                ITEMCODE=:ITEMCODE,
                                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                DESCRIPTION=:DESCRIPTION,
                                COMPANYCODE=:COMPANYCODE,
                                STORAGELOCATIONCODE=:STORAGELOCATIONCODE,
                                WORKORDERTNO=:WORKORDERTNO,
                                QUANTITY1=:QUANTITY1,
                                QUANTITY2=:QUANTITY2,
                                REMARK=:REMARK,
                                INITIALDIP=:INITIALDIP,
                                FINALDIP=:FINALDIP
                
                            WHERE TNO = :P187_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From STOCKTRANSFERDETAIL 
                            Where TNo = :P187_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 173220017041762201
        }
    )

