    region detail (
        name: DETAIL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.rowid,
                       A.TNO,
                       A.SNO,
                       A.SERIALNO,
                       A.ITEMCODE,
                       A.ITEMSPECIFICATIONCODE,
                       A.DESCRIPTION,
                       A.COMPANYCODE,
                       A.STORAGELOCATIONCODE,
                       A.WORKORDERTNO,
                       A.QUANTITY1,
                       A.QUANTITY2,
                       A.REMARK,
                       A.INITIALDIP,
                       A.FINALDIP,
                       'SD' as SD
                  from STOCKTRANSFERDETAIL A
                where a.tno = :p187_TNO
                  
                ```
            pageItemsToSubmit: P187_TNO
        }
        layout {
            sequence: 20
            slot: body
        }
