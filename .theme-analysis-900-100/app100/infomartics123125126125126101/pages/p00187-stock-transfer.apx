    region stock-transfer (
        name: Stock Transfer
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       STOCKTRANSFERNO,
                       STOCKTRANSFERDATE,
                       EMPLOYEECODE,
                       FINANCIALYEARCODE,
                       COMPANYCODE,
                       REMARK,
                       CREATOR,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       VEHICLENO,
                       TRANSPORTERCODE,
                       LRNO,
                       LRDATE,
                       FREIGHT,
                       CREATIONTIME,
                       MODULECODE,
                       MODULETNO,
                       NVL(getdocumentstatuscode(getmodulecodeforpageno(:APP_PAGE_ID),TNO),'STATUS') AS STATUS
                
                  from STOCKTRANSFER
                ```
            pageItemsToSubmit: P187_TNO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
