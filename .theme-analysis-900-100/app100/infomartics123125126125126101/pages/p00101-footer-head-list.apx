page 101 (
    name: Footer Head List
    alias: FOOTER-HEAD-LIST
    title: Footer Head List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region footer-head-list (
        name: Footer Head List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.FOOTERHEADCODE,
                       A.FOOTERHEADNAME,
                       A.POSTFIX,
                       A.REMARK,
                       A.FOOTERPOSTFIX,
                       A.FOOTERHEADTYPECODE,
                       A.PARENTCODE,
                       A.INCLUDEDWITHRATE,
                       A.CREATOR,
                       A.FOOTERGROUP,
                       A.INCLUDEWITHTAXABLEAMOUNT,
                       A.LESSFROMBILLAMOUNTFORTAXABLE,
                       to_char(A.CREATIONTIME,'DD-MON-YYYY HH24:MI:SS') CREATIONTIME,
                       A.ISTAXCODE
                  from FOOTERHEAD A
                  Order By A.TNO DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 102
                items: {
                    P102_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 146675511657196237
        }

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 25
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column FOOTERGROUP (
            type: plainText
            heading {
                heading: Footer Group
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column FOOTERHEADCODE (
            type: plainText
            heading {
                heading: Footer Head Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column FOOTERHEADNAME (
            type: plainText
            heading {
                heading: Footer Head Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FOOTERHEADTYPECODE (
            type: plainText
            heading {
                heading: Footer Head Typecode
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column FOOTERPOSTFIX (
            type: plainText
            heading {
                heading: Footer Postfix
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column INCLUDEDWITHRATE (
            type: plainText
            heading {
                heading: Included With Rate
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column INCLUDEWITHTAXABLEAMOUNT (
            type: plainText
            heading {
                heading: Include With Taxable Amount
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ISTAXCODE (
            type: plainText
            heading {
                heading: Is Taxcode
            }
            layout {
                sequence: 15
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column LESSFROMBILLAMOUNTFORTAXABLE (
            type: plainText
            heading {
                heading: Less From Bill Amount For Taxable
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column PARENTCODE (
            type: plainText
            heading {
                heading: Parent Code
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column POSTFIX (
            type: plainText
            heading {
                heading: Postfix
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Footer Head List
        }

        savedReport 1467265 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATIONTIME (
                sequence: 15
            )

            displayColumn CREATOR (
                sequence: 10
            )

            displayColumn FOOTERGROUP (
                sequence: 11
            )

            displayColumn FOOTERHEADCODE (
                sequence: 2
            )

            displayColumn FOOTERHEADNAME (
                sequence: 3
            )

            displayColumn FOOTERHEADTYPECODE (
                sequence: 7
            )

            displayColumn FOOTERPOSTFIX (
                sequence: 6
            )

            displayColumn INCLUDEDWITHRATE (
                sequence: 9
            )

            displayColumn INCLUDEWITHTAXABLEAMOUNT (
                sequence: 12
            )

            displayColumn ISTAXCODE (
                sequence: 14
            )

            displayColumn LESSFROMBILLAMOUNTFORTAXABLE (
                sequence: 13
            )

            displayColumn PARENTCODE (
                sequence: 8
            )

            displayColumn POSTFIX (
                sequence: 4
            )

            displayColumn REMARK (
                sequence: 5
            )

            displayColumn TNO (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @footer-head-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 102
                clearCache: 102
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @footer-head-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @footer-head-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @footer-head-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @footer-head-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

