lov p242-chequeno (
    name: P242_CHEQUENO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select
            b.ChequeNo d,
            b.ChequeNo r
            From ChequeBookIssue a, ChequeBookIssueDetail b, BossUser c,
            DocumentStatusDetail dsd
            Where a.Tno=b.Tno
            and a.Tno=dsd.ModuleTno(+)
            and dsd.DocumentStatusCode='ACTIVE'
            and a.BossUserCode=c.BossUserCode
            and c.LoginName=:GLOBAL_LOGINNAME
            and not exists(Select 1 
            	       From RtgsLetter aa
            	       Where aa.ChequeNo=b.ChequeNo
            		   and aa.Creator=c.LoginName
            	      )
            and not exists(
            		select
            			aa.TNO
            		from LoanSanction aa
            		where aa.CreditAccountCode = :P242_AccountCode
            			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)
            		
            	and not exists(
            		select
            			aa.TNO
            		from PaymentAdvice aa
            		where aa.AccountCode = :P242_AccountCode
            			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)
            		
            	and not exists(
            		select
            			aa.TNO
            		from Challan aa
            		where aa.AccountCode = :P242_AccountCode
            			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)		
            	/*and not exists(
            		select
            			aa.TNO
            		from TDSChallanDetail aa
            		where aa.AccountCode = :P242_AccountCode
            			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)			
            	*/
            	and not exists(
            		select
            			aa.TNO
            		from FreightAdvice aa
            		where aa.CreditAccountCode = :P242_AccountCode
            			and nvl(aa.MoneyTransferModeCode, 'fd23S') in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)	
            and a.LocationCode=:P242_LocationCode
            UNION ALL
            Select
            b.ChequeNo d,
            b.ChequeNo r
            From ChequeReceipt a, ChequeReceiptDetail b, DocumentStatusDetail dsd
            where a.Tno=b.Tno
            and a.Tno=dsd.ModuleTno
            and dsd.DocumentStatusCode='ACTIVE'
            and a.Creator=User
            and not exists(Select 1 
            	       From RtgsLetter aa
            	       Where aa.ChequeNo=b.ChequeNo
                      		and aa.Creator=User
            	      )
            and not exists(
            		select
            			aa.TNO
            		from LoanSanction aa
            		where aa.CreditAccountCode = :P242_AccountCode
            			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)
            	
            	and not exists(
            		select
            			aa.TNO
            		from PaymentAdvice aa
            		where aa.AccountCode = :P242_AccountCode
            			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)
            	
            	and not exists(
            		select
            			aa.TNO
            		from Challan aa
            		where aa.AccountCode = :P242_AccountCode
            			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)		
            	/*and not exists(
            		select
            			aa.TNO
            		from TDSChallanDetail aa
            		where aa.AccountCode = :P242_AccountCode
            			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)			
            	*/
            	and not exists(
            		select
            			aa.TNO
            		from FreightAdvice aa
            		where aa.CreditAccountCode = :P242_AccountCode
            			and nvl(aa.MoneyTransferModeCode, 'fd23S') in ('CH', 'CHEQUE')
            			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
            			and aa.MONEYTRANSFERREFERENCENO  is not null
            	)	
            Order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov p242-paymentadviceno (
    name: P242_PAYMENTADVICENO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select
            a.Tno as PaymentAdviceTno,
            a.PaymentAdviceNo,
            a.paymentadvicedate,
            a.AmountDr,
            b.PartyName,
            A.ChequePRINTNAME,
            c.PartyTypeName,
            getlocationname(a.locationcode) as LocationName,
            a.LocationCode
            From PaymentAdvice a, Party b, PartyType c, DocumentStatusDetail dsd
            Where a.PartyCode=b.PartyCode
            and b.PartyTypeCode=c.PartyTypeCode
            and a.Tno=dsd.ModuleTno
            and dsd.DocumentStatusCode='ACTIVE'
            and a.AccountCode=:P242_AccountCode
            -- remarked on 11-sep-2024
            --and a.LocationCode=:P242_LocationCode
            and a.MoneyTransferModeCode=:P242_MoneyTransferModeCode
            and getcompanyprivilege(A.COMPANYCODE,GETMODULECODEFORPAGENO(:APP_PAGE_ID),:GLOBAL_LOGINNAME)='YES'
            and ( :P242_FORMSTATUS = 'EDITRECORD' 
                    or
                    not exists(Select 1
            	       From RtgsLetterDetail aa
            	       Where aa.PaymentAdviceTno=a.Tno
            	       )
            )
            Order by a.PaymentAdviceNo
            ```
    }
    columnMapping {
        return: PAYMENTADVICETNO
        display: PAYMENTADVICENO
    }

