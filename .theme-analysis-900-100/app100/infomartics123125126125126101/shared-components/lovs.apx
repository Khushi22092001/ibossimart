            -- 	and a1.PartyTypeCode not in ('ACCOUNTGROUP','ACCOUNT')	
            -- 	and getNatureDocTypeCode('GATEPASS', :P195_DocTypeCode) != 'REPAIRINGJOBOUTOFPREMISES'
            
