lov 155-nameofvendor (
    name: 155_NAMEOFVENDOR
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select partyname , partycode , getcityname(officecitycode) as city from party
            where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
            AND PARTYTYPECODE IN ('TRANSPORTER','CONTRACTOR')
            ```
    }
    columnMapping {
        return: PARTYCODE
        display: PARTYNAME
        defaultSort: PARTYNAME
    }

    column CITY (
        heading {
            heading: City
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column PARTYCODE (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
        advanced {
            searchable: false
        }
    )

    column PARTYNAME (
        heading {
            heading: Party
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

)

lov 155-supplier (
    name: 155_SUPPLIER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select partyname , partycode , getcityname(officecitycode) as city , officecitycode from party     
            where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
            AND PARTYTYPECODE IN ('SUPPLIER' , 'AGENT')
            and :P155_DOCTYPECODE != 'SALERETURN'
            union all
            select partyname , partycode , getcityname(officecitycode) as city, officecitycode from party     
            where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
            AND PARTYTYPECODE IN ('CUSTOMER')
            and :P155_DOCTYPECODE = 'SALERETURN'
            ```
    }
    columnMapping {
        return: PARTYCODE
        display: PARTYNAME
        defaultSort: PARTYNAME
    }

    column CITY (
        heading {
            heading: City
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column OFFICECITYCODE (
        show: false
        heading {
            heading: Officecitycode
        }
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
    )

    column PARTYCODE (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
        advanced {
            searchable: false
        }
    )

    column PARTYNAME (
        heading {
            heading: Party
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

)

