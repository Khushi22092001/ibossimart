        }
    )

    column QUOTATIONNO (
        heading {
            heading: Quotation No
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column TNO (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

)

