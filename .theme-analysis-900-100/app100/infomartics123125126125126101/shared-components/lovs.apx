              and a.CompanyCode = :Global_CompanyCode
              And Nvl(b.stockquantity1,0) - Nvl(b.usedstockquantity1,0) - Nvl(b.reservestockquantity1,0) > 0
              And A.ITEMCODE = :P187_ITEMCODE
