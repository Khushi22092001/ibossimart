lov p274-salesquotation (
    name: P274_SALESQUOTATION
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                  a.TNO,
                  a.PARTYQUOTATIONNO,
                  a.PARTYQUOTATIONDATE,
                  a.VALIDITYUPTODATE,
                  a.SALESQUOTATIONNO,
                  a.SALESQUOTATIONDATE,
                  a.SALESQUOTATIONAMOUNT,
                  a.SALESENQUIRYTNO,
                  c.PartyName
            FROM SalesQuotation a, DocumentStatusDetail b, Party c
            where a.TNo = b.ModuleTNo
            and a.PartyCode = c.PartyCode
            and b.Modulecode = 'SALESQUOTATION'
            and b.DocumentStatusCode = 'ACTIVE'
            and a.SalesQuotationDate <= nvl(:P274_PORECEIPTDATE, sysdate)
            and a.ValidityUpToDate >= nvl(:P274_PORECEIPTDATE, sysdate)
            and  a.PartyCode = :P274_PARTYCODE
            and a.CompanyCode = :global_CompanyCode
            order by a.SalesQuotationDate, a.SalesQuotationNo
            ```
    }
    columnMapping {
        return: TNO
        display: SALESQUOTATIONNO
    }

    column SALESQUOTATIONDATE (
        heading {
            heading: Date
        }
        layout {
            sequence: 60
        }
        source {
            dataType: date
        }
    )

    column SALESQUOTATIONNO (
        heading {
            heading: No.
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column TNO (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

)

