lov p69-loadingadvicetno (
    name: P69_LOADINGADVICETNO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select  tno , loadingadviceno , loadingadvicedate from loadingadvice     
            where locationcode = :P69_LOCATIONCODE
            and (SUPPLIERCODE = :P69_PARTYCODE 
            	        Or Exists (Select * 
            	                   From GROUPOFPARTY AA, GROUPOFPARTYDETAIL BB
                                Where AA.TNO = BB.TNO
                                  And BB.PARTYCODE = :P69_PARTYCODE)
            				)
            and  tno not in (select distinct nvl(loadingadvicetno,0) from materialin)
            and (purchaseordertno is not null or doctypecode = 'SALERETURN')
            and JOBORDERTNO is null
            and SALESORDERTNO is null
            union all
            select  tno , loadingadviceno , loadingadvicedate from loadingadvice     
            where locationcode = :P69_LOCATIONCODE
            and (SUPPLIERCODE = :P69_PARTYCODE 
            	        Or Exists (Select * 
            	                   From GROUPOFPARTY AA, GROUPOFPARTYDETAIL BB
                                Where AA.TNO = BB.TNO
                                  And BB.PARTYCODE = :P69_PARTYCODE)
            				)
            and  tno = :P69_LOADINGADVICETNO
            ```
    }
    columnMapping {
        return: TNO
        display: LOADINGADVICENO
    }

    column LOADINGADVICEDATE (
        heading {
            heading: Date
        }
        layout {
            sequence: 30
        }
        source {
            dataType: date
        }
    )

    column LOADINGADVICENO (
        heading {
            heading: Loading Advice No
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column TNO (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

)

lov p69-party (
    name: P69_PARTY
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select partyname , partycode , getcityname(officecitycode) as city from party
            where partytypecode in ('CUSTOMER','SUPPLIER','AGENT','CONTRACTOR')
            and :P69_DOCTYPECODE = 'RETURNGP'
            union all  
            select partyname , partycode , getcityname(officecitycode) as city from party
            where partytypecode in ('SUPPLIER','AGENT')
            and :P69_DOCTYPECODE = 'PURCHASE'
            union all
            select partyname , partycode , getcityname(officecitycode) as city from party
            where partytypecode in ('CONTRACTOR')
            and :P69_DOCTYPECODE = 'CONVERSIONJOBOUTOFPREMISES'
            union all
            select partyname , partycode , getcityname(officecitycode) as city from party
            where partytypecode in ('CUSTOMER','AGENT')
            and :P69_DOCTYPECODE = 'SALERETURN'
            ```
    }
    columnMapping {
        return: PARTYCODE
        display: PARTYNAME
        defaultSort: PARTYNAME
    }

