lov p9994-module (
    name: P9994_MODULE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select aa.MYBOXLABEL,
                   'f?p=&APP_ID.:' || TO_CHAR(aA.PAGENO) || ':&SESSION.:::::' target,
                   aa.MYBOXKEY,
                   aa.pageno,
                   'YES' As is_current,
                   decode(nvl(ICONNAME, 'A'), 'A', '', ICONNAME) image
            From (Select *
                      From myboxtree_apex a
                     Where A.BossUserCode = :GLOBAL_BOSSUSERCODE
                       And A.COMPANYCODE = :GLOBAL_COMPANYCODE
