lov p79-stockallocation (
    name: P79_STOCKALLOCATION
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select 
               a.tno,
               a.stockdate,
               a.stockmodulecode, 
            	 getmoduleno(a.stockmodulecode,a.stockmoduletno) As TransactionNo,
               a.stockmodulecode||'-'||getmoduleno(a.stockmodulecode,a.stockmoduletno)||' Stock Tno : '||to_char(a.tno) as RefNo,
            	 Nvl(a.stockquantity1,0) - Nvl(a.usedstockquantity1,0) - Nvl(a.reservestockquantity1,0) As BalanceQuantity
            From stock a 
            Where a.storagelocationcode = :STORAGELOCATIONCODE
              And A.STOCKDATE <= :P79_CCINVOICEDATE
              and a.LocationCode = :P79_LOCATIONCODE
              and a.CompanyCode = :Global_CompanyCode
            	And Nvl(a.stockquantity1,0) - Nvl(a.usedstockquantity1,0) - Nvl(a.reservestockquantity1,0) > 0
            	And A.ITEMCODE = :P79_DETAILITEMCODE
            UNION ALL
            Select 
               a.tno,
               a.stockdate,
               a.stockmodulecode, 
            	 getmoduleno(a.stockmodulecode,a.stockmoduletno) As TransactionNo,
               a.stockmodulecode||'-'||getmoduleno(a.stockmodulecode,a.stockmoduletno)||' Stock Tno : '||to_char(a.tno) as RefNo,
            	 Nvl(a.stockquantity1,0) - Nvl(a.usedstockquantity1,0) - Nvl(a.reservestockquantity1,0) As BalanceQuantity
            From stock a 
            WHERE A.TNO = :STOCKTNO
             ORDER BY 2,1
            ```
    }
    columnMapping {
        return: TNO
        display: REFNO
        defaultSort: REFNO
    }

    column BALANCEQUANTITY (
        heading {
            heading: Balance Quantity
        }
        layout {
            sequence: 50
        }
        source {
            dataType: number
        }
    )

    column REFNO (
        heading {
            heading: Ref No
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column STOCKDATE (
        heading {
            heading: Stockdate
        }
        layout {
            sequence: 25
        }
        source {
            dataType: date
        }
    )

    column STOCKMODULECODE (
        show: false
        heading {
            heading: Stock Module
        }
        layout {
            sequence: 30
        }
        source {
            dataType: varchar2
        }
    )

    column TNO (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column TRANSACTIONNO (
        show: false
        heading {
            heading: Transaction No
        }
        layout {
            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

)

lov p80-vrreference (
    name: P80_VRREFERENCE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select
              a.TNo as ReferenceTNo,
              a.VoucherNo  as ReferenceNO,
              a.VoucherDate as ReferenceDate,
              b.Amount,
              'VOUCHER' AS MODULECODE,
              c.partyName as AccountName,
              b.AccountCode,
              b.SNO
            From Voucher a, VoucherDetail b, Party c
            Where a.tno = b.tno
              And b.accountcode = c.partycode
              --And b.accountcode = :P156_DETACCOUNTCODE
              And b.amount > 0
            	And :P156_CRDR='C'
                AND NVL(:P156_FORMSTATUS,'NEWRECORD') = 'NEWRECORD'
            	and (
                      abs(b.Amount) > nvl((
                       select
                          sum(abs(aa.amount)) 
                       from DRCRAllocation aa
                       where b.TNo in (aa.DRVoucherTNO, aa.CRVoucherTNo)                
                           and b.SNO in (aa.DRVoucherSNO, aa.CRVoucherSNo)                
                           and not ( 
                            aa.ModuleTNO = :P156_TNo
                            and
                            aa.ModuleCode = 'VOUCHER'
                           )
                           and aa.AccountCode = b.AccountCode
                        
                      ),0)
                   )    
                UNION
                Select
              a.TNo as ReferenceTNo,
              a.VoucherNo  as ReferenceNO,
              a.VoucherDate as ReferenceDate,
              b.Amount,
              'VOUCHER' AS MODULECODE,
              c.partyName as AccountName,
              b.AccountCode,
              b.SNO
            From Voucher a, VoucherDetail b, Party c
            Where a.tno = b.tno
              AND B.ACCOUNTCODE = C.PARTYCODE
              AND :P156_FORMSTATUS='EDITRECORD' 
            ```
    }
    columnMapping {
        return: REFERENCETNO
        display: REFERENCENO
        defaultSort: REFERENCENO
    }

    column ACCOUNTCODE (
        show: false
        heading {
            heading: Accountcode
        }
        layout {
            sequence: 70
        }
        source {
            dataType: varchar2
        }
    )

    column ACCOUNTNAME (
        heading {
            heading: Accountname
        }
        layout {
            sequence: 60
        }
        source {
            dataType: varchar2
        }
    )

    column AMOUNT (
        heading {
            heading: Amount
        }
        layout {
            sequence: 40
        }
        source {
            dataType: number
        }
    )

    column MODULECODE (
        show: false
        heading {
            heading: Modulecode
        }
        layout {
            sequence: 50
        }
        source {
            dataType: varchar2
        }
    )

    column REFERENCEDATE (
        heading {
            heading: Referencedate
        }
        layout {
            sequence: 30
        }
        source {
            dataType: date
        }
    )

    column REFERENCENO (
        heading {
            heading: Referenceno
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column REFERENCETNO (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column SNO (
        heading {
            heading: Sno
        }
        layout {
            sequence: 80
        }
        source {
            dataType: number
        }
    )

