lov 221-jobbill (
    name: 221_JOBBILL
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT 
            	  A.TNO
            	, A.JOBBILLNO
            	, A.PARTYBILLNO
            	, A.JOBBILLDATE 
            FROM JOBBILL A
            WHERE A.PARTYCODE = :P221_PARTYCODE
            AND NOT EXISTS (SELECT 1 FROM JBPASS x WHERE x.JOBBILLTNO = A.TNO)
            
            UNION ALL
            
            SELECT 
            	  A.TNO 
            	, A.JOBBILLNO 
            	, A.PARTYBILLNO
            	, A.JOBBILLDATE 
            FROM JOBBILL A
            WHERE A.PARTYCODE = :P221_PARTYCODE
            AND EXISTS(SELECT 1 FROM JBPASS x WHERE x.TNO = :P221_TNO AND A.TNO = x.JOBBILLTNO);;
            ```
    }
    columnMapping {
        return: TNO
        display: JOBBILLNO
    }

    column JOBBILLDATE (
        heading {
            heading: DATE
        }
        layout {
            sequence: 30
        }
        source {
            dataType: date
        }
    )

    column JOBBILLNO (
        heading {
            heading: JOB BILL NO
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column PARTYBILLNO (
        heading {
            heading: Party Bill No
        }
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
    )

    column TNO (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

)

