lov p138-stockallocation (
    name: P138_STOCKALLOCATION
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select 
               a.tno,
               a.stockdate,
               a.stockmodulecode, 
            	 getmoduleno(a.stockmodulecode,a.stockmoduletno) As TransactionNo,
               a.stockmodulecode||'-'||getmoduleno(a.stockmodulecode,a.stockmoduletno)||' Stock Tno : '||to_char(a.tno) as RefNo,
            	 Nvl(b.stockquantity1,0) - Nvl(b.usedstockquantity1,0) - Nvl(b.reservestockquantity1,0) As BalanceQuantity
            From stock a , stockstoragedetail b
            Where a.tno = b.tno
             and b.storagelocationcode = :P138_STORAGELOCATION
              And A.STOCKDATE <= :P138_ISSUEDATE
             and a.LocationCode = :P138_LOCATIONCODE
              and a.CompanyCode = :Global_CompanyCode
              And Nvl(b.stockquantity1,0) - Nvl(b.usedstockquantity1,0) - Nvl(b.reservestockquantity1,0) > 0
              And A.ITEMCODE = :P138_ITEMCODE
              And A.ITEMSPECIFICATIONCODE = :P138_ITEMSPECIFICATIONCODE
            	
            UNION ALL
            Select 
               a.tno,
               a.stockdate,
               a.stockmodulecode, 
               getmoduleno(a.stockmodulecode,a.stockmoduletno) As TransactionNo,
               a.stockmodulecode||'-'||getmoduleno(a.stockmodulecode,a.stockmoduletno)||' Stock Tno : '||to_char(a.tno) as RefNo,
               Nvl(a.stockquantity1,0) - Nvl(a.usedstockquantity1,0) - Nvl(a.reservestockquantity1,0) As BalanceQuantity
            From stock a 
            WHERE A.TNO = :STOCKTNO
            
             ORDER BY 2,1
            ```
    }
    columnMapping {
        return: TNO
        display: TRANSACTIONNO
    }

    column BALANCEQUANTITY (
        heading {
            heading: Balance
        }
        layout {
            sequence: 60
        }
        source {
            dataType: number
        }
    )

    column REFNO (
        heading {
            heading: Ref No
        }
        layout {
            sequence: 50
        }
        source {
            dataType: varchar2
        }
    )

    column STOCKDATE (
        heading {
            heading: Date
        }
        layout {
            sequence: 30
        }
        source {
            dataType: date
        }
    )

    column STOCKMODULECODE (
        heading {
            heading: Module
        }
        layout {
            sequence: 20
        }
        source {
            dataType: varchar2
        }
    )

    column TNO (
        show: false
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
        advanced {
            searchable: false
        }
    )

    column TRANSACTIONNO (
        heading {
            heading: Transaction
        }
        layout {
            sequence: 40
        }
        source {
            dataType: varchar2
        }
    )

)

