lov formonth (
    name: FORMONTH
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT DISTINCT 
                TO_CHAR(DAYDATE,'Mon-YYYY') AS MONTH,
                TRUNC(DAYDATE,'MM') AS FROMDATE,
                LAST_DAY(DAYDATE) AS TODATE,
                LAST_DAY(DAYDATE)-TRUNC(DAYDATE,'MM')+1 TOTAL_DAYS
            FROM DATELIST
            ```
    }
    columnMapping {
        return: MONTH
        display: MONTH
        defaultSort: MONTH
    }

    column FROMDATE (
        show: false
        heading {
            heading: Fromdate
        }
        layout {
            sequence: 10
        }
        source {
            dataType: date
        }
    )

    column MONTH (
        heading {
            heading: For Month
        }
        layout {
            sequence: 10
        }
        source {
            dataType: varchar2
        }
    )

    column TODATE (
        show: false
        heading {
            heading: Todate
        }
        layout {
            sequence: 20
        }
        source {
            dataType: date
        }
    )

    column TOTAL_DAYS (
        show: false
        heading {
            heading: Total Days
        }
        layout {
            sequence: 10
        }
        source {
            dataType: number
        }
    )

)

