customAttribute attribute_01 (
    apexlangName: tableSelector
    attribute: 1
    name: Table Selector
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: .a-GV-table
    }
    help {
        helpText: The name of the object (class,id etc...) which identifies the table on which the treegrid is going to be initilazed.
    }
)

customAttribute attribute_02 (
    apexlangName: rowSelector
    attribute: 2
    name: Row Selector
    validation {
        required: true
    }
    appearance {
        sequence: 20
    }
    default {
        value: .a-GV-row
    }
    help {
        helpText: The name of the object (class,id etc...) which identifies the row in the table on which the treegrid is going to be initilazed.
    }
)

customAttribute attribute_03 (
    apexlangName: idColumn
    attribute: 3
    name: ID Column
    appearance {
        sequence: 30
    }
    help {
        helpText: The column which helps to identify the row for the treegrid. For example: EMPNO
    }
)

customAttribute attribute_04 (
    apexlangName: parentIdColumn
    attribute: 4
    name: Parent ID Column
    appearance {
        sequence: 40
    }
    help {
        helpText: The column which helps to identify the parentrow for the treegrid. For example: MGR (Manager ID)
    }
)

customAttribute attribute_05 (
    apexlangName: expandCollapse
    attribute: 5
    name: Expand/Collapse
    type: selectList
    appearance {
        sequence: 50
    }
    default {
        value: expanded
    }
    help {
        helpText:
            ```
            Determine how should the grid behave on initialization or on change.
            
            Expand: All nodes/rows can be seen.
            Collapse: Only the root nodes are displayed. Every other child node is hidden/collapsed.
            ```
    }

    entry collapse (
        sequence: 20
        display: Collapse
        return: collapsed
    )

    entry expand (
        sequence: 10
        display: Expand
        return: expanded
    )

)

customAttribute attribute_06 (
    apexlangName: displayOnColumn
    attribute: 6
    name: Display on Column
    validation {
        required: true
    }
    appearance {
        sequence: 60
    }
    help {
        helpText: The column which the treegrid enhancement will be displayed.
    }
)

customAttribute attribute_07 (
    apexlangName: levelColumn
    attribute: 7
    name: Level Column
    validation {
        required: true
    }
    appearance {
        sequence: 70
    }
    help {
        helpText: The hierarchy where the record can be found.
    }
)

