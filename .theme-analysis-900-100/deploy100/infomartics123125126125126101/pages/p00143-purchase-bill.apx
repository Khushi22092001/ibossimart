    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P143_Tno is null then
                        Select GlobalTno.NextVal into :P143_Tno From Dual;
                     end if;
                    ----
                    if :P143_PURCHASEBILLNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P143_LocationCode,
                					:P143_DocTypeCode,
                					NULL,
                					TO_DATE(:P143_PURCHASEBILLDATE, 'DD-MM-RRRR')
                				);
                        :P143_PURCHASEBILLNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P143_LocationCode,
                                    :P143_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P143_PURCHASEBILLDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 160473069604704986
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P143_TNO is null then
                    :P143_TNO := GlobalTNo.nextval;
                    :P143_FORMSTATUS := 'NEWRECORD';
                else
                    :P143_FORMSTATUS := 'EDITRECORD';
                End if;
                APEX_UTIL.SET_SESSION_STATE (
                    'P143_FORMSTATUS',
                    :P143_FORMSTATUS);
                
                APEX_UTIL.SET_SESSION_STATE (
                    'P143_TNO',
                    :P143_TNO);
                
                
                  :P143_STATUS :=  nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P143_TNO), 'Status');
                
                  if :P143_BILLINROUNDFIGURE is null then
                        :P143_BILLINROUNDFIGURE := 'YES';
                  end if;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 160265491626839117
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P143_MODULEFLOW := 'YES';
                   else
                       :P143_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P143_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P143_ONTHETABLE := 'YES' ;
                   else
                       :P143_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 160265748868840174
        }
    )

