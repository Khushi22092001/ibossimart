    region grnselection-2 (
        name: GRNSelection1
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       a.TNO,
                       a.PURCHASEBILLTNO,
                       a.PURCHASEORDERTNO,
                       a.ISSELECTED,
                       a.GRNTNO,
                       a.GRNSNO,
                       ' ' as PartyRefNo,
                       b.ITEMCODE as Material,
                       b.ITEMSPECIFICATIONCODE AS MATERIAL_DETAIL,
                       b.RATEMEASURINGUNITCODE as Unit,
                       b.CHALANQUANTITY1 as ChalanQty,
                       b.RECEIVEDQUANTITY1 as Received,
                       b.RECEIVEDQUANTITY1 as Accepted
                  from GRNSELECTION_apex a, grndetail b 
                  where a.tno = :P143_TNO
                  and a.grntno = b.tno
                  and a.GRNSNO = b.sno
                ```
            pageItemsToSubmit: P143_TNO
        }
        layout {
            sequence: 20
            parentRegion: @grnselection
            slot: subRegions
        }
