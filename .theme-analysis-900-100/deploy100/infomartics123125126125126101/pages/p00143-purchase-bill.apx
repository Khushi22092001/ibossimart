    process insert-into-footer (
        name: Insert into footer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                delete from purchasebillfooter where tno = :P143_TNO;
                
                insert into purchasebillfooter
                    (
                        TNO,
                        FOOTERHEADCODE,
                        FOOTERVALUE
                    )
                    (
                        select 
                            :P143_TNO,
                            FOOTERHEADCODE,
                            sum(FOOTERVALUE)
                
                        from purchasebilldetailfooter
                        where tno = :P143_TNO
                        group by FOOTERHEADCODE
                    );
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 164933552449923711
        }
    )

