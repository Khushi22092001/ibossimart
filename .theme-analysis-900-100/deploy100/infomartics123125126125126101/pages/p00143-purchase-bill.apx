    dynamicAction calculate-footer-total (
        name: Calculate Footer Total
        execution {
            sequence: 450
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("DetailFooter").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("FOOTERVALUE");
                    model.forEach(function(igrow,index, id) {
                         meta = model.getRecordMetadata(id);
                        n_amt = parseFloat(igrow[col_amt], 10);
                        if (!isNaN(n_amt) !== "" && !meta.deleted && !meta.agg) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P143_FVALUE").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calculate-sum-of-amount-value-on-loose-focus (
        name: Calculate Sum of Amount Value on Loose focus
        execution {
            sequence: 370
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @detail
            columns: [
                AMOUNT
                FD
                FOOTERAMOUNT
                TOTALAMOUNT
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("AMOUNT");
                    var footerKey = model.getFieldKey("FOOTERAMOUNT");
                    var grandtotalKey = model.getFieldKey("TOTALAMOUNT");
                    var totalAmt = 0;
                    var footerAmt = 0;
                    var grandtotalAmt = 0;
                    
                    model.forEach(function(r, index, id) {
                        meta = model.getRecordMetadata(id);
                      var total = parseFloat(r[totalKey], 10);
                      var footer = parseFloat(r[footerKey], 10);
                      var grandtotal = parseFloat(r[grandtotalKey], 10);
                    
                      if (!isNaN(total) && !meta.deleted && !meta.agg) {
                        totalAmt += total;
                      }
                    
                      if (!isNaN(footer) && !meta.deleted && !meta.agg) {
                        footerAmt += footer;
                      }
                    
                      if (!isNaN(grandtotal) && !meta.deleted && !meta.agg) {
                        grandtotalAmt += grandtotal;
                      }
                    });
                    
                    $s("P143_SUMOFAMOUNT", totalAmt);
                    $s("P143_SUMOFFOOTERAMOUNT", footerAmt);
                    $s("P143_PURCHASEBILLAMOUNT", grandtotalAmt);
                    	
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :TOTALAMOUNT
                itemsToSubmit: TOTALAMOUNT
            }
            affectedElements {
                selectionType: items
                items: P143_PURCHASEBILLAMOUNT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action set-p143-purchasebillamount (
            name: set P143_PURCHASEBILLAMOUNT
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select round(:P143_PURCHASEBILLAMOUNT,0) from dual;
                itemsToSubmit: P143_PURCHASEBILLAMOUNT
            }
            affectedElements {
                selectionType: items
                items: P143_PURCHASEBILLAMOUNT
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P143_BILLINROUNDFIGURE
                value: YES
            }
        )

        action set-p143-purchasebillamountbeforeround (
            name: set P143_PURCHASEBILLAMOUNTBEFOREROUND
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P143_PURCHASEBILLAMOUNT
                itemsToSubmit: P143_PURCHASEBILLAMOUNT
            }
            affectedElements {
                selectionType: items
                items: P143_PURCHASEBILLAMOUNTBEFOREROUND
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P143_BILLINROUNDFIGURE
                value: YES
            }
        )

        action set-p143-roundoff (
            name: set P143_ROUNDOFF
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select :P143_PURCHASEBILLAMOUNT - :P143_PURCHASEBILLAMOUNTBEFOREROUND from dual;
                itemsToSubmit: [
                    P143_PURCHASEBILLAMOUNT
                    P143_PURCHASEBILLAMOUNTBEFOREROUND
                ]
            }
            affectedElements {
                selectionType: items
                items: P143_ROUNDOFF
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P143_BILLINROUNDFIGURE
                value: YES
            }
        )

        action set-p143-roundoff-2 (
            name: set P143_ROUNDOFF
            action: setValue
