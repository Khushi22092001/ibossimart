page 255 (
    name: Order to Cash
    alias: ORDER-TO-CASH
    title: Order to Cash
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .t-Cards--compact .t-Card-wrap{
                display: grid;
                grid-template-columns: auto 1fr auto;
                grid-template-rows: auto 1fr auto;
                grid-template-areas: "cardlist-icon cardlist-title cardlist-icon2" "cardlist-body cardlist-body cardlist-body";
            }
            
            .t-Cards--displayIcons .t-Card-icon {
                margin-left: 8px;
            }
            .t-Card-icon2{
                margin-top: 15px;
                margin-bottom: 15px;
                margin-right: 8px;
                padding-left: 15px;
                padding-right: 15px;
                display: flex;
                align-items: center;
                border-radius: 5px;
            }
            .t-Card-desc{
                font-style: italic;
                color: var(--u-color-15);
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region information (
        name: Information:
        type: staticContent
        source {
            htmlCode:
                ```html
                <p style="font-weight: bold; color: var(--u-color-15); margin: 0px; "> Loading Advice:</p>
                <p style="font-style: Italic; color: var(--u-color-15);">This option is utilized for off-site deliveries, such as transporting goods from one party's location to another.</p>
                <p style="font-weight: bold; color: var(--u-color-15); margin: 0px; "> Dispatch Advice:</p>
                <p style="font-style: Italic; color: var(--u-color-15);">This option pertains to deliveries originating from our own premises, specifically from our location to a party's designated destination.<br></p>
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--colorBG
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
                t-Alert--removeHeading js-removeLandmark
            ]
        }
    )

    region order-to-cash (
        name: Order to Cash
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    1                           as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('SALESENQUIRY', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:701:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:4:&APP_SESSION.')
                    END                         as CARD_LINK,
                    'Sales Enquiry'               as CARD_TITLE,
                    null                        as CARD_SUBTITLE,
                    'fa-search'             as CARD_ICON,
                    'This is a Sample Card Text'as CARD_TEXT,
                    null                        as CARD_SUBTEXT,
                    'fa-arrow-right-alt'        as CARD_ICON2,
                    'u-color-14'                as CARD_COLOR2
                From Dual
                union all
                Select
                    2                           as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('SALESQUOTATION', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:704:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:4:&APP_SESSION.')
                    END                         as CARD_LINK,
                    'Sales Quotation'               as CARD_TITLE,
                    null                        as CARD_SUBTITLE,
                    'fa-table-user'             as CARD_ICON,
                    'This is a Sample Card Text'as CARD_TEXT,
                    null                        as CARD_SUBTEXT,
                    'fa-arrow-right-alt'        as CARD_ICON2,
                    'u-color-14'                as CARD_COLOR2
                From Dual
                union all
                Select
                    3                           as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('PORECEIPT', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:273:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:4:&APP_SESSION.')
                    END                         as CARD_LINK,
                    'PO Receipt'               as CARD_TITLE,
                    null                        as CARD_SUBTITLE,
                    'fa-cart-empty'             as CARD_ICON,
                    'This is a Sample Card Text'as CARD_TEXT,
                    null                        as CARD_SUBTEXT,
                    'fa-arrow-right-alt'        as CARD_ICON2,
                    'u-color-14'                as CARD_COLOR2
                From Dual
                
                union all
                Select
                    3                           as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('SALESORDER', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:170:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:4:&APP_SESSION.')
                    END                         as CARD_LINK,
                    'Sales Order'               as CARD_TITLE,
                    null                        as CARD_SUBTITLE,
                    'fa-cart-check'             as CARD_ICON,
                    'This is a Sample Card Text'as CARD_TEXT,
                    null                        as CARD_SUBTEXT,
                    'fa-arrow-right-alt'        as CARD_ICON2,
                    'u-color-14'                as CARD_COLOR2
                From Dual
                
                Union All
                
                Select
                    4                       as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('LOADINGADVICE', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:154:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:4:&APP_SESSION.')
                    END                     as CARD_LINK,
                    'Loading Advice'        as CARD_TITLE,
                    null                    as CARD_SUBTITLE,
                    'fa-truck'              as CARD_ICON,
                    null                    as CARD_TEXT,
                    null                    as CARD_SUBTEXT,
                    'fa-arrow-right-alt'    as CARD_ICON2,
                    'u-color-14'            as CARD_COLOR2
                From Dual
                
                Union All
                
                Select
                    5                       as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('DESPATCHADVICE', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:160:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:4:&APP_SESSION.')
                    END                     as CARD_LINK,
                    'Dispatch Advice'       as CARD_TITLE,
                    null                    as CARD_SUBTITLE,
                    'fa-bus'                as CARD_ICON,
                    null                    as CARD_TEXT,
                    null                    as CARD_SUBTEXT,
                    'fa-arrow-right-alt'    as CARD_ICON2,
                    'u-color-14'            as CARD_COLOR2
                From Dual
                
                Union All
                
                Select
                    6                       as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('CCINVOICE', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:174:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:4:&APP_SESSION.')
                    END                     as CARD_LINK,
                    'CC Invoice'            as CARD_TITLE,
                    null                    as CARD_SUBTITLE,
                    'fa-badge-dollar'       as CARD_ICON,
                    null                    as CARD_TEXT,
                    null                    as CARD_SUBTEXT,
                    'fa-arrow-right-alt'    as CARD_ICON2,
                    'u-color-14'            as CARD_COLOR2
                From Dual
                
                Union All
                
                Select
                    7                       as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('FREIGHTADVICE', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:198:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:4:&APP_SESSION.')
                    END                     as CARD_LINK,
                    'Freight Advice'        as CARD_TITLE,
                    'Outward'               as CARD_SUBTITLE,
                    'fa-dollar'             as CARD_ICON,
                    null                    as CARD_TEXT,
                    null                    as CARD_SUBTEXT,
                    'fa-arrow-right-alt'    as CARD_ICON2,
                    'u-color-14'            as CARD_COLOR2
                From Dual
                
                Union All
                
                Select
                    8                       as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('BILLRECEIPT', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:190:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:4:&APP_SESSION.')
                    END                     as CARD_LINK,
                    'Bill Receipt'          as CARD_TITLE,
                    null                    as CARD_SUBTITLE,
                    'fa-inr'              as CARD_ICON,
                    null                    as CARD_TEXT,
                    null                    as CARD_SUBTEXT,
                    'fa-arrow-right-alt'    as CARD_ICON2,
                    'u-color-14'            as CARD_COLOR2
                From Dual
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @iboss-cards-for-process-flow
            templateOptions: [
                #DEFAULT#
                t-Cards--displaySubtitle
                t-Cards--compact
                t-Cards--displayIcons
                t-Cards--5cols
                t-Cards--hideBody
                t-Cards--iconsRounded
                t-Cards--animRaiseCard
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        breakFormatting {
            breakColumns: col1
        }

        column CARD_COLOR2 (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Card Color2
            }
            layout {
                sequence: 150
            }
        )

        column CARD_ICON (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Card Icon
            }
            layout {
                sequence: 120
            }
        )

        column CARD_ICON2 (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Card Icon2
            }
            layout {
                sequence: 140
            }
        )

        column CARD_LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Card Link
            }
            layout {
                sequence: 80
            }
        )

        column CARD_SUBTEXT (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Card Subtext
            }
            layout {
                sequence: 70
            }
        )

        column CARD_SUBTITLE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Card Subtitle
            }
            layout {
                sequence: 40
            }
        )

        column CARD_TEXT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Card Text
            }
            layout {
                sequence: 130
            }
        )

        column CARD_TITLE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Card Title
            }
            layout {
                sequence: 110
            }
        )

        column SEQ (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Seq
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            sorting {
                defaultSequence: 1
            }
        )

    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @order-to-cash
        }
        clientSideCondition {
            type: itemIsNotNull
            item: CARD_TEXT
        }
        serverSideCondition {
            type: never
        }

        action native-add-class (
            action: addClass
            settings {
                class: t-Cards--desc-4ln
            }
            affectedElements {
                selectionType: columns
                columns: CARD_TEXT
            }
            execution {
                sequence: 10
            }
        )

        action native-add-class-2 (
            action: addClass
            settings {
                class: t-Cards--hideBody
            }
            affectedElements {
                selectionType: columns
                columns: CARD_TEXT
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

)

