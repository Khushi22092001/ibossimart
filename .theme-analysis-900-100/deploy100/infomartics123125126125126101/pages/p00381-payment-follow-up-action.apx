page 381 (
    name: Payment Follow-up Action
    alias: PAYMENT-FOLLOW-UP-ACTION
    title: Payment Follow-up Action
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        height: 500
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #P381_CALLINGDATE .apex-item-datepicker{
                width: 400px;
            }
            #P381_NEXTFOLLOWUPDATE .apex-item-datepicker{
                width: 400px;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region payment-follow-up-action (
        name: Payment Follow-up Action
        type: form
        source {
            location: localDatabase
            tableName: PAYMENTFOLLOWUPACTION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P381_CALLINGDATE (
        type: datePicker
        label {
            label: Calling Date
            alignment: left
        }
        layout {
            sequence: 80
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="width: 400px;"
        }
        source {
            formRegion: @payment-follow-up-action
            column: CALLINGDATE
            dataType: date
        }
    )

    pageItem P381_CALLINGPERSON (
        type: selectOne
        label {
            label: Calling Person
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                     EMPLOYEENAME,
                     EMPLOYEECODE
                FROM EMPLOYEE E
                ```
        }
        layout {
            sequence: 60
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
            columnAttributes: [
                style="width:
                400px;"
            ]
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
        advanced {
            customAttributes: style="width: 400px;"
        }
        source {
            formRegion: @payment-follow-up-action
            column: CALLINGPERSON
            dataType: varchar2
        }
    )

    pageItem P381_CALLINGSTATUS (
        type: selectList
        label {
            label: Calling Status
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Answered;A,Not Answered;NA
        }
        layout {
            sequence: 70
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        advanced {
            customAttributes: style="width: 400px;"
        }
        source {
            formRegion: @payment-follow-up-action
            column: CALLINGSTATUS
            dataType: varchar2
        }
    )

    pageItem P381_COMMENTS (
        type: textarea
        label {
            label: Comments
            alignment: left
        }
        layout {
            sequence: 110
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 2
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @payment-follow-up-action
            column: COMMENTS
            dataType: varchar2
        }
    )

    pageItem P381_COMMITEDAMOUNT (
        type: numberField
        label {
            label: Commited Amount
            alignment: left
        }
        layout {
            sequence: 50
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="width: 400px;"
        }
        source {
            formRegion: @payment-follow-up-action
            column: COMMITEDAMOUNT
            dataType: number
        }
    )

    pageItem P381_INVOICEBALANCE (
        type: numberField
        label {
            label: Invoice Balance
            alignment: left
        }
        layout {
            sequence: 40
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: readonly=true style="width: 400px;"
        }
        source {
            formRegion: @payment-follow-up-action
            column: INVOICEBALANCE
            dataType: number
        }
    )

    pageItem P381_INVOICETNO (
        type: selectMany
        label {
            label: Invoices
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    I.INVOICENO AS D,
                    I.TNO AS R
                FROM INVOICE I
                WHERE I.PARTYCODE = :P381_PARTYCODE
                  AND NVL(I.INVOICEAMOUNT, 0) > (
                      SELECT NVL(SUM(X.AMOUNT), 0) 
                      FROM DFREIGHTBILLRECEIPTDETAIL X 
                      WHERE X.TNO = I.MODULETNO
                  )
                
                ```
        }
        cascadingLov {
            parentItems: P381_PARTYCODE
            itemsToSubmit: P381_INVOICETNO
        }
        layout {
            sequence: 30
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @payment-follow-up-action
            column: INVOICETNO
            dataType: varchar2
        }
    )

    pageItem P381_NEXTFOLLOWUPDATE (
        type: datePicker
        label {
            label: Next Follow-up Date
            alignment: left
        }
        layout {
            sequence: 90
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: style="width: 400px;"
        }
        source {
            formRegion: @payment-follow-up-action
            column: NEXTFOLLOWUPDATE
            dataType: date
        }
    )

    pageItem P381_PARTYCODE (
        type: selectOne
        label {
            label: Party
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                     P.PARTYNAME||', '||GETCITYNAME(P.OFFICECITYCODE)||', '||GETSTATENAME(P.OFFICESTATECODE) AS D,
                     P.PARTYCODE AS R
                FROM CCINVOICE CI
                LEFT JOIN PARTY P ON P.PARTYCODE = CI.PARTYCODE
                ```
        }
        layout {
            sequence: 20
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @payment-follow-up-action
            column: PARTYCODE
            dataType: varchar2
        }
    )

    pageItem P381_REMARK (
        type: textarea
        label {
            label: Remark
            alignment: left
        }
        layout {
            sequence: 120
            region: @payment-follow-up-action
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 60
            height: 2
        }
        validation {
            maxLength: 4000
        }
        source {
            formRegion: @payment-follow-up-action
            column: REMARK
            dataType: varchar2
        }
    )

    pageItem P381_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @payment-follow-up-action
            slot: regionBody
        }
        source {
            formRegion: @payment-follow-up-action
            column: TNO
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P381_TNO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P381_TNO
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P381_TNO
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction get-the-invoice-balance (
        name: Get the Invoice Balance
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P381_INVOICETNO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(SUM(InvoiceAmount), 0)
                    FROM Invoice
                    WHERE TNo IN (
                        SELECT REGEXP_SUBSTR(:P381_INVOICETNO, '[^:]+', 1, LEVEL)
                        FROM DUAL
                        CONNECT BY REGEXP_SUBSTR(:P381_INVOICETNO, '[^:]+', 1, LEVEL) IS NOT NULL
                    )
                    
                    ```
                itemsToSubmit: P381_INVOICETNO
            }
            affectedElements {
                selectionType: items
                items: P381_INVOICEBALANCE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 40458470565635650
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-payment-follow-up-action (
        name: Initialize form Payment Follow-up Action
        type: formInitialization
        formRegion: @payment-follow-up-action
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 40457642475635650
        }
    )

    process process-form-payment-follow-up-action (
        name: Process form Payment Follow-up Action
        type: formAutoRowProcessing
        formRegion: @payment-follow-up-action
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 40458066181635650
        }
    )

)

