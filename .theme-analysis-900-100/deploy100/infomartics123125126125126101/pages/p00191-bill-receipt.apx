    pageItem P191_ACCOUNTCODE (
        type: popupLov
        label {
            label: Account
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName as AccountName,
                a.PartyCode as AccountCode
                from Party a, DocumentStatusDetail b, PartyCompany c
                where a.TNo = b.ModuleTNO
                and b.ModuleCode = 'PARTY'
                and a.TNo = c.TNo
                --and c.CompanyCode = :global_CompanyCode
                --and GetAccountPrivilege(a.PartyCode, 'BILLRECEIPT', :P191_COMPANYCODE, User) = 'YES'
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @bill-receipt
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @bill-receipt
            column: ACCOUNTCODE
            dataType: varchar2
        }
    )

