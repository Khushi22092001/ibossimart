    dynamicAction set-master-amount-detail (
        name: Set Master Amount Detail
        execution {
            sequence: 180
        }
        when {
            event: focusout
            selectionType: region
            region: @detail
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("AMOUNT");
                    var footerKey = model.getFieldKey("TDSAMOUNT");
                    var totalAmt = 0;
                    var footerAmt = 0;
                    
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                      var footer = parseFloat(r[footerKey], 10);
                      
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                      if (!isNaN(footer)) {
                        footerAmt += footer;
                      }
                    
                      
                    });
                    
                    $s("P191_AMOUNT", totalAmt);
                    $s("P191_TDSAMOUNT", footerAmt);
                    
                    	
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-penalty-amount (
        name: Set Penalty Amount
        execution {
            sequence: 126
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Penalty").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("AMOUNT");
                    model.forEach(function(igrow) {
                        n_amt = parseFloat(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P191_PENALTYAMOUNT").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

