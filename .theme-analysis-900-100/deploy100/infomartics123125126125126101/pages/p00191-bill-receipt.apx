    pageItem P191_DEPOCODE (
        type: popupLov
        label {
            label: Party
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	distinct
                	b.PartyName as DepoName,
                	b.PartyCode as DepoCode
                from Party b, DocumentStatusDetail a, PartyCompany c
                where b.TNO = a.ModuleTNo
                and a.ModuleCode = 'PARTY'
                and a.DocumentStatusCode = 'ACTIVE'
                and b.tno = c.tno
                --and c.CompanyCode = :global_CompanyCode
                and exists(
                       select
                                aa.tno
                       from ServiceBill aa
                       where aa.PartyCode = b.PartyCode
                )
                union 
                select
                	distinct
                	b.PartyName as DepoName,
                	b.PartyCode as DepoCode
                from Party b, DocumentStatusDetail a, PartyCompany c
                where b.TNO = a.ModuleTNo
                and a.ModuleCode = 'PARTY'
                and a.DocumentStatusCode = 'ACTIVE'
                and b.tno = c.tno(+)
                --and c.CompanyCode = :global_CompanyCode
                and exists(
                       select
                                aa.tno
                       from ccInvoice aa
                       where aa.PartyCode = b.PartyCode
                )
                union 
                select
                	distinct
                	b.PartyName as DepoName,
                	b.PartyCode as DepoCode
                from Party b, DocumentStatusDetail a, PartyCompany c
                where b.TNO = a.ModuleTNo
                and a.ModuleCode = 'PARTY'
                and a.DocumentStatusCode = 'ACTIVE'
                and b.tno = c.tno
                --and c.CompanyCode = :global_CompanyCode
                and exists(
                       select
                                aa.tno
                       from DEBITNOTE aa
                       where aa.PartyCode = b.PartyCode
                )
                union 
                select
                	distinct
                	b.PartyName as DepoName,
                	b.PartyCode as DepoCode
                from Party b, DocumentStatusDetail a, PartyCompany c
                where b.TNO = a.ModuleTNo
                and a.ModuleCode = 'PARTY'
                and a.DocumentStatusCode = 'ACTIVE'
                and b.tno = c.tno
                --and c.CompanyCode = :global_CompanyCode
                and exists(
                       select
                                aa.tno
                       from CREDITNOTE aa
                       where aa.PartyCode = b.PartyCode
                )
                union
                select
                	distinct
                	b.PartyName as DepoName,
                	b.PartyCode as DepoCode
                from Party b, DocumentStatusDetail a, PartyCompany c
                where b.TNO = a.ModuleTNo
                and a.ModuleCode = 'PARTY'
                and a.DocumentStatusCode = 'ACTIVE'
                and b.tno = c.tno(+)
                --and c.CompanyCode = :global_CompanyCode
                and exists(
                       select
                                aa.tno
                       from AccountOpening aa
                       where aa.AccountCode = b.PartyCode
                			-- and aa.OpeningAmount < 0
                			and aa.BillNo is not null
                )
                order by 1
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @bill-receipt
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @bill-receipt
            column: DEPOCODE
            dataType: varchar2
        }
    )

