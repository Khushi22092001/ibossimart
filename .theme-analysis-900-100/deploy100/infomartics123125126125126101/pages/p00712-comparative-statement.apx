    region cs-detail (
        name: CS Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select seq_id As Seq_id,
                       N001   As TNO,
                       N002   As SNO,
                       N003   As Quantity1,
                       C004   As Measuringunitcode1,
                       c005   As UOM,
                       C006   As Itemcode,
                       c007   As Itemspecificationcode,
                       C008   As ItemName,
                       C009   As ItemSpecification,
                       
                       C010 As quotationtno1,
                       C011 As PARTYCODE1,
                       C012 As PARTYNAME1,
                       C013 As QuotationNo1,
                       c014 As rate1,
                       TO_NUMBER(c015) As amount1,
                       c016 As Approved1,
                       C017 As c017,
                       
                       C018 As quotationtno2,
                       C019 As PARTYCODE2,
                       C020 As PARTYNAME2,
                       C021 As QuotationNo2,
                       c022 As rate2,
                       TO_NUMBER(c023) As amount2,
                       c024 As Approved2,
                       C025 As c025,
                       
                       C026 As quotationtno3,
                       C027 As PARTYCODE3,
                       C028 As PARTYNAME3,
                       C029 As QuotationNo3,
                       c030 As rate3,
                       TO_NUMBER(c031) As amount3,
                       c032 As Approved3,
                       C033 As c033,
                       C034 As quotationtno4,
                       C035 As PARTYCODE4,
                       C036 As PARTYNAME4,
                       C037 As QuotationNo4,
                       c038 As rate4,
                       TO_NUMBER(c039) As amount4,
                       c040 As Approved4,
                       C041 As c041,
                       C042 As quotationtno5,
                       C043 As PARTYCODE5,
                       C044 As PARTYNAME5,
                       C045 As QuotationNo5,
                       c046 As rate5,
                       TO_NUMBER(c047) As amount5,
                       c048 As Approved5,
                       C049 As c049
                  From APEX_COLLECTIONS A
                 Where A.COLLECTION_NAME = 'CSCOLLECTION'
                  AND A.N001 = :P712_TNO
                ;
                ```
            pageItemsToSubmit: P712_TNO
        }
        layout {
            sequence: 40
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
