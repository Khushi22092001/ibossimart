    process get-on-the-table (
        name: Get on the table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P712_MODULEFLOW := 'YES';
                   else
                       :P712_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P712_ONTHETABLE := 'YES' ;
                   else
                       :P712_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9212717797521209
        }
    )

    process gettno (
        name: getTNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P712_TNO is null then
                   select globaltno.nextval into :P712_TNO from dual;
                   :P712_FORMSTATUS := 'NEWRECORD';
                
                   else
                
                    :P712_FORMSTATUS := 'EDITRECORD';
                
                end if;
                
                :P712_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P712_TNO), 'Status');
