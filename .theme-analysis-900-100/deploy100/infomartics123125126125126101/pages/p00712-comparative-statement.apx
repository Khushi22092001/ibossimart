                        :P712_COMPARATIVESTATEMENTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P712_LOCATIONCODE,
                                    :P712_DOCTYPECODE,
