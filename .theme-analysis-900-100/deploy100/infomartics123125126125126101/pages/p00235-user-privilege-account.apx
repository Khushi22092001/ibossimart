page 235 (
    name: User Privilege Account
    alias: USER-PRIVILEGE-ACCOUNT
    title: User Privilege Account
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        height: 400
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region user-privilege-account (
        name: User Privilege Account
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.ACCOUNTCODE,
                       a.SNO
                  from MODULEPRIVILEGEACCOUNT a
                 where  a.TNO = :P235_TNO
                ```
            pageItemsToSubmit: P235_TNO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 126806890915828545
        }

        savedReport 397666 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @ACCOUNTCODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column ACCOUNTCODE (
            type: popupLov
            heading {
                heading: Account
            }
            lov {
                type: sqlQuery
                sqlQuery: select partyname d, partycode r from party order by 1
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ACCOUNTCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column SNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SNO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: User Privilege Account
        }
    )

    pageItem P235_TNO (
        type: textField
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 10
            region: @user-privilege-account
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 20
            region: @user-privilege-account
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @user-privilege-account
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-privilege-account
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process closedialog (
        name: CloseDialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 68943246579259334
        }
    )

    process user-privilege-account-save-interactive-grid-data (
        name: User Privilege Account - Save Interactive Grid Data
        type: executeCode
        editableRegion: @user-privilege-account
        source {
            plsqlCode:
                ```plsql
                if :APEX$ROW_STATUS IN ( 'I','C') then
                   :TNO := :P235_TNO ;
                   SELECT GLOBALTNO.NEXTVAL INTO :SNO FROM DUAL;
                  INSERT INTO MODULEPRIVILEGEACCOUNT ( TNO,SNO,ACCOUNTCODE)
                  VALUES ( :TNO,:SNO,:ACCOUNTCODE) ;
                ELSIF  :APEX$ROW_STATUS IN ( 'U') then
                     UPDATE MODULEPRIVILEGEACCOUNT
                     SET ACCOUNTCODE = :ACCOUNTCODE
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                ELSIF :APEX$ROW_STATUS = 'D' then
                     DELETE FROM  MODULEPRIVILEGEACCOUNT
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                END IF;   
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 68942849535259333
        }
    )

)

