page 503 (
    name: Issue Analysis
    alias: ISSUE-ANALYSIS
    title: Issue Analysis
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var orig = "x";
    }
    security {
        formAutoComplete: false
    }

    region button (
        name: Button
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region contractor-wise-issue (
        name: Contractor wise Issue
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      GetPartyName(a.PartyCode)PartyName,
                      a.PartyCode,
                      sum(StockAmount)as Amount,
                      '#887BB0' as Color,
                      'CHARGEABLE' GROUPNAME
                From  BI_Issue a, FinancialYear fy
                Where a.FinancialYearCode = fy.FinancialYearCode
                  and a.IssueDate Between fy.FinancialYearBegin and nvl(:P503_ASONDATE,fy.FinancialYearEnd)
                  and a.DocTypeCode = 'CHARGEABLE'
                  and a.PartyCode is not null
                  and a.DocTypeCode like nvl((Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE),'%')
                  and a.LocationCode like nvl((Select LocationCode From Location Where Tno = :P503_LOCATIONCODE),'%')
                  and a.DepartmentCode like nvl((Select DepartmentCode From Department Where Tno = :P503_DEPARTMENTCODE),'%')
                Group by GetPartyName(a.PartyCode),
                         a.PartyCode
                union all
                Select
                      GetPartyName(a.PartyCode)PartyName,
                      a.PartyCode,
                      sum(StockAmount)as Amount,
                      '#76B947' as Color,
                      'NON-CHARGEABLE' GROUPNAME
                From  BI_Issue a, FinancialYear fy
                Where a.FinancialYearCode = fy.FinancialYearCode
                  and a.IssueDate Between fy.FinancialYearBegin and nvl(:P503_ASONDATE,fy.FinancialYearEnd)
                  and a.DocTypeCode != 'CHARGEABLE'
                  and a.PartyCode is not null
                  and a.DocTypeCode like nvl((Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE),'%')
                  and a.LocationCode like nvl((Select LocationCode From Location Where Tno = :P503_LOCATIONCODE),'%')
                  and a.DepartmentCode like nvl((Select DepartmentCode From Department Where Tno = :P503_DEPARTMENTCODE),'%')
                Group by GetPartyName(a.PartyCode),
                         a.PartyCode
                ```
            pageItemsToSubmit: [
                P503_DOCTYPECODE
                P503_LOCATIONCODE
                P503_COSTCENTERCODE
            ]
        }
        layout {
            sequence: 140
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent13
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            plsqlExpression: 1=2
        }
        chartAppearance {
            orientation: horizontal
            stack: true
            stackLabel: true
        }
        chartLayout {
            height: 250
        }
        animation {
            onDisplay: zoom
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            position: bottom
        }

        series contractor-wise-issue (
            name: Contractor wise Issue
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: GROUPNAME
                label: PARTYNAME
                value: AMOUNT
            }
            appearance {
                color: &COLOR.
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P503_PARTYCODE',&PARTYCODE.);
            }
            label {
                show: true
                position: outsideBarEdge
                fontStyle: italic
                fontSize: 10
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                pattern: ##,##,###
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region cost-center-wise-issue (
        name: Cost Center wise Issue
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CostCentreName,
                      c.TNo as CostCenterCode,
                      sum(StockAmount)as Amount
                From  BI_Issue a, FinancialYear fy, CostCentre c,
                (Select DepartmentCode,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || DepartmentCode As tree,
                               Level,
                               CONNECT_BY_ROOT DepartmentCode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(Departmentcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From Department a
                         Start With parentcode Is Null
                        Connect By parentcode = Prior Departmentcode
                         Order Siblings By Departmentcode) x
                Where a.FinancialYearCode = fy.FinancialYearCode
                  and a.CostCentreCode =c.CostCentreCode
                  and a.departmentcode = x.departmentcode
                  and a.IssueDate Between fy.FinancialYearBegin and nvl(:P503_ASONDATE,fy.FinancialYearEnd)
                  and a.DocTypeCode like nvl((Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE),'%')
                  and a.LocationCode like nvl((Select LocationCode From Location Where Tno = :P503_LOCATIONCODE),'%')
                  and x.root_id like nvl((Select DepartmentCode From Department Where Tno = :P503_DEPARTMENTCODE),'%')
                Group by c.CostCentreName,
                         c.TNo
                ```
            pageItemsToSubmit: [
                P503_DOCTYPECODE
                P503_LOCATIONCODE
            ]
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent6
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 250
        }
        value {
            format: decimal
            decimalPlaces: 0
            pattern: ##,##,###
            formatScaling: none
        }
        animation {
            onDisplay: zoom
        }
        legend {
            show: false
        }

        series cost-center-wise (
            name: "Cost Center wise "
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: COSTCENTRENAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P503_COSTCENTERCODE',&COSTCENTERCODE.);
            }
            label {
                show: true
                position: outsideSlice
                displayAs: percentageValue
                fontStyle: italic
                fontSize: 10
            }
        )

    )

    region cost-centre-12-months-issue (
        name: Cost Centre > 12 Months Issue
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    x.Month,
                    x.MonthCode,
                    x.Amount
                From
                (Select
                      to_Char(a.IssueDate,'MON-YYYY') Month,
                      To_char(a.IssueDate,'YYYYMM') MonthCode,
                      sum(StockAmount)as Amount
                From  BI_Issue a, FinancialYear fy
                Where a.FinancialYearCode = fy.FinancialYearCode
                  and a.IssueDate Between fy.FinancialYearBegin and nvl(:P503_ASONDATE,fy.FinancialYearEnd)
                  and a.DocTypeCode like nvl((Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE),'%')
                  and a.LocationCode like nvl((Select LocationCode From Location Where Tno = :P503_LOCATIONCODE),'%')
                  and a.CostCentreCode like nvl((Select CostCentreCode From CostCentre Where Tno = :P503_COSTCENTERCODE),'%')
                Group by to_Char(a.IssueDate,'MON-YYYY'),
                         To_char(a.IssueDate,'YYYYMM')
                Order by To_char(a.IssueDate,'YYYYMM')
                )x
                Where rownum<=12
                ```
            pageItemsToSubmit: [
                P503_DOCTYPECODE
                P503_LOCATIONCODE
                P503_COSTCENTERCODE
            ]
        }
        layout {
            sequence: 120
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent7
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 250
        }
        animation {
            onDisplay: zoom
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series cost-centre-wise-12-months-issue (
            name: Cost Centre wise 12 Months Issue
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: MONTH
                value: AMOUNT
            }
            appearance {
                color: #f4bf1e
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P503_CCMONTH',&MONTHCODE.);
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                pattern: ##,##,###
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region cost-centre-month-item-group-wise-issue (
        name: Cost Centre > Month > Item Group wise Issue
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select TO_CHAR(to_date(:P503_DEPTMONTH,'YYYYMM'),'DD-MON-RRRR') AS FromDate,
                TO_CHAR(last_day(to_date(:P503_DEPTMONTH,'YYYYMM')),'DD-MON-RRRR') as ToDate,
                (Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE) AS DOCTYPE,
                NVL((Select NVL(LocationCode,'CO') From Location Where Tno = :P503_LOCATIONCODE),'CO') AS LOCATIONCODE,
                (Select DepartmentCode From Department Where Tno = :P503_DEPARTMENTCODE) AS DEPARTMENTCODE,
                (Select CostCentreCode From CostCentre Where Tno = :P503_COSTCENTERCODE) AS COSTCENTRECODE,
                      GetItemName(e.ParentCode)ItemGroupName,
                      e.ParentCode,
                      sum(StockAmount)as Amount
                From  BI_Issue a, FinancialYear fy, Item e
                Where a.FinancialYearCode = fy.FinancialYearCode
                  and a.ItemCode = e.ItemCode
                  and a.DocTypeCode like nvl((Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE),'%')
                  and a.LocationCode like nvl((Select LocationCode From Location Where Tno = :P503_LOCATIONCODE),'%')
                  and a.CostCentreCode like nvl((Select CostCentreCode From CostCentre Where Tno = :P503_COSTCENTERCODE),'%')
                  --and To_Char(a.IssueDate,'YYYYMM') like nvl(:P503_CCMONTH,'%')
                  --and a.DocTypeCode = (Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE)
                  --and a.LocationCode = (Select LocationCode From Location Where Tno = :P503_LOCATIONCODE) 
                  --and a.CostCentreCode = (Select CostCentreCode From CostCentre Where Tno = :P503_COSTCENTERCODE)
                  and To_Char(a.IssueDate,'YYYYMM') = :P503_CCMONTH
                Group by GetItemName(e.ParentCode),
                      e.ParentCode
                ORDER BY 9 DESC
                ```
            pageItemsToSubmit: P503_CCMONTH
        }
        layout {
            sequence: 130
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent13
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            plsqlExpression: 1=2
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 250
        }
        legend {
            show: false
        }

        series month-x-item-group-wise-cost-centre (
            name: Month x Item Group wise (Cost Centre)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: ITEMGROUPNAME
                value: AMOUNT
            }
            appearance {
                color: #f4bf1e
            }
            link {
                type: redirectThisApp
                target: {
                    page: 17
                    items: {
                        P17_COMPANY: 1
                        P17_COSTCENTRE: &COSTCENTRECODE.
                        P17_DOCTYPE: &DOCTYPE.
                        P17_LOCATION: &LOCATIONCODE.
                        P17_FROMDATE: &FROMDATE.
                        P17_TODATE: &TODATE.
                    }
                    clearCache: 17
                    action: resetPagination
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title {
                fontSize: 8
            }
            value {
                format: decimal
                decimalPlaces: 0
                pattern: ##,##,###
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region department-12-months-issue (
        name: Department > 12 Months Issue
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    x.Month,
                    x.MonthCode,
                    x.Amount
                From
                (Select
                      to_Char(a.IssueDate,'MON-YYYY') Month,
                      To_char(a.IssueDate,'YYYYMM') MonthCode,
                      sum(StockAmount)as Amount
                From  BI_Issue a, FinancialYear fy,Department d, Department e,
                (Select DepartmentCode,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || DepartmentCode As tree,
                               Level,
                               CONNECT_BY_ROOT DepartmentCode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(Departmentcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From Department a
                         Start With parentcode Is Null
                        Connect By parentcode = Prior Departmentcode
                         Order Siblings By Departmentcode) x
                Where a.FinancialYearCode = fy.FinancialYearCode
                    and a.DepartmentCode =d.DepartmentCode
                  and d.DepartmentCode = x.departmentcode
                  and x.root_id=e.departmentcode
                
                  and a.IssueDate Between fy.FinancialYearBegin and nvl(:P503_ASONDATE,fy.FinancialYearEnd)
                  and a.DocTypeCode like nvl((Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE),'%')
                  and a.LocationCode like nvl((Select LocationCode From Location Where Tno = :P503_LOCATIONCODE),'%')
                  and e.DepartmentCode like nvl((Select DepartmentCode From Department Where Tno = :P503_DEPARTMENTCODE),'%')
                Group by to_Char(a.IssueDate,'MON-YYYY'),
                         To_char(a.IssueDate,'YYYYMM')
                Order by To_char(a.IssueDate,'YYYYMM')
                )x
                Where rownum<=12
                ```
            pageItemsToSubmit: [
                P503_DOCTYPECODE
                P503_LOCATIONCODE
                P503_DEPARTMENTCODE
            ]
        }
