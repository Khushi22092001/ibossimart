        animation {
            onDisplay: zoom
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series department-wise-12-months-issue (
            name: Department wise 12 Months Issue
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: MONTH
                value: AMOUNT
            }
            appearance {
                color: #eb5353
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P503_DEPTMONTH',&MONTHCODE.);
            }
            label {
                show: true
            }
        )

