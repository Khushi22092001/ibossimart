    dynamicAction change-region-name (
        name: Change Region Name
        execution {
            sequence: 80
        }
        when {
            selectionType: items
            items: P503_CC
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (orig == "x")
                        orig = $('#MYID h1').text();
                    
                    $('#MYID h1').text(orig + ' (' + $('#P503_CC option:selected').text() + ')');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

