    dynamicAction set-value-for-cost-centre-month-region (
        name: Set Value for Cost Centre Month Region
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P503_COSTCENTERCODE
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P503_COSTCENTRENAME
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P503_COSTCENTRENAME
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                    CostCentreName
                    From CostCentre
                    Where Tno = :P503_COSTCENTERCODE
                    ```
                itemsToSubmit: P503_COSTCENTERCODE
                escapeSpecialChars: false
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: P503_COSTCENTRENAME
            }
            execution {
                sequence: 30
            }
        )

    )

