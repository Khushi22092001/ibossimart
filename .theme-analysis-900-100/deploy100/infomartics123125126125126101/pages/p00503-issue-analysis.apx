    region department-wise-issue (
        name: Department wise Issue
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      e.DepartmentName,
                      e.TNo as DepartmentCode,
                      sum(StockAmount)as Amount,
                      sum(a.quantity1) as Quantity1,
                      sum(a.quantity2) as Quantity2
                From  BI_Issue a, FinancialYear fy, Department d, Department e,
                (Select DepartmentCode,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || DepartmentCode As tree,
                               Level,
                               CONNECT_BY_ROOT DepartmentCode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(Departmentcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From Department a
                         Start With parentcode Is Null
                        Connect By parentcode = Prior Departmentcode
                         Order Siblings By Departmentcode) x
                Where a.FinancialYearCode = fy.FinancialYearCode
                  and a.DepartmentCode =d.DepartmentCode
                  and d.DepartmentCode = x.departmentcode
                  and x.root_id=e.departmentcode
                  and a.IssueDate Between fy.FinancialYearBegin and nvl(:P503_ASONDATE,fy.FinancialYearEnd)
                  and a.DocTypeCode like nvl((Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE),'%')
                  and a.LocationCode like nvl((Select LocationCode From Location Where Tno = :P503_LOCATIONCODE),'%')
                Group by e.DepartmentName,
                         e.TNo 
                ```
            pageItemsToSubmit: [
                P503_DOCTYPECODE
                P503_LOCATIONCODE
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent12
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 250
        }
        value {
            format: decimal
            decimalPlaces: 0
            pattern: ##,##,###
            formatScaling: none
        }
        animation {
            onDisplay: zoom
        }
        legend {
            hideAndShowBehavior: noRescaling
        }

        series department-wise (
            name: "Department wise "
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: DEPARTMENTNAME
                label: DEPARTMENTNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P503_DEPARTMENTCODE',&DEPARTMENTCODE.);
            }
            label {
                show: true
                position: insideBarEdge
                displayAs: percentageValue
                fontStyle: italic
                fontSize: 10
            }
        )

    )

    region division-wise-issue (
        name: Division wise Issue
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      lc.LocationName,
                      lc.TNo as LocationCode,
                      sum(StockAmount)as Amount
                From  BI_Issue a, FinancialYear fy, Location lc
                Where a.FinancialYearCode = fy.FinancialYearCode
                  and a.LocationCode =lc.LocationCode
                  and a.IssueDate Between fy.FinancialYearBegin and nvl(:P503_ASONDATE,fy.FinancialYearEnd)
                  and lc.IsDivision = 'YES'
                  and a.DocTypeCode like nvl((Select DocTypeCode From DocType Where Tno = :P503_DOCTYPECODE),'%')
                Group by lc.LocationName,
                      lc.TNo
                ```
            pageItemsToSubmit: P503_DOCTYPECODE
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent1
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
