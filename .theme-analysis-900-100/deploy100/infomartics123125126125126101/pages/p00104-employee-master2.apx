    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 100
            region: @employee-master
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 130
            region: @employee-master
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: item=value
            item: P104_FORMSTATUS
            value: NEWRECORD
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 110
            region: @employee-master
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P104_FORMSTATUS
            value: EDITRECORD
        }
    )

    button fail (
        buttonName: Fail
        label: Fail
        layout {
            sequence: 60
            region: @employee-master
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-thumbs-o-down
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 163
                clearCache: 163
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P104_FORMSTATUS
            value: EDITRECORD
        }
    )

    button flow (
        buttonName: Flow
        label: Flow
        layout {
            sequence: 70
            region: @employee-master
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pill
            ]
            icon: fa-workflow
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                items: {
                    P162_TNO: &P2_TNO1.
                }
                clearCache: 162
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P104_FORMSTATUS
            value: EDITRECORD
        }
    )

    button pass (
        buttonName: Pass
        label: Pass
        layout {
            sequence: 50
            region: @employee-master
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-thumbs-o-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 163
                clearCache: 163
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P104_FORMSTATUS
            value: EDITRECORD
        }
    )

    button print (
        buttonName: Print
        label: Print
        layout {
            sequence: 90
            region: @employee-master
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
