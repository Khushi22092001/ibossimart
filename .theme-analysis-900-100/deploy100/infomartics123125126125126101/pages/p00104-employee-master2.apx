    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 120
            region: @employee-master
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save-as
        }
        behavior {
