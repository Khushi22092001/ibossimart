            item: P104_FORMSTATUS
            value: EDITRECORD
        }
    )

    button status (
        buttonName: Status
        label: Status
        layout {
            sequence: 80
            region: @employee-master
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-comments-o
        }
        behavior {
            action: redirectThisApp
            target: {
