    pageItem P104_CREATIONTIME (
        type: textField
        label {
            label: Creation Time
            alignment: left
        }
        layout {
            sequence: 690
            region: @employee-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD-MM-YYYY HH24:MI:SS
            width: 35
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @employee-master
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MM-YYYY HH24:MI:SS') from dual
        }
    )

