    pageItem P104_DEPARTMENTCODE (
        type: popupLov
        label {
            label: Department
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                        A.DEPARTMENTNAME, 
                        A.DEPARTMENTCODE 
                        FROM DEPARTMENT A 
                        ORDER BY A.TNO DESC
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 70
            region: @employee-master
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
