    pageItem P104_EMPLOYEECODE (
        type: textField
        label {
            label: Employee Code
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @employee-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 35
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @employee-master
            column: EMPLOYEECODE
            dataType: varchar2
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'EMPLOYEE'
                       and a.CodeScheme = 'AUTO'
                ```
        }
    )

