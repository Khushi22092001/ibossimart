    region requisition-master (
        name: Requisition Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.COMPANYCODE,
                       A.FINANCIALYEARCODE,
                       A.LOCATIONCODE,
                       A.DOCTYPECODE,
                       A.REQUISITIONNO,
                       A.REQUISITIONDATE,
                       A.DEPARTMENTCODE,
                       A.WORKORDERTNO,
                       A.JOBORDERTNO,
                       A.ITEMCODE,
                       A.ITEMSPECIFICATIONCODE,
                       A.QUANTITY1,
                       A.QUANTITY2,
                       A.EMPLOYEECODE,
                       A.PARTYCODE,
                       A.ISSUETOEMPLOYEECODE,
                       A.MODULECODE,
                       A.MODULETNO,
                       A.CREATOR,
                       A.CREATIONTIME,
                       A.REMARK,
                       NVL(GETDOCUMENTSTATUSCODE(getmodulecodeforpageno(:APP_PAGE_ID),A.TNO),'STATUS') AS Status
                  from REQUISITION A
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: General
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

