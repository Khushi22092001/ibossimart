    region requisition-detail (
        name: Requisition Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid,
                       TNO,
                       SNO,
                       SERIALNO,
                       DOCUMENTSTATUSCODE,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       REMARK,
                       QOH1,
                       QOH2,
                       ISSUEDQUANTITY1,
                       ISSUEDQUANTITY2,
                       GetMeasuringUnitNameFromItem(itemcode) AS MEASURINGUNITCODE1,
                       GetMeasuringUnit2NameFromItem(itemcode) AS MEASURINGUNITCODE2,
                       QUANTITY,
                       REQUESTQUANTITY,
                       'CC' as CC
                  from REQUISITIONDETAIL
                  where tno = :P130_TNO
                  
                ```
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
