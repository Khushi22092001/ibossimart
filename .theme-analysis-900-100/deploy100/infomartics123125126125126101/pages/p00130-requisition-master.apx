    process set-requisition-no (
        name: Set REQUISITION No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    --tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tModuleCode varchar2(30) := 'REQUISITION';
                    tmp         number ;
                begin
                     if :P130_TNO is null then
                        Select GlobalTno.NextVal into :P130_TNO From Dual;
                     end if;
                    ----
                    if :P130_REQUISITIONNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P130_LOCATIONCODE,
                					:P130_DOCTYPECODE,
                					NULL,
                					TO_DATE(:P130_REQUISITIONDATE, 'DD-MM-RRRR')
                				);
                        :P130_REQUISITIONNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P130_LOCATIONCODE,
                                    :P130_DOCTYPECODE,
