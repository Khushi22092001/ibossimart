    pageItem P130_DOCTYPECODE (
        type: popupLov
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.DocTypeName as d,
                	a.DocTypeCode as r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c, Module d
                where a.DocTypeCode = b.DocTypeCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode
                    and d.EntryPageNo = :APP_PAGE_ID
                    and  getdocumentstatuscode('DOCTYPE',a.TNO) = 'ACTIVE'
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @requisition-master
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 7
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @requisition-master
            column: DOCTYPECODE
            dataType: varchar2
        }
    )

