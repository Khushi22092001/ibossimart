            default {
                type: sqlQuerySingleValue
                sqlQuerySingleValue:
                    ```sql
                    select b.QUANTITY1 from issue a , issuedetail b , requisition c , requisitiondetail d
                    where a.tno = b.tno
                    and a.REQUISITIONTNO = c.tno
                    and c.tno = d.tno
                    and b.itemcode = d.itemcode
                    and b.ITEMSPECIFICATIONCODE = d.ITEMSPECIFICATIONCODE
                    and a.REQUISITIONTNO = :P130_TNO
                    ```
            }
            columnFilter {
                lovType: none
            }
            advanced {
                customAttributes: readonly=true
            }
        )

        column QUANTITY1 (
            type: numberField
            heading {
                heading: Quantity
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
                group: @primary
