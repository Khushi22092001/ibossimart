    process requisition-detail-save-interactive-grid-data (
        name: Requisition Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @requisition-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        When 'C' THEN
                            Insert Into REQUISITIONDETAIL(
                                TNO,
                                SNO,
                                SERIALNO,
                                DOCUMENTSTATUSCODE,
                                ITEMCODE,
                                ITEMSPECIFICATIONCODE,
                                DESCRIPTION,
                                QUANTITY1,
                                QUANTITY2,
                                REMARK,
                                QOH1,
                                QOH2,
                                ISSUEDQUANTITY1,
                                ISSUEDQUANTITY2,
                                MEASURINGUNITCODE1,
                                MEASURINGUNITCODE2,
                                QUANTITY,
                                REQUESTQUANTITY
                            )
                            VALUES(
                                :TNO,
                                :SNO,
                                :SERIALNO,
                                :DOCUMENTSTATUSCODE,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :DESCRIPTION,
                                :QUANTITY1,
                                :QUANTITY2,
                                :REMARK,
                                :QOH1,
                                :QOH2,
                                :ISSUEDQUANTITY1,
                                :ISSUEDQUANTITY2,
                                :MEASURINGUNITCODE1,
                                :MEASURINGUNITCODE2,
                                :QUANTITY,
                                :REQUESTQUANTITY
                            );
                        
                        WHEN 'U' THEN
                            UPDATE REQUISITIONDETAIL SET
                                    SNO=:SNO,
                                    SERIALNO=:SERIALNO,
                                    DOCUMENTSTATUSCODE=:DOCUMENTSTATUSCODE,
                                    ITEMCODE=:ITEMCODE,
                                    ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                    DESCRIPTION=:DESCRIPTION,
                                    QUANTITY1=:QUANTITY1,
                                    QUANTITY2=:QUANTITY2,
                                    REMARK=:REMARK,
                                    QOH1=:QOH1,
                                    QOH2=:QOH2,
                                    ISSUEDQUANTITY1=:ISSUEDQUANTITY1,
                                    ISSUEDQUANTITY2=:ISSUEDQUANTITY2,
                                    MEASURINGUNITCODE1=:MEASURINGUNITCODE1,
                                    MEASURINGUNITCODE2=:MEASURINGUNITCODE2,
                                    QUANTITY=:QUANTITY,
                                    REQUESTQUANTITY=:REQUESTQUANTITY
                            WHERE TNO = :P130_TNO
                                AND ROWID = :ROWID;
                        WHEN 'D' THEN
                            DELETE FROM INDENTDETAIL
                            WHERE TNO = :P130_TNO
                                AND SNO = :SNO
                                ;
                    end case;
                exception when others THEN
                    raise_application_error(-200010,sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 155661069925668816
        }
    )

