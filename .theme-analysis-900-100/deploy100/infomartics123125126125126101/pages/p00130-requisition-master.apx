    button addnew (
        buttonName: ADDNEW_1
        label: ADD NEW
        layout {
            sequence: 10
            region: @attachment
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 63
                items: {
                    P63_MODULETNO: &P130_TNO.
                }
                clearCache: 63
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back (
        buttonName: Back
