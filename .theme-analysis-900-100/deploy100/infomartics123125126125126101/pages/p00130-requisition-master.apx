page 130 (
    name: Requisition Master
    alias: REQUISITION-MASTER
    title: Requisition Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              
              var reportName = 'IRONMART/REPORT/Requisition.xdo';
              var outputFormat = 'pdf';
              var bireporturl = $('#P130_BIREPORTURL').val()
              var reportParams = 
                '&P_TNO=' + $('#P130_TNO').val() 
                  ;
            
             
                    var reportURL = bireporturl+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P130_BIREPORTURL').val()
              var reportName =  'Requisition.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '"_paramsP_TNO":"' + $('#P130_TNO').val() 
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            ```
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region attachment (
        name: Attachment
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       --A.SNO,
                       --DESCRIPTION,
                       B.PARTYATTRIBUTENAME,
                       A.ATTRIBUTEVALUE,
                       A.ATTACHMENTBLOB,
                       A.FILENAME,
                       A.ATTRIBUTECODE,
                       A.moduletno,
                       A.modulesno
                  from MODULEATTACHMENT A, PARTYATTRIBUTE B
                  Where A.ATTRIBUTECODE = PARTYATTRIBUTECODE
                    AND A.moduletno = :P130_TNO;
                ```
            pageItemsToSubmit: P130_TNO
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 63
                items: {
                    P63_MODULETNO: #MODULETNO#
                    P63_ATTRIBUTECODE: #ATTRIBUTECODE##SNO#
                }
                clearCache: 63
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        heading {
            fixedTo: region
            maxReportHeight: 350
        }
        advanced {
            savedReportMappingIdentifier: 741297400392178559
        }

