    dynamicAction check-item-type-code (
        name: Check Item Type Code
        execution {
            sequence: 100
        }
        when {
            event: focusout
            selectionType: items
            items: P71_PARTYTYPECODE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P71_PARTYTYPECODE")).length===0 ) {
                        showError("Party Type Code Should Not be Empty", 'P71_PARTYTYPECODE');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-item-type-name (
        name: Check Item Type Name
        execution {
            sequence: 110
        }
