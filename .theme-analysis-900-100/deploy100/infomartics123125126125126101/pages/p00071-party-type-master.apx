page 71 (
    name: Party Type Master
    alias: PARTY-TYPE-MASTER
    title: Party Type Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region party-type-master (
        name: Party Type Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       PARTYTYPECODE,
                       PARTYTYPENAME,
                       NATURE,
                       REMARK
                  from PARTYTYPE
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P71_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P71_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 210
            region: @fields
            slot: regionBody
        }
    )

    pageItem P71_MODULEFLOW (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 200
            region: @fields
            slot: regionBody
        }
    )

    pageItem P71_NATURE (
        type: textField
        label {
            label: Nature
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @party-type-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @party-type-master
            column: NATURE
            dataType: varchar2
        }
    )

    pageItem P71_ONTHETABLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 190
            region: @fields
            slot: regionBody
        }
    )

    pageItem P71_PARTYTYPECODE (
        type: textField
        label {
            label: Party Type Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @party-type-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @party-type-master
            column: PARTYTYPECODE
            dataType: varchar2
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'PARTYTYPE'
                       and a.CodeScheme = 'AUTO'
                ```
        }
    )

    pageItem P71_PARTYTYPENAME (
        type: textField
