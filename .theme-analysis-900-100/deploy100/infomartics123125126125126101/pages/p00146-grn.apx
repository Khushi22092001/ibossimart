        column JOBORDERTNO (
            type: popupLov
            heading {
                heading: Job order No
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select 
                             a.joborderno,
                             a.tno
                    from 
                             joborder a
                    where
                            a.partycode = :PARTYCODE
                            and a.companycode = :global_companycode
                            and exists (
                                 select aa.partycode from joborder aa , Joborderdetail bb
                                  where aa.tno = bb.tno
                                        and aa.partycode = a.partycode
                                        and bb.jobtypecode = :jobtypecode
                                        And aa.tno = a.tno 
                                  )
                     Order by 
                               a.joborderdate, a.joborderno
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: [
                    JOBTYPECODE
                    PARTYCODE
                ]
                itemsToSubmit: [
                    JOBTYPECODE
                    PARTYCODE
                ]
                parentRequired: false
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: JOBORDERTNO
                dataType: number
            }
        )

