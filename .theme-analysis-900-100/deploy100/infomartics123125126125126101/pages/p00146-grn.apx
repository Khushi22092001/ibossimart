    region grnjob (
        name: GrnJob
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       JOBTYPECODE,
                       PARTYCODE,
                       JOBORDERTNO,
                       REMARK,
                       SERIALNO,
                       QUANTITY1,
                       QUANTITY2,
                       JOBPOSTEDTOSTOCK,
                       JOBPOSTEDTOSTOCKRATE
                  from GRNJOB
                  where tno = :P146_TNO
                ```
            pageItemsToSubmit: P146_TNO
        }
        layout {
            sequence: 80
