    dynamicAction set-the-storage-location-for-out-to-out-case (
        name: Set The Storage Location for Out to Out Case
        execution {
            sequence: 740
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @grndetail
            columns: RECEIVEDQUANTITY1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        -- Process only if it is an Out-to-Out case
                        IF :P146_IS_OUT_TO_OUT_CASE = 1 THEN
                            
                            BEGIN
                                INSERT INTO grndetailstorage (
                                    TNO, SNO, SN, STORAGELOCATIONCODE, 
                                    UNLOADINGQUANTITY1, UNLOADINGQUANTITY2, 
                                    REJECTEDQUANTITY1, REMARK
                                )
                                SELECT 
                                    :P146_TNO, 
                                    :P146_SNO, 
                                    GlobalTno.NEXTVAL, 
                                    sl.StorageLocationCode, 
                                    :RECEIVEDQUANTITY1, 
                                    :RECEIVEDQUANTITY2, 
                                    :REJECTEDQUANTITY1, 
                                    'AUTO INSERTED FOR OTO CASE'
                                FROM StorageLocation sl
                                INNER JOIN Party p      ON p.PartyName = sl.StorageLocationName
                                INNER JOIN SalesOrder so ON so.PartyCode = p.PartyCode
                                INNER JOIN LoadingAdvice la ON la.SalesOrderTno = so.TNo
                                WHERE la.TNo = :P146_LOADINGADVICETNO
                                  AND ROWNUM = 1; 
                    
                                COMMIT;
                    
                            EXCEPTION
                                WHEN OTHERS THEN
                                    ROLLBACK; 
                                    RAISE_APPLICATION_ERROR(-20001, 'Error during OTO auto-insert: ' || SQLERRM);
                            END;
                            
                        END IF;
                    END;
                    
                    ```
                itemsToSubmit: [
                    P146_TNO
                    P146_SNO
                    P146_LOADINGADVICETNO
                    RECEIVEDQUANTITY1
                    RECEIVEDQUANTITY2
                    REJECTEDQUANTITY2
                    P146_IS_OUT_TO_OUT_CASE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-value-for-stock-required (
        name: set value for stock required
        execution {
            sequence: 710
        }
        when {
            event: focusout
            selectionType: items
            items: P146_LOADINGADVICETNO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    rtvalue varchar2(30);
                    begin
                    if :P146_LOADINGADVICETNO is not null then
                        for vloop in (
                                Select  *
                                 From loadingadvice a 
                                Where A.TNO = :P146_LOADINGADVICETNO
                                  and (a.ispartylocation='YES'           -- Change it to 'YES' from 'No' to enable to stock allocation for Out to Out Cases  -- Changed by Vibhor
                                   OR getmyparametervalue('STOCKREQUIREDFOROUTWARD')='YES')
                        ) loop
                                rtvalue := 'YES';
                          end loop;
                    else
                        rtvalue := 'YES';
                    end if;
                    return(nvl(rtvalue,'NO'));
                    end;
                    
                    ```
                itemsToSubmit: P146_LOADINGADVICETNO
            }
            affectedElements {
                selectionType: items
                items: P146_STOCKREQUIRED
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                        v_rtn NUMBER := 0;
                    BEGIN
                        BEGIN
                            SELECT 1 INTO v_rtn
                            FROM dual
                            WHERE EXISTS (
                                SELECT 1 
                                FROM LoadingAdvice
                                WHERE TNo = :P146_LOADINGADVICETNO
                                  AND SalesOrderTno IS NOT NULL 
                                  AND ispartylocation = 'YES'
                            );
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN
                                v_rtn := 0;
                        END;
                    
                        RETURN v_rtn;
                    END;
                    
                    ```
                itemsToSubmit: P146_LOADINGADVICETNO
            }
            affectedElements {
                selectionType: items
                items: P146_IS_OUT_TO_OUT_CASE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

