    dynamicAction set-discrepancytypecode (
        name: Set DISCREPANCYTYPECODE
        execution {
            sequence: 150
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @grndetail
            columns: [
                RECEIVEDQUANTITY1
                CHALANQUANTITY1
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: columns
                columns: DISCREPANCYTYPECODE
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: abs(nvl(:CHALANQUANTITY1,0)-nvl(:RECEIVEDQUANTITY1,0))
                itemsToSubmit: [
                    CHALANQUANTITY1
                    RECEIVEDQUANTITY1
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: REJECTQUANTITY
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                     rtvalue varchar2(30);
                    begin
                        if nvl(:CHALANQUANTITY1,0) - nvl(:RECEIVEDQUANTITY1,0 ) > 0 then
                            rtvalue := 'SHORT';
                         ELSIF nvl(:CHALANQUANTITY1,0) < nvl(:RECEIVEDQUANTITY1,0)  then
                            rtvalue := 'EXCESS';
                         else
                            rtvalue := 'NONE';
                         end if;
                         return rtvalue;
                    
                    end ;
                    ```
                itemsToSubmit: [
                    CHALANQUANTITY1
                    RECEIVEDQUANTITY1
                ]
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: columns
                columns: DISCREPANCYTYPECODE
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

