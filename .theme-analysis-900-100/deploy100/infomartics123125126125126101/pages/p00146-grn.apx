    region stockstoragedetail (
        name: StockStorageDetail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid , TNO,
                       SNO,
                       SN,
                       STOCKTNO,
                       STORAGELOCATIONCODE,
                       QUANTITY1,
                       QUANTITY2
                  from GRNSTOCKSTORAGEDETAIL
                  where tno = :P146_TNO
                  and sno = :P146_SNO
                ```
            pageItemsToSubmit: [
                P146_TNO
                P146_SNO
            ]
