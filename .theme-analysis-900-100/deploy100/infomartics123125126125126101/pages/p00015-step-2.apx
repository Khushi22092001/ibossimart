page 15 (
    name: Step 2
    alias: STEP-2
    title: Step 2
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region step (
        name: Step 2
        type: list
        source {
            list: @company
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/wizard-container
            templateOptions: [
                #DEFAULT#
                t-Wizard--hideStepsXSmall
            ]
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region step-2 (
        name: Step 2
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       OFFICEADDRESS,
                       OFFICECITYCODE,
                       OFFICESTATECODE,
                       OFFICEPINCODE,
                       OFFICEPHONENO,
                       OFFICEFAXNO,
                       OFFICEEMAIL     
                  from COMPANY
                ```
        }
        layout {
            sequence: 10
            parentRegion: @step
            slot: wizardSubRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P15_OFFICEADDRESS (
        type: textField
        label {
            label: Officeaddress
            alignment: left
        }
        layout {
            sequence: 140
            region: @step-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @step-2
            column: OFFICEADDRESS
            dataType: varchar2
        }
    )

    pageItem P15_OFFICECITYCODE (
        type: textField
        label {
            label: Officecitycode
            alignment: left
        }
        layout {
            sequence: 150
            region: @step-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @step-2
            column: OFFICECITYCODE
            dataType: varchar2
        }
    )

    pageItem P15_OFFICEEMAIL (
        type: textField
        label {
            label: Officeemail
            alignment: left
        }
        layout {
            sequence: 200
            region: @step-2
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @step-2
            column: OFFICEEMAIL
            dataType: varchar2
        }
    )

    pageItem P15_OFFICEFAXNO (
        type: textField
        label {
            label: Officefaxno
            alignment: left
        }
        layout {
            sequence: 190
            region: @step-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @step-2
            column: OFFICEFAXNO
            dataType: varchar2
        }
    )

    pageItem P15_OFFICEPHONENO (
        type: textField
        label {
            label: Officephoneno
            alignment: left
        }
        layout {
            sequence: 180
            region: @step-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @step-2
            column: OFFICEPHONENO
            dataType: varchar2
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P15_OFFICEPINCODE (
        type: textField
        label {
            label: Officepincode
            alignment: left
        }
        layout {
            sequence: 170
            region: @step-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @step-2
            column: OFFICEPINCODE
            dataType: varchar2
        }
    )

    pageItem P15_OFFICESTATECODE (
        type: textField
        label {
            label: Officestatecode
            alignment: left
        }
        layout {
            sequence: 160
            region: @step-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @step-2
            column: OFFICESTATECODE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @step
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @step
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: t-Button--iconRight
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 20
            region: @step
            slot: previous
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process initialize-form-step (
        name: Initialize form Step 2
        type: formInitialization
        formRegion: @step-2
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 135484952455072348
        }
    )

    branch (
        execution {
            sequence: 10
            point: validating
        }
        behavior {
            target: {
                page: 14
            }
        }
        serverSideCondition {
            whenButtonPressed: @previous
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 16
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

