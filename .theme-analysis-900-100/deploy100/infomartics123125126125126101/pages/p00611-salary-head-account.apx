page 611 (
    name: Salary Head Account
    alias: SALARY-HEAD-ACCOUNT
    title: Salary Head Account
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important;
              
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region salary-head-account-list (
        name: Salary Head Account List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,
                       a.modulecode,
                       a.salaryheadaccountcode,
                       a.salaryheadcode,
                       b.salaryheadname,
                       a.stafftypecode,
                       c.stafftypename,
                       a.categorycode,
                       a.accountcode,
                       d.partyname,
                       a.companycode,
                       a.drcr,
                       a.remark,
                       a.creator,
                       to_char(A.CREATIONTIME,'DD-MM-YYYY HH24:MI:SS') CREATIONTIME
                  From salaryheadaccount a, salaryhead b, stafftype c, party d
                 Where a.salaryheadcode = b.salaryheadcode(+)
                   And a.stafftypecode = c.stafftypecode(+)
                   And a.accountcode = d.partycode(+)
                   And a.companycode = :global_companycode
                Order By A.TNO Desc
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 612
                items: {
                    P612_TNO: \#TNO#\
                }
                clearCache: 612
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 206206933222287949
        }

        column ACCOUNTCODE (
            type: plainText
            heading {
                heading: Accountcode
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

        column CATEGORYCODE (
            type: plainText
            heading {
                heading: Categorycode
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Y
            }
        )

        column COMPANYCODE (
            type: hidden
