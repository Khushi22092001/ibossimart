            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Challan List
        }

        savedReport 215012 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTCODE (
                sequence: 3
            )

            displayColumn CHALLANAMOUNT (
                sequence: 4
            )

            displayColumn CHALLANDATE (
                sequence: 5
            )

            displayColumn CHALLANNO (
                sequence: 6
            )

            displayColumn COMPANYCODE (
                sequence: 7
            )

            displayColumn COVERINGLETTERNO (
                sequence: 19
            )

            displayColumn CREATIONTIME (
                sequence: 25
            )

            displayColumn CREATOR (
                sequence: 21
            )

            displayColumn DEPOSITEDINBANKCODE (
                sequence: 16
            )

            displayColumn DEPOSITORCODE (
                sequence: 17
            )

            displayColumn DOCTYPE (
                sequence: 1
            )

            displayColumn FILENAME (
                sequence: 24
            )

            displayColumn FINANCIALYEARCODE (
                sequence: 8
            )

            displayColumn FROMDATE (
                sequence: 9
            )

            displayColumn LOCATION (
                sequence: 2
            )

            displayColumn MODULECODE (
                sequence: 22
            )

            displayColumn MODULETNO (
                sequence: 23
            )

            displayColumn MONEYTRANSFERMODECODE (
                sequence: 10
            )

            displayColumn MONEYTRANSFERREFERENCEDATE (
                sequence: 11
            )

            displayColumn MONEYTRANSFERREFERENCENO (
                sequence: 12
            )

            displayColumn NARRATION (
                sequence: 18
            )

            displayColumn PAYMENTDONE (
                sequence: 13
            )

            displayColumn REMARK (
                sequence: 14
            )

            displayColumn TAXSECTIONCODE (
                sequence: 20
            )

            displayColumn TODATE (
                sequence: 15
            )

        )

    )

    pageItem P311_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @/title
            slot: regionBody
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @challan-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 312
                clearCache: 312
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @challan-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

