page 311 (
    name: Challan List
    alias: CHALLAN-LIST
    title: Challan List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region challan-list (
        name: Challan List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ACCOUNTCODE,
                       CHALLANAMOUNT,
                       CHALLANDATE,
                       CHALLANNO,
                       COMPANYCODE,
                       getdoctypename(DOCTYPECODE) doctype,
                       FINANCIALYEARCODE,
                       FROMDATE,
                       getlocationname(LOCATIONCODE) location,
                       MONEYTRANSFERMODECODE,
                       MONEYTRANSFERREFERENCEDATE,
                       MONEYTRANSFERREFERENCENO,
                       PAYMENTDONE,
                       REMARK,
                       TNO,
                       TODATE,
                       DEPOSITEDINBANKCODE,
                       DEPOSITORCODE,
                       NARRATION,
                       COVERINGLETTERNO,
                       TAXSECTIONCODE,
                       CREATOR,
                       MODULECODE,
                       MODULETNO,
                       FILENAME,
                       CREATIONTIME
                  from CHALLAN
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 312
                items: {
                    P312_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 21489434485653548
        }

        column ACCOUNTCODE (
            type: plainText
            heading {
                heading: Accountcode
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column CHALLANAMOUNT (
            type: plainText
            heading {
                heading: Challanamount
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column CHALLANDATE (
            type: plainText
            heading {
                heading: Challandate
            }
            layout {
                sequence: 3
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column CHALLANNO (
            type: plainText
            heading {
                heading: Challanno
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column COVERINGLETTERNO (
            type: plainText
            heading {
                heading: Coveringletterno
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creationtime
            }
            layout {
                sequence: 26
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Z
            }
        )

        column CREATOR (
