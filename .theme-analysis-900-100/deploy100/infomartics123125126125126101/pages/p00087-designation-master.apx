    dynamicAction check-designation-name (
        name: Check Designation Name
        execution {
            sequence: 100
        }
        when {
            event: focusout
            selectionType: items
            items: P87_DESIGNATIONNAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P87_DESIGNATIONNAME")).length===0 ) {
                        showError("Designation Name Should Not Empty", 'P87_DESIGNATIONNAME');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-designation-shortname (
        name: CHECK DESIGNATION SHORTNAME
        execution {
            sequence: 110
        }
        when {
            selectionType: items
            items: P87_DESIGNATIONSHORTNAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P87_DESIGNATIONSHORTNAME")).length===0 ) {
                        showError("Designation Short Name Should Not be Empty", 'P87_DESIGNATIONSHORTNAME');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

