            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @designation-master
            column: DESIGNATIONSHORTNAME
            dataType: varchar2
        }
    )

