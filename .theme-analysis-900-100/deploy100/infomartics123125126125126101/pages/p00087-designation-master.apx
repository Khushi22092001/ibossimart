page 87 (
    name: Designation Master
    alias: DESIGNATION-MASTER
    title: Designation Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region designation-master (
        name: Designation Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       DESIGNATIONCODE,
                       DESIGNATIONNAME,
                       DESIGNATIONSHORTNAME,
                       CREATOR,
                       CREATIONTIME,
                       REMARK
                  from DESIGNATION
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region flow-buttons (
        name: Flow Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: BEFORE_NAVIGATION_BAR
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    pageItem P87_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P87_CREATIONTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @designation-master
            slot: regionBody
        }
        appearance {
            formatMask: DD-MON-YYYY HH:MIPM
        }
        source {
            formRegion: @designation-master
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MM-YYYY HH24:MI:SS') from dual
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P87_DESIGNATIONCODE
        }
    )

    pageItem P87_CREATOR (
        type: hidden
        layout {
            sequence: 90
            region: @designation-master
            slot: regionBody
        }
        source {
            formRegion: @designation-master
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: item
            item: GLOBAL_LOGINNAME
        }
    )

    pageItem P87_DESIGNATIONCODE (
        type: popupLov
        label {
            label: Designation Code
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select designationname, designationcode from designation;
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @designation-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @designation-master
            column: DESIGNATIONCODE
            dataType: varchar2
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'DESIGNATION'
                       and a.CodeScheme = 'AUTO'
                ```
        }
    )

    pageItem P87_DESIGNATIONNAME (
        type: textField
        label {
            label: Designation Name
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @designation-master
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
