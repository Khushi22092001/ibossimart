    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 144380787473373047
        }
    )

    process get-designation-code (
        name: Get Designation Code
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'DESIGNATION';
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P87_DESIGNATIONCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P87_DESIGNATIONCODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 144435186576470411
        }
    )

    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P87_TNO is null then
                            :P87_FORMSTATUS := 'NEWRECORD';
                        else
                            :P87_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P87_TNO is null then
                
                        select globaltno.nextval into :P87_TNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 144398984188404498
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P87_MODULEFLOW := 'YES';
                   else
                       :P87_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P87_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P87_ONTHETABLE := 'YES' ;
                   else
                       :P87_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 144399265522405086
        }
    )

    process initialize-form-designation-master (
        name: Initialize form Designation Master
        type: formInitialization
        formRegion: @designation-master
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 144379964221373046
        }
    )

    process process-form-designation-master (
        name: Process form Designation Master
        type: formAutoRowProcessing
        formRegion: @designation-master
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 144380369913373047
        }
    )

)

