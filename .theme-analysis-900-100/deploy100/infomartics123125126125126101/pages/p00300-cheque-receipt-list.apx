page 300 (
    name: Cheque Receipt List
    alias: CHEQUE-RECEIPT-LIST
    title: Cheque Receipt List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cheque-receipt-list (
        name: Cheque Receipt List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select getpartyname(BANKCODE) bank,
                       BOOKNO,
                       CHEQUENOPREFIX,
                       CHEQUENOSTART,
                       CHEQUENOSUFFIX,
                       CHEQUERECEIPTCODE,
                       CHEQUERECEIPTDATE,
                       COMPANYCODE,
                       REMARK,
                       STARTSERIALNO,
                       TNO,
                       TOTALCHEQUE,
                       FORMATSTRING,
                       CREATOR,
                       CREATIONTIME
                  from CHEQUERECEIPT 
                  where CHEQUERECEIPTDATE between :P300_FROMDATE and :P300_TODATE
                  --and ( :P300_DOCTYPE IS NULL OR instr(':'||:P300_DOCTYPE||':',':'||a.DocTypeCode||':') > 0 ) 
                  --and ( :P300_LOCATION IS NULL OR instr(':'||:P300_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                 and ( :P300_COMPANY IS NULL OR instr(':'||:P300_COMPANY||':',':'||CompanyCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 301
                items: {
                    P301_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 32133882525513610
        }

        column BANK (
            type: plainText
            heading {
                heading: Bank
            }
            layout {
                sequence: 25
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column BOOKNO (
            type: plainText
            heading {
                heading: Book no
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CHEQUENOPREFIX (
            type: plainText
            heading {
                heading: Cheque no prefix
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CHEQUENOSTART (
            type: plainText
            heading {
                heading: Cheque no start
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column CHEQUENOSUFFIX (
            type: plainText
            heading {
                heading: Cheque no suffix
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column CHEQUERECEIPTCODE (
            type: plainText
            heading {
                heading: Cheque receipt code
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column CHEQUERECEIPTDATE (
            type: plainText
            heading {
                heading: Cheque receipt date
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Company
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation time
            }
            layout {
                sequence: 15
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: O
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column FORMATSTRING (
            type: plainText
            heading {
                heading: Format string
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column STARTSERIALNO (
            type: plainText
            heading {
                heading: Start serial no
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column TOTALCHEQUE (
            type: plainText
            heading {
                heading: Total cheque
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cheque Receipt List
        }

        savedReport 321406 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BOOKNO (
                sequence: 2
            )

            displayColumn CHEQUENOPREFIX (
                sequence: 3
            )

            displayColumn CHEQUENOSTART (
                sequence: 4
            )

            displayColumn CHEQUENOSUFFIX (
                sequence: 5
            )

            displayColumn CHEQUERECEIPTCODE (
                sequence: 6
            )

            displayColumn CHEQUERECEIPTDATE (
                sequence: 7
            )

            displayColumn COMPANYCODE (
                sequence: 8
            )

            displayColumn CREATIONTIME (
                sequence: 14
            )

            displayColumn CREATOR (
                sequence: 13
            )

            displayColumn FORMATSTRING (
                sequence: 12
            )

            displayColumn REMARK (
                sequence: 9
            )

            displayColumn STARTSERIALNO (
                sequence: 10
            )

            displayColumn TNO (
                sequence: 1
            )

            displayColumn TOTALCHEQUE (
                sequence: 11
            )

        )

    )

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    pageItem P300_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = getModuleCodeForPageNo(:APP_PAGE_ID)
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and upper(bu.BossUserName) =  upper('&APP_USER.')
                  and getcompanyprivilege(C.COMPANYCODE,GETMODULECODEFORPAGENO(:APP_PAGE_ID),:GLOBAL_LOGINNAME)='YES'
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
    )

    pageItem P300_DOCTYPE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
        }
    )

    pageItem P300_FROMDATE (
        type: datePicker
        label {
            label: From date
            alignment: left
        }
        layout {
            sequence: 50
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: sysdate-3
        }
    )

    pageItem P300_LOCATION (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @filter
            slot: regionBody
        }
    )

    pageItem P300_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @/title
            slot: regionBody
        }
    )

    pageItem P300_TODATE (
        type: datePicker
        label {
            label: To date
            alignment: left
        }
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @cheque-receipt-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 301
                clearCache: 301
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @cheque-receipt-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 80
            region: @filter
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

