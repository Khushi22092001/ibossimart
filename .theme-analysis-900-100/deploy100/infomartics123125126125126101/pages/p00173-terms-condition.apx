    process get-doc-no (
        name: Get Doc No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getmodulecodeforpageno(:APP_PAGE_ID);
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P173_TERMSANDCONDITIONHEADCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P173_TERMSANDCONDITIONHEADCODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 6761357127479300
        }
    )

