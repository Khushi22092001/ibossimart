        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/StockStatus.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P407_FROMDATE=&P407_FROMDATE.&P407_TODATE=&P407_TODATE.&P407_LOCATION=&P407_LOCATION.&P407_ITEM=&P407_ITEM.&
            warnOnUnsavedChanges: doNotCheck
