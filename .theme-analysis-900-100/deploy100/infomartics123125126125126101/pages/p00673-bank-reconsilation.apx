    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P673_Tno is null then
                        Select GlobalTno.NextVal into :P673_Tno From Dual;
                     end if;
                    ----
                    if :P673_TOUREXPENSENO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P673_LocationCode,
                					:P673_DocTypeCode,
                					NULL,
                					TO_DATE(:P673_TOUREXPENSEDATE, 'DD-MM-RRRR')
                				);
                        :P673_TOUREXPENSENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P673_LocationCode,
                                    :P673_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P673_TOUREXPENSEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 32477149432360296
        }
        serverSideCondition {
            type: never
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P673_TNO is null then
                    :P673_TNO := GlobalTNo.nextval;
                    :P673_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P673_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P673_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P673_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32476341111360296
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P673_MODULEFLOW := 'YES';
                   else
                       :P673_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P673_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P673_ONTHETABLE := 'YES' ;
                   else
                       :P673_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32476741255360296
        }
    )

    process send-pass-fail (
        name: "Send Pass Fail "
