page 226 (
    name: Show Blob_1
    alias: SHOW-BLOB-1
    title: Show Blob_1
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            td[headers="VIMAGE"] img { width: 500px;    border: 1px solid #999;    background: #f6f6f6;   }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region show-blob (
        name: Show Blob
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                  select 
                A.MODULETNO,
                A.MODULESNO,
                A.ATTRIBUTECODE,
                A.ATTRIBUTEVALUE,
                dbms_lob.getlength(a.ATTACHMENTBLOB) AS ATTACHMENTBLOB,
                FILENAME,
                MIMETYPE
                from moduleattachment A
                where a.MODULETNO = :P226_TNO
                  AND a.MODULESNO = :P226_SNO
                ```
            pageItemsToSubmit: [
                P226_TNO
                P226_SNO
            ]
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
                t-Region--removeHeader js-removeLandmark
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 117651317422472804
        }

        column ATTACHMENTBLOB (
            type: displayImage
            heading {
                heading: &P226_FILENAME.
                alignment: center
            }
            singleRowView {
                useColumnHeading: false
                label: Filename
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            blobAttributes {
                tableName: MODULEATTACHMENT
                blobColumn: ATTACHMENTBLOB
                primaryKeyColumn1: MODULESNO
                mimeTypeColumn: MIMETYPE
                filenameColumn: FILENAME
            }
            source {
                dataType: NUMBER
            }
            advanced {
                htmlDomId: VIMAGE
                endUserAlias: M
            }
            enableUsersTo {
                hide: false
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column ATTRIBUTECODE (
            type: plainText
            heading {
                heading: Attributecode
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ATTRIBUTEVALUE (
            type: plainText
            heading {
                heading: Attributevalue
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column FILENAME (
            type: plainText
            heading {
                heading: Filename
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                htmlDomId: Filename
                endUserAlias: K
            }
        )

        column MIMETYPE (
            type: plainText
            heading {
                heading: Mimetype
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column MODULESNO (
            type: plainText
            heading {
                heading: Modulesno
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column MODULETNO (
            type: plainText
            heading {
                heading: Moduletno
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        savedReport 586335 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATTACHMENTBLOB (
                sequence: 1
            )

        )

    )

    pageItem P226_FILENAME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @show-blob
            slot: regionBody
        }
    )

    pageItem P226_SNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @show-blob
            slot: regionBody
        }
    )

    pageItem P226_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @show-blob
            slot: regionBody
        }
    )

)

