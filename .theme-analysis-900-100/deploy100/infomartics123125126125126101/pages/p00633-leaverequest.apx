                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column LEAVEREQUESTDATE (
            type: plainText
            heading {
                heading: Leave Request Date
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column LEAVEREQUESTNO (
            type: plainText
