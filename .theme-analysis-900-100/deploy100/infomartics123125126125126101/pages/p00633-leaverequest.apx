            type: hidden
            heading {
                heading: Moduletno
            }
            layout {
                sequence: 98
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 28
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column STAFFTYPECODE (
            type: hidden
            heading {
                heading: Stafftypecode
            }
            layout {
                sequence: 68
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column STAFFTYPENAME (
            type: plainText
            heading {
                heading: Staff Type
            }
            layout {
                sequence: 78
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column TOEMPLOYEECODE (
            type: hidden
            heading {
                heading: Toemployeecode
            }
            layout {
                sequence: 108
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: LEAVEREQUEST
        }

        savedReport 191094 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEPARTMENTNAME (
                sequence: 3
            )

            displayColumn EMPLOYEENAME (
                sequence: 4
            )

            displayColumn LEAVEREQUESTDATE (
                sequence: 2
            )

            displayColumn LEAVEREQUESTNO (
                sequence: 1
            )

            displayColumn REMARK (
                sequence: 6
            )

            displayColumn STAFFTYPENAME (
                sequence: 5
            )

        )

    )

    pageItem P633_TNO (
        type: hidden
        layout {
            sequence: 20
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @leaverequest
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 634
                clearCache: 634
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @leaverequest
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

