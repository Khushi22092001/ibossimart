page 633 (
    name: LEAVEREQUEST
    alias: LEAVEREQUEST
    title: Leave Request
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region leaverequest (
        name: LEAVEREQUEST
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.COMPANYCODE,
                       A.FINANCIALYEARCODE,
                       A.DOCTYPECODE,
                       A.LOCATIONCODE,
                       A.LEAVEREQUESTNO,
                       A.LEAVEREQUESTDATE,
                       A.EMPLOYEECODE,
                       E.EMPLOYEENAME,
                       D.DEPARTMENTNAME,
                       A.REMARK,
                       A.CREATOR,
                       A.DEPARTMENTCODE,
                       A.STAFFTYPECODE,
                       S.STAFFTYPENAME,
                       A.MODULECODE,
                       A.MODULETNO,
                       A.TOEMPLOYEECODE,
                       A.CREATIONTIME
                  from LEAVEREQUEST A,LEAVEREQUESTDETAIL B,EMPLOYEE E,DEPARTMENT D,STAFFTYPE S
                  WHERE A.TNO=B.TNO
                  AND A.EMPLOYEECODE=E.EMPLOYEECODE(+)
                  AND A.DEPARTMENTCODE = D.DEPARTMENTCODE(+) 
                  AND A.STAFFTYPECODE = S.STAFFTYPECODE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 634
                items: {
                    P634_TNO: #TNO#
                }
                clearCache: 634
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 19102076264151121
        }

        column COMPANYCODE (
            type: hidden
            heading {
                heading: Companycode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATIONTIME (
            type: hidden
            heading {
                heading: Creationtime
            }
            layout {
                sequence: 118
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: P
            }
        )

        column CREATOR (
            type: hidden
            heading {
                heading: Creator
            }
            layout {
                sequence: 38
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column DEPARTMENTCODE (
            type: hidden
            heading {
                heading: Departmentcode
            }
            layout {
                sequence: 48
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DEPARTMENTNAME (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 58
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column DOCTYPECODE (
            type: hidden
