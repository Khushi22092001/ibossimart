page 637 (
    name: LOANREQUEST
    alias: LOANREQUEST1
    title: Loan Request
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region loan-request (
        name: Loan Request
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.COMPANYCODE,
                       A.FINANCIALYEARCODE,
                       A.LOCATIONCODE,
                       A.DOCTYPECODE,
                       A.LOANREQUESTNO,
                       A.LOANREQUESTDATE,
                       A.EMPLOYEECODE,
                       E.EMPLOYEENAME,
                       A.LOANTYPECODE,
                       A.LOANAMOUNT,
                       A.MERGEDAMOUNT,
                       A.TOTALAMOUNT,
                       A.INSTALLMENTAMOUNT,
                       A.NOOFINSTALLMENT,
                       A.DEDUCTIONSTARTDATE,
                       A.REMARK,
                       A.MONEYTRANSFERMODECODE,
                       A.MODULETNO,
                       A.MODULECODE,
                       A.MODULESNO,
                       A.CREATIONTIME,
                       A.CREATOR,
                                   '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||9993||':'||:APP_SESSION||'::::'||'P9993_TNO,P9993_REPNAME'||':'||A.Tno||','||'LoanRequest'||':NO')||'"><span aria-label="Action"><span class="fa fa-print"  aria-hidden="true" title="Action"></span</span></a>' AS Print
                
                  from LOANREQUEST A,EMPLOYEE E
                  WHERE A.EMPLOYEECODE = E.EMPLOYEECODE
                
                ```
            pageItemsToSubmit: P637_TNO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 636
                items: {
                    P636_TNO: #TNO#
                }
                clearCache: 636
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 20355274249840731
        }

        column COMPANYCODE (
            type: hidden
            heading {
                heading: Companycode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATIONTIME (
            type: hidden
            heading {
                heading: Creationtime
            }
            layout {
                sequence: 158
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: U
            }
        )

