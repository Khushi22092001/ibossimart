        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Loan Request
        }

        savedReport 203645 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMPLOYEENAME (
                sequence: 4
            )

            displayColumn INSTALLMENTAMOUNT (
                sequence: 9
