    dynamicAction insert-into-grn-detail (
        name: Insert into Grn Detail
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @getitem
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                        for vloop in (SELECT
                                            a.itemcode,
                                            a.itemspecificationcode,
                                            a.packingtypecode,
                                            a.packingnos,
                                            a.quantity1,
                                            a.remark,
                                            b.rate,
                                            b.amount,
                                            c.tno
                                        FROM
                                            materialindetail    a,
                                            purchaseorderdetail b,
                                            purchaseorder c
                                        WHERE
                                                a.tno = :P189_MATERIALINTNO
                                            AND b.tno IN (
                                                SELECT
                                                    purchaseordertno
                                                FROM
                                                    materialin
                                                WHERE
                                                    tno = :P189_MATERIALINTNO
                                            )
                                            AND a.itemcode = b.itemcode
                                            AND a.itemspecificationcode = b.itemspecificationcode
                                            and b.tno = c.tno
                                    )
                        loop
                            insert into grndetail (tno , 
                                                    sno,
                                                    ITEMCODE , 
                                                    ITEMSPECIFICATIONCODE , 
                                                    PACKINGTYPECODE , 
                                                    PACKINGNOS , 
                                                    CHALANQUANTITY1 , 
                                                    REMARK,
                                                    RATE,
                                                    AMOUNT,
                                                    PURCHASEORDERTNO
                                                    )
                                                    values
                                                    (
                                                        :P189_TNO,
                                                        globaltno.nextval,
                                                        vloop.ITEMCODE , 
                                                        vloop.ITEMSPECIFICATIONCODE , 
                                                        vloop.PACKINGTYPECODE , 
                                                        vloop.PACKINGNOS , 
                                                        vloop.QUANTITY1 , 
                                                        vloop.REMARK,
                                                        vloop.RATE,
                                                        vloop.AMOUNT,
                                                        vloop.tno
                                                    );
                    
                        end loop;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P189_TNO
                    P189_MATERIALINTNO
                    P189_GATEPASSTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @grndetail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P189_CALLEDFROMPAGE').getValue();
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

