    dynamicAction check-loc (
        name: Check Loc
        execution {
            sequence: 200
        }
        when {
            event: focusout
            selectionType: items
            items: P189_LOCATIONCODE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P189_LOCATIONCODE")).length===0 ) {
                        showError("Location Should Not Empty", 'P189_LOCATIONCODE');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-location (
        name: Check Location
        execution {
            sequence: 190
        }
        when {
            event: focusout
            selectionType: items
            items: P189_DOCTYPECODE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P189_DOCTYPECODE")).length===0 ) {
                        showError("Location Should Not Empty", 'P189_DOCTYPECODE');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-shortage (
        name: Check shortage
        execution {
            sequence: 160
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @grndetail
            columns: DISCREPANCYTYPECODE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :RECEIVEDQUANTITY < :CHALANQUANTITY THEN
                    
                        IF :DISCREPANCYTYPECODE IS NULL THEN
                    
                            RAISE_APPLICATION_ERROR(-20000,'DISCREPANCY TYPE CANNOT BE LEFT BLANK!');
                    
                        END IF;
                    
                    END IF;
                    ```
                itemsToSubmit: [
                    CHALANQUANTITY1
                    RECEIVEDQUANTITY1
                    DISCREPANCYTYPECODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction create-dinspection (
        name: Create DInspection
        execution {
            sequence: 210
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P189_STATUS = 'ACTIVE' then
                    
                        if :P189_DOCTYPECODE = 'CONVERSIONJOBOUTOFPREMISES' then
                            CreateStockTransferFromGRN(:P189_TNO);
                        else
                    
                            CreateDInspection(:P189_TNO);
                        end if;
                    
                    end if;
                    ```
                itemsToSubmit: [
                    P189_STATUS
                    P189_DOCTYPECODE
                    P189_TNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 140
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from grndetail a
                    where not exists (select 1 from grn aa where aa.tno = a.tno);
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction delete-unsaved-records (
        name: Delete unsaved records
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
