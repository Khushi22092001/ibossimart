    process get-on-the-table (
        name: Get on the table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P189_MODULEFLOW := 'YES';
                   else
                       :P189_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P189_ONTHETABLE := 'YES' ;
                   else
                       :P189_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 24687835361745012
        }
    )

    process get-tno (
        name: Get Tno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P189_TNO is null then
                    select globaltno.nextval into :P189_TNO from dual;
                end if; 
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21364013045042393
        }
    )

    process grndetail-save-interactive-grid-data (
        name: GrnDetail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @grndetail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into GRNDETAIL (                 
                                    TNO,
                SNO,
                ITEMCODE,
                ITEMSPECIFICATIONCODE,
                STOREAGELOCATIONCODE,
                CHALANQUANTITY1,
                RECEIVEDQUANTITY1,
                CHALANQUANTITY2,
                RECEIVEDQUANTITY2,
                INSPECTEDQUANTITY1,
                INSPECTEDQUANTITY2,
                ACCEPTEDQUANTITY1,
                ACCEPTEDQUANTITY2,
                REJECTEDQUANTITY1,
                REJECTEDQUANTITY2,
                JOININSPECTEDQUANTITY1,
                JOININSPECTEDQUANTITY2,
                JOINACCEPTEDQUANTITY1,
                JOINACCEPTEDQUANTITY2,
                JOINREJECTEDQUANTITY1,
                JOINREJECTEDQUANTITY2,
                RATE,
                RATEMEASURINGUNITCODE,
                DISCREPANCYAMOUNT,
                DISCREPANCYTYPECODE,
                DISCREPANCYQUANTITY1,
                DISCREPANCYQUANTITY2,
                AMOUNT,
                REMARK,
                PACKINGTYPECODE,
                DESCRIPTION,
                STORAGELOCATIONCODE,
                PURCHASEORDERTNO,
                JOBORDERTNO,
                MRNQUANTITY1,
                MRNQUANTITY2,
                PACKINGNOS,
                POAMENDMENTTNO,
                SERIALNO,
                ISEXCISABLE,
                ISCAPITAL,
                MBILLNO,
                MBILLDATE,
                QCLESSQUANTITY1,
                RECEIVEDQUANTITY1WITHOUTQC,
                PACKINGWEIGHT,
                FREIGHTPOSTEDTOSTOCK,
                JOBPOSTEDTOSTOCK,
                WARRANTYUPTO,
                PURCHASEPOSTEDTOSTOCK,
                PURCHASEPOSTEDTOSTOCKRATE,
                FREIGHTPOSTEDTOSTOCKRATE,
                JOBPOSTEDTOSTOCKRATE
                
                
                
                            )
                            Values (
                                :TNO,
                :SNO,
                :ITEMCODE,
                :ITEMSPECIFICATIONCODE,
                :STOREAGELOCATIONCODE,
                :CHALANQUANTITY1,
                :RECEIVEDQUANTITY1,
                :CHALANQUANTITY2,
                :RECEIVEDQUANTITY2,
