page 189 (
    name: GRN
    alias: GRN1
    title: GRN
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'MKRL/REPORT/GRN.xdo';
              var outputFormat = 'pdf';
              
            
            var reportParams = 
                  '&P189_TNO='+ $('#P189_TNO').val() 
                  ;
             
              
              var reportURL = 'http://192.168.0.151:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            ```
    }
    css {
        inline: "td[headers=\"VIMAGE\"] img {width: 100px ; border: 1px  solid #999 ; padding: 4px; background : #f6f6f6}"
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region attachment-nbsp-nbsp-nbsp-nbsp-nbsp-nbsp-nbsp-nbsp (
        name: Attachment&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       MODULETNO,
                       MODULESNO,
                       MODULESN,
                       MODULECODE,
                     --  MODULETABLENAME,
                      -- MODULESERIALNO,
                       ATTRIBUTECODE,
                       ATTRIBUTEVALUE,
                      -- DESCRIPTION,
                       dbms_lob.getlength(ATTACHMENTBLOB) as Attachmentblob,
                       FILENAME,
                       MIMETYPE,
                       --REMARK,
                       dbms_lob.getlength(ATTACHMENTBLOB) as Download
                  from MODULEATTACHMENT
                where ModuleTno = :P189_TNO
                ```
            pageItemsToSubmit: P189_TNO
