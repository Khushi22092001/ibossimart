    process set-doc-no (
        name: Set Doc No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P189_TNO is null then
                        Select GlobalTno.NextVal into :P189_TNO From Dual;
                     end if;
                    ----
                    if :P189_GRNNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P189_LOCATIONCODE,
                					:P189_DOCTYPECODE,
                					NULL,
                					TO_DATE(:P189_GRNDATE, 'DD-MM-RRRR')
                				);
                        :P189_GRNNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P189_LOCATIONCODE,
                                    :P189_DOCTYPECODE,
                                    NULL,
                                    TO_DATE(:P189_GRNDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 24705511959034279
        }
    )

