                #DEFAULT#
                t-Button--small
                t-Button--success
                t-Button--iconLeft
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P189_GRNNO
        }
    )

