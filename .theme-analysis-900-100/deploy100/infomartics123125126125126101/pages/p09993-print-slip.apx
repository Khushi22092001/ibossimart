page 9993 (
    name: Print  Slip
    alias: PRINT-SLIP
    title: Print  Slip
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P9993_BIREPORTURL').val()
              var reportName = 'IRONMART/REPORT/'+$('#P9993_REPNAME').val()+'.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '&P_TNO=' + $('#P9993_TNO').val() ;
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P9993_BIREPORTURL').val()
              var reportName =  $('#P9993_REPNAME').val()+'.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '"_paramsP_TNO":"' + $('#P9993_TNO').val() 
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    pageItem P9993_BIREPORTURL (
        type: textField
        label {
            label: BI Report
            alignment: left
        }
        layout {
            sequence: 30
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: Select getmyparametervalue('BIREPORTURL') From dual
        }
    )

    pageItem P9993_REPNAME (
        type: textField
        label {
            label: Rep Name
            alignment: left
        }
        layout {
            sequence: 20
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        default {
            type: static
            staticValue: PurchaseOrder
        }
    )

    pageItem P9993_TNO (
        type: textField
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 10
            slot: contentBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        default {
            type: static
            staticValue: 848014101
        }
        sessionState {
            storage: request
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 30
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript:window.open('http://192.168.0.199:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/LOGICBOX/REPORT/&P9993_REPNAME..xdo&nQUser=weblogic&nQPassword=webboss123&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_TNO":"&P9993_TNO."}');
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: generatePDF_new()
            }
            execution {
                sequence: 20
            }
        )

    )

)

