    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P664_TNO is null then
                            :P664_FORMSTATUS := 'NEWRECORD';
                        else
                            :P664_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P664_TNO is null then
                
                        select globaltno.nextval into :P664_TNO from dual;
                
                    end if; 
                    select NVL(getdocumentstatuscode('PARTYATTRIBUTE',:P664_TNO),'STATUS') INTO :P664_STATUS FROM DUAL ;
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 27550822400022106
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P664_MODULEFLOW := 'YES';
                   else
                       :P664_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P664_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P664_ONTHETABLE := 'YES' ;
                   else
                       :P664_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 27551222765022106
        }
    )

    process get-party-attribute-code (
        name: Get Party Attribute Code
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getmodulecodeforpageno(:APP_PAGE_ID);
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P664_PARTYATTRIBUTECODE is null then
                            setCodeNext(tModuleCode);
                	  		:P664_PARTYATTRIBUTECODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 27551627687022107
        }
    )

