    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 130
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P664_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P664_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P664_TNO,:P664_STATUS);
                    
                    ```
                itemsToSubmit: [
                    P664_TNO
                    P664_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P664_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @buttons
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P664_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

