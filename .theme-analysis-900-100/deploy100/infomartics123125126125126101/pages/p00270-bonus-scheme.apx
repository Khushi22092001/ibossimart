page 270 (
    name: Bonus Scheme
    alias: BONUS-SCHEME
    title: Bonus Scheme
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bonus-scheme (
        name: Bonus Scheme
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       BONUSSCHEMECODE,
                       BONUSSCHEMENAME,
                       APPLIEDONWARD,
                       CATEGORYCODE,
                       STAFFTYPECODE,
                       ATTENDENCEVALUEMINIMUM,
                       SERVICEDAYSMINIMUM,
                       BONUSAMOUNTMAXIMUM,
                       REMARK,
                       BONUSPERCENT,
                       CREATIONTIME,
                       CREATOR
                  from BONUSSCHEME
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region bonus-scheme-attendence-head (
        name: Bonus Scheme Attendence Head
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       ATTENDENCEHEADCODE,
                       REMARK
                  from BONUSSCHEMEATTENDENCEHEAD
                  where tno = :P270_TNO
                ```
            pageItemsToSubmit: P270_TNO
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 108859359021680963
        }

        savedReport 904162 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 4
                }
            )

            displayColumn (
                column: @ATTENDENCEHEADCODE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATTENDENCEHEADCODE (
            type: popupLov
            heading {
                heading: Attendence Head
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                    a.AttendenceHeadName,
                    a.AttendenceHeadCode
                    from AttendenceHead a
                    order by 1
                    ```
                nullDisplayValue: -Select-
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ATTENDENCEHEADCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column REMARK (
            type: textField
            heading {
                heading: Remark
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SNO (
            type: numberField
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TNO (
            type: numberField
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P270_TNO
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Bonus Scheme Attendence Head
        }
    )

