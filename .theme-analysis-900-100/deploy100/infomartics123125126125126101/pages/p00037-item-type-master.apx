page 37 (
    name: Item Group Master
    alias: ITEM-TYPE-MASTER
    title: Item Group Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1100
        height: 500
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    region item-type-master (
        name: Item Type Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       ITEMTYPECODE,
                       ITEMTYPENAME,
                       ITEMTYPESHORTNAME,
                       REMARK,
                       CREATOR,
                       parentcode
                  from ITEMTYPE
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: master
        }
        headerAndFooter {
            headerText: <div style="height:320px">
            footerText: </div>
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region tree (
        name: Tree
        type: tree
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case when connect_by_isleaf = 1 then 0
                            when level = 1             then 1
                            else                           -1
                       end as status, 
                       level, 
                       itemtypename as title, 
                       null as icon, 
                       tno as value, 
                       null as tooltip,
                        'javascript:$s(''P37_SELECTEDNODE'', '''||TNO||''')' as link 
                 from ITEMTYPE 
                start with parentcode is null
                connect by prior itemtypecode = parentcode
                order siblings by itemtypename
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        headerAndFooter {
            headerText: <div style="height:350px">
            footerText: </div>
        }
        settings {
            nodeLabelColumn: TITLE
            nodeValueColumn: VALUE
            hierarchy: notComputed
            nodeStatusColumn: STATUS
            hierarchyLevelColumn: LEVEL
            tooltip: databaseCol
            tooltipColumn: TOOLTIP
            activateNodeLinkWith: doubleClick
            linkColumn: LINK
            defaultIconCssClass: icon-tree-folder
        }
    )

    pageItem P37_CALLEDFROMPAGE (
        type: hidden
