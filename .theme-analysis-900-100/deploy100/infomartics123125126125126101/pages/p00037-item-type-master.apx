    dynamicAction refr (
        name: REFR
        execution {
            sequence: 140
        }
        when {
            selectionType: items
            items: P37_SELECTEDNODE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.region("master").refresh();
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction set-and-refresh (
        name: SET AND REFRESH
        execution {
            sequence: 130
        }
        when {
            selectionType: items
            items: P37_SELECTEDNODE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select TNO,
                           ITEMTYPECODE,
                           ITEMTYPENAME,
                           ITEMTYPESHORTNAME,
                           REMARK,
                           CREATOR,
                           parentcode
                      from ITEMTYPE
                      WHERE TNO = :P37_SELECTEDNODE
                      ;
                    ```
                itemsToSubmit: P37_SELECTEDNODE
            }
            affectedElements {
                selectionType: items
                items: [
                    P37_TNO
                    P37_ITEMTYPECODE
                    P37_ITEMTYPENAME
                    P37_ITEMTYPESHORTNAME
                    P37_REMARK
                    P37_CREATOR
                    P37_PARENTCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 139150455543356039
        }
    )

    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P37_TNO is null then
                            :P37_FORMSTATUS := 'NEWRECORD';
                        else
                            :P37_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P37_TNO is null then
                
                        select globaltno.nextval into :P37_TNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 139182819453554579
        }
    )

    process get-item-type-code (
        name: Get Item Type Code
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'ITEMTYPE';
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P37_ITEMTYPECODE is null then
                            setCodeNext(tModuleCode);
                	  		:P37_ITEMTYPECODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 139198536470620957
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P37_MODULEFLOW := 'YES';
                   else
                       :P37_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P37_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P37_ONTHETABLE := 'YES' ;
                   else
                       :P37_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 139183109558556010
        }
    )

    process initialize-form-item-type-master (
        name: Initialize form Item Type Master
        type: formInitialization
