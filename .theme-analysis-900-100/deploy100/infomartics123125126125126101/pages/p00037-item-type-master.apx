    dynamicAction check-item-type-list-name (
        name: Check Item Type List Name
        execution {
            sequence: 100
        }
        when {
            event: focusout
            selectionType: items
            items: P37_ITEMTYPENAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P37_ITEMTYPENAME")).length===0 ) {
                        showError("Item Type Name Should Not be Empty", 'P37_ITEMTYPENAME');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

