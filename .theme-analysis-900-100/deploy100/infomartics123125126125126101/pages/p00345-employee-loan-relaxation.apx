page 345 (
    name: Employee Loan Relaxation
    alias: EMPLOYEE-LOAN-RELAXATION
    title: Employee Loan Relaxation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employee-loan-relaxation (
        name: Employee Loan Relaxation
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.TNO,
                	a.LoanRelaxationNO,
                	a.LoanRelaxationDATE,
                	e.EmployeeName,
                	to_char(a.SalaryFromDate, 'MON, RRRR') forMonth,
                	SUBSTR(getEmployeeEmployeeID(a.EmployeeCode, a.LoanRelaxationDate), 1, 100) as EmployeeId,
                	a.Remark
                from LoanRelaxation a, Employee e
                where a.EmployeeCode = e.EmployeeCode(+)
                
                
                  
                  
                      -- filter
                  and ( :P345_FROMDATE is null OR (a.LoanRelaxationdate between :P345_FROMDATE and :P345_TODATE))
                  and (:P345_COMPANY is null  OR (instr(':'||:P345_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  and (:P345_LOCATION is null OR (instr(':'||:P345_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and (:P345_DOCTYPE is null  OR (instr(':'||:P345_DOCTYPE||':',':'||a.DocTypeCode||':') > 0))
                  and (:P345_EMPLOYEE is null  OR (instr(':'||:P345_EMPLOYEE||':',':'||a.EMPLOYEECODE||':') > 0))
                 
                Order by a.LoanRelaxationDATE desc, a.LoanRelaxationNO desc
                ```
            pageItemsToSubmit: [
                P345_COMPANY
                P345_LOCATION
                P345_FROMDATE
                P345_TODATE
                P345_DOCTYPE
                P345_EMPLOYEE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 346
                items: {
                    P346_TNO: \#TNO#\
                }
                clearCache: 346
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 295260410435271293
        }

        column EMPLOYEEID (
            type: plainText
            heading {
                heading: Employeeid
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AV
            }
        )

        column EMPLOYEENAME (
            type: plainText
            heading {
                heading: Employee Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AB
            }
        )

        column FORMONTH (
            type: plainText
            heading {
                heading: Formonth
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AU
            }
        )

        column LOANRELAXATIONDATE (
            type: plainText
            heading {
                heading: Loanrelaxationdate
            }
            layout {
                sequence: 50
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AT
            }
        )

        column LOANRELAXATIONNO (
            type: plainText
            heading {
                heading: Loanrelaxationno
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AS
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AW
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cheque Receipt List
        }

        savedReport 321406 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMPLOYEEID (
                sequence: 2
            )

            displayColumn EMPLOYEENAME (
                sequence: 1
            )

            displayColumn FORMONTH (
                sequence: 3
            )

            displayColumn LOANRELAXATIONDATE (
                sequence: 4
            )

            displayColumn LOANRELAXATIONNO (
                sequence: 5
            )

            displayColumn REMARK (
                sequence: 6
            )

        )

    )

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent15
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P345_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @filter
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P345_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'PFCHALLAN'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P345_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.DocTypeName d,
                a.DocTypeCode r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c
                where a.DocTypeCode = b.DocTypeCode
                and b.tno = c.tno
                and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                and (
                     not exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and aa.CompanyCode = :global_CompanyCode
                     )
                     or
                     exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and bb.DocTypeCode = a.DocTypeCode
                             and aa.CompanyCode = :global_CompanyCode
                     )
                )
                order by a.DocTypeName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P345_COMPANY
            itemsToSubmit: P345_DOCTYPE
        }
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Doc Type Name
        }
    )

    pageItem P345_EMPLOYEE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Employee
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.EmployeeName d,
                a.EmployeeCode r
                from Employee a
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P345_COMPANY
            itemsToSubmit: P345_DOCTYPE
        }
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Employee Name
        }
    )

    pageItem P345_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)-7
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P345_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.LocationName d,
                	a.LocationCode r
                From Location a, ModuleLocationDetail b , ModuleLocation c
                Where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                	and c.CompanyCode = :GLOBAL_COMPANYCODE
                	and (
                		not exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                		or
                		exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and bb.LocationCode = a.LocationCode
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                	)
                Order by a.LocationName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Location Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P345_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @/title
            slot: regionBody
        }
    )

    pageItem P345_TNO_1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @filter
            slot: regionBody
        }
    )

    pageItem P345_TODATE (
        type: datePicker
