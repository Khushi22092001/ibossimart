    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: noRowsReturned
            sqlQuery: select 1 from indentdetail a where a.tno = :P9_TNO AND A.SNO = :P9_SNO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from indentdetail a where a.tno = :P9_TNO AND A.SNO = :P9_SNO
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from indentdetail a where a.tno = :P9_TNO AND A.SNO = :P9_SNO
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-amount (
        name: Set Amount
        execution {
            sequence: 40
        }
        when {
            event: focusout
            selectionType: items
            items: [
                P9_RATE
                P9_INDENTQUANTITY1
            ]
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select nvl(:P9_INDENTQUANTITY1,0) * nvl(:P9_RATE,0) from dual
                itemsToSubmit: [
                    P9_INDENTQUANTITY1
                    P9_RATE
                ]
            }
            affectedElements {
                selectionType: items
                items: P9_AMOUNT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-base-unit (
        name: Set Base Unit
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P9_ITEMCODE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select MEASURINGUNITCODE1 from item
                    where itemcode = :P9_ITEMCODE
                    ```
                itemsToSubmit: P9_ITEMCODE
            }
            affectedElements {
                selectionType: items
                items: P9_BASEUNIT
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-hsn (
        name: Set HSN
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P9_ITEMSPECIFICATIONCODE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select HSNCODE from itemspecification
                    where ITEMSPECIFICATIONCODE = :P9_ITEMSPECIFICATIONCODE
                    ```
                itemsToSubmit: P9_ITEMSPECIFICATIONCODE
            }
            affectedElements {
                selectionType: items
                items: P9_HSN
            }
            execution {
                sequence: 10
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 163074709938244522
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-indent-itemm-detail (
        name: Initialize form Indent Itemm Detail
        type: formInitialization
        formRegion: @indent-itemm-detail
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 163073997857244513
        }
    )

    process initialize-sno (
        name: initialize SNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P9_SNO IS NULL THEN
                   SELECT GLOBALTNO.NEXTVAL INTO :P9_SNO FROM DUAL;
                END IF;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 136118562512173423
        }
    )

    process process-form-indent-itemm-detail (
        name: Process form Indent Itemm Detail
        type: formAutoRowProcessing
        formRegion: @indent-itemm-detail
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 163074332552244518
        }
    )

)

