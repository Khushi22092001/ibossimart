    pageItem P9_ITEMCODE (
        type: popupLov
        label {
            label: Item
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select itemname , itemcode from item 
                where getdocumentstatuscode('ITEM',TNO) = 'ACTIVE'
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @indent-itemm-detail
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @indent-itemm-detail
            column: ITEMCODE
            dataType: varchar2
        }
    )

    pageItem P9_ITEMSPECIFICATIONCODE (
        type: popupLov
        label {
            label: Item Specification
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ITEMSPECIFICATIONNAME , ITEMSPECIFICATIONCODE
                from itemspecification
                where tno in (select tno from item where itemcode = :P9_ITEMCODE )
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P9_ITEMCODE
            itemsToSubmit: P9_ITEMCODE
            parentRequired: false
        }
        layout {
            sequence: 40
            region: @indent-itemm-detail
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @indent-itemm-detail
            column: ITEMSPECIFICATIONCODE
            dataType: varchar2
        }
    )

