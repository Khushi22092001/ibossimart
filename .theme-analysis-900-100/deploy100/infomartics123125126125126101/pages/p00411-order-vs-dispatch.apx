            )

            aggregate (
                column: TOTAL_INVOICES
            )

            aggregate (
                column: TOTAL_INVOICE_QUANTITY
            )

            aggregate (
                column: BALANCE_QTY
            )

            aggregate (
                column: TOTAL_RECEIPTS
            )

            aggregate (
                column: TOTAL_PAYMENT_RECEIVED
            )

            aggregate (
                column: FINAL_BALANCE_AMOUNT
            )

            aggregate (
                column: TOTAL_INVOICE_AMOUNT
            )

            aggregate (
                column: FINAL_BALANCE_AMOUNT_AGAINST_INV
            )

            aggregate (
                column: FINAL_BALANCE_AMOUNT_AGAINST_SO
            )

        )

    )

    pageItem P411_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @order-vs-dispatch
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P411_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'CCINVOICE'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                Order by 1
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @order-vs-dispatch
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Select Company Name
        }
    )

    pageItem P411_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @order-vs-dispatch
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 45
            valuePlaceholder: From Date
        }
        default {
            type: expression
            plsqlExpression: Trunc(sysdate-7)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P411_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'CCINVOICE'
                  and a.ViewPrivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order by 1
                ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @order-vs-dispatch
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Select Location name
        }
    )

    pageItem P411_PARTY (
        type: plugin/pretiusApexEnhancedLovItem
