page 237 (
    name: User Privilege DocType
    alias: USER-PRIVILEGE-DOCTYPE
    title: User Privilege DocType
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            t-Dialog--noPadding
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        height: 400
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region user-privilege-doctype (
        name: User Privilege DocType
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.DocTypeCODE,
                       a.SNO
                  from ModuleprivilegeDocType a
                 where a.TNO = :P237_TNO
                ```
            pageItemsToSubmit: P237_TNO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 126822569224834832
        }

        savedReport 398645 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DOCTYPECODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DOCTYPECODE (
            type: popupLov
            heading {
                heading: Doc Type
            }
            lov {
                type: sqlQuery
                sqlQuery: Select DocTypeName d, DocTypeCode r from DocType order by 1
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: DOCTYPECODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column SNO (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SNO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TNO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: User Privilege DocType
        }
    )

    pageItem P237_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @user-privilege-doctype
            slot: regionBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 20
            region: @user-privilege-doctype
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @user-privilege-doctype
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-privilege-doctype
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process closedialog (
        name: CloseDialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 68950263072262852
        }
        serverSideCondition {
            whenButtonPressed: @back
        }
    )

    process user-privilege-doctype-save-interactive-grid-data (
        name: User Privilege DocType - Save Interactive Grid Data
        type: executeCode
        editableRegion: @user-privilege-doctype
        source {
            plsqlCode:
                ```plsql
                if :APEX$ROW_STATUS IN ( 'I','C') then
                   :TNO := :P237_TNO ;
                   SELECT GLOBALTNO.NEXTVAL INTO :SNO FROM DUAL;
                  INSERT INTO MODULEPRIVILEGEDOCTYPE ( TNO,SNO,DOCTYPECODE)
                  VALUES ( :TNO,:SNO,:DOCTYPECODE) ;
                ELSIF  :APEX$ROW_STATUS IN ( 'U') then
                     UPDATE MODULEPRIVILEGEDOCTYPE
                     SET DOCTYPECODE = :DOCTYPECODE
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                ELSIF :APEX$ROW_STATUS = 'D' then
                     DELETE FROM  MODULEPRIVILEGEDOCTYPE
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                END IF;   
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 68949787899262851
        }
    )

)

