    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @gst-setup-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 308
                clearCache: 308
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
