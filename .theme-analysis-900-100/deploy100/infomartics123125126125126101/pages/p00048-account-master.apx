        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Account Master Report
        }

        savedReport 21195 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AADHARNO (
                sequence: 19
            )

            displayColumn BANKACCOUNTNO (
                sequence: 28
            )

            displayColumn BANKNAME (
                sequence: 27
            )

            displayColumn CONTACTPERSON (
                sequence: 11
            )

            displayColumn CREDITDAYS (
                sequence: 12
            )

            displayColumn ELIGIBLEFORTDSUNDER194Q (
                sequence: 16
            )

            displayColumn GSTINNO (
                sequence: 17
            )

            displayColumn IFSCCODE (
                sequence: 29
            )

            displayColumn NATUREOFACCOUNTNAME (
                sequence: 6
            )

            displayColumn OFFICEADDRESS1 (
                sequence: 20
            )

            displayColumn OFFICEADDRESS2 (
                sequence: 21
            )

            displayColumn OFFICEEMAIL (
                sequence: 26
            )

            displayColumn OFFICEMOBILENO (
                sequence: 25
            )

            displayColumn OFFICEPHONENO (
                sequence: 24
            )

            displayColumn OFFICEPINCODE (
                sequence: 23
            )

            displayColumn OFFICESTATECODE (
                sequence: 22
            )

            displayColumn OWNERNAME (
                sequence: 10
            )

            displayColumn PANNO (
                sequence: 18
            )

            displayColumn PARENTNAME (
                sequence: 5
            )

            displayColumn PARTYCODE (
                sequence: 3
            )

            displayColumn PARTYNAME (
                sequence: 1
            )

            displayColumn PARTYSHORTNAME (
                sequence: 2
            )

            displayColumn PARTYTYPECODE (
                sequence: 4
            )

            displayColumn TAXREGISTRATIONTYPENAME (
                sequence: 9
            )

            displayColumn TDSAPPLICABLE (
                sequence: 13
            )

            displayColumn TDSNATURENAME (
                sequence: 14
            )

            displayColumn TDSPAYEECATEGORYNAME (
                sequence: 15
            )

            displayColumn TRADETYPENAME (
                sequence: 8
            )

            displayColumn ZONENAME (
                sequence: 7
            )

            sort (
                column: CREATIONTIME
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @account-master-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 49
                clearCache: 49
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @account-master-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

