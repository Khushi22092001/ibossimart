    dynamicAction change-brand (
        name: CHANGE BRAND
        execution {
            sequence: 190
        }
        when {
            selectionType: items
            items: P501_BRAND
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P501_BRANDNAME
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @brand-cutsomer-revenue
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-specification-revenue
            }
            execution {
