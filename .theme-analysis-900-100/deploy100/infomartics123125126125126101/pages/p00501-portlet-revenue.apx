                selectionType: region
                region: @item-spec-customer-revenue
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT ITEMNAME FROM ITEM WHERE ITEMCODE = :P501_BRAND ;
                itemsToSubmit: P501_BRAND
            }
            affectedElements {
                selectionType: items
                items: P501_BRANDNAME
            }
            execution {
                sequence: 20
            }
        )

    )

