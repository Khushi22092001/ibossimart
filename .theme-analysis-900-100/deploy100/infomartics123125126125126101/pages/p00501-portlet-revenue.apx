        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #R161123375362759032_jet{
                margin-top: 2rem;
            }
            #R161123533390759034_jet{
                margin-top: 2rem;
            }
            #R158247033530484815_jet{
                margin-top: 2rem;
            }
            #R160542601609573604_jet{
                margin-top: 2rem;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region brand-cutsomer-revenue (
        name: Brand Cutsomer Revenue
        type: chart
        layout {
            sequence: 150
            parentRegion: @revenue
            slot: subRegions
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent10
                t-Region--hiddenOverflow
            ]
        }
        chartLayout {
            height: 400
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series item-revenue-bar-chart (
            name: Item Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select TO_CHAR(to_date(:P501_MONTH,'YYYYMM'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(:P501_MONTH,'YYYYMM')),'DD-MON-RRRR') as ToDate,
                    A.LOCATIONCODE AS LOCATIONCODE,A.PARTYCODE, GETPARTYNAME(A.PARTYCODE) AS PARTYNAME, Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           bi_datetime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   --'-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P501_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P501_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P501_FINYEAR,'%')
                    
                       And (:P501_ITEMGROUP Is Null
                        Or X.ROOT_ID = :P501_ITEMGROUP)
                       And (:P501_ITEM Is Null
                        Or NVL(X.PARENTCODE,X.ITEMCODE) = :P501_ITEM)
                       And (:P501_BRAND IS NULL OR A.ITEMCODE = :P501_BRAND)
                    --   And (&P501_ITEMGROUP Is Null Or
                    --instr(':' || &P501_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By a.PARTYcode,A.LOCATIONCODE
                    order by 6 desc
                    ```
                pageItemsToSubmit: P501_BRAND
            }
            columnMapping {
                label: PARTYNAME
                value: AMOUNT
            }
            link {
                type: redirectThisApp
                target: {
                    page: 174
                    items: {
                        P174_COMPANY: &GLOBAL_COMPANYCODE.
                        P174_STATUS: ACTIVE
                        P174_LOCATION: &LOCATIONCODE.
                        P174_FROMDATE: &FROMDATE.
                        P174_TODATE: &TODATE.
                        P174_ITEM: &P501_BRAND.
                        P174_PARTY: &PARTYCODE.
                    }
                    clearCache: 174
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region brand-revenue (
        name: Brand Revenue
        type: chart
        layout {
            sequence: 140
            parentRegion: @revenue
            slot: subRegions
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent9
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
            fontSize: 8
        }

        series brand-revenue-bar-chart (
            name: Brand Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select A.ITEMCODE As ITEMCODE,
                           getitemNAME(A.ITEMCODE) As ItemName,
                           Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           bi_datetime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   --'-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P501_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P501_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P501_FINYEAR,'%')
                    
                       And (:P501_ITEMGROUP Is Null
                        Or X.ROOT_ID = :P501_ITEMGROUP)
                       And (:P501_ITEM Is Null
                        Or NVL(X.PARENTCODE,X.ITEMCODE) = :P501_ITEM)
                    --   And (&P501_ITEMGROUP Is Null Or
                    --instr(':' || &P501_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By a.itemcode
                    
                    ```
                pageItemsToSubmit: P501_BRAND
            }
            columnMapping {
                label: ITEMNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P501_BRAND',&ITEMCODE.);
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

