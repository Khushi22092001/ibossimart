    region revenue-by-months (
        name: Revenue by Months
        type: chart
        source {
            pageItemsToSubmit: [
                P501_MONTH
                P501_FIN_HALFYEAR
                P501_FINYEAR
                P501_ITEM
            ]
        }
        layout {
            sequence: 50
            parentRegion: @revenue
            slot: subRegions
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent1
                t-Region--hiddenOverflow
            ]
        }
        chartAppearance {
            stack: true
            stackLabel: true
        }
        chartLayout {
            height: 400
        }
        settings {
            timeAxisType: auto
        }
        legend {
            hideAndShowBehavior: noRescaling
        }

        series by-product (
            name: By Product
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select TO_CHAR(to_date(xx.month,'MON-YYYY'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(xx.month,'MON-YYYY')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE,xx.*
                      From (Select b.Fin_Qtr,
                                   b.Fin_Month,
                                   x.root_id,
                                   getitemname(x.root_id) As item,
                                   To_Char(a.CCInvoiceDate, 'MON-YYYY') As Month,
                                   To_Char(a.CCInvoiceDate, 'YYYYMM') As Monthyy,
                                   Sum(a.TotalAmount) Amount
                              From BI_SRevenue a,
                                   BI_DateTime b,
                                   (Select ITEMCODE,
                                           parentcode,
                                           RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                           Level,
                                           CONNECT_BY_ROOT itemcode As root_id,
                                           --'-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                           CONNECT_BY_ISLEAF As leaf
                                      From item a
                                     Start With parentcode Is Null
                                    Connect By parentcode = Prior itemcode
                                     Order Siblings By itemcode) x
                             Where A.ITEMCODE = X.ITEMCODE
                               And a.CCInvoiceDate = b.Fin_date
                            --and b.Fin_Qtr like nvl(:P501_FIN_QTR,'%')
                            --and b.Fin_year like nvl(:P501_FINYEAR,'%')
                               and (b.Fin_Qtr = :P501_FIN_QTR or :P501_FIN_QTR is null)
                              and (replace(b.Fin_year,'-','') = :P501_FINYEAR or :P501_FINYEAR is null)
                            
                             Group By b.Fin_Qtr,
                                      b.Fin_Month,
                                      To_Char(a.CCInvoiceDate, 'MON-YYYY'),
                                      To_Char(a.CCInvoiceDate, 'YYYYMM'),
                                      getitemname(x.root_id),
                                      x.root_id
                             Order By To_Char(a.CCInvoiceDate, 'YYYYMM')) xx
                    where root_id='217'
                     Order By root_id
                    
                    ```
                pageItemsToSubmit: [
                    P501_MONTH
                    P501_FIN_HALFYEAR
                    P501_FINYEAR
                    P501_ITEM
                ]
            }
            columnMapping {
                seriesName: ITEM
                label: MONTHYY
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P116_MONTH',&MONTHYY.);
            }
            label {
                show: true
            }
        )

        series finished-goods (
            name: Finished Goods
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select --APEX_UTIL.PREPARE_URL
                    --('f?p=&APP_ID.:56:&APP_SESSION.::::P56_COMPANY,P56_FROMDATE,P56_TODATE:1,' || to_date(xx.month,'MON-YYYY')|| ',' ||LAST_DAY(to_date(xx.month,'MON-YYYY'))) AS LINK ,
                    TO_CHAR(to_date(xx.month,'MON-YYYY'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(xx.month,'MON-YYYY')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE,
                    xx.*
                      From (Select b.Fin_Qtr,
                                   b.Fin_Month,
                                   x.root_id,
                                   getitemname(x.root_id) As item,
                                   To_Char(a.CCInvoiceDate, 'MON-YYYY') As Month,
                                   To_Char(a.CCInvoiceDate, 'YYYYMM') As Monthyy,
                                   Sum(a.TotalAmount) Amount
                              From BI_SRevenue a,
                                   BI_DateTime b,
                                   (Select ITEMCODE,
                                           parentcode,
                                           RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                           Level,
                                           CONNECT_BY_ROOT itemcode As root_id,
                                           --'-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                           CONNECT_BY_ISLEAF As leaf
                                      From item a
                                     Start With parentcode Is Null
                                    Connect By parentcode = Prior itemcode
                                     Order Siblings By itemcode) x
                             Where A.ITEMCODE = X.ITEMCODE
                               And a.CCInvoiceDate = b.Fin_date
                            --and b.Fin_Qtr like nvl(:P501_FIN_QTR,'%')
                            --and b.Fin_year like nvl(:P501_FINYEAR,'%')
                               and (b.Fin_Qtr = :P501_FIN_QTR or :P501_FIN_QTR is null)
                              and (replace(b.Fin_year,'-','') = :P501_FINYEAR or :P501_FINYEAR is null)
                            
                             Group By b.Fin_Qtr,
                                      b.Fin_Month,
                                      To_Char(a.CCInvoiceDate, 'MON-YYYY'),
                                      To_Char(a.CCInvoiceDate, 'YYYYMM'),
                                      getitemname(x.root_id),
                                      x.root_id
                    
                             Order By To_Char(a.CCInvoiceDate, 'YYYYMM')) xx
                    --where root_id='223'
                    -- Order By XX.MONTHYY --root_id
                    
                    ```
                pageItemsToSubmit: [
                    P501_FIN_HALFYEAR
                    P501_MONTH
                    P501_FIN_HALFYEAR
                    P501_FINYEAR
                    P501_ITEM
                ]
            }
            columnMapping {
                seriesName: ITEM
                label: MONTHYY
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P501_MONTH',&MONTHYY.);
            }
            label {
                show: true
                position: outsideBarEdge
                fontSize: 10
            }
        )

        series waste-scrap (
            name: Waste & Scrap
            execution {
                sequence: 30
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select TO_CHAR(to_date(xx.month,'MON-YYYY'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(xx.month,'MON-YYYY')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE, xx.*
                      From (Select b.Fin_Qtr,
                                   b.Fin_Month,
                                   x.root_id,
                                   getitemname(x.root_id) As item,
                                   To_Char(a.CCInvoiceDate, 'MON-YYYY') As Month,
                                   To_Char(a.CCInvoiceDate, 'YYYYMM') As Monthyy,
                                   Sum(a.TotalAmount) Amount
                              From BI_SRevenue a,
                                   BI_DateTime b,
                                   (Select ITEMCODE,
                                           parentcode,
                                           RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                           Level,
                                           CONNECT_BY_ROOT itemcode As root_id,
                                          -- '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                           CONNECT_BY_ISLEAF As leaf
                                      From item a
                                     Start With parentcode Is Null
                                    Connect By parentcode = Prior itemcode
                                     Order Siblings By itemcode) x
                             Where A.ITEMCODE = X.ITEMCODE
                               And a.CCInvoiceDate = b.Fin_date
                            --and b.Fin_Qtr like nvl(:P501_FIN_QTR,'%')
                            --and b.Fin_year like nvl(:P501_FINYEAR,'%')
                               and (b.Fin_Qtr = :P501_FIN_QTR or :P501_FIN_QTR is null)
                              and (replace(b.Fin_year,'-','') = :P501_FINYEAR or :P501_FINYEAR is null)
                            
                             Group By b.Fin_Qtr,
                                      b.Fin_Month,
                                      To_Char(a.CCInvoiceDate, 'MON-YYYY'),
                                      To_Char(a.CCInvoiceDate, 'YYYYMM'),
                                      getitemname(x.root_id),
