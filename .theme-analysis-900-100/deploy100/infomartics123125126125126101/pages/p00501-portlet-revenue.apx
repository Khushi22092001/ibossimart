            stack: true
        }
        chartLayout {
            height: 400
        }
        multiSeriesChartData {
            sortOrder: valueDesc
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series item-revenue-bar-chart (
            name: Item Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select  TO_CHAR(to_date(:P501_MONTH,'YYYYMM'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(:P501_MONTH,'YYYYMM')),'DD-MON-RRRR') as ToDate,
                    A.LOCATIONCODE AS LOCATIONCODE,B.PARTYCODE, B.PARTYNAME, Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           PARTY B,
                           BI_DateTime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   --'-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode IS NULL
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       And A.PARTYCODE = B.PARTYCODE
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P501_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P501_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P501_FINYEAR,'%')
                    
                       And  (:P501_SUBGROUP IS NULL OR ( X.root_id = :P501_ITEMGROUP) OR (X.PARENTCODE = :P501_SUBGROUP )  )
                            
                       
                    --   And (&P501_ITEMGROUP Is Null Or
                    --instr(':' || &P501_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By B.PARTYCODE, B.PARTYNAME, A.LOCATIONCODE
                     order by 6 desc
                    
                    
                    ```
                pageItemsToSubmit: [
                    P501_ITEM
                    P501_MONTH
                    P501_QUARTER
                    P501_SUBGROUP
                    P501_ITEMGROUP
                ]
            }
            columnMapping {
                label: PARTYNAME
                value: AMOUNT
            }
            link {
                type: redirectThisApp
                target: {
                    page: 174
                    items: {
                        P174_COMPANYCODE: &GLOBAL_COMPANYCODE.
                        P174_LOCATION: &LOCATIONCODE.
                        P174_STATUS: ACTIVE
                        P174_PARTY: &PARTYCODE.
                        P174_FROMDATE: &FROMDATE.
                        P174_TODATE: &TODATE.
                    }
                    clearCache: 174
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region sub-group-revenue (
        name: Sub Group  Revenue
        type: chart
        layout {
            sequence: 100
            parentRegion: @revenue
            slot: subRegions
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent9
                t-Region--hiddenOverflow
            ]
        }
        serverSideCondition {
            type: itemIsZero
            item: P501_FINYEAR
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
            fontSize: 8
        }

        series item-group-revenue-bar-chart (
            name: Item Group Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select x.root_id,
                           getitemname(x.root_id) As RootName,
                           Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           bi_datetime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   --'-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode IS NULL --= NVL(:P501_SUBGROUP,:P501_ITEMGROUP)
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P501_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P501_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P501_FINYEAR,'%')
                       And  (:P501_SUBGROUP IS NULL OR ( X.root_id = :P501_ITEMGROUP) OR (X.PARENTCODE = :P501_SUBGROUP )  )
                            
                    --   And :P501_ITEMGROUP Is Null
                    --    Or X.ROOT_ID = &P501_ITEMGROUP
                    --   And (&P501_ITEMGROUP Is Null Or
                    --instr(':' || &P501_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By x.root_id
                    ```
                pageItemsToSubmit: [
                    P501_SUBGROUP
                    P501_ITEMGROUP
                    P501_MONTH
                ]
            }
            columnMapping {
                seriesName: ROOTNAME
                label: ROOTNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P501_SUBGROUP',&ROOT_ID.);
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

