    region mrn-list (
        name: MRN List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       GetCompanyName(A.COMPANYCODE) as companyname,
                       A.FINANCIALYEARCODE,
                       GetLocationName(A.LOCATIONCODE) as locationname,
                       GetDoctypeName(A.DOCTYPECODE) as doctypename ,
                       A.MRNNO,
                       A.MRNDATE,
                       A.REMARK,
                       getpartyname(A.PARTYCODE) as partyname,
                       A.CREATOR,
                       A.GRNTNO,
                       B.GRNNO,
                       A.CREATIONTIME,
                       GetItemName(c.ITEMCODE) as itemname, 
                       GetItemSpecificationName(c.ITEMCODE , c.ITEMSPECIFICATIONCODE) as itemspecifiationname, 
                       c.DESCRIPTION, 
                       c.QUANTITY1, 
                       c.QUANTITY2, 
                       c.GATEPASSQUANTITY1, 
                       c.GATEPASSQUANTITY2,
                       GetMeasuringUnitNameFromItem(c.itemcode) as unit1,
                       GetMeasuringUnit2NameFromItem(c.itemcode) as unit2,
                                 '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||9993||':'||:APP_SESSION||'::::'||'P9993_TNO,P9993_REPNAME'||':'||A.Tno||','||'MRN'||':NO')||'"><span aria-label="Action"><span class="fa fa-print"  aria-hidden="true" title="Action"></span</span></a>' AS Print
                
                  from MRN A , GRN B , mrndetail c
                  WHERE A.GRNTNO = B.TNO(+)
                  and a.tno = c.tno 
                  and A.mrndate between :P222_FROMDATE and :P222_TODATE
                  and ( :P222_COMPANY IS NULL OR instr(':'||:P222_COMPANY||':',':'||A.COMPANYCODE||':') > 0 )
                  --and A.COMPANYCODE = :P222_COMPANY
                and ( :P222_LOCATION IS NULL OR instr(':'||:P222_LOCATION||':',':'||A.LOCATIONCODE||':') > 0 )
                --and ( :P222_COMPANY IS NULL OR instr(':'||:P222_COMPANY||':',':'||A.COMPANYCODE||':') > 0 )
                and ( :P222_PARTY IS NULL OR instr(':'||:P222_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                and ( :P222_ITEM IS NULL OR instr(':'||:P222_ITEM||':',':'||c.itemCODE||':') > 0 )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 223
                items: {
                    P223_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 17989656135043739
        }

