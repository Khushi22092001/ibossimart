                ```sql
                select TNO,
                       SNO,
                       SERIALNO,
                       SALARYHEADCODE,
                       SALARYHEADFORMULA,
                       SALARYHEADAMOUNT,
                       REVISEDFORMULA,
                       REVISEDVALUE,
                       ARREARFORMULA,
                       ARREARAMOUNT,
                       ARREARGIVEN
                  from SALARYDETAIL
                  where tno = :P641_TNO
                ```
            pageItemsToSubmit: P641_TNO
        }
