                       EMPLOYEESALARYTNO,
                       REMARK,
                       ARREARDATE,
                       ARREARMODULECODE,
                       ARREARMODULETNO,
                       EMPLOYEESALARYTNOFROMDATE,
                       CREATOR,
                       DATEOFENTERY,
                       EMPLOYEECOMPANYCODE,
                       MODULECODE,
                       MODULETNO,
                       MODULESNO,
                       CREATIONTIME,
                       DEPARTMENTCODE
                  from SALARY
                  
                ```
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
