page 100 (
    name: item specification master copy
    alias: ITEM-SPECIFICATION-MASTER-COPY
    title: item specification master copy
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var currentPageId = apex.page.currentPageId;
            console.log(currentPageId);
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region item (
        name: Item
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region itemsp (
        name: Itemsp
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       ITEMCHARACTERISTICSCODE,
                       MCVALUESNO,
                       VALUE
                  from ITEMSPECIFICATIONDETAIL
                  where tno = :P100_ITEMTNO
                  and sno = :P100_SNO
                ```
            pageItemsToSubmit: [
                P100_ITEMTNO
                P100_SNO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ITEMDETAIL
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 291011308106115792
        }

        savedReport 1449617 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @ITEMCHARACTERISTICSCODE
                layout {
                    width: 347.5
                    sequence: 4
                }
            )

            displayColumn (
                column: @MCVALUESNO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @VALUE
                layout {
                    show: false
                    sequence: 6
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ITEMCHARACTERISTICSCODE (
            type: popupLov
            heading {
                heading: Item Characteristics
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     Select
                         ITEMCHARACTERISTICSNAME,
                         ITEMCHARACTERISTICSCODE
                    From ITEMCHARACTERISTICS
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMCHARACTERISTICSCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            advanced {
                htmlDomId: ITEMCHARACTERISTICSCODE
            }
        )

        column MCVALUESNO (
            type: popupLov
            heading {
                heading: Value
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                         VALUE,
                         SNO
                    From MCValue a, ITEMCHARACTERISTICS b
                    Where a.Tno = b.TNo
                     and b.ITEMCHARACTERISTICSCode = :ITEMCHARACTERISTICSCODE
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ITEMCHARACTERISTICSCODE
                itemsToSubmit: [
                    MCVALUESNO
                    ITEMCHARACTERISTICSCODE
                ]
                parentRequired: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: MCVALUESNO
                dataType: number
            }
            advanced {
                htmlDomId: MCVALUESNO
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SNO (
            type: numberField
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            columnFilter {
                lovType: none
            }
        )

        column TNO (
            type: numberField
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P100_ITEMTNO
            }
            columnFilter {
                lovType: none
            }
        )

        column VALUE (
            type: textField
            heading {
                heading: Value
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 500
            }
            source {
                databaseColumn: VALUE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Itemsp
        }
    )

    pageItem P100_ITEMCHARACTERISTICS (
        type: textField
        label {
            label: Item Characteristics
            alignment: left
        }
        layout {
            sequence: 60
            region: @item
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
    )

    pageItem P100_ITEMTNO (
        type: popupLov
        label {
            label: Item
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery: select itemname , tno from item
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @item
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
    )

    pageItem P100_MCVALUE (
        type: textField
        label {
            label: Value
            alignment: left
        }
        layout {
            sequence: 70
            region: @item
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
    )

    pageItem P100_MFACTOR (
        type: textField
        label {
            label: Multiplying Factor
            alignment: left
        }
        layout {
            sequence: 40
            region: @item
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select Multiplyingfactor from itemspecification
                where tno = :P100_ITEMTNO
                ```
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from itemspecification
                where tno = :P100_ITEMTNO
                ```
        }
    )

    pageItem P100_SPECIFICATION (
        type: textField
        label {
            label: Specification
            alignment: left
        }
        layout {
            sequence: 50
            region: @item
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select itemspecificationname  from itemspecification
                where tno = :P100_ITEMTNO
                ```
        }
        sessionState {
            storage: request
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select itemspecificationname from itemspecification
                where tno = :P100_ITEMTNO
                and sno = :P100_SNO
                ```
        }
    )

    pageItem P100_UNIT1 (
        type: popupLov
        label {
            label: UNIT 1
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select MEASURINGUNITNAME , MEASURINGUNITCODE from MEASURINGUNIT
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @item
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select MEASURINGUNITNAME from MEASURINGUNIT
                where MEASURINGUNITCODE in 
                (select MEASURINGUNITCODE1 from item where tno = :P100_ITEMTNO)
                ```
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from MEASURINGUNIT
                where MEASURINGUNITCODE in 
                (select MEASURINGUNITCODE1 from item where tno = :P100_ITEMTNO)
                ```
        }
    )

    pageItem P100_UNIT2 (
        type: popupLov
        label {
            label: UNIT 2
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select MEASURINGUNITNAME , MEASURINGUNITCODE from MEASURINGUNIT
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @item
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select MEASURINGUNITNAME from MEASURINGUNIT
                where MEASURINGUNITCODE in 
                (select MEASURINGUNITCODE2 from item where tno = :P100_ITEMTNO)
                ```
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from MEASURINGUNIT
                where MEASURINGUNITCODE in 
                (select MEASURINGUNITCODE2 from item where tno = :P100_ITEMTNO)
                ```
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: focusout
            selectionType: region
            region: @itemsp
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var widget      = apex.region('ITEMDETAIL').widget();
                    var grid        = widget.interactiveGrid('getViews','grid');  
                    var model       = grid.model; 
                    var jsonData     = [];
                    
                    model.forEach(function(r) {
                        var record = r;
                        var value1 = model.getValue(record,'TNO');
                        var value2 = model.getValue(record,'SNO');
                       
                        jsonData.push(record);
                    
                    
                    })
                    
                    
                    var extractedData = [];
                    
                    jsonData.forEach(function(record) {
                      var ansValue = "";
                      
                      record.forEach(function(cell, columnIndex) {
                        if (columnIndex == 2) {
                          ansValue = cell.d;
                        }
                    
                        if (columnIndex == 3 ) {
                          extractedData.push(ansValue + ":" + cell.d);
                        }
                      });
                    });
                    
                    var output = extractedData.join(";");
                    
                    $s('P100_SPECIFICATION',output);
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

