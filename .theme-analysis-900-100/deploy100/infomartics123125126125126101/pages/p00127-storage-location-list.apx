page 127 (
    name: Storage Location List
    alias: STORAGE-LOCATION-LIST
    title: Storage Location List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region storage-location-list (
        name: Storage Location List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.STORAGELOCATIONCODE,
                       A.STORAGELOCATIONNAME,
                       A.STORAGELOCATIONSHORTNAME,
                       A.PARENTCODE,
                       b.STORAGELOCATIONNAME as Parent ,
                       A.REMARK,
                       A.DATECREATED,
                       A.DATEMODIFY,
                       A.CREATOR,
                       A.ISOUTOFPREMISES,
                       A.ALLOCATIONINCCINVOICEALLOWED
                  from STORAGELOCATION A , STORAGELOCATION B
                  where A.STORAGELOCATIONCODE = B.STORAGELOCATIONCODE(+)
                  Order By A.TNO Desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 128
                items: {
                    P128_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 153293587074158788
        }

        column ALLOCATIONINCCINVOICEALLOWED (
            type: plainText
            heading {
                heading: Allocation In cc Invoice Allowed
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column DATECREATED (
            type: plainText
            heading {
                heading: Date Created
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column DATEMODIFY (
            type: plainText
            heading {
                heading: Date Modify
            }
            layout {
                sequence: 8
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column ISOUTOFPREMISES (
            type: plainText
            heading {
                heading: Is Out Of Premises
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column PARENT (
            type: plainText
            heading {
                heading: Parent
            }
            layout {
                sequence: 21
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column PARENTCODE (
            type: plainText
            heading {
                heading: Parent1
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column STORAGELOCATIONCODE (
            type: hidden
            heading {
                heading: Storagelocationcode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column STORAGELOCATIONNAME (
            type: plainText
            heading {
                heading: Storage Location Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column STORAGELOCATIONSHORTNAME (
            type: plainText
            heading {
                heading: Storage Location Short Name
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Storage Location List
        }

        savedReport 1533048 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ALLOCATIONINCCINVOICEALLOWED (
                sequence: 6
            )

            displayColumn CREATOR (
                sequence: 7
            )

            displayColumn ISOUTOFPREMISES (
                sequence: 5
            )

            displayColumn PARENT (
                sequence: 3
            )

            displayColumn REMARK (
                sequence: 4
            )

            displayColumn STORAGELOCATIONNAME (
                sequence: 1
            )

            displayColumn STORAGELOCATIONSHORTNAME (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @storage-location-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 128
                clearCache: 128
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @storage-location-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @storage-location-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @storage-location-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @storage-location-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

