page 12 (
    name: Combo Box
    alias: COMBO-BOX
    title: Combo Box
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    pageItem P12_COMBOBOXMANY (
        type: combobox
        label {
            label: Combo Box Many
            alignment: left
        }
        settings {
            multiSelection: true
            infiniteScroll: false
            maxValuesInList: 7
            manualEntriesItem: P12_MANY
        }
        lov {
            type: sqlQuery
            sqlQuery: select locationname , locationcode from location
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 60
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P12_COMBOBOXONE (
        type: combobox
        label {
            label: Combo Box One
            alignment: left
        }
        settings {
            infiniteScroll: false
            maxValuesInList: 7
            manualEntriesItem: P12_ONE
        }
        lov {
            type: sqlQuery
            sqlQuery: select locationname , locationcode from location
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P12_MANY (
        type: textField
        label {
            label: Many
            alignment: left
        }
        layout {
            sequence: 70
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P12_MANYRETURN (
        type: textField
        label {
            label: Many Return
            alignment: left
        }
        layout {
            sequence: 80
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P12_ONE (
        type: textField
        label {
            label: One
            alignment: left
        }
        layout {
            sequence: 30
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P12_ONERETURN (
        type: textField
        label {
            label: One Return
            alignment: left
        }
        layout {
            sequence: 40
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    dynamicAction set-many (
        name: Set many
        execution {
            sequence: 20
        }
        when {
            event: focusout
            selectionType: items
            items: P12_COMBOBOXMANY
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P12_COMBOBOXMANY
                itemsToSubmit: P12_COMBOBOXMANY
            }
            affectedElements {
                selectionType: items
                items: P12_MANYRETURN
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-one (
        name: Set One
        execution {
            sequence: 10
        }
        when {
            event: focusout
            selectionType: items
            items: P12_COMBOBOXONE
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :P12_COMBOBOXONE
                itemsToSubmit: P12_COMBOBOXONE
            }
            affectedElements {
                selectionType: items
                items: P12_ONERETURN
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

