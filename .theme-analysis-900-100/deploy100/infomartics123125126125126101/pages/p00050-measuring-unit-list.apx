page 50 (
    name: Measuring Unit List
    alias: MEASURING-UNIT-LIST
    title: Measuring Unit List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region measuring-unit-list (
        name: Measuring Unit List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       MEASURINGUNITCODE,
                       MEASURINGUNITNAME,
                       DECIMALPLACE,
                       DATECRATED,
                       DATEMODIFY,
                       ISWEIGHMENTREQUIRED,
                       DIVISORFACTOR,
                       MULTIPLYINGFACTOR,
                       GSTUQCCODE,
                       FORMANPOWER,
                       REMARK,
                       to_char(CREATIONTIME,'DD-MM-YYYY HH24:MI:SS') CREATIONTIME,
                       CREATOR
                  from MEASURINGUNIT
                  Order By CREATIONTIME DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 51
                items: {
                    P51_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 139479324526819958
        }

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 24
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column DATECRATED (
            type: plainText
            heading {
                heading: Date Created
            }
            layout {
                sequence: 5
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATEMODIFY (
            type: plainText
            heading {
                heading: Date Modify
            }
            layout {
                sequence: 6
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column DECIMALPLACE (
            type: plainText
            heading {
                heading: Decimal Place
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column DIVISORFACTOR (
            type: plainText
            heading {
                heading: Divisor Factor
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column FORMANPOWER (
            type: plainText
            heading {
                heading: Forman Power
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column GSTUQCCODE (
            type: plainText
            heading {
                heading: GST UQC Code
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ISWEIGHMENTREQUIRED (
            type: plainText
            heading {
                heading: Is Weighment Required
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column MEASURINGUNITCODE (
            type: plainText
            heading {
                heading: Measuring Unit Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column MEASURINGUNITNAME (
            type: plainText
            heading {
                heading: Measuring Unit Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column MULTIPLYINGFACTOR (
            type: plainText
            heading {
                heading: Multiplying Factor
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Measuring Unit List
        }

        savedReport 1394937 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATIONTIME (
                sequence: 8
            )

            displayColumn CREATOR (
                sequence: 7
            )

            displayColumn DECIMALPLACE (
                sequence: 3
            )

            displayColumn GSTUQCCODE (
                sequence: 5
            )

            displayColumn ISWEIGHMENTREQUIRED (
                sequence: 4
            )

            displayColumn MEASURINGUNITCODE (
                sequence: 1
            )

            displayColumn MEASURINGUNITNAME (
                sequence: 2
            )

            displayColumn REMARK (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @measuring-unit-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 51
                clearCache: 51
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @measuring-unit-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @measuring-unit-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @measuring-unit-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @measuring-unit-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

