    region salary (
        name: SALARY
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select S.TNO,
                       S.LOCATIONCODE,
                       S.DOCTYPECODE,
                       S.COMPANYCODE,
                       S.FINANCIALYEARCODE,
                       S.SALARYNO,
                       S.SALARYDATE,
                       S.SALARYFROMDATE,
                       S.SALARYTODATE,
                       S.EMPLOYEECODE,
                       E.EMPLOYEENAME,
                       S.DEPARTMENTCODE,
                       D.DEPARTMENTNAME,
                       S.EMPLOYEESALARYTNO,
                       S.REMARK,
                       S.ARREARDATE,
                       S.ARREARMODULECODE,
                       S.ARREARMODULETNO,
                       S.EMPLOYEESALARYTNOFROMDATE,
                       S.CREATOR,
                       S.DATEOFENTERY,
                       S.EMPLOYEECOMPANYCODE,
                       S.MODULECODE,
                       S.MODULETNO,
                       S.MODULESNO,
                       S.CREATIONTIME
                       
                  from SALARY S, EMPLOYEE E,DEPARTMENT D
                WHERE S.EMPLOYEECODE=E.EMPLOYEECODE(+)
                AND S.DEPARTMENTCODE = D.DEPARTMENTCODE(+)
                and s.SALARYDATE  between :P640_FROMDATE and :P640_TODATE
                and   instr(':'||:P640_COMPANY||':',':'||s.companycode||':') > 0
                and   ( :P640_LOCATION IS NULL OR instr(':'||:P640_LOCATION||':',':'||s.LOCATIONCODE||':') > 0 )
                and   ( :P640_DOCTYPE IS NULL OR instr(':'||:P640_DOCTYPE||':',':'||s.DOCTYPECODE||':') > 0 )
                and   ( :P640_EMPLOYEE IS NULL OR instr(':'||:P640_EMPLOYEE||':',':'||s.employeeCODE||':') > 0 )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 641
                items: {
                    P641_TNO: #TNO#
                }
                clearCache: 641
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
