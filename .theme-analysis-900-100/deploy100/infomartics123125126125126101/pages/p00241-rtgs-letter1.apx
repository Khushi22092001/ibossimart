    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 40
            region: @rtgs-letter
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 242
                clearCache: 242
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  tModuleFlow number;
                  tmp         number;
                  tmp1        number;
                BEGIN
                   select count(*) into tmp1 from ModuleFlow a where a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID);
                   if nvl(tmp1,0) > 0 then
                        select 
                            count(*) into tModuleFlow
                        from ModuleFlow a, ModuleFlowUser b, Bossuser c
                        where a.tno = b.tno
                          and b.bossusercode = c.bossusercode
                          and a.Modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                          and c.bossusername = :APP_USER
                          ;
                
                          if nvl(tModuleFlow,0) > 0 then
                             return(TRUE) ;
                          else
                             return(FALSE);
                          end if;
                     else
                            Select
                            	COUNT(*) into tmp 
                            From Module a, ModulePrivilege b, BossUser c
                            Where a.ModuleCode = b.ModuleCode
                            	and b.BossUsercode = c.BossUserCode
                            	and c.LoginName = :GLOBAL_LOGINNAME
                                and a.ModuleCode= getmodulecodeforpageno(:APP_PAGE_ID)
                            	and b.CompanyCode = :GLOBAL_COMPANYCODE
                            	and b.InsertPrivilege = 'YES' ;
                            if nvl(tmp,0) > 0 then
                               return(TRUE);
                            else
                               return(FALSE);
                            end if;
                      end if;
                              
                END;
                ```
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 20
            region: @rtgs-letter
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 110
            region: @rtgs-letter-register
            slot: regionBody
            startNewRow: false
            column: 10
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pagination (
        name: Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P241_SJNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P241_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P241_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 75226117219479438
        }
    )

)

