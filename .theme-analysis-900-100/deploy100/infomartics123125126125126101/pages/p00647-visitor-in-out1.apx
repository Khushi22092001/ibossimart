    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Camera Permission Setting in Chrome
                -- chrome://flags/#unsafely-treat-insecure-origin-as-secure
                -- Enabled and type Application URl
                
                If :P647_TNO is null then
                    :P647_TNO := GlobalTNo.nextval;
                    :P647_FORMSTATUS := 'NEWRECORD';
                    -- ---- collection
                         declare
                          lco_photos_collection_name constant apex_collections.collection_name%type := 'PHOTOS';
                        begin
                          if not apex_collection.collection_exists(lco_photos_collection_name) then
                            apex_collection.create_collection(
                              p_collection_name => lco_photos_collection_name
                            );
                          end if;
                        end;   
                      -- ----
                else
                    :P647_FORMSTATUS := 'EDITRECORD';
                End if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25385665296454922
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P647_MODULEFLOW := 'YES';
                   else
                       :P647_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P647_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P647_ONTHETABLE := 'YES' ;
                   else
                       :P647_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25386001911454922
        }
    )

