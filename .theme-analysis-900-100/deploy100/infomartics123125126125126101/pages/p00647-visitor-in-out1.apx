    dynamicAction close-region (
        name: Close region
        execution {
            sequence: 180
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @setting
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: delete unsaved data
        execution {
            sequence: 150
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: delete from visitorinout where visitorinoutno is null;
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction disable-delete-button-for-updateprivillege (
        name: DISABLE DELETE BUTTON FOR UPDATEPRIVILLEGE
        execution {
            sequence: 80
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      tmp number;
                    begin
                         for vloop in (
                            
                            Select 1
                              From MODULEPRIVILEGE A
                             Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                               And a.bossusercode = :GLOBAL_BOSSUSERCODE
                               And a.companycode = :GLOBAL_COMPANYCODE
                               AND A.DELETEPRIVILEGE = 'NO'
                         ) loop
                               tmp := 1;
                               exit;
                         end loop;
                    
                         select count(*) into tmp from purchaseorder a where a.indenttno = :P647_TNO ;
                         if nvl(tmp,0) = 0 then
                            return false;
                         else
                            return true;
                         end if;
                    end;
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            execution {
                sequence: 30
            }
            serverSideCondition {
                type: never
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      tmp number;
                      tmp1 number;
                    begin
                         for vloop in (
                                   Select 1
                              From MODULEPRIVILEGE A
                             Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                               And a.bossusercode = :GLOBAL_BOSSUSERCODE
                               And a.companycode = :GLOBAL_COMPANYCODE
                               AND A.DELETEPRIVILEGE = 'YES'
                         ) loop
                               tmp1 := 1;
                               exit;
                         end loop;
                    
                         select count(*) into tmp from purchaseorder a where a.indenttno = :P647_TNO ;
                         if nvl(tmp,0) > 0 then
                            return false;
                         else
                            if nvl(tmp1,0) > 0 then
                               return true;
                            else 
                                return false;
                            end if;
                         end if;
                    end;
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
