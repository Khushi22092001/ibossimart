                select COMPANYCODE,
                       COMPANYNAME,
                       LOCATIONCODE,
                       LOCATIONNAME,
                       DOCTYPECODE,
                       DOCTYPENAME,
                       PARTYCODE,
                       PARTYNAME,
                       COUNT0030,
                       VALUE0030,
                       COUNT3160,
                       VALUE3160,
                       COUNT6190,
                       VALUE6190,
                       COUNT91120,
                       VALUE91120,
                       COUNT121150,
                       VALUE121150,
                       COUNT151180,
                       VALUE151180,
