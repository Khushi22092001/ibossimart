    region credit (
        name: Credit
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @supplier-dashboard
            slot: subRegions
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent14
                t-Region--hiddenOverflow
            ]
            cssClasses: region1
        }
    )

    region order-completed (
        name: Order Completed
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.PartyCode,
                      Case when nvl(Count(a.TNo),0) = 0 then '-'
                           else to_char(nvl(Count(a.TNo),0))
                      end as CompletedOrders,
                      Case when nvl(Sum(a.TotalAmount),0) = 0 then '-'
                           else to_char(nvl(Sum(a.TotalAmount),0)) 
                      end as Amount
                From  D_SUPPLIER_360VIEW_PURCHASEORDERCOMPLETED a
                Where a.PartyCode = :P515_SUPPLIERCODE
                Group by a.PartyCode
                
                ```
        }
        layout {
            sequence: 50
            parentRegion: @supplier-dashboard
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            cssClasses: hiddenscroll
        }
        card {
            cssClasses: color8
        }
        title {
            column: COMPLETEDORDERS
            cssClasses: cardtitle
        }
        subtitle {
            column: AMOUNT
            cssClasses: cardsubtitle
        }
        body {
            advancedFormatting: true
            htmlExpression: <H4 style="font-size:20px; text-align:center"> Orders Completed </H4>
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 532
                    items: {
                        P532_SUPPLIERCODE: &PARTYCODE.
                    }
                    clearCache: 532
                }
            }
        )

    )

    region orders-delivered-on-time (
        name: Orders Delivered on Time
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Case when a.PartyCode is null then '-'
                           else a.PartyCode
                      end as PartyCode,
                      case when nvl(Count(a.TNo),0) =  0 then '-'
                           else to_char(nvl(Count(a.TNo),0))
                      end as ODOT,
                      Case when nvl(Sum(a.TotalAmount),0) = 0 then '-'
                           else to_char(nvl(Sum(a.TotalAmount),0))
                      end as Amount
                From  D_SUPPLIER_360VIEW_PURCHASEORDERSDELIVEREDONTIME a
                Where a.PartyCode = :P515_SUPPLIERCODE
                Group by Case when a.PartyCode is null then '-'
                           else a.PartyCode
                      end
                
                ```
        }
        layout {
            sequence: 70
            parentRegion: @supplier-dashboard
            slot: subRegions
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            cssClasses: hiddenscroll
        }
        card {
            cssClasses: color10
        }
        title {
            column: ODOT
            cssClasses: cardtitle
        }
        subtitle {
            column: AMOUNT
            cssClasses: cardsubtitle
        }
        body {
            advancedFormatting: true
            htmlExpression: <H4 style="font-size:20px; text-align:center"> Orders Delivered on Time</H4>
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: NO DATA FOUND
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 533
                    items: {
                        P533_SUPPLIERCODE: &PARTYCODE.
                    }
                    clearCache: 533
                }
            }
        )

    )

    region outstanding-amount (
        name: Outstanding Amount
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Case when a.PartyCode is null then '-'
                           else a.PartyCode
                      end as PartyCode,
                      case when nvl(Count(a.TNo),0) =  0 then '-'
                           else to_char(nvl(Count(a.TNo),0))
                      end as OverdueNos,
                      Case when nvl(Sum(a.BALANCEAMOUNT),0) = 0 then '-'
                           else to_char(nvl(Sum(a.BALANCEAMOUNT),0))
                      end as OverdueAmount
                From  D_SUPPLIER_360VIEW_PENDINGPBPASS a
                Where a.PartyCode = :P515_SUPPLIERCODE
                Group by Case when a.PartyCode is null then '-'
                           else a.PartyCode
                      end
                
                ```
        }
        layout {
            sequence: 100
            parentRegion: @supplier-dashboard
            slot: subRegions
            column: 1
            columnSpan: 3
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            cssClasses: hiddenscroll
        }
        card {
            cssClasses: color10
        }
        title {
            column: OVERDUENOS
            cssClasses: cardtitle
        }
        subtitle {
            column: OVERDUEAMOUNT
            cssClasses: cardsubtitle
        }
        body {
            advancedFormatting: true
            htmlExpression: <H4 style="font-size:20px; text-align:center"> Outstanding Amount</H4>
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: NO DATA FOUND
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 529
                    items: {
                        P529_SUPPLIERCODE: &PARTYCODE.
                    }
                    clearCache: 529
                }
            }
        )

    )

