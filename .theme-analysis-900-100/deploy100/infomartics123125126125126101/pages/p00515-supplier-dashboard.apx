page 515 (
    name: Supplier Dashboard
    alias: SUPPLIER-DASHBOARD
    title: Supplier Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .customerinfo{background-color:#CAF279;}
            .monthsale{background-color:#F7C872;height: 349px;}
            .mytext{font-weight: 500;}
            .cardtitle{font-size: 40px;font-family:'Calibri';font-weight: 900;margin-bottom: 20px;}
            .cardsubtitle{font-size: 20px;font-family:'Calibri';font-weight: 700;}
            .color1{background-color: #f84f4f;}
            .color2{background-color: #b51212}
            .color3{background-color: #12b5b5}
            .color4{background-color: #75d9d9}
            .color5{background-color: #cf98e0}
            .color6{background-color: #a9e098}
            .color7{background-color: #fbb1c7}
            .color8{background-color: #b1fbe5}
            .color9{background-color: #f48956}
            .color10{background-color:#fefe69}
            .region1{background-color: gainsboro;height: 240px;}
            .hiddenscroll{overflow: hidden;}
            .reportheight{height: 350px; overflow: auto !important;}
            .h2+h3{margin-top: 0em;}
            .caption{font-weight: bold;}
            .captionvalue{font-weight: normal;}
            .t-Form-label{padding-top: 0px;padding-bottom: 0px;margin-top: 0px;margin-bottom: 0px;padding-right: 2px;margin-right:2px;width: 100%;}
            ```
    }
    security {
        formAutoComplete: false
    }

    region 12-months-purchase (
        name: 12 Months Purchase
        type: chart
        layout {
            sequence: 30
            parentRegion: @supplier-dashboard
            slot: subRegions
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                i-h320
                t-Region--textContent
                t-Region--hiddenOverflow
            ]
            cssClasses: monthsale
        }
        chartLayout {
            maxWidth: 600
            height: 270
        }
        legend {
            show: false
        }

        series purchase (
            name: Purchase
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                        x.Months,
                        x.Amount,
                        x.partyCode
                    From 
                    (select 
                           partycode,
                           TO_CHAR(PBPASSDATE,'MON-YYYY')AS MONTHS,
                           TO_CHAR(PBPASSDATE,'YYYYMM')AS MONTHSYY,
                           SUM(TOTALAMOUNT) AMOUNT
                      from D_SUPPLIER_360VIEW_ACTIVEPBPASS
                      WHERE PARTYCODE = :P515_SUPPLIERCODE
                      GROUP BY TO_CHAR(PBPASSDATE,'MON-YYYY'),partycode,TO_CHAR(PBPASSDATE,'YYYYMM')
                      Order by TO_CHAR(PBPASSDATE,'YYYYMM')
                    )x
                    Where rownum<= 12
                    ```
            }
            columnMapping {
                label: MONTHS
                value: AMOUNT
            }
            appearance {
                color: #d03333
            }
            link {
                type: redirectThisApp
                target: {
                    page: 542
                    items: {
                        P542_SUPPLIERCODE: &PARTYCODE.
                        P542_MONTH: &MONTHS.
                    }
                    clearCache: 542
                }
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

        axis y-2 (
            name: y2
            minorTicks {
                show: false
            }
        )

    )

    region 12-months-purchase-2 (
        name: 12 Months Purchase
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*Select
                     level
                From dual
                connect by level <= 13
                */
                Select
                     x.Months,
                     x.Amount
                From (
                select 
                       TO_CHAR(PBPASSDATE,'MON-YYYY')AS MONTHS,
                       TO_CHAR(PBPASSDATE,'YYYYMM')AS MONTHSYY,
                       SUM(TOTALAMOUNT) AMOUNT
                  from D_SUPPLIER_360VIEW_ACTIVEPBPASS
                  WHERE PARTYCODE = :P515_SUPPLIERCODE
                  GROUP BY TO_CHAR(PBPASSDATE,'MON-YYYY'),TO_CHAR(PBPASSDATE,'YYYYMM')
                  ORDER BY TO_CHAR(PBPASSDATE,'YYYYMM')
                  )x
                Where rownum <= 12
                
                ```
        }
        layout {
            sequence: 80
            parentRegion: @supplier-dashboard
            slot: subRegions
            column: 1
            columnSpan: 3
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: reportheight
        }
        advanced {
            htmlDomId: MYID
        }
        headerAndFooter {
            headerText: <h3 style="font-family:Calibri;text-align:center;background-color: gainsboro;margin-top: 0em;">12 Months Purchase</h3>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 16115528386084948
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column MONTHS (
            type: plainText
            heading {
                heading: Months
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        savedReport 65768 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 2
            )

            displayColumn MONTHS (
                sequence: 1
            )

            aggregate (
                column: AMOUNT
            )

        )

    )

    region active-po (
        name: Active PO
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.PartyCode,
                      Case When nvl(count(a.TNo),0) = 0 then '-'
                           else to_Char(nvl(count(a.TNo),0))
                      end as ActivePO,
                      Case when nvl(round(sum(a.TotalAmount),2),0) = 0 then '-'
                           else to_Char(nvl(round(sum(a.TotalAmount),2),0))
                      end as Amount
                From  D_SUPPLIER_360VIEW_ACTIVEPURCHASEORDERS a
                Where a.PartyCode = :P515_SUPPLIERCODE
                Group by a.PartyCode
                ```
        }
        layout {
            sequence: 40
            parentRegion: @supplier-dashboard
            slot: subRegions
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            cssClasses: hiddenscroll
        }
        card {
            cssClasses: color4
        }
        title {
            column: ACTIVEPO
            cssClasses: cardtitle
        }
        subtitle {
            column: AMOUNT
            cssClasses: cardsubtitle
        }
        body {
            advancedFormatting: true
            htmlExpression: <H4 style="font-size:20px; text-align:center"> Active PO </H4>
        }
        performance {
            lazyLoading: true
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 543
                    items: {
                        P543_SUPPLIERCODE: &PARTYCODE.
                    }
                    clearCache: 543
                }
            }
        )

    )

