            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P632_Tno is null then
                        Select GlobalTno.NextVal into :P632_Tno From Dual;
