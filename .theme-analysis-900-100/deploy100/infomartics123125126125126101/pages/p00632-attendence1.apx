    dynamicAction new (
        name: New_3
        execution {
            sequence: 100
        }
        when {
            event: click
            selectionType: button
            button: @get-employee
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                      
                      delete from ATTENDENCEDETAIL where tno = :P632_TNO;
                      Insert Into ATTENDENCEDETAIL 
                                ( 
                                     TNO,
                                     SNO,
                                     EMPLOYEECODE,
                                     SHIFTCODE
                                )
                      SELECT    :P632_TNO,
                                globaltno.nextval,
                                E.EMPLOYEECODE,
                                :P632_SHIFTCODE
                          FROM EMPLOYEE E
                          where e.locationcode = :P632_LOCATIONCODE
                          and  ( :P632_SHIFTCODE IS NULL OR instr(':'||:P632_SHIFTCODE||':',':'||E.SHIFTCODE||':') > 0 )
                          and  ( :P632_DEPARTMENTCODE IS NULL OR instr(':'||:P632_DEPARTMENTCODE||':',':'||E.DEPARTMENTCODE||':') > 0 );
                    ```
                itemsToSubmit: [
                    P632_TNO
                    P632_DEPARTMENTCODE
                    P632_LOCATIONCODE
                    P632_SHIFTCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

