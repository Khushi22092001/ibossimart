                					:P632_LocationCode,
                					:P632_DocTypeCode,
                					NULL,
                					TO_DATE(:P632_ATTENDENCEDATE, 'DD-MM-RRRR')
                				);
                        :P632_ATTENDENCENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P632_LocationCode,
                                    :P632_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P632_ATTENDENCEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
