        }
    )

    process attendencedetail-save-interactive-grid-data (
        name: ATTENDENCEDETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @attendencedetail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                           IF :SNO IS NULL then
                                select globaltno.nextval into :SNO from dual;
                           end if;
                            Insert Into ATTENDENCEDETAIL ( 
                                        TNO,
                                        SNO,
                                        EMPLOYEECODE,
                                        SHIFTCODE,
                                        INTIME,
                                        OUTTIME,
                                        PRESENTHOUR ,
                                        COFFHOUR,
                                        ATTENDENCEHEADCODE,
                                        ATTENDENCEVALUE,
                                        REMARK
                            )
                            Values (
                                        :TNO,
                                        :SNO,
                                        :EMPLOYEECODE,
                                        :P632_SHIFTCODE,
                                        TO_DATE(:INTIME,'DD-MM-RRRR HH24:MI'),
                                        TO_DATE(:OUTTIME,'DD-MM-RRRR HH24:MI'),
                                        :PRESENTHOUR ,
                                        :COFFHOUR,
                                        :ATTENDENCEHEADCODE,
                                        :ATTENDENCEVALUE,
                                        :REMARK
                             );
                  
                        when 'U' then
                            update ATTENDENCEDETAIL Set
                                        TNO =   :TNO,
                                        SNO =   :SNO,
                                        EMPLOYEECODE = :EMPLOYEECODE,
                                        SHIFTCODE   =   :P632_SHIFTCODE,
                                        INTIME  = TO_DATE(:INTIME,'DD-MM-RRRR HH24:MI'),
                                        OUTTIME =  TO_DATE(:OUTTIME,'DD-MM-RRRR HH24:MI'),
                                        PRESENTHOUR = :PRESENTHOUR,
                                        COFFHOUR = :COFFHOUR,
                                        ATTENDENCEHEADCODE =   :ATTENDENCEHEADCODE,
                                        ATTENDENCEVALUE = :ATTENDENCEVALUE
                            WHERE TNO = :P632_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From ATTENDENCEDETAIL
                            Where TNo = :P632_TNO
                              and SNO = :SNO
                              ;
                    
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 17539181131848602
        }
    )

