    dynamicAction delete-detail-data (
        name: Delete detail data
        execution {
            sequence: 200
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from ATTENDENCEDETAIL  a
                        where not exists (
                            select 1 from ATTENDENCE  aa  
                            where aa.tno = a.tno
                        );
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

