    region attendencedetail (
        name: ATTENDENCEDETAIL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.SNO,
                       a.SERIALNO,
                       a.EMPLOYEECODE,
                       a.EMPLOYEETNO,
                       a.PRESENTHOUR,
                       a.COFFHOUR,
                       a.ATTENDENCEHEADCODE,
                       h.ATTENDENCEHEADNAME,
                       a.OVERTIMEHOUR,
                       a.OVERTIMEATTENDENCEHEADCODE,
                       a.PREPARED,
                       a.REMARK,
                       a.ATTENDENCEVALUE,
                       a.SHIFTCODE,
                       a.INTIME,
                       a.OUTTIME,
                       a.DELAYTIME,
                       a.ATTENDENCESTATUS,
                       a.MODULECODE,
                       a.MODULETNO,
                       a.FIRSTPUNCHTIME,
                       a.LASTPUNCHTIME,
                       d.departmentname DEPTNAME,
                       s.designationname DESIGNNAME
                FROM ATTENDENCEDETAIL a,EMPLOYEE e,DEPARTMENT d,designation s, ATTENDENCEHEAD h
                WHERE A.EMPLOYEECODE=E.EMPLOYEECODE
                AND e.departmentcode=d.departmentcode(+)
                AND e.designationcode=s.designationcode(+)
                AND a.ATTENDENCEHEADCODE = h.ATTENDENCEHEADCODE(+)
                AND a.TNO = :P632_TNO
                
                ```
            pageItemsToSubmit: P632_TNO
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: S_ATTENDENCEDETAIL
        }
