        action get-presenthour (
            name: GET_PRESENTHOUR
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      out_date DATE;
                      in_date DATE;
                    Begin
                      out_date := to_date(:OUTTIME ,'DD-MM-RRRR HH24:MI');
                      in_date  := to_date(:INTIME,'DD-MM-RRRR HH24:MI');
                      IF out_date > in_date THEN
                        RETURN (out_date-in_date)*24;
                      END IF;
                      IF out_date <= in_date THEN
                         RETURN null;
                      END IF;
                    End;
                    ```
                itemsToSubmit: [
                    INTIME
                    OUTTIME
                ]
            }
            affectedElements {
                selectionType: columns
                columns: PRESENTHOUR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

