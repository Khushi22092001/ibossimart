    process process-routing-detail-save-interactive-grid-data (
        name: Process Routing Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @process-tat-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                     if :FROMMODULECODE is not null then
                            case :APEX$ROW_STATUS
                                when 'C' then
                                    if :SNO IS NULL THEN
                                        select globaltno.nextval into :SNO from dual;
                                    end if;
                                    Insert Into PROCESSTATDETAIL   
                                        (
                                          tno             ,
                                          sno             ,
                                          serialno        ,
                                          frommodulecode  ,
                                          tomodulecode    ,
                                          timeinterval    ,
                                          timeintervaluom ,
                                          sqlquery        ,
                                          remark          
                                     
                                    ) VALUES
                                    (
                                        :TNO,
                                        :SNO,
                                        :SERIALNO,
                                        :FROMMODULECODE,
                                        :TOMODULECODE,
                                        :TIMEINTERVAL,
                                        :TIMEINTERVALUOM,
                                        :SQLQUERY,
                                        :REMARK
                                    ) ;
                           
                                when 'U' then
                                    update PROCESSTATDETAIL 
                                      
                                    SET  SERIALNO = :SERIALNO,
                                         FROMMODULECODE =   :FROMMODULECODE,
                                         TOMODULECODE =   :TOMODULECODE,
                                         TIMEINTERVAL =   :TIMEINTERVAL,
                                         TIMEINTERVALUOM =   :TIMEINTERVALUOM,
                                         SQLQUERY =   :SQLQUERY,
                                         REMARK =   :REMARK
                                     WHERE TNO = :TNO
                                      AND sno = :SNO
                                      ;
                            
                                when 'D' then
                                    Delete from PROCESSTATDETAIL where tno = :TNO AND SNO = :SNO;
                                
                            END CASE;
                   end if;
                 end ;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 61309589352516442
        }
    )

