    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 220
        }
        when {
            event: focusout
            selectionType: items
            items: P718_PROCESSROUTINGTNO
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    tslno  number;
                    begin
                    
                        if :P718_FORMSTATUS='NEWRECORD' then
                            delete from processtatdetail aa where not exists ( select 1 from processtat a where a.tno = aa.tno);
                            delete from processtatdetail aa where aa.tno = :P718_TNO;
                            for vloop in (
                            select 
                                modulecode
                            from processroutingdetail a
                            where a.tno = :P718_PROCESSROUTINGTNO
                            order by sno
                            ) loop
                              tslno := nvl(tslno,0) + 1;
                              insert into processtatdetail ( tno,sno,serialno,frommodulecode)
                              values ( :P718_TNO,globaltno.nextval,tslno,vloop.modulecode)
                              ;
                            end loop;
                        end if;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P718_FORMSTATUS
                    P718_TNO
                    P718_PROCESSROUTINGTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @process-tat-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 90
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: P718_TNO
            }
            execution {
                sequence: 20
                fireOnInit: false
