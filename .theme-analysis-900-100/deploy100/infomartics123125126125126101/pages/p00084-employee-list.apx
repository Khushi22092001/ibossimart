        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Employee List
        }

        savedReport 1440323 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CATEGORYNAME (
                sequence: 3
            )

            displayColumn COMPANYNAME (
                sequence: 4
            )

            displayColumn DATEOFAPPOINTMENT (
                sequence: 11
            )

            displayColumn DATEOFBIRTH (
                sequence: 10
            )

            displayColumn DATEOFJOINING (
                sequence: 12
            )

