page 646 (
    name: Image Priview
    alias: IMAGE-PRIVIEW
    title: Image Priview
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 700
        height: 640
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var video = document.getElementById('video');
            var videoStream;
            var canvas = document.getElementById('canvas');
            var context = canvas.getContext('2d');
            
            var spinner;
            var spinTargetElem = document.getElementById('wwvFlowForm');
            var spinOptions = {
              lines: 13
            , length: 28
            , width: 14
            , radius: 42
            , scale: 1
            , corners: 1
            , color: '#000'
            , opacity: 0.25
            , rotate: 0
            , direction: 1
            , speed: 1
            , trail: 60
            , fps: 20
            , zIndex: 2e9
            , className: 'spinner'
            , top: '50%'
            , left: '50%'
            , shadow: false
            , hwaccel: false
            , position: 'absolute'
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region camera (
        name: Camera
        type: staticContent
        source {
            htmlCode:
                ```html
                <div style="text-align:center;">
                  <video id="video" width="640" height="480" autoplay></video>
                  <canvas id="canvas" width="640" height="480" style="display:none;"></canvas>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div style="text-align:center;">
                  <video id="video" width="640" height="480" autoplay></video>
                  </div>
                ```
