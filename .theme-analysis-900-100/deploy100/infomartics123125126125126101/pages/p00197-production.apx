    dynamicAction set-sum-of-qty (
        name: Set sum of qty1
        execution {
            sequence: 180
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @production-raw-stock-detail
            columns: QUANTITY1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      stockqty  number;
                      allocateqty number;
                    begin
                        allocateqty := nvl(:quantity1,0);
                         select sum(stockquantity1) - sum(nvl(usedstockquantity1,0)) into stockqty 
                         from stock where tno = :STOCKTNO;
                    
                         if nvl(stockqty,0) > allocateqty then
                              :QUANTITY1 := allocateqty ;
                         else
                              :quantity1 := stockqty ;
                              --raise_application_error ( -20000,' Stock Quantity is Less Than Allocated Quantity');
                         end if;
                    end;
                    ```
                itemsToSubmit: [
                    QUANTITY1
                    STOCKTNO
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("StockDetail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("QUANTITY1");
                    
                    var totalAmt = 0;
                    
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                    
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                      
                    });
                    
                    // $s("P197_STOCKQTY1", totalAmt);
                    $s("P197_STOCKQTY1", totalAmt.toFixed(2));
                    
                    	
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: columns
                columns: QUANTITY1
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                        mfactor number;
                    begin
                        select MULTIPLYINGFACTOR into mfactor from ITEMSPECIFICATION where ITEMSPECIFICATIONCODE = :P197_DETAILITEMSPECIFICATIONCODE;
                        return :QUANTITY1*mfactor;
                        exception when others then
                            null;
                    end;
                    ```
                itemsToSubmit: [
                    P197_DETAILITEMSPECIFICATIONCODE
                    QUANTITY1
                ]
            }
            affectedElements {
                selectionType: columns
                columns: QUANTITY2
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

