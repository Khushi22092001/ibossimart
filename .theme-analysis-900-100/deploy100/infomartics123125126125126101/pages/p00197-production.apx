    dynamicAction insert-into-input-output-tables (
        name: Insert into Input & Output tables
        execution {
            sequence: 160
        }
        when {
            event: focusout
            selectionType: items
            items: P197_BOMTNO
        }
        clientSideCondition {
            type: item=value
            item: P197_FORMSTATUS
            value: NEWRECORD
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DELETE FROM PRODUCTIONRAW WHERE TNO = :P197_TNO;
                    DELETE FROM PRODUCTIONFINISHED WHERE TNO = :P197_TNO;
                    
                    INSERT INTO PRODUCTIONRAW ( TNO,SNO,SERIALNO,ITEMCODE,ITEMSPECIFICATIONCODE,QUANTITY1,QUANTITY2)
                    ( 
                    SELECT 
                        :P197_TNO AS TNO,
                        GLOBALTNO.NEXTVAL,
                        ROWNUM,
                        e.ITEMCODE ,
                        e.ITEMSPECIFICATIONCODE ,
                        E.QUANTITY1 * NVL(:P197_QUANTITY1,0) ,
                     
                        E.QUANTITY1 * NVL(:P197_QUANTITY1,0) * c.MULTIPLYINGFACTOR  
                    
                       FROM bom A , ITEM B , ITEMSPECIFICATION C , MEASURINGUNIT D, BOMDETAIL E, MEASURINGUNIT f
                        WHERE A.TNO = E.TNO
                          AND e.ITEMCODE = b.ITEMCODE  
                          AND e.ITEMSPECIFICATIONCODE = c.ITEMSPECIFICATIONCODE 
                          AND B.TNO = C.TNO
                          AND B.MEASURINGUNITCODE1 = D.MEASURINGUNITCODE(+)
                          AND B.MEASURINGUNITCODE2 = F.MEASURINGUNITCODE(+)
                    	  AND A.TNO = :P197_BOMTNO
                          AND :P197_FORMSTATUS='NEWRECORD'
                    );
                    
                    -------- OUTPUT DETAIL
                    
                    INSERT INTO PRODUCTIONFINISHED ( TNO,SNO,SERIALNO,ITEMCODE,ITEMSPECIFICATIONCODE,QUANTITY1,QUANTITY2)
                    (
                      SELECT :P197_tno,
                             globaltno.nextval,
                             rownum,
                             :p197_itemcode,
                             :p197_itemspecificationcode,
                             :p197_quantity1,
                             NVL(:p197_quantity1,0) * NVL(A.MULTIPLYINGFACTOR,0) 
                       from itemspecification a
                       where a.itemspecificationcode = :P197_ITEMSPECIFICATIONCODE
                       AND :P197_FORMSTATUS = 'NEWRECORD'
                    
                    );
                    ```
                itemsToSubmit: [
                    P197_TNO
                    P197_BOMTNO
                    P197_QUANTITY1
                    P197_FORMSTATUS
                    P197_ITEMCODE
                    P197_ITEMSPECIFICATIONCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                                 if :P197_STATUS = 'ACTIVE' then
                            
                                    CREATEPAYMENTADVICEFORPO(:P197_TNO);
                    
                                  end if;
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P197_TNO
                    P197_COMPANYCODE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P197_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

