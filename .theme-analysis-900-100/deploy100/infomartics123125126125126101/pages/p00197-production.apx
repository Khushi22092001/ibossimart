        column ITEMCODE (
            type: popupLov
            heading {
                heading: Item
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ITEMNAME D, ITEMCODE R FROM ITEM A 
                    WHERE ( :P197_BOMTNO IS NULL OR EXISTS ( SELECT 1 FROM BOMDETAIL AA WHERE AA.TNO = :P197_BOMTNO
                            AND AA.ITEMCODE = :ITEMCODE and a.itemcode = aa.itemcode)
                         )
                    AND GETDOCUMENTSTATUSCODE('ITEM',A.TNO) = 'ACTIVE'
                    
                    ```
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    ITEMCODE
                    P197_BOMTNO
                ]
            }
            layout {
                sequence: 60
                group: @item
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMCODE
                dataType: varchar2
            }
            advanced {
                htmlDomId: INPUTITEMCODE
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: popupLov
            heading {
                heading: Itemspecification
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT ITEMSPECIFICATIONNAME D, ITEMSPECIFICATIONCODE R FROM ITEMSPECIFICATION A 
                    WHERE ( :P197_BOMTNO IS NULL OR EXISTS ( SELECT 1 FROM BOMDETAIL AA WHERE AA.TNO = :P197_BOMTNO
                            AND AA.ITEMCODE = :ITEMCODE AND AA.ITEMSPECIFICATIONCODE = :ITEMSPECIFICATIONCODE
                            and a.itemspecificationcode = aa.itemspecificationcode)
                         )
                    AND GETDOCUMENTSTATUSCODE('ITEM',A.TNO) = 'ACTIVE'
                    and a.tno in (select tno from item where itemcode = :itemcode)
                    ```
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    ITEMCODE
                    ITEMSPECIFICATIONCODE
                    P197_BOMTNO
                ]
            }
            layout {
                sequence: 70
                group: @item
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMSPECIFICATIONCODE
                dataType: varchar2
            }
            advanced {
                htmlDomId: INPUTITEMSPECIFICATIONCODE
            }
        )

