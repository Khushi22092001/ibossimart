page 197 (
    name: PRODUCTION
    alias: PRODUCTION
    title: PRODUCTION
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P197_BIREPORTURL').val()
              var reportName = 'IRONMART/REPORT/Production.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '&P_TNO=' + $('#P197_TNO').val() 
                  ;
            
             
                    var reportURL = bireporturl+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P197_BIREPORTURL').val()
              var reportName =  'Production.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '"_paramsP_TNO":"' + $('#P197_TNO').val() 
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            
            
            ```
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 30
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region input-detail (
        name: Input Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.ROWID,
                       a.TNO,
                       a.SNO,
                       a.SERIALNO,
                       a.ITEMCODE,
                       a.ITEMSPECIFICATIONCODE,
                       a.DESCRIPTION,
                       a.QUANTITY1,
                       GETMEASURINGUNITNAME(B.MEASURINGUNITCODE1) AS UOM1,
                       a.QUANTITY2,
                       GETMEASURINGUNITNAME(B.MEASURINGUNITCODE2) AS UOM2,
                       a.LOSSPERCENT,
                       a.LOSSQUANTITY1,
                       a.LOSSQUANTITY2,
                       a.REMARK,
                       a.STORAGELOCATIONCODE,
                       a.FEEDTOKILN,
                       a.CREATOR,
                       a.DATEOFENTRY,
                       a.TEMPERATURE,
                       a.DRYWEIGHT,
                       'SD' as SD
                  from PRODUCTIONRAW a, ITEM B
                  WHERE A.ITEMCODE = B.ITEMCODE
                    AND A.TNO = :P197_TNO
                
                ```
            pageItemsToSubmit: [
                P197_TNO
                P197_BOMTNO
                P197_QUANTITY1
                P197_FORMSTATUS
            ]
        }
        layout {
            sequence: 40
            parentRegion: @tab
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: InputDetail
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 4442273810148904
        }

