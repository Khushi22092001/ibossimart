    dynamicAction calculate-loss-quantity (
        name: Calculate Loss Quantity
        execution {
            sequence: 220
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @input-detail
            columns: LOSSPERCENT
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 
                       NVL(:QUANTITY1,0) * NVL(:LOSSPERCENT,0)/100 , (NVL(:QUANTITY1,0) * NVL(:LOSSPERCENT,0)/100) * NVL(A.MULTIPLYINGFACTOR ,0)
                    from itemspecification a
                    where a.itemspecificationcode = :ITEMSPECIFICATIONCODE
                    ```
                itemsToSubmit: [
                    QUANTITY1
                    LOSSPERCENT
                    ITEMSPECIFICATIONCODE
                ]
            }
            affectedElements {
                selectionType: columns
                columns: [
                    LOSSQUANTITY1
                    LOSSQUANTITY2
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction check-qty (
        name: Check qty
        execution {
            sequence: 190
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @production-raw-stock-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P197_INPUTQUANTITY <> :P197_STOCKQTY1 then
                        raise_application_error(-20000,'Entered Stock Qty is Not Matching With Detail Quantity.');
                    end if;
                    ```
                itemsToSubmit: [
                    P197_INPUTQUANTITY
                    P197_STOCKQTY1
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

