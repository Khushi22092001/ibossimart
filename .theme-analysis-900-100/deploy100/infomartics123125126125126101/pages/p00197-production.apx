    dynamicAction check-stock-qty (
        name: Check stock qty
        execution {
            sequence: 300
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @production-raw-stock-detail
            columns: QUANTITY1
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if nvl(:P197_STOCKTNOQTY1,0) < nvl(:QUANTITY1,0) then
                       -- :QUANTITY1 := 0;
                        raise_application_error(-20000,'Stock Quantity is less then entered quantity.'||'Stock Qty:'||:P197_STOCKTNOQTY1||'-'||'Entered Qty'||:QUANTITY1);
                    end if;
                    ```
                itemsToSubmit: [
                    P197_STOCKTNOQTY1
                    QUANTITY1
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 48
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from PRODUCTIONRAW  a
                        where not exists (
                            select 1 from PRODUCTION  aa  
                            where aa.tno = a.tno
                        ) and a.tno = :P197_TNO;
                    
                        
                    delete from PRODUCTIONFINISHED  a
                        where not exists (
                            select 1 from PRODUCTION  aa  
                            where aa.tno = a.tno
                        ) and a.tno = :P197_TNO;
                    ```
                itemsToSubmit: P197_TNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P197_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            execution {
                sequence: 70
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from loadingadvice aa where aa.purchaseordertno = :P197_TNO;
            }
        )

        action native-disable-4 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 80
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      TMP NUMBER;
                      TMP1 NUMBER;
                    BEGIN
                       SELECT COUNT(*) INTO TMP FROM VOUCHER WHERE MODULETNO = :P197_TNO;
                       IF NVL(TMP,0) > 0 then
                            return true;
                       end if;
                       
                    END;
                    ```
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                       and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

    )

