    region production (
        name: PRODUCTION
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       PRODUCTIONNO,
                       PRODUCTIONDATE,
                       RAWQUANTITY1,
                       RAWQUANTITY2,
                       LOSSQUANTITY1,
                       LOSSQUANTITY2,
                       FINISHEDQUANTITY1,
                       FINISHEDQUANTITY2,
                       SUBSIDERYQUANTITY1,
                       SUBSIDERYQUANTITY2,
                       REMARK,
                       PRODUCTIONCENTRECODE,
                       SHIFTCODE,
                       HITNO,
                       SHIFTINCHARGECODE,
                       MELTORCODE,
                       LIFEOFLINING,
                       POWERON,
                       HEATTAPAT,
                       TAPTOTAPTIME,
                       PREVIOUSHEATTAPAT,
                       TODAYHEATNO,
                       MODULECODE,
                       MODULETNO,
                       QUANTITY1,
                       EQUIPMENTTNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       BOMTNO,
                       SHIFTTIMEFROM,
                       SHIFTTIMETO,
                       CONTRACTORCODE,
                       JOBORDERTNO,
                       CREATIONTIME,
                       BATCHNO,
                       MEASURINGUNITCODE1,
                       QUANTITY2,
                       MEASURINGUNITCODE2,
                       PRODUCTIONPROCESSCODE,
                       CREATOR,
                       NVL(getdocumentstatuscode('PRODUCTION',TNO),'STATUS') AS status
                  from PRODUCTION
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tab
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: PRODUCTION
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region production-raw-stock-detail (
        name: Production Raw Stock Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,A.TNO,
                       A.SNO,
                       A.SN,
                       A.STOCKTNO,
                       A.STORAGELOCATIONCODE,
                       A.QUANTITY1,
                       A.QUANTITY2
                  from productionrawstockdetail A
                  where A.Tno = :P197_TNO
                  AND A.Sno= :P197_SNO
