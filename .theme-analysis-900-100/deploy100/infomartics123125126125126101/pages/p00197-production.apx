    process input-detail-save-interactive-grid-data (
        name: Input Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @input-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into productionraw (                 
                                    TNO,
                                    SNO,
                                    SERIALNO,
                                    ITEMCODE,
                                    ITEMSPECIFICATIONCODE,
                                    DESCRIPTION,
                                    QUANTITY1,
                                    QUANTITY2,
                                    LOSSPERCENT,
                                    LOSSQUANTITY1,
                                    LOSSQUANTITY2,
                                    REMARK,
                                    STORAGELOCATIONCODE,
                                    FEEDTOKILN,
                                    CREATOR,
                                    DATEOFENTRY,
                                    TEMPERATURE,
                                    DRYWEIGHT
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :SERIALNO,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :DESCRIPTION,
                                :QUANTITY1,
                                :QUANTITY2,
                                :LOSSPERCENT,
                                :LOSSQUANTITY1,
                                :LOSSQUANTITY2,
                                :REMARK,
                                :STORAGELOCATIONCODE,
                                :FEEDTOKILN,
                                :CREATOR,
                                :DATEOFENTRY,
                                :TEMPERATURE,
                                :DRYWEIGHT
                
                            );
                        
                        when 'U' then
                            update productionraw Set
                                  TNO=:TNO,
                                    SNO=:SNO,
                                    SERIALNO=:SERIALNO,
                                    ITEMCODE=:ITEMCODE,
                                    ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                    DESCRIPTION=:DESCRIPTION,
                                    QUANTITY1=:QUANTITY1,
                                    QUANTITY2=:QUANTITY2,
                                    LOSSPERCENT=:LOSSPERCENT,
                                    LOSSQUANTITY1=:LOSSQUANTITY1,
                                    LOSSQUANTITY2=:LOSSQUANTITY2,
                                    REMARK=:REMARK,
                                    STORAGELOCATIONCODE=:STORAGELOCATIONCODE,
                                    FEEDTOKILN=:FEEDTOKILN,
                                    CREATOR=:CREATOR,
                                    DATEOFENTRY=:DATEOFENTRY,
                                    TEMPERATURE=:TEMPERATURE,
                                    DRYWEIGHT=:DRYWEIGHT
                            WHERE TNO = :P197_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From productionraw
                            Where TNo = :P197_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 4444532106148927
        }
    )

