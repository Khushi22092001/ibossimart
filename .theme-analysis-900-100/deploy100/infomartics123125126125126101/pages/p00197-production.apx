    pageItem P197_ITEMCODE (
        type: popupLov
        label {
            label: Item
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select itemname d, itemcode r from item a 
                where getdocumentstatuscode('ITEM',a.tno)='ACTIVE'
                AND ITEMCODE IN ( SELECT ITEMCODE  FROM BOMDETAIL WHERE TNO IN (
                                                                                 SELECT BOMCODE FROM JOBORDERDETAIL WHERE TNO = :P197_JOBORDERTNO
                                                                                 )
                                )
                UNION ALL
                select itemname d, itemcode r from item a 
                where getdocumentstatuscode('ITEM',a.tno)='ACTIVE'
                AND :P197_JOBORDERTNO IS NULL
                union all
                select itemname d, itemcode r from item a 
                where getdocumentstatuscode('ITEM',a.tno)='ACTIVE'
                AND ITEMCODE IN ( SELECT itemcode FROM JOBORDERDETAIL WHERE TNO = :P197_JOBORDERTNO
                                )
                
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P197_JOBORDERTNO
            itemsToSubmit: P197_JOBORDERTNO
            parentRequired: false
        }
        layout {
            sequence: 330
            region: @item-bom-detail
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @production
            column: ITEMCODE
            dataType: varchar2
        }
    )

    pageItem P197_ITEMSPECIFICATIONCODE (
        type: popupLov
        label {
            label: "Item Specification "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.itemspecificationname d, A.itemspecificationcode r 
                from itemSpecification a , Item b
                where a.tno = b.tno
                    AND B.ITEMCODE = :P197_ITEMCODE
                    AND A.itemspecificationcode IN (
                                                SELECT itemspecificationcode  FROM BOMDETAIL WHERE TNO IN (
                                                                                                        SELECT BOMCODE FROM JOBORDERDETAIL WHERE TNO = :P197_JOBORDERTNO
                                                                                                        )
                                                )
                UNION ALL
                select A.itemspecificationname d, A.itemspecificationcode r 
                from itemSpecification a , Item b
                where a.tno = b.tno
                AND B.ITEMCODE = :P197_ITEMCODE
                AND :P197_JOBORDERTNO IS NULL
                union all
                select A.itemspecificationname d, A.itemspecificationcode r 
                from itemSpecification a , Item b
                where a.tno = b.tno
                    AND B.ITEMCODE = :P197_ITEMCODE
                    AND A.itemspecificationcode IN (
                                                SELECT itemspecificationcode FROM JOBORDERDETAIL WHERE TNO = :P197_JOBORDERTNO
                                                )
                
                ```
            nullDisplayValue: -Select -
        }
        cascadingLov {
            parentItems: P197_ITEMCODE
            itemsToSubmit: [
                P197_ITEMCODE
                P197_JOBORDERTNO
            ]
            parentRequired: false
        }
        layout {
            sequence: 340
            region: @item-bom-detail
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @production
            column: ITEMSPECIFICATIONCODE
            dataType: varchar2
        }
    )

