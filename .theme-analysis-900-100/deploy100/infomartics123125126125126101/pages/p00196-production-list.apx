                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct a.DoctypeName as d, 
                                a.DoctypeCode as r
                    From Production b
                    JOIN Doctype a ON a.DoctypeCode = b.DoctypeCode
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @production
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
