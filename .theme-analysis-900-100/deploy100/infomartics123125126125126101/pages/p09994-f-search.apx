page 9994 (
    name: Module Search
    alias: F-SEARCH
    title: Module Search
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region search (
        name: Search
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P9994_NEW (
        type: selectList
        label {
            label: New
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @p9994-module
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 10
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P9994_PAGENO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @search
            slot: regionBody
        }
    )

    dynamicAction open-module (
        name: Open Module
        execution {
            sequence: 20
        }
        when {
            event: focusout
            selectionType: items
            items: P9994_NEW
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P9994_NEW
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P9994_PAGENO').getValue();
                    
                    
                    var url = "f?p=#APP_ID#:#PAGENO#:#SESSION#::NO:RP:";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#PAGENO#", x);
                    
                    
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

