page 0 (
    name: Global Page
    comments {
        comments:
            ```
            <img src="#APP_FILES#logo_new4.png" alt="Oracle"style=" width:30px;height:18px;"/>
            InfoMart Release 1.0
            ```
    }

    region global-search (
        name: Global Search
        type: search
        source {
            pageItemsToSubmit: P0_NEW
        }
        layout {
            sequence: 10
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/inline-drawer
            templateOptions: [
                #DEFAULT#
                js-dialog-class-t-Drawer--pullOutEnd
                js-dialog-class-t-Drawer--sm
            ]
        }
        advanced {
            htmlDomId: global_search
            customAttributes: style="overflow:hidden; display:none;"
        }
        settings {
            searchPageItem: P0_NEW
            minChars: 2
        }
        messages {
            noQueryEnteredMessage:
                ```html
                <p class="margin-md" id="gs-info" style="border-radius: 10px; border: 1px dashed var(--ut-palette-primary-text); padding: 10px; color: #555454;">
                    <span id="header" style="font-size: 14px; font-weight: bold;">Global Search Functionality<span><br><br>
                    <span id="first_text" style="font-size: 14px; font-weight: normal;" >The ERP search interface allows users to locate available modules and specific transactions efficiently. Please adhere to the following guidelines:</span><br><br>
                    <span id="second_text" style="font-size: 14px; font-weight: normal;"><span style="font-weight: bold;">Initialization:</span> Enter a minimum of two characters to initiate the search process.<br>
                    <span style="font-weight: bold;">Transaction-Specific Search: </span>To locate a specific transaction, use the prefix <span style="font-weight:bold; color:red;">"TNO: [Transaction Number]"</span>. This format optimizes the search across all modules for more accurate results. or user can directly enter the transaction no.</span>
                
                </p>
                ```
            noResultsFoundMessage:
                ```html
                <span class="u-textCenter"><h5>
                No data Found
                </h5></span>
                ```
        }

        searchSource module-search (
            name: Module Search
            searchConfig: @imart_module_search
            layout {
                sequence: 10
            }
        )

        searchSource transaction-search (
            name: Transaction Search
            searchConfig: @transaction_search
            layout {
                sequence: 20
            }
        )

    )

    region title (
        name: TITLE
        type: staticContent
        layout {
            sequence: 10
            slot: beforeNavigationBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        advanced {
            customAttributes: Style="font-size : 50px";
        }
    )

    pageItem P0_APPUSER (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @title
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: V('APP_USER')
        }
    )

    pageItem P0_COMPANYCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @title
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: v('GLOBAL_COMPANYCODE')
        }
    )

    pageItem P0_NEW (
        type: textField
        label {
            label: Search
            alignment: left
        }
        layout {
            sequence: 20
            region: @global-search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            icon: fa-search
            width: 30
            valuePlaceholder: -- Enter Module Name or Transaction No to Search--
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    pageItem P0_PARTYCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @title
            slot: regionBody
        }
    )

    pageItem P0_SEARCH (
        type: hidden
        layout {
            sequence: 10
            region: @global-search
            slot: regionBody
        }
    )

    pageItem P0_TITLE (
        type: displayOnly
        label {
            label: :APP_PAGE_NAME
            alignment: left
        }
        settings {
            format: html
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @title
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--boldDisplay
            ]
        }
        advanced {
            customAttributes: Style="font-size : 18px"; "text-align: center
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select page_title from apex_application_pages 
                where application_id=:APP_ID 
                and page_id=:APP_PAGE_ID;
                ```
        }
        sessionState {
            storage: request
        }
    )

    dynamicAction close-the-global-search-region-on-click (
        name: Close the global_search Region on click
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click', '.ui-widget-overlay', function() {
                        apex.theme.closeRegion('global_search');
                         $s('P0_NEW', ''); 
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction custom-da-for-open-dialog-and-set-focus (
        name: Custom DA for Open Dialog and set Focus
        execution {
            sequence: 70
        }
        when {
            event: custom
            customEvent: dialogopen
            selectionType: jQuerySelector
            jquerySelector: #global_search
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#P0_NEW').focus();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction menu-tooltip (
        name: menu tooltip
        execution {
            sequence: 30
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#t_TreeNav").treeView("option", "tooltip", {
                        content: function(cb, node) {
                            return node.label;
                        }
                    } );
                    $("#t_TreeNav").tooltip("option", "items", ".a-TreeView-content");
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction menu-tooltip-2 (
        name: menu tooltip_1
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    try {
                    
                      //Tooltip for Menu Text
                      $("#t_TreeNav").treeView("option", "tooltip", {
                        content: function (cb, node) {
                          var ttText;
                    
                          // Only display the tooltip if the menu is collapsed ...
                          if ($(".js-navCollapsed ").length > 0) {
                            ttText = node.label;
                          }
                          else {
                            ttText = "";
                          }
                          return ttText;
                        },
                        position: {
                          my: "left+5 center", at: "right center"
                        }
                      });
                    
                      //This tells the tooltip to show up for the whole node content including the icon.
                      $("#t_TreeNav").tooltip("option", "items", ".a-TreeView-content");
                    }
                    catch (err) {
                      // Do nothing ...
                    
                    }
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction notification (
        name: Notification
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-apex-notification (
            action: plugin/apexNotificationMenu
            settings {
                sqlSource:
                    ```sql
                    Select 'fa-wrench' As NOTE_ICON,
                           '#10779f' As NOTE_ICON_COLOR,
                           b.modulename As NOTE_HEADER,
                           A.MENULABEL || '-' || TO_CHAR(A.QUEUEDATE, 'DD-MM-RRRR HH24:MI') ||' Remark : '||
                           (Select aa.remark
                              From passfail aa
                             Where aa.tokenno < a.tokenno
                               And aa.moduletno = a.ModuleTNo
                               And Rownum = 1) As NOTE_TEXT,
                              null as NOTE_LINK,
                              --'f?p=' || :APP_ID || ':' ||to_char(b.entrypageno) || ':' ||:APP_SESSION || '::NO::' || 'P' ||to_char(b.entrypageno) ||'_TNO,P' ||to_char(b.entrypageno) ||'_CALLEDFROMPAGE,P'||to_char(b.entrypageno)||'_FORMSTATUS' || ':' ||A.MODULETNO || ',' || :APP_PAGE_ID||','||'CALLED'||':NO' As NOTE_LINK, 
                           
                           '#10779f' As NOTE_COLOR,
                           --NULL AS NOTE_ACCEPT,
                           --Order By aa.moduletno, aa.tokenno Desc) As NOTE_ACCEPT,
                           --'javascript:alert("Declined");void(0);' As NOTE_DECLINE,
                           Null As NOTE_ACCEPT,
                           Null As NOTE_DECLINE,
                           0    As NO_BROWSER_NOTIFICATION
                      From ONTHETABLE_APEX a, Module b
                     Where a.modulecode = b.modulecode
                    --order by a.QUEUEDATE desc
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction sidemenuexpandcollapse (
        name: sideMenuExpandCollapse
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#t_Body_nav").show();
                    //$("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

