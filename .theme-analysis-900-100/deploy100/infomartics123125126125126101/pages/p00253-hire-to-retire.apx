page 253 (
    name: Hire to Retire
    alias: HIRE-TO-RETIRE
    title: Hire to Retire
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#iBOSS Custom Templates Classes#MIN#.css
        inline:
            ```css
            #NO1 .t-Region-headerIcon .t-Icon {
                color: white;
                background-color: var(--u-color-25);
                border-radius: 10px;
            }
            
            #NO2 .t-Region-headerIcon .t-Icon {
                color: white;
                background-color: var(--u-color-26);
                border-radius: 10px;
            }
            
            #NO3 .t-Region-headerIcon .t-Icon {
                color: white;
                background-color: var(--u-color-27);
                border-radius: 10px;
            }
            
            #NO4 .t-Region-headerIcon .t-Icon {
                color: white;
                background-color: var(--u-color-28);
                border-radius: 10px;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region attendance-card (
        name: ATTENDANCE CARD
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    1                           as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('ATTENDENCE', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:631:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:&P253_CURRENT_PAGE.:&APP_SESSION.')
                    END                         as LINK,
                    'Attendance'                as LIST_TITLE,
                    'fa fa-calendar-plus-o'     as ICON_CLASS,
                    'u-color-1'                 as ICON_COLOR_CLASS,
                    'Recording of Employee Attendance' as HELP_TEXT
                From Dual
                
                Union All
                
                Select
                    2                       as SEQ,
                    CASE WHEN CHECK_MODULE_VIEW_ACCESS('EMPLOYEESALARY', :APP_USER, :GLOBAL_COMPANYCODE) = 1 THEN
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:621:&APP_SESSION.')
                    ELSE
                        APEX_UTIL.PREPARE_URL('f?p=&APP_ID.:&P253_CURRENT_PAGE.:&APP_SESSION.')
                    END                     as LINK,
                    'Employee Gatepass'     as LIST_TITLE,
                    'fa fa-sign-out'        as ICON_CLASS,
                    'u-color-2'             as ICON_COLOR_CLASS,
                    'Employee Early going Management   ' as HELP_TEXT
                From Dual
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @attendance-management
            slot: subRegions
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleC
            ]
        }
        comments {
            comments:
                ```
                ICON NAMES
                ----------
                
                'Attendance'            -->     'fa fa-calendar-plus-o'
                'Employee Gatepass'     -->     'fa fa-sign-out'
                ```
        }
        componentAppearance {
            template: @iboss-media-list-for-process-flow
            templateOptions: [
                #DEFAULT#
                t-MediaList--stack
            ]
        }

        column HELP_TEXT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Help Text
            }
            layout {
                sequence: 60
            }
        )

        column ICON_CLASS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Icon Class
            }
            layout {
                sequence: 40
            }
        )

        column ICON_COLOR_CLASS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Icon Color Class
            }
            layout {
                sequence: 50
            }
        )

        column LINK (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Link
            }
            layout {
                sequence: 20
            }
        )

        column LIST_TITLE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List Title
            }
            layout {
                sequence: 30
            }
        )

        column SEQ (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Seq
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

    )

    region attendance-management (
        name: "Attendance Management "
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @hire-to-retire
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @iboss-standard-sub-region-with-icon-above
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--scrollBody
            ]
            icon: fa-calendar-o fa-3x
        }
        advanced {
            htmlDomId: NO2
        }
    )

    region employee-exit-card (
        name: Employee Exit CARD
        type: classicReport
