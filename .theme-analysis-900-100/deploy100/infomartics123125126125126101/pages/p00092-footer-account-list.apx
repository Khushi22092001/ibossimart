        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Footer Account List
        }

        savedReport 1457068 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTCODE (
                sequence: 3
            )

            displayColumn ACCOUNTCODESECOND (
                sequence: 13
            )

            displayColumn ACCOUNTCODETHIRD (
                sequence: 17
            )

            displayColumn AMOUNTPERCENT (
                sequence: 12
            )

            displayColumn COMPANYCODE (
                sequence: 6
            )

            displayColumn CREATIONTIME (
                sequence: 22
            )

            displayColumn CREATOR (
                sequence: 21
            )

            displayColumn DESPATCHCATEGORYCODE (
                sequence: 15
            )

            displayColumn DOCTYPECODE (
                sequence: 9
            )

            displayColumn FOOTERACCOUNTCODE (
                sequence: 5
            )

            displayColumn FOOTERHEADCODE (
                sequence: 2
            )

            displayColumn FOOTERNATURECODE (
                sequence: 11
