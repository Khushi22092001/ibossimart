page 92 (
    name: Footer Account List
    alias: FOOTER-ACCOUNT-LIST
    title: Footer Account List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region footer-account-list (
        name: Footer Account List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.MODULECODE,
                       A.FOOTERHEADCODE,
                       A.ACCOUNTCODE,
                       A.REMARK,
                       A.FOOTERACCOUNTCODE,
                       A.COMPANYCODE,
                       A.PARTYCODE,
                       A.ITEMCODE,
                       A.DOCTYPECODE,
                       A.LOCATIONCODE,
                       A.FOOTERNATURECODE,
                       A.AMOUNTPERCENT,
                       A.ACCOUNTCODESECOND,
                       A.FOOTERPERCENT,
                       A.DESPATCHCATEGORYCODE,
                       A.OTHERCODE,
                       A.ACCOUNTCODETHIRD,
                       A.TDSMASTERCODE,
                       A.NATUREOFSUPPLYCODE,
                       A.TRANSACTIONTYPECODE,
                       A.CREATOR,
                       to_char(A.CREATIONTIME,'DD-MM-YYYY HH24:MI:SS') CREATIONTIME
                  from FOOTERACCOUNT A
                 -- where a.companycode =:Global_companycode
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 93
                items: {
                    P93_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 145687049412322861
        }

        column ACCOUNTCODE (
            type: plainText
            heading {
                heading: Account Code
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ACCOUNTCODESECOND (
            type: plainText
            heading {
                heading: Account Code Second
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column ACCOUNTCODETHIRD (
            type: plainText
            heading {
                heading: Account Code Third
            }
            layout {
                sequence: 18
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column AMOUNTPERCENT (
            type: plainText
            heading {
                heading: Amount Percent
                alignment: end
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Company Code
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column CREATIONTIME (
