page 1 (
    name: Home
    alias: HOME
    title: InfoMart
    appearance {
        pageTemplate: @iboss-standard-page
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
             .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important;
              
            } 
            
            body {
              position: relative;
              background-color: #fff;
            }
            
            body::before {
              content: "";
              position: fixed;
            
              top: 0;
              left: 0;
              width: 100%;
              height: 100%;
              
            
            //  background-image: url('#APP_FILES#IRON-MART.jpg');
            background-image: url('#APP_FILES#watermark_page-0001.jpg');
              
              background-repeat: no-repeat;
              background-position: center;
              background-size: 500px 620px;
            
              opacity: 0.10;        /* 🔥 watermark strength */
              z-index: -1;          /* stays behind content */
              pointer-events: none; /* clicks pass through */
            }
            
            /*body{
              background-image: url('#APP_FILES#IRON-MART.jpg');
              //background-image: url('#APP_FILES#rama Group Logo no. 3.png');  
              background-position: center;
              background-size:cover;
                background-repeat: no-repeat; 
            
             background-size: 1380px 620px;
             background-blend-mode: lighten;  
              
            }
            */
            
            ```
    }
    security {
        formAutoComplete: false
        browserCache: false
    }

    region iron-mart (
        name: Iron Mart
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
    )

    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    1 AS serialno,
                    --
                        'BU:' || a.bossusercode
                    || '.C:' || b.companycode
                      AS myboxkey,
                    --
                       'HOME' AS myboxlabel,
                    'ROOT' AS parentkey,
                    'BOX' AS myboxtype,
                        '!@#$%' AS modulecode,
                    'fa-home' AS iconname,
                    0 AS tno,
                        NULL AS pageno,
                    a.bossusercode,
                    a.loginname,
                    b.companycode,
                    v('GLOBAL_COMPANYCODE') as c2,
                    V('APP_USER') as appuser,
                    null as VIEWPRIVILEGE
                  FROM bossuser a, company b
                  where 1=1
                    and b.CompanyCode = v('GLOBAL_COMPANYCODE')
                    and Upper(a.BossUserName) = Upper(V('APP_USER'))
                    and exists(
                      select
                        aa.TNo
                      from ModulePrivilege aa
                      where aa.ModuleCode = 'ACTION'
                        and aa.ViewPrivilege = 'YES'
                        and aa.CompanyCode = b.CompanyCode
                        and aa.BossUserCode = a.BossUserCode
                    )
                    UNION ALL
                  SELECT
                    NVL (c.serialno, 0) AS serialno,
                    --------------- --
                    -- Key
                          'BU:' || a.bossusercode
                          || '.C:' || b.companycode
                          || '.MG:' || c.modulegroupcode AS myboxkey,
                    --------------- --
                    -- Label
                    c.moduleGroupname AS myboxlabel,
                    --------------- --
                    -- ParentKey
                        'BU:' || a.bossusercode
                    || '.C:' || b.companycode
                      AS parentkey,
                        --
                    --------------- --
                    'MODULEGROUP' AS myboxtype,
                    'MG:' || c.modulegroupcode AS modulecode,
                        NVL (c.iconname, 'MODULENODE') AS iconname,
                    0 AS tno,
                        --  Changed By Sanjay 27-May-2022   'f?p=' || chr(38) || 'APP_ID.:'||c.PageNo ||':' || chr(38) || 'APP_SESSION.' as pageno,
                        c.PageNo AS pageno,
                    a.bossusercode,
                    a.loginname,
                    b.companycode,
                    v('GLOBAL_COMPANYCODE') as c2,
                    V('APP_USER') as appuser,
                    null as VIEWPRIVILEGE
                  FROM bossuser a, company b, moduleGroup c
                  WHERE b.CompanyCode = v('GLOBAL_COMPANYCODE')
                    And Upper(a.BossUserName) = Upper(V('APP_USER'))
                    and  exists(
                      select
                        aa.ModuleCode
                      from Module aa
                      where aa.ModuleGroupCode = c.ModuleGroupCode
                        and aa.EntryPageNo is not null
                    )
                    and exists(
                      select
                        aa.TNo
                      from ModulePrivilege aa, Module bb
                      where aa.ModuleCode = bb.ModuleCode
                        and bb.ModuleGroupCode =  c.ModuleGroupCode
                        and aa.ViewPrivilege = 'YES'
                        and aa.CompanyCode = b.CompanyCode
                        and aa.BossUserCode = a.BossUserCode
                        and aa.ModuleCode != 'ACTION'
                    )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
