            }
        )

        column NATUREJOBTYPECODE (
            type: hidden
            heading {
                heading: Nature Job Type Code
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column OLDCOSTCENTRECODE (
            type: hidden
            heading {
                heading: Old Cost Centre Code
            }
            layout {
                sequence: 18
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
