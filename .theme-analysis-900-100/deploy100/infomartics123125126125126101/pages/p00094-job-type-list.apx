                heading: Is Freight Contract Charge Head
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ISPRODUCT (
            type: hidden
            heading {
                heading: Is Product
