page 625 (
    name: EMPLOYEE DEDUCTION EARNING
    alias: EMPLOYEE-DEDUCTION-EARNING
    title: EMPLOYEE DEDUCTION EARNING
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employee-deduction-earning (
        name: EMPLOYEE DEDUCTION EARNING
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.COMPANYCODE,
                       getcompanyname(a.companycode) company,
                       a.FINANCIALYEARCODE,
                       getlocationname(a.LOCATIONCODE) locationname,
                       getdoctypename(a.DOCTYPECODE) doctypename,
                       a.EMPLOYEEDEDUCTIONEARNINGNO,
                       a.EMPLOYEEDEDUCTIONEARNINGDATE,
                       getemployeename(a.EMPLOYEECODE) employeename,
                       a.SUMOFAMOUNT,
                       a.SALARYFROMDATE,
                       a.SALARYTODATE,
                       a.REMARK,
                       a.CREATOR,
                       a.DEDUCTIONEARNINGTYPECODE,
                       a.STAFFTYPECODE,
                       a.MODULECODE,
                       to_char(a.CREATIONTIME,'DD-MM-YYYY HH24:MI') CreationTime,
                       a.MODULETNO,
                       b.deductionearningtypename
                  from EMPLOYEEDEDUCTIONEARNING a, deductionearningtype b
                  where a.deductionearningtypecode = b.deductionearningtypecode(+)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 626
                items: {
                    P626_TNO: #TNO#
                }
                clearCache: 626
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 16614995509647237
        }

        column COMPANY (
            type: plainText
            heading {
