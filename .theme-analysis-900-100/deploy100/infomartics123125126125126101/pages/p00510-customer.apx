page 510 (
    name: Customer
    alias: CUSTOMER
    title: Customer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            /*    
                function codeAddress()
                {
                document.getElementById("X").style.color="red";}
                /*var tb = document.getElementById("C5361576669511002");
                var tds = tb.getElementsByTagName("tr");
                    tds[0].style.color="red";
                }
                window.onload = codeAddress;
            */
            ```
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region customer-360-view-report (
        name: Customer 360 View Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DISTINCT a.COMPANYCODE,
                       a.COMPANYNAME,
                       a.LOCATIONCODE,
                       a.LOCATIONNAME,
                       a.CUSTOMERCODE,
                       a.CUSTOMERNAME,
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':511:'||:APP_SESSION||'::'||':511:P511_CUSTOMERCODE:'|| a.CUSTOMERCODE,NULL,'SESSION' )||'">'||a.CUSTOMERNAME||'</a>' as CustomerLink,    
                       a.YEAROFASSOCIATION,
                       a.LASTORDERDATE,
                       a.LASTBILLEDDATE,
                       a.CREDITLIMIT,
                       a.LEDGERBALANCE,
                       a.OVERDUEAMOUNT,
                       a.TOTALSALESAMOUNT,
                       a.GROSSPROFITPERCENTAGE,
                       a.RANKINGBYSALES,
                       a.AVERAGEORDERVALUE,
                       a.QUOTETOORDERPERCENT,
                       a.PENDINGORDERS,
                       a.INACTIVEINVOICE,
                       a.REGIONCODE,
                       a.REGIONNAME,
                       a.CITYCODE,
                       a.CITYNAME,
                       a.STATECODE,
                       a.STATENAME,
                       a.COUNTRYCODE,
                       a.COUNTRYNAME,
                       a.LASTRUNDATE
                  from D_CUSTOMER_360VIEW a
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            reportsSelectList: false
            rowsPerPageSelector: true
        }
        actionsMenu {
            filter: false
            rowsPerPage: false
            compute: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            formats: excel
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 100
        }
        advanced {
            savedReportMappingIdentifier: 8993355078479300
        }

        column AVERAGEORDERVALUE (
            type: plainText
            heading {
                heading: Average Order Value
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
            appearance {
                formatMask: 99,99,99,99,99,999.90
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:110px">#AVERAGEORDERVALUE#</div>
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

