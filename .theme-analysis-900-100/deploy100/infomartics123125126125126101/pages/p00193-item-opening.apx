    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 140
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P193_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            execution {
                sequence: 70
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from loadingadvice aa where aa.purchaseordertno = :P193_TNO;
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                       and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
        execution {
            sequence: 170
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.PRINTPRIVILEGE= 'NO'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
