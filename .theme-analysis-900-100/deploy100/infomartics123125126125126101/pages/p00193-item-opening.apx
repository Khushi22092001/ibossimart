        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT A.ITEMSPECIFICATIONNAME D, A.ITEMSPECIFICATIONCODE R
                FROM ITEMSPECIFICATION A, ITEM B
                WHERE A.TNO = B.TNO
                AND B.ITEMCODE = :P193_ITEMCODE
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P193_ITEMCODE
            itemsToSubmit: P193_ITEMCODE
        }
        layout {
            sequence: 210
            region: @itemopening
            slot: regionBody
            alignment: left
            startNewRow: false
