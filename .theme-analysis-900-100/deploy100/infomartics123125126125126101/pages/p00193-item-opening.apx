            sequence: 130
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: item=value
            item: P193_FORMSTATUS
            value: NEWRECORD
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 110
            region: @buttons
