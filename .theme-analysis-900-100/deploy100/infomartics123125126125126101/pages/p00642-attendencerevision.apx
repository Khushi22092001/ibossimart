page 642 (
    name: ATTENDENCEREVISION
    alias: ATTENDENCEREVISION
    title: Attendence Revision List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region attendencerevision (
        name: AttendenceRevision
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       getlocationname(LOCATIONCODE) locationname,
                       getdoctypename(DOCTYPECODE) doctype,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       ATTENDENCEREVISIONNO,
                       ATTENDENCEREVISIONDATE,
                       getemployeename(EMPLOYEECODE) employeename,
                       REMARK,
                       REVISIONFORFROMDATE,
                       REVISIONFORTODATE,
                       SALARYFROMDATE,
                       SALARYTODATE,
                       CREATOR,
                       CREATIONTIME
                  from ATTENDENCEREVISION
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 643
                items: {
                    P643_TNO: #TNO#
                }
                clearCache: 643
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 64684192776712414
        }

        column ATTENDENCEREVISIONDATE (
            type: plainText
            heading {
                heading: Attendence Revision Date
            }
            layout {
                sequence: 25
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AI
            }
        )

        column ATTENDENCEREVISIONNO (
            type: plainText
            heading {
                heading: Attendence Revision No.
            }
            layout {
                sequence: 15
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AH
            }
        )

        column COMPANYCODE (
            type: hidden
            heading {
                heading: Companycode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATIONTIME (
