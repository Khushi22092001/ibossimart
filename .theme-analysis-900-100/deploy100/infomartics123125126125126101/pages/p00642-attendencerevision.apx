            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: AttendenceRevision
        }

        savedReport 191094 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATTENDENCEREVISIONDATE (
                sequence: 5
            )

            displayColumn ATTENDENCEREVISIONNO (
                sequence: 4
            )

            displayColumn DOCTYPE (
                sequence: 1
