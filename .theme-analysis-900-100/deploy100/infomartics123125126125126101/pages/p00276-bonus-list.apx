page 276 (
    name: Bonus List
    alias: BONUS-LIST
    title: Bonus List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bonus-list (
        name: Bonus List
        type: interactiveReport
        source {
            location: localDatabase
            tableName: BONUS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 277
                items: {
                    P277_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 8774642112409580
        }

        column BONUSAMOUNT (
            type: plainText
            heading {
                heading: Bonusamount
                alignment: end
            }
            layout {
                sequence: 17
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        column BONUSDATE (
            type: plainText
            heading {
                heading: Bonusdate
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column BONUSNO (
            type: plainText
            heading {
                heading: Bonusno
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column CATEGORYCODE (
            type: plainText
            heading {
                heading: Categorycode
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creationtime
            }
            layout {
                sequence: 13
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: M
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column CREDITACCOUNTCODE (
            type: plainText
            heading {
                heading: Creditaccountcode
            }
            layout {
                sequence: 16
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column DEBITACCOUNTCODE (
            type: plainText
            heading {
                heading: Debitaccountcode
            }
            layout {
                sequence: 15
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column DOCTYPECODE (
            type: plainText
            heading {
                heading: Doctypecode
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column FINANCIALYEARCODE (
            type: plainText
            heading {
                heading: Financialyearcode
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FROMDATE (
            type: plainText
            heading {
                heading: Fromdate
            }
            layout {
                sequence: 8
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: Locationcode
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column STAFFTYPECODE (
            type: plainText
            heading {
                heading: Stafftypecode
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column TODATE (
            type: plainText
            heading {
                heading: Todate
            }
            layout {
                sequence: 9
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Bonus List
        }

        savedReport 87828 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BONUSAMOUNT (
                sequence: 17
            )

            displayColumn BONUSDATE (
                sequence: 7
            )

            displayColumn BONUSNO (
                sequence: 6
            )

            displayColumn CATEGORYCODE (
                sequence: 11
            )

            displayColumn COMPANYCODE (
                sequence: 2
            )

            displayColumn CREATIONTIME (
                sequence: 13
            )

            displayColumn CREATOR (
                sequence: 14
            )

            displayColumn CREDITACCOUNTCODE (
                sequence: 16
            )

            displayColumn DEBITACCOUNTCODE (
                sequence: 15
            )

            displayColumn DOCTYPECODE (
                sequence: 5
            )

            displayColumn FINANCIALYEARCODE (
                sequence: 3
            )

            displayColumn FROMDATE (
                sequence: 8
            )

            displayColumn LOCATIONCODE (
                sequence: 4
            )

            displayColumn REMARK (
                sequence: 12
            )

            displayColumn STAFFTYPECODE (
                sequence: 10
            )

            displayColumn TNO (
                sequence: 1
            )

            displayColumn TODATE (
                sequence: 9
            )

        )

    )

    pageItem P276_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @/title
            slot: regionBody
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 30
            region: @bonus-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 277
                clearCache: 277
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 20
            region: @bonus-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button pdf (
        buttonName: PDF
        label: PDF
        layout {
            sequence: 10
            region: @bonus-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

)

