page 635 (
    name: LEAVEREQUEST
    alias: LEAVEREQUEST2
    title: LEAVEREQUEST
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region leave-detail (
        name: Leave Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT X.MONTH,X.LEAVEFROMDATE,X.LEAVETODATE,X.LEAVECODE,X.LEAVEDAYS
                FROM
                (
                SELECT 
                        CASE 
                            WHEN to_char(B.LEAVEFROMDATE, 'Mon-YYYY') = to_char(B.LEAVETODATE, 'Mon-YYYY')  THEN
                                to_char(B.LEAVEFROMDATE, 'Mon-YYYY')
                            END AS MONTH,
                            B.LEAVEFROMDATE,B.LEAVETODATE,B.LEAVECODE,B.LEAVEDAYS
                FROM LEAVEREQUEST A,LEAVEREQUESTDETAIL B
                WHERE A.TNO=B.TNO
                AND A.LOCATIONCODE  =   :P635_LOCATIONCODE
                AND A.DOCTYPECODE   =   :P635_DOCTYPECODE
                AND A.DEPARTMENTCODE = :P635_DEPARTMENTCODE
                AND A.STAFFTYPECODE =  :P635_STAFFTYPECODE
                AND A.EMPLOYEECODE = :P635_EMPLOYEECODE
                AND B.LEAVECODE     = :P635_LEAVECODE
                ) X
                WHERE UPPER(X.MONTH)=UPPER(:P635_MONTH)
                ```
            pageItemsToSubmit: P635_LOCATIONCODE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 19992467151439541
        }

        column LEAVECODE (
            type: plainText
            heading {
                heading: Leave
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column LEAVEDAYS (
            type: plainText
            heading {
                heading: Leave Days
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column LEAVEFROMDATE (
            type: plainText
            heading {
                heading: Leave From Date
            }
            layout {
                sequence: 2
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column LEAVETODATE (
            type: plainText
            heading {
                heading: Leave To Date
            }
            layout {
                sequence: 3
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column MONTH (
            type: plainText
            heading {
                heading: Month
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Leave Detail
        }

        savedReport 199953 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn LEAVECODE (
                sequence: 4
            )

            displayColumn LEAVEDAYS (
                sequence: 5
            )

            displayColumn LEAVEFROMDATE (
                sequence: 2
            )

            displayColumn LEAVETODATE (
                sequence: 3
            )

            displayColumn MONTH (
                sequence: 1
            )

        )

    )

    pageItem P635_DEPARTMENTCODE (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P635_DOCTYPECODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P635_EMPLOYEECODE (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P635_LEAVECODE (
        type: hidden
        layout {
            sequence: 80
            slot: contentBody
        }
    )

    pageItem P635_LOCATIONCODE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P635_MONTH (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P635_STAFFTYPECODE (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @leave-detail
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 634
                clearCache: 634
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @leave-detail
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

