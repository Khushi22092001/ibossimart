    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from LOANSANCTIONDETAIL a
                        where not exists (
                            select 1 from LOANSANCTION  aa  
                            where aa.tno = a.tno
                        );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

