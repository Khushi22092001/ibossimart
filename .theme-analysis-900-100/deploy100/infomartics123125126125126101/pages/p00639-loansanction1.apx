    process loansanctiondetail-save-interactive-grid-data (
        name: LOANSANCTIONDETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @loansanctiondetail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                           IF :SNO IS NULL then
                                select globaltno.nextval into :SNO from dual;
                           end if;
                            Insert Into LOANSANCTIONDETAIL ( 
                                        TNO,              
                                        SNO,
                                        SERIALNO, 
                                        VOUCHERTNO, 
                                        BALANCEAMOUNT,
                                        MERGEDAMOUNT,
                                        REMARK
                            )
                            Values (
                                        :TNO,              
                                        :SNO,
                                        :SERIALNO, 
                                        :VOUCHERTNO, 
                                        :BALANCEAMOUNT,
                                        :MERGEDAMOUNT,
                                        :REMARK
                             );
                  
                        when 'U' then
                            update LOANSANCTIONDETAIL Set
                                        TNO = :TNO,              
                                        SNO = :SNO,
                                        SERIALNO = :SERIALNO, 
                                        VOUCHERTNO = :VOUCHERTNO, 
                                        BALANCEAMOUNT = :BALANCEAMOUNT,
                                        MERGEDAMOUNT = :MERGEDAMOUNT,
                                        REMARK = :REMARK
                            WHERE TNO = :P639_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From LOANSANCTIONDETAIL
                            Where TNo = :P639_TNO
                              and SNO = :SNO
                              ;
                    
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 21027527021340939
        }
    )

