            region: @filter
            slot: regionBody
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 80
            region: @filter
            slot: regionBody
            column: 12
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

