app INFOMARTICS123125126125126101 (
    name: "Imart- Development "
    version: InfoMart Release 1.0 Developed By Infomatics
    logo {
        type: text
        text: &GLOBAL_TITLE.
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @ironmart
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        usersCanChooseThemeStyle: true
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DD-MM-RRRR
        dateTime: DD-MM-YYYY HH:MIPM
        timestamp: DD-MM-YYYY HH:MIPM
        timestampTimeZone: DD-MM-YYYY HH.MI.SSXFF PM TZR
    }
    javaScript {
        fileUrls: "#APP_FILES#hspl-theme.js?version=#APP_VERSION#&cb=20260829a"
    }
    css {
        fileUrls: [
            "#APP_FILES#app-icon.css?version=#APP_VERSION#"
            "#APP_FILES#rupee.css?version=#APP_VERSION#"
            "#APP_FILES#globalSeach_styles.css"
            "#APP_FILES#hspl-theme.css?version=#APP_VERSION#&cb=20260829a"
            "#APP_FILES#design-system.css?version=#APP_VERSION#&cb=20260829a"
        ]
    }
    authentication {
        scheme: @validatebossuser
        publicUser: APEX_PUBLIC_USER
    }
    authorization {
        runOnPublicPages: true
    }
    security {
        runtimeApiUsage: modifyThisApp
    }
    sessionStateProtection {
        enabled: false
        checksumSalt: A355789D2CD73C2D5191057FB8A5B741E0CE735E41D13B234BF9A9D2AD858836
    }
    sessionManagement {
        sessionStateCommits: immediate
    }
    globalization {
        documentDirection: leftToRight
    }
    progressiveWebApp {
        installable: true
    }
    reportPrinting {
        type: useInstanceSettings
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 21.2
        accessibleReadOnlyItems: false
    }
    advanced {
        modernizeApp: true
    }

    substitution APP_NAME (
        value {
            staticValue: Imart
        }
    )

)
