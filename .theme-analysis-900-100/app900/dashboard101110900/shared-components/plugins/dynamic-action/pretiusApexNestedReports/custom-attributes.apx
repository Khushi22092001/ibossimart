)

customAttribute attribute_12 (
    apexlangName: loadingIndicatorStyle
    attribute: 12
    name: Loading indicator style
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 15
    }
    default {
        value: ATR
    }
    dependingOn {
        attribute: @attribute_02/component
        conditionType: inList
        list: LI
    }
    help {
        helpText: This attributes allows you to choose prefered style of loading indicator while fetching data.
    }

    entry alignedToCell (
        sequence: 20
        display: Aligned to cell
        return: ATC
        help {
            helpText: Loading indicator is aligned to parent cell of triggering element.
        }
        advanced {
            quickPick: true
        }
    )

    entry alignedToReport (
        sequence: 10
        display: Aligned to report
        return: ATR
        help {
            helpText: Loading indicator is aligned to center of affected elements.
        }
        advanced {
            quickPick: true
        }
    )

    entry cellIconSpinner (
        sequence: 30
        display: Cell icon spinner
        return: CIS
        help {
            helpText: Loading indicator is embeded within cell after triggering element.
        }
    )

    entry replaceCellContent (
        sequence: 40
        display: Replace cell content
        return: RCC
        help {
            helpText: Loading indicator replaces cell content. After AJAX finishes fetching data, cell content is restored to initial content.
        }
    )

)

customAttribute attribute_13 (
    apexlangName: defaultTemplateHtml
    attribute: 13
    name: Default template HTML
    type: textarea
    validation {
        maxLength: 4000
    }
    appearance {
        sequence: 12
    }
    default {
        value: #DEFAULT_TEMPLATE#
    }
    dependingOn {
        attribute: @attribute_14/component
        conditionType: inList
        list: EDT
    }
    help {
        helpText:
            ```
            <p>
            Any HTML applied before or after <code>#DEFAULT_TEMPLATE#</code> will be included in <code>default template</code>.
            </p>
            <p>
            Manual events are supported witin default template (check examples). Manual events are bound to elements with specific class.
            </p>
            ```
    }
    examples {
        examples:
            ```
            <strong>Expand all</strong>
            <p>
              Force all child nested reports to expand on anchor click (where triggering element has class <code>showPersonal</code>)
            </p>
            <pre><code><a href="javascript: void(0)" class="nestedreport--expandAll" selector=".showPersonal">Expand all</a></code></pre>
            <br/>
            
            <strong>Refresh</strong>
            <p>
              Force current nested report to refresh itself (template and data).
            </p>
            <pre><code><a href="javascript: void(0)" title="Collapse all expanded" class="nestedreport--refresh">Refresh</a></code></pre>
            
            <br/>
            
            <strong>Collapse all expanded</strong>
            <p>
              Force child expanded nested reports to collapse on anchor click. Adding attribute <code>duration</code> to anchor will force plugin to override animation duration with given number of miliseconds.
            </p>
            <pre><code><a href="javascript: void(0)" title="Collapse all expanded" class="nestedreport--slideupAll" duration="200">Collapse all</a></code></pre>
            
            <br/>
            
            <strong>Collapse</strong>
            <p>
              Force current nested report to collapse. Adding attribute <code>duration</code> to anchor will force plugin to override animation duration with given number of miliseconds.
            </p>
            <pre><code><a href="javascript: void(0)" title="Collapse all expanded" class="nestedreport--slideupAll" duration="200">Collapse all</a></code></pre>
            ```
    }
)

customAttribute attribute_14 (
    apexlangName: defaultTemplateOptions
    attribute: 14
    name: Default template options
    type: checkboxes
    appearance {
        sequence: 10
    }
    dependingOn {
        attribute: @attribute_03/component
        conditionType: inList
        list: [
            DTDC
            DTCC
        ]
    }
    help {
        helpText: This attribute allows you to add extra funcionalities to nested report rendered in HTML data.
    }

    entry extendDefaultTemplate (
        sequence: 40
        display: Extend default template
        return: EDT
        help {
            helpText: If this option is checked, default template can be extended with additional HTML before and after nested report. See <strong>Default template HTML</strong> attribute for more informations.
        }
    )

    entry sortingData (
        sequence: 30
        display: Sorting data
        return: SD
        help {
            helpText: If this option is checked, nested report supports sorting via column headings. Data is sorted using JavaScript function. Sort function supports NUMBER and VARCHAR2 column type.
        }
    )

    entry strechReport (
        sequence: 20
        display: Strech report
        return: SR
        help {
            helpText: If this options is checked, nested report table is streched to 100% width of parent row.
        }
    )

)

