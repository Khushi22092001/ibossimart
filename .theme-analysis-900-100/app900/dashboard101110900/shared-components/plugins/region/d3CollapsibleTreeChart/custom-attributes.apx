customAttribute attribute_01 (
    apexlangName: minimumAspectRatio
    attribute: 1
    name: Minimum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 510
    }
    default {
        value: 1.333
    }
    help {
        helpText:
            ```
            <p>Enter the minimum aspect ratio that charts use to recommend a height. A minimum aspect ratio of 1.333 means that the chart's width should be no less than 1.333 times its height. </p>
            <p>Note: This setting can be overridden by the 'Minimum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: maximumAspectRatio
    attribute: 2
    name: Maximum Aspect Ratio
    scope: app
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 520
    }
    default {
        value: 3
    }
    help {
        helpText:
            ```
            <p>Enter the maximum aspect ratio that charts use to recommend a height. A maximum aspect ratio of 3 means that the chart's width should be no greater than 3 times its height. </p>
            <p>Note: This setting can be overridden by the 'Maximum Height' setting on the region.</p>
            ```
    }
)

customAttribute attribute_02 (
    apexlangName: colorScheme
    attribute: 2
    name: Color Scheme
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 140
    }
    default {
        value: DEFAULT
    }
    help {
        helpText: <p>Select the color scheme used to render the chart.</p>
    }

    entry metro (
        sequence: 40
        display: Metro
        return: METRO
    )

    entry modern (
        sequence: 10
        display: Modern
        return: MODERN
    )

    entry modern2 (
        sequence: 20
        display: Modern 2
        return: MODERN2
    )

    entry queryColumn (
        sequence: 50
        display: Query Column
        return: COLUMN
    )

    entry solar (
        sequence: 30
        display: Solar
        return: SOLAR
    )

    entry themeDefault (
        sequence: 5
        display: Theme Default
        return: DEFAULT
    )

)

customAttribute attribute_04 (
    apexlangName: autoRefresh
    attribute: 4
    name: Auto Refresh
    type: yesNo
    appearance {
        sequence: 110
    }
    builder {
        showInWizard: false
    }
    help {
        helpText: <p>Select whether the chart is refreshed automatically.</p>
    }
)

customAttribute attribute_05 (
    apexlangName: refreshInterval
    attribute: 5
    name: Refresh Interval
    type: integer
    validation {
        maxLength: 5
    }
    appearance {
        sequence: 120
    }
    builder {
        showInWizard: false
        unit: ms
        displayWidth: 5
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: Y
    }
    help {
        helpText: <p>Enter the refresh interval (in milliseconds).</p>
    }
)

customAttribute attribute_06 (
    apexlangName: nodeCssClass
    attribute: 6
    name: Node CSS Class
    validation {
        maxLength: 30
    }
    appearance {
        sequence: 190
    }
    builder {
        common: false
        showInWizard: false
        displayWidth: 30
    }
    help {
        helpText: <p>Enter an additional CSS class name to be applied to each area. The class is being applied to the "div" node which makes up the area for a node.</p>
    }
    examples {
        examples:
            ```
            </pre>
            <g class="node {your CSS class}">
              <circle>{Node Circle definition}</circle>
              <text>{Label}</text>
            </g>
            </pre>
            ```
    }
)

customAttribute attribute_07 (
    apexlangName: highlightCssClass
    attribute: 7
    name: Highlight CSS Class
    validation {
        maxLength: 30
    }
    appearance {
        sequence: 180
    }
    builder {
        common: false
        showInWizard: false
        displayWidth: 30
    }
    help {
        helpText: <p>Enter an additional CSS class name to be applied to each area. The class is being applied to the "div" node which makes up the area for a node.</p>
    }
    examples {
        examples:
            ```
            </pre>
            <g class="node {your CSS class}">
              <circle>{Node Circle definition}</circle>
              <text>{Label}</text>
            </g>
            </pre>
            ```
    }
)

customAttribute attribute_09 (
    apexlangName: linkTarget
    attribute: 9
    name: Link Target
    type: linkToTargetPageUrl
    appearance {
        sequence: 30
    }
    help {
        helpText: <p>Enter a target page to be called when the user clicks a chart entry.</p>
    }
    examples {
        examples:
            ```
            <p>Example 1: URL to navigate to page 10 and set P10_EMPNO to the EMPNO value of the clicked entry.
            <pre>f?p=&amp;APP_ID.:10:&amp;APP_SESSION.::&amp;DEBUG.:RP,10:P10_EMPNO:&amp;EMPNO.</pre>
            </p>
            <p>Example 2: Display the EMPNO value of the clicked entry in a JavaScript alert
            <pre>javascript:alert('current empno: &amp;EMPNO.');</pre>
            </p>
            ```
    }
)

customAttribute attribute_11 (
    apexlangName: treeConfigurationJson
    attribute: 11
    name: Tree Configuration JSON
    type: textarea
    validation {
        required: true
        maxLength: 4000
    }
    appearance {
        sequence: 200
    }
    builder {
        common: false
        showInWizard: false
        displayWidth: 75
    }
    default {
        value:
            ```
            {
              "trdur":                       500,
              "css_class_node":              "com_oracle_apex_d3_tree_node",
              "css_class_leafnode":          "com_oracle_apex_d3_tree_leafnode",
              "css_class_link":              "com_oracle_apex_d3_tree_link",
              "circle_radius_min":           10,
              "circle_radius_max":           10,
              "legend_column_width":         200,
              "root_label":                  "Tree root",
              "show_coll_child_cnt":         true,
              "show_coll_child_template":    " (#CNT#)",
              "offset_scrollbars":           20, 
              "margin":                      {"top": 20, "right": 120, "bottom": 20, "left": 120}
            }
            ```
    }
    help {
        helpText: <p>Enter configuration values to change the chart's behavior. Make sure that this is always <em>valid JSON</em> syntax,  otherwise the plugin will not pick up your changes. </p>
    }
    examples {
        examples:
            ```
            <pre>
            {
              "trdur":                       500,
              "css_class_node":              "com_oracle_apex_d3_tree_node",
              "css_class_leafnode":          "com_oracle_apex_d3_tree_leafnode",
              "css_class_link":              "com_oracle_apex_d3_tree_link",
              "circle_radius_min":           10,
              "circle_radius_max":           10,
              "legend_column_width":         200,
              "root_label":                  "Tree root",
              "show_coll_child_cnt":         true,
              "show_coll_child_template":    " (#CNT#)",
              "offset_scrollbars":           20, 
              "margin":                      {"top": 20, "right": 120, "bottom": 20, "left": 120}
            }
            </pre>
            ```
    }
)

customAttribute attribute_12 (
