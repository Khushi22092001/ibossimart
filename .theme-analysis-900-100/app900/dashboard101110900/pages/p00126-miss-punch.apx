page 126 (
    name: Miss Punch
    alias: MISS-PUNCH
    title: Miss Punch
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region miss-punch (
        name: Miss Punch
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region miss-punch-report (
        name: Miss Punch Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                A.AttendenceDate,
                row_number() over(order by a.ATTENDENCEDATE) SerialNo,
                B.EmployeeCode,
                getemployeeemployeeid(B.EmployeeCode,A.AttendenceDate) as EmployeeID,
                getEmployeeName(B.EmployeeCode) as EmployeeName,
                GETEMPLOYEESHIFTCODE(B.EmployeeCode,A.AttendenceDate) DEFINEDSHIFT,
                to_date(A.AttendenceDate || ' ' ||
                                       gettimehh24mi(C.shifttimefrom),
                                       'dd-mm-rrrr hh24:mi:ss') ShiftStartTime,
                b.intime,
                b.Outtime,
                ROUND(b.delaytime,2) AS DELAYTIME
                From ATTENDENCE A, ATTENDENCEDETAIL B, SHIFT C, MyEmployeeInclude d
                Where a.tno = b.tno(+)
                  And GETEMPLOYEESHIFTCODE(B.EMPLOYEECODE,A.ATTENDENCEDATE) = c.shiftcode(+)
                  And b.employeecode = d.ChildCode(+)
                  And GETEMPLOYEEDEPARTMENTCODE(B.EMPLOYEECODE, A.ATTENDENCEDATE) =
                       D.DEPARTMENTCODE(+)
                  And a.AttendenceDate BETWEEN :P126_FromDate AND :P126_ToDate
                  and (( b.intime is null and b.outtime is NOT null )
                    OR
                    ( b.intime is NOT null and b.outtime is null )
                  )
                --  and a.StaffType != 'HAMAL'
                  and instr(':'||:P126_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P126_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P126_DEPARTMENT IS NULL OR instr(':'||:P126_DEPARTMENT||':',':'||d.DepartmentCode||':') > 0)
                ORDER BY 1,4
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                html
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 25154139829083568
        }

