        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 45
            valuePlaceholder: To Date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select last_day(sysdate) from dual;
        }
        security {
            encryptSessionState: false
        }
    )

    button otsummary (
        buttonName: OTSUMMARY
