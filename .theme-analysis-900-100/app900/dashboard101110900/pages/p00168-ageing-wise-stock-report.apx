    pageItem P168_ASONDATE (
        type: datePicker
        label {
            label: As on Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @ageing-wise-stock-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 15
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P168_GROUP (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Group
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                Distinct
                a.ItemCode||'~'||a.itemName as d,
                a.Itemcode r
                From Item a
                Where a.ItemType = 'GROUP'
                Order By 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @ageing-wise-stock-report
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 1
