page 168 (
    name: Ageing wise Stock Report
    alias: AGEING-WISE-STOCK-REPORT
    title: Ageing wise Stock Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region ageing-wise-stock-report (
        name: Ageing wise Stock Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    x.LocationName,
                    x.MaterialGroup,
                    x.ItemCode,
                    x.MaterialDetail,
                    x.UOM,
                    x.StorageLocationName,
                       row_number() over(order by X.LocationName) SerialNo,
                    sum(case when x.stockdays = '0-30' then x.ClosingQty else 0 end) as Q_0_TO_30,
                    sum(case when x.stockdays = '31-60' then x.ClosingQty else 0 end) as Q_31_TO_60,
                    sum(case when x.stockdays = '61-90' then x.ClosingQty else 0 end) as Q_61_TO_90,
                    sum(case when x.stockdays = '91-120' then x.ClosingQty else 0 end) as Q_91_TO_120,
                    sum(case when x.stockdays = '121-150' then x.ClosingQty else 0 end) as Q_121_TO_150,
                    sum(case when x.stockdays = '>150' then x.ClosingQty else 0 end) as Q_Above_150,
                    --
                    sum(case when x.stockdays = '0-30' then x.ClosingAmount else 0 end) as A_0_TO_30,
                    sum(case when x.stockdays = '31-60' then x.ClosingAmount else 0 end) as A_31_TO_60,
                    sum(case when x.stockdays = '61-90' then x.ClosingAmount else 0 end) as A_61_TO_90,
                    sum(case when x.stockdays = '91-120' then x.ClosingAmount else 0 end) as A_91_TO_120,
                    sum(case when x.stockdays = '121-150' then x.ClosingAmount else 0 end) as A_121_TO_150,
                    sum(case when x.stockdays = '>150' then x.ClosingAmount else 0 end) as A_Above_150,
                    --
                    sum(x.ClosingQty) as Total_Qty,
                    sum(x.ClosingAmount) as Total_Amount,
                    round(sum(x.ClosingAmount) / sum(x.ClosingQty), 2)  as Rate,
                    x.ItemMakeName,
                    x.DealsInName,
                    x.ItemCategoryName   
                from (
                Select
                       row_number() over(order by l.LocationName) SerialNo,
                      l.LocationName,
                      eee.ItemCode||'~'||eee.ItemName as MaterialGroup,
                      e.Itemcode,
                      e.ItemName||' ~ '||ee.ItemSpecificationName as MaterialDetail,
                      e.MEASURINGUNITCODE1 as UOM,
                      sl.StorageLocationName,
                       CASE 
                         WHEN ROUND( dl.DayDate-a.stockdate,0) <= 30 THEN
                           '0-30'
                         WHEN ROUND( dl.DayDate-a.stockdate,0) BETWEEN 31 AND 60 THEN
                           '31-60'
                         WHEN ROUND( dl.DayDate-a.stockdate,0) BETWEEN 61 AND 90 THEN
                           '61-90'
                         WHEN ROUND( dl.DayDate-a.stockdate,0) BETWEEN 91 AND 120 THEN
                           '91-120'
                         WHEN ROUND( dl.DayDate-a.stockdate,0) BETWEEN 121 AND 150 THEN
                           '121-150'
                         ELSE
                           '>150'
                        END stockdays,
                      sum(a.StockQuantity1 - nvl(us.USEDSTOCKQUANTITY1, 0)) as ClosingQty,
                      sum(a.Rate) as ClosingRate,
                      sum(A.RATE * (a.StockQuantity1 - nvl(us.USEDSTOCKQUANTITY1, 0))) as ClosingAmount,
                      im.ItemMakeName,
                      di.DealsInName,
                      ic.ItemCategoryName      
                From  Stock a, DateList dl, Location l, Item e, ItemSpecification ee, Item eee, StorageLocation sl, ItemMake im,
                      (
                          select 
                                aa1.StockTNo,
                                sum(aa1.UsedStockQuantity1) as UsedStockQuantity1
                          from UsedStock aa1 
                          where aa1.UsedStockDate <= :P168_ASONDATE
                          group by aa1.StockTNo
                      ) us, DealsIn di, ItemCategory ic
                Where a.LocationCode = l.LocationCode(+)
                  and a.Itemcode = e.ItemCode(+)
                  and a.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and e.ParentCode = eee.ItemCode(+)
                  and a.StorageLocationCode = sl.StorageLocationCode(+)
                  and ee.ItemMakeCode = im.ItemMakeCode(+)
                  and a.tno = us.stocktno(+)
                  and e.DealsInCode = di.DealsInCode(+)
                  and e.ItemCategoryCode = ic.ItemCategoryCode(+)
                  and dl.DayDate = :P168_ASONDATE
                  and a.stockdate <= :P168_ASONDATE
                    -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and instr(':'||:P168_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P168_GROUP IS NULL OR instr(':'||:P168_GROUP||':',':'||e.ParentCode||':') > 0 )
                  and ( :P168_ITEM IS NULL OR instr(':'||:P168_ITEM||':',':'||a.ItemCode||':') > 0 )
                  and ( :P168_ITEMSPECIFICATION IS NULL OR instr(':'||:P168_ITEMSPECIFICATION||':',':'||a.ItemSpecificationCode||':') > 0 )
                  --and e.itemcode = '1216'
                Group By 
                      l.LocationName,
                      eee.ItemCode||'~'||eee.ItemName,
                      e.Itemcode,
                      e.ItemName,
                      ee.ItemSpecificationName,
                      sl.StorageLocationName,
                      e.MEASURINGUNITCODE1,
                      ROUND( dl.DayDate-a.stockdate,0),
                      im.ItemMakeName,
                      di.DealsInName,
                      ic.ItemCategoryName 
                     having sum(a.StockQuantity1 - nvl(us.USEDSTOCKQUANTITY1, 0)) > 0
                ) x
                group by
                    x.LocationName,
                    x.MaterialGroup,
                    x.ItemCode,
                    x.MaterialDetail,
                    x.UOM,
                    x.StorageLocationName,
                    x.ItemMakeName,
                    x.DealsInName,
                    x.ItemCategoryName 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
