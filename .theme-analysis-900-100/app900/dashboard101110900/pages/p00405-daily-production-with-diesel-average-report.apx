        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

