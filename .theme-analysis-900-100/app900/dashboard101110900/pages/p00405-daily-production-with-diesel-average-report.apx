page 405 (
    name: "Daily Production With Diesel Average Report "
    alias: DAILY-PRODUCTION-WITH-DIESEL-AVERAGE-REPORT
    title: "Daily Production With Diesel Average Report "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/dieselavg.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P405_FROMDATE').val());
              var toDate = new Date($('#P405_TODATE').val());
            
              var reportParams = 
                '&P405_COMPANY=' + $('#P405_COMPANY').val() + 
                '&P405_LOCATION=' +  $('#P405_LOCATION').val() +
                '&P405_FROMDATE=' +  $('#P405_FROMDATE').val() + 
                '&P405_TODATE='  +  $('#P405_TODATE').val() + 
                '&P405_EQUIPMENTGROUP=' + $('#P405_EQUIPMENTGROUP').val() + 
                '&P405_SHIFT=' + $('#P405_SHIFT').val() + 
                '&P405_DOORNO=' + $('#P405_DOORNO').val() 
                  ;
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            ```
    }
    css {
        inline:
            ```css
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region daily-production-with-diesel-average (
        name: Daily Production With Diesel Average
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ROWNUM  as SerialNo ,X.* FROM 
                (
                   Select --row_number() over(Order By a.Equipmentlogbookdate) SerialNo,
                       GetLocationName(a.LocationCode) As Location,
                       c.EquipmentId,
                       a.EquipmentLogBookDate,
                       --       j.JobTypeName,
                       Min(a.OpeningWorkingHrs) As OpeningWorkingHrs,
                       Max(a.ClosingWorkingHrs) As ClosingWorkingHrs,
                       (Max(a.ClosingWorkingHrs) - Min(a.OpeningWorkingHrs)) As WorkingHrs,
                       nvl(Sum(b.TotalTrip), 0) As TotalTrip,
                       Case
                         When (Max(a.ClosingWorkingHrs) - Min(a.OpeningWorkingHrs)) = 0 Then
                          Sum(b.TotalTrip) / 1
                         Else
                          round(Sum(b.TotalTrip) /
                                (Max(a.ClosingWorkingHrs) - Min(a.OpeningWorkingHrs)),
                                2)
                       End As AvgTrip,
                       (getdailyproductionCapacity(a.companycode,
                                                   a.locationcode,
                                                   Null,
                                                   c.manufacturemodelcode,
                                                   a.EquipmentLogBookDate) *
                       ((to_date(&P405_TODATE, 'DD-MON-YYYY') -
                       TO_DATE(&P405_FROMDATE, 'DD-MON-YYYY')) + 1)) As "Required Quantity",
                       
                       Case
                       
                         When ROW_NUMBER()
                          Over(Partition By
                                   (Select Sum(c.quantity1)
                                      From NecessitySlip b, NecessitySlipDetail c
                                     Where b.tno = c.tno
                                       And b.Locationcode = a.locationcode
                                       And b.NecessitySlipDate = a.EquipmentLogBookDate
                                       And b.shiftcode = 'DS') Order By
                                   (Select Sum(c.quantity1)
                                      From NecessitySlip b, NecessitySlipDetail c
                                     Where b.tno = c.tno
                                       And b.Locationcode = a.locationcode
                                       And b.NecessitySlipDate = a.EquipmentLogBookDate
                                       And b.shiftcode = 'DS')) = 1 Then
                          (Select Sum(c.quantity1)
                             From NecessitySlip b, NecessitySlipDetail c
                            Where b.tno = c.tno
                              And b.Locationcode = a.locationcode
                              And b.NecessitySlipDate = a.EquipmentLogBookDate
                              And b.shiftcode = 'DS')
                         Else
                          Null
                       End As "Day Shift Diesel Qty",
                       Case
                         When ROW_NUMBER()
                          Over(Partition By
                                   (Select Sum(c.quantity1)
                                      From NecessitySlip b, NecessitySlipDetail c
                                     Where b.tno = c.tno
                                       And b.Locationcode = a.locationcode
                                       And b.NecessitySlipDate = a.EquipmentLogBookDate
                                       And b.shiftcode = 'NS') Order By
                                   (Select Sum(c.quantity1)
                                      From NecessitySlip b, NecessitySlipDetail c
                                     Where b.tno = c.tno
                                       And b.Locationcode = a.locationcode
                                       And b.NecessitySlipDate = a.EquipmentLogBookDate
                                       And b.shiftcode = 'NS')) = 1 Then
                          (Select Sum(c.quantity1)
                             From NecessitySlip b, NecessitySlipDetail c
                            Where b.tno = c.tno
                              And b.Locationcode = a.locationcode
                              And b.NecessitySlipDate = a.EquipmentLogBookDate
                              And b.shiftcode = 'NS')
                         Else
                          Null
                       End As "Night Shift Diesel Qty",
                       Sum(d.nooftrips) As "V.LogBook Trips",
                       
                       sum(d.qty) As "Achived Quantity"
                
                  From EquipmentLogBook a,
                       EquipmentLogBookDetail b,
                       Equipment c, --, JobType j
                       (Select aa.locationcode,
                               bb.EquipmentTno,
                               bb.Jobtypecode,
                               aa.shiftcode,
                               aa.vehiclelogbookdate,
                               
                               Sum(bb.nooftrips) As nooftrips,
                               Sum(gettripaverageweight(aa.companycode,
                                                        aa.locationcode,
                                                        BB.JOBTYPECODE,
                                                        DD.manufacturemodelcode,
                                                        AA.vEHICLELogBookDate) *
                                   bb.nooftrips) As qty
                          From Vehiclelogbook       aa,
                               VehicleLogBookDetail bb,
                               CompanyVehicle       cc,
                               Equipment            DD
                         Where aa.tno = bb.tno
                           And AA.VEHICLENO = CC.COMPANYVEHICLENO
                           And CC.MODULETNO = DD.TNO
                           And VehicleLogbookDate Between :P405_FROMDATE and :P405_TODATE
                           And aa.locationcode = :P405_LOCATION
                         Group By aa.locationcode,
                                  bb.EquipmentTno,
                                  bb.Jobtypecode,
                                  aa.shiftcode,
                                  aa.vehiclelogbookdate) d
                 Where 1 = 1
                   And a.TNo = b.TNo
                   And a.EquipmentTNo = c.TNo
                   And a.Locationcode = d.Locationcode
                   And a.EquipmentLogBookDate = d.VehicleLogBookDate
                   And c.tno = d.Equipmenttno
                   And a.shiftcode = d.shiftcode
                 
                  and a.Equipmentlogbookdate between :P405_FROMDATE and :P405_TODATE
                  and instr(':'||:P405_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P405_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P405_DOORNO IS NULL OR instr(':'||:P405_DOORNO||':',':'||c.equipmentid||':') > 0 ) 
                  and ( :P405_EQUIPMENTGROUP IS NULL OR instr(':'||:P405_EQUIPMENTGROUP||':',':'||c.EquipmentGroupCode||':') > 0 )
                
                /*   And ( :P5002_LOCATION IS NULL OR instr(':'||:P5002_LOCATION||':',':'||a.LocationCode||':') > 0 )
                   And ( :P5002_EQUIPMENTID IS NULL OR instr(':'||:P5002_EQUIPMENTID||':',':'||a.EquipmentTNo||':') > 0 )
                   And ( :P5002_JOBTYPE IS NULL OR instr(':'||:P5002_JOBTYPE||':',':'||b.JobTypeCode||':') > 0)
                   And ( :P5002_EQUIPMENTGROUP IS NULL OR instr(':'||:P5002_EQUIPMENTGROUP||':',':'||c.EQUIPMENTGROUPCODE||':') > 0)
                */
                 Group By GetLocationName(a.LocationCode),
                          c.EquipmentId,
                          a.EquipmentLogBookDate,
                          --j.JobTypeName,
                          A.LOCATIONCODE,
                          getdailyproductionCapacity(a.companycode,
                                                     a.locationcode,
                                                     Null,
                                                     c.manufacturemodelcode,
                                                     a.EquipmentLogBookDate)
                ) X
                    ;
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
