    pageItem P5002_EQUIPMENTGROUP (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Equipment Group
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct b.EQUIPMENTGROUPNAME d, b.EQUIPMENTGROUPCODE r  from Equipment a , EQUIPMENTGROUP b
                where a.EQUIPMENTGROUPCODE = b.EQUIPMENTGROUPCODE
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 60
            region: @daily-wise-pc-working-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
