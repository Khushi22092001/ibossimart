page 5002 (
    name: PC Working Summary
    alias: PC-WORKING-SUMMARY
    title: Daily Wise PC Working Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/pcworkingsummarynew.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P5002_FROMDATE').val());
              var toDate = new Date($('#P5002_TODATE').val());
            
            var reportParams = 
                  '&P5002_FROMDATE='+ $('#P5002_FROMDATE').val() +  
                  '&P5002_TODATE=' + $('#P5002_TODATE').val() +  
                  '&P5002_EQUIPMENTGROUP=' +$('#P5002_EQUIPMENTGROUP').val() +  
                  '&P5002_JOBTYPE=' +$('#P5002_JOBTYPE').val() + 
                  '&P5002_EQUIPMENTID=' +$('#P5002_EQUIPMENTID').val() + 
                  '&P5002_LOCATION=' +$('#P5002_LOCATION').val() 
                  
                  ;
             
                  
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              var reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region daily-wise-pc-working-summary (
        name: Daily Wise PC Working Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by a.Equipmentlogbookdate) SerialNo, 
                      GetLocationName(a.LocationCode) As Location,
                       c.EquipmentId,
                       a.EquipmentLogBookDate,
                       j.JobTypeName,
                       Min(a.OpeningWorkingHrs) As OpeningWorkingHrs,
                       Max(a.ClosingWorkingHrs) As ClosingWorkingHrs,
                       (Max(a.ClosingWorkingHrs) - Min(a.OpeningWorkingHrs)) As WorkingHrs,
                       nvl(Sum(b.TotalTrip), 0) As TotalTrip,
                       Case
                         When (Max(a.ClosingWorkingHrs) - Min(a.OpeningWorkingHrs)) = 0 Then
                          Sum(b.TotalTrip) / 1
                         Else
                          round(Sum(b.TotalTrip) /
                                (Max(a.ClosingWorkingHrs) - Min(a.OpeningWorkingHrs)),
                                2)
                       End As AvgTrip
                
                  From EquipmentLogBook a, EquipmentLogBookDetail b, Equipment c, JobType j
                 Where 1 = 1
                   And a.TNo = b.TNo(+)
                   And a.EquipmentTNo = c.TNo(+)
                   And b.JobTypeCode = j.JobTypeCode(+)    
                   And a.Equipmentlogbookdate Between :P5002_FROMDATE And :P5002_TODATE
                   And ( :P5002_LOCATION IS NULL OR instr(':'||:P5002_LOCATION||':',':'||a.LocationCode||':') > 0 )
                   And ( :P5002_EQUIPMENTID IS NULL OR instr(':'||:P5002_EQUIPMENTID||':',':'||a.EquipmentTNo||':') > 0 )
                   And ( :P5002_JOBTYPE IS NULL OR instr(':'||:P5002_JOBTYPE||':',':'||b.JobTypeCode||':') > 0)
                   And ( :P5002_EQUIPMENTGROUP IS NULL OR instr(':'||:P5002_EQUIPMENTGROUP||':',':'||c.EQUIPMENTGROUPCODE||':') > 0)
                 Group By GetLocationName(a.LocationCode),
                          c.EquipmentId,
                          a.EquipmentLogBookDate,
                          j.JobTypeName
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 118132667219039311
        }

