            type: itemIsNotNull
            item: P693_PARTY
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            lazyLoading: true
        }
