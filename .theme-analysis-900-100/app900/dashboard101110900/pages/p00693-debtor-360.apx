        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select p.PartyName d, p.PartyCode r
                  From Party p
                 Where p.PartyCode In (Select PartyCode From Party
                         Start With PartyCode = 'SUNDRYDEBTORS' Connect By Prior PartyCode = ParentCode)
                   And Exists (Select 1 From VoucherDetail v
                                Where v.AccountCode = p.PartyCode
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or v.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            nullDisplayValue: Select a customer
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P693_TODATE (
        type: datePicker
        label {
            label: To Date / As-of
            alignment: left
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: Select to_char(trunc(sysdate),'DD-MM-RRRR') From dual
        }
        security {
            encryptSessionState: false
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
    )

    button back (
        buttonName: BACK
        label: Command Centre
        layout {
            sequence: 100
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 690
                items: {
                    P690_FROMDATE: &P693_FROMDATE.
                    P690_TODATE: &P693_TODATE.
                    P690_COMPANY: &P693_COMPANY.
                    P690_LOCATION: &P693_LOCATION.
                    P690_PANEL: &P693_PANEL.
                    P690_AGEBASIS: &P693_AGEBASIS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button party-summary (
        buttonName: PARTYSUMMARY
        label: All Customers
        layout {
            sequence: 90
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-users
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 691
                items: {
                    P691_FROMDATE: &P693_FROMDATE.
                    P691_TODATE: &P693_TODATE.
                    P691_COMPANY: &P693_COMPANY.
                    P691_LOCATION: &P693_LOCATION.
                    P691_PANEL: &P693_PANEL.
                    P691_AGEBASIS: &P693_AGEBASIS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

