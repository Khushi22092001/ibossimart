    region command-header (
        name: Debtor 360
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-ar-head">'
                    || '<div class="ds-ar-eyebrow">Receivables &middot; Debtor 360</div>'
                    || '<h1 class="ds-ar-title">'
                       || apex_escape.html(nvl((Select p.PartyName From Party p Where p.PartyCode = :P693_PARTY),
                                               nvl(:P693_PARTY,'No customer selected'))) || '</h1>'
                    || '<div class="ds-ar-sub">'
                       || Case When :P693_PARTY Is Null Then 'Open this page from Party-wise Outstanding, Bill-wise Outstanding or a chart to load a customer.'
                               Else 'Complete receivable position, credit held, open items and collection history as at the As-of Date' End
                    || '</div>'
                    || '<div class="ds-ar-context">'
                    || Case When :P693_PARTY Is Not Null Then
                            '<span class="ds-ar-chip"><span class="fa fa-user"></span>Code <b>' || apex_escape.html(:P693_PARTY) || '</b></span>'
                         || nvl('<span class="ds-ar-chip"><span class="fa fa-sitemap"></span>Group <b>'
                            || apex_escape.html((Select g.PartyName From Party p Join Party g On g.PartyCode = p.ParentCode
                                                  Where p.PartyCode = :P693_PARTY)) || '</b></span>','') End
                    || '<span class="ds-ar-chip"><span class="fa fa-crosshairs"></span>Position as at <b>' || :P693_TODATE || '</b></span>'
                    || '<span class="ds-ar-chip"><span class="fa fa-calendar"></span>Flows <b>'
                       || :P693_FROMDATE || ' &rarr; ' || :P693_TODATE || '</b></span>'
                    || '<span class="ds-ar-chip"><span class="fa fa-hourglass-half"></span>Ageing basis <b>'
                       || Case When :P693_AGEBASIS = 'DOC' Then 'Document date (age)' Else 'Due date (lateness)' End || '</b></span>'
                    || '<span class="ds-ar-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                               Then (Select GetUserPanelAB_apex() From dual) || ' (enforced)'
                               When :P693_PANEL Is Not Null Then :P693_PANEL Else 'A + B' End || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
            pageItemsToSubmit: [
                P693_PARTY
                P693_FROMDATE
                P693_TODATE
                P693_COMPANY
                P693_LOCATION
                P693_PANEL
                P693_AGEBASIS
            ]
