    region vehicle-statutory-detail (
        name: Vehicle Statutory Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P208_CHASSISNO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Chassis No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                minimalInputLength
                rapidSelection
            ]
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                a.ChassisNo d,
                a.ChassisNo r
                From CompanyVehicle a
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @vehicle-statutory-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P208_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                minimalInputLength
                rapidSelection
            ]
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                b.CompanyName d,
                b.CompanyCode r
                From CompanyVehicle a, Company b
                Where a.CompanyCode = b.CompanyCode(+)
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @vehicle-statutory-detail
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P208_VEHICLENO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vehicle No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                minimalInputLength
                rapidSelection
            ]
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                a.CompanyVehicleNo d,
                a.CompanyVehicleNo r
                From CompanyVehicle a, CompanyVehicleDetail b, necessitycompletiondetail c
                Where a.Tno = b.Tno
                and   a.CompanyVehicleNo   =  c.VehicleNo(+);
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @vehicle-statutory-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
