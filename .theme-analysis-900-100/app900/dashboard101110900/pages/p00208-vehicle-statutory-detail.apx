page 208 (
    name: Vehicle Statutory Detail
    alias: VEHICLE-STATUTORY-DETAIL
    title: Vehicle Statutory Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
            overflow: auto !important;
            }
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region vehicle-statuory-detail-report (
        name: Vehicle Statuory Detail Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                --a.CompanyCode,
                row_number() over(order by a. Tno) SerialNo,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.CompanyCode
                         Else
                          Null
                End CompanyCode,
                --a.Tno,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.Tno
                         Else
                          Null
                End Tno,
                --a.CompanyName,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.CompanyName
                         Else
                          Null
                End CompanyName,
                --a.ChassisNo,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.ChassisNo
                         Else
                          Null
                End ChassisNo,
                --a.VehicleNo,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                          a.VehicleNo
                         Else
                          Null
                End VehicleNo,
                a.InsuranceLastRenewalDate,
                a.InsuranceExpiryDate,
                a.FitnessLastRenewalDate,
                a.FitnessExpiryDate,
                a.PermitNationalLastRenewalDate,
                a.PermitNationalExpiryDate,
                a.PermitStateLastRenewalDate,
                a.PermitStateExpiryDate,
                a.RoadTaxLastRenewalDate,
                a.RoadTaxExpiryDate,
                a.PollutionLastRenewalDate,
                a.PollutionExpiryDate
                From 
                (Select DISTINCT
                a.Tno,
                e.CompanyName,
                a.CompanyCode,
                a.ChassisNo,
                a.CompanyVehicleNo as VehicleNo,
                Case When d.VehicleNecessityName = 'INSURANCE'
                Then b.LastRenewalDate End as InsuranceLastRenewalDate,
                Case When d.VehicleNecessityName = 'INSURANCE'
                Then b.NextDueDate End as InsuranceExpiryDate,
                Case When d.VehicleNecessityName = 'FITNESS'
                Then b.LastRenewalDate End as FitnessLastRenewalDate,
                Case When d.VehicleNecessityName = 'FITNESS'
                Then b.NextDueDate End as FitnessExpiryDate,
                Case When d.VehicleNecessityName = 'PERMIT (NATIONAL)'
                Then b.LastRenewalDate End as PermitNationalLastRenewalDate,
                Case When d.VehicleNecessityName = 'PERMIT (NATIONAL)'
                Then b.NextDueDate End as PermitNationalExpiryDate,
                Case When d.VehicleNecessityName = 'PERMIT (CG STATE)'
                Then b.LastRenewalDate End as PermitStateLastRenewalDate,
                Case When d.VehicleNecessityName = 'PERMIT (CG STATE)'
                Then b.NextDueDate End as PermitStateExpiryDate,
                Case When d.VehicleNecessityName = 'ROAD TAX'
                Then b.LastRenewalDate End as RoadTaxLastRenewalDate,
                Case When d.VehicleNecessityName = 'ROAD TAX'
                Then b.NextDueDate End as RoadTaxExpiryDate,
                Case When d.VehicleNecessityName = 'POLLUTION (PUC)'
                Then b.LastRenewalDate End as PollutionLastRenewalDate,
                Case When d.VehicleNecessityName = 'POLLUTION (PUC)'
                Then b.NextDueDate End as PollutionExpiryDate
                From CompanyVehicle a, CompanyVehicleDetail b, VehicleNecessity d, Company e
                Where a.Tno = b.Tno
                and b.VehicleNecessityCode = d.VehicleNecessityCode
                and a.CompanyCode = e.CompanyCode) a
                --and NVL(a.CompanyCode,1) = :P208_COMPANY
                Where :P208_COMPANY IS NOT NULL
                and ( :P208_CHASSISNO IS NULL OR instr(':'||:P208_CHASSISNO||':',':'||a.ChassisNo||':') > 0 )
                and  ( :P208_COMPANY IS NULL OR instr(':'||:P208_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                and  ( :P208_VEHICLENO IS NULL OR instr(':'||:P208_VEHICLENO||':',':'||a.VehicleNo||':') > 0 )
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                /*Select DISTINCT
                a.Tno,
                e.CompanyName,
                a.ChassisNo,
                a.CompanyVehicleNo as VehicleNo,
                Case When d.VehicleNecessityName = 'INSURANCE'
                Then b.LastRenewalDate End as InsuranceLastRenewalDate,
                Case When d.VehicleNecessityName = 'INSURANCE'
                Then b.NextDueDate End as InsuranceExpiryDate,
                Case When d.VehicleNecessityName = 'FITNESS'
                Then b.LastRenewalDate End as FitnessLastRenewalDate,
                Case When d.VehicleNecessityName = 'FITNESS'
                Then b.NextDueDate End as FitnessExpiryDate,
                Case When d.VehicleNecessityName = 'PERMIT (NATIONAL)'
                Then b.LastRenewalDate End as PermitNationalLastRenewalDate,
                Case When d.VehicleNecessityName = 'PERMIT (NATIONAL)'
                Then b.NextDueDate End as PermitNationalExpiryDate,
                Case When d.VehicleNecessityName = 'PERMIT (CG STATE)'
                Then b.LastRenewalDate End as PermitStateLastRenewalDate,
                Case When d.VehicleNecessityName = 'PERMIT (CG STATE)'
                Then b.NextDueDate End as PermitStateExpiryDate,
                Case When d.VehicleNecessityName = 'ROAD TAX'
                Then b.LastRenewalDate End as RoadTaxLastRenewalDate,
                Case When d.VehicleNecessityName = 'ROAD TAX'
                Then b.NextDueDate End as RoadTaxExpiryDate,
                Case When d.VehicleNecessityName = 'POLLUTION (PUC)'
                Then b.LastRenewalDate End as PollutionLastRenewalDate,
                Case When d.VehicleNecessityName = 'POLLUTION (PUC)'
                Then b.NextDueDate End as PollutionExpiryDate
                From CompanyVehicle a, CompanyVehicleDetail b, VehicleNecessity d, Company e
                Where a.Tno = b.Tno
                and b.VehicleNecessityCode = d.VehicleNecessityCode
                and a.CompanyCode = e.CompanyCode
                --and NVL(a.CompanyCode,1) = :P208_COMPANY
                AND :P208_COMPANY IS NOT NULL
                and ( :P208_CHASSISNO IS NULL OR instr(':'||:P208_CHASSISNO||':',':'||a.ChassisNo||':') > 0 )
                and  ( :P208_COMPANY IS NULL OR instr(':'||:P208_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                and  ( :P208_VEHICLENO IS NULL OR instr(':'||:P208_VEHICLENO||':',':'||a.CompanyVehicleNo||':') > 0 )
                ;*/
                ```
        }
