page 220 (
    name: Freight RateList
    alias: FREIGHTCONTRACTREGISTER
    title: Freight Rate Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region freight-rate-list (
        name: Freight Rate List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With SQLItem as (
                select
                    a.ItemCode
                from Item a
                where ( a.ItemCode = :P220_ITEMCODE or :P220_ITEMCODE IS NULL )
                and exists( 
                    select 
                        aa.tno 
                    from FreightRateList aa 
                    where aa.ItemCode = a.ItemCode
                )    
                ), SQLParty as (
                select
                    a.PartyCode
                from Party a
                where (a.PartyCode = :P220_PARTYCODE or :P220_PARTYCODE IS NULL)
                and exists(
                    select
                        aa.tno
                    from FreightRateList aa
                    where aa.PartyCode = a.PartyCode
                )
                ), SQLList as (
                select
                    distinct
                    a.PartyCode,
                    b.SourceLocationTNo,
                    b.DestinationLocationTNo,
                    a.CompanyCode,
                    a.itemCode,
                    a.ItemSpecificationCode,
                    null as LocationCode,
                    c.VehicleGroupCode,
                    b.FreightBasisCode,
                    :P220_ASONDATE as  AsOnDate
                From FreightRateList a, FreightRateListDetail b, VehicleGroup c, SQLParty d, SQLItem e
                where a.TNO = b.TNo
                    and a.PartyCode = d.PartyCode
                    and a.ItemCode = e.ItemCode
                ), SQLRate as (
                select
                    e.ItemName || ' - ' || f.ItemSpecificationName as ItemName,
                    b.PartyName,
                    c.SourceLocationName as Source,
                    d.DestinationLocationName as Destination,          
                    --GetFreightRateBasisItemWise(a.PartyCode, a.SourceLocationTNo, a.DestinationLocationTNo, a.AsOnDAte, a.CompanyCode, a.LocationCode, a.ItemCode, a.ItemSpecificationCode ) as FreightRate,
                    GetFreightRateItemWise(a.FreightBasisCode, a.PartyCode, a.SourceLocationTNo, a.DestinationLocationTNo, a.AsOnDate, a.CompanyCode, a.LocationCode, a.ItemCode, a.ItemSpecificationCode)  as FreightRate,
                    --GetOurFreightRate(a.PartyCode, a.SourceLocationTNo, a.DestinationLocationTNo, a.AsOnDate, a.CompanyCode, a.LocationCode, a.VehicleGroupCode, a.ItemCode, a.ItemSpecificationCode ) as OurFreightRate
                    GetOurFreightRate(a.PartyCode, a.SourceLocationTNo, a.DestinationLocationTNo, a.AsOnDate, a.CompanyCode, a.LocationCode, a.VehicleGroupCode, a.ItemCode, a.ItemSpecificationCode  ) as OurFreightRate,
                    a.vehiclegroupcode 
                from SQLList a, Party b, SourceLocation c, DestinationLocation d, Item e, ItemSpecification f
                where a.PartyCode = b.PartyCode
                    and a.SourceLocationTNo = c.TNo
                    and a.DestinationLocationTNo = d.TNo
                    and a.ItemCode = e.ItemCode
                    and a.ItemSpecificationCode = f.ItemSpecificationCode
                    and c.SourceLocationName in (
                        select
                            aa.SourceLocationName
                        from SourceLocation aa
                        where aa.SourceLocationName = :P220_SOURCELOCATIONNAME OR :P220_SOURCELOCATIONNAME IS NULL    
                    )
                    and d.DestinationLocationName in (
                        select
                            aa.DestinationLocationName
                        from DestinationLocation aa
                        where aa.DestinationLocationName = :P220_DESTINATIONLOCATIONNAME OR :P220_DESTINATIONLOCATIONNAME IS NULL    
                    )    
                ) 
                select
                a.ItemName,
                a.PartyName,
                a.Source,
                a.Destination,
                a.FreightRate,
                a.OurFreightRate,
                nvl(a.FreightRate, 0) - nvl(a.OurFreightRate, 0) as MarginRate,
                b.vehiclegroupname  as VehicleGroup 
                from SQLRate a, vehiclegroup   b
                where a.vehiclegroupcode = b.vehiclegroupcode (+)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 54637366157849168
        }

