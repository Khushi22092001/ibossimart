page 475 (
    name: Audit Trail
    alias: AUDIT-TRAIL1
    title: Audit Trail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region audit-trail (
        name: Audit Trail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT * FROM 
                (
                Select a.ActionTime,
                       a.ActionUser,
                       decode(a.ActionType, 'SAVE', 'UPDATE', a.ActionType) as ActionType,
                       a.ModuleCode,
                       m.ModuleName,
                       a.ModuleTNo,
                       a.HostName,
                       a.OS_User,
                       a.IP_Address,
                       a.TransactionNo,
                       a.UserLocation,
                       getCOmpanyName(GetModuleCompanyCode(A.MODULECODE, A.MODULETNO)) As COMPANYNAME,
                       GetLocationName(GetModuleLocationCode(A.MODULECODE, A.MODULETNO)) As LocationName,
                       GetModuleFYearCode(A.MODULECODE, A.MODULETNO) As FYearCode
                  From ActionLog a, Module m
                 Where a.ModuleCode = m.ModuleCode(+)
                
                  and Trunc(a.ActionTime) Between :P475_FROMDATE and :P475_TODATE
                  and ( :P475_ACTIONUSER IS NULL OR instr(':'||:P475_ACTIONUSER||':',':'||a.ActionUser||':') > 0 ) 
                 and ( :P475_TransactionNo is null or a.TransactionNo = :P475_TRANSACTIONNO)
                ) X
                WHERE 1=1
                   --and a.ModuleCode :P30_ModuleCode
                  and ( :P475_MODULE   IS NULL OR instr(':'||:P475_MODULE  ||':',':'||X.ModuleCode||':') > 0 ) 
                  and ( :P475_COMPANY  IS NULL OR instr(':'||:P475_COMPANY ||':',':'||X.COMPANYNAME||':') > 0 ) 
                  and ( :P475_LOCATION IS NULL OR instr(':'||:P475_LOCATION||':',':'||X.LOCATIONNAME||':') > 0 ) 
                 and ( :P475_ACTIONTYPE IS NULL OR instr(':'||:P475_ACTIONTYPE||':',':'||X.ACTIONTYPE||':') > 0 ) 
                
                  
                ```
            pageItemsToSubmit: [
                P475_COMPANY
                P475_LOCATION
                P475_FROMDATE
                P475_TODATE
                P475_ACTIONUSER
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 31185181397839573
        }

        column ACTIONTIME (
            type: plainText
            heading {
                heading: Action Time
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI:SS
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column ACTIONTYPE (
            type: plainText
            heading {
                heading: Action Type
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ACTIONUSER (
            type: plainText
            heading {
                heading: Action User
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
