                heading: Host Name
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column IP_ADDRESS (
            type: plainText
            heading {
                heading: Ip Address
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location Name
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: Module Code
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: Module Name
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column MODULETNO (
            type: plainText
