            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Audit Trail
        }

        savedReport 311950 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIONTIME (
                sequence: 4
