page 278 (
    name: Pay Loader Register
    alias: PAY-LOADER-REGISTER
    title: Pay Loader Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region pay-loader-register (
        name: Pay Loader Register
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.RakeLoadingDate) SerialNo,
                b.LocationName "Location Name",
                c.DocTypeName "DocType Name",
                a.RakeLoadingNo "Rake Loading No",
                a.RakeLoadingDate "Rake Loading Date",
                d.PartyName "Party Name",
                j.PartyRefNo "Party Ref No",
                j.PartyRefDate "Party Ref Date",
                e.RakeNo "Rake No",
                e.RakeDate "Rake Date",
                f.ShiftName "Shift Name",
                g.JobTypeName  "JobType Name",
                h.EquipmentName "Equipment Name",
                i.EmployeeName ".Employee Name",
                aa.NoofWagon "No of Wagon",
                aa.NoofTipper "No of Tipper",
                round(aa.Quantity1,3) as "Qty in MT",
                aa.Remark as "Remark",
                a.Creator,
                aa.Rate,
                aa.Amount
                from RakeLoading a,RakeLoadingDetail aa 
                ,Location b, DocType c , Party d, CMPLRake e, Shift  f,
                JobType g, Equipment h, Employee i, WorkOrder j
                where a.Tno = aa.Tno(+)
                and a.LocationCode = b.LocationCode (+)
                and  a.DocTypeCode = c.DocTypeCode(+)
                and a.PartyCode = d.PartyCode(+)
                and a.CmplRakeTno = e.Tno(+)
                and a.ShiftCode = f.ShiftCode(+)
                and aa.JobTypeCode = g.JobTypeCode(+)
                and aa.EquipmentTno = h.Tno(+)
                and aa.Drivercode = i.employeecode(+)
                and a.WorkOrderTno = j.Tno(+)
                and a.RAKELoadingDate between :P278_FROMDATE and :P278_TODATE
                and (:P278_LOCATIONNAME is null or instr(':'||:P278_LOCATIONNAME||':',':'||a.Locationcode||':') > 0)
                and (:P278_DOCTYPE is null or instr(':'||:P278_DOCTYPE||':',':'||a.Doctypecode||':') > 0)
                and (:P278_PARTY is null or instr(':'||:P278_PARTY||':',':'||a.Partycode||':') > 0)
                and (:P278_COMPANYNAME is null or instr(':'||:P278_COMPANYNAME||':',':'||a.Companycode||':') > 0)
                and (:P278_RAKELOADINGNO is null or instr(':'||:P278_RAKELOADINGNO||':',':'||a.TNo||':') > 0)
                and (:P278_CMPLRAKENO is null or instr(':'||:P278_CMPLRAKENO||':',':'||a.CmplRakeTno||':') > 0)
                and (:P278_EQUIPMENT is null or instr(':'||:P278_EQUIPMENT||':',':'||aa.EquipmentTno||':') > 0)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 14444331379632728
        }

