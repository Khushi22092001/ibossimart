        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                b.CMPLRAKENO d,
                b.Tno r
                From 
                RAKELoading a, 
                CMPLRAKE b
                Where a.CmplRakeTno = b.Tno;
                ```
            nullDisplayValue: -Select List-
        }
        layout {
