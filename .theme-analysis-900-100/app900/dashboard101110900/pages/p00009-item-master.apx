        layout {
            sequence: 20
            slot: body
        }
    )

    pageItem P9_EQUIPMENT (
        type: selectList
        label {
            label: Equipment
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:YES;YES,NO;NO
            nullDisplayValue: --  Is Equipment --
        }
        layout {
            sequence: 40
            region: @item-master
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9_ITEMGROUP (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Item Group
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.ItemName as d,
                a.ItemCode as r
                From Item a
                Where a.ItemType = 'GROUP'
                Order by 1
                ```
            nullDisplayValue: --Select--
        }
        layout {
            sequence: 10
            region: @item-master
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

