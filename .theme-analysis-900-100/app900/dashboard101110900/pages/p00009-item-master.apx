    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 70
            region: @item-master
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
