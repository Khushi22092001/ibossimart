page 9 (
    name: Item Master
    alias: ITEM-MASTER
    title: Item Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region item-master (
        name: Item Master
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--noBorder
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-md
                margin-left-none
                margin-right-none
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region item-master-2 (
        name: Item Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	row_number() over(order by e.ParentCode) SerialNo,
                	p.ItemName As MaterialGroup,
                	e.ItemCode,
                	e.ItemName,
                	e.ItemClassificationCode,
                	e.MeasuringUnitCode1,
                	e.MeasuringUnitCode2,
                	itn.ItemNatureName,
                	sa.PartyName as StockAccount,
                	ca.PartyName as ConsumptionAccount,
                	cw.PartyName as CWIPAccount,
                	e.BulkDensity,
                	ee.MultiPlyingFactor,
                	e.IsEquipment,
                	e.SerialNoRequired,
                	ee.ItemSpecificationCode,
                	ee.ItemSpecificationName,
                	ee.HSNCODE,
                	ee.QualityRequired,
                	ee.IsWeighmentRequired,
                	bue.EmployeeName ||' ( '||e.Creator||' )' as ItemCreator,
                	e.CreationTime as ItemCreationTime,
                	emp.EmployeeName ||' ( '||ee.Creator||' )' as ItemSpecificationCreator,
                	ee.CreatedOn as ItemSpecificationCreationTime,
                	e.Remark,
                    dsd.DocumentStatusCode
                From Item e, ItemSpecification ee, ItemNature itn, Party sa, Party ca, Party cw, BossUser bu, BossUser bu2, Item p, Employee emp, Employee bue,
                DocumentStatusDetail dsd
                Where e.TNo = ee.TNo(+)
                	and e.ItemNatureCode = itn.ItemNatureCode(+)
                	and e.StockAccountCode = sa.PartyCode(+)
                	and e.ConsumptionAccountCode = ca.PartyCode(+)
                	and e.CWIPAccountCode = cw.PartyCode(+)
                	and e.ItemType = 'ITEM'
                	and e.Creator = bu.LoginName(+)
                	and ee.Creator = bu2.LoginName(+)
                	and e.ParentCode = p.ItemCode(+)
                	and bu2.employeecode = emp.EmployeeCode(+)
                	and bu.employeecode = bue.EmployeeCode(+)
                    and e.Tno = dsd.ModuleTno(+)
                	-- and instr(':'||:P9_COMPANY||':',':'||e.CompanyCode||':') > 0
                	and (:P9_EQUIPMENT is null or e.IsEquipment = :P9_EQUIPMENT)
                	and (:P9_SERIAL is null or e.SerialNoRequired = :P9_SERIAL)
                	and (:P9_QUALITY is null or ee.QualityRequired = :P9_QUALITY)
                	and (:P9_WEIGHMENT is null or ee.IsWeighmentRequired = :P9_WEIGHMENT)
                    and (:P9_STATUS is null or dsd.DocumentStatusCode = :P9_STATUS)
                	and ( :P9_ItemGroup is null 
                		or
                		e.ItemCode in
                			(
                			select
                				a.ItemCode
                			from Item a
                			where 1=1
                			start with instr(':'||:P9_ITEMGROUP||':',':'||a.ItemCode||':') > 0
                			connect by a.ParentCode = prior a.ItemCode
                			)
                		)
                /*
                Select
                row_number() over(order by e.ParentCode) SerialNo,
                GetItemName(e.ParentCode) As MaterialGroup,
                --||' ~ '||e.ParentCode
                e.ItemCode,
                e.ItemName,
                e.ItemClassificationCode,
                e.MeasuringUnitCode1,
                e.MeasuringUnitCode2,
                itn.ItemNatureName,
                sa.PartyName as StockAccount,
                ca.PartyName as ConsumptionAccount,
                cw.PartyName as CWIPAccount,
                e.BulkDensity,
                ee.MultiPlyingFactor,
                e.IsEquipment,
                e.SerialNoRequired,
                ee.ItemSpecificationCode,
                ee.ItemSpecificationName,
                ee.HSNCODE,
                ee.QualityRequired,
                ee.IsWeighmentRequired,
                GetEmployeeName(bu.employeecode)||' ( '||e.Creator||' )' as ItemCreator,
                --Sys_Connect_By_Path(GetEmployeeName(bu.employeecode) || ':' || e.Creator, ' -> ') "ItemCreator",
                e.CreationTime as ItemCreationTime,
                GetEmployeeName(bu2.employeecode)||' ( '||ee.Creator||' )' as ItemSpecificationCreator,
                ee.CreatedOn as ItemSpecificationCreationTime,
                e.Remark
                From Item e, ItemSpecification ee, ItemNature itn, Party sa, Party ca, Party cw, BossUser bu, BossUser bu2
                Where e.TNo = ee.TNo(+)
                  and e.ItemNatureCode = itn.ItemNatureCode(+)
                  and e.StockAccountCode = sa.PartyCode(+)
                  and e.ConsumptionAccountCode = ca.PartyCode(+)
                  and e.CWIPAccountCode = cw.PartyCode(+)
                  and instr(':'||:P9_COMPANY||':',':'||e.CompanyCode||':') > 0
                 -- and e.CompanyCode = :P9_COMPANY
                  and e.ItemType = 'ITEM'
                  and e.Creator = bu.LoginName(+)
                  and ee.Creator = bu2.LoginName(+)
                  --and instr(':'||:P9_ITEMTYPE||':',':'||e.ItemType||':') > 0
                 -- changed on 28-may-2022
                 -- and (:P9_GROUP IS NULL OR instr(':'||:P9_GROUP||':',':'||e.ParentCode||':') > 0 ) 
                  --and (:P9_GROUP) IS NOT NULL
                  and (:P9_EQUIPMENT is null or e.IsEquipment = :P9_EQUIPMENT)
                  and (:P9_SERIAL is null or e.SerialNoRequired = :P9_SERIAL)
                  and (:P9_QUALITY is null or ee.QualityRequired = :P9_QUALITY)
                  and (:P9_WEIGHMENT is null or ee.IsWeighmentRequired = :P9_WEIGHMENT)
                  and ( :P9_GROUP IS NULL
                      or
                      exists (select 1 from (Select ITEMCODE,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                               Level,
                               CONNECT_BY_ROOT itemcode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '->') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From item a
                         Start With parentcode in ( select itemcode from item xx where
                                                    instr(':'||:P9_GROUP||':',':'||xx.ItemCode||':') > 0)
                                                    
                        Connect By parentcode = Prior itemcode
                         Order Siblings By itemcode) x where x.itemcode = e.itemcode
                        )
                  )
                */
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        componentAdvanced {
            emailFromAddress: erp@pbsoil.com
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 20399868812502814
        }

