                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 250
        }
        dataCursor {
            cursor: true
            behavior: smooth
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
        }

        series halfyear-pie-chart (
            name: HalfYear Pie Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select a.FIN_HALF_YEAR_NAME, 
                           a.FIN_HALF_YEAR, 
                    	   Sum(c.TotalAmount) Amount
                      From BI_DateTime a, BI_Srevenue c
                     Where a.Fin_Date = c.CCInvoiceDate
                       And Replace(a.Fin_Year, '-', '') Like nvl(:P193_FINYEAR, '%')
                     Group By a.FIN_HALF_YEAR_NAME, a.FIN_HALF_YEAR
                     Order By 2
                    ```
                pageItemsToSubmit: P193_FINYEAR
            }
            columnMapping {
                label: FIN_HALF_YEAR_NAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P193_FIN_HALFYEAR',&FIN_HALF_YEAR.);
            }
            label {
                show: true
                position: outsideSlice
                displayAs: percentageValue
                fontSize: 10
            }
        )

    )

