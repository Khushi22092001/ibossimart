            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
        }

        series quater-pie-chart (
            name: Quater Pie Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                          a.Fin_Qtr_Name,
                          a.Fin_Qtr,
                          sum(c.TotalAmount)Amount
                    From  BI_DateTime a, BI_Srevenue c
                    Where a.Fin_Date = c.CCInvoiceDate
                      and replace(a.Fin_Year,'-','') like nvl(:P193_FINYEAR,'%')
                      and (:P193_FIN_HALFYEAR IS NULL OR A.FIN_HALF_YEAR = :P193_FIN_HALFYEAR)
                    Group by a.Fin_Qtr_Name,
                             a.Fin_Qtr
                    Order by 2
                    ```
                pageItemsToSubmit: P193_FINYEAR
            }
            columnMapping {
                label: FIN_QTR_NAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P193_FIN_QTR',&FIN_QTR.);
            }
            label {
                show: true
                position: outsideSlice
                displayAs: percentageValue
                fontSize: 10
            }
        )

    )

    region sub-group-customer-revenue (
        name: Sub Group Customer Revenue
        type: chart
