    region revenue-by-halfyearly (
        name: Revenue by HalfYearly
        type: chart
        layout {
            sequence: 30
            parentRegion: @revenue
            slot: subRegions
            startNewRow: false
            column: 5
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
