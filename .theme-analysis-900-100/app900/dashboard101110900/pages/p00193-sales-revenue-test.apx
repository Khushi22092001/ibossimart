        series item-revenue-bar-chart (
            name: Item Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select  TO_CHAR(to_date(:P193_MONTH,'YYYYMM'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(:P193_MONTH,'YYYYMM')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE,B.PARTYCODE, B.PARTYNAME, Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           PARTY B,
                           BI_DateTime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode IS NULL
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       And A.PARTYCODE = B.PARTYCODE
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P193_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P193_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P193_FINYEAR,'%')
                    
                       And  (:P193_SUBGROUP IS NULL OR ( X.root_id = :P193_ITEMGROUP) OR (X.PARENTCODE = :P193_SUBGROUP )  )
                            
                       
                    --   And (&P193_ITEMGROUP Is Null Or
                    --instr(':' || &P193_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By B.PARTYCODE, B.PARTYNAME
                     order by 6 desc
                    
                    
                    ```
                pageItemsToSubmit: [
                    P193_ITEM
                    P193_MONTH
                    P193_QUARTER
                    P193_SUBGROUP
                    P193_ITEMGROUP
                ]
            }
            columnMapping {
                label: PARTYNAME
                value: AMOUNT
            }
            link {
                type: redirectThisApp
                target: {
                    page: 56
                    items: {
                        P56_COMPANY: 1
                        P56_LOCATION: &LOCATIONCODE.
                        P56_DOCTYPE: CHALANCUMINVOICE
                        P56_STATUS: ACTIVE
                        P56_PARTY: &PARTYCODE.
                        P56_FROMDATE: &FROMDATE.
                        P56_TODATE: &TODATE.
                    }
                    clearCache: 56
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region sub-group-revenue (
        name: Sub Group  Revenue
        type: chart
        layout {
            sequence: 100
            parentRegion: @revenue
            slot: subRegions
            column: 1
