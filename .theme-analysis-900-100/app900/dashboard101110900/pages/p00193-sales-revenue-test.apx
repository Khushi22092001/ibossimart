page 193 (
    name: SALES REVENUE - TEST
    alias: SALES-REVENUE-TEST
    title: SALES REVENUE - TEST
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region brand-revenue (
        name: Brand Revenue
        type: chart
        layout {
            sequence: 140
            parentRegion: @revenue
            slot: subRegions
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent9
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
            fontSize: 8
        }

        series brand-revenue-bar-chart (
            name: Brand Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select A.ITEMCODE As ITEMCODE,
                           getitemNAME(A.ITEMCODE) As ItemName,
                           Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           bi_datetime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P193_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P193_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P193_FINYEAR,'%')
                    
                       And (:P193_ITEMGROUP Is Null
                        Or X.ROOT_ID = :P193_ITEMGROUP)
                       And (:P193_ITEM Is Null
                        Or NVL(X.PARENTCODE,X.ITEMCODE) = :P193_ITEM)
                    --   And (&P193_ITEMGROUP Is Null Or
                    --instr(':' || &P193_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By a.itemcode
                    
                    ```
                pageItemsToSubmit: [
                    P193_BRAND
                    P193_ITEMGROUP
                    P193_ITEM
                ]
            }
            columnMapping {
                label: ITEMNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P193_BRAND',&ITEMCODE.);
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

    region item-cutomer-revenue (
        name: Item Cutomer Revenue
        type: chart
        layout {
            sequence: 130
            parentRegion: @revenue
            slot: subRegions
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent10
                t-Region--hiddenOverflow
            ]
        }
        chartLayout {
            height: 400
        }
        multiSeriesChartData {
            sortOrder: valueAsc
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series item-customer-revenue-bar-chart (
            name: Item Customer Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select TO_CHAR(to_date(:P193_MONTH,'YYYYMM'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(:P193_MONTH,'YYYYMM')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE,B.PARTYCODE, B.PARTYNAME, Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           PARTY B,
                           BI_DateTime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       And A.PARTYCODE = B.PARTYCODE
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P193_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P193_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P193_FINYEAR,'%')
                       And (:P193_ITEMGROUP Is Null    Or X.ROOT_ID = :P193_ITEMGROUP)
                       And (:P193_ITEM Is Null Or NVL(X.PARENTCODE,X.ITEMCODE) = :P193_ITEM)
                     Group By B.PARTYCODE, B.PARTYNAME
                     order by 6 desc
                    ```
                pageItemsToSubmit: [
                    P193_ITEM
                    P193_MONTH
                    P193_QUARTER
                ]
            }
            columnMapping {
                label: PARTYNAME
                value: AMOUNT
            }
            link {
                type: redirectThisApp
                target: {
                    page: 56
                    items: {
                        P56_COMPANY: 1
                        P56_DOCTYPE: CHALANCUMINVOICE
                        P56_LOCATION: &LOCATIONCODE.
                        P56_STATUS: ACTIVE
                        P56_FROMDATE: &FROMDATE.
                        P56_TODATE: &TODATE.
                        P56_PARTY: &PARTYCODE.
                    }
                    clearCache: 56
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region item-revenue (
