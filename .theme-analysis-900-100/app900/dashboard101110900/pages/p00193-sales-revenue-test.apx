    dynamicAction change-month (
        name: Change Month
        execution {
            sequence: 50
            eventScope: dynamic
        }
        when {
            selectionType: items
            items: P193_MONTH
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P193_ITEM
                    P193_ITEMGROUP
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @main-group-revenue
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-spec-cutomer-revenue
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-revenue
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @brand-revenue
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT TO_CHAR(TO_DATE(:P193_MONTH,'YYYYMM'),'MON-RRRR') FROM DUAL;
                itemsToSubmit: P193_MONTH
            }
            affectedElements {
                selectionType: items
                items: P193_SELECTEDMONTH
            }
            execution {
                sequence: 60
            }
        )

    )

    dynamicAction clear (
        name: CLEAR
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P193_ITEMGROUP
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P193_SUBGROUP
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click-subgroup (
        name: CLICK SUBGROUP
        execution {
            sequence: 160
        }
        when {
            selectionType: items
            items: P193_SUBGROUP
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sub-group-customer-revenue
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sub-group-revenue
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

