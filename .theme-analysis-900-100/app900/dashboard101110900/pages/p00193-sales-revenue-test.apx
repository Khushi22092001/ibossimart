            position: top
            fontSize: 8
        }

        series item-group-revenue-bar-chart (
            name: Item Group Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select x.root_id,
                           getitemname(x.root_id) As RootName,
                           Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           bi_datetime c,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode IS NULL --= NVL(:P193_SUBGROUP,:P193_ITEMGROUP)
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P193_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P193_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P193_FINYEAR,'%')
                       And  (:P193_SUBGROUP IS NULL OR ( X.root_id = :P193_ITEMGROUP) OR (X.PARENTCODE = :P193_SUBGROUP )  )
                            
                    --   And :P193_ITEMGROUP Is Null
                    --    Or X.ROOT_ID = &P193_ITEMGROUP
                    --   And (&P193_ITEMGROUP Is Null Or
                    --instr(':' || &P193_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By x.root_id
                    ```
                pageItemsToSubmit: [
                    P193_ITEMGROUP
                    P193_ITEM
                ]
            }
            columnMapping {
                seriesName: ROOTNAME
                label: ROOTNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P193_SUBGROUP',&ROOT_ID.);
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

