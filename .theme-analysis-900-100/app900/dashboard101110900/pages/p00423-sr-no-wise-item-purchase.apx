    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select rownum as SlNo,
                	   l.LocationName,
                       pb.PartyBillNo,
                       pb.PartyBillDate,
                       getpartyname(pb.partycode) as PartyName,
                       e.itemname,
                       ee.itemspecificationname,
                 --      po.PurchaseOrderNo,
                       SR.COMPANYSERIALNO As SerialNo,
                       sr.quantity1,
                       b.rate,
                       b.Quantity2,
                       im.ItemMakeName as Description,
                       Case
                         When Nvl(CGSTAMT.AMOUNT, 0) > 0 Then
                          ROUND((CGSTAMT.AMOUNT / B.QUANTITY1) * SR.QUANTITY1,2)
                         Else
                          0
                       End CGSTAMT,
                       Case
                         When Nvl(SGSTAMT.AMOUNT, 0) > 0 Then
                          ROUND((SGSTAMT.AMOUNT / B.QUANTITY1) * SR.QUANTITY1,2)
                         Else
                          0
                       End SGSTAMT,
                       Case
                         When Nvl(IGSTAMT.AMOUNT, 0) > 0 Then
                          ROUND((IGSTAMT.AMOUNT / B.QUANTITY1) * SR.QUANTITY1,2)
                         Else
                          0
                       End IGSTAMT--,
                       --b.Amount,
                       --b.TotalAmount
                       --- total amount
                       
                        
                  From PBPass       a,
                       PBPassDetail b,
                       Location l,
                       PurchaseBill pb,
                       Item e,
                       ItemSpecification ee,
                       ItemMake im,
                       Party p,
                       PurchaseOrder po,
                       (Select AA.TNO,
                               AA.SNO,
                               CC.ITEMCODE,
                               CC.ITEMSPECIFICATIONCODE,
                               DD.COMPANYSERIALNO,
                               DD.QUANTITY1
                          From PBPASSDETAILGRN AA, GRN BB, GRNDETAIL CC, GRNSERIALNO DD
                         Where AA.GRNTNO = BB.TNO
                           And AA.GRNSNO = CC.SNO
                           And AA.GRNTNO = CC.TNO
                           And CC.TNO = DD.TNO
                           And CC.SNO = DD.SNO) SR,
                      (Select V.TNo, v.ModuleTNo, v.VoucherNo, v.VoucherDate
                          From Voucher v
                         Where v.DocTypeCode = 'PURCHASE') vv,
                       (Select V.TNo, v.ModuleTNo, v.VoucherNo, v.VoucherDate
                          From Voucher v
                         Where v.DocTypeCode = 'DEBITNOTE') dv,
                       (Select XX.TNO, XX.SNO, Sum(XX.FOOTERVALUE) As AMOUNT
                          From PBPASSDETAILFOOTER XX
                         Where XX.FOOTERHEADCODE = '.CGST.'
                         Group By XX.TNO, XX.SNO) CGSTAMT,
                       (Select XX.TNO, XX.SNO, Sum(XX.FOOTERVALUE) As AMOUNT
                          From PBPASSDETAILFOOTER XX
                         Where XX.FOOTERHEADCODE = '.SGST.'
                         Group By XX.TNO, XX.SNO) SGSTAMT,
                       (Select XX.TNO, XX.SNO, Sum(XX.FOOTERVALUE) As AMOUNT
                          From PBPASSDETAILFOOTER XX
                         Where XX.FOOTERHEADCODE = '.IGST.'
                         Group By XX.TNO, XX.SNO) IGSTAMT
                 Where a.TNo = b.TNo(+)
                  And a.LocationCode = l.LocationCode(+)
                   And a.PurchaseBillTNo = pb.TNo(+)
                   And b.PurchaseOrderTNo = po.TNo(+)
                   And b.ItemCode = e.ItemCode(+)
                   And b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                   and ee.ItemMakeCode = im.ItemMakeCode(+)
                   And pb.PartyCode = p.PartyCode(+)
                   And a.TNo = vv.ModuleTno(+)
                    And a.TNo = dv.ModuleTNo(+)
                   And B.TNO = SR.TNO(+)
                   And B.SNO = SR.SNO(+)
                   And B.TNO = CGSTAMT.TNO(+)
                   And B.SNO = CGSTAMT.SNO(+)
                   And B.TNO = SGSTAMT.TNO(+)
                   And B.SNO = SGSTAMT.SNO(+)
                   And B.TNO = IGSTAMT.TNO(+)
                   And B.SNO = IGSTAMT.SNO(+)
                  -- And A.TNO = 1223470208
                
                and pb.partybilldate between :P423_FROMDATE and :P423_TODATE
                and ( :P423_COMPANY IS NULL OR instr(':'||:P423_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                and ( :P423_ITEMCATEGORY IS NULL and e.SerialNoRequired = 'YES' or (instr(':'||:P423_ITEMCATEGORY||':',':'||E.ItemCategoryCode||':') > 0 ) )
                and :P423_FROMDATE is not null
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                
                
                
                
                
                
                
                
                
                
                
                /*Select
                i.Tno,
                a.GRNDate,
                b.ItemCode,
                a.CompanyCode,
                a.RefDocNo,
                a.RefDocDate,
                e.PartyName,
                f.ItemName,
                g.ItemSpecificationName,
                b.Amount/aa.Qty as Price,
                c.CompanySerialNo,
                j.IssueNo,
                j.IssueDate,
                j.CostCentreName,
                k.InterUnitTransferNo,
                k.InterUnitTransferDate,
                k.LocationName
                From GRN a, GRNDetail b,GRNSerialNo c, Party e, Item f, ItemSpecification g,
                Inspection h,Stock i,
                (
                Select
                a.Tno,
                count(a.Tno) as Qty
                From GRNSerialNo a
                --Where a.tno = '1222684204'
                group by a.tno
                )aa,
                (
                Select
                a.StockTno,
                c.IssueNo,
                c.IssueDate,
                e.CostCentreName
                From IssueStockStorageDetail a,IssueDetail b, Issue c, IssueCostCentreDetail d, CostCentre e
                Where a.Tno = b.Tno(+)
                and a.Sno = b.Sno(+)
                and b.Tno = c.Tno(+)
                and b.Tno = d.Tno(+)
                and b.Sno = d.Sno(+)
                and d.CostCentreCode = e.CostCentreCode(+))j,
                (
                Select
                a.StockTno,
                e.InterUnitTransferNo,
                e.InterUnitTransferDate,
                f.LocationName
                From CCInvoiceStockStorageDetail a,CCInvoiceDetail c, CCInvoice d, InterUnitTransfer e, Location f
                Where a.Tno = c.Tno
                and a.Sno = c.Sno
                and c.Tno = d.Tno
                and d.InterUnitTransferTno = e.Tno
                and e.LocationCode = f.LocationCode
                and d.DoctypeCode = 'INTERUNITTRANSFER'
                --and d.ccinvoiceno = 'T/DOB/2023/00138';
                )k
                Where a.Tno = b.Tno
                and b.Tno = c.Tno
                and b.Sno = c.Sno
                and a.PartyCode = e.PartyCode
                and b.ItemCode = f.ItemCode
                and b.ItemSpecificationCode = g.ItemSpecificationCode
                and a.Tno = h.GRNTno
                and h.Tno = i.StockModuleTno
                and b.ItemCode = i.ItemCode
                and b.ItemSpecificationCode = i.ItemSpecificationCode
                and a.Tno = aa.Tno
                and i.Tno = j.StockTno
                and i.Tno = k.StockTno(+)
                and f.SerialNoRequired = 'YES'
                --and a.refdocno = '9643902565';
                and a.GRNDate between :P423_FROMDATE and :P423_TODATE
                and ( :P423_COMPANY IS NULL OR instr(':'||:P423_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                and ( :P423_ITEM IS NULL OR instr(':'||:P423_ITEM||':',':'||b.ItemCode||':') > 0 ) 
                and :P423_FROMDATE is not null
                
                
                
                  */
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                  /*Select
                a.Tno,
                a.RefDocNo,
                a.RefDocDate,
                e.PartyName,
                f.ItemName,
                g.ItemSpecificationName,
                d.Amount,
                b.SerialNo,
                j.IssueNo,
                j.IssueDate
                From GRN a, GRNDetail b,PurchaseOrder c, PurchaseOrderDetail d, Party e, Item f, ItemSpecification g,
                (
                Select
                h.GRNTno,
                c.IssueNo,
                c.IssueDate
                From Inspection h, Stock i,IssueStockStorageDetail a,IssueDetail b, Issue c
                Where h.Tno = i.StockModuleTno
                and i.Tno = a.Stocktno
                and a.Tno = b.Tno
                and b.Tno = c.Tno)j
                Where a.Tno = b.Tno
                and a.PurchaseOrderTno = c.Tno
                and c.Tno = d.Tno
                and b.ItemCode = d.ItemCode
                and b.ItemSpecificationCode = d.ItemSpecificationCode
                and a.PartyCode = e.PartyCode
                and d.ItemCode = f.ItemCode
                and d.ItemSpecificationCode = g.ItemSpecificationCode
                and a.Tno = j.GRNTno(+)
                and a.PurchaseOrderTno is not null
                and b.SerialNo is not Null
                and a.GRNDate between :P423_FROMDATE and :P423_TODATE
                and ( :P423_COMPANY IS NULL OR instr(':'||:P423_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                and ( :P423_ITEM IS NULL OR instr(':'||:P423_ITEM||':',':'||d.ItemCode||':') > 0 ) 
                and :P423_FROMDATE is not null;*/
                
                ```
            pageItemsToSubmit: [
                P423_COMPANY
                P423_FROMDATE
                P423_TODATE
                P423_ITEMCATEGORY
                P423_REPORTTYPE
            ]
        }
