    region stock-report (
        name: Stock Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select rownum as SlNo,
                       l.LocationName,
                       pb.PartyBillNo,
                       pb.PartyBillDate,
                       getpartyname(pb.partycode) as PartyName,
                       e.itemname,
                       ee.itemspecificationname,
                 --      po.PurchaseOrderNo,
                       SR.COMPANYSERIALNO As SerialNo,
                       sr.quantity1,
                       b.rate,
                       b.Quantity2,
                       im.ItemMakeName as Description,
                       Case
                         When Nvl(CGSTAMT.AMOUNT, 0) > 0 Then
                          ROUND((CGSTAMT.AMOUNT / B.QUANTITY1) * SR.QUANTITY1,2)
                         Else
                          0
                       End CGSTAMT,
                       Case
                         When Nvl(SGSTAMT.AMOUNT, 0) > 0 Then
                          ROUND((SGSTAMT.AMOUNT / B.QUANTITY1) * SR.QUANTITY1,2)
                         Else
                          0
                       End SGSTAMT,
                       Case
                         When Nvl(IGSTAMT.AMOUNT, 0) > 0 Then
                          ROUND((IGSTAMT.AMOUNT / B.QUANTITY1) * SR.QUANTITY1,2)
                         Else
                          0
                       End IGSTAMT--,
                       --b.Amount,
                       --b.TotalAmount
                       --- total amount
                       
                        
                  From PBPass       a,
                       PBPassDetail b,
                       Location l,
                       PurchaseBill pb,
                       Item e,
                       ItemSpecification ee,
                       ItemMake im,
                       Party p,
                       PurchaseOrder po,
                       (Select AA.TNO,
                               AA.SNO,
                               CC.ITEMCODE,
                               CC.ITEMSPECIFICATIONCODE,
                               DD.COMPANYSERIALNO,
                               DD.QUANTITY1,
                               EE.TNO As COMPONENTSTOCKTNO
                          From PBPASSDETAILGRN AA,
                               GRN             BB,
                               GRNDETAIL       CC,
                               GRNSERIALNO     DD,
                               COMPONENTSTOCK  EE
                         Where AA.GRNTNO = BB.TNO
                           And AA.GRNSNO = CC.SNO
                           And AA.GRNTNO = CC.TNO
                           And CC.TNO = DD.TNO
                           And CC.SNO = DD.SNO
                           And EE.COMPONENTSERIALNO = DD.COMPANYSERIALNO) SR,
                      (Select V.TNo, v.ModuleTNo, v.VoucherNo, v.VoucherDate
                          From Voucher v
                         Where v.DocTypeCode = 'PURCHASE') vv,
                       (Select V.TNo, v.ModuleTNo, v.VoucherNo, v.VoucherDate
                          From Voucher v
                         Where v.DocTypeCode = 'DEBITNOTE') dv,
                       (Select XX.TNO, XX.SNO, Sum(XX.FOOTERVALUE) As AMOUNT
                          From PBPASSDETAILFOOTER XX
                         Where XX.FOOTERHEADCODE = '.CGST.'
                         Group By XX.TNO, XX.SNO) CGSTAMT,
                       (Select XX.TNO, XX.SNO, Sum(XX.FOOTERVALUE) As AMOUNT
                          From PBPASSDETAILFOOTER XX
                         Where XX.FOOTERHEADCODE = '.SGST.'
                         Group By XX.TNO, XX.SNO) SGSTAMT,
                       (Select XX.TNO, XX.SNO, Sum(XX.FOOTERVALUE) As AMOUNT
                          From PBPASSDETAILFOOTER XX
                         Where XX.FOOTERHEADCODE = '.IGST.'
                         Group By XX.TNO, XX.SNO) IGSTAMT
                 Where a.TNo = b.TNo(+)
                  And a.LocationCode = l.LocationCode(+)
                   And a.PurchaseBillTNo = pb.TNo(+)
                   And b.PurchaseOrderTNo = po.TNo(+)
                   And b.ItemCode = e.ItemCode(+)
                   And b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                   and ee.ItemMakeCode = im.ItemMakeCode(+)
                   And pb.PartyCode = p.PartyCode(+)
                   And a.TNo = vv.ModuleTno(+)
                    And a.TNo = dv.ModuleTNo(+)
                   And B.TNO = SR.TNO(+)
                   And B.SNO = SR.SNO(+)
                   And B.TNO = CGSTAMT.TNO(+)
                   And B.SNO = CGSTAMT.SNO(+)
                   And B.TNO = SGSTAMT.TNO(+)
                   And B.SNO = SGSTAMT.SNO(+)
                   And B.TNO = IGSTAMT.TNO(+)
                   And B.SNO = IGSTAMT.SNO(+)
                  -- And A.TNO = 1223470208
                
                and pb.partybilldate between :P423_FROMDATE and :P423_TODATE
                and ( :P423_COMPANY IS NULL OR instr(':'||:P423_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                and ( :P423_ITEMCATEGORY IS NULL and e.SerialNoRequired = 'YES' or (instr(':'||:P423_ITEMCATEGORY||':',':'||E.ItemCategoryCode||':') > 0 ) )
                and :P423_FROMDATE is not null
                
                And Not Exists
                 (Select 1
                          From COMPONENTUSEDSTOCK YY
                         Where YY.COMPONENTSTOCKTNO = SR.COMPONENTSTOCKTNO)
                
                
                
                
                
                
                
                
                
                /*Select
                i.Tno,
                a.GRNDate,
                b.ItemCode,
                a.CompanyCode,
                a.RefDocNo,
                a.RefDocDate,
                e.PartyName,
                f.ItemName,
                g.ItemSpecificationName,
                b.Amount/aa.Qty as Price,
                c.CompanySerialNo,
                j.IssueNo,
                j.IssueDate,
                j.CostCentreName,
                k.InterUnitTransferNo,
                k.InterUnitTransferDate,
                k.LocationName
                From GRN a, GRNDetail b,GRNSerialNo c, Party e, Item f, ItemSpecification g,
                Inspection h,Stock i,
                (
                Select
                a.Tno,
                count(a.Tno) as Qty
                From GRNSerialNo a
                --Where a.tno = '1222684204'
                group by a.tno
                )aa,
                (
                Select
                a.StockTno,
                c.IssueNo,
                c.IssueDate,
                e.CostCentreName
                From IssueStockStorageDetail a,IssueDetail b, Issue c, IssueCostCentreDetail d, CostCentre e
                Where a.Tno = b.Tno(+)
                and a.Sno = b.Sno(+)
                and b.Tno = c.Tno(+)
                and b.Tno = d.Tno(+)
                and b.Sno = d.Sno(+)
                and d.CostCentreCode = e.CostCentreCode(+))j,
                (
                Select
                a.StockTno,
                e.InterUnitTransferNo,
                e.InterUnitTransferDate,
                f.LocationName
                From CCInvoiceStockStorageDetail a,CCInvoiceDetail c, CCInvoice d, InterUnitTransfer e, Location f
                Where a.Tno = c.Tno
                and a.Sno = c.Sno
                and c.Tno = d.Tno
                and d.InterUnitTransferTno = e.Tno
                and e.LocationCode = f.LocationCode
                and d.DoctypeCode = 'INTERUNITTRANSFER'
                --and d.ccinvoiceno = 'T/DOB/2023/00138';
                )k
                Where a.Tno = b.Tno
                and b.Tno = c.Tno
                and b.Sno = c.Sno
                and a.PartyCode = e.PartyCode
