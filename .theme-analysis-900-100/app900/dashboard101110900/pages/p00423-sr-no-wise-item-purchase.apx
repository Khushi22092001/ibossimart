page 423 (
    name: Sr. No  Wise Item Purchase
    alias: SR-NO-WISE-ITEM-PURCHASE
    title: Sr. No  Wise Item Purchase
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region issue-report (
        name: Issue Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                e.LocationName,
                       a.ACCESSORIESMANAGEMENTDATE,
                       D.EQUIPMENTNAME As TruckNo,
                       b.componentserialno As SerialNo,
                       a.sourceposition,
                       a.manufacturemodelcode,
                       e.itemmakename,
                       getitemname(c.itemcode) Itemname,
                       a.sourceequipmenttotalkmreading As kmreading,
                       a.sourceequipmenttotalhrreading As hrreading,
                       c.rate As amount,
                       h.ItemMakeName as Description
                  From ACCESSORIESMANAGEMENT A,
                       COMPONENTSTOCK        B,
                       STOCK                 C,
                       EQUIPMENT             D,
                       ItemMake              e,
                		Item                  f,
                        ItemSpecification     g,
                        ItemMake              h,
                       Location e
                 Where A.COMPONENTSTOCKTNO = B.TNO(+)
                   And B.STOCKTNO = C.TNO(+)
                   And A.SOURCEEQUIPMENTTNO = D.TNO(+)
                   And a.manufacturemakecode = e.itemmakecode(+)
                	 And c.itemcode = f.itemcode(+)
                     and c.ItemSpecificationCode = g.ItemSpecificationCode(+)
                     and g.ItemMakeCode = h.ItemMakeCode(+)
                and f.SerialNoRequired = 'YES'
                and a.LocationCode = e.LocationCode(+)
                --and i.tno = 1228853185;
                and A.ACCESSORIESMANAGEMENTDATE between :P423_FROMDATE and :P423_TODATE
                and ( :P423_COMPANY IS NULL OR instr(':'||:P423_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                and ( :P423_ITEMCATEGORY IS NULL and f.SerialNoRequired = 'YES' or (instr(':'||:P423_ITEMCATEGORY||':',':'||f.ItemCategoryCode||':') > 0 ) )
                and :P423_FROMDATE is not null
                ```
            pageItemsToSubmit: [
                P423_COMPANY
                P423_FROMDATE
                P423_TODATE
                P423_ITEMCATEGORY
                P423_REPORTTYPE
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P423_REPORTTYPE
            value: ISSUE
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 34708242305622004
        }

