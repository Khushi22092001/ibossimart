                    column: QUANTITY1
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: Basic Amount
                aggregate {
                    column: AMOUNT
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 3
                }
