        savedReport 103539 (
            visibility: alternativeDefault
            name: Group By Item Category Item
            view {
                chart: true
                groupBy: true
                default: groupBy
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 21
            )

            displayColumn CCINVOICEDATE (
                sequence: 3
            )

            displayColumn CCINVOICENO (
                sequence: 1
            )

            displayColumn CGST (
                sequence: 22
            )

            displayColumn COMPONENTSERIALNO (
                sequence: 30
            )

            displayColumn CONSIGNEE (
                sequence: 5
            )

            displayColumn CREATIONTIME (
                sequence: 29
            )

            displayColumn CREATOR (
                sequence: 28
            )

            displayColumn DESCRIPTION (
                sequence: 16
            )

            displayColumn FREIGHTRATE (
                sequence: 12
            )

            displayColumn FREIGHTTYPENAME (
                sequence: 11
            )

            displayColumn FREIGHTUNITCODE (
                sequence: 13
            )

            displayColumn IGST (
                sequence: 24
            )

            displayColumn ITEM (
                sequence: 14
            )

            displayColumn ITEMCATEGORYNAME (
                sequence: 17
            )

            displayColumn ITEMSPECIFICATIONNAME (
                sequence: 15
            )

            displayColumn LORRYDATE (
                sequence: 10
            )

            displayColumn LORRYNO (
                sequence: 9
            )

            displayColumn OTHERAMOUNT (
                sequence: 26
            )

            displayColumn PARTYNAME (
                sequence: 4
            )

            displayColumn QUANTITY1 (
                sequence: 19
            )

            displayColumn RATE (
                sequence: 20
            )

            displayColumn ROWNUM (
                sequence: 2
            )

            displayColumn SALESORDERNO (
                sequence: 7
            )

            displayColumn SGST (
                sequence: 23
            )

            displayColumn TCS (
                sequence: 25
            )

            displayColumn TOTALAMOUNT (
                sequence: 27
            )

            displayColumn TRANSPORTER (
                sequence: 6
            )

            displayColumn UOM (
                sequence: 18
            )

            displayColumn VEHICLENO (
                sequence: 8
            )

            sort (
                column: ROWNUM
                sort {
                    sequence: 1
                }
            )

            sort (
                column: CCINVOICEDATE
                sort {
                    sequence: 2
                }
            )

            sort (
                column: CCINVOICENO
                sort {
                    sequence: 3
                }
            )

            sort (
                column: PARTYNAME
                sort {
                    sequence: 4
                }
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: CGST
            )

            aggregate (
                column: SGST
            )

            aggregate (
                column: IGST
            )

            aggregate (
                column: TCS
            )

            aggregate (
                column: OTHERAMOUNT
            )

            aggregate (
                column: TOTALAMOUNT
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                function: count
                column: ROWNUM
            )

            filter ir-condition (
                column: ITEM
                operator: notIn
                value: RB FATTY ACID ~ LOOSE,RB WAX ~ BAG,SPENT EARTH ~ .
            )

            filter ir-condition-2 (
                column: ITEMCATEGORYNAME
                operator: isNotNull
            )

            controlBreak (
                column: ITEMCATEGORYNAME
                layout {
                    sequence: 1
                }
            )

            controlBreak (
                column: ITEM
                layout {
                    sequence: 2
                }
            )

            chart {
                type: pie
                label: ITEM
                value: QUANTITY1
                valueAggregation: sum
            }

            groupByColumn (
                column: ITEMCATEGORYNAME
                layout {
                    sequence: 1
                }
            )

            groupByColumn (
                column: ITEM
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: Total No of Invoice
                aggregate {
                    function: count
                    column: CCINVOICENO
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990
                }
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Quantity
