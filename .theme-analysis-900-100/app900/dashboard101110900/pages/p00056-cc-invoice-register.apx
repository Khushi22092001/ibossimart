        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      e.ItemName||' ( '||e.ItemCode||' )' as d,
                      e.ItemCode r
                From DespatchAdviceDetail a, Item e
                Where a.ItemCode = e.ItemCode
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @cc-invoice-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 75
            valuePlaceholder: Material
        }
    )

