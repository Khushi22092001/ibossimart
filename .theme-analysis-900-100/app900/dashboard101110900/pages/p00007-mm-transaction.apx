page 7 (
    name: Material Management Transaction
    alias: MM-TRANSACTION
    title: Material Management Transactions
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region transactions (
        name: Transactions
        type: list
        source {
            list: @material-management-transaction-list
        }
        layout {
            sequence: 10
            slot: body
            columnCssClasses: hspl-module-tiles
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: Transaction
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/media-list
            templateOptions: [
                #DEFAULT#
                u-colors
                t-MediaList--cols t-MediaList--3cols
                t-MediaList--iconsRounded
            ]
        }
    )

)

