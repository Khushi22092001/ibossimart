page 284 (
    name: Maintenance Report 2
    alias: MAINTENANCE-REPORT-2
    title: Maintenance Report 2
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenance-report (
        name: Maintenance Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.*,
                ROWNUM AS SERIALNO,
                NVL(b.BreakDown,0) as "Break Down",
                (a.NoofEquipment - NVL(b.BreakDown,0)) as "On Road" From
                (Select 
                a.EquipmentGroupName,
                a.EquipmentGroupCode,
                Count(Distinct(b.EquipmentName)) as NoofEquipment
                from EquipmentGroup a ,  Equipment b  
                where a.EquipmentGroupCode = b.EquipmentGroupCode(+)
                -- Added on 01-nov-23
                and B.equipmenttypecode  != 'COMPONENT'
                and (:P284_LOCATION IS NULL OR instr(':'||:P284_LOCATION||':',':'||b.LocationCode||':') > 0)
                and (:P284_EQUIPMENTGROUP IS NULL OR instr(':'||:P284_EQUIPMENTGROUP||':',':'||b.EquipmentGroupCode||':') > 0)
                Group by EquipmentGroupName, a.EquipmentGroupCode ) a, 
                (
                Select
                Sum (a.BreakDown) as BreakDown,
                a.EquipmentGroupCode
                From
                (
                Select 
                Case When 
                Sum(a.BreakDown) > 0 Then 1 else 0 end as BreakDown,
                a.EquipmentGroupCode,
                a.Tno
                
                From
                (
                      Select 
                          b.Tno,
                      Case When
                              b.BreakDownDateAndTime is Not null Then 1
                          else 0 end as BreakDown,
                          b.MaintenanceRequestDate,
                          a.EquipmentGroupCode
                      From Equipment a, MaintenanceRequest b,  EquipmentMaintenanceOrder c, MaintenanceOrderCompletion d
                      Where a.Tno = b.EquipmentTno(+)
                        and b.MaintenanceTypecode = 'BM'
                        -- Added on 01-nov-23
                        and a.equipmenttypecode  != 'COMPONENT'
                        and b.Tno = c.MaintenanceRequestTno(+)
                        and b.EquipmentTno = c.EquipmentTno(+)
                        and c.Tno = d.EquipmentMaintenanceOrderTno(+)
                        and c.EquipmentTno = d.EquipmentTno(+)
                        And (Trunc(d.breakdowncompletiondate) Is Null Or
                               Trunc(d.breakdowncompletiondate) > :P284_ONDATE)
                        and b.MaintenanceRequestDate >= :P284_ONDATE
                        and (:P284_LOCATION IS NULL OR instr(':'||:P284_LOCATION||':',':'||a.LocationCode||':') > 0)
                        and (:P284_EQUIPMENTGROUP IS NULL OR instr(':'||:P284_EQUIPMENTGROUP||':',':'||a.EquipmentGroupCode||':') > 0)
                ) a
                Group by a.EquipmentGroupCode, a.Tno) a 
                Group by a.EquipmentGroupCode) b
                where a.EquipmentGroupCode = b.EquipmentGroupCode(+)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 14699484097236612
        }

        savedReport 151386 (
            visibility: primary
            view {
                default: grid
                settingsAreaExpanded: false
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @SERIALNO
                layout {
                    width: 110.1125
                    sequence: 1
                }
            )

            displayColumn (
                column: @EQUIPMENTGROUPNAME
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @EQUIPMENTGROUPCODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @NOOFEQUIPMENT
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @"Break Down"
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @"On Road"
                layout {
                    sequence: 6
                }
            )

            sort (
                column: @SERIALNO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            aggregate count (
                column: @SERIALNO
                function: count
                showGrandTotal: true
            )

            aggregate sum (
                column: @NOOFEQUIPMENT
            )

            aggregate sum-2 (
                column: @"Break Down"
                showGrandTotal: true
            )

            aggregate sum-3 (
                column: @"On Road"
                showGrandTotal: true
            )

        )

        column "Break Down" (
            type: numberField
            heading {
                heading: Break Down
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: Break Down
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column EQUIPMENTGROUPCODE (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: EQUIPMENTGROUPCODE
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column EQUIPMENTGROUPNAME (
            type: textarea
            heading {
                heading: Equipment Group Name
            }
            layout {
                sequence: 10
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: EQUIPMENTGROUPNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column NOOFEQUIPMENT (
            type: numberField
            heading {
                heading: No of Equipment
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                databaseColumn: NOOFEQUIPMENT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column "On Road" (
            type: numberField
            heading {
                heading: On Road
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: On Road
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SERIALNO (
            type: numberField
            heading {
                heading: Serial No
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: SERIALNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }
    )

    pageItem P284_EQUIPMENTGROUP (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: "Equipment Group "
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select EquipmentGroupName D,
                EquipmentGroupCode R    
                 from
                 EquipmentGroup;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @maintenance-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Equipment Group Name
        }
    )

    pageItem P284_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select LocationName D,
                LocationCode R
                From Location;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @maintenance-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Location Name
        }
    )

    pageItem P284_ONDATE (
        type: datePicker
        label {
            label: On Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @maintenance-report
            slot: regionBody
            alignment: left
