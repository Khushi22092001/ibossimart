page 136 (
    name: ESIC Challan Detail
    alias: ESIC-CHALLAN-DETAIL
    title: ESIC Challan Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region esic-challan (
        name: "ESIC Challan "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region esic-challan-detail (
        name: ESIC Challan Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.EmpID,
                       b.EmployeeName,
                       c.EsicAccountNo,
                       b.GrossEar,
                       b.PD As paiddays,
                       b.EARNEDESICEMPLOYEECONTRIBUTION As employeecontribution,
                       b.EARNEDESICCOMPCONTRIBUTION     As companycontribution,
                       (b.EARNEDESICEMPLOYEECONTRIBUTION + b.EARNEDESICCOMPCONTRIBUTION) AS TOTALCONTRIBUTION
                  From esichallan a, salaryenginedetail b, Employee c
                 Where a.formonth = b.SalaryFromDate
                   And b.EmployeeCode = c.EmployeeCode
                   And Nvl(b.EARNEDESICEMPLOYEECONTRIBUTION, 0) > 0
                   and ( A.TNO = :P136_TNO
                        OR
                        (
                            A.formonth between :P136_FROMDATE and :P136_TODATE     
                            and instr(':'||:P136_COMPANY||':',':'||B.CompanyCode||':') > 0
                            and instr(':'||:P136_LOCATION||':',':'||B.LocationCode||':') > 0
                            and ( :P136_EMPLOYEE IS NULL OR instr(':'||:P136_EMPLOYEE||':',':'||B.EmployeeCode||':') > 0 ) 
                            and ( :P136_DEPARTMENT IS NULL OR instr(':'||:P136_DEPARTMENT||':',':'||getemployeedepartmentcode(B.EmployeeCode,A.formonth)||':') > 0 ) 
                            and ( :P136_DESIGNATION IS NULL OR instr(':'||:P136_DESIGNATION||':',':'||getemployeedesignationcode(B.EmployeeCode,A.formonth)||':') > 0 ) 
                        )
                  )
                 Order By 2
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 100000
        }
        actionsMenu {
            chart: false
            groupBy: false
            pivot: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        heading {
            fixedTo: region
            maxReportHeight: 340
        }
        advanced {
            savedReportMappingIdentifier: 20615424493013478
        }

