page 515 (
    name: Date Wise Actual Stock Detail
    alias: DATE-WISE-ACTUAL-STOCK-DETAIL
    title: Date Wise Actual Stock  Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region date-wise-actual-stock-testt (
        name: Date Wise Actual Stock Testt
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With
                -- Calendar of days
                DT As
                 (Select X.DAYDATE
                    From DATELIST X
                   Where X.DAYDATE Between :P515_FROMDATE And :P515_TODATE),
                
                -- Stock in (qty + amt) during range
                STK As
                 (Select STOCKDATE,
                         itemcode,
                         ROUND(Sum(stockquantity1), 3) As STOCKQUANTITYA,
                         ROUND(Sum(amount), 2) As STOCKAMOUNTA,
                         0 AS STOCKQUANTITYB,
                         0 AS STOCKAMOUNTB
                    From stock bb
                   Where bb.stockdate Between :P515_FROMDATE And :P515_TODATE
                     AND BB.STOCKMODULECODE != 'ITEMOPENING'
                     AND BB.PANEL = 'A'
                   Group By STOCKDATE, itemcode
                   UNION ALL
                   Select STOCKDATE,
                         itemcode,
                         0,
                         0,
                         ROUND(Sum(stockquantity1), 3) As STOCKQUANTITYB,
                         ROUND(Sum(amount), 2) As STOCKAMOUNTB
                    From stock bb
                   Where bb.stockdate Between :P515_FROMDATE And :P515_TODATE
                     AND BB.STOCKMODULECODE != 'ITEMOPENING'
                     AND BB.PANEL = 'B'
                   Group By STOCKDATE, itemcode),
                
                -- Stock used (qty + amt) during range
                USTK As
                 (Select bb.usedstockdate As USEDSTOCKDATE,
                         aa.itemcode,
                         ROUND(Sum(bb.usedstockquantity1), 3) As USEDSTOCKQUANTITYA,
                         ROUND(Sum(aa.rate * bb.usedstockquantity1), 2) As USEDAMOUNTA,
                         0 As USEDSTOCKQUANTITYB,
                         0 As USEDAMOUNTB
                    From stock aa
                    Join usedstock bb
                      On aa.tno = bb.stocktno
                   Where bb.usedstockdate Between :P515_FROMDATE And :P515_TODATE
                   And bb.Panel = 'A'
                   Group By bb.usedstockdate, aa.itemcode
                   UNION ALL
                   Select bb.usedstockdate As USEDSTOCKDATE,
                         aa.itemcode,
                         0,
                         0,
                         ROUND(Sum(bb.usedstockquantity1), 3) As USEDSTOCKQUANTITYB,
                         ROUND(Sum(aa.rate * bb.usedstockquantity1), 2) As USEDAMOUNTB
                    From stock aa
                    Join usedstock bb
                      On aa.tno = bb.stocktno
                   Where bb.usedstockdate Between :P515_FROMDATE And :P515_TODATE
                   And bb.Panel = 'B'
                   Group By bb.usedstockdate, aa.itemcode),
                
                -- Physical transactions (qty + amt)
                PHY As
                 (Select d.TransactionDate,
                         d.physicalgapitemcode,
                         ROUND(Sum(d.stockquantity1), 3) As PHYSTOCKQUANTITY,
                         ROUND(Sum(d.stockamount), 2) As PHYSTOCKAMOUNT,
                         ROUND(Sum(d.usedstockquantity1), 3) As PHYUSEDSTOCKQUANTITY,
                         ROUND(Sum(d.usedstockamount), 2) As PHYUSEDAMOUNT
                    From physicalgapitemtransaction d
                   Where d.transactiondate Between :P515_FROMDATE And :P515_TODATE
                   Group By d.TransactionDate, d.physicalgapitemcode),
                
                -- Item master (optional filter by item)
                IT As
                 (Select ITEMCODE, ITEMNAME, PHYSICALGAPITEMCODE
                    From ITEM X
                   Where X.PHYSICALGAPITEMCODE Is Not Null
                     And (:P515_ITEM Is Null Or X.ITEMCODE = :P515_ITEM)),
                
                -- Opening balance before start date
                OPENBAL As
                 (Select itemcode,
                         ROUND(Sum(in_qty - out_qty), 3) As OPENING_BAL_QTY,
                         ROUND(Sum(in_amt - out_amt), 2) As OPENING_BAL_AMT
                    From (Select bb.itemcode,
                                 Sum(bb.stockquantity1) As in_qty,
                                 0 As out_qty,
                                 Sum(amount) As in_amt,
                                 0 As out_amt
                            From stock bb
                           Where bb.stockdate <= :P515_FROMDATE
                             AND BB.STOCKMODULECODE='ITEMOPENING'
                           Group By bb.itemcode
                          
                          Union All
                          Select aa.itemcode,
                                 0,
                                 Sum(bb.usedstockquantity1),
                                 0,
                                 Sum(aa.rate * bb.usedstockquantity1)
                            From stock aa
                            Join usedstock bb
                              On aa.tno = bb.stocktno
                           Where bb.usedstockdate < :P515_FROMDATE
                           Group By aa.itemcode
                          
                          Union All
                          Select d.physicalgapitemcode,
                                 Sum(d.stockquantity1),
                                 Sum(d.usedstockquantity1),
                                 Sum(d.stockamount),
                                 Sum(d.usedstockamount)
                            From physicalgapitemtransaction d
                           Where d.transactiondate < :P515_FROMDATE
                           Group By d.physicalgapitemcode)
                   Group By itemcode),
                
                -- Daily movements (qty + amt)
                TXN As
                 (Select DT.DAYDATE,
                         IT.ITEMCODE,
                         IT.ITEMNAME,
                         COALESCE(STK.STOCKQUANTITYA, 0) As STOCKQUANTITYA,
                         COALESCE(STK.STOCKQUANTITYB, 0) As STOCKQUANTITYB,        
                         COALESCE(STK.STOCKAMOUNTA, 0) As STOCKAMOUNTA,
                         COALESCE(STK.STOCKAMOUNTB, 0) As STOCKAMOUNTB,   
                         COALESCE(USTK.USEDSTOCKQUANTITYA, 0) As USEDSTOCKQUANTITYA,
                         COALESCE(USTK.USEDAMOUNTA, 0) As USEDAMOUNTA,
                         COALESCE(USTK.USEDSTOCKQUANTITYB, 0) As USEDSTOCKQUANTITYB,
                         COALESCE(USTK.USEDAMOUNTB, 0) As USEDAMOUNTB,
                         COALESCE(PHY.PHYSTOCKQUANTITY, 0) As PHYSTOCKQUANTITY,
                         COALESCE(PHY.PHYSTOCKAMOUNT, 0) As PHYSTOCKAMOUNT,
                         COALESCE(PHY.PHYUSEDSTOCKQUANTITY, 0) As PHYUSEDSTOCKQUANTITY,
                         COALESCE(PHY.PHYUSEDAMOUNT, 0) As PHYUSEDAMOUNT
                    From DT
                   Cross Join IT
                    Left Join STK
                      On IT.ITEMCODE = STK.ITEMCODE
                     And DT.DAYDATE = STK.STOCKDATE
                    Left Join USTK
                      On IT.ITEMCODE = USTK.ITEMCODE
                     And DT.DAYDATE = USTK.USEDSTOCKDATE
                    Left Join PHY
                      On IT.PHYSICALGAPITEMCODE = PHY.PHYSICALGAPITEMCODE
                     And DT.DAYDATE = PHY.TransactionDate),
                
                -- Running balances (qty + amt)
                TXN_BAL As
                 (Select t.DAYDATE,
                         t.ITEMCODE,
                         t.ITEMNAME,
                         t.STOCKQUANTITYA,
                         t.STOCKQUANTITYB,         
                         t.STOCKAMOUNTA,
                         t.STOCKAMOUNTB,        
                         t.PHYSTOCKQUANTITY,
                         t.PHYSTOCKAMOUNT,
                         t.USEDSTOCKQUANTITYA,
                         t.USEDAMOUNTA,
                         t.USEDSTOCKQUANTITYB,
                         t.USEDAMOUNTB,
                         t.PHYUSEDSTOCKQUANTITY,
                         t.PHYUSEDAMOUNT,
                         ROUND(NVL(ob.OPENING_BAL_QTY, 0) +
                               Sum(t.STOCKQUANTITYA + t.STOCKQUANTITYB + t.PHYSTOCKQUANTITY -
                                   t.USEDSTOCKQUANTITYA - t.USEDSTOCKQUANTITYB - t.PHYUSEDSTOCKQUANTITY)
                               OVER(Partition By t.ITEMCODE Order By t.DAYDATE
                                    ROWS Between UNBOUNDED PRECEDING And Current Row),
                               3) As CLOSING_QTY,
                         ROUND(NVL(ob.OPENING_BAL_AMT, 0) +
                               Sum(t.STOCKAMOUNTA + t.STOCKAMOUNTB +  t.PHYSTOCKAMOUNT - t.USEDAMOUNTA - t.USEDAMOUNTA -
                                   t.PHYUSEDAMOUNT)
                               OVER(Partition By t.ITEMCODE Order By t.DAYDATE
                                    ROWS Between UNBOUNDED PRECEDING And Current Row),
                               2) As CLOSING_AMT
                    From TXN t
                    Left Join OPENBAL ob
                      On t.ITEMCODE = ob.ITEMCODE)
                
                -- Final output
                Select DAYDATE,
                       TO_CHAR(DAYDATE,'DD-MM-RRRR HH24:MI:SS') AS DAYDATESS,
                       ITEMCODE,
                       ITEMNAME,
                       -- Opening = previous day closing or opening balance if first day
                       ROUND(LAG(CLOSING_QTY,
                                 1,
                                 NVL((Select OPENING_BAL_QTY
                                       From OPENBAL ob
                                      Where ob.ITEMCODE = tx.ITEMCODE),
                                     0)) OVER(Partition By ITEMCODE Order By DAYDATE),
                             3) As OPENING_QTY,
                       STOCKQUANTITYA,
                       STOCKQUANTITYB,         
                       STOCKAMOUNTA,
                       STOCKAMOUNTB, 
                       PHYSTOCKQUANTITY,
                       USEDSTOCKQUANTITYA,
                       USEDSTOCKQUANTITYB,
                       PHYUSEDSTOCKQUANTITY,
                       CLOSING_QTY,
                       ROUND(LAG(CLOSING_AMT,
                                 1,
                                 NVL((Select OPENING_BAL_AMT
                                       From OPENBAL ob
                                      Where ob.ITEMCODE = tx.ITEMCODE),
                                     0)) OVER(Partition By ITEMCODE Order By DAYDATE),
                             2) As OPENING_AMT,
                       PHYSTOCKAMOUNT,
                       USEDAMOUNTA,
                       USEDAMOUNTB,       
                       PHYUSEDAMOUNT,
                       CLOSING_AMT
                  From TXN_BAL tx
                  ;
                ```
            pageItemsToSubmit: [
                P515_FROMDATE
                P515_TODATE
                P515_ITEM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
