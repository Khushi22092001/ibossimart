    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH
                -- Calendar of days
                DT AS (
                    SELECT X.DAYDATE
                      FROM DATELIST X
                     WHERE X.DAYDATE BETWEEN :P515_FROMDATE AND :P515_TODATE
                ),
                
                -- Item master
                IT AS (
                    SELECT ITEMCODE, ITEMNAME, PHYSICALGAPITEMCODE
                      FROM ITEM X
                     WHERE X.PHYSICALGAPITEMCODE IS NOT NULL
                       AND (:P515_ITEM IS NULL OR X.ITEMCODE = :P515_ITEM)
                ),
                
                -- Opening balance before start date
                OPENBAL AS (
                    SELECT ITEMCODE,
                           ROUND(SUM(IN_QTY - OUT_QTY), 3) AS OPENING_QTY
                      FROM (
                            SELECT BB.ITEMCODE,
                                   SUM(BB.STOCKQUANTITY1) AS IN_QTY,
                                   0 AS OUT_QTY
                              FROM STOCK BB
                             WHERE BB.STOCKDATE <= :P515_FROMDATE
                               AND BB.STOCKMODULECODE = 'ITEMOPENING'
                             GROUP BY BB.ITEMCODE
                
                            UNION ALL
                            SELECT AA.ITEMCODE,
                                   0,
                                   SUM(BB.USEDSTOCKQUANTITY1)
                              FROM STOCK AA
                              JOIN USEDSTOCK BB ON AA.TNO = BB.STOCKTNO
                             WHERE BB.USEDSTOCKDATE < :P515_FROMDATE
                             GROUP BY AA.ITEMCODE
                
                            UNION ALL
                            SELECT D.PHYSICALGAPITEMCODE,
                                   SUM(D.STOCKQUANTITY1),
                                   SUM(D.USEDSTOCKQUANTITY1)
                              FROM PHYSICALGAPITEMTRANSACTION D
                             WHERE D.TRANSACTIONDATE < :P515_FROMDATE
                             GROUP BY D.PHYSICALGAPITEMCODE
                          )
                     GROUP BY ITEMCODE
                ),
                
                -- Stock In (Panel A, B)
                STK AS (
                    SELECT STOCKDATE,
                           ITEMCODE,
                           SUM(CASE WHEN PANEL = 'A' THEN STOCKQUANTITY1 ELSE 0 END) AS IN_A,
                           SUM(CASE WHEN PANEL = 'B' THEN STOCKQUANTITY1 ELSE 0 END) AS IN_B
                      FROM STOCK BB
                     WHERE BB.STOCKDATE BETWEEN :P515_FROMDATE AND :P515_TODATE
                       AND BB.STOCKMODULECODE != 'ITEMOPENING'
                     GROUP BY STOCKDATE, ITEMCODE
                ),
                
                -- Stock Used (Panel A, B)
                USTK AS (
                    SELECT BB.USEDSTOCKDATE AS TXNDATE,
                           AA.ITEMCODE,
                           SUM(CASE WHEN BB.PANEL = 'A' THEN BB.USEDSTOCKQUANTITY1 ELSE 0 END) AS OUT_A,
                           SUM(CASE WHEN BB.PANEL = 'B' THEN BB.USEDSTOCKQUANTITY1 ELSE 0 END) AS OUT_B
                      FROM STOCK AA
                      JOIN USEDSTOCK BB ON AA.TNO = BB.STOCKTNO
                     WHERE BB.USEDSTOCKDATE BETWEEN :P515_FROMDATE AND :P515_TODATE
                     GROUP BY BB.USEDSTOCKDATE, AA.ITEMCODE
                ),
                
                -- Physical adjustments (in/out)
                PHY AS (
                    SELECT D.TRANSACTIONDATE,
                           D.PHYSICALGAPITEMCODE AS ITEMCODE,
                           SUM(D.STOCKQUANTITY1) AS IN_PHY,
                           SUM(D.USEDSTOCKQUANTITY1) AS OUT_PHY
                      FROM PHYSICALGAPITEMTRANSACTION D
                     WHERE D.TRANSACTIONDATE BETWEEN :P515_FROMDATE AND :P515_TODATE
                     GROUP BY D.TRANSACTIONDATE, D.PHYSICALGAPITEMCODE
                ),
                
                -- Combine daily data (ensures one record per item per date)
                TXN AS (
                    SELECT DT.DAYDATE,
                           IT.ITEMCODE,
                           IT.ITEMNAME,
                           NVL(STK.IN_A, 0) AS IN_A,
                           NVL(STK.IN_B, 0) AS IN_B,
                           NVL(USTK.OUT_A, 0) AS OUT_A,
                           NVL(USTK.OUT_B, 0) AS OUT_B,
                           NVL(PHY.IN_PHY, 0) AS IN_PHY,
                           NVL(PHY.OUT_PHY, 0) AS OUT_PHY
                      FROM DT
                     CROSS JOIN IT
                      LEFT JOIN STK  ON IT.ITEMCODE = STK.ITEMCODE  AND DT.DAYDATE = STK.STOCKDATE
                      LEFT JOIN USTK ON IT.ITEMCODE = USTK.ITEMCODE AND DT.DAYDATE = USTK.TXNDATE
                      LEFT JOIN PHY  ON IT.PHYSICALGAPITEMCODE = PHY.ITEMCODE AND DT.DAYDATE = PHY.TRANSACTIONDATE
                ),
                
                -- Calculate daily closing per panel (running totals)
                TXN_BAL AS (
                    SELECT
                        T.DAYDATE,
                        T.ITEMCODE,
                        T.ITEMNAME,
                        T.IN_A,
                        T.OUT_A,
                        T.IN_B,
                        T.OUT_B,
                        T.IN_PHY,
                        T.OUT_PHY,
                        -- Cumulative closing per panel
                        ROUND(NVL(OB.OPENING_QTY, 0) +
                              SUM(T.IN_A - T.OUT_A)
                              OVER (PARTITION BY T.ITEMCODE ORDER BY T.DAYDATE ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 3) AS CLOSING_A,
                        ROUND(NVL(OB.OPENING_QTY, 0) +
                              SUM(T.IN_B - T.OUT_B)
                              OVER (PARTITION BY T.ITEMCODE ORDER BY T.DAYDATE ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 3) AS CLOSING_B,
                        ROUND(NVL(OB.OPENING_QTY, 0) +
                              SUM(T.IN_PHY - T.OUT_PHY)
                              OVER (PARTITION BY T.ITEMCODE ORDER BY T.DAYDATE ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 3) AS CLOSING_PHY
                      FROM TXN T
                      LEFT JOIN OPENBAL OB ON T.ITEMCODE = OB.ITEMCODE
                )
                
                -- Final output: one record per day per item
                SELECT
                    DAYDATE,
                    ITEMCODE,
                    ITEMNAME,
                
                    -- PANEL A
                    ROUND(LAG(CLOSING_A, 1,
                              NVL((SELECT OPENING_QTY FROM OPENBAL OB WHERE OB.ITEMCODE = TX.ITEMCODE), 0))
                          OVER (PARTITION BY ITEMCODE ORDER BY DAYDATE), 3) AS OPENING_A,
                    IN_A, OUT_A, CLOSING_A,
                
                    -- PANEL B
                    ROUND(LAG(CLOSING_B, 1,
                              NVL((SELECT OPENING_QTY FROM OPENBAL OB WHERE OB.ITEMCODE = TX.ITEMCODE), 0))
                          OVER (PARTITION BY ITEMCODE ORDER BY DAYDATE), 3) AS OPENING_B,
                    IN_B, OUT_B, CLOSING_B,
                
                    -- PHYSICAL
                    ROUND(LAG(CLOSING_PHY, 1,
                              NVL((SELECT OPENING_QTY FROM OPENBAL OB WHERE OB.ITEMCODE = TX.ITEMCODE), 0))
                          OVER (PARTITION BY ITEMCODE ORDER BY DAYDATE), 3) AS OPENING_PHY,
                    IN_PHY, OUT_PHY, CLOSING_PHY
                
                FROM TXN_BAL TX
                ORDER BY ITEMCODE, DAYDATE;
                
                ```
        }
