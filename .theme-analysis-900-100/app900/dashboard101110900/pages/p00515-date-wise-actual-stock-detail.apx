        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    pageItem P515_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P515_ITEM (
        type: popupLov
        label {
            label: Item
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ITEMNAME, ITEMCODE FROM ITEM A
                WHERE A.PHYSICALGAPITEMCODE IS NOT NULL 
                ORDER BY 1
                ```
        }
        layout {
            sequence: 30
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P515_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        settings {
            minDate: item
            minItem: P515_FROMDATE
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: &nbsp Refresh
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            cssClasses: [
                fa
                fa-refresh
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new-2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

