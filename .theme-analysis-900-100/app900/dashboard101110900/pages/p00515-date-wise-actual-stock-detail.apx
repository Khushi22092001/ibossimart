    region new-2 (
        name: New
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH
                -- 📅 Calendar of days
                DT AS (
                    SELECT X.DAYDATE
                      FROM DATELIST X
                     WHERE X.DAYDATE BETWEEN :P515_FROMDATE AND :P515_TODATE
                ),
                
                -- 🧾 Item master
                IT AS (
                    SELECT ITEMCODE, ITEMNAME, PHYSICALGAPITEMCODE
                      FROM ITEM
                     WHERE PHYSICALGAPITEMCODE IS NOT NULL
                       AND (:P515_ITEM IS NULL OR ITEMCODE = :P515_ITEM)
                ),
                
                -- 🧮 Opening before start date (includes ITEMOPENING + pre-date txns)
                OPENBAL AS (
                    SELECT 
                        X.ITEMCODE,
                        ROUND(SUM(CASE WHEN X.PANEL='A' THEN X.IN_QTY - X.OUT_QTY ELSE 0 END),3) AS OPEN_QTY_A,
                        ROUND(SUM(CASE WHEN X.PANEL='B' THEN X.IN_QTY - X.OUT_QTY ELSE 0 END),3) AS OPEN_QTY_B,
                        ROUND(SUM(CASE WHEN X.PANEL='A' THEN X.IN_AMT - X.OUT_AMT ELSE 0 END),2) AS OPEN_AMT_A,
                        ROUND(SUM(CASE WHEN X.PANEL='B' THEN X.IN_AMT - X.OUT_AMT ELSE 0 END),2) AS OPEN_AMT_B
                    FROM (
                        SELECT ITEMCODE, PANEL,
                               SUM(STOCKQUANTITY1) AS IN_QTY, 0 AS OUT_QTY,
                               SUM(AMOUNT) AS IN_AMT, 0 AS OUT_AMT
                          FROM STOCK
                         WHERE STOCKDATE <= :P515_FROMDATE
                           AND STOCKMODULECODE = 'ITEMOPENING'
                         GROUP BY ITEMCODE, PANEL
                        UNION ALL
                        SELECT ITEMCODE, PANEL,
                               SUM(STOCKQUANTITY1) AS IN_QTY, 0, SUM(AMOUNT), 0
                          FROM STOCK
                         WHERE STOCKDATE < :P515_FROMDATE
                           AND STOCKMODULECODE != 'ITEMOPENING'
                         GROUP BY ITEMCODE, PANEL
                        UNION ALL
                        SELECT AA.ITEMCODE, BB.PANEL,
                               0, SUM(BB.USEDSTOCKQUANTITY1), 0,
                               SUM(AA.RATE * BB.USEDSTOCKQUANTITY1)
                          FROM STOCK AA
                          JOIN USEDSTOCK BB ON AA.TNO = BB.STOCKTNO
                         WHERE BB.USEDSTOCKDATE < :P515_FROMDATE
                         GROUP BY AA.ITEMCODE, BB.PANEL
                    ) X
                   GROUP BY X.ITEMCODE
                ),
                
                -- ⚖️ Physical opening
                OPENPHY AS (
                    SELECT D.PHYSICALGAPITEMCODE AS ITEMCODE,
                           ROUND(SUM(D.STOCKQUANTITY1 - D.USEDSTOCKQUANTITY1),3) AS OPEN_QTY_PHY,
                           ROUND(SUM(D.STOCKAMOUNT - D.USEDSTOCKAMOUNT),2) AS OPEN_AMT_PHY
                      FROM PHYSICALGAPITEMTRANSACTION D
                     WHERE D.TRANSACTIONDATE < :P515_FROMDATE
                     GROUP BY D.PHYSICALGAPITEMCODE
                ),
                
                -- 📦 Stock IN per day
                STKIN AS (
                    SELECT STOCKDATE, ITEMCODE,
                           SUM(CASE WHEN PANEL='A' THEN STOCKQUANTITY1 ELSE 0 END) AS IN_QTY_A,
                           SUM(CASE WHEN PANEL='B' THEN STOCKQUANTITY1 ELSE 0 END) AS IN_QTY_B,
                           SUM(CASE WHEN PANEL='A' THEN AMOUNT ELSE 0 END) AS IN_AMT_A,
                           SUM(CASE WHEN PANEL='B' THEN AMOUNT ELSE 0 END) AS IN_AMT_B
                      FROM STOCK
                     WHERE STOCKDATE BETWEEN :P515_FROMDATE AND :P515_TODATE
                       AND STOCKMODULECODE != 'ITEMOPENING'
                     GROUP BY STOCKDATE, ITEMCODE
                ),
                
                -- 📤 Used stock per day
                USTK AS (
                    SELECT BB.USEDSTOCKDATE AS TXNDATE, AA.ITEMCODE,
                           SUM(CASE WHEN BB.PANEL='A' THEN BB.USEDSTOCKQUANTITY1 ELSE 0 END) AS OUT_QTY_A,
                           SUM(CASE WHEN BB.PANEL='B' THEN BB.USEDSTOCKQUANTITY1 ELSE 0 END) AS OUT_QTY_B,
                           SUM(CASE WHEN BB.PANEL='A' THEN (AA.RATE*BB.USEDSTOCKQUANTITY1) ELSE 0 END) AS OUT_AMT_A,
                           SUM(CASE WHEN BB.PANEL='B' THEN (AA.RATE*BB.USEDSTOCKQUANTITY1) ELSE 0 END) AS OUT_AMT_B
                      FROM STOCK AA
                      JOIN USEDSTOCK BB ON AA.TNO = BB.STOCKTNO
                     WHERE BB.USEDSTOCKDATE BETWEEN :P515_FROMDATE AND :P515_TODATE
                     GROUP BY BB.USEDSTOCKDATE, AA.ITEMCODE
                ),
                
                -- ⚖️ Physical txns per day
                PHY AS (
                    SELECT D.TRANSACTIONDATE, D.PHYSICALGAPITEMCODE AS ITEMCODE,
                           SUM(D.STOCKQUANTITY1) AS IN_QTY_PHY,
                           SUM(D.USEDSTOCKQUANTITY1) AS OUT_QTY_PHY,
                           SUM(D.STOCKAMOUNT) AS IN_AMT_PHY,
                           SUM(D.USEDSTOCKAMOUNT) AS OUT_AMT_PHY
                      FROM PHYSICALGAPITEMTRANSACTION D
                     WHERE D.TRANSACTIONDATE BETWEEN :P515_FROMDATE AND :P515_TODATE
                     GROUP BY D.TRANSACTIONDATE, D.PHYSICALGAPITEMCODE
                ),
                
                -- 🧩 Combine calendar × item
                TXN AS (
                    SELECT DT.DAYDATE,
                           IT.ITEMCODE,
                           IT.ITEMNAME,
                           NVL(SI.IN_QTY_A,0)  AS IN_QTY_A,
                           NVL(SI.IN_QTY_B,0)  AS IN_QTY_B,
                           NVL(SI.IN_AMT_A,0)  AS IN_AMT_A,
                           NVL(SI.IN_AMT_B,0)  AS IN_AMT_B,
                           NVL(SO.OUT_QTY_A,0) AS OUT_QTY_A,
                           NVL(SO.OUT_QTY_B,0) AS OUT_QTY_B,
                           NVL(SO.OUT_AMT_A,0) AS OUT_AMT_A,
                           NVL(SO.OUT_AMT_B,0) AS OUT_AMT_B,
                           NVL(P.IN_QTY_PHY,0) AS IN_QTY_PHY,
                           NVL(P.OUT_QTY_PHY,0) AS OUT_QTY_PHY,
                           NVL(P.IN_AMT_PHY,0) AS IN_AMT_PHY,
                           NVL(P.OUT_AMT_PHY,0) AS OUT_AMT_PHY
                      FROM DT
                     CROSS JOIN IT
                      LEFT JOIN STKIN SI ON IT.ITEMCODE = SI.ITEMCODE AND DT.DAYDATE = SI.STOCKDATE
                      LEFT JOIN USTK  SO ON IT.ITEMCODE = SO.ITEMCODE AND DT.DAYDATE = SO.TXNDATE
                      LEFT JOIN PHY   P  ON IT.PHYSICALGAPITEMCODE = P.ITEMCODE AND DT.DAYDATE = P.TRANSACTIONDATE
                ),
                
                -- 📈 Running balances
                TXN_BAL AS (
                    SELECT
                        T.DAYDATE, T.ITEMCODE, T.ITEMNAME,
                        T.IN_QTY_A, T.OUT_QTY_A, T.IN_QTY_B, T.OUT_QTY_B, T.IN_QTY_PHY, T.OUT_QTY_PHY,
                        T.IN_AMT_A, T.OUT_AMT_A, T.IN_AMT_B, T.OUT_AMT_B, T.IN_AMT_PHY, T.OUT_AMT_PHY,
                
                        ROUND(NVL(OB.OPEN_QTY_A,0)
                              + SUM(T.IN_QTY_A - T.OUT_QTY_A)
                                OVER (PARTITION BY T.ITEMCODE ORDER BY T.DAYDATE
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),3) AS CLOSING_QTY_A,
                        ROUND(NVL(OB.OPEN_QTY_B,0)
                              + SUM(T.IN_QTY_B - T.OUT_QTY_B)
                                OVER (PARTITION BY T.ITEMCODE ORDER BY T.DAYDATE
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),3) AS CLOSING_QTY_B,
                        ROUND(NVL(OP.OPEN_QTY_PHY,0)
                              + SUM(T.IN_QTY_PHY - T.OUT_QTY_PHY)
                                OVER (PARTITION BY T.ITEMCODE ORDER BY T.DAYDATE
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),3) AS CLOSING_QTY_PHY,
                
                        ROUND(NVL(OB.OPEN_AMT_A,0)
                              + SUM(T.IN_AMT_A - T.OUT_AMT_A)
                                OVER (PARTITION BY T.ITEMCODE ORDER BY T.DAYDATE
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),2) AS CLOSING_AMT_A,
                        ROUND(NVL(OB.OPEN_AMT_B,0)
                              + SUM(T.IN_AMT_B - T.OUT_AMT_B)
                                OVER (PARTITION BY T.ITEMCODE ORDER BY T.DAYDATE
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),2) AS CLOSING_AMT_B,
                        ROUND(NVL(OP.OPEN_AMT_PHY,0)
                              + SUM(T.IN_AMT_PHY - T.OUT_AMT_PHY)
                                OVER (PARTITION BY T.ITEMCODE ORDER BY T.DAYDATE
                                      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW),2) AS CLOSING_AMT_PHY
                      FROM TXN T
                      LEFT JOIN OPENBAL OB ON T.ITEMCODE = OB.ITEMCODE
                      LEFT JOIN OPENPHY OP ON T.ITEMCODE = OP.ITEMCODE
                )
                
                -- 🏁 Final date + item output
                SELECT
                    TX.DAYDATE,
                    TX.ITEMCODE,
                    TX.ITEMNAME,
                
                    -- Quantities
                    ROUND(LAG(CLOSING_QTY_A,1,NVL(OB.OPEN_QTY_A,0))
                          OVER (PARTITION BY TX.ITEMCODE ORDER BY TX.DAYDATE),3) AS OPENING_QTY_A,
                    TX.IN_QTY_A, TX.OUT_QTY_A, TX.CLOSING_QTY_A,
                
                    ROUND(LAG(CLOSING_QTY_B,1,NVL(OB.OPEN_QTY_B,0))
                          OVER (PARTITION BY TX.ITEMCODE ORDER BY TX.DAYDATE),3) AS OPENING_QTY_B,
                    TX.IN_QTY_B, TX.OUT_QTY_B, TX.CLOSING_QTY_B,
                
                    ROUND(LAG(CLOSING_QTY_PHY,1,NVL(OP.OPEN_QTY_PHY,0))
                          OVER (PARTITION BY TX.ITEMCODE ORDER BY TX.DAYDATE),3) AS OPENING_QTY_PHY,
                    TX.IN_QTY_PHY, TX.OUT_QTY_PHY, TX.CLOSING_QTY_PHY,
                
                    -- Amounts
                    ROUND(LAG(CLOSING_AMT_A,1,NVL(OB.OPEN_AMT_A,0))
                          OVER (PARTITION BY TX.ITEMCODE ORDER BY TX.DAYDATE),2) AS OPENING_AMT_A,
                    TX.IN_AMT_A, TX.OUT_AMT_A, TX.CLOSING_AMT_A,
                
                    ROUND(LAG(CLOSING_AMT_B,1,NVL(OB.OPEN_AMT_B,0))
                          OVER (PARTITION BY TX.ITEMCODE ORDER BY TX.DAYDATE),2) AS OPENING_AMT_B,
                    TX.IN_AMT_B, TX.OUT_AMT_B, TX.CLOSING_AMT_B,
                
                    ROUND(LAG(CLOSING_AMT_PHY,1,NVL(OP.OPEN_AMT_PHY,0))
                          OVER (PARTITION BY TX.ITEMCODE ORDER BY TX.DAYDATE),2) AS OPENING_AMT_PHY,
                    TX.IN_AMT_PHY, TX.OUT_AMT_PHY, TX.CLOSING_AMT_PHY
                
                FROM TXN_BAL TX
                LEFT JOIN OPENBAL OB ON TX.ITEMCODE = OB.ITEMCODE
                LEFT JOIN OPENPHY OP ON TX.ITEMCODE = OP.ITEMCODE
                --ORDER BY TX.ITEMCODE, TX.DAYDATE;
                
                ```
            pageItemsToSubmit: [
                P515_FROMDATE
                P515_TODATE
                P515_ITEM
            ]
        }
