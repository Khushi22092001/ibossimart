    region production-register (
        name: Production Register
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.TNO,
                       A.PRODUCTIONNO,
                       A.PRODUCTIONDATE,
                       getdoctypename(a.doctypecode) As DocType,
                       B.ITEMCODE As ITEMCODE,
                       B.ITEMSPECIFICATIONCODE As ITEMSPECIFICATIONCODE,
                       GetItemName(b.ItemCode) As ITEMNAME,
                       GetItemSpecificationName(b.ItemCode, b.ItemSpecificationCode) As ITEMSPECIFICATION,
                       ROUND(b.quantity1, 3) As PQuantity,
                       f.Measuringunitname As PUnit,
                       ROUND(b.quantity2, 3) As SQuantity,
                       g.Measuringunitname As SUnit,
                       B.STOCKVALUE AS VALUE,
                       --Round(UQTY.USEDVALUE,2) RMVALUE,
                      
                       m.bossusername,
                       to_char(a.creationtime, 'dd-mm-rrrr hh :mi AM') As CreationTime,
                       B.SERIALNO
                
                  From PRODUCTION A,
                       PRODUCTIONFINISHED B,
                       item d,
                       MeasuringUnit f,
                       MeasuringUnit g,
                       BOSSUSER M
                
                 Where A.TNO = B.TNO(+)
                   And b.itemcode = d.itemcode(+)
                   And d.measuringunitcode1 = f.measuringunitcode(+)
                   And d.measuringunitcode2 = g.measuringunitcode(+)
                   
                   And a.creator = m.BOSSUSERCODE(+)
                  -- And A.TNO = 3053803891
                --- Filter
                -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                   And a.productiondate between NVL(:P499_FROMDATE,TRUNC(SYSDATE)) AND NVL(:P499_TODATE,TRUNC(SYSDATE))
                   and (:P499_DOCTYPE is null or a.doctypecode = :P499_DOCTYPE)
                   and ( :P499_INPUTITEM is null or ( b.tno in ( select tno from productionraw where itemcode = :P499_INPUTITEM)))
                   and ( :P499_INPUTITEMSPECIFICATION is null or ( b.tno in ( select tno from productionraw where itemspecificationcode = :P499_INPUTITEMSPECIFICATION)))
                 
                --  And A.TNO = 1441025
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
