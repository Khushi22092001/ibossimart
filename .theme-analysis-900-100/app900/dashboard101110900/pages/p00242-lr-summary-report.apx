page 242 (
    name: LR Summary Report
    alias: LR-SUMMARY-REPORT
    title: LR Summary Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lr-summary (
        name: LR Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.TNO,
                a.LRNo,
                a.GPNo,
                cc.CompanyName,
                cc.OfficeAddress,
                cc.OfficePhoneNo,
                cc.OfficeFaxNo,
                cc.OfficeEMail,
                Sysdate,
                a.VehicleNo,
                a.Quantity1,
                a.Nos,
                dl.DestinationLocationName,
                pl.CreationTime as InTime,
                a.CreationTime as OutTime,
                (a.CreationTime - pl.CreationTime ) as DifferenceDays,
                a.ConsigneeName,
                t.TransporterName,
                e.ItemName,
                a.PartyRefNo,
                a.PartyRefDate,
                lo.LoadingOrderNo,
                sl.SourceLocationName,
                a.BiltyCommission,
                a.InvoiceNo,
                c.PartyName,
                ls.PODStatus,
                ls.FreightAdviceStatus,
                ls.ServiceBillStatus,
                ls.FreightAmount,
                mu1.MeasuringUnitName as MeasuringUnitName1,
                pt.PackingTypeName,
                decode(ls.PODStatus, 'PENDING', 1, 0) as PODPending,
                decode(ls.FreightAdviceStatus, 'PENDING', 1, 0) as FreightAdvicePending,
                decode(ls.ServiceBillStatus, 'PENDING', 1, 0) as ServiceBillPending,
                ss.FreightAmount as ServiceBillAmount
                from LR a, Party c ,Item e, ItemSpecification ee,  Company cc,
                MeasuringUnit mu1, DestinationLocation dl, SourceLocation sl,
                Placement pl, Transporter t, LoadingOrder lo, LRStatus ls,
                PackingType pt, DocumentStatusDetail dsd, ServiceBillLR ss
                where a.PartyCode = c.PartyCode
                and a.ItemCode = e.ItemCode
                and a.ItemSpecificationCode = ee.ItemSpecificationCode
                and e.MeasuringUnitCode1 = mu1.MeasuringUnitCode
                and a.DestinationLocationTNO = dl.TNo(+)
                and a.SourceLocationTNO = sl.TNo(+)
                and a.PlacementTNO = pl.TNo(+)
                and a.TransporterCode  = t.TransporterCode(+)
                and a.LoadingOrderTNo = lo.TNo(+)
                and a.TNO = ls.LRTNo(+)
                and a.PackingTypeCode = pt.PackingTypeCode(+)
                and a.CrossLRTNo is null
                and a.TNO = dsd.ModuleTNo
                and a.Tno = ss.LrTno(+) 
                and a.Companycode = cc.CompanyCode(+)
                and a.LRDate between :P242_FROMDATE and :P242_TODATE
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 22815879662376445
        }

