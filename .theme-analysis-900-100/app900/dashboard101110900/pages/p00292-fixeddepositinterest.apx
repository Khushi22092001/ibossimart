page 292 (
    name: FixedDepositInterestReport
    alias: FIXEDDEPOSITINTEREST
    title: FixedDepositInterest
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region fixeddepositinterest (
        name: FixedDepositInterest
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                row_number() over(order by FDI.FIXEDDEPOSITINTERESTdate) SerialNo,
                l.locationname as location,
                c.companyname as company,
                d.doctypename as doctype,
                fdi.fixeddepositinterestno,
                fdi.fixeddepositinterestdate,
                fd.fixeddepositcertificateno,
                fdi.openingbalance as openingbalanceamount ,
                fdi.interestcompoundingmode as compoundmode,
                p4.partyname as interestaccount,
                fdi.fromdate,
                fdi.todate,
                fdi.interestrate,
                fdi.interestamount,
                p1.partyname as TDSACCOUNT,
                fdi.tdspercent,
                fdi.tdsamount,
                p2.partyname as cessaccount,
                fdi.cesspercent,
                fdi.cessamount,
                p3.partyname as surchargeaccount,
                fdi.surchargepercent,
                fdi.surchargeamount,
                v.voucherno,
                closingbalance as closingbalanceamount
                from fixeddepositinterest fdi,
                     fixeddeposit fd,
                     location l,
                     company c,
                     doctype d,
                     party p1,
                     party p2,
                     party p3,
                     party p4,
                     voucher v
                where
                fdi.fixeddeposittno = fd.tno(+)
                and fdi.tno = v.moduletno(+)
                and fdi.locationcode = l.locationcode(+)
                and fdi.companycode = c.companycode(+)
                and fdi.doctypecode = d.doctypecode(+)
                and fdi.tdsaccountcode = p1.partycode(+)
                and fdi.cessaccountcode = p2.partycode(+)
                and fdi.surchargeaccountcode = p3.partycode(+)
                and fdi.interestaccountcode = p4.partycode(+)
                and FDI.FIXEDDEPOSITINTERESTdate between :P292_FROMDATE and :P292_TODATE
                and (:P292_COMPANY IS NULL OR instr(':'||:P292_COMPANY||':',':'||C.COMPANYcode||':') > 0)
                and (:P292_FIXEDDEPOSITINTERESTNO IS NULL OR instr(':'||:P292_FIXEDDEPOSITINTERESTNO||':',':'||FDI.FIXEDDEPOSITINTERESTNo||':') > 0 ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
