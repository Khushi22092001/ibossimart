page 480 (
    name: Upload Data File
    alias: REPORTFORMAT-UPLOAD
    title: Upload Data File
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region upload-data-file (
        name: Upload Data File
        type: form
        source {
            location: localDatabase
            tableOwner: CMPL
            tableName: REPORTFORMATUPLOAD
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P480_ATTACHEMENT (
        type: fileUpload
        label {
            label: Attachement
            alignment: left
        }
        storage {
            mimeTypeColumn: MIMETYPE
            filenameColumn: FILENAME
        }
        layout {
            sequence: 100
            region: @upload-data-file
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @upload-data-file
            column: ATTACHEMENT
            dataType: blob
        }
    )

    pageItem P480_COMPANYCODE (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: "select Distinct companyname, companycode from company order by 2 "
        }
        layout {
            sequence: 30
            region: @upload-data-file
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @upload-data-file
            column: COMPANYCODE
            dataType: varchar2
        }
    )

    pageItem P480_CREATIONTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 140
            region: @upload-data-file
            slot: regionBody
        }
        appearance {
            formatMask: DD-MM-YYYY HH24:MI:SS
        }
        source {
            formRegion: @upload-data-file
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: expression
            plsqlExpression: SYSDATE
        }
    )

    pageItem P480_CREATOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @upload-data-file
            slot: regionBody
        }
        source {
            formRegion: @upload-data-file
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: item
            item: GLOBAL_LOGINNAME
        }
    )

    pageItem P480_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 90
            region: @upload-data-file
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 60
            height: 4
        }
        validation {
            maxLength: 150
        }
        source {
            formRegion: @upload-data-file
            column: DESCRIPTION
            dataType: varchar2
        }
    )

    pageItem P480_DOCTYPECODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @upload-data-file
            slot: regionBody
        }
        source {
            formRegion: @upload-data-file
            column: DOCTYPECODE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: GENERAL
        }
    )

    pageItem P480_FILENAME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 110
            region: @upload-data-file
            slot: regionBody
        }
        source {
            formRegion: @upload-data-file
            column: FILENAME
            dataType: varchar2
        }
    )

    pageItem P480_FINANCIALYEARCODE (
        type: popupLov
        label {
            label: F.Year
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: Select financialyearcode d, financialyearcode r from financialyear order by 2 desc
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @upload-data-file
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @upload-data-file
            column: FINANCIALYEARCODE
            dataType: varchar2
        }
    )

    pageItem P480_ITEMCATEGORY (
        type: popupLov
        label {
            label: Item Category
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select itemcategoryname, itemcategorycode from itemcategory order by 1
        }
        layout {
            sequence: 80
            region: @upload-data-file
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @upload-data-file
            column: ITEMCATEGORY
            dataType: varchar2
        }
    )

    pageItem P480_LOCATIONCODE (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select LocationName, locationcode from location order by 1
        }
        layout {
            sequence: 40
            region: @upload-data-file
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @upload-data-file
            column: LOCATIONCODE
            dataType: varchar2
        }
    )

    pageItem P480_MIMETYPE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @upload-data-file
            slot: regionBody
        }
        source {
            formRegion: @upload-data-file
            column: MIMETYPE
            dataType: varchar2
        }
    )

    pageItem P480_REPORTFORMATUPLOADDATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @upload-data-file
            slot: regionBody
        }
        source {
            formRegion: @upload-data-file
            column: REPORTFORMATUPLOADDATE
            dataType: date
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE)
        }
    )

    pageItem P480_REPORTFORMATUPLOADNO (
        type: hidden
        layout {
            sequence: 60
            region: @upload-data-file
            slot: regionBody
        }
        source {
            formRegion: @upload-data-file
            column: REPORTFORMATUPLOADNO
            dataType: varchar2
        }
    )

    pageItem P480_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @upload-data-file
            slot: regionBody
        }
        source {
            formRegion: @upload-data-file
            column: TNO
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: GLOBALTNO
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @upload-data-file
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @upload-data-file
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P480_TNO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @upload-data-file
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P480_TNO
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @upload-data-file
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P480_TNO
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    process initialize-form-reportformat-upload (
        name: Initialize form ReportFormat Upload
        type: formInitialization
        formRegion: @upload-data-file
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 37625872811265511
        }
    )

    process process-form-reportformat-upload (
        name: Process form ReportFormat Upload
        type: formAutoRowProcessing
        formRegion: @upload-data-file
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 37626252569265511
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 1
            }
        }
    )

)

