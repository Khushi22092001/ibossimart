page 524 (
    name: Daily Auto mail
    alias: DAILY-AUTO-MAIL
    title: Daily Auto mail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: REPORT
        type: list
        source {
            list: @daily-auto-mail
        }
        layout {
            sequence: 10
            slot: body
            columnCssClasses: hspl-module-tiles
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                u-colors
                t-MediaList--cols t-MediaList--4cols
            ]
        }
    )

)

