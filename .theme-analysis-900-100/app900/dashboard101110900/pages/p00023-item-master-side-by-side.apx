page 23 (
    name: Item Master Side By Side
    alias: ITEM-MASTER-SIDE-BY-SIDE
    title: "Item Master "
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            /* Scroll Results Only in Side Column */
            .t-Body-side {
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            .search-results {
                flex: 1;
                overflow: auto;
            }
            /* Format Search Region */
            .search-region {
                border-bottom: 1px solid rgba(0,0,0,.1);
                flex-shrink: 0;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        enableDuplicatePageSubmissions: false
        reloadOnSubmit: always
    }

    region item (
        name: Item
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       ITEMCODE,
                       ITEMNAME,
                       ITEMTYPE,
                       PARENTCODE,
                       GetItemName(ParentCode) as ParentGroup,
                       MEASURINGUNITCODE1,
                       ItemNatureCode,
                       GetPartyName(StockAccountCode) as StockAccount,
                       GetPartyName(ConsumptionAccountCode) as ConsumptionAccount,
                       GetPartyName(CWIPAccountCode) as CWIPAccount
                  from PBS.ITEM
                 where "TNO" = :P23_TNO
                AND ITEMTYPE = 'ITEM'
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-master-region
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P23_TNO
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: [
                #DEFAULT#
                t-AVPList--leftAligned
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: No Record Selected
        }
        componentAdvanced {
            stripHtml: true
        }

        column CONSUMPTIONACCOUNT (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: CONSUMPTION ACCOUNT
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column CWIPACCOUNT (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: CWIP ACCOUNT
                alignment: center
            }
            layout {
                sequence: 11
            }
        )

        column ITEMCODE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: ITEM CODE
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "ITEM"
                    where "ITEMCODE" is not null
                    and "TNO" = :P23_TNO
                    ```
            }
        )

        column ITEMNAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: ITEM NAME
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "ITEM"
                    where "ITEMNAME" is not null
                    and "TNO" = :P23_TNO
                    ```
            }
        )

        column ITEMNATURECODE (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: ITEM NATURE
                alignment: center
            }
            layout {
                sequence: 8
            }
        )

        column ITEMTYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: ITEM TYPE
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "ITEM"
                    where "ITEMTYPE" is not null
                    and "TNO" = :P23_TNO
                    ```
            }
        )

        column MEASURINGUNITCODE1 (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: UOM
            }
            layout {
                sequence: 7
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "ITEM"
                    where "MEASURINGUNITCODE1" is not null
                    and "TNO" = :P23_TNO
                    ```
            }
        )

        column PARENTCODE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: PARENT CODE
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "ITEM"
                    where "PARENTCODE" is not null
                    and "TNO" = :P23_TNO
                    ```
            }
        )

        column PARENTGROUP (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: PARENT GROUP
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column STOCKACCOUNT (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: STOCK ACCOUNT
                alignment: center
            }
            layout {
                sequence: 9
            }
        )

        column TNO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from "ITEM"
                    where "TNO" is not null
                    and "TNO" = :P23_TNO
                    ```
            }
        )

    )

    region item-master-side-by-side (
        name: Item Master Side By Side
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
            ]
        }
    )

    region item-specifiaction (
        name: Item Specifiaction
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       SNO,
                       ITEMSPECIFICATIONCODE,
                       ITEMSPECIFICATIONNAME,
                       MultiPlyingFactor,
                       HSNCODE,
                       QualityRequired,
                       IsWeighmentRequired,
                       WeighmentUnitCode
                  from PBS.ITEMSPECIFICATION
                 where "TNO" = :P23_TNO
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--scrollBody
            ]
            cssClasses: js-detail-region
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P23_TNO
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                t-Report--stretch
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            maxRowsToProcess: 5000
        }
        messages {
            whenNoDataFound: No data found.
        }
        componentAdvanced {
            stripHtml: true
        }

        column HSNCODE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: HSN CODE
                alignment: center
            }
            layout {
                sequence: 6
            }
        )

        column ISWEIGHMENTREQUIRED (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: IS WEIGHMENT REQUIRED
                alignment: center
            }
            layout {
                sequence: 8
            }
        )

        column ITEMSPECIFICATIONCODE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: ITEM SPECIFICATION CODE
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column ITEMSPECIFICATIONNAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: ITEM SPECIFICATION NAME
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

        column MULTIPLYINGFACTOR (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: MULTIPLYING FACTOR
                alignment: center
            }
            layout {
                sequence: 5
            }
        )

        column QUALITYREQUIRED (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: IS QUALITY REQUIRED
                alignment: center
            }
            layout {
                sequence: 7
            }
        )

        column SNO (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: <span class="u-VisuallyHidden">Edit</span>
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 25
                    items: {
                        P25_SNO: #SNO#
                    }
                    action: resetPagination
                }
                linkText: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 32
            }
        )

        column TNO (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column WEIGHMENTUNITCODE (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: WEIGHMENT UNIT
                alignment: center
            }
            layout {
                sequence: 9
            }
        )

    )

    region master-records (
        name: Master Records
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select "TNO",
                    null link_class,
                    apex_page.get_url(p_items => 'P23_TNO', p_values => "TNO") link,
                    null icon_class,
                    null link_attr,
                    null icon_color_class,
                    case when nvl(:P23_TNO,'0') = "TNO"
                      then 'is-active' 
                      else ' '
                    end list_class,
                    substr("ITEMNAME", 1, 50)||( case when length("ITEMNAME") > 50 then '...' end ) list_title,
                    substr("ITEMCODE", 1, 50)||( case when length("ITEMCODE") > 50 then '...' end ) list_text,
                    null list_badge
                from "ITEM" x
                where (:P23_SEARCH is null
                        or upper(x."ITEMNAME") like '%'||upper(:P23_SEARCH)||'%'
                        or upper(x."ITEMCODE") like '%'||upper(:P23_SEARCH)||'%'
                    )
                order by "ITEMNAME"
                ```
            pageItemsToSubmit: P23_SEARCH
        }
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
            cssClasses: search-results
        }
        reportLayout {
            numberOfRows: 1000
        }
        componentAppearance {
            template: @/media-list
            templateOptions: [
                t-MediaList--showDesc
                t-MediaList--stack
            ]
        }
        performance {
            maxRowsToProcess: 500
        }
        messages {
            whenNoDataFound: <div class="u-tC">No Records Found</div>
        }

        column ICON_CLASS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
