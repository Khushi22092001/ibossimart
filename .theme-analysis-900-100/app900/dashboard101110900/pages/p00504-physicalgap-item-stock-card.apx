page 504 (
    name: Physicalgap Item Stock Card
    alias: PHYSICALGAP-ITEM-STOCK-CARD
    title: Physicalgap Item Stock Card
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region physical-gap-item-stock-card (
        name: Physical gap Item Stock Card
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ItemDates As
                 (
                  -- All combinations of items and dates
                  Select A.ITEMCODE, A.ITEMNAME, B.DAYDATE
                    From item A
                   Cross Join datelist B
                   Where (:P504_ITEM Is Null Or A.ITEMCODE = :P504_ITEM)
                     And B.DAYDATE Between :P504_FROMDATE And :P504_TODATE),
                DailyTransactions As
                 (
                  -- Sum IN/OUT per item per day
                  Select physicalgapitemcode As ITEMCODE,
                          TransactionDate As DAYDATE,
                          Sum(stockquantity1) As INQTY,
                          Sum(stockamount) As INAMT,
                          Sum(usedstockquantity1) As OUTQTY,
                          Sum(usedstockamount) As OUTAMT
                    From Physicalgapitemtransaction
                   Group By physicalgapitemcode, TransactionDate),
                RunningBalances As
                 (Select ID.ITEMCODE,
                         ID.ITEMNAME,
                         ID.DAYDATE,
                         -- Today's IN/OUT
                         NVL(DT.INQTY, 0) As INQTY,
                         NVL(DT.INAMT, 0) As INAMT,
                         NVL(DT.OUTQTY, 0) As OUTQTY,
                         NVL(DT.OUTAMT, 0) As OUTAMT,
                         -- Opening balance = cumulative (IN-OUT) before today
                         NVL((Select Sum(NVL(stockquantity1, 0) - NVL(usedstockquantity1, 0))
                               From Physicalgapitemtransaction T
                              Where T.physicalgapitemcode = ID.ITEMCODE
                                And T.TransactionDate < ID.DAYDATE),
                             0) As OPENINGQTY,
                         NVL((Select Sum(NVL(stockamount, 0) - NVL(usedstockamount, 0))
                               From Physicalgapitemtransaction T
                              Where T.physicalgapitemcode = ID.ITEMCODE
                                And T.TransactionDate < ID.DAYDATE),
                             0) As OPENINGAMT
                    From ItemDates ID
                    Left Join DailyTransactions DT
                      On ID.ITEMCODE = DT.ITEMCODE
                     And ID.DAYDATE = DT.DAYDATE)
                Select ITEMCODE,
                       ITEMNAME,
                       DAYDATE,
                       ROUND(OPENINGQTY,3) OPENINGQTY,
                       ROUND(OPENINGAMT,2) OPENINGAMT,
                       ROUND(INQTY,3) INQTY,
                       ROUND(INAMT,2) INAMT,
                       ROUND(OUTQTY,3) OUTQTY,
                       ROUND(OUTAMT,2) OUTAMT,
                       -- Closing = opening + IN - OUT
                       ROUND(OPENINGQTY + INQTY - OUTQTY,3) As CLOSINGQTY,
                       ROUND(OPENINGAMT + INAMT - OUTAMT,2) As CLOSINGAMT
                  From RunningBalances
                 Order By ITEMNAME, DAYDATE;
                
                ```
            pageItemsToSubmit: [
                P504_FROMDATE
                P504_TODATE
                P504_ITEM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 78730258893170658
        }

        column CLOSINGAMT (
            type: plainText
            heading {
                heading: Closingamt
                alignment: end
            }
            layout {
                sequence: 280
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: BD
            }
        )

        column CLOSINGQTY (
            type: plainText
            heading {
                heading: Closingqty
                alignment: end
            }
            layout {
                sequence: 170
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AR
            }
        )

        column DAYDATE (
            type: plainText
            heading {
                heading: Daydate
            }
            layout {
                sequence: 220
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AX
            }
        )

        column INAMT (
            type: plainText
            heading {
                heading: Inamt
                alignment: end
            }
            layout {
                sequence: 250
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: BA
            }
        )

        column INQTY (
            type: plainText
            heading {
                heading: Inqty
                alignment: end
            }
            layout {
                sequence: 240
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AZ
            }
        )

        column ITEMCODE (
            type: plainText
            heading {
                heading: Itemcode
            }
            layout {
                sequence: 210
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AW
            }
        )

        column ITEMNAME (
            type: link
            heading {
                heading: Itemname
            }
            layout {
                sequence: 200
            }
            link {
                target: {
                    page: 512
                    items: {
                        P512_FROMDATE: &P504_FROMDATE.
                        P512_TODATE: &P504_TODATE.
                        P512_ITEM: #ITEMCODE#
                    }
                    clearCache: 512
                }
                linkText: #ITEMNAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AU
            }
        )

        column OPENINGAMT (
            type: plainText
            heading {
                heading: Openingamt
                alignment: end
            }
            layout {
                sequence: 230
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AY
            }
        )

        column OPENINGQTY (
            type: plainText
            heading {
                heading: Opening Qty
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AG
            }
        )

        column OUTAMT (
            type: plainText
            heading {
                heading: Outamt
                alignment: end
            }
            layout {
                sequence: 270
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: BC
            }
        )

        column OUTQTY (
            type: plainText
            heading {
                heading: Outqty
                alignment: end
            }
            layout {
                sequence: 260
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: BB
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 16
            pageHeaderText: "   Freight Advance Report"
        }

        savedReport 557839 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CLOSINGAMT (
                sequence: 11
            )

            displayColumn CLOSINGQTY (
                sequence: 7
            )

            displayColumn DAYDATE (
                sequence: 1
            )

            displayColumn INAMT (
                sequence: 9
            )

            displayColumn INQTY (
                sequence: 5
            )

            displayColumn ITEMCODE (
                sequence: 2
            )

            displayColumn ITEMNAME (
                sequence: 3
            )

            displayColumn OPENINGAMT (
                sequence: 8
            )

            displayColumn OPENINGQTY (
                sequence: 4
            )

            displayColumn OUTAMT (
                sequence: 10
            )

            displayColumn OUTQTY (
                sequence: 6
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: DEBITAMOUNT
            )

            aggregate (
                column: LOADINGQUANTITY
            )

            aggregate (
                column: REACHEDQUANTITY1
            )

            aggregate (
                column: PASSQUANTITY
            )

            aggregate (
                column: BILLEDAMOUNT
            )

            aggregate (
                column: TDSDEDUCTABLEAMOUNT
            )

            aggregate (
                column: NETPAYABLEAMOUNT
            )

            aggregate (
                column: TDSAMOUNT
            )

            aggregate (
                column: OPENINGAMOUNT
            )

            aggregate (
                column: INQTY
            )

            aggregate (
                column: OUTQTY
            )

            aggregate (
                column: INAMT
            )

            aggregate (
                column: OUTAMT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P504_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @physical-gap-item-stock-card
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P504_ITEM (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Item Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                   a.ItemName d,
                   a.ItemCode r
                From Item a
                Where itemnaturecode = 'PHYSICALGAP'
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @physical-gap-item-stock-card
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Item Name
        }
    )

    pageItem P504_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @physical-gap-item-stock-card
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 60
            region: @physical-gap-item-stock-card
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

