page 375 (
    name: Total Amount
    alias: TOTAL-AMOUNT
    title: Total Amount
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #tam .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region total-amount (
        name: Total Amount
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.GPDate) SerialNo,
                a.Tno,
                a.Categories,
                a.CompanyCode,
                a.ModuleNo,
                a.ModuleDate,
                a.GPNo,
                a.GPDate,
                a.DeliveryOrderNo,
                a.DeliveryOrderDate,
                a.PartyDONo,
                a.PartyDODate,
                a.PartyName,
                a.TransporterName,
                a.VehicleNo,
                b.TransportAreaName,
                a.SourceLocationName,
                a.DestinationLocationName,
                a.DOExpensesNo,
                a.DOExpensesDate,
                a.Quantity,
                a.NetFreightRate,
                a.Amount,
                a.Creator
                From VehiclePerformanceIncome a, TransportArea b
                Where a.TransportAreaCode = b.TransportAreaCode(+)
                and a.Creator = :APP_USER
                and :P375_FROMDATE IS NOT NULL
                and a.CompanyCode = :P375_COMPANYCODE
                and a.VehicleNo like nvl(:P375_VEHICLENO, '%')
                and (:P375_VEHICLENO2 is null
                       or exists(
                         Select
                            aa.VehicleNo
                          From VPVehicleNo aa
                          Where aa.VehicleNo = a.VehicleNo
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P375_VEHICLETYPE is null
                       or exists(
                         Select
                            aa.VehicleTypeCode
                          From VPVehicleType aa
                          Where aa.VehicleTypeCode = a.VehicleTypeCode
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P375_TRANSPORTAREA is null
                       or exists(
                         Select
                            aa.TransportAreaCode
                          From VPTransportArea aa
                          Where aa.TransportAreaCode = a.TransportAreaCode
                              and aa.Creator = :APP_USER
                       )
                   )
                
                ```
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: tam
            regionDisplaySelector: true
        }
