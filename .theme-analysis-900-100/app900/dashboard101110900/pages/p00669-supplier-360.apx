    region command-header (
        name: Supplier 360
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-purchase-head">'
                  || '<div class="ds-purchase-head-eyebrow">Supplier 360</div>'
                  || '<h1 class="ds-purchase-head-title">'
                     || apex_escape.html(nvl(GetPartyName(:P669_SUPPLIER),
                                             'No supplier selected'))
                     || '</h1>'
                  || '<p class="ds-purchase-head-sub">Everything this application records '
                  || 'about one supplier for the chosen period &mdash; what was ordered, '
                  || 'received, billed, passed and settled.</p>'
                  || '<div class="ds-purchase-head-context">'
                  || '<span class="ds-purchase-head-chip">Period <b>'
                     || apex_escape.html(:P669_FROMDATE) || ' &rarr; '
                     || apex_escape.html(:P669_TODATE) || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Company <b>'
                     || apex_escape.html(nvl(GetCompanyName(:P669_COMPANY),'All companies'))
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Location <b>'
                     || apex_escape.html(nvl(GetLocationName(:P669_LOCATION),'All locations'))
                     || '</b></span>'
                  || Case
                       When (Select GetUserPanelAB_apex() From dual) Is Not Null
                       Then '<span class="ds-purchase-head-chip">Panel <b>'
                            || apex_escape.html((Select GetUserPanelAB_apex() From dual))
                            || ' (enforced)</b></span>'
                       Else '<span class="ds-purchase-head-chip">Panel <b>'
                            || apex_escape.html(nvl(:P669_PANEL,'A + B')) || '</b></span>'
                     End
                  -- Last bill from THIS supplier, read through the panel predicate. Says
                  -- "never" rather than showing an empty chip.
                  || '<span class="ds-purchase-head-chip ds-purchase-head-chip--live">Last bill <b>'
                     || apex_escape.html(nvl(to_char(
                          (Select Max(h.PurchaseBillDate) From PurchaseBill h
                            Where h.PartyCode = :P669_SUPPLIER
                              And ((Select GetUserPanelAB_apex() From dual) Is Null
                                   Or h.Panel = (Select GetUserPanelAB_apex() From dual))),
                          'DD-Mon-RRRR'),'never'))
                     || '</b></span>'
                  || '</div></div>' As HEAD
                From dual
                ```
            pageItemsToSubmit: [
                P669_SUPPLIER
                P669_FROMDATE
                P669_TODATE
                P669_COMPANY
                P669_LOCATION
                P669_PANEL
            ]
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-purchase-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Header unavailable.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Whole header as one HTML string. The last-bill chip reads through the panel predicate so it cannot disclose an out-of-panel row.
            }
        )

    )

