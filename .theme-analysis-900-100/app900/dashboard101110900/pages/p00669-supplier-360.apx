        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: The subject of this page. Left switchable so you can move supplier-to-supplier without returning to the Command Centre. Populated from bills, so every entry returns rows.
        }
    )

    pageItem P669_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 5
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: End of the reporting period.
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back-to-hub (
        buttonName: BACKTOHUB
        label: Purchase Command Centre
        layout {
            sequence: 90
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 6
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 668
                items: {
                    P668_FROMDATE: &P669_FROMDATE.
                    P668_TODATE: &P669_TODATE.
                    P668_COMPANY: &P669_COMPANY.
                    P668_LOCATION: &P669_LOCATION.
                    P668_PANEL: &P669_PANEL.
                }
                clearCache: 668
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button supplier-ledger (
        buttonName: SUPPLIERLEDGER
        label: Supplier Ledger
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-book
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 178
                items: {
                    P178_PARTY: &P669_SUPPLIER.
                    P178_FROMDATE: &P669_FROMDATE.
                    P178_TODATE: &P669_TODATE.
                    P178_LOCATION: &P669_LOCATION.
                }
                clearCache: 178
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

