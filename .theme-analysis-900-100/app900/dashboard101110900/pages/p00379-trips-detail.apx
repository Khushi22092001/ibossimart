page 379 (
    name: Trips  Detail
    alias: TRIPS-DETAIL
    title: Trips  Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region trip-detail (
        name: Trip Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                     b.vehicleNo as vc,
                     c.*
                     From vehicleDriver a, vehicledriverdetail b, Employee d,
                  (Select
                      row_number() over(order by x.DriverCode) SerialNo,
                      x.VehicleNo,
                      x.DriverCode,
                      x.SourceLocationName,
                      x.DestinationLOcationName,
                      x.Quantity1,
                      x.GPDate,
                      x.GPNo 
                    From
                    (
                   Select
                b.VehicleNo,
                c.DriverCode,
                d.SourceLocationName,
                e.DestinationLOcationName,
                b.Quantity1,
                b.GPDate,
                b.GPNo
                From NecessitySlipTrip a, LR b, NecessitySlip c, SourceLocation d, DestinationLocation e
                Where a.ModuleTno = b.Tno
                and a.Tno = c.Tno
                and b.SourceLocationTno = d.Tno
                and b.DestinationLocationTno = e.Tno
                and c.VehicleGroupCode = 'SELF'
                --and a.DistanceInKM is not null
                --and a.DieselQuantity is not null
                and c.NecessitySlipDate between :P379_FROMDATE and :P379_TODATE
                and b.VehicleNo = :P379_VEHICLE
                and c.DriverCode = :P379_EMPLOYEE
                UNION ALL
                Select
                b.VehicleNo,
                c.DriverCode,
                d.SourceLocationName,
                e.DestinationLOcationName,
                b.LoadingQuantity1 as Quantity1,
                b.LoadingDate as GPDate,
                b.GPNo
                From NecessitySlipTrip a, InternalTransfer b, NecessitySlip c, SourceLocation d, DestinationLocation e
                Where a.ModuleTno = b.Tno
                and a.Tno = c.Tno
                and b.SourceLocationTno = d.Tno
                and b.DestinationLocationTno = e.Tno
                and c.VehicleGroupCode = 'SELF'
                --and a.DistanceInKM is not null
                --and a.DieselQuantity is not null
                and c.NecessitySlipDate between :P379_FROMDATE and :P379_TODATE
                and b.VehicleNo = :P379_VEHICLE
                and c.DriverCode = :P379_EMPLOYEE
                Order by 1
                ) x
                       )c
                     -- and ( :P379_VEHICLE IS NULL OR instr(':'||:P379_VEHICLE||':',':'||a.VehicleNo||':') > 0 )) c
                
                
                
                    where a.tno = b.tno
                    and b.vehicleno = c.vehicleno
                    and b.DriverCode = d.EmployeeCode
                    and a.VehicleDriverDate BETWEEN  :P379_FROMDATE AND :P379_TODATE
                
                
                
                     --and b.VEHICLENO = 'MH34BG0851'
                    -- AND B.DRIVERCODE = '10109'
                
                
                
                
                
                
                
                
                
                
                
                
                -- Select distinct
                --      b.vehicleNo as vc,
                --      c.*
                --      From vehicleDriver a, vehicledriverdetail b, Employee d,
                --   (Select
                --        a.VehicleNo,
                --        b.GPNo,
                --        b.GPDate,
                --        b.Quantity1,
                --        c.SourceLocationName,
                --        d.DestinationLocationName
                --   From Placement a, LR b, SourceLOcation c, DestinationLocation d, employee e
                --   where a.Tno = b.PlacementTno
                --     and a.SourcelocationTno = C.tNO
                --     and a.DestinationLocationTno = d.Tno
                --     and a.drivercode = e.employeecode
                --     and ( :P379_VEHICLE IS NULL OR instr(':'||:P379_VEHICLE||':',':'||a.VehicleNo||':') > 0 )
                --     and ( :P379_EMPLOYEEID IS NULL OR instr(':'||:P379_VEHICLE||':',':'||e.employeeID||':') > 0 )
                --     and ( :P379_EMPLOYEE IS NULL OR instr(':'||:P379_EMPLOYEE||':',':'||a.DriverCode||':') > 0 )
                --     --  AND  a.VehicleNo = 'MH34BG0851'
                --     --  AND  E.EmployeeId = 'CMPL10109'
                --     --  AND  a.DriverCode = '10109'
                
                --    UNION ALL
                
                --     Select
                --        a.VehicleNo,
                --        b.GPNo,
                --        b.GPDate,
                --        b.Quantity1,
                --        c.SourceLocationName,
                --        d.DestinationLocationName
                --    From EmptyVehiclePlacement a, LR b, SourceLOcation c, DestinationLocation d, Employee e
                --     Where a.Tno = b.ModuleTno
                --       and a.SourcelocationTno = C.tNO
                --       and a.DestinationLocationTno = d.Tno
                --       and ( :P379_VEHICLE IS NULL OR instr(':'||:P379_VEHICLE||':',':'||a.VehicleNo||':') > 0 )
                --       and ( :P379_EMPLOYEEID IS NULL OR instr(':'||:P379_VEHICLE||':',':'||e.employeeID||':') > 0 )
                --       and ( :P379_EMPLOYEE IS NULL OR instr(':'||:P379_EMPLOYEE||':',':'||a.DriverCode||':') > 0 )
                --       -- AND  a.VehicleNo = 'MH34BG0851'
                --       --AND  E.EmployeeId = 'CMPL10109'
                --      -- AND  a.DriverCode = '10109'
                --     --  and ( :P379_VEHICLE IS NULL OR instr(':'||:P379_VEHICLE||':',':'||a.VehicleNo||':') > 0 )
                      
                
                --     UNION ALL
                
                
                --   Select 
                --        a.VehicleNo,
                --        a.GPNo,
                --        a.LoadingDate,
                --        a.LoadingQuantity1,
                --        c.SourceLocationName,
                --        d.DestinationLocationName
                --     From InternalTransfer a, Sourcelocation c, DestinationLocation d, Employee E
                --     Where a.SourcelocationTno = c.Tno
                --       and a.DestinationLocationTno = d.Tno
                --       AND a.DriverCode = E.EmployeeCode
                --       and ( :P379_VEHICLE IS NULL OR instr(':'||:P379_VEHICLE||':',':'||a.VehicleNo||':') > 0 )
                --       and ( :P379_EMPLOYEEID IS NULL OR instr(':'||:P379_VEHICLE||':',':'||e.employeeID||':') > 0 )
                --       and ( :P379_EMPLOYEE IS NULL OR instr(':'||:P379_EMPLOYEE||':',':'||a.DriverCode||':') > 0 )
                --      -- AND  a.VehicleNo = 'MH34BG0851'
                --      -- AND  E.EmployeeId = 'CMPL10109'
                --      -- AND  a.DriverCode = '10109'
                --        )c
                --      -- and ( :P379_VEHICLE IS NULL OR instr(':'||:P379_VEHICLE||':',':'||a.VehicleNo||':') > 0 )) c
                
                
                
                --     where a.tno = b.tno
                --     and b.vehicleno = c.vehicleno
                --     and b.DriverCode = d.EmployeeCode
                --     and ( :P379_VEHICLE IS NULL OR instr(':'||:P379_VEHICLE||':',':'||b.VehicleNo||':') > 0 )
                --     and ( :P379_EMPLOYEE IS NULL OR instr(':'||:P379_EMPLOYEE||':',':'||b.DriverCode||':') > 0 )
                --     and a.VehicleDriverDate BETWEEN  :P379_FROMDATE AND :P379_TODATE
                
                
                --     -- and b.VEHICLENO = 'MH34BG0851'
                --     -- AND B.DRIVERCODE = '10109'
                --     -- and a.vehicledriverdate = '01-may-2023';
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 108791896197780502
        }

        column DESTINATIONLOCATIONNAME (
            type: plainText
            heading {
                heading: DESTINATION LOCATION
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column DRIVERCODE (
            type: plainText
            heading {
                heading: Drivercode
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column GPDATE (
            type: plainText
            heading {
                heading: GP DATE
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column GPNO (
            type: plainText
            heading {
                heading: GP NO
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: QUANTITY
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column SOURCELOCATIONNAME (
            type: plainText
            heading {
                heading: SOURCE LOCATION
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column VC (
            type: plainText
            heading {
                heading: Vc
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: VEHICLE NO
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Trip Detail
        }

        savedReport 1088005 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DESTINATIONLOCATIONNAME (
                sequence: 4
            )

            displayColumn GPDATE (
                sequence: 2
            )

            displayColumn GPNO (
                sequence: 6
            )

            displayColumn QUANTITY1 (
                sequence: 7
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SOURCELOCATIONNAME (
                sequence: 3
            )

            displayColumn VEHICLENO (
                sequence: 5
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P379_COMPANY (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    pageItem P379_EMPLOYEE (
        type: hidden
        layout {
            sequence: 50
            slot: body
        }
    )

    pageItem P379_EMPLOYEEID (
        type: hidden
        layout {
            sequence: 40
            slot: body
        }
    )

    pageItem P379_FROMDATE (
        type: hidden
        layout {
            sequence: 20
            slot: body
        }
    )

    pageItem P379_TODATE (
        type: hidden
        layout {
            sequence: 30
            slot: body
        }
    )

    pageItem P379_VEHICLE (
        type: hidden
        layout {
            sequence: 60
            slot: body
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 70
            slot: body
            column: 1
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 374
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

