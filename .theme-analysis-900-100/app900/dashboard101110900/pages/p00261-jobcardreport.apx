    title: JobCardReport
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region job-card-detail (
        name: Job Card Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-none
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region jobcardreport (
        name: JobCardReport
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                row_number() over(order by aa.jobcarddate) SerialNo,
                c.companyname,
                l.locationname,
                S.doctypename,
                aa.jobcarddate,
                aa.jobcardno,
                f.equipmentmaintenanceorderno,
                aa.shorttext,
                aa.longtext,
                e.equipmentmaintenanceplanno,
                g.maintenancestrategyname,
                j.jobtypename,
                to_char(a.starttime,'dd-mm-rrrr HH24:MI') starttime,
                TO_CHAR(a.endtime,'dd-mm-rrrr HH24:MI') EndTime,
                i.employeename,
                q.qualityname ,
                b.initialvalue,
                b.endvalue,
                b.netvalue,
                aa.remark
                from jobcard aa,jobcarddetail a,location l,doctype S,company c,equipmentmaintenanceplan e,
                equipmentmaintenanceorder f,maintenancestrategy g,maintenancerequest h,employee i,jobtype j,
                jobcardcounterdetail b,quality q
                where aa.doctypecode = S.doctypecode(+)
                and aa.locationcode = l.locationcode(+)
                and aa.companycode = c.companycode(+)
                and aa.equipmentmaintenanceordertno = f.tno(+)
                and h.plantno = e.tno(+)
                and b.propertycode = q.qualitycode(+)
                and f.maintenancerequesttno = h.tno(+)
                and e.maintenancestrategycode = g.maintenancestrategycode(+)
                and a.mechniccode = i.employeecode(+)
                and a.jobtypecode = j.jobtypecode(+)
                and aa.tno = a.tno(+)
                and a.tno = b.tno(+)
                and aa.tno = b.tno(+)
                and aa.jobcarddate between :P261_FROMDATE and :P261_TODATE
                and ( :P261_DOCTYPE IS NULL OR instr(':'||:P261_DOCTYPE||':',':'||S.DocTypeCode||':') > 0 ) 
                and (:P261_LOCATION IS NULL OR instr(':'||:P261_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P261_CARDNO IS NULL OR instr(':'||:P261_CARDNO||':',':'||aa.JobCardNo||':') > 0 ) 
                and (:P261_JOBTYPENAME IS NULL OR instr(':'||:P261_JOBTYPENAME||':',':'||j.jobtypecode||':') > 0)
                and (:P261_PLANNO IS NULL OR instr(':'||:P261_PLANNO||':',':'||E.EQUIPMENTMAINTENANCEPLANNO||':') > 0 ) 
                and (:P261_STRATEGYNAME IS NULL OR instr(':'||:P261_STRATEGYNAME||':',':'||G.MAINTENANCEstrategycode||':') > 0)
                and ( instr(':'||:P261_COMPANYNAME||':',':'||C.COMPANYCODE||':') > 0 )
                and (:P261_EQUIPMENTMAINTENANCEORDERNO IS NULL OR instr(':'||:P261_EQUIPMENTMAINTENANCEORDERNO||':',':'||f.equipmentmaintenanceorderno||':') > 0)
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
