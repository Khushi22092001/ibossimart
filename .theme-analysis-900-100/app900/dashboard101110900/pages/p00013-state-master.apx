page 13 (
    name: State Master
    alias: STATE-MASTER
    title: State Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region state-report (
        name: State Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  row_number() over(order by a.GSTStateCode) SerialNo,
                      a.StateCode,
                      a.StateName,
                      a.StateShortName,
                      a.GSTStateCode,
                      a.IsUnion
                From  State a
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 13629107711089186
        }

        column GSTSTATECODE (
            type: plainText
            heading {
                heading: GST STATE CODE
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column ISUNION (
            type: plainText
            heading {
                heading: IS UNION TERRITORY
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column STATECODE (
            type: plainText
            heading {
                heading: STATE CODE
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column STATENAME (
            type: plainText
            heading {
                heading: STATE NAME
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column STATESHORTNAME (
            type: plainText
            heading {
                heading: STATE SHORT NAME
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        savedReport 21947 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn GSTSTATECODE (
                sequence: 2
            )

            displayColumn ISUNION (
                sequence: 6
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn STATECODE (
                sequence: 3
            )

            displayColumn STATENAME (
                sequence: 4
            )

            displayColumn STATESHORTNAME (
                sequence: 5
            )

            sort (
                column: GSTSTATECODE
                sort {
                    sequence: 1
                }
            )

            sort (
                column: STATENAME
                sort {
                    sequence: 2
                }
            )

            sort (
                column: CITYNAME
                sort {
                    sequence: 3
                }
            )

        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

