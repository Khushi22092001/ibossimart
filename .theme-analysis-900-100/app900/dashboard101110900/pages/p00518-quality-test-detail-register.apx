page 518 (
    name: "Quality Test Detail Register "
    alias: QUALITY-TEST-DETAIL-REGISTER
    title: "Quality Test Detail Register "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region quality-test-detail-register (
        name: "Quality Test Detail Register "
        type: staticContent
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    e.materialindate,
                    f.partyname,
                    g.itemcode,
                    e.refdocno,
                    e.vehicleno,
                    i.chalanquantity1,
                    i.receivedquantity1,
                    i.receivedquantity1 - i.chalanquantity1 AS excess,
                MAX(CASE WHEN d.qualitycode = '105' THEN d.testvalue END) AS "+10MM",
                MAX(CASE WHEN d.qualitycode = '104' THEN d.testvalue END) AS "+12MM",
                MAX(CASE WHEN d.qualitycode = '103' THEN d.testvalue END) AS "+16MM",
                MAX(CASE WHEN d.qualitycode = '+18MM' THEN d.testvalue END) AS "+18MM",
                MAX(CASE WHEN d.qualitycode = '+1MM' THEN d.testvalue END) AS "+1MM",
                MAX(CASE WHEN d.qualitycode = '101' THEN d.testvalue END) AS "+20MM",
                MAX(CASE WHEN d.qualitycode = '+2MM' THEN d.testvalue END) AS "+2MM",
                MAX(CASE WHEN d.qualitycode = '14' THEN d.testvalue END) AS "+3MM",
                MAX(CASE WHEN d.qualitycode = '+40MM' THEN d.testvalue END) AS "+40MM",
                MAX(CASE WHEN d.qualitycode = '13' THEN d.testvalue END) AS "+4MM",
                MAX(CASE WHEN d.qualitycode = '107' THEN d.testvalue END) AS "+5MM",
                MAX(CASE WHEN d.qualitycode = '12' THEN d.testvalue END) AS "+6MM",
                MAX(CASE WHEN d.qualitycode = '106' THEN d.testvalue END) AS "+8MM",
                MAX(CASE WHEN d.qualitycode = '-10MM' THEN d.testvalue END) AS "-10MM",
                MAX(CASE WHEN d.qualitycode = '-1MM' THEN d.testvalue END) AS "-1MM",
                MAX(CASE WHEN d.qualitycode = '-3mm' THEN d.testvalue END) AS "-3MM",
                MAX(CASE WHEN d.qualitycode = '-5MM' THEN d.testvalue END) AS "-5MM",
                MAX(CASE WHEN d.qualitycode = 'ABRASION' THEN d.testvalue END) AS "ABRASION",
                MAX(CASE WHEN d.qualitycode = 'ASH' THEN d.testvalue END) AS "ASH%",
                MAX(CASE WHEN d.qualitycode = 'B.DUST' THEN d.testvalue END) AS "B.DUST",
                MAX(CASE WHEN d.qualitycode = 'B.LOSS' THEN d.testvalue END) AS "B.LOSS",
                MAX(CASE WHEN d.qualitycode = '109' THEN d.testvalue END) AS "BHQ",
                MAX(CASE WHEN d.qualitycode = '10' THEN d.testvalue END) AS "CaO%",
                MAX(CASE WHEN d.qualitycode = 'C' THEN d.testvalue END) AS "Carbon(%)",
                MAX(CASE WHEN d.qualitycode = 'FC' THEN d.testvalue END) AS "FC%",
                MAX(CASE WHEN d.qualitycode = 'FE' THEN d.testvalue END) AS "FE",
                MAX(CASE WHEN d.qualitycode = '2' THEN d.testvalue END) AS "FE(T)%",
                MAX(CASE WHEN d.qualitycode = 'PHOS' THEN d.testvalue END) AS "LATT+Phos (%)",
                MAX(CASE WHEN d.qualitycode = '3' THEN d.testvalue END) AS "LOI%",
                MAX(CASE WHEN d.qualitycode = 'MAG%' THEN d.testvalue END) AS "MAG%",
                MAX(CASE WHEN d.qualitycode = 'MOISTURE' THEN d.testvalue END) AS "MOISTURE (%)",
                MAX(CASE WHEN d.qualitycode = '11' THEN d.testvalue END) AS "MgO%",
                MAX(CASE WHEN d.qualitycode = 'Mz' THEN d.testvalue END) AS "Mz",
                MAX(CASE WHEN d.qualitycode = 'N/M' THEN d.testvalue END) AS "N/M",
                MAX(CASE WHEN d.qualitycode = '112' THEN d.testvalue END) AS "PHOS",
                MAX(CASE WHEN d.qualitycode = 'POROSITY' THEN d.testvalue END) AS "POROSITY",
                MAX(CASE WHEN d.qualitycode = '9' THEN d.testvalue END) AS "RED MATERIAL",
                MAX(CASE WHEN d.qualitycode = '6' THEN d.testvalue END) AS "S%",
                MAX(CASE WHEN d.qualitycode = '5' THEN d.testvalue END) AS "SHELL STONE%",
                MAX(CASE WHEN d.qualitycode = '7' THEN d.testvalue END) AS "SIO2%",
                MAX(CASE WHEN d.qualitycode = '100' THEN d.testvalue END) AS "SIO3%",
                MAX(CASE WHEN d.qualitycode = 'SLAG' THEN d.testvalue END) AS "SLAG",
                MAX(CASE WHEN d.qualitycode = 'TUMBLER' THEN d.testvalue END) AS "TUMBLER",
                MAX(CASE WHEN d.qualitycode = '4' THEN d.testvalue END) AS "VM%",
                MAX(CASE WHEN d.qualitycode = 'YIELD' THEN d.testvalue END) AS "YIELD",
                MAX(CASE WHEN d.qualitycode = 'mms' THEN d.testvalue END) AS "size",
                MAX(CASE WHEN d.qualitycode = 'CCS' THEN d.testvalue END) AS "stands for Cold Compressive Strength"
                  From QCSAMPLE          A,
                       QCSAMPLEDETAIL    B,
                       QUALITYTEST       C,
                       QUALITYTESTDETAIL D,
                       MATERIALIN        E,
                       party             f,
                       item              g,
                       grn               h,
                       grndetail         i,
                       quality           j
                 Where A.TNO = B.TNO
                   And A.TNO = C.QCSAMPLETNO
                   And C.TNO = D.TNO
                   And B.REFERENCETNO = E.TNO(+)
                   And e.partycode = f.partycode
                   And a.itemcode = g.itemcode
                   And e.tno = h.materialintno
                   And a.itemcode = i.itemcode
                   And h.tno = i.tno
                   And d.qualitycode = j.qualitycode
                   and trunc(e.MaterialInDate) Between :P518_FROMDATE and :P518_TODATE
                   and (:P518_COMPANY IS NULL OR instr(':'||:P518_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                   and (:P518_PARTY IS NULL OR instr(':'||:P518_PARTY||':',':'||e.PartyCode||':') > 0 ) 
                   and (:P518_VEHICLE IS NULL OR instr(':'||:P518_VEHICLE||':',':'||e.VehicleNo||':') > 0 ) 
                 Group By e.materialindate,
                          f.partyname,
                          g.itemcode,
                          e.refdocno,
                          e.vehicleno,
                          i.chalanquantity1,
                          i.receivedquantity1,
                          i.receivedquantity1 - i.chalanquantity1
                 Order By e.materialindate, f.partyname, g.itemcode;
                
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 34380456911557307
        }

