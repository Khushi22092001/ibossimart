    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 90
            region: @quality-test-detail-register
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
