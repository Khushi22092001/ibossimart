page 506 (
    name: Stock Status
    alias: STOCK-STATUS
    title: Stock Status
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region stock-status (
        name: Stock Status
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region stock-status-report (
        name: Stock Status Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct 
                      a.DayDate,
                      sum(a.OpeningQuantity) OpeningQuantity,
                      sum(a.InQuantity) InQuantity,
                      sum(a.OutQuantity) OutQuantity,
                      sum(a.ClosingQuantity) ClosingQuantity,
                      'Link' as InLink,
                      'Link' as OutLink,
                      a.ItemCode,
                      a.ItemSpecificationCode,
                      a.LocationCode
                From  StockInOutDateWise a
                Where a.DayDate Between :P506_FROMDATE and :P506_TODATE
                --AND a.ClosingQuantity != 0
                   and (:P506_location is null or instr(':'||:P506_LOCATION||':',':'||a.LocationCode||':') > 0)
                   and instr(':'||:P506_ITEM||':',':'||a.ItemCode||':') > 0 
                   and instr(':'||:P506_ITEMSPECIFICATION||':',':'||a.ItemSpecificationCode||':') > 0 
                   and :P506_ITEMSPECIFICATION is not null 
                   --and ( GetUserPanelAB_apex() is null  or a.PanelStockInBeforeDay = GetUserPanelAB_apex())
                   --and ( GetUserPanelAB_apex() is null  or a.PanelStockOutBeforeDay = GetUserPanelAB_apex())
                   --and ( GetUserPanelAB_apex() is null  or a.PanelStockInOnDay = GetUserPanelAB_apex())
                   --and ( GetUserPanelAB_apex() is null  or a.StockOutOnDay = GetUserPanelAB_apex())
                group by a.DayDate,
                         a.ItemCode,
                         a.ItemSpecificationCode,
                         a.LocationCode
                union all
                Select distinct 
                      a.DayDate,
                      sum(a.OpeningQuantity) OpeningQuantity,
                      sum(a.InQuantity) InQuantity,
                      sum(a.OutQuantity) OutQuantity,
                      sum(a.ClosingQuantity) ClosingQuantity,
                      'Link' as InLink,
                      'Link' as OutLink,
                      a.ItemCode,
                      null as ItemSpecificationCode,
                      a.LocationCode
                From  StockInOutDateWise a
                Where a.DayDate Between :P506_FROMDATE and :P506_TODATE
                --AND a.ClosingQuantity != 0
                   and (:p506_location is null or instr(':'||:P506_LOCATION||':',':'||a.LocationCode||':') > 0)
                   and instr(':'||:P506_ITEM||':',':'||a.ItemCode||':') > 0 
                   and :P506_ITEMSPECIFICATION is null 
                   --and ( GetUserPanelAB_apex() is null  or a.PanelStockInBeforeDay = GetUserPanelAB_apex())
                   --and ( GetUserPanelAB_apex() is null  or a.PanelStockOutBeforeDay = GetUserPanelAB_apex())
                   --and ( GetUserPanelAB_apex() is null  or a.PanelStockInOnDay = GetUserPanelAB_apex())
                   --and ( GetUserPanelAB_apex() is null  or a.StockOutOnDay = GetUserPanelAB_apex())
                group by a.DayDate,
                         a.ItemCode,
                         a.LocationCode
                ```
            pageItemsToSubmit: [
                P506_FROMDATE
                P506_TODATE
                P506_LOCATION
                P506_ITEM
                P506_ITEMSPECIFICATION
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 85502900132031012
        }

        column CLOSINGQUANTITY (
            type: plainText
            heading {
                heading: Closing Quantity
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AS
            }
        )

        column DAYDATE (
            type: plainText
            heading {
                heading: Day Date
            }
            layout {
                sequence: 10
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AO
            }
        )

        column INLINK (
            type: link
            heading {
                heading: In Details
            }
            layout {
                sequence: 60
            }
            link {
                target: {
                    page: 507
                    items: {
                        P507_LOCATION: #LOCATIONCODE#
                        P507_ITEMCODE: #ITEMCODE#
                        P507_ITEMSPECIFICATIONCODE: #ITEMSPECIFICATIONCODE#
                        P507_DAYDATE: #DAYDATE#
                    }
                    clearCache: 507
                }
                linkText: #INLINK#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AT
            }
        )

        column INQUANTITY (
            type: link
            heading {
                heading: In Quantity
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            link {
                target: {
                    page: 507
                    items: {
                        P507_LOCATION: #LOCATIONCODE#
                        P507_ITEMCODE: #ITEMCODE#
                        P507_ITEMSPECIFICATIONCODE: #ITEMSPECIFICATIONCODE#
                        P507_DAYDATE: #DAYDATE#
                    }
                    clearCache: 507
                }
                linkText: #INQUANTITY#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AQ
            }
        )

        column ITEMCODE (
            type: plainText
            heading {
                heading: Item Code
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AV
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: plainText
            heading {
                heading: Itemspecificationcode
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AW
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: Locationcode
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AX
            }
        )

        column OPENINGQUANTITY (
            type: plainText
            heading {
                heading: Opening Quantity
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AP
            }
        )

        column OUTLINK (
            type: link
            heading {
                heading: Out Details
            }
            layout {
                sequence: 70
            }
            link {
                target: {
                    page: 508
                    items: {
                        P508_DAYDATE: #DAYDATE#
                        P508_ITEMCODE: #ITEMCODE#
                        P508_ITEMSPECIFICATIONCODE: #ITEMSPECIFICATIONCODE#
                        P508_LOCATION: #LOCATIONCODE#
                    }
                    clearCache: 508
                }
                linkText: #OUTLINK#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AU
            }
        )

        column OUTQUANTITY (
            type: link
            heading {
                heading: Out Quantity
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            link {
                target: {
                    page: 508
                    items: {
                        P508_LOCATION: #LOCATIONCODE#
                        P508_ITEMCODE: #ITEMCODE#
                        P508_ITEMSPECIFICATIONCODE: #ITEMSPECIFICATIONCODE#
                        P508_DAYDATE: #DAYDATE#
                    }
                    clearCache: 508
                }
                linkText: #OUTQUANTITY#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AR
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: NecessitySlip Detail Report
        }

        savedReport 232721 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn CLOSINGQUANTITY (
                sequence: 5
            )

            displayColumn DAYDATE (
                sequence: 1
            )

            displayColumn INQUANTITY (
                sequence: 3
            )

            displayColumn OPENINGQUANTITY (
                sequence: 2
            )

            displayColumn OUTQUANTITY (
                sequence: 4
            )

            sort (
                column: DAYDATE
                sort {
                    sequence: 1
                }
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 2
                }
            )

            sort (
                column: NECESSITYSLIPNO
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: INQUANTITY
            )

            aggregate (
                column: OUTQUANTITY
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P506_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @stock-status
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P506_ITEM (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Item
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select e.ItemName as d,
                      e.ItemCode as r
                From  Item e
                Order by 1
                ```
        }
        layout {
            sequence: 50
            region: @stock-status
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 35
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P506_ITEMSPECIFICATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Item Specification
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select ee.ItemSpecificationName as d,
                       ee.ItemSpecificationCode as r
                From  Item e, ItemSpecification ee
                Where e.itemcode = :P506_ITEM
                  and e.TNo = ee.TNo
                Order by 1
                ```
            nullDisplayValue: - Select -
        }
        cascadingLov {
            parentItems: P506_ITEM
            itemsToSubmit: P506_ITEM
        }
        layout {
            sequence: 60
            region: @stock-status
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 8
            labelColumnSpan: 2
            columnCssClasses: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 85
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P506_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'GRN'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                ;
                
                ```
        }
        layout {
            sequence: 40
            region: @stock-status
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 2
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P506_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @stock-status
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 2
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 70
            region: @stock-status
            slot: regionBody
            column: 11
            columnCssClasses: 2
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

