page 371 (
    name: Vehicle Driver Detail
    alias: VEHICLE-DRIVER-DETAIL
    title: Vehicle Driver Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     row_number() over(order by a.VehicleDriverDate) SerialNo,
                     c.LocationName,
                     a.VehicleDriverNo,
                     a.VehicleDriverDate,
                     d.ShiftName,
                     b.VehicleNo,
                     e.EmployeeName
                From VehicleDriver a, VehicleDriverDetail b, Location c, Shift d, Employee e
                Where a.Tno = b.Tno
                  and a.LocationCode = c.LocationCode
                  and a.ShiftCode = d.ShiftCode
                  and b.DriverCode = e.EmployeeCode
                  and ( :P371_COMPANY IS NULL OR instr(':'||:P371_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                  and a.VehicleDriverDate BETWEEN  :P371_FROMDATE AND :P371_TODATE
                  and ( :P371_LOCATION IS NULL OR instr(':'||:P371_LOCATION||':',':'||a.LocationCode||':') > 0 )
                  and ( :P371_SHIFT IS NULL OR instr(':'||:P371_SHIFT||':',':'||a.ShiftCode||':') > 0 )
                  and ( :P371_VEHICLE IS NULL OR instr(':'||:P371_VEHICLE||':',':'||b.VehicleNo||':') > 0 )
                  and ( :P371_DRIVER IS NULL OR instr(':'||:P371_DRIVER||':',':'||e.EmployeeCode||':') > 0 );
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 204004530285396985
        }

        column EMPLOYEENAME (
            type: plainText
            heading {
                heading: DRIVER NAME
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: LOCATION NAME
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column SHIFTNAME (
            type: plainText
            heading {
                heading: SHIFT NAME
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column VEHICLEDRIVERDATE (
            type: plainText
            heading {
                heading: ENTRY DATE
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column VEHICLEDRIVERNO (
            type: plainText
            heading {
                heading: ENTRY NO
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: VEHICLE NO
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 16
            pageHeaderText: "     Vehicle Driver Report"
        }
        columnHeadings {
            fontSize: 12
        }

        savedReport 1021322 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMPLOYEENAME (
                sequence: 7
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SHIFTNAME (
                sequence: 5
            )

            displayColumn VEHICLEDRIVERDATE (
                sequence: 4
            )

            displayColumn VEHICLEDRIVERNO (
                sequence: 3
            )

            displayColumn VEHICLENO (
                sequence: 6
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region vehicle-driver-detail (
        name: Vehicle Driver Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P371_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                b.CompanyName d,
                b.CompanyCode r                                                
                From VehicleDriver a, Company b
                Where a.CompanyCode = b.CompanyCode
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @vehicle-driver-detail
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

