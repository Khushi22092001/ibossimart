        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct employeename, b.employeecode
                  From VehicleLogBook a, Employee b
                 Where a.operatorcode = b.employeecode
                 Order By 2
                ```
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 90
            region: @tipper-working-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
