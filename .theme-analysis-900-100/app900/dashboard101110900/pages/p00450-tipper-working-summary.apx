page 450 (
    name: Tipper Working Summary
    alias: TIPPER-WORKING-SUMMARY
    title: Tipper Working Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/PCReport.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P267_FROMDATE').val());
              var toDate = new Date($('#P267_TODATE').val());
            
              var reportParams = 
                '&P_COMPANY=' + $('#P267_COMPANY').val() + 
                '&P_LOCATION=' +  $('#P267_LOCATION').val() +
                '&P_FROMDATE=' +  formatDate(fromDate) + 
                '&P_TODATE='  +  formatDate(toDate) + 
                '&P_EQUIPMENTGROUP=' + $('#P267_EQUIPMENTGROUP').val() + 
                '&P_SHIFT=' + $('#P267_SHIFT').val() + 
                '&P_DOORNO=' + $('#P267_DOORNO').val() 
                  ;
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            ```
    }
    css {
        inline:
            ```css
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWNUM As SerialNo,
                xx.*
                from 
                (Select --ROWNUM As SerialNo,
                       x.locationcode,
                       GetLocationName(x.Locationcode) As LocationName,
                       x.DoorNo,
                       --x.EQUIPMENTGROUPNAME,
                       Sum(x.RunningKM) As RunningKM,
                       Sum(x.RunningHRs) as RunningHrs
                from 
                (Select --rownum AS SERIALNO,
                 a.VehicleLogBookDate,
                 s.ShiftName,
                 --c.equipmentcode As DoorNo,
                 c.EquipmentId As DoorNo,
                 c.equipmentgroupcode,
                 K.EQUIPMENTGROUPNAME,
                 E.EMPLOYEEID,
                 e.EmployeeName,
                 a.openingmeterreading As StartingKM,
                 a.closingmeterreading As EndKM,
                 a.OpeningWorkingHrs   As StartingHRs,
                 a.ClosingWorkingHrs   As EndHrs,
                 a.LocationCode ,
                 --GetLocationName(a.LocationCode) As Location,
                 -- b1.vehicleno,
                 
                 -- a.VehicleLogBookDate,
                 
                 --j.JobTypeName,
                 Sum(nvl(b.NoofTrips, 0)) As TotalTrip,
                 (a.closingmeterreading - a.openingmeterreading) As RunningKM,
                 (a.ClosingWorkingHrs - a.OpeningWorkingHrs) As RunningHRs
                
                /*Case
                   When (a.closingmeterreading - a.openingmeterreading) = 0 Then
                    Sum(b.NoOfTrips) / 1
                   Else
                    round(Sum(B.NOOFTRIPS) / (a.closingmeterreading - a.openingmeterreading),
                          2)
                 End As AvgTrip
                */
                  From VehicleLogBook       a,
                       VehicleLogBookDetail b,
                       CompanyVehicle       b1,
                       Equipment            c,
                       Employee             e,
                       Shift                s,
                       JobType              j,
                       EquipmentGroup       k,
                       ITEM                 L
                 Where 1 = 1
                   And a.TNo = b.TNo
                   And a.EquipmentTNo = b1.tno
                   And b1.ModuleTNo = c.TNo
                   And a.OperatorCode = e.EmployeeCode(+)
                   And a.ShiftCode = s.ShiftCode
                   And b.JobTypeCode = j.JobTypeCode(+)
                   And c.Equipmentgroupcode = k.EquipmentGroupCode(+)
                   And C.ITEMCODE = L.ITEMCODE
                      --- Filter
                --   And L.PARENTCODE = '19162' -- FOR ITEMGROUP TIPPERS
                   And a.Vehiclelogbookdate Between :P450_FROMDATE and :P450_TODATE
                  and ( :P450_COMPANY is null or (instr(':'||:P450_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  and ( :P450_LOCATION is null or (instr(':'||:P450_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and ( :P450_SHIFT IS NULL OR instr(':'||:P450_SHIFT||':',':'||a.shiftCode||':') > 0 ) 
                  and ( :P450_DOORNO IS NULL OR instr(':'||:P450_DOORNO||':',':'||c.equipmentid||':') > 0 ) 
                --  and ( :P450_EQUIPMENTGROUP IS NULL OR instr(':'||:P450_EQUIPMENTGROUP||':',':'||c.EquipmentGroupCode||':') > 0 )
                 --  and ( :P450_ITEMGROUP IS NULL OR instr(':'||:P450_ITEMGROUP||':',':'||L.PARENTCODE||':') > 0 ) 
                   and ( :P450_EQUIPMENTCATEGORY IS NULL OR instr(':'||:P450_EQUIPMENTCATEGORY||':',':'||C.EQUIPMENTCATEGORYCODE||':') > 0 ) 
                   and ( :P450_DRIVER IS NULL OR instr(':'||:P450_DRIVER||':',':'||a.OperatorCode||':') > 0 ) 
                 
                 Group By a.VehicleLogBookDate,
                          s.ShiftName,
                          --c.equipmentcode,
                          c.equipmentgroupcode,
                          K.EQUIPMENTGROUPNAME,
                          c.EquipmentId,
                          e.EmployeeName,
                          E.EMPLOYEEID,
                          a.openingmeterreading,
                          a.closingmeterreading,
                          a.OpeningWorkingHrs,
                          a.ClosingWorkingHrs,
                          a.LocationCode,
                          GetLocationName(a.LocationCode),
                          b1.vehicleno,
                          a.VehicleLogBookDate,
                          -- j.JobTypeName,
                          --Sum(nvl(b.NoofTrips, 0)) As TotalTrip,
                          (a.closingmeterreading - a.openingmeterreading),
                          (a.ClosingWorkingHrs - a.OpeningWorkingHrs)
                ) x
                Group By locationcode,
                       GetLocationName(Locationcode),
                       DoorNo,
                       EQUIPMENTGROUPNAME
                order by locationcode,doorno
                ) xx
                 
                  
                ```
            pageItemsToSubmit: [
                P450_COMPANY
                P450_LOCATION
                P450_FROMDATE
                P450_TODATE
                P450_EQUIPMENTGROUP
                P450_SHIFT
                P450_DOORNO
                P450_ITEMGROUP
                P450_EQUIPMENTCATEGORY
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 141444276771125505
        }

