    region unbilled-transportation-payable-2 (
        name: Unbilled Transportation Payable
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                  row_number() over(order by a.VoucherDate) SerialNo,
                  a.VoucherNo,
                  a.VoucherDate,
                  a.Amount as ToBeBilled,
                  ----------------------------------- --
                  -- 29-jan-2025 
                  -- CASE WHEN NVL(A.REVERSEVOUCHERDATE, '31-MAR-3000') <= '31-MAR-2024' THEN A.AMOUNT ELSE 0 END as BilledAmount,
                  -- (A.AMOUNT -  CASE WHEN NVL(A.REVERSEVOUCHERDATE, '31-MAR-3000') <= '31-MAR-2024' THEN A.AMOUNT ELSE 0 END ) UnbilledAmount,
                    case when a.ReverseVoucherNo is not null then a.Amount else 0 end as BilledAmount,
                    case when a.ReverseVoucherNo is not null then 0 else a.Amount end as UnbilledAmount,
                  ----------------------------------- --
                  a.FreightAdviceNo,
                  a.FreightAdviceDate,
                  a.ReverseVoucherNo,
                  a.ReverseVoucherDate,
                  b.CompanyName,
                  c.LocationName,
                  a.VEHICLENO                     ,
                  a.TRANSPORTER                   , 
                  a.SOURCELOCATIONNAME            , 
                  a.DESTINATIONLOCATIONNAME       , 
                  a.DONO                          , 
                  a.DODATE                        , 
                  a.EWAYBILLNO                    , 
                  a.PARTYNAME                     , 
                  a.ITEMNAME                      , 
                  a.QUANTITY1                     , 
                  a.NOS    
                From UnbilledTransportationPayable a, Company b, Location  c
                Where a.CompanyCode = b.CompanyCode
                 and a.LocationCode = c.LocationCode
                 and a.VoucherDate <= :P455_ASONDATE
                 and ( :P455_COMPANY IS NULL OR instr(':'||:P455_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                Order by a.VoucherDate ASC 
                ```
            pageItemsToSubmit: P455_COMPANY
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
