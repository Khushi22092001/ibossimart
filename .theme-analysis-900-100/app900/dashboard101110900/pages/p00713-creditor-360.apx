    region billing-payment (
        name: Billing vs Payment
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Mv As (
                       Select trunc(d.VoucherDate,'MM') Mth,
                              Sum(Case When v.DocTypeCode In ('PURCHASE','SERVICEBILL') And d.Amount < 0
                                       Then -d.Amount Else 0 End) Billing,
                              Sum(Case When v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT') And d.Amount > 0
                                       Then d.Amount Else 0 End) Payment
                         From VoucherDetail d Join Voucher v On v.Tno = d.Tno
                        Where d.AccountCode = :P713_PARTY
                          And d.VoucherDate >= to_date(:P713_FROMDATE,'DD-MM-RRRR')
                          And d.VoucherDate <  to_date(:P713_TODATE,'DD-MM-RRRR') + 1
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (:P713_PANEL    Is Null Or d.Panel        = :P713_PANEL)
                          And (:P713_COMPANY  Is Null Or d.CompanyCode  = :P713_COMPANY)
                          And (:P713_LOCATION Is Null Or d.LocationCode = :P713_LOCATION)
                        Group By trunc(d.VoucherDate,'MM'))
                Select to_char(Mth,'Mon-RR')          As LABEL,
                       Round(Billing/100000,2)        As BILLING_LAC,
                       Round(Payment/100000,2)     As COLLECTION_LAC
                  From Mv Order By Mth
                ```
            pageItemsToSubmit: [
                P713_PARTY
                P713_FROMDATE
                P713_TODATE
                P713_COMPANY
                P713_LOCATION
                P713_PANEL
            ]
        }
        layout {
            sequence: 26
            slot: body
            startNewRow: false
            columnSpan: 6
        }
