            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                ds-kpiwrap--5up
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P713_PARTY
        }
