    pageItem P713_PARTY (
        type: selectList
        label {
            label: Vendor
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select p.PartyName d, p.PartyCode r
                  From Party p
                 Where p.PartyCode In (Select PartyCode From Party
                         Start With PartyCode = 'SUNDRYCREDITORS' Connect By Prior PartyCode = ParentCode)
                   And Exists (Select 1 From VoucherDetail v
                                Where v.AccountCode = p.PartyCode
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or v.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            nullDisplayValue: Select a vendor
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P713_TODATE (
        type: datePicker
        label {
            label: To Date / As-of
            alignment: left
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: Select to_char(trunc(sysdate),'DD-MM-RRRR') From dual
        }
        security {
            encryptSessionState: false
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
    )

    button back (
        buttonName: BACK
        label: Command Centre
        layout {
            sequence: 100
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 710
                items: {
                    P710_FROMDATE: &P713_FROMDATE.
                    P710_TODATE: &P713_TODATE.
                    P710_COMPANY: &P713_COMPANY.
                    P710_LOCATION: &P713_LOCATION.
                    P710_PANEL: &P713_PANEL.
                    P710_AGEBASIS: &P713_AGEBASIS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button party-summary (
        buttonName: PARTYSUMMARY
        label: All Vendors
        layout {
            sequence: 90
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-users
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 711
                items: {
                    P711_FROMDATE: &P713_FROMDATE.
                    P711_TODATE: &P713_TODATE.
                    P711_COMPANY: &P713_COMPANY.
                    P711_LOCATION: &P713_LOCATION.
                    P711_PANEL: &P713_PANEL.
                    P711_AGEBASIS: &P713_AGEBASIS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
