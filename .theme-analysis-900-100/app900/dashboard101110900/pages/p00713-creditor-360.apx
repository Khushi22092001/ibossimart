    region timeline (
        name: Timeline
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* The vendor's last 60 events in plain chronological order. Deliberately
                   capped: a timeline is read from the top and an uncapped one on a busy
                   account is a scrolling exercise, not a narrative. The cap is stated in
                   the region title rather than applied silently. */
                Select * From (
                  Select d.VoucherDate                             As EVENT_DATE,
                         Case When v.VoucherNo = 'OPENING'      Then 'Opening carry-forward'
                              When v.ModuleCode = 'PBPASS'     Then 'Bill booked'
                              When v.ModuleCode = 'SERVICEBILL' Then 'Service bill raised'
                              When v.ModuleCode = 'DEBITNOTE'  Then 'Credit note issued'
                              When v.ModuleCode = 'CREDITNOTE'   Then 'Debit note issued'
                              When v.ModuleCode = 'INVOICE'      Then 'Purchase from this party (contra)'
                              When v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT')    Then 'Payment received'
                              When v.DocTypeCode = 'RECEIPT'
                                                                Then 'Payment made to this party'
                              Else 'Journal posting' End         As EVENT,
                         v.VoucherNo                             As VOUCHER_NO,
                         d.Tno                                   As VOUCHER_TNO,
                         Round(Abs(d.Amount),2)                  As AMOUNT,
                         Case When d.Amount < 0 Then 'Increases payable'
                              Else 'Reduces payable' End      As EFFECT,
                         apex_escape.html(nvl(l.LocationName, d.LocationCode)) As LOCATION
                    From VoucherDetail d
                    Join Voucher v On v.Tno = d.Tno
                    Left Join Location l On l.LocationCode = d.LocationCode
                   Where d.AccountCode = :P713_PARTY
                     And d.VoucherDate <= to_date(:P713_TODATE,'DD-MM-RRRR')
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P713_PANEL    Is Null Or d.Panel        = :P713_PANEL)
                     And (:P713_COMPANY  Is Null Or d.CompanyCode  = :P713_COMPANY)
                     And (:P713_LOCATION Is Null Or d.LocationCode = :P713_LOCATION)
                   Order By d.VoucherDate Desc, d.Tno Desc)
                 Where rownum <= 60
                ```
            pageItemsToSubmit: [
                P713_PARTY
                P713_TODATE
                P713_COMPANY
                P713_LOCATION
                P713_PANEL
            ]
        }
        layout {
            sequence: 54
            slot: body
        }
