    region outstanding-trend (
        name: Net Exposure Trend
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Month-end NET exposure, computed as the running total of -Amount.
                   No allocation logic is needed here and none is used: allocations net
                   to zero WITHIN a vendor account, so the running ledger total is
                   already the net position. That is the same identity the Reconciliation
                   page proves at 0.00, which is why this shortcut is safe rather than
                   convenient - and it makes the trend cheap instead of re-deriving the
                   whole open-item layer once per month-end. */
                With Mv As (
                       Select trunc(d.VoucherDate,'MM') Mth, Sum(-d.Amount) Net
                         From VoucherDetail d
                        Where d.AccountCode = :P713_PARTY
                          And d.VoucherDate <= to_date(:P713_TODATE,'DD-MM-RRRR')
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (:P713_PANEL    Is Null Or d.Panel        = :P713_PANEL)
                          And (:P713_COMPANY  Is Null Or d.CompanyCode  = :P713_COMPANY)
                          And (:P713_LOCATION Is Null Or d.LocationCode = :P713_LOCATION)
                        Group By trunc(d.VoucherDate,'MM'))
                Select to_char(Mth,'Mon-RR')                              As LABEL,
                       Round(Sum(Net) Over (Order By Mth)/100000,2)       As NET_EXPOSURE_LAC
                  From Mv Order By Mth
                ```
            pageItemsToSubmit: [
                P713_PARTY
                P713_TODATE
                P713_COMPANY
                P713_LOCATION
                P713_PANEL
            ]
        }
        layout {
            sequence: 25
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
