page 180 (
    name: Vr. Narration
    alias: VR-NARRATION
    title: Vr. Narration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region voucher-narration (
        name: Voucher Narration
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                a.tno,
                a.serialno,
                a.narration
                from accountledgerreport a
                where a.tno = NVL(:P180_TNO,255190462)
                order by a.serialno
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 151709487113325612
        }

        column NARRATION (
            type: plainText
            heading {
                heading: Narration
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column SERIALNO (
            type: hidden
            heading {
                heading: SERIAL NO
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        savedReport 134309 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn NARRATION (
                sequence: 2
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            aggregate (
                column: DRAMOUNT
            )

            aggregate (
                column: CRAMOUNT
            )

        )

    )

    pageItem P180_SNO (
        type: hidden
        layout {
            sequence: 20
            region: @voucher-narration
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P180_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @voucher-narration
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

