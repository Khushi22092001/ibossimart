page 30 (
    name: Module Logs
    alias: MODULE-LOGS
    title: Module Logs
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region module-logs (
        name: Module Logs
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--noBorder
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-left-none
                margin-right-none
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region module-logs-report (
        name: Module Logs Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by a.actionTime) SerialNo,
                      a.ActionTime,
                      a.ActionUser,
                      a.ActionType,
                      a.ModuleCode,
                      m.ModuleName,
                      a.ModuleTNo,
                      a.HostName,
                      a.OS_User,
                      a.IP_Address,
                      a.TransactionNo,
                      a.UserLocation
                From  ActionLog a, Module m
                Where a.ModuleCode = m.ModuleCode(+)
                  and Trunc(a.ActionTime) Between :P30_FROMDATE and :P30_TODATE
                  and ( :P30_ACTIONUSER IS NULL OR instr(','||:P30_ACTIONUSER||',',','||a.ActionUser||',') > 0 ) 
                  --and a.ModuleCode :P30_ModuleCode
                  and ( :P30_MODULE IS NULL OR instr(','||:P30_MODULE||',',','||a.ModuleCode||',') > 0 ) 
                  and a.ActionType like nvl(:P30_ACTIONTYPE,'%')
                  and a.TransactionNo like nvl(:P30_TNO,'%')
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 51764877679820702
        }

        column ACTIONTIME (
            type: plainText
            heading {
                heading: ACTION TIME
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            appearance {
                formatMask: DD-MON-YYYY HH:MIPM
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column ACTIONTYPE (
            type: plainText
            heading {
                heading: ACTION TYPE
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ACTIONUSER (
            type: plainText
            heading {
                heading: ACTION USER
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column HOSTNAME (
            type: plainText
            heading {
                heading: HOST NAME
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column IP_ADDRESS (
            type: plainText
            heading {
                heading: IP_ADDRESS
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: MODULE CODE
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: MODULE NAME
                alignment: center
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column MODULETNO (
            type: plainText
            heading {
                heading: MODULE TNO
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column OS_USER (
            type: plainText
            heading {
                heading: OS_USER
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column TRANSACTIONNO (
            type: plainText
            heading {
                heading: TRANSACTION NO
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column USERLOCATION (
            type: plainText
            heading {
                heading: USER LOCATION
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: CLOB
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: J
            }
            enableUsersTo {
                sort: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Module Logs Report
        }

        savedReport 40132 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIONTIME (
                sequence: 2
            )

            displayColumn ACTIONTYPE (
                sequence: 4
            )

            displayColumn ACTIONUSER (
                sequence: 3
            )

            displayColumn HOSTNAME (
                sequence: 7
            )

            displayColumn IP_ADDRESS (
                sequence: 9
            )

            displayColumn MODULENAME (
                sequence: 5
            )

            displayColumn OS_USER (
                sequence: 8
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TRANSACTIONNO (
                sequence: 6
            )

            displayColumn USERLOCATION (
                sequence: 10
            )

            sort (
                column: ACTIONTIME
                sort {
                    sequence: 1
                }
            )

        )

    )

    pageItem P30_ACTIONTYPE (
        type: selectList
        label {
            label: Action Type
            alignment: left
        }
        settings {
            pageActionOnSelection: submitPage
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                ActionType,
                ActionType as Code
                From ActionLog
                ```
            nullDisplayValue: --Select Action Type --
        }
        layout {
            sequence: 40
            region: @module-logs
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P30_ACTIONUSER (
        type: popupLov
        label {
            label: Action User
            alignment: left
        }
        settings {
            fetchOnSearch: true
            title: List  of  ActionUser
            popupWidth: 450
            popupHeight: 350
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                ActionUser,
                Actionuser as Code
                From ActionLog
                ```
        }
        multipleValues {
            type: delimitedList
            separator: ,
        }
        layout {
            sequence: 30
            region: @module-logs
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Action User
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P30_FROMDATE (
        type: datePickerJquery
        label {
            label: From Date
            alignment: left
        }
        settings {
            show: both
            navigationListFor: monthAndYear
        }
        layout {
            sequence: 10
            region: @module-logs
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: From Date
        }
        default {
            type: expression
            plsqlExpression: Trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P30_MODULE (
        type: popupLov
        label {
            label: Module
            alignment: left
        }
        settings {
            fetchOnSearch: true
            title: List  of Modules
            popupWidth: 450
            popupHeight: 350
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                m.ModuleName,
                m.ModuleCode
                From ActionLog a, Module m
                Where a.ModuleCode = m.ModuleCode
                Order by 1
                ```
        }
        multipleValues {
            type: delimitedList
            separator: ,
        }
        layout {
            sequence: 50
            region: @module-logs
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Module Name
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P30_TNO (
        type: textFieldWithAutocomplete
        label {
            label: Transaction No
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnType: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                TransactionNo
                From ActionLog
                ```
        }
        layout {
            sequence: 60
            region: @module-logs
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Transaction No
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P30_TODATE (
        type: datePickerJquery
        label {
            label: To Date
            alignment: left
        }
        settings {
            show: both
            navigationListFor: monthAndYear
        }
        layout {
            sequence: 20
            region: @module-logs
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: To Date
        }
        default {
            type: expression
            plsqlExpression: Trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    button referesh (
        buttonName: REFERESH
        label: Referesh
        layout {
            sequence: 70
            region: @module-logs
            slot: regionBody
            column: 10
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

