page 402 (
    name: Spare Amount Detail
    alias: SPARE-AMOUNT-DETAIL
    title: Spare Amount Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region spare-amount-detail (
        name: Spare Amount Detail
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region spare-amount-detail-2 (
        name: Spare Amount Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                b.IssueNo,
                b.IssueDate,
                a.EquipmentID,
                d.ItemName || ' - ' || e.ItemSpecificationName as ItemName,
                f.MeasuringUnitName,
                x.Quantity1,
                x.Rate,
                x.Quantity1 * x.Rate as Amount
                From PayloaderExpenseTable a, Issue b, IssueDetail c, Item d, ItemSpecification e, MeasuringUnit f,
                (
                Select
                a.Tno,
                a.Sno,
                sum(a.Quantity1) as Quantity1,
                round(sum(b.Rate)/count(a.Tno), 2) as Rate
                From IssueStockStorageDetail a, Stock b
                Where a.StockTno = b.Tno
                Group by a.Tno, a.Sno
                ) x
                Where a.Tno = b.Tno
                and b.Tno = c.Tno
                and c.ItemCode = d.ItemCode(+)
                and c.ItemSpecificationCode = e.ItemSpecificationCode(+)
                and d.MeasuringUnitCode1 = f.MeasuringUnitCode(+)
                and c.Tno = x.Tno(+)
                and c.Sno = x.Sno(+)
                and b.Tno = :P402_TNO
                and a.Creator = :APP_USER
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 6707652446598211
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column EQUIPMENTID (
            type: plainText
            heading {
                heading: Equipment Id
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ISSUEDATE (
            type: plainText
            heading {
                heading: Issue Date
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column ISSUENO (
            type: plainText
            heading {
                heading: Issue No
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column ITEMNAME (
            type: plainText
            heading {
                heading: Item
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column MEASURINGUNITNAME (
            type: plainText
            heading {
                heading: Measuring Unit
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Quantity
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column RATE (
            type: plainText
            heading {
                heading: Rate
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Spare Amount Detail
        }

        savedReport 84419 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 8
            )

            displayColumn EQUIPMENTID (
                sequence: 3
            )

            displayColumn ISSUEDATE (
                sequence: 2
            )

            displayColumn ISSUENO (
                sequence: 1
            )

            displayColumn ITEMNAME (
                sequence: 4
            )

            displayColumn MEASURINGUNITNAME (
                sequence: 5
            )

            displayColumn QUANTITY1 (
                sequence: 6
            )

            displayColumn RATE (
                sequence: 7
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: QUANTITY1
            )

        )

    )

    pageItem P402_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @spare-amount-detail
            slot: regionBody
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

