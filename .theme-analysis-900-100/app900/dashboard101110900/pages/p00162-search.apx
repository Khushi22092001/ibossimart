page 162 (
    name: Search Menu / Pages
    alias: SEARCH
    title: Search Menu / Pages
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 920
        height: 720
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            (function ($) {
              var timer = null, selected = -1;
              function rows() { return $('.hs-search-results .hs-search-row:visible'); }
              function select(i) {
                var r = rows();
                if (!r.length) { selected = -1; return; }
                selected = Math.max(0, Math.min(i, r.length - 1));
                r.removeClass('is-selected').attr('aria-selected','false');
                r.eq(selected).addClass('is-selected').attr('aria-selected','true')[0].scrollIntoView({block:'nearest'});
              }
              function refreshResults() {
                selected = -1;
                apex.region('searchResults').refresh();
                $('.hs-search-popular').toggle(!$.trim($v('P162_SEARCH')));
              }
              $(function () {
                /* A before-header process clears the persisted item before the page renders,
                   so a reopened dialog never flashes the previous result set. */
                $s('P162_SEARCH','');
                selected = -1;
                $('.hs-search-popular').show();
                setTimeout(function(){ $('#P162_SEARCH').trigger('focus'); }, 120);
                $(document).on('input.hsSearch', '#P162_SEARCH', function () {
                  clearTimeout(timer); timer = setTimeout(refreshResults, 180);
                });
                $(document).on('keydown.hsSearch', '#P162_SEARCH', function (e) {
                  if (e.key === 'ArrowDown') { e.preventDefault(); select(selected + 1); }
                  else if (e.key === 'ArrowUp') { e.preventDefault(); select(selected < 0 ? rows().length - 1 : selected - 1); }
                  else if (e.key === 'Enter') {
                    e.preventDefault();
                    var r = rows(); if (r.length) (r.eq(selected < 0 ? 0 : selected)[0]).click();
                  } else if (e.key === 'Escape' && $v('P162_SEARCH')) {
                    e.stopPropagation(); $s('P162_SEARCH',''); refreshResults();
                  }
                });
                $(document).on('click.hsSearch', '#searchGo', function(e){ e.preventDefault(); refreshResults(); $('#P162_SEARCH').trigger('focus'); });
                $(document).on('mouseenter.hsSearch', '.hs-search-row', function(){ select(rows().index(this)); });
                $(document).on('apexafterrefresh.hsSearch', '#searchResults', function(){ selected = -1; });
              });
            })(apex.jQuery);
            ```
    }
    css {
        inline:
            ```css
            body{background:#f8faff;}
            .hs-search-shell{margin:0!important;border:0!important;background:transparent!important;box-shadow:none!important;}
            .hs-search-shell .t-Region-body{padding:0 0 12px!important;}
            #P162_SEARCH_CONTAINER{margin:0;}
            #P162_SEARCH_CONTAINER .t-Form-itemWrapper{position:relative;}
            #P162_SEARCH_CONTAINER .t-Form-itemWrapper:before{content:"\f002";font-family:"Font APEX Small";position:absolute;inset-inline-start:17px;top:50%;transform:translateY(-50%);z-index:2;color:#667085;font-size:17px;pointer-events:none;}
            #P162_SEARCH{height:48px;padding-inline-start:52px!important;padding-inline-end:14px!important;text-indent:0!important;border:2px solid #7c5cff;border-radius:10px;background:#fff;font-size:14px;box-shadow:0 0 0 3px rgba(124,92,255,.07);}
            #searchGo{height:48px;min-width:64px;border-radius:10px;}
            .hs-search-label{margin:8px 0 10px;color:#6655d9;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;}
            .hs-search-popular .t-Report-report{width:100%;}.hs-search-popular .t-Report-report tbody{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:8px;}
            .hs-search-popular .t-Report-report tbody tr,.hs-search-popular .t-Report-report td{display:block!important;width:100%;padding:0!important;border:0!important;background:transparent!important;}
            .hs-search-card{display:flex;width:100%;min-height:104px;padding:12px 7px 10px;align-items:center;justify-content:flex-start;flex-direction:column;gap:7px;border:1px solid #e4e8f2;border-radius:12px;background:#fff;color:#17213d;text-align:center;text-decoration:none;box-shadow:0 3px 10px rgba(23,33,61,.04);transition:.15s ease;}
            .hs-search-card:hover,.hs-search-card:focus{transform:translateY(-2px);border-color:#8b72ff;box-shadow:0 7px 18px rgba(99,75,210,.13);outline:0;}
            .hs-search-card-ic{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:#eef8ff;color:#08a7c7;font-size:17px;}
            .hs-search-popular tr:nth-child(2n) .hs-search-card-ic{background:#fff4e8;color:#f28b18}.hs-search-popular tr:nth-child(3n) .hs-search-card-ic{background:#fff0f6;color:#e83e8c}.hs-search-popular tr:nth-child(4n) .hs-search-card-ic{background:#f0efff;color:#674de6}
            .hs-search-card b{font-size:10.5px;line-height:1.25;}
            .hs-search-results{margin-top:12px!important;border:0!important;background:transparent!important;box-shadow:none!important;}
            .hs-search-results .t-Region-body{padding:0!important;}
            .hs-search-results .t-Report-report{width:100%;border:1px solid #e5e9f2;border-radius:12px;border-collapse:separate;border-spacing:0;overflow:hidden;background:#fff;}
            .hs-search-results .t-Report-report thead{display:none;}.hs-search-results .t-Report-report td{padding:0!important;border:0!important;background:#fff!important;}
            .hs-search-row{display:grid;grid-template-columns:42px minmax(0,1fr) 180px 38px;align-items:center;gap:10px;min-height:48px;padding:7px 12px;border-bottom:1px solid #edf0f6;color:#1d2945;text-decoration:none;transition:.12s ease;}
            .hs-search-results tr:last-child .hs-search-row{border-bottom:0;}
            .hs-search-row:hover,.hs-search-row.is-selected,.hs-search-row:focus{background:#f1efff;color:#3824a8;outline:0;}
            .hs-search-row-ic{display:grid;place-items:center;width:29px;height:29px;border-radius:8px;background:#f0efff;color:#6c50e8;}
            .hs-search-row-title{font-size:12px;font-weight:700;}.hs-search-row-module{font-size:10.5px;color:#667085;}.hs-search-row-go{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:#f1efff;color:#7559ef;}
            .hs-search-empty{padding:38px;text-align:center;color:#667085;}
            @media(max-width:760px){.hs-search-popular .t-Report-report tbody{grid-template-columns:repeat(4,minmax(0,1fr));}.hs-search-row{grid-template-columns:36px minmax(0,1fr) 30px}.hs-search-row-module{display:none;}}
            ```
    }
    security {
        formAutoComplete: false
    }

    region popular-pages (
        name: Popular Pages
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a class="hs-search-card" target="_top" href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>a.Page_Id,p_clear_cache=>to_char(a.Page_Id)))||'">'
                    ||'<span class="hs-search-card-ic"><span class="fa '||
                      Case a.Page_Id When 27 Then 'fa-shopping-cart' When 37 Then 'fa-truck' When 526 Then 'fa-handshake-o'
                           When 56 Then 'fa-file-text-o' When 77 Then 'fa-clipboard' When 15 Then 'fa-list-alt'
                           When 520 Then 'fa-handshake-o' Else 'fa-balance-scale' End||'"></span></span>'
                    ||'<b>'||apex_escape.html(a.Page_Name)||'</b></a>' Card
                  From Apex_Application_Pages a
                 Where a.Application_Id=:APP_ID
                   And a.Page_Id In (27,37,526,56,77,15,520,314)
                   And GetApexReportPrivilege_varchar('1',a.Page_Id,:APP_USER)='True'
                 Order By Instr(',27,37,526,56,77,15,520,314,',','||a.Page_Id||',')
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hs-search-popular
        }
        headerAndFooter {
            headerText: <div class="hs-search-label">Popular Pages</div>
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region search-controls (
        name: Search pages
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--stretchInputs
            ]
            cssClasses: hs-search-shell
        }
    )

    region search-results (
        name: All Pages
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a class="hs-search-row" role="option" aria-selected="false" target="_top" href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>a.Page_Id,p_clear_cache=>to_char(a.Page_Id)))||'">'
                    ||'<span class="hs-search-row-ic"><span class="fa fa-file-o"></span></span>'
                    ||'<span class="hs-search-row-title">'||apex_escape.html(a.Page_Name)||'</span>'
                    ||'<span class="hs-search-row-module">'||apex_escape.html(nvl(a.Page_Group,'General'))||'</span>'
                    ||'<span class="hs-search-row-go"><span class="fa fa-angle-right"></span></span></a>' Row_Html
                  From Apex_Application_Pages a
                 Where a.Application_Id=:APP_ID
                   And a.Page_Id Not In (40,38,44,43,60,41,162,9999)
                   And GetApexReportPrivilege_varchar('1',a.Page_Id,:APP_USER)='True'
                   And (:P162_SEARCH Is Null
                        Or Instr(Upper(a.Page_Name||' '||nvl(a.Page_Group,' ')),Upper(Trim(:P162_SEARCH)))>0)
                 Order By Case When :P162_SEARCH Is Not Null And Upper(a.Page_Name) Like Upper(Trim(:P162_SEARCH))||'%' Then 0 Else 1 End,
                          a.Page_Name
                 Fetch First 40 Rows Only
                ```
            pageItemsToSubmit: P162_SEARCH
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hs-search-results
        }
        advanced {
            htmlDomId: searchResults
        }
        headerAndFooter {
            headerText: <div class="hs-search-label">All Pages</div>
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: <div class="hs-search-empty"><span class="fa fa-search fa-2x"></span><p>No matching page found. Try another keyword.</p></div>
        }

        column ROW_HTML (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    pageItem P162_SEARCH (
        type: textField
        label {
            label: Search menu, pages or keywords
            alignment: left
        }
        layout {
            sequence: 10
            region: @search-controls
            slot: regionBody
            columnSpan: 11
            labelColumnSpan: 0
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            valuePlaceholder: Search menu, pages or keywords...
        }
        security {
            encryptSessionState: false
        }
    )

    button go (
        buttonName: GO
        label: Go
        layout {
            sequence: 20
            region: @search-controls
            slot: regionBody
            startNewRow: false
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: searchGo
        }
    )

    process clear-search-on-open (
        name: Clear search before rendering
        type: executeCode
        source {
            plsqlCode: :P162_SEARCH:=Null;
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 162001
        }
    )

)

