            column: PENDINGSO
            cssClasses: cardtitle
        }
        subtitle {
            column: AMOUNT
            cssClasses: cardsubtitle
        }
        body {
            advancedFormatting: true
            htmlExpression: <H4 style="font-size:20px; text-align:center"> Pending Sales Order </H4>
        }
