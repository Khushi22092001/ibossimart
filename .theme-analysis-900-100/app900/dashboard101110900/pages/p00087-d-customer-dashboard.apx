page 87 (
    name: D Customer Dashboard
    alias: D-CUSTOMER-DASHBOARD
    title: Customer Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .customerinfo{background-color:#CAF279;}
            .monthsale{background-color:#F7C872;height: 349px;}
            .mytext{font-weight: 500;}
            .cardtitle{font-size: 40px;font-family:'Calibri';font-weight: 900;margin-bottom: 20px;}
            .cardsubtitle{font-size: 20px;font-family:'Calibri';font-weight: 700;}
            .color1{background-color: #f84f4f;}
            .color2{background-color: #b51212}
            .color3{background-color: #12b5b5}
            .color4{background-color: #75d9d9}
            .color5{background-color: #cf98e0}
            .color6{background-color: #a9e098}
            .color7{background-color: #fbb1c7}
            .color8{background-color: #b1fbe5}
            .color9{background-color: #f48956}
            .color10{background-color:#fefe69}
            .region1{background-color: gainsboro;height: 240px;}
            .hiddenscroll{overflow: hidden;}
            .reportheight{height: 350px; overflow: auto !important;}
            .h2+h3{margin-top: 0em;}
            .caption{font-weight: bold;}
            .captionvalue{font-weight: normal;}
            .t-Form-label{padding-top: 0px;padding-bottom: 0px;margin-top: 0px;margin-bottom: 0px;padding-right: 2px;margin-right:2px;width: 100%;}
            ```
    }
    security {
        formAutoComplete: false
    }

    region 12-months-sales (
        name: 12 Months Sales
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    x.Months,
                    x.Amount
                From 
                (select 
                       TO_CHAR(CCINVOICEDATE,'MONTH')AS MONTHS,
                       SUM(TOTALAMOUNT) AMOUNT
                  from D_CUSTOMER_360VIEW_INVOICE
                  WHERE PARTYCODE = :P87_CUSTOMERCODE
                  GROUP BY TO_CHAR(CCINVOICEDATE,'MONTH')
                )x
                Where rownum<= 12
                ```
        }
        layout {
            sequence: 30
            parentRegion: @customer-dashboard
            slot: subRegions
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                i-h320
                t-Region--textContent
                t-Region--hiddenOverflow
            ]
            cssClasses: monthsale
        }
        chartLayout {
            maxWidth: 600
            height: 270
        }
        legend {
            show: false
        }

        series sales (
            name: Sales
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                        x.PartyCode,
                        x.Months,
                        x.Amount
                    From 
                    (select 
                           PARTYCODE,
                           TO_CHAR(CCINVOICEDATE,'MON-YYYY')AS MONTHS,
                           TO_CHAR(CCINVOICEDATE,'YYYYMM')AS MONTHSYY,
                           SUM(TOTALAMOUNT) AMOUNT
                      from D_CUSTOMER_360VIEW_INVOICE
                      WHERE PARTYCODE = :P87_CUSTOMERCODE
                      GROUP BY TO_CHAR(CCINVOICEDATE,'MON-YYYY'),PARTYCODE,TO_CHAR(CCINVOICEDATE,'YYYYMM')
                      ORDER BY TO_CHAR(CCINVOICEDATE,'YYYYMM')
                    )x
                    Where rownum<= 12
                    ```
            }
            columnMapping {
                label: MONTHS
                value: AMOUNT
            }
            appearance {
                color: #d03333
            }
            link {
                type: redirectThisApp
                target: {
                    page: 92
                    items: {
                        P92_CUSTOMERCODE: &PARTYCODE.
                        P92_MONTH: &MONTHS.
                    }
                    clearCache: 92
                }
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

        axis y-2 (
            name: y2
            minorTicks {
                show: false
            }
        )

    )

    region active-invoice (
        name: Active Invoice
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Case when a.PartyCode is null then '-'
                           else a.PartyCode
                      end as PartyCode,
                      case when nvl(Count(a.TNo),0) =  0 then '-'
                           else to_char(nvl(Count(a.TNo),0))
                      end as Invoice,
                      Case when nvl(Sum(a.TotalAmount),0) = 0 then '-'
                           else to_char(nvl(Sum(a.TotalAmount),0))
                      end as Amount
                From  D_CUSTOMER_360VIEW_ACTIVEINVOICE a, party b
                Where a.PartyCode = :P87_CUSTOMERCODE
                  and a.partycode=b.partycode
                Group by Case when a.PartyCode is null then '-'
                           else a.PartyCode
                      end
                
                ```
        }
        layout {
            sequence: 100
            parentRegion: @customer-dashboard
            slot: subRegions
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            cssClasses: hiddenscroll
        }
        card {
            cssClasses: color10
        }
        title {
            column: INVOICE
            cssClasses: cardtitle
        }
        subtitle {
            column: AMOUNT
            cssClasses: cardsubtitle
        }
        body {
            advancedFormatting: true
            htmlExpression: <H4 style="font-size:20px; text-align:center"> Active Invoice</H4>
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: NO DATA FOUND
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 94
                    items: {
                        P94_CUSTOMERCODE: &PARTYCODE.
                    }
                    clearCache: 94
                }
            }
        )

    )

    region ageing-summary (
        name: Ageing Summary
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select COMPANYCODE,
                       COMPANYNAME,
                       LOCATIONCODE,
                       LOCATIONNAME,
                       DOCTYPECODE,
                       DOCTYPENAME,
                       PARTYCODE,
                       PARTYNAME,
                       COUNT0007,
                       VALUE0007,
                       COUNT0815,
                       VALUE0815,
                       COUNT1622,
                       VALUE1622,
                       COUNT2329,
                       VALUE2329,
                       COUNT3036,
                       VALUE3036,
                       COUNT3743,
                       VALUE3743,
                       ABOVE43COUNT,
                       ABOVE43VALUE
                  from D_CUSTOMER_360VIEW_ACTIVEINVOICEAGEWISE
                  Where PARTYCODE = :P87_CUSTOMERCODE
                ```
        }
        layout {
            sequence: 130
            parentRegion: @customer-dashboard
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        headerAndFooter {
            headerText: <h3 style="font-family:Calibri;text-align:center;background-color: gainsboro;margin-top: 0em;">Ageing Summary</h3>
        }
        toolbar {
            show: false
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 18831933397046034
        }

