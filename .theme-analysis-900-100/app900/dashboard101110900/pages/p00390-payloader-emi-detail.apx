page 390 (
    name: Payloader EMI Detail
    alias: PAYLOADER-EMI-DETAIL
    title: Payloader EMI Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-emi-detail (
        name: Payloader EMI Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*Select
                a.CompanyCode,
                a.EquipmentTno,
                a.LoanNo as ModuleNo,
                a.LoanDate as ModuleDate,
                c.EquipmentID,
                d.ModuleName,
                nvl(b.PrincipleAmount, 0) + nvl(b.InterestAmount, 0)as Amount,
                lo.LocationName
                From Loan a, LoanDetail b, Equipment c, Module d,DocumentStatusDetail dsd, Location lo
                Where a.Tno = b.Tno
                and a.EquipmentTno = c.Tno
                and d.ModuleCode = 'LOAN'
                and a.Tno = dsd.ModuleTno
                and a.LocationCode = lo.LocationCode
                and c.EquipmentGroupCode = 'PL'
                and dsd.DocumentStatusCode = 'ACTIVE'
                and (:P390_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                and b.DueDate between :P390_FROMDATE and :P390_TODATE
                and (:P390_COMPANYCODE is Null Or Instr (':' || :P390_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P390_EQUIPMENTID is Null Or Instr (':' || :P390_EQUIPMENTID || ':' , ':' || a.EquipmentTno || ':') > 0) */
                
                Select
                   row_number() over(order by a.ModuleDate) SerialNo, 
                  a.CompanyCode,
                  a.EquipmentTno,
                  a.EquipmentID,
                  a.ModuleName,
                  a.ModuleNo,
                  a.ModuleDate,
                  a.DueDate,
                  a.Amount,
                  b.LocationName
                From PayloaderExpenseTable a, Location b
                Where a.Creator = :APP_USER
                	and a.LocationCode = b.LocationCode
                	and (:P390_LOCATION is null
                		or exists(
                			 Select
                				aa.LocationCode
                			  From PayloaderPerformanceLocation aa
                			  Where aa.LocationCode = a.LocationCode
                				  and aa.Creator = :APP_USER
                			)
                		)
                	and a.Categories = 'EMI'
                	and a.DueDate between :P390_FROMDATE and :P390_TODATE
                	and (:P390_COMPANYCODE is Null Or Instr (':' || :P390_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                	and (:P390_EQUIPMENTID is Null Or Instr (':' || :P390_EQUIPMENTID || ':' , ':' || a.EquipmentTno || ':') > 0)
                
                ```
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 1113324273001989792
        }

        column AMOUNT (
