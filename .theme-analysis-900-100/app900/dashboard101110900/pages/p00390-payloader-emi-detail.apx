        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Open Billed Detail
        }

        savedReport 1102245 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 8
            )

            displayColumn DUEDATE (
                sequence: 6
            )

            displayColumn EQUIPMENTID (
                sequence: 7
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn MODULEDATE (
