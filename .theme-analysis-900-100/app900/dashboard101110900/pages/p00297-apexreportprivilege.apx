page 297 (
    name: ApexReportPrivilege
    alias: APEXREPORTPRIVILEGE
    title: ApexReportPrivilege
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region apexreportprivilegedetail (
        name: APEXREPORTPRIVILEGEDETAIL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                A.TNO,
                A.SNO,
                A.PAGEID
                FROM APEXREPORTPRIVILEGEDETAIL A
                WHERE A.TNO = :P297_TNO;
                ```
        }
        layout {
            sequence: 40
            parentRegion: @reportprivilege
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 20562158198023716
        }

        savedReport 208419 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @SNO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
