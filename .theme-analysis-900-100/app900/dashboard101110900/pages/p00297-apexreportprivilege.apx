    process apexreportprivilegedetail-save-interactive-grid-data (
        name: APEXREPORTPRIVILEGEDETAIL - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @apexreportprivilegedetail
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 21990165862237724
        }
    )

    process copyprivilege (
        name: COPYPRIVILEGE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Declare
                TTno number;
                VTno number;
                Begin
                Select Tno into VTno From  ApexReportPrivilege 
                where APEXREPORTPRIVILEGENAME = :P297_COPYFROMBOSSUSER;
                
                --
                --
                
                
                Select Tno into TTno From  ApexReportPrivilege 
                where APEXREPORTPRIVILEGECODE = :P297_APEXREPORTPRIVILEGECODE;
                --
                --
                Delete from  ApexReportPrivilegeDetail where Tno = TTno;
                --
                -- 
                 
                Insert into ApexReportPrivilegeDetail
                (Tno,
                Sno,
                PageId
                )
                (Select 
                TTno,
                GlobalTno.Nextval,
                PageId
                From     
                ApexReportPrivilegeDetail     
                where 
                tno = vTno);
                End;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 22318852478008619
        }
        serverSideCondition {
            whenButtonPressed: @copyprivilege
        }
    )

    process deletedetailprocess (
        name: DeleteDetailProcess
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    delete from APEXREPORTPRIVILEGEDETAIL a where a.tno = :P297_TNO;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 21990510592237727
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process gettno (
        name: GETTNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P297_TNO IS NULL THEN
                SELECT GLOBALTNO.NEXTVAL INTO :P297_TNO
                FROM DUAL;
                END IF;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 22316570517008596
        }
    )

    process initialize-form-apexreportprivilege (
        name: Initialize form ApexReportPrivilege
        type: formInitialization
        formRegion: @reportprivilege
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21987610514237698
        }
    )

    process pre-insert (
        name: PRE-INSERT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                IF :P297_TNO IS NULL THEN
                SELECT NVL(MAX(TNO),0)+1
                INTO :P297_TNO
                FROM APEXREPORTPRIVILEGE;
                END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 21990534053237728
        }
    )

    process process-form-reportprivilege (
        name: Process form ReportPrivilege
        type: formAutoRowProcessing
        formRegion: @reportprivilege
        target {
            targetType: tableView
            tableName: APEXREPORTPRIVILEGE
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 21989902954237721
        }
    )

    branch (
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 298
            }
        }
    )

)

