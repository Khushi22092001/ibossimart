page 680 (
    name: Purchase Bill 360
    alias: PURCHASE-BILL-360
    title: Purchase Bill 360
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            PURCHASE BILL 360 — data contract.
            
            SUBJECT. One supplier invoice, held in P680_TNO. Reached from the Purchase Bill
            Register on page 668 and from the Bills report on Supplier 360. This page has no
            filter bar: it describes exactly one document, so there is nothing to filter.
            
            THE TWO AMOUNTS ARE DIFFERENT ON PURPOSE, and both are shown.
              Line value  = SUM(PurchaseBillDetail.Amount) — the TAXABLE purchase value, and
                            the figure every other page in this suite sums.
              Bill amount = the header total, which additionally carries footer tax.
            Confusing the two is the single easiest way to break reconciliation against the
            register, so this page prints them side by side with the difference named rather
            than showing one and letting the reader assume it is the other.
            
            SETTLEMENT IS THE ADVICE BASIS. PBPass.PaidAmount is only written when settlement
            runs through Payment Advice. A blank does NOT prove the bill is unpaid — it may
            have been settled by direct voucher. The card and the columns say so, and the
            ledger voucher number is shown where the pass has posted.
            
            RECEIPTS BEHIND THE BILL come through PurchaseBillGRNDetail, which ties the bill
            to the GRNs it was raised against. A bill with no linked receipt is not
            necessarily wrong — a service or freight bill has nothing to receive — so the
            region says that rather than presenting emptiness as a fault.
            
            PANEL SECURITY. The panel predicate sits on the HEADER query itself, so a bill
            outside the login's panel renders "Bill not found" rather than leaking that it
            exists.
            
            READ-ONLY. Every region is a SELECT.
            ```
    }

    region bill-lines (
        name: Bill Lines
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  d.SNo As LINE_NO,
                  nvl((Select i.ItemName From Item i Where i.ItemCode = d.ItemCode),
                      d.ItemCode) As ITEM,
                  nvl((Select s.ItemSpecificationName From ItemSpecification s
                        Where s.ItemSpecificationCode = d.ItemSpecificationCode),
                      '<span class="ds-muted">no specification</span>') As SPECIFICATION,
                  d.Quantity1 As QUANTITY,
                  nvl((Select m.MeasuringUnitName From MeasuringUnit m
                        Where m.MeasuringUnitCode = d.RateMeasuringUnitCode),
                      '<span class="ds-muted">no unit</span>') As UOM,
                  d.Rate As RATE,
                  d.Amount As AMOUNT,
                  d.TotalAmount As TOTAL_WITH_TAX,
                  -- The rate actually realised on this line, which can differ from the
                  -- stored Rate when the quantity or amount was adjusted after entry.
                  Case When nvl(d.Quantity1,0) > 0
                       Then Round(d.Amount / d.Quantity1, 2) End As REALISED_RATE
                From PurchaseBillDetail d
                Join PurchaseBill h On h.TNo = d.TNo
                Where h.TNo = :P680_TNO
                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                       Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                Order By d.SNo
                ```
            pageItemsToSubmit: P680_TNO
        }
        layout {
            sequence: 25
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: This bill has no lines, or it lies outside the data panel your login may see.
        }

        column AMOUNT (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Amount (taxable)
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            comments {
                comments: Taxable line value. Summing this column reproduces the Line Value card and reconciles to the register.
            }
        )

        column ITEM (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 20
            }
            comments {
                comments: Item name, falling back to the code where the master row is missing.
            }
        )

        column LINE_NO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Line
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            comments {
                comments: The line's serial on the bill. Also the sort key, so it stays projected.
            }
        )

        column QUANTITY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Quantity
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G990D000
            }
            comments {
                comments: In the line's own unit. Do not total this column — lines of one bill may carry different units.
            }
        )

        column RATE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Rate
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            comments {
                comments: The rate as stored on the line.
            }
        )

        column REALISED_RATE (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Realised Rate
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            comments {
                comments: Amount divided by quantity — what was actually paid per unit. Shown beside the stored rate because the two diverge when a line is adjusted after entry, and the realised figure is the one the 360 pages aggregate.
            }
        )

        column SPECIFICATION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Specification
            }
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Renders "no specification" in the muted style rather than an empty cell, which would read as missing data.
            }
        )

        column TOTAL_WITH_TAX (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Total (with tax)
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            comments {
                comments: Line total including footer tax. Sums to the Bill Amount card, NOT to the register.
            }
        )

        column UOM (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Unit
            }
            layout {
                sequence: 50
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: The rate unit for the line. Present because quantities are only comparable within a unit.
            }
        )

    )

    region command-header (
        name: Purchase Bill 360
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-purchase-head">'
                  || '<div class="ds-purchase-head-eyebrow">Purchase Bill 360</div>'
                  || '<h1 class="ds-purchase-head-title">Bill '
                     || apex_escape.html(nvl(h.PartyBillNo, h.PurchaseBillNo)) || '</h1>'
                  || '<p class="ds-purchase-head-sub">One supplier invoice &mdash; what was '
                  || 'billed, what was approved, what has settled, and the receipts it was '
                  || 'raised against.</p>'
                  || '<div class="ds-purchase-head-context">'
                  || '<span class="ds-purchase-head-chip">Supplier <b>'
                     || apex_escape.html(nvl(GetPartyName(h.PartyCode),'not recorded'))
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Supplier bill date <b>'
                     || apex_escape.html(nvl(to_char(h.PartyBillDate,'DD-Mon-RRRR'),
                                             'not recorded'))
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Booked on <b>'
                     || apex_escape.html(to_char(h.PurchaseBillDate,'DD-Mon-RRRR'))
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Our bill no <b>'
                     || apex_escape.html(h.PurchaseBillNo) || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Company <b>'
                     || apex_escape.html(nvl(GetCompanyName(h.CompanyCode),'not recorded'))
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Location <b>'
                     || apex_escape.html(nvl(GetLocationName(h.LocationCode),'not recorded'))
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Doc type <b>'
                     || apex_escape.html(
                          nvl((Select dt.DocTypeName From DocType dt
                                Where dt.DocTypeCode = h.DocTypeCode), h.DocTypeCode))
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">GSTIN <b>'
                     || apex_escape.html(nvl(GetPartyAttributeValue(h.PartyCode,'GSTINNO'),
                                             'Not on file'))
                     || '</b></span>'
                  -- Whether the bill traces to an order at all. A bill with no order is not
                  -- wrong — direct and service purchases exist — but it cannot be reconciled
                  -- against committed spend, so the reader is told.
                  || '<span class="ds-purchase-head-chip">Against order <b>'
                     || Case When h.PurchaseOrderTNo Is Null Then 'No order linked'
                             Else apex_escape.html(
                                    nvl((Select o.PurchaseOrderNo From PurchaseOrder o
                                          Where o.TNo = h.PurchaseOrderTNo),'linked')) End
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip ds-purchase-head-chip--live">Position <b>'
                     || Case When p.PurchaseBillTNo Is Null Then 'Not passed'
                             When nvl(p.PaidAmount,0) = 0 Then 'Passed, no advice settlement'
                             When nvl(p.PaidAmount,0) >= nvl(p.PBPassAmount,0) Then 'Settled'
                             Else 'Part settled' End
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Panel <b>'
                     || apex_escape.html(nvl(h.Panel,'not set')) || '</b></span>'
                  || '</div></div>' As HEAD
                From PurchaseBill h
                Left Join PBPass p On p.PurchaseBillTNo = h.TNo
                Where h.TNo = :P680_TNO
                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                       Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                ```
            pageItemsToSubmit: P680_TNO
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-purchase-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Bill not found, or it lies outside the data panel your login may see.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Whole identity header as one HTML string. Titled by the SUPPLIER's bill number where present — that is what the supplier will quote — with our own number carried as a separate chip.
            }
        )

    )

    region kpi-strip (
        name: Bill Position
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Ln As (
                  Select Sum(d.Amount) LineVal,
                         Sum(d.TotalAmount) TotalVal,
                         Count(*) Lines,
                         Count(Distinct d.ItemCode) Items
                    From PurchaseBillDetail d
                    Join PurchaseBill h On h.TNo = d.TNo
                   Where h.TNo = :P680_TNO
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))),
                Ps As (
                  Select p.PBPassAmount Passed, p.PaidAmount PaidAdv,
                         p.PBPassNo, p.PBPassDate, p.PurchaseBillTNo,
                         (Select Max(v.VoucherNo) From Voucher v
                           Where v.ModuleCode = 'PBPASS' And v.ModuleTNo = p.TNo) VoucherNo
                    From PBPass p
                    Join PurchaseBill h On h.TNo = p.PurchaseBillTNo
                   Where h.TNo = :P680_TNO
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))),
                Rc As (
                  Select Count(Distinct bg.GRNTno) Grns
                    From PurchaseBillGRNDetail bg
                   Where bg.TNo = :P680_TNO)
                Select
                  '<div class="ds-kpi ds-kpi--value" title="SUM(PurchaseBillDetail.Amount) — '
                  || 'the TAXABLE line value. This is the figure every other page in the '
                  || 'suite sums, and the one that reconciles to the Purchase Bill Register.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-inr"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Line Value (taxable)</span>'
                  || '<span class="ds-kpi-n">Rs '
                     || to_char(nvl(l.LineVal,0),'FM99G99G99G990D00') || '</span>'
                  || '<span class="ds-kpi-sub">' || to_char(nvl(l.Lines,0),'FM999G990')
                     || ' lines &middot; ' || to_char(nvl(l.Items,0),'FM999G990')
                     || ' distinct items</span>'
                  || '</span></div>' As KPI1,
                  -- Shown BESIDE the line value, with the gap named, so the two can never be
                  -- mistaken for one another.
                  '<div class="ds-kpi ds-kpi--bill" title="The line total including footer '
                  || 'tax. Larger than the taxable line value; the difference is the tax and '
                  || 'other footer heads. Do NOT sum this column across bills expecting it to '
                  || 'match the register — the register totals the taxable value.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-file-text-o"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Bill Amount (with tax)</span>'
                  || '<span class="ds-kpi-n">Rs '
                     || to_char(nvl(l.TotalVal,0),'FM99G99G99G990D00') || '</span>'
                  || '<span class="ds-kpi-sub">Rs '
                     || to_char(nvl(l.TotalVal,0) - nvl(l.LineVal,0),'FM99G99G99G990D00')
                     || ' of tax and footer heads</span>'
                  || '</span></div>' As KPI2,
                  '<div class="ds-kpi ds-kpi--ok" title="PBPass.PBPassAmount — the amount '
                  || 'approved for payment. One pass per bill.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-check-square-o"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Passed</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When p.PurchaseBillTNo Is Null
                             Then '<span class="ds-muted">not passed</span>'
                             Else 'Rs ' || to_char(nvl(p.Passed,0),'FM99G99G99G990D00') End
                     || '</span>'
                  || '<span class="ds-kpi-sub">'
                     || Case When p.PBPassNo Is Null
                             Then 'no pass raised against this bill'
                             Else 'Pass ' || apex_escape.html(p.PBPassNo) || ' on '
                                  || to_char(p.PBPassDate,'DD-Mon-RRRR') End
                     || '</span>'
                  || '</span></div>' As KPI3,
                  '<div class="ds-kpi ds-kpi--suppl" title="PBPass.PaidAmount — the Payment '
                  || 'Advice basis ONLY. A blank does not prove the bill is unpaid: it may '
                  || 'have been settled by direct voucher, which this column never records.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-credit-card"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Settled (via advice)</span>'
                  || '<span class="ds-kpi-n">Rs '
                     || to_char(nvl(p.PaidAdv,0),'FM99G99G99G990D00') || '</span>'
                  || '<span class="ds-kpi-sub">'
                     || Case When nvl(p.PaidAdv,0) = 0
                             Then '<span class="ds-muted">may still be paid by direct '
                                  || 'voucher</span>'
                             Else 'advice route only' End
                     || '</span>'
                  || '</span></div>' As KPI4,
                  '<div class="ds-kpi ds-kpi--risk" title="Passed less settled, on the advice '
                  || 'basis. Null rather than zero where the bill has not been passed — an '
                  || 'unpassed bill is not a settled one.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-hourglass-half"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Unsettled</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When p.PurchaseBillTNo Is Null
                             Then '<span class="ds-muted">not passed</span>'
                             Else 'Rs ' || to_char(nvl(p.Passed,0) - nvl(p.PaidAdv,0),
                                                   'FM99G99G99G990D00') End
                     || '</span>'
                  || '<span class="ds-kpi-sub">'
                     || Case When p.VoucherNo Is Not Null
                             Then 'Ledger voucher ' || apex_escape.html(p.VoucherNo)
                             Else '<span class="ds-muted">no ledger voucher posted</span>' End
                     || '</span>'
                  || '</span></div>' As KPI5,
                  '<div class="ds-kpi ds-kpi--input" title="Distinct GRNs tied to this bill '
                  || 'through PurchaseBillGRNDetail. A bill with no linked receipt is not '
                  || 'necessarily wrong — a service or freight bill has nothing to receive.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-truck"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Receipts Behind It</span>'
                  || '<span class="ds-kpi-n">' || to_char(nvl(r.Grns,0),'FM999G990') || '</span>'
                  || '<span class="ds-kpi-sub">'
                     || Case When nvl(r.Grns,0) = 0
                             Then '<span class="ds-muted">none linked — normal for a service '
                                  || 'bill</span>'
                             Else 'GRNs this bill was raised against' End
                     || '</span>'
                  || '</span></div>' As KPI6
                From Ln l
                Cross Join Rc r
                Left Join Ps p On 1 = 1
                ```
            pageItemsToSubmit: P680_TNO
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No position available for this bill.
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Taxable line value — the suite's value grain and the reconciliation anchor.
            }
        )

        column KPI2 (
            reportColumnQueryId: 2
            derivedColumn: N
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Header total including footer tax, shown beside the taxable value with the gap named so the two cannot be confused.
            }
        )

        column KPI3 (
            reportColumnQueryId: 3
            derivedColumn: N
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Passed amount with its pass number and date. Renders "not passed" rather than zero where no pass exists.
            }
        )

        column KPI4 (
            reportColumnQueryId: 4
            derivedColumn: N
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Settlement on the Payment Advice basis only. The sub-line states explicitly that a blank does not prove non-payment.
            }
        )

        column KPI5 (
            reportColumnQueryId: 5
            derivedColumn: N
            layout {
                sequence: 50
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Unsettled on the advice basis, carrying the ledger voucher number where the pass has posted.
            }
        )

        column KPI6 (
            reportColumnQueryId: 6
            derivedColumn: N
            layout {
                sequence: 60
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Receipt count via PurchaseBillGRNDetail. Explains an empty result rather than presenting it as a fault.
            }
        )

    )

    region linked-grn (
        name: Receipts Against This Bill
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  g.GrnNo As GRN_NO,
                  g.GrnDate As GRN_DATE,
                  GetLocationName(g.LocationCode) As LOCATION,
                  nvl((Select o.PurchaseOrderNo From PurchaseOrder o
                        Where o.TNo = g.PurchaseOrderTNo),
                      '<span class="ds-muted">no order linked</span>') As AGAINST_ORDER,
                  (Select Sum(nvl(gd.ReceivedQuantity1,0)) From GrnDetail gd
                    Where gd.TNo = g.TNo) As RECEIVED_QTY,
                  (Select Sum(nvl(gd.RejectedQuantity1,0)) From GrnDetail gd
                    Where gd.TNo = g.TNo) As REJECTED_QTY,
                  Case When (Select Sum(nvl(gd.RejectedQuantity1,0)) From GrnDetail gd
                              Where gd.TNo = g.TNo) > 0
                       Then '<span class="ds-pill ds-pill--bad">Rejection recorded</span>'
                       Else '<span class="ds-pill ds-pill--good">Accepted</span>'
                  End As STATUS
                From PurchaseBillGRNDetail bg
                Join Grn g On g.TNo = bg.GRNTno
                Join PurchaseBill h On h.TNo = bg.TNo
                Where bg.TNo = :P680_TNO
                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                       Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                Order By g.GrnDate, g.GrnNo
                ```
            pageItemsToSubmit: P680_TNO
        }
        layout {
            sequence: 35
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No goods receipt is linked to this bill. That is normal for a service, freight or direct-purchase invoice.
        }

        column AGAINST_ORDER (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Against Order
            }
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: The order the receipt was booked against. "No order linked" is stated rather than left blank — it is why a receipt cannot be priced elsewhere in the suite.
            }
        )

        column GRN_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Receipt Date
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            comments {
                comments: When the material was accepted into stock.
            }
        )

        column GRN_NO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: GRN No
            }
            layout {
                sequence: 10
            }
            comments {
                comments: The receipt's own business number.
            }
        )

        column LOCATION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Location
            }
            layout {
                sequence: 30
            }
            comments {
                comments: Where the goods were received.
            }
        )

        column RECEIVED_QTY (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Received Qty
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G990D000
            }
            comments {
                comments: From GrnDetail.ReceivedQuantity1. May cross units within one receipt, so do not read the total as a single figure.
            }
        )

        column REJECTED_QTY (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Rejected Qty
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G990D000
            }
            comments {
                comments: Quality rejection at receipt. Any non-zero value is worth investigating regardless of size.
            }
        )

        column STATUS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Status
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: center
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Flags any receipt carrying a rejected quantity. GRNs carry no value of their own, so there is deliberately no value column here.
            }
        )

    )

    region rule-lines (
        name: Bill Lines
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>What Was Billed</h2>
                  <p>The item lines on this invoice. <em>Amount</em> is the taxable line
                     value that sums to the headline card; <em>Total</em> adds the footer tax
                     for that line.</p>
                </div>
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-linked (
        name: Receipts Behind This Bill
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Receipts Behind This Bill</h2>
                  <p>The goods receipts this invoice was raised against, via
                     <code>PurchaseBillGRNDetail</code>. An empty list is not automatically a
                     fault &mdash; a service, freight or direct-purchase bill has nothing to
                     receive.</p>
                </div>
                ```
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P680_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @command-header
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: The bill's internal key, arriving from the Purchase Bill Register on page 668 or the Bills report on Supplier 360. Never displayed — the bill is identified on screen by the supplier's own number and by ours.
        }
    )

)

