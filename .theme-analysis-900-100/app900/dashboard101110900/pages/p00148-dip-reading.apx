page 148 (
    name: DIP Reading
    alias: DIP-READING
    title: DIP Reading
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region dip-reading (
        name: DIP Reading
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.dipreadingno,
                       a.dipreadingdate,
                       c.storagelocationname,
                       d.itemname,
                       e.itemspecificationname,
                       b.readingmethod,
                       b.dipmethod,
                       b.diptype,
                       b.temperature,
                       b.dipincm,
                       b.quantityinmt
                  From dipreading       a,
                       dipreadingdetail  b,
                       storagelocation   c,
                       item              d,
                       itemspecification e
                 Where a.tno = b.tno
                   And b.storagelocationcode = c.storagelocationcode(+)
                   And b.itemcode = d.itemcode(+)
                   And b.itemspecificationcode = e.itemspecificationcode(+)
                   And a.DIPReadingDate Between :P148_FROMDATE And :P148_TODATE
                  and instr(':'||:P148_COMPANY||':',':'||a.CompanyCode||':') > 0
                and instr(':'||:P148_LOCATION||':',':'||a.LocationCode||':') > 0
                and ( :P148_ITEM IS NULL OR instr(':'||:P148_ITEM||':',':'||b.ItemCode||':') > 0 ) 
                and ( :P148_ITEMSPECIFICATION IS NULL OR instr(':'||:P148_ITEMSPECIFICATION||':',':'||b.ItemSpecificationCode||':') > 0 ) 
                and a.DIPReadingNo like nvl(:P148_DIPNO,'%')
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
