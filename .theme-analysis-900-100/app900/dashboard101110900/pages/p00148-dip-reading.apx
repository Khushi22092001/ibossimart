    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 80
            region: @dip-reading-register
            slot: regionBody
            startNewRow: false
            column: 10
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
