            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT ITEMNAME AS D,ITEMCODE AS R FROM ITEM A  Where ITEMTYPE = 'ITEM'
        }
        layout {
            sequence: 60
            region: @dip-reading-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
