            ]
            minimalInputLength: 1
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      ee.ItemSpecificationName as d,
                      ee.ItemSpecificationCode as r
                From   Item e, ItemSpecification ee
                Where e.ItemCode = :P148_ITEM
                  and e.TNO = ee.TNO
                ```
        }
        cascadingLov {
            parentItems: P148_ITEM
            itemsToSubmit: P148_ITEM
        }
        layout {
            sequence: 70
            region: @dip-reading-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
