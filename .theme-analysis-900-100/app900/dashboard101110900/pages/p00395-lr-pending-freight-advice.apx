page 395 (
    name: LR Pending Freight Advice
    alias: LR-PENDING-FREIGHT-ADVICE
    title: LR Pending Freight Advice
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lr-pending-freight-advice (
        name: "LR Pending Freight Advice "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    row_number() over(order by a.PartyRefNo) SerialNo,
                    a.PartyRefNo,
                    Count(a.Tno) as NoOFTrips,
                    b.TransporterName,
                    b.TransporterCode,
                    sum(a.Quantity1) as LRQuantity
                From LR a,
                 (Select 
                      a.*  
                  From LR a
                  Where not exists(
                                Select
                                 ax.ModuleTno
                               From FreightAdviceDetail ax
                               Where ax.ModuleTno = a.Tno)) aa, Transporter b
                Where a.Tno = aa.tno
                  and a.TransporterCode = b.TransporterCode
                  and a.GPDate between :P395_FROMDATE and :P395_TODATE
                  and (:P395_COMPANY is Null Or Instr (':' || :P395_COMPANY|| ':' , ':' || a.CompanyCode || ':') > 0)
                  and (:P395_TRANSPORTER is Null Or Instr (':' || :P395_TRANSPORTER|| ':' , ':' || a.TransporterCode || ':') > 0)
                  and (:P395_PARTYDONO is Null Or Instr (':' || :P395_PARTYDONO|| ':' , ':' || a.PartyRefNo || ':') > 0)
                Group by a.PartyRefNo,
                      b.TransporterName,
                      b.TransporterCode;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 117322271246610839
        }

        column LRQUANTITY (
            type: plainText
            heading {
                heading: LR Quantity
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column NOOFTRIPS (
            type: link
            heading {
                heading: No Of Trips
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            link {
                target: {
                    page: 398
                    items: {
                        P398_FROMDATE: &P395_FROMDATE.
                        P398_TODATE: &P395_TODATE.
                        P398_TRANSPORTER: #TRANSPORTERCODE#
                        P398_PARTYDONO: #PARTYREFNO#
                    }
                    clearCache: 398
                }
                linkText: #NOOFTRIPS#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column PARTYREFNO (
            type: plainText
            heading {
                heading: Party DO NO
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column TRANSPORTERCODE (
            type: plainText
            heading {
                heading: Transportercode
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TRANSPORTERNAME (
            type: plainText
            heading {
                heading: Transporter Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 1187530 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn LRQUANTITY (
                sequence: 5
            )

            displayColumn NOOFTRIPS (
                sequence: 4
            )

            displayColumn PARTYREFNO (
                sequence: 2
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TRANSPORTERNAME (
                sequence: 3
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: LRQUANTITY
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P395_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    b.CompanyName d,
                    b.CompanyCode R
                From LR a,Company b
                Where a.CompanyCode = b.CompanyCode
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @lr-pending-freight-advice
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P395_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @lr-pending-freight-advice
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P395_PARTYDONO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Party DO NO
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    a.PartyRefNo d,
                    a.PartyRefNo R
                From LR a
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @lr-pending-freight-advice
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P395_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @lr-pending-freight-advice
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P395_TRANSPORTER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Transporter Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    b.TransporterName d,
                    b.TransporterCode R
                From LR a,Transporter b
                Where a.TransporterCode = b.TransporterCode
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @lr-pending-freight-advice
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 70
            region: @lr-pending-freight-advice
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

