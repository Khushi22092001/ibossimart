page 32 (
    name: Dashboard Privilege
    alias: DASHBOARD-PRIVILEGE
    title: Dashboard Privilege
    pageGroup: @administration
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 700
        height: 600
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region dashboard-privilege (
        name: Dashboard Privilege
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.TNo,
                      a.SNo,
                      a.ExtraPrivilegeCode,
                      a.Remark
                From  ModulePrivilegeExtra a
                Where a.TNo = :P32_TNO
                  and a.SNO = :P32_SNO
                  --and a.ExtraPrivilegeCode = :P32_ExtraPrivilegeCOde
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            icon: fa-plus-square
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P32_EXTRAPRIVILEGECODE (
        type: popupLov
        label {
            label: Extra Privilege
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select DISTINCT
                      a.ExtraPrivilegeName,
                      a.ExtraPrivilegeCode
                From  ExtraPrivilege a, ExtraPrivilegeDetail b
                Where a.TNo = b.TNo
                  and b.ModuleCode = 'DASHBOARD'
                  and (Not Exists 
                  (Select aa.ExtraPrivilegeCode From ModulePrivilegeExtra aa Where aa.ExtraPrivilegeCode = a.ExtraPrivilegeCode and TNo in 
                                        (Select Tno From ModulePrivilege Where BossUserCode = :P33_USER and ModuleCode = 'DASHBOARD' and CompanyCode = :P33_COMPANY) 
                  ) or a.ExtraPrivilegeCode = :P32_EXTRAPRIVILEGECODE)  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @dashboard-privilege
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @dashboard-privilege
            column: EXTRAPRIVILEGECODE
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_MODULE (
        type: displayOnly
        label {
            label: Module
            alignment: left
        }
        layout {
            sequence: 40
            region: @dashboard-privilege
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            type: staticValue
            staticValue: DASHBOARD
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_REMARK (
        type: textField
        label {
            label: Remark
            alignment: left
        }
        layout {
            sequence: 60
            region: @dashboard-privilege
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @dashboard-privilege
            column: REMARK
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_SNO (
        type: hidden
        layout {
            sequence: 20
            region: @dashboard-privilege
            slot: regionBody
        }
        source {
            formRegion: @dashboard-privilege
            column: SNO
            dataType: number
            primaryKey: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @dashboard-privilege
            slot: regionBody
        }
        source {
            formRegion: @dashboard-privilege
            column: TNO
            dataType: number
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P32_USER (
        type: displayOnly
        label {
            label: User
            alignment: left
        }
        layout {
            sequence: 30
            region: @dashboard-privilege
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 30
            region: @dashboard-privilege
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-plus-square
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P32_EXTRAPRIVILEGECODE
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @dashboard-privilege
            slot: delete
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-minus-square
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P32_EXTRAPRIVILEGECODE
        }
    )

    button update (
        buttonName: UPDATE
        label: Update
        layout {
            sequence: 10
            region: @dashboard-privilege
            slot: change
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-chevron-circle-up
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P32_EXTRAPRIVILEGECODE
        }
    )

    process delete (
        name: DELETE
        type: executeCode
        source {
            plsqlCode: Delete From ModulePrivilegeExtra Where TNo = :P32_TNO and SNo = :P32_SNO;
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Deleted Successfully.
        }
        error {
            errorMessage: Failed to delete the record.
        }
        advanced {
            executionMappingIdentifier: 5505640858122814
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-form-dashboard-privilege (
        name: Initialize form Dashboard Privilege
        type: formInitialization
        formRegion: @dashboard-privilege
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 5504219429122799
        }
    )

    process insert (
        name: INSERT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                --Insert Into ModulePrivilegeExtra (TNO,SNO,EXTRAPRIVILEGECODE,REMARK)
                --Values (:P32_TNO,:P32_SNO,:P32_EXTRAPRIVILEGECODE,:P32_REMARK);
                
                Insert Into ModulePrivilegeExtra (TNO,SNO,EXTRAPRIVILEGECODE,REMARK)
                Values (:P32_TNO,GlobalTNo.Nextval,:P32_EXTRAPRIVILEGECODE,:P32_REMARK);
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: New Record Inserted.
        }
        error {
            errorMessage: Failed to Insert the Record.
        }
        advanced {
            executionMappingIdentifier: 5505163974122809
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process update (
        name: UPDATE
        type: executeCode
        source {
            plsqlCode: Update ModulePrivilegeExtra Set ExtraPrivilegeCode = :P32_EXTRAPRIVILEGECODE Where TNO = :P32_TNO and SNO = :P32_SNO;
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Record Updated.
        }
        error {
            errorMessage: Failed to update record.
        }
        advanced {
            executionMappingIdentifier: 5505615019122813
        }
        serverSideCondition {
            whenButtonPressed: @update
        }
    )

    branch (
        name: BACK TO PAGE 33
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 33
            }
        }
    )

)

