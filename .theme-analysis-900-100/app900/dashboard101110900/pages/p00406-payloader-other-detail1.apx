page 406 (
    name: Payloader Other Detail
    alias: PAYLOADER-OTHER-DETAIL1
    title: Payloader Other Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-other-detail (
        name: Payloader Other Detail
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region payloader-other-detail-2 (
        name: Payloader Other Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.ModuleDate) SerialNo,
                a.ModuleName,
                a.ModuleNo,
                a.ModuleDate,
                a.EquipmentID,
                d.ItemName || ' - ' || e.ItemSpecificationName as Particulars,
                f.MeasuringUnitName,
                x.Quantity1,
                x.Rate,
                x.Quantity1 * x.Rate as Amount
                From PayloaderExpenseTable a, Issue b, IssueDetail c, Item d, ItemSpecification e, MeasuringUnit f,
                (
                Select
                a.Tno,
                a.Sno,
                sum(a.Quantity1) as Quantity1,
                round(sum(b.Rate)/count(a.Tno), 2) as Rate
                From IssueStockStorageDetail a, Stock b
                Where a.StockTno = b.Tno
                Group by a.Tno, a.Sno
                ) x
                Where a.Tno = b.Tno
                and b.Tno = c.Tno
                and c.ItemCode = d.ItemCode(+)
                and c.ItemSpecificationCode = e.ItemSpecificationCode(+)
                and d.MeasuringUnitCode1 = f.MeasuringUnitCode(+)
                and c.Tno = x.Tno(+)
                and c.Sno = x.Sno(+)
                and b.Tno = :P406_TNO
                and a.Creator = :APP_USER
                UNION ALL
                Select
                row_number() over(order by a.ModuleDate) SerialNo,
                a.ModuleName,
                a.ModuleNo,
                a.ModuleDate,
                a.EquipmentID,
                c.VehicleNecessityName as Particulars,
                NULL AS MeasuringUnitName,
                b.Quantity1,
                round(b.TotalAmount,2) / b.Quantity1 as Rate,
                round(b.TotalAmount,2) as Amount
                From PayloaderExpenseTable a, NecessityCompletionDetail b, VehicleNecessity c
                Where a.Tno = b.Tno
                and b.Tno = :P406_TNO
                and a.Creator = :APP_USER;
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 6710646906598241
        }

