    pageItem P679_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From PurchaseBill h
                                Where h.CompanyCode = c.CompanyCode
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or h.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Narrows every region to one company.
        }
    )

    pageItem P679_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
