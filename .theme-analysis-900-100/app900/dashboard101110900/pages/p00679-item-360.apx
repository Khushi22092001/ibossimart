        type: popupLov
        label {
            label: Item
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct i.ItemName || ' (' || i.ItemCode || ')' d, i.ItemCode r
                  From PurchaseBillDetail d
                  Join Item i On i.ItemCode = d.ItemCode
                 Order By 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
