            sequence: 90
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Hidden when your login is already bound to a panel. The select list is the control; the SQL predicate on every region is the enforcement.
        }
    )

    pageItem P679_SPEC (
        type: selectList
        label {
            label: Specification
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                       Case When d.ItemSpecificationCode Is Null Then 'No specification recorded'
                            Else nvl((Select s.ItemSpecificationName From ItemSpecification s
                                       Where s.ItemSpecificationCode = d.ItemSpecificationCode),
                                     d.ItemSpecificationCode) End d,
                       nvl(d.ItemSpecificationCode,'~NONE~') r
                  From PurchaseBillDetail d
                 Where d.ItemCode = :P679_ITEMCODE
                 Order By 1
                ```
            nullDisplayValue: All specifications
        }
        cascadingLov {
            parentItems: P679_ITEMCODE
            itemsToSubmit: P679_ITEMCODE
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 5
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Optional narrowing. The Specification Mix report below always shows every specification regardless of this setting, so the mix stays readable.
        }
    )

    pageItem P679_SUPPLIER (
        type: popupLov
        label {
            label: Supplier
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct GetPartyName(h.PartyCode) d, h.PartyCode r
                  From PurchaseBill h
                  Join PurchaseBillDetail d On d.TNo = h.TNo
                 Where d.ItemCode = :P679_ITEMCODE
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All suppliers
        }
        cascadingLov {
            parentItems: P679_ITEMCODE
            itemsToSubmit: P679_ITEMCODE
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Narrows the KPI cards and the rate trend. The Vendor Comparison deliberately IGNORES this filter — a comparison filtered to one vendor has nothing to compare.
        }
    )

    pageItem P679_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: End of the reporting period.
        }
    )

    pageItem P679_UOM (
        type: selectList
        label {
            label: Unit
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                       Case When d.RateMeasuringUnitCode Is Null Then 'No unit recorded'
                            Else nvl((Select m.MeasuringUnitName From MeasuringUnit m
                                       Where m.MeasuringUnitCode = d.RateMeasuringUnitCode),
                                     d.RateMeasuringUnitCode) End d,
                       nvl(d.RateMeasuringUnitCode,'~NONE~') r
                  From PurchaseBillDetail d
                 Where d.ItemCode = :P679_ITEMCODE
                 Order By 1
                ```
            nullDisplayValue: All units (rates not comparable)
        }
        cascadingLov {
            parentItems: P679_ITEMCODE
            itemsToSubmit: P679_ITEMCODE
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: The other half of the subject. Leaving this blank mixes units, and the rates then are NOT comparable — the null display value says so.
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 100
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back-to-analytics (
        buttonName: BACKTOANALYTICS
        label: Purchase Analytics
        layout {
            sequence: 110
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 683
                items: {
                    P683_FROMDATE: &P679_FROMDATE.
                    P683_TODATE: &P679_TODATE.
                    P683_COMPANY: &P679_COMPANY.
                    P683_LOCATION: &P679_LOCATION.
                    P683_PANEL: &P679_PANEL.
                }
                clearCache: 683
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

