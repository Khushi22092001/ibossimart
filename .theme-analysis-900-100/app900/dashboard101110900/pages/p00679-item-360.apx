            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Half the subject of this page. Populated from bill lines, so every entry returns rows.
        }
    )

    pageItem P679_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
