page 316 (
    name: LR With DO Expenses Detail
    alias: LR-WITH-DO-EXPENSES-DETAIL
    title: LR With DO Expenses Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lr-with-do-expenses (
        name: LR With DO Expenses
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Rownum as SerialNo,
                GetCompanyName(a.CompanyCode) as CompanyName,
                lo.LocationName,
                GetDoctypeName(a.DoctypeCode) as DoctypeName,
                a.LRNo,
                a.LRDate,
                round(ded.NetFreightRate,2) as FreightRate,
                round(a.Quantity1,3) as Quantity,
                round((ded.NetFreightRate * a.Quantity1),2) as Amount,
                a.VehicleNo,
                a.DriverName,
                a.GPNo,
                a.GPDate,
                pa.PartyName,
                t.TransporterName,
                sl.SourceLocationName,
                a.ConsigneeName,
                ci.CityName as ConsignorCity,
                cy.CityName as ConsigneeCity,
                a.ConsignorName,
                dl.DestinationLocationName,
                i.ItemName,
                ft.FreightTypeName,
                vt.VehicleTypeName,
                a.PartyRefNo,
                do.DeliveryOrderNo,
                vg.VehicleGroupName
                From LR a, Location lo,SourceLocation sl,DestinationLocation dl,DeliveryOrder do,DeliveryOrderDetail dod,
                Item i,  Transporter t, FreightType ft, City ci, City cy,Party pa, FreightAdviceDetail n,DOExpensesDetail ded,
                (
                Select
                a.VehicleNo,
                b.VehicleTypeName,
                a.VehicleOperatorCode
                From CompanyVehicle a, VehicleType b
                where a.VehicleTypeCode = b.VehicleTypeCode
                )vt, VehicleGroup vg
                Where a.LocationCode = lo.LocationCode
                and a.SourceLocationTno = sl.Tno(+)
                and a.DestinationLocationTno = dl.Tno(+)
                and a.DeliveryOrderTno = do.Tno(+)
                and do.Tno = dod.Tno(+)
                and a.ItemCode = i.ItemCode(+)
                and a.TransporterCode = t.TransporterCode(+)
                and a.FreightTypeCode = ft.FreightTypeCode(+)
                and a.ConsignorCityCode = ci.CityCode(+)
                and a.ConsigneeCityCode = cy.CityCode(+)
                and a.PartyCode = pa.PartyCode(+)
                and a.Tno = n.ModuleTno(+)
                and dod.Tno = ded.DeliveryOrderTno(+)
                and dod.Sno = ded.DeliveryOrderSno(+)
                and a.VehicleNo = vt.VehicleNo(+)
                and a.VehicleGRoupCode = vg.VehicleGroupCode(+)
                and (:P316_COMPANY is Null Or Instr (':' || :P316_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                and a.LRDate between :P316_FROMDATE and :P316_TODATE
                and (:P316_LRNO is Null Or Instr (':' || :P316_LRNO || ':' , ':' || a.Tno || ':') > 0)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 41038059214001915
        }

