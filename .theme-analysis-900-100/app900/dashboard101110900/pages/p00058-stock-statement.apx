        column RECEIPTQTY2 (
            type: plainText
            heading {
                heading: RECEIPT  S QTY
                alignment: center
            }
            layout {
                sequence: 380
                columnAlignment: end
            }
            appearance {
                formatMask: 99,99,99,999.999
