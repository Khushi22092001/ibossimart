page 58 (
    name: Stock Statement
    alias: STOCK-STATEMENT
    title: Stock Statement
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region stock-statement (
        name: Stock Statement
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region stock-statement-2 (
        name: Stock Statement
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	row_number() over(order by x.LocationName, x.ItemName) as SerialNo,
                	x.FromDate,
                	x.ToDate,
                	x.ItemGroup,
                	x.ItemGroupName,
                	x.CompanyCode,
                	x.LocationCode,
                	x.LocationName,
                	x.StorageLocationCode,
                	x.StorageLocationName,
                	x.ItemCode,
                	x.ItemName,
                	x.ItemSpecificationCode,
                	x.ItemSpecificationName,
                    x.DealsInName,
                    x.ItemCategoryName,
                	x.StockAccountCode,
                	x.StockAccountName,
                	x.ConsumptionAccountCode,
                	x.ConsuptionAccountName,
                	x.UOM1,
                	x.UOM2,
                	x.PUOMName,
                	x.SUOMName,
                	nvl(x1.StockQuantity1, 0) + nvl(x2.StockQuantity1, 0) - nvl(x3.UsedStockQuantity1, 0) as OpeningQty1,
                	nvl(x1.StockQuantity2, 0) + nvl(x2.StockQuantity2, 0) - nvl(x3.UsedStockQuantity2, 0) as OpeningQty2,
                	nvl(x1.StockAmount1, 0) + nvl(x2.StockAmount1, 0) - nvl(x3.UsedStockAmount1, 0) as OpeningAmt,
                	x4.ReceiptQty1,
                	x5.ReceiptQty2,
                	x4.ReceiptAmt,
                	x6.IssueQty1,
                	x6.IssueQty2,
                	x6.IssueAmt,
                    x.Description,
                	(nvl(x1.StockQuantity1, 0) + nvl(x2.StockQuantity1, 0) - nvl(x3.UsedStockQuantity1, 0)) + nvl(x4.ReceiptQty1, 0) - nvl(x6.IssueQty1, 0) as ClosingQty1,
                	(nvl(x1.StockQuantity2, 0) + nvl(x2.StockQuantity2, 0) - nvl(x3.UsedStockQuantity2, 0)) + nvl(x4.ReceiptQty2, 0) - nvl(x6.IssueQty2, 0) as ClosingQty2,
                	(nvl(x1.StockAmount1, 0) + nvl(x2.StockAmount1, 0) - nvl(x3.UsedStockAmount1, 0)) + nvl(x4.ReceiptAmt, 0) - nvl(x6.IssueAmt, 0) as ClosingAmt
                From
                	(
                	Select
                		:P58_FROMDATE as FromDate,
                		:P58_TODATE as ToDate,
                		a.ParentCode as ItemGroup,
                		e.ItemName as ItemGroupName,
                		c.CompanyCode,
                		c.LocationCode,
                		f.LocationName,
                		d.StorageLocationCode,
                		g.StorageLocationName,
                		a.ItemCode,
                		a.ItemName,
                		b.ItemSpecificationCode,
                		b.ItemSpecificationName,
                		a.StockAccountCode,
                		h.PartyName as StockAccountName,
                		a.ConsumptionAccountCode,
                		i.PartyName as ConsuptionAccountName,
                		a.MeasuringUnitCode1 as UOM1,
                		a.MeasuringUnitCode2 as UOM2,
                		j.MeasuringUnitName as PUOMName,
                		k.MeasuringUnitName as SUOMName,
                        l.ItemMakeName as Description,
                        di.DealsInName,
                        ic.ItemCategoryName
                	From Item a, ItemSpecification b, Stock c, StockStorageDetail d, Item e, Location f, StorageLocation g,
                		Party h, Party i, MeasuringUnit j, MeasuringUnit k, ItemMake l, DealsIn di, ItemCategory ic 
                	Where a.Tno = b.Tno
                		and a.ItemCode = c.ItemCode
                		and b.ItemSpecificationCode = c.ItemSpecificationCode
                		and c.Tno = d.Tno
                		and a.ParentCode = e.ItemCode(+)
                		and c.LocationCode = f.LocationCode(+)
                		and d.StorageLocationCode = g.StorageLocationCode(+)
                		and a.StockAccountCode = h.PartyCode(+)
                		and a.ConsumptionAccountCode = i.PartyCode(+)
                		and a.MeasuringUnitCode1 = j.MeasuringUnitCode(+)
                		and a.MeasuringUnitCode2 = k.MeasuringUnitCode(+)
                        and b.ItemMakeCode = l.ItemMakeCode(+)
                        and a.DealsInCode = di.DealsInCode(+)
                        and a.ItemCategoryCode = ic.ItemCategoryCode(+)
                		and LENGTH(:P58_FROMDATE) > 0 
                		and INSTR(':'||:P58_COMPANY||':',':'|| c.CompanyCode || ':') > 0
                		and (:P58_LOCATION is null or (INSTR(':' || :P58_LOCATION || ':',':' || c.LocationCode ||':') > 0))
                		and (:P58_ITEM IS NULL OR INSTR(':' || :P58_ITEM || ':',':' || a.ItemCode || ':') > 0 )
                		and (:P58_ITEMSPECIFICATION IS NULL OR INSTR(':' || :P58_ITEMSPECIFICATION || ':',':'|| b.ItemSpecificationCode || ':') > 0 )
                		and (:P58_STORAGELOCATION IS NULL OR INSTR(':'||:P58_STORAGELOCATION ||':',':'|| d.StorageLocationCode || ':') > 0 ) 
                		and (:P58_ITEMGROUP IS NULL
                			OR
                			a.ItemCode in
                				(
                				Select
                		            aa.ItemCode
                				From Item aa
                				Where 1=1
                				Start with aa.ItemCode = :P58_ITEMGROUP
                				Connect by aa.ParentCode = prior aa.ItemCode
                				)
                			)
                	Group by
                		a.ParentCode,
                		e.ItemName,
                		c.CompanyCode,
                		c.LocationCode,
                		f.LocationName,
                		d.StorageLocationCode,
                		g.StorageLocationName,
                		a.ItemCode,
                		a.ItemName,
                		b.ItemSpecificationCode,
                		b.ItemSpecificationName,
                		a.StockAccountCode,
                		h.PartyName,
                		a.ConsumptionAccountCode,
                		i.PartyName,
                		a.MeasuringUnitCode1,
                		a.MeasuringUnitCode2,
                		j.MeasuringUnitName,
                		k.MeasuringUnitName,
                        l.ItemMakeName,
                        di.DealsInName,
                        ic.ItemCategoryName
                	) x,
                	(
                	Select
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode,
                		nvl(sum(b.StockQuantity1), 0) as StockQuantity1,
                		nvl(sum(b.StockQuantity2), 0) as StockQuantity2,
                		round(sum(nvl(b.StockQuantity1, 0) * nvl(a.Rate, 0)), 2) as StockAmount1
                	From Stock a, StockStorageDetail b
                	Where a.Tno = b.Tno
                		and a.StockDate <= :P58_FROMDATE
                		and a.StockModuleCode = 'ITEMOPENING'
                	Group by
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode
                	) x1,
                	(
                	Select
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode,
                		nvl(sum(b.StockQuantity1), 0) as StockQuantity1,
                		nvl(sum(b.StockQuantity2), 0) as StockQuantity2,
                		round(sum(nvl(b.StockQuantity1, 0) * nvl(a.Rate, 0)), 2) as StockAmount1
                	From Stock a, StockStorageDetail b
                	Where a.Tno = b.Tno
                		and a.StockDate < :P58_FROMDATE
                		and a.StockModuleCode != 'ITEMOPENING'
                	Group by
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode
                	) x2,
                	(
                	/*Select
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode,
                		nvl(sum(b.UsedStockQuantity1), 0) as UsedStockQuantity1,
                		nvl(sum(b.UsedStockQuantity2), 0) as UsedStockQuantity2,
                		round(sum(nvl(b.UsedStockQuantity1, 0) * nvl(a.Rate, 0)), 2) as UsedStockAmount1
                		From Stock a, UsedStockStorageDetail b
                	Where a.Tno = b.StockTno
                		and b.UsedStockDate < :P58_FROMDATE
                	Group by
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode
                	*/
                	Select 
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode,
                		nvl(sum(b.UsedStockQuantity1), 0) as UsedStockQuantity1,
                		nvl(sum(b.UsedStockQuantity2), 0) as UsedStockQuantity2,
                		round(sum(nvl(b.UsedStockQuantity1, 0) * nvl(a.Rate, 0)), 2) as UsedStockAmount1
                	From Stock a, UsedStockStorageDetail b, StockStorageDetail c
                	Where a.TNo = b.StockTNo
                		and a.tno = c.tno
                		and c.StorageLocationCode = b.StorageLocationCode
                		and b.UsedStockDate < :P58_FROMDATE
                	Group by
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode
                	) x3,
                	(
                	Select
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode,
                		nvl(sum(b.StockQuantity1), 0) as ReceiptQty1,
                		nvl(sum(b.StockQuantity2), 0) as ReceiptQty2,
                		round(sum(nvl(b.StockQuantity1, 0) * nvl(a.Rate, 0)), 2) as ReceiptAmt
                	From Stock a, StockStorageDetail b
                	Where a.Tno = b.Tno
                		and a.StockDate between :P58_FROMDATE and :P58_TODATE
                		and a.StockModuleCode != 'ITEMOPENING'
                	Group by
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode
                	) x4,
                	(
                	Select
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode,
                		nvl(sum(b.StockQuantity2), 0) as ReceiptQty2
                	From Stock a, StockStorageDetail b
                	Where a.Tno = b.Tno
                		and a.StockDate between :P58_FROMDATE and :P58_TODATE
                	Group by
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode
                	) x5,
                	(
                	Select
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode,
                		nvl(sum(b.UsedStockQuantity1), 0) as IssueQty1,
                		nvl(sum(b.UsedStockQuantity2), 0) as IssueQty2,
                		round(sum(nvl(b.UsedStockQuantity1, 0) * nvl(a.Rate, 0)), 2) as IssueAmt
                		From Stock a, UsedStockStorageDetail b
                	Where a.Tno = b.StockTno
                		and b.UsedStockDate between :P58_FROMDATE and :P58_TODATE
                	Group by
                		a.CompanyCode,
                		a.LocationCode,
                		b.StorageLocationCode,
                		a.ItemCode,
                		a.ItemSpecificationCode
                	) x6
                Where x.CompanyCode = x1.CompanyCode(+)
                	and x.LocationCode = x1.LocationCode(+)
                	and x.StorageLocationCode = x1.StorageLocationCode(+)
                	and x.ItemCode = x1.ItemCode(+)
                	and x.ItemSpecificationCode = x1.ItemSpecificationCode(+)
                	
                	and x.CompanyCode = x2.CompanyCode(+)
                	and x.LocationCode = x2.LocationCode(+)
                	and x.StorageLocationCode = x2.StorageLocationCode(+)
                	and x.ItemCode = x2.ItemCode(+)
                	and x.ItemSpecificationCode = x2.ItemSpecificationCode(+)
                	
                	and x.CompanyCode = x3.CompanyCode(+)
                	and x.LocationCode = x3.LocationCode(+)
                	and x.StorageLocationCode = x3.StorageLocationCode(+)
                	and x.ItemCode = x3.ItemCode(+)
                	and x.ItemSpecificationCode = x3.ItemSpecificationCode(+)
                	
                	and x.CompanyCode = x4.CompanyCode(+)
                	and x.LocationCode = x4.LocationCode(+)
                	and x.StorageLocationCode = x4.StorageLocationCode(+)
                	and x.ItemCode = x4.ItemCode(+)
                	and x.ItemSpecificationCode = x4.ItemSpecificationCode(+)
                	
                	and x.CompanyCode = x5.CompanyCode(+)
                	and x.LocationCode = x5.LocationCode(+)
                	and x.StorageLocationCode = x5.StorageLocationCode(+)
                	and x.ItemCode = x5.ItemCode(+)
                	and x.ItemSpecificationCode = x5.ItemSpecificationCode(+)
                	
                	and x.CompanyCode = x6.CompanyCode(+)
                	and x.LocationCode = x6.LocationCode(+)
                	and x.StorageLocationCode = x6.StorageLocationCode(+)
                	and x.ItemCode = x6.ItemCode(+)
                	and x.ItemSpecificationCode = x6.ItemSpecificationCode(+)
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
