page 415 (
    name: Corrected
    alias: CORRECTED
    title: CORRECTED
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region corrected (
        name: "Corrected "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   GetModuleNo(b.ModuleCode,a.ModuleTno) as ModuleNo,
                   a.IsFail,
                   a.Remark,
                   a.QueueDate,
                   a.PassFailDate
                From PassFail a,ModuleFlow b, BossUser c
                Where a.ModuleFlowTno = b.Tno
                  and Upper(a.MenuLabel) like '%REBOUND%'
                  and a.IsPass = 'Yes'
                  and a.BossUserCode = c.BossUserCode
                  and c.BossUserName = :APP_USER
                  and b.ModuleCode = :P415_MODULECODE;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 19910708636274722
        }

        column ISFAIL (
            type: plainText
            heading {
                heading: Is Fail
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column PASSFAILDATE (
            type: plainText
            heading {
                heading: Pass Fail Date
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column QUEUEDATE (
            type: plainText
            heading {
                heading: Queue Date
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 244872 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ISFAIL (
                sequence: 2
            )

            displayColumn MODULENO (
                sequence: 1
            )

            displayColumn PASSFAILDATE (
                sequence: 5
            )

            displayColumn QUEUEDATE (
                sequence: 4
            )

            displayColumn REMARK (
                sequence: 3
            )

        )

    )

    pageItem P415_MODULECODE (
        type: hidden
        layout {
            sequence: 10
            region: @corrected
            slot: regionBody
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 20
            region: @corrected
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 413
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

