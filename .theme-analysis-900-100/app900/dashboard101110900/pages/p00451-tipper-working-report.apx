        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                a.EquipmentGroupName D,
                a.EquipmentGroupCode R
                from EquipmentGroup a , EquipmentLogBook b, Equipment c
                Where a.EquipmentGroupCode = c.equipmentgroupcode
                  and b.EquipmentTNo = c.TNo
                Order by 1
                ```
            displayExtraValues: false
