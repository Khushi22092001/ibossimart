page 451 (
    name: Tipper Working Report
    alias: TIPPER-WORKING-REPORT
    title: Tipper Working Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/PCReport.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P267_FROMDATE').val());
              var toDate = new Date($('#P267_TODATE').val());
            
              var reportParams = 
                '&P_COMPANY=' + $('#P267_COMPANY').val() + 
                '&P_LOCATION=' +  $('#P267_LOCATION').val() +
                '&P_FROMDATE=' +  formatDate(fromDate) + 
                '&P_TODATE='  +  formatDate(toDate) + 
                '&P_EQUIPMENTGROUP=' + $('#P267_EQUIPMENTGROUP').val() + 
                '&P_SHIFT=' + $('#P267_SHIFT').val() + 
                '&P_DOORNO=' + $('#P267_DOORNO').val() 
                  ;
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            ```
    }
    css {
        inline:
            ```css
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                ROWNUM AS SerialNo,
                x.*
                from 
                (Select --rownum AS SERIALNO,
                 a.VehicleLogBookDate,
                 s.ShiftName,
                 --c.equipmentcode As DoorNo,
                 c.EquipmentId As DoorNo,
                 c.equipmentgroupcode,
                 K.EQUIPMENTGROUPNAME,
                 E.EMPLOYEEID,
                 e.EmployeeName,
                 a.openingmeterreading As StartingKM,
                 a.closingmeterreading As EndKM,
                 a.OpeningWorkingHrs   As StartingHRs,
                 a.ClosingWorkingHrs   As EndHrs,
                 
                 GetLocationName(a.LocationCode) As Location,
                 -- b1.vehicleno,
                 
                 -- a.VehicleLogBookDate,
                 
                 --j.JobTypeName,
                 Sum(nvl(b.NoofTrips, 0)) As TotalTrip,
                 (a.closingmeterreading - a.openingmeterreading) As RunningKM,
                 (a.ClosingWorkingHrs - a.OpeningWorkingHrs) As RunningHRs,
                 a.Remark
                
                /*Case
                   When (a.closingmeterreading - a.openingmeterreading) = 0 Then
                    Sum(b.NoOfTrips) / 1
                   Else
                    round(Sum(B.NOOFTRIPS) / (a.closingmeterreading - a.openingmeterreading),
                          2)
                 End As AvgTrip
                */
                  From VehicleLogBook       a,
                       VehicleLogBookDetail b,
                       CompanyVehicle       b1,
                       Equipment            c,
                       Employee             e,
                       Shift                s,
                       JobType              j,
                       EquipmentGroup       k,
                       ITEM                 L
                 Where 1 = 1
                   And a.TNo = b.TNo(+)
                   And a.EquipmentTNo = b1.tno(+)
                   And b1.ModuleTNo = c.TNo(+)
                   And a.OperatorCode = e.EmployeeCode(+)
                   And a.ShiftCode = s.ShiftCode(+)
                   And b.JobTypeCode = j.JobTypeCode(+)
                   And c.Equipmentgroupcode = k.EquipmentGroupCode(+)
                   And C.ITEMCODE = L.ITEMCODE
                      --- Filter
                --   And L.PARENTCODE = '19162' -- FOR ITEMGROUP TIPPERS
                   And a.Vehiclelogbookdate Between :P451_FROMDATE and :p451_TODATE
                  and ( :P451_COMPANY is null or (instr(':'||:P451_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  and ( :P451_LOCATION is null or (instr(':'||:P451_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and ( :P451_SHIFT IS NULL OR instr(':'||:P451_SHIFT||':',':'||a.shiftCode||':') > 0 ) 
                  and ( :P451_DOORNO IS NULL OR instr(':'||:P451_DOORNO||':',':'||c.equipmentid||':') > 0 ) 
                --  and ( :P451_EQUIPMENTGROUP IS NULL OR instr(':'||:P451_EQUIPMENTGROUP||':',':'||c.EquipmentGroupCode||':') > 0 )
                --   and ( :P451_ITEMGROUP IS NULL OR instr(':'||:P451_ITEMGROUP||':',':'||L.PARENTCODE||':') > 0 ) 
                   and ( :P451_EQUIPMENTCATEGORY IS NULL OR instr(':'||:P451_EQUIPMENTCATEGORY||':',':'||C.EQUIPMENTCATEGORYCODE||':') > 0 ) 
                   and ( :P451_DRIVER IS NULL OR instr(':'||:P451_DRIVER||':',':'||a.OperatorCode||':') > 0 ) 
                 
                 Group By a.VehicleLogBookDate,
                          s.ShiftName,
                          --c.equipmentcode,
                          c.equipmentgroupcode,
                          K.EQUIPMENTGROUPNAME,
                          c.EquipmentId,
                          e.EmployeeName,
                          E.EMPLOYEEID,
                          a.openingmeterreading,
                          a.closingmeterreading,
                          a.OpeningWorkingHrs,
                          a.ClosingWorkingHrs,
                          GetLocationName(a.LocationCode),
                          b1.vehicleno,
                          a.VehicleLogBookDate,
                           a.Remark,
                          -- j.JobTypeName,
                          --Sum(nvl(b.NoofTrips, 0)) As TotalTrip,
                          (a.closingmeterreading - a.openingmeterreading),
                          (a.ClosingWorkingHrs - a.OpeningWorkingHrs)
                 order by 1
                ) x
                  
                ```
            pageItemsToSubmit: [
                P451_COMPANY
                P451_LOCATION
                P451_FROMDATE
                P451_TODATE
                P451_EQUIPMENTGROUP
                P451_SHIFT
                P451_DOORNO
                P451_ITEMGROUP
                P451_EQUIPMENTCATEGORY
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
