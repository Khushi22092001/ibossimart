page 411 (
    name: Insurance Claim Register
    alias: INSURANCE-CLAIM-REGISTER
    title: Insurance Claim Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region insurance-claim-register (
        name: Insurance Claim Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    row_number() over(order by a.InsuranceClaimDate) SerialNo,
                    a.VehicleNo,
                    a.DoorNo,
                    a.ChassisNo,
                    a.EngineNo,
                    b.ItemMakeName as Make,
                    a.ModelNo,
                    c.AccidentDate as DateOfAccident,
                   -- c.AccidentTime as TimeOfAccident,
                    to_char(c.AccidentTime,'HH12:MI:SS PM') as TimeOfAccident,
                    c.PLaceOfAccident,
                    d.EmployeeName as DriverName,
                    a.DrivingLicenceNo,
                    a.DrivingLicenceExpiryDate as LicenceExpiryDate,
                    a.PolicyNo,
                    a.PolicyStartDate ||' to ' || a.PolicyEndDate as PolicyPeriod,
                    a.Policytype,
                    e.PartyName as InsuranceCompany,
                    c.IntimationDate,
                    c.CausesOfAccident,
                    c.ClaimNo,
                    c.ClaimDate,
                    f.SpotSurveyDate,
                    f.SurveyorName as SpotSurveyorName,
                    f.ContactNo as SpotSurveyorContactNo,
                    g.SecondSurveyDate,
                    g.SurveyorName as SecondSurveyorName,
                    g.ContactNo as SecondSurveyContactNo,
                    h.PrimaryEstimateNo,
                    h.Particulars as PrimaryEstimateParticulars,
                    h.Peamount as PrimaryEstimateAmount,
                    i.ICSupplementaryEstimateNo as SupplementaryEstimateNo,
                    j.Particulars as SupplementaryEstimateParticulars,
                    j.SEAmount as SupplementaryEstimateAmount,
                    l.InvoiceNo,
                    l.Particulars as InvoiceParticulars,
                    l.InvoiceAmount,
                    k.FinalSurveyNo,
                    k.FinalSurveyDate,
                    o.AmountReceivedInBank,
                    o.AmountReceivedDate,
                    o.NetClaimAmount as TotalClaimAmount,
                    o.NetClaimAmount as ClaimSettelmentAmount,
                    o.UTRNo,
                    p.PartyName as BankName
                From InsuranceClaim a, ItemMake b, Icintimation c, Employee d, Party e, ICSpotSurvey f, ICSecondSurvey g, ICSecondSurveyDetail h,
                ICSupplementaryEstimate i, ICSupplementaryEstimateDetail j, ICFinalSurvey k,ICFinalSurveyDetail l, ICSurveyorassessment m, ICSurveyorassessmentDetail n,
                ICClaimSettlement o, Party p
                Where a.ManufactureMakeCode = b.ItemMakeCode(+)
                      and a.Tno = c.Tno(+)
                      and a.DriverCode = d.EmployeeCode(+)
                      and a.InsurancePartyCode = e.PartyCode(+)
                      and a.Tno = f.Tno(+)
                      and a.Tno = g.Tno(+)
                      and g.Tno = h.Tno(+)
                      and a.Tno = i.Tno(+)
                      and i.Tno = j.Tno(+)
                      and a.Tno = k.Tno(+)
                      and k.Tno = l.Tno(+)
                      and a.Tno = m.Tno(+)
                      and m.Tno = n.Tno(+)
                      and a.Tno = o.Tno(+)
                      and o.BankAccountCode = p.PartyCode(+)
                      and a.InsuranceClaimDate Between :P411_FROMDATE and :P411_TODATE
                      and ( :P411_VEHICLENO is null or instr(':' ||:P411_VEHICLENO||':',':'||a.VehicleNo||':') > 0 )
                      and :P411_FROMDATE is not null
                    
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 17244467103114703
        }

