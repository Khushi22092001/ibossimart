    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region internaltransfer-with-do-expenses (
        name: InternalTransfer With DO Expenses
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region internaltransfer-with-do-expenses-detail (
        name: InternalTransfer With DO Expenses Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                b.LocationName "Location Name",
                d.DeliveryOrderNo "Delivery Order No",
                d.DeliveryOrderDate "Delivery Order Date",
                d.PartyDONo "Party DO No",
                d.PartyDODate "Party DO Date",
                a.InternalTransferNo "Internal Transfer No",
                a.GPNo as GPNO,
                p.PartyName "Party Name",
                q.SourcelocationName "Source location Name",
                r.DestinationLocationName "Destination Location Name",
                a.VehicleNo "Vehicle No",
                t.TransporterName "Transporter Name",
                a.DriverName "Driver Name",
                s.ShiftName "Shift Name ",
                a.LoadingDate "Loading Date",
                GetTime(a.LoadingTime) as "Loading Time",
                round(a.LoadingQuantity1,3) as "Loading Qty",
                a.UnloadingDate " Unloading Date",
                GetTime(a.UnloadingTime) "Unloading Time",
                round(a.UnloadingQuantity1,3) as "Unloading Qty",
                ro.RouteName as "Route Name",
                do.NetFreightRate,
                round(nvl(do.NetFreightRate,1) * nvl(a.LoadingQuantity1,1),2) as Amount,
                a.Creator
                from InternalTransfer a, Location b, DeliveryOrderDetail c, Deliveryorder d, LoadingOrder e,
                    Party p, Sourcelocation q , DestinationLocation r  , Transporter t , Shift s, Route ro,DOExpensesDetail do
                Where a.LocationCode = b.LocationCode(+)
                and a.DeliveryOrderTno = c.Tno(+)
                and a.DeliveryorderSno = c.Sno(+)
                and c.Tno = e.DeliveryOrderTno(+)
                and c.Sno = e.DeliveryorderSno(+)
                and c.Tno = d.Tno(+)
                and a.PartyCode = p.PartyCode(+)
                and a.SourceLocationTno = q.Tno(+)
                and a.DestinationLocationTno = r.Tno(+)
                and a.TransporterCode = t.TransporterCode(+)
                and a.ShiftCode = s.ShiftCode(+)
                and a.RouteCode = ro.RouteCode(+)
                and c.Tno = do.DeliveryOrderTno(+)
                and c.Sno = do.DeliveryOrderSno(+)
                and a.loadingDate between :P318_FROMDATE and :P318_TODATE
                --and (:P272_LOCATIONNAME is null or instr(':'||:P272_LOCATIONNAME||':',':'||a.Locationcode||':') > 0)
                --and (:P272_PARTY is null or instr(':'||:P272_PARTY||':',':'||a.Partycode||':') > 0)
                --and (:P272_DELIVERYORDER is null or instr(':'||:P272_DELIVERYORDER||':',':'||a.DeliveryOrderTNo||':') > 0)
                and (:P318_INTERNALTRANSFERNO is null or instr(':'||:P318_INTERNALTRANSFERNO||':',':'||a.Tno||':') > 0)
                and (:P318_COMPANY is null or instr(':'||:P318_COMPANY||':',':'||a.Companycode||':') > 0)
                --and (:P272_SHIFT is null or instr(':'||:P272_SHIFT||':',':'||a.ShiftCode||':') > 0)
                --and (:P272_ROUTE is null or instr(':'||:P272_ROUTE||':',':'||a.RouteCode||':') > 0)
                --and (:P272_PARTYDONO is null or instr(':'||:P272_PARTYDONO||':',':'||d.Tno||':') > 0);
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
