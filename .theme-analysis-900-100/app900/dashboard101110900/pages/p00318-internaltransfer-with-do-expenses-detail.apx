    pageItem P318_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: InternalTransfer No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    b.CompanyName d,
                    b.CompanyCode R
                From InternalTransfer a, Company b
                Where a.CompanyCode = b.CompanyCode
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @internaltransfer-with-do-expenses
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
