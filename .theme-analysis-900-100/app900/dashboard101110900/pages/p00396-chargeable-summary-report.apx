page 396 (
    name: Chargeable Summary Report
    alias: CHARGEABLE-SUMMARY-REPORT
    title: Chargeable Summary Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region chargeable-summary-report (
        name: Chargeable Summary Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region chargeable-summary-report-2 (
        name: Chargeable Summary Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by c.TransporterCode) SerialNo,
                   c.TransporterName,
                   c.TransporterCode,
                   f.LocationName,
                   f.LocationCode,
                   g.CompanyName,
                   SUM(b.Quantity1) as Quantity,
                   --round(abs(SUM(e.Amount)) / SUM(b.Quantity1), 2) as Rate,
                   round(abs(SUM(e.Amount)),2) as Amount,
                   'DETAIL'
                From NecessitySlip a, NecessitySlipDetail b, Transporter c, Voucher d, VoucherDetail e, Location f, Company g
                Where a.Tno = b.Tno(+)
                   and a.TransporterCode = c.TransporterCode(+)
                   and b.VehicleNecessityCode in (Select a.VehicleNecessityCode From VehicleNecessityForDiesel a)
                   and a.Tno = d.ModuleTno(+)
                   and d.Tno = e.Tno(+)
                   and a.LocationCode = f.LocationCode(+)
                   and a.CompanyCode = g.CompanyCode(+)
                   and nvl(e.Amount, 0) < 0
                   and a.VehicleGroupCode != 'SELF'
                   and a.EquipmentTno is null
                   and a.NecessitySlipDate between :P396_FROMDATE and :P396_TODATE
                   and (:P396_COMPANY is Null Or Instr (':' || :P396_COMPANY|| ':' , ':' || a.CompanyCode || ':') > 0)
                   and (:P396_LOCATION is Null Or Instr (':' || :P396_LOCATION|| ':' , ':' || a.LocationCode || ':') > 0)
                   and (:P396_PARTY is Null Or Instr (':' || :P396_PARTY|| ':' , ':' || a.TransporterCode || ':') > 0)
                   and (:P396_VEHICLE is Null Or Instr (':' || :P396_VEHICLE|| ':' , ':' || a.vehicleNo || ':') > 0)
                Group by c.TransporterName,
                         c.TransporterCode,
                         f.LocationName,
                         f.LocationCode,
                         g.CompanyName
                UNION ALL
                Select
                   row_number() over(order by c.TransporterCode) SerialNo,
                   c.TransporterName,
                   c.TransporterCode,
                   h.LocationName,
                   h.LocationCode,
                   i.CompanyName,
                   sum(b.Quantity1) as Quantity,
                   --round(abs(SUM(g.Amount)) / SUM(b.Quantity1), 2) as Rate,
                   round(abs(SUM(g.Amount)),2) as Amount,
                   'DETAIL'
                From NecessitySlip a, NecessitySlipDetail b, Transporter c, Requisition d, Issue e, Voucher f, VoucherDetail g,Location h, Company i
                Where a.Tno = b.Tno(+)
                   and a.TransporterCode = c.TransporterCode(+)
                 --  and b.VehicleNecessityCode in (Select a.VehicleNecessityCode From VehicleNecessityForDiesel a)
                   and a.Tno = d.ModuleTno(+)
                   and d.Tno = e.RequisitionTno(+)
                   and e.Tno = f.ModuleTno(+)
                   and f.Tno = g.Tno(+)
                   and a.LocationCode = h.LocationCode(+)
                   and a.CompanyCode = i.CompanyCode(+)
                   and nvl(g.Amount, 0) < 0
                   and a.VehicleGroupCode != 'SELF'
                   and a.EquipmentTno is null
                   and a.NecessitySlipDate between :P396_FROMDATE and :P396_TODATE
                   and (:P396_COMPANY is Null Or Instr (':' || :P396_COMPANY|| ':' , ':' || a.CompanyCode || ':') > 0)
                   and (:P396_LOCATION is Null Or Instr (':' || :P396_LOCATION|| ':' , ':' || a.LocationCode || ':') > 0)
                   and (:P396_PARTY is Null Or Instr (':' || :P396_PARTY|| ':' , ':' || a.TransporterCode || ':') > 0)
                   and (:P396_VEHICLE is Null Or Instr (':' || :P396_VEHICLE|| ':' , ':' || a.vehicleNo || ':') > 0)
                Group by c.TransporterName,
                         c.TransporterCode,
                         h.LocationName,
                         h.LocationCode,
                         i.CompanyName
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 2694766334509825
        }

