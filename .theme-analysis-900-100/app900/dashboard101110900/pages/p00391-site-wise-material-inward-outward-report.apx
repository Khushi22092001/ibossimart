page 391 (
    name: Site Wise Material Inward Outward Report
    alias: SITE-WISE-MATERIAL-INWARD-OUTWARD-REPORT
    title: Site Wise Material Inward Outward Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var lSpinner$;
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        formAutoComplete: false
    }

    region site-wise-material-inward-outward (
        name: Site Wise Material Inward Outward
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 Select
                  'Detail' as Detail,
                   ROWNUM,
                   a.CompanyCode,
                   a.LocationCode,
                	a.CompanyName,
                	a.LocationName,
                	a.DieselPurchaseQuantity,
                	abs(a.DieselPurchaseAmount) as DieselPurchaseAmount ,
                	a.DieselTransferInQuantity,
                	abs(a.DieselTransferInAmount) as DieselTransferInAmount,
                	a.DieselIssueQuantity,
                	abs(a.DieselIssueAmount) as DieselIssueAmount,
                	a.DieselTransferOutQuantity,
                	abs(a.DieselTransferOutAmount) as DieselTransferOutAmount,
                	a.AdbluePurchaseQuantity,
                	abs(a.AdbluePurchaseAmount) as AdbluePurchaseAmount,
                	a.AdblueTransferInQuantity,
                	abs(a.AdblueTransferInAmount) as AdblueTransferInAmount,
                	a.AdblueIssueQuantity,
                	abs(a.AdblueIssueAmount) as AdblueIssueAmount,
                	a.AdblueTransferOutQuantity,
                	abs(a.AdblueTransferOutAmount) as AdblueTransferOutAmount,
                	a.OilPurchaseQuantity,
                	abs(a.OilPurchaseAmount) as OilPurchaseAmount,
                	a.OilTransferInQuantity,
                	abs(a.OilTransferInAmount) as OilTransferInAmount,
                	a.OilIssueQuantity,
                	abs(a.OilIssueAmount) as OilIssueAmount,
                	a.OilTransferOutQuantity,
                	abs(a.OilTransferOutAmount) as OilTransferOutAmount,
                	a.TyrePurchaseQuantity,
                	abs(a.TyrePurchaseAmount) as TyrePurchaseAmount,
                	a.TyreTransferInQuantity,
                	abs(a.TyreTransferInAmount) as TyreTransferInAmount,
                	a.TyreIssueQuantity,
                	abs(a.TyreIssueAmount) as TyreIssueAmount,
                	a.TyreTransferOutQuantity,
                	abs(a.TyreTransferOutAmount) as TyreTransferOutAmount,
                	a.SparePurchaseQuantity,
                	abs(a.SparePurchaseAmount) as SparePurchaseAmount,
                	a.SpareTransferInQuantity,
                	abs(a.SpareTransferInAmount) as SpareTransferInAmount,
                	a.SpareIssueQuantity,
                	abs(a.SpareIssueAmount) as SpareIssueAmount,
                	a.SpareTransferOutQuantity,
                	abs(a.SpareTransferOutAmount) as SpareTransferOutAmount
                From SiteWiseMaterialReportTable a
                Where a.Creator = :APP_USER
                  and :P391_FROMDATE IS NOT NULL
                  --and (:P391_LOCATION is Null Or Instr (':' || :P391_LOCATION|| ':' , ':' || a.LocationCode || ':') > 0)
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tab
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            htmlDomId: sitewisematerialio
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                   
                ```
        }
        advanced {
            savedReportMappingIdentifier: 380201604554897161
        }

