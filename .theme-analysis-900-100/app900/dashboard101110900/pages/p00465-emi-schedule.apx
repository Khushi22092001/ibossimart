page 465 (
    name: EMI Schedule
    alias: EMI-SCHEDULE
    title: EMI Schedule
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region emi-schedule (
        name: EMI Schedule
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.LedgerName,
                       a.TypeOfVehicle,
                       a.Type,
                       a.LoanStartDate,
                       a.LoanEndDate,
                       a.DueDate,
                       a.InstallMentAmount,
                       a.PrincipleAmount,
                       a.InterestAmount,
                       a.TotalEMI,
                       a.PaidEMI,
                       a.EMIStatus,
                       a.PaidByPaymentAdviceNo,
                       (a.TotalEMI - a.PaidEMI) AS UnpaidEMI
                From   EMIReport a
                Where  a.DueDate Between :P465_FROMDATE and :P465_TODATE
                  and  (:P465_COMPANY IS NULL OR instr(':'||:P465_COMPANY||':',':'||a.CompanyCode||':') > 0)
                  and  (:P465_LOCATION IS NULL OR instr(':'||:P465_LOCATION||':',':'||a.LocationCode||':') > 0)
                  and  (:P465_DOCTYPE IS NULL OR instr(':'||:P465_DOCTYPE||':',':'||a.DocTypeCode||':') > 0)
                  and  (:P465_EMISTATUS IS NULL OR instr(':'||:P465_EMISTATUS||':',':'||a.EMIStatus||':') > 0)
                  ORDER BY A.DUEDATE
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 20442539151231363
        }

        column DUEDATE (
            type: plainText
            heading {
                heading: Due Date
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column EMISTATUS (
