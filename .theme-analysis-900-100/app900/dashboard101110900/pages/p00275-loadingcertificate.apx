            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT Distinct
                COMPANYNAME D,
                COMPANYCODE R
                FROM COMPANY
                ```
        }
        layout {
            sequence: 60
            region: @loadingcertificate
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
