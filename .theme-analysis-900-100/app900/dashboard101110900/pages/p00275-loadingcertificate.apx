            displayColumn TOTALWAGEN (
                sequence: 8
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: TOTALWAGEN
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region loadingcertificate (
        name: LoadingCertificate
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P275_CERTIFICATENO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Certificate No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                LOADINGCERTIFICATENO D,
                LOADINGCERTIFICATENO R  
                FROM LOADINGCERTIFICATE
                ```
        }
        layout {
            sequence: 50
            region: @loadingcertificate
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 35
        }
    )

    pageItem P275_COMPANY (
