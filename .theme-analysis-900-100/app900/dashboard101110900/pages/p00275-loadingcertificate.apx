page 275 (
    name: LoadingCertificate
    alias: LOADINGCERTIFICATE
    title: LoadingCertificate
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region loading-certificate-report (
        name: Loading Certificate Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                row_number() over(order by lc.LoadingCertificateDate) SerialNo,
                l.locationname as location,
                d.doctypename as doctype,
                lc.loadingcertificatedate as entrydate,
                lc.loadingcertificateno as certificateno,
                lc.fromdate,
                lc.todate,
                lc.remark,
                cr.cmplrakeno as rakeentryno,
                cr.cmplrakedate as rakedate,
                lcd.totalwagen,
                round(lcd.quantity,3) as quantity
                from loadingcertificate lc,
                     loadingcertificatedetail lcd,
                     cmplrake cr,
                     location l,
                     COMPANY C,
                     doctype d
                where lc.tno = lcd.tno
                and lcd.cmplraketno = cr.tno
                and lc.locationcode = l.locationcode
                and lc.companycode = c.companycode
                and lc.doctypecode = d.doctypecode
                and lc.loadingcertificatedate between :P275_FROMDATE and :P275_TODATE
                --and ( :P275_DOCTYPE IS NULL OR instr(':'||:P275_DOCTYPE||':',':'||d.DocTypeCode||':') > 0 ) 
                and (:P275_LOCATION IS NULL OR instr(':'||:P275_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P275_CERTIFICATENO IS NULL OR instr(':'||:P275_CERTIFICATENO||':',':'||LC.LOADINGCERTIFICATENo||':') > 0 ) 
                and (:P275_COMPANY IS NULL OR instr(':'||:P275_COMPANY||':',':'||c.companycode||':') > 0)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 10929139156547749
        }

        column CERTIFICATENO (
            type: plainText
            heading {
                heading: Certificate No
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column DOCTYPE (
            type: plainText
            heading {
                heading: Doc Type
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column ENTRYDATE (
            type: plainText
            heading {
                heading: Entry Date
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column FROMDATE (
            type: plainText
            heading {
                heading: From Date
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column LOCATION (
            type: plainText
            heading {
                heading: Location
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column RAKEDATE (
            type: plainText
            heading {
                heading: Rake Date
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        column RAKEENTRYNO (
            type: plainText
            heading {
                heading: Rake Entry No
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
