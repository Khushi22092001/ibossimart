        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 40
        }
    )

    pageItem P275_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @loadingcertificate
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 35
        }
    )

    pageItem P275_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                l.locationname d,
                l.locationcode r
                from location l,loadingcertificate b
                where l.locationcode = b.locationcode(+)
                ```
        }
        layout {
            sequence: 40
            region: @loadingcertificate
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
