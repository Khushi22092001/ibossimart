    button custom (
        buttonName: CUSTOM
        label: Custom
        layout {
            sequence: 20
            region: @purchase-bill-register-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/purchasebillregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P73_FROMDATE=&P73_FROMDATE.&P73_TODATE=&P73_TODATE.&P73_PBPSTATUS=&P73_PBPSTATUS.&P73_ITEMSPECIFICATION=&P73_ITEMSPECIFICATION.&P73_ITEM=&P73_ITEM.&P73_LOCATION=&P73_LOCATION.&P73_PARTY=&P73_PARTY.&P73_PBNO=&P73_PBNO.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 1
        }
    )

