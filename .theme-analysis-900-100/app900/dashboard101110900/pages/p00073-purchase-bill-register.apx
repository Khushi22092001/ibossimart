    pageItem P73_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'PURCHASEBILL'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order By 1
                ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @purchase-bill-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
