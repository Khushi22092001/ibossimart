page 657 (
    name: Sales Invoice Details
    alias: SALES-INVOICE-DETAILS
    title: Sales Invoice Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            SALES INVOICE DETAILS (HSPL) — the complete record of one invoice.
            Terminal leaf: the sole item is P657_TNO (hidden). No scope filters,
            no Apply. Authorisation is re-derived server-side: the header selects
            the invoice ONLY through the panel guard, and every child region
            repeats that guard as an EXISTS back to CCInvoice. So pasting another
            panel's Tno into the URL returns a single "does not exist, or belongs
            to a Panel you are not authorised to see" empty state — deliberately
            not distinguishing the two, so existence is never leaked.
            
            Voucher and status are linked by ModuleTNo alone (HSPL does not
            module-qualify CC invoices as 'CCINVOICE'). Stock and serial
            traceability are sparse in this ERP; each empty state says so rather
            than showing a fabricated zero — remeasure the true coverage against
            data. Read-only. Back returns to 653; the register button opens 56.
            ```
    }

    region command-header (
        name: Invoice
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-sales-head">'
                  || '<div class="ds-sales-head-eyebrow">Invoice &middot; Sales Intelligence</div>'
                  || '<h1 class="ds-sales-head-title">Invoice ' || apex_escape.html(a.CCInvoiceNo) || '</h1>'
                  || '<div class="ds-sales-head-context">'
                  || '<span class="ds-chip"><span class="fa fa-calendar ds-chip-ic"></span><span class="ds-chip-k">Date</span><b>'
                     || apex_escape.html(to_char(a.CCInvoiceDate,'DD-Mon-RRRR')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-building-o ds-chip-ic"></span><span class="ds-chip-k">Company</span><b>'
                     || apex_escape.html(nvl(GetCompanyName(a.CompanyCode),a.CompanyCode)) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-map-marker ds-chip-ic"></span><span class="ds-chip-k">Location</span><b>'
                     || apex_escape.html(nvl(GetLocationName(a.LocationCode),a.LocationCode)) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-file-text-o ds-chip-ic"></span><span class="ds-chip-k">Doc Type</span><b>'
                     || apex_escape.html(nvl(dt.DocTypeName,a.DocTypeCode)) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-user-o ds-chip-ic"></span><span class="ds-chip-k">Customer</span><b>'
                     || apex_escape.html(nvl(GetPartyName(a.PartyCode),a.PartyCode)) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-id-card-o ds-chip-ic"></span><span class="ds-chip-k">GSTIN</span><b>'
                     || apex_escape.html(nvl(GetPartyAttributeValue(a.PartyCode,'GSTINNO'),'Not on file')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-truck ds-chip-ic"></span><span class="ds-chip-k">Consignee</span><b>'
                     || apex_escape.html(nvl(GetPartyName(so.ConsigneeCode),'—')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-handshake-o ds-chip-ic"></span><span class="ds-chip-k">Agent</span><b>'
                     || apex_escape.html(nvl(GetPartyName(so.AgentCode),'Not recorded')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-shopping-cart ds-chip-ic"></span><span class="ds-chip-k">Sales Order</span><b>'
                     || apex_escape.html(nvl(so.SalesOrderNo,'Not linked')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-paper-plane-o ds-chip-ic"></span><span class="ds-chip-k">Dispatch Advice</span><b>'
                     || apex_escape.html(nvl(da.DespatchAdviceNo,'Not linked')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-truck ds-chip-ic"></span><span class="ds-chip-k">Transporter</span><b>'
                     || apex_escape.html(nvl(GetPartyName(a.TransporterCode),'—')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-car ds-chip-ic"></span><span class="ds-chip-k">Vehicle</span><b>'
                     || apex_escape.html(nvl(a.VehicleNo,'—')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-info-circle ds-chip-ic"></span><span class="ds-chip-k">Status</span><b>'
                     || apex_escape.html(nvl((Select Max(dsd.DocumentStatusCode) From DocumentStatusDetail dsd
                          Where dsd.ModuleTNo = a.TNo),'No status')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-book ds-chip-ic"></span><span class="ds-chip-k">Voucher</span><b>'
                     || apex_escape.html(nvl((Select Max(v.VoucherNo) From Voucher v
                          Where v.ModuleTNo = a.TNo),'Not posted')) || '</b></span>'
                  || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                          Then '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span><span class="ds-chip-k">Panel</span><b>'
                               || apex_escape.html(a.Panel) || ' (enforced)</b></span>'
                          Else '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span><span class="ds-chip-k">Panel</span><b>'
                               || apex_escape.html(a.Panel) || '</b></span>' End
                  || '</div></div>' As HEAD
                From CCInvoice a
                Left Join DocType dt On dt.DocTypeCode = a.DocTypeCode
                Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                Left Join DespatchAdvice da On da.TNo = a.DespatchAdviceTNo
                Where a.TNo = :P657_TNO
                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                       Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                ```
            pageItemsToSubmit: P657_TNO
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
            cssClasses: ds-sales-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: This invoice does not exist, or it belongs to a Panel you are not authorised to see.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region invoice-items (
        name: Invoice Items
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.SNo As SNO,
                       nvl(i.ItemName, b.ItemCode) As ITEM,
                       b.ItemSpecificationCode As SPEC,
                       i.MeasuringUnitCode1 As UOM,
                       b.Quantity1 As QTY1,
                       b.Quantity2 As QTY2,
                       b.Rate As RATE,
                       b.Amount As AMOUNT,
                       b.FooterAmount As FOOTER,
                       b.TotalAmount As TOTAL
                  From CCInvoiceDetail b
                  Left Join Item i On i.ItemCode = b.ItemCode
                 Where b.TNo = :P657_TNO
                   And Exists (Select 1 From CCInvoice c Where c.TNo = b.TNo
                                And ((Select GetUserPanelAB_apex() From dual) Is Null
                                     Or c.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By b.SNo
                ```
            pageItemsToSubmit: P657_TNO
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        messages {
            whenNoDataFound: This invoice has no item lines.
        }

        column AMOUNT (
            derivedColumn: N
            heading {
                heading: Amount
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
