    region kpi-strip (
        name: Invoice Totals
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Tax As (
                       Select TNo, SNo,
                              Sum(Decode(FooterHeadCode,'.CGST.',FooterValue,'.SGST.',FooterValue,
                                         '.IGST.',FooterValue,'.TCS.',FooterValue,0)) LineTax
                         From CCInvoiceDetailFooter Group By TNo, SNo),
                Agg As (
                       Select Sum(b.Amount) Val, Sum(nvl(tx.LineTax,0)) Tax,
                              Sum(b.TotalAmount) Inv, Count(b.SNo) Lines,
                              Count(Distinct b.ItemCode) Items
                         From CCInvoiceDetail b
                         Left Join Tax tx On tx.TNo = b.TNo And tx.SNo = b.SNo
                        Where b.TNo = :P657_TNO
                          And Exists (Select 1 From CCInvoice c Where c.TNo = b.TNo
                                       And ((Select GetUserPanelAB_apex() From dual) Is Null
                                            Or c.Panel = (Select GetUserPanelAB_apex() From dual))))
                Select
                  '<div class="ds-kpi ds-kpi--value"><span class="ds-kpi-ic"><span class="fa fa-inr"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Sales Value</span><span class="ds-kpi-n">Rs '
                  || to_char(nvl(Val,0),'FM99G99G99G990D00') || '</span><span class="ds-kpi-sub">taxable line value</span></span></div>' As KPI1,
                  '<div class="ds-kpi ds-kpi--freight"><span class="ds-kpi-ic"><span class="fa fa-percent"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Tax</span><span class="ds-kpi-n">Rs '
                  || to_char(nvl(Tax,0),'FM99G99G99G990D00') || '</span><span class="ds-kpi-sub">CGST + SGST + IGST + TCS</span></span></div>' As KPI2,
                  '<div class="ds-kpi ds-kpi--bill"><span class="ds-kpi-ic"><span class="fa fa-file-text-o"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Total Invoice Value</span><span class="ds-kpi-n">Rs '
                  || to_char(nvl(Inv,0),'FM99G99G99G990D00') || '</span><span class="ds-kpi-sub">value plus all charges</span></span></div>' As KPI3,
                  '<div class="ds-kpi ds-kpi--suppl"><span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Item Lines</span><span class="ds-kpi-n">'
                  || to_char(nvl(Lines,0),'FM999G990') || '</span><span class="ds-kpi-sub">'
                  || to_char(nvl(Items,0),'FM999G990') || ' distinct items</span></span></div>' As KPI4
                From Agg
                ```
            pageItemsToSubmit: P657_TNO
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No totals available.
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI2 (
            reportColumnQueryId: 2
            derivedColumn: N
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI3 (
            reportColumnQueryId: 3
            derivedColumn: N
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI4 (
            reportColumnQueryId: 4
            derivedColumn: N
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region page-style (
        name: Sales Theme
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                body:has(.ds-sales-headregion){
                  --ds-dash-gold:#4F46E5; --ds-dash-gold-bg:#EEF0FE;
                  --ds-dash-ink:#1E1B4B; --ds-dash-ink2:#4C4A6E;
                  --ds-dash-canvas:#F7F7FB; --ds-dash-tinted:#F2F2F9; --ds-dash-line:#E4E4F0;
                }
                body:has(.ds-sales-headregion) .ds-kpi--value{--ds-kpi-accent:#4F46E5;--ds-kpi-accent-bg:#EEF0FE;}
                body:has(.ds-sales-headregion) .ds-kpi--bill {--ds-kpi-accent:#6D5CE7;--ds-kpi-accent-bg:#EEF0FE;}
                body:has(.ds-sales-headregion) .ds-kpi--input{--ds-kpi-accent:#0E7C86;--ds-kpi-accent-bg:#E4F4F5;}
                .ds-sales-head{position:relative;overflow:hidden;padding:24px 26px 20px;border:1px solid #C7C5EE;border-radius:16px;background:radial-gradient(130% 130% at 92% 8%, rgba(109,92,231,.30) 0%, rgba(109,92,231,0) 48%),radial-gradient(120% 120% at 0% 100%, rgba(55,48,163,.20) 0%, rgba(55,48,163,0) 44%),linear-gradient(120deg,#D9D8F4 0%,#D2CFF0 34%,#DED9F6 66%,#EAE7FC 100%);box-shadow:0 1px 2px rgba(16,24,40,.05),0 12px 34px rgba(79,70,229,.12);}.ds-sales-head-eyebrow,.ds-sales-head-title,.ds-sales-head-sub,.ds-sales-head-context{position:relative;z-index:1;}.ds-sales-head-context{max-width:64%;}
                .ds-sales-head-eyebrow{font-size:11px;font-weight:700;letter-spacing:.10em;
                  text-transform:uppercase;color:#4F46E5;margin-bottom:4px;}
                .ds-sales-head-title{margin:0;font-size:25px;font-weight:600;letter-spacing:-.01em;
                  line-height:1.2;color:#1E1B4B;}
                .ds-sales-head-sub{margin:5px 0 0;font-size:13px;line-height:1.5;color:#4C4A6E;max-width:74ch;}
                .ds-sales-head-context{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px;}
                html.page-657 .t-Body-title.hspl-hero-card,html.page-657 .t-Body-title{display:none !important;}
                </style>
                ```
        }
        layout {
            sequence: 1
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
        }
    )

    region serial-trace (
        name: Serial Number Traceability
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.SNo As SNO,
                       nvl(i.ItemName, b.ItemCode) As ITEM,
                       cos.ComponentSerialNo As SERIAL_NO
                  From CCInvoiceDetail b
                  Join CCInvoiceDetailSerialNo ccds On ccds.TNo = b.TNo And ccds.SNo = b.SNo
                  Left Join ComponentStock cos On cos.TNo = ccds.ComponentStockTno
                  Left Join Item i On i.ItemCode = b.ItemCode
                 Where b.TNo = :P657_TNO
                   And Exists (Select 1 From CCInvoice c Where c.TNo = b.TNo
                                And ((Select GetUserPanelAB_apex() From dual) Is Null
                                     Or c.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By b.SNo
                ```
            pageItemsToSubmit: P657_TNO
        }
        layout {
            sequence: 60
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        messages {
            whenNoDataFound: No serial numbers are recorded against this invoice. Serial traceability is very sparsely captured for sales in this ERP (remeasure the true coverage against your data).
        }

        column ITEM (
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 20
            }
        )

        column SERIAL_NO (
            derivedColumn: N
            heading {
                heading: Serial No
            }
            layout {
                sequence: 30
            }
        )

        column SNO (
            derivedColumn: N
            heading {
                heading: Line
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: FM990
            }
        )

    )

    region stock-trace (
        name: Stock Traceability
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.SNo As SNO,
                       nvl(i.ItemName, b.ItemCode) As ITEM,
                       ccs.StockTno As STOCK_TNO,
                       st.ItemSpecificationCode As STOCK_SPEC
                  From CCInvoiceDetail b
                  Join CCInvoiceStockStorageDetail ccs On ccs.TNo = b.TNo And ccs.SNo = b.SNo
                  Left Join Stock st On st.TNo = ccs.StockTno
                  Left Join Item i On i.ItemCode = b.ItemCode
                 Where b.TNo = :P657_TNO
                   And Exists (Select 1 From CCInvoice c Where c.TNo = b.TNo
                                And ((Select GetUserPanelAB_apex() From dual) Is Null
                                     Or c.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By b.SNo
                ```
            pageItemsToSubmit: P657_TNO
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        messages {
            whenNoDataFound: No stock layer is linked to this invoice. Stock traceability is captured on only a small fraction of sales lines in this ERP (remeasure the true coverage against your data), so its absence here is expected, not an error.
        }

        column ITEM (
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 20
            }
        )

        column SNO (
            derivedColumn: N
            heading {
                heading: Line
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: FM990
            }
        )

        column STOCK_SPEC (
            derivedColumn: N
            heading {
                heading: Stock Specification
            }
            layout {
                sequence: 40
            }
        )

        column STOCK_TNO (
            derivedColumn: N
            heading {
                heading: Stock Tno
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

    )

    region tax-details (
        name: Tax Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Tax As (
                       Select TNo, SNo,
                              Sum(Decode(FooterHeadCode,'.CGST.',FooterValue,0)) Cgst,
                              Sum(Decode(FooterHeadCode,'.SGST.',FooterValue,0)) Sgst,
                              Sum(Decode(FooterHeadCode,'.IGST.',FooterValue,0)) Igst,
                              Sum(Decode(FooterHeadCode,'.TCS.', FooterValue,0)) Tcs
                         From CCInvoiceDetailFooter Group By TNo, SNo)
                Select b.SNo As SNO,
                       nvl(i.ItemName, b.ItemCode) As ITEM,
                       nvl(tx.Cgst,0) As CGST,
                       nvl(tx.Sgst,0) As SGST,
                       nvl(tx.Igst,0) As IGST,
                       nvl(tx.Tcs,0) As TCS,
                       -- Residual: every footer charge that is not one of the four taxes.
                       (nvl(b.FooterAmount,0) - (nvl(tx.Cgst,0)+nvl(tx.Sgst,0)+nvl(tx.Igst,0)+nvl(tx.Tcs,0))) As OTHER_CHARGES,
                       b.FooterAmount As FOOTER_TOTAL
                  From CCInvoiceDetail b
                  Left Join Item i On i.ItemCode = b.ItemCode
                  Left Join Tax tx On tx.TNo = b.TNo And tx.SNo = b.SNo
                 Where b.TNo = :P657_TNO
                   And Exists (Select 1 From CCInvoice c Where c.TNo = b.TNo
                                And ((Select GetUserPanelAB_apex() From dual) Is Null
                                     Or c.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By b.SNo
                ```
            pageItemsToSubmit: P657_TNO
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        messages {
            whenNoDataFound: No tax or charge lines on this invoice.
        }

        column CGST (
            derivedColumn: N
            heading {
                heading: CGST
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
        )

        column FOOTER_TOTAL (
            derivedColumn: N
            heading {
                heading: Footer Total
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
        )

        column IGST (
            derivedColumn: N
            heading {
                heading: IGST
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
        )

        column ITEM (
            derivedColumn: N
            heading {
                heading: Item
            }
            layout {
                sequence: 20
            }
        )

        column OTHER_CHARGES (
            derivedColumn: N
            heading {
                heading: Other Charges
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
        )

        column SGST (
            derivedColumn: N
            heading {
                heading: SGST
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
        )

        column SNO (
            derivedColumn: N
            heading {
                heading: Line
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: FM990
            }
        )

        column TCS (
            derivedColumn: N
            heading {
                heading: TCS
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
        )

    )

    region toolbar (
        name: Actions
        type: staticContent
        layout {
            sequence: 8
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
            cssClasses: ds-dash-filters
        }
        advanced {
            htmlDomId: p657Toolbar
        }
    )

    region voucher-info (
        name: Voucher Information
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select v.VoucherNo As VOUCHER_NO,
                       v.VoucherDate As VOUCHER_DATE,
                       v.DocTypeCode As DOC_TYPE
                  From Voucher v
                 Where v.ModuleTNo = :P657_TNO
                   And Exists (Select 1 From CCInvoice c Where c.TNo = v.ModuleTNo
                                And ((Select GetUserPanelAB_apex() From dual) Is Null
                                     Or c.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By v.VoucherDate
                ```
            pageItemsToSubmit: P657_TNO
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        messages {
            whenNoDataFound: This invoice has no voucher posted. Vouchers are linked to only a small fraction of CC invoices in this ERP (remeasure the true coverage against your data), so this is information, not an exception.
        }

        column DOC_TYPE (
            derivedColumn: N
            heading {
                heading: Doc Type
            }
            layout {
                sequence: 30
            }
        )

        column VOUCHER_DATE (
            derivedColumn: N
            heading {
                heading: Date
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-RRRR
            }
        )

        column VOUCHER_NO (
            derivedColumn: N
            heading {
                heading: Voucher No
            }
            layout {
                sequence: 10
            }
        )

    )

    pageItem P657_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @toolbar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button back-to-dash (
        buttonName: BACKTODASH
        label: Back to Command Centre
        layout {
            sequence: 20
            region: @toolbar
            slot: regionBody
            column: 1
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 653
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button open-register (
        buttonName: OPENREGISTER
        label: CC Invoice Register
        layout {
            sequence: 30
            region: @toolbar
            slot: regionBody
            startNewRow: false
            column: 4
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-table
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 56
                clearCache: 56
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

