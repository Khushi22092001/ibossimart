page 201 (
    name: Production Wise Consumption
    alias: PRODUCTION-WISE-CONSUMPTION
    title: Production Wise Consumption
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        height: 700
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region production-wise-consumption-report (
        name: Production Wise Consumption Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct C.PRODUCTIONNO,
                                A.ITEMCODE,
                                A.ITEMNAME,
                                B.ITEMSPECIFICATIONNAME,
                                B.ITEMSPECIFICATIONCODE, 
                                E.STORAGELOCATIONCODE,
                                GETSTORAGELOCATIONNAME(E.STORAGELOCATIONCODE) AS StorageLocation,              
                                SUM(E.UsedStockQuantity1) AS QUANTITY,
                                SUM(E.UsedStockQuantity1 * F.RATE) AS VALUE
                                
                  From ITEM A, ITEMSPECIFICATION B, PRODUCTION C, PRODUCTIONRAW D, USEDSTOCKSTORAGEDETAIL E, STOCK F
                 Where A.TNO = B.TNO
                   AND C.TNO = D.TNO
                   AND A.ITEMCODE = D.ITEMCODE
                   AND B.ITEMSPECIFICATIONCODE = D.ITEMSPECIFICATIONCODE
                   AND D.TNO = E.MODULETNO
                   AND D.SNO = E.MODULESNO
                   AND E.STOCKTNO = F.TNO
                   And C.PRODUCTIONDATE Between :P201_FROMDATE And :P201_TODATE
                   And a.ItemCode = :P201_ITEM
                   And b.ItemSpecificationCode = :P201_SPECIFICATION
                
                GROUP BY C.PRODUCTIONNO,
                                A.ITEMCODE,
                                A.ITEMNAME,
                                B.ITEMSPECIFICATIONNAME,
                                B.ITEMSPECIFICATIONCODE,
                                E.STORAGELOCATIONCODE,
                                GETSTORAGELOCATIONNAME(E.STORAGELOCATIONCODE)
                
                 Order By C.PRODUCTIONNO
                ```
            pageItemsToSubmit: [
                P201_COMPANY
                P201_LOCATION
                P201_FROMDATE
                P201_TODATE
                P201_ITEM
                P201_SPECIFICATION
            ]
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: STOCK POSITION
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 106843615781455116
        }

        column ITEMCODE (
            type: hidden
