        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                   c.PartyName d,
                   c.PartyCode r
                 From Party c
                 Where exists (
                      Select 
                      b.AccountCode
                      From VoucherDetail b,Party d
                      Where b.AccountCode = d.PartyCode
                      and d.ParentCode = c.PartyCode )
                      
                
                ```
            displayNullValue: false
