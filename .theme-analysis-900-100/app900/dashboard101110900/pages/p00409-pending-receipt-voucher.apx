    region pending-receipt-voucher (
        name: "Pending Receipt Voucher "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.Tno,
                   row_number() over(order by a.VoucherDate) SerialNo,
                	c.CompanyName,
                	d.LocationName,
                	e.DocTypeName,
                	a.VoucherNo,
                	a.VoucherDate,
                	f.PartyName as AccountName,
                	sum(b.Amount) as VoucherAmount,
                	nvl(x.ReceiptAmount, 0) as ReceiptAmount,
                	nvl(sum(b.Amount), 0) - nvl(x.ReceiptAmount, 0) as BalanceAmount
                From Voucher a, VoucherDetail b, Company c, Location d, DocType e, Party f, Party g,
                	(
                	Select
                		a.VoucherTno,
                		a.VoucherSno,
                		sum(b.Amount) as ReceiptAmount
                	From DFreightBillReceipt a, DFreightBillReceiptDetail b
                	Where a.Tno = b.Tno
                	Group by
                		a.VoucherTno,
                		a.VoucherSno
                	) x
                Where a.Tno = b.Tno
                	and a.CompanyCode = c.CompanyCode(+)
                	and a.LocationCode = d.LocationCode(+)
                	and a.DocTypeCode = e.DocTypeCode(+)
                	and b.AccountCode = f.PartyCode(+)
                   and f.ParentCode = g.PartyCode(+)
                	and b.Tno = x.VoucherTno(+)
                	and b.Sno = x.VoucherSno(+)
                    
                    -- 22-APR-2025
                    and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                	and a.DocTypeCode = 'RECEIPT'
                	and nvl(b.Amount, 0) > 0
                   and a.VoucherDate between :P409_FROMDATE and :P409_TODATE
                   and ( :P409_COMPANY IS NULL OR instr(':'||:P409_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                   and (:P409_PARTY is Null Or Instr (':' || :P409_PARTY || ':' , ':' || f.PartyCode || ':') > 0)
                   and ( :P409_VOUCHER IS NULL OR instr(':'||:P409_VOUCHER||':',':'||a.Tno||':') > 0 ) 
                   and ( :P409_PARENT IS NULL OR instr(':'||:P409_PARENT||':',':'||f.ParentCode||':') > 0 ) 
                Group by
                	a.Tno,
                	c.CompanyName,
                	d.LocationName,
                	e.DocTypeName,
                	a.VoucherNo,
                	a.VoucherDate,
                	f.PartyName,
                	x.ReceiptAmount
                Having nvl(sum(b.Amount), 0) - nvl(x.ReceiptAmount, 0) > 0
                ```
        }
