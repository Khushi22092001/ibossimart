page 262 (
    name: MaintenanceOrderReport
    alias: MAINTENANCEORDERREPORT
    title: MaintenanceOrderReport
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenance-order (
        name: Maintenance Order
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region master (
        name: Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                row_number() over(order by a.equipmentmaintenanceorderdate) SerialNo,
                l.locationname,
                d.doctypename,
                c.companyname,
                a.equipmentmaintenanceorderdate,
                a.equipmentmaintenanceorderno,
                moc.maintenanceordercompletiondate,
                moc.maintenanceordercompletionno,
                ses.serviceentrysheetno,
                ses.serviceentrysheetdate,
                a.notificationno,
                e.equipmentid,
                e.equipmentno,
                e.equipmentname,
                wc.workcentrename,
                p.priorityname,
                a.shorttext,
                a.longtext,
                a.estimatedcost,
                a.controlkey,
                mp.equipmentmaintenanceplanno,
                a.basicstartdate,
                a.orderfinishdate,
                s.maintenancestrategyname,
                mt.maintenancetypename as maintenancetype,
                ac.activityname,
                b.durationofoperation,
                b.unitofmeasurementforduration,
                i.itemname,
                isp.itemspecificationname,
                moid.quantity1,
                moid.lastpurchaserate,
                moid.amount,
                a.isjobcardrequired
                    from equipmentmaintenanceorder a,
                         equipmentmaintenanceorderdtl b,
                         MAINTENANCEORDERCOMPLETION MOC,
                         SERVICEENTRYSHEET SES,
                         location l,
                         doctype d,
                         company c,
                         maintenancestrategy s,
                         equipmentmaintenanceplan mp,
                         priority p,
                         workcentre wc,
                         activity ac,
                         equipment e,
                         maintenancerequest r,
                         maintenanceorderitemdetail moid,
                         item i,
                         itemspecification isp,
                         MAINTENANCETYPE MT
                where a.locationcode = l.locationcode(+)
                and a.doctypecode = d.doctypecode(+)
                and a.companycode = c.companycode(+)
                and a.prioritycode = p.prioritycode(+)
                and a.workcentrecode = wc.workcentrecode(+)
                and mp.maintenancestrategycode = s.maintenancestrategycode(+)
                and b.activitycode = ac.activitycode(+)
                and a.equipmenttno = e.tno(+)
                and a.maintenancerequesttno = r.tno(+)
                and r.plantno = mp.tno(+)
                AND r.maintenancetypecode = mt.maintenancetypecode(+)
                and moid.itemcode = i.itemcode(+)
                and moid.itemspecificationcode = isp.itemspecificationcode(+)
                and a.tno = moc.equipmentmaintenanceordertno(+)
                and a.tno = ses.equipmentmaintenanceordertno(+)
                and a.tno = b.tno(+)
                and b.tno = moid.tno(+)
                and b.sno = moid.sno(+)
                and a.equipmentmaintenanceorderdate between :P262_FROMDATE and :P262_TODATE
                and ( :P262_DOCTYPE IS NULL OR instr(':'||:P262_DOCTYPE||':',':'||D.DocTypeCode||':') > 0 ) 
                and (:P262_LOCATION IS NULL OR instr(':'||:P262_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P262_COMPANY IS NULL OR instr(':'||:P262_COMPANY||':',':'||C.COMPANYCODE||':') > 0 ) 
                and (:P262_EQUIPMENT IS NULL OR instr(':'||:P262_EQUIPMENT||':',':'||E.EQUIPMENTNAME||':') > 0)
                and (:P262_MAINTENANCEPLANNO IS NULL OR instr(':'||:P262_MAINTENANCEPLANNO||':',':'||MP.EQUIPMENTMAINTENANCEPLANNO||':') > 0 ) 
                and (:P262_EQUIPMENTNO IS NULL OR instr(':'||:P262_EQUIPMENTNO||':',':'||E.EQUIPMENTNO||':') > 0)
                and ( :P262_PRIORITY IS NULL OR instr(':'||:P262_PRIORITY||':',':'||P.PRIORITYCode||':') > 0 ) 
                and (:P262_ORDERNO IS NULL OR instr(':'||:P262_ORDERNO||':',':'||A.EQUIPMENTMAINTENANCEORDERNO||':') > 0)
                and (:P262_MAINTENANCETYPE IS NULL OR instr(':'||:P262_MAINTENANCETYPE||':',':'||MT.MAINTENANCETYPECODE||':') > 0)
                and ( :P262_CONTROLKEY IS NULL OR instr(':'||:P262_CONTROLKEY||':',':'||A.CONTROLKEY||':') > 0 ) 
                and ( :P262_STRATEGY IS NULL OR instr(':'||:P262_STRATEGY||':',':'||S.MAINTENANCESTRATEGYCODE||':') > 0 ) 
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 7237358886459938
        }

