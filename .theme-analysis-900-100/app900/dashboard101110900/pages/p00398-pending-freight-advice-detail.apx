            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 1187767 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DELIVERYDATE (
                sequence: 10
            )

            displayColumn DESTINATIONLOCATIONNAME (
                sequence: 7
            )

            displayColumn LRDATE (
                sequence: 2
            )

            displayColumn LRNO (
                sequence: 1
            )

            displayColumn LRQTY (
                sequence: 8
            )

            displayColumn PARTYREFNO (
                sequence: 3
            )

            displayColumn PODQTY (
                sequence: 9
            )

            displayColumn SOURCELOCATIONNAME (
                sequence: 6
            )

            displayColumn TRANSPORTERNAME (
                sequence: 5
            )

            displayColumn VEHICLENO (
                sequence: 4
            )

        )

    )

    pageItem P398_COMPANY (
        type: hidden
        layout {
            sequence: 30
            region: @report
            slot: regionBody
        }
    )

    pageItem P398_FROMDATE (
        type: hidden
        layout {
