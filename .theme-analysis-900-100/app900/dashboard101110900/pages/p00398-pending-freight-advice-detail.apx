            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column PARTYREFNO (
            type: plainText
            heading {
                heading: Party DO NO
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column PODQTY (
            type: plainText
            heading {
                heading: POD Quantity
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column SOURCELOCATIONNAME (
            type: plainText
            heading {
                heading: Source Location Name
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column TRANSPORTERNAME (
            type: plainText
            heading {
                heading: Transporter Name
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: Vehicle No
            }
            layout {
