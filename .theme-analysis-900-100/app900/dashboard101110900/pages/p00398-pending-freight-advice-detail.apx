page 398 (
    name: Pending Freight Advice Detail
    alias: PENDING-FREIGHT-ADVICE-DETAIL
    title: Pending Freight Advice Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #itb .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    a.LRNo,
                    a.LRDate,
                    a.PartyRefNo,
                    a.VehicleNo,
                    b.TransporterName,
                    c.SourceLocationName,
                    d.DestinationLocationName,
                    a.Quantity1 as LRQty,
                    e.Quantity1 as PODQty,
                    e.DeliveryDate
                From LR a,
                 (Select 
                      a.*  
                  From LR a
                  Where not exists(
                                Select
                                 ax.ModuleTno
                               From FreightAdviceDetail ax
                               Where ax.ModuleTno = a.Tno)) aa, Transporter b, SourceLocation c, DestinationLocation d,
                               PODDetail e
                Where a.Tno = aa.tno
                  and a.TransporterCode = b.TransporterCode
                  and a.SourceLocationTno = c.Tno
                  and a.DestinationLocationTno = d.Tno
                  and a.Tno = e.LRTno
                  and a.GPDate between :P398_FROMDATE and :P398_TODATE
                 -- and (:P398_COMPANY is Null Or Instr (':' || :P398_COMPANY|| ':' , ':' || a.CompanyCode || ':') > 0)
                  and (:P398_TRANSPORTER is Null Or Instr (':' || :P398_TRANSPORTER|| ':' , ':' || a.TransporterCode || ':') > 0)
                  and (:P398_PARTYDONO is Null Or Instr (':' || :P398_PARTYDONO|| ':' , ':' || a.PartyRefNo || ':') > 0)
                ```
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: itb
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 118760261718440032
        }

        column DELIVERYDATE (
            type: plainText
            heading {
                heading: Delivery Date
                alignment: center
            }
            layout {
                sequence: 19
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
        )

        column DESTINATIONLOCATIONNAME (
            type: plainText
            heading {
                heading: Destination Location Name
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column LRDATE (
            type: plainText
            heading {
                heading: LR Date
                alignment: center
            }
            layout {
                sequence: 2
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column LRNO (
            type: plainText
            heading {
                heading: LR NO
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column LRQTY (
            type: plainText
