page 734 (
    name: Sales Order 360
    alias: SALES-ORDER-360
    title: Sales Order 360
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Read-only Sales Order 360. Traces one order from confirmation through dispatch, gate, weighment, CC invoice and IRN with standalone date, company, location and panel filters.
    }

    region command-header (
        name: Sales Order 360
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-so360-hero"><div class="ds-so360-row"><span class="ds-so360-icon"><span class="fa fa-file-text-o"></span></span><span>'
                    ||'<span class="ds-so360-eye">Commercial &middot; Order-to-Cash</span><br><span class="ds-so360-title">Sales Order 360</span>'
                    ||'<div class="ds-so360-sub">One order, every item and every downstream handoff &mdash; dispatch, gate, weighment, invoice and IRN.</div></span></div>'
                    ||'<span class="ds-so360-chip"><span class="fa fa-calendar"></span>'||apex_escape.html(:P734_FROMDATE)||' &ndash; '||apex_escape.html(:P734_TODATE)||'</span>'
                    ||Case When :P734_SOTNO Is Not Null Then '<span class="ds-so360-chip"><b>'||apex_escape.html((Select Max(SalesOrderNo) From SalesOrder Where TNo=:P734_SOTNO))||'</b></span>' Else '' End
                    ||'</div>' Head
                From dual
                ```
            pageItemsToSubmit: [
                P734_FROMDATE
                P734_TODATE
                P734_SOTNO
            ]
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-slc-headregion
                ds-360-headregion
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

