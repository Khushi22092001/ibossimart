    region page-style (
        name: Sales Order 360 Theme
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                body:has(.ds-slc-headregion){--slc-primary:#0F766E;--slc-secondary:#0891B2;--slc-deep:#134E4A;--ds-dash-gold:#0F766E;--ds-dash-gold-bg:#E5F3F1;--ds-dash-ink:#0B3B36;--ds-dash-ink2:#2E5A55;}
                body:has(.ds-slc-headregion) .ds-kpi--value{--ds-kpi-accent:#0F766E;--ds-kpi-accent-bg:#E5F3F1;}
                body:has(.ds-slc-headregion) .ds-kpi--bill{--ds-kpi-accent:#0891B2;--ds-kpi-accent-bg:#E2F4F8;}
                body:has(.ds-slc-headregion) .ds-kpi--risk{--ds-kpi-accent:#B45309;--ds-kpi-accent-bg:#FBF0E2;}
                body:has(.ds-slc-headregion) .ds-kpi--ok{--ds-kpi-accent:#15803D;--ds-kpi-accent-bg:#E6F4EA;}
                .ds-so360-hero{padding:22px 24px;border:1px solid #A7D9D3;border-radius:16px;background:linear-gradient(120deg,#D3EEEA,#E9F7F5);box-shadow:0 12px 34px rgba(15,118,110,.12);}
                .ds-so360-row{display:flex;align-items:flex-start;gap:15px}.ds-so360-icon{display:grid;place-items:center;width:50px;height:50px;border-radius:13px;color:#fff;background:linear-gradient(135deg,#0D9488,#0F766E);font-size:20px}
                .ds-so360-eye{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#0F766E}.ds-so360-title{font-size:25px;font-weight:700;color:#0B3B36}.ds-so360-sub{margin-top:5px;color:#2E5A55;line-height:1.5}
                .ds-so360-chip{display:inline-flex;gap:6px;margin-top:14px;padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.72);color:#2E5A55}
                html.page-734 .t-Body-title{display:none!important}
                </style>
                ```
        }
        layout {
            sequence: 1
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

