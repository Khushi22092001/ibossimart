    region order-lines (
        name: Sales Order Item Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Dsp As (
                  Select d.ReferenceTNo,d.ItemCode,d.ItemSpecificationCode,Sum(d.Quantity1) Qty
                    From DespatchAdviceDetail d
                   Group By d.ReferenceTNo,d.ItemCode,d.ItemSpecificationCode),
                Inv As (
                  Select d.ReferenceTNo,d.ItemCode,d.ItemSpecificationCode,Sum(d.Quantity1) Qty
                    From CCInvoiceDetail d
                   Group By d.ReferenceTNo,d.ItemCode,d.ItemSpecificationCode)
                Select so.SalesOrderNo,so.SalesOrderDate,GetPartyName(so.PartyCode) Customer,
                       d.ItemCode,i.ItemName,isp.ItemSpecificationName,i.MeasuringUnitCode1 UOM,
                       d.Quantity1 OrderQty,Nvl(ds.Qty,0) DispatchQty,Nvl(iv.Qty,0) InvoiceQty,
                       Greatest(Nvl(d.Quantity1,0)-Nvl(iv.Qty,0),0) BalanceQty,
                       d.Rate,d.Amount,d.TotalAmount
                  From SalesOrder so Join SalesOrderDetail d On d.TNo=so.TNo
                  Left Join Item i On i.ItemCode=d.ItemCode
                  Left Join ItemSpecification isp On isp.ItemSpecificationCode=d.ItemSpecificationCode
                  Left Join Dsp ds On ds.ReferenceTNo=so.TNo And ds.ItemCode=d.ItemCode And ds.ItemSpecificationCode=d.ItemSpecificationCode
                  Left Join Inv iv On iv.ReferenceTNo=so.TNo And iv.ItemCode=d.ItemCode And iv.ItemSpecificationCode=d.ItemSpecificationCode
                 Where so.TNo=:P734_SOTNO
                   And so.SalesOrderDate Between to_date(:P734_FROMDATE,'DD-MM-RRRR') And to_date(:P734_TODATE,'DD-MM-RRRR')
                   And (:P734_COMPANY Is Null Or so.CompanyCode=:P734_COMPANY)
                   And (:P734_LOCATION Is Null Or so.LocationCode=:P734_LOCATION)
                   And (:P734_PANEL Is Null Or so.Panel=:P734_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                 Order By d.SNo
                ```
            pageItemsToSubmit: [
                P734_SOTNO
                P734_FROMDATE
                P734_TODATE
                P734_COMPANY
                P734_LOCATION
                P734_PANEL
            ]
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: p734OrderLines
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No order lines match the selected scope.
        }
        advanced {
            savedReportMappingIdentifier: 52086591392084043
        }

