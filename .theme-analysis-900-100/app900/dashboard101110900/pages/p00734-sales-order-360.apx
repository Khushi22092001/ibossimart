    pageItem P734_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(add_months(trunc(sysdate,'MM'),-2),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P734_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: Select LocationName d,LocationCode r From Location Order By 1
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P734_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            displayExtraValues: false
            nullDisplayValue: A + B
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 9
            columnSpan: 1
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P734_SOTNO (
        type: popupLov
        label {
            label: Sales Order
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select so.SalesOrderNo||' - '||GetPartyName(so.PartyCode)||' - '||to_char(so.SalesOrderDate,'DD-Mon-RRRR') d,so.TNo r
                  From SalesOrder so
                 Where so.SalesOrderDate Between to_date(:P734_FROMDATE,'DD-MM-RRRR') And to_date(:P734_TODATE,'DD-MM-RRRR')
                   And (:P734_COMPANY Is Null Or so.CompanyCode=:P734_COMPANY)
                   And (:P734_LOCATION Is Null Or so.LocationCode=:P734_LOCATION)
                   And (:P734_PANEL Is Null Or so.Panel=:P734_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                 Order By so.SalesOrderDate Desc,so.SalesOrderNo Desc
                ```
            nullDisplayValue: - Select Sales Order -
        }
        cascadingLov {
            parentItems: [
                P734_FROMDATE
                P734_TODATE
                P734_COMPANY
                P734_LOCATION
                P734_PANEL
            ]
            itemsToSubmit: [
                P734_FROMDATE
                P734_TODATE
                P734_COMPANY
                P734_LOCATION
                P734_PANEL
            ]
        }
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 5
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P734_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    button apply-filters (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 6
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-search
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-filters (
        buttonName: RESETFILTERS
        label: Reset
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 734
                clearCache: 734
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

