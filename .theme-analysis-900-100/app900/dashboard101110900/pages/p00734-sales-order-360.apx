    region kpis (
        name: Order Position
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With O As (
                  Select so.TNo,so.SalesOrderAmount,
                         (Select Sum(d.Quantity1) From SalesOrderDetail d Where d.TNo=so.TNo) OrderQty,
                         (Select Sum(d.Quantity1) From DespatchAdvice da Join DespatchAdviceDetail d On d.TNo=da.TNo Where da.SalesOrderTNo=so.TNo Or Exists (Select 1 From DespatchAdviceDetail dx Where dx.TNo=da.TNo And dx.ReferenceTNo=so.TNo)) DispatchQty,
                         (Select Sum(d.Quantity1) From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo Where ci.SalesOrderTNo=so.TNo Or d.ReferenceTNo=so.TNo) InvoiceQty,
                         (Select Count(*) From DespatchAdvice da Where da.SalesOrderTNo=so.TNo Or Exists (Select 1 From DespatchAdviceDetail dx Where dx.TNo=da.TNo And dx.ReferenceTNo=so.TNo)) Dispatches,
                         (Select Count(*) From CCInvoice ci Where ci.SalesOrderTNo=so.TNo) Invoices
                    From SalesOrder so
                   Where so.TNo=:P734_SOTNO
                     And so.SalesOrderDate Between to_date(:P734_FROMDATE,'DD-MM-RRRR') And to_date(:P734_TODATE,'DD-MM-RRRR')
                     And (:P734_COMPANY Is Null Or so.CompanyCode=:P734_COMPANY)
                     And (:P734_LOCATION Is Null Or so.LocationCode=:P734_LOCATION)
                     And (:P734_PANEL Is Null Or so.Panel=:P734_PANEL)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual)))
                Select Case x.Seq
                  When 1 Then '<div class="ds-kpi ds-kpi--value"><span class="ds-kpi-ic"><span class="fa fa-inr"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Order Value</span><span class="ds-kpi-n">&#8377; '||to_char(Nvl(o.SalesOrderAmount,0)/1e7,'FM999G990D00')||' Cr</span><span class="ds-kpi-sub">Booked value</span></span></div>'
                  When 2 Then '<div class="ds-kpi ds-kpi--bill"><span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Ordered Quantity</span><span class="ds-kpi-n">'||to_char(Nvl(o.OrderQty,0),'FM999G999G990D000')||'</span><span class="ds-kpi-sub">Across all order lines</span></span></div>'
                  When 3 Then '<div class="ds-kpi ds-kpi--ok"><span class="ds-kpi-ic"><span class="fa fa-truck"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Dispatched Quantity</span><span class="ds-kpi-n">'||to_char(Nvl(o.DispatchQty,0),'FM999G999G990D000')||'</span><span class="ds-kpi-sub">'||to_char(Nvl(o.Dispatches,0))||' dispatch advices</span></span></div>'
                  Else '<div class="ds-kpi ds-kpi--risk"><span class="ds-kpi-ic"><span class="fa fa-hourglass-half"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Balance Quantity</span><span class="ds-kpi-n">'||to_char(Greatest(Nvl(o.OrderQty,0)-Nvl(o.InvoiceQty,0),0),'FM999G999G990D000')||'</span><span class="ds-kpi-sub">'||to_char(Nvl(o.Invoices,0))||' CC invoices</span></span></div>' End Card
                From O o Cross Join (Select Level Seq From dual Connect By Level<=4) x
                Order By x.Seq
                ```
            pageItemsToSubmit: [
                P734_SOTNO
                P734_FROMDATE
                P734_TODATE
                P734_COMPANY
                P734_LOCATION
                P734_PANEL
            ]
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                ds-kpiwrap--4up
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Select a Sales Order and apply the filters.
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region lifecycle (
        name: Dispatch, Gate, Weighment &amp; Invoice Trace
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select da.DespatchAdviceNo,da.DespatchAdviceDate,
                       Case When da.VehicleNo Is Not Null Then '<a href="'||apex_page.get_url(p_page=>732,p_clear_cache=>'732',p_items=>'P732_VEHICLE',p_values=>da.VehicleNo)||'">'||apex_escape.html(da.VehicleNo)||'</a>' End Vehicle,
                       mo.GateInTime,mo.GateOutTime,w.WeighmentNo,w.FirstWeight,w.SecondWeight,Nvl(w.NetWeight,Abs(w.SecondWeight-w.FirstWeight)) NetWeight,
                       ci.CCInvoiceNo,ci.CCInvoiceDate,ci.CCInvoiceAmount,
                       Case When e.IRN Is Not Null Then 'IRN generated' When ci.TNo Is Not Null Then 'IRN pending' End EInvoiceStatus
                  From SalesOrder so
                  Left Join DespatchAdvice da On da.SalesOrderTNo=so.TNo Or Exists (Select 1 From DespatchAdviceDetail dx Where dx.TNo=da.TNo And dx.ReferenceTNo=so.TNo)
                  Left Join MaterialOut mo On mo.ReferenceTNo=da.TNo
                  Left Join Weighment w On w.ReferenceTNo=da.TNo
                  Left Join CCInvoice ci On ci.SalesOrderTNo=so.TNo And (ci.DespatchAdviceTNo=da.TNo Or da.TNo Is Null)
                  Left Join EInvoice e On e.CCInvoiceTNo=ci.TNo
                 Where so.TNo=:P734_SOTNO
                   And so.SalesOrderDate Between to_date(:P734_FROMDATE,'DD-MM-RRRR') And to_date(:P734_TODATE,'DD-MM-RRRR')
                   And (:P734_COMPANY Is Null Or so.CompanyCode=:P734_COMPANY)
                   And (:P734_LOCATION Is Null Or so.LocationCode=:P734_LOCATION)
                   And (:P734_PANEL Is Null Or so.Panel=:P734_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                 Order By da.DespatchAdviceDate,ci.CCInvoiceDate
                ```
            pageItemsToSubmit: [
                P734_SOTNO
                P734_FROMDATE
                P734_TODATE
                P734_COMPANY
                P734_LOCATION
                P734_PANEL
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: p734Lifecycle
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No downstream documents found for this order.
        }
        advanced {
            savedReportMappingIdentifier: 52088162295084043
        }

