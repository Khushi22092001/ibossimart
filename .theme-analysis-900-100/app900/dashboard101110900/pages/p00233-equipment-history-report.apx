page 233 (
    name: Equipment History Report
    alias: EQUIPMENT-HISTORY-REPORT
    title: Equipment History Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region equipment-history-report (
        name: Equipment History Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    a.LOCATIONCODE,
                    a.DOCTYPECODE,
                    a.COMPANYCODE,
                    a.FINANCIALYEARCODE,
                    a.EQUIPMENTNO,
                    a.EQUIPMENTNAME,
                    a.WORKCENTRECODE,
                    a.DATEOFINSTALLATION,
                    a.EQUIPMENTID,
                    a.DRAWINGNO,
                    a.MANUFACTURERSERIALNO,
                    a.MANUFACTURERMODELNO,
                    a.LANDMARK,
                    a.WARRANTYEXPIRYDATE,
                    a.ITEMCODE,
                    a.ITEMSPECIFICATIONCODE,
                    a.EQUIPMENTTYPECODE ,
                    a.REMARK,
                    a.EQUIPMENTDATE,
                    a.ASSETNO,
                    a.USEDSTOCKTNO ,
                    a.MAINTAINEDBYCODE,
                    a.PARENTEQUIPMENTTNO,
                    a.CREATOR ,
                    a.DEPARTMENTCODE,
                    f.locationname,
                    e.itemname || ' - ' || ee.itemspecificationname as itemname ,
                    eq.Equipmenttypename,
                    rq.departmentname,
                    wc.workcentrename,
                
                
                
                    dd.RepairingRequisitionno,
                    dd.RepairingRequisitiondate,
                --    dd.remark,
                    dd.StoreInRepairingItemNo,
                    dd.StoreInRepairingItemdate,
                    dd.gatepassno,
                    dd.gatepassdate,
                    dd.grnno,
                    dd.grndate,
                    dd.partyname,
                    dd.StoreOutRepaireditemno,
                    dd.StoreOutRepaireditemdate,
                
                    ee.Masterassetno,  
                    ee.DetailAssetNo,
                    ee.purchasebillno,
                    ee.purchasebilldate ,
                 --   ee.partyname       ,
                    ee.LandingAmount,
                
                
                     ff.purchaseorderno,
                     ff.purchaseorderdate,
                --     ff.grnno,
                --     ff.grndate,
                
                
                     gg.jobbillno,
                     gg.jobbilldate,
                     gg.storeinRepairingitemtno,
                     gg.amount,
                     gg.RepairingRequisitiontno
                
                
                
                
                from 
                     Equipment a, 
                     location f, 
                     item e, 
                     itemspecification ee,
                     Equipmenttype eq,
                     department rq, 
                     workcentre wc,
                
                     --
                     
                     ((Select
                      A.tno ,
                      a.RepairingRequisitionno,
                      RepairingRequisitiondate,
                      b.Equipmenttno,
                      a.remark,
                      c.StoreInRepairingItemNo,
                      c.StoreInRepairingItemdate,
                      d.gatepassno,
                      d.gatepassdate,
                      e.Grntno,
                      e.grnno,
                      e.grndate,
                      f.partyname,
                      g.StoreOutRepaireditemno,
                      g.StoreOutRepaireditemdate
                from 
                      RepairingRequisition a,
                      RepairingRequisitionDetail b,
                      (select
                			a.repairingRequisitiontno ,
                			a.StoreInRepairingItemNo,
                			a.StoreInRepairingItemdate
                	   from StoreinRepairingitem a,StoreinRepairingItemdetail b
                	   where
                			a.tno = b.tno 
                			and a.repairingRequisitiontno = :tno1
                			and b.Equipmenttno = :Equipmenttno
                                                                ) c,
                       (	Select
                  	   b.repairingRequisitiontno ,
                  	   a.gatepassno,
                  	   a.gatepassdate
                  	   from 
                  		GatePass a, StoreinRepairingitem b, gatepassequipmentdetail c
                  	   where
                  		a.StoreinRepairingItemTno = b.tno 
                  		and a.tno = c.tno 
                  		and b.repairingRequisitiontno  = :Tno1
                  		and c.Equipmenttno = :Equipmenttno
                  	                                        ) d ,
                        (
                        	Select
                	   c.repairingRequisitiontno,
                       a.Tno as Grntno,
                	   a.grnno,
                	   a.grndate
                	from 
                		grn a, GatePass b, StoreinRepairingitem c, grnequipmentdetail d
                	where
                		a.gatepasstno = b.tno 
                		and b.StoreinRepairingItemTno = c.tno 
                		and a.tno = d.tno 
                		and c.repairingRequisitiontno  = :Tno1
                		and d.Equipmenttno = :Equipmenttno
                        ) e ,
                        (
                        	Select
                	   a.tno ,
                	   a.grnno,
                	   a.grndate,
                	   g.partyname,
                       c.repairingRequisitiontno
                	from 
                		grn a, GatePass b, StoreinRepairingitem c, grnequipmentdetail d, party g
                	where
                		a.gatepasstno = b.tno 
                		and b.StoreinRepairingItemTno = c.tno 
                		and a.tno = d.tno 
                		and b.partycode = g.partycode
                		and c.repairingRequisitiontno  = :Tno1
                		and d.Equipmenttno = :Equipmenttno
                	
                        ) f,
                        (
                        	select
                			a.tno ,
                            b.repairingRequisitiontno,
                			a.StoreOutRepaireditemno,
                			a.StoreOutRepaireditemdate
                	from StoreOutRepaireditem a,StoreOutRepaireditemdetail b
                	where
                			a.tno = b.tno 
                			and b.repairingRequisitiontno = :tno1
                			and b.Equipmenttno = :Equipmenttno
                        ) g
                       where
                       a.tno = b.tno
                       and a.Tno = c.repairingRequisitiontno(+)
                       and a.Tno = d.repairingRequisitiontno(+)
                       and a.Tno = e.repairingRequisitiontno(+)
                       and a.Tno = f.repairingRequisitiontno(+))) dd
                
                       --
                       ,
                       
                       ( select 
                       a.assetno as Masterassetno,  
                       bb.Assetno as DetailAssetNo,
                       e.grntno ,
                       f.purchasebillno,
                       f.purchasebilldate ,
                       g.partyname       ,
                       f.tno as purchasebilltno,
                       b.amount as LandingAmount
                from 
                       asset a,
                       Assetdetail b , 
                       AssetCodeDetail bb, 
                       issue c , 
                       issuestockdetail d , 
                       stock e, 
                       Purchasebill f,
                       Purchasebillgrndetail ff,
                       Party g
                where
                       a.tno = b.tno 
                       and b.tno = bb.tno 
                       and b.issuetno = c.tno
                       and c.tno = d.tno 
                       and d.stocktno = e.tno 
                       and f.tno = ff.tno 
                       and e.grntno = ff.grntno 
                       and f.partycode = g.partycode ) ee,
                
                --       
                       
                     (Select
                     a.purchaseorderno,
                     a.purchaseorderdate,
                     b.tno as PBTno,
                     g.Tno as Grntno,
                     g.grnno,
                     g.grndate
                from 
                      Purchaseorder a, purchasebilldetail b,GRN g
                 where
                      b.purchaseordertno = a.tno 
                      and g.purchaseordertno = a.tno) ff,
                
                --
                
                    (select
                     a.tno,
                     a.jobbillno,
                     a.jobbilldate,
                     b.equipmenttno,
                     b.storeinRepairingitemtno,
                     b.amount,
                     c.RepairingRequisitiontno
                from 
                     Jobbill a, jobbillequipmentdetail  b , storeinrepairingitem c
                where
                     a.tno = b.tno 
                    and b.storeinrepairingitemtno = c.tno  ) gg
                       
                       
                --       
                --       
                      
                where
                     a.locationcode = f.locationcode 
                     and a.itemcode = e.itemcode
                     and a.itemspecificationcode = ee.itemspecificationcode
                     and a.equipmenttypecode = eq.equipmenttypecode
                     and a.departmentcode = rq.departmentcode(+)
                     and a.workcentrecode = wc.workcentrecode(+)
                     and a.tno = dd.EquipmentTno(+)
                     and dd.Grntno = ee.GrnTno(+)
                     and dd.GrnTno = ff.GrnTno(+)
                     and a.tno = gg.EquipmentTno(+)
                 --   and a.CompanyCode = :p_CompanyCode
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 21819271905257235
        }

