    pageItem P233_EQUIPMENTNO (
        type: popupLov
        label {
            label: Equipment No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select EquipmentNo d,
                Tno r
                From 
                Equipment;
                ```
        }
        layout {
            sequence: 10
            region: @equipment-history-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

