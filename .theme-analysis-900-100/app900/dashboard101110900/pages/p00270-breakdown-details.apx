            displayColumn HMR (
                sequence: 8
            )

            displayColumn KMR (
                sequence: 7
            )

            displayColumn "SerialNo" (
                sequence: 1
            )

            sort (
                column: "SerialNo"
                sort {
                    sequence: 1
                }
            )

            aggregate (
                function: count
                column: "SerialNo"
            )

        )

    )

    pageItem P270_EQUIPMENTCATEGORY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Category
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: staticValues
            staticValues: STATIC:Equipment Log Book;EQUIPMENTLOGBOOK,Vehicle Log Book;VEHICLELOGBOOK
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @breakdown-detail
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Equipment Category
        }
    )

    pageItem P270_GROUPCODE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Group
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select initcap(EquipmentGroupName) D,
                EquipmentGroupCode R
                From 
                EquipmentGroup;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @breakdown-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Equipment Group
        }
    )

    pageItem P270_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'EQUIPMENTLOGBOOK'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order By 1
                ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @breakdown-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Location Name
        }
    )

    pageItem P270_ONDATE (
        type: datePicker
        label {
            label: On Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @breakdown-detail
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select On Date
        }
