page 270 (
    name: Breakdown Details
    alias: BREAKDOWN-DETAILS
    title: Breakdown Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breakdown-detail (
        name: Breakdown Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                Rownum as "SerialNo",
                c.EquipmentId as "Door No",
                To_Char(a.BreakDownInTime,'HH:MM:SS') as "BreakDown In Time",
                a.BreakDownInTime as "BreakDown In Date",
                To_Char(a.BreakDownOutTime,'HH:MM:SS') as "BreakDown Out Time",
                a.BreakDownOutTime as "BreakDown Out Date",
                b.OpeningMeterReading as "KMR",
                b.OpeningWorkingHrs as "HMR",
                initcap(a.BreakDownDetail) as "Complaint",
                initcap(a.ActionTaken) as "Action",
                b.EquipmentLogBookDate,
                d.EquipmentGroupCode
                From EquipmentLogBookBreakDown a,EquipmentLogBook b, Equipment c , EquipmentGroup d
                Where a.tno = b.Tno (+)
                and  b.EquipmentTno = c.Tno(+)
                and c.EquipmentGroupCode = d.EquipmentGroupCode(+)
                and a.BreakDownInTime is not null
                and b.EquipmentLogBookDate <= :P270_ONDATE
                and :P270_EQUIPMENTCATEGORY = 'EQUIPMENTLOGBOOK'
                and (:P270_GROUPCODE IS NULL OR instr(':'||:P270_GROUPCODE||':',':'||d.EquipmentGroupCode||':') > 0)
                and (:P268_LOCATION IS NULL OR instr(':'||:P268_LOCATION||':',':'||b.LocationCode||':') > 0)
                
                Union All
                
                
                Select 
                Rownum as "SerialNo",
                c.EquipmentId as "Door No",
                To_Char(a.BreakDownInTime,'HH:MM:SS') as "BreakDown In Time",
                a.BreakDownInTime as "BreakDown In Date",
                To_Char(a.BreakDownOutTime,'HH:MM:SS') as "BreakDown Out Time",
                a.BreakDownOutTime as "BreakDown Out Date",
                b.OpeningMeterReading as "KMR",
                b.OpeningWorkingHrs as "HMR",
                a.BreakDownDetail as "Complaint",
                a.ActionTaken as "Action",
                b.VehicleLogBookDate,
                d.EquipmentGroupCode
                From VehicleLogBookBreakDownDetail a,VehicleLogBook b, Equipment c , EquipmentGroup d
                Where a.tno = b.Tno (+)
                and  b.EquipmentTno = c.Tno(+)
                and c.EquipmentGroupCode = d.EquipmentGroupCode(+)
                and a.BreakDownInTime is not null
                and b.VehicleLogBookDate <= :P270_ONDATE
                and (:P268_LOCATION IS NULL OR instr(':'||:P268_LOCATION||':',':'||b.LocationCode||':') > 0)
                and (:P270_GROUPCODE IS NULL OR instr(':'||:P270_GROUPCODE||':',':'||d.EquipmentGroupCode||':') > 0)
                and :P270_EQUIPMENTCATEGORY = 'VEHICLELOGBOOK'
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 25593142414343213
        }

