        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region diesel-average-filling-to-fill (
        name: Diesel Average Filling To Fill
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region diesel-average-filling-to-fill-2 (
        name: Diesel Average Filling To Fill
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     Rownum as mysno ,
                     a.TNO ,
                     a.COMPANYCODE,
                     a.FINANCIALYEARCODE,
                     a.LOCATIONCODE,
                     a.DOCTYPECODE,
                     a.NECESSITYCOMPLETIONNO,
                     a.NECESSITYCOMPLETIONDATE,
                     b.VEHICLENO,
                     b.METERREADING,
                     b.VEHICLENECESSITYCODE,
                     round(b.Quantity1) as Quantity1,
                     b.Km,
                     Case When B.QUANTITY1 > 0 and B.METERREADING is not null THEN
                     round(B.Km /b.QUANTITY1, 2) 
                     end as AVG,
                     b.PreviousReading 
                    
                  from  necessitycompletion a,
                  ( Select
                     b.TNO as detailtno,     
                     b.VEHICLENO,
                     B.METERREADING,
                     e.VEHICLENECESSITYNAME as vehiclenecessityCode,
                     Sum(nvl(b.Quantity1,0)) Quantity1,
                     Sum(Nvl(B.METERREADING,0) - Nvl(d.METERREADING, 0)) as Km,
                     Nvl(d.METERREADING,0) as PreviousReading
                From 
                necessitycompletiondetail b , PreviousNecessityCompletion c, necessitycompletiondetail d,
                vehiclenecessity e
                where b.TNO = c.TNo(+)
                        and b.VehicleNecessityCode= c.VehicleNecessityCode(+)
                        and b.VehicleNO = c.VehicleNO(+)
                        and c.PreviousTNo = d.TNo(+)
                        and c.VehicleNecessityCode= d.VehicleNecessityCode(+)
                        and c.VehicleNO = d.VehicleNO(+)
                        and B.VEHICLENECESSITYCODE='DIESEL'
                        and b.vehiclenecessityCode = e.vehiclenecessityCode(+)
                        Group by    
                         b.TNO,     
                         b.VEHICLENO,
                         B.METERREADING,
                         e.VEHICLENECESSITYNAME,
                         d.METERREADING) b  
                Where a.Tno = b.detailTno(+) 
                      and a.CompanyCode like Nvl(:P234_COMPANYCODE,null)
                      and a.NECESSITYCOMPLETIONDATE between :P234_FROMDATE and :P234_TODATE
                --      AND ( &P_LASTFILLINGCONDITION )
                --order by a.NecessityCompletionDate,B.VEHICLENO;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
