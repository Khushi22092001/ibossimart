page 351 (
    name: Bank Balance Update Report
    alias: BANK-BALANCE-UPDATE-REPORT
    title: Bank Balance Update Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            
            
            #mystatic {
                 background-color: red;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region bank-balance-update-report (
        name: Bank Balance Update Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            htmlDomId: mystatic
            regionDisplaySelector: true
        }
    )

    region bank-balance-update-report-2 (
        name: Bank Balance Update Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  
                    row_number() over(order by BU.bOSSUSERNAME) SerialNo,
                    a.CompanyCode,
                    d.CompanyName,
                    b.BankAccountCode,
                    c.PartyName as BankAccountName,
                    to_date(:P351_ASONDATE,'DD-MM-RRRR')-1 as PreviousDate,
                    b.PreviousDayBalanceAmount,
                    GetAccountClosing(b.BankAccountCode, a.BankBalanceUpdateDate, null, a.CompanyCode) as ClosingAccountBalance,
                    b.PreviousDayBalanceAmount - abs(GetAccountClosing(b.BankAccountCode, a.BankBalanceUpdateDate, null, a.CompanyCode)) as DifferenceAmount,
                    bu.BossUserName,
                    b.Remark
                From BankBalanceUpdate a, BankBalanceUpdateDetail b, Party c, Company d, DocumentStatusDetail dsd, BossUser bu
                Where a.Tno = b.Tno(+)
                    and b.BankAccountCode = c.PartyCode(+)
                    and a.CompanyCode = d.CompanyCode(+)
                    and a.Creator = bu.LoginName(+)
                    and a.BankBalanceUpdateDate = :P351_ASONDATE
                    and a.Tno = dsd.ModuleTno
                    and dsd.DocumentStatusCode = 'ACTIVE'
                    and (:P351_COMPANY is Null Or Instr (':' || :P351_COMPANY || ':' , ':' || a.CompanyCode|| ':') > 0)
                    and (:P351_USER is Null Or Instr (':' || :P351_USER || ':' , ':' ||bu.BossUserCode|| ':') > 0)
                    and :P351_ASONDATE is not null
                    
                UNION ALL
                Select
                      row_number() over(order by a.PartyName) SerialNo,
                    b.CompanyCode,
                    c.CompanyName,
                    a.PartyCode as BankAccountCode,
                    a.PartyName as BankAccountName,
                    to_date(:P351_ASONDATE,'DD-MM-RRRR')-1 as PreviousDate,
                    null  as PreviousDayBalanceAmount,
                    abs(GetAccountClosing(a.PartyCode, :P351_ASONDATE, null, b.CompanyCode)) as ClosingAccountBalance,
                    GetAccountClosing(a.PartyCode, :P351_ASONDATE, null, b.CompanyCode) as DifferenceAmount,
                    bu.BossUserName,
                    null as Remark
                From Party a, PartyCompany b, Company c, DocumentStatusDetail dsd, BossUser bu
                Where a.Tno = b.Tno(+)
                    and b.CompanyCode = c.CompanyCode
                    and b.CompanyCode is not null
                    and a.PartyTypeCode = 'BANK'
                    and a.Tno = dsd.ModuleTno
                    and dsd.DocumentStatusCode = 'ACTIVE'
                    and a.ResponsibleBossUserCode is not null
                    and a.ResponsibleBossUserCode = bu.BossUserCode(+)
                    and not exists(
                        Select
                            aa.Tno
                        From BankBalanceUpdateDetail aa
                        Where aa.BankAccountCode = a.PartyCode
                        )
                    and (:P351_COMPANY is Null Or Instr (':' || :P351_COMPANY || ':' , ':' || b.CompanyCode|| ':') > 0)
                    and (:P351_USER is Null Or Instr (':' || :P351_USER || ':' , ':' ||bu.BossUserCode|| ':') > 0)
                    and :P351_ASONDATE is not null
                  
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 70949706652680144
        }

