            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EQUIPMENTID (
            type: plainText
            heading {
                heading: Equipment  ID
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column EQUIPMENTTNO (
            type: plainText
            heading {
                heading: Equipmenttno
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column LOCATIONNAME (
            type: plainText
