page 48 (
    name: Salary Sheet
    alias: SALARY-SHEET
    title: Salary Sheet
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/salarysheetnew.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P48_FROMDATE').val());
              var toDate = new Date($('#P48_TODATE').val());
            
              var reportParams = 
              '&P_COMPANY=' +  $('#P48_COMPANY').val() +
              '&P_STATUS=' +  $('#P48_STATUS').val() +
                '&P_LOCATION=' +  $('#P48_LOCATION').val() +
                '&P_FROMDATE='  +  $('#P48_FROMDATE').val() +
                '&P_TODATE='  +  $('#P48_TODATE').val() +
                '&P_ITEM=' +  $('#P48_DEPARTMENT').val() +
                '&P_EMPLOYEE=' + $('#P48_EMPLOYEE').val() +
                 '&P_DESIGNATION=' + $('#P48_DESIGNATION').val() 
                ;
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            ```
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region salary-sheet (
        name: Salary Sheet
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region salary-sheet-report (
        name: Salary Sheet Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                       row_number() over(order by a.EMPID) SerialNo,
                       A.Location,
                       A.EMPLOYEECODE,
                       A.Department,
                       A.SALARYMONTH,
                       A.EmployeeName as Employee,
                       a.EMPID  as EmployeeID,
                       A.SALARYSCHEME,
                       A.Designation,
                       A.PFACCOUNTNO,
                       A.BANKNAME,
                       A.BANKACCOUNTNO,
                
                       A.TD,
                       A.PR,
                       A.CL,
                       A.EL,
                       A.ML,
                       A.AB,
                       A.WD,
                       A.OH,
                       A.NH,
                       A.OD,
                       A.LWP,
                       A.COFF,
                       A.PL,
                       A.PD,
                       A.WOFF,
                
                       A.PAY_BASIC ,
                       A.PAY_HRA ,
                       A.PAY_MEDICAL,
                       A.PAY_CONV ,
                       A.PAY_SPL,
                       A.PAY_LTA ,
                       A.PAY_CARREIMBURSEMENT,
                       A.PAY_CEA,
                       A.PAY_HOSTEL,
                       A.PAY_MISCALL,
                       a.SOED,
                       A.PAY_CTC,
                       A.PAY_PFEMPLOYER,
                       A.PAY_PFEMPLOYEE,
                       A.PAY_ACEMPLOYER,
                       A.PAY_BONUS,
                       A.PAY_LEAVEINCASH,
                       A.PAY_ESICEMPLOYER,
                       A.PAY_ESICEMPLOYEE,
                       A.PAY_GROSSSALARY,
                       A.PAY_GROSSDEDUCTION,
                       A.PAY_NET,
                
                       A.EARNEDCTC,
                       A.EarnedBasic,
                       A.EarnedHRA,
                       A.EarnedMedical,
                       A.EarnedConv,
                       A.EarnedSpl,
                       A.EarnedLTA,
                       A.EARNEDCARREIMB,
                       A.EARNEDCEA,
                       A.EARNEDHOSTEL,
                       A.EARNEDEARNEDBONUS,
                       A.EARNEDEARNEDLEAVEINCASH,
                       A.MISCALL AS "EARNEDNISC",
                       A.GROSSEAR AS "GROSSEARNING",
                
                       A.EARNEDPFCOMPCONTRIBUTION,
                       A.EARNEDPFEMPLOYEECONTRIBUTION,
                       A.EARNEDADMINCHARGECOMPCONTRIBUTION,
                       A.EARNEDESICCOMPCONTRIBUTION,
                       A.EARNEDESICEMPLOYEECONTRIBUTION,
                       a.TEMPESICCOMP,
                       a.TEMPESICEMP,
                       A.SalAdv,
                       A.LOANDED,
                       a.RunningAdvDed,
                       A.CANTEENDED,
                       A.MOBILEBILLDED,
                       A.OTHERDED,
                       A.ITAX,
                       A.GROSSDED,
                
                       A.NetEarning,
                       
                       emp.UAN,
                       a.EARNEDOTHERINCOME,
                       a.PTAX,
                       emp.DateofJoining,
                       emp.ESICAccountNo ,
                       a.IFSCCODE,
                       a.BANKBRANCHNAME,
                
                       a.OTHours,
                       a.OTRate,
                       a.OTAmount,
                       a.EarnedGrossOT,
                       emp.StaffTypeCode,
                       15000 as FixSalarySlab,
                       A.SALARYVOUCHERNO,
                       A.SALARYVOUCHERDATE
                
                  FROM SALARYENGINEDETAIL A, DEPARTMENT DP, DESIGNATION DG, Employee emp
                where A.DEPARTMENTCODE = DP.DEPARTMENTCODE(+)
                  AND A.DESIGNATIONCODE = DG.DESIGNATIONCODE(+)
                  and a.EmployeeCode = emp.EmployeeCode(+)
                  and emp.StaffTypeCode != 'HAMAL'
                  and ( :P48_FROMDATE IS NULL OR a.SalaryFromDate between :P48_FROMDATE and :P48_TODATE)
                  and instr(':'||:P48_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P48_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P48_EMPLOYEE IS NULL OR instr(':'||:P48_EMPLOYEE||':',':'||a.EmployeeCode||':') > 0 ) 
                  and ( :P48_DEPARTMENT IS NULL OR instr(':'||:P48_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0 ) 
                  and ( :P48_DESIGNATION IS NULL OR instr(':'||:P48_DESIGNATION||':',':'||a.DesignationCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 100000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1688625695022041
        }

