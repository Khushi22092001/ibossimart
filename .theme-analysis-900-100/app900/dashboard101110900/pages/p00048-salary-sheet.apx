    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 110
            region: @salary-sheet
            slot: regionBody
            startNewRow: false
            column: 11
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button salarysheetpreview (
        buttonName: SALARYSHEETPREVIEW
        label: Salary Sheet
        layout {
            sequence: 20
            region: @salary-sheet-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-download
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button salaryslippreview (
        buttonName: SALARYSLIPPREVIEW
        label: Salary Slip
        layout {
            sequence: 30
            region: @salary-sheet-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-download
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @salarysheetpreview
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

