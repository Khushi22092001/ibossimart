page 456 (
    name: InterUnit Transfer With Amount
    alias: INTERUNIT-TRANSFER-WITH-AMOUNT
    title: InterUnit Transfer With Amount
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                rownum as SLNO,
                x.CCINVOICENO,
                x.CCINVOICEDATE,
                x.SOURCElOCATION,
                X.InvoiceAmount,
                X.InvoicevoucherNo,
                X.grnno,
                X.grndate,
                X.DestinationLocation,
                X.VOUCHERNO,
                X.AMOUNT,
                X.STATUS
                from (
                Select A.TNO,
                       A.CCINVOICENO,
                       A.CCINVOICEDATE,
                       GETLOCATIONNAME(A.LOCATIONCODE) As sOURCElOCATION,
                       A1.INVOICEAMOUNT As InvoiceAmount,
                       v1.Voucherno as Invoicevoucherno,
                       --   A.CCINVOICEAMOUNT,
                       --   Sum(B.QUANTITY1) As TransferQuantity,
                       c.grnno,
                       c.grndate,
                       GetLocationName(c.locationcode) As DestinationLocation,
                       --      c.CHALANQUANTITY1 As ReceivedQuantity,
                       V.VOUCHERNO,
                       V.AMOUNT,
                       Case
                         When V.TNO Is Null Then
                          'PENDING'
                         Else
                          'CLOSED'
                       End STATUS
                  From CCINVOICE A,
                       CCINVOICEDETAIL B,
                       INVOICE A1,
                       VOUCHER V1,
                       (Select AA.TNO GRNTNO,
                               AA.GRNDATE,
                               AA.INTERUNITTRANSFERCCINVOICETNO,
                               AA.GRNNO,
                               /* BB.ITEMCODE,
                               BB.ITEMSPECIFICATIONCODE,*/
                               Sum(BB.CHALANQUANTITY1) As CHALANQUANTITY1,
                               aa.locationcode
                          From GRN AA, GRNDETAIL BB
                         Where AA.TNO = BB.TNO
                         Group By AA.TNO,
                                  AA.GRNDATE,
                                  AA.INTERUNITTRANSFERCCINVOICETNO,
                                  AA.GRNNO,
                                  AA.GRNDATE,
                                  AA.LOCATIONCODE
                        
                        ) C,
                       (Select AA.GRNTNO, VV.TNO, VD.AMOUNT, VV.VOUCHERNO
                        
                          From INSPECTION AA, VOUCHER VV, VOUCHERDETAIL VD
                         Where AA.TNO = VV.MODULETNO
                           And VV.TNO = VD.TNO
                           And VD.AMOUNT > 0) V
                 Where A.DOCTYPECODE = 'INTERUNITTRANSFER'
                   And A.TNO = B.TNO
                   And B.TNO = C.INTERUNITTRANSFERCCINVOICETNO(+)
                      -- And B.ITEMCODE = C.ITEMCODE(+)
                      -- And B.ITEMSPECIFICATIONCODE = C.ITEMSPECIFICATIONCODE(+)
                   And C.GRNTNO = V.GRNTNO(+)
                   And A.TNO = A1.MODULETNO
                   And A1.TNO = V1.MODULETNO
                   And v1.tno Is Not Null
                  AND EXISTS ( SELECT 1 FROM VOUCHER AA WHERE AA.MODULETNO = A1.TNO)
                    -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                -- filter
                /* and a.CcInvoiceDate between :P456_FROMDATE and :P456_TODATE
                  and instr(':'||:P456_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and ( :P456_LOCATION is null or instr(':'||:P456_LOCATION||':',':'||a.LocationCode||':') > 0)
                  and ( :P456_ITEM IS NULL OR instr(':'||:P456_ITEM||':',':'||B.ItemCode||':') > 0 ) 
                  and ( :P456_ITEMSPECIFICATION IS NULL OR instr(':'||:P456_ITEMSPECIFICATION||':',':'||B.ItemSpecificationCode||':') > 0 )
                  and ( :P456_TOLOCATION is null or instr(':'||:P456_TOLOCATION||':',':'||C.LocationCode||':') > 0)
                
                */ --And B.QUANTITY1 - C.CHALANQUANTITY1 > 0
                 Group By A.TNO,
                          A.CCINVOICENO,
                          A.CCINVOICEDATE,
                          A.LOCATIONCODE,
                          c.grnno,
                          c.grndate,
                          c.locationcode,
                          c.CHALANQUANTITY1,
                          V.VOUCHERNO,
                          V.AMOUNT,
                          A.CCINVOICEAMOUNT,
                          V.TNO,
                          V1.VOUCHERNO,
                          A1.INVOICEAMOUNT
                
                ) X
                WHERE :P456_STATUS IS NULL OR X.STATUS = :P456_STATUS
                  
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 112577080471175805
        }

