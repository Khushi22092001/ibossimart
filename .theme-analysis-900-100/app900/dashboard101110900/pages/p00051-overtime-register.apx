    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @overtimeregister
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/OTREGISTER.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP51_COMPANY":"&P51_COMPANY.","_paramsP51_LOCATION":"&P51_LOCATION.","_paramsP51_FROMDATE":"&P51_FROMDATE.","_paramsP51_TODATE":"&P51_TODATE.","_paramsP51_DEPARTMENT":"&P51_DEPARTMENT.","_paramsP51_EMPLOYEE":"&P51_EMPLOYEE."}');
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

