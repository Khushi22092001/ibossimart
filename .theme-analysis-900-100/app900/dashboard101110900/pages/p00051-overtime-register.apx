    region overtime-register (
        name: Overtime Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region overtime-register-report (
        name: Overtime Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.TNo,
                      a.CompanyCode,
                      a.LocationCode,
                      GetLocationName(a.LocationCode)Location,
                      GetDepartmentName(a.DepartmentCode)Department,
                      a.OverTimeDate,
                      To_Char(a.OverTimeDate,'MON-YYYY') Month,
                      a.OverTimeNo,
                      e.EmployeeName||'  ( '||e.EmployeeID||' )' as Employee,
                      fs.ShiftName as FromShift,
                      ts.ShiftName as ToShift,
                      To_Char(FromTime,'DD-MM-YYYY HH:MI AM') FromTime,
                      To_Char(ToTime,'DD-MM-YYYY HH:MI AM') ToTime,
                      (b.OverTimeHours/3600) as OTHours,
                      b.Preference,
                      r.ReasonName
                From  OverTime a, OverTimeDetail b, Employee e, Reason r, Shift fs, Shift ts
                Where a.TNo = b.TNo
                  and b.EmployeeCode = e.EmployeeCode
                  and b.ReasonCode = r.ReasonCode(+)
                  and b.ActualShiftCode = fs.ShiftCode(+)
                  and b.OverTimeShiftCode =  ts.ShiftCode(+)
                  and instr(':'||:P51_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P51_LOCATION||':',':'||a.LocationCode||':') > 0
                  and a.OverTimeDate between :P51_FROMDATE and :P51_TODATE
                  and ( :P51_DEPARTMENT IS NULL OR instr(':'||:P51_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0 ) 
                  and ( :P51_EMPLOYEE IS NULL OR instr(':'||:P51_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                html
                excel
            ]
        }
        componentAdvanced {
            emailFromAddress: erp@pbsoil.com
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1943834412943937
        }

