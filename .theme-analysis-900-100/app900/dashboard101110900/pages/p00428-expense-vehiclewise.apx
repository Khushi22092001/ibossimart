                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column MODULEDATE (
            type: plainText
            heading {
                heading: Module Date
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: Module Name
                alignment: center
