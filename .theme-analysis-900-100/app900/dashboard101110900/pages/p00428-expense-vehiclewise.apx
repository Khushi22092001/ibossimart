page 428 (
    name: Expense Vehiclewise
    alias: EXPENSE-VEHICLEWISE
    title: Expense Vehiclewise
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region expense-vehiclewise (
        name: Expense Vehiclewise
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region expense-vehiclewise-2 (
        name: Expense Vehiclewise
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                  a.CompanyName,
                  a.LocationName,
                  a.VoucherNo,
                  a.VoucherDate,
                  a.ModuleName,
                  a.ModuleNo,
                  a.ModuleDate,
                  a.AccountName,
                  a.VehicleNo,
                  --round(abs(a.VoucherAmount),2) as VoucherAmount,
                  --round(a.AllocatedAmount,2) as AllocatedAmount,
                  a.AllocatedAmount,
                  a.DebitAmount,
                  a.CreditAmount
                From ExpenseVehiclewise a
                Where a.VoucherDate Between :P428_FROMDATE and :P428_TODATE
                and (:P428_COMPANY is Null Or Instr (':' || :P428_COMPANY || ':' , ':' ||a.CompanyName|| ':') > 0)
                and (:P428_LOCATION is Null Or Instr (':' || :P428_LOCATION || ':' , ':' ||a.locationName|| ':') > 0)
                and (:P428_ACCOUNT is Null Or Instr (':' || :P428_ACCOUNT || ':' , ':' ||a.AccountName|| ':') > 0)
                ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 35777424382417609
        }

        column ACCOUNTNAME (
            type: plainText
            heading {
                heading: Account Name
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ALLOCATEDAMOUNT (
            type: plainText
            heading {
                heading: Allocated Amount
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column COMPANYNAME (
            type: plainText
            heading {
                heading: Company Name
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column CREDITAMOUNT (
            type: plainText
            heading {
                heading: Credit Amount
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            appearance {
                formatMask: 99999999999990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column DEBITAMOUNT (
            type: plainText
            heading {
                heading: Debit Amount
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: 99999999999990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
