        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Expense Vehiclewise
        }

        savedReport 399382 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTNAME (
                sequence: 8
            )

            displayColumn ALLOCATEDAMOUNT (
                sequence: 10
            )

            displayColumn COMPANYNAME (
                sequence: 1
            )

            displayColumn CREDITAMOUNT (
                sequence: 12
            )

            displayColumn DEBITAMOUNT (
                sequence: 11
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn MODULEDATE (
                sequence: 7
            )

            displayColumn MODULENAME (
                sequence: 5
            )

            displayColumn MODULENO (
                sequence: 6
            )

            displayColumn VEHICLENO (
                sequence: 9
            )

            displayColumn VOUCHERDATE (
                sequence: 4
            )

            displayColumn VOUCHERNO (
                sequence: 3
            )

            sort (
                column: VOUCHERDATE
                sort {
                    sequence: 1
                }
            )

            sort (
                column: VOUCHERNO
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: VOUCHERAMOUNT
            )

            aggregate (
                column: ALLOCATEDAMOUNT
            )

            aggregate (
                column: DEBITAMOUNT
            )

            aggregate (
                column: CREDITAMOUNT
            )

        )

    )

    pageItem P428_ACCOUNT (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Account Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                  a.PartyName as d,
                  a.PartyName as r 
                from Party a 
                where a.PartyTypeCode != 'ACCOUNTGROUP'
                start with a.PartyCode = 'EXPENDITURES'
                connect by prior a.PartyCode = a.ParentCode 
                order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 60
            region: @expense-vehiclewise
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P428_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                a.CompanyName d,
                a.CompanyName r
                From Company a
                Order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 10
            region: @expense-vehiclewise
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P428_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @expense-vehiclewise
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P428_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.LocationName d,
                a.LocationName r
                From Location a
                where exists(
                    select 
                        aa.tno
                    from Voucher aa    
                    where aa.LocationCode = a.LocationCode
                )
                Order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 50
            region: @expense-vehiclewise
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P428_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @expense-vehiclewise
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 70
            region: @expense-vehiclewise
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

