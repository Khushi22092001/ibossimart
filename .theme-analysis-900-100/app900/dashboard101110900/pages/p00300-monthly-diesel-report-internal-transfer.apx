page 300 (
    name: Monthly Diesel Report Internal Transfer
    alias: MONTHLY-DIESEL-REPORT-INTERNAL-TRANSFER
    title: Monthly Diesel Report Internal Transfer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region monthly-diesel-report-internal-transfer (
        name: Monthly Diesel Report Internal Transfer
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                  Select 
                        a.DriverName,
                        Count(Distinct(a.InternalTransferDate)) as noofdays,
                        Count(a.DriverName) as Trips,
                        Count(a.DriverName) * d.DistanceInKM as TotalDistanceinKM,
                        Count(a.DriverName) * d.DieselForLoadedVehicle as TotalFixDiesel,
                        d.DieselForLoadedVehicle as FixAverage,
                
                        Case When Sum(Nvl(e.RunningDieselQuantity,0)) != 0  then
                        d.DistanceinKm / (Sum(e.RunningDieselQuantity)/(Count(Nvl(a.DriverName,1))))
                        else 0 end as "Actual Average",
                
                        Sum(Nvl(e.RunningDieselQuantity,0)) as ConsumptionDiesel,
                        Case When Sum(Nvl(e.RunningDieselQuantity,0)) != 0 then
                        Sum(Nvl(e.RunningDieselQuantity,0))  - (Count(Nvl(a.DriverName,1)) *
                        Nvl(d.DieselForLoadedVehicle,0)) else 0 end as "Extra Diesel",
                        a.Creator
                  from InternalTransfer a, SourceLocation b, DestinationLocation c, 
                        StandardDieselConsumption d, necessitySlip e
                  where a.SourceLocationTno = b.Tno(+)
                        and a.DestinationLocationTno = c.Tno(+)
                        and b.Tno = d.SourceLocationTno(+)
                        and c.Tno = d.DestinationLocationTno(+)
                        and a.vehicleno = e.Vehicleno (+)
                        and a.InternalTransferDate = e.NecessitySlipDate(+)
                        and a.ShiftCode = e.ShiftCode(+)
                        and a.internalTransferDate Between :P300_FROMDATE and :P300_TODATE
                        and ( :P300_COMPANY IS NULL OR instr(':'||:P300_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                        and ( :P300_VEHICLENO IS NULL OR instr(':'||:P300_VEHICLENO||':',':'||a.VehicleNo||':') > 0 )
                        and ( :P300_DRIVER IS NULL OR instr(':'||:P300_DRIVER||':',':'||a.DriverName||':') > 0 ) 
                  Group by
                        a.DriverName,
                        d.DistanceInKM,
                        d.DieselForLoadedVehicle,
                        a.Creator
                        ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 18739950804068324
        }

        column "Actual Average" (
            type: plainText
            heading {
                heading: Actual Average
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 999999999.99
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column CONSUMPTIONDIESEL (
            type: plainText
