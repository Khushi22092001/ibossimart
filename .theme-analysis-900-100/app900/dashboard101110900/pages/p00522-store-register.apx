            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region store-purchase-register-2 (
        name: Store Purchase Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                              xxx.TNo,
                              xxx.LocationName,
                              xxx.PBPassNo,
                              xxx.PBPassDate,
                              xxx.PartyName,
                              xxx.PartyBillNo,
                              xxx.PartyBillDate,
                              xxx.PurchaseOrderNo,
                              xxx.PartyAmount,
                              xxx.ItemCode,
                              xxx.Item,
                              xxx.UOM1,
                              round(xxx.Quantity1,3) as Quantity1,
                              xxx.UOM2,
                              round(xxx.Quantity2,3) as Quantity2,
                              xxx.Rate,
                              xxx.UOM,
                              round(xxx.Amount,2) as Amount,
                              xxx.CGST,
                              xxx.SGST,
                              xxx.IGST,
                              xxx.TCS,
                              xxx.DISCOUNT,
                              round(xxx.FooterAmount,2) as FooterAmount,
                            --   round((xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS)),2) as 
                              xxx.OtherAmount,
                              round(xxx.TotalAmount,2) as TotalAmount,
                              xxx.Description,
                              xxx.FreighttypeName,
                              xxx.TransporterName,
                              xxx.VehicleNo,
                              xxx.FreightAmount,
                              xxx.TDS194C,
                              xxx.TDS194Q,
                              xxx.Remark,
                              xxx.DeductionAmt,
                              xxx.FreightAdviceAmt,
                              xxx.NetFreight,
                              xxx.DebitNoteAmount,
                              nvl(round(xxx.Amount,2),0) + nvl(xxx.CGST,0) + nvl(xxx.SGST,0) + nvl(xxx.IGST,0) + nvl(xxx.OtherAmount,0)
                               - (nvl(xxx.DebitNoteAmount,0) + nvl(xxx.TDS194Q,0))as TotalAmounts,
                                xxx.PurchaseaBillQty,
                                xxx.PurchaseTotalAmount,
                                xxx.PurchaseRate,
                              Case When nvl(xxx.PurchaseTotalAmount,0) - nvl(xxx.DebitNoteAmount,0) - nvl(xxx.TDS194Q,0)  > 0 
                              then nvl(xxx.PurchaseTotalAmount,0) - nvl(xxx.DebitNoteAmount,0) - nvl(xxx.TDS194Q,0) 
                              else 0 end as TotalAmountss,
                              xxx.GRNDate
                            --   nvl(xxx.TotalAmount,0) - (nvl(xxx.DebitNoteAmount,0) + nvl(xxx.TDS194Q,0)) as TotalAmounts
                From (
                Select
                              xx.TNo,
                              xx.LocationName,
                              xx.PBPassNo,
                              xx.PBPassDate,
                              xx.PartyName,
                              xx.PartyBillNo,
                              xx.PartyBillDate,
                              xx.PurchaseOrderNo,
                              xx.PartyAmount,
                              xx.ItemCode,
                              xx.ItemName||' - '||xx.ItemSpecificationName as Item,
                              xx.UOM1,
                              xx.Quantity1,
                              xx.UOM2,
                              xx.Quantity2,
                              xx.Rate,
                              xx.RateMeasuringUnitCode as UOM,
                              xx.Amount,
                              sum(xx.CGST) CGST,
                              sum(xx.SGST) SGST,
                              sum(xx.IGST) IGST,
                              sum(xx.TCS) TCS,
                              sum(xx.OtherAmount) OtherAmount,
                              sum(xx.DISCOUNT) DISCOUNT,
                              xx.FooterAmount,
                              xx.TotalAmount,
                              xx.Description,
                              xx.FreighttypeName,
                              xx.TransporterName,
                              xx.VehicleNo,
                              xx.FreightAmount,
                              xx.TDS194C,
                              xx.TDS194Q,
                              xx.DeductionAmt,
                              xx.FreightAdviceAmt,
                              xx.Remark,
                              xx.NetFreight,
                              xx.DebitNoteAmount,
                              xx.PurchaseBillAmount,
                              xx.PurchaseaBillQty,
                              xx.PurchaseTotalAmount,
                              xx.PurchaseRate,
                              xx.GRNDate
                From (
                         Select         a.TNo,
                                       l.LocationName,
                                       a.PBPassNo,
                                       a.PBPassDate,
                                       p.PartyName,
                                       pb.PartyBillNo,
                                       pb.PartyBillDate,
                                       po.PurchaseOrderNo,
                                       pb.SUMOFAMOUNT As PartyAmount,
                                       e.ItemCode,
                                       e.ItemName,
                                       ee.ItemSpecificationName,
                                       e.MeasuringUnitCode1 As UOM1,
                                       b.Quantity1,
                                       e.MeasuringUnitCode2 As UOM2,
                                       b.Quantity2,
                                       b.Rate,
                                       b.RateMeasuringUnitCode,
                                       b.Amount,
                                       nvl(Decode(c.FooterHeadCode, '.CGST.', c.FooterValue),
                                           0) As CGST,
                                       nvl(Decode(c.FooterHeadCode, '.SGST.', c.FooterValue),
                                           0) As SGST,
                                       nvl(Decode(c.FooterHeadCode, '.IGST.', c.FooterValue),
                                           0) As IGST,
                                       nvl(Decode(c.FooterHeadCode, '.TCS.', c.FooterValue),
                                           0) As TCS,
                                       Case When c.FooterHeadCode not in ('.CGST.','.SGST.', '.IGST.','.TCS.','.DISCOUNT.') then c.FooterValue
                                        end as OtherAmount,
                                        nvl(Decode(c.FooterHeadCode, '.DISCOUNT.', c.FooterValue),
                                           0) As DISCOUNT,
                                       b.FooterAmount,
                                       b.TotalAmount,
                                       b.Description,
                                       i.FreighttypeName,
                                       h.VehicleNo,
                                       j.TransporterName,
                                        -- NVL(
                                        -- ROUND(
                                        -- (
                                        -- NVL(fd.BilledAmount,0) * NVL(b.Amount,0)
                                        -- ) /
                                        -- NULLIF(
                                        -- (
                                        -- SELECT SUM(NVL(bb.Amount,0))
                                        -- FROM PBPassDetail bb
                                        -- WHERE bb.TNo = a.TNo
                                        -- ),
                                        -- 0
                                        -- ),
                                        -- 2
                                        -- ),
                                        -- 0
                                        -- )  
                                      --  round(fd.TotalAmount,2)
                                      nvl(fd.Rate,0) * nvl(g.ReceivedQuantity1,0) as FreightAmount,--NetPayableAmount
                                        NVL(
                                        ROUND(
                                        (
                                        NVL(ff.SumOfTDSAmount,0) * NVL(b.Amount,0)
                                        ) /
                                        NULLIF(
                                        (
                                        SELECT SUM(NVL(bb.Amount,0))
                                        FROM PBPassDetail bb
                                        WHERE bb.TNo = a.TNo
                                        ),
                                        0
                                        ),
                                        2
                                        ),
                                        0
                                        ) AS TDS194C,
                                    --   ff.SumOfTDSAmount as TDS194C,
                                    --   a.SumOfTDSAmount as TDS194Q,
                                    ROUND(
                       (
                         NVL(a.SumOfTDSAmount,0) * NVL(b.Amount,0)
                       ) /
                       NULLIF(
                              (
                                SELECT SUM(NVL(bb.Amount,0))
                                FROM PBPassDetail bb
                                WHERE bb.TNo = a.TNo
                              ),
                              0
                             ),
                       2
                     ) AS TDS194Q,
                --                       ff.SumOfDeductionAmount as DeductionAmt,
                NVL(
                    ROUND(
                        (
                            NVL(ff.SumOfDeductionAmount,0) * NVL(b.Amount,0)
                        ) /
                        NULLIF(
                            (
                                SELECT SUM(NVL(bb.Amount,0))
                                FROM PBPassDetail bb
                                WHERE bb.TNo = a.TNo
                            ),
                            0
                        ),
                        2
                    ),
                    0
                ) AS DeductionAmt,
                                       h.FreightAdvanceAmount as FreightAdviceAmt,
                                       NVL(
                    ROUND(
                        (
                            NVL(ff.SumOfNetPayableAmount,0) * NVL(b.Amount,0)
                        ) /
                        NULLIF(
                            (
                                SELECT SUM(NVL(bb.Amount,0))
                                FROM PBPassDetail bb
                                WHERE bb.TNo = a.TNo
                            ),
                            0
                        ),
                        2
                    ),
                    0
                )  as NetFreight,
                                       b.Remark,
                                       dnd.TotalAmount as DebitNoteAmount,
                                                              NVL(
                    ROUND(
                        (
                            NVL(pbd.TotalAmount,0) * NVL(b.Amount,0)
                        ) /
                        NULLIF(
                            (
                                SELECT SUM(NVL(bb.Amount,0))
                                FROM PBPassDetail bb
                                WHERE bb.TNo = a.TNo
                            ),
                            0
                        ),
                        2
                    ),
                    0
                ) AS PurchaseBillAmount,
                pbd.Quantity1 as PurchaseaBillQty,
                pbd.TotalAmount as PurchaseTotalAmount,
                pbd.Rate as PurchaseRate,
                h.GRNDate
                                  From PurchaseBill       pb,
                                       PurchaseBillDetail pbd,
                                       PBPass             a,
                                       PBPassDetail       b,
                                       PBPassDetailFooter c,
                                       Location           l,
                                       Item               e,
                                       ItemSpecification  ee,
                                       Party              p,
                                       PurchaseOrder      po,
                                       PurchaseBillGRNDetail f,
                                       GRNDetail g,
                                       GRN h,
                                       Freighttype i,
                                       Transporter j,
                                       FreightAdviceDetail fd,
                                       FreightAdvice ff,
                                       DebitNote dn, 
                                       DebitNoteDetail dnd
                                 Where pb.TNo = pbd.TNo(+)
                                   And pb.TNo = a.PurchaseBillTNo(+)
                                   And a.TNo = b.TNo(+)
                                   And b.TNo = c.TNo(+)
                                   And b.SNo = c.SNo(+)
                                   And a.LocationCode = l.LocationCode(+)
                                   And b.PurchaseOrderTNo = po.TNo(+)
                                   And pbd.ItemCode = b.ItemCode(+)
                                   And pbd.ItemSpecificationCode = b.ItemSpecificationCode(+)
                                   And b.ItemCode = e.ItemCode(+)
                                   And b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                                   And pb.PartyCode = p.PartyCode(+)
                                   And pbd.Tno = f.Tno(+)
                                   and pbd.SNo = f.SNo(+)
                                   And f.GRNTno = g.Tno(+)
                                   And f.GRNSno = g.Sno(+)
                                   And g.Tno = h.Tno(+)
                                   And h.FreighttypeCode = i.FreighttypeCode(+)
                                   and h.TransporterCode = j.TransporterCode(+)
                                   and h.Tno = fd.ModuleTno(+)
                                   and fd.Tno = ff.Tno(+)
                                   and a.Tno = dn.ReferenceModuleTno(+)
                                   and dn.Tno = dnd.Tno(+)
                                   And b.ItemCode = dnd.ItemCode(+)
                                   And b.ItemSpecificationCode = dnd.ItemSpecificationCode(+)
                                   ------ADD ON 25-07-2026 DUE TO QUANTITY UNMATCHED
                                   And pbd.Quantity1 = b.Quantity1(+)
                                   and po.DoctypeCode in ('URGENT','REVENUE')
                -- --            -- 22-APR-2025
                          and ( :P522_COMPANY IS NULL OR instr(':'||:P522_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                          and ( :P522_LOCATION IS NULL OR instr(':'||:P522_LOCATION||':',':'||a.LocationCode||':') > 0 )
                          and h.GRNDate between :P522_FROMDATE and :P522_TODATE
                          and ( :P522_PARTYNAME IS NULL OR instr(':'||:P522_PARTYNAME||':',':'||pb.PartyCode||':') > 0 )
                          and ( :P522_ITEM IS NULL OR instr(':'||:P522_ITEM||':',':'||e.ItemCode||':') > 0 )
                          and ( :P522_ITEMSPECIFICATION IS NULL OR instr(':'||:P522_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                -- --            -- 22-APR-2025
                          and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                 )xx
                Group By 
                              xx.TNo,
                              xx.LocationName,
                              xx.PBPassNo,
                              xx.PBPassDate,
                              xx.PartyName,
                              xx.PartyBillNo,
                              xx.PartyBillDate,
                              xx.PurchaseOrderNo,
                              xx.PartyAmount,
                              xx.ItemCode,
                              xx.ItemName||' - '||xx.ItemSpecificationName,
                              xx.UOM1,
                              xx.Quantity1,
                              xx.UOM2,
                              xx.Quantity2,
                              xx.Rate,
                              xx.RateMeasuringUnitCode,
                              xx.Amount,
                              xx.FooterAmount,
                              xx.TotalAmount,
                              xx.Description,
                              xx.FreighttypeName,
                              xx.VehicleNo,
                              xx.TransporterName,
                              xx.FreightAmount,
                              xx.TDS194C,
                              xx.Remark,
                              xx.TDS194Q,
                              xx.DeductionAmt,
                              xx.FreightAdviceAmt,
                              xx.NetFreight,
                              xx.DebitNoteAmount,
                              xx.PurchaseBillAmount,
                              xx.PurchaseaBillQty,
                              xx.PurchaseTotalAmount,
                              xx.PurchaseRate,
                              xx.GRNDate
                )xxx              
                
                ```
        }
