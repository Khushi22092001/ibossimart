page 352 (
    name: Empty Vehicle Placement
    alias: EMPTY-VEHICLE-PLACEMENT
    title: Empty Vehicle Placement
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region empty-vehicle-placement (
        name: "Empty Vehicle PLacement "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region empty-vehicle-placement-report (
        name: Empty Vehicle Placement Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                row_number() over(order by a.EmptyVehiclePlacementDate) SerialNo,
                g.CompanyName,
                a.EmptyVehiclePlacementNo,
                a.EmptyVehiclePlacementDate,
                a.VehicleNo,
                a.DriverName ||'  -  '|| em.EmployeeId as DriverName,
                d.LocationName,
                b.SourceLocationName,
                c.DestinationLocationName,
                f.LRNo,
                a.Remark
                from EmptyVehiclePlacement a, SourceLocation b, DestinationLocation c, Location d, Route e, LR f, Company g, 
                Employee em
                Where a.SourceLocationTno = b.Tno
                and a.DestinationLocationTno = c.Tno
                and a.LocationCode = d.LocationCode(+)
                and a.RouteCode = e.RouteCode(+)
                and a.Tno = f.ModuleTno(+)
                and a.CompanyCode = g.CompanyCode
                and a.DriverCode = em.EmployeeCode(+)
                and a.EmptyVehiclePlacementDate between :P352_FROMDATE and :P352_TODATE
                and (:P352_COMPANY is Null Or Instr (':' || :P352_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P352_LOCATION is Null Or Instr (':' || :P352_LOCATION || ':' , ':' || d.LocationCode || ':') > 0)
                and (:P352_VEHICLE is Null Or Instr (':' || :P352_VEHICLE || ':' , ':' || a.VehicleNo || ':') > 0)
                and (:P352_DRIVER is Null Or Instr (':' || :P352_DRIVER || ':' , ':' || a.DriverName || ':') > 0)
                and :P352_FROMDATE IS NOT NULL;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                   
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 72483711621364718
        }

