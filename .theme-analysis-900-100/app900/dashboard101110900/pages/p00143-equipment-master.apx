                sequence: 1
            )

            displayColumn VALIDONDATE (
                sequence: 15
            )

            displayColumn VRNNO (
                sequence: 37
            )

            displayColumn WORKCENTRENAME (
                sequence: 39
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: EQUIPMENTWEIGHT
            )

            aggregate (
                column: EQUIPMENTACQUISITIONVALUE
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P143_ASONDATE (
        type: datePickerJquery
