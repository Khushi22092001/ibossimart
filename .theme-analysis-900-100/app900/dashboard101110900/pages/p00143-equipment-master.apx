        layout {
            sequence: 50
            region: @equipment-master
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 4
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: From Date
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P143_CATEGORY (
        type: popupLov
        label {
            label: Category
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            title: List of Equipment Category
            popupWidth: 450
            popupHeight: 350
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      ec.EquipmentCategoryName,
                      ec.EquipmentCategoryCode
                From  Equipment a, EquipmentCategory ec
                Where a.EquipmentCategoryCode = ec.EquipmentCategoryCode
                ```
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 90
            region: @equipment-master
            slot: regionBody
