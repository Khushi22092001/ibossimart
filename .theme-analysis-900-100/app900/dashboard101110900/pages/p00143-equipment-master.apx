page 143 (
    name: Equipment Master
    alias: EQUIPMENT-MASTER
    title: Equipment Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region equipment-master (
        name: Equipment Master
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region equipment-master-report (
        name: Equipment Master Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     row_number() over(order by a.tno) SerialNo,
                      a.TNo,
                      l.LocationName,
                      dt.DocTypeName,
                      GetLocationName(GetEquipmentLocationCode(a.TNo,Sysdate)) as CurrentLocation,
                      a.EquipmentNo,
                      a.EquipmentDate,
                      a.EquipmentName,
                      a.EquipmentID,
                      et.EquipmentTypeName,
                      a.AssetNo,
                      pe.EquipmentName as ComponentName,
                      ec.EquipmentCategoryName,
                      eg.EquipmentGroupName,
                      a.OldEquipmentCode,
                      a.ValidonDate,
                      a.DateofInstallation,
                      e.ItemName,
                      ee.ItemSpecificationName,
                      a.EquipmentWeight,
                      om.EmployeeName||' ( '||om.EmployeeID||' )' as OperationalManager,
                      a.EquipmentSize,
                      mm.EmployeeName||' ( '||mm.EmployeeID||' )' as MaintenanceManager,
                      a.EquipmentStartupDate,
                      ow.PartyName as Owner,
                      jo.JobOrderNo as ContractNo,
                      a.EquipmentAcquisitionValue,
                      a.EquipmentAcquisitionDate,
                      mk.ItemMakeName as MakeName,
                      c.CountryName,
                      md.ItemSizeName as ModelName,
                      a.ConstructionYear,
                      a.ManufacturerPartNo,
                      a.ManufacturerSerialNo,
                      a.Capacity,
                      a.EngineNo,
                      a.ChasisNo,
                      a.VRNNo,
                      a.DrawingNo,
                      wc.WorkCentreName,
                      ba.BusinessAreaName,
                      cc.CostCentreName,
                      dp.DepartmentName,
                      dsd.DocumentStatusCode,
                      a.Creator,
                      mic.MiningCategoryName,
                      fs.FinanceSegmentName,
                      fn.partyname as FinancierName,
                      a.EmiStartDate,
                      a.EmiEndDate,
                      a.LoanAmount,
                      a.EmiAmount
                From  Equipment a, Location l, EquipmentType et, Equipment pe, EquipmentCategory ec, EquipmentGroup eg, Item e, ItemSpecification ee,
                      Employee om, Employee mm, Party ow, JobOrder jo, ItemMake mk, Country c, ItemSize md, WorkCentre wc, BusinessArea ba, CostCentre cc,
                      Department dp, DocumentStatusDetail dsd, DocType dt, MiningCategory mic, FinanceSegment fs, Party fn
                Where a.LocationCode = l.LocationCode(+)
                  and a.EquipmentTypeCode = et.EquipmentTypeCode(+)
                  and a.DocTypeCode = dt.DocTypeCode(+)
                  and a.ParentEquipmentTNo = pe.TNo(+)
                  and a.EquipmentCategoryCode = ec.EquipmentCategoryCode(+)
                  and a.EquipmentGroupCode = eg.EquipmentGroupCode(+)
                  and a.ItemCode = e.ItemCode(+)
                  and a.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and a.OperationalManagerCode = om.EmployeeCode(+)
                  and a.MaintenanceManagerCode = mm.EmployeeCode(+)
                  and a.OwnerCode = ow.PartyCode(+)
                  and a.JobOrderTNo = jo.TNo(+)
                  and a.ManufactureMakeCode = mk.ItemMakeCode(+)
                  and a.ManufacturerCountryCode = c.CountryCode(+)
                  and a.ManufactureModelCode = md.ItemSizeCode(+)
                  and a.WorkCentreCode = wc.WorkCentreCode(+)
                  and a.BusinessAreaCode = ba.BusinessAreaCode(+)
                  and a.CostCentreCode = cc.CostCentreCode(+)
                  and a.DepartmentCode = dp.DepartmentCode(+)
                  and a.TNo = dsd.ModuleTNo(+)
                  and a.MiningCategoryCode = mic.MiningCategoryCode(+)
                  and a.FinanceSegmentCode = fs.FinanceSegmentCode(+)
                  and a.Financiercode = Fn.partycode(+)
                  --and GetEquipmentLocationCode(a.TNo,:P143_ASONDATE)like nvl(:P143_LOCATION,'%')
                  and a.EquipmentCategoryCode like nvl(:P143_CATEGORY,'%')
                  and a.EquipmentGroupCode like nvl(:P143_GROUP,'%')
                  and dt.DocTypeCode like nvl(:P143_DOCTYPE,'%')
                  --and a.OwnerCode like nvl(:P143_OWNER,'%')
                  and a.EquipmentTypeCode like nvl(:P143_EQUIPMENTTYPE,'%')
                  and instr(':'||:P143_COMPANY||':',':'||a.CompanyCode||':') > 0
                 and (:P143_LOCATION IS NULL OR instr(':'||:P143_LOCATION||':',':'||l.locationcode||':') > 0)
                 and (:P143_LOCATION IS NULL OR instr(':'||:P143_LOCATION||':',':'||GetEquipmentLocationCode(a.TNo,:P143_ASONDATE)||':') > 0)
                 and (:P143_DOCTYPE IS NULL OR instr(':'||:P143_DOCTYPE||':',':'||dt.doctypecode||':') > 0)
                  and (:P143_EQUIPMENTTYPE IS NULL OR instr(':'||:P143_EQUIPMENTTYPE||':',':'||et.equipmenttypecode||':') > 0)
                   and (:P143_OWNER IS NULL OR instr(':'||:P143_OWNER||':',':'||ow.partycode||':') > 0)
                   and (:P143_CATEGORY IS NULL OR instr(':'||:P143_CATEGORY||':',':'||ec.equipmentcategorycode||':') > 0)
                   and (:P143_GROUP IS NULL OR instr(':'||:P143_GROUP||':',':'||eg.equipmentgroupcode||':') > 0)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 10233999158099026
        }

