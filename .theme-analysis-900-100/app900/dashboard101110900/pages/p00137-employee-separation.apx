page 137 (
    name: Employee Separation
    alias: EMPLOYEE-SEPARATION
    title: Employee Separation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region employee-separation (
        name: Employee Separation
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region employee-separation-report (
        name: Employee Separation Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       row_number() over(order by a.ResignationDate) SerialNo,
                       a.CompanyCode,
                       c.CompanyName,
                       l.LocationCode,
                       l.LocationName,
                       a.DocTypeCode,
                       a.ResignationDate,
                       a.ResignationNo,
                       e.EmployeeName,
                       e.EmployeeID,
                       a.resignationacceptencedate,
                       a.reasonofresignation
                  From Resignation a, Employee e, Company c, Location l
                 Where a.EmployeeCode = e.EmployeeCode
                   And a.CompanyCode = c.CompanyCode
                   And a.LocationCode = l.LocationCode
                      --  and a.EmployeeCode = '247'
                   And a.ResignationDate Between :P137_FROMDATE And :P137_TODATE
                   And instr(':' || :P137_LOCATION || ':', ':' || a.LocationCode || ':') > 0
                   And instr(':' || :P137_COMPANY || ':', ':' || a.CompanyCode || ':') > 0
                   And ( :P137_DOCTYPE is Null or instr(':' || :P137_DOCTYPE || ':', ':' || a.DocTypeCode || ':') > 0)
                   And (:P137_EMPLOYEE Is Null Or
                       instr(':' || :P137_EMPLOYEE || ':', ':' || e.EmployeeCode || ':') > 0)
                   And (:P137_DEPARTMENT Is Null Or
                       instr(':' || :P137_DEPARTMENT || ':',
                              ':' ||
                              GetEmployeeDepartmentCode(e.EmployeeCode, :P137_FROMDATE) || ':') > 0)
                 Order By a.Resignationdate, a.Resignationno
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 12158682316078329
        }

