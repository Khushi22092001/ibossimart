        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                       d.DepartmentName d,
                       d.DepartmentCode r
                From Employee e, Department d
                Where e.DepartmentCode = d.DepartmentCode
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @employee-separation
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
