    region performance-overview (
        name: Sales vs Purchase Trend
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Ctx As (Select nvl(:GLOBAL_COMPANYCODE,(Select Min(CompanyCode) From Company)) CompanyCode From dual),
                Fy As (Select FinancialYearBegin F,Least(trunc(sysdate),FinancialYearEnd) T From FinancialYear Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd Fetch First 1 Row Only),
                X As (
                  Select h.CCInvoiceDate Dt,d.Amount Sales,0 Purch From CCInvoice h Join CCInvoiceDetail d On d.TNo=h.TNo Cross Join Ctx c Cross Join Fy f
                   Where h.CCInvoiceDate Between f.F And f.T And h.CompanyCode=c.CompanyCode And ((Select GetUserPanelAB_apex() From dual) Is Null Or h.Panel=(Select GetUserPanelAB_apex() From dual))
                  Union All
                  Select h.PurchaseBillDate,0,d.Amount From PurchaseBill h Join PurchaseBillDetail d On d.TNo=h.TNo Cross Join Ctx c Cross Join Fy f
                   Where h.PurchaseBillDate Between f.F And f.T And h.CompanyCode=c.CompanyCode And ((Select GetUserPanelAB_apex() From dual) Is Null Or h.Panel=(Select GetUserPanelAB_apex() From dual)))
                Select trunc(Dt,'MM') SortKey,to_char(trunc(Dt,'MM'),'Mon') MonthLabel,
                       round(Sum(Sales)/1e7,2) SalesCr,round(Sum(Purch)/1e7,2) PurchaseCr
                  From X Group By trunc(Dt,'MM') Order By SortKey
                ```
        }
        layout {
            sequence: 3
            slot: body
            columnSpan: 7
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                hs-home-panel
                hs-home-mainpanel
            ]
        }
        chart {
            type: line
        }
        chartLayout {
            height: 250
        }

