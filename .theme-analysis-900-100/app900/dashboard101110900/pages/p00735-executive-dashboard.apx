    region top-suppliers (
        name: Top Suppliers — Payables
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Ctx As (Select nvl(:GLOBAL_COMPANYCODE,(Select Min(CompanyCode) From Company)) CompanyCode From dual),
                Fy As (Select FinancialYearBegin F,Least(trunc(sysdate),FinancialYearEnd) T From FinancialYear Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd Fetch First 1 Row Only)
                Select '<a class="hs-home-party" href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>713,p_clear_cache=>'713',p_items=>'P713_PARTY,P713_FROMDATE,P713_TODATE,P713_COMPANY,P713_AGEBASIS',p_values=>p.PartyCode||','||to_char(f.F,'DD-MM-RRRR')||','||to_char(f.T,'DD-MM-RRRR')||','||c.CompanyCode||',DOC'))||'">'||apex_escape.html(p.PartyName)||'</a>' Supplier,
                       round(-pc.Closing/1e7,2) PayableCr
                  From PartyCurrentClosing pc Join Party p On p.PartyCode=pc.PartyCode Cross Join Ctx c Cross Join Fy f
                 Where pc.CompanyCode=c.CompanyCode And p.PartyTypeCode In ('SUPPLIER','CONTRACTOR','TRANSPORTER') And pc.Closing<0
                 Order By -pc.Closing Desc Fetch First 5 Rows Only
