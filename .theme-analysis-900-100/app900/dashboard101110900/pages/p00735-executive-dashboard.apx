    region top-customers (
        name: Top Customers — Receivables
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Ctx As (Select nvl(:GLOBAL_COMPANYCODE,(Select Min(CompanyCode) From Company)) CompanyCode From dual),
                Fy As (Select FinancialYearBegin F,Least(trunc(sysdate),FinancialYearEnd) T From FinancialYear Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd Fetch First 1 Row Only)
                Select '<a class="hs-home-party" href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>693,p_clear_cache=>'693',p_items=>'P693_PARTY,P693_FROMDATE,P693_TODATE,P693_COMPANY,P693_AGEBASIS',p_values=>p.PartyCode||','||to_char(f.F,'DD-MM-RRRR')||','||to_char(f.T,'DD-MM-RRRR')||','||c.CompanyCode||',DOC'))||'">'||apex_escape.html(p.PartyName)||'</a>' Customer,
                       round(-pc.Closing/1e7,2) ReceivableCr
                  From PartyCurrentClosing pc Join Party p On p.PartyCode=pc.PartyCode Cross Join Ctx c Cross Join Fy f
                 Where pc.CompanyCode=c.CompanyCode And p.PartyTypeCode='CUSTOMER' And pc.Closing<0
                 Order By -pc.Closing Desc Fetch First 5 Rows Only
                ```
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 4
