page 735 (
    name: Executive Dashboard
    alias: EXECUTIVE-DASHBOARD
    title: Executive Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .js-navCollapsed .t-TreeNav .a-TreeView-node--toplevel>.a-TreeView-content.is-hover .a-TreeView-label {
              visibility: visible;
              left: 48px;
              padding: 0 16px;
              width: auto;
              background-color: #0459a1; /* This would be your primary color*/
            }
            .apex-side-nav.js-navCollapsed .t-Body-nav
            , .apex-side-nav.js-navCollapsed .t-Body-nav .t-TreeNav {
                z-index: auto; /* Make it appear on top of the page content*/
            }
            
            //.m-10::before {
            //    content: url(#APP_IMAGES#logo_Infomatics18X18.png);
            //}
            
            .cards {
            //width:300px ;
            //height:10px ;
            border:none !important;
            padding:none !important;
            --a-cv-icon-padding:none !important;
            --a-cv-body-padding-x: none !important;
            --a-cv-body-padding-y: none !important;
            --a-cv-title-padding-x: none !important;
            --a-cv-title-padding-y: none !important;
              --a-cv-title-font-size: 1.25rem;
              --a-cv-title-line-height: 1rem !important;
              --a-cv-title-align-text: center !important; 
            }
            
            .mycard {
            grid-column:10 !important;
            
            }
            
            :root {
              --a-cv-item-width: 90px;
              --a-cv-item-height:50px;
              --a-cv-item-border:none !important;
              
              
            }
            .div.a-CardView.selected {
              box-shadow: 0 0 rgb(0 0 0 / 0.1), 0 0, 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
              border-color: #2e5afd;
            }
            
            div.a-CardView.selected img.a-CardView-mediaImg {
              opacity: 0 !important;
            }
            
            .custom_cards {
            
              height:90px;
              border: none;
            }
            
            .t-CardsRegion--styleA .has-icon--top {
              --a-cv-container-border:none !important;
              --a-cv-icon-container-size: 2rem !important;
              --a-cv-icon-size: 2rem !important;
              --a-cv-icon-border-radius: 0rem !important;
              --a-cv-icon-image-size: 4rem !important;
              --a-cv-icon-image-border-radius: var(--a-cv-icon-border-radius);
              --a-cv-initials-border-radius: var(--a-cv-icon-border-radius);
              --a-cv-initials-size: var(--a-cv-icon-container-size);
              --a-cv-initials-font-size: 1.5rem;
              --ut-cardlist-box-shadow: 0 !important;
              --ut-cardlist-box-border:none !important;
              --ut-region-border-width: 0px !important;
            }
            
            
            .t-CardsRegion--styleA .a-CardView-items--row .t-CardsRegion--styleA .a-CardView-actions {
              flex-direction: column;
              align-items: flex-end;
              grid-column: 8 !important;
              grid-row-start: 1;
              grid-row-end: 4;
            }
            .t-CardsRegion--styleA .a-CardView-items--row .a-CardView-media {
              margin-block-start: var(--a-cv-media-padding-y);
              margin-block-end: var(--a-cv-media-padding-y);
              margin-inline-end: 0;
            }
            .u-RTL .t-CardsRegion--styleA .a-CardView-items--row .a-CardView-media {
              margin-inline-end: var(--a-cv-media-padding-x);
              margin-inline-start: 0;
            }
            
            
            // Interactive Report
            .a-IRR-header{
                background-color: #da1b1b !important;
                font-size: 20px;
                font-family:Arial;
                font-weight: bold;
            }
            
            .a-IRR-headerLink{
                color: white;
                 font-size: 20px;
                font-family: Arial;
                font-weight: bold;
            }
            
            .a-IRR-table td{
                border-color: black;
                font-size: 18px;
                font-family: Arial;
            }
            
            /* Executive home dashboard — page scoped, no global theme changes. */
            body:has(.hs-home-root) .t-Body-contentInner{padding:18px 20px 28px;background:#f5f7fb;}
            .hs-home-root{position:relative;overflow:hidden;padding:22px 24px;border:1px solid #dfe6f1;border-radius:18px;
              background:linear-gradient(125deg,#fff 0%,#f7faff 58%,#eef8f5 100%);box-shadow:0 8px 28px rgba(24,45,84,.08);}
            .hs-home-root::after{content:"";position:absolute;right:-55px;top:-85px;width:280px;height:280px;border-radius:50%;
              background:radial-gradient(circle,rgba(59,130,246,.14),transparent 68%);pointer-events:none;}
            .hs-home-head{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:18px;}
            .hs-home-titlewrap{display:flex;align-items:center;gap:14px;min-width:0;}
            .hs-home-mark{display:grid;place-items:center;width:52px;height:52px;flex:0 0 auto;border-radius:15px;color:#fff;
              background:linear-gradient(145deg,#2563eb,#0f766e);box-shadow:0 8px 18px rgba(37,99,235,.23);font-size:22px;}
            .hs-home-eyebrow{display:block;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:#0f766e;}
            .hs-home-title{display:block;margin-top:2px;font-size:25px;line-height:1.15;font-weight:800;color:#14213d;}
            .hs-home-sub{display:block;margin-top:5px;font-size:12.5px;color:#65708a;}
            .hs-home-context{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:7px;max-width:52%;}
            .hs-home-chip{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid #dbe5f3;border-radius:999px;
              background:rgba(255,255,255,.88);font-size:11px;color:#53617b;white-space:nowrap;}
            .hs-home-chip b{color:#172554;}
            .hs-home-kpis .t-Report-report{width:100%;}
            .hs-home-kpis .t-Report-report thead{display:none;}
            .hs-home-kpis .t-Report-report tbody tr{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;}
            .hs-home-kpis .t-Report-report td{display:block;padding:0;border:0;background:transparent;}
            .hs-home-kpis .ds-kpi{min-height:128px;border-radius:15px;background:#fff;}
            .hs-home-kpis .ds-kpi-n{font-size:22px;}
            .hs-home-panel{border:1px solid #e0e6ef!important;border-radius:16px!important;overflow:hidden;
              box-shadow:0 5px 20px rgba(28,45,76,.06)!important;background:#fff;}
            .hs-home-panel .t-Region-header{background:#fff;border-bottom:1px solid #edf0f5;}
            .hs-home-panel .t-Region-title{font-weight:750;color:#16213e;}
            .hs-home-alert{display:flex;align-items:center;gap:10px;padding:10px 2px;color:#26334f;text-decoration:none;}
            .hs-home-alert+.hs-home-alert{border-top:1px solid #edf0f5;}
            .hs-home-alert-ic{display:grid;place-items:center;width:31px;height:31px;flex:0 0 auto;border-radius:10px;background:#fff3e8;color:#c45a0a;}
            .hs-home-alert-copy{min-width:0;flex:1;}.hs-home-alert-copy b{display:block;font-size:12px;}.hs-home-alert-copy span{font-size:10.5px;color:#78839a;}
            .hs-home-alert-n{font-size:16px;font-weight:800;color:#c2410c;font-variant-numeric:tabular-nums;}
            .hs-home-party{font-weight:700;color:#314ed8;text-decoration:none;}.hs-home-party:hover{text-decoration:underline;}
            .hs-home-shortcuts{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;}
            .hs-home-shortcut{display:flex;align-items:center;gap:9px;padding:12px;border:1px solid #e0e7f1;border-radius:13px;background:#fff;
              color:#24304c;text-decoration:none;transition:.16s ease;}
            .hs-home-shortcut:hover{transform:translateY(-2px);border-color:#7294ec;box-shadow:0 7px 18px rgba(37,99,235,.1);}
            .hs-home-shortcut .fa{display:grid;place-items:center;width:31px;height:31px;border-radius:10px;background:#edf3ff;color:#315ee7;}
            .hs-home-shortcut b{font-size:11.5px;line-height:1.25;}
            
            /* Compact executive home: keep the decision layer above the fold. */
            body:has(.hs-home-root) .t-Body-title{display:none!important;}
            body:has(.hs-home-root) .t-Body-contentInner{padding:8px 12px 18px!important;}
            body:has(.hs-home-root) .t-Body-content{min-height:calc(100vh - 52px);}
            .hs-home-root{padding:10px 14px;border-radius:14px;box-shadow:0 4px 16px rgba(24,45,84,.07);}
            .hs-home-head{gap:10px;}
            .hs-home-titlewrap{gap:10px;}
            .hs-home-mark{width:38px;height:38px;border-radius:11px;font-size:17px;box-shadow:0 5px 12px rgba(37,99,235,.18);}
            .hs-home-eyebrow{font-size:8.5px;}
            .hs-home-title{font-size:18px;line-height:1.1;}
            .hs-home-sub{margin-top:2px;font-size:10.5px;}
            .hs-home-context{gap:5px;max-width:58%;}
            .hs-home-chip{padding:5px 8px;font-size:9.5px;}
            .hs-home-kpis .t-Report-report tbody tr{gap:8px;}
            .hs-home-kpis .ds-kpi{min-height:88px;padding:11px 10px;border-radius:12px;}
            .hs-home-kpis .ds-kpi-ic{width:34px;height:34px;min-width:34px;font-size:15px;border-radius:10px;}
            .hs-home-kpis .ds-kpi-t{font-size:9.5px;}
            .hs-home-kpis .ds-kpi-n{font-size:18px;line-height:1.1;}
            .hs-home-kpis .ds-kpi-sub{font-size:9.5px;line-height:1.25;}
            .hs-home-panel{border-radius:12px!important;box-shadow:0 3px 12px rgba(28,45,76,.05)!important;}
            .hs-home-panel .t-Region-header{min-height:38px;padding-block:6px;}
            .hs-home-panel .t-Region-title{font-size:13px;}
            .hs-home-panel .t-Region-body{padding:9px 12px;}
            .hs-home-mainpanel{height:100%;min-height:330px;}
            .hs-home-mainpanel .t-Region-body{min-height:282px;}
            .hs-home-tablepanel{height:100%;min-height:286px;}
            .hs-home-tablepanel .t-Region-body{height:calc(100% - 39px);}
            .hs-home-panel .t-Report-report{font-size:10.5px;}
            .hs-home-panel .t-Report-report th,.hs-home-panel .t-Report-report td{padding:5px 7px;}
            .hs-home-alert{gap:8px;padding:6px 1px;}
            .hs-home-alert-ic{width:26px;height:26px;border-radius:8px;font-size:11px;}
            .hs-home-alert-copy b{font-size:10.5px;}.hs-home-alert-copy span{font-size:9px;}
            .hs-home-alert-n{font-size:14px;}
            .hs-home-shortcuts{gap:7px;}
            .hs-home-shortcut{padding:8px 10px;border-radius:10px;}
            .hs-home-shortcut .fa{width:26px;height:26px;border-radius:8px;font-size:11px;}
            .hs-home-shortcut b{font-size:10px;}
            body:has(.hs-home-root) .t-Body-content .t-Region{margin-bottom:8px;}
            @media(max-width:1200px){.hs-home-kpis .t-Report-report tbody tr{grid-template-columns:repeat(3,minmax(0,1fr));}.hs-home-shortcuts{grid-template-columns:repeat(3,minmax(0,1fr));}}
            @media(max-width:760px){body:has(.hs-home-root) .t-Body-contentInner{padding:10px}.hs-home-head{align-items:flex-start;flex-direction:column;}.hs-home-context{justify-content:flex-start;max-width:100%;}.hs-home-kpis .t-Report-report tbody tr{grid-template-columns:repeat(2,minmax(0,1fr));}.hs-home-shortcuts{grid-template-columns:repeat(2,minmax(0,1fr));}}
            @media(max-width:480px){.hs-home-kpis .t-Report-report tbody tr,.hs-home-shortcuts{grid-template-columns:1fr;}}
            ```
    }
    security {
        formAutoComplete: false
    }

    region attention-now (
        name: Attention Now
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Ctx As (Select nvl(:GLOBAL_COMPANYCODE,(Select Min(CompanyCode) From Company)) CompanyCode From dual),
                Fy As (Select FinancialYearBegin F,Least(trunc(sysdate),FinancialYearEnd) T From FinancialYear Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd Fetch First 1 Row Only),
                A As (
                  Select 1 Seq,'Order not dispatched' Nm,'Orders older than 7 days without dispatch' Sub,
                         (Select Count(*) From SalesOrder s Cross Join Ctx c Cross Join Fy f Where s.SalesOrderDate Between f.F And f.T And trunc(sysdate-s.SalesOrderDate)>7 And s.CompanyCode=c.CompanyCode And Not Exists(Select 1 From DespatchAdvice d Where d.SalesOrderTNo=s.TNo) And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel=(Select GetUserPanelAB_apex() From dual))) Cnt,
                         apex_page.get_url(p_page=>730,p_clear_cache=>'730',p_items=>'P730_FROMDATE,P730_TODATE,P730_COMPANY,P730_EXCEPTION_FOCUS',p_values=>to_char(f.F,'DD-MM-RRRR')||','||to_char(f.T,'DD-MM-RRRR')||','||c.CompanyCode||',Order not dispatched') Url From Ctx c Cross Join Fy f
                  Union All
                  Select 2,'Dispatch not gated','Dispatch advices older than 2 days without gate movement',
                         (Select Count(*) From DespatchAdvice d Cross Join Ctx c Cross Join Fy f Where d.DespatchAdviceDate Between f.F And f.T And trunc(sysdate-d.DespatchAdviceDate)>2 And d.CompanyCode=c.CompanyCode And Not Exists(Select 1 From MaterialOut m Where m.ReferenceTNo=d.TNo) And ((Select GetUserPanelAB_apex() From dual) Is Null Or d.Panel=(Select GetUserPanelAB_apex() From dual))),
                         apex_page.get_url(p_page=>730,p_clear_cache=>'730',p_items=>'P730_FROMDATE,P730_TODATE,P730_COMPANY,P730_EXCEPTION_FOCUS',p_values=>to_char(f.F,'DD-MM-RRRR')||','||to_char(f.T,'DD-MM-RRRR')||','||c.CompanyCode||',Dispatch not gated') From Ctx c Cross Join Fy f
                  Union All
                  Select 3,'Awaiting final weighment','First weight captured; second weight pending',
                         (Select Count(*) From Weighment w Cross Join Ctx c Where w.WeighmentDate>sysdate-30 And w.SecondWeight Is Null And w.CompanyCode=c.CompanyCode And ((Select GetUserPanelAB_apex() From dual) Is Null Or w.Panel=(Select GetUserPanelAB_apex() From dual))),
                         apex_page.get_url(p_page=>730,p_clear_cache=>'730',p_items=>'P730_FROMDATE,P730_TODATE,P730_COMPANY,P730_EXCEPTION_FOCUS',p_values=>to_char(f.F,'DD-MM-RRRR')||','||to_char(f.T,'DD-MM-RRRR')||','||c.CompanyCode||',Awaiting final weighment') From Ctx c Cross Join Fy f
                  Union All
                  Select 4,'Bills awaiting pass','Purchase bills not yet linked to PB Pass',
                         (Select Count(*) From PurchaseBill b Cross Join Ctx c Cross Join Fy f Where b.PurchaseBillDate Between f.F And f.T And b.CompanyCode=c.CompanyCode And Not Exists(Select 1 From PBPass p Where p.PurchaseBillTNo=b.TNo) And ((Select GetUserPanelAB_apex() From dual) Is Null Or b.Panel=(Select GetUserPanelAB_apex() From dual))),
                         apex_page.get_url(p_page=>668,p_clear_cache=>'668') From Ctx c Cross Join Fy f)
                Select '<a class="hs-home-alert" href="'||apex_escape.html_attribute(Url)||'">'
                    ||'<span class="hs-home-alert-ic"><span class="fa fa-exclamation-triangle"></span></span>'
                    ||'<span class="hs-home-alert-copy"><b>'||apex_escape.html(Nm)||'</b><span>'||apex_escape.html(Sub)||'</span></span>'
                    ||'<span class="hs-home-alert-n">'||to_char(Cnt,'FM999G990')||'</span></a>' ALERT
                  From A Order By Seq
                ```
        }
        layout {
            sequence: 4
            slot: body
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                hs-home-panel
                hs-home-mainpanel
            ]
        }
        advanced {
            htmlDomId: homeAlerts
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        performance {
            lazyLoading: true
        }

        column ALERT (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region companydetails (
        name: CompanyDetails
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
            cssClasses: [
                cards
                hspl-drawer
            ]
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: never
        }
    )

    region dashboard-shortcuts (
        name: Command Centre Shortcuts
        type: staticContent
        source {
            htmlCode:
                ```html
                <nav class="hs-home-shortcuts" aria-label="Executive dashboard shortcuts">
                  <a class="hs-home-shortcut" href="f?p=&APP_ID.:730:&SESSION.::NO:730"><span class="fa fa-exchange"></span><b>Sales Lifecycle</b></a>
                  <a class="hs-home-shortcut" href="f?p=&APP_ID.:653:&SESSION.::NO:653"><span class="fa fa-line-chart"></span><b>Sales Command Centre</b></a>
                  <a class="hs-home-shortcut" href="f?p=&APP_ID.:668:&SESSION.::NO:668"><span class="fa fa-shopping-cart"></span><b>Purchase Command Centre</b></a>
                  <a class="hs-home-shortcut" href="f?p=&APP_ID.:684:&SESSION.::NO:684"><span class="fa fa-cubes"></span><b>Inventory Command Centre</b></a>
                  <a class="hs-home-shortcut" href="f?p=&APP_ID.:690:&SESSION.::NO:690"><span class="fa fa-money"></span><b>Receivables Command Centre</b></a>
                  <a class="hs-home-shortcut" href="f?p=&APP_ID.:710:&SESSION.::NO:710"><span class="fa fa-credit-card"></span><b>Payables Command Centre</b></a>
                </nav>
                ```
        }
        layout {
            sequence: 8
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: hs-home-panel
        }
    )

    region executive-home-header (
        name: Executive Dashboard
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Ctx As (
                  Select nvl(:GLOBAL_COMPANYCODE,(Select Min(CompanyCode) From Company)) CompanyCode From dual),
                Fy As (
                  Select FinancialYearCode,FinancialYearBegin,FinancialYearEnd
                    From FinancialYear
                   Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   Fetch First 1 Row Only)
                Select '<div class="hs-home-root">'
                    || '<div class="hs-home-head"><div class="hs-home-titlewrap">'
                    || '<span class="hs-home-mark"><span class="fa fa-line-chart"></span></span><span>'
                    || '<span class="hs-home-eyebrow">Enterprise command view</span>'
                    || '<span class="hs-home-title">'||apex_escape.html(nvl(c.CompanyName,'HSPL'))||' Executive Dashboard</span>'
                    || '<span class="hs-home-sub">Sales, procurement, working capital, inventory and actions &mdash; one click from source dashboards.</span>'
                    || '</span></div><div class="hs-home-context">'
                    || '<span class="hs-home-chip"><span class="fa fa-building-o"></span>Company <b>'||apex_escape.html(nvl(c.CompanyName,'All'))||'</b></span>'
                    || '<span class="hs-home-chip"><span class="fa fa-calendar"></span>FY <b>'||apex_escape.html(f.FinancialYearCode)||'</b></span>'
                    || '<span class="hs-home-chip"><span class="fa fa-clock-o"></span>As at <b>'||to_char(sysdate,'DD Mon RRRR HH24:MI')||'</b></span>'
                    || '<span class="hs-home-chip"><span class="fa fa-user-o"></span><b>'||apex_escape.html(:APP_USER)||'</b></span>'
                    || '</div></div></div>' HEAD
                  From Ctx x Left Join Company c On c.CompanyCode=x.CompanyCode Cross Join Fy f
                ```
        }
        layout {
            sequence: 1
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region executive-kpis (
        name: Executive Pulse
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Ctx As (
                  Select nvl(:GLOBAL_COMPANYCODE,(Select Min(CompanyCode) From Company)) CompanyCode From dual),
                Fy As (
                  Select FinancialYearBegin F,Least(trunc(sysdate),FinancialYearEnd) T
                    From FinancialYear
                   Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   Fetch First 1 Row Only),
                Sales As (
                  Select nvl(Sum(d.Amount),0) Val
                    From CCInvoice h Join CCInvoiceDetail d On d.TNo=h.TNo Cross Join Ctx c Cross Join Fy f
                   Where h.CCInvoiceDate Between f.F And f.T And h.CompanyCode=c.CompanyCode
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or h.Panel=(Select GetUserPanelAB_apex() From dual))),
                PrevSales As (
                  Select nvl(Sum(d.Amount),0) Val
                    From CCInvoice h Join CCInvoiceDetail d On d.TNo=h.TNo Cross Join Ctx c Cross Join Fy f
                   Where h.CCInvoiceDate Between add_months(f.F,-12) And add_months(f.T,-12) And h.CompanyCode=c.CompanyCode
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or h.Panel=(Select GetUserPanelAB_apex() From dual))),
                Purch As (
                  Select nvl(Sum(d.Amount),0) Val
                    From PurchaseBill h Join PurchaseBillDetail d On d.TNo=h.TNo Cross Join Ctx c Cross Join Fy f
                   Where h.PurchaseBillDate Between f.F And f.T And h.CompanyCode=c.CompanyCode
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or h.Panel=(Select GetUserPanelAB_apex() From dual))),
                PrevPurch As (
                  Select nvl(Sum(d.Amount),0) Val
                    From PurchaseBill h Join PurchaseBillDetail d On d.TNo=h.TNo Cross Join Ctx c Cross Join Fy f
                   Where h.PurchaseBillDate Between add_months(f.F,-12) And add_months(f.T,-12) And h.CompanyCode=c.CompanyCode
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or h.Panel=(Select GetUserPanelAB_apex() From dual))),
                Ledger As (
                  Select nvl(Sum(Case When p.PartyTypeCode='CUSTOMER' And c.Closing<0 Then -c.Closing End),0) Receivable,
                         nvl(Sum(Case When p.PartyTypeCode In ('SUPPLIER','CONTRACTOR','TRANSPORTER') And c.Closing<0 Then -c.Closing End),0) Payable
                    From PartyCurrentClosing c Join Party p On p.PartyCode=c.PartyCode Cross Join Ctx x
                   Where c.CompanyCode=x.CompanyCode),
                UsedQty As (
                  Select u.StockTNo,Sum(u.UsedStockQuantity1) Used
                    From UsedStock u Where u.UsedStockDate<=trunc(sysdate) Group By u.StockTNo),
                Inventory As (
                  Select nvl(Sum((s.StockQuantity1-nvl(u.Used,0))*nvl(s.Rate,0)),0) Val
                    From Stock s Left Join UsedQty u On u.StockTNo=s.TNo Cross Join Ctx c
                   Where s.StockDate<=trunc(sysdate) And s.CompanyCode=c.CompanyCode
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel=(Select GetUserPanelAB_apex() From dual))),
                Attention As (
                  Select nvl(Sum(nvl(t.PendingToApproval,0)+nvl(t.PendingToNextProcess,0)+nvl(t.Rejected,0)),0) Cnt
                    From TodoList t Where t.Creator=:APP_USER)
                Select
                  '<a class="ds-kpi ds-kpi--value" href="'||apex_page.get_url(p_page=>653,p_clear_cache=>'653')||'">'
                  ||'<span class="ds-kpi-ic"><span class="fa fa-line-chart"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">FY Sales</span><span class="ds-kpi-n">&#8377; '
                  ||to_char(s.Val/1e7,'FM999G990D00')||' Cr</span><span class="ds-kpi-sub">'
                  ||Case When ps.Val=0 Then 'No comparable prior period' Else to_char((s.Val-ps.Val)*100/abs(ps.Val),'FMS999G990D0')||'% vs same period LY' End||'</span></span></a>' KPI1,
                  '<a class="ds-kpi ds-kpi--bill" href="'||apex_page.get_url(p_page=>668,p_clear_cache=>'668')||'">'
                  ||'<span class="ds-kpi-ic"><span class="fa fa-shopping-cart"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">FY Purchases</span><span class="ds-kpi-n">&#8377; '
                  ||to_char(p.Val/1e7,'FM999G990D00')||' Cr</span><span class="ds-kpi-sub">'
                  ||Case When pp.Val=0 Then 'No comparable prior period' Else to_char((p.Val-pp.Val)*100/abs(pp.Val),'FMS999G990D0')||'% vs same period LY' End||'</span></span></a>' KPI2,
                  '<a class="ds-kpi ds-kpi--input" href="'||apex_page.get_url(p_page=>690,p_clear_cache=>'690')||'">'
                  ||'<span class="ds-kpi-ic"><span class="fa fa-money"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Receivables</span><span class="ds-kpi-n">&#8377; '
                  ||to_char(l.Receivable/1e7,'FM999G990D00')||' Cr</span><span class="ds-kpi-sub">'||to_char(100*l.Receivable/nullif(s.Val,0),'FM999G990D0')||'% of FY sales &#183; net AR less AP &#8377; '||to_char((l.Receivable-l.Payable)/1e7,'FMS999G990D00')||' Cr</span></span></a>' KPI3,
                  '<a class="ds-kpi ds-kpi--risk" href="'||apex_page.get_url(p_page=>710,p_clear_cache=>'710')||'">'
                  ||'<span class="ds-kpi-ic"><span class="fa fa-credit-card"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Payables</span><span class="ds-kpi-n">&#8377; '
                  ||to_char(l.Payable/1e7,'FM999G990D00')||' Cr</span><span class="ds-kpi-sub">'||to_char(100*l.Payable/nullif(p.Val,0),'FM999G990D0')||'% of FY purchases</span></span></a>' KPI4,
                  '<a class="ds-kpi ds-kpi--ok" href="'||apex_page.get_url(p_page=>684,p_clear_cache=>'684')||'">'
                  ||'<span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Inventory Value</span><span class="ds-kpi-n">&#8377; '
                  ||to_char(i.Val/1e7,'FM999G990D00')||' Cr</span><span class="ds-kpi-sub">'||to_char(100*i.Val/nullif(s.Val,0),'FM999G990D0')||'% of FY sales &#183; rated closing layers</span></span></a>' KPI5,
                  '<a class="ds-kpi ds-kpi--suppl" href="#homeApprovals">'
                  ||'<span class="ds-kpi-ic"><span class="fa fa-bell-o"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">My Action Queue</span><span class="ds-kpi-n">'
                  ||to_char(a.Cnt,'FM999G990')||'</span><span class="ds-kpi-sub">Approval, next-process and rejected items</span></span></a>' KPI6
                From Sales s Cross Join PrevSales ps Cross Join Purch p Cross Join PrevPurch pp Cross Join Ledger l Cross Join Inventory i Cross Join Attention a
                ```
        }
        layout {
            sequence: 2
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: hs-home-kpis
