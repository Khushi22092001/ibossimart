                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        advanced {
            customAttributes: width="70px" , height="90px"
        }
    )

    pageItem P735_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    button refreshtodolist (
        buttonName: RefreshToDoList
        label: Refreshtodolist
        layout {
            sequence: 40
            region: @companydetails
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            plsqlExpression: 1=2
        }
    )

    dynamicAction createtodolist (
        name: Refresh Home Workflow Data After Paint
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: cREATETODOLIST(:APP_USER);
                itemsToSubmit: P735_TNO
            }
            execution {
                sequence: 10
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @my-approvals
            }
            execution {
                sequence: 20
            }
        )

        action refresh-executive-kpis (
            action: refresh
            affectedElements {
                selectionType: region
                region: @executive-kpis
            }
            execution {
                sequence: 30
            }
        )

    )

    process createtodolist (
        name: CreateToDoList
        type: executeCode
        source {
            plsqlCode: Createtodolist(:APP_USER);
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16342075342328921
        }
        serverSideCondition {
            type: never
        }
    )

    process getcompanyname (
        name: GetCompanyName
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Select 
                     c.CompanyName into :P735_COMPANYNAME
                     --c.CompanyCode into :P735_COMPANYCODE
                From BossUser a, BossUserRole b, Company c
                Where a.TNo = b.TNo
                  and b.CompanyCode = c.CompanyCode
                  and b.IsDefault = 'YES'
                  and a.BossUserName = '&APP_USER.'
                  ;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3512863963257600
        }
    )

)

