    region my-approvals (
        name: My Workflow Queue
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a class="hs-home-party" href="'||apex_escape.html_attribute(apex_util.prepare_url('f?p='||:APP_ID||':'||to_char(x.ApexPageNo)||':'||:APP_SESSION||'::NO::P'||to_char(x.ApexPageNo)||'_TODOLIST:YES'))||'">'||apex_escape.html(x.ModuleName)||'</a>' Module,
                       x.Pending,
                       x.NextStep,
                       x.Rejected
                  From (
                    Select m.ApexPageNo,Max(m.ModuleName) ModuleName,
                           Sum(nvl(t.PendingToApproval,0)) Pending,
                           Sum(nvl(t.PendingToNextProcess,0)) NextStep,
                           Sum(nvl(t.Rejected,0)) Rejected
                      From TodoList t
                      Join (Select ModuleCode,ApexPageNo,Max(ModuleName) ModuleName
                              From Module Group By ModuleCode,ApexPageNo) m
                        On m.ModuleCode=t.ModuleCode
                     Where t.Creator=:APP_USER
                     Group By m.ApexPageNo
                    Having Sum(nvl(t.PendingToApproval,0)+nvl(t.PendingToNextProcess,0)+nvl(t.Rejected,0))>0
                  ) x
                 Order By (x.Pending+x.NextStep+x.Rejected) Desc
                 Fetch First 5 Rows Only
                ```
        }
        layout {
            sequence: 7
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                hs-home-panel
                hs-home-tablepanel
            ]
        }
