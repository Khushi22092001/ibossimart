page 282 (
    name: BankGaurantyCommissionReport
    alias: BANKGAURANTYCOMMISSION
    title: BankGaurantyCommission
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bankgaurantycommission (
        name: BankGaurantyCommission
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                row_number() over(order by bgc.bankgaurantycommissiondate) SerialNo,
                locationname as location,
                doctypename as doctype,
                companyname as company,
                bgc.bankgaurantycommissionno,
                bgc.bankgaurantycommissiondate,
                bg.bankgaurantyno,
                bgc.fromdate,
                bgc.todate,
                bgc.bgcommissionpercent,
                bgc.bgcommissionamount,
                ty.transactiontypename,
                p.partyname as debitaccount,
                py.partyname as creditaccount,
                fn.footernaturename as gstcreditnature,
                nos.natureofsupplyname,
                bgc.taxpercent,
                bgc.cgstpercent,
                bgc.sgstpercent,
                bgc.igstpercent,
                bgc.cgstamount,
                bgc.sgstamount,
                bgc.igstamount,
                bgc.totalamount
                from bankgaurantycommission bgc,
                     bankgauranty bg,
                     location l,
                     doctype d,
                     company c,
                     transactiontype ty,
                     natureofsupply nos,
                     footernature fn,
                     party p,
                     party py
                where  bgc.bankgaurantytno = bg.tno(+)  
                and bgc.locationcode = l.locationcode(+)
                and bgc.doctypecode = d.doctypecode(+)
                and bgc.companycode = c.companycode(+)
                and bgc.transactiontypecode = ty.transactiontypecode(+)
                and bgc.natureofsupplycode = nos.natureofsupplycode(+)
                and bgc.footernaturecode = fn.footernaturecode(+)
                and bgc.debitaccountcode = p.partycode(+)
                and bgc.creditaccountcode = py.partycode(+)
                and bgc.bankgaurantycommissiondate between :P282_FROMDATE AND  :P282_TODATE
                --and ( :P282_DOCTYPE IS NULL OR instr(':'||:P282_DOCTYPE||':',':'||d.DocTypeCode||':') > 0 ) 
                and (:P282_COMPANY IS NULL OR instr(':'||:P282_COMPANY||':',':'||C.COMPANYcode||':') > 0)
                and (:P282_LOCATION IS NULL OR instr(':'||:P282_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P282_BANKGAURANTYNO IS NULL OR instr(':'||:P282_BANKGAURANTYNO||':',':'||BG.BANKGAURANTYNo||':') > 0 ) 
                and (:P282_COMMISSIONNO IS NULL OR instr(':'||:P282_COMMISSIONNO||':',':'||BGC.BANKGAURANTYCOMMISSIONNO||':') > 0)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 15155895956592413
        }

