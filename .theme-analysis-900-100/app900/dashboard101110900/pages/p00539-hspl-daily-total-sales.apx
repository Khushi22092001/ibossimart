page 539 (
    name: HSPL Daily Total Sales
    alias: HSPL-DAILY-TOTAL-SALES
    title: HSPL Daily Total Sales
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hspl-daily-total-sales (
        name: HSPL Daily Total Sales
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.tno,
                a.salesconfirmno,
                a.salesconfirmdate,
                a.partycode,
                getpartyname(a.partycode) as partyname,
                GetPartyName(a.AgentCode) as AgentName,
                fr.FreighttypeName,
                X.*,
                --b.itemcategoryname,
                --b.itemcategorycode,
                b.scqty,
                so.qty as soqty,
                
                da.daqty as daqty,
                da.daqty - nvl(cc.qty,0) as dabalance,
                
                da.wtqty as wtqty,
                --wt.wtqty as wtqty,
                cc.qty as ccqty,
                CASE WHEN NVL(CC.QTY,0) > 0 THEN
                     NVL(B.SCQTY,0) - NVL(cc.qty,so.qty) - NVL(da.daqty,0)
                     ELSE
                       NVL(B.SCQTY,0) - nvl(NVL(cc.qty,so.qty),0)
                END BALANCEQTY
                
                
                
                from salesconfirm a,Freighttype fr,
                (
                SELECT
                    TNO TNO1,
                
                    MAX(CASE WHEN ITEMCATEGORYCODE = 'SCP'    THEN WITHOUTDISCOUNTRATE END) AS SCP,
                    MAX(CASE WHEN ITEMCATEGORYCODE = 'BEAM'   THEN WITHOUTDISCOUNTRATE END) AS BEAM,
                    MAX(CASE WHEN ITEMCATEGORYCODE = 'LS'     THEN WITHOUTDISCOUNTRATE END) AS LS,
                    MAX(CASE WHEN ITEMCATEGORYCODE = 'FLAT'   THEN WITHOUTDISCOUNTRATE END) AS FLAT,
                    MAX(CASE WHEN ITEMCATEGORYCODE = 'MS'     THEN WITHOUTDISCOUNTRATE END) AS MS,
                    MAX(CASE WHEN ITEMCATEGORYCODE = 'STRIPS' THEN WITHOUTDISCOUNTRATE END) AS STRIPS,
                    MAX(CASE WHEN ITEMCATEGORYCODE = 'PIPES'  THEN WITHOUTDISCOUNTRATE END) AS PIPES,
                    MAX(CASE WHEN ITEMCATEGORYCODE = 'BP'     THEN WITHOUTDISCOUNTRATE END) AS BP,
                    MAX(CASE WHEN ITEMCATEGORYCODE NOT IN ('BP','SCP','BEAM','LS','FLAT','MS','STRIPS','PIPES')     THEN WITHOUTDISCOUNTRATE END) AS OTHERS 
                
                FROM SALESCONFIRMDETAIL
                GROUP BY TNO
                ) X,
                     (
                      select b.tno,--b.itemcategorycode,c.itemcategoryname,
                      max(b.quantity1) scqty
                      from salesconfirmdetail b, itemcategory c
                      WHERE getdocumentstatuscode('SALESCONFIRM',B.tno)='ACTIVE'
                      and b.itemcategorycode = c.itemcategorycode
                      group by b.tno--,b.itemcategorycode,c.itemcategoryname
                     ) b,
                     (
                     select
                     aa.salesconfirmtno,sum(bb.Quantity1) qty
                     from salesorder aa, salesorderdetail bb
                     where aa.tno = bb.tno
                     and getdocumentstatuscode('SALESORDER',aa.tno)='ACTIVE'
                     --and rownum = 1
                     group by aa.salesconfirmtno
                     ) so,
                     (
                select
                     aa1.tno salesconfirmtno,sum(cc.quantity1) daqty, sum(distinct ee.netweight) wtqty
                     from salesconfirm aa1, salesorder aa, salesorderdetail bb
                     , Despatchadvicedetail cc , Despatchadvice dd, weighment ee
                     where aa1.tno = aa.salesconfirmtno
                     and aa.tno = bb.tno
                     and bb.tno = cc.referencetno
                     and bb.itemcode = cc.itemcode
                     and bb.itemspecificationcode = cc.itemspecificationcode
                     and bb.itemlengthcode = cc.itemlengthcode
                     and cc.tno = dd.tno
                     and dd.tno=ee.referencetno(+)
                     and getdocumentstatuscode('DESPATCHADVICE',DD.tno)='ACTIVE'
                     AND NOT EXISTS ( SELECT 1 FROM CCINVOICE XX WHERE XX.DESPATCHADVICETNO=DD.TNO)
                    -- and aa1.tno = 104992071
                     group by aa1.tno
                
                     ) da,
                    /* (
                     select
                     dd.tno,ee.netweight wtqty,sum(ee.netweight)
                     from Despatchadvice dd,weighment ee, salesorder
                     where dd.tno = ee.referencetno
                     group by dd.tno,ee.netweight
                
                     ) wt,
                     */
                     (
                     select aa1.tno salesconfirmtno,sum(cc.quantity1) qty
                     from salesconfirm aa1, salesorder aa
                     , salesorderdetail bb
                     , ccinvoicedetail cc
                     where aa1.tno = aa.salesconfirmtno
                     and aa.tno = bb.tno
                     and bb.tno = cc.referencetno
                     and bb.itemcode = cc.itemcode
                     and bb.itemspecificationcode = cc.itemspecificationcode
                     and bb.itemlengthcode = cc.itemlengthcode
                     and getdocumentstatuscode('CCINVOICE',CC.tno)='ACTIVE'
                     --and aa1.tno = 104992071
                     group by aa1.tno
                     ) cc,
                     DOCUMENTSTATUSDETAIL I
                where a.tno = b.tno
                  and a.FreighttypeCode = fr.FreighttypeCode(+)
                  and a.tno = so.salesconfirmtno(+)
                  and a.tno = da.salesconfirmtno(+)
                 -- and da.tno = wt.tno(+)
                  and a.tno = cc.salesconfirmtno(+)
                 -- and a.tno=104792185
                 --and a.salesconfirmno='HSPL/SCF/CO/26-27/05/09/000355'
                 --and a.panel='A'
                 --and a.salesconfirmdate = '31-mar-2026'
                 AND A.TNO=X.TNO1
                 AND A.TNO = I.MODULETNO
                 and a.panel='A'
                --- FILTER
                   and  a.SalesConfirmDate between :P539_FROMDATE and :P539_TODATE
                    and ( :P539_COMPANY IS NULL OR instr(':'||:P539_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                    and ( :P539_LOCATION IS NULL OR instr(':'||:P539_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    and ( :P539_PARTY IS NULL OR instr(':'||:P539_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P539_SALESCONFIRM IS NULL OR instr(':'||:P539_SALESCONFIRM||':',':'||a.Tno||':') > 0 ) 
                    
                    and ( :P539_STATUS IS NULL OR instr(':'||:P539_STATUS||':',':'||i.DocumentStatusCode||':') > 0 )
                    AND ( :P539_ITEMCATEGORY IS NULL OR EXISTS ( SELECT 1 FROM SALESCONFIRMDETAIL AA WHERE AA.ITEMCATEGORYCODE=:P539_ITEMCATEGORY))
                
                
                
                 order by A.tno desc
                ```
            pageItemsToSubmit: [
                P539_COMPANY
                P539_FROMDATE
                P539_TODATE
                P539_LOCATION
                P539_PARTY
                P539_ITEM
                P539_ITEMCATEGORY
                P539_STATUS
                P539_SALESCONFIRM
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 28056739316111403
        }

