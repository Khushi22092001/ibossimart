    region report-2 (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    row_number() over(order by SalesConfirmDate) SerialNo,
                    SalesConfirmNo,
                    SalesConfirmDate,
                    PartyName,
                    MAX(CASE WHEN rn = 1 THEN Items END) AS Item1,
                    MAX(CASE WHEN rn = 2 THEN Items END) AS Item2,
                    MAX(CASE WHEN rn = 3 THEN Items END) AS Item3,
                    
                    MAX(CASE WHEN rn = 1 THEN BRate END) AS Rate1,
                    MAX(CASE WHEN rn = 2 THEN BRate END) AS Rate2,
                    MAX(CASE WHEN rn = 3 THEN BRate END) AS Rate3,
                    
                    MAX(CASE WHEN rn = 1 THEN Quantity1 END) AS Quantity,
                    Case When DAQuantity > 0 then DAQuantity
                    else null end as DAQuantity,
                    CCInvoiceQty,
                    nvl(MAX(CASE WHEN rn = 1 THEN Quantity1 END),0) - nvl(DAQuantity,0) - nvl(CCInvoiceQty,0) as BalanceQty
                    --nvl(MAX(CASE WHEN rn = 1 THEN Quantity1 END),0) - nvl(DAQuantity,0) - nvl(CCInvoiceQty,0) as BalanceQty
                
                FROM (
                    SELECT 
                        a.SalesConfirmNo,
                        a.SalesConfirmDate,
                        c.PartyName,
                        d.ItemCategoryName || '-' || e.ItemName AS Items,
                        b.Rate AS BRate,
                        b.Quantity1,
                        f.DAQuantity,
                        g.CCInvoiceQty,
                        ROW_NUMBER() OVER (PARTITION BY a.Tno ORDER BY b.SerialNo) rn
                    FROM SalesConfirm a, SalesConfirmDetail b, Party c, ItemCategory d, Item e,
                    (
                       Select
                            a.Tno,
                            sum(NVL(f.Quantity1,0)) - sum(NVL(g.Quantity1,0))  as DAQuantity
                        From SalesConfirm a,  SalesOrder c, DespatchAdviceDetail f, DespatchAdvice e, ccinvoicedetail g, DocumentStatusDetail dsd
                        Where a.Tno = c.SalesConfirmTno(+)
                            and c.Tno = f.referencetno(+) --e.SalesOrderTno --
                            and f.Tno = e.tno(+) --e.SalesOrderTno
                            and f.referencetno = g.referencetno(+)
                            and f.itemcode = g.itemcode(+)
                            and f.itemspecificationcode = g.itemspecificationcode(+)
                            and f.ItemLengthCode = g.ItemLengthCode(+)
                            and e.Tno = dsd.ModuleTno(+)
                            and dsd.DocumentStatusCode = 'ACTIVE'
                            GROUP BY A.TNO
                --    Select 
                --       a.tno,
                --       nvl(sum(c.DIQuantity),0) - nvl(sum(c.CCInvoiceQty),0) as DAQuantity
                -- From salesconfirm a, salesorder b,
                --     (Select 
                --                x.itemcode,
                --                x.itemspecificationcode,
                --                x.itemlengthcode,
                --                x.referencetno,
                --                y.tno,
                --                x.Quantity1 as DIQuantity,
                --                z1.Quantity1 as CCInvoiceQty
                --             From DespatchAdviceDetail x, DespatchAdvice y , DocumentStatusDetail z, CCInvoiceDetail z1
                --             Where x.Tno = y.Tno
                --             and y.Tno = z.ModuleTno(+)
                --             and z.DocumentStatusCode = 'ACTIVE'
                --             and x.referencetno = z1.referencetno
                --             and x.itemcode = z1.itemcode
                --             and x.itemspecificationcode = z1.itemspecificationcode
                --            and x.ItemlengthCode = z1.ItemlengthCode
                --             ) c
                --             where a.tno = b.SalesConfirmTno
                --              and b.tno = c.referencetno
                --             group by a.tno
                         ) f,
                       ( 
                        Select 
                            dd.tno,
                            Sum(aa.quantity1) as CCInvoiceQty
                        From CCInvoiceDetail aa, ccinvoice bb, SalesOrder cc, SalesConfirm dd, DocumentStatusDetail dsd
                        Where aa.tno = bb.tno(+)
                           -- and bb.SalesOrderTno = cc.tno(+)
                            and aa.ReferenceTno = cc.tno(+)
                            And cc.SalesConfirmtno = dd.tno(+)
                            and bb.Tno = dsd.ModuleTno(+)
                            and dsd.DocumentStatusCode = 'ACTIVE'
                            --and bb.CCinvoiceDate <= :P539_TODATE
                        Group By dd.tno
                        ---------------CHANGE 08-05-2026 TO CORRECT CCINVOICE QTY---------- 
                        /*Select 
                            a.TNo,
                            sum(d.Quantity1) as CCInvoiceQty
                        From   Salesconfirm a,SalesConfirmDetail b,SalesOrder c,CCinvoiceDetail d,CCInvoice e
                        Where  a.TNo = b.TNo(+)
                        and  b.TNo = c.SalesConfirmTNo(+)
                        and  c.TNo = d.ReferenceTNo(+)
                        and  d.TNo = e.TNo(+)
                        Group By a.TNo*/
                        )g, DocumentStatusDetail h, DocumentStatus i
                    WHERE a.Tno = b.Tno(+)
                      AND a.PartyCode = c.PartyCode(+)
                      AND b.ItemCode = e.ItemCode(+)
                      AND b.ItemCategoryCode = d.ItemCategoryCode(+)
                      AND a.Tno = f.Tno(+) 
                      AND a.Tno = g.Tno(+)
                      and a.Tno = h.ModuleTno(+)
                      and h.DocumentStatusCode = i.DocumentStatusCode(+)
                      and h.DocumentStatusCode = 'ACTIVE'
                      and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                      and GetPendingscQuantity(a.Tno,b.ItemCategoryCode, b.ItemCode, b.ItemSpecificationCode) > 0
                    and  a.SalesConfirmDate between :P539_FROMDATE and :P539_TODATE
                    and ( :P539_COMPANY IS NULL OR instr(':'||:P539_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                    and ( :P539_LOCATION IS NULL OR instr(':'||:P539_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    and ( :P539_PARTY IS NULL OR instr(':'||:P539_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P539_ITEM IS NULL OR instr(':'||:P539_ITEM||':',':'||b.ItemCode||':') > 0 ) 
                     and ( :P539_SALESCONFIRM IS NULL OR instr(':'||:P539_SALESCONFIRM||':',':'||a.Tno||':') > 0 ) 
                    and ( :P539_ITEMCATEGORY IS NULL OR instr(':'||:P539_ITEMCATEGORY||':',':'||b.ItemCategoryCode||':') > 0 ) 
                    and ( :P539_STATUS IS NULL OR instr(':'||:P539_STATUS||':',':'||i.DocumentStatusCode||':') > 0 ) 
                --       AND a.Tno = 102078438
                )
                GROUP BY 
                    SalesConfirmNo,
                    SalesConfirmDate,
                    PartyName,
                    DAQuantity,
                    CCInvoiceQty
                
                
                /*Select 
                    row_number() over(order by SalesConfirmDate) SerialNo,
                    SalesConfirmNo,
                    SalesConfirmDate,
                    PartyName,
                    MAX(CASE WHEN rn = 1 THEN Items END) AS Item1,
                    MAX(CASE WHEN rn = 2 THEN Items END) AS Item2,
                    MAX(CASE WHEN rn = 3 THEN Items END) AS Item3,
                    
                    MAX(CASE WHEN rn = 1 THEN BRate END) AS Rate1,
                    MAX(CASE WHEN rn = 2 THEN BRate END) AS Rate2,
                    MAX(CASE WHEN rn = 3 THEN BRate END) AS Rate3,
                    
                    MAX(CASE WHEN rn = 1 THEN Quantity1 END) AS Quantity,
                    DAQuantity,
                    CCInvoiceQty,
                    nvl(MAX(CASE WHEN rn = 1 THEN Quantity1 END),0) - nvl(DAQuantity,0) - nvl(CCInvoiceQty,0) as BalanceQty
                
                FROM (
                    SELECT 
                        a.SalesConfirmNo,
                        a.SalesConfirmDate,
                        c.PartyName,
                        d.ItemCategoryName || '-' || e.ItemName AS Items,
                        b.Rate AS BRate,
                        b.Quantity1,
                        f.DAQuantity,
                        f.CCInvoiceQty,
                        ROW_NUMBER() OVER (PARTITION BY a.Tno ORDER BY b.SerialNo) rn
                    FROM SalesConfirm a, SalesConfirmDetail b, Party c, ItemCategory d, Item e,
                    (
                     Select
                         w.salesconfirmtno,
                         Sum(x2.Quantity1) as DAQuantity,
                         Sum(y.CCInvoiceQty) as CCInvoiceQty         
                         From SalesOrder w, SalesOrderDetail x, DespatchAdvice x1, DespatchAdviceDetail x2,
                         (Select 
                                xx.SalesOrderTno,
                                yy.ItemCode,
                                yy.ItemSpecificationCode,
                                yy.Quantity1 as CCInvoiceQty
                            From CCInvoice xx, CCInvoiceDetail yy
                            Where xx.Tno = yy.Tno(+)
                             and xx.CCinvoiceDate >= :P539_TODATE
                             )y
                         Where w.Tno = x.Tno(+)
                           and w.Tno = x1.SalesOrderTno(+)
                           and x1.Tno = x2.Tno(+)
                            and x.ItemCode = x2.ItemCode(+)
                            and x.ItemSpecificationCode = x2.ItemSpecificationCode(+)
                           and x1.SalesOrderTno = y.SalesOrderTno(+)
                            and x.ItemCode = y.ItemCode(+)
                            and x.ItemSpecificationCode = y.ItemSpecificationCode(+)
                --            and w.salesconfirmtno = 102078438
                    Group By w.salesconfirmtno
                         ) f
                    WHERE a.Tno = b.Tno(+)
                      AND a.PartyCode = c.PartyCode(+)
                      AND b.ItemCategoryCode = d.ItemCategoryCode(+)
                      AND b.ItemCode = e.ItemCode(+)
                      AND a.Tno = f.SalesConfirmTno(+) 
                    and a.SalesConfirmDate between :P539_FROMDATE and :P539_TODATE
                    and ( :P539_COMPANY IS NULL OR instr(':'||:P539_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                    and ( :P539_LOCATION IS NULL OR instr(':'||:P539_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    and ( :P539_PARTY IS NULL OR instr(':'||:P539_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P539_ITEM IS NULL OR instr(':'||:P539_ITEM||':',':'||b.ItemCode||':') > 0 ) 
                     and ( :P539_SALESCONFIRM IS NULL OR instr(':'||:P539_SALESCONFIRM||':',':'||a.Tno||':') > 0 ) 
                    and ( :P539_ITEMCATEGORY IS NULL OR instr(':'||:P539_ITEMCATEGORY||':',':'||b.ItemCategoryCode||':') > 0 ) 
                --       AND a.Tno = 102078438
                )
                GROUP BY 
                    SalesConfirmNo,
                    SalesConfirmDate,
                    PartyName,
                    DAQuantity,
                    CCInvoiceQty
                ;
                
                */
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
