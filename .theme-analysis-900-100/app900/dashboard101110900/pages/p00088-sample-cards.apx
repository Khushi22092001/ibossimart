page 88 (
    name: Sample Cards
    alias: SAMPLE-CARDS
    title: Sample Cards
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region sample-cards (
        name: Sample Cards
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     --GetPartyName(a.PartyCode) PartyName,
                     Count(a.TNo) Invoice,
                     sum(a.CCInvoiceAmount) as Revenue
                From CCInvoice a
                --Group by GetPartyName(a.PartyCode)
                --Order by 3 desc
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                u-colors
                t-CardsRegion--styleB
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        title {
            column: INVOICE
        }
        iconAndBadge {
            iconSource: iconClass
            iconCssClasses: fa-money
            badgeColumn: REVENUE
            badgeLabel: Revenue
        }
    )

)

