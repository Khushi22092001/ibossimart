        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P690_TODATE (
        type: datePicker
        label {
            label: To Date / As-of
            alignment: left
