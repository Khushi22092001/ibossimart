            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: Select to_char(trunc(sysdate),'DD-MM-RRRR') From dual
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: End of the flow window AND the As-of Date for every balance on the page. Outstanding, ageing, advances and net exposure are all measured as at this date, reconstructed from effective transactions - not rolled back from today.
        }
    )

