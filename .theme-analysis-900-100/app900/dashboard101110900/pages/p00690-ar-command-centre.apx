    pageItem P690_AGEBASIS (
        type: radioGroup
        label {
            label: Ageing Basis
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC:Due Date (lateness);DUE,Document Date (age);DOC
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter-drawer
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: DUE
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Due Date measures LATENESS and is the accounting-correct basis, but due dates exist on only 28% of open receivable value here - the rest lands in an explicit Cannot Age bucket. Document Date measures AGE, covers every item, and is the basis every existing iBOSS ageing report uses. Neither is hidden and neither is presented as the only answer.
        }
    )

    pageItem P690_COMPANY (
        type: selectList
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.CompanyCode = c.CompanyCode
                                  And v.AccountCode In (Select PartyCode From Party
                                        Start With PartyCode = 'SUNDRYDEBTORS' Connect By Prior PartyCode = ParentCode)
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or v.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P690_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Start of the FLOW window. It bounds receipts, billing and credit notes. It does NOT affect outstanding, ageing or advances - those are point-in-time balances measured at the To Date.
        }
    )

    pageItem P690_LOCATION (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.LocationCode = l.LocationCode
                                  And v.AccountCode In (Select PartyCode From Party
                                        Start With PartyCode = 'SUNDRYDEBTORS' Connect By Prior PartyCode = ParentCode)
                                  And (:P690_COMPANY Is Null Or v.CompanyCode = :P690_COMPANY)
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or v.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P690_COMPANY
            itemsToSubmit: P690_COMPANY
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: "Location" is the business term throughout this dashboard; the underlying column is LocationCode and is never renamed, only relabelled. The list shows only locations that actually carry a receivable, narrowed by the selected Company. NOTE FOR MAINTAINERS - an LOV query must begin with SELECT. A leading /* */ comment here makes APEX fail the item at render time with "Error during rendering of page item P690_LOCATION", which apex validate does not catch. Rationale for an LOV therefore belongs in this help text, not above its SQL.
        }
    )

    pageItem P690_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            displayExtraValues: false
            nullDisplayValue: A + B
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
