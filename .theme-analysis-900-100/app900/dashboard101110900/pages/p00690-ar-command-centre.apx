        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column BAND (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: BAND
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
