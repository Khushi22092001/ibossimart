page 66 (
    name: Department wise Salary Summary
    alias: DEPARTMENT-WISE-SALARY-SUMMARY
    title: Department wise Salary Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region new (
        name: New
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: Select * From DEPTSALSUM;
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DEPARTMENTCODE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Departmentcode
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column NET (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Net
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column TREE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Tree
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

    )

)

