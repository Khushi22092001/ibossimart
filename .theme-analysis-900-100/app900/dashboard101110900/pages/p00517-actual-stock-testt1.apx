        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ITEMNAME, ITEMCODE FROM ITEM A
                WHERE A.PHYSICALGAPITEMCODE IS NOT NULL 
                ORDER BY 1
                ```
        }
        layout {
            sequence: 30
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P517_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        settings {
            minDate: item
            minItem: P517_FROMDATE
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: &nbsp Refresh
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            column: 10
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: [
                fa
                fa-refresh
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @actual-stock-testt
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

