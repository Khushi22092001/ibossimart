page 517 (
    name: Actual Stock Testt
    alias: ACTUAL-STOCK-TESTT1
    title: Actual Stock Testt
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region actual-stock-testt (
        name: Actual Stock Testt
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH
                -- 🧾 Opening stock from ITEMOPENING + transactions before start date
                OPENBAL AS (
                    SELECT 
                        X.ITEMCODE,
                        -- Quantities for Panel A
                        ROUND(SUM(CASE WHEN X.PANEL = 'A' THEN X.IN_QTY - X.OUT_QTY ELSE 0 END),3) AS OPEN_QTY_A,
                        -- Quantities for Panel B
                        ROUND(SUM(CASE WHEN X.PANEL = 'B' THEN X.IN_QTY - X.OUT_QTY ELSE 0 END),3) AS OPEN_QTY_B,
                        -- Amounts for Panel A
                        ROUND(SUM(CASE WHEN X.PANEL = 'A' THEN X.IN_AMT - X.OUT_AMT ELSE 0 END),2) AS OPEN_AMT_A,
                        -- Amounts for Panel B
                        ROUND(SUM(CASE WHEN X.PANEL = 'B' THEN X.IN_AMT - X.OUT_AMT ELSE 0 END),2) AS OPEN_AMT_B
                    FROM (
                        -- ① From ITEMOPENING
                        SELECT 
                            ITEMCODE, PANEL,
                            SUM(STOCKQUANTITY1) AS IN_QTY, 0 AS OUT_QTY,
                            SUM(AMOUNT) AS IN_AMT, 0 AS OUT_AMT
                        FROM STOCK
                        WHERE STOCKDATE <= :P517_FROMDATE
                          AND STOCKMODULECODE = 'ITEMOPENING'
                        GROUP BY ITEMCODE, PANEL
                
                        UNION ALL
                
                        -- ② From normal stock (inward)
                        SELECT 
                            ITEMCODE, PANEL,
                            SUM(STOCKQUANTITY1) AS IN_QTY, 0 AS OUT_QTY,
                            SUM(AMOUNT) AS IN_AMT, 0 AS OUT_AMT
                        FROM STOCK
                        WHERE STOCKDATE < :P517_FROMDATE
                          AND STOCKMODULECODE != 'ITEMOPENING'
                        GROUP BY ITEMCODE, PANEL
                
                        UNION ALL
                
                        -- ③ From used stock (outward)
                        SELECT 
                            AA.ITEMCODE, BB.PANEL,
                            0 AS IN_QTY, SUM(BB.USEDSTOCKQUANTITY1) AS OUT_QTY,
                            0 AS IN_AMT, SUM(AA.RATE * BB.USEDSTOCKQUANTITY1) AS OUT_AMT
                        FROM STOCK AA
                        JOIN USEDSTOCK BB ON AA.TNO = BB.STOCKTNO
                        WHERE BB.USEDSTOCKDATE < :P517_FROMDATE
                        GROUP BY AA.ITEMCODE, BB.PANEL
                    ) X
                    GROUP BY X.ITEMCODE
                ),
                
                -- ⚖️ Physical opening before start
                OPENPHY AS (
                    SELECT 
                        D.PHYSICALGAPITEMCODE AS ITEMCODE,
                        ROUND(SUM(D.STOCKQUANTITY1 - D.USEDSTOCKQUANTITY1),3) AS OPEN_QTY_PHY,
                        ROUND(SUM(D.STOCKAMOUNT - D.USEDSTOCKAMOUNT),2) AS OPEN_AMT_PHY
                    FROM PHYSICALGAPITEMTRANSACTION D
                    WHERE D.TRANSACTIONDATE < :P517_FROMDATE
                    GROUP BY D.PHYSICALGAPITEMCODE
                ),
                
                -- 📦 Stock IN during range
                STKIN AS (
                    SELECT 
                        ITEMCODE,
                        SUM(CASE WHEN PANEL='A' THEN STOCKQUANTITY1 ELSE 0 END) AS IN_QTY_A,
                        SUM(CASE WHEN PANEL='B' THEN STOCKQUANTITY1 ELSE 0 END) AS IN_QTY_B,
                        SUM(CASE WHEN PANEL='A' THEN AMOUNT ELSE 0 END) AS IN_AMT_A,
                        SUM(CASE WHEN PANEL='B' THEN AMOUNT ELSE 0 END) AS IN_AMT_B
                    FROM STOCK
                    WHERE STOCKDATE BETWEEN :P517_FROMDATE AND :P517_TODATE
                      AND STOCKMODULECODE != 'ITEMOPENING'
                    GROUP BY ITEMCODE
                ),
                
                -- 📤 Used stock during range
                USTK AS (
                    SELECT 
                        AA.ITEMCODE,
                        SUM(CASE WHEN BB.PANEL='A' THEN BB.USEDSTOCKQUANTITY1 ELSE 0 END) AS OUT_QTY_A,
                        SUM(CASE WHEN BB.PANEL='B' THEN BB.USEDSTOCKQUANTITY1 ELSE 0 END) AS OUT_QTY_B,
                        SUM(CASE WHEN BB.PANEL='A' THEN (AA.RATE*BB.USEDSTOCKQUANTITY1) ELSE 0 END) AS OUT_AMT_A,
                        SUM(CASE WHEN BB.PANEL='B' THEN (AA.RATE*BB.USEDSTOCKQUANTITY1) ELSE 0 END) AS OUT_AMT_B
                    FROM STOCK AA
                    JOIN USEDSTOCK BB ON AA.TNO = BB.STOCKTNO
                    WHERE BB.USEDSTOCKDATE BETWEEN :P517_FROMDATE AND :P517_TODATE
                    GROUP BY AA.ITEMCODE
                ),
                
                -- ⚖️ Physical movement during range
                PHY AS (
                    SELECT 
                        D.PHYSICALGAPITEMCODE AS ITEMCODE,
                        SUM(D.STOCKQUANTITY1) AS IN_QTY_PHY,
                        SUM(D.USEDSTOCKQUANTITY1) AS OUT_QTY_PHY,
                        SUM(D.STOCKAMOUNT) AS IN_AMT_PHY,
                        SUM(D.USEDSTOCKAMOUNT) AS OUT_AMT_PHY
                    FROM PHYSICALGAPITEMTRANSACTION D
                    WHERE D.TRANSACTIONDATE BETWEEN :P517_FROMDATE AND :P517_TODATE
                    GROUP BY D.PHYSICALGAPITEMCODE
                ),
                
                -- 🧩 Combine all by item
                ITEM_SUM AS (
                    SELECT
                        IT.ITEMCODE,
                        IT.ITEMNAME,
                
                        -- Opening (from OPENBAL + OPENPHY)
                        NVL(OB.OPEN_QTY_A,0) AS OPENING_QTY_A,
                        NVL(OB.OPEN_AMT_A,0) AS OPENING_AMT_A,
                        NVL(OB.OPEN_QTY_B,0) AS OPENING_QTY_B,
                        NVL(OB.OPEN_AMT_B,0) AS OPENING_AMT_B,
                        NVL(OP.OPEN_QTY_PHY,0) AS OPENING_QTY_PHY,
                        NVL(OP.OPEN_AMT_PHY,0) AS OPENING_AMT_PHY,
                
                        -- Current period IN and OUT
                        NVL(SI.IN_QTY_A,0) AS IN_QTY_A,
                        NVL(SI.IN_AMT_A,0) AS IN_AMT_A,
                        NVL(SI.IN_QTY_B,0) AS IN_QTY_B,
                        NVL(SI.IN_AMT_B,0) AS IN_AMT_B,
                
                        NVL(SO.OUT_QTY_A,0) AS OUT_QTY_A,
                        NVL(SO.OUT_AMT_A,0) AS OUT_AMT_A,
                        NVL(SO.OUT_QTY_B,0) AS OUT_QTY_B,
                        NVL(SO.OUT_AMT_B,0) AS OUT_AMT_B,
                
                        NVL(P.IN_QTY_PHY,0) AS IN_QTY_PHY,
                        NVL(P.OUT_QTY_PHY,0) AS OUT_QTY_PHY,
                        NVL(P.IN_AMT_PHY,0) AS IN_AMT_PHY,
                        NVL(P.OUT_AMT_PHY,0) AS OUT_AMT_PHY
                
                    FROM ITEM IT
                    LEFT JOIN OPENBAL OB ON IT.ITEMCODE = OB.ITEMCODE
                    LEFT JOIN OPENPHY OP ON IT.PHYSICALGAPITEMCODE = OP.ITEMCODE
                    LEFT JOIN STKIN SI ON IT.ITEMCODE = SI.ITEMCODE
                    LEFT JOIN USTK SO ON IT.ITEMCODE = SO.ITEMCODE
                    LEFT JOIN PHY P ON IT.PHYSICALGAPITEMCODE = P.ITEMCODE
                    WHERE IT.PHYSICALGAPITEMCODE IS NOT NULL
                      AND (:P517_ITEM IS NULL OR IT.ITEMCODE = :P517_ITEM)
                )
                
                -- ✅ Final summarized report
                SELECT
                    ITEMCODE,
                    ITEMNAME,
                
                    -- 🔹 Quantities
                    OPENING_QTY_A, IN_QTY_A, OUT_QTY_A,
                    ROUND(OPENING_QTY_A + IN_QTY_A - OUT_QTY_A,3) AS CLOSING_QTY_A,
                
                    OPENING_QTY_B, IN_QTY_B, OUT_QTY_B,
                    ROUND(OPENING_QTY_B + IN_QTY_B - OUT_QTY_B,3) AS CLOSING_QTY_B,
                
                    OPENING_QTY_PHY, IN_QTY_PHY, OUT_QTY_PHY,
                    ROUND(OPENING_QTY_PHY + IN_QTY_PHY - OUT_QTY_PHY,3) AS CLOSING_QTY_PHY,
                
                    -- 🔹 Amounts
                    OPENING_AMT_A, IN_AMT_A, OUT_AMT_A,
                    ROUND(OPENING_AMT_A + IN_AMT_A - OUT_AMT_A,2) AS CLOSING_AMT_A,
                
                    OPENING_AMT_B, IN_AMT_B, OUT_AMT_B,
                    ROUND(OPENING_AMT_B + IN_AMT_B - OUT_AMT_B,2) AS CLOSING_AMT_B,
                
                    OPENING_AMT_PHY, IN_AMT_PHY, OUT_AMT_PHY,
                    ROUND(OPENING_AMT_PHY + IN_AMT_PHY - OUT_AMT_PHY,2) AS CLOSING_AMT_PHY
                
                FROM ITEM_SUM
                --ORDER BY ITEMCODE;
                
                ```
            pageItemsToSubmit: [
                P517_FROMDATE
                P517_TODATE
                P517_ITEM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
