page 12 (
    name: City Master
    alias: CITY-MASTER
    title: City Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region city-report (
        name: City Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        row_number() over(order by a.Citycode) SerialNo,
                      a.CityCode,
                      a.CityName,
                      s.StateName,
                      a.STDCode,
                      a.PinCode
                From  City a, State s
                Where a.StateCode = s.StateCode
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            saveReport: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 8490320056305686
        }

        column CITYCODE (
            type: plainText
            heading {
                heading: CITY CODE
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column CITYNAME (
            type: plainText
            heading {
                heading: CITY NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PINCODE (
            type: plainText
            heading {
                heading: PIN CODE
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column STATENAME (
            type: plainText
            heading {
                heading: STATE NAME
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column STDCODE (
            type: plainText
            heading {
                heading: STD CODE
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: City Report
        }

        savedReport 21895 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CITYCODE (
                sequence: 2
            )

            displayColumn CITYNAME (
                sequence: 3
            )

            displayColumn PINCODE (
                sequence: 6
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn STATENAME (
                sequence: 4
            )

            displayColumn STDCODE (
                sequence: 5
            )

            sort (
                column: SNO
                sort {
                    sequence: 1
                }
            )

        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

