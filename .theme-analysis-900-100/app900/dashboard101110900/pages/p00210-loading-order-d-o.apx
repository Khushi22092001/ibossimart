    region loading-order-register-report (
        name: Loading Order Register Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                    row_number() over(order by a.LoadingOrderDate) SerialNo,
                    co.CompanyName as CompanyName,
                    a.LoadingOrderNo,
                    a.LoadingOrderDate,
                    do.DeliveryOrderNo,
                    a.WorkOrderNo,
                    a.WorkOrderDate,
                    a.PartyRefNo as PartyDoNo,
                    p.PartyName,
                	 a.ItemCode,
                	 a.LocationCode,	
                	 b.LocationName,
                    c.ItemName,
                    dl.DestinationLocationName,
                    s1.SourceLocationName,
                    a.ConsignorName,
                    a.ConsigneeName,
                	round(nvl(a.Quantity1,0),3) as Ordered,
                	round(nvl(f.Quantity1,0),3) as LiftingQty,
                   round(nvl(dod.Quantity1,0),3) as DeliveryQty,
                	case when (dsd.DocumentStatusCode = 'CANCELED') then round(dod.Quantity1 - nvl(f.Quantity1, 0),3) else 0 end as Canceled,
                	case when (dsd.DocumentStatusCode != 'CANCELED' and a.ToDate < trunc(sysdate)) then dod.Quantity1 - nvl(f.Quantity1, 0) else 0 end as Lapsed,
                	(
                		case when (dsd.DocumentStatusCode = 'CANCELED') then 
                			0 
                		else 
                			case when (dsd.DocumentStatusCode != 'CANCELED' and a.ToDate < trunc(sysdate)) then
                				0
                			else 
                				nvl(dod.Quantity1, 0) - nvl(f.Quantity1, 0)
                			end 
                		end 	
                	) as Balance,
                  Case When a.ToDate > trunc(SysDate) then
                    a.ToDate - trunc(SysDate)
                    When a.ToDate <= trunc(SysDate) then
                    0 end as DaysOnHand,
                    a.ToDate ValidityTillDate,
                    a.PartyRefNo,
                    a.PartyRefDate,
                    round(a.ItemRate,2) as ItemRate,
                    a.IsdeDuctiononFull,
                    a.ToleranceValue,
                    a.ToleranceMethodCode
                from LoadingOrder a, Location b, DocumentStatusDetail dsd, documentStatus ds, Item c, DestinationLocation dl,SourceLocation s1, Party p, Company co,
                DeliveryOrder do, DeliveryOrderDetail dod,
                (SELECT Sum(f.Quantity1) as Quantity1 ,f.LoadingOrderTno from Lr f Group by f.LoadingOrderTno) f
                where a.LocationCode = b.LocationCode(+)
                and a.Tno = dsd.ModuleTno(+)
                and dsd.documentstatusCode = ds.documentstatusCode(+)
                and dsd.ModuleCode = 'LOADINGORDER'
                and a.ItemCode = c.ItemCode(+)
                and a.DestinationLocationTNO = dl.TNo(+)
                and a.SourceLocationTno = s1.Tno(+)
                and a.PartyCode = p.PartyCode(+)
                and a.CompanyCode = co.CompanyCode(+)
                and a.DeliveryOrderTno = do.Tno(+)
                and do.Tno = dod.Tno(+)
                and a.Tno = f.LoadingOrderTno(+)
                and TRUNC(a.LoadingOrderDate) between :P210_FROMDATE and :P210_TODATE
                and ( :P210_COMPANY IS NULL OR INSTR(':'||:P210_COMPANY||':',':'||a.companycode||':') > 0 )
                and ( :P210_LOCATION IS NULL OR INSTR(':'||:P210_LOCATION||':',':'||b.locationcode||':') > 0 )
                and ( :P210_PARTY IS NULL OR INSTR(':'||:P210_PARTY||':',':'||a.partycode||':') > 0)
                and ( :P210_PARTYDONO IS NULL OR INSTR(':'||:P210_PARTYDONO||':',':'||a.PartyRefNo||':') > 0)
                and ( :P210_DESTINATION IS NULL OR INSTR(':'||:P210_DESTINATION||':',':'||a.DestinationLocationTno||':') > 0)
                and ( :P210_SOURCE IS NULL OR INSTR(':'||:P210_SOURCE||':',':'||a.SourceLocationTno||':') > 0)
                and ( (
                      (
                  		case when (dsd.DocumentStatusCode = 'CANCELED') then 
                  			0 
                  		else 
                  			case when (dsd.DocumentStatusCode != 'CANCELED' and a.ToDate < trunc(sysdate)) then
                  				0
                  			else 
                  				nvl(dod.Quantity1, 0) - nvl(f.Quantity1, 0)
                  			end 
                  		end 	
                  	) > 0
                    and :P210_BALANCEQUANTITY = 'ONLYBALANCE'
                    )
                    OR
                     (
                      (
                  		case when (dsd.DocumentStatusCode = 'CANCELED') then 
                  			0 
                  		else 
                  			case when (dsd.DocumentStatusCode != 'CANCELED' and a.ToDate < trunc(sysdate)) then
                  				0
                  			else 
                  				nvl(dod.Quantity1, 0) - nvl(f.Quantity1, 0)
                  			end 
                  		end 	
                  	) = 0
                    and :P210_BALANCEQUANTITY = 'ZEROBALANCE'
                    )
                    OR
                    :P210_BALANCEQUANTITY is null
                    )
                --order by a.todate desc;
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
