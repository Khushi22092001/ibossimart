    region rate-contract-report (
        name: Rate Contract Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       row_number() over(order by xxx.Tno) SerialNo,
                       xxx.TNo,
                       xxx.SNo,
                       xxx.LocationName,
                       xxx.RateContractNo,
                       xxx.RateContractDate,
                       xxx.ValidDays,
                       xxx.VendorName,
                       xxx.ExpiryDate,
                       xxx.MaterialGroup,
                       xxx.ItemCode,
                       xxx.MaterialDetail,
                       xxx.UOM,
                       xxx.Quantity1,
                       xxx.UOM2,
                       xxx.Quantity2,
                       xxx.Rate,
                       xxx.RateUOM,
                       xxx.Amount,
                       CGST,
                       SGST,
                       IGST,
                       TCS,
                       xxx.FooterAmount,
                       (xxx.FooterAmount - (CGST + SGST + IGST + TCS)) As OtherAmount,
                       xxx.TotalAmount,
                       xxx.Creator,
                       xxx.CreationTime
                  From (Select xx.TNo,
                               xx.SNo,
                               xx.LocationName,
                               xx.RateContractNo,
                               xx.RateContractDate,
                               xx.ValidDays,
                               xx.VendorName,
                               xx.ExpiryDate,
                               xx.MaterialGroup,
                               xx.ItemCode,
                               xx.MaterialDetail,
                               xx.UOM,
                               xx.Quantity1,
                               xx.UOM2,
                               xx.Quantity2,
                               xx.Rate,
                               xx.RateUOM,
                               xx.Amount,
                               Sum(xx.CGST) CGST,
                               Sum(xx.SGST) SGST,
                               Sum(xx.IGST) IGST,
                               Sum(xx.TCS) TCS,
                               xx.FooterAmount,
                               xx.TotalAmount,
                               xx.Creator,
                               xx.CreationTime
                          From (Select a.TNo,
                                       b.SNo,
                                       l.Locationname,
                                       a.RateContractNo,
                                       a.RateContractDate,
                                       Round((a.ExpiryDate - a.RateContractDate), 0) As ValidDays,
                                       v.partyname As VendorName,
                                       a.ExpiryDate,
                                       e.ParentCode || ' ~ ' || GetItemName(e.ParentCode) As MaterialGroup,
                                       e.ItemCode,
                                       e.ItemName,
                                       ee.ItemSpecificationname,
                                       e.ItemName || ' ~ ' || ee.ItemSpecificationname As MaterialDetail,
                                       e.MeasuringUnitCode1 As UOM,
                                       b.Quantity1,
                                       e.MeasuringUnitCode2 As UOM2,
                                       b.Quantity2,
                                       b.Rate,
                                       b.RateMeasuringUnitCode As RateUOM,
                                       b.Amount,
                                       Nvl(Decode(c.FooterHeadCode, '.CGST.', c.FooterValue),
                                           0) As CGST,
                                       Nvl(Decode(c.FooterHeadCode, '.SGST.', c.FooterValue),
                                           0) As SGST,
                                       Nvl(Decode(c.FooterHeadCode, '.IGST.', c.FooterValue),
                                           0) As IGST,
                                       Nvl(Decode(c.FooterHeadCode, '.TCS.', c.FooterValue),
                                           0) As TCS,
                                       b.FooterAmount,
                                       b.TotalAmount,
                                       bue.EmployeeName || ' ( ' || a.Creator || ' )' As Creator,
                                       a.CreationTime,
                                       'Details' As Property,
                                       'RateContract' As Module
                                  From RateContract             a,
                                       RateContractDetail       b,
                                       RateContractDetailFooter c,
                                       Location                 l,
                                       Party                    v,
                                       Item                     e,
                                       ItemSpecification        ee,
                                       BossUser                 bu,
                                       Employee                 bue
                                 Where a.TNo = b.TNo
                                   And b.TNo = c.TNo(+)
                                   And b.SNo = c.SNo(+)
                                   And a.Locationcode = l.LocationCode(+)
                                   And a.partyCode = v.PartyCode(+)
                                   And b.ItemCode = e.ItemCode(+)
                                   And b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                                   And a.Creator = bu.LoginName(+)
                                   And bu.EmployeeCode = bue.EmployeeCode(+)
                                   and a.RateContractDate between :P145_FROMDATE and :P145_TODATE
                                     -- 22-APR-2025
                                   and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                                and instr(':'||:P145_COMPANY||':',':'||a.CompanyCode||':') > 0
                                and instr(':'||:P145_LOCATION||':',':'||a.LocationCode||':') > 0
                                and ( :P145_PARTY IS NULL OR instr(':'||:P145_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                                and ( :P145_ITEM IS NULL OR instr(':'||:P145_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                                and ( :P145_ITEMSPECIFICATION IS NULL OR instr(':'||:P145_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                               -- and ( :P145_GROUP IS NULL OR instr(':'||:P145_GROUP||':',':'||e.ParentCode||':') > 0 )
                                and a.TNo like nvl(:P145_RateContract,'%')
                                and ( :P145_GROUP IS NULL
                                        or
                                        exists (select 1 from (Select ITEMCODE,
                                                parentcode,
                                                RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                                Level,
                                                CONNECT_BY_ROOT itemcode As root_id,
                                                '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                                CONNECT_BY_ISLEAF As leaf
                                            From item a
                                            Start With parentcode in ( select itemcode from item xx where
                                                                        instr(':'||:P145_GROUP||':',':'||xx.ItemCode||':') > 0)
                                                                        
                                            Connect By parentcode = Prior itemcode
                                            Order Siblings By itemcode) x where x.itemcode = e.itemcode
                                            )
                                    )
                                ) xx
                         Group By xx.TNo,
                                  xx.SNo,
                                  xx.LocationName,
                                  xx.RateContractNo,
                                  xx.RateContractDate,
                                  xx.ValidDays,
                                  xx.VendorName,
                                  xx.ExpiryDate,
                                  xx.MaterialGroup,
                                  xx.ItemCode,
                                  xx.MaterialDetail,
                                  xx.UOM,
                                  xx.Quantity1,
                                  xx.UOM2,
                                  xx.Quantity2,
                                  xx.Rate,
                                  xx.RateUOM,
                                  xx.Amount,
                                  xx.FooterAmount,
                                  xx.TotalAmount,
                                  xx.Creator,
                                  xx.CreationTime) xxx
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
