    button custom (
        buttonName: CUSTOM
        label: Custom
        layout {
            sequence: 10
            region: @rate-contract-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconLeft
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/quotation.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P145_FROMDATE=&P145_FROMDATE.&P145_TODATE=&P145_TODATE.&P145_LOCATION=&P145_LOCATION.&P145_BREAKUPAS=&P145_BREAKUPAS.&P145_BREAKUP=&P145_BREAKUP.&P145_QUOTATIONNO=&P145_QUOTATIONNO.&P145_GROUP=&P145_GROUP.&P145_ITEM=&P145_ITEM.&P145_ITEMSPECIFICATION=&P145_ITEMSPECIFICATION.&P145_PARTY=&P145_PARTY.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 1
        }
    )

