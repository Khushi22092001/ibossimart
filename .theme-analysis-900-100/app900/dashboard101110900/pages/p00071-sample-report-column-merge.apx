page 71 (
    name: Sample Report Column Merge
    alias: SAMPLE-REPORT-COLUMN-MERGE
    title: Sample Report Column Merge
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region sample-report (
        name: Sample Report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                   d.departmentname
                 , e.employeename
                 , e.Employeeid
                 , count(*) over (partition by d.departmentcode order by d.departmentcode) rowspan
                 , row_number() over (partition by d.departmentcode order by d.departmentcode , e.Employeename) rn
                from
                   employee e
                 , department d
                where
                   e.departmentcode = d.departmentcode
                order by
                1,2
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            templateType: predefined
        }
        pagination {
            type: nextAndPreviousLinks
        }
        breakFormatting {
            breakColumns: col1
        }

        column DEPARTMENTNAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: DEPARTMENTNAME
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column EMPLOYEEID (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: EMPLOYEEID
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column EMPLOYEENAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: EMPLOYEENAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column RN (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: RN
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column ROWSPAN (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: ROWSPAN
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

)

