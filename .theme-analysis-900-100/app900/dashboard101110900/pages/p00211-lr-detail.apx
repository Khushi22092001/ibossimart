page 211 (
    name: LR Register
    alias: LR-DETAIL
    title: LR Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        formAutoComplete: false
    }

    region lr-register (
        name: LR Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lr-register-report (
        name: LR Register Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by a.GPDATE) SerialNo,
                   GetCompanyName(a.CompanyCode) as CompanyName,
                   lo.LocationName,
                   GetDoctypeName(a.DoctypeCode) as DoctypeName,
                   a.LRNo,
                   a.LRDate,
                   round(n.FreightRate,2) as FreightRate,
                   round(a.Quantity1,2) as Quantity,
                   round(pd.Quantity1,2) as ReceivedQty,
                   pod.PODDate as ReceivedDate,
                   a.ChallanNo,
                   a.VehicleNo,
                   a.DriverName,
                   a.GPNo,
                   a.GPDate,
                   pa.PartyName,
                   t.TransporterName,
                   pp.PartyName as OperatorName,
                   sl.SourceLocationName,
                   a.ConsigneeName,
                   ci.CityName as ConsignorCity,
                   cy.CityName as ConsigneeCity,
                   a.ConsignorName,
                   dl.DestinationLocationName,
                   i.ItemName,
                   ft.FreightTypeName,
                   pd.DeliveryDate,
                   pl.PlacementNo,
                   vt.VehicleTypeName,
                   l.LoadingorderNo,
                   round(l.Quantity1,2) as LOQuantity,
                   l.WorkOrderNo,
                   l.PartyRefNo,
                   do.DeliveryOrderNo,
                   vg.VehicleGroupName,
                   a.CreationTime,
                   a.Creator,
                   a.EwayBillNo,
                   do.LineItem,
                   do.PartyPONO,
                   ds.DocumentStatusName as Status,
                   sol.SourceLocationName as LiftingPoint
                From LR a, Location lo, SourceLocation sl,DestinationLocation dl, Placement pl, LoadingOrder l, DeliveryOrder do,
                Item i,  Transporter t, FreightType ft, City ci, City cy,Party pa, PODDetail pd,POD pod, ServicebillLR n,Party pp,
                DocumentStatusDetail dsd,DocumentStatus ds,
                (
                Select
                a.VehicleNo,
                b.VehicleTypeName,
                a.VehicleOperatorCode
                From CompanyVehicle a, VehicleType b
                where a.VehicleTypeCode = b.VehicleTypeCode(+)
                )vt, VehicleGroup vg, SourceLocation sol
                Where a.LocationCode = lo.LocationCode(+)
                   and a.SourceLocationTno = sl.Tno(+)
                   and a.DestinationLocationTno = dl.Tno(+)
                   and a.PlacementTno = pl.Tno(+)
                   and a.LoadingOrderTno = l.Tno(+)
                   and a.DeliveryOrderTno = do.Tno(+)
                   and a.ItemCode = i.ItemCode(+)
                   and a.TransporterCode = t.TransporterCode(+)
                   and a.FreightTypeCode = ft.FreightTypeCode(+)
                   and a.ConsignorCityCode = ci.CityCode(+)
                   and a.ConsigneeCityCode = cy.CityCode(+)
                   and a.PartyCode = pa.PartyCode(+)
                   and a.Tno = pd.LrTno(+)
                   and pd.Tno = pod.Tno(+)
                   and a.Tno = n.LRTno(+)
                   and vt.VehicleOperatorCode = pp.PartyCode(+)
                   and a.Tno = dsd.ModuleTno(+)
                   and dsd.DocumentStatusCode = ds.DocumentStatusCode(+)
                   and a.VehicleNo = vt.VehicleNo(+)
                   and a.VehicleGRoupCode = vg.VehicleGroupCode(+)
                   and nvl(a.LoadingPointTno,a.SourceLocationTno) = sol.Tno(+)
                   and (:P211_COMPANY is Null Or Instr (':' || :P211_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                   and a.GPDATE Between :P211_FROMDATE and :P211_TODATE 
                    and (:P211_LOCATION is Null Or Instr (':' || :P211_LOCATION || ':' , ':' || lo.LocationCode || ':') > 0)
                    And  (:P211_SOURCE is Null Or Instr (':' || :P211_SOURCE || ':' , ':' ||sl.SourceLocationCode|| ':') > 0)
                    And  (:P211_DESTINATION is Null Or Instr (':' || :P211_DESTINATION || ':' , ':' ||a.DestinationLocationTno|| ':') > 0) 
                    And  (:P211_LR is Null Or Instr (':' || :P211_LR || ':' , ':' ||a.Tno|| ':') > 0)
                    And  (:P211_VEHICLENO is Null Or Instr (':' || :P211_VehicleNo || ':' , ':' ||a.VehicleNo|| ':') > 0)
                    and  (:P211_PARTY is Null Or Instr (':' || :P211_PARTY || ':' , ':' || pa.PartyCode || ':') > 0)
                    and  (:P211_PARTYDONO is Null Or Instr (':' || :P211_PARTYDONO || ':' , ':' ||a.PartyRefNo|| ':') > 0)
                    and (:P211_TRANSPORTER is Null Or Instr (':' || :P211_TRANSPORTER || ':' , ':' || t.TransporterCode|| ':') > 0)
                    and (:P211_VEHICLEGROUP is Null Or Instr (':' || :P211_VEHICLEGROUP || ':' , ':' || vg.VehicleGroupCode|| ':') > 0)
                    and (:P211_CREATOR is Null Or Instr (':' || :P211_CREATOR || ':' , ':' || a.Creator|| ':') > 0)
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 30004299576648618
        }

