        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    'Purchase' d,
                    'Purchase' r
                From Dual 
                union all
                Select
                Distinct
                    'Transfer In' d,
                    'Transfer In' r
                From Dual 
                union all
                Select
                Distinct
                    'Issue' d,
                    'Issue' r
                From Dual 
                union all
                Select
                Distinct
                    'Transfer Out' d,
                    'Transfer Out' r
                From Dual 
                
                ```
