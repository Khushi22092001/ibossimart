page 394 (
    name: Site Wise Material Inward Outward Detail
    alias: SITE-WISE-MATERIAL-INWARD-OUTWARD-DETAIL
    title: Site Wise Material Inward Outward Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var lSpinner$;
    }
    css {
        inline:
            ```css
            #oud .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region site-wise-inward-outward-detail (
        name: Site Wise Inward Outward Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by a.StockDate) SerialNo,
                   a.CompanyName,
                   a.LocationName,
                   a.RecordType,
                   a.DocumentNature,
                   a.ModuleTno,
                   a.ModuleCode,
                   a.DocumentNo,
                   a.DocTypeName,
                   a.StockDate,
                   a.StorageLocationName,
                   a.VendorName,
                   a.ItemCode,
                   a.ItemSpecificationCode,
                   a.ItemName,
                   a.CostCentreName,
                   a.Rate,
                   abs(a.Quantity) as Quantity,
                   abs(a.Amount) as Amount
                From SiteWiseMaterialDetailTable a
                Where 1=1
                   and a.Creator = :APP_USER
                   and a.StockDate between :P394_FROMDATE and :P394_TODATE
                   and (:P394_COMPANY is Null Or Instr (':' || :P394_COMPANY|| ':' , ':' || a.CompanyCode || ':') > 0)
                   and (:P394_LOCATION is Null Or Instr (':' || :P394_LOCATION|| ':' , ':' || a.LocationCode || ':') > 0)
                   and (:P394_RECORDTYPE is Null Or Instr (':' || :P394_RECORDTYPE|| ':' , ':' || a.RecordType || ':') > 0)
                   and (:P394_DOCUMENT is Null Or Instr (':' || :P394_DOCUMENT|| ':' , ':' || a.DocumentNature || ':') > 0)
                   Order by a.RecordType, a.DocumentNature, a.StockDate, a.DocumentNo
                ```
        }
        layout {
            sequence: 90
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: oud
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 337435335915490244
        }

