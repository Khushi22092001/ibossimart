    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction preparerecord (
        name: PrepareRecord
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 50
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: PrepareSiteWiseMaterialDetail(:P394_COMPANY, :P394_LOCATION, :P394_FROMDATE,:P394_TODATE, :APP_USER);
                itemsToSubmit: [
                    P394_COMPANY
                    P394_FROMDATE
                    P394_TODATE
                    P394_LOCATION
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#apex_wait_overlay").remove();
                    $(".u-Processing").remove();
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @site-wise-inward-outward-detail
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @site-wise-inward-outward-detail
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

    )

    dynamicAction show-spinner (
        name: Show Spinner
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var lSpinner$ = apex.util.showSpinner( $( "#oud" ) );
                    //var spinner = apex.util.showSpinner("", {size:"big",color:"blue"})
                    
                    //spinner.remove();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

