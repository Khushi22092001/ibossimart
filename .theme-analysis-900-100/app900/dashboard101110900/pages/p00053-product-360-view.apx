page 53 (
    name: PRODUCT 360 VIEW
    alias: PRODUCT-360-VIEW
    title: PRODUCT 360 VIEW
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region 360-view-list (
        name: 360 View List
        type: list
        source {
            list: @product-360-view
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                u-colors
                t-Cards--featured t-Cards--block force-fa-lg
                t-Cards--displayIcons
                t-Cards--spanHorizontally
                t-Cards--hideBody
                t-Cards--iconsRounded
                t-Cards--animRaiseCard
            ]
        }
    )

)

