page 10 (
    name: Administration
    alias: ADMINISTRATION
    title: Administration
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region administration (
        name: Administration
        type: list
        source {
            list: @administration-list
        }
        layout {
            sequence: 10
            slot: body
            columnCssClasses: hspl-module-tiles
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/media-list
            templateOptions: [
                #DEFAULT#
                u-colors
                t-MediaList--cols t-MediaList--3cols
                t-MediaList--iconsRounded
            ]
        }
    )

)

