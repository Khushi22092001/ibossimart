    )

    region rule-actions (
        name: Actions
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-dash-section">
                  <h2>Where to Act</h2>
                  <p>The twenty largest exposures, and the controls that failed this week</p>
                </div>
                ```
        }
        layout {
            sequence: 28
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-sectionregion
        }
    )

    region top-creditors (
        name: Largest Exposures
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Top 20, and the cap is in the heading. Adjustable Now is carried
                   alongside the exposure because for many of these vendors the fastest
                   reduction is an allocation, not a phone call. */
                With Sd As (
                       Select PartyCode From Party
                        Start With PartyCode = 'SUNDRYCREDITORS'
                        Connect By Prior PartyCode = ParentCode),
                     Asof As (Select to_date(:P721_TODATE,'DD-MM-RRRR') D From dual),
                     Alc As (
                       Select a.DrVoucherTno Tno, a.DrVoucherSno Sno, -Sum(a.Amount) Amt
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                        Group By a.DrVoucherTno, a.DrVoucherSno
                       Union All
                       Select a.CrVoucherTno, a.CrVoucherSno, Sum(a.Amount)
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                        Group By a.CrVoucherTno, a.CrVoucherSno),
                     Al As (Select Tno, Sno, Sum(Amt) Amt From Alc Group By Tno, Sno),
                     Rc As (
                       Select d.AccountCode Pty, Sum(d.Amount) Amt
                         From VoucherDetail d Join Voucher v On v.Tno = d.Tno
                        Where d.AccountCode In (Select PartyCode From Sd) And v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT')
                          And d.VoucherDate >= to_date(:P721_FROMDATE,'DD-MM-RRRR')
                          And d.VoucherDate <  to_date(:P721_TODATE,'DD-MM-RRRR') + 1
                        Group By d.AccountCode),
                     G As (
                       Select d.AccountCode Pty,
                              Sum(Case When -(d.Amount-nvl(al.Amt,0))>0 Then -(d.Amount-nvl(al.Amt,0)) Else 0 End) Gross,
                              Sum(Case When -(d.Amount-nvl(al.Amt,0))<0 Then  (d.Amount-nvl(al.Amt,0)) Else 0 End) Cred,
                              Sum(Case When -(d.Amount-nvl(al.Amt,0))>0
                                        And coalesce(i.DueDate, sb.DueDate, ao.BillDueDate) < (Select D From Asof)
                                       Then -(d.Amount-nvl(al.Amt,0)) Else 0 End) Overdue
                         From VoucherDetail d
                         Join Voucher v On v.Tno = d.Tno
                         Left Join Al al On al.Tno = d.Tno And al.Sno = d.Sno
                         Left Join PBPass     i  On v.ModuleCode = 'PBPASS'     And i.Tno  = v.ModuleTno
                         Left Join ServiceBill sb On v.ModuleCode = 'SERVICEBILL' And sb.Tno = v.ModuleTno
                         Left Join AccountOpening ao On v.VoucherNo = 'OPENING'   And ao.Tno = d.ModuleTno
                         Cross Join Asof
                        Where d.AccountCode In (Select PartyCode From Sd)
                          And d.VoucherDate <= Asof.D
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (:P721_PANEL    Is Null Or d.Panel        = :P721_PANEL)
                          And (:P721_COMPANY  Is Null Or d.CompanyCode  = :P721_COMPANY)
                          And (:P721_LOCATION Is Null Or d.LocationCode = :P721_LOCATION)
                        Group By d.AccountCode)
                Select * From (
                  Select apex_escape.html(nvl(p.PartyName, g.Pty)) As CUSTOMER,
                         g.Pty                                     As PARTY_CODE,
                         Round(g.Gross,2)                          As GROSS,
                         Round(g.Overdue,2)                        As OVERDUE,
                         Round(g.Cred,2)                           As CREDIT_HELD,
                         Round(g.Gross-g.Cred,2)                   As NET_EXPOSURE,
                         Round(Least(g.Gross,g.Cred),2)            As ADJUSTABLE_NOW,
                         Round(nvl(rc.Amt,0),2)                    As COLLECTED_THIS_WEEK
                    From G g
                    Left Join Party p On p.PartyCode = g.Pty
                    Left Join Rc rc On rc.Pty = g.Pty
                   Where g.Gross > 0.005
                   Order By g.Gross - g.Cred Desc)
                 Where rownum <= 20
                ```
            pageItemsToSubmit: [
                P721_FROMDATE
                P721_TODATE
                P721_COMPANY
                P721_LOCATION
                P721_PANEL
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No vendor carries an open payable in this scope.
        }

        column ADJUSTABLE_NOW (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Adjustable Now (₹)
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
        )

        column COLLECTED_THIS_WEEK (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Paid in Window (₹)
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
        )

        column CREDIT_HELD (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Credit Held (₹)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

        column CUSTOMER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Vendor (top 20 by net exposure)
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column GROSS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Gross (₹)
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column NET_EXPOSURE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Net Exposure (₹)
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

        column OVERDUE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Overdue (₹)
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column PARTY_CODE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
        )

    )

    pageItem P721_COMPANY (
        type: selectList
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.CompanyCode = c.CompanyCode
                                  And v.AccountCode In (Select PartyCode From Party
                                        Start With PartyCode = 'SUNDRYCREDITORS' Connect By Prior PartyCode = ParentCode))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P721_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: Select to_char(trunc(sysdate) - 6,'DD-MM-RRRR') From dual
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P721_LOCATION (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.LocationCode = l.LocationCode
                                  And v.AccountCode In (Select PartyCode From Party
                                        Start With PartyCode = 'SUNDRYCREDITORS' Connect By Prior PartyCode = ParentCode)
                                  And (:P721_COMPANY Is Null Or v.CompanyCode = :P721_COMPANY))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P721_COMPANY
            itemsToSubmit: P721_COMPANY
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P721_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            displayExtraValues: false
            nullDisplayValue: A + B
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P721_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: Select to_char(trunc(sysdate),'DD-MM-RRRR') From dual
        }
        security {
            encryptSessionState: false
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
    )

    button back (
        buttonName: BACK
        label: Command Centre
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 710
                items: {
                    P710_FROMDATE: &P721_FROMDATE.
                    P710_TODATE: &P721_TODATE.
                    P710_COMPANY: &P721_COMPANY.
                    P710_LOCATION: &P721_LOCATION.
                    P710_PANEL: &P721_PANEL.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

