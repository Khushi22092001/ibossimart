page 235 (
    name: Vehicle Last Settlement
    alias: VEHICLE-LAST-SETTLEMENT
    title: Vehicle Last Settlement
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region vehicle-last-settlement (
        name: Vehicle Last Settlement
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vehicle-last-settlement-2 (
        name: Vehicle Last Settlement
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     RowNum as mysno,
                     a.TRIPSETTLEMENTNO ,
                     a.TRIPSETTLEMENTDATE,
                     A.VEHICLENO ,
                     A.BOOKNO,
                     A.TODATE
                  from  TRIPSETTLEMENT a, COMPANYVEHICLE B
                where 
                        A.VEHICLENO=B.VEHICLENO
                        and B.OWNERCODE='SELF'
                       and a.CompanyCode = :P235_COMPANYCODE
                       and A.TODATE between :P235_FROMDATE and :P235_TODATE
                       and A.TODATE IN (SELECT MAX(TODATE) FROM TRIPSETTLEMENT C  
                       WHERE C.VEHICLENO=A.VEHICLENO)
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 22444695917305720
        }

        savedReport 227207 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @MYSNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @TRIPSETTLEMENTNO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @TRIPSETTLEMENTDATE
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @VEHICLENO
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @BOOKNO
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @TODATE
                layout {
                    sequence: 11
                }
            )

        )

        column BOOKNO (
            type: textField
            heading {
                heading: Book No
            }
            layout {
                sequence: 100
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: BOOKNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column MYSNO (
            type: numberField
            heading {
                heading: Mysno
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                databaseColumn: MYSNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TODATE (
            type: datePicker
            heading {
                heading: To Date
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            source {
                databaseColumn: TODATE
                dataType: date
            }
        )

        column TRIPSETTLEMENTDATE (
            type: datePicker
            heading {
                heading: Trip Settlement Date
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: center
            }
            source {
                databaseColumn: TRIPSETTLEMENTDATE
                dataType: date
            }
        )

        column TRIPSETTLEMENTNO (
            type: textarea
            heading {
                heading: Trip Settlement No
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: TRIPSETTLEMENTNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column VEHICLENO (
            type: textField
            heading {
                heading: Vehicle No
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: VEHICLENO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Vehicle Last Settlement
        }
    )

    pageItem P235_COMPANYCODE (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select CompanyName d,
                CompanyCode r
                From
                Company;
                ```
        }
        layout {
            sequence: 30
            region: @vehicle-last-settlement
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P235_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @vehicle-last-settlement
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P235_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @vehicle-last-settlement
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 10
            region: @vehicle-last-settlement
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

