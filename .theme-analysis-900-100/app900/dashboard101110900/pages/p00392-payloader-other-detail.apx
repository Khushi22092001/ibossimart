page 392 (
    name: Payloader Other Detail
    alias: PAYLOADER-OTHER-DETAIL
    title: Payloader Other Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-other-detail (
        name: Payloader  Other Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*Select
                   a.CompanyCode,
                   b.ModuleName,
                   a.IssueNo as ModuleNo,
                   a.IssueDate as ModuleDate,
                   x.EquipmentTno,
                   x.EquipmentID,
                   x.Amount as Amount,
                   lo.LocationName
                From Issue a, Module b, DocumentStatusDetail dsd, Location lo,
                   (
                   Select
                      a.ModuleTno,
                      c.Tno as EquipmentTno,
                      c.EquipmentID,
                      sum(b.Amount) as Amount
                   From Voucher a, VoucherCostCentreDetail b, Equipment c
                   Where a.Tno = b.Tno
                      and b.CostCentreCode = c.CostCentreCode
                      and c.EquipmentGroupCode = 'PL'
                   Group by
                         a.ModuleTno,
                         c.Tno,
                         c.EquipmentID
                   ) x
                Where 1=1
                and a.LocationCode = lo.LocationCode
                and a.Tno = x.ModuleTno
                and b.ModuleCode = 'ISSUE'
                and a.Tno = dsd.ModuleTno
                and dsd.DocumentStatusCode = 'ACTIVE'
                and exists(
                         Select
                             aa.Tno
                         From IssueDetail aa, Item bb
                         Where aa.ItemCode = bb.ItemCode
                            and bb.ItemCategoryCode = 'ADBLUE'
                            and aa.Tno = a.Tno
                           )
                and exists(
                         Select
                             aa.Tno
                         From IssueStockStorageDetail aa
                         Where aa.StorageLocationCode != '291'
                           and aa.Tno = a.Tno
                           )
                and not exists(
                         Select
                             aa.Tno
                         From NecessitySlip aa, NecessitySlipDetail bb, Requisition cc
                         Where aa.Tno = bb.Tno
                           and bb.VehicleNecessityCode in (Select vn.VehicleNecessityCode From VehicleNecessityForFuel vn)
                           and aa.Tno = cc.ModuleTno
                           and cc.Tno = a.RequisitionTno
                         )
                and (:P392_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                and a.IssueDate between :P392_FROMDATE and :P392_TODATE
                and (:P392_COMPANYCODE is Null Or Instr (':' || :P392_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P392_EQUIPMENTID is Null Or Instr (':' || :P392_EQUIPMENTID || ':' , ':' || x.EquipmentTno || ':') > 0)
                UNION ALL
                Select
                   a.CompanyCode,
                   d.ModuleName,
                   a.NecessityCompletionNo as ModuleNo,
                   a.NecessityCompletionDate as ModuleDate,
                   a.EquipmentTno,
                   c.EquipmentID,
                   b.TotalAmount as Amount,
                   lo.LocationName
                From NecessityCompletion a, NecessityCompletionDetail b, Equipment c, Module d,DocumentStatusDetail dsd, Location lo
                Where a.Tno = b.Tno
                   and a.EquipmentTno = c.Tno
                   and a.ModuleCode = 'NECESSITYCOMPLETION'
                   and c.EquipmentGroupCode = 'PL'
                   and a.Tno = dsd.ModuleTno
                   and a.LocationCode = lo.LocationCode
                   and dsd.DocumentStatusCode = 'ACTIVE'
                   and b.NecessitySlipTno is null
                   and (:P392_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                   and a.NecessityCompletionDate between :P392_FROMDATE and :P392_TODATE
                   and (:P392_COMPANYCODE is Null Or Instr (':' || :P392_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                   and (:P392_EQUIPMENTID is Null Or Instr (':' || :P392_EQUIPMENTID || ':' , ':' || a.EquipmentTno || ':') > 0)
                
                */
                
                
                Select 
                  row_number() over(order by a.ModuleDate) SerialNo,
                  a.Tno,
                  a.CompanyCode,
                  a.EquipmentTno,
                  a.EquipmentID,
                  a.ModuleName,
                  a.ModuleNo,
                  a.ModuleDate,
                  a.Amount,
                  b.LocationName
                From PayloaderExpenseTable a, Location b
                Where a.Creator = :APP_USER
                	and a.LocationCode = b.LocationCode
                	and (:P392_LOCATION is null
                		or exists(
                			 Select
                				aa.LocationCode
                			  From PayloaderPerformanceLocation aa
                			  Where aa.LocationCode = a.LocationCode
                				  and aa.Creator = :APP_USER
                			)
                		)
                	and a.Categories = 'OTHER'
                	and a.ModuleDate between :P392_FROMDATE and :P392_TODATE
                	and (:P392_COMPANYCODE is Null Or Instr (':' || :P392_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                	and (:P392_EQUIPMENTID is Null Or Instr (':' || :P392_EQUIPMENTID || ':' , ':' || a.EquipmentTno || ':') > 0)
                
                ```
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 1224845882674475472
        }

        column AMOUNT (
            type: link
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            link {
                target: {
                    page: 406
                    items: {
                        P406_TNO: #TNO#
                    }
                    clearCache: 406
                }
                linkText: #AMOUNT#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EQUIPMENTID (
            type: plainText
            heading {
                heading: Equipment  ID
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column EQUIPMENTTNO (
            type: plainText
            heading {
