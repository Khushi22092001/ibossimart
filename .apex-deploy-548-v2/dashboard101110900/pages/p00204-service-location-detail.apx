                layout {
                    width: 156
                    sequence: 10
                }
            )

            displayColumn (
                column: @CREATOR
                layout {
                    sequence: 12
                }
            )

            sort (
                column: @SERIALNO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            aggregate sum (
                column: @SERIALNO
                showGrandTotal: true
            )

        )

