page 204 (
    name: Service Location Detail
    alias: SERVICE-LOCATION-DETAIL
    title: Service Location Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region service-location-detail (
        name: Service Location Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region service-location-detail-report (
        name: Service Location Detail Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                Rownum as SerialNo,
                a.ServiceLocationCode,
                a.ServiceLocationName,
                a.IsDestinationLocation,
                a.IsSourceLocation,
                a.IsCity,
                a.Pincode,
                sc.CityName as SourceCityName,
                ss.StateName as SourceStateName,
                dc.CityName as DestinationCityName, 
                ds.StateName as DestinationStateName,
                nvl(bs.BossUserName , bd.BossUserName) as Creator
                From ServiceLocation a, SourceLocation b, DestinationLocation c, City sc, State ss, City dc, State ds,
                BossUser bs, BossUser bd
                Where a.Tno = b.ModuleTno(+)
                and a.Tno = c.ModuleTno(+)
                and b.CityCode = sc.CityCode(+)
                and b.StateCode = ss.StateCode(+)
                and c.CityCode = dc.CityCode(+)
                and c.StateCode = ds.StateCode(+)
                and b.Creator = bs.LoginName(+)
                and c.Creator = bd.LoginName(+)
                ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 18995997279337013
        }

        savedReport 191149 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

