    region vehicle-kpi (
        name: Vehicle KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With K As (
                  Select Count(*) Trips, Count(Distinct mo.PartyCode) Customers,
                         Round(Avg(Case When mo.GateOutTime > mo.GateInTime And (mo.GateOutTime-mo.GateInTime)*24 < 72 Then (mo.GateOutTime-mo.GateInTime)*24 End),1) AvgHrs,
                         Max(mo.GateInTime) LastTrip
                    From MaterialOut mo
                   Where mo.VehicleNo = :P732_VEHICLE
                     And mo.MaterialOutDate Between to_date(:P732_FROMDATE,'DD-MM-RRRR') And to_date(:P732_TODATE,'DD-MM-RRRR')
                     And (:P732_COMPANY Is Null Or mo.CompanyCode=:P732_COMPANY)
                     And (:P732_LOCATION Is Null Or mo.LocationCode=:P732_LOCATION)
                     And (:P732_PANEL Is Null Or mo.Panel=:P732_PANEL)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or mo.Panel=(Select GetUserPanelAB_apex() From dual)))
                Select Case x.Seq
                  When 1 Then q'~<div class="ds-kpi ds-kpi--value"><span class="ds-kpi-ic"><span class="fa fa-refresh"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Total Trips</span><span class="ds-kpi-n">~'||to_char(K.Trips,'FM999G990')||q'~</span><span class="ds-kpi-sub">Gate movements on record</span></span></div>~'
                  When 2 Then q'~<div class="ds-kpi ds-kpi--bill"><span class="ds-kpi-ic"><span class="fa fa-users"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Customers Served</span><span class="ds-kpi-n">~'||to_char(K.Customers,'FM999G990')||q'~</span><span class="ds-kpi-sub">Distinct parties carried</span></span></div>~'
                  When 3 Then q'~<div class="ds-kpi ds-kpi--ok"><span class="ds-kpi-ic"><span class="fa fa-clock-o"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Avg Dwell</span><span class="ds-kpi-n">~'||to_char(Nvl(K.AvgHrs,0),'FM990D0')||q'~ h</span><span class="ds-kpi-sub">Gate-in to gate-out (clean trips)</span></span></div>~'
                  Else q'~<div class="ds-kpi ds-kpi--input"><span class="ds-kpi-ic"><span class="fa fa-calendar"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Last Trip</span><span class="ds-kpi-n" style="font-size:16px">~'||nvl(to_char(K.LastTrip,'DD-Mon-RR'),'&ndash;')||q'~</span><span class="ds-kpi-sub">Most recent gate-in</span></span></div>~'
                End As CARD
                From K, (Select Level Seq From dual Connect By Level <= 4) x
                Order By x.Seq
                ```
            pageItemsToSubmit: [
                P732_VEHICLE
                P732_FROMDATE
                P732_TODATE
                P732_COMPANY
                P732_LOCATION
                P732_PANEL
            ]
        }
