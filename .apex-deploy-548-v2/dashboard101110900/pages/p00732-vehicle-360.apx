page 732 (
    name: Vehicle 360
    alias: VEHICLE-360
    title: Vehicle 360
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            VEHICLE 360 (HSPL). Pick a vehicle number and see its complete sales-movement history:
            every gate movement (MaterialOut GateInTime/GateOutTime) with the Dispatch Advice, Sales
            Order, customer and CC Invoice it carried. Links: MaterialOut.ReferenceTNo=DespatchAdvice,
            DespatchAdvice.SalesOrderTNo, CCInvoice.DespatchAdviceTNo. VehicleNo is free-text on the
            documents (customer/transporter trucks). READ-ONLY.
            ```
    }

    region command-header (
        name: Vehicle 360
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-slc-hero"><div class="ds-slc-hero-row">'
                  || '<span class="ds-slc-hero-icon"><span class="fa fa-truck"></span></span>'
                  || '<span><span class="ds-slc-hero-eyebrow">Logistics &middot; Traceability</span><br>'
                  || '<span class="ds-slc-hero-title">Vehicle 360</span>'
                  || '<div class="ds-slc-hero-sub">Pick a vehicle and see every trip it made &mdash; gate in and out, '
                  || 'the dispatch, order, customer and invoice it carried.</div></span></div>'
                  || Case When :P732_VEHICLE Is Not Null Then
                       '<div class="ds-slc-hero-chips"><span class="ds-chip ds-chip--live"><span class="fa fa-truck ds-chip-ic"></span>'
                       || '<span class="ds-chip-k">Vehicle</span><b>'||apex_escape.html(:P732_VEHICLE)||'</b></span></div>'
                     Else '<div class="ds-slc-hero-chips"><span class="ds-chip"><span class="fa fa-search ds-chip-ic"></span>'
                       || '<span class="ds-chip-k">Select</span><b>a vehicle to begin</b></span></div>' End
                  || '</div>' As HEAD
                From dual
                ```
            pageItemsToSubmit: [
                P732_VEHICLE
                P732_FROMDATE
                P732_TODATE
                P732_COMPANY
                P732_LOCATION
                P732_PANEL
            ]
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-slc-headregion
                ds-360-headregion
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Header unavailable.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

