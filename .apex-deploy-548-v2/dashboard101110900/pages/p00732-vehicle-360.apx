    region trip-history (
        name: Trip History
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With WeightRank As (
                  Select w.*,
                         Row_Number() Over (Partition By nvl(w.DespatchAdviceTNo,nvl(w.ReferenceTNo,w.SalesOrderTNo))
                                                Order By w.WeighmentDate Desc,w.TNo Desc) rn
                    From Weighment w)
                Select mo.MaterialOutNo MOUT_NO,
                       mo.MaterialOutDate MOUT_DATE,
                       mo.GateInTime GATE_IN,
                       mo.GateOutTime GATE_OUT,
                       da.DespatchAdviceNo DA_NO,
                       Case When so.TNo Is Not Null Then '<a href="'||apex_page.get_url(p_page=>734,p_clear_cache=>'734',p_items=>'P734_SOTNO',p_values=>so.TNo)||'">'||apex_escape.html(so.SalesOrderNo)||'</a>'
                            When iut.TNo Is Not Null Then '<span class="ds-pill ds-pill--muted">Inter-unit transfer &middot; '||apex_escape.html(iut.InterunittransferNo)||'</span>' End SO_NO,
                       '<a href="'||apex_page.get_url(p_page=>655,p_clear_cache=>'655',p_items=>'P655_PARTY_CODE',p_values=>mo.PartyCode)||'">'||GetPartyName(mo.PartyCode)||'</a>' CUSTOMER,
                       w.WeighmentNo WEIGHMENT_NO,w.FirstWeight FIRST_WEIGHT,w.SecondWeight SECOND_WEIGHT,w.NetWeight NET_WEIGHT,
                       Case When ci.TNo Is Not Null Then '<a href="'||apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>ci.TNo)||'">'||ci.CCInvoiceNo||'</a>' End INV_NO
                  From MaterialOut mo
                  Left Join DespatchAdvice da On da.TNo = mo.ReferenceTNo
                  Left Join SalesOrder so On so.TNo = da.SalesOrderTNo
                  Left Join Interunittransfer iut On iut.TNo=da.ReferenceTNo
                  Left Join WeightRank w On w.rn=1 And (w.DespatchAdviceTNo=da.TNo Or w.ReferenceTNo=da.TNo Or w.SalesOrderTNo=so.TNo)
                  Left Join CCInvoice ci On ci.DespatchAdviceTNo = da.TNo
                 Where mo.VehicleNo = :P732_VEHICLE
                   And mo.MaterialOutDate Between to_date(:P732_FROMDATE,'DD-MM-RRRR') And to_date(:P732_TODATE,'DD-MM-RRRR')
                   And (:P732_COMPANY Is Null Or mo.CompanyCode=:P732_COMPANY)
                   And (:P732_LOCATION Is Null Or mo.LocationCode=:P732_LOCATION)
                   And (:P732_PANEL Is Null Or mo.Panel=:P732_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or mo.Panel=(Select GetUserPanelAB_apex() From dual))
                 Order By mo.GateInTime Desc Nulls Last
                ```
            pageItemsToSubmit: [
                P732_VEHICLE
                P732_FROMDATE
                P732_TODATE
                P732_COMPANY
                P732_LOCATION
                P732_PANEL
            ]
        }
        layout {
            sequence: 21
            slot: body
            columnSpan: 12
        }
