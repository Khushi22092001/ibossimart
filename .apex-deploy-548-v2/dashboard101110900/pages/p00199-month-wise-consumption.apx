page 199 (
    name: Month Wise Consumption
    alias: MONTH-WISE-CONSUMPTION
    title: Month Wise Consumption
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        height: 700
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region consumption-report (
        name: Consumption Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct e.fin_month,
                                e.FIN_MONTH_START_DATE,
                                DECODE(SIGN(e.FIN_MONTH_END_DATE -
                                                                          TO_DATE(:P199_TODATE,
                                                                                  'DD-MON-RRRR')),
                                                                     1,
                                                                     TO_DATE(:P199_TODATE,
                                                                             'DD-MON-RRRR'),
                                                                     e.FIN_MONTH_END_DATE) AS FIN_MONTH_END_DATE,
                                --e.FIN_MONTH_END_DATE,
                                E.FIN_MONTH_NAME,
                                A.ITEMCODE,
                                A.ITEMNAME,
                                B.ITEMSPECIFICATIONNAME,
                                B.ITEMSPECIFICATIONCODE,
                                
                                getslitemconsumptionquantity1(Null,
                                                              A.ITEMCODE,
                                                              B.ITEMSPECIFICATIONCODE,
                                                              '1',
                                                              e.FIN_MONTH_START_DATE,
                                                              DECODE(SIGN(e.FIN_MONTH_END_DATE -
                                                                          TO_DATE(:P199_TODATE,
                                                                                  'DD-MON-RRRR')),
                                                                     1,
                                                                     TO_DATE(:P199_TODATE,
                                                                             'DD-MON-RRRR'),
                                                                     e.FIN_MONTH_END_DATE)) As Quantity,
                                getslitemconsumptionValue(Null,
                                                          A.ITEMCODE,
                                                          B.ITEMSPECIFICATIONCODE,
                                                          '1',
                                                          e.FIN_MONTH_START_DATE,
                                                          DECODE(SIGN(e.FIN_MONTH_END_DATE -
                                                                          TO_DATE(:P199_TODATE,
                                                                                  'DD-MON-RRRR')),
                                                                     1,
                                                                     TO_DATE(:P199_TODATE,
                                                                             'DD-MON-RRRR'),
                                                                     e.FIN_MONTH_END_DATE)) As Value
                  From ITEM A, ITEMSPECIFICATION B, BI_DATETIME e
                 Where A.TNO = B.TNO
                   And E.FIN_DATE Between :P199_FROMDATE And :P199_TODATE
                   And a.ItemCode = :P199_ITEM
                   And b.ItemSpecificationCode = :P199_SPECIFICATION
                
                 Order By E.FIN_MONTH
                
                ```
            pageItemsToSubmit: [
                P199_COMPANY
                P199_LOCATION
                P199_FROMDATE
                P199_TODATE
                P199_ITEM
                P199_SPECIFICATION
            ]
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: STOCK POSITION
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 58287032460799019
        }

        column FIN_MONTH (
            type: plainText
            heading {
                heading: Fin Month
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column FIN_MONTH_END_DATE (
            type: plainText
            heading {
                heading: Fin Month End Date
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: P
            }
        )

        column FIN_MONTH_NAME (
            type: link
            heading {
                heading: Fin Month Name
                alignment: center
            }
            layout {
                sequence: 130
            }
            link {
                target: {
                    page: 200
                    items: {
                        P200_COMPANY: &P199_COMPANY.
                        P200_LOCATION: &P199_LOCATION.
                        P200_FROMDATE: #FIN_MONTH_START_DATE#
                        P200_TODATE: #FIN_MONTH_END_DATE#
                        P200_ITEM: #ITEMCODE#
                        P200_SPECIFICATION: #ITEMSPECIFICATIONCODE#
                    }
                    clearCache: 200
                }
                linkText: #FIN_MONTH_NAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column FIN_MONTH_START_DATE (
            type: plainText
            heading {
                heading: Fin Month Start Date
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: O
            }
        )

        column ITEMCODE (
            type: hidden
            heading {
                heading: Itemcode
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ITEMNAME (
            type: plainText
            heading {
                heading: ITEM NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: plainText
            heading {
                heading: Itemspecificationcode
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ITEMSPECIFICATIONNAME (
            type: plainText
            heading {
                heading: ITEM SPECIFICATION
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 99,99,999.999
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column VALUE (
            type: plainText
            heading {
                heading: Value
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: 99,99,99,99,999.99
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        savedReport 242462 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FIN_MONTH_NAME (
                sequence: 1
            )

            displayColumn ITEMNAME (
                sequence: 2
            )

            displayColumn ITEMSPECIFICATIONNAME (
                sequence: 3
            )

            displayColumn QUANTITY (
                sequence: 4
            )

            displayColumn VALUE (
                sequence: 5
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: VALUE
            )

        )

    )

    region consumption-report-2 (
        name: Consumption Report
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-left-none
                margin-right-none
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P199_COMPANY (
        type: hidden
        layout {
            sequence: 10
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P199_DIPNO (
        type: hidden
        layout {
            sequence: 30
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P199_FROMDATE (
        type: hidden
        layout {
