        security {
            encryptSessionState: false
        }
    )

    pageItem P199_ITEM (
        type: hidden
        layout {
            sequence: 60
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P199_LOCATION (
        type: hidden
        layout {
            sequence: 20
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P199_SPECIFICATION (
        type: hidden
        layout {
            sequence: 70
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P199_TODATE (
        type: hidden
        layout {
            sequence: 50
            region: @consumption-report-2
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: Trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P199_SJNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P199_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P199_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 25676256995005505
        }
    )

)

