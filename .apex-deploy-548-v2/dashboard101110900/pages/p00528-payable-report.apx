page 528 (
    name: Payable Report
    alias: PAYABLE-REPORT
    title: Payable Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region payable-report (
        name: Payable  Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                x.*
                From
                (
                Select 
                    a.Tno,
                    b.PartyBillNo,
                    b.PartyBillDate,
                    null as GRNDate,
                    null as AgentName,
                    'JBPASS' as Module,
                    c.PartyName,
                    d.Quantity1 as BillQty,
                    d.Rate,
                    a.JBPassAmount as GrossAmount,
                    e.DebitNoteAmount,
                    a.SumofTDSAmount as TDS,
                    a.AmountAfterTDS as NetAmount,
                    a.PaidAmount,
                    nvl(a.AmountAfterTDS, 0) - nvl(a.PaidAmount, 0) as Balance
                From JBPass a, JobBill b, Party c, JobBillDetail d, DebitNote e
                Where a.JobBillTno = b.Tno(+)
                and b.PartyCode = c.PartyCode(+)
                and b.Tno = d.Tno
                and a.Tno = e.ReferenceModuleTno(+)
                and a.JBPassDate Between :P528_FROMDATE and :P528_TODATE
                and ( :P528_COMPANY IS NULL OR instr(':'||:P528_COMPANY||':',':'||a.CompanyCode||':') > 0)
                and ( :P528_PARTY IS NULL OR instr(':'||:P528_PARTY||':',':'||b.PartyCode ||':') > 0 )
                and ( :P528_BILLNO IS NULL OR instr(':'||:P528_BILLNO||':',':'||b.PartyBillNo||':') > 0 )
                
                union all
                Select 
                    a.Tno,
                    b.PartyBillNo,
                    b.PartyBillDate,
                    g.GRNDate,
                    j.PartyName as AgentName,
                    'PBPASS' as Module,
                    c.PartyName,
                    d.Quantity1 as BillQty,
                    d.Rate,
                    a.PBPassAmount as GrossAmount,
                    h.DebitNoteAmount,
                    a.SumofTDSAmount as TDS,
                    a.AmountAfterTDS as NetAmount,
                    a.PaidAmount,
                    nvl(a.AmountAfterTDS, 0) - nvl(a.PaidAmount, 0) as Balance
                From PBPass a, PurchaseBill b, Party c, PurchaseBillDetail d, PurchaseBillGRNDetail e, GRNDetail f, GRN g, DebitNote h,
                PurchaseOrder i, Party j
                Where a.PurchaseBillTno = b.Tno(+)
                and b.PartyCode = c.PartyCode(+)
                and b.Tno = d.Tno(+)
                and d.Tno = e.Tno(+)
                and d.Sno = e.Sno(+)
                and e.GRNTno = f.Tno(+)
                and e.GRNSno = f.Sno(+)
                and f.Tno = g.Tno(+)
                and a.Tno = h.ReferenceModuleTno(+)
                and b.PurchaseOrderTno = i.Tno(+)
                and i.AgentCode = j.PartyCode(+)
                and a.PBPassDate Between :P528_FROMDATE and :P528_TODATE
                and ( :P528_COMPANY IS NULL OR instr(':'||:P528_COMPANY||':',':'||a.CompanyCode||':') > 0)
                and ( :P528_PARTY IS NULL OR instr(':'||:P528_PARTY||':',':'||b.PartyCode ||':') > 0 )
                and ( :P528_BILLNO IS NULL OR instr(':'||:P528_BILLNO||':',':'||b.PartyBillNo||':') > 0 )
                union all
                Select
                    a.Tno,
                    a.PartyBillNo,
                    a.PartyBillDate,
                    d.GRNDate,
                    null as AgentName,
                    'FREIGHTADVICE' as Module,
                    b.PartyName,
                    c.Quantity1 as BillQty,
                    c.Rate,
                    a.FreightAdviceAmount as GrossAmount,
                    null as DebitNoteAmount,
                    a.SumofTDSAmount as TDS,
                    a.AmountAfterTDS as NetAmount,
                    a.PaidAmount,
                    nvl(a.AmountAfterTDS, 0) - nvl(a.PaidAmount, 0) as Balance
                From FreightAdvice a, Party b, FreightAdviceDetail c, GRN d
                Where a.TransporterCode = b.PartyCode
                    and a.Tno = c.Tno
                    and c.ModuleTno = d.Tno
                    and a.FreightAdviceDate Between :P528_FROMDATE and :P528_TODATE
                    and ( :P528_COMPANY IS NULL OR instr(':'||:P528_COMPANY||':',':'||a.CompanyCode||':') > 0)
                    and ( :P528_PARTY IS NULL OR instr(':'||:P528_PARTY||':',':'||a.TransporterCode||':') > 0 )
                    and ( :P528_BILLNO IS NULL OR instr(':'||:P528_BILLNO||':',':'||a.PartyBIllNo||':') > 0 )
                ) x
                Where ( :P528_MODULE IS NULL OR instr(':'||:P528_MODULE||':',':'||x.Module||':') > 0 )   
                and x.Balance > 0 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
