    region visitor-gate-pass-register (
        name: Visitor Gate pass Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region visitor-gate-pass-register-report (
        name: Visitor Gate pass Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.TNo,
                      row_number() over(order by b.VisitorInDate) SerialNo,
                      dbms_lob.getlength(b.CaptureImage) Image,
                      b.VisitorInDate,
                      b.VisitorOutDate,
                      b.VisitorInOutNo,
                      Upper(b.VisitorName) VisitorName,
                      b.ContactNo,
                      Upper(b.VehicleNo) VehicleNo,
                      Upper(b.ContactPerson) ContactPerson,
                      Upper(b.FromCity) FromCity,
                      b.Purpose,
                      GetEmployeeName(b.AllowedByCode) as  Allowedby,
                      GetEmployeeName(b.OutPassByCode) as  OutPassBy,      
                      GetCityName(b.CityCode) as City,
                      GetPartyName(b.PartyCode) as PartyName
                From  VisitorInOutBlob a, VisitorInOut b
                Where a.TNo = b.TNo(+)
                  and Trunc(b.VisitorInDate) Between :P54_FROMDATE and :P54_TODATE
                  and instr(':'||:P54_COMPANY||':',':'||b.CompanyCode||':') > 0
                  and instr(':'||:P54_LOCATION||':',':'||b.LocationCode||':') > 0
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        link {
            linkColumn: singleRowView
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            subscription: false
