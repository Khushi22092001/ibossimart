            sqlQuery: select ShiftName , ShiftCode from shift;
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 60
            region: @pc-tipper-trips-diff-report
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
