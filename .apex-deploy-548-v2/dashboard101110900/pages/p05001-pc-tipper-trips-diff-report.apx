page 5001 (
    name: PC Tipper Trips Diff. Report
    alias: PC-TIPPER-TRIPS-DIFF-REPORT
    title: PC Tipper Trips Diff. Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region pc-tipper-trips-diff-report (
        name: PC Tipper Trips Diff Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                      ROWNUM,
                      Case
                         When ROW_NUMBER()
                          Over(Partition By a.LocationCode Order By a.LocationCode) = 1 Then
                          GETLOCATIONNAME(a.LocationCode)
                         Else
                          Null
                       End Location,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By a.LocationCode,
                                   a.EquipmentLogBookDate Order By a.LocationCode,
                                   a.EquipmentLogBookDate) = 1 Then
                          a.EquipmentLogBookDate
                         Else
                          Null
                       End EquipmentLogBookDate,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By a.LocationCode,
                                   a.EquipmentLogBookDate ,
                                   e.EquipmentName Order By a.LocationCode,
                                   a.EquipmentLogBookDate ,
                                   e.EquipmentName) = 1 Then
                          e.EquipmentName
                         Else
                          Null
                       End EquipmentName,
                       Case
                         When ROW_NUMBER() Over(Partition By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName ,
                                   a.ShiftCode Order By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName,
                                   a.ShiftCode) = 1 Then
                          GETSHIFTNAME(a.ShiftCode)
                         Else
                          Null
                       End ShiftCode,
                       Case
                         When ROW_NUMBER() Over(Partition By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName,
                                   a.ShiftCode,
                                   b.JobTypeCode Order By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName,
                                   a.ShiftCode,
                                   b.JobTypeCode) = 1 Then
                          GETJOBTYPENAME(b.JobTypeCode)
                         Else
                          Null
                       End JobType,
                       --      a.EquipmentLogBookNo,
                       --      b.JobTypeCode,
                       Case
                         When ROW_NUMBER() Over(Partition By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName,
                                   a.ShiftCode,
                                   b.JobTypeCode,
                                   a.TotalTrip Order By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName,
                                   a.ShiftCode,
                                   b.JobTypeCode,
                                   a.TotalTrip) = 1 Then
                          a.TotalTrip
                         Else
                          Null
                       End TotalTrip,
                       --       a.TotalTrip,
                       c.VehicleNo,
                       d.NoOfTrips,
                
                        Case
                         When ROW_NUMBER() Over(Partition By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName,
                                   a.ShiftCode,
                                   b.JobTypeCode,
                                   a.TotalTrip,
                                   f.SumTrip Order By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName,
                                   a.ShiftCode,
                                   b.JobTypeCode,
                                   a.TotalTrip,
                                   f.SumTrip) = 1 Then
                          f.SumTrip
                         Else
                          Null
                       End SumTrip ,
                
                        Case
                         When ROW_NUMBER() Over(Partition By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName,
                                   a.ShiftCode,
                                   b.JobTypeCode,
                                   a.TotalTrip,
                                   f.SumTrip,
                                   f.Diff Order By a.LocationCode,
                                   a.EquipmentLogBookDate,
                                   e.EquipmentName,
                                   a.ShiftCode,
                                   b.JobTypeCode,
                                   a.TotalTrip,
                                   f.SumTrip,
                                   f.Diff) = 1 Then
                          f.Diff
                         Else
                          Null
                       End Diff
                     
                  From EquipmentLogBook       a,
                       EquipmentLogBookDetail b,
                       VehicleLogBook         c,
                       VehicleLogBookDetail   d ,
                       Equipment              e,
                       TripDiff               f
                 Where a.Tno = b.Tno
                   And c.Tno = d.Tno
                   And a.EquipmentTno = d.EquipmentTno
                   And a.EquipmentLogBookDate = c.VehicleLogBookDate
                   And a.ShiftCode = c.ShiftCode
                   And b.JobTypeCode = d.JobTypeCode
                   And a.LocationCode = c.LocationCode
                   And a.EquipmentTno = e.Tno
                   And a.LocationCode = f.LocationCode
                   and a.EquipmentLogBookDate = f.EquipmentLogBookDate
                   And e.Equipmentname = f.Equipmentname
                   And a.EquipmentTno = f.Tno
                   And a.ShiftCode = f.ShiftCode
                   And b.JobTypeCode = f.JobTypeCode
                   And a.TotalTrip = f.TotalTrip
                   And a.equipmentlogbookdate Between :P5001_FROMDATE And :P5001_TODATE
                   and ( :P5001_LOCATION IS NULL OR instr(':'||:P5001_LOCATION||':',':'||a.LocationCode||':') > 0 )
                   and ( :P5001_EQUIPMENTNO IS NULL OR instr(':'||:P5001_EQUIPMENTNO||':',':'||a.EquipmentTno||':') > 0 )
                   and ( :P5001_VEHICLENO IS NULL OR instr(':'||:P5001_VEHICLENO||':',':'||c.VehicleNo||':') > 0 )
                   and ( :P5001_JOBTYPE IS NULL OR instr(':'||:P5001_JOBTYPE||':',':'||b.JobTypeCode||':') > 0 )
                   and ( :P5001_SHIFT IS NULL OR instr(':'||:P5001_SHIFT||':',':'||a.ShiftCode||':') > 0 )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 28949271435745341
        }

        column DIFF (
            type: plainText
            heading {
                heading: Diff
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column EQUIPMENTLOGBOOKDATE (
            type: plainText
            heading {
                heading: Equipment Log Book Date
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column EQUIPMENTNAME (
            type: plainText
            heading {
                heading: Equipment Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column JOBTYPE (
            type: plainText
            heading {
                heading: Job Type
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column LOCATION (
            type: plainText
            heading {
                heading: Location
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column NOOFTRIPS (
            type: plainText
            heading {
                heading: No Of Trips
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column ROWNUM (
            type: plainText
            heading {
                heading: SR. No.
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column SHIFTCODE (
            type: plainText
            heading {
                heading: Shift Code
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column SUMTRIP (
            type: plainText
            heading {
                heading: Sum Trip
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column TOTALTRIP (
            type: plainText
            heading {
                heading: Total Trip
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: Vehicle No
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 1181310 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DIFF (
                sequence: 11
            )

            displayColumn EQUIPMENTLOGBOOKDATE (
                sequence: 3
            )

            displayColumn EQUIPMENTNAME (
                sequence: 4
            )

            displayColumn JOBTYPE (
                sequence: 6
            )

            displayColumn LOCATION (
                sequence: 2
            )

            displayColumn NOOFTRIPS (
                sequence: 9
            )

            displayColumn ROWNUM (
                sequence: 1
            )

            displayColumn SHIFTCODE (
                sequence: 5
            )

            displayColumn SUMTRIP (
                sequence: 10
            )

            displayColumn TOTALTRIP (
                sequence: 7
            )

            displayColumn VEHICLENO (
                sequence: 8
            )

            sort (
                column: ROWNUM
                sort {
                    sequence: 1
                }
            )

            aggregate (
                function: count
                column: ROWNUM
            )

        )

    )

    pageItem P5001_DRIVEROPERATORNAME (
        type: hidden
        layout {
            sequence: 80
            region: @pc-tipper-trips-diff-report
            slot: regionBody
        }
    )

    pageItem P5001_EQUIPMENTNO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Equipment No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.EquipmentName d, a.Tno r
                From equipment a, EquipmentGroup b
                Where a.EquipmentGroupCode = b.EquipmentGroupCode
                and b.Productivity = 'ELB';
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 40
            region: @pc-tipper-trips-diff-report
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P5001_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @pc-tipper-trips-diff-report
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P5001_JOBTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Job Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                      Distinct d.JobTypeName d , 
                                d.JobTypeCode r
                from EquipmentLogBook        a, 
                      VehicleLogBookDetail   b , 
                      EquipmentLogBookDetail c , 
                      JobType                d
                where a.EquipmentTno = b.EquipmentTno     
                  and c.JobTypeCode = b.JobTypeCode
                  and d.JobTypeCode = c.JobTypeCode ;
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 70
            region: @pc-tipper-trips-diff-report
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P5001_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct a.LocationName d, a.LocationCode r
                from Location a , EquipmentLogBook b
                where a.LocationCode = b.LocationCode;
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 30
            region: @pc-tipper-trips-diff-report
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
