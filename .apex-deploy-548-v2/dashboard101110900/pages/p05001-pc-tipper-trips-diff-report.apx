            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct d.VehicleNo d , d.VehicleNo r  from equipmentlogbook a,  Equipment b, EquipmentGroup c,vehiclelogbook d
                where a.EquipmentTno = b.Tno 
                and b.EquipmentGroupCode = c.EquipmentGroupCode
                and a.EquipmentLogBookDate = d.VehicleLogBookDate;
                ```
            nullDisplayValue: -Select-
        }
        layout {
