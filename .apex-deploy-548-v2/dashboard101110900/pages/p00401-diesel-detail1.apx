page 401 (
    name: Diesel Detail
    alias: DIESEL-DETAIL1
    title: Diesel Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region diesel-detail (
        name: Diesel Detail
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent10
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Rownum as SerialNo,
                a.NecessitySlipNo,
                a.NecessitySlipDate,
                a.VehicleNo,
                c.TransporterName,
                c.TransporterCode,
                f.LocationName,
                f.LocationCode,
                g.CompanyName,
                b.Quantity1,
                round(abs(e.Amount) / b.Quantity1, 2) as Rate,
                round(abs(e.Amount),2) as Amount,
                'DETAIL'
                From NecessitySlip a, NecessitySlipDetail b, Transporter c, Voucher d, VoucherDetail e, Location f, Company g
                Where a.Tno = b.Tno
                and a.TransporterCode = c.TransporterCode(+)
                and b.VehicleNecessityCode in (Select a.VehicleNecessityCode From VehicleNecessityForDiesel a)
                and a.Tno = d.ModuleTno
                and d.Tno = e.Tno
                and a.LocationCode = f.LocationCode
                and a.CompanyCode = g.CompanyCode
                and nvl(e.Amount, 0) < 0
                and a.VehicleGroupCode != 'SELF'
                and a.EquipmentTno is null
                and a.NecessitySlipDate between :P401_FROMDATE and :P401_TODATE
                and (:P401_COMPANY is Null Or Instr (':' || :P401_COMPANY|| ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P401_LOCATION is Null Or Instr (':' || :P401_LOCATION|| ':' , ':' || a.LocationCode || ':') > 0)
                and (:P401_PARTY is Null Or Instr (':' || :P401_PARTY|| ':' , ':' || a.TransporterCode || ':') > 0)
                UNION ALL
                Select
                Rownum as SerialNo,
                a.NecessitySlipNo,
                a.NecessitySlipDate,
                a.VehicleNo,
                c.TransporterName,
                c.TransporterCode,
                h.LocationName,
                h.LocationCode,
                i.CompanyName,
                b.Quantity1,
                round(abs(g.Amount) / b.Quantity1, 2) as Rate,
                round(abs(g.Amount),2) as Amount,
                'DETAIL'
                From NecessitySlip a, NecessitySlipDetail b, Transporter c, Requisition d, Issue e, Voucher f, VoucherDetail g,Location h, Company i
                Where a.Tno = b.Tno
                and a.TransporterCode = c.TransporterCode(+)
                and b.VehicleNecessityCode in (Select a.VehicleNecessityCode From VehicleNecessityForDiesel a)
                and a.Tno = d.ModuleTno
                and d.Tno = e.RequisitionTno
                and e.Tno = f.ModuleTno
                and f.Tno = g.Tno
                and a.LocationCode = h.LocationCode
                and a.CompanyCode = i.CompanyCode
                and nvl(g.Amount, 0) < 0
                and a.VehicleGroupCode != 'SELF'
                and a.EquipmentTno is null
                and a.NecessitySlipDate between :P401_FROMDATE and :P401_TODATE
                and (:P401_COMPANY is Null Or Instr (':' || :P401_COMPANY|| ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P401_LOCATION is Null Or Instr (':' || :P401_LOCATION|| ':' , ':' || a.LocationCode || ':') > 0)
                and (:P401_PARTY is Null Or Instr (':' || :P401_PARTY|| ':' , ':' || a.TransporterCode || ':') > 0)
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 2696124195509839
        }

