page 654 (
    name: Location Sales Analysis
    alias: LOCATION-SALES-ANALYSIS
    title: Location Sales Analysis
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            LOCATION SALES ANALYSIS (HSPL) — one location for the period.
            Value = SUM(CCInvoiceDetail.Amount); tax pre-aggregated to (Tno,Sno).
            Panel guard repeated on every region (scalar-subquery form). Read-only.
            Reached from page 653 (location bar / KPI cards); Back returns to 653.
            The item chart deliberately does NOT carry a customer scope — from a
            location the item view widens to all customers there.
            ```
    }

    region command-header (
        name: Location Sales Analysis
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-sales-head">'
                  || '<div class="ds-sales-head-eyebrow">Location &middot; Sales Intelligence</div>'
                  || '<h1 class="ds-sales-head-title">'
                     || apex_escape.html(nvl(GetLocationName(:P654_LOCATION_CODE),
                          nvl(:P654_LOCATION_CODE,'All locations'))) || '</h1>'
                  || '<div class="ds-sales-head-sub">Sales value, monthly shape, customer and '
                     || 'item mix for this location over the selected period.</div>'
                  || '<div class="ds-sales-head-context">'
                  || '<span class="ds-chip"><span class="fa fa-calendar ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Period</span><b>'
                     || apex_escape.html(:P654_FROMDATE) || ' &ndash; ' || apex_escape.html(:P654_TODATE) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-building-o ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Company</span><b>'
                     || apex_escape.html(nvl(GetCompanyName(:P654_COMPANY),'All companies')) || '</b></span>'
                  || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                          Then '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                               || '<span class="ds-chip-k">Panel</span><b>'
                               || apex_escape.html((Select GetUserPanelAB_apex() From dual)) || ' (enforced)</b></span>'
                          Else '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                               || '<span class="ds-chip-k">Panel</span><b>'
                               || apex_escape.html(nvl(:P654_PANEL,'A + B')) || '</b></span>' End
                  || '<span class="ds-chip ds-chip--live"><span class="fa fa-calendar-check-o ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Invoices as of</span><b>'
                     || apex_escape.html(nvl(to_char((Select Max(a.CCInvoiceDate) From CCInvoice a
                          Where (
                              :P654_LOCATION_CODE Is Null Or a.LocationCode = :P654_LOCATION_CODE
                          )
                            And ((Select GetUserPanelAB_apex() From dual) Is Null
                                 Or a.Panel = (Select GetUserPanelAB_apex() From dual))),'DD-Mon-RRRR'),'no invoices')) || '</b></span>'
                  || '</div></div>' As HEAD
                From dual
                ```
            pageItemsToSubmit: [
                P654_FROMDATE
                P654_TODATE
                P654_COMPANY
                P654_LOCATION_CODE
                P654_PANEL
            ]
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
            cssClasses: ds-sales-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Header unavailable.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region customer-chart (
        name: Top Customers at this Location
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select CUST_NAME, PARTY_CODE, VALUE_LAC From (
                  Select GetPartyName(a.PartyCode) CUST_NAME, a.PartyCode PARTY_CODE,
                         Round(Sum(b.Amount)/100000,2) VALUE_LAC
                    From CCInvoice a Join CCInvoiceDetail b On b.TNo = a.TNo
                   Where a.CCInvoiceDate >= to_date(:P654_FROMDATE,'DD-MM-RRRR')
                     And a.CCInvoiceDate <  to_date(:P654_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (
                         :P654_PANEL   Is Null Or a.Panel        = :P654_PANEL
                     )
                     And (
                         :P654_COMPANY Is Null Or a.CompanyCode  = :P654_COMPANY
                     )
                     And (
                         :P654_LOCATION_CODE Is Null Or a.LocationCode = :P654_LOCATION_CODE
                     )
                   Group By a.PartyCode
                  Having Sum(b.Amount) > 0
                   Order By Sum(b.Amount) Desc)
                 Where Rownum <= 10
                 Order By VALUE_LAC
                ```
            pageItemsToSubmit: [
                P654_FROMDATE
                P654_TODATE
                P654_COMPANY
                P654_LOCATION_CODE
                P654_PANEL
            ]
        }
        layout {
            sequence: 50
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 300
        }
        messages {
            whenNoDataFound: No customer sales at this location and period.
        }

        series cust (
            name: Sales Value (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: CUST_NAME
                value: VALUE_LAC
            }
            link {
                type: redirectThisApp
                target: {
                    page: 655
                    items: {
                        P655_PARTY_CODE: &PARTY_CODE.
                        P655_FROMDATE: &P654_FROMDATE.
                        P655_TODATE: &P654_TODATE.
                        P655_COMPANY: &P654_COMPANY.
                        P655_LOCATION: &P654_LOCATION_CODE.
                        P655_PANEL: &P654_PANEL.
                    }
                    clearCache: 655
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region customer-summary (
        name: Customer Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Tax As (
                       Select TNo, SNo,
                              Sum(Decode(FooterHeadCode,'.CGST.',FooterValue,'.SGST.',FooterValue,
                                         '.IGST.',FooterValue,'.TCS.',FooterValue,0)) LineTax
                         From CCInvoiceDetailFooter Group By TNo, SNo)
                Select a.PartyCode As PARTYCODE,
                       GetPartyName(a.PartyCode) As CUSTOMER,
                       Count(Distinct a.TNo) As INVOICES,
                       Count(b.SNo) As LINES,
                       Sum(b.Amount) As SALES_VALUE,
                       Sum(nvl(tx.LineTax,0)) As TAX,
                       Sum(b.TotalAmount) As TOTAL_VALUE,
                       Max(a.CCInvoiceDate) As LAST_INVOICE
                  From CCInvoice a
                  Join CCInvoiceDetail b On b.TNo = a.TNo
                  Left Join Tax tx On tx.TNo = b.TNo And tx.SNo = b.SNo
                 Where a.CCInvoiceDate >= to_date(:P654_FROMDATE,'DD-MM-RRRR')
                   And a.CCInvoiceDate <  to_date(:P654_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P654_PANEL   Is Null Or a.Panel        = :P654_PANEL
                   )
                   And (
                       :P654_COMPANY Is Null Or a.CompanyCode  = :P654_COMPANY
                   )
                   And (
                       :P654_LOCATION_CODE Is Null Or a.LocationCode = :P654_LOCATION_CODE
                   )
                 Group By a.PartyCode
                 Order By Sum(b.Amount) Desc
                ```
            pageItemsToSubmit: [
                P654_FROMDATE
                P654_TODATE
                P654_COMPANY
                P654_LOCATION_CODE
                P654_PANEL
            ]
        }
        layout {
            sequence: 70
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No customer had sales at this location and period.
        }
        advanced {
            savedReportMappingIdentifier: 28082857287250082
        }

