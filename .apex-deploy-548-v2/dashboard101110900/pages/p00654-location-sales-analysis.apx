            columnMapping {
                label: ITEM_NAME
                value: VALUE_LAC
            }
            link {
                type: redirectThisApp
                target: {
                    page: 656
                    items: {
                        P656_ITEM_CODE: &ITEM_CODE.
                        P656_FROMDATE: &P654_FROMDATE.
                        P656_TODATE: &P654_TODATE.
                        P656_COMPANY: &P654_COMPANY.
                        P656_LOCATION: &P654_LOCATION_CODE.
                        P656_PANEL: &P654_PANEL.
