    region kpi-strip (
        name: Location Snapshot
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Tax As (
                       Select TNo, SNo,
                              Sum(Decode(FooterHeadCode,'.CGST.',FooterValue,'.SGST.',FooterValue,
                                         '.IGST.',FooterValue,'.TCS.',FooterValue,0)) LineTax
                         From CCInvoiceDetailFooter Group By TNo, SNo),
                Cur As (
                       Select a.TNo, a.PartyCode, b.SNo, b.ItemCode, b.Amount, b.TotalAmount,
                              nvl(tx.LineTax,0) LineTax
                         From CCInvoice a
                         Left Join CCInvoiceDetail b On b.TNo = a.TNo
                         Left Join Tax tx On tx.TNo = b.TNo And tx.SNo = b.SNo
                        Where a.CCInvoiceDate >= to_date(:P654_FROMDATE,'DD-MM-RRRR')
                          And a.CCInvoiceDate <  to_date(:P654_TODATE,'DD-MM-RRRR') + 1
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (
                              :P654_PANEL   Is Null Or a.Panel        = :P654_PANEL
                          )
                          And (
                              :P654_COMPANY Is Null Or a.CompanyCode  = :P654_COMPANY
                          )
                          And (:P654_LOCATION_CODE Is Null Or a.LocationCode = :P654_LOCATION_CODE)),
                Agg As (
                       Select Sum(Amount) Val, Sum(TotalAmount) Inv, Sum(LineTax) Tax,
                              Count(SNo) Lines, Count(Distinct TNo) Invoices,
                              Count(Distinct ItemCode) Items, Count(Distinct PartyCode) Parties
                         From Cur)
                Select
                  '<div class="ds-kpi ds-kpi--value"><span class="ds-kpi-ic"><span class="fa fa-inr"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Sales Value</span><span class="ds-kpi-n">'
                  || Case When nvl(Val,0) >= 10000000 Then 'Rs ' || to_char(Round(Val/10000000,2),'FM99G990D00') || ' Cr'
                          When nvl(Val,0) >= 100000 Then 'Rs ' || to_char(Round(Val/100000,2),'FM99G990D00') || ' L'
                          Else 'Rs ' || to_char(nvl(Val,0),'FM99G99G990D00') End
                  || '</span><span class="ds-kpi-sub">taxable line value</span></span></div>' As KPI1,
                  '<div class="ds-kpi ds-kpi--input"><span class="ds-kpi-ic"><span class="fa fa-list-alt"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Invoices</span><span class="ds-kpi-n">'
                  || to_char(nvl(Invoices,0),'FM999G999G999') || '</span><span class="ds-kpi-sub">'
                  || to_char(nvl(Lines,0),'FM999G999') || ' lines</span></span></div>' As KPI2,
                  '<div class="ds-kpi ds-kpi--users"><span class="ds-kpi-ic"><span class="fa fa-users"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Customers</span><span class="ds-kpi-n">'
                  || to_char(nvl(Parties,0),'FM999G999') || '</span><span class="ds-kpi-sub">distinct parties invoiced</span></span></div>' As KPI3,
                  '<div class="ds-kpi ds-kpi--suppl"><span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Items Sold</span><span class="ds-kpi-n">'
                  || to_char(nvl(Items,0),'FM999G999') || '</span><span class="ds-kpi-sub">distinct items</span></span></div>' As KPI4,
                  '<div class="ds-kpi ds-kpi--struct"><span class="ds-kpi-ic"><span class="fa fa-calculator"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Average Invoice Value</span><span class="ds-kpi-n">'
                  || Case When nvl(Invoices,0) = 0 Then 'Rs 0'
                          Else Case When Inv/Invoices >= 100000 Then 'Rs ' || to_char(Round(Inv/Invoices/100000,2),'FM99G990D00') || ' L'
                                    Else 'Rs ' || to_char(Round(Inv/Invoices),'FM99G99G990') End End
                  || '</span><span class="ds-kpi-sub">across ' || to_char(nvl(Invoices,0),'FM999G999') || ' invoices</span></span></div>' As KPI5,
                  '<div class="ds-kpi ds-kpi--freight"><span class="ds-kpi-ic"><span class="fa fa-percent"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Total Tax</span><span class="ds-kpi-n">'
                  || Case When nvl(Tax,0) >= 10000000 Then 'Rs ' || to_char(Round(Tax/10000000,2),'FM99G990D00') || ' Cr'
                          When nvl(Tax,0) >= 100000 Then 'Rs ' || to_char(Round(Tax/100000,2),'FM99G990D00') || ' L'
                          Else 'Rs ' || to_char(nvl(Tax,0),'FM99G99G990D00') End
                  || '</span><span class="ds-kpi-sub">'
                  || Case When nvl(Val,0) > 0 Then to_char(Round(100*nvl(Tax,0)/Val,1),'FM99999990D0') || '% of sales value' Else 'no sales value' End
                  || '</span></span></div>' As KPI6
                From Agg
                ```
            pageItemsToSubmit: [
                P654_FROMDATE
                P654_TODATE
                P654_COMPANY
                P654_LOCATION_CODE
                P654_PANEL
            ]
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No sales at this location in this period.
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI2 (
            reportColumnQueryId: 2
