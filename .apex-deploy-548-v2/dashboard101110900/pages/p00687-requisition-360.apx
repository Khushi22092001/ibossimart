    region stock-availability (
        name: Current Stock Availability
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Today's balance for each item on this requisition, using the same
                   validated layer model as the Store Command Centre so a store manager
                   can see immediately whether the pending quantity can be met. */
                With Bal As (
                  Select s.ItemCode, s.LocationCode, s.Rate,
                         s.StockQuantity1 - nvl(u.Used,0) Qty
                    From Stock s
                    Left Join (Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                                 From UsedStock us Group By us.StockTno) u On u.StockTno = s.Tno
                   Where ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual)))
                Select d.ItemCode                                   As ITEMCODE,
                       nvl(i.ItemName, d.ItemCode)                  As ITEMNAME,
                       Round(nvl(Sum(d.Quantity1),0)-nvl(Sum(d.IssuedQuantity1),0),3) As PENDING_QTY,
                       Round(nvl((Select Sum(b.Qty) From Bal b
                                   Where b.ItemCode = d.ItemCode
                                     And (r.LocationCode Is Null Or b.LocationCode = r.LocationCode)),0),3) As STOCK_AT_LOCATION,
                       Round(nvl((Select Sum(b.Qty) From Bal b Where b.ItemCode = d.ItemCode),0),3)         As STOCK_ALL_LOCATIONS,
                       Case When nvl(Sum(d.Quantity1),0)-nvl(Sum(d.IssuedQuantity1),0) <= 0.001 Then 'Nothing pending'
                            When nvl((Select Sum(b.Qty) From Bal b
                                       Where b.ItemCode = d.ItemCode
                                         And (r.LocationCode Is Null Or b.LocationCode = r.LocationCode)),0)
                                 >= nvl(Sum(d.Quantity1),0)-nvl(Sum(d.IssuedQuantity1),0)
                            Then 'Can be met here'
                            When nvl((Select Sum(b.Qty) From Bal b Where b.ItemCode = d.ItemCode),0)
                                 >= nvl(Sum(d.Quantity1),0)-nvl(Sum(d.IssuedQuantity1),0)
                            Then 'Needs transfer from another location'
                            Else 'Insufficient stock - procurement needed' End As AVAILABILITY
                  From RequisitionDetail d
                  Join Requisition r On r.Tno = d.Tno
                  Left Join Item i   On i.ItemCode = d.ItemCode
                 Where d.Tno = :P687_REQTNO
                 Group By d.ItemCode, nvl(i.ItemName, d.ItemCode), r.LocationCode
                 Order By 3 Desc
                ```
            pageItemsToSubmit: P687_REQTNO
        }
        layout {
            sequence: 35
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-register
                ds-dense
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }

