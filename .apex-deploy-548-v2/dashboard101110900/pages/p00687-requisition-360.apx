            }
        )

    )

    region linked-issues (
        name: Issues Against This Requisition
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Issue.RequisitionTno is the link. Values come from IssueRegister so
                   they agree with the Issue Register report. */
                Select i.Tno                                        As ISSUETNO,
                       nvl(i.IssueNo,'(unnumbered)')                As ISSUENO,
                       to_char(i.IssueDate,'DD-MM-RRRR')            As ISSUEDATE,
                       trunc(i.IssueDate) - trunc(r.RequisitionDate) As DAYS_TO_ISSUE,
                       nvl(l.LocationName, i.LocationCode)          As LOCATION,
                       nvl(i.DocTypeCode,'-')                       As DOCTYPE,
                       nvl(i.Creator,'-')                           As ISSUED_BY,
                       (Select Count(*) From IssueRegister a Where a.Tno = i.Tno)                    As LINES,
                       (Select Round(nvl(Sum(a.Quantity1),0),3) From IssueRegister a Where a.Tno = i.Tno) As QUANTITY,
                       (Select Round(nvl(Sum(a.Amount),0),2) From IssueRegister a Where a.Tno = i.Tno)    As AMOUNT
                  From Issue i
                  Join Requisition r   On r.Tno = i.RequisitionTno
                  Left Join Location l On l.LocationCode = i.LocationCode
                 Where i.RequisitionTno = :P687_REQTNO
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or i.Panel = (Select GetUserPanelAB_apex() From dual))
                 Order By i.IssueDate
                ```
            pageItemsToSubmit: P687_REQTNO
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-register
                ds-dense
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }

        column AMOUNT (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Amount
                alignment: end
