page 687 (
    name: Requisition 360
    alias: REQUISITION-360
    title: Requisition 360
    pageGroup: @store-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Document level view of a single material requisition, reached from the Store Command Centre (page 684) or from an Issue 360. P687_REQTNO is the Requisition.Tno. Fulfilment is derived from RequisitionDetail: Quantity1 is what was asked for and IssuedQuantity1 is what the store has issued against it, so pending is the difference. RequisitionDetail.DocumentStatusCode is not populated in this database, so status is derived from those quantities rather than from a stored approval state - there is no approval workflow recorded against a requisition in this ERP.
    }

    region command-header (
        name: Requisition Document
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-store-head">'
                    || '<div class="ds-store-eyebrow">Store &middot; Material Requisition</div>'
                    || '<h1 class="ds-store-title">Requisition '
                    || apex_escape.html(nvl(r.RequisitionNo,'(unnumbered)')) || '</h1>'
                    || '<div class="ds-store-sub">What was asked for, what the store has issued against it, and what is still outstanding</div>'
                    || '<div class="ds-store-context">'
                    || '<span class="ds-store-chip"><span class="fa fa-calendar"></span>Requisition Date <b>'
                       || to_char(r.RequisitionDate,'DD-MM-RRRR') || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-clock-o"></span>Open For <b>'
                       || to_char(trunc(sysdate) - trunc(r.RequisitionDate)) || ' days</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl(c.CompanyName, r.CompanyCode)) || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl(l.LocationName, r.LocationCode)) || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-file-text-o"></span>Doc Type <b>'
                       || apex_escape.html(nvl(r.DocTypeCode,'-')) || '</b></span>'
                    || Case When d.DepartmentName Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-sitemap"></span>Department <b>'
                            || apex_escape.html(d.DepartmentName) || '</b></span>' End
                    || '<span class="ds-store-chip"><span class="fa fa-user"></span>Raised By <b>'
                       || apex_escape.html(nvl(r.Creator,'-')) || '</b></span>'
                    || Case When r.IssueToEmployeeCode Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-user-o"></span>Issue To <b>'
                            || apex_escape.html(r.IssueToEmployeeCode) || '</b></span>' End
                    /* Fulfilment state is computed, not stored: this ERP leaves
                       DocumentStatusCode empty on every requisition line. */
                    || '<span class="ds-store-chip ds-store-chip--live"><span class="fa fa-tasks"></span>Fulfilment <b>'
                       || nvl((Select Case When Sum(nvl(rd.Quantity1,0)) <= 0 Then 'No quantity'
                                           When Sum(nvl(rd.IssuedQuantity1,0)) >= Sum(nvl(rd.Quantity1,0)) - 0.001 Then 'Fully issued'
                                           When Sum(nvl(rd.IssuedQuantity1,0)) > 0 Then 'Partly issued'
                                           Else 'Nothing issued' End
                                From RequisitionDetail rd Where rd.Tno = r.Tno),'-') || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || apex_escape.html(nvl(r.Panel,'-')) || '</b></span>'
                    || Case When r.Remark Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-comment-o"></span>Remark <b>'
                            || apex_escape.html(r.Remark) || '</b></span>' End
                    || '</div></div>' As HEAD
                  From Requisition r
                  Left Join Company c    On c.CompanyCode    = r.CompanyCode
                  Left Join Location l   On l.LocationCode   = r.LocationCode
                  Left Join Department d On d.DepartmentCode = r.DepartmentCode
                 Where r.Tno = :P687_REQTNO
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or r.Panel = (Select GetUserPanelAB_apex() From dual))
                ```
            pageItemsToSubmit: P687_REQTNO
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-store-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region kpi-strip (
        name: Requisition Totals
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With A As (
                  Select Count(*) Lines,
                         Count(Distinct d.ItemCode) Items,
                         nvl(Sum(d.Quantity1),0) ReqQty,
                         nvl(Sum(d.IssuedQuantity1),0) IssQty,
                         nvl(Sum(nvl(d.Quantity1,0) - nvl(d.IssuedQuantity1,0)),0) PendQty,
                         Count(Case When nvl(d.Quantity1,0) - nvl(d.IssuedQuantity1,0) > 0.001 Then 1 End) OpenLines
                    From RequisitionDetail d Where d.Tno = :P687_REQTNO),
                     R As (Select trunc(sysdate) - trunc(RequisitionDate) AgeDays
                             From Requisition Where Tno = :P687_REQTNO)
                Select '<div class="ds-kpi ds-kpi--input" title="Sum of RequisitionDetail.Quantity1 - what was asked for">'
                    || '<span class="ds-kpi-ic fa fa-list-alt"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">REQUESTED</div><div class="ds-kpi-n">'
                    || to_char(a.ReqQty,'FM999G999G990D000') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.Lines,'FM999G990')||' lines &middot; '
                       ||to_char(a.Items,'FM999G990')||' items</div>'
                    || '</div></div>' As KPI1,
                
                       '<div class="ds-kpi ds-kpi--ok" title="Sum of RequisitionDetail.IssuedQuantity1 - what the store has issued">'
                    || '<span class="ds-kpi-ic fa fa-check-circle-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">ISSUED</div><div class="ds-kpi-n">'
                    || to_char(a.IssQty,'FM999G999G990D000') || '</div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When a.ReqQty > 0 Then to_char(a.IssQty/a.ReqQty*100,'FM990D0')||'% fulfilled'
                              Else 'Nothing requested' End||'</div>'
                    || '</div></div>' As KPI2,
                
                       '<div class="ds-kpi ds-kpi--'||Case When a.PendQty > 0.001 Then 'pend' Else 'ok' End
                       ||'" title="Requested less issued - what the store still owes">'
                    || '<span class="ds-kpi-ic fa fa-hourglass-half"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">PENDING</div><div class="ds-kpi-n">'
                    || to_char(a.PendQty,'FM999G999G990D000') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.OpenLines,'FM999G990')||' lines still open</div>'
                    || '</div></div>' As KPI3,
                
                       '<div class="ds-kpi ds-kpi--'||Case When r.AgeDays > 30 And a.PendQty > 0.001 Then 'risk' Else 'bill' End
                       ||'" title="Days since the requisition was raised">'
                    || '<span class="ds-kpi-ic fa fa-clock-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">AGE</div><div class="ds-kpi-n">'
                    || to_char(r.AgeDays,'FM999G990') || '<i>d</i></div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When a.PendQty <= 0.001 Then 'Closed - fully issued'
                              When r.AgeDays > 60 Then 'Critical - over 60 days open'
                              When r.AgeDays > 30 Then 'Overdue - over 30 days open'
                              Else 'Within 30 days' End||'</div>'
                    || '</div></div>' As KPI4
                From A a Cross Join R r
                ```
            pageItemsToSubmit: P687_REQTNO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: KPI1
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI2 (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: KPI2
            }
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI3 (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: KPI3
            }
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
