            heading {
                heading: Availability
            }
            layout {
                sequence: 60
            }
        )

        column ITEMCODE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Item Code
            }
            layout {
                sequence: 10
            }
            link {
