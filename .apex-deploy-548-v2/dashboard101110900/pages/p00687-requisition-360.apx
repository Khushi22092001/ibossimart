    region requisition-lines (
        name: Requisition Lines
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* QOH1 is the quantity on hand captured on the line when the
                   requisition was raised, so it is a point-in-time snapshot and will
                   not agree with today's balance. It is shown as context, not as a
                   current stock figure. */
                Select d.SerialNo                                       As SERIALNO,
                       d.ItemCode                                       As ITEMCODE,
                       nvl(i.ItemName, d.ItemCode)                      As ITEMNAME,
                       nvl(sp.ItemSpecificationName,'-')                As SPECIFICATION,
                       nvl(d.Description,'-')                           As DESCRIPTION,
                       nvl(d.MeasuringUnitCode1, nvl(i.MeasuringUnitCode1,'-')) As UOM,
                       Round(nvl(d.Quantity1,0),3)                      As REQUESTED,
                       Round(nvl(d.IssuedQuantity1,0),3)                As ISSUED,
                       Round(nvl(d.Quantity1,0)-nvl(d.IssuedQuantity1,0),3) As PENDING,
                       Round(nvl(d.QOH1,0),3)                           As QOH_AT_REQUEST,
                       Case When nvl(d.Quantity1,0) - nvl(d.IssuedQuantity1,0) <= 0.001 Then 'Fully issued'
                            When nvl(d.IssuedQuantity1,0) > 0 Then 'Partly issued'
                            Else 'Not issued' End                       As LINE_STATUS,
                       nvl(d.PriorityCode,'-')                          As PRIORITY,
                       nvl(to_char(d.RequiredInDays),'-')               As REQUIRED_IN_DAYS,
                       nvl(sl.StorageLocationName, nvl(d.ToStorageLocationCode,'-')) As TO_STORAGE,
                       nvl(d.Remark,'-')                                As REMARK
                  From RequisitionDetail d
                  Left Join Item i               On i.ItemCode = d.ItemCode
                  Left Join ItemSpecification sp On sp.ItemSpecificationCode = d.ItemSpecificationCode
                  Left Join StorageLocation sl   On sl.StorageLocationCode = d.ToStorageLocationCode
                 Where d.Tno = :P687_REQTNO
                 Order By d.SNo
                ```
            pageItemsToSubmit: P687_REQTNO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-register
                ds-dense
            ]
