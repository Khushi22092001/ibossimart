    pageItem P144_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'GATEPASS'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                Order by 1
                  ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @gate-pass-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Company Name
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
    )

