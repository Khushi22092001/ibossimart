            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/ccinvoiceregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P144_FROMDATE=&P144_FROMDATE.&P144_TODATE=&P144_TODATE.&P144_LOCATION=&P144_LOCATION.&P144_DOCTYPE=&P144_DOCTYPE.&P144_PARTY=&P144_PARTY.&P144_TRANSPORTER=&P144_TRANSPORTER.&P144_ITEM=&P144_ITEM.&P144_ITEMSPECIFICATION=&P144_ITEMSPECIFICATION.&P144_CCINO=&P144_CCINO.&P144_VEHICLENO=&P144_VEHICLENO.&P144_VSTATUS=&P144_VSTATUS.&P144_MISTATUS=&P144_MISTATUS.
