    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/Gate Pass Register Report.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P144_COMPANY.","_paramsP_STATUS":"&P144_STATUS.","_paramsP_FROMDATE":"&P144_FROMDATE.","_paramsP_TODATE":"&P144_TODATE.","_paramsP_LOCATION":"&P144_LOCATION.","_paramsP_PARTY":"&P144_PARTY.","_paramsP_DOCTYPE":"&P144_DOCTYPE.","_paramsP_TRANSPORTER":"&P144_TRANSPORTER.","_paramsP_GATEPASSNO":"&P144_GATEPASSNO.","_paramsP_ITEM":"&P144_ITEM.","_paramsP_DEPARTMENT":"&P144_DEPARTMENT.","_paramsP_ITEMSPECIFICATION":"&P144_ITEMSPECIFICATION."}');
                                                                                                       
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P144_CCINO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P144_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P144_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 11657125273311074
        }
    )

)

