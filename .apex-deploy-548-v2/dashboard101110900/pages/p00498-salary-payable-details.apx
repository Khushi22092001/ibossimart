page 498 (
    name: Salary Payable Details
    alias: SALARY-PAYABLE-DETAILS
    title: Salary Payable Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region salary-payable-details (
        name: Salary Payable Details
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
    )

    region salary-payable-details-report (
        name: Salary Payable Details Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    a.EmployeeID,
                    a.EmployeeName,
                    b.BankName,
                    a.IFSCCode,
                    a.BankAccountNo,
                    SUM (CASE WHEN d.SalaryHeadCode = 'NETEARNING' Then d.SalaryHeadAmount ELSE 0 END) as Salary,
                    SUM (CASE WHEN d.SalaryHeadCode = 'OT' Then d.SalaryHeadAmount ELSE 0 END) as Exgratia,
                    SUM (CASE WHEN d.SalaryHeadCode = 'NETEARNING' Then d.SalaryHeadAmount ELSE 0 END) + 
                    SUM (CASE WHEN d.SalaryHeadCode = 'OT' Then d.SalaryHeadAmount ELSE 0 END) as Total
                From Employee a, Bank b, Salary c, SalaryDetail d
                Where a.BankCode = b.BankCode (+)
                    and a.EmployeeCode = c.EmployeeCode (+)
                    and c.Tno = d.Tno (+)
                    and d.SalaryHeadCode IN ('NETEARNING', 'OT')
                    and ( :P498_COMPANY IS NULL OR instr(':'||:P498_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and ( :P498_EMPLOYEE IS NULL OR instr(':'||:P498_EMPLOYEE||':',':'||a.EmployeeCode||':') > 0 )
                    and  to_char(c.SalaryFromDate,'MON-RRRR') = :P498_MONTH
                Group by a.EmployeeID,
                a.EmployeeName,
                b.BankName,
                a.IFSCCode,
                a.BankAccountNo
                Having SUM (CASE WHEN d.SalaryHeadCode = 'NETEARNING' Then d.SalaryHeadAmount ELSE 0 END) > 0 
                Order by a.EmployeeID asc;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 24492063398945680
        }

        column BANKACCOUNTNO (
            type: plainText
            heading {
                heading: Bank A/C No.
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column BANKNAME (
            type: plainText
            heading {
                heading: Bank
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column EMPLOYEEID (
            type: plainText
            heading {
                heading: Employee ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column EMPLOYEENAME (
            type: plainText
            heading {
                heading: Employee
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EXGRATIA (
            type: plainText
            heading {
                heading: Exgratia
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column IFSCCODE (
            type: plainText
            heading {
                heading: IFSC Code
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column SALARY (
            type: plainText
            heading {
                heading: Salary
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column TOTAL (
            type: plainText
            heading {
                heading: Total
                alignment: end
            }
            layout {
                sequence: 17
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Salary Payable Details
        }

        savedReport 245056 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BANKACCOUNTNO (
                sequence: 5
            )

            displayColumn BANKNAME (
                sequence: 3
            )

            displayColumn EMPLOYEEID (
                sequence: 1
            )

            displayColumn EMPLOYEENAME (
                sequence: 2
            )

            displayColumn EXGRATIA (
                sequence: 7
            )

            displayColumn IFSCCODE (
                sequence: 4
            )

            displayColumn SALARY (
                sequence: 6
            )

            displayColumn TOTAL (
                sequence: 8
            )

        )

    )

    pageItem P498_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct 
                b.CompanyName as d, 
                a.CompanyCode as r 
                From Employee a, Company b
                Where a.CompanyCode = b.CompanyCode (+);
                ```
        }
        layout {
            sequence: 30
            region: @salary-payable-details
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P498_EMPLOYEE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Employee
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                a.EmployeeName as d,
                a.EmployeeCode as r
                From Employee a;
                ```
        }
        layout {
            sequence: 20
            region: @salary-payable-details
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P498_MONTH (
        type: datePicker
        label {
            label: Month
            alignment: left
        }
        layout {
            sequence: 10
            region: @salary-payable-details
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: MON-RRRR
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 40
            region: @salary-payable-details
            slot: regionBody
            column: 12
            columnSpan: 1
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

