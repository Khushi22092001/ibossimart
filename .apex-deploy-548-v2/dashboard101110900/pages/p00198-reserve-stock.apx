            regionDisplaySelector: true
        }
    )

    region reserve-stock-2 (
        name: Reserve Stock
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.tno As LoadingSlipTNO,
                       a.tno As ReservestockstoragedetailTno,
                       B.Loadingslipno,
                       b.Loadingslipdate,
                       getpartyname(b.partycode) As Party,
                       c.ItemCode,
                       c.Itemspecificationcode,
                       getitemname(c.ItemCode) As ItemName,
                       getitemspecificationname(c.itemcode, c.Itemspecificationcode) As Specification,
                       Sum(Nvl(a.reservestockquantity1, 0) - Nvl(a.freestockquantity1, 0)) As ReserveQty1,
                       Sum(Nvl(a.reservestockquantity2, 0) - Nvl(a.freestockquantity2, 0)) As ReserveQty2
                  From Reservestockstoragedetail a, Loadingslip b, LoadingSlipDetail c
                 Where a.moduletno = b.tno(+)
                   And a.Modulesno = c.sno(+)
                   And Nvl(a.reservestockquantity1, 0) - Nvl(a.freestockquantity1, 0) != 0
                ----
                
                 -- AND LENGTH(:P198_FROMDATE) > 0 
                  and instr(':'||:P198_COMPANY||':',':'||b.CompanyCode||':') > 0
                  and instr(':'||:P198_LOCATION||':',':'||b.LocationCode||':') > 0
                  AND ( :P198_ITEM IS NULL OR instr(':'||:P198_ITEM||':',':'||c.ItemCode||':') > 0 )
                  AND ( :P198_ITEMSPECIFICATION IS NULL OR instr(':'||:P198_ITEMSPECIFICATION||':',':'||c.ItemSpecificationCode||':') > 0 )
                --  AND ( :P58_ITEMGROUP IS NULL or instr(':'||:P58_ITEMGROUP||':',':'||a.ParentCode||':') > 0 )
                  AND ( :P198_STORAGELOCATION IS NULL OR instr(':'||:P198_STORAGELOCATION||':',':'||a.StorageLocationCode||':') > 0 ) 
                
                ----
                 Group By b.tno,
                          B.Loadingslipno,
                          b.Loadingslipdate,
                          getpartyname(b.partycode),
                          c.ItemCode,
                          c.Itemspecificationcode,
                          getitemname(c.ItemCode),
                          getitemspecificationname(c.itemcode, c.Itemspecificationcode),
                          a.tno
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
