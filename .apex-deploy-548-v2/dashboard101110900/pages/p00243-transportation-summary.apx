page 243 (
    name: Transporter Summary
    alias: TRANSPORTATION-SUMMARY
    title: Transporter Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region transport-summary-report (
        name: Transport Summary Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    ROWNUM AS SERIALNO,
                    a.PARTYNAME,
                    a.ITEMSPECIFICATION, 
                    a.TransporterName,
                    round(SUM(a.QUANTITY),3) AS TOTALQUANTITY,
                    a.Creator
                from 
                    (Select   
                        B.PARTYNAME,
                        C.ITEMNAME || ' - ' || D.ITEMSPECIFICATIONNAME as ITEMSPECIFICATION, 
                        g.TransporterName,
                        NVL(A.NOS,0) BAGS,
                        Case When g.TransporterName = 'SELF' then
                        NVL(A.NOS,0) end as OWNBAGS,
                        Case When g.TRANSPORTERName!='SELF' then
                        NVL(A.NOS,0) end as OTHERBAGS,
                        NVL(A.QUANTITY1,0) as QUANTITY,
                        Case When g.TransporterName = 'SELF' then
                        NVL(A.QUANTITY1,0) end as OWNQUANTITY,
                        Case When g.TRANSPORTERName!='SELF' then
                        NVL(A.QUANTITY1,0) end as OTHERQUANTITY,
                        a.Creator
                
                    FROM   LR A, 
                           PARTY B,
                           ITEM C, 
                           ITEMSPECIFICATION D, 
                           LOCATION F,
                           Transporter g
                    WHERE 
                        A.PARTYCODE=B.PARTYCODE(+)
                        AND A.ITEMCODE = C.ITEMCODE(+)
                        AND A.ITEMSPECIFICATIONCODE = D.ITEMSPECIFICATIONCODE(+)
                        AND A.LOCATIONCODE = F.LOCATIONCODE(+)
                        and a.TransporterCode = g.TransporterCode(+)
                        and a.LRDate between :P243_FROMDATE and :P243_TODATE
                        and ( :P243_TRANSPORTER IS NULL OR instr(':'||:P243_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 ) 
                        and ( :P243_PARTY IS NULL OR instr(':'||:P243_PARTY||':',':'||b.PartyCode||':') > 0 )
                      ) a
                Group by
                    a.PARTYNAME,
                    a.ITEMSPECIFICATION, 
                    a.TransporterName,
                    a.Creator,
                    ROWNUM;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 24116702713260437
        }

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column ITEMSPECIFICATION (
            type: plainText
            heading {
                heading: Item with Specification
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PARTYNAME (
            type: plainText
            heading {
                heading: Party Name
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column TOTALQUANTITY (
            type: plainText
            heading {
                heading: Total Quantity
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column TRANSPORTERNAME (
            type: plainText
            heading {
                heading: Transporter
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Transport Summary Report
        }

        savedReport 241478 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATOR (
                sequence: 6
            )

            displayColumn ITEMSPECIFICATION (
                sequence: 3
            )

            displayColumn PARTYNAME (
                sequence: 2
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TOTALQUANTITY (
                sequence: 5
            )

            displayColumn TRANSPORTERNAME (
                sequence: 4
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: TOTALQUANTITY
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region transporter-summary (
        name: Transporter Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P243_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @transporter-summary
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P243_PARTY (
        type: popupLov
        label {
            label: Party
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                a.PartyName,
                a.PartyCode
                From Party a,LR b
                Where b.PartyCode = a.PartyCode
                
                ```
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 50
            region: @transporter-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P243_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @transporter-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P243_TRANSPORTER (
        type: popupLov
        label {
            label: Transporter
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                TransporterName d,
                TransporterCode r
                From transporter ;
                ```
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 40
            region: @transporter-summary
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 60
            region: @transporter-summary
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

