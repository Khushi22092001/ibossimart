    region creditors-aging-report (
        name: Creditors Aging Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With t_Allocated as (
                	select 
                		aa.DrVoucherTNo as VoucherTNo,
                		aa.DrVoucherSNo as VoucherSNo,
                		round(-1 * sum(aa.Amount),2) as AllocatedAmount 
                	from DrCrAllocation aa, Voucher bb, Voucher cc 
                	where aa.DrVoucherTNo = bb.TNo
                		and aa.CrVoucherTNo = cc.TNo
                        and bb.VoucherDate <= :P425_ASONDATE
                        and cc.VoucherDate <= :P425_ASONDATE
                	group by 
                		aa.DrVoucherTNo,
                		aa.DrVoucherSNo
                	union all
                	select 
                		aa.CrVoucherTNo as VoucherTNo,
                		aa.CrVoucherSNo as VoucherSNo,
                		round(sum(aa.Amount),2) as AllocatedAmount
                	from DrCrAllocation aa, Voucher bb, Voucher cc 
                	where aa.DrVoucherTNo = bb.TNo
                		and aa.CrVoucherTNo = cc.TNo
                        and bb.VoucherDate <= :P425_ASONDATE
                        and cc.VoucherDate <= :P425_ASONDATE
                	group by 
                		aa.CrVoucherTNo,
                		aa.CrVoucherSNo
                ), t_Bill as (
                	select 
                		aa.TNo,
                		bb.PartyBillNo,
                		bb.PartyBillDate
                	from PBPass aa, PurchaseBill bb 
                	where aa.PurchaseBillTNo = bb.TNo
                	union all
                	select 
                		aa.TNo,
                		bb.PartyBillNo,
                		bb.PartyBillDate
                	from JBPass aa, JobBill bb 
                	where aa.JobBillTNo = bb.TNo
                	union all
                	select 
                		aa.TNo,
                		aa.PartyBillNo,
                		aa.PartyBillDate
                	from FreightAdvice aa
                	union all
                	select 
                		aa.TNo,
                		aa.PartyBillNo,
                		aa.PartyBillDate
                	from CashPurchase aa
                	union all
                	select 
                		aa.TNo,
                		aa.PartyBillNo,
                		aa.PartyBillDate
                	from MiscellaneousExpense aa
                	union all
                	select 
                		aa.TNo,
                		aa.BillNo AS PartyBillNo,
                		aa.BillDate as PartyBillDate
                	from ExternalServicesEntry aa
                	union all
                	select 
                		aa.TNo,
                		aa.PartyBillNo,
                		aa.PartyBillDate
                	from NecessityCompletion aa
                ---- Dt.22-May-2023
                  union all
                	select 
                		aa.TNo,
                		aa.CCInvoiceNo,
                		aa.CCInvoiceDate
                	from CCInvoice aa
                  union all
                	select 
                		aa.TNo,
                		aa.ServiceBillNo,
                		aa.ServiceBillDate
                	from ServiceBill aa
                  union all
                	select 
                		aa.TNo,
                		aa.CreditNoteNo,
                		aa.CreditNoteDate
                	from CreditNote aa
                ), t_Balance as (
                        select 
                            a.TNo,
                            a.SNo,
                            a.VoucherDate,
                            b.VoucherNo,
                            a.LocationCode,
                            d.BillNo as PartyBillNo,
                            d.BillDate as PartyBillDate,
                            trunc(sysdate) - nvl(d.BillDate, a.VoucherDate) as BillAge,
                            a.AccountCode,
                            round(a.Amount,2) as VoucherAmount,
                            round(c.AllocatedAmount,2) as AllocatedAmount,
                            round(a.Amount - nvl(c.AllocatedAmount, 0),2) as BalanceAmount
                        from VoucherDetail a, Voucher b, t_Allocated c, AccountOpening d 
                        where a.TNo = b.TNo
                            and a.TNO= c.VoucherTNo(+)
                            and a.SNo = c.VoucherSNo(+)
                            and a.ModuleTNo = d.TNo(+)
                            and b.VoucherNo = 'OPENING'
                            and round(a.Amount - nvl(c.AllocatedAmount, 0), 0) != 0
                            and a.VoucherDate <= :P425_ASONDATE
                            and ( :P425_LOCATION IS NULL OR instr(':'||:P425_LOCATION||':',':'||a.LocationCode||':') > 0)
                            and ( :P425_PARTY IS NULL OR instr(':'||:P425_PARTY||':',':'||a.AccountCode||':') > 0 )
                            and ( :P425_COMPANY IS NULL OR instr(':'||:P425_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                            and a.LocationCode is not null   
                        union all
                        select 
                            a.TNo,
                            a.SNo,
                            a.VoucherDate,
                            b.VoucherNo,
                            a.LocationCode,
                            d.PartyBillNo,
                            d.PartyBillDate,
                            trunc(sysdate) - nvl(d.PartyBillDate, a.VoucherDate) as BillAge,
                            a.AccountCode,
                            round(a.Amount,2) as VoucherAmount,
                            round(c.AllocatedAmount,2) as AllocatedAmount,
                            round(a.Amount - nvl(c.AllocatedAmount, 0),2) as BalanceAmount
                        from VoucherDetail a, Voucher b, t_Allocated c, t_Bill d 
                        where a.TNo = b.TNo
                            and a.TNO= c.VoucherTNo(+)
                            and a.SNo = c.VoucherSNo(+)
                            and b.ModuleTNo = d.TNo(+)
                            and b.VoucherNo != 'OPENING'
                            and round(a.Amount - nvl(c.AllocatedAmount, 0), 0) != 0
                            and a.VoucherDate <= :P425_ASONDATE
                            and ( :P425_LOCATION IS NULL OR instr(':'||:P425_LOCATION||':',':'||a.LocationCode||':') > 0)
                            and ( :P425_PARTY IS NULL OR instr(':'||:P425_PARTY||':',':'||a.AccountCode||':') > 0 )
                            and ( :P425_COMPANY IS NULL OR instr(':'||:P425_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                            and a.LocationCode is not null
                )  
                select rownum as serialno, xx.* from (
                select 
                   --rownum as serialno,
                    --x.LocationCode,
                    y.PartyName,
                    --sum(case when x.BillAge <= 30 then x.BalanceAmount else 0 end) as Balance0t30,
                    case when sum(case when x.BillAge <= 30 then x.BalanceAmount else 0 end) < 0
                         then sum(case when x.BillAge <= 30 then x.BalanceAmount else 0 end)*-1||' DR'
                         when sum(case when x.BillAge <= 30 then x.BalanceAmount else 0 end) > 0
                         then sum(case when x.BillAge <= 30 then x.BalanceAmount else 0 end)||' CR'
                         ELSE '0' END AS Balanc0to30,
                    --sum(case when x.BillAge between 31 and 60  then x.BalanceAmount else 0 end) as Balance31to60,
                    case when sum(case when x.BillAge between 31 and 60  then x.BalanceAmount else 0 end) < 0
                         then sum(case when x.BillAge between 31 and 60  then x.BalanceAmount else 0 end)*-1||' DR'
                         when sum(case when x.BillAge between 31 and 60  then x.BalanceAmount else 0 end) > 0
                         then sum(case when x.BillAge between 31 and 60  then x.BalanceAmount else 0 end)||' CR'
                         ELSE '0' END AS Balanc31to60,
                    --sum(case when x.BillAge between 61 and 90  then x.BalanceAmount else 0 end) as Balance61to90,
                    case when sum(case when x.BillAge between 61 and 90  then x.BalanceAmount else 0 end) < 0
                         then sum(case when x.BillAge between 61 and 90  then x.BalanceAmount else 0 end)*-1||' DR'
                         when sum(case when x.BillAge between 61 and 90  then x.BalanceAmount else 0 end) > 0
                         then sum(case when x.BillAge between 61 and 90  then x.BalanceAmount else 0 end)||' CR'
                         ELSE '0' END AS Balanc61to90,
                    --sum(case when x.BillAge between 91 and 120  then x.BalanceAmount else 0 end) as Balance91to120,
                    case when sum(case when x.BillAge between 91 and 120  then x.BalanceAmount else 0 end) < 0
                         then sum(case when x.BillAge between 91 and 120  then x.BalanceAmount else 0 end)*-1||' DR'
                         WHEN sum(case when x.BillAge between 91 and 120  then x.BalanceAmount else 0 end) > 0
                         then sum(case when x.BillAge between 91 and 120  then x.BalanceAmount else 0 end)||' CR'
                         ELSE '0' END AS Balanc91to120,
                    --sum(case when x.BillAge between 121 and 150  then x.BalanceAmount else 0 end) as Balance121to150,
                    case when sum(case when x.BillAge between 121 and 150  then x.BalanceAmount else 0 end) < 0
                         then sum(case when x.BillAge between 121 and 150  then x.BalanceAmount else 0 end)*-1||' DR'
                         when sum(case when x.BillAge between 121 and 150  then x.BalanceAmount else 0 end) > 0
                         then sum(case when x.BillAge between 121 and 150  then x.BalanceAmount else 0 end)||' CR'
                         ELSE '0' END AS Balanc121to150,
                    --sum(case when x.BillAge between 151 and 180  then x.BalanceAmount else 0 end) as Balance151to180,
                    case when sum(case when x.BillAge between 151 and 180  then x.BalanceAmount else 0 end) < 0
                         then sum(case when x.BillAge between 151 and 180  then x.BalanceAmount else 0 end)*-1||' DR'
                         when sum(case when x.BillAge between 151 and 180  then x.BalanceAmount else 0 end) > 0
                         then sum(case when x.BillAge between 151 and 180  then x.BalanceAmount else 0 end)||' CR'
                         ELSE '0' END AS Balanc151to180,
                    --sum(case when x.BillAge >= 180 then x.BalanceAmount else 0 end) as BalanceAbove180,
                    CASE WHEN sum(case when x.BillAge > 180 then x.BalanceAmount else 0 end)< 0 
                        THEN sum(case when x.BillAge > 180 then x.BalanceAmount else 0 end)*-1||' DR'
                        WHEN sum(case when x.BillAge > 180 then x.BalanceAmount else 0 end)> 0
                        THEN sum(case when x.BillAge > 180 then x.BalanceAmount else 0 end)||' CR'
                        ELSE '0' END as BalancAbove180,
                    --round(sum(x.BalanceAmount),2) as TotalBalance,
                    CASE WHEN round(sum(x.BalanceAmount),2) < 0 THEN round(sum(x.BalanceAmount),2)*-1||' DR'
                        WHEN round(sum(x.BalanceAmount),2) > 0 THEN round(sum(x.BalanceAmount),2)||' CR'
                        ELSE '0' END AS TotalBalanc,
                    X.AccountCode
                from t_Balance x, Party y
                where x.AccountCode = y.PartyCode
                    and y.PartyTypeCode IN ('CUSTOMER','SUPPLIER','CONTRACTOR','TRANSPORTER')
                    and ( :P425_PARTYTYPE IS NULL OR instr(':'||:P425_PARTYTYPE||':',':'||y.PARTYTYPECODE||':') > 0 )
                    and :P425_ASONDATE is not null
                group by  --x.LocationCode,
                    y.PartyName,
                    x.AccountCode--,
                    --rownum
                having round(sum(x.BalanceAmount), 3) != 0
                order by y.PartyName --, x.LocationCode
                )  xx
                
                
                ```
        }
