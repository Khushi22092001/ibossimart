page 360 (
    name: Internal Balance Details
    alias: INTERNAL-BALANCE-DETAILS
    title: Internal Balance Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/Internal Balance Details.xdo';
              var outputFormat = 'pdf';
              var asonDate = new Date($('#P360_ASONDATE').val());
            
            var reportParams =  
                  '&P360_ASONDATE=' +$('#P360_ASONDATE').val() + 
                  '&P360_COMPANY=' +$('#P360_COMPANY').val() +
                  '&P360_ACCOUNTGROUP=' +$('#P360_ACCOUNTGROUP').val() +
                  '&P360_ACCOUNT=' +$('#P360_ACCOUNT').val()
                  ;
             
                  
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              var reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region internal-balance-details (
        name: Internal Balance Details
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by B.PARTYCODE) SerialNo,
                d.CompanyName,
                b.PartyName as AccountGroupName,
                a.PartyName as AccountName,
                abs(GetAccountDebitDuring(a.PartyCode,c.CompanyCode,f.financialyearbegin,:P360_ASONDATE)) as DR,
                abs(GetAccountCreditDuring(a.PartyCode,c.CompanyCode,f.financialyearbegin,:P360_ASONDATE)) as CR,
                round(decode(GetAccountClosing(a.PartyCode, :P360_ASONDATE, null, c.CompanyCode) - abs(GetAccountClosing(a.PartyCode, :P360_ASONDATE, null, c.CompanyCode)), 0, null, abs(GetAccountClosing(a.PartyCode, :P360_ASONDATE, null, c.CompanyCode))), 2) as DRBalance,
                round(decode(GetAccountClosing(a.PartyCode, :P360_ASONDATE, null, c.CompanyCode) - abs(GetAccountClosing(a.PartyCode, :P360_ASONDATE, null, c.CompanyCode)), 0, GetAccountClosing(a.PartyCode, :P360_ASONDATE, null, c.CompanyCode), null), 2) as CRBalance
                From Party a, party b, PartyCompany c, Company d, Financialyear f
                Where a.ParentCode = b.PartyCode(+)
                and a.Tno = c.Tno(+)
                and c.CompanyCode = d.CompanyCode(+)
                and nvl(a.IsCompanyAccount, 'NO') = 'YES'
                and :P360_ASONDATE between f.financialyearbegin and f.financialyearend
                and :P360_ASONDATE = NVL(:P360_ASONDATE,TRUNC(SYSDATE))
                and ( :P360_COMPANY IS NULL OR instr(':'||:P360_COMPANY||':',':'||c.CompanyCode||':') > 0)
                and ( :P360_ACCOUNTGROUP IS NULL OR instr(':'||:P360_ACCOUNTGROUP||':',':'||a.ParentCode||':') > 0)
                and ( :P360_ACCOUNT IS NULL OR instr(':'||:P360_ACCOUNT||':',':'||a.PartyCode||':') > 0)
                and :P360_ASONDATE is not null
                and b.PartyName !='BRANCH & DIVISIONS'
                and abs(GetAccountClosing(a.PartyCode, :P360_ASONDATE, null, c.CompanyCode)) > 0
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 79525970005410421
        }

