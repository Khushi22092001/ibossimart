            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.PartyName d,
                a.PartyCode r
                From Party a, party b
                Where a.ParentCode = b.PartyCode(+)
                and nvl(a.IsCompanyAccount, 'NO') = 'YES'
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @internal-balance-details
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            labelColumnSpan: 1
