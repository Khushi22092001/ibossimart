page 187 (
    name: "Department Wise WokCentre CostCentre "
    alias: DEPARTMENT-WISE-WOKCENTRE-COSTCENTRE
    title: "Department Wise WokCentre CostCentre "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region department-wise-work-centre-cost-centre (
        name: Department Wise Work Centre Cost Centre
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.departmentcode,
                       a.departmentname,
                       b.workcentrecode,
                       b.workcentrename,
                       c.costcentrecode,
                       c.costcentrename
                /*Case
                         When ROW_NUMBER()
                          Over(Partition By a.departmentcode Order By A.departmentcode) = 1 Then
                          A.departmentcode
                         Else
                          Null
                       End departmentcode,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By a.departmentcode Order By A.departmentcode) = 1 Then
                          A.departmentname
                         Else
                          Null
                       End departmentname,
                       Case
                         When ROW_NUMBER() Over(Partition By a.departmentcode,
                                   b.workcentrecode Order By A.departmentcode,
                                   b.workcentrecode) = 1 Then
                          b.workcentrecode
                         Else
                          Null
                       End workcentrecode,
                       Case
                         When ROW_NUMBER() Over(Partition By a.departmentcode,
                                   b.workcentrecode Order By A.departmentcode,
                                   b.workcentrecode) = 1 Then
                          b.workcentrename
                         Else
                          Null
                       End workcentrename,
                       Case
                         When ROW_NUMBER() Over(Partition By a.departmentcode,
                                   b.workcentrecode,
                                   c.costcentrecode Order By A.departmentcode,
                                   b.workcentrecode,
                                   c.costcentrecode) = 1 Then
                          c.costcentrecode
                         Else
                          Null
                       End costcentrecode,
                       Case
                         When ROW_NUMBER() Over(Partition By a.departmentcode,
                                   b.workcentrecode,
                                   c.costcentrecode Order By A.departmentcode,
                                   b.workcentrecode,
                                   c.costcentrecode) = 1 Then
                          c.costcentrename
                         Else
                          Null
                       End costcentrename
                */
                  From department a, workcentre b, costcentre c, Location d
                 Where a.departmentcode = b.departmentcode(+)
                   And b.workcentrecode = c.workcentrecode(+)
                   and b.locationcode = d.locationcode (+)
                  and ( :P187_LOCATION IS NULL OR instr(':'||:P187_LOCATION||':',':'||d.LocationCode||':') > 0)
                   and ( :P187_DEPARTMENT IS NULL OR instr(':'||:P187_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0)
                  and d.LocationCode is not null
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
        }
