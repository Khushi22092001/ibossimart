page 74 (
    name: Sample Send Email
    alias: SAMPLE-SEND-EMAIL
    title: Sample Send Email
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region send-email (
        name: Send Email
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P74_MESSAGE (
        type: textarea
        label {
            label: Message
            alignment: left
        }
        settings {
            resizable: false
        }
        layout {
            sequence: 40
            region: @send-email
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
            height: 5
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P74_SUBJECT (
        type: textField
        label {
            label: Subject
            alignment: left
        }
        layout {
            sequence: 30
            region: @send-email
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P74_TO (
        type: textField
        label {
            label: To
            alignment: left
        }
        layout {
            sequence: 20
            region: @send-email
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button sendemail (
        buttonName: SENDEMAIL
        label: Send Email
        layout {
            sequence: 50
            region: @send-email
            slot: regionBody
            column: 10
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction send-mail (
        name: Send Mail
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @sendemail
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    Begin
                        apex_mail.send (p_to => :P74_TO,
                                        p_from => 'erp@pbsoil.com',
                                        p_body => :P74_MESSAGE,
                                        p_subj => :P74_SUBJECT);
                        apex_mail.push_queue;
                    End;
                    ```
                itemsToSubmit: [
                    P74_TO
                    P74_SUBJECT
                    P74_MESSAGE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

