        )

    )

    pageItem P130_ASONDATE (
        type: datePicker
        label {
            label: As On Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @parameter
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    button new (
        buttonName: New
        label: Refresh
        layout {
            sequence: 20
            region: @parameter
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
