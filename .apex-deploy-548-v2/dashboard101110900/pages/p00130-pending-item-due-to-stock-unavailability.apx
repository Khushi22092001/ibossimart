page 130 (
    name: Pending  Item Due to Stock Unavailability
    alias: PENDING-ITEM-DUE-TO-STOCK-UNAVAILABILITY
    title: Pending  Item Due to Stock Unavailability
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }

    region parameter (
        name: Parameter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pending-item-due-to-stock-unavailability (
        name: Pending  Item Due to Stock Unavailability
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.itemcode,
                       b.Itemspecificationcode,
                       getitemname(b.itemcode) As ItemName,
                       getItemSpecificationName(b.ItemCode, b.ItemSpecificationCode) As ItemSpecificationName,
                       --a.requisitionno,
                       --a.tno As requisitiontno,
                       -- a.requisitiondate,
                       Sum(b.quantity1) RequisitionQty1,
                       Sum(b.quantity2) RequisitionQty2
                  From requisition a, RequisitionDetail b
                
                 Where a.tno = b.tno
                   and a.companycode = :global_Companycode
                   and :P130_ASONDATE IS NOT NULL 
                      ---
                   And (Nvl((Select Sum(aa.StockQuantity1)
                              From Stock aa
                             Where 1 = 1
                               And aa.ItemCode = b.itemcode
                               And aa.ItemSpecificationCode = b.ItemSpecificationCode
                               And aa.CompanyCode = a.companycode
                               And aa.StockDate < a.requisitiondate + 1),
                            0) -
                       Nvl((Select Sum(bb.UsedStockQuantity1)
                              From Stock aa, UsedStock bb
                             Where aa.TNO = bb.StockTNO
                               And aa.ItemCode = b.ItemCode
                               And aa.ItemSpecificationCode = b.ItemSpecificationCode
                               And aa.CompanyCode = a.companycode
                               And aa.StockDate < a.requisitiondate + 1
                               And bb.UsedStockDate < a.requisitiondate + 1),
                            0)
                       
                       ) <= 0
                      --
                        -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                   And Not Exists
                 (Select 1
                          From Issue x, Issuedetail y
                         Where x.tno = y.tno
                           And x.requisitiontno = a.tno
                           And y.Itemcode = b.Itemcode
                           And y.Itemspecificationcode = b.Itemspecificationcode)
                
                    -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())         
                
                ----
                
                /*   And getitemopeningquantity1(b.itemcode,
                                               b.itemspecificationcode,
                                               a.companycode,
                                               a.requisitiondate + 1) < 0
                */
                
                 Group By b.itemcode,
                          b.Itemspecificationcode,
                          getitemname(b.itemcode),
                          getItemSpecificationName(b.ItemCode, b.ItemSpecificationCode) --,
                --  a.requisitiondate,
                -- a.requisitionno,
                --  a.companycode,
                -- a.tno
                
                ```
            pageItemsToSubmit: P130_ASONDATE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 8750124849486427
        }

        column ITEMCODE (
            type: plainText
            heading {
                heading: Itemcode
                alignment: center
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ITEMNAME (
            type: link
            heading {
                heading: ITEM NAME
            }
            layout {
                sequence: 3
            }
            link {
                target: {
                    page: 131
                    items: {
                        P131_ASONDATE: &P130_ASONDATE.
                        P131_ITEMCODE: #ITEMCODE#
                        P131_ITEMSPECIFICATIONCODE: #ITEMSPECIFICATIONCODE#
                    }
                    clearCache: 131
                }
                linkText: #ITEMNAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: plainText
            heading {
                heading: Itemspecificationcode
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ITEMSPECIFICATIONNAME (
            type: plainText
            heading {
                heading: ITEMSPECIFICATION NAME
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REQUISITIONQTY1 (
            type: link
            heading {
                heading: REQUISITION QUANTITY1
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            link {
                target: {
                    page: 131
                    items: {
                        P131_ASONDATE: &P130_ASONDATE.
                        P131_ITEMCODE: #ITEMCODE#
                        P131_ITEMSPECIFICATIONCODE: #ITEMSPECIFICATIONCODE#
                    }
                    clearCache: 131
                }
                linkText: #REQUISITIONQTY1#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column REQUISITIONQTY2 (
            type: plainText
            heading {
