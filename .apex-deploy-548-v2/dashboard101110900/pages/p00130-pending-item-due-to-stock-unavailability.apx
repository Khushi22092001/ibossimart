                sequence: 6
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Pending  Item Due to Stock Unavailability
        }

        savedReport 87534 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ITEMNAME (
                sequence: 1
