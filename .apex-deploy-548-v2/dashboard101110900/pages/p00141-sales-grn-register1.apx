    region sales-grn-register-report (
        name: Sales GRN Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  row_number() over(order by a.SalesGRNDate) SerialNo,
                       A.SALESGRNNO,
                       A.SALESGRNDATE,
                       CC.CCInvoiceNo,
                       CC.CCInvoiceDate,
                       A.PARTYCODE,
                       P.PartyName,
                       C.CityName,
                       S.StateCode,
                       A.SUMOFAMOUNT          As Amount,
                       A.Sumoffooteramount    As FooterAmount,
                       A.Salesgrnamount       As SalesGRNAmount,
                       b.ccinvoicequantity1   As InvoiceQuantity1,
                       b.ccinvoicequantity2   As InvoiceQuantity2,
                       b.reachedquantity1     As ReachedQuantity1,
                       b.reachedquantity2     As ReachedQuantity2,
                       b.discrepancyquantity1 As DiscrepancyQuantity1,
                       b.discrepancyquantity2 As DiscrepancyQuantity2,
                       cr.creditnoteno,
                       cr.creditnotedate,
                       cr.creditnoteamount
                  From SALESGRN A,
                       CCINVOICE CC,
                       Party P,
                       City C,
                       State s,
                       CreditNote cr,
                       (Select x.tno,
                               Sum(x.ccinvoicequantity1) As CCInvoiceQuantity1,
                               Sum(X.Ccinvoicequantity2) As CCInvoiceQuantity2,
                               Sum(x.Quantity1) As ReachedQuantity1,
                               Sum(X.Quantity2) As ReachedQuantity2,
                               Sum(x.Discrepancyquantity1) As DiscrepancyQuantity1,
                               Sum(x.Discrepancyquantity2) As DiscrepancyQuantity2,
                               Sum(x.discrepancyamount) As DiscrepancyAmount
                          From Salesgrndetail x
                         Group By x.tno) b
                 Where A.CCINVOICETNO = CC.TNO(+)
                   And a.partycode = p.partycode
                   And Nvl(p.workscitycode, p.officecitycode) = c.cityCode(+)
                   And Nvl(p.worksstatecode, p.worksstatecode) = S.Statecode(+)
                   And a.tno = b.tno(+)
                   And a.tno = cr.moduletno(+)
                     -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    and a.SalesGrnDate between :P141_FROMDATE and :P141_TODATE
                    and instr(':'||:P141_LOCATION||':',':'||a.LocationCode||':') > 0
                    and instr(':'||:P141_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                    and ( :P141_PARTY IS NULL OR instr(':'||:P141_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and cc.CCInvoiceNo like nvl(:P141_CCINO,'%')
                  Order By a.salesgrndate, salesgrnno
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
