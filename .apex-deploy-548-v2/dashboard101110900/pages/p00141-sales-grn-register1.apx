    pageItem P141_CCINO (
        type: textFieldWithAutocomplete
        label {
            label: Invoice No
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select CCInvoiceNo 
                From CCInvoice 
                Where instr(':'||:P141_LOCATION||':',':'||LocationCode||':') > 0
                  and CCInvoiceDate Between :P141_FROMDATE and :P141_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P141_LOCATION
            itemsToSubmit: P141_CCINO
        }
        layout {
            sequence: 90
            region: @sales-grn-register
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
