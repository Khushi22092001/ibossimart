page 1 (
    name: Home
    alias: HOME
    title: Home
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            body:not(.t-PageBody--login) .t-Body-title{display:none!important;}
            body:not(.t-PageBody--login) .t-Body-contentInner{padding:0!important;}
            ```
    }
    security {
        formAutoComplete: false
    }

    branch (
        name: Open personalized home
        execution {
            sequence: 10
            point: beforeHeader
        }
        behavior {
            target: {
                page: 736
                clearCache: 736
            }
        }
    )

)

