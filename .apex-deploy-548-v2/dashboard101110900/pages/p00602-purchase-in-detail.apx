page 602 (
    name: Purchase In Detail
    alias: PURCHASE-IN-DETAIL
    title: Purchase In Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1200
        height: 800
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region purchase-in-detail-report (
        name: Purchase In Detail Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.ItemCode,
                	b.ItemSpecificationCode,
                	a.ItemName || ' - ' || b.ItemSpecificationName as Item,
                    b.ItemCategoryCode,
                	x.Panel,
                    x1.ModuleNo,
                    x1.ModuleDate,
                	x1.PurchaseInStockQty1
                From Item a, ItemSpecification b,
                	(
                    Select
                        y.ItemCode,
                		y.ItemSpecificationCode,
                		y.Panel
                    From
                        (
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From GRN a, GRNDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P602_COMPANY
                             and ( :P602_LOCATION IS NULL OR instr(':'||:P602_LOCATION||':',':'||a.LocationCode||':') > 0 )             
                    		and a.GRNDate <= :P602_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From CCInvoice a, CCInvoiceDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P602_COMPANY
                            and ( :P602_LOCATION IS NULL OR instr(':'||:P602_LOCATION||':',':'||a.LocationCode||':') > 0 )  
                    		and a.CCInvoiceDate <= :P602_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From StockJournal a, StockJournalDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P602_COMPANY
                            and ( :P602_LOCATION IS NULL OR instr(':'||:P602_LOCATION||':',':'||a.LocationCode||':') > 0 )  
                    		and a.StockJournalDate <= :P602_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From CashPurchase a, CashPurchaseDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P602_COMPANY
                            and ( :P602_LOCATION IS NULL OR instr(':'||:P602_LOCATION||':',':'||a.LocationCode||':') > 0 )  
                    		and a.CashPurchaseDate <= :P602_TODATE
                        UNION ALL
                        Select
                    		a.ItemCode,
                    		a.ItemSpecificationCode,
                    		a.Panel
                    	From ItemOpening a
                    	Where a.CompanyCode = :P602_COMPANY
                            and ( :P602_LOCATION IS NULL OR instr(':'||:P602_LOCATION||':',':'||a.LocationCode||':') > 0 )  
                    		and a.ItemOpeningDate <= :P602_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From Issue a, IssueDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P602_COMPANY
                            and ( :P602_LOCATION IS NULL OR instr(':'||:P602_LOCATION||':',':'||a.LocationCode||':') > 0 )  
                    		and a.IssueDate <= :P602_TODATE
                        ) y
                	Group by 
                		y.ItemCode,
                		y.ItemSpecificationCode,
                		y.Panel
                	) x,
                	(
                		Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		xx.StockQuantity1 as PurchaseInStockQty1,
                        xx.ModuleNo,
                        xx.ModuleDate
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			b.Panel,
                			a.AcceptedQuantity1 as StockQuantity1,
                            b.InspectionNo as ModuleNo,
                            b.InspectionDate as ModuleDate
                		From InspectionDetail a, Inspection b, GRN c
                		Where a.Tno = b.Tno
                			and  b.GRNTno = c.Tno(+)
                			and c.DocTypeCode != 'SALERETURN'
                			and b.CompanyCode = :P602_COMPANY
                            and ( :P602_LOCATION IS NULL OR instr(':'||:P602_LOCATION||':',':'||b.LocationCode||':') > 0 )  
                			and b.InspectionDate between :P602_FROMDATE and :P602_TODATE
                		UNION ALL
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as StockQuantity1,
                            a.CashPurchaseNo as ModuleNo,
                            a.CashPurchaseDate as ModuleDate
                		From CashPurchase a, CashPurchaseDetail b
                		Where a.Tno = b.Tno(+)
                			and a.CompanyCode = :P602_COMPANY
                            and ( :P602_LOCATION IS NULL OR instr(':'||:P602_LOCATION||':',':'||a.LocationCode||':') > 0 )  
                			and a.CashPurchaseDate between :P602_FROMDATE and :P602_TODATE
                		) xx
                	) x1
                Where a.Tno = b.Tno
                	and a.ItemCode = x.ItemCode
                	and b.ItemSpecificationCode = x.ItemSpecificationCode
                	
                	and x.ItemCode = x1.ItemCode(+)
                	and x.ItemSpecificationCode = x1.ItemSpecificationCode(+)
                	and x.Panel = x1.Panel(+)
                    and a.ItemCode = :P602_ITEMCODE
                    and b.ItemSpecificationCode = :P602_SPECIFICATIONCODE
                    and b.ItemCategoryCode = :P602_ITEMCATEGORY
                    and x.Panel = :P602_PANEL
                ;
                ```
            pageItemsToSubmit: [
                P602_FROMDATE
                P602_TODATE
            ]
        }
        layout {
            sequence: 100
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 135192652096918671
        }

        column ITEM (
            type: plainText
            heading {
                heading: Item
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AY
            }
        )

        column ITEMCATEGORYCODE (
            type: plainText
            heading {
                heading: Itemcategorycode
            }
            layout {
                sequence: 160
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BE
            }
        )

        column ITEMCODE (
            type: plainText
            heading {
                heading: Item Code
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AV
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: plainText
            heading {
                heading: Itemspecificationcode
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AW
            }
        )

        column MODULEDATE (
            type: plainText
            heading {
                heading: Module Date
            }
            layout {
                sequence: 140
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: BC
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BB
            }
        )

        column PANEL (
            type: plainText
            heading {
                heading: Panel
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AZ
            }
        )

        column PURCHASEINSTOCKQTY1 (
            type: plainText
            heading {
                heading: Purchase In Stock Qty
                alignment: end
            }
            layout {
                sequence: 150
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: BD
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: NecessitySlip Detail Report
        }

        savedReport 232721 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn ITEM (
                sequence: 3
            )

            displayColumn MODULEDATE (
                sequence: 2
            )

            displayColumn MODULENO (
                sequence: 1
            )

            displayColumn PANEL (
                sequence: 4
            )

            displayColumn PURCHASEINSTOCKQTY1 (
                sequence: 5
            )

            sort (
                column: DAYDATE
                sort {
                    sequence: 1
                }
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 2
                }
            )

            sort (
                column: NECESSITYSLIPNO
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: INQUANTITY
            )

            aggregate (
                column: OUTQUANTITY
            )

            aggregate (
                column: OPENINGINSTOCKQTY1
            )

            aggregate (
                column: PURCHASEINSTOCKQTY1
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P602_COMPANY (
        type: hidden
        layout {
