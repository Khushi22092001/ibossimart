        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.CompanyName d,
                a.CompanyCode r
                From Company a
                Where exists(
                   Select
                      aa.CompanyCode
                   From Voucher aa
                   Where aa.CompanyCode = a.CompanyCode
                )
                Order by 1
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @driver-running-advance-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
