    pageItem P462_ACCOUNT (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Account
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.PartyName d,
                a.PartyCode r
                From Party a
                Where exists(
                   Select
                      aa.CompanyCode
                   From VoucherDetail aa
                   Where aa.AccountCode = a.PartyCode
                   and aa.AccountCode in ('4400','4401')
                )
                Order by 1
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @driver-running-advance-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P462_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
