page 462 (
    name: "Driver Running Advance Detail "
    alias: DRIVER-RUNNING-ADVANCE-DETAIL
    title: "Driver Running Advance Detail "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region driver-running-advance-detail (
        name: "Driver Running Advance Detail "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select x.*
                From (Select
                       A.TNO,
                       A.VOUCHERNO,
                	   a.voucherdate,
                      to_char(a.voucherdate, 'MON-RRRR') as Monthss,
                       row_number() over(order by a.VoucherDate) SerialNo,
                       A.MODULECODE,
                       A.MODULETNO,
                       'WITHZERO' as NetName,
                     Case
                         When B.AMOUNT < 0 Then
                          round((B.AMOUNT * (-1)),2)
                         Else
                          0
                       End DrAmount,
                       Case
                         When B.AMOUNT > 0 Then
                          B.AMOUNT
                         Else
                          0
                       End CrAmount,
                      round(SV.AMOUNT,2)       As Cramtemployeewise,
                       nvl((Case
                         When B.AMOUNT < 0 Then
                          round((B.AMOUNT * (-1)),2)
                         Else
                          0 End),0) -  nvl(SV.AMOUNT, 0) as NetBalance,
                      LS.EMPCODE,
                	   LS.EMPNAME,
                       nvl(LS.EMPNAME, SV.EMPLOYEENAME) as EmployeeeeName,
                       nvl(LS.EMPCODE, SV.EMPLOYEECODE) as EmployeeCode,
                	   LS.TOTALAMOUNT,
                       SV.EMPLOYEENAME,
                       b.AccountCode,
                       a.CompanyCode
                  From VOUCHER A,
                       VOUCHERDETAIL B,
                       (Select AA.TNO,
                               AA.LOANSANCTIONNO,
                               AA.LOANSANCTIONDATE,
                               CC.LOANREQUESTNO,
                               CC.LOANREQUESTDATE,
                               AA.TOTALAMOUNT,
                			   CC.EMPLOYEECODE AS EMPCODE,
                			   GETEMPLOYEENAME(CC.EMPLOYEECODE) AS EMPNAME
                          From LOANSANCTION AA, LOANREQUEST CC
                         Where AA.LOANREQUESTTNO = CC.TNO) LS,
                       (Select AA.TNO,
                               cc.modulecode,
                               cc.referencetno,
                               --B.AMOUNT,
                               cc.amount,
                               cc.accountcode,
                               FF.employeecode,
                               GETEMPLOYEENAME(FF.EMPLOYEECODE) As EMPLOYEENAME
                          From voucher                aa,
                               voucherdetail          bb,
                               voucherreferencedetail cc,
                               voucher                dd,
                               loansanction           ee,
                               loanrequest            ff
                         Where aa.tno = bb.tno
                        --    And bb.accountcode = '4401'
                          and (bb.AccountCode = :P462_ACCOUNT)
                           And bb.tno = cc.tno
                           And bb.sno = cc.sno
                           And cc.referencetno = dd.tno
                           And dd.moduletno = ee.tno
                           And ee.loanrequesttno = ff.tno) SV
                 Where A.TNO = B.TNO
                --    And B.ACCOUNTCODE = '4401'
                   And A.MODULETNO = LS.TNO(+)
                   And A.TNO = SV.TNO(+)
                   AND nvl((Case When B.AMOUNT < 0 Then B.AMOUNT * (-1) Else 0 End),0) -  nvl(SV.AMOUNT, 0) = 0
                and ( :P462_COMPANY IS NULL OR instr(':'||:P462_COMPANY||':',':'||a.CompanyCode||':') > 0)
                -- and  TO_CHAR(a.voucherdate,'DD-MM-RR') between :P462_FROMDATE and :P462_TODATE
                and  a.voucherdate between :P462_FROMDATE and :P462_TODATE
                and (b.AccountCode = :P462_ACCOUNT)
                
                
                UNION ALL
                
                
                Select
                       A.TNO,
                       A.VOUCHERNO,
                	   a.voucherdate,
                       to_char(a.voucherdate, 'MON-RRRR') as Monthss,
                       row_number() over(order by a.VoucherDate) SerialNo,
                       A.MODULECODE,
                       A.MODULETNO,
                       'WITHOUTZERO' as NetName,
                     Case
                         When B.AMOUNT < 0 Then
                          round((B.AMOUNT * (-1)),2)
                         Else
                          0
                       End DrAmount,
                       Case
                         When B.AMOUNT > 0 Then
                          B.AMOUNT
                         Else
                          0
                       End CrAmount,
                      round(SV.AMOUNT,2) As Cramtemployeewise,
                       nvl((Case
                         When B.AMOUNT < 0 Then
                          round((B.AMOUNT * (-1)),2)
                         Else
                          0 End),0) -  nvl(SV.AMOUNT, 0) as NetBalance,
                      LS.EMPCODE,
                	   LS.EMPNAME,
                       nvl(LS.EMPNAME, SV.EMPLOYEENAME) as EmployeeeeName,
                       nvl(LS.EMPCODE, SV.EMPLOYEECODE) as EmployeeCode,
                	   LS.TOTALAMOUNT,
                       SV.EMPLOYEENAME,
                       b.AccountCode,
                       a.CompanyCode
                  From VOUCHER A,
                       VOUCHERDETAIL B,
                       (Select AA.TNO,
                               AA.LOANSANCTIONNO,
                               AA.LOANSANCTIONDATE,
                               CC.LOANREQUESTNO,
                               CC.LOANREQUESTDATE,
                               AA.TOTALAMOUNT,
                			   CC.EMPLOYEECODE AS EMPCODE,
                			   GETEMPLOYEENAME(CC.EMPLOYEECODE) AS EMPNAME
                          From LOANSANCTION AA, LOANREQUEST CC
                         Where AA.LOANREQUESTTNO = CC.TNO) LS,
                       (Select AA.TNO,
                               cc.modulecode,
                               cc.referencetno,
                               --B.AMOUNT,
                               cc.amount,
                               cc.accountcode,
                               FF.employeecode,
                               GETEMPLOYEENAME(FF.EMPLOYEECODE) As EMPLOYEENAME
                          From voucher                aa,
                               voucherdetail          bb,
                               voucherreferencedetail cc,
                               voucher                dd,
                               loansanction           ee,
                               loanrequest            ff
                         Where aa.tno = bb.tno
                        --    And bb.accountcode = '4401'
                          and (bb.AccountCode = :P462_ACCOUNT)
                           And bb.tno = cc.tno
                           And bb.sno = cc.sno
                           And cc.referencetno = dd.tno
                           And dd.moduletno = ee.tno
                           And ee.loanrequesttno = ff.tno) SV
                 Where A.TNO = B.TNO
                --    And B.ACCOUNTCODE = '4401'
                   And A.MODULETNO = LS.TNO(+)
                   And A.TNO = SV.TNO(+)
                   AND nvl((Case When B.AMOUNT < 0 Then B.AMOUNT * (-1) Else 0 End),0) -  nvl(SV.AMOUNT, 0) != 0
                   and ( :P462_COMPANY IS NULL OR instr(':'||:P462_COMPANY||':',':'||a.CompanyCode||':') > 0)
                   and  a.voucherdate between :P462_FROMDATE and :P462_TODATE
                   and (b.AccountCode = :P462_ACCOUNT)
                
                ) x
                where ( :P462_COMPANY IS NULL OR instr(':'||:P462_COMPANY||':',':'||x.CompanyCode||':') > 0)
                and  x.voucherdate between :P462_FROMDATE and :P462_TODATE
                and (x.AccountCode = :P462_ACCOUNT)
                and ( :P462_NETBALANCE IS NULL OR instr(':'||:P462_NETBALANCE||':',':'|| x.NetName||':') > 0)
                order by 3,1
                
                /*Select
                       A.TNO,
                       A.VOUCHERNO,
                	   a.voucherdate,
                       to_char(a.voucherdate, 'MON-RRRR') as Monthss,
                       row_number() over(order by a.VoucherDate) SerialNo,
                       A.MODULECODE,
                       A.MODULETNO,
                     Case
                         When B.AMOUNT < 0 Then
                          B.AMOUNT * (-1)
                         Else
                          0
                       End DrAmount,
                       Case
                         When B.AMOUNT > 0 Then
                          B.AMOUNT
                         Else
                          0
                       End CrAmount,
                      SV.AMOUNT       As Cramtemployeewise,
                       nvl((Case
                         When B.AMOUNT < 0 Then
                          B.AMOUNT * (-1)
                         Else
                          0 End),0) -  nvl(SV.AMOUNT, 0) as NetBalance,
                      LS.EMPCODE,
                	   LS.EMPNAME,
                       nvl(LS.EMPNAME, SV.EMPLOYEENAME) as EmployeeeeName,
                       nvl(LS.EMPCODE, SV.EMPLOYEECODE) as EmployeeCode,
                	   LS.TOTALAMOUNT,
                       SV.EMPLOYEENAME
                  From VOUCHER A,
                       VOUCHERDETAIL B,
                       (Select AA.TNO,
                               AA.LOANSANCTIONNO,
                               AA.LOANSANCTIONDATE,
                               CC.LOANREQUESTNO,
                               CC.LOANREQUESTDATE,
                               AA.TOTALAMOUNT,
                			   CC.EMPLOYEECODE AS EMPCODE,
                			   GETEMPLOYEENAME(CC.EMPLOYEECODE) AS EMPNAME
                          From LOANSANCTION AA, LOANREQUEST CC
                         Where AA.LOANREQUESTTNO = CC.TNO) LS,
                       (Select AA.TNO,
                               cc.modulecode,
                               cc.referencetno,
                               --B.AMOUNT,
                               cc.amount,
                               cc.accountcode,
                               FF.employeecode,
                               GETEMPLOYEENAME(FF.EMPLOYEECODE) As EMPLOYEENAME
                          From voucher                aa,
                               voucherdetail          bb,
                               voucherreferencedetail cc,
                               voucher                dd,
                               loansanction           ee,
                               loanrequest            ff
                         Where aa.tno = bb.tno
                        --    And bb.accountcode = '4401'
                          and (bb.AccountCode = :P462_ACCOUNT)
                           And bb.tno = cc.tno
                           And bb.sno = cc.sno
                           And cc.referencetno = dd.tno
                           And dd.moduletno = ee.tno
                           And ee.loanrequesttno = ff.tno) SV
                 Where A.TNO = B.TNO
                --    And B.ACCOUNTCODE = '4401'
                   And A.MODULETNO = LS.TNO(+)
                   And A.TNO = SV.TNO(+)
                and ( :P462_COMPANY IS NULL OR instr(':'||:P462_COMPANY||':',':'||a.CompanyCode||':') > 0)
                and a.voucherdate between :P462_FROMDATE and :P462_TODATE
                and (b.AccountCode = :P462_ACCOUNT)
                order by 3,1;
                */
                ```
        }
