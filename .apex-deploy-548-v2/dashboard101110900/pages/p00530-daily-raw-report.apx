page 530 (
    name: Daily Raw Report
    alias: DAILY-RAW-REPORT
    title: Daily Raw Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        formAutoComplete: false
    }

    region daily-raw-report (
        name: Daily Raw Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region daily-raw-report-2 (
        name: Daily Raw Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by a.PurchaseOrderNo) SerialNo, 
                    a.PurchaseOrderNo,
                    a.PurchaseOrderDate,
                    b.PartyName as VendorName,
                    c.PartyName as AgentName,
                    e.ItemName ||'-'|| f.ItemSpecificationName as MaterialDescription,
                    d.Quantity1 as PQty,
                    a.FreightRate,
                    a.Remark,
                    g.FreighttypeName,
                    dsd.DocumentStatusCode as Status
                From PurchaseOrder a, Party b, Party c, PurchaseOrderDetail d, Item e, ItemSpecification f, Freighttype g, DocumentStatusDetail dsd
                Where a.PartyCode = b.PartyCode(+)
                    and a.AgentCode = c.PartyCode(+)
                    and a.Tno = d.Tno(+)
                    and d.ItemCode = e.ItemCode(+)
                    and d.ItemSpecificationCode = f.ItemSpecificationCode(+)
                    and a.FreighttypeCode = g.FreighttypeCode(+)
                    and a.DoctypeCode = 'RAWMATERIALPURCHASE'
                    and a.Tno = dsd.ModuleTno(+)
                    AND A.PANEL='A'
                    and (:P530_COMPANY is Null Or Instr (':' || :P530_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                    and a.PurchaseOrderDate Between nvl(:P530_FROMDATE,trunc(sysdate)-1) and nvl(:P530_TODATE ,trunc(sysdate) - 1)
                    and (:P530_LOCATION is Null Or Instr (':' || :P530_LOCATION || ':' , ':' || a.LocationCode || ':') > 0)
                    And  (:P530_VENDOR is Null Or Instr (':' || :P530_VENDOR || ':' , ':' ||a.PartyCode|| ':') > 0)
                ```
            pageItemsToSubmit: [
                P530_COMPANY
                P530_FROMDATE
                P530_TODATE
                P530_LOCATION
                P530_VENDOR
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 72080512071138181
        }

