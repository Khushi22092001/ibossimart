page 252 (
    name: Maintenance Request Report
    alias: MAINTENANCEREQUESTREPORT
    title: MaintenanceRequestReport
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenance-request (
        name: Maintenance Request
        type: staticContent
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region master (
        name: Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                row_number() over(order by a.maintenancerequestdate) SerialNo,
                a.maintenancerequestno,
                to_char(a.maintenancerequestdate,'DD-MM-YYYY') AS MAINTENANCEREQUESTDATE,
                m.maintenancetypename,
                emo.equipmentmaintenanceorderno,
                emo.equipmentmaintenanceorderdate,
                e.equipmentname  as equipment,
                de.departmentname as responsibledepartment,
                em.employeename as personresponsible,
                a.reasoncode as reasonname,
                emp.employeename as reportedby,
                to_char(a.notificationdateandtime,'DD-MM-YYYY HH24:MI:SS') AS NOTIFICATIONDATEANDTIME,
                a.notificationshorttext,
                a.notificationlongtext,
                a.isinwarranty,
                to_char(a.malfunctionstartdateandtime,'DD-MM-YYYY HH24:MI:SS') AS MALFUNCTIONSTARTDATEANDTIME,
                to_char(a.malfunctionenddateandtime,'DD-MM-YYYY HH24:MI:SS') AS MALFUNCTIONENDDATEANDTIME,
                a.isequipmentinbreakdownstatus,
                to_char(a.breakdowndateandtime,'DD-MM-YYYY hh24:mi:ss') AS breakdowndateandtime,
                p.equipmentmaintenanceplanno,
                s.maintenancestrategyname,
                Case When EMO.EQUIPMENTMAINTENANCEORDERNO IS NOT NULL Then 'DONE'
                	       When EMO.EQUIPMENTMAINTENANCEORDERNO is null  Then 'PENDING'
                      End as Status,
                sh.shiftname as shift,
                l.locationname as location,
                d.doctypename as doctype,
                a.KMRReading,
                a.HMRReading
                from maintenancerequest a,location l,company c,doctype d,maintenancetype m,equipment e,
                equipmentmaintenanceplan p,maintenancestrategy s,department de,employee em,employee emp,shift sh,equipmentmaintenanceorder emo
                where a.companycode = c.companycode(+)
                and a.locationcode = l.locationcode(+)
                and a.doctypecode = d.doctypecode(+)
                and a.responsibledepartmentcode = de.departmentcode(+)
                and a.personresponsible = em.employeecode(+)
                and a.reportedby = emp.employeecode(+)
                and a.maintenancetypecode = m.maintenancetypecode(+)
                and a.plantno = p.tno(+)
                and p.maintenancestrategycode = s.maintenancestrategycode(+)
                and a.equipmenttno = e.tno
                and a.tno = emo.maintenancerequesttno(+)
                and a.shiftcode = sh.shiftcode(+)
                and a.maintenancerequestdate between :P252_FROMDATE and :P252_TODATE
                and (:P252_DOCTYPE IS NULL OR instr(':'||:P252_DOCTYPE||':',':'||D.DOCTYPEcode||':') > 0)
                and (:P252_LOCATION IS NULL OR instr(':'||:P252_LOCATION||':',':'||l.locationcode||':') > 0)
                and (:P252_COMPANY IS NULL OR instr(':'||:P252_COMPANY||':',':'||c.companycode||':') > 0)
                and ( :P252_EQUIPMENT IS NULL OR instr(':'||:P252_EQUIPMENT||':',':'||e.equipmentname||':') > 0 ) 
                --and (:P252_REQUESTNO IS NULL OR instr(':'||:P252_REQUESTNO||':',':'||a.maintenancerequestno||':') > 0)
                and (:P252_STRATEGYNAME IS NULL OR instr(':'||:P252_STRATEGYNAME||':',':'||S.maintenanceSTRATEGYcode||':') > 0)
                and (:P252_MAINTENANCETYPE IS NULL OR instr(':'||:P252_MAINTENANCETYPE||':',':'||m.maintenancetypecode||':') > 0)
                --and (:P252_STATUS IS NULL OR instr(':'||:P252_STATUS||':',':'||EMO.EQUIPMENTMAINTENANCEORDERNO||':') > 0)
                
                
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 7233786278459902
        }

