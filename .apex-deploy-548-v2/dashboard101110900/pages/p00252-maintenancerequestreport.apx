                A.EQUIPMENTNAME R,
                A.EQUIPMENTNAME D
                FROM EQUIPMENT A,MAINTENANCEREQUEST B
                WHERE B.EQUIPMENTTNO = A.TNO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @maintenance-request
