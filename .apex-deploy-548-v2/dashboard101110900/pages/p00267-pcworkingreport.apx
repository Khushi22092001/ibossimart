    region pc-working-report (
        name: PC Working Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                rownum,
                GetLocationName(a.LocationCode) as Location,
                c.EquipmentId,
                e.EmployeeName,
                e.EmployeeID,
                a.EquipmentLogBookDate,
                s.ShiftName,
                j.JobTypeName,
                a.OpeningWorkingHrs,
                a.ClosingWorkingHrs,
                (a.ClosingWorkingHrs - a.OpeningWorkingHrs) as WorkingHrs,
                nvl(b.TotalTrip,0) as TotalTrip,
                Case when (a.ClosingWorkingHrs - a.OpeningWorkingHrs) = 0 then b.TotalTrip/1
                else round(b.TotalTrip /(a.ClosingWorkingHrs - a.OpeningWorkingHrs),2)
                End as AvgTrip,
                a.Remark
                From EquipmentLogBook a, EquipmentLogBookDetail b, Equipment c, Employee e, Shift s, JobType j
                Where 1=1
                  and a.TNo = b.TNo(+)
                  and a.EquipmentTNo = c.TNo(+)
                  and a.OperatorCode = e.EmployeeCode(+)
                  and a.ShiftCode = s.ShiftCode(+)
                  and b.JobTypeCode = j.JobTypeCode(+)
                  and a.Equipmentlogbookdate between :P267_FROMDATE and :P267_TODATE
                  and instr(':'||:P267_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P267_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P267_SHIFT IS NULL OR instr(':'||:P267_SHIFT||':',':'||a.shiftCode||':') > 0 ) 
                  and ( :P267_DOORNO IS NULL OR instr(':'||:P267_DOORNO||':',':'||c.equipmentid||':') > 0 ) 
                  and ( :P267_EQUIPMENTGROUP IS NULL OR instr(':'||:P267_EQUIPMENTGROUP||':',':'||c.EquipmentGroupCode||':') > 0 )
                  ;
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 8501792603523234
        }

