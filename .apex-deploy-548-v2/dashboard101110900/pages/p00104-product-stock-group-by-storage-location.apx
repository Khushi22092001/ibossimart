page 104 (
    name: Product Stock Group by Storage Location
    alias: PRODUCT-STOCK-GROUP-BY-STORAGE-LOCATION
    title: Product Stock Group by Storage Location
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region product-stock-group-by-storage-location (
        name: Product Stock Group by Storage Location
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       STORAGELOCATIONCODE,
                       STORAGELOCATIONNAME,
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':99:'||:APP_SESSION||'::'||':99:P99_ITEMSPECIFICATIONCODE,P99_STORAGELOCATION:'||ITEMSPECIFICATIONCODE||','||STORAGELOCATIONCODE,NULL,'SESSION' )||'">'||STORAGELOCATIONNAME||'</a>' as StorageLink,
                       NVL(SUM(STOCKQUANTITY1),0)STOCKQUANTITY1,
                       NVL(SUM(USEDSTOCKQUANTITY1),0)USEDSTOCKQUANTITY1,
                       NVL(SUM(RESERVESTOCKQUANTITY1),0)RESERVESTOCKQUANTITY1,
                       NVL(SUM(BALANCEQUANTITY1),0)BALANCEQUANTITY1,
                       NVL(SUM(STOCKQUANTITY2),0)STOCKQUANTITY2,
                       NVL(SUM(USEDSTOCKQUANTITY2),0)USEDSTOCKQUANTITY2,
                       NVL(SUM(RESERVESTOCKQUANTITY2),0)RESERVESTOCKQUANTITY2,
                       NVL(SUM(BALANCEQUANTITY2),0)BALANCEQUANTITY2,
                       NVL(SUM(STOCKVALUE),0)STOCKVALUE
                  from D_PRODUCT360VIEW_STOCKSTORAGELOCATIONWISE
                  where  ITEMSPECIFICATIONCODE like nvl(:P104_ITEMSPECIFICATIONCODE,'%')
                  GROUP BY ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       STORAGELOCATIONCODE,
                       STORAGELOCATIONNAME
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            compute: false
            flashback: false
            saveReport: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 72550353461852591
        }

        column BALANCEQUANTITY1 (
            type: plainText
            heading {
                heading: Balance Base Quantity
                alignment: center
            }
            layout {
                sequence: 360
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
