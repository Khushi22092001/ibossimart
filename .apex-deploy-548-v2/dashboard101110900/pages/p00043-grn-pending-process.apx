            sort (
                column: ROWNUM
                sort {
                    sequence: 1
                }
            )

            sort (
                column: GRNDATE
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: TOTALAMOUNT
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: RECEIVEDQUANTITY1
            )

            aggregate (
                function: count
                column: ROWNUM
