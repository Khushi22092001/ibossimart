    region grn-pending-process-2 (
        name: GRN Pending Process
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select ROWNUM,XX.*
                  From (Select a.TNo,
                               b.SNo,
                               l.LocationName,
                               d.DocTypeName,
                               a.GRNNo,
                               a.GRNDate,
                               a.RefDocNo,
                               a.RefDocDate,
                               p.PartyName,
                               e.ItemCode,
                               e.ItemName || ' ~ ' || ee.ItemSpecificationName As Material,
                               e.MeasuringUnitCode1,
                               round(b.ReceivedQuantity1,3) as ReceivedQuantity1,
                               Case
                                 When i.InspectionNo Is Null Then
                                 --':PFI:'
                                  ':PFPB' || ':' || 'PFI' || ':' || 'PFPBP' || ':' || 'PFVP:'
                                 When pb.PurchaseBillNo Is Null Or i.InspectionNo Is Null Then
                                  ':PFPB' || ':' || 'PFPBP' || ':' || 'PFVP:'
                                 When pb.PBPassNo Is Null And pb.PurchaseBillNo Is Not Null And
                                      i.InspectionNo Is Not Null Then
                                  ':PFVP' || ':' || 'PFPBP:'
                                 When pb.VoucherNo Is Null And pb.PBPassNo Is Not Null And
                                      pb.PurchaseBillNo Is Not Null And
                                      i.InspectionNo Is Not Null Then
                                  ':PFVP:'
                               --  Else
                               --  ':PFPB' || ':' || 'PFI' || ':' || 'PFPBP' || ':' || 'PFVP' || ':' ||
                               --  'DONE:'
                               End As GRNStatus,
                               GetDepartmentName(nvl(Nvl(IND.DepartmentCode, JO.DEPARTMENTCODE),di.departmentcode)) As Department,
                               --GetDepartmentName(di.departmentcode) As Department,
                               di.DepartmentCode,
                               i.InspectionNo,
                               i.InspectionDate,
                               pb.PurchaseBillNo,
                               pb.PurchaseBillDate,
                               pb.PBPassNo,
                               pb.PBPassDate,
                               pb.VoucherNo,
                               pb.VoucherDate
                          From GRN a,
                               GRNDetail b,
                               Location l,
                               DocType d,
                               Party p,
                               DocumentStatusDetail dsd,
                               Item e,
                               ItemSpecification ee,
                               PurchaseOrderDetail pod,
                               JOBORDER JO,
                               Inspection i,
                               Dinspection di,
                               (Select aa.TNo,
                                       aa.PurchaseBillNo,
                                       aa.PurchaseBillDate,
                                       bb.GRNTNo,
                                       bb.GRNSNo,
                                       cc.PBPassNo,
                                       cc.PBPassDate,
                                       v.VoucherNo,
                                       v.VoucherDate
                                  From PurchaseBill          aa,
                                       PurchaseBillGRNDetail bb,
                                       PBPass                cc,
                                       Voucher               v
                                 Where aa.TNo = bb.TNo
                                   And aa.TNo = cc.PurchaseBillTNo(+)
                                   And cc.TNo = v.ModuleTNo(+)
                                --and v.ModuleTNo is null
                                ) pb,
                               Indent IND
                        
                         Where a.TNo = b.TNo
                           And a.LocationCode = l.LocationCode
                           And a.DocTypeCode = d.DocTypeCode
                           And a.PartyCode = p.PartyCode(+)
                           And a.TNo = dsd.ModuleTNo(+)
                           And e.TNo = ee.TNo
                           And b.ItemCode = e.ItemCode(+)
                           And b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                           And B.PurchaseOrderTNo = pod.TNo(+)
                           And b.ItemCode = pod.ItemCode(+)
                           And b.ItemSpecificationCode = pod.ItemSpecificationCode(+)
                           And B.JOBORDERTNO = JO.TNO(+)
                           And POD.INDENTTNO = IND.TNO(+)
                           And b.TNo = i.GRNTNo(+)
                           And b.TNo = pb.GRNTNo(+)
                           And b.SNo = pb.GRNSNo(+)
                           And a.TNo = di.GRNTNO(+)
                           
                           and a.GRNDate Between :P43_FROMDATE and :P43_TODATE
                             -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and instr(':'||:P43_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P43_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P43_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                  and ( :P43_ITEM IS NULL OR instr(':'||:P43_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P43_ITEMSPECIFICATION IS NULL OR instr(':'||:P43_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                  and ( :P43_DEPARTMENT IS NULL OR instr(':'||:P43_DEPARTMENT||':',':'||di.DepartmentCode||':') > 0 ) 
                  and ( :P43_PARTY IS NULL OR instr(':'||:P43_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                /* CHANGED ON 22-MAY-2022
                  and ( :P43_ITEMGROUP IS NULL OR instr(':'||:P43_ITEMGROUP||':',':'||e.ParentCode||':') > 0 ) 
                */
                  and ( :P43_ITEMGROUP IS NULL
                      or
                      exists (select 1 from (Select ITEMCODE,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                               Level,
                               CONNECT_BY_ROOT itemcode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From item a
                         Start With parentcode in ( select itemcode from item xx where
                                                    instr(':'||:P43_ITEMGROUP||':',':'||xx.ItemCode||':') > 0)
                                                    
                        Connect By parentcode = Prior itemcode
                         Order Siblings By itemcode) x where x.itemcode = e.itemcode
                        )
                  )
                  ) XX
                 WHERE (:P43_STATUS IS NULL OR instr(XX.GRNSTATUS, ':' || :P43_STATUS || ':') > 0)
                    Or (XX.GRNSTATUS = :P43_STATUS And
                       XX.DOCTYPENAME != 'Conversion Job Out Of Premises')
                
                   /*
                Select
                    a.TNo,
                    b.SNo,
                    l.LocationName,
                    d.DocTypeName,
                    a.GRNNo,
                    a.GRNDate,
                    a.RefDocNo,
                    a.RefDocDate,
                    p.PartyName,
                    e.ItemCode,
                    e.ItemName||' ~ '||ee.ItemSpecificationName as Material,
                    e.MeasuringUnitCode1,
                    b.ReceivedQuantity1,
                    Case When i.InspectionNo is Null Then 'PFI'
                         When pb.PurchaseBillNo is null Then 'PFPB'
                         When pb.PBPassNo is null Then 'PFPBP'
                         When pb.VoucherNo is null Then 'PFVP'
                      End as GRNStatus,
                      GetDepartmentName(IND.DepartmentCode) as Department,
                      di.DepartmentCode,
                      i.InspectionNo,
                      i.InspectionDate,
                      pb.PurchaseBillNo,
                      pb.PurchaseBillDate,
                      pb.PBPassNo,
                      pb.PBPassDate,
                      pb.VoucherNo,
                      pb.VoucherDate
                From GRN a, GRNDetail b, Location l, DocType d, Party p, DocumentStatusDetail dsd, Item e, ItemSpecification ee, PurchaseOrderDetail pod, Inspection i, Dinspection di
                    , (Select
                             aa.TNo,
                             aa.PurchaseBillNo,
                             aa.PurchaseBillDate,
                             bb.GRNTNo,
                             bb.GRNSNo,
                             cc.PBPassNo,
                             cc.PBPassDate,
                             v.VoucherNo,
                             v.VoucherDate
                       From  PurchaseBill aa, PurchaseBillGRNDetail bb, PBPass cc, Voucher v
                       Where aa.TNo = bb.TNo
                         and aa.TNo = cc.PurchaseBillTNo(+)
                         and cc.TNo = v.ModuleTNo(+)
                         --and v.ModuleTNo is null
                       ) pb,
                			 Indent IND
                Where a.TNo = b.TNo
                  and a.LocationCode = l.LocationCode
                  and a.DocTypeCode = d.DocTypeCode
                  and a.PartyCode = p.PartyCode
                  and a.TNo = dsd.ModuleTNo(+)
                  and e.TNo = ee.TNo
                  and b.ItemCode = e.ItemCode(+)
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and b.PurchaseOrderTNo = pod.TNo(+)
                  and b.ItemCode = pod.ItemCode(+)
                  and b.ItemSpecificationCode = pod.ItemSpecificationCode(+)
                	And POD.INDENTTNO = IND.TNO(+)
                  and b.TNo = i.GRNTNo(+)
                  and b.TNo = pb.GRNTNo(+)
                  and b.SNo = pb.GRNSNo(+)
                  and a.TNo = di.GRNTNO(+)
                  and a.GRNDate Between :P43_FROMDATE and :P43_TODATE
                  and instr(':'||:P43_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P43_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P43_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                  and ( :P43_ITEM IS NULL OR instr(':'||:P43_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P43_ITEMSPECIFICATION IS NULL OR instr(':'||:P43_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                  and ( :P43_DEPARTMENT IS NULL OR instr(':'||:P43_DEPARTMENT||':',':'||di.DepartmentCode||':') > 0 ) 
                  and ( :P43_PARTY IS NULL OR instr(':'||:P43_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                -- CHANGED ON 22-MAY-2022
                --  and ( :P43_ITEMGROUP IS NULL OR instr(':'||:P43_ITEMGROUP||':',':'||e.ParentCode||':') > 0 ) 
                
                  and ( :P43_ITEMGROUP IS NULL
                      or
                      exists (select 1 from (Select ITEMCODE,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                               Level,
                               CONNECT_BY_ROOT itemcode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From item a
                         Start With parentcode in ( select itemcode from item xx where
                                                    instr(':'||:P43_ITEMGROUP||':',':'||xx.ItemCode||':') > 0)
                                                    
                        Connect By parentcode = Prior itemcode
                         Order Siblings By itemcode) x where x.itemcode = e.itemcode
                        )
                  )
                  and Case When i.InspectionNo is Null Then 'PFI'
                         When pb.PurchaseBillNo is null Then 'PFPB'
                         When pb.PBPassNo is null Then 'PFPBP'
                         When pb.VoucherNo is null Then 'PFVP'
                      End like nvl(:P43_STATUS,'%')
                */
                ```
        }
