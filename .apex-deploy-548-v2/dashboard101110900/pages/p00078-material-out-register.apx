            action: executeJsCode
            settings {
                jsCode: javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/materialoutregister.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P78_COMPANY.","_paramsP_LOCATION":"&P78_LOCATION.","_paramsP_FROMDATE":"&P78_FROMDATE.","_paramsP_TODATE":"&P78_TODATE.","_paramsP_DOCTYPE":"&P78_DOCTYPE.","_paramsP_LOCATION":"&P78_LOCATION.","_paramsP_ITEM":"&P78_ITEM.","_paramsP_ITEMSPECIFICATION":"&P78_ITEMSPECIFICATION.","_paramsP_TRANSPORTER":"&P78_TRANSPORTER.","_paramsP_PARTY":"&P78_PARTY.","_paramsP_VEHICLENO":"&P78_VEHICLENO."}');
