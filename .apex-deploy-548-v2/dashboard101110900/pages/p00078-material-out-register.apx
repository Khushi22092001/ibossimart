    region material-out-register (
        name: Material Out Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region material-out-register-report (
        name: Material Out Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.LocationName,
                      Upper(a.DocTypeName)as DocTypeName,
                      a.MaterialOutNo,
                      a.MaterialOutDate,
                      a.PartyName,
                      a.Transporter,
                      a.VehicleNo,
                      a.DriverName,
                      a.ItemCode,
                      a.ItemName||' ~ '||a.ItemSpecificationName as ItemDetail,
                      a.UOM1,
                      a.Quantity1,
                      a.UOM2,
                      a.Quantity2,
                      ip.packingTypeCode,
                      Upper(a.Module) as Module,
                      a.ModuleNo,
                      a.ModuleDate,
                      a.WeighmentNo,
                      a.FirstWeight,
                      a.SecondWeight,
                      a.NetWeight,
                      a.AcceptedWeight
                From  GATEOUTREGISTER_VIEW a, ItemPacking ip, MaterialOut mo
                Where a.ItemCode = ip.ItemCode(+)
                  and a.itemSpecificationCode = ip.ItemSpecificationCode(+)
                  and a.Tno = mo.Tno(+)
                  and trunc(a.MaterialOutDate) between :P78_FROMDATE and :P78_TODATE
                  and instr(':'||:P78_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P78_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P78_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                  and a.VehicleNo like nvl(:P78_VEHICLENO,'%')
                        and ( GetUserPanelAB_apex() is null  or mo.panel = GetUserPanelAB_apex())
                  and ( :P78_PARTY IS NULL OR instr(':'||:P78_PARTY||':',':'||a.PartyCode||':') > 0 )
                  and ( :P78_TRANSPORTER IS NULL OR instr(':'||:P78_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 )
                  and ( :P78_ITEM IS NULL OR instr(':'||:P78_ITEM||':',':'||a.ItemCode||':') > 0 ) 
                  and ( :P78_ITEMSPECIFICATION IS NULL OR instr(':'||:P78_ITEMSPECIFICATION||':',':'||a.ItemSpecificationCode||':') > 0 ) 
                  --and a.materialOutNo  like nvl(:P78_MONO,'%')
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 52301072202649911
        }

