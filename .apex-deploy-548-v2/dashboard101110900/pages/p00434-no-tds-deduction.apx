    region no-tds-deduction (
        name: No TDS Deduction
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                  row_number() over(order by a.DocumentDate) SerialNo,
                  a.CompanyName,
                  a.LocationName,
                  a.Documenttype,
                  a.DocumentNo,
                  a.DocumentDate,
                  a.VoucherNo,
                  a.VoucherDate,
                  a.ModuleType,
                  a.ModuleNo,
                  a.ModuleDate,
                  a.VehicleNo,
                  a.TransporterName
                From NOTDSDeducted a
                Where a.DocumentDate Between :P434_FROMDATE and :P434_TODATE
                  and ( :P434_COMPANY IS NULL OR instr(':'||:P434_COMPANY||':',':'||a.CompanyCode||':') > 0 );
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
