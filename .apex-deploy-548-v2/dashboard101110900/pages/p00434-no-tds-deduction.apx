                sequence: 10
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P434_CCINO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P434_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P434_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 50741531661528677
        }
    )

