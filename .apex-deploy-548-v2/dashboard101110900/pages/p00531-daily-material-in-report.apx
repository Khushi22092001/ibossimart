    pageItem P531_TRANSPORTER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Transporter
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      p.PartyName d,
                      p.PartyCode r
                From MaterialIn a, Party p
                Where a.TransporterCode = p.PartyCode
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @daily-material-in-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 74
            valuePlaceholder: Transporter Name
        }
        sessionState {
            storage: request
        }
    )

    pageItem P531_VEHICLENO (
        type: textFieldWithAutocomplete
        label {
            label: Vehicle No
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnType: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        a.VehicleNo
                From MaterialIn a
                
                Union
                
                Select
                        Distinct
                        a.VehicleNo
                From MaterialOut a
                ```
        }
        layout {
            sequence: 110
            region: @daily-material-in-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
