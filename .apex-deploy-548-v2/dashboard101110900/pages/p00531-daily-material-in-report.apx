page 531 (
    name: Daily Material In Report
    alias: DAILY-MATERIAL-IN-REPORT
    title: Daily Material In Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/materialinregister.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P36_FROMDATE').val());
              var toDate = new Date($('#P36_TODATE').val());
            
              var reportParams = 
                  '&P_COMPANY='+ $('#P36_COMPANY').val() +  
                  '&P_LOCATION=' + $('#P36_LOCATION').val() +    
                  '&P_FROMDATE=' +$('#P36_FROMDATE').val() + 
                  '&P_TODATE=' +$('#P36_TODATE').val() + 
                  '&P_DOCTYPE=' +$('#P36_DOCTYPE').val() +
                  '&P_PARTY=' +$('#P36_PARTY').val() +
                  '&P_GRNSTATUS=' +$('#P36_GRNSTATUS').val() +
                  '&P_TRANSPORTER=' +$('#P36_TRANSPORTER').val() +
                  '&P_VEHICLENO=' +$('#P36_VEHICLENO').val() +
                  '&P_ITEM=' +$('#P36_ITEM').val() +
                  '&P_MINO=' +$('#P36_MINO').val() +
            	    '&P_ITEMSPECIFICATION=' +$('#P36_ITEMSPECIFICATION').val() +
                  '&P_CREATOR=' +$('#P36_CREATOR').val()  
                  ;
              
              var reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            ```
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region daily-material-in-report (
        name: Daily Material In Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region daily-material-in-report-2 (
        name: Daily Material In Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       row_number() over(order by a.Tno) SerialNo,
                       a.LOCATIONCODE,
                       a.DOCTYPECODE,
                       a.LOCATIONNAME,
                       PO.LOCATIONCODE AS POLOCATIONCODE,
                       PO.DOCTYPECODE  AS PODOCTYPECODE,
                       GETLOCATIONNAME(PO.LOCATIONCODE) POLOCATIONNAME,
                       GETDOCTYPENAME(PO.DOCTYPECODE) AS PODOCTYPENAME,
                       Upper(a.DOCTYPENAME) DOCTYPENAME,
                       a.MATERIALINNO,
                       a.MATERIALINDATE,
                       a.PARTYCODE,
                       a.PARTYNAME,
                       a.REFDOCNO,
                       a.REFDOCDATE,
                       a.REFDOCAMOUNT,
                       a.TRANSPORTERCODE,
                       a.TRANSPORTER,
                       a.VEHICLENO,
                       a.VEHICLETYPENAME,
                       a.DRIVERNAME,
                       a.LRNO,
                       a.LRDATE,
                       a.ITEMCODE,
                       a.ITEMNAME,
                       a.ITEMSPECIFICATIONCODE,
                       a.ITEMSPECIFICATIONNAME,
                       a.ITEMNAME||' ~ '||a.ITEMSPECIFICATIONNAME as MATERIALDESCRIPTION,
                       a.UOM,
                       a.UOM2,
                       round(a.QUANTITY1,3) as QUANTITY1,
                       ROUND(a.Quantity2,3) AS Quantity2,
                       a.PACKINGTYPENAME,
                       Upper(a.MODULE) MODULE,
                       a.MODULENO,
                       a.MODULEDATE,
                       a.WEIGHMENTTNO,
                       a.WEIGHMENTNO,
                       a.WEIGHMENTDATE,
                       a.FIRSTWEIGHT,
                       a.SECONDWEIGHT,
                       a.NETWEIGHT,
                       a.ACCEPTEDWEIGHT,
                       a.Creator,
                       a.CreationTime,
                       a.CreatedFrom,
                       Case When a.AcceptedWeight < a.Quantity1 then 'RED_COLOR'
                            When a.AcceptedWeight = a.Quantity1 then 'GREEN_COLOR'
                       Else 'YELLOW_COLOR'
                       End as Color_Value,
                       a.GRNStatus,
                       a.GRNNO,
                       a.GRNDate,
                       GetEmployeeName(bu.EmployeeCode)||'( '||g.Creator||' )' as GRNCreator,
                       g.CreationTime as GRNCreationTime,
                       a.RakeTno,
                       a.RakeNo,
                       A.GATEINTIME,
                       A.GATEOUTTIME,
                       A.QUANTITY1 AS CHALLANQUANTITY
                From GATEINREGISTER_VIEW a, Grn g, Bossuser bu, MaterialIn mn, Purchaseorder po
                Where a.MaterialInDate between nvl(:P531_FROMDATE,trunc(sysdate) - 1) and nvl(:P531_TODATE,trunc(sysdate) - 1)
                  and instr(':'||:P531_COMPANY||':',':'||a.CompanyCode||':') > 0
                   AND (:P531_LOCATION IS NULL OR (instr(':'||:P531_LOCATION||':',':'||a.LocationCode||':') > 0))
                  
                  --(:P531_TODOLIST = 'YES' OR :P531_NEXTPROCESS = 'YES' OR (a.MaterialInDate between :P531_FROMDATE and :P531_TODATE))
                  --and (:P531_TODOLIST = 'YES' OR :P531_NEXTPROCESS = 'YES' OR (instr(':'||:P531_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  --and (:P531_TODOLIST = 'YES' OR :P531_NEXTPROCESS = 'YES' OR (instr(':'||:P531_LOCATION||':',':'||a.LocationCode||':') > 0))
                 
                  and (:P531_DOCTYPE IS NULL OR instr(':'||:P531_DOCTYPE||':',':'||mn.DocTypeCode||':') > 0 )
                  AND (:P531_POLOCATION IS NULL OR (instr(':'||:P531_POLOCATION||':',':'||a.LocationCode||':') > 0))
                  and (:P531_PODOCTYPE IS NULL OR instr(':'||:P531_PODOCTYPE||':',':'||PO.DocTypeCode||':') > 0 )
                 
                  and (:P531_PARTY IS NULL OR instr(':'||:P531_PARTY||':',':'||a.PartyCode||':') > 0 )
                  and (:P531_TRANSPORTER IS NULL OR instr(':'||:P531_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 )
                  and (:P531_ITEM IS NULL OR instr(':'||:P531_ITEM||':',':'||a.ItemCode||':') > 0 ) 
                  and (:P531_ITEMSPECIFICATION IS NULL OR instr(':'||:P531_ITEMSPECIFICATION||':',':'||a.ItemSpecificationCode||':') > 0 ) 
                 -- and a.VehicleNo like nvl(:P531_VEHICLENO,'%')
                 -- and a.GRNSTATUS like nvl(:P531_GRNSTATUS,'%')
                 -- and a.MaterialInNo like nvl(:P531_MINO,'%')
                  and (:P531_RAKENO is null or mn.raketno = :P531_RAKENO)
                 -- and a.RakeTno like nvl(:P531_RAKENO,'%')
                  and ( :P531_CREATOR IS NULL OR instr(':'||:P531_CREATOR||':',':'||a.Creator||':') > 0 )
                  and  a.GRNTNo = g.TNo(+)
                  and g.Creator = bu.LoginName(+)
                  and a.Tno = mn.Tno(+)
                  and mn.purchaseordertno = po.tno(+)
                  and a.NETWEIGHT is not null
                  -- 22-APR-2025
                  AND MN.PANEL='A'
                  --and ( GetUserPanelAB_apex() is null  or MN.panel = GetUserPanelAB_apex())
                --   AND ( :P531_TODOLIST='NO' OR (:P531_TODOLIST='YES' AND EXISTS ( SELECT 1 FROM ONTHETABLE_APEX YY WHERE YY.TNO=A.TNO) ))
                -- AND ( :P531_NEXTPROCESS = 'NO' OR (:P531_NEXTPROCESS = 'YES' AND (  getdocumentstatuscode('MATERIALIN',A.TNO)='ACTIVE'
                --                                     AND  NOT EXISTS (Select 1 From GRN AA Where AA.Materialintno = A.TNO)
                --                                 ))
                
                --  )
                ```
            pageItemsToSubmit: [
                P531_COMPANY
                P531_LOCATION
                P531_DOCTYPE
                P531_FROMDATE
                P531_TODATE
                P531_RAKENO
                P531_PARTY
                P531_GRNSTATUS
                P531_TRANSPORTER
                P531_VEHICLENO
                P531_CREATOR
                P531_POLOCATION
                P531_PODOCTYPE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: t-Form--search
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        download {
