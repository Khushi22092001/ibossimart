        type: textFieldWithAutocomplete
        label {
            label: Mi No
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select MaterialInNo 
                From MaterialIn 
                Where instr(':'||:P531_LOCATION||':',':'||LocationCode||':') > 0
                --  and instr(':'||:P114_DOCTYPE||':',':'||DocTypeCode||':') > 0
                  and MaterialInDate Between :P531_FROMDATE and :P531_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P531_LOCATION
            itemsToSubmit: P531_MINO
