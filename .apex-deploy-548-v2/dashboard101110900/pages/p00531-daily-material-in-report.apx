        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report(Material In)
        }

        savedReport 42431 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCEPTEDWEIGHT (
                sequence: 17
            )

            displayColumn CHALLANQUANTITY (
                sequence: 13
            )

            displayColumn FIRSTWEIGHT (
                sequence: 15
            )

            displayColumn MATERIALDESCRIPTION (
                sequence: 10
            )

            displayColumn MATERIALINDATE (
                sequence: 3
            )

            displayColumn MATERIALINNO (
                sequence: 4
            )

            displayColumn MODULENO (
                sequence: 6
            )

            displayColumn PARTYNAME (
                sequence: 5
            )

            displayColumn POLOCATIONNAME (
                sequence: 2
            )

            displayColumn QUANTITY1 (
                sequence: 12
            )

            displayColumn REFDOCDATE (
                sequence: 8
            )

            displayColumn REFDOCNO (
                sequence: 7
            )

            displayColumn SECONDWEIGHT (
                sequence: 16
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn UOM (
                sequence: 11
            )

            displayColumn VEHICLENO (
                sequence: 9
            )

            displayColumn WEIGHMENTNO (
                sequence: 14
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DOCTYPENAME
                sort {
                    sequence: 2
                }
            )

            sort (
                column: PARTYNAME
                sort {
                    sequence: 3
                }
            )

            sort (
                column: MATERIALINDATE
                sort {
                    sequence: 4
                }
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: FIRSTWEIGHT
            )

            aggregate (
                column: SECONDWEIGHT
            )

            aggregate (
                column: NETWEIGHT
            )

            aggregate (
                column: ACCEPTEDWEIGHT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P531_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'MATERIALIN'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @daily-material-in-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Company Name
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
        sessionState {
            storage: request
        }
    )

    pageItem P531_CREATOR (
