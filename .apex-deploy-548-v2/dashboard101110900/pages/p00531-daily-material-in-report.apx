                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        ee.ItemSpecificationName as d,
                        ee.ItemSpecificationCode as r
                From Item e, ItemSpecification ee
                Where e.ItemCode = :P531_ITEM
                and   e.TNo = ee.TNo
                
                Union
                
                Select
                        Distinct
                        ee.ItemSpecificationName as ItemName,
                        ee.ItemSpecificationCode as ItemCode
                From MaterialOutDetail a, Item e, ItemSpecification ee
                Where e.ItemCode = :P531_ITEM
                and   e.TNo = ee.TNo
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P531_ITEM
            itemsToSubmit: P531_ITEMSPECIFICATION
