page 231 (
    name: EMI Summary Report
    alias: EMI-SUMMARY-REPORT
    title: EMI Summary Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region emi-summary-report (
        name: EMI Summary Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     1 as mysno,
                     --a.TNO ,
                     a.COMPANYCODE,
                     a.FINANCIALYEARCODE,
                     a.LOCATIONCODE,
                     a.DOCTYPECODE,
                     a.LOANNO  ,
                     a.LOANDATE,
                     A.EMI, 
                     a.partycode, 
                	 c.PartyName,
                     e.EquipmentName,
                     a.REMARK,
                	 a.LoanAmount as TotalLoan,
                	 a.InterestAmount as TotalInterest,	 
                	 a.PaidAmount,
                	 a.BalanceAmount,
                	 a.ROI,
                	 a.NoOfEMI, 
                     
                     Round(nvl(f.PrincipleAmount,0),2) as Openingason,
                     Round(nvl(g.INTERESTAMOUNT,0),2) as HpCharges,
                     Round(nvl(AMOUNTCR,0),2)as PAIDDURING,
                     Round(nvl(f.PrincipleAmount,0)-nvl(i.principleamount2,0)) as BalanceAsOn,
                     nvl(a.LoanAmount, 0) - nvl(a.BalanceAmount - nvl(a.PaidAmount, 0), 0) as TotalPaid
                from  Loan a,Party c, Equipment e,
                ( 		select
                        
                  			SUM(b.principleamount) AS principleamount
                  		from 
                  				loan a , loandetail b , paymentadvice c
                  		where
                  		     a.tno = b.tno 
                  		     and b.tno = c.loantno 
                  		     and b.sno = c.loansno 
                  		     and a.TNO like nvl(:P231_PAYMENTADVICENO, '%')
                  		     and c.paymentadvicedate < NVL(:P231_FROMDATE,trunc(sysdate))
                ) f,
                
                (
                        select
                  			SUM(B.INTERESTAMOUNT) as INTERESTAMOUNT  
                  		from 
                  				loan a, loandetail b , paymentadvice c
                  		where
                  		     a.tno = b.tno 
                  		     and b.tno = c.loantno 
                  		     and b.sno = c.loansno 
                                     and a.TNO like nvl(:P231_PAYMENTADVICENO, '%')
                  		     and c.paymentadvicedate BETWEEN  NVL(:P231_FROMDATE,trunc(sysdate))  
                                     and NVL(:P231_TODATE,trunc(sysdate))
                ) g,
                
                (
                  		select
                  			SUM(C.AMOUNTCR) as AMOUNTCR
                  		from 
                  				loan a, loandetail b , paymentadvice c
                  		where
                  		     a.tno = b.tno 
                  		     and b.tno = c.loantno 
                  		     and b.sno = c.loansno 
                  		     and a.TNO like nvl(:P231_PAYMENTADVICENO, '%')
                    		     and c.paymentadvicedate BETWEEN NVL(:P231_FROMDATE,TRUNC(SYSDATE))
                                     AND NVL(:P231_TODATE, TRUNC(SYSDATE) ) 
                ) h,
                
                (
                	select
                  			SUM(B.principleamount) as PrincipleAmount2  
                  		from 
                  				loan a, loandetail b , paymentadvice c
                  		where
                  		     a.tno = b.tno 
                  		     and b.tno = c.loantno 
                  		     and b.sno = c.loansno 
                  		     and a.TNO like nvl(:P231_PAYMENTADVICENO, '%')
                  		     and c.paymentadvicedate BETWEEN  NVL(:P231_FROMDATE,trunc(sysdate))  
                                     and NVL(:P231_TODATE,trunc(sysdate))
                ) i
                where a.PartyCode = c.PartyCode
                	and a.EquipmentTNO = e.TNo 
                        and a.TNO like nvl(:P231_PAYMENTADVICENO, '%') 
                  and (:P231_DOCTYPE is null or instr(':'||:P231_DOCTYPE||':',':'||a.DocTypeCode||':') > 0)
                  
                --	and a.CompanyCode = :p_CompanyCode;
                --order by a.LoanDate, a.tno;
                ```
            pageItemsToSubmit: [
                P231_FROMDATE
                P231_TODATE
                P231_PAYMENTADVICENO
                P231_DOCTYPE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 21188536791854450
        }

