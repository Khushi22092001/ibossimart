page 538 (
    name: test pivot
    alias: TEST-PIVOT
    title: test pivot
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region test-pivot (
        name: test pivot
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select GETPARTYNAME(A.PARTYCODE) PARTY,A.VEHICLENO,C.ITEMSPECIFICATIONNAME,B.QUANTITY1
                from despatchadvice a, despatchadvicedetail b, ITEMSPECIFICATION C, DocumentStatusDetail dsd
                where a.tno = b.tno 
                 and not exists ( select 1 from ccinvoice aa
                where aa.despatchadvicetno = a.tno)
                and a.doctypecode != 'INTERUNITTRANSFER'
                and b.itemspecificationcode = c.itemspecificationcode
                and c.itemcategorycode='PIPES'
                and a.Tno = dsd.ModuleTno
                and dsd.DocumentStatusCode = 'ACTIVE'
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 2657729949658053
        }

        column ITEMSPECIFICATIONNAME (
            type: plainText
            heading {
                heading: Itemspecificationname
            }
            layout {
                sequence: 21
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column PARTY (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Quantity1
                alignment: end
            }
            layout {
                sequence: 31
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: Vehicleno
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: test pivot
        }

        savedReport 26599 (
            visibility: primaryDefault
            view {
                pivot: true
                default: pivot
                rowsPerPage: 50
            }

            displayColumn ITEMSPECIFICATIONNAME (
                sequence: 2
            )

            displayColumn PARTY (
                sequence: 1
            )

            displayColumn QUANTITY1 (
                sequence: 4
            )

            displayColumn VEHICLENO (
                sequence: 3
            )

            pivotColumn (
                column: PARTY
                layout {
                    sequence: 1
                }
            )

            pivotColumn (
                column: VEHICLENO
                layout {
                    sequence: 2
                }
            )

            pivotRowColumn (
                column: ITEMSPECIFICATIONNAME
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg (
                aggregate {
                    function: sum
                    column: QUANTITY1
                }
                appearance {
                    formatMask: 999G999G999G999G990D000
                }
                layout {
                    sequence: 1
                }
            )

        )

    )

)

