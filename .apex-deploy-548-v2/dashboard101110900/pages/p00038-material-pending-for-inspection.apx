    region pending-material-inspection (
        name: Pending Material Inspection
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT row_number() over(order by xx.GRNDate) SerialNo,
                xx.* FROM 
                (
                Select
                    a.TNo,
                    b.SNo,
                    l.LocationName,
                    d.DocTypeName,
                    a.GRNNo,
                    a.GRNDate,
                    p.PartyName,
                    e.ItemCode,
                    e.ItemName||' ~ '||ee.ItemSpecificationName as Material,
                    e.MeasuringUnitCode1,
                    ROUND(b.ReceivedQuantity1,2) AS ReceivedQuantity1,
                    nvl(pod.Rate,ccd.Rate) as Rate,
                    round((b.ReceivedQuantity1 * nvl(pod.Rate,ccd.Rate)),2) as Amount,
                    case   When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                           When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When dsd.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End as DocStatus,
                      bue.EmployeeName||' ( '||a.Creator||' )' as Creator,
                      Round(((SYSDATE) - A.GRNDate),0) as PendingDays,
                      GetDepartmentName(di.DepartmentCode) as Department,
                      DI.TNO AS DINSPECTIONTNO
                From GRN a, GRNDetail b, Location l, DocType d, Party p, DocumentStatusDetail dsd, Item e, ItemSpecification ee, Bossuser bu, Employee bue, PurchaseOrderDetail pod, Dinspection di,
                     (Select gd.TNo,
                             gd.SNo,
                             ci.TNo as CCTNO,
                             cci.ItemCode,
                             cci.ItemSpecificatioNCode,
                             cci.Rate
                      From CCinvoice ci, CCInvoiceDetail cci, GRN g, GRNDetail gd
                      Where ci.TNo = cci.TNo
                        and ci.TNo  = g.InterUnitTransferCCInvoiceTNo
                        and g.TNo = gd.TNo
                        and cci.ItemCode = gd.ItemCode
                        and cci.ItemSpecificationCode = gd.ItemSPecificationCode
                      ) ccd
                Where a.TNo = b.TNo
                  and a.LocationCode = l.LocationCode
                  and a.DocTypeCode = d.DocTypeCode
                  and a.PartyCode = p.PartyCode
                  and a.TNo = dsd.ModuleTNo(+)
                  and e.TNo = ee.TNo
                  and b.ItemCode = e.ItemCode(+)
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)
                  and b.PurchaseOrderTNo = pod.TNo(+)
                  and b.ItemCode = pod.ItemCode(+)
                  and b.ItemSpecificationCode = pod.ItemSpecificationCode(+)
                  and b.TNO = ccd.TNO(+)
                  and b.SNo = ccd.SNO(+)
                  and a.TNo = di.GRNTNo(+)
                   AND  NOT EXISTS ( Select 1 From inspection AA Where AA.grntno = A.TNO )
                    -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  --and (a.doctypecode != 'EQUIPMENTTRANSFER' OR (not exists (Select i.GRNTNo From Inspection i Where i.GRNTNo = a.TNo)))
                  and (:P38_TODOLIST = 'YES' OR :P38_NEXTPROCESS = 'YES' OR (a.GRNDate Between :P38_FROMDATE and :P38_TODATE ))
                  and (:P38_TODOLIST = 'YES' OR :P38_NEXTPROCESS = 'YES' OR (instr(':'||:P38_COMPANY||':',':'||a.CompanyCode||':') > 0 ))
                  and (:P38_TODOLIST = 'YES' OR :P38_NEXTPROCESS = 'YES' OR (instr(':'||:P38_DOCTYPE||':',':'||a.DocTypeCode||':') > 0 ))
                  and (:P38_TODOLIST = 'YES' OR :P38_NEXTPROCESS = 'YES' OR (instr(':'||:P38_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and ( :P38_ITEM IS NULL OR instr(':'||:P38_ITEM||':',':'||e.ItemCode||':') > 0 )
                  and ( :P38_ITEMSPECIFICATION IS NULL OR instr(':'||:P38_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                  and ( :P38_PARTY IS NULL OR instr(':'||:P38_PARTY||':',':'||a.PartyCode||':') > 0 )
                  and ( :P38_DEPARTMENT IS NULL OR instr(':'||:P38_DEPARTMENT||':',':'||di.DepartmentCode||':') > 0 )
                /* cHANGED ON 28-MAY-2022
                  and ( :P38_ITEMGROUP IS NULL OR instr(':'||:P38_ITEMGROUP||':',':'||e.ParentCode||':') > 0 )
                */
                and ( :P38_ITEMGROUP IS NULL
                      or
                      exists (select 1 from (Select ITEMCODE,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                               Level,
                               CONNECT_BY_ROOT itemcode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From item a
                         Start With parentcode in ( select itemcode from item xx where
                                                    instr(':'||:P38_ITEMGROUP||':',':'||xx.ItemCode||':') > 0)
                                                    
                        Connect By parentcode = Prior itemcode
                         Order Siblings By itemcode) x where x.itemcode = e.itemcode
                        )
                  )
                  and case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                           When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When dsd.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End  like nvl(:P38_STATUS,'%')
                ) XX
                where (:P38_TODOLIST='NO' OR  (:P38_TODOLIST='YES' AND EXISTS ( SELECT 1 FROM ONTHETABLE_APEX YY WHERE YY.MODULETNO=XX.DINSPECTIONTNO) ))
                AND ( :P38_NEXTPROCESS = 'NO' OR (:P38_NEXTPROCESS = 'YES' AND (  getdocumentstatuscode('GRN',XX.TNO)='ACTIVE'
                                                    AND  NOT EXISTS ( Select 1 From inspection AA Where AA.grntno = XX.TNO )
                                                )
                                                )
                
                 )
                
                ```
        }
