            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select    Distinct
                          ee.ItemSpecificationName as d,
                          ee.ItemSpecificationCode as r
                
                From Item e, ItemSpecification ee
                Where e.TNo = ee.TNo
                  and e.ItemCode = :P38_ITEM
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P38_ITEM
            itemsToSubmit: [
                P38_DEPARTMENT
                P38_ITEMSPECIFICATION
            ]
        }
        layout {
            sequence: 110
            region: @material-pending-for-inspection
