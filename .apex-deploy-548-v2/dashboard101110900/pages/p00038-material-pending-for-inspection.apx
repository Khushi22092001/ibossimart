                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select    Distinct
                          e.ItemName||' ~ '||e.ItemCode as d,
                          e.ItemCode  as r
                
                From GRNDetail a, Item e
                Where a.ItemCode = e.ItemCode
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @material-pending-for-inspection
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Material Name
        }
    )

