    button custom (
        buttonName: CUSTOM
        label: Custom
        layout {
            sequence: 20
            region: @pending-material-inspection
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/pendingmaterailinspection.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P38_FROMDATE=&P38_FROMDATE.&P38_TODATE=&P38_TODATE.&P38_LOCATION=&P38_LOCATION.&P38_STATUS=&P38_STATUS.&P38_BREAKUPAS=&P38_BREAKUPAS.&P38_BREAKUP=&P38_BREAKUP.&P38_DEPARTMENT=&P38_DEPARTMENT.&P38_DOCTYPE=&P38_DOCTYPE.&P38_ITEMGROUP=&P38_ITEMGROUP.&P38_ITEM=&P38_ITEM.&P38_ITEMSPECIFICATION=&P38_ITEMSPECIFICATION.&P38_PARTY=&P38_PARTY.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 2
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @pending-material-inspection
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 150
            region: @material-pending-for-inspection
            slot: regionBody
            startNewRow: false
            column: 9
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

