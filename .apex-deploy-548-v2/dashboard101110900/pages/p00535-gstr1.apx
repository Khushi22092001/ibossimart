    pageItem P535_GSTR1NO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: GSTR1 NO
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                GSTR1NO D,
                TNO R
                FROM GSTR1 ORDER BY TNO DESC;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @gstr-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 6
            labelColumnSpan: 1
        }
