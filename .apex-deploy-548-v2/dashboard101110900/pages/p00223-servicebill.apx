page 223 (
    name: Service Bill Summary
    alias: SERVICEBILL
    title: Service Bill Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region service-bill-summary (
        name: Service Bill Summary
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @service-bill-summary-report
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
    )

    region service-bill-summary-report (
        name: Service Bill Summary Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select	
                       row_number() over(order by a.ServiceBillDate) SerialNo,
                		a.Tno, 
                      co.CompanyName,
                		b.LocationName,
                		c.DoctypeName, 
                      slr.SourceLocationName,
                      slr.DestinationLocationName,
                      round(slr.ChallanQuantity,3) as ChallanQuantity,
                      round(slr.ReceivedQuantity,3) as BillingQuantity,
                      round(slr.ShortageQuantity,3) as ShortageQuantity,
                      round(slr.BillingQty,3) as ReceivedQty,
                      slr.Rate,
                      round(slr.BalanceQty,3) as BalanceQty,
                		round(a.SumofAmount,2) as SumofAmount,
                		round(a.SumofFooterAmount,2) as SumofFooterAmount,
                		round(a.ServiceBillAmount,2) as ServiceBillAmount,
                		a.ReferenceText,
                      e.ItemName,
                      fb.FreightBasisName,
                      d.PartyName,
                		a.ServiceBillDate,
                		a.ServiceBillNo,
                      g.RouteName,
                      a.Creator,
                      a.FromDate || ' to ' || a.ToDate as BillingPeriod,
                      h.PartyDoNo,
                      i.Quantity1 as DOQuantity,
                      h.WorkOrderNo,
                      j.AllotmentSchemeName,
                      'LR Detail'
                From ServiceBill a, Location b, DocType c, Party d,Item e,ServiceBillDetail f,Company co,
                FreightBasis fb, Route g,DeliveryOrder h, DeliveryOrderDetail i, AllotmentScheme j,
                (Select 
                    a.Tno,
                    sum(a.Rate) as Rate,
                    Sum(a.DispatchedQuantity1) as ChallanQuantity,
                    sum(a.Quantity1) as ReceivedQuantity,
                    sum(b.ShortageQuantity1) as ShortageQuantity,
                    sum(a.ReachedQuantity1) as BillingQty,
                    case When sum(a.Quantity1)- Sum(c.Quantity1) > 0 
                    then sum(a.Quantity1)- Sum(c.Quantity1)
                    Else null end as BalanceQty,
                    d.SourceLocationName,
                    e.DestinationLocationName
                 From ServiceBillDetail a, ServiceBillLr b, Lr c, PODDetail P, Sourcelocation d, Destinationlocation e
                 Where a.Tno = b.Tno(+)
                   and b.LrTno = c.Tno(+)
                   and b.PODTno = P.Tno(+)
                   and b.PODSno = P.Sno(+)
                   and c.sourcelocationtno = d.tno(+)
                   and c.destinationlocationtno = e.tno(+)
                   and b.sno in (Select 
                                  min(t2.sno)
                                From ServiceBillDetail t1, ServiceBillLr t2, Lr t3
                                Where t1.Tno = t2.Tno(+)
                                  and t2.LrTno = t3.Tno(+)
                                  and t1.Tno = a.tno)
                             Group by a.Tno,
                               d.SourceLocationName,
                               e.DestinationLocationName) slr
                Where a.LocationCode = b.LocationCode
                and   a.DocTypeCode = c.DocTypeCode
                and   a.PartyCode = d.PartyCode
                and   a.ItemCode = e.ItemCode
                and   a.TNO = f.TNO
                and   a.CompanyCode = co.CompanyCode
                and   a.FreightBasisCode = fb.FreightBasisCode
                and   a.RouteCode = g.RouteCode(+)
                and   a.DeliveryOrderTno = h.Tno(+)
                and   h.Tno = i.Tno(+)
                and   h.AllotmentSchemeCode = j.AllotmentSchemeCode(+)
                and   f.Tno = slr.Tno(+)
                and   a.ServiceBillDate between :P223_FROMDATE and :P223_TODATE
                and (:P223_LOCATION is Null Or Instr (':' || :P223_LOCATION || ':' , ':' || b.LocationCode|| ':') > 0)
                and (:P223_COMPANY is Null Or Instr (':' || :P223_COMPANY || ':' , ':' || co.CompanyCode|| ':') > 0)
                and (:P223_PARTY is Null Or Instr (':' || :P223_PARTY || ':' , ':' || d.PartyCode|| ':') > 0)
                and ( :P223_DOCTYPE  IS NULL OR instr(':'||:P223_DOCTYPE||':',':'|| a.DoctypeCode||':') > 0 )
                and (:P223_SERVICEBILL is Null Or Instr (':' || :P223_SERVICEBILL || ':' , ':' ||a.Tno|| ':') > 0)
                and (:P223_SOURCE is Null Or Instr (':' || :P223_SOURCE || ':' , ':' || slr.SourceLocationName|| ':') > 0)
                and (:P223_DESTINATION is Null Or Instr (':' || :P223_DESTINATION || ':' , ':' ||slr.DestinationLocationName|| ':') > 0)
                and (:P223_PARTYDO is Null Or Instr (':' || :P223_PARTYDO || ':' , ':' ||h.PartyDONO|| ':') > 0)
                ORDER BY a.ServiceBillDate asc
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                -- Select	
                -- 		a.TNo, 
                --       co.CompanyName,
                -- 		b.LocationName,
                -- 		c.DoctypeName, 
                -- 		a.SumofAmount,
                -- 		a.SumofFooterAmount,
                -- 		a.ServiceBillAmount,
                -- 		a.ReferenceText,
                --         i.ItemName,
                --         fb.FreightBasisName,
                --         p.PartyName,
                -- 		a.ServiceBillDate,
                -- 		a.ServiceBillNo,
                --         'LR Detail'
                       
                -- From
                --         ServiceBill a, 
                --         Location b, 
                --         DocType c,  
                --         Party p,
                --         Item i,
                --         ServiceBillDetail s,
                --         Company co,
                --         FreightBasis fb
                -- Where a.LocationCode = b.LocationCode
                -- and   a.DocTypeCode = c.DocTypeCode
                -- and   a.PartyCode = p.PartyCode
                -- and   a.ItemCode = i.ItemCode
                -- and   a.TNO = s.TNO
                -- and   a.CompanyCode = co.CompanyCode
                -- and   a.FreightBasisCode = fb.FreightBasisCode
                -- and   a.ServiceBillDate between :P223_FROMDATE and :P223_TODATE
                -- and (:P223_LOCATION is Null Or Instr (':' || :P223_LOCATION || ':' , ':' || b.LocationCode|| ':') > 0)
                -- and (:P223_COMPANY is Null Or Instr (':' || :P223_COMPANY || ':' , ':' || co.CompanyCode|| ':') > 0)
                -- and (:P223_PARTY is Null Or Instr (':' || :P223_PARTY || ':' , ':' || p.PartyCode|| ':') > 0)
                -- and ( :P254_DOCTYPE  IS NULL OR instr(':'||:P254_DOCTYPE||':',':'|| c.DoctypeCode||':') > 0 )
                -- and (:P223_SERVICEBILL is Null Or Instr (':' || :P223_SERVICEBILL || ':' , ':' ||a.Tno|| ':') > 0)
                -- ORDER BY a.ServiceBillDate asc;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
