                From Location a
                Where exists(
                   Select
                      aa.LocationCode
                   From Servicebill aa
                   Where aa.LocationCode = a.LocationCode
                )
                Order by 1
                ```
            displayExtraValues: false
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 50
            region: @service-bill-summary
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

