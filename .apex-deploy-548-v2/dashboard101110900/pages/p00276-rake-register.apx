page 276 (
    name: Rake Register
    alias: RAKE-REGISTER
    title: Rake Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region rake-register (
        name: Rake Register
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.CMPLRAKEDate) SerialNo,
                b.LocationName "Location Name",
                c.DocTypeName "DocType Name",
                a.CmplRakeDate "Cmpl Rake Date",
                a.CmplRakeNo "Cmpl Rake No",
                a.RakeNo "Rake No",
                a.RakeDate "Rake Date",
                d.PartyName "Party Name",
                e.WorkOrderNo "Work Order No",
                f.SourceLocationName,
                g.DestinationLocationName,
                a.RRNo "RR No",
                a.RRDate "RR Date",
                a.TotalWagen "Total Wagen",
                a.RRWeight "RR Weight",
                a.Remark,
                a.Creator
                from CMPLRAKE a, Location b, DocType c , Party d, WorkOrder e, SourceLocation f, DestinationLocation g
                where a.LocationCode = b.LocationCode (+)
                and  a.DocTypeCode = c.DocTypeCode(+)
                and a.PartyCode = d.PartyCode(+)
                and a.WorkOrderTno = e.Tno(+)
                and a.SourceLocationTno = f.Tno(+)
                and a.DestinationLocationTno = g.Tno(+)
                and a.CMPLRAKEDate between :P276_FROMDATE and :P276_TODATE
                and (:P276_LOCATIONNAME is null or instr(':'||:P276_LOCATIONNAME||':',':'||a.Locationcode||':') > 0)
                and (:P276_DOCTYPE is null or instr(':'||:P276_DOCTYPE||':',':'||a.Doctypecode||':') > 0)
                and (:P276_PARTY is null or instr(':'||:P276_PARTY||':',':'||a.Partycode||':') > 0)
                and (:P276_COMPANYNAME is null or instr(':'||:P276_COMPANYNAME||':',':'||a.Companycode||':') > 0)
                and (:P276_WORKORDERNO is null or instr(':'||:P276_WORKORDERNO||':',':'||a.WorkOrderTNo||':') > 0)
                and (:P276_CMPLRAKENO is null or instr(':'||:P276_CMPLRAKENO||':',':'||a.Tno||':') > 0);
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 14442647571632711
        }

