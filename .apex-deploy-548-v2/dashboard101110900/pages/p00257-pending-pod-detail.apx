page 257 (
    name: Pending POD Detail
    alias: PENDING-POD-DETAIL
    title: Pending POD Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region pending-pod-detail (
        name: Pending POD Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pending-pod-detail-report (
        name: Pending POD Detail Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.LRDATE) SerialNo,
                co.CompanyName,
                lo.LocationName,
                a.LrNo,
                a.LrDate,
                a.GPNo,
                d.PartyName,
                a.PartyRefNo as PartyDoNo,
                ld.LoadingOrderNo as PartyLoadingOrderNo,
                a.VehicleNo,
                b.TransporterName,
                round(a.Quantity1,3) as ChallanQty,
                c.SourceLocationName,
                de.DestinationLocationName,
                e.VehicleGroupName,
                f.ItemName,
                a.Creator
                from  Lr a, Transporter b, SourceLocation c, Party d, Company co, Location lo, LoadingOrder ld, DestinationLocation de,
                VehicleGroup e, Item f
                where  a.TransporterCode = b.TransporterCode(+)
                and a.SourceLocationTno = c.Tno(+)
                and a.PartyCode = d.PartyCode(+)
                and a.CompanyCode = co.CompanyCode(+)
                and a.LocationCode = lo.LocationCode(+)
                and a.LoadingOrderTno = ld.Tno(+)
                and a.DestinationLocationTno = de.Tno(+)
                and a.VehicleGroupCode = e.VehicleGroupCode(+)
                and a.ItemCode = f.ItemCode(+)
                and not exists 
                 (Select
                  aa.Tno from PODDetail aa 
                 Where aa.LrTno = a.Tno
                 )
                 and a.LrDate Between :P257_FROMDATE and :P257_TODATE
                and ( :P257_COMPANY IS NULL OR instr(':'||:P257_COMPANY||':',':'||co.CompanyCode||':') > 0 )
                and ( :P257_LOCATION IS NULL OR instr(':'||:P257_LOCATION||':',':'||lo.LocationCode||':') > 0 )
                and ( :P257_TRANSPORTER IS NULL OR instr(':'||:P257_TRANSPORTER||':',':'||b.TransporterCode||':') > 0 )
                and ( :P257_SOURCE IS NULL OR instr(':'||:P257_SOURCE||':',':'||c.SourceLocationCode||':') > 0 )
                and ( :P257_DESTINATION IS NULL OR instr(':'||:P257_DESTINATION||':',':'||de.DestinationLocationCode||':') > 0 )
                and ( :P257_VEHICLEGROUP IS NULL OR instr(':'||:P257_VEHICLEGROUP||':',':'||e.VehicleGroupCode||':') > 0 )
                and ( :P257_PARTYDONO IS NULL OR instr(':'||:P257_PARTYDONO||':',':'||a.PartyRefNo||':') > 0 )
                and ( :P257_PARTY IS NULL OR instr(':'||:P257_PARTY||':',':'||d.PartyCode||':') > 0 )
                ORDER BY a.LrDate asc
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                -- Select
                -- co.CompanyName,
                -- lo.LocationName,
                -- a.LrNo,
                -- a.LrDate,
                -- a.GPNo,
                -- d.PartyName,
                -- a.PartyRefNo as PartyDoNo,
                -- ld.LoadingOrderNo as PartyLoadingOrderNo,
                -- a.VehicleNo,
                -- b.TransporterName,
                -- a.Quantity1 as ChallanQty,
                -- c.SourceLocationName,
                -- de.DestinationLocationName
                -- from  Lr a, Transporter b, SourceLocation c, Party d, Company co, Location lo, LoadingOrder ld, DestinationLocation de
                -- where  a.TransporterCode = b.TransporterCode(+)
                -- and a.SourceLocationTno = c.Tno(+)
                -- and a.PartyCode = d.PartyCode(+)
                -- and a.CompanyCode = co.CompanyCode(+)
                -- and a.LocationCode = lo.LocationCode(+)
                -- and a.LoadingOrderTno = ld.Tno(+)
                -- and a.DestinationLocationTno = de.Tno(+)
                -- and not exists 
                --  (Select
                --   aa.Tno from PODDetail aa 
                --  Where aa.LrTno = a.Tno
                --  )
                --  and a.LrDate Between :P257_FROMDATE and :P257_TODATE
                -- and ( :P257_COMPANY IS NULL OR instr(':'||:P257_COMPANY||':',':'||co.CompanyCode||':') > 0 )
                -- and ( :P257_LOCATION IS NULL OR instr(':'||:P257_LOCATION||':',':'||lo.LocationCode||':') > 0 )
                -- and ( :P257_TRANSPORTER IS NULL OR instr(':'||:P257_TRANSPORTER||':',':'||b.TransporterCode||':') > 0 )
                -- and ( :P257_SOURCE IS NULL OR instr(':'||:P257_SOURCE||':',':'||c.SourceLocationCode||':') > 0 )
                -- and ( :P257_DESTINATION IS NULL OR instr(':'||:P257_DESTINATION||':',':'||de.DestinationLocationCode||':') > 0 )
                -- ORDER BY a.LrDate asc;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
