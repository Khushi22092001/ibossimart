    region vehicle-no-p29-vehicleno (
        name: Vehicle No : &P29_VEHICLENO.
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P216_SNO (
        type: hidden
        layout {
            sequence: 10
            region: @vehicle-no-p29-vehicleno
            slot: regionBody
        }
        source {
            type: databaseColumn
            databaseColumn: SNO
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P216_TNO (
        type: hidden
        layout {
            sequence: 30
            region: @vehicle-no-p29-vehicleno
            slot: regionBody
        }
        source {
            type: item
            item: P28_TNO
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P216_VEHICLENO (
        type: hidden
        layout {
            sequence: 20
            region: @vehicle-no-p29-vehicleno
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                Select a.vehicleno
                from COMPANYVEHICLE a
                where a.TNO=:P216_TNO
                ```
        }
        security {
            encryptSessionState: false
        }
    )

)

