page 216 (
    name: Vehicle Details
    alias: VEHICLE-DETAILS
    title: Vehicle Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        height: 550
        maxWidth: 1500
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region necessity-details (
        name: Necessity Details
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.TNO,
                      a.SNO,
                      a.SNO as ATTACHMENT,
                      b.VEHICLENECESSITYNAME,
                      a.MinNos,
                      a.RENEWALPERIODINMONTH,
                      a.RENEWALTOLERANCEDAYS,
                      a.ESTIMATEDCOST,
                      a.LASTRENEWALDATE,
                      a.RENEWALDISTANCEINKM,
                      a.RENEWALTOLERANCEKM,
                      a.COMPONENTSERIALNO,
                      a.LASTRENEWALMETERREADING,
                      a.NEXTDUEMETERREADING,
                      a.NEXTDUEDATE,
                      a.REMARK,
                	  (a.NEXTDUEDATE-trunc(sysdate)) as "Days Left"
                From COMPANYVEHICLEDETAIL a , VEHICLENECESSITY b
                
                Where a.VEHICLENECESSITYCODE=b.VEHICLENECESSITYCODE
                and   a.TNO=:P216_TNO
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 50389827403072275
        }

        savedReport 104402 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @VEHICLENECESSITYNAME
                layout {
                    width: 160
                    sequence: 3
                }
            )

            displayColumn (
                column: @MINNOS
