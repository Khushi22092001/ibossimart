                    width: 169
                    sequence: 5
                }
            )

            displayColumn (
                column: @RENEWALTOLERANCEDAYS
                layout {
                    width: 154
                    sequence: 6
                }
            )

            displayColumn (
                column: @ESTIMATEDCOST
                layout {
                    width: 107
                    sequence: 7
                }
            )

            displayColumn (
                column: @LASTRENEWALDATE
                layout {
                    width: 134
                    sequence: 8
                }
            )

            displayColumn (
                column: @RENEWALDISTANCEINKM
                layout {
                    width: 157
                    sequence: 11
                }
            )

            displayColumn (
                column: @RENEWALTOLERANCEKM
                layout {
                    width: 151
                    sequence: 12
                }
            )

            displayColumn (
                column: @COMPONENTSERIALNO
                layout {
                    width: 148
                    sequence: 13
                }
            )

            displayColumn (
                column: @LASTRENEWALMETERREADING
                layout {
                    width: 181
                    sequence: 14
                }
            )

            displayColumn (
                column: @NEXTDUEMETERREADING
                layout {
                    width: 162
                    sequence: 15
                }
            )

            displayColumn (
                column: @NEXTDUEDATE
                layout {
                    width: 109
                    sequence: 9
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    width: 92
                    sequence: 16
                }
            )

            displayColumn (
                column: @"Days Left"
                layout {
                    width: 72
                    sequence: 10
                }
            )

            displayColumn (
                column: @ATTACHMENT
                layout {
                    width: 100
                    sequence: 2
                }
            )

        )

        column ATTACHMENT (
            type: numberField
            heading {
                heading: Attachment
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 170
                columnAlignment: end
            }
            link {
                target: {
                    page: 217
                    items: {
                        P217_SNO: &ATTACHMENT.
                    }
                    clearCache: 217
                    action: resetPagination
                }
                linkText: Attachment
            }
            source {
                databaseColumn: ATTACHMENT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

