    region qc-sample-register-2 (
        name: QC Sample Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      aa.TNo,
                      l.Locationname,
                      aa.QCSampleNo,
                      aa.QCSampleDate,
                      p.PartyName,
                      aa.ItemCode,
                      e.ItemName||''||ee.ItemSpecificationName as Item,
                      e.MeasuringUnitCode1 as UOM,
                      po.PurchaseOrderNo,
                      mi.MaterialInNo,
                      mi.MaterialInDate,
                      mi.ChallanNo,
                      mi.ChallanDate,
                      mi.GRNNo,
                      mi.Quantity,
                      bb.Remark,
                      qt.tno as testtno,
                      qt.QualityTestNo,
                      qt.QualityTestDate
                From  QCSample aa, QCSampleDetail bb, Party p, PurchaseOrder po, Location l, Item e, itemSpecification ee, 
                      (Select
                            mm.TNo,
                            m.MaterialInNo,
                            m.MaterialInDate,
                            mm.PurchaseOrderTNo,
                            m.RefDocNo as ChallanNo,
                            m.RefDocDate as ChallanDate,
                            g.GRNNo,
                            g.GRNDate,
                            sum(mm.Quantity1) as Quantity
                       From MaterialIn m, MaterialInDetail mm, GRN g
                       Where m.TNo = mm.TNo
                         and m.TNo = g.MaterialInTNo(+)
                       Group By  mm.TNo,
                            m.MaterialInNo,
                            m.MaterialInDate,
                            mm.PurchaseOrderTNo,
                            m.RefDocNo,
                            m.RefDocDate,
                            g.GRNNo,
                            g.GRNDate
                       )mi, QualityTest qt
                Where aa.TNo = bb.TNo
                  and bb.ReferenceTNo = mi.TNo
                  and aa.PartyCode = p.PartyCode
                  and mi.PurchaseOrderTNo = po.TNo
                  and aa.ItemCode = e.ItemCode
                  and aa.ItemSpecificationCode = ee.ItemSpecificationCode
                  and aa.LocationCode = l.LocationCode
                  and aa.TNo = qt.QCSampleTNo(+)
                  and aa.QCSampleDate between :P149_FROMDATE and :P149_TODATE
                  and instr(':'||:P149_LOCATION||':',':'||aa.LocationCode||':') > 0
                  and ( :P149_ITEM IS NULL OR instr(':'||:P149_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P149_SPECIFICATION IS NULL OR instr(':'||:P149_SPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                  and ( :P149_PARTYNAME IS NULL OR instr(':'||:P149_PARTYNAME||':',':'||aa.PartyCode||':') > 0 ) 
                  and aa.QCSampleNo like nvl(:P149_QCSNO,'%')
                  and mi.MaterialInNo like nvl(:P149_MINO,'%')
                  and po.PurchaseOrderNo like nvl(:P149_PONO,'%')
                             
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
