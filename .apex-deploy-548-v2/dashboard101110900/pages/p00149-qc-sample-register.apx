            plsqlCode:
                ```plsql
                begin
                  if :P149_PONO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P149_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P149_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                
                
                begin
                
                if :P149_MINO IS NOT NULL THEN
