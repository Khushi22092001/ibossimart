            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/materialoutregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P165_FROMDATE=&P165_FROMDATE.&P165_TODATE=&P165_TODATE.&P165_LOCATION=&P165_LOCATION.&P165_DOCTYPE=&P165_DOCTYPE.&P165_ITEM=&P165_ITEM.&P165_ITEMSPECIFICATION=&P165_ITEMSPECIFICATION.&P165_TRANSPORTER=&P165_TRANSPORTER.&P165_PARTY=&P165_PARTY.&P165_VEHICLENO=&P165_VEHICLENO.&P165_MONO=&P165_MONO.
