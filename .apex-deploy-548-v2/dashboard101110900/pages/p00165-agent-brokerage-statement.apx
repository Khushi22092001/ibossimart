        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/Pending Freight Report.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P165_COMPANY.","_paramsP_LOCATION":"&P165_LOCATION.","_paramsP_FROMDATE":"&P165_FROMDATE.","_paramsP_TODATE":"&P165_TODATE.","_paramsP_DOCTYPE":"&P165_DOCTYPE.","_paramsP_TRANSPORTER":"&P165_TRANSPORTER.","_paramsP_VEHICLENO":"&P165_VEHICLENO.","_paramsP_PARTY":"&P165_PARTY.","_paramsP_ITEM":"&P165_ITEM."}');
                                                                                                       
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                begin
                  if :P165_MONO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P165_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P165_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 14320531580991474
        }
    )

)

