    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 20
            region: @agent-brokerage-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 1
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 160
            region: @agent-brokerage
            slot: regionBody
            column: 10
            columnSpan: 3
        }
