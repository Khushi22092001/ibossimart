page 165 (
    name: Agent Brokerage Statement
    alias: AGENT-BROKERAGE-STATEMENT
    title: Agent Brokerage Statement
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID1 .t-fht-thead{
              overflow: auto !important;
            }
            
            .m-10::before {
                content: url(#APP_IMAGES#smallinfomaticslogo.png);
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region agent-brokerage (
        name: Agent Brokerage
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
    )

    region agent-brokerage-report (
        name: Agent Brokerage Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  X.AGENTNAME,
                        X.ModuleCode,
                        x.CCINVOICENO,
                        x.ccinvoicedate,
                        x.PARTYNAME,
                        x.ITEMNAME,
                        X.SpecificationName,
                       X.QUANTITY1,
                       X.QUANTITY2,
                       X.UOM1,
                       X.UOM2,
                       X.COMMISSIONRATE,
                       X.COMMISSIONAMOUNT
                  From agenttransactiondetail_view x
                 Where trunc(X.CCINVOICEDate) between :P165_FROMDATE and :P165_TODATE
                  and instr(':'||:P165_COMPANY||':',':'||X.CompanyCode||':') > 0
                  and instr(':'||:P165_LOCATION||':',':'||X.LocationCode||':') > 0
                  and instr(':'||:P165_DOCTYPE||':',':'||X.ModuleCode||':') > 0
                  and ( :P165_AGENT IS NULL OR instr(':'||:P165_AGENT||':',':'||x.AgentCode||':') > 0 )
                  and ( :P165_PARTY IS NULL OR instr(':'||:P165_PARTY||':',':'||x.PartyCode||':') > 0 )
                  and ( :P165_ITEM IS NULL OR instr(':'||:P165_ITEM||':',':'||x.ItemCode||':') > 0 )
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            flashback: false
            reset: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 24978512277663242
        }

