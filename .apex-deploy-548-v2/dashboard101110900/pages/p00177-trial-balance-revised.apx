page 177 (
    name: Trial Balance Revised
    alias: TRIAL-BALANCE-REVISED
    title: Trial Balance Revised
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                a.partycode,
                a.partyname,
                getTrialBalancePosition(a.PartyCode) AS ccurrentposition,
                a.partytypecode,
                c.AccountLevel,
                decode(c.openingamount, 0, null, round(C.OPENINGAMOUNT,2)) as openingamount,
                round(C.CLOSINGAMOUNT,2) as closingamount,
                decode(c.OpeningDebitAmount, 0, null, round(c.OpeningDebitAmount,2)) as OpeningDebitAmount,
                decode(c.OpeningCreditAmount, 0, null, round(c.OpeningCreditAmount,2)) as OpeningCreditAmount,
                round(decode(C.DEBITAMOUNT, 0, null, c.DebitAmount),2) AS debitamount,
                round(decode(C.CREDITAMOUNT, 0 , null, round(c.CreditAmount,2)),2) AS CreditAmount,
                decode(C.PDEBITAMOUNT, 0, null, round(c.PDebitAmount,2)) AS pdebitamount,
                decode(C.PCREDITAMOUNT, 0 , null, round(c.PCreditAmount,2)) AS pcreditamount,
                decode(c.ClosingDebitAmount, 0, null, round(c.ClosingDebitAmount,2)) AS debitclosing,
                decode(c.ClosingCreditAmount, 0, null, round(c.ClosingCreditAmount,2)) AS creditclosing,
                CASE WHEN nvl(:P177_LedgerOnly,'NO') = 'NO' and A.partytypecode='ACCOUNTGROUP' then
                
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':176:'||:APP_SESSION||'::'||'P176_accountcode:'|| a.partycode||':'||'P176_FROMDATE,P176_ACCOUNTLEVEL,P176_ACCOUNTCODE,P176_TODATE:'||:P177_FROMDATE||','||C.ACCOUNTLEVEL||','||A.PARTYCODE||','||:P177_TODATE,NULL,'SESSION') ||'">'||rpad('-',5 * (C.AccountLevel - (nvl( (TO_NUMBER(:P177_AccountLevel,99)),1)) ),'-')  || A.PARTYNAME||'</a>'
                
                     WHEN nvl(:P177_LedgerOnly,'NO') = 'NO' and A.partytypecode='ACCOUNT' then
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':178:'||:APP_SESSION||'::'||'P178_fromdate:'|| c.fromdate||':'||'P178_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||rpad('-',5 * (C.AccountLevel - (nvl( (TO_NUMBER(:P177_AccountLevel,99)),1)) ),'-')  || A.PARTYNAME||'</a>'	
                 
                     when nvl(:P177_LedgerOnly,'NO') = 'YES' and A.partytypecode='ACCOUNTGROUP' then
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':176:'||:APP_SESSION||'::'||:DEBUG||'::'||'P176_fromdate:'|| c.fromdate||':'||'P176_ACCOUNTLEVEL:'||c.accountlevel||':'||'P176_ACCOUNTCODE:'||a.partycode,NULL,'SESSION') ||'">'||a.partyname||'</a>'
                      
                     when nvl(:P177_LedgerOnly,'NO') = 'YES' and A.partytypecode='ACCOUNT' then
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':178:'||:APP_SESSION||'::'||'P178_fromdate:'|| c.fromdate||':'||'P178_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||a.partyname||'</a>'	
                end ACCOUNTNAMEDISPLAY ,
                
                CASE
                        WHEN A.partytypecode='ACCOUNTGROUP' then
                       /*<a href="||APEX_UTIL.PREPARE_URL(p_url => 'f?p=' || :APP_ID || ':308:'|| :APP_SESSION
                                ||'::NO::P308_ITEM,C.FROMDATE')"||'>'||c.partyname||'</a>'*/
                
                      /* '<a href="http://3.7.1.231:8888/apex/f?p=&APP_ID.:308">'||c.partyname||'</a>''*/
                      
                      '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':178:'||:APP_SESSION||'::'||:DEBUG||'::'||'P308_fromdate,P308_TODATE:'|| c.fromdate,C.TODATE,NULL,'SESSION') ||'">'||a.partyname||'</a>'
                
                    ELSE
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':304:'||:APP_SESSION||'::'||'P304_fromdate:'|| c.fromdate||':'||'P304_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||a.partyname||'</a>'	
                end  LINK
                
                
                
                
                FROM 
                Party a, ApexTrialBalanceRevisedGroup c
                WHERE C.CREATOR = '&APP_USER.'
                AND a.PartyCode = c.AccountCode
                and (
                     exists (
                           select
                                aa.ChildCode
                           from MyAccountIncludeRevised aa
                           where aa.CompanyCode = :P177_CompanyCode
                               and aa.FromDate = :P177_FROMDATE
                               and aa.ToDate = :P177_TODATE
                               and nvl(aa.LocationCode, 'NULL') = nvl(:P177_LocationCode, 'NULL')
                               and aa.AccountCode = :P177_AccountCode
                               and aa.ChildCode = a.PartyCode
                     )
                     or
                     :P177_AccountCode is null
                )
                
                and ( 
                     nvl(:P177_LedgerOnly,'NO') = 'YES'          
                     or
                     c.AccountLevel <= nvl(:P177_DetailLevel,1)
                     or
                     ( c.AccountLevel <= :P177_AccountLevel+ nvl(:P177_DetailLevel,1) and :P177_AccountCode is not null )
                )
                and ( 
                     nvl(:P177_LedgerOnly,'NO') = 'NO' 
                     OR
                     a.PartyTypeCode != 'ACCOUNTGROUP'
                )
                and (
                     nvl(:P177_IncludeZeroTransaction ,'NO') = 'YES'
                     or ( 
                         nvl(c.OpeningAmount,0) != 0
                         or
                         nvl(c.DebitAmount,0) != 0
                         or
                         nvl(c.CreditAmount,0) != 0
                         or
                         nvl(c.PDebitAmount,0) != 0
                         or
                         nvl(c.PCreditAmount,0) != 0
                     )     
                )
                and (
                     nvl(:P177_Exclude0Closing ,'NO') = 'NO'
                     or (
                         ROUND(nvl(c.OpeningAmount,0) - nvl(c.DebitAmount,0) + nvl(c.CreditAmount,0)   - nvl(c.PDebitAmount,0) + nvl(c.PCreditAmount,0), 2) != 0
                     )     
                )
                and c.FromDate = trunc(TO_DATE(:P177_FROMDATE,'DD-MON-RRRR'))
                and c.ToDate = trunc(TO_DATE(:P177_TODATE,'DD-MON-RRRR'))
                and c.IncludeChild = nvl(:P177_IncludeChild , 'NO')
                and c.CompanyCode = :P177_CompanyCode
                and nvl(c.LocationCode, 'null') = nvl(:P177_Locationcode, 'null') 
                ORDER BY c.TrialBalancePosition, a.PartyName ;
                
                ```
            pageItemsToSubmit: [
                P177_FROMDATE
                P177_TODATE
                P177_DETAILLEVEL
                P177_FINANCIALYEARCODE
                P177_COMPANYCODE
                P177_ACCOUNTCODE
                P177_ACCOUNTLEVEL
            ]
        }
