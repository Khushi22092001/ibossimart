                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      p.PartyName d,
                      p.PartyCode r
                From  Party p
                Where P.PartyTYPECODE != 'ACCOUNTGROUP'
                
                Order By 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
