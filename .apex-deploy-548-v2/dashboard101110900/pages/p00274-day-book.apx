page 274 (
    name: Day Book
    alias: DAY-BOOK
    title: Day Book
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region day-book (
        name: Day Book
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                --	a.Tno,
                --	b.Sno,
                --	a.DocTypeCode,
                --	a.LocationCode,
                --	a.CompanyCode,
                   ROWNUM AS SERIALNO,
                	a.VoucherNo "Voucher No",
                	a.VoucherDate "Voucher Date",
                	GetModuleNo(a.ModuleCode, a.ModuleTno) as ModuleNo,
                	c.ModuleName "Module Name",
                	d.PartyName as "Account Name",
                	round(decode(b.Amount - abs(b.Amount), 0, null, abs(b.Amount)),2) as "Debit Amount",
                	round(decode(b.Amount - abs(b.Amount), 0, b.Amount, null),2) as "Credit Amount",
                	a.Narration,
                	e.CompanyName as "Company Name"
                From Voucher a, VoucherDetail b, Module c, Party d, Company e
                Where a.Tno = b.Tno
                	and a.ModuleCode = c.ModuleCode(+)
                	and b.AccountCode = d.PartyCode
                    and a.CompanyCode = e.CompanyCode
                and a.VoucherDate Between :P274_FROMDATE and :P274_TODATE
                and (:P274_DOCTYPE is Null Or Instr (':' || :P274_DOCTYPE || ':' , ':' || a.DocTypeCode || ':') > 0)
                and (:P274_COMPANY is Null Or Instr (':' || :P274_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P274_LOCATION is Null Or Instr (':' || :P274_LOCATION || ':' , ':' || a.LocationCode || ':') > 0)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                   
                ```
        }
        advanced {
            savedReportMappingIdentifier: 14118945542143601
        }

        savedReport 141272 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @SERIALNO
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @MODULENO
                layout {
                    width: 177
                    sequence: 4
                }
            )

            displayColumn (
                column: @NARRATION
                layout {
                    width: 623
                    sequence: 9
                }
            )

            displayColumn (
                column: @"Voucher No"
                layout {
                    width: 191.999
                    sequence: 1
                }
            )

            displayColumn (
                column: @"Voucher Date"
                layout {
                    width: 93
                    sequence: 2
                }
            )

            displayColumn (
