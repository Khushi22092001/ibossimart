                layout {
                    width: 228.993
                    sequence: 5
                }
            )

            displayColumn (
                column: @"Debit Amount"
                layout {
                    width: 103
                    sequence: 6
                }
            )

            displayColumn (
                column: @"Credit Amount"
                layout {
                    width: 107
                    sequence: 7
                }
            )

            displayColumn (
                column: @"Company Name"
                layout {
                    width: 232
                    sequence: 8
                }
            )

        )

        column "Account Name" (
