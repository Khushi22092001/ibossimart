page 172 (
    name: Freight Advice Register
    alias: FREIGHT-ADVICE-REGISTER
    title: Freight Advice Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region freight-advice-register (
        name: Freight Advice Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    row_number() over(order by a.FreightAdviceDate) SerialNo,
                    a.FreightAdviceNo,
                    a.FreightAdviceDate,
                    c.PartyName as TransporterName,
                    d.LRNo,
                    e.SourceLocationName,
                    f.DestinationLocationName,
                    d.GPNo,
                    d.GPDate,
                    b.FreightDeductionAmount,
                    b.DeductionAmount as ShortageAmount,
                    b.TDSDeductableAmount,
                    b.TDSAmount,
                    b.NetPayableAmount,
                    b.Rate as PassFreightRate,
                    b.BilledAmount,
                    d.VehicleNo,
                    b.ChalanQuantity1 as LoadingQuantity,
                    b.ReachedQuantity1,
                    b.Quantity1 as PassQuantity
                From FreightAdvice a, FreightAdviceDetail b, Party c, LR d, SourceLocation e, DestinationLocation f
                Where a.Tno = b.Tno(+)
                  and a.CreditAccountCode = c.PartyCode(+)
                  and b.ModuleTno = d.Tno(+)
                  and d.SourceLocationTno = e.Tno(+)
                  and d.DestinationLocationTno = f.Tno(+)
                  ----and a.DoctypeCode = 'LR'
                  and a.FreightAdviceDate between :P172_FROMDATE and :P172_TODATE
                  and ( :P172_COMPANY IS NULL OR instr(':'||:P172_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                  and ( :P172_LOCATION IS NULL OR instr(':'||:P172_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                  and ( :P172_TRANSPORTER IS NULL OR instr(':'||:P172_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 ) 
                  and ( :P172_VEHICLENO IS NULL OR instr(':'||:P172_VEHICLENO||':',':'||d.VehicleNo||':') > 0 ) 
                ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 62430620950604872
        }

