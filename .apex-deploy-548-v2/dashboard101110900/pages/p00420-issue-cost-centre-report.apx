page 420 (
    name: Issue Cost Centre Report
    alias: ISSUE-COST-CENTRE-REPORT
    title: Issue Cost Centre Report
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region issue-costcentre (
        name: "Issue CostCentre "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select row_number() over(Order By a.Tno) SerialNo,
                       a.Tno,
                       a.CostCentreCode,
                       b.IssueNo,
                       b.IssueDate,
                       d.ItemName || ' - ' || e.ItemSpecificationName As ItemName,
                       f.CostCentreName,
                       a.Quantity1,
                       a.Quantity2
                  From IssueCostCentreDetail a,
                       Issue                 b,
                       IssueDetail           c,
                       Item                  d,
                       Itemspecification     e,
                       CostCentre            f
                 Where a.Tno = c.Tno(+)
                   And a.sno = c.sno(+)
                   And b.Tno = c.Tno(+)
                   And c.ItemCode = d.ItemCode(+)
                   And c.ItemSpecificationCode = e.ItemSpecificationCode(+)
                   And a.CostCentreCode = f.CostCentreCode(+)
                 and b.IssueDate between :P420_FROMDATE and :P420_TODATE
                 and a.Tno = :P420_TNO
                 and c.ItemCode = :P420_ITEMCODE
                 and c.ItemSpecificationCode = :P420_ITEMSPECIFICATIONCODE
                ```
        }
        layout {
            sequence: 120
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 17555632114548416
        }

        column COSTCENTRECODE (
            type: plainText
            heading {
                heading: Costcentrecode
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column COSTCENTRENAME (
            type: plainText
            heading {
                heading: Cost Centre Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ISSUEDATE (
            type: plainText
            heading {
                heading: Issue Date
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column ISSUENO (
            type: plainText
            heading {
                heading: Issue No
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ITEMNAME (
            type: plainText
            heading {
                heading: Item Name
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Quantity1
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column QUANTITY2 (
            type: plainText
            heading {
                heading: Quantity2
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: "Issue CostCentre "
        }

        savedReport 188541 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COSTCENTRENAME (
                sequence: 5
            )

            displayColumn ISSUEDATE (
                sequence: 3
            )

            displayColumn ISSUENO (
                sequence: 2
            )

            displayColumn ITEMNAME (
                sequence: 4
            )

            displayColumn QUANTITY1 (
                sequence: 6
            )

            displayColumn QUANTITY2 (
                sequence: 7
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: QUANTITY2
            )

        )

    )

    pageItem P420_COMPANY (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P420_DOCUMENT (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P420_FROMDATE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P420_ITEMCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P420_ITEMSPECIFICATIONCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    pageItem P420_LOCATION (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P420_RECORDTYPE (
        type: hidden
        layout {
            sequence: 80
            slot: contentBody
        }
    )

    pageItem P420_TNO (
        type: hidden
        layout {
            sequence: 100
            slot: contentBody
        }
    )

    pageItem P420_TODATE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 110
            slot: contentBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 394
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

