page 50 (
    name: BOM
    alias: BOM
    title: BOM
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region bom (
        name: BOM
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region bom-2 (
        name: BOM
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by a.TNO) SerialSNo,
                      a.TNo,
                      a.BOMCode,
                      a.BOMName,
                      a.BomTypeCode,
                      e.itemName||' ~ '||ee.ItemSpecificationName as MasterItem,
                      e.measuringunitcode1 as MasterUOM,
                      b.SerialNo,
                      i.itemName||' ~ '||ii.ItemSpecificationName as DetailItem,
                      round(b.Quantity1,3) as Quantity1,
                      round(b.Quantity2,3) as Quantity2,
                      i.MeasuringUnitCode1 as UOM1,
                      i.MeasuringUnitCode2 as UOM2
                From  BOM a, BOMDetail b, Item e, ItemSpecification ee, Item i, ItemSpecification ii
                Where a.TNo = b.TNo
                  and a.ItemCode = e.ItemCode
                  and a.ItemSpecificationCode = ee.ItemSpecificationCode
                  and b.ItemCode = i.ItemCode
                  and b.ItemSpecificationCode = ii.ItemSpecificationCode
                  and instr(':'||:P50_COMPANY||':',':'||i.CompanyCode||':') > 0
                  and ( :P50_BOM IS NULL OR instr(':'||:P50_BOM||':',':'||a.BOMCode||':') > 0 ) 
                  and ( :P50_BOMTYPE IS NULL OR instr(':'||:P50_BOMTYPE||':',':'||a.BOMTypeCode||':') > 0 ) 
                Order by 1,7 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1941929707943918
        }

        column BOMCODE (
            type: plainText
            heading {
                heading: BOM CODE
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column BOMNAME (
