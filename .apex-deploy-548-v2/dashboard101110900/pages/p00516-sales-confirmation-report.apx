    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region sales-confirmation (
        name: Sales Confirmation
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region sales-confirmation-report (
        name: Sales Confirmation Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    a.Tno,
                    b.PartyName,
                    a.Remark AS ContactPerson,
                    a.SalesConfirmNo,
                    a.CreditDays,
                    d.ItemName || '-' || e.ItemSpecificationName AS Material,
                    a.SalesConfirmDate,
                    c.Quantity1,
                    c.Rate,
                
                    /* Opening Qty (Pending before Ason Date) */
                    NVL(c.Quantity1,0) - NVL(f.OpeningDispatchQty,0) AS OpeningQty,
                
                    /* Dispatch Qty (ONLY on Ason Date) */
                    NVL(f.TodayDispatchQty,0) AS DispatchQty,
                
                    /* Pending / Closing Qty */
                    NVL(c.Quantity1,0)
                      - ( NVL(f.OpeningDispatchQty,0) + NVL(f.TodayDispatchQty,0) ) AS PendingQty,
                
                    c.Description
                FROM SalesConfirm a,
                     Party b,
                     SalesConfirmDetail c,
                     Item d,
                     ItemSpecification e,
                
                     /* Dispatch Calculation */
                     (
                        SELECT
                            aa.SalesConfirmTno,
                
                            /* Dispatch before Ason Date (for Opening) */
                            SUM(
                                CASE
                                    WHEN cc.CCInvoiceDate < nvl(:P516_ASONDATE, :P516_TODATE)
                                    THEN NVL(dd.Quantity1,0)
                                    ELSE 0
                                END
                            ) AS OpeningDispatchQty,
                
                            /* Dispatch ON Ason Date only */
                            SUM(
                                CASE
                                    WHEN cc.CCInvoiceDate = nvl(:P516_ASONDATE, :P516_TODATE)
                                    THEN NVL(dd.Quantity1,0)
                                    ELSE 0
                                END
                            ) AS TodayDispatchQty
                
                        FROM SalesOrder aa,
                             CCInvoice cc,
                             CCInvoiceDetail dd
                        WHERE aa.Tno = cc.SalesOrderTno(+)
                          AND cc.Tno = dd.Tno(+)
                        GROUP BY aa.SalesConfirmTno
                     ) f
                
                WHERE a.PartyCode = b.PartyCode(+)
                  AND a.Tno = c.Tno(+)
                  AND c.ItemCode = d.ItemCode(+)
                  AND c.ItemSpecificationCode = e.ItemSpecificationCode(+)
                  AND a.Tno = f.SalesConfirmTno(+)
                
                --   AND a.SalesConfirmDate <= :P516_ASONDATE
                AND (
                        (
                            :P516_FROMDATE IS NOT NULL 
                            AND :P516_TODATE IS NOT NULL
                            AND a.SalesConfirmDate BETWEEN :P516_FROMDATE AND :P516_TODATE
                        )
                     OR
                        (
                            :P516_FROMDATE IS NULL 
                            AND :P516_TODATE IS NULL
                            AND a.SalesConfirmDate <= :P516_ASONDATE
                        )
                    )
                    and (:P516_COMPANY IS NULL OR instr(':'||:P516_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and (:P516_LOCATION IS NULL OR instr(':'||:P516_LOCATION||':',':'||a.LocationCode||':') > 0 )
                    and (:P516_PARTY IS NULL OR instr(':'||:P516_PARTY||':',':'||a.PartyCode||':') > 0 )
                    and (:P516_CONTACTPERSON IS NULL OR instr(':'||:P516_CONTACTPERSON||':',':'||a.Remark||':') > 0 )
                    and (:P516_ITEM IS NULL OR instr(':'||:P516_ITEM||':',':'||c.ItemCode||':') > 0 )
                    and (:P516_SALESCONFIRM IS NULL OR instr(':'||:P516_SALESCONFIRM||':',':'||a.Tno||':') > 0 )
                
                
                
                
                ```
            pageItemsToSubmit: [
                P516_ASONDATE
                P516_COMPANY
                P516_LOCATION
                P516_ITEM
                P516_PARTY
                P516_CONTACTPERSON
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
