page 239 (
    name: MaintenanceTaskListReport
    alias: MAINTENANCETASKLIST
    title: MaintenanceTaskList
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenancetasklist (
        name: MaintenanceTaskList
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region master (
        name: Master
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.equipmenttasklistdate) SerialNo,
                b.LocationName,
                d.Doctypename,
                c.companyname,
                a.EquipmentTaskListDate,
                a.EquipmentTaskListNo,
                eg.EquipmentGroupName,
                g.MaintenanceStrategyName,
                e.WorkCentreName,
                f.ItemSizeName,
                h.durationofoperation,
                h.unitofmeasurementforduration,
                h.remark
                from EquipmentTaskList a, Location b,doctype d, EquipmentGroup eg, MaintenanceStrategy g, WorkCentre e,
                ItemSize f,equipmenttasklistdetail h,company c
                Where a.LocationCode = b.LocationCode(+)
                and a.doctypecode = d.doctypecode(+)
                and a.companycode = c.companycode(+)
                and a.EquipmentGroupCode = eg.EquipmentGroupCode(+)
                and a.MaintenanceStrategyCode = g.MaintenanceStrategyCode(+)
                and a.WorkCentreCode = e.WorkCentreCode(+)
                and a.ItemSizecode = f.ItemSizeCode(+)
                and a.tno = h.tno(+)
                and a.equipmenttasklistdate between :P239_FROMDATE and :P239_TODATE
                and ( :P239_DOCTYPE IS NULL OR instr(':'||:P239_DOCTYPE||':',':'||d.DocTypeCode||':') > 0 ) 
                and (:P239_LOCATION IS NULL OR instr(':'||:P239_LOCATION||':',':'||b.locationcode||':') > 0)
                and ( :P239_COMPANY IS NULL OR instr(':'||:P239_COMPANY||':',':'||c.companyCode||':') > 0 ) 
                --and (:P239_STRATEGYNAME IS NULL OR instr(':'||:P239_STRATEGYNAME||':',':'||g.maintenancestrategycode||':') > 0 ) 
                --and (:P239_EQUIPMENTGROUP IS NULL OR instr(':'||:P239_EQUIPMENTGROUP||':',':'||eg.equipmentgroupcode||':') > 0)
                --and (:P239_TASKLISTNO IS NULL OR instr(':'||:P239_TASKLISTNO||':',':'||a.equipmenttasklistno||':') > 0)
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 8181341530723621
        }

