page 293 (
    name: FixedDepositWithdrawlReport
    alias: FIXEDDEPOSITWITHDRAWL
    title: FixedDepositWithdrawl
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region fixedwithdrawlreport (
        name: FixedWithdrawlReport
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                row_number() over(order by FDW.FIXEDDEPOSITWITHDRAWLdate) SerialNo,
                C.COMPANYNAME AS company,
                l.locationname as location,
                d.doctypename as doctype,
                fdw.fixeddepositwithdrawlno,
                fdw.fixeddepositwithdrawldate,
                fd.fixeddepositcertificateno,
                fdw.openingbalance,
                fdw.closingbalance,
                fdw.interestcompoundingmode,
                fdw.withdrawltype,
                fdw.withdrawlamount,
                p.partyname as interestadjustmentaccount,
                fdw.interestadjustmentamount,
                v.voucherno
                from 
                  fixeddepositwithdrawl fdw,
                  fixeddeposit fd,
                  party p,
                  voucher v,
                  location l,
                  doctype d,
                  company c
                where 
                fdw.companycode = c.companycode(+)
                and fdw.locationcode = l.locationcode(+)
                and fdw.doctypecode = d.doctypecode(+)
                and fdw.tno = v.moduletno(+)
                and fdw.interestadjustmentaccountcode = p.partycode(+)
                and fdw.fixeddeposittno = fd.tno(+)
                and FDw.FIXEDDEPOSITWITHDRAWLdate between :P293_FROMDATE and :P293_TODATE
                and (:P293_COMPANY IS NULL OR instr(':'||:P293_COMPANY||':',':'||C.COMPANYcode||':') > 0)
                and (:P293_FIXEDDEPOSITWITHDRAWLNO IS NULL OR instr(':'||:P293_FIXEDDEPOSITWITHDRAWLNO||':',':'||FDW.FIXEDDEPOSITWITHDRAWLNo||':') > 0 ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 18259538505558110
        }

        column CLOSINGBALANCE (
            type: plainText
            heading {
                heading: Closing Balance
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column COMPANY (
            type: plainText
            heading {
                heading: Company
                alignment: center
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column DOCTYPE (
            type: plainText
            heading {
                heading: Doctype
                alignment: center
            }
