            displayColumn OPENINGBALANCE (
                sequence: 7
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn VOUCHERNO (
                sequence: 14
            )

            displayColumn WITHDRAWLAMOUNT (
                sequence: 11
            )

            displayColumn WITHDRAWLTYPE (
                sequence: 10
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: OPENINGBALANCE
            )

            aggregate (
                column: CLOSINGBALANCE
            )

            aggregate (
                column: WITHDRAWLAMOUNT
            )

            aggregate (
                column: INTERESTADJUSTMENTAMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P293_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT Distinct
                COMPANYNAME D,
                COMPANYCODE R  
                FROM COMPANY
                ```
        }
        layout {
            sequence: 30
            region: @fixedwithdrawlreport
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P293_FIXEDDEPOSITWITHDRAWLNO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Fixed Deposit Withdrawl No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                fixeddepositwithdrawlno d,
                fixeddepositwithdrawlno r   
                from fixeddepositwithdrawl
                ```
        }
        layout {
            sequence: 40
            region: @fixedwithdrawlreport
