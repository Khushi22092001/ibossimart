    region report-necesity-completion (
        name: Report (Necesity Completion)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        l.LocationName,
                        a.NecessityCompletionNo,
                        a.NecessityCompletionDate,
                        b.VehicleNo,
                        pp.PartyName,
                        a.PartyBillNo,
                        a.NecessityCompletionAmount,
                        v.VoucherNo,
                        d.LRNO,
                        d.LRDATE,
                        vn.VEHICLENECESSITYNAME
                        
                From 	NecessityCompletion a, Location l, Party pp, Voucher v, NecessityCompletionDetail b, NECESSITYSLIP C, LR d,VEHICLENECESSITY vn
                Where   a.LocationCode = l.LocationCode(+)
                and 	  a.PartyCode = pp.PartyCode(+)
                and     a.NecessityCompletionDate between :P221_FROMDATE AND :P221_TODATE
                and     b.VehicleNo = :P221_VEHICLENO
                and     a.TNO = b.TNO(+)
                and     b.NecessitySlipTno = c.TNO(+)
                and     c.TNo = v.ModuleTno(+)
                and     c.LRTNO = d.TNO(+)
                and     b.VEHICLENECESSITYCODE = vn.VEHICLENECESSITYCODE(+)
                and     b.VEHICLENECESSITYCODE = 'DIESEL'                    --like nvl(:P221_VNECESSITY, '%')
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                /*Select
                        l.LocationName,
                        a.NecessityCompletionNo,
                        a.NecessityCompletionDate,
                        b.VehicleNo,
                        pp.PartyName,
                        a.PartyBillNo,
                        a.NecessityCompletionAmount,
                        v.VoucherNo,
                        d.LRNO,
                        d.LRDATE,
                        vn.VEHICLENECESSITYNAME
                        
                From 	NecessityCompletion a, Location l, Party pp, Voucher v, NecessityCompletionDetail b, NECESSITYSLIP C, LR d,VEHICLENECESSITY vn
                Where   a.LocationCode = l.LocationCode(+)
                and 	  a.PartyCode = pp.PartyCode(+)
                and     a.NecessityCompletionDate between :P221_FROMDATE AND :P221_TODATE
                and     b.VehicleNo = :P221_VEHICLENO
                and     a.TNo = v.ModuleTno(+)
                and     a.TNO = b.TNO(+)
                and     b.NecessitySlipTno = c.TNO(+)
                and     c.LRTNO = d.TNO(+)
                and     b.VEHICLENECESSITYCODE = vn.VEHICLENECESSITYCODE(+)
                and     b.VEHICLENECESSITYCODE = 'DIESEL'                    --like nvl(:P221_VNECESSITY, '%')*/
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
