    region vehicle-position-history-2 (
        name: Vehicle Position History
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With 
                t_SQLDiesel as (
                    select
                         a.LRTNo,
                         round(c.TotalAmount,2) as Amount
                    from NecessitySlip a, NecessityCompletion b, NecessityCompletionDetail c
                    where a.TNO = b.ModuleTNo(+)
                          and b.TNo = c.TNO(+)
                ),
                a as (
                Select  p.PlacementNo,
                        p.PlacementDate,
                        b.LRDATE,
                        b.LRNO,
                        p.VehicleNo,
                        GetDocTypeName(b.DocTypeCode),
                        sl.SourceLocationName,
                        dl.DestinationLocationName,
                        p.METERREADING,
                        dl.DISTANCEINKM,
                        round(p.QUANTITY1,3) as Quantity1,
                        p.NOS,
                        round(dsl.Amount,2) as ActualDieselAmount,
                        b.FREIGHTRATE,
                        round(b.FREIGHTAMOUNT,2) as FreightAmount,
                        round(b.IMMEDIATEPAIDADVANCEAMOUNT,2) As Advance1,
                        round(b.BROKERAGEAMOUNT,2) as Advance2,
                        null as Link,
                        ls.PODSTATUS,
                        ls.FREIGHTADVICESTATUS,
                        ls.SERVICEBILLSTATUS,
                        b.DieselAmount
                        
                from Placement p, LR b , SourceLocation sl, DestinationLocation dl ,t_SQLDiesel dsl,
                LRSTATUS ls
                Where p.TNO = b.PlacementTNO(+)
                and   p.SOURCELOCATIONTNO = sl.TNO(+)
                and   p.DESTINATIONLOCATIONTNO = dl.TNO(+)
                and   p.PARTYCODE = dl.PARTYCODE(+)
                and   p.VehicleNo like nvl(:P221_VEHICLENO,'%')
                and   p.PlacementDate between :P221_FROMDATE and :P221_TODATE 
                and   b.TNO = DSL.LRTNO(+)
                and   b.TNO = ls.LRTNO(+)
                order by b.LRDATE)
                SELECT * FROM a
                
                
                
                /*With 
                SQLDiesel as (
                    select
                         a.LRTNo,
                         round(c.TotalAmount,2) as Amount
                    from NecessitySlip a, NecessityCompletion b, NecessityCompletionDetail c
                    where a.TNO = b.ModuleTNo(+)
                          and b.TNo = c.TNO(+)
                ),
                Vehicle as (
                Select  p.PlacementNo,
                        p.PlacementDate,
                        b.LRDATE,
                        b.LRNO,
                        p.VehicleNo,
                        GetDocTypeName(b.DocTypeCode),
                        sl.SourceLocationName,
                        dl.DestinationLocationName,
                        p.METERREADING,
                        dl.DISTANCEINKM,
                        round(p.QUANTITY1,3) as Quantity1,
                        p.NOS,
                        round(dsl.Amount,2) as ActualDieselAmount,
                        b.FREIGHTRATE,
                        round(b.FREIGHTAMOUNT,2) as FreightAmount,
                        round(b.IMMEDIATEPAIDADVANCEAMOUNT,2) As Advance1,
                        round(b.BROKERAGEAMOUNT,2) as Advance2,
                        null as Link,
                        ls.PODSTATUS,
                        ls.FREIGHTADVICESTATUS,
                        ls.SERVICEBILLSTATUS,
                        b.DieselAmount
                        
                from Placement p, LR b , SourceLocation sl, DestinationLocation dl ,SQLDiesel dsl, LRSTATUS ls
                Where p.TNO = b.PlacementTNO(+)
                and   p.SOURCELOCATIONTNO = sl.TNO(+)
                and   p.DESTINATIONLOCATIONTNO = dl.TNO(+)
                and   p.PARTYCODE = dl.PARTYCODE(+)
                and   p.VehicleNo = :P221_VEHICLENO
                and   p.PlacementDate between :P221_FROMDATE and :P221_TODATE 
                and   b.TNO = DSL.LRTNO(+)
                and   b.TNO = ls.LRTNO(+)
                order by b.LRDATE
                )
                
                Select * from Vehicle*/
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
