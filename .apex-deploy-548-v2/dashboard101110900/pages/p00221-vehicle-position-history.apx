    pageItem P221_VEHICLENO (
        type: popupLov
        label {
            label: Vehicle No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.VehicleNo
                from CompanyVehicle a
                Where a.OwnerCode = 'SELF'
                ```
            displayNullValue: false
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 30
            region: @vehicle-position-history
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
            valuePlaceholder: Vehicle No
        }
        security {
            encryptSessionState: false
        }
    )

