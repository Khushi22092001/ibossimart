    button otsummary (
        buttonName: OTSUMMARY
        label: Overtime Summary
        layout {
            sequence: 10
            region: @overtime-summary-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-download
        }
        behavior {
            action: definedByDynamicAction
            executeValidations: false
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 70
            region: @overtime-summary
            slot: regionBody
            startNewRow: false
            column: 10
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @otsummary
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/OTSUMMARY.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP52_COMPANY":"&P52_COMPANY.","_paramsP52_LOCATION":"&P52_LOCATION.","_paramsP52_FROMDATE":"&P52_FROMDATE.","_paramsP52_TODATE":"&P52_TODATE.","_paramsP52_DEPARTMENT":"&P52_DEPARTMENT.","_paramsP52_EMPLOYEE":"&P52_EMPLOYEE."}');
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

