page 52 (
    name: Overtime Summary
    alias: OVERTIME-SUMMARY
    title: Overtime Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region overtime-summary (
        name: Overtime Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region overtime-summary-report (
        name: Overtime Summary Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.OverTimeGenerationDate,
                      a.OverTimeGenerationNo,
                      a.FromDate,
                      a.ToDate,
                      To_Char(a.FromDate,'MON-YYYY') Month,
                      e.EmployeeID,
                      e.EmployeeName,
                      GetEmployeeDepartmentName(b.EmployeeCode,a.FromDate)as Department,
                      b.Basic,
                      b.Rate,
                      b.WorkedHours/3600 as WorkedHours,
                      round(b.PaidAmount,2) as PaidAmount,
                      round(b.ESICEmployeeAmount,2) as ESICEmployeeAmount,
                      ROUND(b.NetAmount,2) AS NetAmount
                From  OverTimeGeneration a, OverTimeGenerationDetail b, Employee e
                Where a.TNo = b.TNo
                  and b.EmployeeCode = e.EmployeeCode
                  and instr(':'||:P52_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P52_LOCATION||':',':'||a.LocationCode||':') > 0
                  and a.FromDate between :P52_FROMDATE and :P52_TODATE
                  and ( :P52_DEPARTMENT IS NULL OR instr(':'||:P52_DEPARTMENT||':',':'||GetEmployeeDepartmentCode(b.EmployeeCode,a.FromDate)||':') > 0 ) 
                  and ( :P52_EMPLOYEE IS NULL OR instr(':'||:P52_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                html
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4822026114637588
        }

