        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.EmployeeName||' ('||a.EmployeeID||')' d,
                a.EmployeeCode r
                From Employee a
                Where a.EmployeeCode not in ('AS','VAS')
                ```
            displayExtraValues: false
            displayNullValue: false
