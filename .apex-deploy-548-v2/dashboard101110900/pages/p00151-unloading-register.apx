    pageItem P151_UNLOADINGNO (
        type: textFieldWithAutocomplete
        label {
            label: Unloading No
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select UnloadingNo 
                From Unloading
                Where instr(':'||:P151_LOCATION||':',':'||LocationCode||':') > 0
                  and UnloadingDate Between :P151_FROMDATE and :P151_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P151_LOCATION
            itemsToSubmit: P151_UNLOADINGNO
        }
        layout {
            sequence: 90
            region: @unloading-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Unloading No
        }
        security {
            encryptSessionState: false
        }
    )

