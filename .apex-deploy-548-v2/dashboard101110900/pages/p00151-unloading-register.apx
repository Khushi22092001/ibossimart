    region unloading-register (
        name: Unloading Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region unnloading-register-report (
        name: Unnloading  Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,
                       a.unloadingno,
                       a.unloadingdate,
                       b.materialinno,
                       b.materialindate,
                       b.vehicleno,
                       a.itemcode,
                       a.itemspecificationcode,
                       c.itemname,
                       d.itemspecificationname,
                       a.temperature,
                       C.MEASURINGUNITCODE1 AS UOM1,
                       C.MEASURINGUNITCODE2 AS UOM2,
                       BB.STORAGELOCATIONNAME,
                       AA.INITIALREADING,
                       AA.FINALREADING,
                       AA.DIFFERENCEREADING,
                       AA.UNLOADINGQUANTITY1,
                       AA.UNLOADINGQUANTITY2,
                       AA.REMARK,
                       AA.INITIALDIPTIME,
                       AA.FINALDIPTIME
                  From unloading a, materialin b, item c, itemspecification d, UnloadingDetail aa, StorageLocation bb, Company k
                 Where a.referencemoduletno = b.tno(+)
                   And a.itemcode = c.itemcode(+)
                   and a.CompanyCode = k.CompanyCode(+)
                   And a.itemspecificationcode = d.itemspecificationcode(+)
                   and a.tno = aa.tno(+)
                   and aa.StorageLocationCode = bb.StorageLocationCode(+)
                  and a.UnloadingDate between :P151_FROMDATE and :P151_TODATE
                  and instr(':'||:P151_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P151_ITEM IS NULL OR instr(':'||:P151_ITEM||':',':'||a.ItemCode||':') > 0 ) 
                  and instr(':'||:P151_COMPANY||':',':'||k.CompanyCode||':') > 0 
                  and ( :P151_DOCTYPE IS NULL OR instr(':'||:P151_DOCTYPE||':',':'||A.DocTypeCode||':') > 0 ) 
                
                  and ( :P151_SPECIFICATION IS NULL OR instr(':'||:P151_SPECIFICATION||':',':'||a.ItemSpecificationCode||':') > 0 ) 
                  and ( :P151_PARTYNAME IS NULL OR instr(':'||:P151_PARTYNAME||':',':'||b.PartyCode||':') > 0 ) 
                  and a.UnloadingNo like nvl(:P151_UNLOADINGNO,'%')
                  and b.MaterialinNo like nvl(:P151_MINNO,'%')
                
                 Order By a.unloadingdate, a.unloadingno
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
