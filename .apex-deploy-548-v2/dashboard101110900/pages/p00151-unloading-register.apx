        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/Unnloading  Register Report.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P151_COMPANY.","_paramsP_LOCATION":"&P151_LOCATION.","_paramsP_FROMDATE":"&P151_FROMDATE.","_paramsP_TODATE":"&P151_TODATE.","_paramsP_PARTYNAME":"&P151_PARTYNAME.","_paramsP_MINNO":"&P151_MINNO.","_paramsP_ITEM":"&P151_ITEM.","_paramsP_UNLOADINGNO":"&P151_UNLOADINGNO.","_paramsP_SPECIFICATION":"&P151_SPECIFICATION."}');
                                                                                                       
