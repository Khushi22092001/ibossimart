page 206 (
    name: Vehicle Statutory Expiry Detail
    alias: VEHICLE-STATUTORY-EXPIRY-DETAIL
    title: Vehicle Statutory Expiry Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region vehicle-statutory-expiry-detail (
        name: Vehicle Statutory Expiry Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vehicle-statutory-expiry-detail-2 (
        name: Vehicle Statutory Expiry Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                	row_number() over(order by x.ExpiryDate) SerialNo,
                	x.VehicleNo,
                	x.ModelNo,
                	x.ManufacturingYear,
                	x.VehicleNecessityName,
                	x.ExpiryDate,
                	x.CompanyName,
                	x.ChassisNo,
                	x.CompanyCode
                From
                	(
                	Select
                		a.CompanyVehicleNo as VehicleNo,
                		a.ModelNo,
                		a.ManufacturingYear,
                		d.VehicleNecessityName,
                		b.NextDueDate as ExpiryDate,
                		a.ChassisNo,
                		e.CompanyName,
                		a.CompanyCode
                	From CompanyVehicle a, CompanyVehicleDetail b, VehicleNecessity d, Company e
                	Where a.Tno = b.Tno
                		and b.VehicleNecessityCode = d.VehicleNecessityCode
                		and a.CompanyCode = e.CompanyCode
                		--and d.NecessityTypeCode = 'STATUTORY'
                	UNION ALL
                	Select
                		a.EquipmentID as VehicleNo,
                		c.ItemSizeName as ModelNo,
                		a.ConstructionYear as ManufacturingYear,
                		d.ActivityName as VehicleNecessityName,
                		b.NextDueDate as ExpiryDate,
                		a.ChasisNo as ChassisNo,
                		e.CompanyName,
                		a.CompanyCode
                	From Equipment a, EquipmentDocument b, ItemSize c, Activity d, Company e
                	Where a.Tno = b.Tno(+)
                        and a.ManufactureModelCode = c.ItemSizeCode(+)
                		and b.ActivityCode = d.ActivityCode(+)
                		and a.CompanyCode = e.CompanyCode(+)
                		and not exists(
                				Select
                					aa.Tno
                				From CompanyVehicle aa
                				Where aa.ModuleTno = a.Tno
                				)
                	) x
                Where ( :P206_VEHICLENO IS NULL OR instr(':'||:P206_VEHICLENO||':',':'||x.VehicleNo||':') > 0 )
                and   ( :P206_COMPANY IS NULL OR instr(':'||:P206_COMPANY||':',':'||x.CompanyCode||':') > 0 )
                and   ( :P206_CHASSISNO IS NULL OR instr(':'||:P206_CHASSISNO||':',':'||x.ChassisNo||':') > 0 )
                and   ( :P206_VEHICLENECESSITY IS NULL OR instr(':'||:P206_VEHICLENECESSITY||':',':'||x.VehicleNecessityName||':') > 0 )
                and   x.ExpiryDate between :P206_FROMDATE AND :P206_TODATE;
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 27328403531526843
        }

        column CHASSISNO (
            type: plainText
            heading {
                heading: Chassis No
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column COMPANYNAME (
            type: plainText
            heading {
                heading: Company Name
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column EXPIRYDATE (
            type: plainText
            heading {
                heading: Expiry Date
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column MANUFACTURINGYEAR (
            type: plainText
            heading {
                heading: Manufacturing Year
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column MODELNO (
            type: plainText
            heading {
                heading: Model No
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column VEHICLENECESSITYNAME (
            type: plainText
            heading {
                heading: Vehicle Necessity Name
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
