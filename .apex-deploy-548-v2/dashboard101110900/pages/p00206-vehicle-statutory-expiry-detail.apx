    )

    pageItem P206_CHASSISNO (
        type: popupLov
        label {
            label: Chassis No
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                Distinct
                a.ChassisNo d,
                a.ChassisNo r
                From CompanyVehicle a
                ```
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 50
            region: @vehicle-statutory-expiry-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P206_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct 
                b.CompanyName d,
                b.CompanyCode r
                from CompanyVehicle a, Company b
                Where a.CompanyCode = b.CompanyCode
                ```
            nullDisplayValue: --Select List--
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 10
            region: @vehicle-statutory-expiry-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P206_FROMDATE (
