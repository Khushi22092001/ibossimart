            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Vehicle Statutory Expiry Detail
        }

        savedReport 59713 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EXPIRYDATE (
                sequence: 6
            )

            displayColumn MANUFACTURINGYEAR (
                sequence: 4
            )

            displayColumn MODELNO (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn VEHICLENECESSITYNAME (
                sequence: 5
            )

            displayColumn VEHICLENO (
                sequence: 2
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                function: count
                column: SERIALNO
