            alignment: left
        }
        layout {
            sequence: 20
            region: @vehicle-statutory-expiry-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P206_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @vehicle-statutory-expiry-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P206_VEHICLENECESSITY (
        type: popupLov
        label {
            label: Vehicle Necessity
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                d.VehicleNecessityName
                From CompanyVehicleDetail b, VehicleNecessity d
                Where b.VehicleNecessityCode = d.VehicleNecessityCode
                UNION
                Select 
                a.ActivityName as VehicleNecessityName
                From Activity a
                Where a.NatureofActivitiesCOde='DOCUMENT'
                order by 1
                ```
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 60
            region: @vehicle-statutory-expiry-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P206_VEHICLENO (
        type: popupLov
        label {
            label: Vehicle No
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct 
                       x.d,
                       x.r
                From   
                (Select 
                a.VehicleNo D,
                a.VehicleNo r 
                From CompanyVehicle a
                Union all
                Select  
                a.EquipmentID d,
                a.EquipmentID r
                From  Equipment a
                Where not exists(
                				Select
                					aa.Tno
                				From CompanyVehicle aa
                				Where aa.ModuleTno = a.Tno
                				)
                )x
                Order By 1
                
                ```
            nullDisplayValue: --Select List--
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 40
            region: @vehicle-statutory-expiry-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    button refresh (
        buttonName: Refresh
