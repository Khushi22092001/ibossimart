    region module-flow-report (
        name: Module Flow Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	c.ModuleName,
                	a.ModuleFlowNo,
                	b.ModuleFlowNo AS ParentModuleFlowNo,
                	a.TNo,
                	a.OnPassingOfMODULEFLOWTNO,
                    a.OnGettingOfPassMarks,
                    a.ReboundFailMarks,
                	LEVEL as ModuleFlowLevel,
                	d.DocumentStatusName,               
                   lpad(to_char(level), level* 10, ' ') || ')' as MySpace,
                   '( ' || dsd2.DocumentStatusName || ' )' as ModuleFlowStatus,
                   bb.Condition,
                   cc.BossUserName,
                	cc.PassMarks,
                	cc.FailMarks,
                	cc.UpdatePrivilege,
                	cc.OnlyIfCreator,
                    cc.EmployeeName
                From ModuleFlow a, ModuleFlow b, Module c, DocumentStatus d, DocumentStatusDetail dsd, DocumentStatus dsd2,
                (
                 Select
                	a.TNo,
                	a.SNo,
                	b.ColumnName,
                	a.LogicalOperator,
                	a.ColumnValue,
                   b.ColumnName || ' ' || a.LogicalOperator || ' ' ||  a.ColumnValue as Condition
                 From ModuleFlowCondition a, TableColumn b
                 Where a.ColumnCode = b.ColumnCode
                Order by a.TNo, a.Sno) bb,
                (
                 Select
                	a.TNo,
                	a.SNo,
                	b.BossUserName,
                	a.PassMarks,
                	a.FailMarks,
                	a.UpdatePrivilege,
                	a.OnlyIfCreator,
                    a.BossUserCode,
                    b.EmployeeCode,
                    emp.EmployeeName
                 From ModuleFlowUser a, BossUser b, Employee emp
                 Where a.BossUserCode = b.BossUserCode
                        ----------------- --
                        -- 16-nov-2024 
                        and b.EmployeeCode = emp.EmployeeCode(+)
                        ----------------- --
                Order by a.Tno, a.Sno) cc
                Where a.OnPassingOfModuleFlowTNo = b.TNo(+)
                  and a.ModuleCode = c.ModuleCode
                  and a.DocumentStatusCode = d.DocumentStatusCode(+)
                  and a.TNo = dsd.ModuleTNo
                  and dsd.DocumentStatusCode = dsd2.DocumentStatusCode
                  and a.Tno = bb.Tno
                  and a.Tno = cc.Tno
                  and ( :P436_COMPANY IS NULL OR instr(':'||:P436_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                  and ( :P436_BOSSUSER IS NULL OR instr(':'||:P436_BOSSUSER||':',':'||cc.BossUserCode||':') > 0 ) 
                --  and c.ModuleName = nvl(:P_ModuleName, c.ModuleName)
                Connect By a.OnPassingOfModuleFlowTno = PRIOR a.Tno
                Order siblings By c.ModuleName
                ```
            pageItemsToSubmit: P436_COMPANY
        }
        layout {
            sequence: 20
            slot: body
        }
