        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                    a.CompanyName d,
                    a.CompanyCode r
                From Company a
                Where exists
                (Select 
                  b.CompanyCode
                  From ModuleFlow b
                  Where b.CompanyCode = a.CompanyCode)
                Order by 1
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
