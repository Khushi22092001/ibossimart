    pageItem P436_BOSSUSER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Boss User
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                 Select Distinct
                	b.BossUserName d,
                   b.BossuserCode r
                 From ModuleFlow aa,ModuleFlowUser a, BossUser b
                 Where aa.Tno = a.Tno
                  and a.BossUserCode = b.BossUserCode
                Order by 1
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
