    pageItem P263_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'EQUIPMENTLOGBOOK'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order By 1
                ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @availability-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Location Name
        }
    )

    pageItem P263_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 70
            region: @availability-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select To Date
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P263_VEHICLENO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vehicle No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                Distinct
                VehicleNo D,
                VehicleNo R
                FROM VehiclelogBook;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @availability-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Vehicle No
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 120
            region: @availability-report
            slot: regionBody
            column: 10
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction equipment-change (
        name: Equipment Change
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P263_EQUIPMENTCATEGORY
        }
        clientSideCondition {
            type: item=value
            item: P263_EQUIPMENTCATEGORY
            value: VEHICLELOGBOOK
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P263_EQUIPMENTID
                    P263_EQUIPMENTNAME
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: P263_VEHICLENO
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction equipment-change-2 (
        name: Equipment Change_1
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P263_EQUIPMENTCATEGORY
        }
        clientSideCondition {
            type: item!=value
            item: P263_EQUIPMENTCATEGORY
            value: VEHICLELOGBOOK
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: P263_VEHICLENO
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P263_EQUIPMENTID
                    P263_EQUIPMENTNAME
                ]
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction null-hide (
        name: Null hide
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P263_EQUIPMENTCATEGORY
        }
        clientSideCondition {
            type: itemIsNull
            item: P263_EQUIPMENTCATEGORY
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P263_EQUIPMENTID
                    P263_EQUIPMENTNAME
                    P263_VEHICLENO
                ]
            }
            execution {
                sequence: 10
            }
        )

    )

)

