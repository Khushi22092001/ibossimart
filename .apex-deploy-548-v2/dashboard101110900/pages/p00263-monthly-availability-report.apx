page 263 (
    name: "Monthly Availability report "
    alias: MONTHLY-AVAILABILITY-REPORT
    title: Monthly Availability report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region availability-report (
        name: Availability Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region month-availability-report (
        name: Month Availability Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  
                ROWNUM AS SERIALNO,
                a.DoorNo,
                a.OpeningKM,
                a.ClosingKM,
                a.TotalKM,
                a.OpeningWorkingHrs,
                a.ClosingWorkingHrs,
                a.TotalReadingHours,
                a.TotalHrs,
                a.TotalAvaliabilityHrs,
                a.ShiftHrs,
                a.BdHrs,
                a.IdleHrs,
                a.TotalRunningHrs,
                a.Utilization,
                a.Availability
                From
                	(
                	Select 
                		b.EquipmentId as DoorNo,
                		null as OpeningKM,
                		null as ClosingKM,
                		null as TotalKM,
                		Min(d.Opening)  as OpeningWorkingHrs,
                		Max(e.Closing) as ClosingWorkingHrs,
                        nvl(Max(e.Closing), 0) - nvl(Min(d.Opening), 0) as TotalReadingHours, 
                		((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22 as TotalHrs,
                		(((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22) - Nvl(Sum(c.BDHrs),0) as TotalAvaliabilityHrs,
                        null as Shifthrs,
                        Nvl(Sum(c.BDHrs),0) as BDHrs,
                        null as IdleHrs,
                		(Max(e.Closing) - Min(d.Opening)) as TotalRunningHrs,
                		(Max(e.Closing) - Min(d.Opening)) / (((((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22))/100) Utilization,
                		((((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22) - (Nvl(Sum(c.BDHrs),0))) /(((((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22))/100) as Availability
                		From EquipmentLogBook a,
                		(
                		Select 
                			b.Tno 
                		From EquipmentLogBookDetail b
                		Group by b.Tno
                		) aa, 
                		Equipment b, 
                		(
                		Select 
                			c.Tno,
                			Sum((Round(((c.BREAKDOWNOUTTIME - c.BREAKDOWNINTIME) * 24),2))) as BDHrs
                		From EquipmentLogBookBreakDown c 
                		Group by c.Tno
                		) c,
                		(
                		Select 
                			a.Tno,
                			a.OpeningWorkingHrs as Opening,
                			a.EquipmentTno
                		From EquipmentLogBook a, Equipment b
                		where a.EquipmentTno = b.Tno(+)
                		and a.Tno in (
                				Select 
                					Min(a.Tno)
                				From EquipmentLogBook a, Equipment b
                				where a.EquipmentTno = b.Tno(+)
                					and a.EquipmentLogBookDate Between :P263_FromDATE and :P263_TODATE
                					and (:P263_COMPANY IS NULL OR instr(':'||:P263_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                					and (:P263_LOCATION IS NULL OR instr(':'||:P263_LOCATION||':',':'||a.LocationCode||':') > 0)
                					and (:P263_EQUIPMENTID IS NULL OR instr(':'||:P263_EQUIPMENTID||':',':'||b.Equipmentid||':') > 0 ) 
                					and (:P263_EQUIPMENTNAME IS NULL OR instr(':'||:P263_EQUIPMENTNAME||':',':'||b.EquipmentNAME||':') > 0)
                				Group by Equipmenttno
                				)
                		) d,
                		(
                		Select 
                			a.Tno,
                			Nvl(a.ClosingWorkingHrs,a.OpeningWorkingHrs) as Closing,
                			a.EquipmentLogBookDate,
                			a.EquipmentTno
                		From EquipmentLogBook a, Equipment b
                		where a.EquipmentTno = b.Tno(+)
                			and a.Tno in (
                				Select 
                					Max(a.Tno)
                				From EquipmentLogBook a, Equipment b
                				where a.EquipmentTno = b.Tno(+)
                					and a.EquipmentLogBookDate Between :P263_FromDATE and :P263_TODATE
                					and (:P263_COMPANY IS NULL OR instr(':'||:P263_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                					and (:P263_LOCATION IS NULL OR instr(':'||:P263_LOCATION||':',':'||a.LocationCode||':') > 0)
                					and (:P263_EQUIPMENTID IS NULL OR instr(':'||:P263_EQUIPMENTID||':',':'||b.Equipmentid||':') > 0 ) 
                					and (:P263_EQUIPMENTNAME IS NULL OR instr(':'||:P263_EQUIPMENTNAME||':',':'||b.EquipmentNAME||':') > 0)
                				Group By a.EquipmentTno 
                				)
                		) e
                	Where a.Tno = aa.Tno(+)
                		and a.EquipmentTno = b.Tno
                		and a.Tno = c.Tno(+)
                		and a.EquipmentLogBookDate Between :P263_FromDATE and :P263_TODATE
                		and (:P263_EQUIPMENTID IS NULL OR instr(':'||:P263_EQUIPMENTID||':',':'||b.Equipmentid||':') > 0 ) 
                		and (:P263_EQUIPMENTNAME IS NULL OR instr(':'||:P263_EQUIPMENTNAME||':',':'||b.EquipmentNAME||':') > 0)
                		and (:P263_COMPANY IS NULL OR instr(':'||:P263_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                		and (:P263_LOCATION IS NULL OR instr(':'||:P263_LOCATION||':',':'||a.LocationCode||':') > 0)
                		and a.Tno = d.Tno (+)
                		and a.Tno = e.Tno (+)
                		and :P263_EQUIPMENTCATEGORY = 'EQUIPMENTLOGBOOK'
                	Group by
                		b.EquipmentId
                	UNION ALL
                	Select 
                		d.VehicleNo as DoorNo,
                		Min(e.Opening) as OpeningKM,
                		Max(f.Closing) as ClosingKM,
                		nvl(Max(f.Closing), 0) - nvl(Min(e.Opening), 0) as TotalKM,
                		--min(e.OpeningWorkingHrs) as OpeningWorkingHmr,
                		--max(f.ClosingWorkingHrs) as ClosingWorkingHmr,
                        min(e.OpeningWorkingHrs) as OpeningWorkingHmr,
                		max(f.ClosingWorkingHrs) as ClosingWorkingHmr,
                        nvl(max(f.ClosingWorkingHrs), 0) - nvl(min(e.OpeningWorkingHrs), 0) as  TotalReadingHours, 
                		((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22 as TotalHrs,
                		(((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22) - Nvl(Sum(d.BreakDownHrs),0)  as TotalAvaliabilityHrs,
                        Nvl(Sum(d.Shifthour),0) as ShiftHrs,
                        Nvl(Sum(d.BreakDownHrs),0) as BDHrs,
                        Nvl(Sum(d.IdleHrs),0) as IdleHrs,
                		Nvl(Sum(d.Shifthour),0) - Nvl(Sum(d.BreakDownHrs),0) - Nvl(Sum(d.IdleHrs),0) as TotalRunningHrs,
                		(((((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22) - Nvl(Sum(d.BreakDownHrs),0) - Nvl(Sum(d.IdleHrs),0)) / ((((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22)/100)) Utilization,
                		--((Nvl(Sum(d.Shifthour),0) - Nvl(Sum(d.BreakDownHrs),0) - Nvl(Sum(d.IdleHrs),0)) / ((((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) +1) * 22)/100))) Utilization,
                		(((((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22) - Nvl(Sum(d.BreakDownHrs),0)) /(((((To_Date(:P263_TODATE) - To_Date(:P263_FromDATE) )+1) * 22)/100))) as Availability
                	From
                		(
                		Select 
                			a.Tno,
                			a.ShiftCode,
                			a.VehiclelogBookDate,
                			a.OpeningMeterReading,
                			a.IdleHrs,
                			a.BreakDownHrs,
                			c.ShiftHour,
                			a.CompanyCode,
                			a.LocationCode,
                			a.VehicleNo,
                			a.ClosingMeterReading
                		From VehicleLogBook a , 
                			(
                			Select 
                				b.Tno
                			From VehicleLogBookDetail b 
                			Group by  b.Tno
                			) b, 
                			Shift c 
                		Where a.Tno = b.tno(+)
                			and a.ShiftCode = c.ShiftCode(+)
                		) d,
                		(
                		Select 
                			a.Tno,
                			a.OpeningMeterReading as Opening ,
                            a.OpeningWorkingHrs,
                			a.VehicleLogBookDate,
                			a.Vehicleno
                		From VehicleLogBook a
                		where a.Tno in (
                				Select 
                					min(a.Tno)
                				From VehicleLogBook a
                				where a.VehicleLogBookDate Between :P263_FromDATE and :P263_TODATE
                					and (:P263_VEHICLENO IS NULL OR instr(':'||:P263_VEHICLENO||':',':'||a.VehicleNo||':') > 0 ) 
                					and (:P263_COMPANY IS NULL OR instr(':'||:P263_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                					and (:P263_LOCATION IS NULL OR instr(':'||:P263_LOCATION||':',':'||a.LocationCode||':') > 0)
                				Group By a.Vehicleno
                				)
                		) e,
                		(
                		Select 
                			a.Tno,
                			Nvl(a.ClosingMeterReading,a.OpeningMeterReading) as Closing,
                            a.ClosingWorkingHrs,
                			a.VehicleLogBookDate,a.Vehicleno
                		From VehicleLogBook a
                		where a.Tno in (
                				Select 
                					max(a.Tno)
                				From VehicleLogBook a
                				where a.VehicleLogBookDate Between :P263_FromDATE and :P263_TODATE
                					and (:P263_VEHICLENO IS NULL OR instr(':'||:P263_VEHICLENO||':',':'||a.VehicleNo||':') > 0 ) 
                					and (:P263_COMPANY IS NULL OR instr(':'||:P263_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                					and (:P263_LOCATION IS NULL OR instr(':'||:P263_LOCATION||':',':'||a.LocationCode||':') > 0)
                				Group By a.Vehicleno
                				)
                		) f
                	Where d.Tno = e.Tno(+)
                		and d.Tno = f.Tno(+)
                		and d.VehicleLogBookDate Between :P263_FromDATE and :P263_TODATE
                		and (:P263_VEHICLENO IS NULL OR instr(':'||:P263_VEHICLENO||':',':'||d.VehicleNo||':') > 0 ) 
                		and (:P263_COMPANY IS NULL OR instr(':'||:P263_COMPANY||':',':'||d.CompanyCode||':') > 0 ) 
                		and (:P263_LOCATION IS NULL OR instr(':'||:P263_LOCATION||':',':'||d.LocationCode||':') > 0)
                		and :P263_EQUIPMENTCATEGORY = 'VEHICLELOGBOOK'
                	Group by
                		d.VehicleNo
                	) A
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
