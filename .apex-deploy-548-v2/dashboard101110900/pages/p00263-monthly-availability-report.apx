    pageItem P263_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     distinct
                     b.CompanyName d,
                     b.CompanyCode r
                From EquipmentLogBook a, Company b
                Where a.CompanyCode = b.CompanyCode(+)
                
                
                
                
                
                
                
                
                
                /*Select
                      c.CompanyName d,
                      C.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'EQUIPMENTLOGBOOK'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode(+)
                  and a.CompanyCode = c.CompanyCode(+)
                  and bu.BossUserName =  '&APP_USER.'*/
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @availability-report
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 1
