        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region credit-note-register (
        name: Credit Note Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                        Select 
                        row_number() over(order by a.CreditNoteDate) SerialNo,
                        a.CreditNoteNo,
                        a.CreditNoteDate,
                        a.DocTypeName,
                        a.Vendor,
                        a.Reference,
                        a.ReferenceNo,
                        a.referencetext,
                        a.refdate,
                        a.TransactionTypeName,
                        a.NatureofSupplyName,
                        a.PartyInvoiceNo,
                        a.PartyInvoiceDate,
                        a.ReasonforIssuingNoteName,
                        a.ItemName,
                        a.ItemSpecificationName,
                        a.JobTypeName,
                        a.SACName,
                        a.Quantity1,
                        a.Rate,
                        a.Amount,
                        Sum(a.CGST),
                        Sum(a.SGST),
                        Sum(a.IGST),
                        Sum(a.TCS),
                        Sum(a.Other),
                        a.FooterAmount,
                        a.TotalAmount,
                        a.LocationName,
                        a.CompanyName
                        from (
                          
                          Select a.CreditNoteNo,
                        a.CreditNoteDate,
                        d.DocTypeName,
                        e.PartyName as Vendor,
                        a.referencemodulecode As Reference,
                        getModuleNo(a.ReferenceModuleCode,a.ReferenceModuleTNo) As ReferenceNo,
                        a.referencetext,
                        a.refdate,
                        f.TransactionTypeName,
                        g.NatureofSupplyName,
                        a.PartyDebitNoteNo,
                        a.PartyDebitNoteDate,
                        a.PartyInvoiceNo,
                        a.PartyInvoiceDate,
                        h.ReasonforIssuingNoteName,
                        i.ItemName,
                        ii.ItemSpecificationName,
                        j.JobTypeName,
                        k.SACName,
                        b.Quantity1,
                        b.Rate,
                        b.Amount,
                        nvl(Decode(c.FooterHeadCode, '.CGST.', c.FooterValue),
                           0) As CGST,
                        nvl(Decode(c.FooterHeadCode, '.SGST.', c.FooterValue),
                           0) As SGST,
                        nvl(Decode(c.FooterHeadCode, '.IGST.', c.FooterValue),
                           0) As IGST,
                        nvl(Decode(c.FooterHeadCode, '.TCS.', c.FooterValue),
                           0) As TCS,
                        Case when c.FooterHeadCode not in( '.TCS.' ,'.IGST.','.SGST.','.CGST.')
                           then Nvl(c.FooterValue,0) end as Other,
                        b.FooterAmount,
                        b.TotalAmount,
                        l.LocationName,
                        m.CompanyName,
                        b.Sno
                from CreditNote a, CreditNoteDetail b , CreditNoteDetailFooter c, Doctype d, Party e, TransactionType f, NatureofSupply g ,
                     ReasonforIssuingNote h, Item i, ItemSpecification ii, JobType j , SAC k , Location l, Company m
                where a.Tno = b.Tno
                        and a.Tno = c.Tno(+)
                        and a.DoctypeCode = d.DoctypeCode(+)
                        and a.PartyCode = e.PartyCode(+)
                        and a.TransactionTypeCode = f.TransactionTypeCode(+)
                        and a.NatureofSupplyCode = g.NatureofSupplyCode(+)
                        and a.ReasonforIssuingNoteCode = h.ReasonforIssuingNoteCode (+)
                        and b.ItemCode = i.ItemCode(+)
                        and b.ItemSpecificationCode = ii.ItemSpecificationCode(+)
                        and b.JobTypeCode = j.JobTypeCode(+)
                        and j.SACCODE = k.SACCODE(+)
                        and a.LocationCode = l.LocationCode(+)
                        and a.CompanyCode = m.CompanyCode(+)
                        -- 22-APR-2025
                        and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                
                        -- and a.CreditNoteDate between  nvl(to_date(:P139_FROMDATE,'DD-MM-RRRR'),TRUNC(SYSDATE)-3000) 
                        --           AND NVL(TO_DATE(:P139_TODATE,'DD-MM-RRRR'),TRUNC(SYSDATE))
                        and a.CreditNoteDate between  :P139_FROMDATE AND :P139_TODATE
                        and ( :P139_LOCATION IS NULL OR instr(':'||:P139_LOCATION||':',':'||a.LocationCode||':') > 0)
                         and ( :P139_COMPANY IS NULL OR instr(':'||:P139_COMPANY||':',':'||a.CompanyCode||':') > 0) 
                         and ( :P139_PARTYNAME IS NULL OR instr(':'||:P139_PARTYNAME||':',':'||a.PartyCode||':') > 0 )  
                        ) a
                        Group by
                        a.CreditNoteNo,
                        a.CreditNoteDate,
                        a.DocTypeName,
                        a.Vendor,
                        a.Reference,
                        a.ReferenceNo,
                        a.referencetext,
                        a.refdate,
                        a.TransactionTypeName,
                        a.NatureofSupplyName,
                        -- a.PartyCreditNoteNo,
                        -- a.PartyCreditNoteDate,
                        a.PartyInvoiceNo,
                        a.PartyInvoiceDate,
                        a.ReasonforIssuingNoteName,
                        a.ItemName,
                        a.ItemSpecificationName,
                        a.JobTypeName,
                        a.SACName,
                        a.Quantity1,
                        a.Rate,
                        a.Amount,
                        a.FooterAmount,
                        a.TotalAmount,
                        a.LocationName,
                        a.CompanyName
                
                
                
                
                        
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
