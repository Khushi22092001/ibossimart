page 246 (
    name: Service Entry Sheet
    alias: SERVICE-ENTRY-SHEET
    title: Service Entry Sheet
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region master (
        name: Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                row_number() over(order by A.serviceentrysheetdate) SerialNo,
                l.locationname,
                d.doctypename,
                co.companyname,
                a.serviceentrysheetno,
                a.serviceentrysheetdate,
                mo.equipmentmaintenanceorderno,
                e.equipmentname,
                mp.equipmentmaintenanceplanno,
                ms.maintenancestrategyname,
                jc.jobcardno,
                jt.jobtypename AS JobType,
                mt.maintenancetypename as maintenancetype,
                b.actualstarttime as starttime,
                b.actualendtime as endtime,
                b.actualworkhrs as durationofoperation,
                b.measuringunitcode as uomforduration,
                i1.itemname as itemname1,
                isp1.itemspecificationname as itemspecificationname1,
                c.measuringunitcode,
                round(c.quantity1,3) as quantity1,
                round(c.amount,3) as amount1,
                i.itemname as itemname2,
                isp.itemspecificationname as itemspecificationname2,
                round(moid.quantity1,3) as quantity2,
                moid.lastpurchaserate,
                round(moid.amount,2) as amount2
                from serviceentrysheet a,
                     serviceentrysheetdetail b,
                     serviceentrysheetitem c,
                     maintenanceorderitemdetail moid,
                     location l,
                     company co,
                     doctype d,
                     equipmentmaintenanceorder mo,
                     equipmentmaintenanceplan mp,
                     equipment e,
                     maintenancestrategy ms,
                     jobcard jc,
                     jobtype jt,
                     item i,
                     itemspecification isp,
                     item i1,
                     itemspecification isp1,
                     maintenancerequest mr,
                     maintenancetype mt
                     where  a.tno = b.tno(+)
                     and b.tno = c.tno(+)
                     and b.sno = c.sno(+)
                     and a.locationcode = l.locationcode(+)
                     and a.doctypecode = d.doctypecode(+)
                     and a.companycode = co.companycode(+)
                     and a.equipmentmaintenanceordertno = mo.tno(+)
                     and mo.maintenancerequesttno = mr.tno(+)
                     and mr.plantno = mp.tno(+)
                     and mp.maintenancestrategycode = ms.maintenancestrategycode(+)
                     and mr.equipmenttno = e.tno(+)
                     and mr.maintenancetypecode = mt.maintenancetypecode(+)
                     and a.jobcardtno = jc.tno(+)
                     and b.jobtypecode = jt.jobtypecode(+)
                     and a.equipmentmaintenanceordertno = moid.tno(+)
                     and moid.itemcode = i.itemcode(+)
                     and moid.itemspecificationcode = isp.itemspecificationcode(+)
                     and c.itemcode = i1.itemcode(+)
                     and c.itemspecificationcode = isp1.itemspecificationcode(+)
                     and A.serviceentrysheetdate between :P246_FROMDATE and :P246_TODATE
                and ( :P246_DOCTYPE IS NULL OR instr(':'||:P246_DOCTYPE||':',':'||d.DocTypeCode||':') > 0 ) 
                and (:P246_LOCATION IS NULL OR instr(':'||:P246_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P246_ORDERNO IS NULL OR instr(':'||:P246_ORDERNO||':',':'||MO.EQUIPMENTMAINTENANCEORDERNo||':') > 0 ) 
                and (:P246_ENTRYSHEETNO IS NULL OR instr(':'||:P246_ENTRYSHEETNO||':',':'||a.serviceentrysheetno||':') > 0)
                and (:P246_PLANNO IS NULL OR instr(':'||:P246_PLANNO||':',':'||mp.equipmentmaintenanceplanno||':') > 0 ) 
                and (:P246_STRATEGYNAME IS NULL OR instr(':'||:P246_STRATEGYNAME||':',':'||ms.maintenancestrategycode||':') > 0)
                and (:P246_EQUIPMENT IS NULL OR instr(':'||:P246_EQUIPMENT||':',':'||E.EQUIPMENTNAME||':') > 0 )
                and ( instr(':'||:P246_COMPANY||':',':'||CO.COMPANYCODE||':') > 0 )
                and ( :P246_JOBTYPE IS NULL OR instr(':'||:P246_JOBTYPE||':',':'||jt.jobtypeCode||':') > 0 ) 
                and (:P246_MAINTENANCETYPE IS NULL OR instr(':'||:P246_MAINTENANCETYPE||':',':'||mt.maintenancetypecode||':') > 0)
                    
                     
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 7429427421297637
        }

