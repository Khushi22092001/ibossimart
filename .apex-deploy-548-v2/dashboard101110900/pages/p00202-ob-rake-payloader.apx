page 202 (
    name: OB Rake , Payloader
    alias: OB-RAKE-PAYLOADER
    title: OB Rake , Payloader
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region reports (
        name: Reports
        type: list
        source {
            list: @ob-rake-payloader
        }
        layout {
            sequence: 10
            slot: body
            columnCssClasses: hspl-module-tiles
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                u-colors
                t-MediaList--cols t-MediaList--4cols
            ]
        }
    )

)

