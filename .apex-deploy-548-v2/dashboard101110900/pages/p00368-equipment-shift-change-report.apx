        }

        savedReport 1007676 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DOORNO (
                sequence: 6
            )

            displayColumn EMPLOYEENAME (
                sequence: 8
            )

            displayColumn EQUIPMENTNAME (
                sequence: 7
            )

            displayColumn LOCATIONNAME (
                sequence: 3
            )

            displayColumn PREVIOUSHMR (
                sequence: 11
            )

            displayColumn PREVIOUSKMR (
                sequence: 9
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SHIFTCHANGEDATE (
                sequence: 4
            )

            displayColumn SHIFTCHANGENO (
                sequence: 2
            )

            displayColumn SHIFTNAME (
                sequence: 5
            )

            displayColumn STARTHOUR (
                sequence: 12
            )

            displayColumn STARTINGKM (
                sequence: 10
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P368_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                b.CompanyName d,
                b.CompanyCode r                                                
                From ShiftChange a, Company b
                Where a.CompanyCode = b.CompanyCode
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @equipment-shift-change-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

