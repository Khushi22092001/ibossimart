page 368 (
    name: Equipment Shift Change Report
    alias: EQUIPMENT-SHIFT-CHANGE-REPORT
    title: Equipment Shift Change Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region equipment-shift-change-report (
        name: Equipment Shift Change Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                  row_number() over(order by a.ShiftChangeDate) SerialNo,
                a.ShiftChangeNo,
                c.LocationName,
                a.ShiftChangeDate,
                d.ShiftName,
                e.EquipmentId as DoorNo,
                e.EquipmentName,
                f.EmployeeName,
                b.PreviousKMR,
                b.StartingKM,
                b.PreviousHMR,
                b.StartHour
                From ShiftChange a, ShiftChangeDetail b, Location c, Shift d, Equipment e,Employee f
                Where a.Tno = b.Tno
                and a.LocationCode = c.LocationCode
                and a.ShiftTno = d.Tno
                and b.EquipmentTno = e.Tno
                and b.DriverCode = f.EmployeeCode
                and ( :P368_COMPANY IS NULL OR instr(':'||:P368_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                 and a.ShiftChangeDate BETWEEN  :P368_FROMDATE AND :P368_TODATE
                 and ( :P368_LOCATION IS NULL OR instr(':'||:P368_LOCATION||':',':'||a.LocationCode||':') > 0 )
                 and ( :P368_DOORNO IS NULL OR instr(':'||:P368_DOORNO||':',':'||b.EquipmentTno||':') > 0 )
                  and ( :P368_SHIFT IS NULL OR instr(':'||:P368_SHIFT||':',':'||a.ShiftTno||':') > 0 )
                  and :P368_FROMDATE is not null
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 100725011713117002
        }

        column DOORNO (
            type: plainText
            heading {
                heading: Door No
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column EMPLOYEENAME (
            type: plainText
            heading {
                heading: Employee Name
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column EQUIPMENTNAME (
            type: plainText
            heading {
