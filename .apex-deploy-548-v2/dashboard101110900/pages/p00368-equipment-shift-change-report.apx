                heading: Shift Change Date
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column SHIFTCHANGENO (
            type: plainText
            heading {
                heading: Shift Change No
                alignment: center
