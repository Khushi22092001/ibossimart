page 167 (
    name: GST Output Report
    alias: GST-OUTPUT-REPORT
    title: GST Output Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID1 .t-fht-thead{
              overflow: auto !important;
            }
            
            .m-10::before {
                content: url(#APP_IMAGES#smallinfomaticslogo.png);
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region gst-output-report (
        name: GST Output Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 Select
                       row_number() over(order by a.vOUCHERDate) SerialNo,
                       A.locationcode AS NAMEOFSITE,
                       getlocationattributevalue(A.LOCATIONCODE, 'LOCATIONSTATE') AS STATEOFSITE,
                       CO.COMPANYNAME,
                       A.ModuleCode,
                       A.Voucherno,
                       A.VOUCHERDATE,
                       NULL AS DRACCOUNTINERP,
                       A.PARTYNAME AS CRACCOUNTINERP,
                       NULL AS CONSIDEREDINGSTR3B,
                       NULL AS ACTUALMONTHOFGSTR3B,
                       NULL AS SHOWNINGSTR1,
                       NULL AS ACTUALMONTHOFGSTR1,
                       A.PartyName AS NAMEOFCUSTOMER,
                       getpartyaddress(A.PARTYCODE) AS SUPPLIERADDRESS,
                       A.StateName AS SUPPLIERSTATE,
                       A.gststatecode,
                       getpartyattributevalue(A.PARTYCODE, 'GSTINNO') AS CUSTOMERGSTIN,
                       getpartyattributevalue(A.PARTYCODE, 'PANNO') AS CUSTOMERPANNO,
                       A.Quantity1 AS QUANTITY,
                       I.MEASURINGUNITCODE1 AS UNIT,
                       A.BillNo AS INVOICENO,
                       A.BILLDATE AS INVOICEDATE,
                       NULL AS APPLICABILITYOFWAYBILL,
                       NULL AS EWAYBILLNO,
                       NVL(GETITEMNAME(A.ITEMCODE), getjobtypename(A.JOBTYPECODE)) AS PARTICULAROFITEMJOB,
                       NULL AS BRODGROUPNAME,
                       NVL(A.HSN, A.SAC) AS HSNSAC,
                        A.TransactionTypeCode,
                       A.footerpercent AS GSTTAXRATE,
                       A.TaxableAmount AS TAXABLEVALUEBEFORETAX,
                       round(A.IGST,0) as IGST,
                       round(A.CGST,0) as CGST,
                       ROUND(A.SGST,0) as SGST,
                       ROUND(NVL(A.IGST, 0) + NVL(A.CGST, 0) + NVL(A.SGST, 0),2) AS TOTALTAX,
                       ROUND((NVL(A.BILLAMOUNT, 0) - NVL((NVL(A.TaxableAmount,0) + NVL(A.IGST, 0) + NVL(A.CGST, 0) + NVL(A.SGST, 0) ), 0) ),2) AS OTHERINCIDENTALAMOUNT,
                       ROUND(A.BILLAMOUNT,2) AS INVOICEAMOUNT,
                       PY.PAYMENTVOUCHERDATE AS ACTUALPAYMENTDAYS,
                       PY.PAYMENTVOUCHERNO AS PAYMENTVOUCHERNO,
                       NULL AS REASONFORNONITCAVAILABLE,
                       NULL AS ORIGINALINVOICEYESNO,
                       NULL AS ADVANCERECEIPTVOUCHERNO,
                       NULL AS ADVANCERECEIPTVOUCHERDATE,
                       NULL AS ADVANCETAXABLEAMOUNT,
                       NULL AS IGSTONADVANCE,
                       NULL AS CGSTONADVANCE,
                       NULL AS SGSTONADVANCE,
                       NULL AS TOTALTAXONADVANCE,
                       NULL AS DIFFERENCEAMOUNT,
                       K.ACKNO,
                       K.ACKDATE,
                       K.IRN,
                       L.SELLERDTLS_GSTIN,
                       L.EWBNO,
                       L.EWBDATE,
                       L.VALIDTILLDATE,
                       LO.LOCATIONNAME
                
                  from gsttaxinoutdetail a,
                       COMPANY CO,
                       LOCATION LO,
                       PARTY P,
                       TAXREGISTRATIONTYPE TG,
                       NATUREOFSUPPLY NS,
                       ITEM I,
                       JOBTYPE J,
                       EINVOICE K,
                       INVOICEFOREI0101REVISED L,
                     /*  (
                         Select  A.TNO,
                   Case when a.SELLERDTLS_GSTIN IS NOT NULL then 'YES'  
                   WHEN A.SELLERDTLS_GSTIN IS NULL THEN 'NO'
                   ELSE NULL END AS COMPANYGSTINNO
                  FROM INVOICEFOREI0101REVISED A 
                       ) M,*/
                      /* (Select a.tno ,
                       CASE WHEN A.IGST != 0  OR A.IGST > 0 THEN 'IGST'
                       WHEN A.SGST != 0  OR A.SGST > 0 THEN 'SGST'
                       ELSE NULL
                       END AS GST 
                       From gsttaxinoutdetail a)M,*/
                       (SELECT ZZ.TNO          AS BILLVOUCHERTNO,
                               ZZ.MODULETNO,
                               XX.CRVOUCHERTNO,
                               YY.VOUCHERNO    AS PAYMENTVOUCHERNO,
                               YY.VOUCHERDATE  AS PAYMENTVOUCHERDATE
                          FROM DRCRALLOCATION XX, VOUCHER YY, VOUCHER ZZ
                         WHERE XX.MODULETNO = YY.TNO
                           AND YY.DOCTYPECODE IN ('JOURNAL','RECEIPT')
                           AND XX.DRVOUCHERTNO = ZZ.TNO) PY
                
                 where a.type = 'OUTWARD'
                   AND A.COMPANYCODE = CO.COMPANYCODE(+)
                   AND A.LOCATIONCODE = LO.LOCATIONCODE(+)
                   AND A.PARTYCODE = P.PARTYCODE(+)
                   AND P.TAXREGISTRATIONTYPECODE = TG.TAXREGISTRATIONTYPECODE(+)
                   AND A.NatureOfSupplyCode = NS.NATUREOFSUPPLYCODE(+)
                   AND A.ITEMCODE = I.ITEMCODE(+)
                   and A.JOBTYPECODE = J.JOBTYPECODE(+)
                   AND A.TNO = K.MODULETNO(+)
                   AND A.TNO = L.TNO(+)
                --   AND A.TNO = M.TNO(+)
                   AND A.Vouchertno = PY.BILLVOUCHERTNO(+)
                   and ( :P167_COMPANY IS NULL OR instr(':'||:P167_COMPANY||':',':'||A.COMPANYCODE||':') > 0 )
                   and NVL(a.VoucherDate,A.ENTRYDATE) between :P167_FROMDATE and :P167_TODATE
                   and ( :P167_PARTY IS NULL OR instr(':'||:P167_PARTY||':',':'||a.PartyCode||':') > 0 )
                   and ( :P167_MODULECODE IS NULL OR instr(':'||:P167_MODULECODE||':',':'||a.ModuleCode||':') > 0 )
                  AND ( 
                      ( NVL(A.IGST,0)   > 0 AND :P167_SER = 'IGST' )
                      OR 
                      (  NVL(A.SGST,0) <= 0 AND :P167_SER = 'SGST' )
                      OR
                      :P167_SER IS NULL
                  )
                   and ( :P167_LOCATION IS NULL OR instr(':'||:P167_LOCATION||':',':'||A.LOCATIONCODE||':') > 0 )
                   and ( :P167_COMPANYGSTIN IS NULL OR instr(':'||:P167_COMPANYGSTIN||':',':'||L.SELLERDTLS_GSTIN||':') > 0 )
                   and NVL(A.IGST, 0) + NVL(A.CGST, 0) + NVL(A.SGST, 0) > 0
                
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            compute: false
            chart: false
            groupBy: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                csv
                excel
                pdf
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 100
        }
        advanced {
            savedReportMappingIdentifier: 64468600314154632
        }

