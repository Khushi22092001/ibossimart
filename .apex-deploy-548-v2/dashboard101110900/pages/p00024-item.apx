page 24 (
    name: Item
    alias: ITEM
    title: Item
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 700
        height: 600
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region item (
        name: Item
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       
                       ITEMCODE,
                       ITEMNAME,
                       ITEMTYPE,
                       PARENTCODE,
                       DEALSINCODE,
                       MEASURINGUNITCODE1
                  from PBS.ITEM
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P24_ISEQUIPMENT (
        type: radioGroup
        label {
            label: IS EQUIPMENT
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:YES;YES,NO;NO
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @item
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_ITEMCODE (
        type: textField
        label {
            label: ITEM CODE
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 40
            region: @item
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @item
            column: ITEMCODE
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_ITEMNAME (
        type: textField
        label {
            label: ITEM NAME
            alignment: left
        }
        layout {
            sequence: 50
            region: @item
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @item
            column: ITEMNAME
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_ITEMNATURE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: ITEM NATURE
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     ItemNatureName d,
                     ItemNatureCode r
                From ItemNature
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @item
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
            valuePlaceholder: Item Nature
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @item
            column: MEASURINGUNITCODE1
            dataType: varchar2
        }
    )

    pageItem P24_ITEMTYPE (
        type: textField
        label {
            label: ITEM TYPE
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 100
            region: @item
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @item
            column: ITEMTYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: ITEM
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_MEASURINGUNITCODE1 (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: PRIMARY UNIT
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     MeasuringUnitName d,
                     MeasuringUnitCode r
                From MeasuringUnit
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @item
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
            valuePlaceholder: Primary Unit
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @item
            column: MEASURINGUNITCODE1
            dataType: varchar2
        }
    )

    pageItem P24_MEASURINGUNITCODE2 (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: SECONDARY UNIT
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     MeasuringUnitName d,
                     MeasuringUnitCode r
                From MeasuringUnit
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @item
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
            valuePlaceholder: Secondary Unit
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @item
            column: MEASURINGUNITCODE1
            dataType: varchar2
        }
    )

    pageItem P24_PARENTCODE (
        type: popupLov
        label {
            label: PARENT CODE
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     ItemName d,
                ItemCode r
                From Item
                Where ItemType = 'GROUP'
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @item
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
            valuePlaceholder: Parent Group
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @item
            column: PARENTCODE
            dataType: varchar2
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_REMARK (
        type: textField
        label {
            label: REMARK
            alignment: left
        }
        layout {
            sequence: 130
            region: @item
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_SERIALNOREQUIRED (
        type: radioGroup
        label {
            label: SERIAL NO REQUIRED
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:YES;YES,NO;NO
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @item
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P24_TNO (
        type: hidden
        layout {
            sequence: 30
            region: @item
            slot: regionBody
        }
        source {
            formRegion: @item
            column: TNO
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
            encryptSessionState: false
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P24_TNO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_TNO
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P24_TNO
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 4537433906352673
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process get-tno (
        name: GET TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Begin
                    If :P24_TNO is null then
                        Select
                             GlobalTNo.Nextval into :P24_TNO
                        From Dual;
                    End If;
                End;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3814249237109331
        }
    )

    process initialize-form-item (
        name: Initialize form Item
        type: formInitialization
        formRegion: @item
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4536689251352672
        }
    )

    process process-form-item (
        name: Process form Item
        type: formAutoRowProcessing
        formRegion: @item
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 4537061493352673
        }
    )

    branch (
        name: Redirect to new
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 23
                items: {
                    P23_TNO: &P24_TNO.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    branch (
        name: Redirect to all
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 23
                clearCache: 23
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

