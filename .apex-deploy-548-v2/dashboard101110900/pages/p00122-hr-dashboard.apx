page 122 (
    name: HR Dashboard
    alias: HR-DASHBOARD
    title: HR Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region active-employees (
        name: Active Employees
        type: chart
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: combination
        }
        chartLayout {
            height: 400
        }
        settings {
            timeAxisType: auto
        }
        legend {
            show: false
        }

        series active-employees (
            name: Active Employees
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select B.FIN_YEAR, 
                     Count(A.TNO) As ActiveMember
                      From EMPLOYEE A, BI_DATETIME B, DocumentstatusDetail c
                     Where Trunc(C.STATUSTIME) = B.FIN_DATE
                       And a.tno = c.moduletno(+)
                       And c.documentstatuscode = 'ACTIVE'
                       And Not Exists (Select aa.tno
                              From Resignation aa
                             Where aa.employeecode = a.employeecode
                               And aa.resignationdate > b.FIN_YEAR_END)
                       AND Not Exists (Select aa.tno
                              From Termination aa
                             Where aa.employeecode = a.employeecode
                               And aa.terminationdate > b.FIN_YEAR_END)
                     Group By b.fin_year
                    ```
            }
            columnMapping {
                label: FIN_YEAR
                value: ACTIVEMEMBER
            }
            appearance {
                color: #931313
            }
        )

        series new-hiring (
            name: New Hiring
            type: line
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select B.FIN_YEAR, Count(A.TNO) As NewHiring
                      From EMPLOYEE A, BI_DATETIME B, DocumentstatusDetail c
                     Where Trunc(C.STATUSTIME) = B.FIN_DATE
                       And a.tno = c.moduletno(+)
                       And c.documentstatuscode = 'ACTIVE'
                       And a.dateofjoining Between b.FIN_YEAR_BIGIN And b.FIN_YEAR_END
                     Group By b.fin_year
                    ```
            }
            columnMapping {
                label: FIN_YEAR
                value: NEWHIRING
            }
            appearance {
                color: #46a2d7
            }
            marker {
                show: false
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

)

