    pageItem P213_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        settings {
            displayAs: modalDialog
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  Distinct
                    a.CompanyName D,
                    a.CompanyCode R
                from 
                    company a;
                ```
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 20
            region: @transport-bill-for-tms
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 2
