page 213 (
    name: Transport Bill For TMS
    alias: FREIGHT-ADVICE-FOR-TMS
    title: Transport Bill For TMS
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
            overflow: auto !important;
            }
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region transport-bill-for-tms (
        name: Transport Bill For TMS
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region transport-bill-for-tms-report (
        name: Transport Bill For TMS Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.freightAdviceDate) SerialNo, 
                a.Tno,
                Getcompanyname(a.Companycode) as Company,
                lo.LocationName,
                a.FreightAdviceNo,
                a.FreightAdviceDate,
                c.TransporterName,
                e.FooterValue,
                e.FooterPercent,
                round(a.SUMoFtdsAmount,2) as SUMoFtdsAmount,
                round(a.SumOfDeductionAmount,2) as SumOfDeductionAmount,
                round(a.SumOfAdvanceAmount,2) as SumOfAdvanceAmount,
                round(a.SumofNetPayableAmount,2) as SumofNetPayableAmount,
                round(a.LoanAmount,2) as LOanAmount,
                d.BankName,
                To_char(a.BankAccountNo) as BANKACCOUNTNO,
                a.Creator,
                f.PartyName as CreditAccountName,
                'Freight Advice Detail'
                From FreightAdvice a, Transporter c, Bank d,Location lo,
                (
                select
                b.Tno,
                a.FooterHeadCode,
                SUM(a.FooterPercent) as FooterPercent,
                SUM(a.FooterValue) as FooterValue,
                c.FooterHeadName,
                b.freightadviceAmount
                from
                FreightAdviceDetailFooter a,FreightAdvice  b, FooterHead c
                where a.TNo = b.TNo
                and a.FooterHeadCode = c.FooterHeadCode
                and a.FooterHeadCode in
                (
                '.CGST.',
                '.SGST.',
                '.IGST.'
                )
                Group by a.FooterHeadCode,
                b.Tno,
                c.FooterHeadName,
                b.freightadviceAmount)e, Party f
                Where a.TransporterCode = c.TransporterCode(+)
                and a.LocationCode = lo.LocationCode(+)
                and a.BankCode = d.BankCode(+)
                and a.Tno = e.Tno(+)
                and a.CreditAccountCode = f.PartyCode(+)
                --and a.FreightAdviceNo = 'CMPL/LORRY/2023/000534';
                and a.FreightAdviceDate Between :P213_FROMDATE and :P213_TODATE
                and (:P213_TRANSPORTER is Null Or Instr (':' || :P213_TRANSPORTER || ':' , ':' || c.TransporterName || ':') > 0)
                and (:P213_FREIGHTADVICENO is Null Or Instr (':' || :P213_FREIGHTADVICENO || ':' , ':' || a.FreightAdviceNo || ':') > 0)
                and (:P213_LOCATION is Null Or Instr (':' || :P213_LOCATION || ':' , ':' || lo.LocationName || ':') > 0)
                and (:P213_COMPANY is Null Or Instr (':' || :P213_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                
                
                
                
                
                
                
                
                
                
                /*Select 
                b.Tno,
                Getcompanyname(a.Companycode) as Company,
                lo.LocationName,
                a.FreightAdviceNo,
                a.FreightAdviceDate,
                c.TransporterName,
                b.Rate,
                round(b.Amount,2) as Amount,
                round(b.ChallanQuantity,3) as ChallanQuantity,
                round(b.ReceivedQuantity,3) as ReceivedQuantity,
                round(b.ShortageQuantity,3) as ShotageQuantity,
                e.FooterValue,
                e.FooterPercent,
                round(a.SUMoFtdsAmount,2) as SUMoFtdsAmount,
                round(a.SumOfDeductionAmount,2) as SumOfDeductionAmount,
                round(a.SumOfAdvanceAmount,2) as SumOfAdvanceAmount,
                round(a.SumofNetPayableAmount,2) as SumofNetPayableAmount,
                round(a.LoanAmount,2) as LOanAmount,
                d.BankName,
                To_char(a.BankAccountNo) as BANKACCOUNTNO,
                a.Creator,
                f.PartyName as CreditAccountName,
                'Freight Advice Detail'
                From FreightAdvice a,
                (
                SELECT 
                aa.Tno,
                aa.Rate,
                aa.Amount,
                sum(aa.ChalanQuantity1) as ChallanQuantity,
                sum(aa.ReachedQuantity1) as ReceivedQuantity,
                sum(aa.ShortageQuantity1) as ShortageQuantity
                FROM FREIGHTADVICEDETAIL aa
                group by aa.Tno,
                aa.Rate,
                aa.Amount) b, Transporter c, Bank d,Location lo,
                (
                select
                b.Tno,
                a.FooterHeadCode,
                SUM(a.FooterPercent) as FooterPercent,
                SUM(a.FooterValue) as FooterValue,
                c.FooterHeadName,
                b.freightadviceAmount
                from
                FreightAdviceDetailFooter a,FreightAdvice  b, FooterHead c
                where a.TNo = b.TNo
                and a.FooterHeadCode = c.FooterHeadCode
                and a.FooterHeadCode in
                (
                '.CGST.',
                '.SGST.',
                '.IGST.'
                )
                Group by a.FooterHeadCode,
                b.Tno,
                c.FooterHeadName,
                b.freightadviceAmount)e, Party f
                Where a.Tno = b.Tno(+)
                and a.TransporterCode = c.TransporterCode(+)
                and a.LocationCode = lo.LocationCode(+)
                and a.BankCode = d.BankCode(+)
                and a.Tno = e.Tno(+)
                and a.CreditAccountCode = f.PartyCode(+)
                and a.FreightAdviceDate Between :P213_FROMDATE and :P213_TODATE
                and (:P213_TRANSPORTER is Null Or Instr (':' || :P213_TRANSPORTER || ':' , ':' || c.TransporterName || ':') > 0)
                and (:P213_FREIGHTADVICENO is Null Or Instr (':' || :P213_FREIGHTADVICENO || ':' , ':' || a.FreightAdviceNo || ':') > 0)
                and (:P213_LOCATION is Null Or Instr (':' || :P213_LOCATION || ':' , ':' || lo.LocationName || ':') > 0)
                and (:P213_COMPANY is Null Or Instr (':' || :P213_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                
                
                */
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                -- Select 
                --     b.moduleTno,
                --     a.LRno,
                --     a.lrdate,
                --     a.ManualLrNo,
                --     a.ChallanNo,
                --     a.GPNo as TPNo,
                --     a.VehicleNo,
                --     a.PartyRefNo as PartyDoNo,
                --     T.TransporterName,
                --     sl.SourceLocationName,
                --     dl.DestinationLocationName,
                --     a.Quantity1 as LRWeight,
                --     b.ReachedQuantity1 as ReceivedWeight,
                --     b.MinimumQuantity1 as MinimumWeight, 
                --     a.FreightRate,
                --     nvl(b.Amount, a.FreightAmount) as FreightAmount,
                --     b.AdvanceAmount as CashAdvance,
                --     ns.Quantity1 as DieselQuantity,
                --     ns.DieselAmount as DieselAmount,
                --     b.ShortageQuantity1 ,
                --     b.deductionamount as  ShortageAmount,
                --     a.BrokerAgeAmount,
                --     ns.AmountDR,
                --     b.LoanAmount,
                --     c.PaidTo,
                --     c.Narration,
                --     c.freightAdviceAmount,
                --     k.ReconsilationDate,
                --     to_number(b.DeductionAmount) as DeductionAmount,
                --     to_number(b.GPSDeductionAmount) as  GPSDeductionAmount,
                --     j.NextAdvanceAmount,
                --     b.TDSAmount,
                --     b.Paymentcommission,
                --     to_number(b.NetPayableAmount)
                -- from 
                --     lr a,
                --     SourceLocation sl,
                --     DestinationLocation dl,
                --     Transporter t,
                --     (Select 
                --     a.LrTno,
                --     Sum(b.Quantity1) as Quantity1,
                --     Sum(Pa.AmountDR) as AmountDR,
                --     Sum(b.Quantity1 * b.DieselRate) as DieselAmount
                --     from
                --     NecessitySlip a, NecessitySlipDetail b ,PaymentAdviceReference par,
                --     PaymentAdvice pa
                --     where a.Tno = b.Tno
                --     and a.Tno = par.ReferenceModuleTno(+)
                --     and par.Tno = pa.Tno(+)
                --     Group by
                --     a.LRTno) Ns,
                --     FreightAdviceDetail b,
                --     FreightAdvice c,
                --     Bank i,
                --     Location Lo,
                -- (
                --         Select
                --             a.Tno,
                --             sum(aa.Amount) as NextAdvanceAmount
                --         From LR a,PaymentAdviceReference aa, PaymentAdvice bb
                --         Where aa.Tno = bb.Tno
                --             and aa.ReferenceModuleTno = a.Tno
                --             and aa.ReferenceModuleCode = 'LR'
                --             and nvl(bb.ModuleTno, 0) != a.Tno
                --         Group by 
                --             a.Tno) j,
                -- (		Select
                --             b.ReconsilationDate,
                --             c.Tno
                --     	From Voucher a, VoucherDetail b, FreightAdvice c
                --         Where a.Tno = b.Tno
                -- 			and a.ModuleTno = c.Tno
                -- 			and b.ReconsilationDate is not null) k
                -- Where  
                --     b.ModuleTno  in (Select Min(aa.Tno) as Tno 
                --     From LR aa
                --     Group by aa.PartyRefNo,
                --     aa.SourceLocationTno,
                --     aa.DestinationLocationTno)
                --     and a.Tno = b.MODULETNO(+)
                --         and  a.SourceLocationTno=sl.Tno(+)
                --         and a.DestinationLocationTno=dl.TNo(+)
                --         and a.TransporterCode=t.TransporterCode(+)
                --         and a.Tno=ns.LRTNO(+)
                --         and b.ModuleCode='LR'
                --         and b.Tno=c.Tno(+)
                --         and c.BANKCODE=i.BankCode(+)
                --         and a.Tno = j.Tno (+)
                --         and c.Tno = k.Tno(+)
                
                
                
                
                
                --       --   and a.LocationCode = Lo.LocationCode(+)
                --       --   and a.FreightAdviceDate Between :P213_FROMDATE and :P213_TODATE
                --       --   and (:P213_TRANSPORTER is Null Or Instr (':' || :P213_TRANSPORTER || ':' , ':' || T.TransporterName || ':') > 0)
                --       --   and (:P213_FREIGHTADVICENO is Null Or Instr (':' || :P213_FREIGHTADVICENO || ':' , ':' || c.FreightAdviceNo || ':') > 0)
                --       --   and (:P213_LOCATION is Null Or Instr (':' || :P213_LOCATION || ':' , ':' || lo.LocationName || ':') > 0)
                --       --   and (:P213_COMPANY is Null Or Instr (':' || :P213_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                --       --   and (:P213_VEHICLENO is Null Or Instr (':' || :P213_VEHICLENO || ':' , ':' || a.VEHICLENO || ':') > 0)
                --       --   and (:P213_DONO is Null Or Instr (':' || :P213_DONO || ':' , ':' || a.PARTYREFNO || ':') > 0)
                --       --   and (:P213_GPNO is Null Or Instr (':' || :P213_GPNO || ':' , ':' || a.GPNo || ':') > 0)
                --       --   and (:P213_SOURCE is Null Or Instr (':' || :P213_SOURCE || ':' , ':' || sl.Tno || ':') > 0)
                --       --   and (:P213_DESTINATION is Null Or Instr (':' || :P213_DESTINATION || ':' , ':' || dl.Tno || ':') > 0)
                --       --   and (:P213_PARTYDONO is Null Or Instr (':' || :P213_PARTYDONO || ':' , ':' || a.PartyRefNo || ':') > 0);
                ```
        }
