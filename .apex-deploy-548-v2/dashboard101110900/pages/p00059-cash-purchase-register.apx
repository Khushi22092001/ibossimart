page 59 (
    name: Cash Purchase Register
    alias: CASH-PURCHASE-REGISTER
    title: Cash Purchase Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region cash-purchase (
        name: Cash Purchase
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.TNo,
                      l.LocationName,
                      dt.DocTypeName,
                      a.CashPurchaseNo,
                      a.CashPurchaseDate,
                      ca.PartyName as CreditAccount,
                      GetPartyName(a.DebitAccountCode) as DebitAccount,
                      a.ReferenceNo,
                      a.ReferenceDate,
                      a.Narration,
                      a.SupplierName,
                      a.SumofAmount,
                      a.CashPurchaseAmount,
                      tt.TransactionTypeName,
                      ns.NatureofSupplyName,
                      a.Remark,
                      bue.EmployeeName||' ( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      i.IndentNo,
                      i.IndentDate,
                      jt.JobTypeName,
                      e.ItemCode,
                      e.ItemName,
                      ee.ItemSpecificationName,
                      e.ItemName||'~'||ee.ItemSpecificationName as Material,
                      e.MeasuringUnitCode1,
                      b.Description,
                      b.Quantity1,
                      b.Rate,
                      b.RateMeasuringUnitCode,
                      b.Amount,
                      b.FooterAmount,
                      b.TotalAmount
                From  CashPurchase a, CashPurchaseDetail b, Location l, Party ca, DocType dt, BossUser bu, Employee bue, NatureofSupply ns, TransactionType tt, Indent i,
                      JobType jt, Item e, ItemSpecification ee
                Where a.TNo = b.TNo(+)
                  and a.LocationCode = l.LocationCode(+)
                  and a.CreditAccountCode = ca.PartyCode(+)
                  and a.DocTypeCode = dt.DoctypeCode(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)
                  and a.TransactionTypeCode = tt.TransactionTypeCode(+)
                  and a.NatureofSupplyCode = ns.NatureofSupplyCode(+)
                  and b.IndentTNo = i.Tno(+)
                  and b.JobTypeCode = jt.JobTypeCode(+)
                  and b.ItemCode = e.ItemCode(+)
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and a.CashPurchaseDate between :P59_FROMDATE and :P59_TODATE
                  and instr(':'||:P59_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P59_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P59_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                  and ( :P59_ITEM IS NULL OR instr(':'||:P59_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P59_ITEMSPECIFICATION IS NULL OR instr(':'||:P59_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                  and ( :P59_INDENT IS NULL OR instr(':'||:P59_INDENT||':',':'||I.TNO||':') > 0 ) 
                 -- and ( :P59_CREDITACCOUNT IS NULL OR instr(':'||:P59_CREDITACCOUNT||':',':'||a.CreditAccountCode||':') > 0 ) 
                 -- and ( :P59_DEBITACCOUNT IS NULL OR instr(':'||:P59_DEBITACCOUNT||':',':'||a.DebitAccountCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                html
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 15273209130917448
        }

