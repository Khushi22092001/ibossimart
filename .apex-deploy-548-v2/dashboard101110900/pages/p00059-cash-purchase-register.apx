        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      ee.ItemSpecificationName as d,
                      ee.ItemSpecificationCode as r
                From Item e, ItemSpecification ee
                Where e.ItemCode = :P59_ITEM
                  and e.TNo = ee.TNo
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P59_ITEM
            itemsToSubmit: P59_ITEMSPECIFICATION
