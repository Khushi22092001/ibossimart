    region command-header (
        name: Category 360
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-slc-hero"><div class="ds-slc-hero-row">'
                  || '<span class="ds-slc-hero-icon"><span class="fa fa-cubes"></span></span>'
                  || '<span><span class="ds-slc-hero-eyebrow">Product &middot; Category Intelligence</span><br>'
                  || '<span class="ds-slc-hero-title">Category 360</span>'
                  || '<div class="ds-slc-hero-sub">Pick a product category to see who it was sold to, its average rate '
                  || 'and rate trend, the specifications inside it, and every bill and order it produced.</div></span></div>'
                  || Case When :P733_CATEGORY Is Not Null Then
                       '<div class="ds-slc-hero-chips"><span class="ds-chip ds-chip--live"><span class="fa fa-cube ds-chip-ic"></span>'
                       || '<span class="ds-chip-k">Category</span><b>'||apex_escape.html(Nvl((Select ItemCategoryName From ItemCategory Where ItemCategoryCode=:P733_CATEGORY),:P733_CATEGORY))||'</b></span>'
                       || '<span class="ds-chip"><span class="fa fa-calendar ds-chip-ic"></span><span class="ds-chip-k">Window</span><b>'||apex_escape.html(:P733_FROMDATE)||' &ndash; '||apex_escape.html(:P733_TODATE)||'</b></span></div>'
                     Else '<div class="ds-slc-hero-chips"><span class="ds-chip"><span class="fa fa-search ds-chip-ic"></span>'
                       || '<span class="ds-chip-k">Select</span><b>a category to begin</b></span></div>' End
                  || '</div>' As HEAD
                From dual
                ```
