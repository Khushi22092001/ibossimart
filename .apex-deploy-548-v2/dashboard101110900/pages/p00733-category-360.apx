    region page-style (
        name: SLC Theme
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                body:has(.ds-slc-headregion){
                  --ds-dash-gold:#0F766E; --ds-dash-gold-bg:#E5F3F1; --ds-dash-ink:#0B3B36; --ds-dash-ink2:#2E5A55;
                }
                body:has(.ds-slc-headregion) .ds-kpi--value{--ds-kpi-accent:#0F766E;--ds-kpi-accent-bg:#E5F3F1;}
                body:has(.ds-slc-headregion) .ds-kpi--bill {--ds-kpi-accent:#0891B2;--ds-kpi-accent-bg:#E2F4F8;}
                body:has(.ds-slc-headregion) .ds-kpi--ok   {--ds-kpi-accent:#15803D;--ds-kpi-accent-bg:#E6F4EA;}
                body:has(.ds-slc-headregion) .ds-kpi--input{--ds-kpi-accent:#0E7490;--ds-kpi-accent-bg:#E2F1F6;}
                body:has(.ds-slc-headregion) .ds-purchase-section::before{background:linear-gradient(180deg,#0891B2,#134E4A);}
                body:has(.ds-slc-headregion) .ds-kpiwrap--4up{grid-template-columns:repeat(4,minmax(0,1fr));}
                @media(max-width:900px){body:has(.ds-slc-headregion) .ds-kpiwrap--4up{grid-template-columns:repeat(2,minmax(0,1fr));}}
                .ds-slc-hero{position:relative;overflow:hidden;padding:22px 24px 18px;border:1px solid #A7D9D3;border-radius:16px;
                  background:radial-gradient(130% 130% at 92% 8%, rgba(8,145,178,.24) 0%, rgba(8,145,178,0) 48%),
                    linear-gradient(120deg,#D3EEEA 0%,#DAF1EF 60%,#E9F7F5 100%);box-shadow:0 1px 2px rgba(16,24,40,.05),0 12px 34px rgba(15,118,110,.12);}
                .ds-slc-hero-row{position:relative;z-index:1;display:flex;align-items:flex-start;gap:15px;}
                .ds-slc-hero-icon{flex:0 0 auto;display:grid;place-items:center;width:50px;height:50px;border-radius:13px;color:#fff;font-size:20px;
                  background:linear-gradient(135deg,#0D9488 0%,#0F766E 100%);box-shadow:0 6px 16px rgba(15,118,110,.32);}
                .ds-slc-hero-eyebrow{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#0F766E;}
                .ds-slc-hero-title{font-size:24px;font-weight:700;letter-spacing:-.02em;color:#0B3B36;}
                .ds-slc-hero-sub{margin-top:5px;font-size:13px;line-height:1.5;color:#2E5A55;max-width:64ch;}
                .ds-slc-hero-chips{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:8px;margin-top:15px;}
                html.page-733 .t-Body-title.hspl-hero-card, html.page-733 .t-Body-title{display:none !important;}
                </style>
                ```
        }
        layout {
            sequence: 1
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rate-trend-chart (
        name: Average Rate Trend
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select to_char(trunc(ci.CCInvoiceDate,'MM'),'Mon-RR') MONTH_LABEL,
                       Round(Sum(d.Amount)/Nullif(Sum(d.Quantity1),0)) AVG_RATE,
                       trunc(ci.CCInvoiceDate,'MM') SORT_KEY
                  From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                  Join ItemSpecification isp On isp.ItemSpecificationCode=d.ItemSpecificationCode
                 Where ci.CCInvoiceDate Between to_date(:P733_FROMDATE,'DD-MM-RRRR') And to_date(:P733_TODATE,'DD-MM-RRRR')
                   And isp.ItemCategoryCode = :P733_CATEGORY
                   And (:P733_COMPANY Is Null Or ci.CompanyCode=:P733_COMPANY)
                   And (:P733_LOCATION Is Null Or ci.LocationCode=:P733_LOCATION)
                   And (:P733_PANEL Is Null Or ci.Panel=:P733_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                 Group By trunc(ci.CCInvoiceDate,'MM')
                 Order By trunc(ci.CCInvoiceDate,'MM')
                ```
            pageItemsToSubmit: [
                P733_CATEGORY
                P733_FROMDATE
                P733_TODATE
                P733_COMPANY
                P733_LOCATION
                P733_PANEL
            ]
        }
        layout {
            sequence: 30
            slot: body
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: line
        }
        chartLayout {
            height: 300
        }
        settings {
            timeAxisType: auto
        }
        messages {
            whenNoDataFound: Select a category to plot its rate trend.
        }

        series rate (
            name: Avg Rate
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: SORT_KEY
                value: AVG_RATE
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rate
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region rule-customers (
        name: Customers Note
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Sold To</h2>
                  <p>Every customer this category was billed to over the last 12 months &mdash; quantity, value and their own average rate. Click a customer to open its 360.</p>
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-specs (
        name: Specs Note
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Specifications Inside</h2>
                  <p>Which specifications make up this category &mdash; quantity, value and average rate per specification. Last 12 months.</p>
                </div>
                ```
        }
        layout {
            sequence: 50
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-transactions (
        name: Transactions Note
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Bills &amp; Orders</h2>
                  <p>Every invoice line in this category, newest first &mdash; with links to the CC Invoice / Invoice 360 (bill, e-invoice and receipt) and the sales order behind it.</p>
                </div>
                ```
        }
        layout {
            sequence: 60
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-trends (
        name: Trends Note
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Rate &amp; Value Trend</h2>
                  <p>How this category has moved month by month &mdash; the weighted average rate on the left, the monthly invoiced value on the right. Last 12 months.</p>
                </div>
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region value-trend-chart (
        name: Monthly Value
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select to_char(trunc(ci.CCInvoiceDate,'MM'),'Mon-RR') MONTH_LABEL,
                       Round(Sum(d.Amount)/1e5,2) VAL_L,
                       trunc(ci.CCInvoiceDate,'MM') SORT_KEY
                  From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                  Join ItemSpecification isp On isp.ItemSpecificationCode=d.ItemSpecificationCode
                 Where ci.CCInvoiceDate Between to_date(:P733_FROMDATE,'DD-MM-RRRR') And to_date(:P733_TODATE,'DD-MM-RRRR')
                   And isp.ItemCategoryCode = :P733_CATEGORY
                   And (:P733_COMPANY Is Null Or ci.CompanyCode=:P733_COMPANY)
                   And (:P733_LOCATION Is Null Or ci.LocationCode=:P733_LOCATION)
                   And (:P733_PANEL Is Null Or ci.Panel=:P733_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                 Group By trunc(ci.CCInvoiceDate,'MM')
                 Order By trunc(ci.CCInvoiceDate,'MM')
                ```
            pageItemsToSubmit: [
                P733_CATEGORY
                P733_FROMDATE
                P733_TODATE
                P733_COMPANY
                P733_LOCATION
                P733_PANEL
            ]
        }
        layout {
            sequence: 30
            slot: body
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartLayout {
            height: 300
        }
        settings {
            timeAxisType: auto
        }
        messages {
            whenNoDataFound: Select a category to plot its value trend.
        }

        series val (
            name: Value (Rs Lakh)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: SORT_KEY
                value: VAL_L
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lakh
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    pageItem P733_CATEGORY (
        type: selectList
        label {
            label: Category
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select cat.ItemCategoryName d, cat.ItemCategoryCode r
                  From ItemCategory cat
                 Where Exists (Select 1 From CCInvoiceDetail dd Join ItemSpecification isp On isp.ItemSpecificationCode=dd.ItemSpecificationCode Where isp.ItemCategoryCode=cat.ItemCategoryCode)
                 Order By cat.ItemCategoryName
                ```
            displayExtraValues: false
            nullDisplayValue: - Select category -
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Pick a product category, then select Apply to load its full 360.
        }
    )

    pageItem P733_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: Select CompanyName d,CompanyCode r From Company Order By 1
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 3
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 5
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P733_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 1
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(add_months(trunc(sysdate,'MM'),-2),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P733_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: Select LocationName d,LocationCode r From Location Order By 1
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        layout {
            sequence: 4
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 8
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P733_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            displayExtraValues: false
            nullDisplayValue: A + B
        }
        layout {
            sequence: 5
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 11
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P733_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 2
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    button apply-filters (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-search
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-filters (
        buttonName: RESETFILTERS
        label: Reset
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 9
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 733
                clearCache: 733
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

