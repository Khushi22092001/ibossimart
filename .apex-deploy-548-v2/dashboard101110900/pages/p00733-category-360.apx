    region cat-transactions (
        name: Transactions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a href="'||apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>ci.TNo)||'">'||ci.CCInvoiceNo||'</a>' INV_NO,
                       ci.CCInvoiceDate INV_DATE,
                       '<a href="'||apex_page.get_url(p_page=>655,p_clear_cache=>'655',p_items=>'P655_PARTY_CODE',p_values=>ci.PartyCode)||'">'||GetPartyName(ci.PartyCode)||'</a>' CUSTOMER,
                       Nvl(isp.ItemSpecificationName, d.ItemSpecificationCode) SPEC,
                       Round(d.Quantity1) QTY,
                       d.Rate RATE,
                       Round(d.Amount) AMOUNT,
                       so.SalesOrderNo ORDER_NO
                  From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                  Join ItemSpecification isp On isp.ItemSpecificationCode=d.ItemSpecificationCode
                  Left Join SalesOrder so On so.TNo=ci.SalesOrderTNo
                 Where ci.CCInvoiceDate Between to_date(:P733_FROMDATE,'DD-MM-RRRR') And to_date(:P733_TODATE,'DD-MM-RRRR')
                   And isp.ItemCategoryCode = :P733_CATEGORY
                   And (:P733_COMPANY Is Null Or ci.CompanyCode=:P733_COMPANY)
                   And (:P733_LOCATION Is Null Or ci.LocationCode=:P733_LOCATION)
                   And (:P733_PANEL Is Null Or ci.Panel=:P733_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                 Order By ci.CCInvoiceDate Desc, ci.CCInvoiceNo Desc
                ```
            pageItemsToSubmit: [
                P733_CATEGORY
                P733_FROMDATE
                P733_TODATE
                P733_COMPANY
                P733_LOCATION
                P733_PANEL
