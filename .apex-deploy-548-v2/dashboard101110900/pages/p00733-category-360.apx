page 733 (
    name: Category 360
    alias: CATEGORY-360
    title: Category 360
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            CATEGORY 360 (HSPL). Pick a product category and see everything about it over the last
            12 months: quantity, invoiced value, distinct customers and the weighted average rate;
            the average-rate and value trend by month; who it was sold to (with per-customer qty,
            value and rate); the specifications inside the category; and every invoice line with
            links to the CC Invoice / Invoice 360 (bill + e-invoice + receipt) and its sales order.
            Category = ItemSpecification.ItemCategoryCode -> ItemCategory, resolved on invoice lines.
            READ-ONLY.
            ```
    }

    region cat-customers (
        name: Customers
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a href="'||apex_page.get_url(p_page=>655,p_clear_cache=>'655',p_items=>'P655_PARTY_CODE',p_values=>ci.PartyCode)||'">'||GetPartyName(ci.PartyCode)||'</a>' CUSTOMER,
                       Round(Sum(d.Quantity1)) QTY,
                       Round(Sum(d.Amount)/1e5,2) VAL_L,
                       Round(Sum(d.Amount)/Nullif(Sum(d.Quantity1),0)) AVG_RATE,
                       Count(Distinct ci.TNo) BILLS
                  From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                  Join ItemSpecification isp On isp.ItemSpecificationCode=d.ItemSpecificationCode
                 Where ci.CCInvoiceDate Between to_date(:P733_FROMDATE,'DD-MM-RRRR') And to_date(:P733_TODATE,'DD-MM-RRRR')
                   And isp.ItemCategoryCode = :P733_CATEGORY
                   And (:P733_COMPANY Is Null Or ci.CompanyCode=:P733_COMPANY)
                   And (:P733_LOCATION Is Null Or ci.LocationCode=:P733_LOCATION)
                   And (:P733_PANEL Is Null Or ci.Panel=:P733_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                 Group By ci.PartyCode
                 Order By Sum(d.Amount) Desc
                ```
            pageItemsToSubmit: [
                P733_CATEGORY
                P733_FROMDATE
                P733_TODATE
                P733_COMPANY
                P733_LOCATION
                P733_PANEL
            ]
        }
        layout {
            sequence: 41
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: p733Customers
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: Select a category above to list its customers.
        }
        advanced {
            savedReportMappingIdentifier: 48983570530097972
        }

