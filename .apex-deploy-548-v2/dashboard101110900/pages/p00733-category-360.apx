    region cat-kpi (
        name: Category KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With K As (
                  Select Round(Sum(d.Quantity1)) Qty, Sum(d.Amount) Val,
                         Count(Distinct ci.PartyCode) Customers,
                         Round(Sum(d.Amount)/Nullif(Sum(d.Quantity1),0)) AvgRate
                    From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                    Join ItemSpecification isp On isp.ItemSpecificationCode=d.ItemSpecificationCode
                   Where ci.CCInvoiceDate Between to_date(:P733_FROMDATE,'DD-MM-RRRR') And to_date(:P733_TODATE,'DD-MM-RRRR')
                     And isp.ItemCategoryCode = :P733_CATEGORY
                     And (:P733_COMPANY Is Null Or ci.CompanyCode=:P733_COMPANY)
                     And (:P733_LOCATION Is Null Or ci.LocationCode=:P733_LOCATION)
                     And (:P733_PANEL Is Null Or ci.Panel=:P733_PANEL)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual)))
                Select Case x.Seq
                  When 1 Then q'~<div class="ds-kpi ds-kpi--value"><span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Quantity Sold</span><span class="ds-kpi-n">~'||to_char(Nvl(K.Qty,0),'FM999G999G990')||q'~</span><span class="ds-kpi-sub">Invoiced qty, last 12 months</span></span></div>~'
                  When 2 Then q'~<div class="ds-kpi ds-kpi--bill"><span class="ds-kpi-ic"><span class="fa fa-inr"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Invoiced Value</span><span class="ds-kpi-n">~'||to_char(Nvl(K.Val,0)/1e7,'FM999G990D00')||q'~ Cr</span><span class="ds-kpi-sub">CC Invoice value</span></span></div>~'
                  When 3 Then q'~<div class="ds-kpi ds-kpi--ok"><span class="ds-kpi-ic"><span class="fa fa-users"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Customers</span><span class="ds-kpi-n">~'||to_char(Nvl(K.Customers,0),'FM999G990')||q'~</span><span class="ds-kpi-sub">Distinct parties billed</span></span></div>~'
                  Else q'~<div class="ds-kpi ds-kpi--input"><span class="ds-kpi-ic"><span class="fa fa-tag"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Avg Rate</span><span class="ds-kpi-n">~'||to_char(Nvl(K.AvgRate,0),'FM999G999G990')||q'~</span><span class="ds-kpi-sub">Weighted, per unit</span></span></div>~'
                End As CARD
                From K, (Select Level Seq From dual Connect By Level <= 4) x
                Order By x.Seq
                ```
            pageItemsToSubmit: [
                P733_CATEGORY
                P733_FROMDATE
                P733_TODATE
                P733_COMPANY
                P733_LOCATION
                P733_PANEL
            ]
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                ds-kpiwrap--4up
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: Select a category above to see its KPIs.
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region cat-specs (
        name: Specifications
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Nvl(isp.ItemSpecificationName, d.ItemSpecificationCode) SPEC,
                       Round(Sum(d.Quantity1)) QTY,
                       Round(Sum(d.Amount)/1e5,2) VAL_L,
                       Round(Sum(d.Amount)/Nullif(Sum(d.Quantity1),0)) AVG_RATE,
                       Count(Distinct ci.PartyCode) CUSTOMERS
                  From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                  Join ItemSpecification isp On isp.ItemSpecificationCode=d.ItemSpecificationCode
                 Where ci.CCInvoiceDate Between to_date(:P733_FROMDATE,'DD-MM-RRRR') And to_date(:P733_TODATE,'DD-MM-RRRR')
                   And isp.ItemCategoryCode = :P733_CATEGORY
                   And (:P733_COMPANY Is Null Or ci.CompanyCode=:P733_COMPANY)
                   And (:P733_LOCATION Is Null Or ci.LocationCode=:P733_LOCATION)
                   And (:P733_PANEL Is Null Or ci.Panel=:P733_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                 Group By Nvl(isp.ItemSpecificationName, d.ItemSpecificationCode)
                 Order By Sum(d.Amount) Desc
