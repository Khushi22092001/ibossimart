page 533 (
    name: Sales Confirmation Followup
    alias: SALES-CONFIRMATION-FOLLOWUP
    title: Sales Confirmation Followup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        title: Sales Confirmation Followup
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.partycode Order By a.partycode) = 1 Then
                          getpartyname(a.partycode) 
                         Else
                          Null
                       End partyname,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.partycode,a.tNo Order By a.partycode,a.Tno) = 1 Then
                          a.salesconfirmno
                         Else
                          Null
                       End salesconfirmno,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.partycode,a.tNo Order By a.partycode,a.Tno) = 1 Then
                          a.salesconfirmdate
                         Else
                          Null
                       End salesconfirmdate,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.partycode,a.tNo Order By a.partycode,a.Tno) = 1 Then
                          (select quantity1 from salesconfirmdetail where tno = a.tno and rownum = 1)
                         Else
                          Null
                       End salesconfirmqty,
                      Case
                         When ROW_NUMBER()
                          Over(Partition By a.partycode,a.tNo Order By a.partycode,a.Tno) = 1 Then
                          (select rate from salesconfirmdetail where tno = a.tno and rownum = 1)
                         Else
                          Null
                       End salesconfirmrate,
                --a.salesconfirmno, 
                --a.salesconfirmdate,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.partycode,a.tNo,b.salesorderno Order By a.partycode,a.Tno,b.salesorderno) = 1 Then
                          b.salesorderno
                         Else
                          Null
                       End salesorderno,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.tNo,b.salesorderno,e.ccinvoiceno Order By a.Tno,b.salesorderno,e.ccinvoiceno) = 1 Then
                          e.ccinvoiceno
                         Else
                          Null
                       End ccinvoiceno,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.tNo,b.salesorderno,e.ccinvoiceno,e.vehicleno Order By a.Tno,b.salesorderno,e.ccinvoiceno,e.vehicleno) = 1 Then
                          e.vehicleno
                         Else
                          Null
                       End vehicleno,
                Case
                         When ROW_NUMBER()
                          Over(Partition By a.tNo,b.salesorderno,e.ccinvoiceno Order By a.Tno,b.salesorderno,e.ccinvoiceno) = 1 Then
                          e.ccinvoicedate
                         Else
                          Null
                       End ccinvoicedate,
                --b.salesorderno,
                --e.ccinvoiceno,
                --e.ccinvoicedate,
                sum(d.quantity1) Quantity
                from salesconfirm a,
                     salesorder b,
                     salesorderdetail c,
                     ccinvoicedetail d,
                     ccinvoice e,
                     Documentstatusdetail i
                where a.tno = b.salesconfirmtno(+)
                  and b.tno = c.tno(+)
                  and c.tno = d.referencetno(+)
                  and c.itemcode = d.itemcode(+)
                  and c.itemspecificationcode = d.itemspecificationcode(+)
                  and c.itemlengthcode=d.itemlengthcode(+)
                  and d.tno = e.tno(+)
                  and a.tno = i.moduletno(+)
                
                --- FILTER
                and  a.SalesConfirmDate between :P533_FROMDATE and :P533_TODATE
                and ( :P533_COMPANY IS NULL OR instr(':'||:P533_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                and ( :P533_LOCATION IS NULL OR instr(':'||:P533_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                and ( :P533_PARTY IS NULL OR instr(':'||:P533_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                and ( :P533_SALESCONFIRM IS NULL OR instr(':'||:P533_SALESCONFIRM||':',':'||a.Tno||':') > 0 ) 
                and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                and ( :P533_STATUS IS NULL OR instr(':'||:P533_STATUS||':',':'||i.DocumentStatusCode||':') > 0 )
                AND ( :P533_ITEMCATEGORY IS NULL OR EXISTS ( SELECT 1 FROM SALESCONFIRMDETAIL AA WHERE AA.ITEMCATEGORYCODE=:P533_ITEMCATEGORY))
                
                group by a.partycode,a.tno,a.salesconfirmno, 
                a.salesconfirmdate,
                b.salesorderno,
                e.ccinvoiceno,
                e.vehicleno,
                e.ccinvoicedate
                 
                ```
            pageItemsToSubmit: [
                P533_COMPANY
                P533_FROMDATE
                P533_TODATE
                P533_LOCATION
                P533_PARTY
                P533_ITEM
                P533_ITEMCATEGORY
                P533_STATUS
                P533_SALESCONFIRM
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 23183408249093342
        }

