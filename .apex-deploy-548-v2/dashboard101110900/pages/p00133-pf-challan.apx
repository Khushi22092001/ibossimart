    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pf-challan (
        name: PF Challan
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.TNO,
                       row_number() over(order by a.PFCHALLANDATE) SerialNo,
                       A.PFCHALLANNO,
                       A.PFCHALLANDATE,
                       to_char(a.formonth, 'MON-RRRR') As FORMONTH,
                       A.FORMONTH As FromDate,
                       last_day(a.formonth) As toDate,
                       A.LASTSUBSCRIBER,
                       A.NEWSUBSCRIBER,
                       round(A.PFDEDUCTEDONAMOUNT,2) as PFDEDUCTEDONAMOUNT,
                       round(A.PFAMOUNT,2) as PFAMOUNT,
                       round(A.EMPLOYEEPFACCOUNT01AMOUNT,2) as EMPLOYEEPFACCOUNT01AMOUNT,
                       round(A.EMPLOYERPFACCOUNT10AMOUNT,2) as EMPLOYERPFACCOUNT10AMOUNT,
                       round(A.ADMINPFACCOUNT02AMOUNT,2) as ADMINPFACCOUNT02AMOUNT,
                       round(A.ADMINPFACCOUNT21AMOUNT,2) as ADMINPFACCOUNT21AMOUNT
                  From PFCHALLAN A
                  where a.FORMONTH between :P133_FROMDATE and :P133_TODATE
                  and instr(':'||:P133_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P133_LOCATION||':',':'||a.LocationCode||':') > 0
                 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 134
                items: {
                    P134_TNO: #TNO#
                }
                clearCache: 134
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            authorizationScheme: @hr-salary-sheet
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 100000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            groupBy: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
