    region txn-register (
        name: Production transactions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With
                Txn As (
                  Select p.Tno, p.ProductionNo, p.ProductionDate, p.CompanyCode, p.LocationCode,
                         p.ShiftCode, p.Panel, p.Creator
                    From Production p
                   Where p.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR')
                     And p.ProductionDate <  to_date(:P652_TO,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P652_PANEL    Is Null Or p.Panel        = :P652_PANEL)
                     And (:P652_COMPANY  Is Null Or p.CompanyCode  = :P652_COMPANY)
                     And (:P652_LOCATION Is Null Or p.LocationCode = :P652_LOCATION)),
                InpS As (
                  Select r.Tno, Sum(r.Quantity1) InQty,
                         Count(Distinct r.ItemCode) InItems
                    From ProductionRaw r
                    Join Item i On i.ItemCode = r.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)
                   Group By r.Tno),
                OutD As (
                  Select f.Tno,
                         Case i.ItemNatureCode
                              When 'FINISHEDITEM'     Then 'FINISHED'
                              When 'SEMIFINISHEDITEM' Then 'SEMI'
                              When 'SUBSIDERY'        Then 'SUBSIDIARY'
                              When 'BYPRODUCT'        Then 'SUBSIDIARY'
                              When 'WASTE'            Then 'WASTE'
                              When 'SCRAP'            Then 'WASTE'
                              Else 'OTHER' End OutType,
                         f.Quantity1 MT,
                         s.Amount Val
                    From ProductionFinished f
                    Join Item i On i.ItemCode = f.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                    Left Join Stock s On s.StockModuleCode = 'PRODUCTION'
                                     And s.StockModuleTno  = f.Tno
                                     And s.StockModuleSno  = f.Sno
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)),
                OutS As (
                  Select Tno, Sum(MT) OutQty,
                         Sum(Case When OutType='FINISHED'   Then MT End) FinQ,
                         Sum(Case When OutType='SEMI'       Then MT End) SemiQ,
                         Sum(Case When OutType='SUBSIDIARY' Then MT End) SubQ,
                         Sum(Case When OutType='WASTE'      Then MT End) WasteQ,
                         Sum(Val) OutVal
                    From OutD
                   Where (:P652_OUTTYPE Is Null Or OutType = :P652_OUTTYPE)
                   Group By Tno),
                Fact As (
                  Select t.Tno, t.ProductionNo, t.ProductionDate, t.LocationCode, t.ShiftCode, t.Panel,
                         nvl(i.InQty,0) InQty, nvl(i.InItems,0) InItems,
                         nvl(o.OutQty,0) OutQty, nvl(o.FinQ,0) FinQ, nvl(o.SemiQ,0) SemiQ,
                         nvl(o.SubQ,0) SubQ, nvl(o.WasteQ,0) WasteQ, nvl(o.OutVal,0) OutVal
                    From Txn t
                    Left Join InpS i On i.Tno = t.Tno
                    Left Join OutS o On o.Tno = t.Tno),
                F As (
                  Select Fact.*,
                         Case When OutQty = 0 Then 1
                              When InQty  = 0 Then 2
                              When OutQty/InQty > 1.02 Then 3
                              When OutQty/InQty < 0.55 Then 4
                              Else 9 End Kind
                    From Fact)
                Select
                  Case Kind When 1 Then '<span class="ds-sev ds-sev--high">No output</span>'
                            When 2 Then '<span class="ds-sev ds-sev--high">No input</span>'
                            When 3 Then '<span class="ds-sev ds-sev--high">Out &gt; in</span>'
                            When 4 Then '<span class="ds-sev ds-sev--medium">Low ratio</span>'
                            Else        '<span class="ds-sev ds-sev--low">Balanced</span>' End As STATUS,
                  to_char(ProductionDate,'DD-Mon-RR') As TXN_DATE,
                  /* 352 of 466 production numbers are 32-character generated
                     tokens rather than a numbering series, so a short stable
                     reference is shown with the full value in the tooltip. */
                  '<a href="' || APEX_UTIL.PREPARE_URL(
                       'f?p=' || :APP_ID || ':499:' || :APP_SESSION || '::NO:499:'
                       || 'P499_FROMDATE,P499_TODATE,P499_COMPANY,P499_LOCATION:'
                       || to_char(ProductionDate,'DD-MM-RRRR') || ',' || to_char(ProductionDate,'DD-MM-RRRR')
                       || ',,' || LocationCode)
                   || '" title="' || apex_escape.html(ProductionNo) || '">'
                   || Case When Length(ProductionNo) > 18
                           Then '#' || apex_escape.html(Substr(ProductionNo, -8))
                           Else apex_escape.html(ProductionNo) End
                   || ' <span class="fa fa-angle-right"></span></a>' As TXN_REF,
                  GetLocationName(LocationCode) As LOCATION,
                  Panel As PANEL,
                  nvl(GetShiftName(ShiftCode), ShiftCode) As SHIFT,
                  to_char(InItems,'FM990') As IN_ITEMS,
                  to_char(Round(InQty,1),'FM999G999G990D0')  As INPUT_QTL,
                  to_char(Round(FinQ,1),'FM999G999G990D0')   As FINISHED_QTL,
                  to_char(Round(SemiQ,1),'FM999G999G990D0')  As SEMI_QTL,
                  to_char(Round(SubQ,1),'FM999G999G990D0')   As SUBSIDIARY_QTL,
                  to_char(Round(WasteQ,1),'FM999G999G990D0') As WASTE_QTL,
                  Case When InQty - OutQty < 0
                       Then '<span class="ds-neg">' || to_char(Round(InQty-OutQty,1),'FM999G999G990D0') || '</span>'
                       Else to_char(Round(InQty-OutQty,1),'FM999G999G990D0') End As BALANCE_QTL,
                  Case When InQty = 0 Then '<span class="ds-pill ds-pill--bad">no input</span>'
                       Else '<span class="ds-pill ds-pill--' ||
                            Case When OutQty/InQty > 1.02 Then 'bad'
                                 When OutQty/InQty >= 0.78 Then 'good'
                                 When OutQty/InQty >= 0.55 Then 'warn'
                                 Else 'muted' End || '">'
                            || to_char(Round(OutQty/InQty*100,1),'FM990D0') || '&nbsp;%</span>' End As RATIO,
                  Case When OutVal = 0 Then '&mdash;'
                       Else to_char(Round(OutVal/100000,2),'FM999G990D00') End As VALUE_LAKH
                From F Order By Case When Kind = 9 Then 1 Else 0 End, Kind, ProductionDate Desc
                Fetch First 60 Rows Only
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_OUTTYPE
                P652_GROUP
            ]
        }
        layout {
            sequence: 85
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                ds-dash-panel
                ds-recon
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No production transactions in this period for the selected scope.
        }

        column BALANCE_QTL (
