    pageItem P652_CATEGORY (
        type: selectList
        label {
            label: Item category
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.ItemCategoryName d, c.ItemCategoryCode r
                  From ItemCategory c
                 Where Exists (Select 1 From Item i
                                Where i.ItemCategoryCode = c.ItemCategoryCode
                                  And (Exists (Select 1 From ProductionFinished f Where f.ItemCode = i.ItemCode)
                                    Or Exists (Select 1 From ProductionRaw r Where r.ItemCode = i.ItemCode)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All categories
        }
        layout {
            sequence: 30
            region: @filter-drawer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_COMPANY (
        type: selectList
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From Production p
                                Where p.CompanyCode = c.CompanyCode
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 30
            region: @parameters
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_FROM (
        type: datePicker
        label {
            label: From
            alignment: left
        }
        layout {
            sequence: 10
            region: @parameters
            slot: regionBody
            alignment: left
            columnSpan: 2
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 20
        }
        default {
            type: expression
            plsqlExpression: add_months(trunc(add_months(sysdate,-3),'YEAR'),3)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_GROUP (
        type: selectList
        label {
            label: Product / material group
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select g.ItemName d, g.ItemCode r
                  From Item g
                 Where Exists (Select 1 From Item c
                                Where c.ParentCode = g.ItemCode
                                  And (Exists (Select 1 From ProductionFinished f Where f.ItemCode = c.ItemCode)
                                    Or Exists (Select 1 From ProductionRaw r Where r.ItemCode = c.ItemCode)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All groups
        }
        layout {
            sequence: 20
            region: @filter-drawer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_LOCATION (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From Production p
                                Where p.LocationCode = l.LocationCode
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                                  And (:P652_COMPANY Is Null Or p.CompanyCode = :P652_COMPANY))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P652_COMPANY
            itemsToSubmit: P652_COMPANY
        }
        layout {
            sequence: 40
            region: @parameters
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_OUTTYPE (
        type: selectList
        label {
            label: Output type
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Finished;FINISHED,Semi-finished;SEMI,Subsidiary;SUBSIDIARY,Waste;WASTE
            displayExtraValues: false
            nullDisplayValue: All output types
        }
        layout {
            sequence: 10
            region: @filter-drawer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_PANEL (
        type: radioGroup
        label {
            label: Panel
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            displayExtraValues: false
            nullDisplayValue: A + B
        }
        layout {
            sequence: 50
            region: @parameters
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            cssClasses: ds-seg
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P652_TO (
        type: datePicker
        label {
            label: To
            alignment: left
        }
        layout {
            sequence: 20
            region: @parameters
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            width: 20
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    button open-consumption (
        buttonName: OPENCONSUMPTION
        label: Consumption Detail
        layout {
            sequence: 110
            region: @parameters
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
            icon: fa-cubes
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 201
                items: {
                    P201_FROMDATE: &P652_FROM.
                    P201_TODATE: &P652_TO.
                    P201_COMPANY: &P652_COMPANY.
                    P201_LOCATION: &P652_LOCATION.
                }
                clearCache: 201
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

