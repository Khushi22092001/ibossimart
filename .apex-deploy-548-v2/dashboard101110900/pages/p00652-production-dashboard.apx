    button refresh (
        buttonName: REFRESH
        label: Apply
        layout {
            sequence: 80
            region: @parameters
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
                t-Button--stretch
            ]
            cssClasses: ds-apply
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction filter-switch (
        name: Filter switch refresh
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P652_PANEL
                P652_OUTTYPE
                P652_GROUP
            ]
        }

        action refresh-flow (
            action: refresh
            affectedElements {
                selectionType: region
                region: @material-flow
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action refresh-header (
            action: refresh
            affectedElements {
                selectionType: region
                region: @dash-header
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-kpi (
            action: refresh
            affectedElements {
                selectionType: region
                region: @kpi-strip
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-location (
            action: refresh
            affectedElements {
                selectionType: region
                region: @location-analysis
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action refresh-material (
            action: refresh
            affectedElements {
                selectionType: region
                region: @material-consumed
            }
            execution {
                sequence: 80
                fireOnInit: false
            }
        )

        action refresh-mix (
            action: refresh
            affectedElements {
                selectionType: region
                region: @chart-mix
            }
