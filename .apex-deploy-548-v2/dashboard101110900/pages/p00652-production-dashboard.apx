            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Material
            }
            layout {
                sequence: 10
            }
        )

        column MATERIAL_GROUP (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Group
            }
            layout {
                sequence: 20
            }
        )

        column NATIVE_QTY (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: As posted
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

        column QTY_QTL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Normalised (MT)
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

        column SHARE_OF_OUTPUT (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Share of consumption
            }
            layout {
                sequence: 70
            }
            security {
                escapeSpecialChars: false
            }
        )

        column STREAM (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Stream
            }
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TXNS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Txns
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

    )

    region material-flow (
        name: Input to output flow
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With
                Txn As (
                  Select p.Tno From Production p
                   Where p.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR')
                     And p.ProductionDate <  to_date(:P652_TO,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P652_PANEL    Is Null Or p.Panel        = :P652_PANEL)
                     And (:P652_COMPANY  Is Null Or p.CompanyCode  = :P652_COMPANY)
                     And (:P652_LOCATION Is Null Or p.LocationCode = :P652_LOCATION)),
                InpS As (
                  Select r.Tno, Sum(r.Quantity1) InQty,
                         Count(Distinct r.ItemCode) InItems
                    From ProductionRaw r
                    Join Item i On i.ItemCode = r.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)
                   Group By r.Tno),
                OutD As (
                  Select f.Tno, f.ItemCode,
                         Case i.ItemNatureCode
                              When 'FINISHEDITEM'     Then 'FINISHED'
                              When 'SEMIFINISHEDITEM' Then 'SEMI'
                              When 'SUBSIDERY'        Then 'SUBSIDIARY'
                              When 'BYPRODUCT'        Then 'SUBSIDIARY'
                              When 'WASTE'            Then 'WASTE'
                              When 'SCRAP'            Then 'WASTE'
                              Else 'OTHER' End OutType,
                         f.Quantity1 MT,
                         s.Amount Val
                    From ProductionFinished f
                    Join Item i On i.ItemCode = f.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                    Left Join Stock s On s.StockModuleCode = 'PRODUCTION'
                                     And s.StockModuleTno  = f.Tno
                                     And s.StockModuleSno  = f.Sno
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)),
                OutS As (
                  Select Tno, Sum(MT) OutQty,
                         Sum(Case When OutType='FINISHED'   Then MT End) FinQ,
                         Sum(Case When OutType='SEMI'       Then MT End) SemiQ,
                         Sum(Case When OutType='SUBSIDIARY' Then MT End) SubQ,
                         Sum(Case When OutType='WASTE'      Then MT End) WasteQ,
                         Sum(Case When OutType='FINISHED'   Then Val End) FinV,
                         Sum(Case When OutType='SEMI'       Then Val End) SemiV,
                         Sum(Case When OutType='SUBSIDIARY' Then Val End) SubV,
                         Sum(Case When OutType='WASTE'      Then Val End) WasteV,
                         Count(Distinct Case When OutType='FINISHED'   Then ItemCode End) FinItems,
                         Count(Distinct Case When OutType='SEMI'       Then ItemCode End) SemiItems,
                         Count(Distinct Case When OutType='SUBSIDIARY' Then ItemCode End) SubItems
                    From OutD
                   Where (:P652_OUTTYPE Is Null Or OutType = :P652_OUTTYPE)
                   Group By Tno),
                T As (
                  Select Count(*) Txns,
                         nvl(Sum(i.InQty),0) InQ,  nvl(Sum(o.OutQty),0) OutQ,
                         nvl(Sum(o.FinQ),0)  FinQ, nvl(Sum(o.SemiQ),0)  SemiQ,
                         nvl(Sum(o.SubQ),0)  SubQ, nvl(Sum(o.WasteQ),0) WasteQ,
                         nvl(Sum(o.FinV),0)  FinV, nvl(Sum(o.SemiV),0)  SemiV,
                         nvl(Sum(o.SubV),0)  SubV, nvl(Sum(o.WasteV),0) WasteV,
                         nvl(Max(i.InItems),0) InItems, nvl(Max(o.FinItems),0) FinItems,
                         nvl(Max(o.SemiItems),0) SemiItems, nvl(Max(o.SubItems),0) SubItems
                    From Txn t
                    Left Join InpS i On i.Tno = t.Tno
                    Left Join OutS o On o.Tno = t.Tno)
                Select Case N.Seq
                  When 1 Then
                    '<div class="ds-flownode ds-flownode--in">'
                    || '<div class="ds-flow-l"><span class="fa fa-sign-in"></span>Material charged</div>'
                    || '<div class="ds-flow-n">' || to_char(Round(InQ,1),'FM999G999G990D0') || '<i>MT</i></div>'
                    || '<div class="ds-flow-s"><b>' || to_char(Txns) || '</b> transactions &middot; <b>'
                       || to_char(InItems) || '</b> materials</div></div>'
                  When 2 Then
                    '<div class="ds-flownode ds-flownode--fin' || Case When FinQ = 0 Then ' ds-flownode--idle' End || '">'
                    || '<div class="ds-flow-l"><span class="fa fa-cube"></span>Finished</div>'
                    || '<div class="ds-flow-n">' || to_char(Round(FinQ,1),'FM999G999G990D0') || '<i>MT</i></div>'
                    || '<div class="ds-flow-s"><b>' || nvl(to_char(Round(FinQ/nullif(OutQ,0)*100,1),'FM990D0'),'0')
                       || '%</b> of output'
                       || Case When FinV > 0 Then ' &middot; &#8377;<b>' || to_char(Round(FinV/100000,1),'FM999G990D0')
                                                  || '</b> L' End || '</div></div>'
                  When 3 Then
                    '<div class="ds-flownode ds-flownode--semi' || Case When SemiQ = 0 Then ' ds-flownode--idle' End || '">'
                    || '<div class="ds-flow-l"><span class="fa fa-cubes"></span>Semi-finished</div>'
                    || '<div class="ds-flow-n">' || to_char(Round(SemiQ,1),'FM999G999G990D0') || '<i>MT</i></div>'
                    || '<div class="ds-flow-s"><b>' || nvl(to_char(Round(SemiQ/nullif(OutQ,0)*100,1),'FM990D0'),'0')
                       || '%</b> of output'
                       || Case When SemiV > 0 Then ' &middot; &#8377;<b>' || to_char(Round(SemiV/100000,1),'FM999G990D0')
                                                   || '</b> L' End || '</div></div>'
                  When 4 Then
                    '<div class="ds-flownode ds-flownode--sub' || Case When SubQ = 0 Then ' ds-flownode--idle' End || '">'
                    || '<div class="ds-flow-l"><span class="fa fa-recycle"></span>Subsidiary</div>'
                    || '<div class="ds-flow-n">' || to_char(Round(SubQ,1),'FM999G999G990D0') || '<i>MT</i></div>'
                    || '<div class="ds-flow-s"><b>' || nvl(to_char(Round(SubQ/nullif(OutQ,0)*100,1),'FM990D0'),'0')
                       || '%</b> of output'
                       || Case When SubV > 0 Then ' &middot; &#8377;<b>' || to_char(Round(SubV/100000,1),'FM999G990D0')
                                                  || '</b> L' End || '</div></div>'
                  When 5 Then
                    '<div class="ds-flownode ds-flownode--waste' || Case When WasteQ = 0 Then ' ds-flownode--idle' End || '">'
                    || '<div class="ds-flow-l"><span class="fa fa-trash-o"></span>Waste</div>'
                    || '<div class="ds-flow-n">' || to_char(Round(WasteQ,1),'FM999G999G990D0') || '<i>MT</i></div>'
                    || '<div class="ds-flow-s">'
                       || Case When WasteQ = 0
                               Then 'Classification exists in the item master, not yet used on any output line'
                               Else '<b>' || to_char(Round(WasteQ/nullif(OutQ,0)*100,1),'FM990D0') || '%</b> of output'
                                    || Case When WasteV > 0 Then ' &middot; &#8377;<b>'
                                            || to_char(Round(WasteV/100000,1),'FM999G990D0') || '</b> L' End End
                       || '</div></div>'
                  When 6 Then
                    '<div class="ds-flownode ds-flownode--bal ds-flownode--last'
                    || Case When :P652_OUTTYPE Is Not Null Or :P652_GROUP Is Not Null
                            Then ' ds-flownode--idle' End || '">'
                    || '<div class="ds-flow-l"><span class="fa fa-balance-scale"></span>Unaccounted</div>'
                    || '<div class="ds-flow-n">'
                       || Case When :P652_OUTTYPE Is Not Null Or :P652_GROUP Is Not Null Then '&mdash;'
                               Else to_char(Round(InQ-OutQ,1),'FM999G999G990D0') || '<i>MT</i>' End || '</div>'
                    || '<div class="ds-flow-s">'
                       || Case When :P652_OUTTYPE Is Not Null Or :P652_GROUP Is Not Null
                               Then 'Not valid while a classification filter narrows one side of the balance'
                               Else '<b>' || nvl(to_char(Round((InQ-OutQ)/nullif(InQ,0)*100,1),'FM990D0'),'0')
                                    || '%</b> of input charged' End || '</div></div>'
                  End As NODE
                From T Cross Join (Select Level Seq From dual Connect By Level <= 6) N
                Order By N.Seq
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_OUTTYPE
                P652_GROUP
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-flowwrap
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column NODE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Node
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region output-by-product (
        name: Output by product
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With O As (
                  Select f.ItemCode, i.ItemNatureCode Nat, i.ParentCode Grp,
                         Count(Distinct f.Tno) Txns,
                         Sum(f.Quantity1) MT,
                         Sum(s.Amount) Val
                    From Production p
                    Join ProductionFinished f On f.Tno = p.Tno
                    Join Item i On i.ItemCode = f.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                    Left Join Stock s On s.StockModuleCode = 'PRODUCTION'
                                     And s.StockModuleTno  = f.Tno
                                     And s.StockModuleSno  = f.Sno
                   Where p.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR')
                     And p.ProductionDate <  to_date(:P652_TO,'DD-MM-RRRR') + 1
                     And nvl(f.Quantity1,0) <> 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P652_PANEL    Is Null Or p.Panel        = :P652_PANEL)
                     And (:P652_COMPANY  Is Null Or p.CompanyCode  = :P652_COMPANY)
                     And (:P652_LOCATION Is Null Or p.LocationCode = :P652_LOCATION)
                     And (:P652_GROUP    Is Null Or i.ParentCode   = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)
                     And (:P652_OUTTYPE  Is Null Or
                          Case i.ItemNatureCode
                               When 'FINISHEDITEM'     Then 'FINISHED'
                               When 'SEMIFINISHEDITEM' Then 'SEMI'
                               When 'SUBSIDERY'        Then 'SUBSIDIARY'
                               When 'BYPRODUCT'        Then 'SUBSIDIARY'
                               When 'WASTE'            Then 'WASTE'
                               When 'SCRAP'            Then 'WASTE'
                               Else 'OTHER' End = :P652_OUTTYPE)
                   Group By f.ItemCode, i.ItemNatureCode, i.ParentCode)
                Select GetItemName(ItemCode) As PRODUCT,
                       GetItemName(Grp) As PRODUCT_GROUP,
                       '<span class="ds-pill ds-pill--' ||
                         Case Nat When 'FINISHEDITEM' Then 'good'
                                  When 'SEMIFINISHEDITEM' Then 'info'
                                  When 'WASTE' Then 'warn' When 'SCRAP' Then 'warn'
                                  Else 'muted' End || '">' ||
                         Case Nat When 'FINISHEDITEM'     Then 'Finished'
                                  When 'SEMIFINISHEDITEM' Then 'Semi-finished'
                                  When 'SUBSIDERY'        Then 'Subsidiary'
                                  When 'BYPRODUCT'        Then 'Subsidiary'
                                  When 'WASTE'            Then 'Waste'
                                  When 'SCRAP'            Then 'Waste'
                                  Else apex_escape.html(nvl(Nat,'Unclassified')) End
                       || '</span>' As OUT_TYPE,
                       to_char(Txns,'FM999G990') As TXNS,
                       to_char(Round(MT,1),'FM999G999G990D0') As QTY_QTL,
                       /* Share of period output, with the bar drawn to the
                          same number — one column, not a number plus a
                          separate bar scaled to a different denominator. */
                       '<span class="ds-sharecell"><b>'
                         || to_char(Round(MT/nullif(Sum(MT) Over (),0)*100,1),'FM990D0') || ' %</b>'
                         || '<span class="ds-bar ds-bar--'
                         || Case When Nat In ('SUBSIDERY','BYPRODUCT') Then 'amber'
                                 When Nat In ('WASTE','SCRAP') Then 'red' Else 'gold' End
                         || '"><i style="width:'
                         || to_char(Round(MT/nullif(Sum(MT) Over (),0)*100,0),'FM990')
                         || '%"></i></span></span>' As SHARE_OF_OUTPUT,
                       Case When Val Is Null Then '<span class="ds-pill ds-pill--muted">not valued</span>'
                            Else to_char(Round(Val/100000,1),'FM999G999G990D0') End As VALUE_LAKH
                From O Order By MT Desc Fetch First 12 Rows Only
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_OUTTYPE
                P652_GROUP
            ]
        }
        layout {
            sequence: 70
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No output was posted in this period for the selected scope.
        }

        column OUT_TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Output type
            }
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
        )

        column PRODUCT (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Product
            }
            layout {
                sequence: 10
            }
        )

        column PRODUCT_GROUP (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Group
            }
            layout {
                sequence: 20
            }
        )

        column QTY_QTL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Quantity (MT)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

        column SHARE_OF_OUTPUT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Share of output
            }
            layout {
                sequence: 60
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TXNS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Txns
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

