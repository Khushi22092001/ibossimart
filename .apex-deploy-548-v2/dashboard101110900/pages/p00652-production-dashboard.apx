            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Value (Rs lakh)
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

