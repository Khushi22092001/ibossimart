page 652 (
    name: Production Dashboard
    alias: PRODUCTION-DASHBOARD
    title: Production Command Centre
    pageGroup: @production-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region chart-mix (
        name: Output mix by type
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Case i.ItemNatureCode
                            When 'FINISHEDITEM'     Then 'Finished'
                            When 'SEMIFINISHEDITEM' Then 'Semi-finished'
                            When 'SUBSIDERY'        Then 'Subsidiary'
                            When 'BYPRODUCT'        Then 'Subsidiary'
                            When 'WASTE'            Then 'Waste'
                            When 'SCRAP'            Then 'Waste'
                            Else 'Unclassified' End As OUT_TYPE,
                       Round(Sum(f.Quantity1),1) As QTY_QTL
                  From Production p
                  Join ProductionFinished f On f.Tno = p.Tno
                  Join Item i On i.ItemCode = f.ItemCode
                  Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                 Where p.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR')
                   And p.ProductionDate <  to_date(:P652_TO,'DD-MM-RRRR') + 1
                   And nvl(f.Quantity1,0) > 0
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P652_PANEL    Is Null Or p.Panel        = :P652_PANEL)
                   And (:P652_COMPANY  Is Null Or p.CompanyCode  = :P652_COMPANY)
                   And (:P652_LOCATION Is Null Or p.LocationCode = :P652_LOCATION)
                   And (:P652_GROUP    Is Null Or i.ParentCode   = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)
                 Group By i.ItemNatureCode
                 Order By 2 Desc
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_GROUP
            ]
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-chart
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 320
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No output was posted in this period for the selected scope.
        }

        series output-type (
            name: Output by type (MT)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: OUT_TYPE
                value: QTY_QTL
            }
            label {
                show: true
            }
        )

    )

    region chart-trend (
        name: Daily consumption vs output
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With
                Txn As (
                  Select p.Tno, p.ProductionDate From Production p
                   Where p.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR')
                     And p.ProductionDate <  to_date(:P652_TO,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P652_PANEL    Is Null Or p.Panel        = :P652_PANEL)
                     And (:P652_COMPANY  Is Null Or p.CompanyCode  = :P652_COMPANY)
                     And (:P652_LOCATION Is Null Or p.LocationCode = :P652_LOCATION)),
                InpS As (
                  Select r.Tno, Sum(r.Quantity1) InQty
                    From ProductionRaw r
                    Join Item i On i.ItemCode = r.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)
                   Group By r.Tno),
                OutD As (
                  Select f.Tno,
                         Case i.ItemNatureCode
                              When 'FINISHEDITEM'     Then 'FINISHED'
                              When 'SEMIFINISHEDITEM' Then 'SEMI'
                              When 'SUBSIDERY'        Then 'SUBSIDIARY'
                              When 'BYPRODUCT'        Then 'SUBSIDIARY'
                              When 'WASTE'            Then 'WASTE'
                              When 'SCRAP'            Then 'WASTE'
                              Else 'OTHER' End OutType,
                         f.Quantity1 MT
                    From ProductionFinished f
                    Join Item i On i.ItemCode = f.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)),
                OutS As (
                  Select Tno, Sum(MT) OutQty From OutD
                   Where (:P652_OUTTYPE Is Null Or OutType = :P652_OUTTYPE) Group By Tno)
                Select to_char(t.ProductionDate,'DD Mon') As DAY_LBL,
                       Round(nvl(Sum(i.InQty),0),1)  As INPUT_QTL,
                       Round(nvl(Sum(o.OutQty),0),1) As OUTPUT_QTL
                  From Txn t
                  Left Join InpS i On i.Tno = t.Tno
                  Left Join OutS o On o.Tno = t.Tno
                 Group By t.ProductionDate
                 Order By t.ProductionDate
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_OUTTYPE
                P652_GROUP
            ]
        }
        layout {
            sequence: 45
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-chart
            ]
        }
        chartLayout {
            height: 320
        }
        legend {
            position: top
        }
        messages {
            whenNoDataFound: No production was posted in this period for the selected scope.
        }

        series input-consumed (
            name: Material consumed (MT)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: DAY_LBL
                value: INPUT_QTL
            }
        )

        series output-produced (
            name: Output produced (MT)
            execution {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: DAY_LBL
                value: OUTPUT_QTL
            }
        )

        axis x (
            name: x
            title: Production date
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: MT
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: thousand
            }
            minorTicks {
                show: false
            }
        )

    )

    region coverage-note (
        name: Coverage notes
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-note">
                  <span class="fa fa-info-circle"></span>
                  <span><b>Not shown, and why.</b>
                  <b>Costing basis</b> &mdash; the production raw lines hold no value of their own, so input is costed
                  at each item&rsquo;s weighted-average stock rate (stock value &divide; quantity &mdash; the ERP&rsquo;s
                  own valuation). Input cost, output value and gross margin are shown in the Production economics strip on
                  that basis; it is a stock-valuation rate, not a per-lot GRN cost.
                  <b>Plan vs actual</b> &mdash; this ERP records continuous-process production without orders or work
                  orders, and every production-plan table in the schema is empty, so no target or achievement
                  percentage is displayed.
                  <b>Waste</b> &mdash; the item master defines WASTE and SCRAP but no output line uses either yet; the
                  node is shown dormant rather than as a measured zero.
                  <b>Quality</b> &mdash; quality results are not linked to a production transaction.
                  <b>Machine, batch and process</b> &mdash; those columns exist on the transaction but are unpopulated
                  (batch 0%, process 0%, equipment 0%), so they are not offered as analysis dimensions. Shift is
                  populated and is shown per transaction.</span>
                </div>
                ```
        }
        layout {
            sequence: 90
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-noteregion
                ds-noteregion--standalone
            ]
        }
    )

    region dash-header (
        name: Production Command Centre
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Fx As (
                  Select Max(p.ProductionDate) LastPost,
                         Count(Case When p.Panel = 'B' Then 1 End) BRuns
                    From Production p
                   Where ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual)))
                Select '<div class="ds-prod-head">'
                    || '<div class="ds-prod-eyebrow">Operations &middot; Production</div>'
                    || '<h1 class="ds-prod-title">Production Command Centre</h1>'
                    || '<p class="ds-prod-sub">Actual raw-material consumption against actual output &mdash; '
                    || 'finished, semi-finished, subsidiary and waste &mdash; for every producing location. '
                    || 'Input and output are aggregated separately per transaction, then reconciled, so no '
                    || 'quantity is ever multiplied by a one-to-many join.</p>'
                    || '<div class="ds-prod-context">'
                    || '<span class="ds-prod-chip"><span class="fa fa-calendar"></span>Period <b>'
                       || to_char(to_date(:P652_FROM,'DD-MM-RRRR'),'DD Mon RRRR') || ' &ndash; '
                       || to_char(to_date(:P652_TO,'DD-MM-RRRR'),'DD Mon RRRR') || '</b> <small>('
                       || to_char(to_date(:P652_TO,'DD-MM-RRRR') - to_date(:P652_FROM,'DD-MM-RRRR') + 1)
                       || ' days)</small></span>'
                    || '<span class="ds-prod-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl(GetCompanyName(:P652_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-prod-chip"><span class="fa fa-industry"></span>Location <b>'
                       || apex_escape.html(nvl(GetLocationName(:P652_LOCATION),'All locations')) || '</b></span>'
                    || Case When :P652_OUTTYPE Is Not Null
                            Then '<span class="ds-prod-chip"><span class="fa fa-filter"></span>Output type <b>'
                                 || Case :P652_OUTTYPE When 'FINISHED' Then 'Finished'
                                         When 'SEMI' Then 'Semi-finished'
                                         When 'SUBSIDIARY' Then 'Subsidiary'
                                         When 'WASTE' Then 'Waste' Else 'Other' End || '</b></span>' End
                    || Case When :P652_GROUP Is Not Null
                            Then '<span class="ds-prod-chip"><span class="fa fa-sitemap"></span>Group <b>'
                                 || apex_escape.html(GetItemName(:P652_GROUP)) || '</b></span>' End
                    || '<span class="ds-prod-chip ds-prod-chip--panel"><span class="fa fa-th-large"></span>Panel <b>'
                       || nvl(:P652_PANEL,'A + B') || '</b>'
                       || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                               Then ' <small>&middot; your login is entitled to panel ' || (Select GetUserPanelAB_apex() From dual)
                                    || ' only</small>' End
                       || '</span>'
                    || '<span class="ds-prod-chip ds-prod-chip--live"><span class="fa fa-bolt"></span>'
                       || 'Live ledger &middot; last posting <b>'
                       || nvl(to_char(Fx.LastPost,'DD Mon RRRR'),'none') || '</b></span>'
                    || Case When Fx.BRuns = 0 And nvl(:P652_PANEL,'A') <> 'A'
                            Then '<span class="ds-prod-chip ds-prod-chip--warn">'
                                 || '<span class="fa fa-exclamation-triangle"></span>'
                                 || 'No Panel&nbsp;B production has ever been posted &mdash; '
                                 || '<b>Panel B is empty by data, not by filter</b></span>' End
                    || '</div></div>' As HEAD
                From Fx
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_OUTTYPE
                P652_GROUP
            ]
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-prod-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: " "
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region filter-drawer (
        name: Advanced Filters
        type: staticContent
        layout {
            sequence: 12
            slot: body
        }
        appearance {
            template: @/inline-drawer
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: [
                ds-filterdrawer
                js-dialog-class-t-Drawer--pullOutEnd
            ]
        }
        advanced {
            htmlDomId: p652Drawer
        }
    )

    region flow-note (
        name: Material balance notes
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-note">
                  <span class="fa fa-info-circle"></span>
                  <span><b>Basis of the balance.</b> Every producing item here is stocked in a single unit &mdash;
                  <b>MT (metric tonnes)</b> &mdash; so input and output are directly comparable and are differenced
                  as posted, with no unit conversion in between. <b>Unaccounted</b> mixes genuine process loss
                  (moisture, dust, handling) with output that was never booked, which is why it is not labelled
                  loss &mdash; process loss is not recorded as a separate transaction anywhere in this ERP.
                  Selecting an <b>output type</b> or a <b>group</b> narrows one side of the balance only, so the
                  balance and the output/input ratio are suppressed while either is active rather than shown as a misleading figure.</span>
                </div>
                ```
        }
        layout {
            sequence: 35
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-noteregion
                ds-noteregion--standalone
            ]
        }
    )

    region kpi-strip (
        name: Production Snapshot
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With
                Txn As (
                  Select p.Tno, p.ProductionDate
                    From Production p
                   Where p.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR') -
                         (to_date(:P652_TO,'DD-MM-RRRR') - to_date(:P652_FROM,'DD-MM-RRRR') + 1)
                     And p.ProductionDate <  to_date(:P652_TO,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P652_PANEL    Is Null Or p.Panel        = :P652_PANEL)
                     And (:P652_COMPANY  Is Null Or p.CompanyCode  = :P652_COMPANY)
                     And (:P652_LOCATION Is Null Or p.LocationCode = :P652_LOCATION)),
                InpS As (
                  Select r.Tno, Sum(r.Quantity1) InQty
                    From ProductionRaw r
                    Join Item i On i.ItemCode = r.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)
                   Group By r.Tno),
                OutD As (
                  Select f.Tno,
                         Case i.ItemNatureCode
                              When 'FINISHEDITEM'     Then 'FINISHED'
                              When 'SEMIFINISHEDITEM' Then 'SEMI'
                              When 'SUBSIDERY'        Then 'SUBSIDIARY'
                              When 'BYPRODUCT'        Then 'SUBSIDIARY'
                              When 'WASTE'            Then 'WASTE'
                              When 'SCRAP'            Then 'WASTE'
                              Else 'OTHER' End OutType,
                         f.Quantity1 MT,
                         s.Amount Val
                    From ProductionFinished f
                    Join Item i On i.ItemCode = f.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                    Left Join Stock s On s.StockModuleCode = 'PRODUCTION'
                                     And s.StockModuleTno  = f.Tno
                                     And s.StockModuleSno  = f.Sno
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)),
                OutS As (
                  Select Tno, Sum(MT) OutQty,
                         Sum(Case When OutType='FINISHED' Then MT End) FinQ,
                         Sum(Case When OutType='WASTE'    Then MT End) WasteQ,
                         Sum(Val) OutVal, Count(*) OutLines, Count(Val) ValuedLines
                    From OutD
                   Where (:P652_OUTTYPE Is Null Or OutType = :P652_OUTTYPE)
                   Group By Tno),
                Fact As (
                  Select t.Tno, t.ProductionDate,
                         Case When t.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR') Then 'C' Else 'P' End Bkt,
                         nvl(i.InQty,0) InQty, nvl(o.OutQty,0) OutQty, nvl(o.FinQ,0) FinQ,
                         nvl(o.WasteQ,0) WasteQ, nvl(o.OutVal,0) OutVal,
                         nvl(o.OutLines,0) OutLines, nvl(o.ValuedLines,0) ValuedLines
                    From Txn t
                    Left Join InpS i On i.Tno = t.Tno
                    Left Join OutS o On o.Tno = t.Tno),
                /* Bare aggregate, no GROUP BY: always exactly one row, so an
                   empty period renders honest zeros instead of "no data". */
                Ag As (
                  Select nvl(Sum(Case When Bkt='C' Then InQty  End),0) InC,
                         nvl(Sum(Case When Bkt='P' Then InQty  End),0) InP,
                         nvl(Sum(Case When Bkt='C' Then OutQty End),0) OutC,
                         nvl(Sum(Case When Bkt='P' Then OutQty End),0) OutP,
                         nvl(Sum(Case When Bkt='C' Then FinQ   End),0) FinC,
                         nvl(Sum(Case When Bkt='C' Then WasteQ End),0) WasteC,
                         nvl(Sum(Case When Bkt='C' Then OutVal End),0) ValC,
                         nvl(Sum(Case When Bkt='C' Then OutLines End),0) LinesC,
                         nvl(Sum(Case When Bkt='C' Then ValuedLines End),0) ValLinesC,
                         Count(Case When Bkt='C' Then 1 End) TxnC,
                         Count(Case When Bkt='P' Then 1 End) TxnP,
                         Count(Distinct Case When Bkt='C' Then trunc(ProductionDate) End) DaysC
                    From Fact),
                Dy As (Select trunc(ProductionDate) D, Sum(OutQty) Q
                         From Fact Where Bkt='C' Group By trunc(ProductionDate)),
                Sk As (Select D, Q, Count(*) Over () N, Row_Number() Over (Order By D) - 1 R,
                              Max(Q) Over () Mx, Min(Q) Over () Mn From Dy),
                Sp As (
                  Select 'M ' || listagg(to_char(Round(Case When N > 1 Then R*100/(N-1) Else 50 End,1)) || ' ' ||
                                to_char(Round(24 - Case When Mx > Mn Then (Q-Mn)/(Mx-Mn)*21 Else 10.5 End,1)), ' L ')
                         within group (order by R) Pth, Count(*) Pts From Sk),
                M As (
                  Select Ag.*, Sp.Pth, Sp.Pts,
                         Round(OutC/nullif(InC,0)*100,1)    RatioC,
                         Round(OutP/nullif(InP,0)*100,1)    RatioP,
                         Round(FinC/nullif(OutC,0)*100,1)   FinPct,
                         Round(WasteC/nullif(OutC,0)*100,1) WastePct,
                         InC - OutC                         BalC,
                         Case When :P652_OUTTYPE Is Not Null Or :P652_GROUP Is Not Null
                              Then 1 Else 0 End                Filt,
                         'f?p=' || :APP_ID || ':499:' || :APP_SESSION || '::NO:499:'
                            || 'P499_FROMDATE,P499_TODATE,P499_COMPANY,P499_LOCATION:'
                            || :P652_FROM || ',' || :P652_TO || ',' || :P652_COMPANY || ',' || :P652_LOCATION Reg,
                         'f?p=' || :APP_ID || ':201:' || :APP_SESSION || '::NO:201:'
                            || 'P201_FROMDATE,P201_TODATE,P201_COMPANY,P201_LOCATION:'
                            || :P652_FROM || ',' || :P652_TO || ',' || :P652_COMPANY || ',' || :P652_LOCATION Cons
                    From Ag, Sp)
                Select Case S.Seq
                  /* KPI 1 — total actual raw-material consumption */
                  When 1 Then
                    '<a class="ds-kpi ds-kpi--input ds-kpi--link" href="' || APEX_UTIL.PREPARE_URL(Cons) || '"'
                    || ' title="Actual raw-material consumption for the period. Aggregated per transaction first, then summed, and converted to quintals using each item''s own master factor.">'
                    || '<span class="ds-kpi-ic fa fa-sign-in"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Total Input Consumed</div>'
                    || '<div class="ds-kpi-n">' || to_char(InC,'FM999G999G990D0') || '<i>MT</i></div>'
                    || Case When InP > 0 Then
                         '<span class="ds-delta ds-delta--' || Case When InC >= InP Then 'up' Else 'down' End || '">'
                         || Case When InC >= InP Then '&#9650; ' Else '&#9660; ' End
                         || to_char(Round(abs(InC-InP)/InP*100,1),'FM990D0') || '%<small>vs prev period</small></span>'
                       Else '<span class="ds-delta ds-delta--flat">no prior period</span>' End
                    || '</div></a>'
                  /* KPI 2 — total actual output, all classes */
                  When 2 Then
                    '<a class="ds-kpi ds-kpi--output ds-kpi--link" href="' || APEX_UTIL.PREPARE_URL(Reg) || '"'
                    || ' title="Actual production output for the period across every output class, reported in MT.">'
                    || '<span class="ds-kpi-ic fa fa-sign-out"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Total Output</div>'
                    || '<div class="ds-kpi-n">' || to_char(OutC,'FM999G999G990D0') || '<i>MT</i></div>'
                    || Case When OutP > 0 Then
                         '<span class="ds-delta ds-delta--' || Case When OutC >= OutP Then 'up' Else 'down' End || '">'
                         || Case When OutC >= OutP Then '&#9650; ' Else '&#9660; ' End
                         || to_char(Round(abs(OutC-OutP)/OutP*100,1),'FM990D0') || '%<small>vs prev period</small></span>'
                       Else '<span class="ds-delta ds-delta--flat">no prior period</span>' End
                    || Case When Pts > 1 Then
                         '<svg class="ds-spark" viewBox="0 0 100 26" preserveAspectRatio="none" aria-hidden="true">'
                         || '<path class="ds-spark-line" d="' || Pth || '"/></svg>' End
                    || '</div></a>'
                  /* KPI 7 — output to input ratio, weighted */
                  When 3 Then
                    '<div class="ds-kpi ds-kpi--rec"'
                    || ' title="Total output divided by total input for the whole selection at once. Percentages are never averaged: A+B divides combined output by combined input.">'
                    || '<span class="ds-kpi-ic fa fa-exchange"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Output / Input Ratio</div>'
                    || '<div class="ds-kpi-n">' || nvl(to_char(RatioC,'FM990D0'),'&mdash;') || '<i>%</i></div>'
                    || Case When RatioP Is Not Null And RatioC Is Not Null Then
                         '<span class="ds-delta ds-delta--' || Case When RatioC >= RatioP Then 'up' Else 'down' End || '">'
                         || Case When RatioC >= RatioP Then '&#9650; ' Else '&#9660; ' End
                         || to_char(Round(abs(RatioC-RatioP),1),'FM990D0') || ' pp<small>vs prev period</small></span>'
                       Else '<span class="ds-delta ds-delta--flat">no comparison</span>' End
                    || '<div class="ds-kpi-sub">'
                       || Case When Filt = 1
                               Then 'Partial scope &mdash; a classification filter is active, so this is not the plant ratio'
                               Else 'Input and output both in MT' End || '</div>'
                    || '</div></div>'
                  /* KPI 8 — finished share of output */
                  When 4 Then
                    '<div class="ds-kpi ds-kpi--yield"'
                    || ' title="Finished output divided by total output. Shows how much of what the process produced is finished product rather than semi-finished, subsidiary or waste.">'
                    || '<span class="ds-kpi-ic fa fa-cube"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Finished Share of Output</div>'
                    || '<div class="ds-kpi-n">' || nvl(to_char(FinPct,'FM990D0'),'&mdash;') || '<i>%</i></div>'
                    || '<div class="ds-kpi-sub">Finished <b>' || to_char(FinC,'FM999G999G990D0') || '</b> MT'
                       || ' of <b>' || to_char(OutC,'FM999G999G990D0') || '</b> MT</div>'
                    || '</div></div>'
                  /* KPI 9 — waste share of output */
                  When 5 Then
                    '<div class="ds-kpi ds-kpi--loss"'
                    || ' title="Waste output divided by total output. The ItemNature master defines WASTE and SCRAP, but no output line currently uses either, so this reads zero because the classification is unused - not because waste was measured as nil.">'
                    || '<span class="ds-kpi-ic fa fa-trash-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Waste Share of Output</div>'
                    || '<div class="ds-kpi-n">' || nvl(to_char(WastePct,'FM990D0'),'0') || '<i>%</i></div>'
                    || '<div class="ds-kpi-sub">'
                       || Case When WasteC = 0
                               Then 'No output line classified WASTE or SCRAP'
                               Else '<b>' || to_char(WasteC,'FM999G999G990D0') || '</b> MT booked as waste' End
                       || '</div>'
                    || '</div></div>'
                  /* KPI 10 — material balance difference */
                  When 6 Then
                    '<div class="ds-kpi ds-kpi--exc' || Case When BalC <> 0 And Filt = 0 Then ' is-hot' End || '"'
                    || ' title="Input minus the sum of all output classes, computed directly in MT. Covers genuine process loss and any unrecorded output, so it is not labelled loss.">'
                    || '<span class="ds-kpi-ic fa fa-balance-scale"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Material Balance Difference</div>'
                    || '<div class="ds-kpi-n">'
                       || Case When Filt = 1 Then '&mdash;'
                               Else to_char(BalC,'FM999G999G990D0') || '<i>MT</i>' End || '</div>'
                    || '<div class="ds-kpi-sub">'
                       || Case When Filt = 1
                               Then 'Not computed while an output-type or group filter is active &mdash; '
                                    || 'a balance is only valid over the whole charge'
                               Else '<b>' || nvl(to_char(Round(BalC/nullif(InC,0)*100,1),'FM990D0'),'0')
                                    || '%</b> of input charged' End || '</div>'
                    || '</div></div>'
                  /* KPI 11 — production value, output side only */
                  When 7 Then
                    '<div class="ds-kpi ds-kpi--disp"'
                    || ' title="Value of actual output, taken from the Stock ledger row each output line posts. Input material value is not available in this ERP, so no cost or margin is shown.">'
                    || '<span class="ds-kpi-ic fa fa-inr"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Production Value &middot; Output</div>'
                    || '<div class="ds-kpi-n">' || to_char(Round(ValC/100000,1),'FM999G999G990D0')
                       || '<i>&#8377; lakh</i></div>'
                    || '<div class="ds-kpi-sub">Valued <b>' || to_char(ValLinesC) || '</b> of <b>'
                       || to_char(LinesC) || '</b> output lines</div>'
                    || '</div></div>'
                  /* Throughput context */
                  When 8 Then
                    '<a class="ds-kpi ds-kpi--runs ds-kpi--link" href="' || APEX_UTIL.PREPARE_URL(Reg) || '"'
                    || ' title="Distinct production transactions in the period, the number of days on which any were posted, and mean output per active day.">'
                    || '<span class="ds-kpi-ic fa fa-list-ol"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Production Transactions</div>'
                    || '<div class="ds-kpi-n">' || to_char(TxnC,'FM999G990') || '<i>txns</i></div>'
                    || '<div class="ds-kpi-sub"><b>' || to_char(DaysC) || '</b> active days &middot; avg <b>'
                       || nvl(to_char(Round(OutC/nullif(DaysC,0),0),'FM999G999G990'),'0') || '</b> MT/day</div>'
                    || '</div></a>'
                  End As CARD
                From M Cross Join (Select Level Seq From dual Connect By Level <= 8) S
                Order By S.Seq
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_OUTTYPE
                P652_GROUP
            ]
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Card
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region location-analysis (
        name: Consumption and output by location
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With
                Txn As (
                  Select p.Tno, p.CompanyCode, p.LocationCode From Production p
                   Where p.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR')
                     And p.ProductionDate <  to_date(:P652_TO,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P652_PANEL    Is Null Or p.Panel        = :P652_PANEL)
                     And (:P652_COMPANY  Is Null Or p.CompanyCode  = :P652_COMPANY)
                     And (:P652_LOCATION Is Null Or p.LocationCode = :P652_LOCATION)),
                InpS As (
                  Select r.Tno, Sum(r.Quantity1) InQty
                    From ProductionRaw r
                    Join Item i On i.ItemCode = r.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)
                   Group By r.Tno),
                OutD As (
                  Select f.Tno,
                         Case i.ItemNatureCode
                              When 'FINISHEDITEM'     Then 'FINISHED'
                              When 'SEMIFINISHEDITEM' Then 'SEMI'
                              When 'SUBSIDERY'        Then 'SUBSIDIARY'
                              When 'BYPRODUCT'        Then 'SUBSIDIARY'
                              When 'WASTE'            Then 'WASTE'
                              When 'SCRAP'            Then 'WASTE'
                              Else 'OTHER' End OutType,
                         f.Quantity1 MT,
                         s.Amount Val
                    From ProductionFinished f
                    Join Item i On i.ItemCode = f.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                    Left Join Stock s On s.StockModuleCode = 'PRODUCTION'
                                     And s.StockModuleTno  = f.Tno
                                     And s.StockModuleSno  = f.Sno
                   Where (:P652_GROUP Is Null Or i.ParentCode = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)),
                OutS As (
                  Select Tno, Sum(MT) OutQty,
                         Sum(Case When OutType='FINISHED'   Then MT End) FinQ,
                         Sum(Case When OutType='SEMI'       Then MT End) SemiQ,
                         Sum(Case When OutType='SUBSIDIARY' Then MT End) SubQ,
                         Sum(Case When OutType='WASTE'      Then MT End) WasteQ,
                         Sum(Val) OutVal
                    From OutD
                   Where (:P652_OUTTYPE Is Null Or OutType = :P652_OUTTYPE)
                   Group By Tno),
                Fact As (
                  Select t.CompanyCode, t.LocationCode, t.Tno,
                         nvl(i.InQty,0) InQty, nvl(o.OutQty,0) OutQty, nvl(o.FinQ,0) FinQ,
                         nvl(o.SemiQ,0) SemiQ, nvl(o.SubQ,0) SubQ, nvl(o.WasteQ,0) WasteQ,
                         nvl(o.OutVal,0) OutVal
                    From Txn t
                    Left Join InpS i On i.Tno = t.Tno
                    Left Join OutS o On o.Tno = t.Tno),
                L As (
                  Select CompanyCode, LocationCode, Count(*) Txns,
                         Sum(InQty) InQ, Sum(OutQty) OutQ, Sum(FinQ) FinQ, Sum(SemiQ) SemiQ,
                         Sum(SubQ) SubQ, Sum(WasteQ) WasteQ, Sum(OutVal) OutVal
                    From Fact Group By CompanyCode, LocationCode),
                B As (Select L.*, Max(OutQ) Over () MaxOut From L),
                R As (
                  Select CompanyCode, LocationCode, Txns, InQ, OutQ, FinQ, SemiQ, SubQ, WasteQ,
                         OutVal, MaxOut, 0 IsTot From B
                  Union All
                  Select Null, Null, Sum(Txns), Sum(InQ), Sum(OutQ), Sum(FinQ), Sum(SemiQ), Sum(SubQ),
                         Sum(WasteQ), Sum(OutVal), Max(MaxOut), 1 From B)
                Select
                  Case When IsTot = 1 Then '<span class="ds-totalmark">All locations</span>'
                       Else '<a href="' || APEX_UTIL.PREPARE_URL(
                              'f?p=' || :APP_ID || ':499:' || :APP_SESSION || '::NO:499:'
                              || 'P499_FROMDATE,P499_TODATE,P499_COMPANY,P499_LOCATION:'
                              || :P652_FROM || ',' || :P652_TO || ',,' || LocationCode)
                            || '">' || apex_escape.html(GetLocationName(LocationCode))
                            || ' <span class="fa fa-angle-right"></span></a>' End As LOCATION,
                  Case When IsTot = 1 Then to_char(Count(*) Over () - 1) || ' locations'
                       Else apex_escape.html(GetCompanyName(CompanyCode)) End As COMPANY,
                  to_char(Txns,'FM999G990')                  As TXNS,
                  to_char(Round(InQ,1),'FM999G999G990D0')    As INPUT_QTL,
                  to_char(Round(FinQ,1),'FM999G999G990D0')   As FINISHED_QTL,
                  to_char(Round(SemiQ,1),'FM999G999G990D0')  As SEMI_QTL,
                  to_char(Round(SubQ,1),'FM999G999G990D0')   As SUBSIDIARY_QTL,
                  to_char(Round(WasteQ,1),'FM999G999G990D0') As WASTE_QTL,
                  to_char(Round(OutQ,1),'FM999G999G990D0')   As OUTPUT_QTL,
                  Case When :P652_OUTTYPE Is Not Null Or :P652_GROUP Is Not Null Then '&mdash;'
                       When InQ - OutQ < 0
                       Then '<span class="ds-neg">' || to_char(Round(InQ-OutQ,1),'FM999G999G990D0') || '</span>'
                       Else to_char(Round(InQ-OutQ,1),'FM999G999G990D0') End As BALANCE_QTL,
                  /* Thresholds are deliberate. Above 102% is physically
                     impossible and flagged; the alumina line sits near 40%
                     legitimately, so low reads neutral rather than red. */
                  Case When :P652_OUTTYPE Is Not Null Or :P652_GROUP Is Not Null
                       Then '<span class="ds-pill ds-pill--muted">partial</span>'
                       When InQ = 0 Then '&mdash;'
                       Else '<span class="ds-pill ds-pill--' ||
                            Case When Round(OutQ/InQ*100,1) > 102 Then 'bad'
                                 When Round(OutQ/InQ*100,1) >= 78 Then 'good'
                                 When Round(OutQ/InQ*100,1) >= 55 Then 'warn'
                                 Else 'muted' End
                            || '">' || to_char(Round(OutQ/InQ*100,1),'FM990D0') || '&nbsp;%</span>' End As RATIO,
                  to_char(Round(OutVal/100000,1),'FM999G999G990D0') As VALUE_LAKH,
                  '<span class="ds-bar ds-bar--gold"><i style="width:'
                     || Case When IsTot = 1 Then '100'
                             Else to_char(Round(OutQ/nullif(MaxOut,0)*100,0),'FM990') End
                     || '%"></i></span>' As OUTPUT_SHARE
                From R Order By IsTot, OutQ Desc
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_OUTTYPE
                P652_GROUP
            ]
        }
        layout {
            sequence: 60
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-recon
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No production was posted in this period for the selected scope.
        }

        column BALANCE_QTL (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Unaccounted
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
