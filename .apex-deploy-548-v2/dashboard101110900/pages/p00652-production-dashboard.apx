    region material-consumed (
        name: Raw material consumed
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With C As (
                  Select r.ItemCode, i.ItemNatureCode Nat, i.ParentCode Grp, i.MeasuringUnitCode1 Uom,
                         Count(Distinct r.Tno) Txns,
                         Sum(r.Quantity1) MT,
                         Sum(r.Quantity1) Native
                    From Production p
                    Join ProductionRaw r On r.Tno = p.Tno
                    Join Item i On i.ItemCode = r.ItemCode
                    Left Join MeasuringUnit mu On mu.MeasuringUnitCode = i.MeasuringUnitCode1
                   Where p.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR')
                     And p.ProductionDate <  to_date(:P652_TO,'DD-MM-RRRR') + 1
                     And nvl(r.Quantity1,0) <> 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P652_PANEL    Is Null Or p.Panel        = :P652_PANEL)
                     And (:P652_COMPANY  Is Null Or p.CompanyCode  = :P652_COMPANY)
                     And (:P652_LOCATION Is Null Or p.LocationCode = :P652_LOCATION)
                     And (:P652_GROUP    Is Null Or i.ParentCode   = :P652_GROUP)
                   And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)
                   Group By r.ItemCode, i.ItemNatureCode, i.ParentCode, i.MeasuringUnitCode1)
                Select GetItemName(ItemCode) As MATERIAL,
                       GetItemName(Grp) As MATERIAL_GROUP,
                       '<span class="ds-pill ds-pill--' || Case When Nat = 'RAWMATERIAL' Then 'info' Else 'muted' End
                         || '">' || Case When Nat = 'RAWMATERIAL' Then 'Raw material' Else 'Re-charged' End
                         || '</span>' As STREAM,
                       to_char(Txns,'FM999G990') As TXNS,
                       to_char(Round(Native,1),'FM999G999G990D0') || ' '
                         || nvl(GetMeasuringUnitName(Uom), nvl(Uom,'?')) As NATIVE_QTY,
                       to_char(Round(MT,1),'FM999G999G990D0') As QTY_QTL,
                       '<span class="ds-sharecell"><b>'
                         || to_char(Round(MT/nullif(Sum(MT) Over (),0)*100,1),'FM990D0') || ' %</b>'
                         || '<span class="ds-bar ds-bar--blue"><i style="width:'
                         || to_char(Round(MT/nullif(Sum(MT) Over (),0)*100,0),'FM990')
                         || '%"></i></span></span>' As SHARE_OF_OUTPUT
                From C Order By MT Desc Fetch First 12 Rows Only
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_GROUP
            ]
        }
