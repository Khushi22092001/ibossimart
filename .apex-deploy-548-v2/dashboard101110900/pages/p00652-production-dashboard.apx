            affectedElements {
                selectionType: region
                region: @chart-trend
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action refresh-txns (
            action: refresh
            affectedElements {
                selectionType: region
                region: @txn-register
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
        )

    )

