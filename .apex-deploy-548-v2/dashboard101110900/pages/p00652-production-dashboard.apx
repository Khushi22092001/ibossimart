    region prod-economics (
        name: Production economics
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Rate As (
                       Select ItemCode, Sum(Amount)/nullif(Sum(StockQuantity1),0) Rt
                         From Stock Group By ItemCode),
                     Txn As (
                       Select p.Tno From Production p
                        Where p.ProductionDate >= to_date(:P652_FROM,'DD-MM-RRRR')
                          And p.ProductionDate <  to_date(:P652_TO,'DD-MM-RRRR') + 1
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (:P652_PANEL    Is Null Or p.Panel        = :P652_PANEL)
                          And (:P652_COMPANY  Is Null Or p.CompanyCode  = :P652_COMPANY)
                          And (:P652_LOCATION Is Null Or p.LocationCode = :P652_LOCATION)),
                     Inp As (
                       Select Sum(r.Quantity1 * rt.Rt) Cost, Count(*) Lines, Count(rt.Rt) Rated
                         From ProductionRaw r
                         Join Txn t On t.Tno = r.Tno
                         Left Join Item i On i.ItemCode = r.ItemCode
                         Left Join Rate rt On rt.ItemCode = r.ItemCode
                        Where (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)),
                     Outp As (
                       Select Sum(f.Quantity1) Qty, Sum(f.Quantity1 * rt.Rt) Val
                         From ProductionFinished f
                         Join Txn t On t.Tno = f.Tno
                         Left Join Item i On i.ItemCode = f.ItemCode
                         Left Join Rate rt On rt.ItemCode = f.ItemCode
                        Where nvl(f.Quantity1,0) > 0
                          And (:P652_CATEGORY Is Null Or i.ItemCategoryCode = :P652_CATEGORY)),
                     Ag As (
                       Select nvl(i.Cost,0) InCost, nvl(o.Val,0) OutVal, nvl(o.Qty,0) OutQty,
                              nvl(i.Lines,0) Lines, nvl(i.Rated,0) Rated
                         From Inp i Cross Join Outp o)
                Select '<div class="ds-kpi ds-kpi--input"><span class="ds-kpi-ic fa fa-sign-in"></span>'
                    || '<div class="ds-kpi-body"><div class="ds-kpi-t">Input material cost</div>'
                    || '<div class="ds-kpi-n">&#8377;'
                    || Case When InCost >= 10000000 Then to_char(InCost/10000000,'FM9G99G990D00')||'<i> Cr</i>'
                            When InCost >= 100000   Then to_char(InCost/100000,'FM99G990D00')||'<i> L</i>'
                            Else to_char(round(InCost),'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">valued at stock rate &middot; '
                    || Case When Lines>0 Then to_char(round(Rated*100/Lines))||'% of lines rated' Else 'no consumption' End
                    || '</div></div></div>' As KPI1,
                       '<div class="ds-kpi ds-kpi--disp"><span class="ds-kpi-ic fa fa-sign-out"></span>'
                    || '<div class="ds-kpi-body"><div class="ds-kpi-t">Output value</div>'
                    || '<div class="ds-kpi-n">&#8377;'
                    || Case When OutVal >= 10000000 Then to_char(OutVal/10000000,'FM9G99G990D00')||'<i> Cr</i>'
                            When OutVal >= 100000   Then to_char(OutVal/100000,'FM99G990D00')||'<i> L</i>'
                            Else to_char(round(OutVal),'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">finished + semi + subsidiary, at stock rate</div></div></div>' As KPI2,
                       '<div class="ds-kpi ' || Case When OutVal-InCost < 0 Then 'ds-kpi--loss' Else 'ds-kpi--yield' End || '">'
                    || '<span class="ds-kpi-ic fa fa-balance-scale"></span>'
                    || '<div class="ds-kpi-body"><div class="ds-kpi-t">Gross margin</div>'
                    || '<div class="ds-kpi-n">&#8377;'
                    || Case When abs(OutVal-InCost) >= 10000000 Then to_char((OutVal-InCost)/10000000,'FM9G990D00')||'<i> Cr</i>'
                            When abs(OutVal-InCost) >= 100000   Then to_char((OutVal-InCost)/100000,'FM99G990D00')||'<i> L</i>'
                            Else to_char(round(OutVal-InCost),'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">output value &minus; input cost'
                    || Case When InCost>0 Then ' &middot; ' || to_char(round((OutVal-InCost)*100/InCost,1)) || '%' Else '' End
                    || '</div></div></div>' As KPI3,
                       '<div class="ds-kpi ds-kpi--rec"><span class="ds-kpi-ic fa fa-inr"></span>'
                    || '<div class="ds-kpi-body"><div class="ds-kpi-t">Input cost per MT of output</div>'
                    || '<div class="ds-kpi-n">&#8377;'
                    || Case When OutQty>0 Then to_char(round(InCost/OutQty),'FM99G99G990') Else '&mdash;' End || '</div>'
                    || '<div class="ds-kpi-sub">' || to_char(round(OutQty,1)) || ' MT produced</div></div></div>' As KPI4
                From Ag
                ```
            pageItemsToSubmit: [
                P652_FROM
                P652_TO
                P652_COMPANY
                P652_LOCATION
                P652_PANEL
                P652_CATEGORY
            ]
        }
        layout {
            sequence: 23
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: " "
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI2 (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: " "
            }
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI3 (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: " "
            }
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI4 (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: " "
            }
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

