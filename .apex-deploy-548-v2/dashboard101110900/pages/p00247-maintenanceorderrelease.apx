page 247 (
    name: MaintenanceOrderRelease
    alias: MAINTENANCEORDERRELEASE
    title: MaintenanceOrderRelease
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenance-order-release (
        name: Maintenance Order Release
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
    )

    region master (
        name: Master
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                row_number() over(order by a.maintenanceorderreleasedate) SerialNo,
                l.locationname,
                b.doctypename,
                C.COMPANYNAME,
                a.maintenanceorderreleasedate,
                a.maintenanceorderreleaserno,
                e.equipmentmaintenanceorderno,
                eq.equipmentname,
                a.Remark
                FROM MAINTENANCEORDERRELEASE a,doctype b,location l,EQUIPMENTMAINTENANCEORDER E,COMPANY C,equipment eq
                where a.doctypecode = b.doctypecode(+)
                and a.locationcode = l.locationcode(+)
                and a.equipmentmaintenanceordertno = e.tno(+)
                and e.equipmenttno = eq.tno(+)
                and a.maintenanceorderreleasedate between :P247_FROMDATE and :P247_TODATE
                and ( :P247_DOCTYPE IS NULL OR instr(':'||:P247_DOCTYPE||':',':'||B.DocTypeCode||':') > 0 ) 
                and (:P247_LOCATION IS NULL OR instr(':'||:P247_LOCATION||':',':'||L.locationcode||':') > 0)
                and (instr(':'||:P247_COMPANY||':',':'||C.COMPANYCODE||':') > 0 ) 
                and (:P247_ORDERNO IS NULL OR instr(':'||:P247_ORDERNO||':',':'||e.equipmentmaintenanceorderno||':') > 0 )
                and (:P247_EQUIPMENTNAME IS NULL OR instr(':'||:P247_EQUIPMENTNAME||':',':'||eq.equipmentname||':') > 0 )
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                
                
                
                
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 5018093985330518
        }

        savedReport 51904 (
