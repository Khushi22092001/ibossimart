    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 10
            region: @maintenance-report
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
