page 373 (
    name: Service Bill Summary For Partywise
    alias: SERVICE-BILL-SUMMARY-FOR-PARTYWISE
    title: Service Bill Summary For Partywise
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  
                    row_number() over(order by a.ServiceBillDate) SerialNo,
                    a.ServiceBillNo,
                    a.ServiceBillDate,
                    d.Quantity1 as DOQuantity,
                    c.WorkOrderNo,
                    e.AllotmentSchemeName,
                    f.PartyName,
                    c.PartyDoNo,
                    a.FromDate || ' to ' || a.ToDate as BillingPeriod,
                    slr.SourceLocationName,
                    slr.DestinationLocationName,
                    slr.ChallanQuantity,
                    slr.ReceivedQuantity,
                    slr.BillingQty,
                    slr.Rate,
                    round(a.SumofAmount,2) as SumofAmount
                From ServiceBill a, ServiceBillDetail b, DeliveryOrder c,DeliveryOrderDetail d, AllotmentScheme e,
                Party f,
                 (Select 
                    a.Tno,
                    sum(a.Rate) as Rate,
                    Sum(a.DispatchedQuantity1) as ChallanQuantity,
                    sum(a.ReachedQuantity1) as ReceivedQuantity,
                    sum(b.ShortageQuantity1) as ShortageQuantity,
                    sum(a.Quantity1) as BillingQty,
                    case When sum(a.Quantity1)- Sum(c.Quantity1) > 0 
                    then sum(a.Quantity1)- Sum(c.Quantity1)
                    Else null end as BalanceQty,
                    d.SourceLocationName,
                    e.DestinationLocationName
                 From ServiceBillDetail a, ServiceBillLr b, Lr c, PODDetail P, Sourcelocation d, Destinationlocation e
                 Where a.Tno = b.Tno(+)
                   and b.LrTno = c.Tno(+)
                   and b.PODTno = P.Tno(+)
                   and b.PODSno = P.Sno(+)
                   and c.sourcelocationtno = d.tno(+)
                   and c.destinationlocationtno = e.tno(+)
                   and b.sno in (Select 
                                  min(t2.sno)
                                From ServiceBillDetail t1, ServiceBillLr t2, Lr t3
                                Where t1.Tno = t2.Tno(+)
                                  and t2.LrTno = t3.Tno(+)
                                  and t1.Tno = a.tno)
                             Group by a.Tno,
                               d.SourceLocationName,
                               e.DestinationLocationName) slr
                Where a.Tno = b.Tno(+) 
                  and a.DeliveryOrderTno = c.Tno(+)
                  and c.Tno = d.Tno(+)
                  and c.AllotmentSchemeCode = e.AllotmentSchemeCode(+)
                  and a.PartyCode = f.PartyCode(+)
                 and b.Tno = slr.Tno(+)
                  and ( :P373_COMPANY IS NULL OR instr(':'||:P373_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                  and a.ServiceBillDate BETWEEN  :P373_FROMDATE AND :P373_TODATE
                  and ( :P373_PARTY IS NULL OR instr(':'||:P373_PARTY||':',':'||a.PartyCode||':') > 0 )
                  and :P373_FROMDATE is not null
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        download {
