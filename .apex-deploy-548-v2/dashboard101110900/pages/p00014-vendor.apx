page 14 (
    name: Vendor
    alias: VENDOR
    title: Vendor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region vendor (
        name: Vendor
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vendor-2 (
        name: Vendor
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                      ROWNUM AS SerialNo,
                      a.VendorCode,
                      a.VendorName,
                      a.ContactPerson,
                      a.OfficeAddress,
                      ct.CityName as OfficeCity,
                      st.StateName as OfficeState,
                      a.OfficePhoneNo,
                      a.OfficeMobileNo,
                      a.OfficeEmailID,
                      a.Website,
                      a.VendorCategory,
                      a.Creator,
                      a.CreationTime,
                      vsv.VendorSiteVisitNo,
                      vsv.VendorSiteVisitDate,
                      vsv.VisitDate,
                      vsv.CanbeRegistered,
                      a.RegistrationNo,
                      a.RegistrationDate,
                      a.ContactPersonAddress,
                      c.CityName as ContactPersonCity,
                      s.StateName as ContactPersonState,
                      a.ContactPersonPhoneNo,
                      a.ContactPersonEMailID,
                      a.VendorStatusCode,
                      a.BusinessNatureCode,
                      a.IndustryTypeCode,
                      GetModuleAttachmentValue('VENDOR',a.TNo,'GSTINNO') as GST,
                      GetModuleAttachmentValue('VENDOR',a.TNo,'PANNO') as PAN,
                      GetModuleAttachmentValue('VENDOR',a.TNo,'FOSCOS') as FOSCOS
                From  Vendor a, City ct, State st, VendorSiteVisit vsv, City c, State s
                Where a.OfficeCityCode = ct.CityCode(+)
                  and a.OfficeStateCode = st.StateCode(+)
                  and a.VendorSiteVisitTNo = vsv.TNo(+)
                  and a.ContactPersonCityCode = c.CityCode(+)
                  and a.ContactPersonStateCode = s.StateCode(+)
                  --and instr(':'||:P14_COMPANY||':',':'||co.CompanyCode||':') > 0
                  --and a.OfficeCityCode like nvl(:P14_CITY,'%')
                  and instr(':'||:P14_CITY||':',':'||a.OfficeCityCode||':') > 0
                  and a.OfficeStateCode like  nvl(:P14_STATE,'%')
                Order by a.TNo
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 20502480083277835
        }

