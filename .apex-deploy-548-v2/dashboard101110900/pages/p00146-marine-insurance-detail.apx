    region marine-insurance (
        name: "Marine Insurance "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region marine-insurance-detail (
        name: Marine Insurance Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select xx.marineinsuranceno,
                       xx.ccinvoiceno,
                       xx.ccinvoicedate,
                       Case
                         When xx.ccinvoiceno = 'OPENING' Then
                          xx.balance
                         Else
                          xx.balance + Abs(xx.marineinsuranceamount)
                       End Opening,
                       Case
                         When xx.ccinvoiceno = 'OPENING' Then
                          Null
                         Else
                          Abs(xx.marineinsuranceamount)
                       End marineinsuranceamount,
                       xx.balance,
                       XX.SRNO,
                       xx.VEHICLETYPECODE,
                       xx.VEHICLENO,
                       xx.CITYNAME,
                       xx.STATENAME,
                       xx.InvAmt,
                       xx.tenperOfInvAmt,
                       xx.PackingType,
                       xx.FromCity
                
                  From (Select X.MARINEINSURANCENO,
                               X.CCINVOICENO,
                               X.CCINVOICEDATE,
                               Abs(x.marineinsuranceamount) As marineinsuranceamount,
                               Sum(X.MARINEINSURANCEAMOUNT) Over(Order By CCINVOICENO) As Balance,
                               SUM(X.MYSNO) OVER ( ORDER BY CCINVOICENO) AS SRNO,
                               x.tno,
                               x.VEHICLETYPECODE,
                               x.VEHICLENO,
                               x.CITYNAME,
                               x.STATENAME,
                               x.InvAmt,
                               x.tenperOfInvAmt,
                               x.PackingType,
                               x.FromCity
                          From (Select 1 AS MYSNO,
                                        A.MARINEINSURANCENO,
                                       'OPENING' CCINVOICENO,
                                       TO_DATE(:P146_FROMDATE,'DD-MON-RRRR') As CCINVOICEDATE,
                                       getmarineinsurancebalanceason(a.tno, TO_DATE(:P146_FROMDATE,'DD-MON-RRRR')) As MARINEINSURANCEAMOUNT,
                                       Null As TNO,
                                       
                                       Null As VEHICLETYPECODE,
                                       Null As VEHICLENO,
                                       Null As CITYNAME,
                                       Null As STATENAME,
                                       Null As InvAmt,
                                       Null As tenperOfInvAmt,
                                       Null As PackingType,
                                       NULL AS FromCity
                                
                                  From MARINEINSURANCE A
                                Union All
                                
                                Select 1 AS MYSNO,
                                       A.MARINEINSURANCENO,
                                       C.CCINVOICENO,
                                       C.CCINVOICEDATE,
                                       Round(-1 * C.MARINEINSURANCEAMOUNT, 0) As MARINEINSURANCEAMOUNT,
                                       c.tno,
                                       
                                       c.VEHICLETYPECODE,
                                       c.VEHICLENO,
                                       d.CITYNAME,
                                       e.STATENAME,
                                       Round(c.CCINVOICEAMOUNT, 0) InvAmt,
                                       --Round(c.CCINVOICEAMOUNT + (c.CCINVOICEAMOUNT * nvl(a.basisofvaluation,0))/100, 0) As "10%OfInvAmt",
                                       round(c.marineinsuranceamount,0) as "10%OfInvAmt",
                                       (Select PACKINGTYPECODE
                                          From CCINVOICEDETAIL
                                         Where TNO = c.TNO
                                           And Rownum = 1) As PackingType,
                                        'DHAMTARI' AS FromCity
                                
                                  From MARINEINSURANCE A,
                                       CCINVOICE       C,
                                       party           p,
                                       city            d,
                                       state           e
                                 Where A.TNO = C.MARINEINSURANCETNO
                                   And c.CONSIGNEECODE = p.PARTYCODE
                                   And Nvl(p.WORKSCITYCODE, p.OFFICECITYCODE) = d.CITYCODE
                                   And Nvl(p.WORKSSTATECODE, p.OFFICESTATECODE) = e.STATECODE
                                   AND GETDOCUMENTSTATUSCODE('CCINVOICE',C.TNO) = 'ACTIVE'
                                   AND C.MARINEINSURANCETNO IS NOT NULL
                                   and c.ccinvoicedate between :P146_FROMDATE and :P146_TODATE     
                                    and instr(':'||:P146_COMPANY||':',':'||c.CompanyCode||':') > 0
                                    and instr(':'||:P146_LOCATION||':',':'||c.LocationCode||':') > 0
                                    and ( :P146_INSURANCE IS NULL OR instr(':'||:P146_INSURANCE||':',':'||C.MARINEINSURANCETNO||':') > 0 ) 
                                 
                                
                                 Order By 3, 2) X) xx
                
                 Order By 1
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
