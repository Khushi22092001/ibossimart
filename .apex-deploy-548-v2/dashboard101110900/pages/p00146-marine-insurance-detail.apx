                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Select Department Name
        }
    )

    pageItem P146_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'SALARY'
                  and a.ViewPrivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order by 1
                ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @marine-insurance
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Select Location Name
        }
        validation {
            valueRequired: true
        }
    )

