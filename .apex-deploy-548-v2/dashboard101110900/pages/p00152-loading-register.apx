                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Quality Test No
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P152_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      dt.DocTypeName d,
                      dt.DocTypeCode r
                From  ModulePrivilege a, ModulePrivilegeDocType b, DocType dt, BossUser bu, ModuleDocType md, ModuleDocTypeDetail mdd
                Where a.TNo = b.TNo(+)
                  and (b.DocTypeCode = dt.DocTypeCode or b.DocTypeCode is null)
                  and a.ModuleCode = md.ModuleCode
                  and md.TNo = mdd.TNo
                  and mdd.DocTypeCode = dt.DocTypeCode
                  and a.ModuleCode = 'LOADINGSLIP'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order By 1
                ;
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @loading-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
