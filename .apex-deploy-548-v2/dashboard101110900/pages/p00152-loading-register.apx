    region loading-register (
        name: Loading Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region loading-register-report (
        name: Loading  Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,
                       a.LoadingSlipno,
                       a.LoadingSlipdate,
                       b.DespatchAdviceNo,
                       b.DespatchAdviceDate,
                       e.PartyName,
                       aa.LoadingStatus,
                       b.vehicleno,
                       aa.itemcode,
                       aa.itemspecificationcode,
                       c.itemname,
                       d.itemspecificationname,
                       C.MEASURINGUNITCODE1     As UOM1,
                       C.MEASURINGUNITCODE2     As UOM2,
                       AA.QUANTITY1,
                       AA.QUANTITY2,
                       AA.REMARK
                  From LoadingSlip       a,
                       DespatchAdvice    b,
                       Party             e,
                       item              c,
                       itemspecification d,
                       LoadingSlipDetail aa
                 Where a.DespatchAdviceTNo = b.tno(+)
                   And e.PartyCode = a.PartyCode
                   And aa.itemcode = c.itemcode(+)
                   And aa.itemspecificationcode = d.itemspecificationcode(+)
                   And a.tno = aa.tno(+)
                  and a.LoadingSlipDate between :P152_FROMDATE and :P152_TODATE
                  and instr(':'||:P152_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P152_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and ( :P152_ITEM IS NULL OR instr(':'||:P152_ITEM||':',':'||aa.ItemCode||':') > 0 ) 
                  and ( :P152_SPECIFICATION IS NULL OR instr(':'||:P152_SPECIFICATION||':',':'||aa.ItemSpecificationCode||':') > 0 ) 
                  and ( :P152_PARTYNAME IS NULL OR instr(':'||:P152_PARTYNAME||':',':'||b.PartyCode||':') > 0 ) 
                   and ( :P152_DOCTYPE IS NULL OR instr(':'||:P152_DOCTYPE||':',':'||a.DocTypeCode||':') > 0 ) 
                  and a.LoadingSlipNo like nvl(:P152_LOADINGSLIPNO,'%')
                  and b.DespatchAdviceNO like nvl(:P152_DANO,'%')
                
                 Order By a.LoadingSlipdate, a.LoadingSlipno
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
