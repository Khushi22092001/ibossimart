                        --                   'DEPTAPPROVED'
                        --                  When dsd.DocumentStatusCode = 'STOREAPPROVED' Then
                        --                   'STOREAPPROVED'
                        --                End As DocStatus
                        --           From DebitNote             a,
                        --                DebitNoteDetail       b,
                        --                DebitNoteDetailFooter c,
                        --                Location              l,
                        --                JobType               jt,
                        --                Item                  e,
                        --                itemSpecification     ee,
                        --                NatureofSupply        n,
                        --                ReasonforissuingNote  r,
                        --                Voucher               v,
                        --                documentstatusdetail  dsd
                        --          Where a.TNo = b.TNo(+)
                        --            And b.TNo = c.TNo(+)
                        --            And b.SNO = c.SNo(+)
