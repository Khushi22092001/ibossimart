                        --        xx.DocType,
                        --        xx.LocationName,
                        --        xx.DebitNoteNo,
                        --        xx.DebitNoteDate,
                        --        xx.Party,
                        --        xx.Reference,
                        --        xx.ReferenceNo,
                        --        xx.referencetext,
                        --        xx.RefDate,
                        --        xx.transactiontypecode,
                        --        xx.natureofsupplyname,
                        --        xx.PartyCreditNoteNo,
                        --        xx.PartyCreditNoteDate,
                        --        xx.ItemCode,
                        --        xx.Item,
