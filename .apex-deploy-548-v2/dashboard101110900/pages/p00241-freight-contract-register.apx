page 241 (
    name: Freight Contract Register
    alias: FREIGHT-CONTRACT-REGISTER
    title: Freight Contract Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region freight-contract-register (
        name: Freight Contract Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region freight-contract-register-report (
        name: Freight Contract Register Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                ROWNUM AS Sno,
                a.Tno,
                a.CompanyName,
                a.FreightRateListNo,
                a.FreightRateListDate,
                a.DoctypeName,
                a.LocationName,
                a.PartyName,
                a.ItemName,
                a.EffectiveDateFrom,
                a.ValidTillDate,
                round(a.ItemRate,2) as ItemRate,
                a.WorkOrderNo,
                a.WorkOrderDate,
                round(a.ToleranceValue,2) as ToleranceValue,
                a.ToleranceMethodCode,
                a.SourceLocationName,
                a.DestinationLocationName,
                a.RouteName,
                a.FreightBasisName,
                round(a.FreightRate,2) as FreihghtRate,
                -- Case
                --         When ROW_NUMBER()
                --          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                --          round(a.Quantity,3)
                --         Else
                --          Null
                --       End Quantity,
                a.Quantity,
                --Case
                --         When ROW_NUMBER()
                --          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                --          round(a.SourceDestinationQty,3)
                --         Else
                --          Null
                --       End SourceDestinationQty,
                a.SourceDestinationQty,
                --Case
                --         When ROW_NUMBER()
                --          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                --          round(to_number(a.AllocatedQuantity),3)
                --         Else
                --          Null
                --       End AllocatedQty,
                to_number(a.AllocatedQuantity) as AllocatedQty,
                --Case
                --         When ROW_NUMBER()
                --          Over(Partition By a.TNo Order By a.TNo) = 1 Then
                --          round(a.BalanceQuantity,3)
                --         Else
                --          Null
                --       End BalanceQuantity,
                a.BalanceQuantity,
                a.leadhours, 
                a.DistanceInKm,
                a.Creator From 
                (Select
                a.Tno,
                co.CompanyName,
                a.FreightRateListNo,
                a.FreightRateListDate,
                dc.DoctypeName,
                lo.LocationName,
                pa.PartyName,
                i.ItemName,
                a.EffectiveDateFrom,
                a.ValidTillDate,
                a.ItemRate,
                a.WorkOrderNo,
                a.WorkOrderDate,
                a.ToleranceValue,
                a.ToleranceMethodCode,
                c.SourceLocationName,
                d.DestinationLocationName,
                r.RouteName,
                fb.FreightBasisName,
                b.FreightRate,
                nvl(a.Quantity1,0) as Quantity,
                nvl(b.Quantity1,0) as SourceDestinationQty,
                nvl(decode(a.Quantity1, null, null, GetFRLAllocatedQuantity(a.Tno)), GetFRLAllocatedQuantitySD(a.Tno, b.SourceLocationTno, b.DestinationLocationTno)) as AllocatedQuantity,
                nvl(a.Quantity1 - decode(a.Quantity1, null, null, GetFRLAllocatedQuantity(a.Tno)), b.Quantity1 - GetFRLAllocatedQuantitySD(a.Tno, b.SourceLocationTno, b.DestinationLocationTno)) as BalanceQuantity,
                (b.leaddays * 24) as leadhours, 
                b.DistanceInKm,
                a.Creator
                From FreightRateList a, FreightRateListDetail b, SourceLocation c, DestinationLocation d, Location lo,Doctype dc,
                Company co, Party pa, Item i, FreightBasis fb, Route r
                Where a.Tno = b.Tno(+)
                and b.SourceLocationTno = c.Tno(+)
                and b.DestinationLocationTno = d.Tno(+)
                and a.LocationCode = lo.LocationCode(+)
                and a.DoctypeCode = dc.DoctypeCode(+)
                and a.CompanyCode = co.CompanyCode(+)
                and a.PartyCode = pa.PartyCode(+)
                and a.ItemCode = i.Itemcode(+)
                and b.FreightBasisCode = fb.FreightBasisCode(+)
                and b.RouteCode = r.RouteCode(+)
                and a.FreightRateListDate between :P241_FROMDATE and :P241_TODATE
                and (:P241_COMPANY is Null Or Instr (':' || :P241_COMPANY || ':' , ':' || co.CompanyCode|| ':') > 0)
                and (:P241_PARTYNAME is Null Or Instr (':' || :P241_PARTYNAME || ':' , ':' || pa.PartyCode|| ':') > 0)
                and (:P241_DOCTYPE is Null Or Instr (':' || :P241_DOCTYPE || ':' , ':' || dc.DoctypeCode|| ':') > 0)
                and (:P241_LOCATION is Null Or Instr (':' || :P241_LOCATION || ':' , ':' || lo.LocationCode|| ':') > 0)
                order by a.freightratelistNO asc) a
                ;
                
                
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
