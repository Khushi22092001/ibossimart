    region sc-balance (
        name: SC Balance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a href="'||apex_page.get_url(p_page=>731,p_items=>'P731_SCTNO',p_values=>b.TNo)||'">'
                         ||b.SalesConfirmNo||'</a>' CONFIRM_NO,
                       b.SalesConfirmDate CONFIRM_DATE,
                       b.PartyName CUSTOMER,
                       Round(b.ScQty) SC_QTY,
                       Round(b.SoQty) SO_QTY,
                       Round(b.DaQty) DA_QTY,
                       Round(b.CcQty) CC_QTY,
                       Round(b.BalanceQty) BALANCE_QTY,
                       trunc(sysdate-b.SalesConfirmDate) AGE_DAYS
                  From SCBALANCE b Join SalesConfirm sc On sc.TNo=b.TNo
                 Where b.BalanceQty > 0
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P731_PANEL Is Null Or sc.Panel=:P731_PANEL)
                   And sc.SalesConfirmDate Between to_date(:P731_FROMDATE,'DD-MM-RRRR') And to_date(:P731_TODATE,'DD-MM-RRRR')
                   And (:P731_COMPANY Is Null Or sc.CompanyCode=:P731_COMPANY)
                   And (:P731_LOCATION Is Null Or sc.LocationCode=:P731_LOCATION)
                 Order By b.SalesConfirmDate Desc
                ```
            pageItemsToSubmit: [
                P731_FROMDATE
                P731_TODATE
                P731_COMPANY
                P731_LOCATION
                P731_PANEL
            ]
        }
        layout {
            sequence: 21
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: p731ScBalance
        }
        serverSideCondition {
            type: never
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No open confirmation balance in scope.
        }
        advanced {
            savedReportMappingIdentifier: 48479440214664135
        }

