    region lifecycle-trace (
        name: Lifecycle Trace
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a href="'||apex_page.get_url(p_page=>734,p_clear_cache=>'734',p_items=>'P734_SOTNO,P734_FROMDATE,P734_TODATE',p_values=>so.TNo||','||:P731_FROMDATE||','||:P731_TODATE)||'">'||apex_escape.html(so.SalesOrderNo)||'</a>' SO_NO,
                       so.SalesOrderDate SO_DATE,
                       so.SalesOrderAmount SO_VALUE,
                       da.DespatchAdviceNo DA_NO, da.DespatchAdviceDate DA_DATE,
                       da.VehicleNo VEHICLE,
                       (Select Sum(nvl(dd.Quantity1,0)) From DespatchAdviceDetail dd Where dd.TNo=da.TNo) DA_QTY,
                       mo.GateInTime GATE_IN, mo.GateOutTime GATE_OUT,
                       w.FirstWeight FIRST_WEIGHT,w.FirstWeightTime FIRST_WEIGHT_TIME,
                       w.SecondWeight SECOND_WEIGHT,w.SecondWeightTime SECOND_WEIGHT_TIME,
                       Case When ci.TNo Is Not Null Then '<a href="'||apex_page.get_url(p_page=>657,p_clear_cache=>'657',p_items=>'P657_TNO',p_values=>ci.TNo)||'">'||ci.CCInvoiceNo||'</a>' End INV_NO, ci.CCInvoiceDate INV_DATE,
                       ci.NetWeight NET_WT,ci.CCInvoiceAmount INV_VALUE,
                       Case When e.Irn Is Not Null Then '<span class="ds-pill ds-pill--good">IRN</span>'
                            When ci.TNo Is Not Null Then '<span class="ds-pill ds-pill--warn">No IRN</span>'
                            Else '' End EINVOICE
                  From SalesOrder so
                  Left Join DespatchAdvice da On da.SalesOrderTNo = so.TNo
                  Left Join MaterialOut mo On mo.ReferenceTNo = da.TNo
                  Left Join Weighment w On w.TNo=da.WeighmentTNo
                  Left Join CCInvoice ci On ci.SalesOrderTNo=so.TNo
                   And (ci.DespatchAdviceTNo=da.TNo Or (ci.DespatchAdviceTNo Is Null And da.TNo Is Null))
                  Left Join EInvoice e On e.CCInvoiceTNo = ci.TNo
                 Where so.SalesConfirmTNo = :P731_SCTNO
                 Order By so.SalesOrderDate, da.DespatchAdviceDate
                ```
            pageItemsToSubmit: [
                P731_SCTNO
                P731_FROMDATE
                P731_TODATE
            ]
        }
        layout {
            sequence: 31
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: p731Trace
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: Select a confirmation above to trace its lifecycle.
        }
        advanced {
            savedReportMappingIdentifier: 48480651938664135
        }

