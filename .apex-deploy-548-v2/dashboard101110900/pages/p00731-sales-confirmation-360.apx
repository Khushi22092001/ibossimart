    region command-header (
        name: Sales Confirmation 360
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-slc-hero"><div class="ds-slc-hero-row">'
                  ||'<span class="ds-slc-hero-icon"><span class="fa fa-handshake-o"></span></span><span>'
                  ||'<span class="ds-slc-hero-eyebrow">Commercial &middot; Order-to-Cash</span><br>'
                  ||'<span class="ds-slc-hero-title">'||apex_escape.html(nvl(sc.SalesConfirmNo,'Sales Confirmation 360'))||'</span>'
                  ||'<div class="ds-slc-hero-sub">'||Case When sc.TNo Is Null Then
                       'Select a confirmation below to see its complete commercial record and every downstream handoff.'
                     Else 'Complete confirmation position for '||apex_escape.html(GetPartyName(sc.PartyCode))||' &mdash; item, order, dispatch, gate, weighment, invoice, IRN and ledger context.' End||'</div>'
                  ||'</span></div><div class="ds-slc-hero-chips">'
                  ||Case When sc.TNo Is Not Null Then
                       '<span class="ds-chip ds-chip--live"><span class="fa fa-calendar ds-chip-ic"></span><span class="ds-chip-k">Confirmed</span><b>'||to_char(sc.SalesConfirmDate,'DD-Mon-RRRR')||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-user ds-chip-ic"></span><span class="ds-chip-k">Customer</span><b>'||apex_escape.html(GetPartyName(sc.PartyCode))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-building-o ds-chip-ic"></span><span class="ds-chip-k">Company</span><b>'||apex_escape.html(GetCompanyName(sc.CompanyCode))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-map-marker ds-chip-ic"></span><span class="ds-chip-k">Location</span><b>'||apex_escape.html(GetLocationName(sc.LocationCode))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span><span class="ds-chip-k">Panel</span><b>'||apex_escape.html(sc.Panel)||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-truck ds-chip-ic"></span><span class="ds-chip-k">Delivery</span><b>'||nvl(to_char(sc.DeliveryDate,'DD-Mon-RRRR'),'not recorded')||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-clock-o ds-chip-ic"></span><span class="ds-chip-k">Credit</span><b>'||nvl(to_char(sc.CreditDays),'0')||' days</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-sitemap ds-chip-ic"></span><span class="ds-chip-k">Department</span><b>'||apex_escape.html(nvl(GetDepartmentName(sc.DepartmentCode),'not recorded'))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-user-circle ds-chip-ic"></span><span class="ds-chip-k">Employee</span><b>'||apex_escape.html(nvl(GetEmployeeName(sc.EmployeeCode),'not recorded'))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-users ds-chip-ic"></span><span class="ds-chip-k">Consignee</span><b>'||apex_escape.html(nvl(GetPartyName(sc.ConsigneeCode),'not recorded'))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-user-secret ds-chip-ic"></span><span class="ds-chip-k">Agent</span><b>'||apex_escape.html(nvl(GetPartyName(sc.AgentCode),'not recorded'))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-truck ds-chip-ic"></span><span class="ds-chip-k">Transporter</span><b>'||apex_escape.html(nvl(GetPartyName(sc.TransporterCode),'not recorded'))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-calendar-check-o ds-chip-ic"></span><span class="ds-chip-k">Valid until</span><b>'||nvl(to_char(sc.ValidityUptoDate,'DD-Mon-RRRR'),'not recorded')||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-exchange ds-chip-ic"></span><span class="ds-chip-k">Transaction</span><b>'||apex_escape.html(nvl(sc.TransactionTypeCode,'not recorded'))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-cube ds-chip-ic"></span><span class="ds-chip-k">Dispatch category</span><b>'||apex_escape.html(nvl(sc.DespatchCategoryCode,'not recorded'))||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-money ds-chip-ic"></span><span class="ds-chip-k">Currency</span><b>'||apex_escape.html(nvl(sc.CurrencyUnitCode,'INR'))||' @ '||to_char(nvl(sc.CurrencyValue,1),'FM999G990D000')||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-user-plus ds-chip-ic"></span><span class="ds-chip-k">Created by</span><b>'||apex_escape.html(nvl(sc.Creator,'not recorded'))||' &middot; '||nvl(to_char(sc.CreationTime,'DD-Mon-RRRR HH24:MI'),'not recorded')||'</b></span>'
                    || '<span class="ds-chip"><span class="fa fa-inr ds-chip-ic"></span><span class="ds-chip-k">Value</span><b>&#8377; '||to_char(nvl(sc.SalesConfirmAmount,0),'FM999G999G999G990D00')||'</b></span>'
                    || Case When sc.Remark Is Not Null Then '<span class="ds-chip"><span class="fa fa-comment-o ds-chip-ic"></span><span class="ds-chip-k">Remark</span><b>'||apex_escape.html(sc.Remark)||'</b></span>' Else '' End
                     Else '<span class="ds-chip"><span class="fa fa-info-circle ds-chip-ic"></span><b>No confirmation selected</b></span>' End
                  ||'</div></div>' HEAD
                  From dual Left Join SalesConfirm sc On sc.TNo=:P731_SCTNO
                ```
            pageItemsToSubmit: [
                P731_FROMDATE
                P731_TODATE
                P731_COMPANY
                P731_LOCATION
                P731_PANEL
                P731_SCTNO
            ]
        }
