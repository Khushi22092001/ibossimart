page 731 (
    name: Sales Confirmation 360
    alias: SALES-CONFIRMATION-360
    title: Sales Confirmation 360
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            SALES CONFIRMATION 360 (HSPL). Two things in one:
            1. CONFIRMATION FULFILMENT dashboard from the SCBALANCE view (per-confirmation qty flow
               ScQty -> SoQty -> DaQty -> CcQty -> BalanceQty). SCBALANCE lists only confirmations
               that still carry a balance (fully-fulfilled ones drop off). Panel guard is applied by
               joining SCBALANCE.TNo -> SalesConfirm for the Panel column (the view has none).
            2. A per-confirmation 360: pick a confirmation and trace its whole lifecycle in one view -
               Sales Order -> Dispatch Advice -> Gate In/Out (MaterialOut) -> CC Invoice -> E-Invoice,
               with dates. Links: SalesOrder.SalesConfirmTNo, DespatchAdvice.SalesOrderTNo,
               MaterialOut.ReferenceTNo=DA, CCInvoice.DespatchAdviceTNo, EInvoice.CCInvoiceTNo.
            READ-ONLY. Every region is a SELECT.
            ```
    }

    region bal-aging (
        name: Balance Aging
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With A As (
                  Select Case When b.SalesConfirmDate > sysdate-15 Then 1
                              When b.SalesConfirmDate > sysdate-30 Then 2
                              When b.SalesConfirmDate > sysdate-60 Then 3
                              When b.SalesConfirmDate > sysdate-90 Then 4 Else 5 End Ord,
                         Case When b.SalesConfirmDate > sysdate-15 Then '0-15 days'
                              When b.SalesConfirmDate > sysdate-30 Then '16-30 days'
                              When b.SalesConfirmDate > sysdate-60 Then '31-60 days'
                              When b.SalesConfirmDate > sysdate-90 Then '61-90 days' Else '90+ days' End Lbl,
                         b.BalanceQty q
                    From SCBALANCE b Join SalesConfirm sc On sc.TNo=b.TNo
                   Where b.BalanceQty > 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P731_PANEL Is Null Or sc.Panel=:P731_PANEL)
                     And sc.SalesConfirmDate Between to_date(:P731_FROMDATE,'DD-MM-RRRR') And to_date(:P731_TODATE,'DD-MM-RRRR')
                     And (:P731_COMPANY Is Null Or sc.CompanyCode=:P731_COMPANY)
                     And (:P731_LOCATION Is Null Or sc.LocationCode=:P731_LOCATION)),
                G As (Select Ord, Lbl, Round(Sum(q)) Qty, Count(*) Cnt From A Group By Ord, Lbl),
                Mx As (Select Nullif(Max(Qty),0) mx From G)
                Select '<div class="ds-slc-age">'||Listagg(
                    '<div class="ds-slc-agerow"><span class="ds-slc-agelbl">'||g.Lbl||'</span>'
                    ||'<span class="ds-slc-agebar"><i style="width:'||to_char(Greatest(Round(100*g.Qty/mx.mx),2))||'%"></i></span>'
                    ||'<span class="ds-slc-ageval">'||to_char(g.Qty,'FM999G999G990')||' &middot; '||to_char(g.Cnt)||'</span></div>'
                  ) Within Group (Order By g.Ord)||'</div>' As FLOW
                From G g Cross Join Mx mx
                ```
            pageItemsToSubmit: [
                P731_FROMDATE
                P731_TODATE
                P731_COMPANY
                P731_LOCATION
                P731_PANEL
            ]
        }
        layout {
            sequence: 12
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        advanced {
            htmlDomId: p731BalanceAging
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No open balance to age.
        }

        column FLOW (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region bal-customers (
        name: Top Open Customers
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.PartyName CUSTOMER,
                       Count(*) CONFIRMS,
                       Round(Sum(b.ScQty)) CONFIRMED_QTY,
                       Round(Sum(b.BalanceQty)) BALANCE_QTY
                  From SCBALANCE b Join SalesConfirm sc On sc.TNo=b.TNo
                 Where b.BalanceQty > 0
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P731_PANEL Is Null Or sc.Panel=:P731_PANEL)
                   And sc.SalesConfirmDate Between to_date(:P731_FROMDATE,'DD-MM-RRRR') And to_date(:P731_TODATE,'DD-MM-RRRR')
                   And (:P731_COMPANY Is Null Or sc.CompanyCode=:P731_COMPANY)
                   And (:P731_LOCATION Is Null Or sc.LocationCode=:P731_LOCATION)
                 Group By b.PartyName
                 Order By Sum(b.BalanceQty) Desc
                ```
            pageItemsToSubmit: [
                P731_FROMDATE
                P731_TODATE
                P731_COMPANY
                P731_LOCATION
                P731_PANEL
            ]
        }
        layout {
            sequence: 13
