    region bal-kpi (
        name: Balance KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With K As (
                  Select Count(*) Confirms, Round(Sum(b.BalanceQty)) BalQty,
                         Round(Sum(Greatest(b.ScQty-b.SoQty,0))) NotOrdered,
                         Round(Max(sysdate-b.SalesConfirmDate)) OldestDays
                    From SCBALANCE b Join SalesConfirm sc On sc.TNo=b.TNo
                   Where b.BalanceQty > 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P731_PANEL Is Null Or sc.Panel=:P731_PANEL)
                     And sc.SalesConfirmDate Between to_date(:P731_FROMDATE,'DD-MM-RRRR') And to_date(:P731_TODATE,'DD-MM-RRRR')
                     And (:P731_COMPANY Is Null Or sc.CompanyCode=:P731_COMPANY)
                     And (:P731_LOCATION Is Null Or sc.LocationCode=:P731_LOCATION))
                Select Case x.Seq
                  When 1 Then q'~<div class="ds-kpi ds-kpi--risk"><span class="ds-kpi-ic"><span class="fa fa-hourglass-half"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Open Confirmations</span><span class="ds-kpi-n">~'||to_char(K.Confirms,'FM999G990')||q'~</span><span class="ds-kpi-sub">Still carrying a balance</span></span></div>~'
                  When 2 Then q'~<div class="ds-kpi ds-kpi--value"><span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Balance Quantity</span><span class="ds-kpi-n">~'||to_char(K.BalQty,'FM999G999G990')||q'~</span><span class="ds-kpi-sub">Confirmed but not invoiced</span></span></div>~'
                  When 3 Then q'~<div class="ds-kpi ds-kpi--bill"><span class="ds-kpi-ic"><span class="fa fa-file-text-o"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Not Yet Ordered</span><span class="ds-kpi-n">~'||to_char(K.NotOrdered,'FM999G999G990')||q'~</span><span class="ds-kpi-sub">Confirmed qty without a Sales Order</span></span></div>~'
                  Else q'~<div class="ds-kpi ds-kpi--ok"><span class="ds-kpi-ic"><span class="fa fa-clock-o"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Oldest Open</span><span class="ds-kpi-n">~'||to_char(Nvl(K.OldestDays,0),'FM999G990')||q'~ d</span><span class="ds-kpi-sub">Age of the oldest open confirmation</span></span></div>~'
                End As CARD
                From K, (Select Level Seq From dual Connect By Level <= 4) x
                Order By x.Seq
                ```
            pageItemsToSubmit: [
                P731_FROMDATE
                P731_TODATE
                P731_COMPANY
                P731_LOCATION
                P731_PANEL
            ]
        }
        layout {
            sequence: 11
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                ds-kpiwrap--4up
            ]
        }
        serverSideCondition {
            type: never
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
