    region page-style (
        name: SLC Theme
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                body:has(.ds-slc-headregion){
                  --slc-primary:#0F766E; --slc-secondary:#0891B2; --slc-deep:#134E4A;
                  --ds-dash-gold:#0F766E; --ds-dash-gold-bg:#E5F3F1;
                  --ds-dash-ink:#0B3B36; --ds-dash-ink2:#2E5A55;
                }
                body:has(.ds-slc-headregion) .ds-kpi--value{--ds-kpi-accent:#0F766E;--ds-kpi-accent-bg:#E5F3F1;}
                body:has(.ds-slc-headregion) .ds-kpi--bill {--ds-kpi-accent:#0891B2;--ds-kpi-accent-bg:#E2F4F8;}
                body:has(.ds-slc-headregion) .ds-kpi--risk {--ds-kpi-accent:#B45309;--ds-kpi-accent-bg:#FBF0E2;}
                body:has(.ds-slc-headregion) .ds-kpi--ok   {--ds-kpi-accent:#15803D;--ds-kpi-accent-bg:#E6F4EA;}
                body:has(.ds-slc-headregion) .ds-purchase-section::before{background:linear-gradient(180deg,#0891B2,#134E4A);}
                body:has(.ds-slc-headregion) .ds-kpiwrap--4up{grid-template-columns:repeat(4,minmax(0,1fr));}
                @media(max-width:900px){body:has(.ds-slc-headregion) .ds-kpiwrap--4up{grid-template-columns:repeat(2,minmax(0,1fr));}}
                .ds-slc-hero{position:relative;overflow:hidden;padding:22px 24px 18px;border:1px solid #A7D9D3;border-radius:16px;
                  background:radial-gradient(130% 130% at 92% 8%, rgba(8,145,178,.24) 0%, rgba(8,145,178,0) 48%),
                    linear-gradient(120deg,#D3EEEA 0%,#DAF1EF 60%,#E9F7F5 100%);
                  box-shadow:0 1px 2px rgba(16,24,40,.05),0 12px 34px rgba(15,118,110,.12);}
                .ds-slc-hero-row{position:relative;z-index:1;display:flex;align-items:flex-start;gap:15px;}
                .ds-slc-hero-icon{flex:0 0 auto;display:grid;place-items:center;width:50px;height:50px;border-radius:13px;color:#fff;font-size:20px;
                  background:linear-gradient(135deg,#0D9488 0%,#0F766E 100%);box-shadow:0 6px 16px rgba(15,118,110,.32);}
                .ds-slc-hero-eyebrow{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#0F766E;}
                .ds-slc-hero-title{font-size:24px;font-weight:700;letter-spacing:-.02em;color:#0B3B36;}
                .ds-slc-hero-sub{margin-top:5px;font-size:13px;line-height:1.5;color:#2E5A55;max-width:64ch;}
                .ds-slc-hero-chips{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:8px;margin-top:15px;}
                /* qty flow chips */
                .ds-slc-flow2{display:flex;flex-wrap:wrap;gap:0;align-items:stretch;margin-top:4px;}
                .ds-slc-fstep{position:relative;flex:1 1 0;min-width:96px;padding:11px 14px;background:var(--ds-dash-surface);
                  border:1px solid var(--ds-dash-line);border-right:0;}
                .ds-slc-fstep:first-child{border-radius:10px 0 0 10px;}
                .ds-slc-fstep:last-child{border-right:1px solid var(--ds-dash-line);border-radius:0 10px 10px 0;}
                .ds-slc-fstep.is-bal{background:#FBF0E2;border-color:#F0D9B8;}
                .ds-slc-fk{font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--ds-dash-muted);}
                .ds-slc-fv{font-size:18px;font-weight:700;color:#0B3B36;font-variant-numeric:tabular-nums;line-height:1.15;}
                .ds-slc-fstep.is-bal .ds-slc-fv{color:#B45309;}
                /* aging bars */
                .ds-slc-age{display:flex;flex-direction:column;gap:9px;padding:4px 2px;}
                .ds-slc-agerow{display:flex;align-items:center;gap:12px;}
                .ds-slc-agelbl{flex:0 0 90px;font-size:12px;font-weight:600;color:var(--ds-dash-ink2);}
                .ds-slc-agebar{flex:1 1 auto;height:16px;border-radius:8px;background:#EEF1F0;overflow:hidden;}
                .ds-slc-agebar i{display:block;height:100%;border-radius:8px;background:linear-gradient(90deg,#14B8A6,#0F766E);}
                .ds-slc-ageval{flex:0 0 auto;font-size:12px;font-weight:700;color:#0B3B36;font-variant-numeric:tabular-nums;min-width:70px;text-align:right;}
                html.page-731 .t-Body-title.hspl-hero-card, html.page-731 .t-Body-title{display:none !important;}
                #p731BalanceAging{min-height:0!important;height:auto!important;}
                </style>
                ```
        }
        layout {
            sequence: 1
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region receipt-context (
        name: Customer Receipt &amp; Ledger Context
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With S As (
                  Select sc.PartyCode,sc.CompanyCode,sc.LocationCode,sc.Panel,sc.SalesConfirmDate
                    From SalesConfirm sc Where sc.TNo=:P731_SCTNO),
                R As (
                  Select Sum(d.Amount) ReceivedAmount,Count(Distinct d.TNo) ReceiptCount,Max(d.VoucherDate) LastReceiptDate
                    From S Join VoucherDetail d On d.AccountCode=S.PartyCode And d.CompanyCode=S.CompanyCode And d.LocationCode=S.LocationCode
                    Join Voucher v On v.TNo=d.TNo
                   Where v.DocTypeCode='RECEIPT' And d.Amount>0
                     And d.VoucherDate>=S.SalesConfirmDate And d.VoucherDate<to_date(:P731_TODATE,'DD-MM-RRRR')+1),
                B As (
                  Select Sum(-d.Amount) NetOutstanding,Max(d.VoucherDate) LastMovement
                    From S Join VoucherDetail d On d.AccountCode=S.PartyCode And d.CompanyCode=S.CompanyCode And d.LocationCode=S.LocationCode
                   Where d.VoucherDate<to_date(:P731_TODATE,'DD-MM-RRRR')+1)
                Select GetPartyName(s.PartyCode) Customer,
                       nvl(r.ReceivedAmount,0) ReceiptsSinceConfirmation,nvl(r.ReceiptCount,0) ReceiptCount,
                       r.LastReceiptDate,greatest(nvl(b.NetOutstanding,0),0) Outstanding,
                       greatest(-nvl(b.NetOutstanding,0),0) CustomerAdvance,b.LastMovement,
                       '<a class="ds-link-arrow" href="'||apex_page.get_url(p_page=>693,p_clear_cache=>'693',
                         p_items=>'P693_PARTY,P693_FROMDATE,P693_TODATE,P693_COMPANY,P693_LOCATION,P693_PANEL',
                         p_values=>s.PartyCode||','||to_char(s.SalesConfirmDate,'DD-MM-RRRR')||','||:P731_TODATE||','||s.CompanyCode||','||s.LocationCode||','||s.Panel)||'">Open Customer Ledger &rsaquo;</a>' Ledger
                  From S Cross Join R Cross Join B
                ```
            pageItemsToSubmit: [
                P731_SCTNO
                P731_TODATE
            ]
        }
        layout {
            sequence: 32
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: "[#DEFAULT# t-Region--scrollBody]"
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: p731ReceiptContext
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: Select a confirmation to see customer receipt and ledger context.
        }
        advanced {
            savedReportMappingIdentifier: 53124332673454206
        }

