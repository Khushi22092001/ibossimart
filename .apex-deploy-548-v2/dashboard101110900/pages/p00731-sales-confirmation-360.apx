            encryptSessionState: false
        }
    )

    pageItem P731_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            displayExtraValues: false
            nullDisplayValue: A + B
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 11
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Hidden when the login is already bound to a panel; the enforced panel is shown in the 360 header.
        }
    )

    pageItem P731_SCTNO (
        type: popupLov
        label {
            label: Sales Confirmation
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select sc.SalesConfirmNo||' - '||GetPartyName(sc.PartyCode)||' - '||to_char(sc.SalesConfirmDate,'DD-Mon-RRRR') d,
                       sc.TNo r
                  From SalesConfirm sc
                 Where sc.SalesConfirmDate Between to_date(:P731_FROMDATE,'DD-MM-RRRR') And to_date(:P731_TODATE,'DD-MM-RRRR')
                   And (:P731_COMPANY Is Null Or sc.CompanyCode=:P731_COMPANY)
                   And (:P731_LOCATION Is Null Or sc.LocationCode=:P731_LOCATION)
                   And (:P731_PANEL Is Null Or sc.Panel=:P731_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                 Order By sc.SalesConfirmDate Desc, sc.SalesConfirmNo Desc
                ```
            nullDisplayValue: - All confirmations -
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Pick a confirmation, then select Apply to load its complete lifecycle trace.
        }
    )

    pageItem P731_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 2
            region: @filter-bar
