    region selected-kpi (
        name: Selected Confirmation Position
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Q As (
                  Select sc.TNo,
                         nvl((Select Sum(d.Quantity1) From SalesConfirmDetail d Where d.TNo=sc.TNo),0) ScQty,
                         nvl((Select Sum(d.Quantity1) From SalesOrder so Join SalesOrderDetail d On d.TNo=so.TNo Where so.SalesConfirmTNo=sc.TNo),0) SoQty,
                         nvl((Select Sum(d.Quantity1) From SalesOrder so Join DespatchAdvice da On da.SalesOrderTNo=so.TNo Join DespatchAdviceDetail d On d.TNo=da.TNo Where so.SalesConfirmTNo=sc.TNo),0) DaQty,
                         nvl((Select Sum(d.Quantity1) From SalesOrder so Join CCInvoice ci On ci.SalesOrderTNo=so.TNo Join CCInvoiceDetail d On d.TNo=ci.TNo Where so.SalesConfirmTNo=sc.TNo),0) CcQty,
                         nvl((Select Count(*) From SalesOrder so Where so.SalesConfirmTNo=sc.TNo),0) SoCnt,
                         nvl((Select Count(*) From SalesOrder so Join DespatchAdvice da On da.SalesOrderTNo=so.TNo Where so.SalesConfirmTNo=sc.TNo),0) DaCnt,
                         nvl((Select Count(*) From SalesOrder so Join CCInvoice ci On ci.SalesOrderTNo=so.TNo Where so.SalesConfirmTNo=sc.TNo),0) CcCnt
                    From SalesConfirm sc Where sc.TNo=:P731_SCTNO)
                Select Case x.Seq
                  When 1 Then q'~<div class="ds-kpi ds-kpi--value"><span class="ds-kpi-ic"><span class="fa fa-handshake-o"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Confirmed Quantity</span><span class="ds-kpi-n">~'||to_char(q.ScQty,'FM999G999G990D000')||q'~</span><span class="ds-kpi-sub">ERP confirmation detail</span></span></div>~'
                  When 2 Then q'~<div class="ds-kpi ds-kpi--bill"><span class="ds-kpi-ic"><span class="fa fa-file-text-o"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Ordered Quantity</span><span class="ds-kpi-n">~'||to_char(q.SoQty,'FM999G999G990D000')||q'~</span><span class="ds-kpi-sub">~'||q.SoCnt||q'~ sales order(s)</span></span></div>~'
                  When 3 Then q'~<div class="ds-kpi ds-kpi--ok"><span class="ds-kpi-ic"><span class="fa fa-truck"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Dispatched Quantity</span><span class="ds-kpi-n">~'||to_char(q.DaQty,'FM999G999G990D000')||q'~</span><span class="ds-kpi-sub">~'||q.DaCnt||q'~ dispatch advice(s)</span></span></div>~'
                  When 4 Then q'~<div class="ds-kpi ds-kpi--cash"><span class="ds-kpi-ic"><span class="fa fa-inr"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Invoiced Quantity</span><span class="ds-kpi-n">~'||to_char(q.CcQty,'FM999G999G990D000')||q'~</span><span class="ds-kpi-sub">~'||q.CcCnt||q'~ CC invoice(s)</span></span></div>~'
                  Else q'~<div class="ds-kpi ds-kpi--risk"><span class="ds-kpi-ic"><span class="fa fa-hourglass-half"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Balance Quantity</span><span class="ds-kpi-n">~'||to_char(greatest(q.ScQty-q.CcQty,0),'FM999G999G990D000')||q'~</span><span class="ds-kpi-sub">Confirmed less invoiced</span></span></div>~' End CARD
                  From Q q Cross Join (Select Level Seq From dual Connect By Level<=5) x Order By x.Seq
                ```
            pageItemsToSubmit: P731_SCTNO
        }
        layout {
            sequence: 7
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-slc-kpi-region
                ds-kpi-gap
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Select a sales confirmation to load its position.
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    pageItem P731_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: Select CompanyName d,CompanyCode r From Company Order By 1
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 3
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 5
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P731_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 1
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(add_months(trunc(sysdate,'MM'),-2),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P731_LOCATION (
        type: popupLov
