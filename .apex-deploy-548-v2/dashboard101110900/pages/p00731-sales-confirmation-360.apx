            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: p731BalCust
        }
        serverSideCondition {
            type: never
        }
