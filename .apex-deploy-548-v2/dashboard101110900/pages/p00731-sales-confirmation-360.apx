            type: sqlQuery
            sqlQuery: Select LocationName d,LocationCode r From Location Order By 1
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        layout {
            sequence: 4
            region: @filter-bar
            slot: regionBody
