    region sc-lines (
        name: Confirmation Items
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With S As (
                  Select d.ItemCode,d.ItemSpecificationCode,Max(d.Description) Description,
                         Sum(nvl(d.Quantity1,0)) ConfirmedQty,Max(d.Rate) Rate,Sum(nvl(d.TotalAmount,d.Amount)) Amount
                    From SalesConfirmDetail d Where d.TNo=:P731_SCTNO
                   Group By d.ItemCode,d.ItemSpecificationCode),
                O As (
                  Select d.ItemCode,d.ItemSpecificationCode,Sum(nvl(d.Quantity1,0)) Qty
                    From SalesOrder so Join SalesOrderDetail d On d.TNo=so.TNo
                   Where so.SalesConfirmTNo=:P731_SCTNO Group By d.ItemCode,d.ItemSpecificationCode),
                D As (
                  Select d.ItemCode,d.ItemSpecificationCode,Sum(nvl(d.Quantity1,0)) Qty
                    From SalesOrder so Join DespatchAdvice da On da.SalesOrderTNo=so.TNo Join DespatchAdviceDetail d On d.TNo=da.TNo
                   Where so.SalesConfirmTNo=:P731_SCTNO Group By d.ItemCode,d.ItemSpecificationCode),
                I As (
                  Select d.ItemCode,d.ItemSpecificationCode,Sum(nvl(d.Quantity1,0)) Qty
                    From SalesOrder so Join CCInvoice ci On ci.SalesOrderTNo=so.TNo Join CCInvoiceDetail d On d.TNo=ci.TNo
                   Where so.SalesConfirmTNo=:P731_SCTNO Group By d.ItemCode,d.ItemSpecificationCode)
                Select GetItemName(s.ItemCode) Item,
                       GetItemSpecificationName(s.ItemCode,s.ItemSpecificationCode) Specification,
                       s.Description,s.ConfirmedQty,nvl(o.Qty,0) OrderedQty,nvl(d.Qty,0) DispatchQty,nvl(i.Qty,0) InvoiceQty,
                       greatest(s.ConfirmedQty-nvl(i.Qty,0),0) BalanceQty,s.Rate,s.Amount,
                       Case When nvl(i.Qty,0)>=s.ConfirmedQty Then 'Complete'
                            When nvl(o.Qty,0)=0 Then 'Awaiting order'
                            When nvl(d.Qty,0)=0 Then 'Awaiting dispatch'
                            When nvl(i.Qty,0)=0 Then 'Awaiting invoice' Else 'Part fulfilled' End Status
                  From S s Left Join O o On o.ItemCode=s.ItemCode And nvl(o.ItemSpecificationCode,'~')=nvl(s.ItemSpecificationCode,'~')
                  Left Join D d On d.ItemCode=s.ItemCode And nvl(d.ItemSpecificationCode,'~')=nvl(s.ItemSpecificationCode,'~')
                  Left Join I i On i.ItemCode=s.ItemCode And nvl(i.ItemSpecificationCode,'~')=nvl(s.ItemSpecificationCode,'~')
                 Order By Item,Specification
                ```
            pageItemsToSubmit: P731_SCTNO
        }
        layout {
            sequence: 9
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: "[#DEFAULT# t-Region--scrollBody]"
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: p731ScLines
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: Select a confirmation to see its item details.
        }
        advanced {
            savedReportMappingIdentifier: 53122343555454181
        }

