page 323 (
    name: Stock Consumed From Opening
    alias: STOCK-CONSUMED-FROM-OPENING
    title: Stock Consumed From Opening
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region stock-consumed-from-opening (
        name: Stock Consumed From Opening
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                row_number() over(order by B.LOCATIONCode) SerialNo,
                f.LocationName,
                b.LocationCode,
                d.MeasuringUnitName as Unit1,
                e.MeasuringUnitName as Unit2,
                round(( b.OpeningValue / b.OpeningQuantity1 ) * a.UsedStockQuantity1, 2) as UsedStockAmount,
                a.*
                from StockConsumedFromOpening a, ItemOpening b, Item c, MeasuringUnit d, MeasuringUnit e, Location f
                where a.ItemOpeningTNo = b.TNo
                and a.ItemCode = c.ItemCode
                and c.measuringUnitcode1 = d.MeasuringUnitCode(+)
                and c.measuringUnitcode2 = e.MeasuringUnitCode(+)
                and b.LocationCode = f.LocationCode
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 48582024394912502
        }

