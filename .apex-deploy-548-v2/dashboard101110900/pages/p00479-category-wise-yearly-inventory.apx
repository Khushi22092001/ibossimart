page 479 (
    name: Category Wise Yearly Inventory
    alias: CATEGORY-WISE-YEARLY-INVENTORY
    title: Category Wise Yearly Inventory
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region category-wise-yearly-inventory (
        name: Category Wise Yearly Inventory
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region category-wise-yearly-inventory-2 (
        name: Category Wise Yearly Inventory
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                ROWNUM AS SERIALNO,
                  a.StockDate,
                  a.DocumentNO,
                  a.VoucherNo,
                  a.Module,
                  a.Location,
                  a.StorageLocation,
                  a.DocumentNature,
                  a.Item,
                  a.Quantity,
                  a.Amount
                From CategoryWiseYearlyInventory a
                Where a.StockDate Between :P479_FROMDATE and :P479_TODATE
                and ( :P479_ITEM IS NULL OR instr(':'||:P479_ITEM||':',':'||a.Item||':') > 0 )
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 61267037381817757
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 190
                columnAlignment: end
            }
            appearance {
                formatMask: 999999990.99
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:80px">#AMOUNT#</div>
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: W
            }
        )

        column DOCUMENTNATURE (
            type: plainText
            heading {
                heading: Document Nature
                alignment: center
            }
            layout {
                sequence: 160
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:130px">#DOCUMENTNATURE#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column DOCUMENTNO (
            type: plainText
            heading {
                heading: Document No
                alignment: center
            }
            layout {
                sequence: 120
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:160px">#DOCUMENTNO#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column ITEM (
            type: plainText
            heading {
                heading: Item
                alignment: center
            }
            layout {
                sequence: 170
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:140px">#ITEM#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column LOCATION (
            type: plainText
            heading {
                heading: Location
                alignment: center
            }
            layout {
                sequence: 140
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:110px">#LOCATION#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column MODULE (
            type: plainText
            heading {
                heading: Module
                alignment: center
            }
            layout {
                sequence: 130
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:80px">#MODULE#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
                alignment: center
            }
            layout {
                sequence: 180
                columnAlignment: end
            }
            appearance {
                formatMask: 999999990.99
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:80px">#QUANTITY#</div>
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: V
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial  No
                alignment: center
            }
            layout {
                sequence: 200
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: X
            }
        )

        column STOCKDATE (
            type: plainText
            heading {
                heading: Stock Date
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:80px">#STOCKDATE#</div>
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: O
            }
        )

        column STORAGELOCATION (
            type: plainText
            heading {
                heading: Storage Location
                alignment: center
            }
            layout {
                sequence: 150
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:110px">#STORAGELOCATION#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column VOUCHERNO (
            type: plainText
            heading {
                heading: Voucher No
                alignment: center
            }
            layout {
                sequence: 100
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:150px">#VOUCHERNO#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Fixed Asset Register
        }

        savedReport 232132 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 11
            )

            displayColumn DOCUMENTNATURE (
                sequence: 8
            )

            displayColumn DOCUMENTNO (
                sequence: 3
            )

            displayColumn ITEM (
                sequence: 9
            )

            displayColumn LOCATION (
                sequence: 6
            )

            displayColumn MODULE (
                sequence: 5
            )

            displayColumn QUANTITY (
                sequence: 10
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn STOCKDATE (
                sequence: 2
            )

            displayColumn STORAGELOCATION (
                sequence: 7
            )

            displayColumn VOUCHERNO (
                sequence: 4
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: AMOUNT
            )

        )

    )

    pageItem P479_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @category-wise-yearly-inventory
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P479_ITEM (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Item
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct 
                 a.Item d,
                 a.Item r
                From CategoryWiseYearlyInventory a;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @category-wise-yearly-inventory
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Item Name
        }
    )

    pageItem P479_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @category-wise-yearly-inventory
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 50
            region: @category-wise-yearly-inventory
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

