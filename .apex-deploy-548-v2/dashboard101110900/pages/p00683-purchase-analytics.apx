        }
    )

    pageItem P683_XEC_FOCUS (
        type: hidden
        layout {
            sequence: 40
            region: @filter-drawer
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: NOT A FILTER. Holds the executive exception rule id being drilled. Starts empty so the detail region costs nothing until a rule is clicked.
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back-to-hub (
        buttonName: BACKTOHUB
        label: Purchase Command Centre
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 6
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 668
                items: {
                    P668_FROMDATE: &P683_FROMDATE.
                    P668_TODATE: &P683_TODATE.
                    P668_COMPANY: &P683_COMPANY.
                    P668_LOCATION: &P683_LOCATION.
                    P668_PANEL: &P683_PANEL.
                    P668_SUPPLIER: &P683_SUPPLIER.
                    P668_ITEMGROUP: &P683_ITEMGROUP.
                    P668_ITEM: &P683_ITEM.
                }
                clearCache: 668
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button open-filters (
        buttonName: OPENFILTERS
        label: More Filters
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-sliders
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.theme.openRegion('p683Drawer');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button update-view (
        buttonName: UPDATEVIEW
        label: Update View
        layout {
            sequence: 30
            region: @spend-controls
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-bar-chart
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction xec-drill (
        name: Executive Exception Drill
        execution {
            sequence: 10
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .ds-xec-drill
        }

        action refresh-detail (
            action: refresh
            affectedElements {
                selectionType: region
                region: @exec-exception-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action scroll-to-detail (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    document.getElementById("p683XecDetail")
                            .scrollIntoView({ behavior: "smooth", block: "start" });
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action set-focus (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // The rule id travels in data-k, never the rule wording, so a rule can
                    // be reworded without silently breaking its drill-down.
                    this.browserEvent.preventDefault();
                    apex.item("P683_XEC_FOCUS").setValue(this.triggeringElement.dataset.k);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

