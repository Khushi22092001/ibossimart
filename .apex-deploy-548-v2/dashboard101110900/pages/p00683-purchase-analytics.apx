    region spend-dimension (
        name: Spend by Dimension
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ItemTree As (
                       Select ItemCode From Item
                        Where :P683_ITEMGROUP Is Not Null
                        Start With ItemCode = :P683_ITEMGROUP
                      Connect By Prior ItemCode = ParentCode
                       Union All
                       Select ItemCode From Item Where :P683_ITEMGROUP Is Null)
                Select * From (
                  Select
                    Case nvl(:P683_DIM,'SUPPLIER')
                      When 'SUPPLIER' Then nvl(GetPartyName(K),'Not recorded')
                      When 'COMPANY'  Then nvl(GetCompanyName(K),'Not recorded')
                      When 'LOCATION' Then nvl(GetLocationName(K),'Not recorded')
                      When 'ITEM'     Then nvl((Select i.ItemName From Item i
                                                 Where i.ItemCode = K),'Not recorded')
                      When 'UOM'      Then nvl((Select m.MeasuringUnitName From MeasuringUnit m
                                                 Where m.MeasuringUnitCode = K),
                                               'No unit recorded')
                      Else K
                    End As DIM_LABEL,
                    VALUE_LAC
                  From (
                    Select
                      Case nvl(:P683_DIM,'SUPPLIER')
                        When 'SUPPLIER' Then h.PartyCode
                        When 'COMPANY'  Then h.CompanyCode
                        When 'LOCATION' Then h.LocationCode
                        When 'ITEM'     Then d.ItemCode
                        When 'UOM'      Then d.RateMeasuringUnitCode
                        Else h.PartyCode
                      End K,
                      Round(Sum(d.Amount) / 100000, 2) VALUE_LAC
                      From PurchaseBill h
                      Join PurchaseBillDetail d On d.TNo = h.TNo
                     Where h.PurchaseBillDate
                           Between to_date(:P683_FROMDATE,'DD-MM-RRRR')
                               And to_date(:P683_TODATE,'DD-MM-RRRR')
                       And ((Select GetUserPanelAB_apex() From dual) Is Null
                            Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                       And (:P683_PANEL Is Null Or h.Panel = :P683_PANEL)
                       And (:P683_COMPANY  Is Null Or h.CompanyCode  = :P683_COMPANY)
                       And (:P683_LOCATION Is Null Or h.LocationCode = :P683_LOCATION)
                       And d.ItemCode In (Select ItemCode From ItemTree)
                     Group By
                      Case nvl(:P683_DIM,'SUPPLIER')
                        When 'SUPPLIER' Then h.PartyCode
                        When 'COMPANY'  Then h.CompanyCode
                        When 'LOCATION' Then h.LocationCode
                        When 'ITEM'     Then d.ItemCode
                        When 'UOM'      Then d.RateMeasuringUnitCode
                        Else h.PartyCode
                      End
                     Order By Sum(d.Amount) Desc))
                 Where rownum <= 14
                ```
            pageItemsToSubmit: [
                P683_FROMDATE
                P683_TODATE
                P683_COMPANY
                P683_LOCATION
                P683_PANEL
                P683_ITEMGROUP
                P683_DIM
            ]
        }
        layout {
            sequence: 120
            slot: body
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 380
        }
        messages {
            whenNoDataFound: No spend to break down for this period and scope.
        }

        series by-dimension (
            name: Spend (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: DIM_LABEL
                value: VALUE_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region spend-pareto (
        name: Supplier Concentration
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select * From (
                  Select
                    Rank() Over (Order By V Desc, PartyCode) As RNK,
                    apex_escape.html(GetPartyName(PartyCode)) As SUPPLIER,
                    V As PURCHASE_VALUE,
                    Round(100 * V / Sum(V) Over (), 2) As SHARE_PCT,
                    Round(100 * Sum(V) Over (Order By V Desc, PartyCode
                                             Rows Between Unbounded Preceding
                                                      And Current Row)
                              / Sum(V) Over (), 2) As CUM_PCT,
                    Case
                      When 100 * Sum(V) Over (Order By V Desc, PartyCode
                                              Rows Between Unbounded Preceding
                                                       And Current Row)
                               / Sum(V) Over () <= 50 Then 'red'
                      When 100 * Sum(V) Over (Order By V Desc, PartyCode
                                              Rows Between Unbounded Preceding
                                                       And Current Row)
                               / Sum(V) Over () <= 80 Then 'amber'
                      Else 'teal'
                    End As CUM_BAND
                  From (
                    Select h.PartyCode, Sum(d.Amount) V
                      From PurchaseBill h
                      Join PurchaseBillDetail d On d.TNo = h.TNo
                     Where h.PurchaseBillDate
                           Between to_date(:P683_FROMDATE,'DD-MM-RRRR')
                               And to_date(:P683_TODATE,'DD-MM-RRRR')
                       And ((Select GetUserPanelAB_apex() From dual) Is Null
                            Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                       And (:P683_PANEL Is Null Or h.Panel = :P683_PANEL)
                       And (:P683_COMPANY  Is Null Or h.CompanyCode  = :P683_COMPANY)
                       And (:P683_LOCATION Is Null Or h.LocationCode = :P683_LOCATION)
                     Group By h.PartyCode))
                 Where RNK <= 12
                 Order By RNK
                ```
            pageItemsToSubmit: [
                P683_FROMDATE
                P683_TODATE
                P683_COMPANY
                P683_LOCATION
                P683_PANEL
            ]
        }
        layout {
            sequence: 122
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No supplier billing in this period and scope.
        }

        column CUM_BAND (
            reportColumnQueryId: 6
            derivedColumn: N
            layout {
                sequence: 60
            }
            comments {
                comments: Bar colour token consumed by the CUM_PCT html expression. Hidden classic-report columns omit the heading block by contract.
            }
        )

        column CUM_PCT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Cumulative Share
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: FM990D0
            }
            columnFormatting {
                htmlExpression: <span class="ds-sharecell"><span class="ds-bar ds-bar--#CUM_BAND#"><i style="width:#CUM_PCT#%"></i></span><b>#CUM_PCT#%</b></span>
            }
            comments {
                comments: Running share. Banded red at or under 50% and amber at or under 80% because heavy concentration is a RISK — colour follows cost, not arithmetic.
            }
        )

        column PURCHASE_VALUE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Purchase Value
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            comments {
                comments: SUM(PurchaseBillDetail.Amount) for the supplier.
            }
        )

        column RNK (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Rank
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            comments {
                comments: Rank by descending value, tie-broken on PartyCode so the ordering is deterministic.
            }
        )

        column SHARE_PCT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Share %
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: FM990D0
            }
            comments {
                comments: This supplier's share of total value in scope.
            }
        )

        column SUPPLIER (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Supplier
            }
            layout {
                sequence: 20
            }
            comments {
                comments: Supplier name, pre-escaped in SQL.
            }
        )

    )

    region spend-trend (
        name: Spend Over Time
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ItemTree As (
                       Select ItemCode From Item
                        Where :P683_ITEMGROUP Is Not Null
                        Start With ItemCode = :P683_ITEMGROUP
                      Connect By Prior ItemCode = ParentCode
                       Union All
                       Select ItemCode From Item Where :P683_ITEMGROUP Is Null)
                Select
                  Case nvl(:P683_GRAIN,'MM')
                    When 'DD'   Then to_char(B,'DD-Mon')
                    When 'IW'   Then 'w/c ' || to_char(B,'DD-Mon')
                    When 'Q'    Then 'Q' || to_char(B,'Q') || ' ' || to_char(B,'RR')
                    When 'YYYY' Then to_char(B,'RRRR')
                    Else to_char(B,'Mon-RR')
                  End As BUCKET_LABEL,
                  VALUE_LAC,
                  B As SORT_KEY
                From (
                  Select Trunc(h.PurchaseBillDate, nvl(:P683_GRAIN,'MM')) B,
                         Round(Sum(d.Amount) / 100000, 2) VALUE_LAC
                    From PurchaseBill h
                    Join PurchaseBillDetail d On d.TNo = h.TNo
                   Where h.PurchaseBillDate
                         Between to_date(:P683_FROMDATE,'DD-MM-RRRR')
                             And to_date(:P683_TODATE,'DD-MM-RRRR')
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P683_PANEL Is Null Or h.Panel = :P683_PANEL)
                     And (:P683_COMPANY  Is Null Or h.CompanyCode  = :P683_COMPANY)
                     And (:P683_LOCATION Is Null Or h.LocationCode = :P683_LOCATION)
                     And (:P683_SUPPLIER Is Null Or h.PartyCode    = :P683_SUPPLIER)
                     And (:P683_ITEM     Is Null Or d.ItemCode     = :P683_ITEM)
                     And d.ItemCode In (Select ItemCode From ItemTree)
                   Group By Trunc(h.PurchaseBillDate, nvl(:P683_GRAIN,'MM')))
                Order By SORT_KEY
                ```
            pageItemsToSubmit: [
                P683_FROMDATE
                P683_TODATE
                P683_COMPANY
                P683_LOCATION
                P683_PANEL
                P683_SUPPLIER
                P683_ITEMGROUP
                P683_ITEM
                P683_GRAIN
            ]
        }
        layout {
            sequence: 115
            slot: body
            columnSpan: 3
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 270
        }
        messages {
            whenNoDataFound: No bills were booked in this period and scope, so there is nothing to plot.
        }

        series spend (
            name: Spend (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: BUCKET_LABEL
                value: VALUE_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region vendor-kpi (
        name: Vendor KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P683_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P683_TODATE,'DD-MM-RRRR')   T
                         From dual),
                -- DELIVERY. Grain is the ORDER: this application carries the order
                -- reference on the GRN HEADER (Grn.PurchaseOrderTNo). GrnDetail has no
                -- PurchaseOrderTno, so the blueprint's order-LINE match is not possible.
                Ord As (
                  Select o.TNo, o.PartyCode, o.DeliveryDate,
                         (Select Min(g.GrnDate) From Grn g
                           Where g.PurchaseOrderTNo = o.TNo) FirstGrn
                    From PurchaseOrder o Cross Join Win w
                   Where o.PurchaseOrderDate Between w.F And w.T
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P683_PANEL Is Null Or o.Panel = :P683_PANEL)
                     And (:P683_COMPANY  Is Null Or o.CompanyCode  = :P683_COMPANY)
                     And (:P683_LOCATION Is Null Or o.LocationCode = :P683_LOCATION)
                     And (:P683_SUPPLIER Is Null Or o.PartyCode    = :P683_SUPPLIER)),
                Deliv As (
                  -- Orders with no delivery date or no receipt are EXCLUDED, not assumed
                  -- on time. Counting them as on time would flatter the figure.
                  Select Count(*) Legs,
                         Sum(Case When DeliveryDate >= FirstGrn Then 1 Else 0 End) OnTime,
                         Avg(FirstGrn - DeliveryDate) AvgLateDays
                    From Ord
                   Where DeliveryDate Is Not Null And FirstGrn Is Not Null),
                Pay As (
                  Select Sum(-vd.Amount) Paid
                    From Voucher v
                    Join VoucherDetail vd On vd.TNo = v.TNo
                   Cross Join Win w
                   Where v.DocTypeCode = 'PAYMENT'
                     And vd.Amount < 0
                     And v.VoucherDate Between w.F And w.T
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or v.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P683_PANEL Is Null Or v.Panel = :P683_PANEL)
                     And (:P683_COMPANY Is Null Or v.CompanyCode = :P683_COMPANY)),
                Rej As (
                  Select Count(Distinct g.TNo) RejGrns
                    From Grn g
                    Join GrnDetail gd On gd.TNo = g.TNo
                   Cross Join Win w
                   Where g.GrnDate Between w.F And w.T
                     And nvl(gd.RejectedQuantity1,0) > 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or g.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P683_PANEL Is Null Or g.Panel = :P683_PANEL)
                     And (:P683_COMPANY Is Null Or g.CompanyCode = :P683_COMPANY))
                Select
                  '<div class="ds-kpi ds-kpi--ok" title="Orders whose DeliveryDate is on or '
                  || 'after the earliest GRN against that order. Grain is the ORDER, not the '
                  || 'order line — GrnDetail carries no order reference in this application.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-clock-o"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">On-Time Delivery</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(dv.Legs,0) = 0 Then 'n/a'
                             Else to_char(Round(100 * dv.OnTime / dv.Legs,1),'FM99999990D0') || '%'
                        End || '</span>'
                  || '<span class="ds-kpi-sub">'
                     || Case When nvl(dv.Legs,0) = 0
                             Then '<span class="ds-muted">no order carries both a delivery '
                                  || 'date and a receipt</span>'
                             Else 'measured on ' || to_char(dv.Legs,'FM999G999')
                                  || ' scheduled orders' End
                  || '</span></span></div>' As KPI1,
                  '<div class="ds-kpi ds-kpi--risk" title="The complement of on-time over the '
                  || 'same measurable population.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-exclamation-triangle"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Late Deliveries</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(dv.Legs,0) = 0 Then 'n/a'
                             Else to_char(Round(100 * (dv.Legs - dv.OnTime) / dv.Legs,1),'FM99999990D0')
                                  || '%' End || '</span>'
                  || '<span class="ds-kpi-sub">'
                     || Case When nvl(dv.Legs,0) = 0 Then 'not measurable'
                             Else to_char(dv.Legs - dv.OnTime,'FM999G999') || ' orders late'
                        End || '</span>'
                  || '</span></div>' As KPI2,
                  '<div class="ds-kpi ds-kpi--move" title="Average days between the promised '
                  || 'delivery date and the earliest receipt. A value at or below zero means '
                  || 'goods arrived on or before the promise — or the order was raised '
                  || 'retrospectively, which is normal for bulk commodity buying.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-calendar"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Avg Days vs Promise</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When dv.AvgLateDays Is Null Then 'n/a'
                             Else to_char(Round(dv.AvgLateDays,1),'FM99999990D0') End
                     || '</span>'
                  || '<span class="ds-kpi-sub">negative means early or same-day</span>'
                  || '</span></div>' As KPI3,
                  '<div class="ds-kpi ds-kpi--suppl" title="SUM(-VoucherDetail.Amount) on '
                  || 'PAYMENT vouchers, negative supplier leg. Period figure — no route in '
                  || 'this ERP ties a payment voucher to an individual bill.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-credit-card"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Paid to Suppliers</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(py.Paid,0) >= 10000000
                             Then 'Rs ' || to_char(Round(py.Paid/10000000,2),'FM99G990D00') || ' Cr'
                             When nvl(py.Paid,0) >= 100000
                             Then 'Rs ' || to_char(Round(py.Paid/100000,2),'FM99G990D00') || ' L'
                             Else 'Rs ' || to_char(nvl(py.Paid,0),'FM99G99G990D00') End
                     || '</span>'
                  || '<span class="ds-kpi-sub">PAYMENT vouchers only in this application</span>'
                  || '</span></div>' As KPI4,
                  '<div class="ds-kpi ds-kpi--exc" title="Receipts carrying a rejected '
                  || 'quantity. Reported as a COUNT of affected receipts, not a percentage — '
                  || 'a rejection rate reads as zero for nearly every vendor and hides the '
                  || 'ones that matter.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-times-circle-o"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Receipts with Rejection</span>'
                  || '<span class="ds-kpi-n">' || to_char(nvl(rj.RejGrns,0),'FM999G999') || '</span>'
                  || '<span class="ds-kpi-sub">count of affected GRNs, never a rate</span>'
                  || '</span></div>' As KPI5
                From Deliv dv Cross Join Pay py Cross Join Rej rj
                ```
            pageItemsToSubmit: [
                P683_FROMDATE
                P683_TODATE
                P683_COMPANY
                P683_LOCATION
                P683_PANEL
                P683_SUPPLIER
            ]
        }
        layout {
            sequence: 132
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                ds-kpiwrap--5up
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No vendor activity in this period and scope.
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: On-time delivery. ORDER grain in this application, not order-line grain — see the page help text.
            }
        )

        column KPI2 (
            reportColumnQueryId: 2
            derivedColumn: N
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Late deliveries, complement of on-time over the same measurable population.
            }
        )

        column KPI3 (
            reportColumnQueryId: 3
            derivedColumn: N
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Average days between promise and earliest receipt. The card explains a zero-or-below value rather than leaving it puzzling.
            }
        )

        column KPI4 (
            reportColumnQueryId: 4
            derivedColumn: N
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Ledger-based paid figure. PAYMENT doc type only in this application.
            }
        )

        column KPI5 (
            reportColumnQueryId: 5
            derivedColumn: N
            layout {
                sequence: 50
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Rejection reported as a count of affected receipts, never a per-vendor percentage.
            }
        )

    )

    region vendor-late (
        name: Worst Late Deliverers
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select * From (
                  Select GetPartyName(PartyCode) SUPPLIER,
                         Round(100 * (Orders - OnTime) / Orders, 1) LATE_PCT
                    From (
                      Select PartyCode,
                             Count(*) Orders,
                             Sum(Case When DeliveryDate >= FirstGrn Then 1 Else 0 End) OnTime
                        From (
                          Select o.PartyCode, o.DeliveryDate,
                                 (Select Min(g.GrnDate) From Grn g
                                   Where g.PurchaseOrderTNo = o.TNo) FirstGrn
                            From PurchaseOrder o
                           Where o.PurchaseOrderDate
                                 Between to_date(:P683_FROMDATE,'DD-MM-RRRR')
                                     And to_date(:P683_TODATE,'DD-MM-RRRR')
                             And o.DeliveryDate Is Not Null
                             And ((Select GetUserPanelAB_apex() From dual) Is Null
                                  Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                             And (:P683_PANEL Is Null Or o.Panel = :P683_PANEL)
                             And (:P683_COMPANY Is Null Or o.CompanyCode = :P683_COMPANY))
                       Where FirstGrn Is Not Null
                       Group By PartyCode
                      Having Count(*) >= 10
                         And Sum(Case When DeliveryDate >= FirstGrn Then 1 Else 0 End)
                             < Count(*))
                   Order By (Orders - OnTime) / Orders Desc)
                 Where rownum <= 10
                ```
            pageItemsToSubmit: [
                P683_FROMDATE
                P683_TODATE
                P683_COMPANY
                P683_PANEL
            ]
        }
        layout {
            sequence: 140
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 380
        }
        messages {
            whenNoDataFound: No supplier with at least ten scheduled orders delivered late in this period.
        }

        series late (
            name: Late %
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: SUPPLIER
                value: LATE_PCT
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Late %
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region vendor-price (
        name: Purchase Price Movement
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ItemTree As (
                       Select ItemCode From Item
                        Where :P683_ITEMGROUP Is Not Null
                        Start With ItemCode = :P683_ITEMGROUP
                      Connect By Prior ItemCode = ParentCode
                       Union All
                       Select ItemCode From Item Where :P683_ITEMGROUP Is Null),
                -- Realised rate per item, unit and month. Money divided by quantity —
                -- never an average of the stored Rate column, which mixes rate bases.
                M As (
                  Select d.ItemCode,
                         nvl(d.RateMeasuringUnitCode,'~NONE~') Uom,
                         Trunc(h.PurchaseBillDate,'MM') Mth,
                         Sum(d.Amount) Amt,
                         Sum(d.Quantity1) Qty
                    From PurchaseBill h
                    Join PurchaseBillDetail d On d.TNo = h.TNo
                   Where h.PurchaseBillDate
                         Between to_date(:P683_FROMDATE,'DD-MM-RRRR')
                             And to_date(:P683_TODATE,'DD-MM-RRRR')
                     And nvl(d.Quantity1,0) > 0
                     And nvl(d.Amount,0)    > 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P683_PANEL Is Null Or h.Panel = :P683_PANEL)
                     And (:P683_COMPANY  Is Null Or h.CompanyCode  = :P683_COMPANY)
                     And (:P683_LOCATION Is Null Or h.LocationCode = :P683_LOCATION)
                     And d.ItemCode In (Select ItemCode From ItemTree)
                   Group By d.ItemCode, nvl(d.RateMeasuringUnitCode,'~NONE~'),
                            Trunc(h.PurchaseBillDate,'MM')),
                A As (
                  Select ItemCode, Uom,
                         Count(*) Months,
                         Sum(Amt) Spend,
                         Min(Amt/Qty) KEEP (DENSE_RANK FIRST Order By Mth) FirstRate,
                         Max(Amt/Qty) KEEP (DENSE_RANK LAST  Order By Mth) LastRate
                    From M
                   Group By ItemCode, Uom
                  Having Count(*) >= 2 And Sum(Amt) >= 5000000)
                Select * From (
                  Select
                    apex_escape.html(nvl((Select i.ItemName From Item i
                                           Where i.ItemCode = a.ItemCode), a.ItemCode))
                      || ' <span class="ds-muted">'
                      || apex_escape.html(nvl((Select m.MeasuringUnitName From MeasuringUnit m
                                                Where m.MeasuringUnitCode = a.Uom),
                                              'no unit')) || '</span>' As ITEM,
                    Round(a.FirstRate,2) As FIRST_RATE,
                    Round(a.LastRate,2)  As LAST_RATE,
                    Round(a.Spend/100000,2) As SPEND_LAC,
                    -- A RISE is adverse, so it takes the DOWN (red) chip. The business
                    -- meaning on screen wins over the arithmetic direction of the number.
                    Case
                      When a.LastRate > a.FirstRate
                      Then '<span class="ds-delta ds-delta--down">&uarr; '
                           || to_char(Round(100*(a.LastRate-a.FirstRate)/a.FirstRate,1),'FM99999990D0')
                           || '%</span>'
                      When a.LastRate < a.FirstRate
                      Then '<span class="ds-delta ds-delta--up">&darr; '
                           || to_char(Round(100*(a.FirstRate-a.LastRate)/a.FirstRate,1),'FM99999990D0')
                           || '%</span>'
                      Else '<span class="ds-delta ds-delta--flat">no change</span>'
                    End As MOVEMENT,
                    Abs(a.LastRate - a.FirstRate) / a.FirstRate As SORTKEY
                  From A a
                 Order By SORTKEY Desc)
                 Where rownum <= 12
                ```
            pageItemsToSubmit: [
                P683_FROMDATE
                P683_TODATE
                P683_COMPANY
                P683_LOCATION
                P683_PANEL
                P683_ITEMGROUP
            ]
        }
        layout {
            sequence: 142
            slot: body
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No item carries material spend across at least two months in this period, so no price movement can be measured.
        }

        column FIRST_RATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: First Month
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
