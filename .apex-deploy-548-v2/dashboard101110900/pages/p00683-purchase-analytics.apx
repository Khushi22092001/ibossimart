    region item-procurement (
        name: Item Procurement Analysis
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ItemTree As (
                       Select ItemCode From Item
                        Where :P683_ITEMGROUP Is Not Null
                        Start With ItemCode = :P683_ITEMGROUP
                      Connect By Prior ItemCode = ParentCode
                       Union All
                       Select ItemCode From Item Where :P683_ITEMGROUP Is Null),
                L As (
                  Select h.TNo BillTno, h.PurchaseBillDate BillDate, h.PartyCode,
                         d.ItemCode,
                         nvl(d.RateMeasuringUnitCode,'~NONE~') Uom,
                         d.Amount Amt, d.Quantity1 Qty
                    From PurchaseBill h
                    Join PurchaseBillDetail d On d.TNo = h.TNo
                   Where h.PurchaseBillDate
                         Between to_date(:P683_FROMDATE,'DD-MM-RRRR')
                             And to_date(:P683_TODATE,'DD-MM-RRRR')
                     And nvl(d.Quantity1,0) > 0
                     And nvl(d.Amount,0)    > 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P683_PANEL Is Null Or h.Panel = :P683_PANEL)
                     And (:P683_COMPANY  Is Null Or h.CompanyCode  = :P683_COMPANY)
                     And (:P683_LOCATION Is Null Or h.LocationCode = :P683_LOCATION)
                     And (:P683_ITEM     Is Null Or d.ItemCode     = :P683_ITEM)
                     And d.ItemCode In (Select ItemCode From ItemTree)),
                B As (
                  Select ItemCode, Uom, BillTno, BillDate,
                         Sum(Amt) Amt, Sum(Qty) Qty,
                         Sum(Amt) / Sum(Qty) BillRate
                    From L
                   Group By ItemCode, Uom, BillTno, BillDate),
                A As (
                  Select ItemCode, Uom,
                         Count(*) Bills,
                         Sum(Amt) Spend,
                         Sum(Qty) Qty,
                         Sum(Amt) / Sum(Qty) AvgRate,
                         Min(BillRate) MinRate,
                         Max(BillRate) MaxRate,
                         -- Deterministic "most recent rate" even when several bills share
                         -- a date: the tie is broken on BillTno.
                         Max(BillRate) KEEP (DENSE_RANK LAST
                                             Order By BillDate, BillTno) LastRate,
                         Max(BillDate) LastBuy
                    From B
                   Group By ItemCode, Uom),
                Vend As (
                  Select ItemCode, Uom, Count(Distinct PartyCode) Vendors
                    From L Group By ItemCode, Uom)
                Select
                  a.ItemCode As ITEMCODE,
                  -- Carried as the SECOND half of the drill key to Item 360. Already
                  -- sentinel-wrapped by CTE L, so a line with no unit travels as '~NONE~'
                  -- and lands on its own group there rather than being read as "all units".
                  a.Uom As UOMCODE,
                  nvl((Select i.ItemName From Item i Where i.ItemCode = a.ItemCode),
                      a.ItemCode) As ITEM,
                  nvl((Select m.MeasuringUnitName From MeasuringUnit m
                        Where m.MeasuringUnitCode = a.Uom),
                      'No unit recorded') As UOM,
                  a.Bills As BILLS,
                  vn.Vendors As VENDORS,
                  a.Qty As QUANTITY,
                  a.Spend As SPEND,
                  Round(a.AvgRate,2) As AVG_RATE,
                  Round(a.MinRate,2) As MIN_RATE,
                  Round(a.MaxRate,2) As MAX_RATE,
                  Round(a.LastRate,2) As LAST_RATE,
                  Case When a.MinRate > 0
                       Then Round(100 * (a.MaxRate - a.MinRate) / a.MinRate, 1) End
                    As SPREAD_PCT,
                  a.LastBuy As LAST_BUY
                From A a
                Join Vend vn On vn.ItemCode = a.ItemCode And vn.Uom = a.Uom
                Order By a.Spend Desc
                ```
            pageItemsToSubmit: [
                P683_FROMDATE
                P683_TODATE
                P683_COMPANY
                P683_LOCATION
                P683_PANEL
                P683_ITEMGROUP
                P683_ITEM
            ]
        }
        layout {
            sequence: 155
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No item was billed with both a quantity and a value in this period and scope.
        }
        advanced {
            savedReportMappingIdentifier: 21556827939436316
        }

        column AVG_RATE (
            type: plainText
            heading {
                heading: Avg Realised Rate
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
            comments {
                comments: Total money divided by total quantity — a VALUE-WEIGHTED mean, not an average of per-bill rates. Averaging rates would weight a 1 kg bill like a 40 MT one.
            }
        )

        column BILLS (
            type: plainText
            heading {
                heading: Bills
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Purchase frequency — how many bills carried this item in this unit.
            }
        )

        column ITEM (
            type: link
            heading {
                heading: Item
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 679
                    items: {
                        P679_ITEMCODE: #ITEMCODE#
                        P679_UOM: #UOMCODE#
                        P679_FROMDATE: &P683_FROMDATE.
                        P679_TODATE: &P683_TODATE.
                        P679_COMPANY: &P683_COMPANY.
                        P679_LOCATION: &P683_LOCATION.
                        P679_PANEL: &P683_PANEL.
                    }
                    clearCache: 679
                    debug: NO
                }
                linkText: #ITEM#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            comments {
                comments: Drills to Item 360 (page 679) on BOTH halves of the grain — item and unit — so the target opens on exactly the row clicked and its figures reconcile to this one. The supplier filter is deliberately not carried, because the vendor comparison there must show every vendor.
            }
        )

        column ITEMCODE (
            type: hidden
            heading {
                heading: Item Code
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
            comments {
                comments: Technical drill key. Never displayed.
            }
        )

        column LAST_BUY (
            type: plainText
            heading {
                heading: Last Buy
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-RRRR
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: N
            }
            comments {
                comments: Date of the most recent bill carrying this item and unit.
            }
        )

        column LAST_RATE (
            type: plainText
            heading {
                heading: Last Rate
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
            comments {
                comments: Most recent per-bill rate, resolved deterministically with KEEP DENSE_RANK LAST on bill date then bill key.
            }
        )

        column MAX_RATE (
            type: plainText
            heading {
                heading: Highest
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
            comments {
                comments: Dearest per-BILL realised rate.
            }
        )

        column MIN_RATE (
            type: plainText
            heading {
                heading: Lowest
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
            comments {
                comments: Cheapest per-BILL realised rate.
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G990D000
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
            comments {
                comments: Meaningful only within the row's own unit. Never sum this column across rows.
            }
        )

        column SPEND (
            type: plainText
            heading {
                heading: Spend
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
            comments {
                comments: SUM(PurchaseBillDetail.Amount) for this item and unit.
            }
        )

        column SPREAD_PCT (
            type: plainText
            heading {
                heading: Spread %
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: FM9990D0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
            comments {
                comments: Highest against lowest realised rate. A wide spread on a high-spend item is worth investigating.
            }
        )

        column UOM (
            type: plainText
            heading {
                heading: Unit
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Rate unit. Part of the grain — rates across units are not comparable, so each unit is its own row.
            }
        )

        column UOMCODE (
            type: hidden
            heading {
                heading: Unit Code
            }
            layout {
