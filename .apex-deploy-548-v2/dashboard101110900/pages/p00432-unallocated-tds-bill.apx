page 432 (
    name: Unallocated TDS Bill
    alias: UNALLOCATED-TDS-BILL
    title: Unallocated TDS Bill
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     c.CompanyName,
                     b.LocationName,
                     a.BillNo,
                     a.BillDate,
                     a.DFreightBillReceiptNo,
                     a.BillAmount,
                     a.TDSAmount,
                     a.TDSAllocatedAmount,
                     a.BalanceTDSAmount
                From BillWithTDSDetail a, Location b, Company c
                Where a.LocationCode = b.LocationCode
                and a.CompanyCode = c.CompanyCode
                and a.BalanceTDSAmount > 0
                and a.BillDate Between :P432_FROMDATE and :P432_TODATE;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 42522637856454511
        }

        column BALANCETDSAMOUNT (
            type: plainText
            heading {
                heading: Balance TDS Amount
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column BILLAMOUNT (
            type: plainText
            heading {
                heading: Bill Amount
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column BILLDATE (
            type: plainText
            heading {
                heading: Bill Date
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column BILLNO (
            type: plainText
            heading {
                heading: Bill No
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COMPANYNAME (
            type: plainText
            heading {
                heading: Company Name
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DFREIGHTBILLRECEIPTNO (
            type: plainText
            heading {
                heading: DFreight Bill Receipt No
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TDSALLOCATEDAMOUNT (
            type: plainText
            heading {
                heading: TDS Allocated Amount
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column TDSAMOUNT (
            type: plainText
            heading {
                heading: TDS Amount
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 452387 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BALANCETDSAMOUNT (
                sequence: 9
            )

            displayColumn BILLAMOUNT (
                sequence: 6
            )

            displayColumn BILLDATE (
                sequence: 4
            )

            displayColumn BILLNO (
                sequence: 3
            )

            displayColumn COMPANYNAME (
                sequence: 1
            )

            displayColumn DFREIGHTBILLRECEIPTNO (
                sequence: 5
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn TDSALLOCATEDAMOUNT (
                sequence: 8
            )

            displayColumn TDSAMOUNT (
                sequence: 7
            )

        )

    )

    region unallocated-tds-bill (
        name: Unallocated TDS Bill
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P432_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @unallocated-tds-bill
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 5
            columnCssClasses: 1
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P432_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @unallocated-tds-bill
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            columnCssClasses: 1
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 30
            region: @unallocated-tds-bill
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

