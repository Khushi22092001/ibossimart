                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                c.EmployeeName d,
                c.EmployeeCode r
                From Employee c
                Where exists
                (Select
                    a.Tno
                    From EmployeeDeployment a, EmployeeDeploymentDetail b
                    Where a.Tno = b.Tno
                     and b.EmployeeCode = c.EmployeeCode)
                Order by 1
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @employee-deployment-report
            slot: regionBody
            alignment: left
            startNewRow: false
