page 407 (
    name: Employee Deployment Report
    alias: EMPLOYEE-DEPLOYMENT-REPORT
    title: Employee Deployment Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employee-deployment-report (
        name: Employee Deployment Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                   row_number() over(order by d.EmployeeName) SerialNo,
                   c.LocationName,
                   a.EmployeeDeploymentNo,
                   a.EmployeeDeploymentDate,
                   a.EffectiveDate,
                   d.EmployeeName,
                   d.EmployeeID,
                   e.CompanyName as OldCompanyName,
                   f.CompanyName as NewCompanyName,
                   g.LocationName as OldLocationName,
                   h.LocationName as NewLocationName,
                   i.DepartmentName as OldDepartmentName,
                   j.DepartmentName as NewDepartmentName,
                   k.DesignationName as OldDesignationName,
                   l.DesignationName as NewDesignationName
                From EmployeeDeployment a, EmployeeDeploymentDetail b, Location c, Employee d, Company e, Company f, Location g, Location h, Department i,
                Department j, Designation k, Designation l
                Where a.Tno = b.Tno(+)
                  and a.LocationCode = c.LocationCode(+)
                  and b.EmployeeCode = d.EmployeeCode(+)
                  and a.CompanyCode = e.CompanyCode(+)
                  and b.NewCompanyCode = f.CompanyCode(+)
                  and a.LocationCode = g.LocationCode(+)
                  and b.NewLocationCode = h.LocationCode(+)
                  and d.DepartmentCode = i.DepartmentCode(+)
                  and b.NewDepartmentCode = j.DepartmentCode(+)
                  and d.DesignationCode = k.DesignationCode(+)
                  and b.NewDesignationCode = l.DesignationCode(+)
                and a.EmployeeDeploymentDate between :P407_FROMDATE and :P407_TODATE
                and ( :P407_COMPANY IS NULL OR instr(':'||:P407_COMPANY||':',':'||a.CompanyCode||':') > 0)
                and ( :P407_LOCATION IS NULL OR instr(':'||:P407_LOCATION||':',':'||a.LocationCode||':') > 0)
                and ( :P407_EMPLOYEE IS NULL OR instr(':'||:P407_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0)
                and :P407_FROMDATE is not null
                
                ```
            pageItemsToSubmit: [
                P407_COMPANY
                P407_FROMDATE
                P407_TODATE
                P407_LOCATION
                P407_EMPLOYEE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 87850387035768846
        }

