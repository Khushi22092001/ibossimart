    button custom (
        buttonName: CUSTOM
        label: Custom
        layout {
            sequence: 10
            region: @pending-freight-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/materialoutregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P160_FROMDATE=&P160_FROMDATE.&P160_TODATE=&P160_TODATE.&P160_LOCATION=&P160_LOCATION.&P160_DOCTYPE=&P160_DOCTYPE.&P160_ITEM=&P160_ITEM.&P160_ITEMSPECIFICATION=&P160_ITEMSPECIFICATION.&P160_TRANSPORTER=&P160_TRANSPORTER.&P160_PARTY=&P160_PARTY.&P160_VEHICLENO=&P160_VEHICLENO.&P160_MONO=&P160_MONO.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 1
        }
    )

