    region transporter-party-item-wise (
        name: Transporter-Party-Item Wise
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Case
                         When ROW_NUMBER()
                          Over(Partition By C.PARTYNAME Order By C.PARTYNAME) = 1 Then
                          C.PARTYNAME
                         Else
                          Null
                       End TRANSPORTERNAME,
                       -- C.PARTYNAME As TRPT,
                       Case
                         When ROW_NUMBER() Over(Partition By C.PARTYNAME,
                                   B.PARTYNAME Order By C.PARTYNAME,
                                   B.PARTYNAME) = 1 Then
                          B.PARTYNAME
                         Else
                          Null
                       End PARTYNAME,
                       --  B.PARTYNAME,
                       Case
                         When ROW_NUMBER() Over(Partition By C.PARTYNAME,
                                   B.PARTYNAME,
                                   A.ITEMNAME Order By C.PARTYNAME,
                                   B.PARTYNAME,
                                   A.ITEMNAME) = 1 Then
                          A.ITEMNAME
                         Else
                          Null
                       End ITEMNAME,
                       
                       --       A.ITEMNAME,
                       a.GRNNO,
                       a.GRNDATE,
                       a.VEHICLENO,
                       a.FREIGHTUNITCODE,
                       a.QUANTITY,
                       d.measuringunitcode1 As UOM,
                       a.FREIGHTRATE,
                       a.FREIGHTAMOUNT
                  From GRNFORFREIGHTWITHITEM a, party b, party c, item d
                 Where a.partyCode = b.PartyCode(+)
                   And a.transportercode = c.partycode(+)
                   And a.itemcode = d.itemcode(+)
                    and trunc(a.GRNDate) between :P160_FROMDATE and :P160_TODATE
                  and instr(':'||:P160_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P160_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P160_DOCTYPE||':',':'||a.ModuleCode||':') > 0
                  and a.VehicleNo like nvl(:P160_VEHICLENO,'%')
                  and ( :P160_TRANSPORTER IS NULL OR instr(':'||:P160_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 )
                  and ( :P160_PARTY IS NULL OR instr(':'||:P160_PARTY||':',':'||a.PartyCode||':') > 0 )
                  and ( :P160_ITEM IS NULL OR instr(':'||:P160_ITEM||':',':'||a.ItemCode||':') > 0 )
                
                 Order By C.PARTYNAME, B.PARTYNAME, A.ITEMNAME
                
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
