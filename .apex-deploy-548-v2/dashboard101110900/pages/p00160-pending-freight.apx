    region pending-freight-report (
        name: Pending Freight Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.MODULECODE,
                       a.TNO,
                       a.COMPANYCODE,
                       a.LOCATIONCODE,
                       a.DOCTYPECODE,
                       a.GRNNO,
                       a.GRNDATE,
                       a.PARTYCODE,
                       a.TRANSPORTERCODE,
                       a.VEHICLENO,
                       a.LRNO,
                       a.LRDATE,
                       a.FREIGHTTYPECODE,
                       a.FREIGHTUNITCODE,
                       a.INCLUDEINPURCHASEBILL,
                       a.ITEMCODE,
                       a.ITEMSPECIFICATIONCODE,
                       a.ITEMNAME,
                       a.ITEMSPECIFICATIONNAME,
                       a.FREIGHTAMOUNT,
                       a.QUANTITY,
                       a.FREIGHTRATE,
                       b.PartyName,
                       c.partyname as TransporterName,
                       d.measuringunitcode1 as UOM
                  from GRNFORFREIGHTWITHITEM a,
                       party b,
                       party c,
                       item d
                  Where a.partyCode = b.PartyCode(+)
                    and a.transportercode = c.partycode(+)
                    and a.itemcode = d.itemcode(+)
                    and trunc(a.GRNDate) between :P160_FROMDATE and :P160_TODATE
                  and instr(':'||:P160_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P160_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P160_DOCTYPE||':',':'||a.ModuleCode||':') > 0
                  and a.VehicleNo like nvl(:P160_VEHICLENO,'%')
                  and ( :P160_TRANSPORTER IS NULL OR instr(':'||:P160_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 )
                  and ( :P160_PARTY IS NULL OR instr(':'||:P160_PARTY||':',':'||a.PartyCode||':') > 0 )
                  and ( :P160_ITEM IS NULL OR instr(':'||:P160_ITEM||':',':'||a.ItemCode||':') > 0 )
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
