    pageItem P160_VEHICLENO (
        type: textFieldWithAutocomplete
        label {
            label: Vehicle No
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnType: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        a.VehicleNo
                From GRN a, FreightAdviceDetail b
                Where a.TNo = b.ModuleTNo
                Union All
                Select
                        Distinct
                        a.VehicleNo
                From CCInvoice a, FreightAdviceDetail b
                Where a.TNo = b.ModuleTNo
                Union All
                Select
                        Distinct
                        a.VehicleNo
                From Gatepass a, FreightAdviceDetail b
                Where a.TNo = b.ModuleTNo
                ```
        }
