    region itemwise-transporter-party-wise (
        name: "Itemwise -Transporter-Party-Wise "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Case
                         When ROW_NUMBER()
                          Over(Partition By A.ITEMNAME Order By A.ITEMNAME) = 1 Then
                          A.ITEMNAME
                         Else
                          Null
                       End ITEMNAME,
                       -- C.PARTYNAME As TRPT,
                       Case
                         When ROW_NUMBER() Over(Partition By A.ITEMNAME,
                                   C.PARTYNAME Order By A.ITEMNAME,
                                   C.PARTYNAME) = 1 Then
                          C.PARTYNAME
                         Else
                          Null
                       End TRANSPORTERNAME,
                       --  B.PARTYNAME,
                       Case
                         When ROW_NUMBER() Over(Partition By A.ITEMNAME,
                                   C.PARTYNAME,
                                   B.PARTYNAME Order By A.ITEMNAME,
                                   C.PARTYNAME,
                                   B.PARTYNAME) = 1 Then
                          B.PARTYNAME
                         Else
                          Null
                       End PARTYNAME,
                       
                       --       A.ITEMNAME,
                       a.GRNNO,
                       a.GRNDATE,
                       a.VEHICLENO,
                       a.FREIGHTUNITCODE,
                       a.QUANTITY,
                       d.measuringunitcode1 As UOM,
                       a.FREIGHTRATE,
                       a.FREIGHTAMOUNT
                  From GRNFORFREIGHTWITHITEM a, party b, party c, item d
                 Where a.partyCode = b.PartyCode(+)
                   And a.transportercode = c.partycode(+)
                   And a.itemcode = d.itemcode(+)
                    and trunc(a.GRNDate) between :P160_FROMDATE and :P160_TODATE
                  and instr(':'||:P160_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P160_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P160_DOCTYPE||':',':'||a.ModuleCode||':') > 0
                  and a.VehicleNo like nvl(:P160_VEHICLENO,'%')
                  and ( :P160_TRANSPORTER IS NULL OR instr(':'||:P160_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 )
                  and ( :P160_PARTY IS NULL OR instr(':'||:P160_PARTY||':',':'||a.PartyCode||':') > 0 )
                  and ( :P160_ITEM IS NULL OR instr(':'||:P160_ITEM||':',':'||a.ItemCode||':') > 0 )
                
                 Order By A.ITEMNAME, C.PARTYNAME, B.PARTYNAME
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID1
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 12114646056885848
        }

