            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      l.PartyName d,
                      l.PartyCode r
                from dfreightbillreceipt a, party l
                where a.depoCode = l.PartyCode(+)
                Order By 1
                ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @daily-bill-receipt-report-2
