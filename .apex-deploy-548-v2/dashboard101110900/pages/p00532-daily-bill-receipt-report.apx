    pageItem P532_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.CompanyName d,
                a.CompanyCode r
                From Company a
                Where exists(
                   Select
                      aa.CompanyCode
                   From DFreightBillReceipt aa
                   Where aa.companyCode = a.companyCode
                )
                Order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @daily-bill-receipt-report-2
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

