app DASHBOARD101110900 (
    name: DASHBOARD(UI DEVELOPMENT)
    logo {
        type: imageAndText
        imageUrl: #APP_FILES#icons/app-icon-32.png
        text: DASHBOARD
    }
    navigation {
        homeUrl: {
            page: &GLOBAL_PAGENO.
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            js-addActions
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @desktop-navigation-menu
    }
    navigationBar {
        list: @desktop-navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DD-MM-RRRR
        dateTime: DD-MM-YYYY HH:MIPM
        timestamp: DD-MM-YYYY HH:MIPM
        timestampTimeZone: DD-MM-YYYY HH.MI.SSXFF PM TZR
    }
    javaScript {
        fileUrls: "#APP_IMAGES#hspl-theme.js?version=#APP_VERSION#&cb=20260826b"
    }
    css {
        fileUrls: [
            "#APP_IMAGES#app-icon.css?version=#APP_VERSION#"
            "#APP_IMAGES#rupee.css?version=#APP_VERSION#"
            "#APP_IMAGES#app-icon.svg"
            "#APP_IMAGES#hspl-theme.css?version=#APP_VERSION#&cb=20260825h"
            "#APP_IMAGES#design-system.css?version=#APP_VERSION#&cb=20260825d"
        ]
    }
    authentication {
        scheme: @validatebossuser
        publicUser: APEX_PUBLIC_USER
    }
    security {
        referrerPolicy: strictOriginWhenCrossOrigin
    }
    sessionStateProtection {
        checksumSalt: 10AA84DD1EFFCB91F4F10CB1DE28A919192BBEF213C97CD2B64753BEC74C0438
        acceptPre202UrlChecksums: false
    }
    sessionManagement {
        sessionStateCommits: immediate
    }
    globalization {
        documentDirection: leftToRight
    }
    progressiveWebApp {
        installable: true
    }
    runtime {
        compatibilityMode: 21.2
        accessibleReadOnlyItems: false
    }
    advanced {
        passEcid: false
        modernizeApp: true
    }
    comments {
        comments: Application created from create application wizard 2021.04.02.
    }

    substitution APP_NAME (
        value {
            staticValue: DASHBOARD
        }
    )

)
