plugin pretiusApexNestedReports (
    name: Pretius APEX Nested Reports
    staticId: PRETIUS_APEX_NESTED_REPORTS
    type: dynamicAction
    component {
        standardAttributes: [
            forRegion
            forJquerySelector
            affectedElementRequired
        ]
    }
    callbacks {
        apiInterface: function
        renderProcedureName: #OWNER#.PRETIUS_APEX_NESTED_REPORTS.pretius_row_details
        ajaxProcedureName: #OWNER#.PRETIUS_APEX_NESTED_REPORTS.pretius_row_details_ajax
    }
    advanced {
        category: execute
        substituteAttributeValues: true
    }
    css {
        fileUrls: #PLUGIN_FILES#pretius_row_details_styles.css
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#pretius_main.js
            #PLUGIN_FILES#pretius_nestedreport.js
        ]
    }
    information {
        version: 2.0.2
        aboutUrl: http://apex.pretius.com/apex/f?p=PLUGINS:NESTED_REPORTS
        helpText:
            ```
            <p>
              The plugin is dynamic action plugin implementing nested reports within APEX Classic Reports, Interactive Reports and static HTML tables. Scope of data, data appearance and behavior is customizable with the plugin attributes.
            </p>
            <p>
              Author: <code>Bartosz Ostrowski</code><br/>
              E-mail: <code>bostrowski@pretius.com</code>, <code>ostrowski.bartosz@gmail.com</code><br/>
              Twitter: <code>@bostrowsk1</code><br/>
              Plugin home page: <code>http://apex.pretius.com/apex/f?p=PLUGINS:NESTED_REPORTS</code>
            </p>
            ```
    }
)

