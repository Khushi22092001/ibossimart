            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: COLLECTED_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Collected (₹ Lac)
            value {
