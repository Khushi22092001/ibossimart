page 911 (
    name: Receipts and Collections
    alias: AR-COLLECTIONS
    title: Receipts and Collections
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #APP_FILES#hspl-jet-l10n-fallback.js?version=#APP_VERSION#&cb=20260924a
    }
    htmlHeader {
        htmlHeader:
            ```html
            
            <script id="hspl-sidebar-head-state">
            (function(d){
              var state='closed';
              try {
                var saved=window.localStorage.getItem('imart.sidebar.state.v1');
                if(saved==='open'||saved==='closed') state=saved;
              } catch(ignore) {}
              d.classList.remove(state==='open'?'hspl-nav-target-closed':'hspl-nav-target-open');
              d.classList.add(state==='open'?'hspl-nav-target-open':'hspl-nav-target-closed');
            })(document.documentElement);
            </script>
            ```
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Collections are actual RECEIPT voucher lines posted to a customer account between From Date and To Date - never a fall in outstanding, which also moves through credit notes, journals and allocation. This page is a FLOW report: the As-of Date does not apply to it. Bank is derived from the contra (debit) account on the same receipt voucher, which resolves cleanly. Payment mode is NOT analysed: VoucherDetail.MoneyTransferModeCode is null on all 114,284 rows and the voucher header carries a mode on only 225 of 2,551 debtor receipts, so a mode chart would be a lie at 9% coverage.
    }

    region bank-mix (
        name: Collections by Bank
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Bank is the CONTRA account on the receipt voucher - the account that
                   was debited when the customer was credited. It is not stored on the
                   receipt line, and it is the only reliable banking dimension here.
                   The contra is aggregated per voucher before it is attributed, so a
                   receipt split across two banks is not double counted. */
                With Sd As (
                       Select PartyCode From Party
                        Start With PartyCode = 'SUNDRYDEBTORS'
                        Connect By Prior PartyCode = ParentCode),
                     Rv As (
                       Select Distinct d.Tno
                         From VoucherDetail d Join Voucher v On v.Tno = d.Tno
                        Where d.AccountCode In (Select PartyCode From Sd)
                          And v.DocTypeCode = 'RECEIPT'
                          And d.VoucherDate >= to_date(:P911_FROMDATE,'DD-MM-RRRR')
                          And d.VoucherDate <  to_date(:P911_TODATE,'DD-MM-RRRR') + 1
                          And (cast(null as varchar2(100)) Is Null
                               Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                          And (null    Is Null Or cast(null as varchar2(100))        = null)
                          And (:P911_COMPANY  Is Null Or d.CompanyCode  = :P911_COMPANY)
                          And (:P911_LOCATION Is Null Or d.LocationCode = :P911_LOCATION))
                Select * From (
                  Select nvl(p.PartyName, o.AccountCode) As LABEL,
                         Round(Sum(-o.Amount)/100000,2) As RECEIVED_LAC
                    From VoucherDetail o
                    Join Rv On Rv.Tno = o.Tno
                    Left Join Party p On p.PartyCode = o.AccountCode
                   Where o.Amount < 0
                     And o.AccountCode Not In (Select PartyCode From Sd)
                   Group By o.AccountCode, p.PartyName
                   Order By Sum(-o.Amount) Desc)
                 Where rownum <= 12
                 /* Outer Order By is required: the inner one only picks the twelve
                    rows, it does not survive to the result set. */
                 Order By RECEIVED_LAC Desc
                ```
            pageItemsToSubmit: [
                P911_FROMDATE
                P911_TODATE
                P911_COMPANY
                P911_LOCATION
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartLayout {
            height: 340
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: No receipt was banked in this period for the selected scope.
        }

        series received (
            name: Received (₹ Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: RECEIVED_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Received (₹ Lac)
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region command-header (
        name: Receipts and Collections
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-ar-head">'
                    || '<div class="ds-ar-eyebrow">Receivables &middot; Collections</div>'
                    || '<h1 class="ds-ar-title">Receipts &amp; Collections</h1>'
                    || '<div class="ds-ar-sub">Cash actually received from customers in the period, which bank took it, and how much of it has been applied to a bill</div>'
                    || '<div class="ds-ar-context">'
                    || '<span class="ds-ar-chip"><span class="fa fa-calendar"></span>Receipts <b>'
                       || :P911_FROMDATE || ' &rarr; ' || :P911_TODATE || '</b></span>'
                    || '<span class="ds-ar-chip"><span class="fa fa-info-circle"></span><b>Flow report</b> &mdash; not an as-at balance</span>'
                    || '<span class="ds-ar-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P911_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-ar-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P911_LOCATION),'All locations')) || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
            pageItemsToSubmit: [
                P911_FROMDATE
                P911_TODATE
                P911_COMPANY
                P911_LOCATION
            ]
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-ar-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region daily-trend (
        name: Daily Collection Trend
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Sd As (
                       Select PartyCode From Party
                        Start With PartyCode = 'SUNDRYDEBTORS'
                        Connect By Prior PartyCode = ParentCode)
                Select to_char(d.VoucherDate,'DD-Mon') As LABEL,
                       Round(Sum(d.Amount)/100000,2)   As COLLECTED_LAC
                  From VoucherDetail d Join Voucher v On v.Tno = d.Tno
                 Where d.AccountCode In (Select PartyCode From Sd)
                   And v.DocTypeCode = 'RECEIPT'
                   And d.VoucherDate >= to_date(:P911_FROMDATE,'DD-MM-RRRR')
                   And d.VoucherDate <  to_date(:P911_TODATE,'DD-MM-RRRR') + 1
                   And (cast(null as varchar2(100)) Is Null
                        Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                   And (null    Is Null Or cast(null as varchar2(100))        = null)
                   And (:P911_COMPANY  Is Null Or d.CompanyCode  = :P911_COMPANY)
                   And (:P911_LOCATION Is Null Or d.LocationCode = :P911_LOCATION)
                 Group By d.VoucherDate
                 Order By d.VoucherDate
                ```
            pageItemsToSubmit: [
                P911_FROMDATE
                P911_TODATE
                P911_COMPANY
                P911_LOCATION
            ]
        }
        layout {
            sequence: 32
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: line
        }
        chartLayout {
            height: 340
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: No collection in this period for the selected scope.
        }

        series collected (
            name: Collected (₹ Lac)
            execution {
