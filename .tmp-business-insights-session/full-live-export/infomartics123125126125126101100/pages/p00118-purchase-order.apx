                       AND A.STATUSPRIVILEGE = 'YES'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

    )

    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 100
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P118_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P118_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P118_TNO,:P118_STATUS);
                    
                    declare
                        tpaymentadvice number;
                    
                    begin
                        SELECT COUNT(A.TNO) INTO tpaymentadvice
                    	FROM PAYMENTADVICE A
                    	WHERE A.MODULETNO = :P118_TNO ;
                    
                        if nvl(tpaymentadvice, 0) = 0 then
                            if :P118_STATUS = 'ACTIVE' then
                            
                                CREATEPAYMENTADVICEFORPO(:P118_TNO);
                    
                            end if;
                    
                        end if;
                    --RAISE_APPLICATION_ERROR(-20005,' STATUS '||:P118_STATUS||' ISOPEN '||:P118_ISOPENSPEC);
                        if :P118_STATUS = 'ACTIVE' and nvl(:P118_ISOPENSPEC,'NO') = 'YES' then
                            
                                createindentfrompo(:P118_TNO);
                                COMMIT;
                        end if;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P118_TNO
                    P118_STATUS
                    P118_ISOPENSPEC
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P118_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @buttons
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P118_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

