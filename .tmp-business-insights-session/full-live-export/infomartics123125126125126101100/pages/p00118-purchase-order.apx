    process fetch-the-attached-file-from-binary-store (
        name: Fetch the attached file from Binary Store
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_file_tno BINARY_STORE.TNO%TYPE;
                BEGIN
                    SELECT TNO 
                    INTO   v_file_tno
                    FROM   BINARY_STORE 
                    WHERE  REFERENCE_TNO = :P118_TNO
                    ORDER BY TNO DESC
                    FETCH FIRST 1 ROW ONLY;
                
                    :P118_FILE_TNO := v_file_tno;
                
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        :P118_FILE_TNO := NULL; 
                    WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20001, 'Error retrieving file: ' || SQLERRM);
                END;
                ```
        }
        execution {
            sequence: 160
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 35668952546321619
        }
    )

    process fetch-the-email-status (
        name: Fetch the Email Status
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_mail_Id        PURCHASEORDER.MAILID%TYPE;
                    v_mail_Status   PURCHASEORDER.MAILID%TYPE;
                BEGIN
                    SELECT 
                           MailID ,
                           CASE WHEN po.MailID IS NULL THEN '❌ Not Sent'
                                WHEN EXISTS (SELECT 1 FROM apex_mail_queue q WHERE q.ID = po.MailID) THEN '⏳ Sending (In Queue)'
                                WHEN EXISTS (SELECT 1 FROM apex_mail_log l WHERE l.Mail_ID = po.MailID AND l.mail_send_error IS NULL) THEN '✅ Sent Successfully'
                                WHEN EXISTS (SELECT 1 FROM apex_mail_log l WHERE l.Mail_ID = po.MailID AND l.mail_send_error IS NOT NULL) THEN '⚠️ Delivery Failed'
                                ELSE '❓ Unknown Status'
                            END AS email_status 
                        INTO :P118_HIDDEN_MAIL_ID, :P118_MAILSTATUS
                    FROM   PURCHASEORDER po
                    WHERE  po.TNO = :P118_TNO
                    ORDER BY po.TNO DESC
                    FETCH FIRST 1 ROW ONLY;
                
                
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        :P118_HIDDEN_MAIL_ID := NULL; 
                        :P118_MAILSTATUS    := NULL;
                    WHEN OTHERS THEN
                        RAISE_APPLICATION_ERROR(-20001, 'Error retrieving file: ' || SQLERRM);
                END;
                ```
