              function mixedFields(i){var result=[];mixed[i].selectors.forEach(function(selector){document.querySelectorAll(selector).forEach(function(e){if(usable(e))result.push(e);});});return result;}
              function mixedStart(i,last){activate(mixed[i].panel);var fields=mixedFields(i);if(fields.length)focus(fields[last?fields.length-1:0]);else if(i===0)attachment();else focus(actions()[0]);}
              var upload=document.getElementById('R53134147830550917_dropzone');if(upload){upload.tabIndex=0;upload.setAttribute('role','button');upload.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();upload.click();}});}
              function attachment(){activate(attachmentPanel);if(!focus(document.getElementById(attachmentButton)))focus(actions()[0]);}
