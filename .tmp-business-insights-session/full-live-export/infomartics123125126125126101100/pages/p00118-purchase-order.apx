                    delete from PURCHASEORDERTAC where tno = :P118_TNO;
                    insert into PURCHASEORDERTAC
                    (
                        TNO, 
                        SNO, 
                        TERMSANDCONDITIONHEADCODE, 
                        TERMSANDCONDITION
