    pageItem P118_AGENTCODE (
        type: popupLov
        label {
            label: Agent
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName as AgentName,
                a.PartyCode as AgentCode
                from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) a
                where a.PartyTypeCode = 'AGENT'
                and GetDocumentStatusCode('PARTY', A.TNO) = 'ACTIVE'
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @other-informations
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @general
            column: AGENTCODE
            dataType: varchar2
        }
    )

