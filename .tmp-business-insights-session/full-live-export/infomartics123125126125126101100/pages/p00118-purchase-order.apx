    region upload-file (
        name: Upload File
        type: plugin/dropzone2
        layout {
            sequence: 170
            parentRegion: @e-mail
            slot: regionBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            dropzoneStyle: greyDashedBorderBackground
            width: 100%
            height: 10px
            maxFilesizeInMb: 5
            maxFiles: 1
            acceptedFileTypes: .pdf
            copyPasteSupport: true
            removeFilesAfterUpload: true
        }
    )

    region vendor-acceptance (
        name: Vendor Acceptance
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       TNO,
                       MODULECODE,
                       MODULETNO,
                       MODULESNO,
                       ACCEPTANCEDATE,
                       DELIVERYDATE,
                       PERSONACCOUNTABLE,
                       DESIGNATION,
                       MOBILENO,
                       ACCEPTANCE,
                      -- ISUPDATED,
                       EXPIRYTIME
                  from MA_ACCEPTANCE
                  where moduletno = :P118_TNO
                
                ```
            pageItemsToSubmit: P118_TNO
        }
        layout {
            sequence: 80
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: Vendor
        }
        serverSideCondition {
            type: never
        }
    )

