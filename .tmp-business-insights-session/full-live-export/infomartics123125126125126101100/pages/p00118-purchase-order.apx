            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 400
        }
        advanced {
            savedReportMappingIdentifier: 545718993056907012
        }

        savedReport 1491207 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @TERMSANDCONDITIONHEADCODE
                layout {
                    width: 287
                    sequence: 4
                }
            )

            displayColumn (
                column: @TERMSANDCONDITION
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SNO (
            type: numberField
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            columnFilter {
                lovType: none
            }
        )

        column TERMSANDCONDITION (
            type: popupLov
            heading {
                heading: Terms And Condition
            }
            settings {
                manualEntry: true
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select a.termsandcondition a , a.termsandcondition b from TERMSANDCONDITIONHEADDETAIL a , TERMSANDCONDITIONHEAD b
                    where a.tno = b.tno
                    and b.tno = :TERMSANDCONDITIONHEADCODE
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TERMSANDCONDITIONHEADCODE
                itemsToSubmit: TERMSANDCONDITIONHEADCODE
                parentRequired: false
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: TERMSANDCONDITION
                dataType: varchar2
            }
        )

        column TERMSANDCONDITIONHEADCODE (
            type: popupLov
            heading {
                heading: Terms And Condition Head
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery: select TERMSANDCONDITIONHEADNAME , tno from TERMSANDCONDITIONHEAD
                displayNullValue: false
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: TERMSANDCONDITIONHEADCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            advanced {
                htmlDomId: TERMSANDCONDITIONHEADCODE
            }
        )

        column TNO (
            type: numberField
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P118_TNO
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Terms and Conditions
        }
    )

