            function openFileInNewTab(pReferenceTNo) {
                if (!pReferenceTNo) return;
            
                // var url = "f?p=" + $v("pFlowId") + ":0:" + $v("pInstance") + ":APPLICATION_PROCESS=GET_BINARY_FILE:::x01:" + pReferenceTNo;
                
