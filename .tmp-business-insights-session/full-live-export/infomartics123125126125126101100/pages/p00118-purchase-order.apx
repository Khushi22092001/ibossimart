    dynamicAction upload-file (
        name: Upload File
        execution {
            sequence: 660
        }
        when {
            event: region/plugin-dropzone2/dropzone-upload-success
            selectionType: region
            region: @upload-file
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        l_tno           BINARY_STORE.TNO%TYPE;
                        l_last_filename BINARY_STORE.FILE_NAME%TYPE;
                        v_collection    CONSTANT VARCHAR2(100) := 'DROPZONE_UPLOAD';
                    BEGIN
                        IF APEX_COLLECTION.COLLECTION_EXISTS(v_collection) THEN
                            
                            -- Loop through the collection
                            FOR r IN (
                                SELECT c001, c002, blob001 
                                FROM apex_collections 
                                WHERE collection_name = v_collection
                                ORDER BY seq_id DESC -- Processing most recent first
                            ) LOOP
                                
                                INSERT INTO BINARY_STORE (
                                    REFERENCE_TNO, 
                                    REFERENCE_MODULE, 
                                    FILE_NAME, 
                                    MIME_TYPE, 
                                    FILE_DATA
                                ) VALUES (
                                    :P118_TNO, 
                                    'PURCHASEORDER',
                                    r.c001, 
                                    r.c002, 
                                    r.blob001
                                ) RETURNING TNO, FILE_NAME INTO l_tno, l_last_filename;
                    
                            END LOOP;
                    
                            -- Assign the last processed file info to page items
                            :P118_FILE_TNO := l_tno;
                            :P118_FILENAME := l_last_filename;
                    
                            -- Efficiently clear the collection
                            APEX_COLLECTION.DELETE_COLLECTION(v_collection);
                        END IF;
                    
                    EXCEPTION
                        WHEN OTHERS THEN
                            apex_debug.error('Collection Upload Error: ' || SQLERRM);
                            RAISE;
                    END;
                    
                    ```
                itemsToSubmit: P118_TNO
                itemsToReturn: [
                    P118_FILE_TNO
                    P118_FILENAME
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P118_FILENAME
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action plugin-uc-notifications (
            action: plugin/ucNotifications
            settings {
                title: Success
                message: File Successfully Uploaded
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction validate-correct-cc-email-address (
        name: Validate Correct CC_Email Address
        execution {
            sequence: 720
        }
        when {
            selectionType: items
            items: P118_EMAIL_CC
        }

        action multi-email-validate (
            name: Multi Email Validate
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var emailField = apex.item('P118_EMAIL_CC');
                    var emailValue = emailField.getValue();
                    
                    if (emailValue) {
                        // Comma (,) ya Semicolon (;) dono se split karne ke liye
                        var emails = emailValue.split(/[\s,;]+/); 
                        var emailRegex = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
                        var invalidEmails = [];
                    
                        // Har ek email ko loop mein check karein
                        emails.forEach(function(email) {
                            email = email.trim(); // Extra spaces hatane ke liye
                            if (email.length > 0 && !emailRegex.test(email)) {
                                invalidEmails.push(email);
                            }
                        });
                    
                        // Agar koi email invalid mila toh error dikhayein
                        if (invalidEmails.length > 0) {
                            apex.message.alert('These emails are invalid: ' + invalidEmails.join(', '));
                            // Optional: Aap chahein toh field clear kar sakte hain
                            // emailField.setValue('');
                        }
                    }
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action single-email-validate (
            name: Single Email Validate
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var emailField = apex.item('P118_OFFICEEMAIL');
                    var emailValue = emailField.getValue();
                    var regex = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
                    
                    if (emailValue && !regex.test(emailValue)) {
                        // Show an error alert
                        apex.message.alert('Please enter a valid email address.');
                        
                        // Optional: Clear the invalid value and clear focus
                        emailField.setValue('');
                    }
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

    )

