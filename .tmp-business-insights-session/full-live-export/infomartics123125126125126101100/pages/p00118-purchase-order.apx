        column ITEMCODE (
            type: popupLov
            heading {
                heading: Item
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                    B.ITEMNAME D, B.ITEMCODE R
                    FROM PURCHASEORDERDETAIL  A, ITEM B
                    WHERE A.ITEMCODE = B.ITEMCODE
                    AND A.TNO = :P118_TNO
                    union all
                    SELECT 
                    A.ITEMNAME D, A.ITEMCODE R 
                    from item a
                    where itemnaturecode = 'SERVICES'
                    union all
                    SELECT 
                    A.ITEMNAME D, A.ITEMCODE R 
                    from item a
                    where NVL(:P118_ISOPENSPEC,'NO')='YES'
                    
                    ;
                    
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    P118_INDENTTNO
                    P118_TNO
                    P118_ISOPENSPEC
                ]
                parentRequired: false
            }
            layout {
                sequence: 30
                group: @item-specification
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMCODE
                dataType: varchar2
            }
            advanced {
                htmlDomId: ITEMCODE
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: popupLov
            heading {
                heading: Specification
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ITEMSPECIFICATIONNAME , ITEMSPECIFICATIONCODE
                    from itemspecification
                    where tno in (select tno from item where itemcode = :ITEMCODE )
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ITEMCODE
                itemsToSubmit: ITEMCODE
                parentRequired: false
            }
            layout {
