                }
              },true);
              $(document).on('popupopen.hsplPurchaseOrderTab','#P118_PURCHASEORDERDATE_dialog,#P118_DELIVERYDATE_dialog',function(){queueMicrotask(function(){if(keyboardFocus&&document.activeElement.closest('a-date-picker'))reveal(document.activeElement);});});
