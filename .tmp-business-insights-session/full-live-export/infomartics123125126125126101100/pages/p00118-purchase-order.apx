            /* WORKFLOW_LAYOUT_HORIZONTAL_HEADER_SYNC_V1 */
            (function () {
              function bindGrid(grid) {
                var body = grid.querySelector('.a-GV-bdy');
                var header = grid.querySelector('.a-GV-w-hdr');
                if (!body || !header || body.dataset.workflowHorizontalSync === 'Y') { return; }
            
                body.dataset.workflowHorizontalSync = 'Y';
                header.scrollLeft = body.scrollLeft;
                body.addEventListener('scroll', function () {
                  header.scrollLeft = body.scrollLeft;
                }, { passive: true });
              }
            
              function bindAll() {
                Array.prototype.forEach.call(document.querySelectorAll('.a-IG'), bindGrid);
              }
            
              function scheduleBinding() { window.setTimeout(bindAll, 0); }
              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', scheduleBinding, { once: true });
              } else {
                scheduleBinding();
              }
              document.addEventListener('click', scheduleBinding);
              new MutationObserver(scheduleBinding).observe(document.documentElement, {
                childList: true,
                subtree: true
              });
            }());
            
            /* HSPL_PHASE2_CALC_GUARD_V1 */
            (function () {
              function inputOf(element) {
                if (element && element.jquery) { return element[0]; }
                return element || null;
              }
              window.hsplPhase2CellChanged = function (element) {
                var input = inputOf(element);
                if (!input) { return true; }
                var original = input.getAttribute('data-hspl-phase2-start');
                if (original === null) { return true; }
                return String(input.value == null ? '' : input.value) !== original;
              };
              document.addEventListener('focusin', function (event) {
                var input = event.target;
                if (input && input.closest && input.closest('.a-IG')) {
                  input.setAttribute('data-hspl-phase2-start', String(input.value == null ? '' : input.value));
                }
              }, true);
            }());
            
            /* HSPL_PHASE2_PO_LIVE_SUMMARY_V1 */
            window.hsplPhase2UpdatePoSummary = function () {
              try {
                var region = apex.region('Detail');
                var model = region.widget().interactiveGrid('getViews', 'grid').model;
                var amount = 0, footer = 0, total = 0;
                function numberOf(value) {
                  if (value && typeof value === 'object' && value.v !== undefined) { value = value.v; }
                  value = Number(String(value == null ? '' : value).replace(/,/g, ''));
                  return isFinite(value) ? value : 0;
                }
                model.forEach(function (record, index, id) {
                  var meta = model.getRecordMetadata(id);
                  if (meta.deleted || meta.agg) { return; }
                  amount += numberOf(model.getValue(record, 'AMOUNT'));
                  footer += numberOf(model.getValue(record, 'FOOTERAMOUNT'));
                  total += numberOf(model.getValue(record, 'TOTALAMOUNT'));
                });
                apex.item('P118_SUMOFAMOUNT').setValue(amount, null, true);
                apex.item('P118_SUMOFFOOTERAMOUNT').setValue(footer, null, true);
                apex.item('P118_PURCHASEORDERAMOUNT').setValue(total, null, true);
              } catch (ignore) {}
            };
            $(document).on('interactivegridviewmodelcreate', '#Detail', function (event, ui) {
              if (ui && ui.model) {
                ui.model.subscribe({ onChange: window.hsplPhase2UpdatePoSummary });
                window.hsplPhase2UpdatePoSummary();
              }
            });
            
            /* HSPL_PAGE_TAB_FUNCTION:118 */
