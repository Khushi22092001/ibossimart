        buttonName: ADD_PARTY_EMAIL
        label: Add Party Email
        layout {
            sequence: 50
            region: @send-email
            slot: regionBody
            startNewRow: false
            column: 5
            columnAttributes: style="Margin-top:3px;"
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
