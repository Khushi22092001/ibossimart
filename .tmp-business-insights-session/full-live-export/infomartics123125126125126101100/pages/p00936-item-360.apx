    region vendor-compare (
        name: Vendor Comparison
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With L As (
                  Select h.TNo BillTno, h.PurchaseBillDate BillDate, h.PartyCode,
                         d.Amount Amt, d.Quantity1 Qty
                    From PCC_PurchaseBill h
                    Join PurchaseBillDetail d On d.TNo = h.TNo
                   Where d.ItemCode = :P936_ITEMCODE
                     And (:P936_UOM  Is Null
                          Or nvl(d.RateMeasuringUnitCode,'~NONE~') = :P936_UOM)
                     And (:P936_SPEC Is Null
                          Or nvl(d.ItemSpecificationCode,'~NONE~') = :P936_SPEC)
                     And h.PurchaseBillDate
                         Between to_date(:P936_FROMDATE,'DD-MM-RRRR')
                             And to_date(:P936_TODATE,'DD-MM-RRRR')
                     And nvl(d.Quantity1,0) > 0
                     And nvl(d.Amount,0)    > 0
                     And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                     And (:P936_PANEL Is Null Or h.Panel = :P936_PANEL)
                     And (:P936_COMPANY  Is Null Or h.CompanyCode  = :P936_COMPANY)
                     And (:P936_LOCATION Is Null Or h.LocationCode = :P936_LOCATION)),
                B As (
                  Select PartyCode, BillTno, BillDate,
                         Sum(Amt) Amt, Sum(Qty) Qty,
                         Sum(Amt) / Sum(Qty) BillRate
                    From L
                   Group By PartyCode, BillTno, BillDate),
                A As (
                  Select PartyCode,
                         Count(*) Bills,
                         Sum(Amt) Spend,
                         Sum(Qty) Qty,
                         Sum(Amt) / Sum(Qty) AvgRate,
                         Min(BillRate) MinRate,
                         Max(BillRate) MaxRate,
                         Max(BillRate) KEEP (DENSE_RANK LAST
                                             Order By BillDate, BillTno) LastRate,
                         Min(BillDate) FirstBuy,
                         Max(BillDate) LastBuy
                    From B
                   Group By PartyCode)
                Select
                  a.PartyCode As PARTYCODE,
                  GetPartyName(a.PartyCode) As SUPPLIER,
                  a.Bills As BILLS,
                  a.Qty As QUANTITY,
                  a.Spend As SPEND,
                  Round(a.AvgRate,2)  As AVG_RATE,
                  Round(a.MinRate,2)  As MIN_RATE,
                  Round(a.MaxRate,2)  As MAX_RATE,
                  Round(a.LastRate,2) As LAST_RATE,
                  -- Premium over the CHEAPEST source for this item. Arithmetic only.
                  Round(100 * (a.AvgRate - Min(a.AvgRate) Over ())
                            / Nullif(Min(a.AvgRate) Over (),0), 1) As PREMIUM_PCT,
                  a.FirstBuy As FIRST_BUY,
                  a.LastBuy  As LAST_BUY
                From A a
                Order By a.AvgRate
                ```
            pageItemsToSubmit: [
                P936_COMPANY
                P936_FROMDATE
                P936_ITEMCODE
                P936_LOCATION
                P936_PANEL
                P936_SPEC
                P936_SUPPLIER
                P936_TODATE
                P936_UOM
            ]
        }
        layout {
            sequence: 45
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No supplier billed this item in the selected period, unit and scope.
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 100
        }
        advanced {
            savedReportMappingIdentifier: 21534839070436227
        }

        column AVG_RATE (
            type: plainText
            heading {
                heading: Avg Realised Rate
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
            comments {
                comments: The ranking measure — value-weighted, so a large bill counts for more than a token one.
            }
        )

        column BILLS (
            type: plainText
            heading {
                heading: Bills
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
            comments {
                comments: How many bills this supplier raised for the item.
            }
        )

        column FIRST_BUY (
            type: plainText
            heading {
                heading: First Buy
            }
            layout {
                sequence: 100
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-RRRR
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
            comments {
                comments: Earliest bill from this supplier for the item in the period.
            }
        )

        column LAST_BUY (
            type: plainText
            heading {
                heading: Last Buy
            }
            layout {
                sequence: 110
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-RRRR
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
            comments {
                comments: Most recent bill. A distant date next to a low premium may mean the good rate is stale.
            }
        )

        column LAST_RATE (
            type: plainText
            heading {
                heading: Last Rate
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
            comments {
                comments: Most recent per-bill rate from this supplier, deterministically resolved.
            }
        )

        column MAX_RATE (
            type: plainText
            heading {
                heading: Highest
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
            comments {
                comments: Dearest per-bill rate from this supplier.
            }
        )

        column MIN_RATE (
            type: plainText
            heading {
                heading: Lowest
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
            comments {
                comments: Cheapest per-bill rate from this supplier.
            }
        )

        column PARTYCODE (
            type: hidden
            heading {
                heading: Party Code
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
            comments {
                comments: Technical drill key. Never displayed.
            }
        )

        column PREMIUM_PCT (
            type: plainText
            heading {
                heading: Premium vs Best %
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990D0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
            comments {
                comments: How much dearer than the cheapest source. ARITHMETIC ONLY — not quality-adjusted, because this ERP holds no quality or service rating. Zero marks the best source.
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990D000
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Quantity in the page's fixed unit, so this column is comparable down the rows.
            }
        )

        column SPEND (
            type: plainText
            heading {
                heading: Spend
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Money booked with this supplier for the item. Summing this column reproduces the Purchase Value KPI.
            }
        )

        column SUPPLIER (
            type: link
            heading {
                heading: Supplier
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 935
                    items: {
                        P935_SUPPLIER: #PARTYCODE#
                        P935_FROMDATE: &P936_FROMDATE.
                        P935_TODATE: &P936_TODATE.
                        P935_COMPANY: &P936_COMPANY.
                        P935_LOCATION: &P936_LOCATION.
                        P935_PANEL: &P936_PANEL.
                    }
                    clearCache: 935
                    debug: NO
                }
                linkText: #SUPPLIER#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            comments {
                comments: Drills to Supplier 360 for the WHOLE supplier — the item and specification are deliberately not carried, because that page is a supplier dossier, not an item view.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 20
            }

            displayColumn AVG_RATE (
                sequence: 1
            )

            displayColumn BILLS (
                sequence: 2
            )

            displayColumn FIRST_BUY (
                sequence: 3
            )

            displayColumn LAST_BUY (
                sequence: 4
            )

            displayColumn LAST_RATE (
                sequence: 5
            )

            displayColumn MAX_RATE (
                sequence: 6
            )

            displayColumn MIN_RATE (
                sequence: 7
            )

            displayColumn PARTYCODE (
                sequence: 8
            )

            displayColumn PREMIUM_PCT (
                sequence: 9
            )

            displayColumn QUANTITY (
                sequence: 10
            )

            displayColumn SPEND (
                sequence: 11
            )

            displayColumn SUPPLIER (
                sequence: 12
            )

        )

    )

    pageItem P936_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From PCC_PurchaseBill h
                                Where h.CompanyCode = c.CompanyCode
                                  And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                                       Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Narrows every region to one company.
        }
    )

    pageItem P936_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD-MM-RRRR
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Start of the reporting period. Arrives from the page that drilled here.
        }
    )

    pageItem P936_ITEMCODE (
        type: popupLov
        label {
            label: Item
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct i.ItemName || ' (' || i.ItemCode || ')' d, i.ItemCode r
                  From PurchaseBillDetail d
                  Join Item i On i.ItemCode = d.ItemCode
                 Order By 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Half the subject of this page. Populated from bill lines, so every entry returns rows.
        }
    )

    pageItem P936_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From PCC_PurchaseBill fb
                                Where fb.LocationCode = l.LocationCode
                                  And (:P936_COMPANY Is Null
                                       Or fb.CompanyCode = :P936_COMPANY)
                                  And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                                       Or fb.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P936_COMPANY
            itemsToSubmit: P936_COMPANY
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Cascades from Company.
        }
    )

    pageItem P936_PANEL (
        type: hidden
        layout {
            sequence: 90
            region: @filter-bar
            slot: regionBody
        }
        serverSideCondition {
            type: expression
            plsqlExpression: SAGAR.GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Hidden when your login is already bound to a panel. The select list is the control; the SQL predicate on every region is the enforcement.
        }
    )

    pageItem P936_SPEC (
        type: popupLov
        label {
            label: Specification
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                       Case When d.ItemSpecificationCode Is Null Then 'No specification recorded'
                            Else nvl((Select s.ItemSpecificationName From ItemSpecification s
                                       Where s.ItemSpecificationCode = d.ItemSpecificationCode),
                                     d.ItemSpecificationCode) End d,
                       nvl(d.ItemSpecificationCode,'~NONE~') r
                  From PurchaseBillDetail d
                 Where d.ItemCode = :P936_ITEMCODE
                 Order By 1
                ```
            nullDisplayValue: All specifications
        }
        cascadingLov {
            parentItems: P936_ITEMCODE
            itemsToSubmit: P936_ITEMCODE
        }
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Optional narrowing. The Specification Mix report below always shows every specification regardless of this setting, so the mix stays readable.
        }
    )

    pageItem P936_SUPPLIER (
        type: popupLov
        label {
            label: Supplier
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct GetPartyName(h.PartyCode) d, h.PartyCode r
                  From PCC_PurchaseBill h
                  Join PurchaseBillDetail d On d.TNo = h.TNo
                 Where d.ItemCode = :P936_ITEMCODE
                   And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All suppliers
        }
        cascadingLov {
            parentItems: P936_ITEMCODE
            itemsToSubmit: P936_ITEMCODE
        }
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Narrows the KPI cards and the rate trend. The Vendor Comparison deliberately IGNORES this filter — a comparison filtered to one vendor has nothing to compare.
        }
    )

    pageItem P936_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD-MM-RRRR
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: End of the reporting period.
        }
    )

    pageItem P936_UOM (
        type: popupLov
        label {
            label: Unit
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                       Case When d.RateMeasuringUnitCode Is Null Then 'No unit recorded'
                            Else nvl((Select m.MeasuringUnitName From MeasuringUnit m
                                       Where m.MeasuringUnitCode = d.RateMeasuringUnitCode),
                                     d.RateMeasuringUnitCode) End d,
                       nvl(d.RateMeasuringUnitCode,'~NONE~') r
                  From PurchaseBillDetail d
                 Where d.ItemCode = :P936_ITEMCODE
                 Order By 1
                ```
            nullDisplayValue: All units (rates not comparable)
        }
        cascadingLov {
            parentItems: P936_ITEMCODE
            itemsToSubmit: P936_ITEMCODE
        }
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: The other half of the subject. Leaving this blank mixes units, and the rates then are NOT comparable — the null display value says so.
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 100
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back-to-analytics (
        buttonName: BACKTOANALYTICS
        label: Purchase Analytics
        layout {
            sequence: 110
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: ds360NavBACKTOANALYTICS
        }
    )

    process ds360-navigation (
        name: DS360_NAVIGATION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                case apex_application.g_x01
                when 'BACKTOANALYTICS' then
                apex_json.open_object;apex_json.write('url',apex_page.get_url(p_page=>'940',p_clear_cache=>'940',p_items=>'P940_FROMDATE,P940_TODATE,P940_COMPANY,P940_LOCATION,P940_PANEL',p_values=>:P936_FROMDATE||','||:P936_TODATE||','||:P936_COMPANY||','||:P936_LOCATION||','||:P936_PANEL));apex_json.close_object;
                else raise_application_error(-20001,'Unknown navigation action');end case;end;
                ```
        }
        execution {
            sequence: 90
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 900360090000679
        }
    )

)

