                P936_SUPPLIER
                P936_TODATE
                P936_UOM
            ]
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-purchase-headregion
