    region grni-trend (
        name: GRNI Trend
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Receipts by the month they were RECEIVED, split by whether they have
                   since been billed. Billed state is current, not as-at the month end -
                   the question this answers is "which months are still unbilled", which
                   is a current-state question, and the axis title says so. */
                Select to_char(trunc(o.GRNDate,'MM'),'Mon-RR') As LABEL,
                       Round(Sum(Case When o.Status = 'PENDING' Then nvl(o.Amount,0) Else 0 End)/10000000,2) As PENDING_CR,
                       Round(Sum(Case When o.Status = 'BILLED'  Then nvl(o.Amount,0) Else 0 End)/10000000,2) As BILLED_CR
                  From (Select cast(null as number) Amount, cast(null as varchar2(100)) CompanyCode, cast(null as date) GRNDate, cast(null as varchar2(100)) GRNNo, cast(null as number) GRNTno, cast(null as varchar2(100)) LocationCode, cast(null as varchar2(100)) PartyBillNo, cast(null as varchar2(20)) Status, cast(null as varchar2(200)) TransporterName, cast(null as varchar2(100)) VehicleNo, cast(null as number) VOCUHERTNO, cast(null as varchar2(100)) VoucherNo From dual Where 1=0) o
                  Join GRN gr On gr.Tno = o.GRNTno
                 Where o.GRNDate >= to_date(:P926_FROMDATE,'DD-MM-RRRR')
                   And o.GRNDate <  to_date(:P926_TODATE,'DD-MM-RRRR') + 1
                   And (cast(null as varchar2(100)) Is Null
                        Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                   And (null    Is Null Or cast(null as varchar2(100))       = null)
                   And (:P926_COMPANY  Is Null Or o.CompanyCode  = :P926_COMPANY)
                   And (:P926_LOCATION Is Null Or o.LocationCode = :P926_LOCATION)
                 Group By trunc(o.GRNDate,'MM')
                 Order By trunc(o.GRNDate,'MM')
                ```
            pageItemsToSubmit: [
                P926_FROMDATE
                P926_TODATE
                P926_COMPANY
                P926_LOCATION
            ]
        }
        layout {
            sequence: 32
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartLayout {
            height: 340
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No goods receipt in this window for the selected scope.
        }

