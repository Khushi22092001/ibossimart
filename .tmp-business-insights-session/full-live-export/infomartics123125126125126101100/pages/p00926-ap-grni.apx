            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: Select to_char(trunc(sysdate),'DD-MM-RRRR') From dual
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: End of the flow window AND the As-of Date for the pending position. Receipts dated after this date are excluded, and ageing is measured from the GRN date to this date.
        }
    )

