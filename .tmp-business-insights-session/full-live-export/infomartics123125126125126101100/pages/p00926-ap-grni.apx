    region rule-analysis (
        name: Where the Unbilled Liability Sits
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-dash-section">
                  <h2>Where the Unbilled Liability Sits</h2>
                  <p>By vendor and by location, and how the position has moved month by month</p>
                </div>
                ```
        }
        layout {
            sequence: 28
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-sectionregion
        }
    )

    region rule-register (
        name: Pending Receipts
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-dash-section">
                  <h2>Every Receipt Awaiting a Supplier Bill</h2>
                  <p>Oldest first, with the vendor, the vehicle and the purchase voucher that recorded it</p>
                </div>
                ```
        }
        layout {
            sequence: 38
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-sectionregion
        }
    )

    region separate-note (
        name: Why GRNI is not in vendor AP
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* A REPORT, not static text: the tie-out figures are measured live, so
                   the note can never quote a stale difference. */
                With G As (
                       Select nvl(Sum(nvl(o.Amount,0)),0) Pend, Count(*) N
                         From (Select cast(null as number) Amount, cast(null as varchar2(100)) CompanyCode, cast(null as date) GRNDate, cast(null as varchar2(100)) GRNNo, cast(null as number) GRNTno, cast(null as varchar2(100)) LocationCode, cast(null as varchar2(100)) PartyBillNo, cast(null as varchar2(20)) Status, cast(null as varchar2(200)) TransporterName, cast(null as varchar2(100)) VehicleNo, cast(null as number) VOCUHERTNO, cast(null as varchar2(100)) VoucherNo From dual Where 1=0) o
                         Join GRN gr On gr.Tno = o.GRNTno
                        Where o.Status = 'PENDING'
                          And o.GRNDate <= to_date(:P926_TODATE,'DD-MM-RRRR')
                          And (cast(null as varchar2(100)) Is Null
                               Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                          And (null    Is Null Or cast(null as varchar2(100))       = null)
                          And (:P926_COMPANY  Is Null Or o.CompanyCode  = :P926_COMPANY)
                          And (:P926_LOCATION Is Null Or o.LocationCode = :P926_LOCATION)),
                     Gl As (
                       /* The GR/IR clearing account straight off the ledger. A credit is
                          positive here, exactly as on the payables pages. */
                       Select nvl(Sum(d.Amount),0) Bal
                         From VoucherDetail d
                        Where d.AccountCode = 'GRIRACCOUNT'
                          And d.VoucherDate <= to_date(:P926_TODATE,'DD-MM-RRRR')
                          And (cast(null as varchar2(100)) Is Null
                               Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                          And (null    Is Null Or cast(null as varchar2(100))        = null)
                          And (:P926_COMPANY  Is Null Or d.CompanyCode  = :P926_COMPANY)
                          And (:P926_LOCATION Is Null Or d.LocationCode = :P926_LOCATION)),
                     Fp As (
                       Select nvl(Sum(d.Amount),0) Bal
                         From VoucherDetail d
                        Where d.AccountCode = 'FREIGHTPAYABLE'
                          And d.VoucherDate <= to_date(:P926_TODATE,'DD-MM-RRRR')
                          And (cast(null as varchar2(100)) Is Null
                               Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                          And (null    Is Null Or cast(null as varchar2(100))        = null)
                          And (:P926_COMPANY  Is Null Or d.CompanyCode  = :P926_COMPANY)
                          And (:P926_LOCATION Is Null Or d.LocationCode = :P926_LOCATION))
                Select '<div class="ds-apnote"><span class="fa fa-random"></span><div>'
                    || '<b>This liability is deliberately absent from every payable figure on the other AP pages.</b> '
                    || 'A goods receipt credits <code>GRIRACCOUNT</code>, which sits under CURRENTLIABILITIESANDPROVISION in this '
                    || 'chart of accounts &mdash; <b>not</b> under SUNDRYCREDITORS. It becomes vendor AP only when a supplier bill is '
                    || 'passed, at which point the clearing account is relieved. Adding the two together would double-count the same goods.'
                    || '</div></div>'
                    || '<div class="ds-apnote"><span class="fa fa-balance-scale"></span><div>'
                    || '<b>Tie-out.</b> Pending GRNs in this scope: <b>&#8377;'
                    || to_char(Round(g.Pend,2),'FM999G99G99G990D00') || '</b> across ' || to_char(g.N,'FM999G990')
                    || ' receipts. GR/IR clearing balance on the ledger: <b>&#8377;'
                    || to_char(Round(gl.Bal,2),'FM999G99G99G990D00') || '</b>. Difference: <b>&#8377;'
                    || to_char(Round(gl.Bal - g.Pend,2),'FM999G99G99G990D00') || '</b> &mdash; '
                    || Case When Abs(gl.Bal - g.Pend) < 1
                            Then 'the view and the account agree.'
                            Else 'partial billing and timing, where a receipt has been billed in part or billed after the As-of Date. '
                                 || 'It is shown rather than smoothed: the two measures answer slightly different questions, and the gap is the finding.' End
                    || ' Freight clearing (<code>FREIGHTPAYABLE</code>) carries a further <b>&#8377;'
                    || to_char(Round(fp.Bal,2),'FM999G99G99G990D00') || '</b>, which is the transporter twin of this position.'
                    || '</div></div>' As NOTE
                  From G g Cross Join Gl gl Cross Join Fp fp
                ```
            pageItemsToSubmit: [
                P926_FROMDATE
                P926_TODATE
                P926_COMPANY
                P926_LOCATION
            ]
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column NOTE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: NOTE
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region top-vendors (
        name: Top Vendors by Unbilled Liability
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With P As (
                       Select gr.PartyCode Pty, nvl(o.Amount,0) Amt,
                              to_date(:P926_TODATE,'DD-MM-RRRR') - o.GRNDate Age
                         From (Select cast(null as number) Amount, cast(null as varchar2(100)) CompanyCode, cast(null as date) GRNDate, cast(null as varchar2(100)) GRNNo, cast(null as number) GRNTno, cast(null as varchar2(100)) LocationCode, cast(null as varchar2(100)) PartyBillNo, cast(null as varchar2(20)) Status, cast(null as varchar2(200)) TransporterName, cast(null as varchar2(100)) VehicleNo, cast(null as number) VOCUHERTNO, cast(null as varchar2(100)) VoucherNo From dual Where 1=0) o
                         Join GRN gr On gr.Tno = o.GRNTno
                        Where o.Status = 'PENDING'
                          And o.GRNDate <= to_date(:P926_TODATE,'DD-MM-RRRR')
                          And (cast(null as varchar2(100)) Is Null
                               Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                          And (null    Is Null Or cast(null as varchar2(100))       = null)
                          And (:P926_COMPANY  Is Null Or o.CompanyCode  = :P926_COMPANY)
                          And (:P926_LOCATION Is Null Or o.LocationCode = :P926_LOCATION))
                Select * From (
                  Select nvl(pa.PartyName, p.Pty)                                  As LABEL,
                         Round(Sum(p.Amt)/100000,2)                                As UNBILLED_LAC,
                         Round(Sum(Case When p.Age > 30 Then p.Amt Else 0 End)/100000,2) As OVER30_LAC,
                         p.Pty                                                     As PARTY_CODE
                    From P p Left Join Party pa On pa.PartyCode = p.Pty
                   Group By p.Pty, pa.PartyName
                   Having Sum(p.Amt) > 0
                   Order By Sum(p.Amt) Desc)
                 Where rownum <= 12
                 /* Outer Order By is required: the inner one only picks the twelve
                    rows, it does not survive to the result set. */
                 Order By UNBILLED_LAC Desc
                ```
            pageItemsToSubmit: [
                P926_FROMDATE
                P926_TODATE
                P926_COMPANY
                P926_LOCATION
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartLayout {
            height: 340
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No vendor carries an unbilled receipt in this scope.
        }

        series over30 (
            name: Of which over 30 days (₹ Lac)
            execution {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: OVER30_LAC
            }
        )

        series unbilled (
            name: Unbilled (₹ Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: UNBILLED_LAC
            }
            link {
                type: redirectThisApp
                target: {
                    page: 923
                    items: {
                        P923_PARTY: &PARTY_CODE.
                        P923_FROMDATE: &P926_FROMDATE.
                        P923_TODATE: &P926_TODATE.
                        P923_COMPANY: &P926_COMPANY.
                        P923_LOCATION: &P926_LOCATION.
                    }
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Unbilled Liability (₹ Lac)
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    pageItem P926_COMPANY (
        type: selectList
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From (Select cast(null as number) Amount, cast(null as varchar2(100)) CompanyCode, cast(null as date) GRNDate, cast(null as varchar2(100)) GRNNo, cast(null as number) GRNTno, cast(null as varchar2(100)) LocationCode, cast(null as varchar2(100)) PartyBillNo, cast(null as varchar2(20)) Status, cast(null as varchar2(200)) TransporterName, cast(null as varchar2(100)) VehicleNo, cast(null as number) VOCUHERTNO, cast(null as varchar2(100)) VoucherNo From dual Where 1=0) o
                                Where o.CompanyCode = c.CompanyCode)
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P926_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Start of the FLOW window, which bounds the GRNI Trend chart only. The pending position, its ageing and the register are point-in-time measures taken at the To Date and are not affected by this item.
        }
    )

    pageItem P926_LOCATION (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From (Select cast(null as number) Amount, cast(null as varchar2(100)) CompanyCode, cast(null as date) GRNDate, cast(null as varchar2(100)) GRNNo, cast(null as number) GRNTno, cast(null as varchar2(100)) LocationCode, cast(null as varchar2(100)) PartyBillNo, cast(null as varchar2(20)) Status, cast(null as varchar2(200)) TransporterName, cast(null as varchar2(100)) VehicleNo, cast(null as number) VOCUHERTNO, cast(null as varchar2(100)) VoucherNo From dual Where 1=0) o
                                Where o.LocationCode = l.LocationCode
                                  And (:P926_COMPANY Is Null Or o.CompanyCode = :P926_COMPANY))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P926_COMPANY
            itemsToSubmit: P926_COMPANY
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: "Location" is the business term throughout this dashboard; the underlying column is LocationCode and is never renamed, only relabelled. The list shows only locations that actually carry a goods receipt, narrowed by the selected Company.
        }
    )

    pageItem P926_TODATE (
        type: datePicker
        label {
            label: To Date / As-of
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
