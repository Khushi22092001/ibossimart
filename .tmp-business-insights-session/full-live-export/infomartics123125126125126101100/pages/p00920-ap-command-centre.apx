    region rule-control (
        name: Control and Traceability
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-dash-section">
                  <h2>Control and Traceability</h2>
                  <p>What the data cannot support, and where the exceptions are</p>
                </div>
                ```
        }
        layout {
            sequence: 58
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-sectionregion
        }
    )

