    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @detailfooter
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    Declare
                    mysno number;
                    Begin
                    If :SN is null then
                        Select GlobalTNo.nextval into mysno from dual;
                    else MYSNO := :SN;
                    end if;
                    return mysno;
                    end;
                    ```
                itemsToSubmit: SN
            }
            affectedElements {
                selectionType: columns
                columns: SN
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-serial-no-for-detail (
