    dynamicAction set-value-final-value-of-detail-footer-on-loose-focus (
        name: Set Value- Final value of Detail footer on Loose Focus
        execution {
            sequence: 20
        }
        when {
            event: focusout
            selectionType: region
            region: @detailfooter
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("DetailFooter").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("FOOTERVALUE");
                    model.forEach(function(igrow,index,id) {
                    meta = model.getRecordMetadata(id);
                        n_amt = parseInt(igrow[col_amt], 10);
                        if (!isNaN(n_amt) && !meta.agg) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P321_FVALUE").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

