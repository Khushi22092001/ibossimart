            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Header
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
