    pageItem P902_ACCOUNTGROUP (
        type: selectMany
        label {
            label: Account
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.partyname || case when count(*) over (partition by p.partyname)>1 then '  ['||p.partycode||']' end d,
                       p.partycode r
                  from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) p
                 order by p.partyname,p.partycode
                ```
        }
        layout {
            sequence: 60
            region: @trial-balance-scope
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 4
            columnSpan: 3
        }
        appearance {
