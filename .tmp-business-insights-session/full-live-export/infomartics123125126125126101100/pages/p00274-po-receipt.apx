        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       TERMSANDCONDITIONHEADCODE,
                       TERMSANDCONDITION
                  from PORECEIPTTAC
                  where tno = :P274_TNO
