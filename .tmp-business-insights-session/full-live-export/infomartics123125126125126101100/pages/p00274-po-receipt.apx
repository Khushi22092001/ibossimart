    process detail-footer-save-interactive-grid-data (
        name: Detail Footer - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detail-footer
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 65443621139005890
        }
        serverSideCondition {
            type: never
        }
    )

    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                declare l_rows number;begin
                 if :APEX$ROW_STATUS='C' then :TNO:=:P274_TNO;
                 elsif :APEX$ROW_STATUS in('U','D') then
                 if nvl(:TNO,:P274_TNO)<>:P274_TNO then raise_application_error(-20074,'Detail row belongs to a different document');end if;
                 select count(*) into l_rows from PORECEIPTDETAIL where tno=:P274_TNO and rowid=:ROWID;
                 if l_rows<>1 then raise_application_error(-20074,'Detail row is missing or duplicated; the save was blocked');end if;
                 end if;
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                 :TNO:=:P274_TNO;if :SNO is null then select globaltno.nextval into :SNO from dual;end if;
                            Insert Into poreceiptdetail (                 
                                    TNO,
                SNO,
                ITEMCODE,
                ITEMSPECIFICATIONCODE,
                DESCRIPTION,
                QUANTITY1,
                QUANTITY2,
                TOLERANCE,
                RECEIVEDQUANTITY1,
                RECEIVEDQUANTITY2,
                PURCHASEBILLQUANTITY1,
                PURCHASEBILLQUANTITY2,
                MATERIALINQUANTITY1,
                MATERIALINQUANTITY2,
                GATEPASSQUANTITY1,
                GATEPASSQUANTITY2,
                ACCEPTEDQUANTITY1,
                ACCEPTEDQUANTITY2,
                INSPECTEDQUANTITY1,
                INSPECTEDQUANTITY2,
                JOINACCEPTEDQUANTITY1,
                JOINACCEPTEDQUANTITY2,
                JOININSPECTEDQUANTITY1,
                JOININSPECTEDQUANTITY2,
                RATEMEASURINGUNITCODE,
                RATE,
                AMOUNT,
                FOOTERAMOUNT,
                TOTALAMOUNT,
                REMARK,
                LOWERTOLERANCEPERCENT,
                HIGHERTOLERANCEPERCENT,
                DOCUMENTSTATUSCODE,
                TAXRULECODE,
                PACKINGTYPECODE,
                PACKINGNOS
                            )
                            Values (
                                :TNO,
                :SNO,
                :ITEMCODE,
                :ITEMSPECIFICATIONCODE,
                :DESCRIPTION,
                :QUANTITY1,
                :QUANTITY2,
                :TOLERANCE,
                :RECEIVEDQUANTITY1,
                :RECEIVEDQUANTITY2,
                :PURCHASEBILLQUANTITY1,
                :PURCHASEBILLQUANTITY2,
                :MATERIALINQUANTITY1,
                :MATERIALINQUANTITY2,
                :GATEPASSQUANTITY1,
                :GATEPASSQUANTITY2,
                :ACCEPTEDQUANTITY1,
                :ACCEPTEDQUANTITY2,
                :INSPECTEDQUANTITY1,
                :INSPECTEDQUANTITY2,
                :JOINACCEPTEDQUANTITY1,
                :JOINACCEPTEDQUANTITY2,
                :JOININSPECTEDQUANTITY1,
                :JOININSPECTEDQUANTITY2,
                :RATEMEASURINGUNITCODE,
                :RATE,
                :AMOUNT,
                :FOOTERAMOUNT,
                :TOTALAMOUNT,
                :REMARK,
                :LOWERTOLERANCEPERCENT,
                :HIGHERTOLERANCEPERCENT,
                :DOCUMENTSTATUSCODE,
                :TAXRULECODE,
                :PACKINGTYPECODE,
                :PACKINGNOS
                            );
                        
                        when 'U' then
                            update poreceiptdetail Set
                                  TNO=:TNO,
                SNO=:SNO,
                ITEMCODE=:ITEMCODE,
                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                DESCRIPTION=:DESCRIPTION,
                QUANTITY1=:QUANTITY1,
                QUANTITY2=:QUANTITY2,
                TOLERANCE=:TOLERANCE,
                RECEIVEDQUANTITY1=:RECEIVEDQUANTITY1,
                RECEIVEDQUANTITY2=:RECEIVEDQUANTITY2,
                PURCHASEBILLQUANTITY1=:PURCHASEBILLQUANTITY1,
                PURCHASEBILLQUANTITY2=:PURCHASEBILLQUANTITY2,
                MATERIALINQUANTITY1=:MATERIALINQUANTITY1,
                MATERIALINQUANTITY2=:MATERIALINQUANTITY2,
                GATEPASSQUANTITY1=:GATEPASSQUANTITY1,
                GATEPASSQUANTITY2=:GATEPASSQUANTITY2,
                ACCEPTEDQUANTITY1=:ACCEPTEDQUANTITY1,
                ACCEPTEDQUANTITY2=:ACCEPTEDQUANTITY2,
                INSPECTEDQUANTITY1=:INSPECTEDQUANTITY1,
                INSPECTEDQUANTITY2=:INSPECTEDQUANTITY2,
                JOINACCEPTEDQUANTITY1=:JOINACCEPTEDQUANTITY1,
                JOINACCEPTEDQUANTITY2=:JOINACCEPTEDQUANTITY2,
                JOININSPECTEDQUANTITY1=:JOININSPECTEDQUANTITY1,
                JOININSPECTEDQUANTITY2=:JOININSPECTEDQUANTITY2,
                RATEMEASURINGUNITCODE=:RATEMEASURINGUNITCODE,
                RATE=:RATE,
                AMOUNT=:AMOUNT,
                FOOTERAMOUNT=:FOOTERAMOUNT,
                TOTALAMOUNT=:TOTALAMOUNT,
                REMARK=:REMARK,
                LOWERTOLERANCEPERCENT=:LOWERTOLERANCEPERCENT,
                HIGHERTOLERANCEPERCENT=:HIGHERTOLERANCEPERCENT,
                DOCUMENTSTATUSCODE=:DOCUMENTSTATUSCODE,
                TAXRULECODE=:TAXRULECODE,
                PACKINGTYPECODE=:PACKINGTYPECODE,
                PACKINGNOS=:PACKINGNOS
                            WHERE TNO = :P274_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From poreceiptdetail
                            Where TNo = :P274_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                end;
                ```
        }
