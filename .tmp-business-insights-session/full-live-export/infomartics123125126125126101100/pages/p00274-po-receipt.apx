    region detail-footer (
        name: Detail Footer
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       SERIALNO,
                       FOOTERHEADCODE,
                       FOOTERPERCENT,
                       FOOTERVALUE,
                       TAXFORMCODE,
                       LEGENDSCODE
                  from PORECEIPTDETAILFOOTER
                  where tno = :P274_TNO
                  and sno = :P274_SNO
                ```
            pageItemsToSubmit: [
                P274_TNO
                P274_SNO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size720x480
            ]
        }
        advanced {
            htmlDomId: Detail_Footer
        }
        edit {
