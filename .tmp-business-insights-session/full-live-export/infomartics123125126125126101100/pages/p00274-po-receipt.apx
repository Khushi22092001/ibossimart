    dynamicAction back (
        name: Back
        execution {
            sequence: 210
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @detail-footer
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

