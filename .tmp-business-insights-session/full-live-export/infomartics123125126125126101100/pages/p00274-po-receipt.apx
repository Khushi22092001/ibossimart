    region po-receipt (
        name: PO Receipt
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       DEPARTMENTCODE,
                       EMPLOYEECODE,
                       PORECEIPTNO,
                       PORECEIPTDATE,
                       DELIVERYDATE,
                       CURRENCYUNITCODE,
                       CURRENCYVALUE,
                       PARTYCODE,
                       DELIVERYORDERTNO,
                       SUMOFAMOUNT,
                       SUMOFFOOTERAMOUNT,
                       PORECEIPTAMOUNT,
                       SUBJECTTEXT,
                       REFERENCETEXT,
                       LETTERTEXT,
                       TITLETEXT,
                       REMARK,
                       ITEMWISEFOOTER,
                       SALESQUOTATIONTNO,
                       AGENTCODE,
                       CONSIGNEECODE,
                       PARTYPORECEIPTNO,
                       PARTYPORECEIPTDATE,
                       VALIDITYUPTODATE,
                       NATUREOFSUPPLYCODE,
                       TRANSACTIONTYPECODE,
                       CREATIONTIME,
                       CREATOR
                  from PORECEIPT
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: General
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

