             function pump(){if(busy||!pending)return;if(!value('JOBBILLTNO')){pending=false;return;}var sig=signature(),rev=revision;busy=true;
              apex.server.process('P221_TAX_CONTEXT',{x01:JSON.stringify({amount:number(value('SUMOFAMOUNT'))}),pageItems:fields.map(function(f){return '#P221_'+f;}).join(',')},{dataType:'json'}).done(function(ctx){
