               if(Math.abs(number(value('SUMOFTDSAMOUNT'))-number(ctx.tds))>.0051)dirty=true;
               [['TDSPAYEECATEGORYCODE',ctx.payee],['TDSTAXCATEGORYCODE',ctx.category],['PANNO',ctx.pan],['TDSTHRESHOLD',ctx.threshold],['TDSTRANSACTIONTHRESHOLD',ctx.transactionThreshold],['TOTALTDSPERCENT',ctx.totalPercent],['THRESHOLDPLUSMINUS',ctx.thresholdAdjustment],['TDSDEDUCTABLEAMOUNT',ctx.deductable],['SUMOFTDSAMOUNT',ctx.tds],['ADVANCEORBILL','BILL']].forEach(function(pair){set(pair[0],pair[1]);});pending=false;failed=false;net();render(ctx.footers);
              }).fail(function(){if(rev===revision){pending=false;failed=true;error();}}).always(function(){busy=false;if(pending)pump();});
             }
             function bind(){var v;try{v=apex.region('Detail').widget().interactiveGrid('getViews','grid');}catch(ignore){}if(v&&v.model!==bound){bound=v.model;bound.subscribe({onChange:function(type,data){if(type==='set'&&data&&['AMOUNT','FOOTERAMOUNT','TOTALAMOUNT'].includes(data.field))schedule(false);if(type==='delete'||type==='insert')schedule(false);}});}schedule(false);}
             var nativeDirty=window.hsplP221HasUnsaved;window.hsplP221HasUnsaved=function(){return dirty||pending||busy||failed||nativeDirty&&nativeDirty();};
             apex.jQuery(bind);apex.jQuery(document).on('interactivegridviewmodelcreate.p221Tax apexafterrefresh.p221Tax',bind);
             apex.jQuery(document).on('change.p221Tax input.p221Tax',fields.filter(function(f){return !['TNO','COMPANYCODE','FINANCIALYEARCODE'].includes(f);}).map(function(f){return '#P221_'+f;}).join(','),function(){schedule(true);});
             apex.jQuery(document).on('change.p221Tax input.p221Tax','#P221_ROUNDOFF,#P221_BILLINROUNDFIGURE,#P221_SUMOFWCTAMOUNT',net);
