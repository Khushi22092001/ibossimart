    pageItem P221_ACCOUNTCODE (
        type: popupLov
        label {
            label: Account
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName as AccountName,
                a.PartyCode as AccountCode
                from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) a
                where a.PartyTypeCode = 'ACCOUNT'
                order by a.PartyName
                ```
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @general
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @service-bill-pass
            column: ACCOUNTCODE
            dataType: varchar2
        }
    )

