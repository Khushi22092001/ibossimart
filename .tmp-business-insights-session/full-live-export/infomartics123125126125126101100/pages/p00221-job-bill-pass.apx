    process calculate-tds-amount (
        name: Calculate TDS Amount
        type: executeCode
        source {
            plsqlCode: begin update JBPASS h set SUMOFTDSAMOUNT=(select nvl(sum(f.footervalue),0) from JBPASSTDSDETAIL f where f.tno=h.tno),AMOUNTAFTERTDS=nvl(h.JBPASSAMOUNT,0)-nvl(h.SUMOFWCTAMOUNT,0)-(select nvl(sum(f.footervalue),0) from JBPASSTDSDETAIL f where f.tno=h.tno) where h.tno=:P221_TNO;end;
        }
        execution {
            sequence: 90
        }
