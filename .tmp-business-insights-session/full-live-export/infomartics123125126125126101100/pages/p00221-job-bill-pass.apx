            /* P221 read-only TDS context: revision checked, derived from the Job Bill vendor. */
            (function(){
             var busy=false,pending=false,failed=false,dirty=false,revision=0,timer,bound;
             var fields=['TNO','JOBBILLTNO','COMPANYCODE','FINANCIALYEARCODE','JBPASSDATE','TDSNATURECODE','TDSDEDUCTEDINADVANCE','TDSLOWERRATEAPPLICABLE','TDSLOWERRATE','CESSLOWERRATE','SURCHARGELOWERRATE'];
             function value(name){return apex.item('P221_'+name).getValue();}
             function number(v){return Number(String(v||0).replace(/,/g,''))||0;}
             function set(name,v){apex.item('P221_'+name).setValue(v==null?'':v,null,true);}
