    dynamicAction insert-tables (
        name: Insert tables
        execution {
            sequence: 360
        }
        when {
            event: click
            selectionType: button
            button: @getitem
        }

        action delete-tables (
            name: Delete tables
            action: executeServerSideCode
            settings {
                itemsToSubmit: [
                    P221_TNO
                    P221_JOBBILLTNO
                    P221_COMPANYCODE
                    P221_FINANCIALYEARCODE
                    P221_PARTYCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action insert-into-detail-footer-table (
            name: Insert into detail footer table
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    IMART_REFERENCE_SCOPE.assert_reference('JOBBILL',:P221_JOBBILLTNO,IMART_REFERENCE_SCOPE.company_code,'P221_JOBBILLTNO');
                    if :P221_JOBBILLTNO is not null then
                        insert into jbpassdetailfooter
                        (   TNO,
                            SNO,
                            SN,
                            SERIALNO,
                            FOOTERHEADCODE,
                            FOOTERPERCENT,
                            FOOTERVALUE,
                            LEGENDSCODE,
                            FOOTERNATURECODE
                        )
                        (
                            select 
                                :P221_TNO,
                                c.SNO,
                                b.SN,
                                b.SERIALNO,
                                b.FOOTERHEADCODE,
                                b.FOOTERPERCENT,
                                b.FOOTERVALUE,
                                b.LEGENDSCODE,
                                'IS'
                            from jobbilldetail a ,jobbilldetailfooter b ,  jbpassdetail c
                            where a.tno = :P221_JOBBILLTNO
                            and a.tno = b.tno  
                            and ((a.itemcode = c.itemcode
                                  and a.itemspecificationcode = c.itemspecificationcode)
                                  or
                                  a.jobtypecode = c.jobtypecode)
                            and a.sno = b.sno     
                            and c.tno = :P221_TNO
                        );
                    end if;
                    end;
                    ```
                itemsToSubmit: [
                    P221_TNO
                    P221_JOBBILLTNO
