    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P221_TNO is null then
                    :P221_TNO := GlobalTNo.nextval;
                    :P221_FORMSTATUS := 'NEWRECORD';
                    :P221_TAXINROUNDFIGURE := 'YES';
                    :P221_BILLINROUNDFIGURE := 'YES';
                  
                else
                    :P221_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                for pBill in (
                select B.JOBBILLAMOUNT, A.JBPASSAMOUNT 
                from jbpass a, jobbill b
                where a.jobbilltno = b.tno(+)
                and a.tno = :P221_TNO
                ) loop
                   :P221_BILLAMOUNT := PBILL.JOBBILLAMOUNT;
                   :P221_DEBITNOTEAMOUNT :=  NVL(PBILL.JOBBILLAMOUNT,0) - NVL(PBILL.JBPASSAMOUNT,0) ;
                end loop;
                
                :P221_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P221_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12323431866052717
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P221_MODULEFLOW := 'YES';
                   else
                       :P221_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P221_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P221_ONTHETABLE := 'YES' ;
                   else
                       :P221_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12323923542057140
        }
    )

    process imart-integrity-001 (
        name: Verify final saved transaction integrity
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin declare saved_header JBPASS%rowtype;result json_object_t;request json_object_t:=json_object_t();lines json_array_t;line json_object_t;gross number;before_x01 varchar2(32767):=apex_application.g_x01;hits number;expected number;actual_percent number;actual_value number;head varchar2(100);
                 procedure derive_context is begin declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);
                 own_tno number:=saved_header.TNO;bill_tno number:=saved_header.JOBBILLTNO;company varchar2(100):=saved_header.COMPANYCODE;fy varchar2(100):=saved_header.FINANCIALYEARCODE;
                 doc_date date:=to_date(to_char(saved_header.JBPASSDATE,'DD-MM-YYYY'),'DD-MM-RRRR');nature varchar2(100):=saved_header.TDSNATURECODE;
                 party varchar2(100);payee varchar2(100);category varchar2(100);pan varchar2(100);hits number;
                 profile TDSTAXCATEGORYDETAIL%rowtype;gross number:=nvl(j.get_number('amount'),0);advance_tds number:=nvl(saved_header.TDSDEDUCTEDINADVANCE,0);
                 lower_applies varchar2(3):=nvl(saved_header.TDSLOWERRATEAPPLICABLE,'NO');lower_tds number:=saved_header.TDSLOWERRATE;lower_cess number:=saved_header.CESSLOWERRATE;lower_surcharge number:=saved_header.SURCHARGELOWERRATE;
                 total_percent number:=0;threshold number:=0;transaction_threshold number:=0;threshold_adjustment number:=0;prior_tds number;prior_expense number;deductable number:=0;
                 footer_percent number;footer_value number;tds_sum number:=0;formula varchar2(4000);lines json_array_t:=json_array_t();line json_object_t;
                 type values_t is table of number index by varchar2(100);computed values_t;
                begin
                 if own_tno is null or bill_tno is null then raise_application_error(-20074,'Select the owning Job Bill before calculating TDS');end if;
                 select partycode into party from JOBBILL where tno=bill_tno and companycode=company and financialyearcode=fy;
                 select count(*) into hits from JBPASS where tno=own_tno and (nvl(companycode,'~')<>nvl(company,'~') or nvl(financialyearcode,'~')<>nvl(fy,'~'));if hits>0 then raise_application_error(-20074,'Job Bill Pass belongs to another company or financial year');end if;
                 if gross<0 then raise_application_error(-20074,'TDS expense base cannot be negative');end if;
                 if nature is not null then
                  select TDSPAYEECATEGORYCODE into payee from PARTY where PARTYCODE=party;
                  category:=GetTDSTaxCategoryCode(payee,nature,doc_date);pan:=GetPartyAttributeValue(party,'PANNO');
                  select count(*) into hits from TDSTAXCATEGORY a join TDSTAXCATEGORYDETAIL b on b.tno=a.tno where a.TDSTAXCATEGORYCODE=category and b.TDSPAYEECATEGORYCODE=payee;
                  if hits<>1 then raise_application_error(-20074,'Select one configured TDS category for the Job Bill vendor and date');end if;
                  select b.* into profile from TDSTAXCATEGORY a join TDSTAXCATEGORYDETAIL b on b.tno=a.tno where a.TDSTAXCATEGORYCODE=category and b.TDSPAYEECATEGORYCODE=payee;
                  threshold:=nvl(profile.threshold,0);transaction_threshold:=nvl(profile.transactionthreshold,0);
                  total_percent:=case when pan is null then nvl(profile.TOTALTDSPERCENTWITHOUTPAN,0) else nvl(profile.TOTALTDSPERCENTWITHPAN,0) end;
                  if threshold>0 then
                   select nvl(sum(b.TDSAMOUNT),0),nvl(sum(case when b.THRESHOLDPLUSMINUS<0 and b.ADVANCEORBILL='BILL' and a.VOUCHERNO<>'OPENING' then -b.THRESHOLDPLUSMINUS else 0 end),0) into prior_tds,prior_expense
                   from VOUCHER a join VOUCHERTDSDEDUCTED b on b.tno=a.tno
                   where a.COMPANYCODE=company and a.FINANCIALYEARCODE=fy and b.PARTYCODE=party and b.TDSNATURECODE=nature
                   and not(nvl(a.MODULECODE,'~')='JBPASS' and nvl(a.MODULETNO,-1)=own_tno)
                   and not(nvl(a.MODULECODE,'~')='VOUCHER' and exists(select 1 from VOUCHER parent where parent.TNO=a.MODULETNO and parent.MODULECODE='JBPASS' and parent.MODULETNO=own_tno));
                   if prior_tds>0 then threshold_adjustment:=0;elsif prior_expense+gross>threshold or gross>transaction_threshold then threshold_adjustment:=prior_expense;else threshold_adjustment:=-gross;end if;
                  end if;
                  if total_percent>0 then deductable:=greatest(0,gross+threshold_adjustment-advance_tds);end if;
                  if total_percent>0 and deductable>0 then select count(*) into hits from FOOTERSCHEMELIST where COMPANYCODE=company and FINANCIALYEARCODE=fy and MODULECODE='JBPASS' and STATUS='ACTIVE' and FOOTERHEADCODE='.TDS.';if hits<>1 then raise_application_error(-20074,'Configure one active TDS scheme head for this company/year before saving');end if;end if;
                  for f in(select * from FOOTERSCHEMELIST where COMPANYCODE=company and FINANCIALYEARCODE=fy and MODULECODE='JBPASS' and STATUS='ACTIVE' and FOOTERHEADCODE in('.TDS.','.CESSONTDS.','.SURCHARGEONTDS.') order by sno)loop
                   if computed.exists(f.footerheadcode) then raise_application_error(-20074,'Duplicate active TDS scheme head');end if;
                   if pan is null then footer_percent:=case f.footerheadcode when '.TDS.' then profile.TDSPERCENTWITHOUTPAN when '.CESSONTDS.' then profile.CESSPERCENTWITHOUTPAN when '.SURCHARGEONTDS.' then profile.SURCHARGEPERCENTWITHOUTPAN end;
                   elsif lower_applies='YES' then footer_percent:=case f.footerheadcode when '.TDS.' then lower_tds when '.CESSONTDS.' then lower_cess when '.SURCHARGEONTDS.' then lower_surcharge end;
                   else footer_percent:=case f.footerheadcode when '.TDS.' then profile.TDSPERCENTWITHPAN when '.CESSONTDS.' then profile.CESSPERCENTWITHPAN when '.SURCHARGEONTDS.' then profile.SURCHARGEPERCENTWITHPAN end;end if;
                   formula:=replace(f.formula,'.A.',to_char(deductable,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''));
                   formula:=replace(formula,f.footerheadcode,to_char(nvl(footer_percent,0),'TM9','NLS_NUMERIC_CHARACTERS=''.,'''));
                   for dependency in(select footerheadcode from FOOTERSCHEMELIST where tno=f.tno and status='ACTIVE' and footerheadcode<>f.footerheadcode)loop
                    if instr(formula,dependency.footerheadcode)>0 and dependency.footerheadcode in('.TDS.','.CESSONTDS.','.SURCHARGEONTDS.') and not computed.exists(dependency.footerheadcode) then raise_application_error(-20074,'TDS scheme dependency must precede dependent head: '||dependency.footerheadcode);end if;
                    formula:=replace(formula,dependency.footerheadcode,to_char(case when computed.exists(dependency.footerheadcode) then computed(dependency.footerheadcode) else 0 end,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''));
                   end loop;
                   footer_value:=case when formula is null then 0 else greatest(0,ceil(round(getvalue(formula),nvl(GetMyParameterValue('TDSROUND'),'0')))) end;
                   computed(f.footerheadcode):=footer_value;tds_sum:=tds_sum+footer_value;
                   if footer_value>0 then line:=json_object_t();line.put('TNO',own_tno);line.put('SERIALNO',f.sno);line.put('FOOTERHEADCODE',f.footerheadcode);line.put('FOOTERPERCENT',nvl(footer_percent,0));line.put('FOOTERVALUE',footer_value);lines.append(line);end if;
                  end loop;
                  if total_percent>0 and deductable>0 and not computed.exists('.TDS.') then raise_application_error(-20074,'Configure one active TDS scheme head for this company/year before saving');end if;
                 end if;
                 result:=json_object_t();result.put('payee',payee);result.put('category',category);result.put('pan',pan);result.put('threshold',threshold);result.put('transactionThreshold',transaction_threshold);result.put('totalPercent',total_percent);result.put('thresholdAdjustment',threshold_adjustment);result.put('deductable',deductable);result.put('tds',tds_sum);result.put('footers',lines);
                end; end;
                 procedure money(actual number,wanted number,label varchar2) is begin if abs(nvl(actual,0)-nvl(wanted,0))>.0051 then raise_application_error(-20074,'Job Bill Pass '||label||' differs from independently calculated source');end if;end;
                begin
                 select * into saved_header from JBPASS where tno=:P221_TNO;
                 select nvl(sum(amount),0) into gross from JBPASSDETAIL where tno=saved_header.tno;request.put('amount',gross);apex_application.g_x01:=request.to_string();derive_context;apex_application.g_x01:=before_x01;
                 money(saved_header.TDSDEDUCTABLEAMOUNT,result.get_number('deductable'),'TDS base');money(saved_header.THRESHOLDPLUSMINUS,result.get_number('thresholdAdjustment'),'TDS threshold adjustment');money(saved_header.TOTALTDSPERCENT,result.get_number('totalPercent'),'TDS profile rate');money(saved_header.SUMOFTDSAMOUNT,result.get_number('tds'),'TDS summary');money(saved_header.AMOUNTAFTERTDS,nvl(saved_header.JBPASSAMOUNT,0)-nvl(saved_header.SUMOFWCTAMOUNT,0)-result.get_number('tds'),'amount after TDS');
                 money(saved_header.TDSTHRESHOLD,result.get_number('threshold'),'annual threshold');money(saved_header.TDSTRANSACTIONTHRESHOLD,result.get_number('transactionThreshold'),'transaction threshold');
                 if nvl(saved_header.ADVANCEORBILL,'~')<>'BILL' or nvl(saved_header.TDSPAYEECATEGORYCODE,'~')<>nvl(result.get_string('payee'),'~') or nvl(saved_header.TDSTAXCATEGORYCODE,'~')<>nvl(result.get_string('category'),'~') or nvl(saved_header.PANNO,'~')<>nvl(result.get_string('pan'),'~') then raise_application_error(-20074,'Job Bill Pass saved TDS profile does not belong to source vendor/date');end if;
                 lines:=result.get_array('footers');select count(*) into hits from JBPASSTDSDETAIL where tno=saved_header.tno;if hits<>lines.get_size() then raise_application_error(-20074,'Job Bill Pass TDS head count differs from source profile');end if;
                 for i in 0..lines.get_size()-1 loop line:=treat(lines.get(i) as json_object_t);head:=line.get_string('FOOTERHEADCODE');select count(*),max(footerpercent),max(footervalue) into hits,actual_percent,actual_value from JBPASSTDSDETAIL where tno=saved_header.tno and footerheadcode=head;if hits<>1 then raise_application_error(-20074,'Job Bill Pass TDS head is missing or duplicated');end if;money(actual_percent,line.get_number('FOOTERPERCENT'),'TDS head rate');money(actual_value,line.get_number('FOOTERVALUE'),'TDS head amount');end loop;
                exception when others then apex_application.g_x01:=before_x01;raise;
                end;
                 imart_txn_integrity.verify_page(221,:P221_TNO);end;
                ```
        }
        execution {
            sequence: 9850
        }
        advanced {
            executionMappingIdentifier: 99022120260928001
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process imart-integrity-003 (
        name: Verify Active transaction and voucher after workflow
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin if GetDocumentStatusCode('JBPASS',:P221_TNO)='ACTIVE' then declare saved_header JBPASS%rowtype;result json_object_t;request json_object_t:=json_object_t();lines json_array_t;line json_object_t;gross number;before_x01 varchar2(32767):=apex_application.g_x01;hits number;expected number;actual_percent number;actual_value number;head varchar2(100);
                 procedure derive_context is begin declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);
                 own_tno number:=saved_header.TNO;bill_tno number:=saved_header.JOBBILLTNO;company varchar2(100):=saved_header.COMPANYCODE;fy varchar2(100):=saved_header.FINANCIALYEARCODE;
                 doc_date date:=to_date(to_char(saved_header.JBPASSDATE,'DD-MM-YYYY'),'DD-MM-RRRR');nature varchar2(100):=saved_header.TDSNATURECODE;
                 party varchar2(100);payee varchar2(100);category varchar2(100);pan varchar2(100);hits number;
                 profile TDSTAXCATEGORYDETAIL%rowtype;gross number:=nvl(j.get_number('amount'),0);advance_tds number:=nvl(saved_header.TDSDEDUCTEDINADVANCE,0);
                 lower_applies varchar2(3):=nvl(saved_header.TDSLOWERRATEAPPLICABLE,'NO');lower_tds number:=saved_header.TDSLOWERRATE;lower_cess number:=saved_header.CESSLOWERRATE;lower_surcharge number:=saved_header.SURCHARGELOWERRATE;
                 total_percent number:=0;threshold number:=0;transaction_threshold number:=0;threshold_adjustment number:=0;prior_tds number;prior_expense number;deductable number:=0;
                 footer_percent number;footer_value number;tds_sum number:=0;formula varchar2(4000);lines json_array_t:=json_array_t();line json_object_t;
                 type values_t is table of number index by varchar2(100);computed values_t;
                begin
                 if own_tno is null or bill_tno is null then raise_application_error(-20074,'Select the owning Job Bill before calculating TDS');end if;
                 select partycode into party from JOBBILL where tno=bill_tno and companycode=company and financialyearcode=fy;
                 select count(*) into hits from JBPASS where tno=own_tno and (nvl(companycode,'~')<>nvl(company,'~') or nvl(financialyearcode,'~')<>nvl(fy,'~'));if hits>0 then raise_application_error(-20074,'Job Bill Pass belongs to another company or financial year');end if;
                 if gross<0 then raise_application_error(-20074,'TDS expense base cannot be negative');end if;
                 if nature is not null then
                  select TDSPAYEECATEGORYCODE into payee from PARTY where PARTYCODE=party;
                  category:=GetTDSTaxCategoryCode(payee,nature,doc_date);pan:=GetPartyAttributeValue(party,'PANNO');
                  select count(*) into hits from TDSTAXCATEGORY a join TDSTAXCATEGORYDETAIL b on b.tno=a.tno where a.TDSTAXCATEGORYCODE=category and b.TDSPAYEECATEGORYCODE=payee;
                  if hits<>1 then raise_application_error(-20074,'Select one configured TDS category for the Job Bill vendor and date');end if;
                  select b.* into profile from TDSTAXCATEGORY a join TDSTAXCATEGORYDETAIL b on b.tno=a.tno where a.TDSTAXCATEGORYCODE=category and b.TDSPAYEECATEGORYCODE=payee;
                  threshold:=nvl(profile.threshold,0);transaction_threshold:=nvl(profile.transactionthreshold,0);
                  total_percent:=case when pan is null then nvl(profile.TOTALTDSPERCENTWITHOUTPAN,0) else nvl(profile.TOTALTDSPERCENTWITHPAN,0) end;
                  if threshold>0 then
                   select nvl(sum(b.TDSAMOUNT),0),nvl(sum(case when b.THRESHOLDPLUSMINUS<0 and b.ADVANCEORBILL='BILL' and a.VOUCHERNO<>'OPENING' then -b.THRESHOLDPLUSMINUS else 0 end),0) into prior_tds,prior_expense
                   from VOUCHER a join VOUCHERTDSDEDUCTED b on b.tno=a.tno
                   where a.COMPANYCODE=company and a.FINANCIALYEARCODE=fy and b.PARTYCODE=party and b.TDSNATURECODE=nature
                   and not(nvl(a.MODULECODE,'~')='JBPASS' and nvl(a.MODULETNO,-1)=own_tno)
                   and not(nvl(a.MODULECODE,'~')='VOUCHER' and exists(select 1 from VOUCHER parent where parent.TNO=a.MODULETNO and parent.MODULECODE='JBPASS' and parent.MODULETNO=own_tno));
                   if prior_tds>0 then threshold_adjustment:=0;elsif prior_expense+gross>threshold or gross>transaction_threshold then threshold_adjustment:=prior_expense;else threshold_adjustment:=-gross;end if;
                  end if;
                  if total_percent>0 then deductable:=greatest(0,gross+threshold_adjustment-advance_tds);end if;
                  if total_percent>0 and deductable>0 then select count(*) into hits from FOOTERSCHEMELIST where COMPANYCODE=company and FINANCIALYEARCODE=fy and MODULECODE='JBPASS' and STATUS='ACTIVE' and FOOTERHEADCODE='.TDS.';if hits<>1 then raise_application_error(-20074,'Configure one active TDS scheme head for this company/year before saving');end if;end if;
                  for f in(select * from FOOTERSCHEMELIST where COMPANYCODE=company and FINANCIALYEARCODE=fy and MODULECODE='JBPASS' and STATUS='ACTIVE' and FOOTERHEADCODE in('.TDS.','.CESSONTDS.','.SURCHARGEONTDS.') order by sno)loop
                   if computed.exists(f.footerheadcode) then raise_application_error(-20074,'Duplicate active TDS scheme head');end if;
                   if pan is null then footer_percent:=case f.footerheadcode when '.TDS.' then profile.TDSPERCENTWITHOUTPAN when '.CESSONTDS.' then profile.CESSPERCENTWITHOUTPAN when '.SURCHARGEONTDS.' then profile.SURCHARGEPERCENTWITHOUTPAN end;
                   elsif lower_applies='YES' then footer_percent:=case f.footerheadcode when '.TDS.' then lower_tds when '.CESSONTDS.' then lower_cess when '.SURCHARGEONTDS.' then lower_surcharge end;
                   else footer_percent:=case f.footerheadcode when '.TDS.' then profile.TDSPERCENTWITHPAN when '.CESSONTDS.' then profile.CESSPERCENTWITHPAN when '.SURCHARGEONTDS.' then profile.SURCHARGEPERCENTWITHPAN end;end if;
                   formula:=replace(f.formula,'.A.',to_char(deductable,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''));
                   formula:=replace(formula,f.footerheadcode,to_char(nvl(footer_percent,0),'TM9','NLS_NUMERIC_CHARACTERS=''.,'''));
                   for dependency in(select footerheadcode from FOOTERSCHEMELIST where tno=f.tno and status='ACTIVE' and footerheadcode<>f.footerheadcode)loop
                    if instr(formula,dependency.footerheadcode)>0 and dependency.footerheadcode in('.TDS.','.CESSONTDS.','.SURCHARGEONTDS.') and not computed.exists(dependency.footerheadcode) then raise_application_error(-20074,'TDS scheme dependency must precede dependent head: '||dependency.footerheadcode);end if;
                    formula:=replace(formula,dependency.footerheadcode,to_char(case when computed.exists(dependency.footerheadcode) then computed(dependency.footerheadcode) else 0 end,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''));
                   end loop;
                   footer_value:=case when formula is null then 0 else greatest(0,ceil(round(getvalue(formula),nvl(GetMyParameterValue('TDSROUND'),'0')))) end;
                   computed(f.footerheadcode):=footer_value;tds_sum:=tds_sum+footer_value;
                   if footer_value>0 then line:=json_object_t();line.put('TNO',own_tno);line.put('SERIALNO',f.sno);line.put('FOOTERHEADCODE',f.footerheadcode);line.put('FOOTERPERCENT',nvl(footer_percent,0));line.put('FOOTERVALUE',footer_value);lines.append(line);end if;
                  end loop;
                  if total_percent>0 and deductable>0 and not computed.exists('.TDS.') then raise_application_error(-20074,'Configure one active TDS scheme head for this company/year before saving');end if;
                 end if;
                 result:=json_object_t();result.put('payee',payee);result.put('category',category);result.put('pan',pan);result.put('threshold',threshold);result.put('transactionThreshold',transaction_threshold);result.put('totalPercent',total_percent);result.put('thresholdAdjustment',threshold_adjustment);result.put('deductable',deductable);result.put('tds',tds_sum);result.put('footers',lines);
                end; end;
                 procedure money(actual number,wanted number,label varchar2) is begin if abs(nvl(actual,0)-nvl(wanted,0))>.0051 then raise_application_error(-20074,'Job Bill Pass '||label||' differs from independently calculated source');end if;end;
                begin
                 select * into saved_header from JBPASS where tno=:P221_TNO;
                 select nvl(sum(amount),0) into gross from JBPASSDETAIL where tno=saved_header.tno;request.put('amount',gross);apex_application.g_x01:=request.to_string();derive_context;apex_application.g_x01:=before_x01;
                 money(saved_header.TDSDEDUCTABLEAMOUNT,result.get_number('deductable'),'TDS base');money(saved_header.THRESHOLDPLUSMINUS,result.get_number('thresholdAdjustment'),'TDS threshold adjustment');money(saved_header.TOTALTDSPERCENT,result.get_number('totalPercent'),'TDS profile rate');money(saved_header.SUMOFTDSAMOUNT,result.get_number('tds'),'TDS summary');money(saved_header.AMOUNTAFTERTDS,nvl(saved_header.JBPASSAMOUNT,0)-nvl(saved_header.SUMOFWCTAMOUNT,0)-result.get_number('tds'),'amount after TDS');
                 money(saved_header.TDSTHRESHOLD,result.get_number('threshold'),'annual threshold');money(saved_header.TDSTRANSACTIONTHRESHOLD,result.get_number('transactionThreshold'),'transaction threshold');
                 if nvl(saved_header.ADVANCEORBILL,'~')<>'BILL' or nvl(saved_header.TDSPAYEECATEGORYCODE,'~')<>nvl(result.get_string('payee'),'~') or nvl(saved_header.TDSTAXCATEGORYCODE,'~')<>nvl(result.get_string('category'),'~') or nvl(saved_header.PANNO,'~')<>nvl(result.get_string('pan'),'~') then raise_application_error(-20074,'Job Bill Pass saved TDS profile does not belong to source vendor/date');end if;
                 lines:=result.get_array('footers');select count(*) into hits from JBPASSTDSDETAIL where tno=saved_header.tno;if hits<>lines.get_size() then raise_application_error(-20074,'Job Bill Pass TDS head count differs from source profile');end if;
                 for i in 0..lines.get_size()-1 loop line:=treat(lines.get(i) as json_object_t);head:=line.get_string('FOOTERHEADCODE');select count(*),max(footerpercent),max(footervalue) into hits,actual_percent,actual_value from JBPASSTDSDETAIL where tno=saved_header.tno and footerheadcode=head;if hits<>1 then raise_application_error(-20074,'Job Bill Pass TDS head is missing or duplicated');end if;money(actual_percent,line.get_number('FOOTERPERCENT'),'TDS head rate');money(actual_value,line.get_number('FOOTERVALUE'),'TDS head amount');end loop;
                exception when others then apex_application.g_x01:=before_x01;raise;
                end;
                 imart_txn_integrity.verify_activation('JBPASS',:P221_TNO);end if;end;
                ```
        }
        execution {
            sequence: 9950
        }
        advanced {
            executionMappingIdentifier: 99022120260928003
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

