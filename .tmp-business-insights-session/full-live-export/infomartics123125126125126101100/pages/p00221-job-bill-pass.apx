               var data=Array.from(table.querySelectorAll('tr[data-id]')).filter(function(r){return !r.classList.contains('is-aggregate')&&!r.classList.contains('u-invisible');}),last=data[data.length-1],row=table.querySelector('tr.hspl-p221-fd-total');
