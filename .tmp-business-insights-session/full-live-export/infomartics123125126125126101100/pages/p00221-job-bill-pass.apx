    process p221-calculate-detail (
        name: P221_CALCULATE_DETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                IMART_REFERENCE_SCOPE.assert_reference('JOBBILL',:P221_JOBBILLTNO,IMART_REFERENCE_SCOPE.company_code,'P221_JOBBILLTNO');
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);
                 v_tno number:=j.get_number('tno');v_sno number:=j.get_number('sno');hits number;
                 q1 number;q2 number;amount number;footer number;total number;old_amount number:=j.get_number('previousAmount');old_qty number:=j.get_number('previousQuantity');
                 job_code varchar2(100):=j.get_string('JOBTYPECODE');item_code varchar2(100):=j.get_string('item');spec_code varchar2(100):=j.get_string('spec');sac_code varchar2(100);unit1 varchar2(100);unit2 varchar2(100);factor number;is_job number:=0;source_party varchar2(100);tax_round varchar2(3):=:P221_TAXINROUNDFIGURE;preview_started boolean:=false;
                 type footer_rows_t is table of JBPASSDETAILFOOTER%rowtype;old_rows footer_rows_t;
                 type keys_t is table of boolean index by varchar2(100);seen_heads keys_t;
                 type rids_t is table of varchar2(30) index by varchar2(100);original_rids rids_t;
                 function jobpass_footer_value(legend varchar2,base_amount number,percent number,current_value number,quantity number) return number is code varchar2(30):=upper(trim(legend));begin
                 case code when 'PRA' then return round(abs(nvl(base_amount,0)*nvl(percent,0)/100),0);when 'PRD' then return -round(abs(nvl(base_amount,0)*nvl(percent,0)/100),0);when 'PAA' then return round(abs(nvl(base_amount,0)*nvl(percent,0)/100),2);when 'PAD' then return -round(abs(nvl(base_amount,0)*nvl(percent,0)/100),2);when 'OQA' then return abs(nvl(quantity,0)*nvl(percent,0));when 'OQD' then return -abs(nvl(quantity,0)*nvl(percent,0));when 'LSA' then return abs(nvl(current_value,0));when 'LSD' then return -abs(nvl(current_value,0));else return nvl(current_value,0);end case;end;
                
                begin
                 if v_tno is null or v_tno<>:P221_TNO then raise_application_error(-20074,'Job Bill Pass document identity changed');end if;
                 if v_sno is null then v_sno:=globaltno.nextval;end if;
                 select count(*) into hits from JBPASSDETAIL where sno=v_sno and tno<>v_tno;
                 if hits>0 then raise_application_error(-20074,'Job Bill Pass detail belongs to another document');end if;
                 select count(*) into hits from JBPASS where tno=v_tno and nvl(companycode,'~')<>nvl(:GLOBAL_COMPANYCODE,'~');
                 if hits>0 then raise_application_error(-20074,'Job Bill Pass belongs to another company');end if;
                 if old_amount is null then begin select amount,quantity1 into old_amount,old_qty from JBPASSDETAIL where tno=v_tno and sno=v_sno;exception when no_data_found then old_amount:=0;old_qty:=0;end;end if;
                 select partycode into source_party from JOBBILL where tno=:P221_JOBBILLTNO and companycode=:GLOBAL_COMPANYCODE;
                 savepoint jobpass_preview;preview_started:=true;
                 for f in(select sn,rowid rid from JBPASSDETAILFOOTER where tno=v_tno and sno=v_sno)loop
                  declare own_sn number:=f.sn;begin if own_sn is null then own_sn:=globaltno.nextval;update JBPASSDETAILFOOTER set sn=own_sn where rowid=f.rid;end if;original_rids(to_char(own_sn)):=f.rid;end;
                 end loop;
                 if j.has('footers') then
                  declare lines json_array_t:=j.get_array('footers');line json_object_t;r JBPASSDETAILFOOTER%rowtype;empty_row JBPASSDETAILFOOTER%rowtype;cache_rows footer_rows_t:=footer_rows_t();seen keys_t;own_sn number;own_rid varchar2(30);
                  begin
                   for k in 0..lines.get_size()-1 loop
                    line:=treat(lines.get(k) as json_object_t);r:=empty_row;
                    if nvl(line.get_number('TNO'),-1)<>v_tno or nvl(line.get_number('SNO'),-1)<>v_sno then raise_application_error(-20074,'Preview footer belongs to another detail');end if;
                    if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20074,'Select a footer head and legend');end if;
                    own_sn:=line.get_number('SN');own_rid:=line.get_string('ROWID');
                    if own_rid is not null and not regexp_like(own_rid,'^t[0-9]+$') then
                     begin select * into r from JBPASSDETAILFOOTER where rowid=chartorowid(own_rid) and tno=v_tno and sno=v_sno;exception when no_data_found then raise_application_error(-20074,'Footer ROWID is stale or belongs to another detail');end;
                     if own_sn is not null and r.sn<>own_sn then raise_application_error(-20074,'Footer SN and ROWID disagree');end if;own_sn:=nvl(own_sn,r.sn);
                    elsif own_rid is not null then
                     null; /* APEX temporary ROWID is a client key, not a durable footer SN. */
                    end if;
                    if own_sn is null then own_sn:=globaltno.nextval;end if;
                    if seen.exists(to_char(own_sn)) then raise_application_error(-20074,'Duplicate footer SN');end if;seen(to_char(own_sn)):=true;
                    select count(*) into hits from JBPASSDETAILFOOTER where sn=own_sn and(tno<>v_tno or sno<>v_sno);if hits>0 then raise_application_error(-20074,'Footer SN belongs to another detail');end if;
                    if r.tno is null then begin select * into r from JBPASSDETAILFOOTER where tno=v_tno and sno=v_sno and sn=own_sn;exception when no_data_found then null;end;end if;
                    r.tno:=v_tno;r.sno:=v_sno;r.sn:=own_sn;r.serialno:=k+1;r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');if line.has('CREDITPERCENT') then r.creditpercent:=line.get_number('CREDITPERCENT');end if;if line.has('FOOTERNATURECODE') then r.footernaturecode:=line.get_string('FOOTERNATURECODE');end if;
                    cache_rows.extend;cache_rows(cache_rows.count):=r;
                   end loop;
                   delete from JBPASSDETAILFOOTER where tno=v_tno and sno=v_sno;
                   for k in 1..cache_rows.count loop r:=cache_rows(k);insert into JBPASSDETAILFOOTER values r;end loop;
                  end;
                 end if;
                 select * bulk collect into old_rows from JBPASSDETAILFOOTER where tno=v_tno and sno=v_sno;
                 delete from JBPASSDETAILFOOTER where tno=v_tno and sno=v_sno;
                 q1:=nvl(j.get_number('q1'),0);q2:=nvl(j.get_number('q2'),0);
                 if item_code is not null then
                  select count(*) into hits from item where itemcode=item_code;if hits<>1 then raise_application_error(-20074,'Select one valid item');end if;
                  select measuringunitcode1,measuringunitcode2 into unit1,unit2 from item where itemcode=item_code;
                  select count(*) into hits from itemspecification where itemspecificationcode=spec_code and tno in(select tno from item where itemcode=item_code);if hits<>1 then raise_application_error(-20074,'Specification does not belong to selected item');end if;
                  select multiplyingfactor,trim(hsncode) into factor,sac_code from itemspecification where itemspecificationcode=spec_code and tno in(select tno from item where itemcode=item_code);
                  q1:=round(q1,getuomdecimal(unit1));q2:=round(q1*nvl(factor,1),3);
                  if j.get_string('unit')=unit1 then amount:=q1*nvl(j.get_number('rate'),0);elsif unit2 is not null and j.get_string('unit')=unit2 then amount:=q2*nvl(j.get_number('rate'),0);else raise_application_error(-20074,'Rate UOM does not belong to selected item');end if;
                 elsif job_code is not null then
                  select count(*) into hits from jobtype where jobtypecode=job_code;if hits<>1 then raise_application_error(-20074,'Select one valid Job Type');end if;
                  select trim(saccode) into sac_code from jobtype where jobtypecode=job_code;is_job:=1;amount:=q1*nvl(j.get_number('rate'),0);
                 else raise_application_error(-20074,'Select an item or Job Type');end if;
                 if amount>0 then
                  for f in(select rownum serialno,x.* from(
                   select a.legendscode,c.footerheadcode,b.taxrate footerpercent
                   from taxruledetail a join taxruledetailfooter b on b.tno=a.tno and b.sno=a.sno
                   join footerhead c on c.footerheadcode=b.footerheadcode join taxrule d on d.tno=a.tno
                   join party p on p.taxregistrationtypecode=d.taxregistrationtypecode
                   where p.partycode=source_party and p.taxregistrationtypecode='RD' and d.transactiontypecode=:P221_TRANSACTIONTYPECODE and ((is_job=1 and exists(select 1 from taxrulesac e where e.tno=d.tno and trim(e.saccode)=sac_code)) or (is_job=0 and exists(select 1 from taxrulehsn e where e.tno=d.tno and trim(e.hsncode)=sac_code)))
                  )x)loop
                   declare legend varchar2(30):=f.legendscode;val number;begin
                    if tax_round='YES' and legend='PAA' then legend:='PRA';elsif tax_round='NO' and legend='PRA' then legend:='PAA';end if;
                    val:=jobpass_footer_value(legend,amount,f.footerpercent,0,q1);
                    insert into JBPASSDETAILFOOTER(tno,sno,sn,serialno,footerheadcode,footerpercent,footervalue,legendscode) values(v_tno,v_sno,globaltno.nextval,f.serialno,f.footerheadcode,f.footerpercent,val,legend);
                   end;
                  end loop;
                 end if;
                 for k in 1..old_rows.count loop
                  if j.get_string('field') in('HEADER','JOBTYPECODE','ITEMCODE','ITEMSPECIFICATIONCODE','TAX_ROUND') and old_rows(k).footerheadcode in('.CGST.','.SGST.','.IGST.') then continue;end if;
                  if not seen_heads.exists(old_rows(k).footerheadcode) then delete from JBPASSDETAILFOOTER where tno=v_tno and sno=v_sno and footerheadcode=old_rows(k).footerheadcode;seen_heads(old_rows(k).footerheadcode):=true;end if;
                  if upper(trim(old_rows(k).legendscode)) in('PRA','PRD','PAA','PAD','OQA','OQD') and (
                   abs(nvl(old_rows(k).footervalue,0)-jobpass_footer_value(old_rows(k).legendscode,old_amount,old_rows(k).footerpercent,old_rows(k).footervalue,old_qty))<=.0051
                   or (upper(trim(old_rows(k).legendscode))='OQA' and abs(nvl(old_rows(k).footervalue,0)+abs(nvl(old_qty,0)*nvl(old_rows(k).footerpercent,0)/100))<=.0051)
                   or (upper(trim(old_rows(k).legendscode))='OQA' and abs(nvl(old_rows(k).footervalue,0)-abs(nvl(old_qty,0)*nvl(old_rows(k).footerpercent,0)/100))<=.0051)
                   or (upper(trim(old_rows(k).legendscode))='OQD' and abs(nvl(old_rows(k).footervalue,0)+abs(nvl(old_qty,0)*nvl(old_rows(k).footerpercent,0)/100))<=.0051)) then
                   old_rows(k).footervalue:=jobpass_footer_value(old_rows(k).legendscode,amount,old_rows(k).footerpercent,old_rows(k).footervalue,q1);
                  elsif upper(trim(old_rows(k).legendscode)) in('LSA','LSD') then old_rows(k).footervalue:=jobpass_footer_value(old_rows(k).legendscode,amount,old_rows(k).footerpercent,old_rows(k).footervalue,q1);end if;
                  insert into JBPASSDETAILFOOTER values old_rows(k);
                 end loop;
                 select nvl(sum(footervalue),0) into footer from JBPASSDETAILFOOTER where tno=v_tno and sno=v_sno;total:=amount+footer;
                 apex_json.open_object;apex_json.write('sno',v_sno);apex_json.write('q1',q1);apex_json.write('q2',q2);apex_json.write('rate',j.get_number('rate'));apex_json.write('unit',j.get_string('unit'));apex_json.write('amount',amount);apex_json.write('footer',footer);apex_json.write('total',total);apex_json.write('primaryUnit',unit1);apex_json.write('secondaryUnit',unit2);
                 apex_json.open_array('footers');
                 for f in(select * from JBPASSDETAILFOOTER where tno=v_tno and sno=v_sno order by serialno,sn)loop
                  apex_json.open_object;apex_json.write('TNO',f.tno);apex_json.write('SNO',f.sno);apex_json.write('SN',f.sn);apex_json.write('SERIALNO',f.serialno);apex_json.write('FOOTERHEADCODE',f.footerheadcode);apex_json.write('LEGENDSCODE',f.legendscode);apex_json.write('CREDITPERCENT',f.creditpercent,true);apex_json.write('FOOTERNATURECODE',f.footernaturecode,true);apex_json.write('FOOTERPERCENT',f.footerpercent);apex_json.write('FOOTERVALUE',f.footervalue);
                  if original_rids.exists(to_char(f.sn)) then apex_json.write('ROWID',original_rids(to_char(f.sn)));else apex_json.write('ROWID','t'||to_char(f.sn));end if;apex_json.close_object;
                 end loop;
                 apex_json.close_array;rollback to jobpass_preview;preview_started:=false;apex_json.close_object;
                exception when others then if preview_started then rollback to jobpass_preview;end if;raise;
                end;
                end;
                ```
        }
        execution {
            sequence: 0
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99022120260929052
        }
    )

    process p221-footer-calculate (
        name: P221_FOOTER_CALCULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare j json_object_t:=json_object_t.parse(apex_application.g_x01);code varchar2(30):=upper(trim(j.get_string('legend')));base_amount number:=j.get_number('amount');percent number:=j.get_number('percent');quantity number:=j.get_number('quantity');v number:=j.get_number('value');begin
                case code when 'PAA' then v:=round(abs(base_amount*percent/100),2);when 'PAD' then v:=-round(abs(base_amount*percent/100),2);when 'PRA' then v:=round(abs(base_amount*percent/100),0);when 'PRD' then v:=-round(abs(base_amount*percent/100),0);when 'OQA' then if quantity is null then raise_application_error(-20074,'Owning service quantity is missing');end if;v:=abs(quantity*percent);when 'OQD' then if quantity is null then raise_application_error(-20074,'Owning service quantity is missing');end if;v:=-abs(quantity*percent);when 'LSA' then v:=abs(v);when 'LSD' then v:=-abs(v);else null;end case;apex_json.open_object;apex_json.write('value',v);apex_json.close_object;end;
                ```
        }
        execution {
            sequence: 0
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99022120260929053
        }
    )

    process p221-tax-context (
        name: P221_TAX_CONTEXT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);
                 own_tno number:=:P221_TNO;bill_tno number:=:P221_JOBBILLTNO;company varchar2(100):=:P221_COMPANYCODE;fy varchar2(100):=:P221_FINANCIALYEARCODE;
                 doc_date date:=to_date(:P221_JBPASSDATE,'DD-MM-RRRR');nature varchar2(100):=:P221_TDSNATURECODE;
                 party varchar2(100);payee varchar2(100);category varchar2(100);pan varchar2(100);hits number;
                 profile TDSTAXCATEGORYDETAIL%rowtype;gross number:=nvl(j.get_number('amount'),0);advance_tds number:=nvl(:P221_TDSDEDUCTEDINADVANCE,0);
                 lower_applies varchar2(3):=nvl(:P221_TDSLOWERRATEAPPLICABLE,'NO');lower_tds number:=:P221_TDSLOWERRATE;lower_cess number:=:P221_CESSLOWERRATE;lower_surcharge number:=:P221_SURCHARGELOWERRATE;
                 total_percent number:=0;threshold number:=0;transaction_threshold number:=0;threshold_adjustment number:=0;prior_tds number;prior_expense number;deductable number:=0;
                 footer_percent number;footer_value number;tds_sum number:=0;formula varchar2(4000);lines json_array_t:=json_array_t();line json_object_t;
                 type values_t is table of number index by varchar2(100);computed values_t;
                begin
                 if own_tno is null or bill_tno is null then raise_application_error(-20074,'Select the owning Job Bill before calculating TDS');end if;
                 select partycode into party from JOBBILL where tno=bill_tno and companycode=company and financialyearcode=fy;
                 select count(*) into hits from JBPASS where tno=own_tno and (nvl(companycode,'~')<>nvl(company,'~') or nvl(financialyearcode,'~')<>nvl(fy,'~'));if hits>0 then raise_application_error(-20074,'Job Bill Pass belongs to another company or financial year');end if;
                 if gross<0 then raise_application_error(-20074,'TDS expense base cannot be negative');end if;
                 if nature is not null then
                  select TDSPAYEECATEGORYCODE into payee from PARTY where PARTYCODE=party;
                  category:=GetTDSTaxCategoryCode(payee,nature,doc_date);pan:=GetPartyAttributeValue(party,'PANNO');
                  select count(*) into hits from TDSTAXCATEGORY a join TDSTAXCATEGORYDETAIL b on b.tno=a.tno where a.TDSTAXCATEGORYCODE=category and b.TDSPAYEECATEGORYCODE=payee;
                  if hits<>1 then raise_application_error(-20074,'Select one configured TDS category for the Job Bill vendor and date');end if;
                  select b.* into profile from TDSTAXCATEGORY a join TDSTAXCATEGORYDETAIL b on b.tno=a.tno where a.TDSTAXCATEGORYCODE=category and b.TDSPAYEECATEGORYCODE=payee;
                  threshold:=nvl(profile.threshold,0);transaction_threshold:=nvl(profile.transactionthreshold,0);
                  total_percent:=case when pan is null then nvl(profile.TOTALTDSPERCENTWITHOUTPAN,0) else nvl(profile.TOTALTDSPERCENTWITHPAN,0) end;
                  if threshold>0 then
                   select nvl(sum(b.TDSAMOUNT),0),nvl(sum(case when b.THRESHOLDPLUSMINUS<0 and b.ADVANCEORBILL='BILL' and a.VOUCHERNO<>'OPENING' then -b.THRESHOLDPLUSMINUS else 0 end),0) into prior_tds,prior_expense
                   from VOUCHER a join VOUCHERTDSDEDUCTED b on b.tno=a.tno
                   where a.COMPANYCODE=company and a.FINANCIALYEARCODE=fy and b.PARTYCODE=party and b.TDSNATURECODE=nature
                   and not(nvl(a.MODULECODE,'~')='JBPASS' and nvl(a.MODULETNO,-1)=own_tno)
                   and not(nvl(a.MODULECODE,'~')='VOUCHER' and exists(select 1 from VOUCHER parent where parent.TNO=a.MODULETNO and parent.MODULECODE='JBPASS' and parent.MODULETNO=own_tno));
                   if prior_tds>0 then threshold_adjustment:=0;elsif prior_expense+gross>threshold or gross>transaction_threshold then threshold_adjustment:=prior_expense;else threshold_adjustment:=-gross;end if;
                  end if;
                  if total_percent>0 then deductable:=greatest(0,gross+threshold_adjustment-advance_tds);end if;
                  if total_percent>0 and deductable>0 then select count(*) into hits from FOOTERSCHEMELIST where COMPANYCODE=company and FINANCIALYEARCODE=fy and MODULECODE='JBPASS' and STATUS='ACTIVE' and FOOTERHEADCODE='.TDS.';if hits<>1 then raise_application_error(-20074,'Configure one active TDS scheme head for this company/year before saving');end if;end if;
                  for f in(select * from FOOTERSCHEMELIST where COMPANYCODE=company and FINANCIALYEARCODE=fy and MODULECODE='JBPASS' and STATUS='ACTIVE' and FOOTERHEADCODE in('.TDS.','.CESSONTDS.','.SURCHARGEONTDS.') order by sno)loop
                   if computed.exists(f.footerheadcode) then raise_application_error(-20074,'Duplicate active TDS scheme head');end if;
                   if pan is null then footer_percent:=case f.footerheadcode when '.TDS.' then profile.TDSPERCENTWITHOUTPAN when '.CESSONTDS.' then profile.CESSPERCENTWITHOUTPAN when '.SURCHARGEONTDS.' then profile.SURCHARGEPERCENTWITHOUTPAN end;
                   elsif lower_applies='YES' then footer_percent:=case f.footerheadcode when '.TDS.' then lower_tds when '.CESSONTDS.' then lower_cess when '.SURCHARGEONTDS.' then lower_surcharge end;
                   else footer_percent:=case f.footerheadcode when '.TDS.' then profile.TDSPERCENTWITHPAN when '.CESSONTDS.' then profile.CESSPERCENTWITHPAN when '.SURCHARGEONTDS.' then profile.SURCHARGEPERCENTWITHPAN end;end if;
                   formula:=replace(f.formula,'.A.',to_char(deductable,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''));
                   formula:=replace(formula,f.footerheadcode,to_char(nvl(footer_percent,0),'TM9','NLS_NUMERIC_CHARACTERS=''.,'''));
                   for dependency in(select footerheadcode from FOOTERSCHEMELIST where tno=f.tno and status='ACTIVE' and footerheadcode<>f.footerheadcode)loop
                    if instr(formula,dependency.footerheadcode)>0 and dependency.footerheadcode in('.TDS.','.CESSONTDS.','.SURCHARGEONTDS.') and not computed.exists(dependency.footerheadcode) then raise_application_error(-20074,'TDS scheme dependency must precede dependent head: '||dependency.footerheadcode);end if;
                    formula:=replace(formula,dependency.footerheadcode,to_char(case when computed.exists(dependency.footerheadcode) then computed(dependency.footerheadcode) else 0 end,'TM9','NLS_NUMERIC_CHARACTERS=''.,'''));
                   end loop;
                   footer_value:=case when formula is null then 0 else greatest(0,ceil(round(getvalue(formula),nvl(GetMyParameterValue('TDSROUND'),'0')))) end;
                   computed(f.footerheadcode):=footer_value;tds_sum:=tds_sum+footer_value;
                   if footer_value>0 then line:=json_object_t();line.put('TNO',own_tno);line.put('SERIALNO',f.sno);line.put('FOOTERHEADCODE',f.footerheadcode);line.put('FOOTERPERCENT',nvl(footer_percent,0));line.put('FOOTERVALUE',footer_value);lines.append(line);end if;
                  end loop;
                  if total_percent>0 and deductable>0 and not computed.exists('.TDS.') then raise_application_error(-20074,'Configure one active TDS scheme head for this company/year before saving');end if;
                 end if;
                 apex_json.open_object;apex_json.write('party',party);apex_json.write('payee',payee,true);apex_json.write('category',category,true);apex_json.write('pan',pan,true);apex_json.write('threshold',threshold);apex_json.write('transactionThreshold',transaction_threshold);apex_json.write('totalPercent',total_percent);apex_json.write('thresholdAdjustment',threshold_adjustment);apex_json.write('priorTds',nvl(prior_tds,0));apex_json.write('priorExpense',nvl(prior_expense,0));apex_json.write('deductable',deductable);apex_json.write('tds',tds_sum);apex_json.write_raw('footers',lines.to_clob());apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 0
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99022120260929056
