              function footerValue(line,amount,qty){var p=num(line.FOOTERPERCENT),v=num(line.FOOTERVALUE),legend=String(line.LEGENDSCODE||'').toUpperCase().trim();switch(legend){case 'PRA':return Math.round(amount*p/100);case 'PRD':return -Math.round(amount*p/100);case 'PAA':return Math.round(Math.abs(amount*p/100)*100)/100;case 'PAD':return -Math.round(Math.abs(amount*p/100)*100)/100;case 'OQA':return Math.abs(qty*p);case 'OQD':return -Math.abs(qty*p);default:return v;}}
