             function signature(){return JSON.stringify(fields.map(value).concat([value('SUMOFAMOUNT')]));}
             function net(){var amount=number(value('JBPASSAMOUNT'))-number(value('SUMOFWCTAMOUNT'))-number(value('SUMOFTDSAMOUNT'));set('AMOUNTAFTERTDS',amount);set('NETPAYABLEAMOUNT',amount);}
             function render(lines){var root=document.getElementById('TDS');if(!root)return;var nativeGrid=root.querySelector('.a-IG');if(nativeGrid)nativeGrid.style.display='none';var box=root.querySelector('.hspl-p221-tax-preview');if(!box){box=document.createElement('div');box.className='hspl-p221-tax-preview';root.appendChild(box);}box.replaceChildren();var table=document.createElement('table');table.className='t-Report-report';var body=document.createElement('tbody');table.appendChild(body);var heading=document.createElement('tr');['TDS Head','Rate','Amount'].forEach(function(label){var th=document.createElement('th');th.textContent=label;heading.appendChild(th);});body.appendChild(heading);var sum=0;lines.forEach(function(line){var row=document.createElement('tr');[line.FOOTERHEADCODE,number(line.FOOTERPERCENT),number(line.FOOTERVALUE).toFixed(2)].forEach(function(text){var cell=document.createElement('td');cell.textContent=text;row.appendChild(cell);});sum+=number(line.FOOTERVALUE);body.appendChild(row);});var total=document.createElement('tr');total.className='hspl-p221-tax-total';['Total','',sum.toFixed(2)].forEach(function(text){var cell=document.createElement('td');cell.textContent=text;cell.style.fontWeight='700';total.appendChild(cell);});body.appendChild(total);box.appendChild(table);}
