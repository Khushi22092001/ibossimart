    pageItem P221_DEBITNOTEAMOUNT (
        type: numberField
        label {
            label: Debit Note Amount
            alignment: left
        }
        settings {
            numberAlignment: end
        }
        layout {
            sequence: 80
            region: @account-posting-detail
            slot: regionBody
            alignment: left
            labelColumnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: 999999999.99
            width: 37
        }
        advanced {
            customAttributes: readonly=true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select nvl(DEBITNOTEAMOUNT,(:P221_JBPASSAMOUNT - NVL(:P221_DEBITNOTEAMOUNT,0))) from debitnote     
                where REFERENCEMODULETNO = :P221_TNO;
                ```
        }
        sessionState {
            storage: request
        }
    )

    pageItem P221_DEBITNOTENO (
        type: textField
        label {
            label: Debit Voucher No
            alignment: left
        }
        layout {
            sequence: 30
            region: @account-posting-detail
            slot: regionBody
            alignment: left
            labelColumnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 37
        }
        advanced {
            customAttributes: readonly=true
            postText: <a href="f?p=&APP_ID.:156:&SESSION.::NO:RP,156:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS,P156_CALLEDFROMTNO:&P221_DEBITNOTETNO.,221,CALLED,&P221_TNO."><span class="fa fa-magic"></span></a>
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select VOUCHERNO from voucher 
                where moduletno in (
                                    select tno from debitnote
                                    where REFERENCEMODULETNO = :P221_TNO
                );
                ```
        }
    )

