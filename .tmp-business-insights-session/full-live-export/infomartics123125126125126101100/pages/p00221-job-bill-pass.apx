                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      rtvalue number;
                    BEGIN
                      if :P221_BILLINROUNDFIGURE = 'YES' then
                            rtvalue := round(:P221_JBPASSAMOUNTBEFOREROUND,0) - :P221_JBPASSAMOUNTBEFOREROUND ;
                      else  rtvalue := 0;
                      end if;
                      
                      return(rtvalue);
                    
                    END;
