                var tno=String(apex.item('P221_TNO').getValue()),sno=String(apex.item('P221_SNO').getValue()),list=[],owns=true;
                if(type==='insert'&&sno&&sno!=='undefined'){restoringFooter=true;try{footerModel.forEach(function(r,i,id){var m=footerModel.getRecordMetadata(id)||{};if(m.deleted||m.agg)return;['TNO','SNO'].forEach(function(f){if(!raw(footerModel.getValue(r,f)))footerModel.setValue(r,f,f==='TNO'?tno:sno);});});}finally{restoringFooter=false;}}
