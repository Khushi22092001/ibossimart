            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Amount (₹)
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column LINE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Line
            }
            layout {
                sequence: 20
            }
        )

        column NOTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Basis
            }
            layout {
                sequence: 40
            }
        )

        column ORD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Ord
            }
            layout {
                sequence: 10
            }
            serverSideCondition {
                type: never
            }
        )

