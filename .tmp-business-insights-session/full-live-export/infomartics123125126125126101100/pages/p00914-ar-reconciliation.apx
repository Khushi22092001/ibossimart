            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 907
                items: {
                    P907_FROMDATE: &P914_FROMDATE.
                    P907_TODATE: &P914_TODATE.
                    P907_COMPANY: &P914_COMPANY.
                    P907_LOCATION: &P914_LOCATION.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

