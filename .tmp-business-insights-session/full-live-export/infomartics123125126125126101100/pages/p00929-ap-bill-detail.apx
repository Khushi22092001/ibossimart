            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Account
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ACCOUNT_CODE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
        )

        column CREDIT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Credit (₹)
                alignment: end
