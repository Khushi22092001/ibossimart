page 36 (
    name: Item Group List
    alias: ITEM-TYPE-LIST
    title: Item Group List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    htmlHeader {
        htmlHeader:
            ```html
            
            <script id="hspl-sidebar-head-state">
            (function(d){
              var state='closed';
              try {
                var saved=window.localStorage.getItem('imart.sidebar.state.v1');
                if(saved==='open'||saved==='closed') state=saved;
              } catch(ignore) {}
              d.classList.remove(state==='open'?'hspl-nav-target-closed':'hspl-nav-target-open');
              d.classList.add(state==='open'?'hspl-nav-target-open':'hspl-nav-target-closed');
            })(document.documentElement);
            </script>
            <style id="hspl-register-first-paint">
            /* Match the application's existing final register palette at parser time.
               These declarations intentionally duplicate (not replace) the final shared
               design-system values, preventing the older theme palette from becoming a
               visible intermediate frame during initial render or APEX IR refresh. */
            body:not(.t-PageBody--login) .a-IRR-header,
            body:not(.t-PageBody--login) .a-IRR-table th.a-IRR-header,
            body:not(.t-PageBody--login) .a-IRR-table thead th,
            body:not(.t-PageBody--login) .t-fht-thead th,
            body:not(.t-PageBody--login) .t-fht-thead .a-IRR-header {
              background:#e6e8f7!important;
              color:#3f4a7a!important;
            }
            body:not(.t-PageBody--login) .a-IRR-toolbar,
            body:not(.t-PageBody--login) .a-IRR-controlsContainer {
              background:#f4f3fd!important;
              border-color:#e6e4f7!important;
            }
            body:not(.t-PageBody--login) .a-IRR-table tbody tr:nth-child(even) td:not([style*="background"]) {
              background-color:#f3f6fc!important;
            }
            body:not(.t-PageBody--login) .a-IRR-table tbody tr:nth-child(odd) td:not([style*="background"]) {
              background-color:#fff!important;
            }
            body:not(.t-PageBody--login) .a-IRR-table tbody tr:hover td:not([style*="background"]) {
              background-color:#eaf0fb!important;
            }
            body:not(.t-PageBody--login) .t-Region:has(.a-IRR),
            body:not(.t-PageBody--login) .a-IRR,
            body:not(.t-PageBody--login) .a-IRR-region,
            body:not(.t-PageBody--login) .t-IRR-region,
            body:not(.t-PageBody--login) .a-IRR-content,
            body:not(.t-PageBody--login) .a-IRR-table,
            body:not(.t-PageBody--login) .t-fht-wrapper,
            body:not(.t-PageBody--login) .t-fht-thead,
            body:not(.t-PageBody--login) .t-fht-tbody {
              animation:none!important;
              transition:none!important;
            }
            </style>
            <style id="hspl-register-cell-paint-lock">
            /* APEX/UT gives report cells a background/color transition. During an IR
               refresh the replacement rows therefore fade from the native palette into
               the application palette. Keep every existing colour and hover selector,
               but make their application atomic. */
            body:not(.t-PageBody--login) .a-IRR-table th,
            body:not(.t-PageBody--login) .a-IRR-table td,
            body:not(.t-PageBody--login) .a-IRR-table .a-IRR-headerLink,
            body:not(.t-PageBody--login) .t-fht-thead th,
            body:not(.t-PageBody--login) .t-fht-tbody td {
              animation:none!important;
              transition:none!important;
            }
            </style>
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region item-type-list (
        name: Item Group List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.ITEMTYPECODE,
                       a.ITEMTYPENAME,
                       a.ITEMTYPESHORTNAME,
                       a.REMARK,
                       a.CREATOR,
                      to_char(a.CREATIONTIME,'DD-MM-YYYY HH24:MI:SS') CREATIONTIME,
                      b.ITEMTYPEname as parentname
                  from ITEMTYPE a , ITEMTYPE b
                  where a.parentcode = b.ITEMTYPECODE(+)
                  Order By CREATIONTIME DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 37
                items: {
                    P37_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 139151183088356039
        }

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 16
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ITEMTYPECODE (
            type: plainText
            heading {
                heading: Item Group Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column ITEMTYPENAME (
            type: plainText
            heading {
                heading: Item Group Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ITEMTYPESHORTNAME (
            type: plainText
            heading {
                heading: Item Group Short Name
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column PARENTNAME (
            type: plainText
            heading {
                heading: Parent Name
            }
            layout {
                sequence: 26
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Item Group List
        }

        savedReport 1391586 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATIONTIME (
                sequence: 7
            )

            displayColumn CREATOR (
                sequence: 6
            )

            displayColumn ITEMTYPECODE (
                sequence: 1
            )

            displayColumn ITEMTYPENAME (
                sequence: 2
            )

            displayColumn ITEMTYPESHORTNAME (
                sequence: 3
            )

            displayColumn PARENTNAME (
                sequence: 4
            )

            displayColumn REMARK (
                sequence: 5
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @item-type-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 37
                clearCache: 37
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @item-type-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-type-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @item-type-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-type-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

