page 924 (
    name: Payments and Settlement
    alias: AP-PAYMENTS
    title: Payments and Settlement
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #APP_FILES#hspl-jet-l10n-fallback.js?version=#APP_VERSION#&cb=20260924a
    }
    htmlHeader {
        htmlHeader:
            ```html
            
            <script id="hspl-sidebar-head-state">
            (function(d){
              var state='closed';
              try {
                var saved=window.localStorage.getItem('imart.sidebar.state.v1');
                if(saved==='open'||saved==='closed') state=saved;
              } catch(ignore) {}
              d.classList.remove(state==='open'?'hspl-nav-target-closed':'hspl-nav-target-open');
              d.classList.add(state==='open'?'hspl-nav-target-open':'hspl-nav-target-closed');
            })(document.documentElement);
            </script>
            ```
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Payments are actual PAYMENT, CASHPAYMENT and BANKPAYMENT voucher lines debited to a vendor account between From Date and To Date - every channel, so bank-statement uploads (EBSUPLOAD) and direct vouchers count alongside payment advices. Never a fall in outstanding, which also moves through debit notes, journals and allocation. This page is a FLOW report: the As-of Date bounds only the settlement state. Bank is derived from the contra (credit) account on the same payment voucher and covers all channels. Payment MODE is reliable only where a PaymentAdvice exists (99.7% coverage there, about 30% of payment value overall) - the mode chart is scoped to advice-routed payments and says so on its face.
    }

    region approval-pipeline (
        name: Payment Approval Pipeline
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Advices raised but not marked done - approved liability queued for
                   execution. This is the operational payment-approval pipeline the
                   brief asks for, and it exists only in the PaymentAdvice channel:
                   bank uploads and direct vouchers have no approval state to show. */
                Select pa.PaymentAdviceNo                                As ADVICE_NO,
                       pa.PaymentAdviceDate                              As ADVICE_DATE,
                       nvl(p.PartyName, pa.PartyCode)   As VENDOR,
                       Round(nvl(pa.AmountCr,0),2)                       As AMOUNT,
                       nvl(pa.MoneyTransferModeCode,'-')                 As TRANSFER_MODE,
                       trunc(sysdate) - pa.PaymentAdviceDate             As DAYS_WAITING,
                       substr(pa.Remark,1,200)          As REMARK
                  From PaymentAdvice pa
                  Left Join Party p On p.PartyCode = pa.PartyCode
                 Where nvl(pa.PaymentDone,'NO') <> 'YES'
                   And (cast(null as varchar2(100)) Is Null
                        Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                   And (null    Is Null Or cast(null as varchar2(100))        = null)
                   And (:P924_COMPANY  Is Null Or pa.CompanyCode  = :P924_COMPANY)
                   And (:P924_LOCATION Is Null Or pa.LocationCode = :P924_LOCATION)
                 Order By pa.PaymentAdviceDate, pa.PaymentAdviceNo
                ```
            pageItemsToSubmit: [
                P924_FROMDATE
                P924_TODATE
                P924_COMPANY
                P924_LOCATION
            ]
        }
        layout {
            sequence: 36
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-matchchart
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Nothing is waiting in the approval pipeline for this scope - every advice raised has been executed.
        }

        column ADVICE_DATE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Date
            }
            layout {
                sequence: 20
            }
        )

        column ADVICE_NO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Advice No
            }
            layout {
                sequence: 10
            }
        )

        column AMOUNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Amount (₹)
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column DAYS_WAITING (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Days Waiting
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

        column REMARK (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Remark
            }
            layout {
                sequence: 70
            }
        )

        column TRANSFER_MODE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Mode
            }
            layout {
                sequence: 50
            }
        )

        column VENDOR (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Vendor
            }
            layout {
                sequence: 30
            }
        )

    )

    region bank-mix (
        name: Payments by Bank
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Bank is the CONTRA account on the payment voucher - the account that
                   was credited when the vendor was debited. It is not stored on the
                   payment line, and it is the only banking dimension that covers ALL
                   payment channels (advices, bank-statement uploads, direct vouchers).
                   The contra is aggregated per voucher before it is attributed, so a
                   payment split across two banks is not double counted. */
                With Sd As (
                       Select PartyCode From Party
                        Start With PartyCode = 'SUNDRYCREDITORS'
                        Connect By Prior PartyCode = ParentCode),
                     Rv As (
                       Select Distinct d.Tno
                         From VoucherDetail d Join Voucher v On v.Tno = d.Tno
                        Where d.AccountCode In (Select PartyCode From Sd)
                          And v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT')
                          And d.Amount < 0
                          And d.VoucherDate >= to_date(:P924_FROMDATE,'DD-MM-RRRR')
                          And d.VoucherDate <  to_date(:P924_TODATE,'DD-MM-RRRR') + 1
                          And (cast(null as varchar2(100)) Is Null
                               Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                          And (null    Is Null Or cast(null as varchar2(100))        = null)
                          And (:P924_COMPANY  Is Null Or d.CompanyCode  = :P924_COMPANY)
                          And (:P924_LOCATION Is Null Or d.LocationCode = :P924_LOCATION))
                Select * From (
                  Select nvl(p.PartyName, o.AccountCode) As LABEL,
                         Round(Sum(o.Amount)/100000,2) As RECEIVED_LAC
                    From VoucherDetail o
                    Join Rv On Rv.Tno = o.Tno
                    Left Join Party p On p.PartyCode = o.AccountCode
                   Where o.Amount > 0
                     And o.AccountCode Not In (Select PartyCode From Sd)
                   Group By o.AccountCode, p.PartyName
                   Order By Sum(o.Amount) Desc)
                 Where rownum <= 12
                 /* Outer Order By is required: the inner one only picks the twelve
                    rows, it does not survive to the result set. */
                 Order By RECEIVED_LAC Desc
                ```
            pageItemsToSubmit: [
                P924_FROMDATE
                P924_TODATE
                P924_COMPANY
                P924_LOCATION
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartLayout {
            height: 340
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: No payment left a bank in this period for the selected scope.
        }

        series received (
            name: Paid (₹ Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: RECEIVED_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Paid (₹ Lac)
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region command-header (
        name: Payments and Settlement
        type: classicReport
