    region item-mix (
        name: What We Buy From Them
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ds_chart_ordered As (
                  Select * From (
                    Select nvl(i.ItemName, d.ItemCode) ITEM,
                           Round(Sum(d.Amount) / 100000, 2) VALUE_LAC
                      From PCC_PurchaseBill h
                      Join PurchaseBillDetail d On d.TNo = h.TNo
                      Left Join Item i On i.ItemCode = d.ItemCode
                     Where h.PartyCode = :P935_SUPPLIER
                       And h.PurchaseBillDate
                           Between to_date(:P935_FROMDATE,'DD-MM-RRRR')
                               And to_date(:P935_TODATE,'DD-MM-RRRR')
                       And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                            Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                       And (:P935_PANEL Is Null Or h.Panel = :P935_PANEL)
                       And (:P935_COMPANY  Is Null Or h.CompanyCode  = :P935_COMPANY)
                       And (:P935_LOCATION Is Null Or h.LocationCode = :P935_LOCATION)
                     Group By nvl(i.ItemName, d.ItemCode)
                     Order By Sum(d.Amount) Desc)
                   Where rownum <= 8
                ),
                ds_chart_q As (
                  Select ordered_q.*, rownum ds_ord
                    From ds_chart_ordered ordered_q
                )
                Select
                  '<div class="ds-fast-chart" data-chart-type="donut" aria-label="What We Buy From Them"><script type="application/json" class="ds-fast-chart-data">' ||
                  replace(
                    json_object(
                      'unit' value 'Rs Lac',
                      'series' value json_array('Billed (Rs Lac)' returning clob) format json,
                      'rows' value json_arrayagg(
                        json_object('l' value to_char(q.ITEM),
                                    'values' value json_array(q.VALUE_LAC returning clob) format json,
                                    'u' value null
                                    returning clob)
                        order by q.ds_ord returning clob) format json
                      returning clob),
                    '<', '\\u003c'
                  ) || '</script></div>' As CHART_ROW
                From ds_chart_q q
                ```
            pageItemsToSubmit: [
                P935_COMPANY
                P935_FROMDATE
                P935_LOCATION
                P935_PANEL
                P935_SUPPLIER
                P935_TODATE
            ]
        }
        layout {
            sequence: 32
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                hspl-register-empty-disabled
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No values for the selected record.
        }

        column CHART_ROW (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: " "
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region kpi-strip (
        name: Supplier KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P935_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P935_TODATE,'DD-MM-RRRR')   T
                         From dual),
                Ord As (
                  Select Sum(od.Amount) Ordered, Count(Distinct o.TNo) Orders
                    From PCC_PurchaseOrder o
                    Join PurchaseOrderDetail od On od.TNo = o.TNo
                   Cross Join Win w
                   Where o.PartyCode = :P935_SUPPLIER
                     And o.PurchaseOrderDate Between w.F And w.T
                     And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                          Or o.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                     And (:P935_PANEL Is Null Or o.Panel = :P935_PANEL)
                     And (:P935_COMPANY  Is Null Or o.CompanyCode  = :P935_COMPANY)
                     And (:P935_LOCATION Is Null Or o.LocationCode = :P935_LOCATION)),
                Rec As (
                  Select Count(Distinct g.TNo) Grns
                    From PCC_Grn g Cross Join Win w
                   Where g.PartyCode = :P935_SUPPLIER
                     And g.GrnDate Between w.F And w.T
                     And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                          Or g.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                     And (:P935_PANEL Is Null Or g.Panel = :P935_PANEL)
                     And (:P935_COMPANY  Is Null Or g.CompanyCode  = :P935_COMPANY)
                     And (:P935_LOCATION Is Null Or g.LocationCode = :P935_LOCATION)),
                Bil As (
                  Select Sum(d.Amount) Billed,
                         Count(Distinct h.TNo) Bills,
                         Count(Distinct d.ItemCode) Items
                    From PCC_PurchaseBill h
                    Join PurchaseBillDetail d On d.TNo = h.TNo
                   Cross Join Win w
                   Where h.PartyCode = :P935_SUPPLIER
                     And h.PurchaseBillDate Between w.F And w.T
                     And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                     And (:P935_PANEL Is Null Or h.Panel = :P935_PANEL)
                     And (:P935_COMPANY  Is Null Or h.CompanyCode  = :P935_COMPANY)
                     And (:P935_LOCATION Is Null Or h.LocationCode = :P935_LOCATION)),
                Pss As (
                  Select Sum(p.PBPassAmount) Passed,
                         Sum(p.PaidAmount) PaidAdv,
                         Count(*) Passes
                    From PCC_PBPass p
                    Join PCC_PurchaseBill h On h.TNo = p.PurchaseBillTNo
                   Cross Join Win w
                   Where h.PartyCode = :P935_SUPPLIER
                     And h.PurchaseBillDate Between w.F And w.T
                     And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                     And (:P935_PANEL Is Null Or h.Panel = :P935_PANEL)
                     And (:P935_COMPANY  Is Null Or h.CompanyCode  = :P935_COMPANY)
                     And (:P935_LOCATION Is Null Or h.LocationCode = :P935_LOCATION)),
                NoPass As (
                  Select Count(Distinct h.TNo) Cnt, Sum(d.Amount) Val
                    From PCC_PurchaseBill h
                    Join PurchaseBillDetail d On d.TNo = h.TNo
                   Cross Join Win w
                   Where h.PartyCode = :P935_SUPPLIER
                     And h.PurchaseBillDate Between w.F And w.T
                     And Not Exists (Select 1 From PCC_PBPass p Where p.PurchaseBillTNo = h.TNo)
                     And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                     And (:P935_PANEL Is Null Or h.Panel = :P935_PANEL)
                     And (:P935_COMPANY  Is Null Or h.CompanyCode  = :P935_COMPANY)
                     And (:P935_LOCATION Is Null Or h.LocationCode = :P935_LOCATION))
                Select
                  '<div class="ds-kpi ds-kpi--struct" title="SUM(PurchaseOrderDetail.Amount) '
                  || 'on orders raised on this supplier in the period.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-shopping-cart"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Ordered</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(o.Ordered,0) >= 10000000
                             Then 'Rs ' || to_char(Round(o.Ordered/10000000,2),'FM99G990D00') || ' Cr'
                             When nvl(o.Ordered,0) >= 100000
                             Then 'Rs ' || to_char(Round(o.Ordered/100000,2),'FM99G990D00') || ' L'
                             Else 'Rs ' || to_char(nvl(o.Ordered,0),'FM99G99G990D00') End
                     || '</span>'
                  || '<span class="ds-kpi-sub">' || to_char(nvl(o.Orders,0),'FM999G999')
                     || ' purchase orders</span>'
                  || '</span></div>' As KPI1,
                  '<div class="ds-kpi ds-kpi--input" title="COUNT(DISTINCT Grn.TNo) for this '
                  || 'supplier. Receipts carry QUANTITY ONLY in this ERP — GrnDetail holds no '
                  || 'usable rate or amount — so no value is shown here.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-truck"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Receipts</span>'
                  || '<span class="ds-kpi-n">' || to_char(nvl(r.Grns,0),'FM999G999') || '</span>'
                  || '<span class="ds-kpi-sub">GRNs booked &middot; '
                  || '<span class="ds-muted">receipts carry no value here</span></span>'
                  || '</span></div>' As KPI2,
                  '<div class="ds-kpi ds-kpi--value" title="SUM(PurchaseBillDetail.Amount) — '
                  || 'the value grain. This must equal this supplier''s row on the Command '
                  || 'Centre supplier table for the same period and scope.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-inr"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Billed</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(b.Billed,0) >= 10000000
                             Then 'Rs ' || to_char(Round(b.Billed/10000000,2),'FM99G990D00') || ' Cr'
                             When nvl(b.Billed,0) >= 100000
                             Then 'Rs ' || to_char(Round(b.Billed/100000,2),'FM99G990D00') || ' L'
                             Else 'Rs ' || to_char(nvl(b.Billed,0),'FM99G99G990D00') End
                     || '</span>'
                  || '<span class="ds-kpi-sub">' || to_char(nvl(b.Bills,0),'FM999G999')
                     || ' bills &middot; ' || to_char(nvl(b.Items,0),'FM999G999')
                     || ' distinct items</span>'
                  || '</span></div>' As KPI3,
                  '<div class="ds-kpi ds-kpi--ok" title="SUM(PBPass.PBPassAmount). PBPass is '
                  || 'one-to-one with the bill, so the join cannot multiply the grain.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-check-square-o"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Passed</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(p.Passed,0) >= 10000000
                             Then 'Rs ' || to_char(Round(p.Passed/10000000,2),'FM99G990D00') || ' Cr'
                             When nvl(p.Passed,0) >= 100000
                             Then 'Rs ' || to_char(Round(p.Passed/100000,2),'FM99G990D00') || ' L'
                             Else 'Rs ' || to_char(nvl(p.Passed,0),'FM99G99G990D00') End
                     || '</span>'
                  || '<span class="ds-kpi-sub">' || to_char(nvl(p.Passes,0),'FM999G999')
                     || ' bills approved for payment</span>'
                  || '</span></div>' As KPI4,
                  -- BASIS DISCLOSED ON THE CARD. This is PBPass.PaidAmount, not the ledger.
                  '<div class="ds-kpi ds-kpi--suppl" title="SUM(PBPass.PaidAmount) — the '
                  || 'Payment Advice basis. This column is only written when settlement runs '
                  || 'through Payment Advice, so it can understate badly for a supplier that '
                  || 'settles by direct voucher. Pages 668 and 683 read the ledger instead. '
                  || 'Use the Supplier Ledger button for the ledger-side position.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-credit-card"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Paid (via advice)</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(p.PaidAdv,0) >= 10000000
                             Then 'Rs ' || to_char(Round(p.PaidAdv/10000000,2),'FM99G990D00') || ' Cr'
                             When nvl(p.PaidAdv,0) >= 100000
                             Then 'Rs ' || to_char(Round(p.PaidAdv/100000,2),'FM99G990D00') || ' L'
                             Else 'Rs ' || to_char(nvl(p.PaidAdv,0),'FM99G99G990D00') End
                     || '</span>'
                  || '<span class="ds-kpi-sub">'
                     || Case When nvl(p.Passed,0) > 0
                             Then to_char(Round(100 * nvl(p.PaidAdv,0) / p.Passed,1),'FM99999990D0')
                                  || '% of passed'
                             Else 'nothing passed in period' End
                     || ' &middot; <span class="ds-muted">advice route only</span></span>'
                  || '</span></div>' As KPI5,
                  '<div class="ds-kpi ds-kpi--risk" title="Bills from this supplier in the '
                  || 'period with no PBPass row — booked as a liability but not yet approved, '
                  || 'and therefore not yet in the ledger.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-hourglass-half"></span></span>'
                  || '<span class="ds-kpi-body">'
                  || '<span class="ds-kpi-t">Awaiting Pass</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(np.Val,0) >= 10000000
                             Then 'Rs ' || to_char(Round(np.Val/10000000,2),'FM99G990D00') || ' Cr'
                             When nvl(np.Val,0) >= 100000
                             Then 'Rs ' || to_char(Round(np.Val/100000,2),'FM99G990D00') || ' L'
                             Else 'Rs ' || to_char(nvl(np.Val,0),'FM99G99G990D00') End
                     || '</span>'
                  || '<span class="ds-kpi-sub">' || to_char(nvl(np.Cnt,0),'FM999G999')
                     || ' bills booked, not yet passed</span>'
                  || '</span></div>' As KPI6
                From Ord o
                Cross Join Rec r
                Cross Join Bil b
                Cross Join Pss p
                Cross Join NoPass np
                ```
            pageItemsToSubmit: [
                P935_COMPANY
                P935_FROMDATE
                P935_LOCATION
                P935_PANEL
                P935_SUPPLIER
                P935_TODATE
            ]
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                hspl-register-empty-disabled
                ds360-kpi
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No values for the selected record.
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Ordered. SUM(PurchaseOrderDetail.Amount) — committed value, distinct from what was subsequently billed.
            }
        )

        column KPI2 (
            reportColumnQueryId: 2
            derivedColumn: N
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Receipts. Count only — GrnDetail carries no usable value in this ERP, and the card says so rather than showing a zero.
            }
        )

        column KPI3 (
            reportColumnQueryId: 3
            derivedColumn: N
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Billed. The value grain, and the reconciliation anchor against the 668 supplier table.
            }
        )

        column KPI4 (
            reportColumnQueryId: 4
            derivedColumn: N
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Passed. SUM(PBPass.PBPassAmount), one pass per bill.
            }
        )

        column KPI5 (
            reportColumnQueryId: 5
            derivedColumn: N
            layout {
                sequence: 50
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Paid on the Payment Advice basis, NOT the ledger. The basis is stated on the card, in its tooltip and in the page help — see TD-1 in the blueprint.
            }
        )

        column KPI6 (
            reportColumnQueryId: 6
            derivedColumn: N
            layout {
                sequence: 60
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Awaiting Pass. Bills with no PBPass row — liability booked but not yet approved.
            }
        )

    )

    region orders (
        name: Purchase Orders
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  o.PurchaseOrderNo As PO_NO,
                  o.PurchaseOrderDate As PO_DATE,
                  GetLocationName(o.LocationCode) As LOCATION,
                  o.DeliveryDate As DELIVERY_DUE,
                  Count(*) As LINES,
                  Sum(od.Amount) As ORDER_VALUE,
                  -- Received % is shown ONLY where every line shares one unit. Summing
                  -- quantities across incompatible units to make a ratio is meaningless.
                  Case When Count(Distinct od.RateMeasuringUnitCode) <= 1
                            And Sum(od.Quantity1) > 0
                       Then Round(100 * Sum(Least(nvl(od.ReceivedQuantity1,0), od.Quantity1))
                                      / Sum(od.Quantity1), 1)
                  End As RECEIVED_PCT,
                  Case
                    When Sum(Least(nvl(od.ReceivedQuantity1,0), od.Quantity1))
                         >= Sum(od.Quantity1) And Sum(od.Quantity1) > 0 Then 'Fully received'
                    When Sum(nvl(od.ReceivedQuantity1,0)) > 0 Then 'Part received'
                    Else 'Awaiting material'
                  End As STATUS,
                  o.PartyCode As PARTYCODE,
                  -- Drill key to Purchase Order 360. The link travels on TNo rather than the
                  -- order number, so it works whatever the numbering scheme looks like.
                  o.TNo As PO_TNO
                From PCC_PurchaseOrder o
                Join PurchaseOrderDetail od On od.TNo = o.TNo
                Where o.PartyCode = :P935_SUPPLIER
                  And o.PurchaseOrderDate
                      Between to_date(:P935_FROMDATE,'DD-MM-RRRR')
                          And to_date(:P935_TODATE,'DD-MM-RRRR')
                  And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                       Or o.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                  And (:P935_PANEL Is Null Or o.Panel = :P935_PANEL)
                  And (:P935_COMPANY  Is Null Or o.CompanyCode  = :P935_COMPANY)
                  And (:P935_LOCATION Is Null Or o.LocationCode = :P935_LOCATION)
                Group By o.PurchaseOrderNo, o.PurchaseOrderDate, o.LocationCode,
                         o.DeliveryDate, o.PartyCode, o.TNo
                Order By o.PurchaseOrderDate Desc, o.PurchaseOrderNo
                ```
            pageItemsToSubmit: [
                P935_COMPANY
                P935_FROMDATE
                P935_LOCATION
                P935_PANEL
                P935_SUPPLIER
                P935_TODATE
            ]
        }
        layout {
            sequence: 45
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No purchase order was raised on this supplier in the selected period and scope.
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 100
        }
        advanced {
            savedReportMappingIdentifier: 21527384775436196
        }

        column DELIVERY_DUE (
            type: plainText
            heading {
                heading: Delivery Due
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-RRRR
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
            comments {
                comments: Promised date. Blank where none was recorded — such orders are excluded from on-time measurement rather than counted as late.
            }
        )

        column LINES (
            type: plainText
            heading {
                heading: Lines
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
            comments {
                comments: Order line count.
            }
        )

        column LOCATION (
            type: plainText
            heading {
                heading: Location
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Location that raised the order.
            }
        )

        column ORDER_VALUE (
            type: plainText
            heading {
                heading: Order Value
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G99G99G99G99G99G99G99G99G99G99G99G99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
            comments {
                comments: SUM(PurchaseOrderDetail.Amount) — committed value, excludes footer tax carried on the header.
            }
        )

        column PARTYCODE (
            type: hidden
            heading {
                heading: Party Code
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
            comments {
                comments: Technical key carried for the register drill. Never displayed.
            }
        )

        column PO_DATE (
            type: plainText
            heading {
                heading: Order Date
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-RRRR
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Date the order was raised — the date the period filter works on.
            }
        )

        column PO_NO (
            type: link
            heading {
                heading: Order No
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 939
                    items: {
                        P939_TNO: #PO_TNO#
                    }
                    clearCache: 939
                    debug: NO
                }
                linkText: #PO_NO#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            comments {
                comments: The order's own business number, drilling to Purchase Order 360 (682). The link travels on TNo, so it works whatever the numbering scheme looks like — most doc types here use a randomised number rather than a running serial.
            }
        )

        column PO_TNO (
            type: hidden
            heading {
                heading: PO Key
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            comments {
                comments: Technical drill key to Purchase Order 360. Never displayed — the order is identified on screen by its own business number.
            }
        )

        column RECEIVED_PCT (
            type: plainText
            heading {
                heading: Received %
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM990D0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
            comments {
                comments: Shown ONLY where every line of the order shares one unit of measure. Blank on a mixed-unit order, because summing across units to make a ratio is meaningless.
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
            comments {
                comments: Plain-language position derived from the order line, guarded with LEAST so an over-receipt cannot read as more than fully received.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 20
            }

            displayColumn DELIVERY_DUE (
                sequence: 6
            )

            displayColumn LINES (
                sequence: 7
            )

            displayColumn LOCATION (
                sequence: 5
            )

            displayColumn ORDER_VALUE (
                sequence: 8
            )

            displayColumn PARTYCODE (
                sequence: 1
            )

            displayColumn PO_DATE (
                sequence: 4
            )

            displayColumn PO_NO (
                sequence: 3
            )

            displayColumn PO_TNO (
                sequence: 2
            )

            displayColumn RECEIVED_PCT (
                sequence: 9
            )

            displayColumn STATUS (
                sequence: 10
            )

        )

    )

    region rule-bills (
        name: Bills
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Purchase Bills</h2>
                  <p>Every bill from this supplier with its pass and settlement position.
                     Summing Line Value here reproduces the Billed card at the top of the
                     page. The supplier's <em>own</em> bill number is shown &mdash; internal
                     document keys are never displayed.</p>
                </div>
                ```
        }
        layout {
            sequence: 50
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-flow (
        name: Flow Over Time
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Flow and Material Mix</h2>
                  <p>Monthly billed value from this supplier, and what is actually being
                     bought from them. Both read the bill line, so they tie to the Billed
                     card above.</p>
                </div>
                ```
        }
        layout {
            sequence: 25
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-orders (
        name: Orders
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Purchase Orders</h2>
                  <p>Every order raised on this supplier in the period, with its receipt
                     progress. Progress is read from the order line itself
                     (<code>ReceivedQuantity1</code> against <code>Quantity1</code>), never
                     inferred from a join &mdash; one order can feed several receipts, and a
                     join would double-count.</p>
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-position (
        name: Supplier Position
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Position With This Supplier</h2>
                  <p>The chain from order to settlement. Billed here must equal this
                     supplier's row on the Command Centre supplier table for the same period
                     and scope. Paid is the <em>Payment&nbsp;Advice</em> basis on this page
                     &mdash; the group cards on 668 read the ledger, so the two can differ
                     for a supplier that settles by direct voucher.</p>
                </div>
                ```
        }
        layout {
            sequence: 15
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region trend-chart (
        name: Monthly Billed Value
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ds_chart_ordered As (
                  Select to_char(Trunc(h.PurchaseBillDate,'MM'),'Mon-RR') MONTH_LABEL,
                         Round(Sum(d.Amount) / 100000, 2) VALUE_LAC,
                         Trunc(h.PurchaseBillDate,'MM') SORT_KEY
                    From PCC_PurchaseBill h
                    Join PurchaseBillDetail d On d.TNo = h.TNo
                   Where h.PartyCode = :P935_SUPPLIER
                     And h.PurchaseBillDate
                         Between to_date(:P935_FROMDATE,'DD-MM-RRRR')
                             And to_date(:P935_TODATE,'DD-MM-RRRR')
                     And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                     And (:P935_PANEL Is Null Or h.Panel = :P935_PANEL)
                     And (:P935_COMPANY  Is Null Or h.CompanyCode  = :P935_COMPANY)
                     And (:P935_LOCATION Is Null Or h.LocationCode = :P935_LOCATION)
                   Group By Trunc(h.PurchaseBillDate,'MM')
                   Order By SORT_KEY
                ),
                ds_chart_q As (
                  Select ordered_q.*, rownum ds_ord
                    From ds_chart_ordered ordered_q
                )
                Select
                  '<div class="ds-fast-chart" data-chart-type="hbar" aria-label="Monthly Billed Value"><script type="application/json" class="ds-fast-chart-data">' ||
                  replace(
                    json_object(
                      'unit' value 'Rs Lac',
                      'series' value json_array('Billed (Rs Lac)' returning clob) format json,
                      'rows' value json_arrayagg(
                        json_object('l' value to_char(q.MONTH_LABEL),
                                    'values' value json_array(q.VALUE_LAC returning clob) format json,
                                    'u' value null
                                    returning clob)
                        order by q.ds_ord returning clob) format json
                      returning clob),
                    '<', '\\u003c'
                  ) || '</script></div>' As CHART_ROW
                From ds_chart_q q
                ```
            pageItemsToSubmit: [
                P935_COMPANY
                P935_FROMDATE
                P935_LOCATION
                P935_PANEL
                P935_SUPPLIER
                P935_TODATE
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                hspl-register-empty-disabled
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No values for the selected record.
        }

        column CHART_ROW (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: " "
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    pageItem P935_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From PCC_PurchaseBill h
                                Where h.CompanyCode = c.CompanyCode
                                  And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                                       Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Narrows every region to one company.
        }
    )

    pageItem P935_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD-MM-RRRR
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Start of the reporting period. Arrives from whichever page drilled here.
        }
    )

    pageItem P935_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From PCC_PurchaseBill fb
                                Where fb.LocationCode = l.LocationCode
                                  And (:P935_COMPANY Is Null
                                       Or fb.CompanyCode = :P935_COMPANY)
                                  And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                                       Or fb.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P935_COMPANY
            itemsToSubmit: P935_COMPANY
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Cascades from Company.
        }
    )

    pageItem P935_PANEL (
        type: hidden
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
        }
        serverSideCondition {
            type: expression
            plsqlExpression: SAGAR.GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Hidden when your login is already bound to a panel. The select list is the control; the SQL predicate on every region is the enforcement.
        }
    )

    pageItem P935_SUPPLIER (
        type: popupLov
        label {
            label: Supplier
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct GetPartyName(h.PartyCode) d, h.PartyCode r
                  From PCC_PurchaseBill h
                 Where ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                   And (:P935_COMPANY Is Null Or h.CompanyCode = :P935_COMPANY)
                 Order By 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: The subject of this page. Left switchable so you can move supplier-to-supplier without returning to the Command Centre. Populated from bills, so every entry returns rows.
        }
    )

    pageItem P935_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD-MM-RRRR
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: End of the reporting period.
        }
    )

