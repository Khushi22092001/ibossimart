                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P179_LocationCode,
                					:P179_DocTypeCode,
                					NULL,
                					TO_DATE(:P179_JOBORDERDATE, 'DD-MM-RRRR')
                				);
                        :P179_JOBORDERNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P179_LocationCode,
                                    :P179_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P179_JOBORDERDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
