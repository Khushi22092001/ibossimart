    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                declare l_rows number;begin
                 if :APEX$ROW_STATUS='C' then :TNO:=:P179_TNO;
                 elsif :APEX$ROW_STATUS in('U','D') then
                 if nvl(:TNO,:P179_TNO)<>:P179_TNO then raise_application_error(-20074,'Detail row belongs to a different document');end if;
                 select count(*) into l_rows from JOBORDERDETAIL where tno=:P179_TNO and sno=:SNO;
                 if l_rows<>1 then raise_application_error(-20074,'Detail row is missing or duplicated; the save was blocked');end if;
                 end if;
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then :TNO:=:P179_TNO;if :SNO is null then :SNO:=globaltno.nextval;end if;declare own_count number;begin select count(*) into own_count from JOBORDERDETAIL where sno=:SNO;if own_count<>0 then raise_application_error(-20074,'New Job Order detail identity already exists');end if;end;
                            Insert Into joborderdetail (                 
                                                            TNO,
                                        SNO,
                                        ITEMCODE,
                                        ITEMSPECIFICATIONCODE,
                                        DESCRIPTION,
                                        QUANTITY1,
                                        QUANTITY2,
                                        TOLERANCE,
                                        RECEIVEDQUANTITY1,
                                        RECEIVEDQUANTITY2,
                                        RATEMEASURINGUNITCODE,
                                        RATE,
                                        AMOUNT,
                                        FOOTERAMOUNT,
                                        TOTALAMOUNT,
                                        REMARK,
                                        DOCUMENTSTATUSCODE,
                                        JOBTYPECODE,
                                        INDENTTNO,
                                        ACCEPTEDQUANTITY1,
                                        ACCEPTEDQUANTITY2,
                                        JOININSPECTEDQUANTITY1,
                                        JOININSPECTEDQUANTITY2,
                                        JOINACCEPTEDQUANTITY1,
                                        JOINACCEPTEDQUANTITY2,
                                        CHALANQUANTITY1,
                                        CHALANQUANTITY2,
                                        INSPECTEDQUANTITY1,
                                        INSPECTEDQUANTITY2,
                                        MATERIALINQUANTITY1,
                                        MATERIALINQUANTITY2,
                                        BOMCODE,
                                        EQUIPMENTTNO,
                                        TAXRULECODE,
                                        MINIMUMHOUR,
                                        IFGREATERISBILLABLE,
                                        WITHOPERATOR,
                                        WITHDIESEL,
                                        MILEAGEWITHAC,
                                        MILEAGEWITHOUTAC,
                                        MINUMUMHOURWORKING,
                                        MOBLIZATIONDEMOBLIZATIONAPBYC,
                                        FOODINGACCOMODATIONPBYC,
                                        BREAKDOWNMAINTENANCEBYC,
                                        BREAKDOWNALLOWEDDAYS,
                                        CALCULATEMODULECODE,
                                        MINIMUMWORKINGDAYS,
                                        NOTICEPERIOD,
                                        ISRATESLABWISE,
                                        SLABTYPECODE,
                                        BOQSERIALNO,
                                        WBSCODE,
                                        TASKSNO,
                                        WITHOUTDISCOUNTRATE,
                                        DISCOUNTPERCENTAGE,
                                        DISCOUNTRATE
                
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :DESCRIPTION,
                                :QUANTITY1,
                                :QUANTITY2,
                                :TOLERANCE,
                                :RECEIVEDQUANTITY1,
                                :RECEIVEDQUANTITY2,
                                :RATEMEASURINGUNITCODE,
                                :RATE,
                                :AMOUNT,
                                :FOOTERAMOUNT,
                                :TOTALAMOUNT,
                                :REMARK,
                                :DOCUMENTSTATUSCODE,
                                :JOBTYPECODE,
                                :INDENTTNO,
                                :ACCEPTEDQUANTITY1,
                                :ACCEPTEDQUANTITY2,
                                :JOININSPECTEDQUANTITY1,
                                :JOININSPECTEDQUANTITY2,
                                :JOINACCEPTEDQUANTITY1,
                                :JOINACCEPTEDQUANTITY2,
                                :CHALANQUANTITY1,
                                :CHALANQUANTITY2,
                                :INSPECTEDQUANTITY1,
                                :INSPECTEDQUANTITY2,
                                :MATERIALINQUANTITY1,
                                :MATERIALINQUANTITY2,
                                :BOMCODE,
                                :EQUIPMENTTNO,
                                :TAXRULECODE,
                                :MINIMUMHOUR,
                                :IFGREATERISBILLABLE,
                                :WITHOPERATOR,
                                :WITHDIESEL,
                                :MILEAGEWITHAC,
                                :MILEAGEWITHOUTAC,
                                :MINUMUMHOURWORKING,
                                :MOBLIZATIONDEMOBLIZATIONAPBYC,
                                :FOODINGACCOMODATIONPBYC,
                                :BREAKDOWNMAINTENANCEBYC,
                                :BREAKDOWNALLOWEDDAYS,
                                :CALCULATEMODULECODE,
                                :MINIMUMWORKINGDAYS,
                                :NOTICEPERIOD,
                                :ISRATESLABWISE,
                                :SLABTYPECODE,
                                :BOQSERIALNO,
                                :WBSCODE,
                                :TASKSNO,
                                :WITHOUTDISCOUNTRATE,
                                :DISCOUNTPERCENTAGE,
                                :DISCOUNTRATE
                
                            ) returning rowid into :ROWID;
                 when 'U' then
                            update joborderdetail Set
                                  TNO=:TNO,
                                    SNO=:SNO,
                                    ITEMCODE=:ITEMCODE,
                                    ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                    DESCRIPTION=:DESCRIPTION,
                                    QUANTITY1=:QUANTITY1,
                                    QUANTITY2=:QUANTITY2,
                                    TOLERANCE=:TOLERANCE,
                                    RECEIVEDQUANTITY1=:RECEIVEDQUANTITY1,
                                    RECEIVEDQUANTITY2=:RECEIVEDQUANTITY2,
                                    RATEMEASURINGUNITCODE=:RATEMEASURINGUNITCODE,
                                    RATE=:RATE,
                                    AMOUNT=:AMOUNT,
                                    FOOTERAMOUNT=:FOOTERAMOUNT,
                                    TOTALAMOUNT=:TOTALAMOUNT,
                                    REMARK=:REMARK,
                                    DOCUMENTSTATUSCODE=:DOCUMENTSTATUSCODE,
                                    JOBTYPECODE=:JOBTYPECODE,
                                    INDENTTNO=:INDENTTNO,
                                    ACCEPTEDQUANTITY1=:ACCEPTEDQUANTITY1,
                                    ACCEPTEDQUANTITY2=:ACCEPTEDQUANTITY2,
                                    JOININSPECTEDQUANTITY1=:JOININSPECTEDQUANTITY1,
                                    JOININSPECTEDQUANTITY2=:JOININSPECTEDQUANTITY2,
                                    JOINACCEPTEDQUANTITY1=:JOINACCEPTEDQUANTITY1,
                                    JOINACCEPTEDQUANTITY2=:JOINACCEPTEDQUANTITY2,
                                    CHALANQUANTITY1=:CHALANQUANTITY1,
                                    CHALANQUANTITY2=:CHALANQUANTITY2,
                                    INSPECTEDQUANTITY1=:INSPECTEDQUANTITY1,
                                    INSPECTEDQUANTITY2=:INSPECTEDQUANTITY2,
                                    MATERIALINQUANTITY1=:MATERIALINQUANTITY1,
                                    MATERIALINQUANTITY2=:MATERIALINQUANTITY2,
                                    BOMCODE=:BOMCODE,
                                    EQUIPMENTTNO=:EQUIPMENTTNO,
                                    TAXRULECODE=:TAXRULECODE,
                                    MINIMUMHOUR=:MINIMUMHOUR,
                                    IFGREATERISBILLABLE=:IFGREATERISBILLABLE,
                                    WITHOPERATOR=:WITHOPERATOR,
                                    WITHDIESEL=:WITHDIESEL,
                                    MILEAGEWITHAC=:MILEAGEWITHAC,
                                    MILEAGEWITHOUTAC=:MILEAGEWITHOUTAC,
                                    MINUMUMHOURWORKING=:MINUMUMHOURWORKING,
                                    MOBLIZATIONDEMOBLIZATIONAPBYC=:MOBLIZATIONDEMOBLIZATIONAPBYC,
                                    FOODINGACCOMODATIONPBYC=:FOODINGACCOMODATIONPBYC,
                                    BREAKDOWNMAINTENANCEBYC=:BREAKDOWNMAINTENANCEBYC,
                                    BREAKDOWNALLOWEDDAYS=:BREAKDOWNALLOWEDDAYS,
                                    CALCULATEMODULECODE=:CALCULATEMODULECODE,
                                    MINIMUMWORKINGDAYS=:MINIMUMWORKINGDAYS,
                                    NOTICEPERIOD=:NOTICEPERIOD,
                                    ISRATESLABWISE=:ISRATESLABWISE,
                                    SLABTYPECODE=:SLABTYPECODE,
                                    BOQSERIALNO=:BOQSERIALNO,
                                    WBSCODE=:WBSCODE,
                                    TASKSNO=:TASKSNO,
                                    WITHOUTDISCOUNTRATE=:WITHOUTDISCOUNTRATE,
                                    DISCOUNTPERCENTAGE=:DISCOUNTPERCENTAGE,
                                    DISCOUNTRATE=:DISCOUNTRATE
                
                            WHERE TNO = :P179_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From joborderdetail
                            Where TNo = :P179_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                end;
                ```
        }
