    process savejoborderfooter (
        name: SaveJobOrderFooter
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    delete from Joborderfooter where tno = :P179_TNO;
                    insert into Joborderfooter
                        (tno ,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   select 
                                :P179_TNO , 
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from Joborderdetailfooter
                            where tno = :P179_TNO
                            group by FOOTERHEADCODE
                        );
                end;
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 171819294750701188
        }
    )

