    process save-all-edited-job-order-row-footers (
        name: Save all edited Job Order row footers
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 edits json_object_t;keys json_key_list;lines json_array_t;line json_object_t;own_sno number;own_rid varchar2(30);hits number;
                 r JOBORDERDETAILFOOTER%rowtype;empty_row JOBORDERDETAILFOOTER%rowtype;
                 type rows_t is table of JOBORDERDETAILFOOTER%rowtype;pending_rows rows_t:=rows_t();
                 type seen_t is table of boolean index by varchar2(100);seen seen_t;
                begin
                 if :P179_FD_EDITS is null then return;end if;
                 edits:=json_object_t.parse(:P179_FD_EDITS);keys:=edits.get_keys;
                 for i in 1..keys.count loop
                  own_sno:=to_number(keys(i));select count(*) into hits from JOBORDERDETAIL where tno=:P179_TNO and sno=own_sno;
                  if hits<>1 then raise_application_error(-20073,'Footer does not belong to exactly one saved Job Order detail.');end if;
                  lines:=edits.get_array(keys(i));pending_rows:=rows_t();seen.delete;
                  for k in 0..lines.get_size()-1 loop
                   line:=treat(lines.get(k) as json_object_t);r:=empty_row;
                   if nvl(line.get_number('TNO'),-1)<>:P179_TNO or nvl(line.get_number('SNO'),-1)<>own_sno then raise_application_error(-20073,'Job Order footer owner changed.');end if;
                   if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20073,'Select a footer head and legend.');end if;
                   own_rid:=line.get_string('ROWID');
                   if own_rid is not null then
                    if seen.exists(own_rid) then raise_application_error(-20073,'Duplicate Job Order footer identity.');end if;seen(own_rid):=true;
                    if not regexp_like(own_rid,'^t[0-9]+$') then
                     begin select * into r from JOBORDERDETAILFOOTER where rowid=chartorowid(own_rid) and tno=:P179_TNO and sno=own_sno;exception when no_data_found then raise_application_error(-20073,'Job Order footer ROWID is stale or belongs to another detail.');end;
                    end if;
                   end if;
                   r.tno:=:P179_TNO;r.sno:=own_sno;r.serialno:=k+1;
                   r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');
                   pending_rows.extend;pending_rows(pending_rows.count):=r;
                  end loop;
                  delete from JOBORDERDETAILFOOTER where tno=:P179_TNO and sno=own_sno;
                  for k in 1..pending_rows.count loop r:=pending_rows(k);insert into JOBORDERDETAILFOOTER values r;end loop;
                 end loop;
                end;
                
                ```
        }
        execution {
            sequence: 85
        }
