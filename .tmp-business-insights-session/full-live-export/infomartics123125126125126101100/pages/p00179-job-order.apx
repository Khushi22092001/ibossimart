    process validations (
        name: Validations
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                declare tmp number;own_indent number;begin
                select indenttno into own_indent from JOBORDER where tno=:P179_TNO;
                if own_indent is not null then
                select count(*) into tmp from indent i join JOBORDER h on h.indenttno=i.tno where h.tno=:P179_TNO and i.companycode=h.companycode and i.financialyearcode=h.financialyearcode;
                if tmp<>1 then raise_application_error(-20074,'Selected Indent company or year does not match Job Order');end if;
                for vloop in(select a.itemcode from indentdetail a join item b on b.itemcode=a.itemcode where a.tno=own_indent)loop
                select count(*) into tmp from JOBORDERDETAIL where tno=:P179_TNO and itemcode=vloop.itemcode;
                if tmp=0 then raise_application_error(-20000,'Item details not matching with Selected Indent No');end if;
                end loop;end if;end;
                ```
        }
        execution {
            sequence: 95
        }
        advanced {
            executionMappingIdentifier: 171818971241699056
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE, CREATE
        }
    )

    process verify-job-order-saved-quantity-and-discount-basis (
        name: Verify Job Order saved quantity and discount basis
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare unit1 varchar2(100);unit2 varchar2(100);factor number;expected_discount number;expected_rate number;hits number;
                begin
                 for d in(select * from JOBORDERDETAIL where tno=:P179_TNO)loop
                  expected_discount:=case when d.discountpercentage is not null then nvl(d.withoutdiscountrate,0)*d.discountpercentage/100 else nvl(d.discountrate,0) end;
                  expected_rate:=nvl(d.withoutdiscountrate,0)-expected_discount;
                  if abs(nvl(d.discountrate,0)-expected_discount)>.0051 or abs(nvl(d.rate,0)-expected_rate)>.0051 then raise_application_error(-20074,'Job Order discount or rate calculation does not match saved detail [row='||d.sno||']');end if;
                  if d.itemcode is not null then
                   select measuringunitcode1,measuringunitcode2 into unit1,unit2 from item where itemcode=d.itemcode;
                   select multiplyingfactor into factor from itemspecification where itemspecificationcode=d.itemspecificationcode and tno in(select tno from item where itemcode=d.itemcode);
                   if d.ratemeasuringunitcode is null or(d.ratemeasuringunitcode<>unit1 and(unit2 is null or d.ratemeasuringunitcode<>unit2)) then raise_application_error(-20074,'Job Order rate UOM does not belong to saved item');end if;
                   if abs(nvl(d.quantity1,0)-round(nvl(d.quantity1,0),getuomdecimal(unit1)))>.000001 or abs(nvl(d.quantity2,0)-nvl(round(nvl(d.quantity1,0)*factor,3),0))>.001 then raise_application_error(-20074,'Job Order quantity conversion does not match saved item specification [row='||d.sno||']');end if;
                  elsif d.jobtypecode is null then raise_application_error(-20074,'Saved Job Order detail requires an item or Job Type');
                  end if;
                  if d.jobtypecode is not null then select count(*) into hits from jobtype where jobtypecode=d.jobtypecode;if hits<>1 then raise_application_error(-20074,'Saved Job Order Job Type is invalid');end if;end if;
                 end loop;
                end;
                
                ```
        }
        execution {
            sequence: 9840
        }
        advanced {
            executionMappingIdentifier: 99017920260929056
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

