    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       TOLERANCE,
                       RECEIVEDQUANTITY1,
                       RECEIVEDQUANTITY2,
                       RATEMEASURINGUNITCODE,
                       RATE,
                       AMOUNT,
                       FOOTERAMOUNT,
                       TOTALAMOUNT,
                       REMARK,
                       DOCUMENTSTATUSCODE,
                       JOBTYPECODE,
                       INDENTTNO,
                       ACCEPTEDQUANTITY1,
                       ACCEPTEDQUANTITY2,
                       JOININSPECTEDQUANTITY1,
                       JOININSPECTEDQUANTITY2,
                       JOINACCEPTEDQUANTITY1,
                       JOINACCEPTEDQUANTITY2,
                       CHALANQUANTITY1,
                       CHALANQUANTITY2,
                       INSPECTEDQUANTITY1,
                       INSPECTEDQUANTITY2,
                       MATERIALINQUANTITY1,
                       MATERIALINQUANTITY2,
                       BOMCODE,
                       EQUIPMENTTNO,
                       TAXRULECODE,
                       MINIMUMHOUR,
                       IFGREATERISBILLABLE,
                       WITHOPERATOR,
                       WITHDIESEL,
                       MILEAGEWITHAC,
                       MILEAGEWITHOUTAC,
                       MINUMUMHOURWORKING,
                       MOBLIZATIONDEMOBLIZATIONAPBYC,
                       FOODINGACCOMODATIONPBYC,
                       BREAKDOWNMAINTENANCEBYC,
                       BREAKDOWNALLOWEDDAYS,
                       CALCULATEMODULECODE,
                       MINIMUMWORKINGDAYS,
                       NOTICEPERIOD,
                       ISRATESLABWISE,
                       SLABTYPECODE,
                       BOQSERIALNO,
                       WBSCODE,
                       TASKSNO,
                       WITHOUTDISCOUNTRATE,
                       DISCOUNTPERCENTAGE,
                       DISCOUNTRATE,
                       GetMeasuringUnitNameFromItem(ITEMCODE) as Unit1,
                       GetMeasuringUnit2NameFromItem(ITEMCODE) as Unit2,
                       'FD' as FD
                  from JOBORDERDETAIL
                  where tno = :P179_TNO
                ```
            pageItemsToSubmit: P179_TNO
        }
        layout {
