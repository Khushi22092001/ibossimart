    dynamicAction calculate-footer-total (
        name: Calculate Footer Total
        execution {
            sequence: 270
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("FooterDetail").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("FOOTERVALUE");
                    model.forEach(function(igrow) {
                        n_amt = parseFloat(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P179_FVALUE").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calculate-sum-of-amount-value-on-loose-focus (
        name: Calculate Sum of Amount Value on Loose focus
        execution {
            sequence: 320
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail
            columns: [
                AMOUNT
                FD
                FOOTERAMOUNT
                TOTALAMOUNT
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("AMOUNT");
                    var footerKey = model.getFieldKey("FOOTERAMOUNT");
                    var grandtotalKey = model.getFieldKey("TOTALAMOUNT");
                    var totalAmt = 0;
                    var footerAmt = 0;
                    var grandtotalAmt = 0;
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                      var footer = parseFloat(r[footerKey], 10);
                      var grandtotal = parseFloat(r[grandtotalKey], 10);
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                      if (!isNaN(footer)) {
                        footerAmt += footer;
                      }
                    
                      if (!isNaN(grandtotal)) {
                        grandtotalAmt += grandtotal;
                      }
                    });
                    
                    $s("P179_SUMOFAMOUNT", totalAmt);
                    $s("P179_SUMOFFOOTERAMOUNT", footerAmt);
                    $s("P179_JOBORDERAMOUNT", grandtotalAmt);
                    	
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :totalamount
                itemsToSubmit: TOTALAMOUNT
            }
            affectedElements {
                selectionType: items
                items: P179_JOBORDERAMOUNT
            }
            execution {
                sequence: 10
            }
        )

    )

