    process p179-calculate-detail (
        name: P179_CALCULATE_DETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);
                 v_tno number:=j.get_number('tno');v_sno number:=j.get_number('sno');hits number;
                 item_code varchar2(100):=j.get_string('item');spec_code varchar2(100):=j.get_string('spec');job_code varchar2(100):=j.get_string('JOBTYPECODE');tax_code varchar2(100);is_job number:=0;
                 q1 number:=nvl(j.get_number('q1'),0);q2 number:=nvl(j.get_number('q2'),0);base_rate number:=nvl(j.get_number('base'),0);pct number:=j.get_number('discountPercent');discount number:=nvl(j.get_number('discountValue'),0);rate number;rate_unit varchar2(100):=j.get_string('unit');unit1 varchar2(100);unit2 varchar2(100);factor number;amount number;footer number:=0;
                 old_amount number:=j.get_number('previousAmount');old_qty number:=j.get_number('previousQuantity');
                 type rows_t is table of JOBORDERDETAILFOOTER%rowtype;old_rows rows_t:=rows_t();result_rows rows_t:=rows_t();
                 type rids_t is table of varchar2(30) index by binary_integer;old_rids rids_t;result_rids rids_t;
                 type seen_t is table of boolean index by varchar2(100);seen seen_t;
                 r JOBORDERDETAILFOOTER%rowtype;empty_row JOBORDERDETAILFOOTER%rowtype;
                 function footer_value(legend varchar2,a number,p number,v number,q number) return number is
                 begin case upper(trim(legend)) when 'PAA' then return round(abs(nvl(a,0)*nvl(p,0)/100),2);when 'PAD' then return -round(abs(nvl(a,0)*nvl(p,0)/100),2);when 'PRA' then return round(abs(nvl(a,0)*nvl(p,0)/100),0);when 'PRD' then return -round(abs(nvl(a,0)*nvl(p,0)/100),0);when 'OQA' then return abs(nvl(q,0)*nvl(p,0));when 'OQD' then return -abs(nvl(q,0)*nvl(p,0));when 'LSA' then return abs(nvl(v,0));when 'LSD' then return -abs(nvl(v,0));else return nvl(v,0);end case;end;
                 procedure append_row(a JOBORDERDETAILFOOTER%rowtype,rid varchar2) is begin result_rows.extend;result_rows(result_rows.count):=a;result_rows(result_rows.count).serialno:=result_rows.count;result_rids(result_rows.count):=rid;end;
                begin
                 if v_tno is null or v_tno<>:P179_TNO then raise_application_error(-20074,'Job Order document identity changed');end if;
                 if v_sno is null then v_sno:=globaltno.nextval;end if;
                 select count(*) into hits from JOBORDERDETAIL where sno=v_sno and tno<>v_tno;if hits>0 then raise_application_error(-20074,'Job Order detail belongs to another document');end if;
                 select count(*) into hits from JOBORDER where tno=v_tno and(nvl(companycode,'~')<>nvl(:GLOBAL_COMPANYCODE,'~') or nvl(financialyearcode,'~')<>nvl(:GLOBAL_FINANCIALYEARCODE,'~'));if hits>0 then raise_application_error(-20074,'Job Order company or year changed');end if;
                 if old_amount is null then begin select amount,quantity1 into old_amount,old_qty from JOBORDERDETAIL where tno=v_tno and sno=v_sno;exception when no_data_found then old_amount:=0;old_qty:=0;end;end if;
                 if pct is not null then discount:=base_rate*pct/100;end if;rate:=base_rate-discount;
                 if item_code is not null then
                  select measuringunitcode1,measuringunitcode2 into unit1,unit2 from item where itemcode=item_code;
                  select multiplyingfactor,trim(hsncode) into factor,tax_code from itemspecification where itemspecificationcode=spec_code and tno in(select tno from item where itemcode=item_code);
                  q1:=round(q1,getuomdecimal(unit1));q2:=round(q1*factor,3);
                  rate_unit:=nvl(rate_unit,unit1);
                  if rate_unit=unit1 then amount:=q1*rate;elsif unit2 is not null and rate_unit=unit2 then amount:=nvl(q2,0)*rate;else raise_application_error(-20074,'Rate UOM does not belong to Job Order item');end if;
                 elsif job_code is not null then amount:=q1*rate;
                 else raise_application_error(-20074,'Select an item or Job Type');end if;
                 if job_code is not null then select trim(saccode) into tax_code from jobtype where jobtypecode=job_code;is_job:=1;end if;
                 if j.has('footers') then
                  declare lines json_array_t:=j.get_array('footers');line json_object_t;rid varchar2(30);begin
                   for k in 0..lines.get_size()-1 loop
                    line:=treat(lines.get(k) as json_object_t);r:=empty_row;rid:=line.get_string('ROWID');
                    if nvl(line.get_number('TNO'),-1)<>v_tno or nvl(line.get_number('SNO'),-1)<>v_sno then raise_application_error(-20074,'Preview footer owner changed');end if;
                    if rid is not null then
                     if seen.exists(rid) then raise_application_error(-20074,'Duplicate preview footer identity');end if;seen(rid):=true;
                     if not regexp_like(rid,'^t[0-9]+$') then begin select * into r from JOBORDERDETAILFOOTER where rowid=chartorowid(rid) and tno=v_tno and sno=v_sno;exception when no_data_found then raise_application_error(-20074,'Preview footer ROWID is stale or belongs to another detail');end;end if;
                    end if;
                    r.tno:=v_tno;r.sno:=v_sno;r.serialno:=k+1;r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');
                    if r.footerheadcode is null or r.legendscode is null then raise_application_error(-20074,'Select a footer head and legend');end if;
                    old_rows.extend;old_rows(old_rows.count):=r;old_rids(old_rows.count):=nvl(rid,'t'||globaltno.nextval);
                   end loop;
                  end;
                 else
                  for f in(select rowid rid,a.* from JOBORDERDETAILFOOTER a where tno=v_tno and sno=v_sno order by serialno,rowid)loop
                   r:=empty_row;r.tno:=f.tno;r.sno:=f.sno;r.serialno:=f.serialno;r.footerheadcode:=f.footerheadcode;r.legendscode:=f.legendscode;r.footerpercent:=f.footerpercent;r.footervalue:=f.footervalue;
                   old_rows.extend;old_rows(old_rows.count):=r;old_rids(old_rows.count):=f.rid;
                  end loop;
                 end if;
                 seen.delete;
                 for k in 1..old_rows.count loop
                  if j.get_string('field') in('HEADER','JOBTYPECODE','ITEMCODE','ITEMSPECIFICATIONCODE') and old_rows(k).footerheadcode in('.CGST.','.SGST.','.IGST.') then continue;end if;
                  r:=old_rows(k);
                  if abs(nvl(r.footervalue,0)-footer_value(r.legendscode,old_amount,r.footerpercent,r.footervalue,old_qty))<=.0051 then r.footervalue:=footer_value(r.legendscode,amount,r.footerpercent,r.footervalue,q1);end if;
                  append_row(r,old_rids(k));seen(r.footerheadcode):=true;
                 end loop;
                 if amount>0 then
                  for f in(select c.footerheadcode,a.legendscode,b.taxrate footerpercent from taxruledetail a join taxruledetailfooter b on b.tno=a.tno and b.sno=a.sno join footerhead c on c.footerheadcode=b.footerheadcode join taxrule d on d.tno=a.tno join party p on p.taxregistrationtypecode=d.taxregistrationtypecode where p.partycode=:P179_PARTYCODE and d.transactiontypecode=:P179_TRANSACTIONTYPECODE and((is_job=1 and exists(select 1 from taxrulesac e where e.tno=d.tno and trim(e.saccode)=tax_code)) or(is_job=0 and exists(select 1 from taxrulehsn e where e.tno=d.tno and trim(e.hsncode)=tax_code))))loop
                   if seen.exists(f.footerheadcode) then continue;end if;
                   r:=empty_row;r.tno:=v_tno;r.sno:=v_sno;r.footerheadcode:=f.footerheadcode;r.legendscode:=f.legendscode;r.footerpercent:=f.footerpercent;r.footervalue:=footer_value(f.legendscode,amount,f.footerpercent,0,q1);append_row(r,'t'||globaltno.nextval);
                  end loop;
                 end if;
                 for k in 1..result_rows.count loop footer:=footer+nvl(result_rows(k).footervalue,0);end loop;
                 apex_json.open_object;apex_json.write('sno',v_sno);apex_json.write('q1',q1);apex_json.write('q2',q2);apex_json.write('rate',rate);apex_json.write('discount',discount);apex_json.write('unit',rate_unit);apex_json.write('primaryUnit',unit1);apex_json.write('secondaryUnit',unit2);apex_json.write('amount',amount);apex_json.write('footer',footer);apex_json.write('total',amount+footer);apex_json.open_array('footers');
                 for k in 1..result_rows.count loop r:=result_rows(k);apex_json.open_object;apex_json.write('TNO',r.tno);apex_json.write('SNO',r.sno);apex_json.write('ROWID',result_rids(k));apex_json.write('SERIALNO',r.serialno);apex_json.write('FOOTERHEADCODE',r.footerheadcode);apex_json.write('LEGENDSCODE',r.legendscode);apex_json.write('FOOTERPERCENT',r.footerpercent);apex_json.write('FOOTERVALUE',r.footervalue);apex_json.close_object;end loop;
                 apex_json.close_array;apex_json.close_object;
                end;
                
                ```
        }
        execution {
            sequence: 0
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99017920260929052
        }
    )

    process p179-footer-calculate (
        name: P179_FOOTER_CALCULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare j json_object_t:=json_object_t.parse(apex_application.g_x01);code varchar2(30):=upper(trim(j.get_string('legend')));base_amount number:=j.get_number('amount');percent number:=j.get_number('percent');quantity number:=j.get_number('quantity');v number:=j.get_number('value');begin
                case code when 'PAA' then v:=round(abs(base_amount*percent/100),2);when 'PAD' then v:=-round(abs(base_amount*percent/100),2);when 'PRA' then v:=round(abs(base_amount*percent/100),0);when 'PRD' then v:=-round(abs(base_amount*percent/100),0);when 'OQA' then if quantity is null then raise_application_error(-20074,'Owning Job Order quantity is missing');end if;v:=abs(quantity*percent);when 'OQD' then if quantity is null then raise_application_error(-20074,'Owning Job Order quantity is missing');end if;v:=-abs(quantity*percent);when 'LSA' then v:=abs(v);when 'LSD' then v:=-abs(v);else null;end case;apex_json.open_object;apex_json.write('value',v);apex_json.close_object;end;
                ```
        }
        execution {
            sequence: 0
            point: ajaxCallback
        }
