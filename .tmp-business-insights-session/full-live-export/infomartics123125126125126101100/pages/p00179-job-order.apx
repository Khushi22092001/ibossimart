              window.hsplP179CaptureFd=function(){bindFooter();var f=grid('FooterDetail');if(f){var actions=apex.region('FooterDetail').widget().interactiveGrid('getActions');if(actions&&actions.set)actions.set('edit',false);}if(!footerEdits[String(apex.item('P179_SNO').getValue())])rememberFooter('set');};
              window.hsplP179PrepareFdRefresh=function(){var f=grid('FooterDetail');if(f&&f.model.clearChanges){restoringFooter=true;try{f.model.clearChanges();}finally{restoringFooter=false;}}};
              window.hsplP179RestoreFd=function(){bindFooter();var f=grid('FooterDetail'),sno=String(apex.item('P179_SNO').getValue()),saved=footerEdits[sno];if(!f||!saved)return;if(f.model.allowEdit&&f.model.getTotalRecords()>0){var first;f.model.forEach(function(r,i,id){if(!first&&!(f.model.getRecordMetadata(id)||{}).agg)first=r;});if(first&&!f.model.allowEdit(first))return;}
                var m=f.model,existing={},remove=[];m.forEach(function(r,i,id){var meta=m.getRecordMetadata(id)||{};if(!meta.agg&&!meta.deleted)existing[String(footerOwnerKeys.get(r)||raw(m.getValue(r,'ROWID')))]=r;});
