    process save-all-edited-o2c-row-footers (
        name: Save all edited O2C row footers
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 edits json_object_t;keys json_key_list;lines json_array_t;line json_object_t;own_sno number;own_sn number;own_rid varchar2(30);hits number;
                 r SALESQUOTATIONDETAILFOOTER%rowtype;empty_row SALESQUOTATIONDETAILFOOTER%rowtype;
                 type rows_t is table of SALESQUOTATIONDETAILFOOTER%rowtype;pending_rows rows_t:=rows_t();
                 type seen_t is table of boolean index by varchar2(100);seen seen_t;
                begin
                 if :P705_FD_EDITS is null then return;end if;
                 edits:=json_object_t.parse(:P705_FD_EDITS);keys:=edits.get_keys;
                 for i in 1..keys.count loop
                  own_sno:=to_number(keys(i));select count(*) into hits from SALESQUOTATIONDETAIL where tno=:P705_TNO and sno=own_sno;
                  if hits<>1 then raise_application_error(-20073,'Footer does not belong to exactly one saved detail row.');end if;
                  lines:=edits.get_array(keys(i));pending_rows:=rows_t();seen.delete;
                  for k in 0..lines.get_size()-1 loop
                   line:=treat(lines.get(k) as json_object_t);
                   if nvl(line.get_number('TNO'),-1)<>:P705_TNO or nvl(line.get_number('SNO'),-1)<>own_sno then raise_application_error(-20073,'Footer owner changed.');end if;
                   if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20073,'Select a footer head and legend.');end if;
                   own_rid:=line.get_string('ROWID');own_sn:=line.get_number('SN');r:=empty_row;
                   if own_rid is not null and not regexp_like(own_rid,'^t[0-9]+$') then
                    begin select * into r from SALESQUOTATIONDETAILFOOTER where rowid=chartorowid(own_rid) and tno=:P705_TNO and sno=own_sno;exception when no_data_found then raise_application_error(-20073,'Footer ROWID is stale or belongs to another detail.');end;
                    if r.sn is not null and own_sn is not null and r.sn<>own_sn then raise_application_error(-20073,'Footer SN and ROWID disagree.');end if;own_sn:=nvl(own_sn,r.sn);
                   end if;
                   if own_sn is not null then
                    select count(*) into hits from SALESQUOTATIONDETAILFOOTER where sn=own_sn and(tno<>:P705_TNO or sno<>own_sno);
                    if hits>0 then raise_application_error(-20073,'Footer SN belongs to another detail.');end if;
                    if r.tno is null then begin select * into r from SALESQUOTATIONDETAILFOOTER where tno=:P705_TNO and sno=own_sno and sn=own_sn;exception when no_data_found then null;when too_many_rows then raise_application_error(-20073,'Duplicated stored footer SN requires review.');end;end if;
                   else own_sn:=globaltno.nextval;end if;
                   if seen.exists(to_char(own_sn)) then raise_application_error(-20073,'Duplicate footer SN in Save payload.');end if;seen(to_char(own_sn)):=true;
                   r.tno:=:P705_TNO;r.sno:=own_sno;r.sn:=own_sn;
                   if line.has('FOOTERHEADCODE') then r.FOOTERHEADCODE:=line.get_string('FOOTERHEADCODE');end if;
                   if line.has('FOOTERPERCENT') then r.FOOTERPERCENT:=line.get_number('FOOTERPERCENT');end if;
                   if line.has('FOOTERVALUE') then r.FOOTERVALUE:=line.get_number('FOOTERVALUE');end if;
                   if line.has('SERIALNO') then r.SERIALNO:=line.get_number('SERIALNO');end if;
                   if line.has('LEGENDSCODE') then r.LEGENDSCODE:=line.get_string('LEGENDSCODE');end if;
                   if line.has('TAXFORMCODE') then r.TAXFORMCODE:=line.get_string('TAXFORMCODE');end if;
                   r.serialno:=k+1;
                   pending_rows.extend;pending_rows(pending_rows.count):=r;
                  end loop;
                  delete from SALESQUOTATIONDETAILFOOTER where tno=:P705_TNO and sno=own_sno;
                  for k in 1..pending_rows.count loop r:=pending_rows(k);insert into SALESQUOTATIONDETAILFOOTER values r;end loop;
                 end loop;
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 98202609297050002
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('CREATE','SAVE')
        }
    )

    process save-detail (
        name: save detail
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                declare l_rows number;begin
                 if :APEX$ROW_STATUS='C' then :TNO:=:P705_TNO;
                 elsif :APEX$ROW_STATUS in('U','D') then
                 if nvl(:TNO,:P705_TNO)<>:P705_TNO then raise_application_error(-20074,'Detail row belongs to a different document');end if;
                 select count(*) into l_rows from SALESQUOTATIONDETAIL where tno=:P705_TNO and rowid=:ROWID;
                 if l_rows<>1 then raise_application_error(-20074,'Detail row is missing or duplicated; the save was blocked');end if;
                 end if;
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                 :TNO:=:P705_TNO;if :SNO is null then select globaltno.nextval into :SNO from dual;end if;
                            Insert Into SALESQUOTATIONDETAIL (                 
                                    TNO,
                SNO,
                SERIALNO,
                ITEMCODE,
                ITEMSPECIFICATIONCODE,
                DESCRIPTION,
                QUANTITY1,
                QUANTITY2,
                RATEMEASURINGUNITCODE,
                RATE,
                AMOUNT,
                FOOTERAMOUNT,
                TOTALAMOUNT,
                REMARK,
                PACKINGTYPECODE,
                PACKINGNOS
                            )
                            Values (
                                :TNO,
                :SNO,
                :SERIALNO,
                :ITEMCODE,
                :ITEMSPECIFICATIONCODE,
                :DESCRIPTION,
                :QUANTITY1,
                :QUANTITY2,
                :RATEMEASURINGUNITCODE,
                :RATE,
                :AMOUNT,
                :FOOTERAMOUNT,
                :TOTALAMOUNT,
                :REMARK,
                :PACKINGTYPECODE,
                :PACKINGNOS
                
                            );
                        
                        when 'U' then
                            update SALESQUOTATIONDETAIL Set
                                  TNO=:TNO,
                SNO=:SNO,
                SERIALNO=:SERIALNO,
                ITEMCODE=:ITEMCODE,
                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                DESCRIPTION=:DESCRIPTION,
                QUANTITY1=:QUANTITY1,
                QUANTITY2=:QUANTITY2,
                RATEMEASURINGUNITCODE=:RATEMEASURINGUNITCODE,
                RATE=:RATE,
                AMOUNT=:AMOUNT,
                FOOTERAMOUNT=:FOOTERAMOUNT,
                TOTALAMOUNT=:TOTALAMOUNT,
                REMARK=:REMARK,
                PACKINGTYPECODE=:PACKINGTYPECODE,
                PACKINGNOS=:PACKINGNOS
                
                
                            WHERE TNO = :P705_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From SALESQUOTATIONDETAIL
                            Where TNo = :P705_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 8842942652508813
        }
    )

    process savesalesquotationfooter (
        name: SaveSalesquotationFooter
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    update salesquotationdetail d
                       set (footeramount,totalamount) = (
                           select nvl(sum(f.footervalue),0),
                                  nvl(d.amount,0) + nvl(sum(f.footervalue),0)
                             from salesquotationdetailfooter f
                            where f.tno=d.tno and f.sno=d.sno
                       )
                     where d.tno = :P705_TNO;
                
                    update salesquotation h
                       set (sumofamount,sumoffooteramount,salesquotationamount) = (
                           select nvl(sum(d.amount),0),
                                  nvl(sum(d.footeramount),0),
                                  nvl(sum(d.totalamount),0)
                             from salesquotationdetail d
                            where d.tno=h.tno
                       )
                     where h.tno=:P705_TNO;
                
                    delete from SALESquotationFOOTER where tno = :P705_TNO;
                    insert into SALESquotationFOOTER
                        (tno ,
                        SNO,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   SELECT X.TNO,
                                   GLOBALTNO.NEXTVAL,
                                   X.FOOTERHEADCODE,
                                   X.SUMOFVALUE
                             FROM 
                            (select 
                                :P705_TNO AS TNO ,               
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from SALESquotationDETAILFOOTER
                            where tno = :P705_TNO
                            group by FOOTERHEADCODE
                            ) X
                        );
                end;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 8902239106508838
        }
    )

