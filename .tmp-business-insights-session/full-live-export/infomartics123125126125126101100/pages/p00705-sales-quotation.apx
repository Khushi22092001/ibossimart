        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var widget      = apex.region('Detail').widget();
                    var grid        = widget.interactiveGrid('getViews','grid');  
                    var model = grid.getSelectedRecords(); 
                    var jsonData     = [];
                    
                    model.forEach(function(r) {
