    process p705-calculate-detail (
        name: P705_CALCULATE_DETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);v_itemspecificationcode varchar2(200):=j.get_string('spec');
                v_itemcode varchar2(200):=j.get_string('item');
                v_ratemeasuringunitcode varchar2(200):=j.get_string('unit');
                v_amount number:=j.get_number('AMOUNT');
                v_rate number:=j.get_number('rate');
                v_quantity1 number:=j.get_number('q1');
                v_quantity2 number:=j.get_number('q2');
                v_hsncode varchar2(200):=j.get_string('HSNCODE');
                v_tno number:=j.get_number('tno');
                v_sno number:=j.get_number('sno');
                v_footeramount number:=j.get_number('FOOTERAMOUNT');
                v_totalamount number:=j.get_number('TOTALAMOUNT');
                v_dfamount number:=j.get_number('DFAMOUNT');
                v_dfquantity1 number:=j.get_number('DFQUANTITY1');
                v_is_job varchar2(200):=j.get_string('IS_JOB');
                 v_u1 varchar2(30);v_u2 varchar2(30);v_factor number;v_dec1 number;v_dec2 number;hits number;old_auto number;next_value number;
                 previous_amount number:=j.get_number('previousAmount');previous_qty number:=j.get_number('previousQuantity');
                 type footer_rows is table of salesquotationdetailfooter%rowtype;old_rows footer_rows;
                 preview_started boolean:=false;
                 type seen_heads_t is table of boolean index by varchar2(100);seen_heads seen_heads_t;
                 type original_rids_t is table of varchar2(30) index by varchar2(100);original_rids original_rids_t;
                begin
                 if v_tno is null or v_tno!=:P705_TNO then raise_application_error(-20071,'Document identity changed. Reopen this form.');end if;
                 if v_sno is null then v_sno:=globaltno.nextval;end if;
                 select count(*) into hits from salesquotationdetail where sno=v_sno and tno!=v_tno;
                 if hits>0 then raise_application_error(-20071,'Detail identity belongs to another document.');end if;
                 select count(*) into hits from salesquotationdetail where tno=v_tno and sno=v_sno;
                 if hits>1 then raise_application_error(-20071,'Legacy duplicate detail identity requires document review before recalculation.');end if;
                 if v_itemcode is null  then raise_application_error(-20072,'Select an item/specification or applicable job first.');end if;
                
                 select count(*) into hits from SALESQUOTATION where tno=v_tno and nvl(companycode,'~')<>nvl(:GLOBAL_COMPANYCODE,'~');
                 if hits>0 then raise_application_error(-20074,'Preview belongs to a different company');end if;
                 savepoint o2c_preview_705;preview_started:=true;
                 for f in(select sn,rowid rid from SALESQUOTATIONDETAILFOOTER where tno=v_tno and sno=v_sno)loop
                  declare own_sn number:=f.sn;begin if own_sn is null then own_sn:=globaltno.nextval;update SALESQUOTATIONDETAILFOOTER set sn=own_sn where rowid=f.rid;end if;original_rids(to_char(own_sn)):=f.rid;end;
                 end loop;
                 if j.has('footers') then
                  declare lines json_array_t:=j.get_array('footers');line json_object_t;r SALESQUOTATIONDETAILFOOTER%rowtype;empty_row SALESQUOTATIONDETAILFOOTER%rowtype;
                  type cache_rows_t is table of SALESQUOTATIONDETAILFOOTER%rowtype;cache_rows cache_rows_t:=cache_rows_t();
                  type seen_keys_t is table of boolean index by varchar2(100);seen_keys seen_keys_t;l_sn number;l_rid varchar2(30);
                  begin
                   for k in 0..lines.get_size()-1 loop
                    line:=treat(lines.get(k) as json_object_t);
                    if nvl(line.get_number('TNO'),-1)<>v_tno or nvl(line.get_number('SNO'),-1)<>v_sno then raise_application_error(-20074,'Preview footer belongs to another detail');end if;
                    if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20074,'Preview footer head or legend missing');end if;
                    l_sn:=line.get_number('SN');
                    
                    if l_sn is null then l_sn:=globaltno.nextval;end if;
                    if seen_keys.exists(to_char(l_sn)) then raise_application_error(-20074,'Duplicate preview footer identity');end if;seen_keys(to_char(l_sn)):=true;
                    select count(*) into hits from SALESQUOTATIONDETAILFOOTER where sn=l_sn and(tno<>v_tno or sno<>v_sno) and not exists(select 1 from SALESQUOTATIONDETAILFOOTER own where own.tno=v_tno and own.sno=v_sno and own.sn=l_sn);
                    if hits>0 then raise_application_error(-20074,'Preview footer key belongs to another row');end if;
                    r:=empty_row;begin select * into r from SALESQUOTATIONDETAILFOOTER where tno=v_tno and sno=v_sno and sn=l_sn;exception when no_data_found then null;end;
                    r.tno:=v_tno;r.sno:=v_sno;r.sn:=l_sn;r.serialno:=k+1;r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');cache_rows.extend;cache_rows(cache_rows.count):=r;
                   end loop;
                   delete from SALESQUOTATIONDETAILFOOTER where tno=v_tno and sno=v_sno;
                   for k in 1..cache_rows.count loop r:=cache_rows(k);insert into SALESQUOTATIONDETAILFOOTER values r;end loop;
                  end;
                 end if;
                
                 select * bulk collect into old_rows from salesquotationdetailfooter where tno=v_tno and sno=v_sno;
                 if v_itemcode is not null then
                 select measuringunitcode1,measuringunitcode2 into v_u1,v_u2 from item where itemcode=v_itemcode;
                 select max(multiplyingfactor) into v_factor from itemspecification where itemspecificationcode=v_itemspecificationcode;
                 v_dec1:=nvl(getuomdecimal(v_u1),3);v_dec2:=case when v_u2 is null then 3 else nvl(getuomdecimal(v_u2),3) end;
                 
                 v_quantity1:=round(nvl(v_quantity1,0),v_dec1);
                 if v_u2 is not null and nvl(v_factor,0)>0 then
                  if j.get_string('field')='QUANTITY2' then v_quantity1:=round(nvl(v_quantity2,0)/v_factor,v_dec1);else v_quantity2:=round(v_quantity1*v_factor,v_dec2);end if;
                 end if;
                 v_ratemeasuringunitcode:=nvl(v_ratemeasuringunitcode,v_u1);
                 if v_ratemeasuringunitcode!=v_u1 and (v_u2 is null or v_ratemeasuringunitcode!=v_u2) then raise_application_error(-20072,'Select a valid rate unit for this item.');end if;
                end if;
                 
                 declare
                    mfactor number;
                    unit1 varchar2(30);
                    unit2 varchar2(30);
                    tmp    number;
                    phsn varchar(30);
                
                 
                begin
                    null;
                    select max(MULTIPLYINGFACTOR) into mfactor from ITEMSPECIFICATION where ITEMSPECIFICATIONCODE = v_itemspecificationcode;      
                    null;
                    null;
                
                    select MEASURINGUNITCODE1 into unit1 from item where itemcode = v_itemcode;
                    select MEASURINGUNITCODE2 into unit2 from item where itemcode = v_itemcode;
                    
                    if v_ratemeasuringunitcode = unit1 then
                       v_amount := nvl(v_rate,0)*nvl(v_quantity1,0);
                    else 
                       v_amount := nvl(v_rate,0)*nvl(v_quantity2,0);
                    end if;
                
                    
                    
                    
                    select trim(hsncode) INTO v_hsncode from itemspecification where itemspecificationcode = v_itemspecificationcode;
                   
                    
                    if nvl(v_rate,0) > 0 then
                    
                      
                
                           DELETE FROM SALESquotationDETAILFOOTER WHERE TNO = v_tno AND SNO = v_sno;
                
                            for vTaxRule
                            				in (
                            					select
                            						rownum as slno,
                            						b.TNo,
                            						b.SNO,
                            						a.LegendsCode,
                            						c.FooterHeadCode,
                            						c.FooterHeadName,
                            						b.TaxRate as FooterPercent,
                                                    (v_amount * B.TAXrATE) /100 AS FooterValue
                            					from TaxRuleDetail a, TaxRuleDetailFooter b, FooterHead c, TaxRule d, TaxRuleHSN e, party F
                            					where a.TNO = b.TNo
                            						and a.SNO = b.SNo
                            						and b.FooterHeadCode = c.FooterHeadCode
                            						and a.TNO = d.TNo
                                                    and d.tno = e.tno
                                                    and d.TaxRegistrationTypeCode = f.TaxRegistrationTypeCode
                                                    and f.PartyCode = :P705_PARTYCODE
                                                    And d.transactiontypecode = :P705_TRANSACTIONTYPECODE
                                                    and e.HSNCODE = v_hsncode
                                                    
                            					
                            				)
                            			loop
                           
                           
                           
                           
                            			    Insert into SALESquotationDETAILFOOTER
                                            (tno,sno,sn,footerheadcode,footerpercent,footervalue,serialno,legendscode)
                            				values
                                            (v_tno,v_sno,globaltno.nextval,vTaxRule.FooterHeadCode,vTaxRule.FooterPercent,round(vTaxRule.FooterValue,2),vTaxRule.Slno,vTaxRule.LegendsCode);
                            			
                            			end loop; 
                                        null;
                        end if;
                
                   
                   SELECT SUM(FOOTERVALUE) INTO v_footeramount from SALESquotationDETAILFOOTER
                   where tno = v_tno
                     and sno = v_sno;
                   
                   v_totalamount := nvl(v_amount,0) + nvl(v_footeramount,0);
                
                end;
                
                 -- Keep non-formula/manual footer rows; rescale only recognised matching automatic rows.
                 for i in 1..old_rows.count loop
                  if j.get_string('field') in('HEADER','ITEMCODE','ITEMSPECIFICATIONCODE','JOBTYPECODE') and old_rows(i).footerheadcode in('.CGST.','.SGST.','.IGST.') then continue;end if;
                  next_value:=old_rows(i).footervalue;
                  if upper(trim(old_rows(i).legendscode)) in('PRA','PRD','PAA','PAD') and previous_amount is not null then
                   old_auto:=imart_purchasebill_calc.footer_value(old_rows(i).legendscode,previous_amount,old_rows(i).footerpercent,old_rows(i).footervalue,previous_qty);if upper(trim(old_rows(i).legendscode)) in('PAA','PAD') then old_auto:=round(old_auto,2);end if;
                   
                   if abs(nvl(old_rows(i).footervalue,0)-nvl(old_auto,0))<=.0051 then
                    next_value:=imart_purchasebill_calc.footer_value(old_rows(i).legendscode,v_amount,old_rows(i).footerpercent,old_rows(i).footervalue,v_quantity1);if upper(trim(old_rows(i).legendscode)) in('PAA','PAD') then next_value:=round(next_value,2);end if;
                   end if;
                  end if;
                  if old_rows(i).footerheadcode='.TCS.' and false then continue;end if;
                  if not seen_heads.exists(old_rows(i).footerheadcode) then
                  delete from salesquotationdetailfooter where tno=v_tno and sno=v_sno and footerheadcode=old_rows(i).footerheadcode;
                   seen_heads(old_rows(i).footerheadcode):=true;
                  end if;
                  insert into salesquotationdetailfooter(tno,sno,sn,footerheadcode,footerpercent,footervalue,serialno,legendscode)values(old_rows(i).tno,old_rows(i).sno,old_rows(i).sn,old_rows(i).footerheadcode,old_rows(i).footerpercent,next_value,old_rows(i).serialno,old_rows(i).legendscode);
                 end loop;
                 
                 select nvl(sum(footervalue),0) into v_footeramount from salesquotationdetailfooter where tno=v_tno and sno=v_sno;
                 v_totalamount:=nvl(v_amount,0)+v_footeramount;
                 apex_json.open_object;
                 apex_json.write('sno',v_sno,true);
                apex_json.write('q1',v_quantity1,true);
                apex_json.write('q2',v_quantity2,true);
                apex_json.write('rate',v_rate,true);
                apex_json.write('unit',v_ratemeasuringunitcode,true);
                apex_json.write('amount',v_amount,true);
                apex_json.write('footer',v_footeramount,true);
                apex_json.write('total',v_totalamount,true);
                 
                 
                 apex_json.write('primaryUnit',v_u1,true);apex_json.write('secondaryUnit',v_u2,true);update SALESQUOTATIONDETAILFOOTER set sn=globaltno.nextval where tno=v_tno and sno=v_sno and sn is null;
                 apex_json.open_array('footers');
                 for f in(select * from SALESQUOTATIONDETAILFOOTER where tno=v_tno and sno=v_sno order by serialno,sn)loop
                  apex_json.open_object;apex_json.write('TNO',f.tno);apex_json.write('SNO',f.sno);apex_json.write('SN',f.sn);apex_json.write('SERIALNO',f.serialno);apex_json.write('FOOTERHEADCODE',f.footerheadcode);apex_json.write('LEGENDSCODE',f.legendscode);apex_json.write('FOOTERPERCENT',f.footerpercent);apex_json.write('FOOTERVALUE',f.footervalue);apex_json.close_object;
                 end loop;
                 apex_json.close_array;
                 rollback to o2c_preview_705;preview_started:=false;
                 apex_json.close_object;
                exception when others then
                 if preview_started then rollback to o2c_preview_705;end if;raise;
                end;
                ```
        }
        execution {
            sequence: 80
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 98202609297050001
        }
    )

    process p705-footer-calculate (
        name: P705_FOOTER_CALCULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare j json_object_t:=json_object_t.parse(apex_application.g_x01);l_head varchar2(30):=j.get_string('head');l_legend varchar2(30):=j.get_string('legend');l_percent number:=j.get_number('percent');l_value number:=j.get_number('value');l_amount number:=j.get_number('amount');begin
                declare	
                	cursor cFooterSchemeDetail is
                		select a.* 
                		from FooterSchemeList a, FooterSchemeList c
                		where a.tno = c.tno
                			and a.Status = 'ACTIVE'
                			and c.FooterHeadCode = l_head
                			and a.sno < c.sno 
                			and a.companycode = :global_CompanyCode
                			and a.financialyearcode = :global_financialyearcode
                			and a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                			and c.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                		order by a.sno;
                	vFooterSchemeDetail cFooterSchemeDetail%ROWTYPE;
                	
                	cursor c3FooterSchemeDetail is
                		select a.* 
                		from FooterSchemeList a, FooterSchemeList c
                		where a.tno = c.tno
                			and a.Status = 'ACTIVE'
                			and c.FooterHeadCode = l_head
                			and a.companycode = :global_CompanyCode
                			and a.financialyearcode = :global_financialyearcode
                			and a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                			and c.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                		order by a.sno;
                	v3FooterSchemeDetail c3FooterSchemeDetail%ROWTYPE;
                
                
                	cursor c2FooterSchemeDetail is
                		select a.* 
                		from FooterSchemeList a
                		where a.Status = 'ACTIVE'
                			and a.FooterHeadCode = l_head
                			and a.companycode = :global_CompanyCode
                			and a.financialyearcode = :global_financialyearcode
                			and a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                		order by a.sno;
                	v2FooterSchemeDetail c2FooterSchemeDetail%ROWTYPE;
                	
                	myFormula varchar2(1000);
                	isFound varchar2(10);
                	fvalue number;
                    tTotalDetailAmount number;
                    tmp varchar2(100);
                	
                BEGIN
                  /*for vBookingDetail in
                        (
                        Select
                            sum(a.Amount) as TotalAmount
                        From BookingDetail a
                        Where a.Tno = :P93_Tno
                        )
                    loop
                        tTotalDetailAmount := vBookingDetail.TotalAmount;
                    end loop;*/
                    tTotalDetailAmount := l_amount;
                
                  open c2FooterSchemeDetail;
                  fetch c2FooterSchemeDetail into v2FooterSchemeDetail;
                  if c2FooterSchemeDetail%FOUND then
                  		if length(nvl(v2FooterSchemeDetail.Formula,''))>0 then
                  				myFormula := v2FooterSchemeDetail.Formula;
                  				myFormula := replace(myFormula, '.A.', nvl(tTotalDetailAmount,0) );
                  				for vFooterSchemeDetail  in cFooterSchemeDetail 
                  				loop
                					if l_head = vFooterSchemeDetail.FooterHeadCode then
                							isFound := 'YES';
                							myFormula := replace(myFormula, vFooterSchemeDetail.FooterHeadCode, nvl(l_value,0) );
                							exit;
                					end if;
                  				end loop;
                  				
                  					myFormula := replace(myFormula, v2FooterSchemeDetail.FooterHeadCode, nvl(l_percent,0) );
                  			
                  				for v3FooterSchemeDetail  in c3FooterSchemeDetail 
                  				loop
                  						myFormula := replace(myFormula, v3FooterSchemeDetail.FooterHeadCode, '0' );
                  				end loop;
                  				if (l_legend is null and NVL(GetMYparametervalue('LEGENDS'),'YES') = 'NO') then 
                					myFormula := replace(myFormula, v2FooterSchemeDetail.FooterHeadCode, nvl(l_percent,0));
                					l_value := getvalue(myformula);
                			    end if;
                
                                
                
                		  		if (l_legend is not null and  NVL(GetMyparametervalue('LEGENDS'),'NO')= 'YES') then 
                		  				select getvalue(myFormula) into  fvalue 	from dual;
                
                                          
                                      
                		  				if l_legend = 'PRA' then 
                		  					 	l_value := nvl(round(fvalue,0),0);
                		  					
                
                                                 
                                                
                		  				end if;
                		  				
                		  				if l_legend = 'PRD' then 
                		  						l_value := (-1)* nvl(round(fvalue,0),0);
                		  					
                		  				end if;
                							if l_legend is null then 
                									myFormula := replace(myFormula, v2FooterSchemeDetail.FooterHeadCode, nvl(l_percent,0));
                							end if;
                							if l_legend = 'PAA' then 
                		  						l_value := nvl(round(fvalue,2),0);
                							end if;
                							
                							if l_legend = 'PAD' then 
                		  						l_value := (-1)* nvl(round(fvalue,2),0);
                							end if;
                		  		END IF;
                		  	
                  			
                  		end if;
                 end if;
                 end;
                apex_json.open_object;apex_json.write('value',l_value,true);apex_json.close_object;end;
                ```
