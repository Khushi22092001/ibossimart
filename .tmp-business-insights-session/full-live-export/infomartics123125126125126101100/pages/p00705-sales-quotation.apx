    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 90
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action imart-o2c-705-dirty-activation (
            action: executeJsCode
            settings {
                jsCode: "if(apex.item('P705_STATUS').getValue()==='ACTIVE'&&window.hsplP705HasUnsaved&&window.hsplP705HasUnsaved()){apex.da.cancel();apex.message.showErrors([{type:'error',location:'page',message:'Save header, detail and footer edits before making this document Active.',unsafe:false}]);}"
            }
            execution {
                sequence: 1
                fireOnInit: false
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P705_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P705_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare l_guard boolean := :P705_STATUS='ACTIVE'; l_started boolean:=false; begin
                     savepoint imart_activation_request;
                     if l_guard then imart_txn_integrity.begin_change('SALESQUOTATION',:P705_TNO);l_started:=true;end if;
                     SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P705_TNO,:P705_STATUS);
                    
                    
                     if l_started then imart_txn_integrity.finish_change('SALESQUOTATION',:P705_TNO);l_started:=false;end if;
                     exception when others then
                     if l_started then imart_txn_integrity.abort_change('SALESQUOTATION',:P705_TNO);end if;
                     begin rollback to imart_activation_request;exception when others then null;end;
                     raise;
                    end;
                    ```
                itemsToSubmit: [
                    P705_TNO
                    P705_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P705_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @buttons
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P705_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

