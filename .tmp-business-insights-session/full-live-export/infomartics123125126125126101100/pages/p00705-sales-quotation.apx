                plsqlCode:
                    ```plsql
                    begin
                    IMART_REFERENCE_SCOPE.assert_reference('INDENT',:P705_INDENTTNO,IMART_REFERENCE_SCOPE.company_code,'P705_INDENTTNO');
                    begin
                        insert into purchaseorderdetail
                        (
                            tno,
                            sno,
                            INDENTTNO,
                            ITEMCODE,
                            ITEMSPECIFICATIONCODE,
                            QUANTITY1,
                            QUANTITY2,
                            RATE,
                            AMOUNT , 
                            RATEMEASURINGUNITCODE
                        )
                        (
                            select 
                                :P705_TNO,
                                globaltno.nextval,
                                :P705_INDENTTNO,
                                a.ITEMCODE , 
                                a.ITEMSPECIFICATIONCODE , 
                                a.INDENTQUANTITY1 , 
                                a.INDENTQUANTITY2,
                                a.RATE , 
                                a.AMOUNT ,
                                GetMeasuringUnitCodeFromItem(a.itemcode) 
                            from indentdetail a , item b
                            where a.itemcode = b.itemcode
                            and a.tno = :P705_INDENTTNO
                        );
                    end;
                    end;
                    ```
                itemsToSubmit: [
                    P705_TNO
                    P705_INDENTTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

