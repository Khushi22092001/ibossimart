    dynamicAction insert-detail (
        name: Insert detail
        execution {
            sequence: 990
        }
        when {
            event: click
            selectionType: button
            button: @getitem
        }

        action detail (
            name: detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    IMART_REFERENCE_SCOPE.assert_reference('SALESENQUIRY',:P705_SALESENQUIRYTNO,IMART_REFERENCE_SCOPE.company_code,'P705_SALESENQUIRYTNO');
                    if :P705_SALESENQUIRYTNO is not null then
                        delete from salesquotationdetail where tno = :P705_TNO;
                    
                        for vSenq in (
                              select
                                ITEMCODE,
                                ITEMSPECIFICATIONCODE,
                                DESCRIPTION,
                                QUANTITY1,
                                QUANTITY2,
                                RATEMEASURINGUNITCODE,
                                RATE,
                                AMOUNT,
                                FOOTERAMOUNT,
                                TOTALAMOUNT,
                                REMARK
                               
                            from salesenquirydetail a
                            where tno = :P705_SALESENQUIRYTNO
                            order by sno
                        ) loop 
                        insert into salesquotationdetail
                        (
                            TNO,
                            SNO,
                            ITEMCODE,
                            ITEMSPECIFICATIONCODE,
                            DESCRIPTION,
                            QUANTITY1,
                            QUANTITY2,
                            RATEMEASURINGUNITCODE,
                            RATE,
                            AMOUNT,
                            FOOTERAMOUNT,
                            TOTALAMOUNT,
                            Remark
                        ) values 
                        (
                            :P705_TNO,
                            globaltno.nextval,
                            vSenq.itemcode,
                            vSenq.itemspecificationcode,
                            vSenq.description,
                            vSenq.quantity1,
                            vSenq.quantity2,
                            vSenq.ratemeasuringunitcode,
                            vSenq.rate,
                            vSenq.amount,
                            vSenq.footeramount,
                            vSenq.totalamount,
                            vSenq.Remark
                        );
                      end loop;  
                        
                    end if;
                    end;
                    ```
                itemsToSubmit: [
                    P705_SALESENQUIRYTNO
                    P705_TNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action detail-footer (
            name: detail footer
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    IMART_REFERENCE_SCOPE.assert_reference('SALESENQUIRY',:P705_SALESENQUIRYTNO,IMART_REFERENCE_SCOPE.company_code,'P705_SALESENQUIRYTNO');
                    if :P705_SALESENQUIRYTNO is not null then
                        delete from salesquotationdetailfooter where tno = :P705_TNO;
                        insert into salesquotationdetailfooter
                        (
                            tno,
                            sno,
                            sn,
                            serialno,
                            FOOTERHEADCODE,
                            LEGENDSCODE,
                            FOOTERPERCENT,
                            FOOTERVALUE
                        )
                        (
                        select
                            :P705_TNO, 
                            c.SNO, 
                            globaltno.nextval, 
                            1, 
                            a.FOOTERHEADCODE, 
                            a.LEGENDSCODE, 
                            a.FOOTERPERCENT, 
                            a.FOOTERVALUE
                            from salesenquirydetailfooter a, salesenquirydetail b, salesquotationdetail c
                            where a.tno = :P705_SALESENQUIRYTNO 
                            and a.tno = b.tno   
                            and c.tno = :P705_TNO
                            and c.itemcode = b.itemcode
                            and c.itemspecificationcode = b.itemspecificationcode
                            and a.sno=b.sno
                        );
                    end if;
                    end;
                    ```
                itemsToSubmit: [
                    P705_SALESENQUIRYTNO
                    P705_TNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(amount) , sum(footeramount) , sum(totalamount)
                    from salesquotationdetail 
                    where tno = :P705_TNO
                    ```
                itemsToSubmit: P705_TNO
            }
            affectedElements {
                selectionType: items
                items: [
                    P705_SUMOFAMOUNT
                    P705_SUMOFFOOTERAMOUNT
                    P705_SALESQUOTATIONAMOUNT
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action refresh-detail (
            name: refresh detail
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

