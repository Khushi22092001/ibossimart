                var m=f.model,existing={},remove=[];m.forEach(function(r,i,id){var meta=m.getRecordMetadata(id)||{};if(!meta.agg&&!meta.deleted)existing[String(raw(m.getValue(r,'SN')))]=r;});
                restoringFooter=true;try{
                  saved.forEach(function(line){var r=existing[String(line.SN)];if(r)delete existing[String(line.SN)];else r=m.getRecord(m.insertNewRecord());footerFields.forEach(function(field){if(field==='ROWID')return;var value=line[field];if(String(raw(m.getValue(r,field))||'')!==String(value||''))m.setValue(r,field,value==null?'':String(value));});if(line.ROWID)footerOwnerKeys.set(r,line.ROWID);});
