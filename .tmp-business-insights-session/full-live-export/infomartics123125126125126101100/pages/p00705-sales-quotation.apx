              }
              function bind(){var v=grid('Detail');if(!v||!v.model||v.model.hsplO2c705ModelCalc)return;model=v.model;generation++;rows={};footerEdits={};invalid={};var owner=model;model.forEach(function(r,i,id){var m=model.getRecordMetadata(id)||{};if(!m.deleted&&!m.agg)rows[id]={revision:0,previousAmount:num(value(r,'AMOUNT')),previousQuantity:num(value(r,'QUANTITY1'))};});model.hsplO2c705ModelCalc=true;model.subscribe({onChange:function(type,data){
