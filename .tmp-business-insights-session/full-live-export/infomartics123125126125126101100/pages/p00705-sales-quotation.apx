    dynamicAction set-value-final-value-of-detail-footer-on-loose-focus (
        name: Set Value- Final value of Detail footer on Loose Focus
        execution {
            sequence: 240
        }
        when {
            event: focusout
            selectionType: region
            region: @footerdetail
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("FooterDetail").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("FOOTERVALUE");
                    model.forEach(function(igrow) {
                        n_amt = parseInt(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P705_FVALUE").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

