                    select count(*) into hits from JOBBILLDETAILFOOTER where sn=own_sn and(tno<>v_tno or sno<>v_sno);if hits>0 then raise_application_error(-20074,'Footer SN belongs to another detail');end if;
                    if r.tno is null then begin select * into r from JOBBILLDETAILFOOTER where tno=v_tno and sno=v_sno and sn=own_sn;exception when no_data_found then null;end;end if;
                    r.tno:=v_tno;r.sno:=v_sno;r.sn:=own_sn;r.serialno:=k+1;r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');
