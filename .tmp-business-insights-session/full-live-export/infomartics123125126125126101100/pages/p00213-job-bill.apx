    dynamicAction set-qty (
        name: Set qty2
        execution {
            sequence: 180
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail
            columns: QUANTITY1
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                        mfactor number;
                    begin
                        select MULTIPLYINGFACTOR into mfactor from ITEMSPECIFICATION where ITEMSPECIFICATIONCODE = :ITEMSPECIFICATIONCODE;
                        return :QUANTITY1*mfactor;
                    exception when others then
                        null;
