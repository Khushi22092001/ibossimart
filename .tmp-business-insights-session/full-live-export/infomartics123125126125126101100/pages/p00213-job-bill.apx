    pageItem P213_JOBORDERTNO (
        type: popupLov
        label {
            label: Service Order No
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select joborderno , tno from (select * from JOBORDER where COMPANYCODE=(select IMART_REFERENCE_SCOPE.company_code(:P213_TNO,:P213_COMPANYCODE) from dual)) JOBORDER
                where getdocumentstatuscode('JOBORDER',TNO) = 'ACTIVE'
                and partycode = :P213_PARTYCODE
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P213_PARTYCODE
            itemsToSubmit: [
                P213_PARTYCODE
                P213_TNO
                P213_COMPANYCODE
            ]
            parentRequired: false
        }
        layout {
            sequence: 10
            region: @job-order-detail
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        advanced {
            postText: <a href="f?p=&APP_ID.:179:&SESSION.::NO:RP,179:P179_TNO,P179_CALLEDFROMPAGE,P179_FORMSTATUS,P179_CALLEDFROMTNO:&P213_JOBORDERTNO.,213,CALLED,&P213_TNO."><span class="fa fa-magic"></span></a>
        }
        source {
            formRegion: @service-bill
            column: JOBORDERTNO
            dataType: number
        }
    )

