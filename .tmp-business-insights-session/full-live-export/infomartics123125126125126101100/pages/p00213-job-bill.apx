    process insert-into-footer (
        name: Insert into footer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    delete from jobbillfooter where tno = :P213_TNO;
                    insert into jobbillfooter
                        (tno ,
                        SNO,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   SELECT X.TNO,
                                   GLOBALTNO.NEXTVAL,
                                   X.FOOTERHEADCODE,
                                   X.SUMOFVALUE
                             FROM 
                            (select 
                                :P213_TNO AS TNO ,               
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from jobbilldetailfooter
                            where tno = :P213_TNO
                            group by FOOTERHEADCODE
                            ) X
                        );
                end;
                ```
        }
        execution {
            sequence: 60
        }
