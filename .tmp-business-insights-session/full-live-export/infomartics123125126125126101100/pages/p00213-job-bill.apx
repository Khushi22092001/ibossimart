    dynamicAction calculate-sum-of-amount-value-on-loose-focus (
        name: Calculate Sum of Amount Value on Loose focus
        execution {
            sequence: 240
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail
            columns: [
                AMOUNT
                FD
                FOOTERAMOUNT
                TOTALAMOUNT
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("AMOUNT");
                    var footerKey = model.getFieldKey("FOOTERAMOUNT");
                    var grandtotalKey = model.getFieldKey("TOTALAMOUNT");
                    var totalAmt = 0;
                    var footerAmt = 0;
                    var grandtotalAmt = 0;
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                      var footer = parseFloat(r[footerKey], 10);
                      var grandtotal = parseFloat(r[grandtotalKey], 10);
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                      if (!isNaN(footer)) {
                        footerAmt += footer;
                      }
                    
                      if (!isNaN(grandtotal)) {
                        grandtotalAmt += grandtotal;
                      }
                    });
                    
                    $s("P213_SUMOFAMOUNT", totalAmt);
                    $s("P213_SUMOFFOOTERAMOUNT", footerAmt);
                    $s("P213_JOBBILLAMOUNT", grandtotalAmt);
                    	
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :TOTALAMOUNT
                itemsToSubmit: TOTALAMOUNT
            }
            affectedElements {
                selectionType: items
                items: P213_JOBBILLAMOUNT
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction calculate-the-total-amount (
        name: Calculate the Total Amount
        execution {
            sequence: 480
        }
        when {
            selectionType: items
            items: [
                P213_SUMOFAMOUNT
                P213_SUMOFFOOTERAMOUNT
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // 1. Fetch values and remove commas to prevent NaN errors
                    var num1 = parseFloat($v("P213_SUMOFAMOUNT").replace(/,/g, '')) || 0;
                    var num2 = parseFloat($v("P213_SUMOFFOOTERAMOUNT").replace(/,/g, '')) || 0;
                    
                    // 2. Calculate the raw sum
                    var rawTotal = num1 + num2;
                    $s("P213_JOBBILLAMOUNTBEFOREROUND", rawTotal.toFixed(2));
                    
                    // 3. Calculate the rounded figure (Nearest Integer)
                    var roundedTotal = Math.round(rawTotal);
                    
                    // 4. Calculate the adjustment (Round Off) amount
                    var roundOffAmount = roundedTotal - rawTotal;
                    
                    // 5. Set the values to the Page Items
                    $s("P213_ROUNDOFF", roundOffAmount.toFixed(2));
                    $s("P213_JOBBILLAMOUNT", roundedTotal.toFixed(2));
                    
                    
                    
                    
                    
                    
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: nvl(:P213_JOBBILLAMOUNTBEFOREROUND,0)+nvl(:P213_ROUNDOFF,0)
                itemsToSubmit: [
                    P213_JOBBILLAMOUNTBEFOREROUND
                    P213_ROUNDOFF
                ]
            }
            affectedElements {
                selectionType: items
                items: P213_JOBBILLAMOUNT
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action check-detail (
            name: check detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    checkdetail(getmodulecodeforpageno(:APP_PAGE_ID),:P213_TNO);
                    
                    ```
                itemsToSubmit: P213_TNO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from jobbillDETAIL a
                        where not exists (
                            select 1 from jobbill  aa  
                            where aa.tno = a.tno
                        )and a.tno = :P213_TNO;
                        delete from jobbilljobgrn a
                        where not exists (
                            select 1 from jobbill  aa  
                            where aa.tno = a.tno
                        )and a.tno = :P213_TNO;
                           delete from jobbilljobccinvoice a
                        where not exists (
                            select 1 from jobbill  aa  
                            where aa.tno = a.tno
                        )and a.tno = :P213_TNO;
                    ```
                itemsToSubmit: P213_TNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P213_CALLEDFROMPAGE').getValue();
                    var y = apex.item('P213_CALLEDFROMTNO').getValue();
                    
                    //var url = "f?p=#APP_ID#:80:#SESSION#::NO:RP,80:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#:P#2002#_TNO:#P2002_TNO#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    
                    url = url.replace("#P2002_TNO#", y);
                    //window.alert(x);
                    //window.alert(y);
                    //window.alert(url);
                    
                    
                    //call
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

