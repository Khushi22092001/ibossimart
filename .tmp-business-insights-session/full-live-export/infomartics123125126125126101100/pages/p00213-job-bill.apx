        }
    )

    process p213-calculate-detail (
        name: P213_CALCULATE_DETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);
                 v_tno number:=j.get_number('tno');v_sno number:=j.get_number('sno');hits number;
                 q1 number;q2 number;amount number;footer number;total number;old_amount number:=j.get_number('previousAmount');old_qty number:=j.get_number('previousQuantity');
                 job_code varchar2(100):=j.get_string('JOBTYPECODE');item_code varchar2(100):=j.get_string('item');spec_code varchar2(100):=j.get_string('spec');sac_code varchar2(100);unit1 varchar2(100);unit2 varchar2(100);factor number;is_job number:=0;tax_round varchar2(3):=:P213_TAXINROUNDFIGURE;preview_started boolean:=false;
                 type footer_rows_t is table of JOBBILLDETAILFOOTER%rowtype;old_rows footer_rows_t;
                 type keys_t is table of boolean index by varchar2(100);seen_heads keys_t;
                 type rids_t is table of varchar2(30) index by varchar2(100);original_rids rids_t;
                 function job_footer_value(legend varchar2,base_amount number,percent number,current_value number,quantity number) return number is code varchar2(30):=upper(trim(legend));begin
                 case code when 'PRA' then return round(abs(nvl(base_amount,0)*nvl(percent,0)/100),0);when 'PRD' then return -round(abs(nvl(base_amount,0)*nvl(percent,0)/100),0);when 'PAA' then return round(abs(nvl(base_amount,0)*nvl(percent,0)/100),2);when 'PAD' then return -round(abs(nvl(base_amount,0)*nvl(percent,0)/100),2);when 'OQA' then return abs(nvl(quantity,0)*nvl(percent,0));when 'OQD' then return -abs(nvl(quantity,0)*nvl(percent,0));when 'LSA' then return abs(nvl(current_value,0));when 'LSD' then return -abs(nvl(current_value,0));else return nvl(current_value,0);end case;end;
                
                begin
                 if v_tno is null or v_tno<>:P213_TNO then raise_application_error(-20074,'Job Bill document identity changed');end if;
                 if v_sno is null then v_sno:=globaltno.nextval;end if;
                 select count(*) into hits from JOBBILLDETAIL where sno=v_sno and tno<>v_tno;
                 if hits>0 then raise_application_error(-20074,'Job Bill detail belongs to another document');end if;
                 select count(*) into hits from JOBBILL where tno=v_tno and nvl(companycode,'~')<>nvl(:GLOBAL_COMPANYCODE,'~');
                 if hits>0 then raise_application_error(-20074,'Job Bill belongs to another company');end if;
                 if old_amount is null then begin select amount,quantity1 into old_amount,old_qty from JOBBILLDETAIL where tno=v_tno and sno=v_sno;exception when no_data_found then old_amount:=0;old_qty:=0;end;end if;
                 savepoint jobbill_preview;preview_started:=true;
                 for f in(select sn,rowid rid from JOBBILLDETAILFOOTER where tno=v_tno and sno=v_sno)loop
                  declare own_sn number:=f.sn;begin if own_sn is null then own_sn:=globaltno.nextval;update JOBBILLDETAILFOOTER set sn=own_sn where rowid=f.rid;end if;original_rids(to_char(own_sn)):=f.rid;end;
                 end loop;
                 if j.has('footers') then
