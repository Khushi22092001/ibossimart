                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       SERIALNO,
                       JOBTYPECODE,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       RATE,
                       RATEMEASURINGUNITCODE,
                       AMOUNT,
                       FOOTERAMOUNT,
                       TOTALAMOUNT,
                       JOBORDERTNO,
                       ROUNDING,
                       TAXRULECODE,
                       REMARK,
                       'FD' as FD,
                       GetMeasuringUnitNameFromItem(:ITEMCODE) as Unit1,
                       GetMeasuringUnit2NameFromItem(:ITEMCODE) as Unit2,
                       'INV' as INV,
                       'GRN' as GRN,
                       'PRD' as PRD
                  from JOBBILLDETAIL
                  where tno = :P213_TNO
                ```
