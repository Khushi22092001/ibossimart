                  if not seen_heads.exists(old_rows(k).footerheadcode) then delete from JOBBILLDETAILFOOTER where tno=v_tno and sno=v_sno and footerheadcode=old_rows(k).footerheadcode;seen_heads(old_rows(k).footerheadcode):=true;end if;
