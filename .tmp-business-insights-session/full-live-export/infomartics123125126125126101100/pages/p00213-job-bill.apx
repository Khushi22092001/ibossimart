                sqlQuery: select productionno , tno from (select * from PRODUCTION where COMPANYCODE=(select IMART_REFERENCE_SCOPE.company_code(:P213_TNO,:P213_COMPANYCODE) from dual)) PRODUCTION
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: PRODUCTIONTNO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SNO (
            type: numberField
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TNO (
            type: numberField
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: JOBBILLJOBPRODUCTIONDETAIL
        }
    )

