    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                declare l_rows number;begin
                 if :APEX$ROW_STATUS='C' then :TNO:=:P213_TNO;
                 elsif :APEX$ROW_STATUS in('U','D') then
                 if nvl(:TNO,:P213_TNO)<>:P213_TNO then raise_application_error(-20074,'Detail row belongs to a different document');end if;
                 select count(*) into l_rows from JOBBILLDETAIL where tno=:P213_TNO and sno=:SNO;
                 if l_rows<>1 then raise_application_error(-20074,'Detail row is missing or duplicated; the save was blocked');end if;
                 end if;
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then :TNO:=:P213_TNO;if :SNO is null then :SNO:=globaltno.nextval;end if;declare own_count number;begin select count(*) into own_count from JOBBILLDETAIL where sno=:SNO;if own_count<>0 then raise_application_error(-20074,'New detail identity already exists');end if;end;
                            Insert Into JOBBILLDETAIL (                 
                                    TNO,
                                    SNO,
                                    SERIALNO,
                                    JOBTYPECODE,
                                    ITEMCODE,
                                    ITEMSPECIFICATIONCODE,
                                    DESCRIPTION,
                                    QUANTITY1,
                                    QUANTITY2,
                                    RATE,
                                    RATEMEASURINGUNITCODE,
                                    AMOUNT,
                                    FOOTERAMOUNT,
                                    TOTALAMOUNT,
                                    JOBORDERTNO,
                                    ROUNDING,
                                    TAXRULECODE,
                                    REMARK
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :SERIALNO,
                                :JOBTYPECODE,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :DESCRIPTION,
                                :QUANTITY1,
                                :QUANTITY2,
                                :RATE,
                                :RATEMEASURINGUNITCODE,
                                :AMOUNT,
                                :FOOTERAMOUNT,
                                :TOTALAMOUNT,
                                :JOBORDERTNO,
                                :ROUNDING,
                                :TAXRULECODE,
                                :REMARK
                
                            ) returning rowid into :ROWID;
                 when 'U' then
                            update JOBBILLDETAIL Set
                                  TNO=:TNO,
                                SNO=:SNO,
                                SERIALNO=:SERIALNO,
                                JOBTYPECODE=:JOBTYPECODE,
                                ITEMCODE=:ITEMCODE,
                                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                DESCRIPTION=:DESCRIPTION,
                                QUANTITY1=:QUANTITY1,
                                QUANTITY2=:QUANTITY2,
                                RATE=:RATE,
                                RATEMEASURINGUNITCODE=:RATEMEASURINGUNITCODE,
                                AMOUNT=:AMOUNT,
                                FOOTERAMOUNT=:FOOTERAMOUNT,
                                TOTALAMOUNT=:TOTALAMOUNT,
                                JOBORDERTNO=:JOBORDERTNO,
                                ROUNDING=:ROUNDING,
                                TAXRULECODE=:TAXRULECODE,
                                REMARK=:REMARK
                
                
                            WHERE TNO = :P213_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From JOBBILLDETAIL
                            Where TNo = :P213_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 10868414733598104
        }
    )

