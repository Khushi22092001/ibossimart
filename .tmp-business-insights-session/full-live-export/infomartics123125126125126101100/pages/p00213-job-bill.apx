    process p213-footer-calculate (
        name: P213_FOOTER_CALCULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare j json_object_t:=json_object_t.parse(apex_application.g_x01);code varchar2(30):=upper(trim(j.get_string('legend')));base_amount number:=j.get_number('amount');percent number:=j.get_number('percent');quantity number:=j.get_number('quantity');v number:=j.get_number('value');begin
                case code when 'PAA' then v:=round(abs(base_amount*percent/100),2);when 'PAD' then v:=-round(abs(base_amount*percent/100),2);when 'PRA' then v:=round(abs(base_amount*percent/100),0);when 'PRD' then v:=-round(abs(base_amount*percent/100),0);when 'OQA' then if quantity is null then raise_application_error(-20074,'Owning service quantity is missing');end if;v:=abs(quantity*percent);when 'OQD' then if quantity is null then raise_application_error(-20074,'Owning service quantity is missing');end if;v:=-abs(quantity*percent);when 'LSA' then v:=abs(v);when 'LSD' then v:=-abs(v);else null;end case;apex_json.open_object;apex_json.write('value',v);apex_json.close_object;end;
                ```
        }
        execution {
            sequence: 0
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99021320260929053
        }
    )

