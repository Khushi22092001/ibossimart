    region payment-behaviour (
        name: Payment Behaviour
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Behaviour is measured from ALLOCATIONS, because only an allocation
                   records which bill a payment actually settled. Where a vendor's
                   payments are unallocated - the normal state in this ledger - the
                   measure says so rather than inventing a lag from payment dates.
                   On the AP side the bill is the Cr line and the payment the Dr. */
                With Asof As (Select to_date(:P923_TODATE,'DD-MM-RRRR') D From dual),
                     Pay As (
                       Select cv.VoucherDate BillDate, dv.VoucherDate PayDate,
                              dv.VoucherDate - cv.VoucherDate Lag, a.Amount Amt
                         From DrCrAllocation a
                         Join Voucher dv On dv.Tno = a.DrVoucherTno
                         Join Voucher cv On cv.Tno = a.CrVoucherTno
                         Join VoucherDetail cd On cd.Tno = a.CrVoucherTno And cd.Sno = a.CrVoucherSno
                         Cross Join Asof
                        Where cd.AccountCode = :P923_PARTY
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D),
                     R As (
                       Select Count(*) N, nvl(Sum(-d.Amount),0) Amt,
                              Count(Case When Not Exists (
                                     Select 1 From DrCrAllocation a
                                      Where a.DrVoucherTno = d.Tno And a.DrVoucherSno = d.Sno) Then 1 End) Unalloc
                         From VoucherDetail d Join Voucher v On v.Tno = d.Tno Cross Join Asof
                        Where d.AccountCode = :P923_PARTY
                          And v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT')
                          And d.Amount < 0
                          And d.VoucherDate <= Asof.D)
                Select Ord, Metric, Val, Note From (
                  Select 10 Ord, 'Settlements observed' Metric, to_char(Count(*),'FM999G990') Val,
                         'allocation rows linking a payment to a bill' Note From Pay
                  Union All
                  Select 20, 'Average days to settle',
                         nvl(to_char(Round(Avg(Lag),0),'FM999G990'),'&mdash;'),
                         'bill date to the date of the payment that settled it' From Pay
                  Union All
                  Select 30, 'Weighted days to settle',
                         nvl(to_char(Round(Sum(Lag * Amt) / Nullif(Sum(Amt),0),0),'FM999G990'),'&mdash;'),
                         'weighted by amount, so a large late bill counts more than a small prompt one' From Pay
                  Union All
                  Select 40, 'Fastest / slowest settlement',
                         nvl(to_char(Min(Lag),'FM999G990'),'&mdash;') || ' / ' || nvl(to_char(Max(Lag),'FM999G990'),'&mdash;'),
                         'days' From Pay
                  Union All
                  Select 50, 'Payments made', to_char(r.N,'FM999G990'),
                         'total payment lines to this vendor up to the As-of Date' From R r
                  Union All
                  Select 60, 'Payments never allocated',
                         to_char(r.Unalloc,'FM999G990')
                         || Case When r.N > 0 Then ' (' || to_char(Round(100 * r.Unalloc / r.N,0),'FM990') || '%)' End,
                         'cash paid but never applied to a bill - behaviour cannot be measured for these' From R r
                ) Order By Ord
                ```
            pageItemsToSubmit: [
                P923_PARTY
                P923_TODATE
            ]
        }
        layout {
            sequence: 27
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
