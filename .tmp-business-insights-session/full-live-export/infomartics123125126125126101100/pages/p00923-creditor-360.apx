    process download-supplier-statement-xls (
        name: Download Supplier Statement Excel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                /* A native SpreadsheetML statement.  Values come from the same
                   AP voucher and allocation layer used by this Creditor 360 page. */
                Declare
                    lFrom        Date := to_date(:P923_FROMDATE,'DD-MM-RRRR');
                    lTo          Date := to_date(:P923_TODATE,'DD-MM-RRRR');
                    lParty       Varchar2(100) := :P923_PARTY;
                    lPartyName   Varchar2(500);
                    lOpening     Number := 0;
                    lBills       Number := 0;
                    lPayments    Number := 0;
                    lClosing     Number := 0;
                    lOpenBills   Number := 0;
                    lAdvances    Number := 0;
                    lOpenRows    Number := 0;
                    lPaymentRows Number := 0;
                
                    Procedure TextCell(pValue Varchar2, pStyle Varchar2 Default 'Text') Is
                    Begin
                        htp.prn('<Cell ss:StyleID="'||pStyle||'"><Data ss:Type="String">'||apex_escape.html(nvl(pValue,''))||'</Data></Cell>');
                    End;
                    Procedure NumCell(pValue Number, pStyle Varchar2 Default 'Number') Is
                    Begin
                        htp.prn('<Cell ss:StyleID="'||pStyle||'"><Data ss:Type="Number">');
                        If pValue Is Not Null Then
                            htp.prn(to_char(pValue,'FM9999999999999990D00','NLS_NUMERIC_CHARACTERS=''.,'''));
                        End If;
                        htp.prn('</Data></Cell>');
                    End;
                    Procedure BlankCells(pCount PLS_INTEGER, pStyle Varchar2 Default 'Text') Is
                    Begin
                        For i In 1..pCount Loop TextCell(null,pStyle); End Loop;
                    End;
                    Procedure SheetStart(pName Varchar2, pTitle Varchar2, pSpan PLS_INTEGER) Is
                    Begin
                        htp.prn('<Worksheet ss:Name="'||apex_escape.html(pName)||'"><Table>');
                        htp.prn('<Row ss:Height="24"><Cell ss:StyleID="Title" ss:MergeAcross="'||(pSpan-1)||'"><Data ss:Type="String">AMBIKAH PARBOILED PRODUCTS PRIVATE LIMITED</Data></Cell></Row>');
                        htp.prn('<Row ss:Height="20"><Cell ss:StyleID="SubTitle" ss:MergeAcross="'||(pSpan-1)||'"><Data ss:Type="String">'||apex_escape.html(upper(pTitle))||'</Data></Cell></Row>');
                        htp.prn('<Row><Cell ss:StyleID="Context" ss:MergeAcross="'||(pSpan-1)||'"><Data ss:Type="String">'||apex_escape.html(lPartyName||'  |  Period: '||to_char(lFrom,'DD-MM-RRRR')||' to '||to_char(lTo,'DD-MM-RRRR')||'  |  Company: '||Case When :P923_COMPANY Is Null Then 'All' Else to_char(:P923_COMPANY) End)||'</Data></Cell></Row>');
                    End;
                    Procedure SheetEnd Is
                    Begin
                        htp.prn('</Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>4</SplitHorizontal><TopRowBottomPane>4</TopRowBottomPane><PageSetup><Layout x:Orientation="Landscape"/></PageSetup><Print><FitWidth>1</FitWidth><FitHeight>0</FitHeight></Print></WorksheetOptions></Worksheet>');
                    End;
                Begin
                    If lParty Is Null Then
                        raise_application_error(-20001,'Select a vendor before downloading the supplier statement.');
                    End If;
                    Select nvl(Max(PartyName),lParty) Into lPartyName From Party Where PartyCode=lParty;
                
                    With Asof As (Select lTo D From dual),
                         Alc As (
                           Select a.DrVoucherTno Tno,a.DrVoucherSno Sno,-Sum(a.Amount) Amt
                             From DrCrAllocation a Join Voucher dv On dv.Tno=a.DrVoucherTno Join Voucher cv On cv.Tno=a.CrVoucherTno Cross Join Asof
                            Where dv.VoucherDate<=Asof.D And cv.VoucherDate<=Asof.D Group By a.DrVoucherTno,a.DrVoucherSno
                           Union All
                           Select a.CrVoucherTno,a.CrVoucherSno,Sum(a.Amount)
                             From DrCrAllocation a Join Voucher dv On dv.Tno=a.DrVoucherTno Join Voucher cv On cv.Tno=a.CrVoucherTno Cross Join Asof
                            Where dv.VoucherDate<=Asof.D And cv.VoucherDate<=Asof.D Group By a.CrVoucherTno,a.CrVoucherSno),
                         Al As (Select Tno,Sno,Sum(Amt) Amt From Alc Group By Tno,Sno)
                    Select nvl(Sum(Case When d.VoucherDate<lFrom Then d.Amount Else 0 End),0),
                           nvl(Sum(Case When d.VoucherDate>=lFrom And d.VoucherDate<lTo+1 And d.Amount>0 Then d.Amount Else 0 End),0),
                           nvl(Sum(Case When d.VoucherDate>=lFrom And d.VoucherDate<lTo+1 And v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT') And d.Amount<0 Then -d.Amount Else 0 End),0),
                           nvl(Sum(d.Amount),0),
                           nvl(Sum(Greatest(d.Amount-nvl(al.Amt,0),0)),0),
                           nvl(Sum(-Least(d.Amount-nvl(al.Amt,0),0)),0)
                      Into lOpening,lBills,lPayments,lClosing,lOpenBills,lAdvances
                      From VoucherDetail d Join Voucher v On v.Tno=d.Tno Left Join Al al On al.Tno=d.Tno And al.Sno=d.Sno
                     Where d.AccountCode=lParty And d.VoucherDate<=lTo
                       And (cast(null as varchar2(100)) Is Null Or cast(null as varchar2(100))=cast(null as varchar2(100)))
                       And (null Is Null Or cast(null as varchar2(100))=null)
                       And (:P923_COMPANY Is Null Or d.CompanyCode=:P923_COMPANY)
                       And (:P923_LOCATION Is Null Or d.LocationCode=:P923_LOCATION);
                
                    owa_util.mime_header('application/vnd.ms-excel',false);
                    htp.p('Content-Disposition: attachment; filename="supplier-statement-'||to_char(sysdate,'YYYYMMDD-HH24MISS')||'.xml"');
                    owa_util.http_header_close();
                    htp.prn('<?xml version="1.0"?><Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:x="urn:schemas-microsoft-com:office:excel"><Styles><Style ss:ID="Title"><Font ss:FontName="Calibri" ss:Size="15" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#7C2D12" ss:Pattern="Solid"/></Style><Style ss:ID="SubTitle"><Font ss:FontName="Calibri" ss:Size="12" ss:Bold="1" ss:Color="#431407"/><Interior ss:Color="#FDBA74" ss:Pattern="Solid"/></Style><Style ss:ID="Context"><Font ss:FontName="Calibri" ss:Size="9" ss:Color="#4A2A1A"/><Interior ss:Color="#FFF7ED" ss:Pattern="Solid"/></Style><Style ss:ID="Header"><Font ss:FontName="Calibri" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#C2410C" ss:Pattern="Solid"/><Alignment ss:Horizontal="Center"/></Style><Style ss:ID="Text"><Font ss:FontName="Calibri" ss:Size="10"/><Alignment ss:Vertical="Top"/></Style><Style ss:ID="Number"><Font ss:FontName="Calibri" ss:Size="10"/><NumberFormat ss:Format="#\\,##0.00"/><Alignment ss:Horizontal="Right"/></Style><Style ss:ID="Total"><Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1"/><Interior ss:Color="#FFEDD5" ss:Pattern="Solid"/><NumberFormat ss:Format="#\\,##0.00"/><Alignment ss:Horizontal="Right"/></Style></Styles>');
                
                    SheetStart('Summary','Supplier Statement of Account',6);
                    htp.prn('<Row>'); TextCell('Particulars','Header'); TextCell('Amount (₹)','Header'); TextCell('Particulars','Header'); TextCell('Amount (₹)','Header'); TextCell('As-of Position','Header'); TextCell('Amount (₹)','Header'); htp.prn('</Row>');
                    htp.prn('<Row>'); TextCell('Opening payable'); NumCell(lOpening); TextCell('Bills booked in period'); NumCell(lBills); TextCell('Open payable bills'); NumCell(lOpenBills); htp.prn('</Row>');
                    htp.prn('<Row>'); TextCell('Payments in period'); NumCell(lPayments); TextCell('Closing payable'); NumCell(lClosing); TextCell('Vendor advances / debit'); NumCell(lAdvances); htp.prn('</Row>');
                    htp.prn('<Row>'); TextCell('Statement basis','Total'); TextCell('Voucher + allocation ledger','Total'); TextCell('Confirmation','Total'); TextCell('Please reconcile within 7 days','Total'); TextCell('Balance type','Total'); TextCell(Case When lClosing>0 Then 'Payable' When lClosing<0 Then 'Advance / debit' Else 'Settled' End,'Total'); htp.prn('</Row>');
                    SheetEnd;
                
                    SheetStart('Ledger','Supplier Ledger',8);
                    htp.prn('<Row>'); TextCell('Date','Header'); TextCell('Voucher','Header'); TextCell('Reference','Header'); TextCell('Document Type','Header'); TextCell('Narration','Header'); TextCell('Payment / Debit (₹)','Header'); TextCell('Bill / Credit (₹)','Header'); TextCell('Payable Balance (₹)','Header'); htp.prn('</Row>');
                    htp.prn('<Row>'); TextCell(to_char(lFrom-1,'DD-MM-RRRR')); TextCell('OPENING'); TextCell(''); TextCell('Opening balance'); TextCell('Balance before selected period'); NumCell(Case When lOpening<0 Then -lOpening End); NumCell(Case When lOpening>0 Then lOpening End); NumCell(abs(lOpening)); htp.prn('</Row>');
                    Declare lRun Number:=lOpening; Begin
                      For r In (Select d.VoucherDate,v.VoucherNo,coalesce(pb.PartyBillNo,ao.BillNo,v.VoucherNo) Reference,nvl(v.ModuleCode,v.DocTypeCode) SourceType,substr(d.Narration,1,300) Narration,Case When d.Amount<0 Then -d.Amount Else 0 End Debit,Case When d.Amount>0 Then d.Amount Else 0 End Credit From VoucherDetail d Join Voucher v On v.Tno=d.Tno Left Join PBPass pp On v.ModuleCode='PBPASS' And pp.Tno=v.ModuleTno Left Join PurchaseBill pb On pb.Tno=pp.PurchaseBillTno Left Join AccountOpening ao On v.VoucherNo='OPENING' And ao.Tno=d.ModuleTno Where d.AccountCode=lParty And d.VoucherDate>=lFrom And d.VoucherDate<lTo+1 And (cast(null as varchar2(100)) Is Null Or cast(null as varchar2(100))=cast(null as varchar2(100))) And (null Is Null Or cast(null as varchar2(100))=null) And (:P923_COMPANY Is Null Or d.CompanyCode=:P923_COMPANY) And (:P923_LOCATION Is Null Or d.LocationCode=:P923_LOCATION) Order By d.VoucherDate,d.Tno,d.Sno) Loop
                        lRun:=lRun+nvl(r.Credit,0)-nvl(r.Debit,0); htp.prn('<Row>'); TextCell(to_char(r.VoucherDate,'DD-MM-RRRR')); TextCell(r.VoucherNo); TextCell(r.Reference); TextCell(r.SourceType); TextCell(r.Narration); NumCell(r.Debit); NumCell(r.Credit); NumCell(abs(lRun)); htp.prn('</Row>');
                      End Loop;
                    End;
                    htp.prn('<Row>'); TextCell('Closing balance','Total'); BlankCells(6,'Total'); NumCell(abs(lClosing),'Total'); htp.prn('</Row>'); SheetEnd;
                
                    SheetStart('Pending Bills','Pending Supplier Bills',8);
                    htp.prn('<Row>'); TextCell('Voucher','Header'); TextCell('Bill Reference','Header'); TextCell('Document Date','Header'); TextCell('Due Date','Header'); TextCell('Bill Amount (₹)','Header'); TextCell('Allocated (₹)','Header'); TextCell('Outstanding (₹)','Header'); TextCell('Days Overdue','Header'); htp.prn('</Row>');
                    For r In (With Asof As (Select lTo D From dual),Alc As (Select a.DrVoucherTno Tno,a.DrVoucherSno Sno,-Sum(a.Amount) Amt From DrCrAllocation a Join Voucher dv On dv.Tno=a.DrVoucherTno Join Voucher cv On cv.Tno=a.CrVoucherTno Cross Join Asof Where dv.VoucherDate<=Asof.D And cv.VoucherDate<=Asof.D Group By a.DrVoucherTno,a.DrVoucherSno Union All Select a.CrVoucherTno,a.CrVoucherSno,Sum(a.Amount) From DrCrAllocation a Join Voucher dv On dv.Tno=a.DrVoucherTno Join Voucher cv On cv.Tno=a.CrVoucherTno Cross Join Asof Where dv.VoucherDate<=Asof.D And cv.VoucherDate<=Asof.D Group By a.CrVoucherTno,a.CrVoucherSno),Al As (Select Tno,Sno,Sum(Amt) Amt From Alc Group By Tno,Sno),Pt As (Select pp.Tno,coalesce(Max(pb.PartyBillDate),Max(pb.PurchaseBillDate)) DocDt,Max(pb.PurchaseBillDate)+coalesce(Max(po.CreditDays),Max(pty.CreditDays)) DueDt,Max(pb.PartyBillNo) BillNo From PBPass pp Join PurchaseBill pb On pb.Tno=pp.PurchaseBillTno Left Join PurchaseBillDetail pbd On pbd.Tno=pb.Tno Left Join PurchaseOrder po On po.Tno=pbd.PurchaseOrderTno Left Join Party pty On pty.PartyCode=pb.PartyCode Group By pp.Tno),Jt As (Select jp.Tno,coalesce(Max(jb.PartyBillDate),Max(jb.JobBillDate)) DocDt,Max(jb.JobBillDate)+nvl(Max(jo.CreditDays),0) DueDt From JBPass jp Join JobBill jb On jb.Tno=jp.JobBillTno Left Join JobOrder jo On jo.Tno=jb.JobOrderTno Group By jp.Tno) Select v.VoucherNo,coalesce(pt.BillNo,ao.BillNo,v.VoucherNo) BillRef,coalesce(pt.DocDt,jt.DocDt,ao.BillDate,d.VoucherDate) DocDate,coalesce(pt.DueDt,jt.DueDt,ao.BillDueDate) DueDate,d.Amount BillAmount,nvl(al.Amt,0) Allocated,d.Amount-nvl(al.Amt,0) Outstanding,Case When coalesce(pt.DueDt,jt.DueDt,ao.BillDueDate) Is Not Null Then Greatest(lTo-coalesce(pt.DueDt,jt.DueDt,ao.BillDueDate),0) End DaysOverdue From VoucherDetail d Join Voucher v On v.Tno=d.Tno Left Join Al al On al.Tno=d.Tno And al.Sno=d.Sno Left Join Pt pt On v.ModuleCode='PBPASS' And pt.Tno=v.ModuleTno Left Join Jt jt On v.ModuleCode='JBPASS' And jt.Tno=v.ModuleTno Left Join AccountOpening ao On v.VoucherNo='OPENING' And ao.Tno=d.ModuleTno Where d.AccountCode=lParty And d.VoucherDate<=lTo And d.Amount-nvl(al.Amt,0)>0 And (cast(null as varchar2(100)) Is Null Or cast(null as varchar2(100))=(Select cast(null as varchar2(100)) From dual)) And (null Is Null Or cast(null as varchar2(100))=null) And (:P923_COMPANY Is Null Or d.CompanyCode=:P923_COMPANY) And (:P923_LOCATION Is Null Or d.LocationCode=:P923_LOCATION) Order By DocDate,VoucherNo) Loop
                        lOpenRows:=lOpenRows+1; htp.prn('<Row>'); TextCell(r.VoucherNo); TextCell(r.BillRef); TextCell(to_char(r.DocDate,'DD-MM-RRRR')); TextCell(to_char(r.DueDate,'DD-MM-RRRR')); NumCell(r.BillAmount); NumCell(abs(r.Allocated)); NumCell(r.Outstanding); NumCell(r.DaysOverdue); htp.prn('</Row>');
                    End Loop;
                    htp.prn('<Row>'); TextCell('Total outstanding','Total'); BlankCells(5,'Total'); NumCell(lOpenBills,'Total'); TextCell(to_char(lOpenRows)||' open bills','Total'); htp.prn('</Row>'); SheetEnd;
                
                    SheetStart('Payments','Payments Made',6);
                    htp.prn('<Row>'); TextCell('Date','Header'); TextCell('Payment No','Header'); TextCell('Payment Amount (₹)','Header'); TextCell('Applied (₹)','Header'); TextCell('Unapplied (₹)','Header'); TextCell('Narration','Header'); htp.prn('</Row>');
                    For r In (With Asof As (Select lTo D From dual),Alc As (Select a.DrVoucherTno Tno,a.DrVoucherSno Sno,Sum(a.Amount) Amt From DrCrAllocation a Join Voucher dv On dv.Tno=a.DrVoucherTno Join Voucher cv On cv.Tno=a.CrVoucherTno Cross Join Asof Where dv.VoucherDate<=Asof.D And cv.VoucherDate<=Asof.D Group By a.DrVoucherTno,a.DrVoucherSno) Select d.VoucherDate,v.VoucherNo,-d.Amount PaymentAmount,nvl(al.Amt,0) Applied,-d.Amount-nvl(al.Amt,0) Unapplied,substr(d.Narration,1,300) Narration From VoucherDetail d Join Voucher v On v.Tno=d.Tno Left Join Alc al On al.Tno=d.Tno And al.Sno=d.Sno Where d.AccountCode=lParty And v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT') And d.Amount<0 And d.VoucherDate>=lFrom And d.VoucherDate<lTo+1 And ((Select cast(null as varchar2(100)) From dual) Is Null Or cast(null as varchar2(100))=cast(null as varchar2(100))) And (null Is Null Or cast(null as varchar2(100))=null) And (:P923_COMPANY Is Null Or d.CompanyCode=:P923_COMPANY) And (:P923_LOCATION Is Null Or d.LocationCode=:P923_LOCATION) Order By d.VoucherDate,d.Tno,d.Sno) Loop
                        lPaymentRows:=lPaymentRows+1; htp.prn('<Row>'); TextCell(to_char(r.VoucherDate,'DD-MM-RRRR')); TextCell(r.VoucherNo); NumCell(r.PaymentAmount); NumCell(r.Applied); NumCell(r.Unapplied); TextCell(r.Narration); htp.prn('</Row>');
                    End Loop;
                    htp.prn('<Row>'); TextCell('Payments in selected period','Total'); BlankCells(1,'Total'); NumCell(lPayments,'Total'); BlankCells(2,'Total'); TextCell(to_char(lPaymentRows)||' payment rows','Total'); htp.prn('</Row>'); SheetEnd;
                    htp.prn('</Workbook>');
                    apex_application.stop_apex_engine;
                End;
                ```
        }
