            type: itemIsNotNull
            item: P923_PARTY
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No credit or debit note has been raised on this vendor.
        }

