    region exceptions (
        name: Exceptions and Controls
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* The same control predicates as page 715, narrowed to this vendor.
                   Counts here and counts there are produced from the same expressions,
                   so a reader can move between the two pages without reconciling them. */
                With Asof As (Select to_date(:P923_TODATE,'DD-MM-RRRR') D From dual),
                     Alc As (
                       Select a.DrVoucherTno Tno, a.DrVoucherSno Sno, -Sum(a.Amount) Amt
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                        Group By a.DrVoucherTno, a.DrVoucherSno
                       Union All
                       Select a.CrVoucherTno, a.CrVoucherSno, Sum(a.Amount)
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                        Group By a.CrVoucherTno, a.CrVoucherSno),
                     Al As (Select Tno, Sno, Sum(Amt) Amt From Alc Group By Tno, Sno),
                     Oi As (
                       Select d.CompanyCode Cmp, cast(null as varchar2(100)) Pnl, d.LocationCode Loc, d.VoucherDate Vdt,
                              v.VoucherNo Vno, v.DocTypeCode Dtc,
                              (d.Amount - nvl(al.Amt,0)) Pay,
                              coalesce(pt.DueDt, jt.DueDt, ao.BillDueDate) DueDate,
                              ao.BillDate AoBillDate, ao.BillDueDate AoBillDue
                         From VoucherDetail d
                         Join Voucher v On v.Tno = d.Tno
                         Left Join Al al On al.Tno = d.Tno And al.Sno = d.Sno
                         Left Join (Select pp.Tno Tno,
                                           coalesce(Max(pb.PartyBillDate), Max(pb.PurchaseBillDate)) DocDt,
                                           Max(pb.PurchaseBillDate)
                                             + coalesce(Max(po.CreditDays), Max(pty.CreditDays)) DueDt
                                      From PBPass pp
                                      Join PurchaseBill pb On pb.Tno = pp.PurchaseBillTno
                                      Left Join PurchaseBillDetail pbd On pbd.Tno = pb.Tno
                                      Left Join PurchaseOrder po On po.Tno = pbd.PurchaseOrderTno
                                      Left Join Party pty On pty.PartyCode = pb.PartyCode
                                     Group By pp.Tno) pt On v.ModuleCode = 'PBPASS' And pt.Tno = v.ModuleTno
                         Left Join (Select jp.Tno Tno,
                                           coalesce(Max(jb.PartyBillDate), Max(jb.JobBillDate)) DocDt,
                                           Max(jb.JobBillDate) + nvl(Max(jo.CreditDays),0) DueDt
                                      From JBPass jp
                                      Join JobBill jb On jb.Tno = jp.JobBillTno
                                      Left Join JobOrder jo On jo.Tno = jb.JobOrderTno
                                     Group By jp.Tno) jt On v.ModuleCode = 'JBPASS' And jt.Tno = v.ModuleTno
                         Left Join AccountOpening ao On v.VoucherNo = 'OPENING'   And ao.Tno = d.ModuleTno
                         Cross Join Asof
                        Where d.AccountCode = :P923_PARTY
                          And d.VoucherDate <= Asof.D
                          And (cast(null as varchar2(100)) Is Null
                               Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                          And (null    Is Null Or cast(null as varchar2(100))        = null)
                          And (:P923_COMPANY  Is Null Or d.CompanyCode  = :P923_COMPANY)
                          And (:P923_LOCATION Is Null Or d.LocationCode = :P923_LOCATION))
                Select Code, Nm, Items, Round(Expo,2) Expo From (
                  Select 'AP-B02' Code, 'Open payable that cannot be aged' Nm,
                         Count(*) Items, Sum(Abs(Pay)) Expo
                    From Oi Where Pay > 0.005 And DueDate Is Null Having Count(*) > 0
                  Union All
                  Select 'AP-O01','Opening item, original bill date lost', Count(*), Sum(Abs(Pay))
                    From Oi Where Vno = 'OPENING' And AoBillDate Is Null And Abs(Pay) > 0.005 Having Count(*) > 0
                  Union All
                  Select 'AP-O02','Opening item, original due date lost', Count(*), Sum(Abs(Pay))
                    From Oi Where Vno = 'OPENING' And AoBillDue Is Null And Pay > 0.005 Having Count(*) > 0
                  Union All
                  Select 'AP-P03','Payment cash unapplied over 90 days', Count(*), Sum(-Pay)
                    From Oi Cross Join Asof
                   Where Dtc In ('PAYMENT','CASHPAYMENT','BANKPAYMENT')
                     And Pay < -0.005 And Asof.D - Vdt > 90 Having Count(*) > 0
                  Union All
                  Select 'AP-M01','Posted with incomplete business scope', Count(*), Sum(Abs(Pay))
                    From Oi Where Cmp Is Null Or Loc Is Null Having Count(*) > 0
                  Union All
                  Select 'AP-M02','Posted to a location marked DO NOT USE', Count(*), Sum(Abs(o.Pay))
                    From Oi o Join Location l On l.LocationCode = o.Loc
                   Where upper(l.LocationName) Like '%DO NOT USE%' And Abs(o.Pay) > 0.005 Having Count(*) > 0
                ) Order By Code
                ```
            pageItemsToSubmit: [
                P923_PARTY
                P923_TODATE
                P923_COMPANY
                P923_LOCATION
            ]
        }
        layout {
            sequence: 52
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P923_PARTY
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No control fires on this vendor.
        }

        column CODE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Control
            }
            layout {
                sequence: 10
            }
        )

        column EXPO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Exposure (₹)
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column ITEMS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Items
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column NM (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Exception
            }
            layout {
                sequence: 20
            }
        )

    )

