    region timeline (
        name: Timeline
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* The vendor's last 60 events in plain chronological order. Deliberately
                   capped: a timeline is read from the top and an uncapped one on a busy
                   account is a scrolling exercise, not a narrative. The cap is stated in
                   the region title rather than applied silently. */
                Select * From (
                  Select d.VoucherDate                             As EVENT_DATE,
                         Case When v.VoucherNo = 'OPENING'      Then 'Opening carry-forward'
                              When v.ModuleCode = 'INVOICE'     Then 'Invoice raised'
                              When v.ModuleCode = 'SERVICEBILL' Then 'Service bill raised'
                              When v.ModuleCode = 'CREDITNOTE'  Then 'Credit note issued'
                              When v.ModuleCode = 'DEBITNOTE'   Then 'Debit note issued'
                              When v.ModuleCode = 'PBPASS'      Then 'Purchase from this party (contra)'
                              When v.DocTypeCode = 'RECEIPT'    Then 'Receipt received'
                              When v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT')
                                                                Then 'Payment made to this party'
                              Else 'Journal posting' End         As EVENT,
                         v.VoucherNo                             As VOUCHER_NO,
                         d.Tno                                   As VOUCHER_TNO,
                         Round(Abs(d.Amount),2)                  As AMOUNT,
                         Case When d.Amount < 0 Then 'Increases payable'
                              Else 'Reduces payable' End      As EFFECT,
                         nvl(l.LocationName, d.LocationCode) As LOCATION
                    From VoucherDetail d
                    Join Voucher v On v.Tno = d.Tno
                    Left Join Location l On l.LocationCode = d.LocationCode
                   Where d.AccountCode = :P923_PARTY
                     And d.VoucherDate <= to_date(:P923_TODATE,'DD-MM-RRRR')
                     And (cast(null as varchar2(100)) Is Null
                          Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                     And (null    Is Null Or cast(null as varchar2(100))        = null)
                     And (:P923_COMPANY  Is Null Or d.CompanyCode  = :P923_COMPANY)
                     And (:P923_LOCATION Is Null Or d.LocationCode = :P923_LOCATION)
                   Order By d.VoucherDate Desc, d.Tno Desc)
                 Where rownum <= 60
                ```
            pageItemsToSubmit: [
                P923_PARTY
                P923_TODATE
                P923_COMPANY
                P923_LOCATION
            ]
        }
        layout {
            sequence: 54
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P923_PARTY
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No activity on this vendor up to the As-of Date.
        }

        column AMOUNT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Amount (₹)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

        column EFFECT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Effect
            }
            layout {
                sequence: 60
            }
        )

        column EVENT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Event
            }
            layout {
                sequence: 20
            }
        )

        column EVENT_DATE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Date
            }
            layout {
                sequence: 10
            }
        )

        column LOCATION (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Location
            }
            layout {
                sequence: 70
            }
        )

        column VOUCHER_NO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Voucher
            }
            layout {
                sequence: 30
            }
        )

        column VOUCHER_TNO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Tno
            }
            layout {
                sequence: 40
            }
            serverSideCondition {
                type: never
            }
        )

    )

