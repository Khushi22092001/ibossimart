    htmlHeader {
        htmlHeader:
            ```html
            
            <script id="hspl-sidebar-head-state">
            (function(d){
              var state='closed';
              try {
                var saved=window.localStorage.getItem('imart.sidebar.state.v1');
                if(saved==='open'||saved==='closed') state=saved;
              } catch(ignore) {}
              d.classList.remove(state==='open'?'hspl-nav-target-closed':'hspl-nav-target-open');
              d.classList.add(state==='open'?'hspl-nav-target-open':'hspl-nav-target-closed');
            })(document.documentElement);
            </script>
            ```
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: One vendor, end to end. Open bills, payment history, payment allocations, ageing, advances and the vendor's own debit position, all from the same canonical AP layer as every other page. Regions are separate and lazy-loaded so the browser is not asked to render every dataset at once. Procurement views (orders, receipts, item mix) live on the existing Supplier 360 and Purchase Order 360 pages, which this page links to rather than duplicates. Credit limit and utilisation are absent throughout - Party.CreditAmount is greater than zero on 0 creditor accounts, so there is nothing to measure exposure against.
    }

    region advances (
        name: Advances and Debits Held
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Asof As (Select to_date(:P923_TODATE,'DD-MM-RRRR') D From dual),
                     Alc As (
                       Select a.DrVoucherTno Tno, a.DrVoucherSno Sno, -Sum(a.Amount) Amt
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                        Group By a.DrVoucherTno, a.DrVoucherSno
                       Union All
                       Select a.CrVoucherTno, a.CrVoucherSno, Sum(a.Amount)
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                        Group By a.CrVoucherTno, a.CrVoucherSno),
                     Al As (Select Tno, Sno, Sum(Amt) Amt From Alc Group By Tno, Sno),
                     Oi As (
                       Select (d.Amount - nvl(al.Amt,0)) Pay, d.VoucherDate Vdt,
                              Case When v.VoucherNo = 'OPENING'     Then 'Opening Debit'
                                   When v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT')
                                                                    Then 'Unapplied Payment'
                                   When v.ModuleCode In ('INVOICE','CCINVOICE')
                                     Or v.DocTypeCode = 'SALE'      Then 'Contra Sale'
                                   When v.ModuleCode = 'DEBITNOTE'
                                     Or v.DocTypeCode = 'DEBITNOTE' Then 'Debit Note'
                                   Else 'Other Debit' End Cls
                         From VoucherDetail d
                         Join Voucher v On v.Tno = d.Tno
                         Left Join Al al On al.Tno = d.Tno And al.Sno = d.Sno
                         Cross Join Asof
                        Where d.AccountCode = :P923_PARTY
                          And d.VoucherDate <= Asof.D
                          And (cast(null as varchar2(100)) Is Null
                               Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                          And (null    Is Null Or cast(null as varchar2(100))        = null)
                          And (:P923_COMPANY  Is Null Or d.CompanyCode  = :P923_COMPANY)
                          And (:P923_LOCATION Is Null Or d.LocationCode = :P923_LOCATION))
                Select Cls                                     As CREDIT_TYPE,
                       Count(*)                                As ITEMS,
                       Round(Sum(-Pay),2)                     As AMOUNT,
                       to_char(Min(Vdt),'DD-MM-RRRR')          As OLDEST,
                       Round(Sum(Case When (Select D From Asof) - Vdt > 90 Then -Pay Else 0 End),2) As OVER_90_DAYS
                  From Oi Where Pay < -0.005
                 Group By Cls Order By Sum(-Pay) Desc
                ```
            pageItemsToSubmit: [
                P923_PARTY
                P923_TODATE
                P923_COMPANY
                P923_LOCATION
            ]
        }
