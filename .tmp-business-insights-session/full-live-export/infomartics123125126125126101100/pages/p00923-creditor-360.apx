    region command-header (
        name: Creditor 360
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-ap-head">'
                    || '<div class="ds-ap-eyebrow">Payables &middot; Creditor 360</div>'
                    || '<h1 class="ds-ap-title">'
                       || apex_escape.html(nvl((Select p.PartyName From Party p Where p.PartyCode = :P923_PARTY),
                                               nvl(:P923_PARTY,'No vendor selected'))) || '</h1>'
                    || '<div class="ds-ap-sub">'
                       || Case When :P923_PARTY Is Null Then 'Open this page from Party-wise Outstanding, Bill-wise Outstanding or a chart to load a vendor.'
                               Else 'Complete payable position, debits held, open bills and payment history as at the As-of Date' End
                    || '</div>'
                    || '<div class="ds-ap-context">'
                    || Case When :P923_PARTY Is Not Null Then
                            '<span class="ds-ap-chip"><span class="fa fa-user"></span>Code <b>' || apex_escape.html(:P923_PARTY) || '</b></span>'
                         || nvl('<span class="ds-ap-chip"><span class="fa fa-sitemap"></span>Group <b>'
                            || apex_escape.html((Select g.PartyName From Party p Join Party g On g.PartyCode = p.ParentCode
                                                  Where p.PartyCode = :P923_PARTY)) || '</b></span>','') End
                    || '<span class="ds-ap-chip"><span class="fa fa-crosshairs"></span>Position as at <b>' || :P923_TODATE || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-calendar"></span>Flows <b>'
                       || :P923_FROMDATE || ' &rarr; ' || :P923_TODATE || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-hourglass-half"></span>Ageing basis <b>'
                       || Case When :P923_AGEBASIS = 'DOC' Then 'Document date (age)' Else 'Due date (lateness)' End || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
            pageItemsToSubmit: [
                P923_PARTY
                P923_FROMDATE
                P923_TODATE
                P923_COMPANY
                P923_LOCATION
                P923_AGEBASIS
            ]
        }
