            plsqlCode:
                ```plsql
                If :P702_TNO is null then
                    :P702_TNO := GlobalTNo.nextval;
                    :P702_FORMSTATUS := 'NEWRECORD';
                else
                    
                    :P702_FORMSTATUS := 'EDITRECORD';
                End if;
                
                :P702_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P702_TNO), 'Status');
