            }).fail(function(xhr,status,message){if(epoch===generation&&s.revision===revision){s.pending=false;s.error=true;error('Sales Enquiry calculation failed. Check the selected item/unit and retry the edit. '+(message||status));}}).always(function(){busy=false;pump();});
              }
