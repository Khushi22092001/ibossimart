    dynamicAction set-dfamount (
        name: Set DFAMOUNT
        execution {
            sequence: 570
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail
            columns: AMOUNT
        }
        serverSideCondition {
            type: never
