                window.hsplP702CaptureFd();if(window.hsplP702CancelNativeFd)window.hsplP702CancelNativeFd();window.hsplP702PrepareFdRefresh();apex.item('P702_SNO').setValue(key,null,true);apex.item('P702_DFAMOUNT').setValue(value(r,'AMOUNT'),null,true);if(document.getElementById&&document.getElementById('P702_DFQUANTITY1'))apex.item('P702_DFQUANTITY1').setValue(value(r,'QUANTITY1'),null,true);var region=apex.region('FooterDetail');openModal('FooterDetail');region.element.css('visibility','');region.element.find('.a-IG,.hspl-live-total-dock,.hspl-relocated-grid-footer').css('visibility','');window.hsplP702RestoreFd();return true;}
              var nativeFd=window.hsplO2cInlineFd;
              window.hsplO2cInlineFd=function(anchor,event){if(event)event.preventDefault();var currentFooter=grid('FooterDetail');if(invalidEditor()||currentFooter&&currentFooter.model.hsplFooterBlocked&&currentFooter.model.hsplFooterBlocked()){error('Resolve the current numeric or FD calculation before switching rows.');return false;}var v=grid('Detail'),r;try{r=v.getContextRecord(anchor)[0];}catch(ignore){}if(!r)return nativeFd(anchor,event);var id=v.model.getRecordId(r);if((!model.allowEdit||model.allowEdit(r))&&footerEdits[String(value(r,'SNO'))]===undefined)schedule(r,'FD');var s=rows[id],seq=++fdSequence;if(!s||!s.pending){if(s&&s.error){error('Resolve this row calculation error before opening FD.');return false;}if(openCached(anchor,event,r))return false;return nativeFd(anchor,event);}
                var region=apex.region('FooterDetail');region.element.css('visibility','hidden');openModal('FooterDetail');var spinner=apex.util.showSpinner(region.element);spinner.css('visibility','visible');var deadline=Date.now()+10000;
                (function wait(){if(seq!==fdSequence){spinner.remove();return;}if(s.error){spinner.remove();apex.theme.closeRegion('FooterDetail');error('Resolve this row calculation error before opening FD.');return;}if(!s.pending){spinner.remove();if(!openCached(anchor,event,r))nativeFd(anchor,event);return;}if(Date.now()>deadline){spinner.remove();apex.theme.closeRegion('FooterDetail');error('Row calculation is still running. Retry FD after it finishes.');return;}setTimeout(wait,25);})();return false;
