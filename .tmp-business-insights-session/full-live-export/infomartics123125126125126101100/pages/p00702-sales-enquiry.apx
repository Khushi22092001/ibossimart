    pageItem P702_AGENTCODE (
        type: popupLov
        label {
            label: Agent
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName as AgentName,
                a.PartyCode as AgentCode
                from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) a
                where a.PartyTypeCode = 'AGENT'
                and GetDocumentStatusCode('PARTY', A.TNO) = 'ACTIVE'
                And Exists (Select 1
                      From partycompany aa
                     Where aa.tno = a.tno
                       And aa.companycode = :GLOBAL_COMPANYCODE)
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 670
            region: @general-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
