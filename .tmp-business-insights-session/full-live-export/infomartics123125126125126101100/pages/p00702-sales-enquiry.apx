    dynamicAction insert-into-tac (
        name: Insert into tac
        execution {
            sequence: 920
        }
        when {
            event: click
            selectionType: button
            button: @getdefault
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from salesenquirytac where tno = :P702_TNO;
                    insert into salesenquirytac
                    (
                        TNO, 
                        SNO, 
                        TERMSANDCONDITIONHEADCODE, 
                        TERMSANDCONDITION
                    )
                    (
                        SELECT
                            :P702_TNO,
                            globaltno.nextval,
                            termsandconditionheadcode,
                            termsandconditionvalue
                        FROM
                            moduledoctypewisetacdetail
                        WHERE
                            tno IN (
                                SELECT
                                    tno
                                FROM
                                    moduledoctypewisetac
                                WHERE
                                        modulecode = getModuleCodeForPageNo(:APP_PAGE_ID)
                                    AND doctypecode = :P702_DOCTYPECODE
                            )
                    );
                    
                    ```
                itemsToSubmit: [
                    P702_TNO
                    P702_DOCTYPECODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @terms-and-conditions
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

