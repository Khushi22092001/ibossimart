    pageItem P702_CONSIGNEECODE (
        type: popupLov
        label {
            label: Consignee
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select partyname , partycode from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) a
                where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
                and partytypecode in ('CUSTOMER','AGENT')
                and :P702_DOCTYPECODE = 'SALE'
                And Exists (Select 1
                      From partycompany aa
                     Where aa.tno = a.tno
                       And aa.companycode = :GLOBAL_COMPANYCODE)
                union all   
                select partyname , partycode from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) a
                where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
                and partytypecode in ('SUPPLIER','AGENT')
                and :P702_DOCTYPECODE = 'PURCHASERETURN'
                And Exists (Select 1
                      From partycompany aa
                     Where aa.tno = a.tno
                       And aa.companycode = :GLOBAL_COMPANYCODE)
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P702_DOCTYPECODE
            itemsToSubmit: P702_DOCTYPECODE
        }
        layout {
            sequence: 80
            region: @general-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @general
            column: CONSIGNEECODE
            dataType: varchar2
        }
    )

