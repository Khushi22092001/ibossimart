                            where moduletno = :P702_TNO
                        ) loop
                            :P702_ENQUIRYTNO := vEnq.tno;
                            :P702_ENQUIRYNO  := vEnq.EnquiryNO;
                        end loop;
                    
                    end;
                    ```
