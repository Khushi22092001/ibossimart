              window.hsplP702PrepareFdRefresh=function(){var f=grid('FooterDetail');if(f&&f.model.clearChanges){restoringFooter=true;try{f.model.clearChanges();}finally{restoringFooter=false;}}};
              window.hsplP702RestoreFd=function(){bindFooter();var f=grid('FooterDetail'),sno=String(apex.item('P702_SNO').getValue()),saved=footerEdits[sno];if(!f||!saved)return;if(f.model.allowEdit&&f.model.getTotalRecords()>0){var first;f.model.forEach(function(r,i,id){if(!first&&!(f.model.getRecordMetadata(id)||{}).agg)first=r;});if(first&&!f.model.allowEdit(first))return;}
                var m=f.model,existing={},remove=[];m.forEach(function(r,i,id){var meta=m.getRecordMetadata(id)||{};if(!meta.agg&&!meta.deleted)existing[String(raw(m.getValue(r,'SN')))]=r;});
                restoringFooter=true;try{
                  saved.forEach(function(line){var r=existing[String(line.SN)];if(r)delete existing[String(line.SN)];else r=m.getRecord(m.insertNewRecord());footerFields.forEach(function(field){if(field==='ROWID')return;var value=line[field];if(String(raw(m.getValue(r,field))||'')!==String(value||''))m.setValue(r,field,value==null?'':String(value));});if(line.ROWID)footerOwnerKeys.set(r,line.ROWID);});
                  Object.keys(existing).forEach(function(key){remove.push(existing[key]);});if(remove.length)m.deleteRecords(remove);
                }finally{restoringFooter=false;}if(m.clearChanges){restoringFooter=true;try{m.clearChanges();}finally{restoringFooter=false;}}setTimeout(syncFooter,0);
              };
