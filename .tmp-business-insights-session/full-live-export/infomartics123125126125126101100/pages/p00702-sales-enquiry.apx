    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 130
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: item=value
            item: P702_FORMSTATUS
            value: NEWRECORD
        }
    )

    button createindentandenquiry (
        buttonName: CreateIndentAndEnquiry
        label: Create Indent & Enquiry
        layout {
            sequence: 720
            region: @general-2
            slot: regionBody
            column: 7
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 700
                clearCache: 700
            }
            warnOnUnsavedChanges: doNotCheck
        }
