    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                declare l_rows number;l_sno number;begin
                 if :APEX$ROW_STATUS='C' then :TNO:=:P702_TNO;
                 elsif :APEX$ROW_STATUS in('U','D') then
                 if nvl(:TNO,:P702_TNO)<>:P702_TNO then raise_application_error(-20074,'Detail row belongs to a different document');end if;
                 select count(*) into l_rows from SALESENQUIRYDETAIL where tno=:P702_TNO and rowid=:ROWID;
                 if l_rows<>1 then raise_application_error(-20074,'Detail row is missing or duplicated; the save was blocked');end if;
                 select sno into l_sno from SALESENQUIRYDETAIL where tno=:P702_TNO and rowid=:ROWID;
                 if l_sno is null then raise_application_error(-20074,'Stored detail identity is missing; review this line');end if;
                 if :SNO is not null and :SNO<>l_sno then raise_application_error(-20074,'Detail identity changed; reopen this line');end if;
                 :SNO:=l_sno;:TNO:=:P702_TNO;
                 end if;
                Begin
                    if :ITEMCODE is not null then
                    case :APEX$ROW_STATUS
                        when 'C' then
                 :TNO:=:P702_TNO;if :SNO is null then select globaltno.nextval into :SNO from dual;end if;
                 select count(*) into l_rows from SALESENQUIRYDETAIL where sno=:SNO;
                 if l_rows<>0 then raise_application_error(-20074,'A new detail line cannot reuse an existing identity');end if;
                            Insert Into salesenquirydetail (                 
                                    tno                    ,
                                    sno                    ,
                                    itemcode               ,
                                    itemspecificationcode  ,
                                    description            ,
                                    quantity1              ,
                                    quantity2              ,
                                    ratemeasuringunitcode  ,
                                    
                                  
                                    rate                   ,
                                    amount                 ,
                                    footeramount           ,
                                    totalamount            ,
                                    remark                 ,
                                    lowertolerancepercent  ,
                                    highertolerancepercent 
                                     
                                    --taxrulecode            
                            )
                            Values (
                                :tno                    ,
                                :sno                    ,
                                :itemcode               ,
                                :itemspecificationcode  ,
                                :description            ,
                                :quantity1              ,
                                :quantity2              ,
                                :ratemeasuringunitcode  ,
                              
                             
                                :rate                   ,
                                :amount                 ,
                                :footeramount           ,
                                :totalamount            ,
                                :remark                 ,
                                :lowertolerancepercent  ,
                                :highertolerancepercent 
                                   
                                  
                            );
                        
                        when 'U' then
                            update salesenquirydetail Set
                                    tno                     =		:tno                    ,
                                    sno                     =		:sno                    ,
                                    itemcode                =		:itemcode               ,
                                    itemspecificationcode   =		:itemspecificationcode  ,
                                    description             =		:description            ,
                                    quantity1               =		:quantity1              ,
                                    quantity2               =		:quantity2              ,
                                    ratemeasuringunitcode   =		:ratemeasuringunitcode  ,
                                
                                    rate                    =		:rate                   ,
                                    amount                  =		:amount                 ,
                                    footeramount            =		:footeramount           ,
                                    totalamount             =		:totalamount            ,
                                    remark                  =		:remark                 ,
                                    lowertolerancepercent   =		:lowertolerancepercent  ,
                                    highertolerancepercent  =		:highertolerancepercent 
                                  
                            WHERE TNO = :P702_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From salesenquirydetail
                            Where TNo = :P702_TNO
                              and SNO = :SNO
                              ;
                    end case;
                    end if;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 8662045761502218
        }
    )

