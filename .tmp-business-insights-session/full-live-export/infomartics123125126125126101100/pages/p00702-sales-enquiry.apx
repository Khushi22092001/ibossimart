            /* Native editable FD; explicit clicked-row keys and one refresh path. */
            (function(config){
              "use strict";
              var token=0,cacheKey="",activeSpinner;
              function raw(v){return v&&typeof v==="object"&&"v" in v?v.v:v;}
              function number(v){var n=Number(String(raw(v)||0).replace(/,/g,""));return Number.isFinite(n)?n:0;}
              function view(id){try{var r=apex.region(id),v=r&&r.widget().interactiveGrid("getViews","grid");return v&&v.model?{r:r,v:v,m:v.model}:null;}catch(e){return null;}}
              function records(m,fn){m.forEach(function(r,i,id){var meta=m.getRecordMetadata(id)||{};if(!meta.agg&&!meta.deleted)fn(r);});}
              function footerMatches(f,tno,sno){var count=0,owns=true;if(!f)return false;records(f.m,function(r){count++;if(String(raw(f.m.getValue(r,"TNO")))!==String(tno)||String(raw(f.m.getValue(r,"SNO")))!==String(sno))owns=false;});return count>0&&owns;}
              window.hsplP702CancelNativeFd=function(){token++;if(activeSpinner)activeSpinner.remove();};
              window.hsplO2cInlineFd=function(anchor,event){
                if(event)event.preventDefault();var pendingFooter=view(config.footer);if(pendingFooter&&pendingFooter.m.hsplFooterBlocked&&pendingFooter.m.hsplFooterBlocked()){apex.message.showErrors([{type:'error',location:'page',message:'Wait for the current FD calculation before switching rows.',unsafe:false}]);return false;}if(window.hsplP702CaptureFd)window.hsplP702CaptureFd();if(activeSpinner)activeSpinner.remove();var current=++token,b=view(config.detail),rec;
                try{var context=b&&b.v.getContextRecord(anchor);rec=context&&context[0];}catch(ignore){}
                if(!rec&&b){var row=anchor&&anchor.closest("tr[data-id]");rec=row&&b.m.getRecord(row.getAttribute("data-id"));}
                function error(message){apex.message.showErrors([{type:"error",location:"page",message:message,unsafe:false}]);}
                if(!rec){error("The clicked detail row is unavailable. Retry its FD button.");return false;}
                var tno=raw(b.m.getValue(rec,"TNO")),sno=raw(b.m.getValue(rec,"SNO")),amount=number(b.m.getValue(rec,"AMOUNT"));
                if(!tno||!sno){error("The clicked detail row has no document/row identity.");return false;}
                // These are the SQL predicates of this form's existing native FD region.
                apex.item(config.tno).setValue(tno,null,true);apex.item(config.sno).setValue(sno,null,true);
                apex.item(config.amount).setValue(amount,null,true);var q=document.getElementById('P702_DFQUANTITY1');if(q)apex.item(q.id).setValue(number(b.m.getValue(rec,'QUANTITY1')),null,true);
                if(b.v.setSelectedRecords)b.v.setSelectedRecords([rec],false,true);
                var key=[tno,sno,amount,raw(b.m.getValue(rec,"QUANTITY1")),raw(b.m.getValue(rec,"QUANTITY2")),raw(b.m.getValue(rec,"RATE"))].concat(["PARTYCODE","TRANSACTIONTYPECODE"].map(function(name){var node=document.getElementById("P"+config.page+"_"+name);return node?node.value:"";})).join("|"),f=view(config.footer),region=apex.region(config.footer),spinner,mask;
                /* O2C_FD_FETCH_COMPLETION_V3: native refresh can reuse its existing model. */
                var refreshObservers=[];function watchFetch(f){if(!f||refreshObservers.some(function(x){return x.model===f.m;}))return;var id=f.m.subscribe({onChange:function(type){if(current===token&&requested&&type==='addData')loaded=true;}});refreshObservers.push({model:f.m,id:id});}function finishFetch(){refreshObservers.forEach(function(x){if(x.model.unSubscribe)x.model.unSubscribe(x.id);});refreshObservers=[];}
                function hide(){if(current!==token)return;region.element.css("visibility","hidden");mask=region.element.find(".a-IG,.hspl-live-total-dock,.hspl-relocated-grid-footer");mask.css("visibility","hidden");}
                function show(){if(current!==token)return;finishFetch();if(window.hsplP702RestoreFd)window.hsplP702RestoreFd();region.element.css("visibility","");region.element.find(".a-IG,.hspl-live-total-dock,.hspl-relocated-grid-footer").css("visibility","");if(spinner)spinner.remove();cacheKey=key;try{region.widget().interactiveGrid("resize");}catch(ignore){}}
                hide();openModal(config.name);spinner=apex.util.showSpinner(region.element);spinner.css("visibility","visible");activeSpinner=spinner;
                if(cacheKey===key&&f&&(footerMatches(f,tno,sno)||f.m.getTotalRecords()===0)){setTimeout(show,0);return false;}
                var deadline=Date.now()+8000,requested=false,loaded=false,prior=f&&f.m;region.element.one("apexafterrefresh.o2cFd",function(){if(current===token)loaded=true;});
