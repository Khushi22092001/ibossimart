                    begin
                        for vInd in (
                            select tno,indentno from indent
                            where moduletno = :P702_TNO
                        ) loop
                            :P702_INDENTTNO := vInd.tno;
                            :P702_INDENTNO  := vInd.INDENTNO;
                        end loop;
                        for vEnq in (
