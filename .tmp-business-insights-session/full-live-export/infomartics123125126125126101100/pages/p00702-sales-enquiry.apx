    region attachment (
        name: Attachment
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       --A.SNO,
                       --DESCRIPTION,
                       A.ATTRIBUTEVALUE,
                       A.ATTACHMENTBLOB,
                       A.FILENAME,
                       A.ATTRIBUTECODE,
                       A.MODULETNO,
                       A.MODULESNO,
                       b.PARTYATTRIBUTEname
                  from MODULEATTACHMENT A, partyattribute b
                  WHERE A.MODULETNO = :P702_TNO
                  and a.ATTRIBUTECODE = b.PARTYATTRIBUTECODE
                ```
            pageItemsToSubmit: P702_TNO
        }
