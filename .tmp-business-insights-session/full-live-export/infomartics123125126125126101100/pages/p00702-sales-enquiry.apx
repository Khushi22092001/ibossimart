    pageItem P702_PARTYFORENQUIRY (
        type: popupLov
        label {
            label: Party For Enquiry
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select VENDORNAME , VENDORCODE from (select v.* from VENDOR v where exists(select 1 from PARTY p join PARTYCOMPANY c on c.TNO=p.TNO where p.PARTYCODE=v.VENDORCODE and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) A, DOCUMENTSTATUSDETAIL B
                WHERE NVL(GETMYPARAMETERVALUE('VENDORAPPLICABLEINPURCHASE'),'NO')= 'YES'
                AND A.TNO = B.MODULETNO(+)
                AND B.DOCUMENTSTATUSCODE='ACTIVE'
                UNION ALL
                select PARTYNAME , PARTYCODE from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) PARTY WHERE NVL(GETMYPARAMETERVALUE('VENDORAPPLICABLEINPURCHASE'),'NO')= 'NO'
                AND getdocumentstatuscode('PARTY',TNO)='ACTIVE'
                and partytypecode='SUPPLIER'
                ORDER BY 1
                ```
        }
        layout {
            sequence: 10
            region: @enquiryparty
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

