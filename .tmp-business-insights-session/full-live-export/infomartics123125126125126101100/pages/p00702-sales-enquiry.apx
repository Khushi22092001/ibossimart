    button addnew (
        buttonName: AddNew
        label: Add New
        layout {
            sequence: 210
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pillEnd
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
            }
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Want to Add New Record?
        }
    )

    button addnew-2 (
        buttonName: ADDNEW_1
        label: ADD NEW
        layout {
            sequence: 10
            region: @attachment
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1063
                items: {
                    P1063_MODULETNO: &P702_TNO.
                }
                clearCache: 1063
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

