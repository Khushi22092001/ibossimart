    region rule-lines (
        name: Bill Lines
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>What Was Billed</h2>
                  <p>The item lines on this invoice. <em>Amount</em> is the taxable line
                     value that sums to the headline card; <em>Total</em> adds the footer tax
                     for that line.</p>
                </div>
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-linked (
        name: Receipts Behind This Bill
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Receipts Behind This Bill</h2>
                  <p>The goods receipts this invoice was raised against, via
                     <code>PurchaseBillGRNDetail</code>. An empty list is not automatically a
                     fault &mdash; a service, freight or direct-purchase bill has nothing to
                     receive.</p>
                </div>
                ```
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P937_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r From Company c
                 Where Exists (Select 1 From PCC_PurchaseBill x Where x.CompanyCode=c.CompanyCode
                   And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null Or x.Panel=(Select SAGAR.GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P937_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD-MM-RRRR
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P937_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r From Location l
                 Where Exists (Select 1 From PCC_PurchaseBill x Where x.LocationCode=l.LocationCode
                   And (:P937_COMPANY Is Null Or x.CompanyCode=:P937_COMPANY)
                   And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null Or x.Panel=(Select SAGAR.GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P937_COMPANY
            itemsToSubmit: P937_COMPANY
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
