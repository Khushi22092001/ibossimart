        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P937_SUPPLIER (
        type: popupLov
        label {
            label: Supplier
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct GetPartyName(x.PartyCode) d, x.PartyCode r
                  From PCC_PurchaseBill x
                 Where ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null Or x.Panel=(Select SAGAR.GetUserPanelAB_apex() From dual))
                   And (:P937_COMPANY Is Null Or x.CompanyCode=:P937_COMPANY)
                   And (:P937_LOCATION Is Null Or x.LocationCode=:P937_LOCATION)
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All suppliers
        }
        cascadingLov {
            parentItems: [
                P937_COMPANY
                P937_LOCATION
            ]
            itemsToSubmit: [
                P937_COMPANY
                P937_LOCATION
            ]
        }
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P937_TNO (
        type: popupLov
        label {
            label: Purchase Bill
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nvl(h.PurchaseBillNo,'Incomplete bill (TNO '||h.TNo||')') || ' - ' || to_char(h.PurchaseBillDate,'DD-MM-RRRR') || ' - ' || nvl(GetPartyName(h.PartyCode),'supplier not recorded') d, h.TNo r
                  From PCC_PurchaseBill h
                 Where ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null Or h.Panel=(Select SAGAR.GetUserPanelAB_apex() From dual))
                   And (:P937_COMPANY Is Null Or h.CompanyCode=:P937_COMPANY)
                   And (:P937_LOCATION Is Null Or h.LocationCode=:P937_LOCATION)
                   And (:P937_SUPPLIER Is Null Or h.PartyCode=:P937_SUPPLIER)
                   And (:P937_FROMDATE Is Null Or h.PurchaseBillDate>=to_date(:P937_FROMDATE,'DD-MM-RRRR'))
                   And (:P937_TODATE Is Null Or h.PurchaseBillDate<to_date(:P937_TODATE,'DD-MM-RRRR')+1)
                 Order By h.PurchaseBillDate Desc, 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P937_COMPANY
                P937_LOCATION
                P937_FROMDATE
                P937_TODATE
                P937_SUPPLIER
            ]
            itemsToSubmit: [
                P937_COMPANY
                P937_LOCATION
                P937_FROMDATE
                P937_TODATE
                P937_SUPPLIER
            ]
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Select the purchase bill directly; this 360 page also accepts a TNO from upstream drill links.
        }
    )

    pageItem P937_TODATE (
