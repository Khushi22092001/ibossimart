            }
        )

    )

    region linked-grn (
        name: Receipts Against This Bill
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  g.GrnNo As GRN_NO,
                  g.GrnDate As GRN_DATE,
                  GetLocationName(g.LocationCode) As LOCATION,
                  nvl((Select o.PurchaseOrderNo From PCC_PurchaseOrder o
                        Where o.TNo = g.PurchaseOrderTNo),
                      '<span class="ds-muted">no order linked</span>') As AGAINST_ORDER,
                  (Select Sum(nvl(gd.ReceivedQuantity1,0)) From GrnDetail gd
                    Where gd.TNo = g.TNo) As RECEIVED_QTY,
                  (Select Sum(nvl(gd.RejectedQuantity1,0)) From GrnDetail gd
                    Where gd.TNo = g.TNo) As REJECTED_QTY,
                  Case When (Select Sum(nvl(gd.RejectedQuantity1,0)) From GrnDetail gd
                              Where gd.TNo = g.TNo) > 0
                       Then '<span class="ds-pill ds-pill--bad">Rejection recorded</span>'
                       Else '<span class="ds-pill ds-pill--good">Accepted</span>'
                  End As STATUS
                From PurchaseBillGRNDetail bg
                Join PCC_Grn g On g.TNo = bg.GRNTno
                Join PCC_PurchaseBill h On h.TNo = bg.TNo
                Where bg.TNo = :P937_TNO
                  And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                       Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual))
                Order By g.GrnDate, g.GrnNo
                ```
            pageItemsToSubmit: [
                P937_COMPANY
                P937_FROMDATE
                P937_LOCATION
                P937_SUPPLIER
                P937_TNO
                P937_TODATE
            ]
        }
        layout {
            sequence: 35
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                ds-dash-panel
                ds-register
                ds360-register
            ]
        }
