             function n(v){if(v&&typeof v==='object'&&'v' in v)v=v.v;return Number(String(v||0).replace(/,/g,''))||0;}
             function bind(){var view;try{view=apex.region(regionId).widget().interactiveGrid('getViews','grid');}catch(ignore){return;}
              if(!view||!view.model||view.model.hsplLocalMoneyModel)return;
              var model=view.model,applying=false;model.hsplLocalMoneyModel=true;
              function put(r,f,v){if(n(model.getValue(r,f))!==v)model.setValue(r,f,String(v));}
              function summary(){if(page!==140)return;var entered=0,base=0,tds=0;model.forEach(function(r,i,id){var m=model.getRecordMetadata(id)||{};if(m.deleted||m.agg)return;entered+=n(model.getValue(r,'AMOUNTENTERED'));base+=n(model.getValue(r,'TDSDEDUCTABLEAMOUNT'));tds+=n(model.getValue(r,'TDSAMOUNT'));});[['P140_AMOUNTDR',entered],['P140_TDSDEDUCTABLEAMOUNT',base],['P140_TDSAMOUNT',tds],['P140_TOTALTDSAMOUNT',tds]].forEach(function(v){apex.item(v[0]).setValue(v[1],null,true);});}
              model.subscribe({onChange:function(type,data){if(applying)return;applying=true;try{
               if(type==='set'&&data){var r=data.record||model.getRecord(data.recordId);if(r){
                if(page===140&&data.field==='AMOUNTENTERED'){put(r,'AMOUNT',n(model.getValue(r,'AMOUNTENTERED')));put(r,'TDSDEDUCTABLEAMOUNT',n(model.getValue(r,'AMOUNTENTERED')));}
                if(page===156&&data.field==='DRAMOUNT')put(r,'AMOUNT',-n(model.getValue(r,'DRAMOUNT')));
                if(page===156&&data.field==='CRAMOUNT')put(r,'AMOUNT',n(model.getValue(r,'CRAMOUNT')));
               }}summary();
              }finally{applying=false;}}});summary();
             }
