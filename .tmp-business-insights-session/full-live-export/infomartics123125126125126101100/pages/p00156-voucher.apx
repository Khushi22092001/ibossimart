    dynamicAction setdateongetfocus (
        name: SetDateOnGetFocus
        execution {
            sequence: 10
        }
        when {
            event: focusin
            selectionType: items
            items: P156_VOUCHERDATE
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    for vModule 
                        in (
                            select 
                                'P' || :APP_PAGE_ID || '_' || A.TRANSACTIONDATECOLUMN as DateColumnName
                            from Module a 
                            where a.EntryPageNo = :APP_PAGE_ID
                        )
                    loop 
                        if v(vModule.DateColumnName) is  null and V('P' || :APP_PAGE_ID || '_LOCATIONCODE') is not null and V('P'|| :APP_PAGE_ID || '_DOCTYPECODE') is not null  then 
                            APEX_UTIL.SET_SESSION_STATE(vModule.DateColumnName,to_char(sysdate, 'DD-MM-RRRR'));
                        end if;
                    end loop;
                    ```
                itemsToSubmit: [
                    P156_VOUCHERDATE
                    P156_LOCATIONCODE
                    P156_DOCTYPECODE
                ]
                itemsToReturn: P156_VOUCHERDATE
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

