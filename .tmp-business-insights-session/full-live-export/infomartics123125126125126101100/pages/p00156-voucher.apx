            /* CRUD_BATCH_OWNING_EDITOR_V1: forward typed numbers to the exact grid record. */
            (function($){
             var config={"VOUCHERDETAIL":["DRAMOUNT","CRAMOUNT"],"CC":["AMOUNT"],"REF":["AMOUNT"]},invalid={};
             function raw(v){return v&&typeof v==='object'&&'v'in v?v.v:v;}
             function view(id){try{return apex.region(id).widget().interactiveGrid('getViews','grid');}catch(ignore){return null;}}
             function owner(input){for(var id in config){var v=view(id),host;try{host=apex.region(id).element[0];}catch(ignore){}if(!v||!v.model||!host||!host.contains(input)&&!(input.closest&&input.closest('#'+id+'_ig_grid_vc_floatingItem_dialog')))continue;
             var cell=$(input).closest('.a-GV-cell');if(!cell||!cell.length)cell=v.view$.grid('getActiveCellFromColumnItem',input);if(!cell||!cell.length)cell=v.view$.grid('getCurrentCell');if(!cell||!cell.length)continue;
             var col=v.view$.grid('getColumnForCell',cell);if(!col||col.readonly||config[id].indexOf(col.property)<0||col.property!==input.id&&!/^C[0-9]+$/.test(input.id))continue;var rid=cell.closest('tr[data-id]').attr('data-id'),r=rid&&v.model.getRecord(rid);if(!r)r=v.view$.grid('getActiveRecord');if(!r||v.model.allowEdit&&!v.model.allowEdit(r))continue;var meta=v.model.getRecordMetadata(v.model.getRecordId(r))||{};if(!meta.deleted&&!meta.agg)return{region:id,view:v,record:r,field:col.property};}return null;}
             function prune(){Object.keys(invalid).forEach(function(k){var parts=k.split(':'),v=view(parts[0]),r=v&&v.model.getRecord(parts[1]);if(!r||(v.model.getRecordMetadata(parts[1])||{}).deleted)delete invalid[k];});return Object.keys(invalid).length>0;}
             $(document).on('input.crudBatchEditor','input',function(){if(document.activeElement!==this)return;var o=owner(this);if(!o)return;var m=o.view.model,r=o.record,id=m.getRecordId(r),key=o.region+':'+id+':'+o.field,text=this.value,start=this.selectionStart,end=this.selectionEnd,clean=text.trim().replace(/,/g,'');if(!clean||!Number.isFinite(Number(clean))){invalid[key]=true;return;}delete invalid[key];if(String(raw(m.getValue(r,o.field)))!==String(Number(clean)))m.setValue(r,o.field,String(Number(clean)));if(document.activeElement===this){var next=owner(this);if(next&&next.view.model===m&&next.record===r){this.value=text;if(this.setSelectionRange&&start!==null)this.setSelectionRange(start,end);}}});
             $(document).on('apexbeforepagesubmit.crudBatchEditor',function(e,request){if(['CREATE','SAVE'].indexOf(request)<0)return;if(prune()){e.preventDefault();apex.message.showErrors([{type:'error',location:'page',message:'Complete the quantity, rate or amount in the detail row before saving.',unsafe:false}]);return false;}});
             window.hsplCrudBatchInvalid=prune;
             window.hsplCrudBatchPreserveEditor=function(){var input=document.activeElement,o=input&&owner(input);if(!o||!('value'in input))return function(){};var text=input.value,start=input.selectionStart,end=input.selectionEnd;return function(){if(document.activeElement!==input)return;var next=owner(input);if(!next||next.view.model!==o.view.model||next.record!==o.record||next.field!==o.field)return;input.value=text;if(input.setSelectionRange&&start!==null)input.setSelectionRange(start,end);};};
            }(apex.jQuery));
            
            
