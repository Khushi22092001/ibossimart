    process quotationdetail-save-interactive-grid-data (
        name: QuotationDetail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @quotation-detail
        source {
            plsqlCode:
                ```plsql
                declare
                    l_sno quotationdetail.sno%type;
                begin
                    /* HSPL_P710_ROW_LIFECYCLE_V1: document and row identity are immutable. */
                    if :P710_TNO is null then
                        raise_application_error(-20010,'Quotation document key is missing.');
                    end if;
                    if :APEX$ROW_STATUS in ('U','D') and :ROWID is not null then
                        begin
                            select sno into l_sno from quotationdetail
                             where tno = :P710_TNO and rowid = :ROWID for update;
                        exception when no_data_found then
                            raise_application_error(-20010,'Quotation detail no longer exists in this document. Refresh and retry.');
                        end;
                        :TNO := :P710_TNO;
                        :SNO := l_sno;
                    end if;
                    case :APEX$ROW_STATUS
                        when 'C' then
                            /* A never-entered Add Row placeholder has no business detail. */
                            if :ITEMCODE is null and :ITEMSPECIFICATIONCODE is null
                               and :QUANTITY1 is null and :RATE is null and :WITHOUTDISCOUNTRATE is null then
                                return;
                            end if;
                            :TNO := :P710_TNO;
                            if :SNO is null then :SNO := globaltno.nextval; end if;
                            Insert Into QUOTATIONDETAIL (                 
                                    TNO,
                					SNO,
                					SERIALNO,
                					ITEMCODE,
                					ITEMSPECIFICATIONCODE,
                					DESCRIPTION,
                					QUANTITY1,
                					QUANTITY2,
                					RATEMEASURINGUNITCODE,
                					RATE,
                					AMOUNT,
                					FOOTERAMOUNT,
                					TOTALAMOUNT,
                					REMARK,
                					WITHOUTDISCOUNTRATE,
                					DISCOUNTPERCENTAGE,
                					DISCOUNTRATE,
                					HSNCODE,
                					ISRATEINCLUSIVETAX,
                					RATEAFTERDISCOUNT
                
                            )
                            Values (
                                :TNO,
                				:SNO,
                				:SERIALNO,
                				:ITEMCODE,
                				:ITEMSPECIFICATIONCODE,
                				:DESCRIPTION,
                				:QUANTITY1,
                				:QUANTITY2,
                				:RATEMEASURINGUNITCODE,
                				:RATE,
                				:AMOUNT,
                				:FOOTERAMOUNT,
                				:TOTALAMOUNT,
                				:REMARK,
                				:WITHOUTDISCOUNTRATE,
                				:DISCOUNTPERCENTAGE,
                				:DISCOUNTRATE,
                				:HSNCODE,
                				:ISRATEINCLUSIVETAX,
                				:RATEAFTERDISCOUNT
                              
                
                            ) returning rowid into :ROWID;
                        
                        when 'U' then
                            if :ROWID is null then
                                raise_application_error(-20010,'Existing quotation row identity is missing. Refresh and retry.');
                            end if;
                            update QUOTATIONDETAIL Set
                				SERIALNO = :SERIALNO,
                				ITEMCODE = :ITEMCODE,
                				ITEMSPECIFICATIONCODE = :ITEMSPECIFICATIONCODE,
                				DESCRIPTION = :DESCRIPTION,
                				QUANTITY1 = :QUANTITY1,
                				QUANTITY2 = :QUANTITY2,
                				RATEMEASURINGUNITCODE = :RATEMEASURINGUNITCODE,
                				RATE = :RATE,
                				AMOUNT = :AMOUNT,
                				FOOTERAMOUNT = :FOOTERAMOUNT,
                				TOTALAMOUNT = :TOTALAMOUNT,
                				REMARK = :REMARK,
                				WITHOUTDISCOUNTRATE = :WITHOUTDISCOUNTRATE,
                				DISCOUNTPERCENTAGE = :DISCOUNTPERCENTAGE,
                				DISCOUNTRATE = :DISCOUNTRATE,
                				HSNCODE = :HSNCODE,
                				ISRATEINCLUSIVETAX = :ISRATEINCLUSIVETAX,
                				RATEAFTERDISCOUNT = :RATEAFTERDISCOUNT           
                            WHERE TNO = :P710_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            if :ROWID is null then
                                /* A canceled new row must not delete a persisted detail. */
                                select count(*) into l_sno from quotationdetail
                                 where tno = :P710_TNO and sno = :SNO;
                                if l_sno > 0 then
                                    raise_application_error(-20010,'Deleted row identity is missing. Refresh and retry.');
                                end if;
                            end if;
                            delete from quotationdetailfooter where tno = :P710_TNO and sno = :SNO;
                            delete from quotationdetail where tno = :P710_TNO and rowid = :ROWID;
                    end case;
                exception when others then
                    raise_application_error(-20010, 'Quotation detail row SNO '||nvl(to_char(:SNO),'?')||
                        ' could not be saved: '||sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 9027916337514032
        }
    )

    process repair-incomplete-persisted-quotation-rows (
        name: Repair incomplete persisted quotation rows
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_party varchar2(30) := :P710_PARTYCODE;
                    l_transaction varchar2(30) := :P710_TRANSACTIONTYPECODE;
                    l_unit1 varchar2(30);
                    l_unit2 varchar2(30);
                    l_rate_unit varchar2(30);
                    l_hsn varchar2(30);
                    l_factor number;
                    l_q2 number;
                    l_base_rate number;
                    l_discount_percent number;
                    l_discount_rate number;
                    l_rate number;
                    l_amount number;
                    l_footer_amount number;
                    l_total_amount number;
                    l_fixed pls_integer := 0;
                    l_sum_amount number;
                    l_sum_footer number;
                    l_sum_total number;
                begin
                    if :P710_TNO is null then
                        raise_application_error(-20021,'Quotation key is missing; nothing was saved.');
                    end if;
                
                    for d in (select rowid rid, q.*
                                from quotationdetail q
                               where q.tno = :P710_TNO
                                 and (q.rate is null or q.amount is null
                                   or q.footeramount is null or q.totalamount is null
                                   or q.rateafterdiscount is null or q.discountrate is null
                                   or exists (select 1
                                                from quotationdetailfooter f
                                               where f.tno=q.tno and f.sno=q.sno
                                               group by f.tno,f.sno
                                              having abs(nvl(q.footeramount,0)-nvl(sum(f.footervalue),0))>.005))
                               order by nvl(q.serialno,q.sno),q.sno)
                    loop
                        if d.itemcode is null or d.itemspecificationcode is null then
                            raise_application_error(-20022,'SNO '||d.sno||' item/specification is blank.');
                        end if;
                        if nvl(d.quantity1,0) <= 0 then
                            raise_application_error(-20023,'SNO '||d.sno||' quantity must be greater than zero.');
                        end if;
                        l_base_rate := nvl(d.withoutdiscountrate,d.rate);
                        if l_base_rate is null then
                            raise_application_error(-20024,'SNO '||d.sno||' W/O Discount Rate is blank.');
                        end if;
                        l_discount_percent := nvl(d.discountpercentage,0);
                        if l_discount_percent < 0 or l_discount_percent > 100 then
                            raise_application_error(-20025,'SNO '||d.sno||' Discount % must be between 0 and 100.');
                        end if;
                
                        select max(i.measuringunitcode1), max(i.measuringunitcode2)
                          into l_unit1, l_unit2
                          from item i
                         where i.itemcode = d.itemcode;
                        select nvl(max(s.multiplyingfactor),1), max(trim(s.hsncode))
                          into l_factor, l_hsn
                          from itemspecification s
                         where s.itemspecificationcode = d.itemspecificationcode;
                        l_hsn := nvl(trim(d.hsncode),l_hsn);
                        l_q2 := case when l_unit2 is not null
                                     then round(d.quantity1*l_factor,3)
                                     else nvl(d.quantity2,0) end;
                        l_rate_unit := nvl(trim(d.ratemeasuringunitcode),l_unit1);
                        l_discount_rate := l_base_rate*l_discount_percent/100;
                        l_rate := l_base_rate-l_discount_rate;
                        if l_unit2 is not null and l_rate_unit=l_unit2 then
                            l_amount := l_rate*l_q2;
                        else
                            l_amount := l_rate*d.quantity1;
                        end if;
                
                        delete from quotationdetailfooter
                         where tno=:P710_TNO and sno=d.sno;
                        if l_party is not null and l_transaction is not null and l_hsn is not null then
                            for f in (
                                select rownum slno, a.legendscode, c.footerheadcode,
                                       b.taxrate footerpercent, (l_amount*b.taxrate)/100 footervalue
                                  from taxruledetail a
                                  join taxruledetailfooter b on b.tno=a.tno and b.sno=a.sno
                                  join footerhead c on c.footerheadcode=b.footerheadcode
                                  join taxrule tr on tr.tno=a.tno
                                  join taxrulehsn h on h.tno=tr.tno
                                  join vendor v on v.taxregistrationtypecode=tr.taxregistrationtypecode
                                 where v.vendorcode=l_party
                                   and tr.transactiontypecode=l_transaction
                                   and h.hsncode=l_hsn)
                            loop
                                insert into quotationdetailfooter
                                    (tno,sno,sn,footerheadcode,footerpercent,footervalue,serialno,legendscode)
                                values
                                    (:P710_TNO,d.sno,globaltno.nextval,f.footerheadcode,f.footerpercent,
                                     f.footervalue,f.slno,f.legendscode);
                            end loop;
                        end if;
                        select nvl(sum(footervalue),0)
                          into l_footer_amount
                          from quotationdetailfooter
                         where tno=:P710_TNO and sno=d.sno;
                        l_total_amount := l_amount+l_footer_amount;
                
                        update quotationdetail
                           set quantity2=l_q2,
                               ratemeasuringunitcode=l_rate_unit,
                               withoutdiscountrate=l_base_rate,
                               discountpercentage=l_discount_percent,
                               discountrate=l_discount_rate,
                               rateafterdiscount=l_rate,
                               rate=l_rate,
                               amount=l_amount,
                               footeramount=l_footer_amount,
                               totalamount=l_total_amount,
                               hsncode=l_hsn
                         where rowid=d.rid;
                        l_fixed := l_fixed+1;
                    end loop;
                
                    delete from quotationdetailfooter f
                     where f.tno=:P710_TNO
                       and not exists (select 1 from quotationdetail d
                                        where d.tno=f.tno and d.sno=f.sno);
                
                    if l_fixed > 0 then
                        select nvl(sum(amount),0),nvl(sum(footeramount),0),nvl(sum(totalamount),0)
                          into l_sum_amount,l_sum_footer,l_sum_total
                          from quotationdetail
                         where tno=:P710_TNO;
                        update quotation
                           set sumofamount=l_sum_amount,
                               sumoffooteramount=l_sum_footer,
                               quotationamount=l_sum_total
                         where tno=:P710_TNO;
                        :P710_SUMOFAMOUNT := l_sum_amount;
                        :P710_SUMOFFOOTERAMOUNT := l_sum_footer;
                        :P710_QUOTATIONAMOUNT := l_sum_total;
                    end if;
                exception
                    when others then
                        if sqlcode between -20025 and -20021 then raise; end if;
                        raise_application_error(-20020,'Quotation calculation save failed: '||sqlerrm);
                end;
                ```
        }
        execution {
            sequence: 70
        }
