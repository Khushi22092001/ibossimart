        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("DetailFooter").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("FOOTERVALUE");
                    model.forEach(function(igrow) {
                        n_amt = parseFloat(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P710_FVALUE").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: jsExpression
