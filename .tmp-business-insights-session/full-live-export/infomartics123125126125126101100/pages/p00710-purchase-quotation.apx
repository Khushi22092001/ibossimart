        column TERMSANDCONDITION (
            type: popupLov
            heading {
                heading: Terms And Condition
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select a.termsandcondition a , a.termsandcondition b from TERMSANDCONDITIONHEADDETAIL a , TERMSANDCONDITIONHEAD b
                    where a.tno = b.tno
                    and b.tno = :TERMSANDCONDITIONHEADCODE
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TERMSANDCONDITIONHEADCODE
                itemsToSubmit: TERMSANDCONDITIONHEADCODE
                parentRequired: false
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: TERMSANDCONDITION
                dataType: varchar2
            }
        )

        column TERMSANDCONDITIONHEADCODE (
            type: popupLov
            heading {
                heading: Terms And Condition Head
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery: select TERMSANDCONDITIONHEADNAME , tno from TERMSANDCONDITIONHEAD
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: TERMSANDCONDITIONHEADCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P710_TNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Terms and Condition
        }
    )

