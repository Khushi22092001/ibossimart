    dynamicAction calculate-detail-footer-amount (
        name: Calculate Detail Footer Amount
        execution {
            sequence: 120
        }
        when {
            selectionType: columns
            interactiveGrid: @detailfooter
            columns: [
                FOOTERPERCENT
                LEGENDSCODE
            ]
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                itemsToSubmit: [
                    FOOTERHEADCODE
                    FOOTERPERCENT
                    FOOTERVALUE
                    LEGENDSCODE
                    P710_DFAMOUNT
                ]
                itemsToReturn: FOOTERVALUE
                suppressChangeEvent: true
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: jsExpression
                javaScriptExpression: window.hsplPhase1WasEdited(this)
            }
        )

    )

    dynamicAction calculate-detail-footer-total-amount-value-on-get-focus (
        name: Calculate Detail Footer Total Amount value on get focus
        execution {
            sequence: 150
        }
        when {
            event: focusin
            selectionType: region
            region: @detailfooter
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("DetailFooter").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("FOOTERVALUE");
                    var totalAmt = 0;
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    });
                    
                    $s("P710_DFTOTALAMOUNT", totalAmt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

