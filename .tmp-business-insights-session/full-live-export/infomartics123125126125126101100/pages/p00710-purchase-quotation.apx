            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                itemsToSubmit: [
                    QUANTITY1
                    QUANTITY2
                    WITHOUTDISCOUNTRATE
                    DISCOUNTPERCENTAGE
                    DISCOUNTRATE
                    RATEAFTERDISCOUNT
                    RATE
                    AMOUNT
                    TOTALAMOUNT
                    TNO
                    SNO
