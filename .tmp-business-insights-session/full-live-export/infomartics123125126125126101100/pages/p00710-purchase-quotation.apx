            button: @getitem
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    IMART_REFERENCE_SCOPE.assert_reference('ENQUIRY',:P710_ENQUIRYTNO,IMART_REFERENCE_SCOPE.company_code,'P710_ENQUIRYTNO');
                    begin
                    
                    if :P710_ENQUIRYTNO is not null then
                        delete from quotationdetail where tno = :P710_TNO;
                    
                    end if;
                        for vloop in (select 
                                        itemcode , 
                                        ITEMSPECIFICATIONCODE , 
                                        DESCRIPTION , 
                                        QUANTITY1 , 
                                        QUANTITY2, 
                                        (select max(trim(s.hsncode)) from itemspecification s
                                          where s.itemspecificationcode = eid.itemspecificationcode) HSNCODE, 
                                        SNO 
                                    from ENQUIRYITEMDETAIL eid 
                                    where tno = :P710_ENQUIRYTNO)
                        loop
                            insert into QUOTATIONDETAIL 
                            (tno,
                            sno,
                            serialno,
                            itemcode,
                            ITEMSPECIFICATIONCODE,
                            DESCRIPTION,
                            QUANTITY1,
                            QUANTITY2,
                            HSNCODE
                            )
                            values (
                                :P710_TNO,
                                globaltno.nextval,
                                vloop.sno,
                                vloop.itemcode,
                                vloop.ITEMSPECIFICATIONCODE,
                                vloop.DESCRIPTION,
                                vloop.QUANTITY1,
                                vloop.QUANTITY2,
                                vloop.HSNCODE
                            );
                        end loop;
                    end;
                    end;
                    ```
                itemsToSubmit: [
                    P710_TNO
                    P710_ENQUIRYTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @quotation-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

