                    ```plsql
                    begin
                    IMART_REFERENCE_SCOPE.assert_reference('INDENT',:P714_INDENTTNO,IMART_REFERENCE_SCOPE.company_code,'P714_INDENTTNO');
                    begin
                        insert into purchaseorderdetail
                        (
                            tno,
                            sno,
                            INDENTTNO,
                            ITEMCODE,
                            ITEMSPECIFICATIONCODE,
                            QUANTITY1,
                            QUANTITY2,
                            RATE,
                            AMOUNT , 
                            RATEMEASURINGUNITCODE
                        )
                        (
                            select 
                                :P714_TNO,
                                globaltno.nextval,
                                :P714_INDENTTNO,
                                a.ITEMCODE , 
                                a.ITEMSPECIFICATIONCODE , 
                                a.INDENTQUANTITY1 , 
                                a.INDENTQUANTITY2,
                                a.RATE , 
                                a.AMOUNT ,
                                GetMeasuringUnitCodeFromItem(a.itemcode) 
                            from indentdetail a , item b
                            where a.itemcode = b.itemcode
                            and a.tno = :P714_INDENTTNO
                        );
                    end;
                    end;
                    ```
