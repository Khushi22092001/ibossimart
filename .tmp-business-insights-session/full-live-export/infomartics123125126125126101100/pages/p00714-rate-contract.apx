    process save-all-edited-rate-contract-row-footers (
        name: Save all edited Rate Contract row footers
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 edits json_object_t;keys json_key_list;lines json_array_t;line json_object_t;own_sno number;own_sn number;own_rid varchar2(30);hits number;
                 r RATECONTRACTDETAILFOOTER%rowtype;empty_row RATECONTRACTDETAILFOOTER%rowtype;
                 type rows_t is table of RATECONTRACTDETAILFOOTER%rowtype;pending_rows rows_t:=rows_t();
                 type seen_t is table of boolean index by varchar2(100);seen seen_t;
                begin
                 if :P714_FD_EDITS is null then return;end if;
                 edits:=json_object_t.parse(:P714_FD_EDITS);keys:=edits.get_keys;
                 for i in 1..keys.count loop
                  own_sno:=to_number(keys(i));select count(*) into hits from RATECONTRACTDETAIL where tno=:P714_TNO and sno=own_sno;
                  if hits<>1 then raise_application_error(-20073,'Footer does not belong to exactly one saved Rate Contract detail.');end if;
                  lines:=edits.get_array(keys(i));pending_rows:=rows_t();seen.delete;
                  for k in 0..lines.get_size()-1 loop
                   line:=treat(lines.get(k) as json_object_t);r:=empty_row;
                   if nvl(line.get_number('TNO'),-1)<>:P714_TNO or nvl(line.get_number('SNO'),-1)<>own_sno then raise_application_error(-20073,'Rate Contract footer owner changed.');end if;
                   if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20073,'Select a footer head and legend.');end if;
                   own_sn:=line.get_number('SN');if own_sn is null then own_sn:=globaltno.nextval;end if;select count(*) into hits from RATECONTRACTDETAILFOOTER where sn=own_sn and (tno<>:P714_TNO or sno<>own_sno);if hits>0 then raise_application_error(-20073,'Footer SN belongs to another detail');end if;if seen.exists('SN'||own_sn) then raise_application_error(-20073,'Duplicate footer SN');end if;seen('SN'||own_sn):=true;own_rid:=line.get_string('ROWID');
                   if own_rid is not null then
                    if seen.exists(own_rid) then raise_application_error(-20073,'Duplicate Rate Contract footer identity.');end if;seen(own_rid):=true;
                    if not regexp_like(own_rid,'^t[0-9]+$') then
                     begin select * into r from RATECONTRACTDETAILFOOTER where rowid=chartorowid(own_rid) and tno=:P714_TNO and sno=own_sno;exception when no_data_found then raise_application_error(-20073,'Rate Contract footer ROWID is stale or belongs to another detail.');end;
                    end if;
                   end if;
                   if r.sn is not null and r.sn<>own_sn then raise_application_error(-20073,'Footer ROWID and SN disagree');end if;r.sn:=own_sn;r.tno:=:P714_TNO;r.sno:=own_sno;r.serialno:=k+1;
                   r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');
                   pending_rows.extend;pending_rows(pending_rows.count):=r;
                  end loop;
                  delete from RATECONTRACTDETAILFOOTER where tno=:P714_TNO and sno=own_sno;
                  for k in 1..pending_rows.count loop r:=pending_rows(k);insert into RATECONTRACTDETAILFOOTER values r;end loop;
                 end loop;
                end;
                
                ```
        }
        execution {
            sequence: 105
        }
        advanced {
            executionMappingIdentifier: 982026092871400105
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE','CREATE')
        }
    )

    process saveratecontractfooter (
        name: SaveratecontractFooter
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    delete from ratecontractfooter where tno = :P714_TNO;
                    insert into ratecontractfooter
                        (tno ,
                        SNO,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   SELECT X.TNO,
                                   GLOBALTNO.NEXTVAL,
                                   X.FOOTERHEADCODE,
                                   X.SUMOFVALUE
                             FROM 
                            (select 
                                :P714_TNO AS TNO ,               
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from ratecontractdetailfooter
                            where tno = :P714_TNO
                            group by FOOTERHEADCODE
                            ) X
                        );
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 60853064232523179
        }
    )

