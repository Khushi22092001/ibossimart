    process verify-and-reconcile-submitted-rate-contract-calculations (
        name: Verify and reconcile submitted Rate Contract calculations
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  u1 varchar2(30);u2 varchar2(30);expected number;lines number;
                begin
                  select count(*) into lines from ratecontractdetail where tno=:P714_TNO;
                  if lines=0 then raise_application_error(-20063,'Rate Contract requires at least one detail row.');end if;
                  for d in (select * from ratecontractdetail where tno=:P714_TNO) loop
                    if d.itemcode is null or d.itemspecificationcode is null then
                      raise_application_error(-20063,'Select item and specification on each Rate Contract row.');
                    end if;
                    select measuringunitcode1,measuringunitcode2 into u1,u2 from item where itemcode=d.itemcode;
                    if nvl(d.quantity1,0)<=0 or d.rate is null or d.rate<0 then
                      raise_application_error(-20063,'Quantity must be positive and rate cannot be blank or negative.');
                    end if;
                    if d.ratemeasuringunitcode=u1 then expected:=round(d.quantity1*d.rate,2);
                    elsif u2 is not null and d.ratemeasuringunitcode=u2 then expected:=round(nvl(d.quantity2,0)*d.rate,2);
                    else raise_application_error(-20063,'Rate unit does not match the selected item.');end if;
                    if d.amount is null or abs(d.amount-expected)>.005 then
                      raise_application_error(-20063,'Detail amount is stale. Recalculate the changed row before saving.');
                    end if;
                  end loop;
                  update ratecontractdetail d set footeramount=(select nvl(sum(f.footervalue),0) from ratecontractdetailfooter f where f.tno=d.tno and f.sno=d.sno),
                    totalamount=nvl(d.amount,0)+(select nvl(sum(f.footervalue),0) from ratecontractdetailfooter f where f.tno=d.tno and f.sno=d.sno)
                    where d.tno=:P714_TNO;
                  select nvl(sum(amount),0),nvl(sum(footeramount),0),nvl(sum(totalamount),0)
                    into :P714_SUMOFAMOUNT,:P714_SUMOFFOOTERAMOUNT,:P714_RATECONTRACTAMOUNT
                    from ratecontractdetail where tno=:P714_TNO;
                  update ratecontract set sumofamount=:P714_SUMOFAMOUNT,sumoffooteramount=:P714_SUMOFFOOTERAMOUNT,ratecontractamount=:P714_RATECONTRACTAMOUNT
                    where tno=:P714_TNO;
                end;
                
                ```
        }
