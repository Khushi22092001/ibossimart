    dynamicAction set-value-final-value-of-detail-footer-on-loose-focus (
        name: Set Value- Final value of Detail footer on Loose Focus
        execution {
            sequence: 240
        }
        when {
            selectionType: region
            region: @footerdetail
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("FooterDetail").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("FOOTERVALUE");
                    model.forEach(function(igrow, index, id) { var meta=model.getRecordMetadata(id)||{}; if(meta.deleted||meta.agg||meta.aggregate)return;
                        n_amt = parseFloat(igrow[col_amt]);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    if(Number(apex.item("P714_FVALUE").getValue()||0)!==n_totamt)apex.item("P714_FVALUE").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

