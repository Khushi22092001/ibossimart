                var region=apex.region('FooterDetail');region.element.css('visibility','hidden');openModal('FooterDetail');var spinner=apex.util.showSpinner(region.element);spinner.css('visibility','visible');var deadline=Date.now()+10000;
                (function wait(){if(seq!==fdSequence){spinner.remove();return;}if(s.error){spinner.remove();apex.theme.closeRegion('FooterDetail');error('Resolve this row calculation error before opening FD.');return;}if(!s.pending){spinner.remove();if(openCached(anchor,event,r))return;if(Date.now()>deadline){apex.theme.closeRegion('FooterDetail');error('FD grid is not ready. Retry FD.');return;}setTimeout(wait,25);return;}if(Date.now()>deadline){spinner.remove();apex.theme.closeRegion('FooterDetail');error('Row calculation is still running. Retry FD after it finishes.');return;}setTimeout(wait,25);})();return false;
