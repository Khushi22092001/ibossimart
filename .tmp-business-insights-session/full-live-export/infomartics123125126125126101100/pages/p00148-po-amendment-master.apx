            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select itemname , itemcode from item 
                    where itemcode in (select distinct itemcode from poamendmentdetail where tno = :P148_TNO)
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: P148_TNO
                parentRequired: false
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMCODE
                dataType: varchar2
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: popupLov
            heading {
                heading: Item Specification
                alignment: center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ITEMSPECIFICATIONNAME , ITEMSPECIFICATIONCODE
                    from itemspecification
                    where tno in (select tno from item where itemcode = :ITEMCODE )
                    and ITEMSPECIFICATIONCODE in (select distinct ITEMSPECIFICATIONCODE from poamendmentdetail 
                                                    where tno = :P148_TNO and itemcode = :ITEMCODE)
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ITEMCODE
                itemsToSubmit: [
                    ITEMCODE
                    ITEMSPECIFICATIONCODE
                    P148_TNO
                ]
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMSPECIFICATIONCODE
                dataType: varchar2
            }
