    process delete-master-if-detail-is-not-saved (
        name: Delete master if Detail is not saved
        type: executeCode
        source {
            plsqlCode: checkdetail(getmodulecodeforpageno(:APP_PAGE_ID),:P148_TNO);
        }
        execution {
            sequence: 130
