    process update-indent-when-deleting-po-amendment (
        name: update indent when deleting po amendment
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                IMART_REFERENCE_SCOPE.assert_reference('PURCHASEORDER',:P148_PURCHASEORDERTNO,IMART_REFERENCE_SCOPE.company_code,'P148_PURCHASEORDERTNO');
                declare
                    pindent number;
                    qty1    number;
                begin
                    select indenttno into pindent  from purchaseorder    
                    where tno = :P148_PURCHASEORDERTNO;
                
                    for i in (
                        select itemcode , itemspecificationcode from poamendmentdetail
                        where tno = :P148_TNO
                    )
                    loop
                        select quantity1 into qty1 from purchaseorderdetail
                        where tno = :P148_PURCHASEORDERTNO
                        and itemcode = i.itemcode
                        and itemspecificationcode = i.itemspecificationcode;
                
                        update indentdetail set orderedquantity1 = qty1 
                        where tno = pindent
                        and itemcode = i.itemcode
                        and itemspecificationcode = i.itemspecificationcode;
                
                    end loop;
                end;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 17262009541499831
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

