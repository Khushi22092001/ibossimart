    process p148-calculate-detail (
        name: P148_CALCULATE_DETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  j json_object_t:=json_object_t.parse(apex_application.g_x01);
                  l_tno number:=j.get_number('tno'); l_sno number:=j.get_number('sno');
                  l_itemcode varchar2(30):=j.get_string('item'); l_spec varchar2(30):=j.get_string('spec');
                  q1 number:=nvl(j.get_number('q1'),0); q2 number:=nvl(j.get_number('q2'),0);
                  rate number:=nvl(j.get_number('rate'),0); ru varchar2(30):=j.get_string('unit');
                  field varchar2(30):=j.get_string('field'); u1 varchar2(30);u2 varchar2(30); factor number; l_hsn varchar2(30);
                  amount number; footer number; hits number;indent_qty number;indent_tno number;
                  previous_amount number:=j.get_number('previousAmount');previous_qty number:=j.get_number('previousQuantity');old_auto number;new_value number;
                cache json_array_t;line json_object_t;farr json_array_t:=json_array_t();out_line json_object_t;head varchar2(100);legend varchar2(100);percent number;fvalue number;sn number;footer_identity number;rid varchar2(40);serial_no number;footer_count number;footer_owner_tno number;footer_owner_sno number;
                 function numeric(o json_object_t,k varchar2) return number is begin if o.get(k) is null or o.get(k).is_null then return null;end if;return to_number(o.get_string(k));end;
                 procedure append_line(obj in out json_object_t) is begin
                  if nvl(numeric(obj,'TNO'),-1)<>l_tno or nvl(numeric(obj,'SNO'),-1)<>l_sno then raise_application_error(-20062,'Footer owner does not match this detail');end if;
                  head:=obj.get_string('FOOTERHEADCODE');legend:=upper(trim(obj.get_string('LEGENDSCODE')));percent:=numeric(obj,'FOOTERPERCENT');fvalue:=numeric(obj,'FOOTERVALUE');
                  if head is null then raise_application_error(-20062,'Footer head is required');end if;
                  if previous_amount is not null then old_auto:=imart_purchasebill_calc.footer_value(legend,previous_amount,percent,fvalue,previous_qty);
                   if abs(nvl(fvalue,0)-nvl(old_auto,0))<=.0051 then fvalue:=imart_purchasebill_calc.footer_value(legend,amount,percent,fvalue,q1);end if;end if;
                  obj.put('FOOTERVALUE',fvalue);footer:=footer+nvl(fvalue,0);farr.append(obj);
                 end;
                begin
                  if l_tno is null or l_tno != :P148_TNO then raise_application_error(-20062,'PO Amendment document identity changed. Reopen the form.');end if;
                  if l_itemcode is null or l_spec is null then raise_application_error(-20062,'Select item and specification before calculating.');end if;
                  if l_sno is null then l_sno:=globaltno.nextval;end if;
                  select count(*) into hits from poamendmentdetail d where d.sno=l_sno and d.tno!=l_tno;
                  if hits>0 then raise_application_error(-20062,'PO Amendment line belongs to another document.');end if;
                  select i.measuringunitcode1,i.measuringunitcode2 into u1,u2 from item i where i.itemcode=l_itemcode;
                  select s.multiplyingfactor,trim(s.hsncode) into factor,l_hsn from itemspecification s where s.itemspecificationcode=l_spec;
                  q1:=round(q1,getuomdecimal(u1));
                  if field='QUANTITY2' then
                    if nvl(factor,0)>0 and u2 is not null then q1:=round(q2/factor,getuomdecimal(u1));end if;
                  elsif nvl(factor,0)>0 and u2 is not null then q2:=q1*factor;
                  end if;
                  q2:=round(q2,case when u2 is null then 3 else getuomdecimal(u2) end);
                  ru:=nvl(ru,u1);
                  if ru=u1 then amount:=q1*rate;
                  elsif ru=u2 then amount:=q2*rate;
                  else raise_application_error(-20062,'Rate unit does not match this item. Select a valid rate unit.');end if;
                  -- An amendment may have no Indent. Validate a linked Indent without erasing input.
                  select max(indenttno) into indent_tno from purchaseorder where tno=:P148_PURCHASEORDERTNO;
                  if indent_tno is not null then
                    select sum(quantity1) into indent_qty from indentdetail where tno=indent_tno and itemcode=l_itemcode and itemspecificationcode=l_spec;
                    if indent_qty is not null and q1>indent_qty then raise_application_error(-20062,'Amended quantity exceeds linked Indent quantity '||indent_qty);end if;
                  end if;
                  footer:=0;
                  if j.has('footers') then cache:=j.get_array('footers');
                   for k in 0..cache.get_size()-1 loop line:=treat(cache.get(k) as json_object_t);
                    rid:=line.get_string('ROWID');if rid is null then line.put('ROWID','t'||globaltno.nextval);elsif not regexp_like(rid,'^t[0-9]+$') then select count(*) into hits from poamendmentdetailfooter where rowid=chartorowid(rid) and tno=l_tno and sno=l_sno;if hits<>1 then raise_application_error(-20062,'Footer identity is stale or belongs to another detail');end if;end if;
                    append_line(line);end loop;
                  else
                   for f in(select rowid rid,f.* from poamendmentdetailfooter f where tno=l_tno and sno=l_sno order by serialno)loop
                    line:=json_object_t();line.put('TNO',f.tno);line.put('SNO',f.sno);line.put('ROWID',to_char(f.rid));line.put('FOOTERHEADCODE',f.footerheadcode);line.put('LEGENDSCODE',f.legendscode);line.put('FOOTERPERCENT',f.footerpercent);line.put('FOOTERVALUE',f.footervalue);line.put('SERIALNO',f.serialno);append_line(line);
                   end loop;
                   if rate>0 and farr.get_size()=0 then
                    for tax in(select rownum serialno,c.footerheadcode,b.taxrate footerpercent,a.legendscode from taxruledetail a,taxruledetailfooter b,footerhead c,taxrule d,taxrulehsn e,party f where a.tno=b.tno and a.sno=b.sno and b.footerheadcode=c.footerheadcode and a.tno=d.tno and d.tno=e.tno and d.taxregistrationtypecode=f.taxregistrationtypecode and f.partycode=:P148_PARTYCODE and d.transactiontypecode=:P148_TRANSACTIONTYPECODE and e.hsncode=l_hsn)loop
                     line:=json_object_t();line.put('TNO',l_tno);line.put('SNO',l_sno);sn:=globaltno.nextval;line.put('ROWID','t'||sn);line.put('FOOTERHEADCODE',tax.footerheadcode);line.put('LEGENDSCODE',tax.legendscode);line.put('FOOTERPERCENT',tax.footerpercent);line.put('FOOTERVALUE',round(amount*tax.footerpercent/100,2));line.put('SERIALNO',tax.serialno);previous_amount:=null;append_line(line);
                    end loop;
                   end if;
                  end if;
                  apex_json.open_object;apex_json.write('sno',l_sno);apex_json.write('q1',q1);apex_json.write('q2',q2);apex_json.write('rate',rate);apex_json.write('unit',ru);apex_json.write('primaryUnit',u1);apex_json.write('secondaryUnit',u2);apex_json.write('amount',amount);apex_json.write('footer',footer);apex_json.write('total',amount+footer);apex_json.write_raw('footers',farr.to_clob());apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 80
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 982026092814800001
        }
    )

    process p148-footer-calculate (
        name: P148_FOOTER_CALCULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare j json_object_t:=json_object_t.parse(apex_application.g_x01);head varchar2(100):=j.get_string('head');legend varchar2(100):=upper(trim(j.get_string('legend')));percent number:=j.get_number('percent');result_value number:=j.get_number('value');base_amount number:=j.get_number('amount');quantity number:=j.get_number('quantity');begin
                if legend in('OQA','OQD') then if quantity is null then raise_application_error(-20074,'Owning detail quantity is missing');end if;result_value:=abs(quantity*nvl(percent,0));if legend='OQD' then result_value:=-result_value;end if;elsif legend='LSA' then result_value:=abs(nvl(result_value,0));elsif legend='LSD' then result_value:=-abs(nvl(result_value,0));else
                declare	
                	cursor cFooterSchemeDetail is
                		select a.* 
                		from FooterSchemeList a, FooterSchemeList c
                		where a.tno = c.tno
                			and a.Status = 'ACTIVE'
                			and c.FooterHeadCode = head
                			and a.sno < c.sno 
                			and a.companycode = :global_CompanyCode
                			and a.financialyearcode = :global_financialyearcode
                			and a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                			and c.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                		order by a.sno;
                	vFooterSchemeDetail cFooterSchemeDetail%ROWTYPE;
                	
                	cursor c3FooterSchemeDetail is
                		select a.* 
                		from FooterSchemeList a, FooterSchemeList c
                		where a.tno = c.tno
                			and a.Status = 'ACTIVE'
                			and c.FooterHeadCode = head
                			and a.companycode = :global_CompanyCode
                			and a.financialyearcode = :global_financialyearcode
                			and a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                			and c.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                		order by a.sno;
                	v3FooterSchemeDetail c3FooterSchemeDetail%ROWTYPE;
                
                
                	cursor c2FooterSchemeDetail is
                		select a.* 
                		from FooterSchemeList a
                		where a.Status = 'ACTIVE'
                			and a.FooterHeadCode = head
                			and a.companycode = :global_CompanyCode
                			and a.financialyearcode = :global_financialyearcode
                			and a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                		order by a.sno;
                	v2FooterSchemeDetail c2FooterSchemeDetail%ROWTYPE;
                	
                	myFormula varchar2(1000);
                	isFound varchar2(10);
                	fvalue number;
                    tTotalDetailAmount number;
                    tmp varchar2(100);
                	
                BEGIN
                  /*for vBookingDetail in
                        (
                        Select
                            sum(a.Amount) as TotalAmount
                        From BookingDetail a
                        Where a.Tno = :P93_Tno
                        )
                    loop
                        tTotalDetailAmount := vBookingDetail.TotalAmount;
                    end loop;*/
                    tTotalDetailAmount := base_amount;
                
                  open c2FooterSchemeDetail;
                  fetch c2FooterSchemeDetail into v2FooterSchemeDetail;
                  if c2FooterSchemeDetail%FOUND then
                  		if length(nvl(v2FooterSchemeDetail.Formula,''))>0 then
                  				myFormula := v2FooterSchemeDetail.Formula;
                  				myFormula := replace(myFormula, '.A.', nvl(tTotalDetailAmount,0) );
                  				for vFooterSchemeDetail  in cFooterSchemeDetail 
                  				loop
                					if head = vFooterSchemeDetail.FooterHeadCode then
                							isFound := 'YES';
                							myFormula := replace(myFormula, vFooterSchemeDetail.FooterHeadCode, nvl(result_value,0) );
                							exit;
                					end if;
                  				end loop;
                  				
                  					myFormula := replace(myFormula, v2FooterSchemeDetail.FooterHeadCode, nvl(percent,0) );
                  			
                  				for v3FooterSchemeDetail  in c3FooterSchemeDetail 
                  				loop
                  						myFormula := replace(myFormula, v3FooterSchemeDetail.FooterHeadCode, '0' );
                  				end loop;
                  				if (legend is null and NVL(GetMYparametervalue('LEGENDS'),'YES') = 'NO') then 
                					myFormula := replace(myFormula, v2FooterSchemeDetail.FooterHeadCode, nvl(percent,0));
                					result_value := getvalue(myformula);
                			    end if;
                
                                
                
                		  		if (legend is not null and  NVL(GetMyparametervalue('LEGENDS'),'NO')= 'YES') then 
                		  				select getvalue(myFormula) into  fvalue 	from dual;
                
                                          
                                      
                		  				if legend = 'PRA' then 
                		  					 	result_value := nvl(round(fvalue,0),0);
                		  					
                
                                                 
                                                
                		  				end if;
                		  				
                		  				if legend = 'PRD' then 
                		  						result_value := (-1)* nvl(round(fvalue,0),0);
                		  					
                		  				end if;
                							if legend is null then 
                									myFormula := replace(myFormula, v2FooterSchemeDetail.FooterHeadCode, nvl(percent,0));
                							end if;
                							if legend = 'PAA' then 
                		  						result_value := nvl(fvalue,0);
                							end if;
                							
                							if legend = 'PAD' then 
                		  						result_value := (-1)* nvl(abs(fvalue),0);
                							end if;
                		  		END IF;
                		  	
                  			
                  		end if;
                 end if;
                 end;
                end if;
                apex_json.open_object;apex_json.write('value',result_value);apex_json.close_object;end;
                ```
        }
        execution {
            sequence: 80
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 98202609281480003
        }
    )

