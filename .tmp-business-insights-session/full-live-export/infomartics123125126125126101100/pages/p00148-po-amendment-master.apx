                ```sql
                select A.TNO,
                       --A.SNO,
                       --DESCRIPTION,
                       A.ATTRIBUTEVALUE,
                       A.ATTACHMENTBLOB,
                       A.FILENAME,
                       A.ATTRIBUTECODE,
                       A.MODULETNO,
                       A.MODULESNO
