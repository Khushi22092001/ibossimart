    pageItem P148_PARTYCODE (
        type: popupLov
        label {
            label: Party Name
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select PARTYNAME d, PARTYCODE r
                  From (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) a
                 Where Exists (Select 1
                          From purchaseorder aa, purchaseorderdetail bb
                         Where aa.tno = bb.tno
                           And getpendingpoquantity1(bb.itemcode,
                                                     bb.itemspecificationcode,
                                                     bb.tno) > 0
                           And a.partycode = aa.partycode)
                ```
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @general
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @po-amendment-master
            column: PARTYCODE
            dataType: varchar2
        }
    )

