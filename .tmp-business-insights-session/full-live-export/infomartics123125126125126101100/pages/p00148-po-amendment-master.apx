    process save-all-edited-amendment-row-footers (
        name: Save all edited Amendment row footers
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 edits json_object_t;keys json_key_list;lines json_array_t;line json_object_t;own_sno number;own_rid varchar2(30);hits number;
                 r POAMENDMENTDETAILFOOTER%rowtype;empty_row POAMENDMENTDETAILFOOTER%rowtype;
                 type rows_t is table of POAMENDMENTDETAILFOOTER%rowtype;pending_rows rows_t:=rows_t();
                 type seen_t is table of boolean index by varchar2(100);seen seen_t;
                begin
                 if :P148_FD_EDITS is null then return;end if;
                 edits:=json_object_t.parse(:P148_FD_EDITS);keys:=edits.get_keys;
                 for i in 1..keys.count loop
                  own_sno:=to_number(keys(i));select count(*) into hits from POAMENDMENTDETAIL where tno=:P148_TNO and sno=own_sno;
                  if hits<>1 then raise_application_error(-20073,'Footer does not belong to exactly one saved PO Amendment detail.');end if;
                  lines:=edits.get_array(keys(i));pending_rows:=rows_t();seen.delete;
                  for k in 0..lines.get_size()-1 loop
                   line:=treat(lines.get(k) as json_object_t);r:=empty_row;
                   if nvl(line.get_number('TNO'),-1)<>:P148_TNO or nvl(line.get_number('SNO'),-1)<>own_sno then raise_application_error(-20073,'PO Amendment footer owner changed.');end if;
                   if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20073,'Select a footer head and legend.');end if;
                   own_rid:=line.get_string('ROWID');
                   if own_rid is not null then
                    if seen.exists(own_rid) then raise_application_error(-20073,'Duplicate PO Amendment footer identity.');end if;seen(own_rid):=true;
                    if not regexp_like(own_rid,'^t[0-9]+$') then
                     begin select * into r from POAMENDMENTDETAILFOOTER where rowid=chartorowid(own_rid) and tno=:P148_TNO and sno=own_sno;exception when no_data_found then raise_application_error(-20073,'PO Amendment footer ROWID is stale or belongs to another detail.');end;
                    end if;
                   end if;
                   r.tno:=:P148_TNO;r.sno:=own_sno;r.serialno:=k+1;
                   r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');
                   pending_rows.extend;pending_rows(pending_rows.count):=r;
                  end loop;
                  delete from POAMENDMENTDETAILFOOTER where tno=:P148_TNO and sno=own_sno;
                  for k in 1..pending_rows.count loop r:=pending_rows(k);insert into POAMENDMENTDETAILFOOTER values r;end loop;
                 end loop;
                end;
                
                ```
        }
        execution {
            sequence: 85
        }
        advanced {
            executionMappingIdentifier: 982026092814800085
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('SAVE','CREATE')
        }
    )

    process savepoamendmentfooter (
        name: SavePOAmendmentfooter
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    update poamendmentdetail d
                       set (footeramount,totalamount) = (
                           select nvl(sum(f.footervalue),0),
                                  nvl(d.amount,0) + nvl(sum(f.footervalue),0)
                             from poamendmentdetailfooter f
                            where f.tno=d.tno and f.sno=d.sno
                       )
                     where d.tno = :P148_TNO;
                
                    delete from poamendmentfooter where tno = :P148_TNO;
                    insert into poamendmentfooter
                        (tno ,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   select 
                                :P148_TNO , 
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from poamendmentdetailfooter
                            where tno = :P148_TNO
                            group by FOOTERHEADCODE
                        );
                end;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 158582132203931346
        }
    )

