    dynamicAction get-item-from-po (
        name: Get item from PO
        execution {
            sequence: 140
        }
        when {
            event: click
            selectionType: button
            button: @getitem
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    IMART_REFERENCE_SCOPE.assert_reference('PURCHASEORDER',:P148_PURCHASEORDERTNO,IMART_REFERENCE_SCOPE.company_code,'P148_PURCHASEORDERTNO');
                    --raise_application_error(-20003,:P118_DOCTYPECODE);
                    begin
                    --Inserting data in issue detail
                    delete from POAMENDMENTDETAIL where tno = :P148_TNO;
                    for vloop in (
                    select 
                    			:P148_TNO as tno,
                    			b.itemcode,
                    			b.itemspecificationcode,
                                b.description,
                                b.sno as sno,
                    			--globaltno.nextval as sno,
                                b.quantity1,
                                b.rate,
                                b.amount,
                                b.footeramount,
                                b.totalamount,
                                b.ratemeasuringunitcode
                                --A.TNO AS PTNO
                    from 
                    			Purchaseorder a, 
                    			PurchaseOrderdetail b,
                    			item e,
                    			itemspecification ee ,
                                ( SELECT BB.PURCHASEORDERTNO,
                                          CC.ITEMCODE,
                                          CC.ITEMSPECIFICATIONCODE,
                                          SUM(CC.RECEIVEDQUANTITY1) QUANTITY1, 
                                          SUM(CC.RECEIVEDQUANTITY2) QUANTITY2
                                 FROM grn Bb , grndetail Cc
                                 WHERE BB.TNO = CC.TNO
                                 And bb.PURCHASEORDERTNO = :P148_PURCHASEORDERTNO
                                 GROUP BY BB.PURCHASEORDERTNO,
                                          CC.ITEMCODE,
                                          CC.ITEMSPECIFICATIONCODE
                                 ) D 
                    where
                    			a.tno = b.tno
                    			and b.itemcode = e.itemcode
                    			and b.itemspecificationcode = ee.itemspecificationcode
                    			and a.tno = :P148_PURCHASEORDERTNO
                    			and b.tno = D.purchaseordertno(+)
                                and b.itemcode = D.itemcode(+)
                                and b.itemspecificationcode = D.itemspecificationcode(+)
                                and b.quantity1 - nvl(d.quantity1,0) > 0   
                    		
                    ) loop
                        insert into POAMENDMENTDETAIL
                            (
                                TNO,
                                ITEMCODE,
                                ITEMSPECIFICATIONCODE,
                                DESCRIPTION,
                                SNO,
                                Quantity1,
                                rate,
                                amount,
                                footeramount,
                                totalamount,
                                ratemeasuringunitcode,
                                AMENDMENTTYPECODE
                                --REQUISITIONTNO
                            ) values
                            (
                                vloop.tno,
                                 vloop.itemcode,
                                 vloop.itemspecificationcode,
                                 vloop.description,
                                 vloop.sno,
                                 vloop.quantity1,
                                 vloop.rate,
                                 vloop.amount,
                                 vloop.footeramount,
                                 vloop.totalamount,
                                 vloop.ratemeasuringunitcode,
                                 'ALTERATION'
                                 --vloop.PTNO
                            );
                    end loop;
                    
                    
                    -----Inserting data in footer detail------
                    for vloop1 in(
                        Select 
                                :P148_TNO as tno, 
                                c.sno,
                                c.footerheadcode,
                                c.footerpercent,
                                c.footervalue
                    from 
                    			Purchaseorder a, 
                    			PurchaseOrderdetail b,
                                PurchaseOrderdetailfooter c,
                    			item e,
                    			itemspecification ee
                    where
                    			a.tno = b.tno
                                and c.sno = b.sno
                                and b.tno = c.tno
                    			and b.itemcode = e.itemcode
                    			and b.itemspecificationcode = ee.itemspecificationcode
                    			and a.tno = :P148_PURCHASEORDERTNO
                    )loop
                        insert into POAMENDMENTDETAILFOOTER(
                            TNO,
                            SNO,
                            Footerheadcode,
                            footerpercent,
                            footervalue
                        )values(
                            vloop1.tno,
                            vloop1.sno,
                            vloop1.footerheadcode,
                            vloop1.footerpercent,
                            vloop1.footervalue
                        );
                    end loop;
                    end;
                    end;
                    ```
                itemsToSubmit: [
                    P148_TNO
                    P148_PURCHASEORDERTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

