    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P148_MODULEFLOW := 'YES';
                   else
                       :P148_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P148_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P148_ONTHETABLE := 'YES' ;
                   else
                       :P148_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 80
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 158810689331825679
        }
    )

