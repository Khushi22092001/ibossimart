    dynamicAction calculate-footer-total (
        name: Calculate Footer Total
        execution {
            sequence: 230
        }
        when {
            event: click
            selectionType: button
            button: @back
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("FooterDetail").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("FOOTERVALUE");
                    model.forEach(function(igrow, index, id) { var meta=model.getRecordMetadata(id)||{}; if(meta.deleted||meta.agg||meta.aggregate)return;
                        n_amt = parseFloat(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    if(Number(apex.item("P148_FVALUE").getValue()||0)!==n_totamt)apex.item("P148_FVALUE").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calculate-sum-of-amount-value-on-loose-focus (
        name: Calculate Sum of Amount Value on Loose focus
        execution {
            sequence: 190
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail
            columns: [
                AMOUNT
                FD
                FOOTERAMOUNT
                TOTALAMOUNT
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("AMOUNT");
                    var footerKey = model.getFieldKey("FOOTERAMOUNT");
                    var grandtotalKey = model.getFieldKey("TOTALAMOUNT");
                    var totalAmt = 0;
                    var footerAmt = 0;
                    var grandtotalAmt = 0;
                    
                    model.forEach(function(r, index, id) { var meta=model.getRecordMetadata(id)||{}; if(meta.deleted||meta.agg||meta.aggregate)return;
                      var total = parseFloat(r[totalKey], 10);
                      var footer = parseFloat(r[footerKey], 10);
                      var grandtotal = parseFloat(r[grandtotalKey], 10);
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                      if (!isNaN(footer)) {
                        footerAmt += footer;
                      }
                    
                      if (!isNaN(grandtotal)) {
                        grandtotalAmt += grandtotal;
                      }
                    });
                    
                    $s("P148_SUMOFAMOUNT", totalAmt);
                    $s("P148_SUMOFFOOTERAMOUNT", footerAmt);
                    $s("P148_PoAmendmentAMOUNT", grandtotalAmt);
                    	
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :TOTALAMOUNT
                itemsToSubmit: TOTALAMOUNT
            }
            affectedElements {
                selectionType: items
                items: P148_POAMENDMENTAMOUNT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-qty-with-indent (
        name: check qty with indent
        execution {
            sequence: 365
        }
        when {
            selectionType: columns
            interactiveGrid: @detail
            columns: [
                QUANTITY1
                QUANTITY2
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        qty1 number ;
                    begin
                        select quantity1 into qty1 from indentdetail 
                        where tno in (
                                        select indenttno from purchaseorder 
                                        where tno = :P148_PURCHASEORDERTNO
                                     )
                        and itemcode = :itemcode
                        and itemspecificationcode = :itemspecificationcode;
                    
                        --raise_application_error(-20000 , 'Quantity mismatch.-'||:quantity1||'-'||qty1);
                    
                        if to_number(:quantity1) > qty1 then
                            --raise_application_error(-20000 , 'Quantity mismatch.'||:quantity1||'-'||qty1);
                            :quantity1 := 0;
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P148_PURCHASEORDERTNO
                    ITEMCODE
                    ITEMSPECIFICATIONCODE
                    QUANTITY1
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        qty1 number ;
                    begin
                        select quantity1 into qty1 from indentdetail 
                        where tno in (
                                        select indenttno from purchaseorder 
                                        where tno = :P148_PURCHASEORDERTNO
                                     )
                        and itemcode = :itemcode
                        and itemspecificationcode = :itemspecificationcode;
                    
                        raise_application_error(-20000 , 'Quantity mismatch. Indent Qty -'||qty1);
                     
                    end;
                    ```
                itemsToSubmit: [
                    P148_PURCHASEORDERTNO
                    ITEMCODE
                    ITEMSPECIFICATIONCODE
                    QUANTITY1
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: QUANTITY1
                value: .000
            }
            serverSideCondition {
                type: never
            }
        )

    )

