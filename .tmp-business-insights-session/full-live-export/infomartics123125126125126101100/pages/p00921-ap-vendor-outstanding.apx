page 921 (
    name: Vendor-wise Payable
    alias: AP-VENDOR-OUTSTANDING
    title: Vendor-wise Payable
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #APP_FILES#hspl-jet-l10n-fallback.js?version=#APP_VERSION#&cb=20260924a
    }
    htmlHeader {
        htmlHeader:
            ```html
            
            <script id="hspl-sidebar-head-state">
            (function(d){
              var state='closed';
              try {
                var saved=window.localStorage.getItem('imart.sidebar.state.v1');
                if(saved==='open'||saved==='closed') state=saved;
              } catch(ignore) {}
              d.classList.remove(state==='open'?'hspl-nav-target-closed':'hspl-nav-target-open');
              d.classList.add(state==='open'?'hspl-nav-target-open':'hspl-nav-target-closed');
            })(document.documentElement);
            </script>
            ```
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: One row per vendor, aggregated from the same canonical open-item layer as the command centre - so this page and page 708 cannot disagree. Payable and Vendor Debits are shown as two separate columns rather than netted, because a vendor holding both is the single most actionable position in this ledger (1,414 vendors do, with Rs 338.22 Cr clearable by allocation alone). Credit limit and credit utilisation are absent because this ERP holds no credit-limit data at all: Party.CreditAmount is greater than zero on 0 creditor accounts.
    }

    region command-header (
        name: Vendor-wise Payable
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-ap-head">'
                    || '<div class="ds-ap-eyebrow">Payables &middot; Vendor Summary</div>'
                    || '<h1 class="ds-ap-title">Vendor-wise Payable</h1>'
                    || '<div class="ds-ap-sub">Every vendor''s payable, debits held, net liability and ageing profile as at the As-of Date. Click a vendor for Creditor 360.</div>'
                    || '<div class="ds-ap-context">'
                    || '<span class="ds-ap-chip"><span class="fa fa-crosshairs"></span>Outstanding as at <b>' || :P921_TODATE || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-hourglass-half"></span>Ageing basis <b>'
                       || Case When :P921_AGEBASIS = 'DOC' Then 'Document date (age)' Else 'Due date (lateness)' End || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P921_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P921_LOCATION),'All locations')) || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
            pageItemsToSubmit: [
                P921_FROMDATE
                P921_TODATE
                P921_COMPANY
                P921_LOCATION
                P921_AGEBASIS
            ]
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-ap-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

