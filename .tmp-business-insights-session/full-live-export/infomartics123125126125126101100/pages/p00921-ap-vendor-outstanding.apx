            action: redirectThisApp
            target: {
                page: 920
                items: {
                    P920_FROMDATE: &P921_FROMDATE.
                    P920_TODATE: &P921_TODATE.
                    P920_COMPANY: &P921_COMPANY.
                    P920_LOCATION: &P921_LOCATION.
                    P920_AGEBASIS: &P921_AGEBASIS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

