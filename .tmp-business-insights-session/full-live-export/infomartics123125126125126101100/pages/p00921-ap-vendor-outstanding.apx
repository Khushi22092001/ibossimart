        column EXCEPTION_COUNT (
            type: link
            heading {
                heading: Exceptions
                alignment: end
            }
            layout {
                sequence: 290
                columnAlignment: end
            }
            link {
                target: {
                    page: 927
                    items: {
                        P927_FROMDATE: &P921_FROMDATE.
                        P927_TODATE: &P921_TODATE.
                        P927_COMPANY: &P921_COMPANY.
                        P927_LOCATION: &P921_LOCATION.
                        P927_CATEGORY: ALL
                    }
                    clearCache: 927
                }
                linkText: #EXCEPTION_COUNT#
            }
