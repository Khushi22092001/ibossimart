            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
