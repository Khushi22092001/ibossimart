            link {
                target: {
                    page: 929
                    items: {
                        P929_TNO: #VOUCHER_TNO#
                        P929_SNO: #VOUCHER_SNO#
                        P929_TODATE: &P922_TODATE.
                        P929_FROMDATE: &P922_FROMDATE.
                        P929_PARTY: #PARTY_CODE#
                    }
                    clearCache: 929
                }
                linkText: #BILL_REFERENCE#
            }
