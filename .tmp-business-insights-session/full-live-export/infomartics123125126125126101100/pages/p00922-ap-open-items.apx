                        P923_COMPANY: &P922_COMPANY.
                        P923_LOCATION: &P922_LOCATION.
                        P923_AGEBASIS: &P922_AGEBASIS.
                    }
                    clearCache: 923
                }
                linkText: #CUSTOMER#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

