        column CUSTOMER (
            type: link
            heading {
                heading: Vendor
            }
            layout {
                sequence: 30
            }
            link {
                target: {
                    page: 923
                    items: {
                        P923_PARTY: #PARTY_CODE#
                        P923_FROMDATE: &P922_FROMDATE.
