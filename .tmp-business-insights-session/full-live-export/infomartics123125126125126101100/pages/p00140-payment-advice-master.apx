    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action imart-payment-dirty-activation (
            action: executeJsCode
            settings {
                jsCode: "if(apex.item('P140_STATUS').getValue()==='ACTIVE'&&window.imartPaymentUnsaved&&window.imartPaymentUnsaved()){apex.da.cancel();apex.message.showErrors([{type:'error',location:'page',message:'Save Payment Advice header and detail changes before making it Active.',unsafe:false}]);}"
            }
            execution {
                sequence: 1
                fireOnInit: false
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P140_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P140_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare l_guard boolean := :P140_STATUS='ACTIVE'; l_started boolean:=false; begin
                     savepoint imart_activation_request;
                     if l_guard then imart_txn_integrity.begin_change('PAYMENTADVICE',:P140_TNO);l_started:=true;end if;
                     SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P140_TNO,:P140_STATUS);
                    IF :P140_STATUS = 'ACTIVE' then
                        postpaymentadvice(:P140_TNO,:P140_PAYMENTADVICEDATE);
                    END IF;
                     if l_started then imart_txn_integrity.finish_change('PAYMENTADVICE',:P140_TNO);l_started:=false;end if;
                     exception when others then
                     if l_started then imart_txn_integrity.abort_change('PAYMENTADVICE',:P140_TNO);end if;
                     begin rollback to imart_activation_request;exception when others then null;end;
                     raise;
                    end;
                    ```
                itemsToSubmit: [
                    P140_TNO
                    P140_STATUS
                    P140_PAYMENTADVICEDATE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P140_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @buttons
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P140_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

