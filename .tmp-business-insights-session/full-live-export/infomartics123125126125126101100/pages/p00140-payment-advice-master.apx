    process p140-tax-context (
        name: P140_TAX_CONTEXT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare l_entered number:=json_object_t.parse(apex_application.g_x01).get_number('entered');l_catchup number;begin
                declare
                	tExpenseAmount Number;
                	tThisExpenseAmount Number;
                	tTDSAmount Number;
                	tTotalExpenseAmount Number;
                	tSumOfAmountEntered number;
                begin
                  :P140_TDSPERCENT:=0;:P140_TDSCESSPERCENT:=0;:P140_TDSSURCHARGEPERCENT:=0;:P140_TOTALTDSPERCENT:=0;:P140_TDSTHRESHOLD:=0;:P140_TDSTRANSACTIONTHRESHOLD:=0;:P140_THRESHOLDPLUSMINUS:=0;:P140_DEDUCTIONSTARTABOVEAMOUNT:=0;
                	tSumOfAmountEntered:=l_entered;
                	----
                    for vParty in
                    	(
                    	select 
                    		a.TDSPayeeCategoryCode,
                            b.TDSPayeeCategoryName,
                    		a.IncomeTaxReturnTillDate,
                    		a.EligibleForTDSUnder194Q
                    	from Party a, TDSPayeeCategory b
                    	where a.TDSPayeeCategoryCode = b.TDSPayeeCategoryCode(+)
                            and a.PartyCode = :P140_PartyCode 
                    	)
                    loop 
                    	:P140_TDSPayeeCategoryCode 		:= vParty.TDSPayeeCategoryCode;
                        :P140_TDSPayeeCategoryName 		:= vParty.TDSPayeeCategoryName;
                    	:P140_IncomeTaxReturnTillDate 	:= vParty.IncomeTaxReturnTillDate;
                    	:P140_EligibleForTDSUnder194Q	:= vParty.EligibleForTDSUnder194Q;
                    end loop;
                	----
                	:P140_TDSTaxCategoryCode := GetTDSTaxCategoryCode(:P140_TDSPayeeCategoryCode, :P140_TDSNatureCode, :P140_PaymentAdviceDate);
                	:P140_PANNo := GetPartyAttributeValue(:P140_PartyCode, 'PANNO');
                	----
                	for vTDSTaxCategory in
                		(
                		select
                			b.TotalTDSPercentWithPAN,
                			b.TotalTDSPercentWithoutPAN,
                			b.Threshold,
                			b.TransactionThreshold,
                			b.DeductionStartAboveAmount,
                			a.YearsWithoutReturn,
                            b.TDSPayeeCategoryCode,
                            b.TDSPercentWithPAN,
                            b.TDSPercentWithoutPAN,
                            b.CessPercentWithPAN,
                            b.CessPercentWithoutPAN,     
                            b.SurchargePercentWithPAN,
                            b.SurchargePercentWithoutPAN, b.TDSPercentWithoutReturn, b.CessPercentWithoutReturn, b.SurchargePercentWithoutReturn
                		from TDSTaxCategory a, TDSTaxCategoryDetail b
                		where a.TNo = b.TNo 
                			and a.TDSTaxCategoryCode = :P140_TDSTaxCategoryCode
                			and b.TDSPayeeCategoryCode = :P140_TDSPayeeCategoryCode
                		)
                	loop
                		:P140_TDSThreshold := vTDSTaxCategory.Threshold;
                		:P140_DeductionStartAboveAmount := vTDSTaxCategory.DeductionStartAboveAmount;
                		:P140_YearsWithoutReturn := vTDSTaxCategory.YearsWithoutReturn;
                		----
                		if nvl(vTDSTaxCategory.TransactionThreshold, 0) <= 0 then 
                			:P140_TDSTransactionThreshold := :P140_TDSThreshold;
                		else 
                			:P140_TDSTransactionThreshold := vTDSTaxCategory.TransactionThreshold;
                		end if;
                		----
                		if :P140_PANNo is null then
                   :P140_TDSPERCENT:=vTDSTaxCategory.TDSPercentWithoutPAN;:P140_TDSCESSPERCENT:=vTDSTaxCategory.CessPercentWithoutPAN;:P140_TDSSURCHARGEPERCENT:=vTDSTaxCategory.SurchargePercentWithoutPAN;
                  elsif floor(months_between(to_date(:P140_PAYMENTADVICEDATE,'DD-MM-RRRR'),nvl(to_date(:P140_INCOMETAXRETURNTILLDATE,'DD-MM-RRRR'),date '2000-03-31'))/12)>=:P140_YEARSWITHOUTRETURN then
                   :P140_TDSPERCENT:=vTDSTaxCategory.TDSPercentWithoutReturn;:P140_TDSCESSPERCENT:=vTDSTaxCategory.CessPercentWithoutReturn;:P140_TDSSURCHARGEPERCENT:=vTDSTaxCategory.SurchargePercentWithoutReturn;
                  elsif :P140_TDSLOWERRATEAPPLICABLE='YES' then
                   :P140_TDSPERCENT:=:P140_TDSLOWERRATE;:P140_TDSCESSPERCENT:=:P140_CESSLOWERRATE;:P140_TDSSURCHARGEPERCENT:=:P140_SURCHARGELOWERRATE;
                  else
                   :P140_TDSPERCENT:=vTDSTaxCategory.TDSPercentWithPAN;:P140_TDSCESSPERCENT:=vTDSTaxCategory.CessPercentWithPAN;:P140_TDSSURCHARGEPERCENT:=vTDSTaxCategory.SurchargePercentWithPAN;
                  end if;
                  :P140_TOTALTDSPERCENT:=nvl(:P140_TDSPERCENT,0)+nvl(:P140_TDSCESSPERCENT,0)+nvl(:P140_TDSSURCHARGEPERCENT,0);
                  if :P140_TDSONOVERANDABOVE='YES' and :P140_TOTALTDSPERCENT>=100 then raise_application_error(-20074,'TDS gross-up percentage must be below 100');end if;
                		exit;
                	end loop;
                	----
                	if nvl(:P140_TDSThreshold, 0) > 0 then 
                		select 
                			sum(b.ExpenseAmount),
                			sum(b.TDSAmount)
                			into tExpenseAmount, tTDSAmount
                		from Voucher a, VoucherTDSDeducted b 
                		where a.TNo = b.TNo 
                			and b.PartyCode = :P140_PartyCode
                			and a.FinancialYearCode=:P140_FinancialYearCode and a.CompanyCode=:GLOBAL_COMPANYCODE and not(a.ModuleCode='PAYMENTADVICE' and a.ModuleTNo=:P140_TNO)
                			and b.TDSNatureCode = :P140_TDSNatureCode
                		;
                		----
                		if nvl(tTDSAmount, 0) > 0 then 
                			:P140_ThresholdPlusMinus := 0;
                		else
                			select 
                				sum(-1 * b.ThresholdPlusMinus)
                				into tExpenseAmount
                			from Voucher a, VoucherTDSDeducted b 
                			where a.TNo = b.TNo 
                				and b.PartyCode = :P140_PartyCode
                				and a.FinancialYearCode=:P140_FinancialYearCode and a.CompanyCode=:GLOBAL_COMPANYCODE and not(a.ModuleCode='PAYMENTADVICE' and a.ModuleTNo=:P140_TNO)
                				and b.ThresholdPlusMinus < 0
                				and b.AdvanceOrBill = 'ADVANCE'
                				and b.TDSNatureCode = :P140_TDSNatureCode
                				and a.VoucherNo != 'OPENING'
                			;
                			----
                			if nvl(tSumOfAmountEntered, 0) > 0 then 
                				if :P140_TDSOnOverAndAbove = 'YES' then
                					tThisExpenseAmount := round(( ( tSumOfAmountEntered + NVL(tExpenseAmount, 0) )* 100 ) / (100 - NVL(:P140_TOTALTDSPERCENT, 0) ), 0);
                				else 
                					tThisExpenseAmount :=  nvl(tSumOfAmountEntered, 0);
                				end if;
                			else
                				if :P140_TDSOnOverAndAbove = 'YES' then
                					tThisExpenseAmount := round(( ( :P140_AmountDrEntered + NVL(tExpenseAmount, 0) ) * 100 ) 	/ (100 - NVL(:P140_TOTALTDSPERCENT, 0) ), 0);		
                				else 
                					tThisExpenseAmount := nvl(:P140_AmountDrEntered, 0);
                				end if;
                			end if;	 --	if nvl(tSumOfAmountEntered, 0) > 0 then 	
                			----
                			tTotalExpenseAmount := nvl(tExpenseAmount, 0) + nvl(tThisExpenseAmount, 0);
                			----
                			if nvl(tTotalExpenseAmount, 0) > nvl(:P140_TDSThreshold, 0) or tThisExpenseAmount > nvl(:P140_TDSTransactionThreshold, 0) then 
                				:P140_ThresholdPlusMinus := tExpenseAmount;
                			else 
                				:P140_ThresholdPlusMinus := -1 * tThisExpenseAmount;
                			end if;
                		end if;  -- if nv(tTDSAmount, 0) > 0 then
                	end if; -- if nvl(:P140_TDSThreshold, 0) > 0 then 
                	----
                	select 
                		sum(a.AmountDr) 
                		into :P140_TotalPaymentAmountForTheFY
                	from PaymentAdvice a, Voucher b 
                	where a.TNo=b.ModuleTNo and b.ModuleCode='PAYMENTADVICE' and b.CompanyCode=:GLOBAL_COMPANYCODE and a.TNo<>:P140_TNO
                		and a.PartyCode = :P140_PartyCode
                		and b.FinancialYearCode = :P140_FinancialYearCode
                	;
                end;
                select nvl(sum(-b.thresholdplusminus),0) into l_catchup from voucher a join vouchertdsdeducted b on b.tno=a.tno where b.partycode=:P140_PARTYCODE and a.companycode=:GLOBAL_COMPANYCODE and a.financialyearcode=:P140_FINANCIALYEARCODE and b.advanceorbill='ADVANCE' and b.tdsnaturecode=:P140_TDSNATURECODE and b.thresholdplusminus<0 and not(a.modulecode='PAYMENTADVICE' and a.moduletno=:P140_TNO);
                apex_json.open_object;apex_json.write('TDSPERCENT',:P140_TDSPERCENT,true);
                apex_json.write('TDSCESSPERCENT',:P140_TDSCESSPERCENT,true);
                apex_json.write('TDSSURCHARGEPERCENT',:P140_TDSSURCHARGEPERCENT,true);
                apex_json.write('TOTALTDSPERCENT',:P140_TOTALTDSPERCENT,true);
                apex_json.write('TDSTHRESHOLD',:P140_TDSTHRESHOLD,true);
                apex_json.write('TDSTRANSACTIONTHRESHOLD',:P140_TDSTRANSACTIONTHRESHOLD,true);
                apex_json.write('THRESHOLDPLUSMINUS',:P140_THRESHOLDPLUSMINUS,true);
                apex_json.write('TOTALPAYMENTAMOUNTFORTHEFY',:P140_TOTALPAYMENTAMOUNTFORTHEFY,true);
                apex_json.write('DEDUCTIONSTARTABOVEAMOUNT',:P140_DEDUCTIONSTARTABOVEAMOUNT,true);
                apex_json.write('ELIGIBLEFORTDSUNDER194Q',:P140_ELIGIBLEFORTDSUNDER194Q,true);
                apex_json.write('TDSTAXCATEGORYCODE',:P140_TDSTAXCATEGORYCODE,true);
                apex_json.write('CATCHUPAMOUNT',l_catchup,true);apex_json.close_object;end;
                ```
        }
        execution {
            sequence: 85
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99014020260929006
        }
    )

