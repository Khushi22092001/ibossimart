    dynamicAction calculate-net-amount (
        name: Calculate Net Amount
        execution {
            sequence: 110
        }
        when {
            event: focusout
            selectionType: items
            items: P140_TDSAMOUNT
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(:P140_AMOUNTDR,0) - nvl(:P140_TDSAMOUNT,0) 
                    from dual
                    ```
                itemsToSubmit: [
                    P140_AMOUNTDR
                    P140_TDSAMOUNT
                ]
            }
            affectedElements {
                selectionType: items
                items: P140_AMOUNTCR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction calculate-net-amount-2 (
        name: calculate net amount
        execution {
            sequence: 240
        }
        when {
            selectionType: items
            items: P140_TDSAMOUNT
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: NVL(:P140_AMOUNTDR,0) - NVL(:P140_TDSAMOUNT,0)
                itemsToSubmit: [
                    P140_AMOUNTDR
                    P140_TDSAMOUNT
                ]
            }
            affectedElements {
                selectionType: items
                items: P140_AMOUNTCR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction calculate-total-amount (
        name: Calculate total amount
        execution {
            sequence: 160
        }
        when {
            selectionType: columns
            interactiveGrid: @payment-advice-reference
            columns: [
                TDSDEDUCTABLEAMOUNT
                AMOUNTENTERED
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("detail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("AMOUNTENTERED");
                    
                    var totalAmt = 0;
                    
                    
                    model.forEach(function(r, index, id) {
                         meta = model.getRecordMetadata(id);
                      var total = parseFloat(r[totalKey], 10);
                    
                      if (!isNaN(total) && !meta.deleted && !meta.agg) {
                        totalAmt += total;
                      }
                    
                    });
                    
                    $s("P140_AMOUNTDR", totalAmt.toFixed(2));
                    $s("P140_AMOUNTCR", totalAmt.toFixed(2));
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    (function(){
                    let model = apex.region("detail").widget().interactiveGrid("getViews", "grid").model; // retrieve the model
                    let amount_total = 0;
                    let amountentered_total = 0;
                    let tdsdeductable_total = 0;
                    let tds_total = 0;
                    
                    
                    model.forEach(function(record, index, id) {
                        meta = model.getRecordMetadata(id);
                        if (model.getValue(record, "AMOUNT") !== "" && !meta.deleted && !meta.agg) {
                            amount_total += Number(model.getValue(record, "AMOUNT"));
                        }
                        if (model.getValue(record, "AMOUNTENTERED") !== "" && !meta.deleted && !meta.agg) {
                            amountentered_total += Number(model.getValue(record, "AMOUNTENTERED"));
                        }
                        if (model.getValue(record, "TDSDEDUCTABLEAMOUNT") !== "" && !meta.deleted && !meta.agg) {
                            tdsdeductable_total += Number(model.getValue(record, "TDSDEDUCTABLEAMOUNT"));
                        }
                        if (model.getValue(record, "TDSAMOUNT") !== "" && !meta.deleted && !meta.agg) {
                            tds_total += Number(model.getValue(record, "TDSAMOUNT"));
                        }
                            
                    });
                    
                    $s('P140_AMOUNTDR',amountentered_total);
                    $s('P140_TDSDEDUCTABLEAMOUNT',tdsdeductable_total);
                    $s('P140_TDSAMOUNT',tds_total);
                    
                    $s('P140_TOTALTDSAMOUNT',tds_total);
                    
                    }());
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :AMOUNTENTERED
                itemsToSubmit: [
                    AMOUNTENTERED
                    TDSDEDUCTABLEAMOUNT
                ]
            }
            affectedElements {
                selectionType: columns
                columns: TDSDEDUCTABLEAMOUNT
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    and a.CompanyCode = :GLOBAL_COMPANYCODE
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P140_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    and a.CompanyCode = :GLOBAL_COMPANYCODE
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
        execution {
            sequence: 90
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @print
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
