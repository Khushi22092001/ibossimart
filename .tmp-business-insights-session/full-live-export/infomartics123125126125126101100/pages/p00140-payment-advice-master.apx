            /* WORKFLOW_LAYOUT_HORIZONTAL_HEADER_SYNC_V1 */
            (function () {
              function bindGrid(grid) {
                var body = grid.querySelector('.a-GV-bdy');
                var header = grid.querySelector('.a-GV-w-hdr');
                if (!body || !header || body.dataset.workflowHorizontalSync === 'Y') { return; }
            
                body.dataset.workflowHorizontalSync = 'Y';
                header.scrollLeft = body.scrollLeft;
                body.addEventListener('scroll', function () {
                  header.scrollLeft = body.scrollLeft;
                }, { passive: true });
              }
            
              function bindAll() {
                Array.prototype.forEach.call(document.querySelectorAll('.a-IG'), bindGrid);
              }
            
              function scheduleBinding() { window.setTimeout(bindAll, 0); }
              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', scheduleBinding, { once: true });
              } else {
                scheduleBinding();
              }
              document.addEventListener('click', scheduleBinding);
              new MutationObserver(scheduleBinding).observe(document.documentElement, {
                childList: true,
                subtree: true
              });
            }());
            
            /* HSPL_CROSSFORM_DETAIL_INTEGRITY_V1 */
            (function(){
              "use strict";
              if(Number(apex.env.APP_PAGE_ID||0)!==140||window.hsplCrossformDetailIntegrityV1)return;
              window.hsplCrossformDetailIntegrityV1=true;
              var heldFromDetail=false;
              function inDetail(target){return !!(target&&target.closest&&target.closest("#detail,#Detail_ig"));}
              document.addEventListener("keydown",function(event){
                if(event.key!=="Tab")return;
                if(!event.repeat){heldFromDetail=inDetail(event.target);return;}
                if(heldFromDetail){event.preventDefault();event.stopImmediatePropagation();}
              },true);
              document.addEventListener("keyup",function(event){if(event.key==="Tab")heldFromDetail=false;},true);
              window.addEventListener("blur",function(){heldFromDetail=false;});
              
            })();
            
            
            /* IMART_PAYMENT_MODEL_V2: one record calculation owns money and summaries. */
            (function(){
             var regionId='detail',model,applying=false,revision=0,pending=0,contextError=false,initialHeader;
             var headerFields=['PARTYCODE','PAYMENTADVICEDATE','LOCATIONCODE','DOCTYPECODE','ACCOUNTCODE','PAYMENTFORLOCATIONCODE','MONEYTRANSFERMODECODE','MONEYTRANSFERREFERENCENO','COSTCENTRECODE','NARRATION','REMARK','AMOUNTDRENTERED','TDSNATURECODE','TDSONOVERANDABOVE','TDSLOWERRATEAPPLICABLE','TDSLOWERRATE','CESSLOWERRATE','SURCHARGELOWERRATE','ROUNDINGMETHODCODE','ROUNDINGAMOUNT'];
             function raw(v){return v&&typeof v==='object'&&'v' in v?v.v:v;}
             function n(v){return Number(String(raw(v)||0).replace(/,/g,''))||0;}
             function round(v,p){var m=Math.pow(10,p==null?2:p);return Math.sign(v)*Math.round((Math.abs(v)+Number.EPSILON*Math.max(1,Math.abs(v)))*m)/m;}
             function h(f){return raw(apex.item('P140_'+f).getValue());}
             function seth(f,v){apex.item('P140_'+f).setValue(String(v),null,true);}
             function value(r,f){return raw(model.getValue(r,f));}
             function put(r,f,v){if(n(value(r,f))!==v)model.setValue(r,f,String(v));}
             function rows(){var a=[];model.forEach(function(r,i,id){var m=model.getRecordMetadata(id)||{};if(!m.deleted&&!m.agg&&value(r,'AMOUNTENTERED')!==''&&value(r,'AMOUNTENTERED')!=null)a.push(r);});return a;}
             function advance(r){return ['JOBORDER','PURCHASEORDER','CCINVOICE','GRN','LOADINGADVICE'].indexOf(value(r,'REFERENCEMODULECODE'))>=0;}
             function calculate(){if(!model||applying)return;applying=true;try{
              var rs=rows(),entered=rs.reduce(function(a,r){return a+n(value(r,'AMOUNTENTERED'));},0),dr=0,noTax=0,totalPercent=n(h('TOTALTDSPERCENT')),over=h('TDSONOVERANDABOVE')==='YES',threshold=n(h('THRESHOLDPLUSMINUS')),catchup=n(h('CATCHUPAMOUNT')),anyAdvance=!rs.length;
              if(over&&totalPercent>=100)return;
              rs.forEach(function(r){var e=n(value(r,'AMOUNTENTERED')),a=e,eligible=advance(r);anyAdvance=anyAdvance||eligible;
               if(eligible&&over&&threshold>=0){var share=round(catchup*e/(entered||1),0);a=round((e+share)*100/(100-totalPercent),0)-share;}
               put(r,'AMOUNT',a);dr+=a;if(!eligible)noTax+=e;
              });
              if(!rs.length){dr=n(h('AMOUNTDRENTERED'));if(over&&threshold>=0)dr=round((dr+catchup)*100/(100-totalPercent),0)-catchup;}
              var base=anyAdvance&&h('DOCTYPECODE')!=='EMIREVERSAL'&&(n(h('TOTALPAYMENTAMOUNTFORTHEFY'))+dr>n(h('DEDUCTIONSTARTABOVEAMOUNT'))||h('ELIGIBLEFORTDSUNDER194Q')==='YES')?Math.max(0,dr+threshold-noTax):0;
              var tax=round(base*n(h('TDSPERCENT'))/100),cess=round(base*n(h('TDSCESSPERCENT'))/100),sur=round(base*n(h('TDSSURCHARGEPERCENT'))/100),all=round(tax+cess+sur);
              var weighted=rs.filter(function(r){return advance(r)&&n(value(r,'AMOUNT'))>0;}),weight=weighted.reduce(function(a,r){return a+n(value(r,'AMOUNT'));},0),leftTax=tax,leftBase=base;
              rs.forEach(function(r){put(r,'TDSAMOUNT',0);put(r,'TDSDEDUCTABLEAMOUNT',0);});
              weighted.forEach(function(r,i){var t=i===weighted.length-1?leftTax:round(tax*n(value(r,'AMOUNT'))/weight),b=i===weighted.length-1?leftBase:round(base*n(value(r,'AMOUNT'))/weight);put(r,'TDSAMOUNT',t);put(r,'TDSDEDUCTABLEAMOUNT',b);leftTax-=t;leftBase-=b;});
              var before=round(dr-all),rounding=n(h('ROUNDINGAMOUNT'));if(h('ROUNDINGMETHODCODE')==='AUTO'){rounding=round(round(before,0)-before);seth('ROUNDINGAMOUNT',rounding);}
              [['AMOUNTDR',dr],['AMOUNT',dr],['TDSDEDUCTABLEAMOUNT',base],['TDSAMOUNT',tax],['TDSCESSAMOUNT',cess],['TDSSURCHARGEAMOUNT',sur],['TOTALTDSAMOUNT',all],['BEFOREROUNDEDAMOUNTCR',before],['AMOUNTCR',round(before+rounding)]].forEach(function(x){seth(x[0],x[1]);});
             }finally{applying=false;}}
             function refreshContext(){if(!model)return;var own=++revision,entered=rows().reduce(function(a,r){return a+n(value(r,'AMOUNTENTERED'));},0);pending++;contextError=false;
              apex.server.process('P140_TAX_CONTEXT',{x01:JSON.stringify({entered:entered}),pageItems:'#P140_TNO,#P140_PARTYCODE,#P140_FINANCIALYEARCODE,#P140_PAYMENTADVICEDATE,#P140_TDSNATURECODE,#P140_TDSONOVERANDABOVE,#P140_AMOUNTDRENTERED,#P140_TDSLOWERRATEAPPLICABLE,#P140_TDSLOWERRATE,#P140_CESSLOWERRATE,#P140_SURCHARGELOWERRATE'},{dataType:'json'}).done(function(result){if(own!==revision)return;Object.keys(result).forEach(function(f){seth(f,result[f]==null?'':result[f]);});calculate();}).fail(function(){if(own===revision){contextError=true;apex.message.showErrors([{type:'error',location:'page',message:'Payment tax context could not load. Retry the change before saving.',unsafe:false}]);}}).always(function(){pending--;});
             }
             function bind(){var view;try{view=apex.region(regionId).widget().interactiveGrid('getViews','grid');}catch(ignore){return;}if(!view||!view.model||view.model.imartPaymentModel)return;model=view.model;model.imartPaymentModel=true;
              if(!initialHeader){initialHeader={};headerFields.forEach(function(f){initialHeader[f]=String(h(f)||'');});}
              model.subscribe({onChange:function(type,data){if(applying)return;
               if(type==='set'&&data&&['AMOUNTENTERED','TDSDEDUCTABLEAMOUNT','TDSAMOUNT'].indexOf(data.field)<0)return;
               calculate();if(type==='set'&&data&&data.field==='AMOUNTENTERED'||['delete','insert','refresh','clearChanges'].indexOf(type)>=0)refreshContext();
              }});refreshContext();
             }
             window.imartPaymentUnsaved=function(){return pending>0||contextError||!!(model&&model.isChanged&&model.isChanged())||!!(initialHeader&&headerFields.some(function(f){return String(h(f)||'')!==initialHeader[f];}));};
             apex.jQuery(bind);apex.jQuery(document).on('interactivegridviewmodelcreate.imartPayment apexafterrefresh.imartPayment',bind);
             apex.jQuery(document).on('change.imartPayment','#P140_PARTYCODE,#P140_TDSNATURECODE,#P140_PAYMENTADVICEDATE,#P140_TDSONOVERANDABOVE,#P140_AMOUNTDRENTERED,#P140_TDSLOWERRATEAPPLICABLE,#P140_TDSLOWERRATE,#P140_CESSLOWERRATE,#P140_SURCHARGELOWERRATE',function(){calculate();refreshContext();});
             apex.jQuery(document).on('change.imartPayment','#P140_ROUNDINGAMOUNT,#P140_ROUNDINGMETHODCODE',calculate);
             apex.jQuery(document).on('apexbeforepagesubmit.imartPayment',function(event,request){if(['SAVE','CREATE'].indexOf(request)>=0&&(pending>0||contextError)){event.preventDefault();apex.message.showErrors([{type:'error',location:'page',message:'Wait for Payment Advice tax calculation to finish before saving.',unsafe:false}]);return false;}});
            }());
            
            
            
            /* P2P_ROW_LOOKUPS_V1: asynchronous defaults belong to the originating record. */
            (function(){
             var page=Number(apex.env.APP_PAGE_ID),regionId=page===156?'VOUCHERDETAIL':page===140?'detail':'Detail';
             function raw(v){return v&&typeof v==='object'&&'v' in v?v.v:v;}
             function view(){try{return apex.region(regionId).widget().interactiveGrid('getViews','grid');}catch(ignore){return null;}}
             function bind(){var v=view();if(!v||!v.model||v.model.hsplRowLookups)return;var model=v.model,states={},applying=false;model.hsplRowLookups=true;
              function value(r,f){return raw(model.getValue(r,f));}
              function alive(r,id){var current=view();return current&&current.model===model&&model.getRecord(id)===r&&!(model.getRecordMetadata(id)||{}).deleted;}
              model.subscribe({onChange:function(type,data){if(applying||!data)return;var r=data.record||model.getRecord(data.recordId);if(!r||!['set','insert'].includes(type))return;
               var id=model.getRecordId(r),s=states[id]||(states[id]={revision:0});s.revision++;
               var identity=page===156;if(identity){if(value(r,'SNO')||s.pending)return;}else if(data.field!==(page===140?'REFERENCEMODULETNO':'ITEMSPECIFICATIONCODE'))return;
               var revision=s.revision,payload=identity?{}:page===140?{reference:value(r,'REFERENCEMODULETNO')}:{tno:value(r,'TNO')||apex.item('P108_TNO').getValue(),item:value(r,'ITEMCODE'),spec:value(r,'ITEMSPECIFICATIONCODE')};
               s.pending=(s.pending||0)+1;s.error=false;
               apex.server.process('P'+page+'_ROW_DEFAULT',{x01:JSON.stringify(payload),pageItems:page===108?'#P108_INDENTDATE':undefined},{dataType:'json'}).done(function(result){
                if(!alive(r,id)||(!identity&&s.revision!==revision)||identity&&value(r,'SNO'))return;
                // Let the amount listener react to the default, while avoiding another lookup.
                applying=true;try{model.setValue(r,identity?'SNO':page===140?'AMOUNTENTERED':'RATE',result.value==null?'':String(result.value));}finally{applying=false;}
               }).fail(function(){if(alive(r,id)&&s.revision===revision){s.error=true;apex.message.showErrors([{type:'error',location:'page',message:'Could not load this row default. Retry the selection before saving.',unsafe:false}]);}}).always(function(){s.pending--;});
              }});
              model.hsplRowDefaultsBlocked=function(){return Object.keys(states).some(function(id){return model.getRecord(id)&&!(model.getRecordMetadata(id)||{}).deleted&&(states[id].pending||states[id].error);});};
             }
             apex.jQuery(bind);apex.jQuery(document).on('interactivegridviewmodelcreate.p2pRowDefaults apexafterrefresh.p2pRowDefaults',bind);
             apex.jQuery(document).on('apexbeforepagesubmit.p2pRowDefaults',function(event,request){if(!['SAVE','CREATE'].includes(request))return;var v=view();if(v&&v.model&&v.model.hsplRowDefaultsBlocked&&v.model.hsplRowDefaultsBlocked()){event.preventDefault();apex.message.showErrors([{type:'error',location:'page',message:'Wait for this row default to finish before saving.',unsafe:false}]);return false;}});
            }());
            
            /* CRUD_BATCH_OWNING_EDITOR_V1: forward typed numbers to the exact grid record. */
            (function($){
             var config={"detail":["AMOUNTENTERED"]},invalid={};
             function raw(v){return v&&typeof v==='object'&&'v'in v?v.v:v;}
             function view(id){try{return apex.region(id).widget().interactiveGrid('getViews','grid');}catch(ignore){return null;}}
             function owner(input){for(var id in config){var v=view(id),host;try{host=apex.region(id).element[0];}catch(ignore){}if(!v||!v.model||!host||!host.contains(input)&&!(input.closest&&input.closest('#'+id+'_ig_grid_vc_floatingItem_dialog')))continue;
             var cell=$(input).closest('.a-GV-cell');if(!cell||!cell.length)cell=v.view$.grid('getActiveCellFromColumnItem',input);if(!cell||!cell.length)cell=v.view$.grid('getCurrentCell');if(!cell||!cell.length)continue;
             var col=v.view$.grid('getColumnForCell',cell);if(!col||col.readonly||config[id].indexOf(col.property)<0||col.property!==input.id&&!/^C[0-9]+$/.test(input.id))continue;var rid=cell.closest('tr[data-id]').attr('data-id'),r=rid&&v.model.getRecord(rid);if(!r)r=v.view$.grid('getActiveRecord');if(!r||v.model.allowEdit&&!v.model.allowEdit(r))continue;var meta=v.model.getRecordMetadata(v.model.getRecordId(r))||{};if(!meta.deleted&&!meta.agg)return{region:id,view:v,record:r,field:col.property};}return null;}
             function prune(){Object.keys(invalid).forEach(function(k){var parts=k.split(':'),v=view(parts[0]),r=v&&v.model.getRecord(parts[1]);if(!r||(v.model.getRecordMetadata(parts[1])||{}).deleted)delete invalid[k];});return Object.keys(invalid).length>0;}
             $(document).on('input.crudBatchEditor','input',function(){if(document.activeElement!==this)return;var o=owner(this);if(!o)return;var m=o.view.model,r=o.record,id=m.getRecordId(r),key=o.region+':'+id+':'+o.field,text=this.value,start=this.selectionStart,end=this.selectionEnd,clean=text.trim().replace(/,/g,'');if(!clean||!Number.isFinite(Number(clean))){invalid[key]=true;return;}delete invalid[key];if(String(raw(m.getValue(r,o.field)))!==String(Number(clean)))m.setValue(r,o.field,String(Number(clean)));if(document.activeElement===this){var next=owner(this);if(next&&next.view.model===m&&next.record===r){this.value=text;if(this.setSelectionRange&&start!==null)this.setSelectionRange(start,end);}}});
             $(document).on('apexbeforepagesubmit.crudBatchEditor',function(e,request){if(['CREATE','SAVE'].indexOf(request)<0)return;if(prune()){e.preventDefault();apex.message.showErrors([{type:'error',location:'page',message:'Complete the quantity, rate or amount in the detail row before saving.',unsafe:false}]);return false;}});
             window.hsplCrudBatchInvalid=prune;
            }(apex.jQuery));
            
            
            ```
