                ```plsql
                begin
                 delete from paymentadvicedetail where tno=:P140_TNO;
                 insert into paymentadvicedetail(tno,sno,serialno,footerheadcode,footerpercent,footervalue)
                 select :P140_TNO,globaltno.nextval,serialno,head,percent,value from(
                 select 1 serialno,'.TDS.' head,nvl(:P140_TDSPERCENT,0) percent,nvl(:P140_TDSAMOUNT,0) value from dual
                 union all select 2,'.CESSONTDS.',nvl(:P140_TDSCESSPERCENT,0),nvl(:P140_TDSCESSAMOUNT,0) from dual
                 union all select 3,'.SURCHARGEONTDS.',nvl(:P140_TDSSURCHARGEPERCENT,0),nvl(:P140_TDSSURCHARGEAMOUNT,0) from dual);
                end;
