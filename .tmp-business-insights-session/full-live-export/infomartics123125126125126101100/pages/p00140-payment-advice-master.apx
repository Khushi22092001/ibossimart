    pageItem P140_DOCTYPECODE (
        type: popupLov
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                	a.DocTypeName as d,
                	a.DocTypeCode as r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c, Module d
                where a.DocTypeCode = b.DocTypeCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode
                    and d.EntryPageNo = :APP_PAGE_ID
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @payment-advice
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @payment-advice
            column: DOCTYPECODE
            dataType: varchar2
        }
    )

