             function bind(){var v=view();if(!v||!v.model||v.model.hsplFooterRecordCalc)return;var m=v.model,states={},busy=false,applying=false;m.hsplFooterRecordCalc=true;
              function val(r,f){return raw(m.getValue(r,f));}
