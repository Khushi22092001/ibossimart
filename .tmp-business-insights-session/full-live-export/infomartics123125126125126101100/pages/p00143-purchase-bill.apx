              window.hsplP143PreserveEditor=preserveEditor;window.hsplP143FdQuantity=function(){var qty=null;if(model)model.forEach(function(r,i,id){var m=model.getRecordMetadata(id)||{};if(!m.deleted&&!m.agg&&String(value(r,'SNO'))===String(apex.item('P143_SNO').getValue()))qty=num(value(r,'QUANTITY1'));});return qty;};
