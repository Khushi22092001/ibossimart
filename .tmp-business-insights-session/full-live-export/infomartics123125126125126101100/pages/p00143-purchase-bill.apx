    process p143-calculate-detail (
        name: P143_CALCULATE_DETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);
                 v_tno number:=j.get_number('tno');v_sno number:=j.get_number('sno');hits number;
                 q1 number;q2 number;amount number;footer number;total number;old_amount number:=j.get_number('previousAmount');old_qty number:=j.get_number('previousQuantity');
                 unit1 varchar2(100);unit2 varchar2(100);item_code varchar2(100):=j.get_string('item');preview_started boolean:=false;
                 type footer_rows_t is table of PURCHASEBILLDETAILFOOTER%rowtype;old_rows footer_rows_t;
                 type keys_t is table of boolean index by varchar2(100);seen_heads keys_t;
                 type rids_t is table of varchar2(30) index by varchar2(100);original_rids rids_t;
                begin
                 if v_tno is null or v_tno<>:P143_TNO then raise_application_error(-20074,'Purchase Bill document identity changed');end if;
                 if v_sno is null then v_sno:=globaltno.nextval;end if;
                 select count(*) into hits from PURCHASEBILLDETAIL where sno=v_sno and tno<>v_tno;
                 if hits>0 then raise_application_error(-20074,'Purchase Bill detail belongs to another document');end if;
                 select count(*) into hits from PURCHASEBILL where tno=v_tno and nvl(companycode,'~')<>nvl(:GLOBAL_COMPANYCODE,'~');
                 if hits>0 then raise_application_error(-20074,'Purchase Bill belongs to another company');end if;
                 if old_amount is null then begin select amount,quantity1 into old_amount,old_qty from PURCHASEBILLDETAIL where tno=v_tno and sno=v_sno;exception when no_data_found then old_amount:=0;old_qty:=0;end;end if;
                 savepoint purchasebill_preview;preview_started:=true;
                 for f in(select sn,rowid rid from PURCHASEBILLDETAILFOOTER where tno=v_tno and sno=v_sno)loop
                  declare own_sn number:=f.sn;begin if own_sn is null then own_sn:=globaltno.nextval;update PURCHASEBILLDETAILFOOTER set sn=own_sn where rowid=f.rid;end if;original_rids(to_char(own_sn)):=f.rid;end;
                 end loop;
                 if j.has('footers') then
                  declare lines json_array_t:=j.get_array('footers');line json_object_t;r PURCHASEBILLDETAILFOOTER%rowtype;empty_row PURCHASEBILLDETAILFOOTER%rowtype;cache_rows footer_rows_t:=footer_rows_t();seen keys_t;own_sn number;own_rid varchar2(30);
                  begin
                   for k in 0..lines.get_size()-1 loop
                    line:=treat(lines.get(k) as json_object_t);r:=empty_row;
                    if nvl(line.get_number('TNO'),-1)<>v_tno or nvl(line.get_number('SNO'),-1)<>v_sno then raise_application_error(-20074,'Preview footer belongs to another detail');end if;
                    if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20074,'Select a footer head and legend');end if;
                    own_sn:=line.get_number('SN');own_rid:=line.get_string('ROWID');
                    if own_rid is not null and not regexp_like(own_rid,'^t[0-9]+$') then
                     begin select * into r from PURCHASEBILLDETAILFOOTER where rowid=chartorowid(own_rid) and tno=v_tno and sno=v_sno;exception when no_data_found then raise_application_error(-20074,'Footer ROWID is stale or belongs to another detail');end;
                     if own_sn is not null and r.sn<>own_sn then raise_application_error(-20074,'Footer SN and ROWID disagree');end if;own_sn:=nvl(own_sn,r.sn);
                    elsif own_rid is not null then
                     null; /* APEX temporary ROWID is a client key, not a durable footer SN. */
                    end if;
                    if own_sn is null then own_sn:=globaltno.nextval;end if;
                    if seen.exists(to_char(own_sn)) then raise_application_error(-20074,'Duplicate footer SN');end if;seen(to_char(own_sn)):=true;
                    select count(*) into hits from PURCHASEBILLDETAILFOOTER where sn=own_sn and(tno<>v_tno or sno<>v_sno);if hits>0 then raise_application_error(-20074,'Footer SN belongs to another detail');end if;
                    if r.tno is null then begin select * into r from PURCHASEBILLDETAILFOOTER where tno=v_tno and sno=v_sno and sn=own_sn;exception when no_data_found then null;end;end if;
                    r.tno:=v_tno;r.sno:=v_sno;r.sn:=own_sn;r.serialno:=k+1;r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');
                    if line.has('TAXFORMCODE') then r.taxformcode:=line.get_string('TAXFORMCODE');end if;
                    if line.has('INCLUDEDINRATE') then r.includedinrate:=line.get_string('INCLUDEDINRATE');end if;
                    if line.has('INCLUDEDWITHRATE') then r.includedwithrate:=line.get_string('INCLUDEDWITHRATE');end if;
                    cache_rows.extend;cache_rows(cache_rows.count):=r;
                   end loop;
                   delete from PURCHASEBILLDETAILFOOTER where tno=v_tno and sno=v_sno;
                   for k in 1..cache_rows.count loop r:=cache_rows(k);insert into PURCHASEBILLDETAILFOOTER values r;end loop;
                  end;
                 end if;
                 select * bulk collect into old_rows from PURCHASEBILLDETAILFOOTER where tno=v_tno and sno=v_sno;
                 delete from PURCHASEBILLDETAILFOOTER where tno=v_tno and sno=v_sno;
                 imart_purchasebill_calc.recalculate_line(v_tno,v_sno,j.get_string('item'),j.get_string('spec'),j.get_number('q1'),j.get_number('q2'),j.get_number('rate'),j.get_string('unit'),:P143_PARTYCODE,:P143_TRANSACTIONTYPECODE,q1,q2,amount,footer,total);
                 select measuringunitcode1,measuringunitcode2 into unit1,unit2 from item where itemcode=item_code;
                 for k in 1..old_rows.count loop
                  if j.get_string('field') in('HEADER','ITEMCODE','ITEMSPECIFICATIONCODE') and old_rows(k).footerheadcode in('.CGST.','.SGST.','.IGST.') then continue;end if;
                  if not seen_heads.exists(old_rows(k).footerheadcode) then delete from PURCHASEBILLDETAILFOOTER where tno=v_tno and sno=v_sno and footerheadcode=old_rows(k).footerheadcode;seen_heads(old_rows(k).footerheadcode):=true;end if;
                  if upper(trim(old_rows(k).legendscode)) in('PRA','PRD','PAA','PAD','OQA','OQD') and (
                   abs(nvl(old_rows(k).footervalue,0)-imart_purchasebill_calc.footer_value(old_rows(k).legendscode,old_amount,old_rows(k).footerpercent,old_rows(k).footervalue,old_qty))<=.0051
                   or (upper(trim(old_rows(k).legendscode))='OQA' and abs(nvl(old_rows(k).footervalue,0)-abs(nvl(old_qty,0)*nvl(old_rows(k).footerpercent,0)/100))<=.0051)
                   or (upper(trim(old_rows(k).legendscode))='OQD' and abs(nvl(old_rows(k).footervalue,0)+abs(nvl(old_qty,0)*nvl(old_rows(k).footerpercent,0)/100))<=.0051)) then
                   old_rows(k).footervalue:=imart_purchasebill_calc.footer_value(old_rows(k).legendscode,amount,old_rows(k).footerpercent,old_rows(k).footervalue,q1);
                  elsif upper(trim(old_rows(k).legendscode)) in('LSA','LSD') then old_rows(k).footervalue:=imart_purchasebill_calc.footer_value(old_rows(k).legendscode,amount,old_rows(k).footerpercent,old_rows(k).footervalue,q1);end if;
                  insert into PURCHASEBILLDETAILFOOTER values old_rows(k);
                 end loop;
                 select nvl(sum(footervalue),0) into footer from PURCHASEBILLDETAILFOOTER where tno=v_tno and sno=v_sno;total:=amount+footer;
                 apex_json.open_object;apex_json.write('sno',v_sno);apex_json.write('q1',q1);apex_json.write('q2',q2);apex_json.write('rate',j.get_number('rate'));apex_json.write('unit',j.get_string('unit'));apex_json.write('primaryUnit',unit1);apex_json.write('secondaryUnit',unit2);apex_json.write('amount',amount);apex_json.write('footer',footer);apex_json.write('total',total);
                 apex_json.open_array('footers');
                 for f in(select * from PURCHASEBILLDETAILFOOTER where tno=v_tno and sno=v_sno order by serialno,sn)loop
                  apex_json.open_object;apex_json.write('TNO',f.tno);apex_json.write('SNO',f.sno);apex_json.write('SN',f.sn);apex_json.write('SERIALNO',f.serialno);apex_json.write('FOOTERHEADCODE',f.footerheadcode);apex_json.write('LEGENDSCODE',f.legendscode);apex_json.write('FOOTERPERCENT',f.footerpercent);apex_json.write('FOOTERVALUE',f.footervalue);apex_json.write('TAXFORMCODE',f.taxformcode,true);apex_json.write('INCLUDEDINRATE',f.includedinrate,true);apex_json.write('INCLUDEDWITHRATE',f.includedwithrate,true);
                  if original_rids.exists(to_char(f.sn)) then apex_json.write('ROWID',original_rids(to_char(f.sn)));else apex_json.write('ROWID','t'||to_char(f.sn));end if;apex_json.close_object;
                 end loop;
                 apex_json.close_array;rollback to purchasebill_preview;preview_started:=false;apex_json.close_object;
                exception when others then if preview_started then rollback to purchasebill_preview;end if;raise;
                end;
                ```
        }
        execution {
            sequence: 80
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 982026092814300001
        }
    )

