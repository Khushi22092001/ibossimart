                type: sqlQuery
                sqlQuery:
                    ```sql
                    select a.termsandcondition a , a.termsandcondition b from TERMSANDCONDITIONHEADDETAIL a , TERMSANDCONDITIONHEAD b
                    where a.tno = b.tno
                    and b.tno = :TERMSANDCONDITIONHEADCODE
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TERMSANDCONDITIONHEADCODE
                itemsToSubmit: TERMSANDCONDITIONHEADCODE
                parentRequired: false
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: TERMSANDCONDITION
                dataType: varchar2
            }
        )

        column TERMSANDCONDITIONHEADCODE (
            type: popupLov
            heading {
                heading: Terms And Condition Head
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery: select TERMSANDCONDITIONHEADNAME , tno from TERMSANDCONDITIONHEAD
                displayNullValue: false
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: TERMSANDCONDITIONHEADCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            advanced {
                htmlDomId: TERMSANDCONDITIONHEADCODE
            }
        )

        column TNO (
            type: textField
            heading {
                heading: tno
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            masterDetail {
                masterColumn: @TNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Terms & Conditions
        }
    )

