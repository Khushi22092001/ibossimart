                                 and g.ItemCode = b.ItemCode
                                and g.ItemSpecificationCode = b.ItemSpecificationCode
                               and g.PurchaseOrderTno = :P143_PURCHASEORDERTNO
                                and g.tno =  :P143_TNO
                                
                                
                        );
                    
                    --end if;
                    end;
