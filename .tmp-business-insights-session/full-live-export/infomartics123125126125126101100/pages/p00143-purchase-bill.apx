               if(p===199){try{var parent=apex.region('Detail_Region').widget().interactiveGrid('getViews','grid').model,sno=apex.item('P199_SNO').getValue();parent.forEach(function(r,i,id){var meta=parent.getRecordMetadata(id)||{};if(!meta.deleted&&!meta.agg&&String(raw(parent.getValue(r,'SNO')))===String(sno)){var base=num(parent.getValue(r,'AMOUNT'));apex.item('P199_DFAMOUNT_1').setValue(base,null,true);apex.item('P199_DFAMOUNT').setValue(base+included,null,true);}});}catch(ignore){} }
              }
