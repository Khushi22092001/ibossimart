            button: @status
        }

        action imart-o2c-143-dirty-activation (
            action: executeJsCode
            settings {
                jsCode: "if(apex.item('P143_STATUS').getValue()==='ACTIVE'&&window.hsplP143HasUnsaved&&window.hsplP143HasUnsaved()){apex.da.cancel();apex.message.showErrors([{type:'error',location:'page',message:'Save header, detail and footer edits before making this document Active.',unsafe:false}]);}"
            }
