                    from GRN a, PurchaseOrder b, TransactionType c, NatureOfSupply d, CurrencyUnit e
                    where a.PurchaseOrderTNo = b.TNo
                    	and b.TransactionTypeCode = c.TransactionTypeCode(+)
                    	and b.NatureOfSupplyCode = d.NatureOfSupplyCode(+)
