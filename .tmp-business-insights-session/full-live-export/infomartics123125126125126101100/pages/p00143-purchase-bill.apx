    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid , TNO,
                       SNO,
                       SERIALNO,
                       PURCHASEORDERTNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       RATEMEASURINGUNITCODE,
                       RATE,
                       AMOUNT,
                       FOOTERAMOUNT,
                       TOTALAMOUNT,
                       DOCUMENTSTATUSCODE,
                       REMARK,
                       OURRG23DNO,
                       PARTYRG23DNO,
                       ROUNDING,
                       FOOTERAMOUNTWITHRATE,
                       JOBORDERTNO,
                       TAXRULECODE,
                       PRORATA,
                       QUALITYCODE,
                       'GRN' as GRN,
                       'FD' as FD,
                       GetMeasuringUnit2NameFromItem(itemcode) as unit2,
                       (SELECT PURCHASEORDERNO FROM PURCHASEORDER WHERE TNO = PURCHASEORDERTNO) as PURCHASEORDERNO
                
                  from PURCHASEBILLDETAIL
                  where tno = :P143_TNO
