        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P143_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare l_guard boolean := :P143_STATUS='ACTIVE'; l_started boolean:=false; begin
                     savepoint imart_activation_request;
                     if l_guard then imart_txn_integrity.begin_change('PURCHASEBILL',:P143_TNO);l_started:=true;end if;
                     SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P143_TNO,:P143_STATUS);
                     if l_started then imart_txn_integrity.finish_change('PURCHASEBILL',:P143_TNO);l_started:=false;end if;
                     exception when others then
                     if l_started then imart_txn_integrity.abort_change('PURCHASEBILL',:P143_TNO);end if;
                     begin rollback to imart_activation_request;exception when others then null;end;
                     raise;
                    end;
                    ```
                itemsToSubmit: [
                    P143_TNO
                    P143_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

