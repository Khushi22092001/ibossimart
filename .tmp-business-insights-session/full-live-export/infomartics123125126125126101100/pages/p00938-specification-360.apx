    pageItem P938_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From PCC_PurchaseBill h
                                Where h.CompanyCode = c.CompanyCode
                                  And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                                       Or h.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Narrows both regions to one company.
        }
    )

    pageItem P938_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            formatMask: DD-MM-RRRR
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Start of the reporting period. Arrives from Item 360.
        }
    )

    pageItem P938_ITEMCODE (
        type: popupLov
        label {
            label: Item
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct i.ItemName || ' (' || i.ItemCode || ')' d, i.ItemCode r
                  From PurchaseBillDetail d
                  Join Item i On i.ItemCode = d.ItemCode
                 Order By 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Required item subject. Searchable here so Specification 360 works as a standalone dashboard as well as from Item 360.
        }
    )

    pageItem P938_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From PCC_PurchaseBill fb
                                Where fb.LocationCode = l.LocationCode
                                  And (:P938_COMPANY Is Null
                                       Or fb.CompanyCode = :P938_COMPANY)
                                  And ((Select SAGAR.GetUserPanelAB_apex() From dual) Is Null
                                       Or fb.Panel = (Select SAGAR.GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P938_COMPANY
            itemsToSubmit: P938_COMPANY
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Cascades from Company.
        }
    )

    pageItem P938_PANEL (
        type: hidden
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
        }
        serverSideCondition {
            type: expression
            plsqlExpression: SAGAR.GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Hidden when your login is already bound to a panel. The select list is the control; the SQL predicate on every region is the enforcement.
        }
    )

    pageItem P938_SPEC (
        type: popupLov
        label {
            label: Specification
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                       Case When d.ItemSpecificationCode Is Null Then 'No specification recorded'
                            Else nvl((Select s.ItemSpecificationName From ItemSpecification s
                                       Where s.ItemSpecificationCode = d.ItemSpecificationCode),
                                     d.ItemSpecificationCode) End d,
                       nvl(d.ItemSpecificationCode,'~NONE~') r
                  From PurchaseBillDetail d
                 Where d.ItemCode = :P938_ITEMCODE
                 Order By 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P938_ITEMCODE
            itemsToSubmit: P938_ITEMCODE
        }
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Required specification subject; no-specification rows use the explicit ~NONE~ sentinel.
        }
    )

    pageItem P938_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter-bar
