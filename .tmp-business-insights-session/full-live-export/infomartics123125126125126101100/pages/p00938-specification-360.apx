    pageItem P938_UOM (
        type: popupLov
        label {
            label: Unit
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                       Case When d.RateMeasuringUnitCode Is Null Then 'No unit recorded'
                            Else nvl((Select m.MeasuringUnitName From MeasuringUnit m
                                       Where m.MeasuringUnitCode = d.RateMeasuringUnitCode),
                                     d.RateMeasuringUnitCode) End d,
                       nvl(d.RateMeasuringUnitCode,'~NONE~') r
                  From PurchaseBillDetail d
                 Where d.ItemCode = :P938_ITEMCODE
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All units (rates not comparable)
        }
        cascadingLov {
            parentItems: P938_ITEMCODE
            itemsToSubmit: P938_ITEMCODE
        }
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Optional unit narrowing. Empty means all units and rate comparisons are intentionally labelled as mixed.
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 90
            region: @filter-bar
            slot: regionBody
