        action load-eligible-indents-without-date-filter (
            name: Load eligible indents without date filter
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                        delete from enquiryindentdetail where tno = :P708_TNO;
                    
                        insert into enquiryindentdetail (tno, indenttno)
                        select distinct :P708_TNO, a.tno
                          from indent a, indentdetail b, documentstatusdetail c
                         where a.tno = b.tno
                           and a.companycode = :global_companycode
                           and a.indentdate <= :P708_ENQUIRYDATE
                           and c.modulecode = 'INDENT'
                           and a.tno = c.moduletno
                           and c.documentstatuscode = 'ACTIVE'
                           and a.locationcode = :P708_LOCATIONCODE
                           and b.quantity1 - nvl(b.orderedquantity1,0) > 0;
                    end;
                    ```
                itemsToSubmit: [
                    P708_ENQUIRYDATE
                    P708_LOCATIONCODE
                    P708_TNO
                ]
