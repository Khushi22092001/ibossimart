    process check-item-and-party-detail (
        name: check item and party detail
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  tmp number;
                  TMP1 NUMBER;
                begin
                   select count(*) INTO TMP from enquirypartydetail 
                   where tno = :P708_TNO;
                
                   select count(*) INTO TMP1 from ENQUIRYITEMDETAIL 
                   where tno = :P708_TNO;
                
                   if nvl(tmp,0) = 0 then
                        raise_application_error(-20200,'Pl. select atleast one party');
                   end if;
                    if nvl(tmp1,0) = 0 then
                         raise_application_error(-20200,'Pl. select atleast one Item');
                    end if;
                end;
                ```
        }
        execution {
            sequence: 120
        }
