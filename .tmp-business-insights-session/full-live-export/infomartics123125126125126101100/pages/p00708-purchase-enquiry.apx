                                    vloop.ITEMSPECIFICATIONCODE));
                                END IF;
                    			
                    			
                    	end loop;
                    
                        delete from ENQUIRYPARTYDETAIL 
                        where tno = :P708_TNO
                        and partycode is null;
                    	
                    END;
                    ```
                itemsToSubmit: [
                    P708_TNO
                    P708_COMPANYCODE
                    P708_LOCATIONCODE
