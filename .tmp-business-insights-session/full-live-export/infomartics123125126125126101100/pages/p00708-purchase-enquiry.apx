    region enquiry (
        name: Enquiry
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.COMPANYCODE,
                       a.FINANCIALYEARCODE,
                       a.LOCATIONCODE,
                       a.DOCTYPECODE,
                       a.ENQUIRYNO,
                       a.ENQUIRYDATE,
                       a.GENERATEDFOR,
                       a.REMARK,
                       a.SUBJECT,
                       a.LETTERTEXT,
                       a.HEADLINEMESSAGE,
                       a.EMPLOYEECODE,
                       a.CREATOR,
                       a.PURCHASEPRIFRENCELOCATIONCODE,
                       a.CREATIONTIME,
                       NVL(getdocumentstatuscode('ENQUIRY', a.TNO),'STATUS') AS Status
                  from ENQUIRY a--, ENQUIRYPARTYDETAIL b, VENDOR c
                  --WHERE a.TNO = b.TNO (+)
                 -- AND b.PARTYCODE = c.VENDORCODE (+);
                ```
        }
        layout {
            sequence: 5
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region enquiry-indent-detail (
        name: Enquiry Indent Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.INDENTTNO,
                       to_char(b.IndentDate,'DD-MM-RRRR') STATUS,
                       b.indentno ,
                       b.tno itno
                  from ENQUIRYINDENTDETAIL a , indent b
                  where a.tno = :P708_TNO
                  and a.INDENTTNO = b.tno
                order by b.IndentDate desc, b.IndentNo desc
                ```
            pageItemsToSubmit: P708_TNO
        }
        layout {
            sequence: 20
            parentRegion: @enquiry
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
