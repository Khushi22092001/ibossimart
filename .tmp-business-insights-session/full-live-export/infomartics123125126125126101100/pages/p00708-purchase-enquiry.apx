    dynamicAction delete-unsaved-data (
        name: delete unsaved data
        execution {
            sequence: 260
        }
        when {
            event: unload
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from EnquiryIndentDetail a
                        where not exists (
                            select 1 from enquiry  aa  
                            where aa.tno = a.tno
                        )
                        and a.tno = :P708_TNO;
                    
                        delete from ENQUIRYITEMDETAIL a
                        where not exists (
                            select 1 from enquiry  aa  
                            where aa.tno = a.tno
                        )
                          and a.tno = :P708_TNO;
                    
                        delete from ENQUIRYDETAILQUALITY a
                        where not exists (
                            select 1 from enquiry  aa  
                            where aa.tno = a.tno
                        )
                          and a.tno = :P708_TNO;
                    
                        delete from ENQUIRYTAC a
                        where not exists (
                            select 1 from enquiry  aa  
                            where aa.tno = a.tno
                        )
                          and a.tno = :P708_TNO;
                    
                        delete from ENQUIRYPARTYDETAIL a
                        where not exists (
                            select 1 from enquiry  aa  
                            where aa.tno = a.tno
                        )
                          and a.tno = :P708_TNO;
                    
                    ```
                itemsToSubmit: P708_TNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

