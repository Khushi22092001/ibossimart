    process p383-calculate-detail (
        name: P383_CALCULATE_DETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);
                 l_tno number:=j.get_number('tno');l_sno number:=j.get_number('sno');
                 l_spec varchar2(100):=j.get_string('spec');l_item varchar2(100):=j.get_string('item');l_actual_item varchar2(100);
                 l_qty number:=nvl(j.get_number('q1'),0);l_rate number:=nvl(j.get_number('rate'),0);l_amount number;l_footer number:=0;
                 l_previous_amount number:=j.get_number('previousAmount');l_previous_qty number:=j.get_number('previousQuantity');
                 l_hsn varchar2(100);l_unit varchar2(100);l_hits number;l_auto number;l_value number;l_percent number;l_sn number;l_head varchar2(100);l_legend varchar2(100);
                 l_rows json_array_t:=json_array_t();l_result json_array_t:=json_array_t();l_row json_object_t;l_regenerate boolean:=j.get_string('field') in('HEADER','ITEMCODE','ITEMSPECIFICATIONCODE');
                 l_read_only boolean:=j.get_string('field')='READ_ONLY_FD';
                begin
                 if l_tno is null or l_tno<>:P383_TNO then raise_application_error(-20074,'Proforma document identity changed');end if;
                 select count(*) into l_hits from pinvoice where tno=l_tno and companycode<>:GLOBAL_COMPANYCODE;
                 if l_hits>0 then raise_application_error(-20074,'Proforma belongs to a different company');end if;
                 if l_sno is null then l_sno:=globaltno.nextval;end if;
                 select count(*) into l_hits from pinvoicedetail where sno=l_sno and tno<>l_tno;
                 if l_hits>0 then raise_application_error(-20074,'Proforma detail belongs to another document');end if;
                 if l_read_only then
                  select itemcode,itemspecificationcode,quantity1,rate,amount into l_item,l_spec,l_qty,l_rate,l_amount from pinvoicedetail where tno=l_tno and sno=l_sno;
                 end if;
                 select i.itemcode,trim(s.hsncode),getmeasuringunitnamefromitem(i.itemcode) into l_actual_item,l_hsn,l_unit
                 from itemspecification s join item i on i.tno=s.tno where s.itemspecificationcode=l_spec;
                 if l_item is not null and l_item<>l_actual_item then raise_application_error(-20074,'Item and specification do not match');end if;
                 l_item:=l_actual_item;
                 if l_qty<0 then raise_application_error(-20074,'Proforma quantity cannot be negative');end if;
                 if not l_read_only then l_qty:=round(l_qty,greatest(nvl(getuomdecimal(getmeasuringunitcodefromitem(l_item)),3),3));l_amount:=round(l_qty*l_rate,2);end if;
                 if j.has('footers') and not l_read_only then l_rows:=j.get_array('footers');
                 else
                  for r in(select * from pinvoicedetailfooter where tno=l_tno and sno=l_sno order by serialno,sn)loop
                   l_row:=json_object_t();l_row.put('SN',r.sn);l_row.put('FOOTERHEADCODE',r.footerheadcode);l_row.put('LEGENDSCODE',r.legendscode);l_row.put('FOOTERPERCENT',r.footerpercent);l_row.put('FOOTERVALUE',r.footervalue);l_rows.append(l_row);
                  end loop;
                 end if;
                 for i in 0..l_rows.get_size()-1 loop
                  l_row:=treat(l_rows.get(i) as json_object_t);l_head:=l_row.get_string('FOOTERHEADCODE');l_legend:=l_row.get_string('LEGENDSCODE');
                  if j.has('footers') and not l_read_only and (nvl(l_row.get_number('TNO'),-1)<>l_tno or nvl(l_row.get_number('SNO'),-1)<>l_sno) then raise_application_error(-20074,'Proforma preview footer belongs to another detail');end if;
                  if l_head is null then raise_application_error(-20074,'Footer head is missing');end if;
                  if l_regenerate and l_head in('.CGST.','.SGST.','.IGST.') then continue;end if;
                  l_sn:=l_row.get_number('SN');if l_sn is null then l_sn:=globaltno.nextval;end if;
                  l_percent:=nvl(l_row.get_number('FOOTERPERCENT'),0);l_value:=nvl(l_row.get_number('FOOTERVALUE'),0);
                  if not l_read_only and upper(trim(l_legend)) in('PRA','PRD','PAA','PAD','OQA','OQD') and l_previous_amount is not null then
                   l_auto:=imart_purchasebill_calc.footer_value(l_legend,l_previous_amount,l_percent,l_value,l_previous_qty);
                   if l_legend in('PAA','PAD') then l_auto:=round(l_auto,2);end if;
                   if abs(l_value-nvl(l_auto,0))<=.0051 then
                    l_value:=imart_purchasebill_calc.footer_value(l_legend,l_amount,l_percent,l_value,l_qty);
                    if l_legend in('PAA','PAD') then l_value:=round(l_value,2);end if;
                   end if;
                  end if;
                  l_row.put('TNO',l_tno);l_row.put('SNO',l_sno);l_row.put('SN',l_sn);l_row.put('FOOTERVALUE',l_value);l_result.append(l_row);l_footer:=l_footer+l_value;
                 end loop;
                 if not l_read_only and (l_regenerate or l_rows.get_size()=0) then
                  for r in(select c.footerheadcode,a.legendscode,b.taxrate,
                   count(*) over(partition by c.footerheadcode) same_head
                   from taxruledetail a join taxruledetailfooter b on b.tno=a.tno and b.sno=a.sno
                   join footerhead c on c.footerheadcode=b.footerheadcode join taxrule d on d.tno=a.tno
                   join taxrulehsn e on e.tno=d.tno join party f on f.taxregistrationtypecode=d.taxregistrationtypecode
                   where f.partycode=:P383_PARTYCODE and d.transactiontypecode=:P383_TRANSACTIONTYPECODE and e.hsncode=l_hsn
                   order by c.footerheadcode)loop
                   if r.same_head<>1 then raise_application_error(-20074,'Ambiguous Proforma tax rule for footer head '||r.footerheadcode);end if;
                   if l_regenerate and l_rows.get_size()>0 and r.footerheadcode not in('.CGST.','.SGST.','.IGST.') then continue;end if;
                   l_value:=imart_purchasebill_calc.footer_value(r.legendscode,l_amount,r.taxrate,0,l_qty);
                   if r.legendscode in('PAA','PAD') then l_value:=round(l_value,2);end if;
                   l_row:=json_object_t();l_row.put('TNO',l_tno);l_row.put('SNO',l_sno);l_row.put('SN',globaltno.nextval);l_row.put('FOOTERHEADCODE',r.footerheadcode);l_row.put('LEGENDSCODE',r.legendscode);l_row.put('FOOTERPERCENT',r.taxrate);l_row.put('FOOTERVALUE',l_value);l_result.append(l_row);l_footer:=l_footer+l_value;
                  end loop;
                 end if;
                 apex_json.open_object;apex_json.write('tno',l_tno);apex_json.write('sno',l_sno);apex_json.write('item',l_item);apex_json.write('unit',l_unit);apex_json.write('q1',l_qty);apex_json.write('amount',l_amount);apex_json.write('footer',l_footer);apex_json.write('total',l_amount+l_footer);apex_json.write_raw('footers',l_result.to_clob());apex_json.close_object;
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99038320260929031
        }
    )

