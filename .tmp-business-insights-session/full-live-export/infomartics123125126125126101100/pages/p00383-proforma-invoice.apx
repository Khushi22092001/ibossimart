    pageItem P383_SALESORDERTNO (
        type: selectOne
        label {
            label: Sales Order No
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                     A.salesorderno ||' ('||a.SalesOrderDate||')', 
                     A.tno 
                from (select * from SALESORDER where COMPANYCODE=(select IMART_REFERENCE_SCOPE.company_code(:P383_TNO,:P383_COMPANYCODE) from dual)) A
                where a.locationcode = :P383_LOCATIONCODE
                  and a.PartyCode = :P383_PARTYCODE
                ```
        }
        cascadingLov {
            parentItems: [
                P383_LOCATIONCODE
                P383_PARTYCODE
            ]
            itemsToSubmit: [
                P383_LOCATIONCODE
                P383_PARTYCODE
                P383_TNO
                P383_COMPANYCODE
            ]
        }
        layout {
            sequence: 130
            region: @party-and-reference-details
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            valuePlaceholder: Sales Order No
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @proforma-invoice
            column: SALESORDERTNO
            dataType: number
        }
    )

