            /* P383_RECORD_CALC_V1: owning records, pure tax preview, exact-row footer cache. */
            (function($){
             var model,epoch=0,busy=false,applying=false,states={},footerModel,footerApplying=false,currentFd,fdSequence=0,invalid={},headerDirty=false;
             var footerFields=['TNO','SNO','SN','FOOTERHEADCODE','LEGENDSCODE','FOOTERPERCENT','FOOTERVALUE'];
             function grid(id){try{return apex.region(id).widget().interactiveGrid('getViews','grid');}catch(ignore){return null;}}
             function raw(value){return value&&typeof value==='object'&&'v'in value?value.v:value;}
             function num(value){var n=Number(String(raw(value)==null?'':raw(value)).replace(/,/g,''));return Number.isFinite(n)?n:0;}
             function money(value){return Math.round((value+Number.EPSILON)*100)/100;}
             function val(r,f){return raw(model.getValue(r,f));}
             function set(r,f,v){if(String(val(r,f)==null?'':val(r,f))!==String(v==null?'':v))model.setValue(r,f,String(v==null?'':v));}
             function error(text){apex.message.showErrors([{type:'error',location:'page',message:text,unsafe:false}]);}
             function activeOwner(input){
              if(!input)return null;
              for(var id of ['Detail','Detail_Footer']){
               var v=grid(id);if(!v||!v.model||!apex.region(id).element[0].contains(input))continue;
               var cell=$(input).closest('.a-GV-cell');if(!cell.length)cell=v.view$.grid('getActiveCellFromColumnItem',input);if(!cell||!cell.length)cell=v.view$.grid('getCurrentCell');if(!cell||!cell.length)continue;
               var col=v.view$.grid('getColumnForCell',cell);if(!col||!col.property||col.property!==input.id&&!/^C[0-9]+$/.test(input.id))continue;
               var key=cell.closest('tr[data-id]').attr('data-id'),r=key&&v.model.getRecord(key);if(!r)r=v.view$.grid('getActiveRecord');if(r)return {region:id,view:v,record:r,field:col.property};
              }
             }
             function preserveEditor(){
              var input=document.activeElement,owner=activeOwner(input);if(!owner||!('value'in input))return function(){};
              var text=input.value,start=input.selectionStart,end=input.selectionEnd;
              return function(){if(document.activeElement!==input)return;var next=activeOwner(input);if(!next||next.record!==owner.record||next.view.model!==owner.view.model)return;input.value=text;if(input.setSelectionRange&&start!==null)input.setSelectionRange(start,end);};
             }
             function headerSummary(){
              var a=num(apex.item('P383_SUMOFAMOUNT').getValue()),f=num(apex.item('P383_SUMOFFOOTERAMOUNT').getValue()),before=money(a+f),tds=money(a*num(apex.item('P383_LESS_TDS_PERCENT').getValue())/100),after=money(before-tds),interest=money(after*num(apex.item('P383_INTREST_ON_LC_PERCENT').getValue())/100/365*num(apex.item('P383_INTREST_ON_LC_DAYS').getValue())),gst=money(interest*.18),net=money(after+interest+gst),rounded=Math.round(net);
              [['PINVOICEAMOUNTBEFOREROUND',before],['LESS_TDS_AMOUNT',tds],['AMOUNT_AFTER_TDS',after],['INTREST_ON_LC_AMOUNT',interest],['GST_ON_INTREST',gst],['ROUNDINGAMOUNT',money(rounded-net)],['PINVOICEAMOUNT',rounded]].forEach(function(x){apex.item('P383_'+x[0]).setValue(x[1].toFixed(2),null,true);});
             }
             window.calculateInvoiceFields=window.calculatePInvoiceFields=headerSummary;
             function summary(){if(!model)return;var a=0,f=0;model.forEach(function(r,i,id){var meta=model.getRecordMetadata(id)||{};if(meta.deleted||meta.agg)return;a+=num(val(r,'AMOUNT'));f+=num(val(r,'FOOTERAMOUNT'));});apex.item('P383_SUMOFAMOUNT').setValue(money(a).toFixed(2),null,true);apex.item('P383_SUMOFFOOTERAMOUNT').setValue(money(f).toFixed(2),null,true);headerSummary();}
             function schedule(r,field,old){
              if(!val(r,'ITEMSPECIFICATIONCODE'))return;
              var id=model.getRecordId(r),s=states[id]||(states[id]={revision:0,previousAmount:num(val(r,'AMOUNT')),previousQuantity:field==='QUANTITY1'?num(old):num(val(r,'QUANTITY1'))});
              s.revision++;s.field=field;s.pending=true;s.error=false;clearTimeout(s.timer);s.timer=setTimeout(pump,25);
              var restore=preserveEditor();applying=true;try{set(r,'AMOUNT',money(num(val(r,'QUANTITY1'))*num(val(r,'RATE'))));set(r,'TOTALAMOUNT',money(num(val(r,'AMOUNT'))+num(val(r,'FOOTERAMOUNT'))));summary();}finally{applying=false;restore();}
             }
             function pump(){
              if(busy||!model)return;var id=Object.keys(states).find(function(key){return states[key].pending;});if(!id)return;
              var r=model.getRecord(id),s=states[id];if(!r||(model.getRecordMetadata(id)||{}).deleted){delete states[id];pump();return;}
              var request={tno:num(apex.item('P383_TNO').getValue()),sno:num(val(r,'SNO'))||null,item:val(r,'ITEMCODE')||null,spec:val(r,'ITEMSPECIFICATIONCODE'),q1:num(val(r,'QUANTITY1')),rate:num(val(r,'RATE')),field:s.field,previousAmount:s.previousAmount,previousQuantity:s.previousQuantity};if(s.footers!==undefined)request.footers=s.footers;
              var revision=s.revision,owner=model,generation=epoch;busy=true;
              apex.server.process('P383_CALCULATE_DETAIL',{x01:JSON.stringify(request),pageItems:'#P383_TNO,#P383_PARTYCODE,#P383_TRANSACTIONTYPECODE'},{dataType:'json'}).done(function(result){
               if(owner!==model||generation!==epoch||model.getRecord(id)!==r||(model.getRecordMetadata(id)||{}).deleted)return;
               var restore=preserveEditor();applying=true;try{
                if(!val(r,'SNO'))set(r,'SNO',result.sno);
                if(s.revision!==revision)return;
                [['TNO',result.tno],['ITEMCODE',result.item],['MEASURINGUNITNAME1',result.unit],['QUANTITY1',result.q1],['AMOUNT',result.amount],['FOOTERAMOUNT',result.footer],['TOTALAMOUNT',result.total]].forEach(function(x){set(r,x[0],x[1]);});
                s.footers=result.footers;s.previousAmount=result.amount;s.previousQuantity=result.q1;s.pending=false;s.error=false;summary();if(currentFd===id)renderFooter();
               }finally{applying=false;restore();}
              }).fail(function(xhr,status,message){if(owner===model&&generation===epoch&&s.revision===revision){s.pending=false;s.error=true;error('Proforma detail calculation failed. Correct this row before saving. '+(message||status));}}).always(function(){busy=false;pump();});
             }
             function formula(legend,amount,percent,old,qty){switch(String(legend||'').trim().toUpperCase()){case 'PRA':return Math.round(amount*percent/100);case 'PRD':return -Math.round(Math.abs(amount*percent/100));case 'PAA':return money(Math.abs(amount*percent/100));case 'PAD':return -money(Math.abs(amount*percent/100));case 'OQA':return Math.abs(qty*percent);case 'OQD':return -Math.abs(qty*percent);default:return old;}}
             function captureFooter(type,data){
              if(['set','insert','delete','revert','switch','submit'].indexOf(type)<0)return;
              if(footerApplying||!footerModel||!model||!currentFd)return;var parent=model.getRecord(currentFd);if(!parent||(model.getRecordMetadata(currentFd)||{}).deleted)return;
              if(!model.allowEdit(parent))return;
              var s=states[currentFd],tno=val(parent,'TNO')||apex.item('P383_TNO').getValue(),sno=val(parent,'SNO'),list=[],total=0,valid=true,restore=preserveEditor();
              footerApplying=true;try{
               if(type==='set'&&data&&['FOOTERPERCENT','LEGENDSCODE','FOOTERHEADCODE'].indexOf(data.field)>=0){var edited=data.record||footerModel.getRecord(data.recordId);if(edited)footerModel.setValue(edited,'FOOTERVALUE',String(formula(raw(footerModel.getValue(edited,'LEGENDSCODE')),num(val(parent,'AMOUNT')),num(footerModel.getValue(edited,'FOOTERPERCENT')),num(footerModel.getValue(edited,'FOOTERVALUE')),num(val(parent,'QUANTITY1')))));}
               footerModel.forEach(function(r,i,id){var meta=footerModel.getRecordMetadata(id)||{};if(meta.deleted||meta.agg)return;if(meta.inserted){if(!raw(footerModel.getValue(r,'TNO')))footerModel.setValue(r,'TNO',String(tno));if(!raw(footerModel.getValue(r,'SNO')))footerModel.setValue(r,'SNO',String(sno));}var head=raw(footerModel.getValue(r,'FOOTERHEADCODE'));if(!head){if(num(footerModel.getValue(r,'FOOTERPERCENT'))||num(footerModel.getValue(r,'FOOTERVALUE')))valid=false;return;}
                var line={};footerFields.forEach(function(f){line[f]=raw(footerModel.getValue(r,f));});if(String(line.TNO)!==String(tno)||String(line.SNO)!==String(sno)){valid=false;return;}line.FOOTERPERCENT=num(line.FOOTERPERCENT);line.FOOTERVALUE=num(line.FOOTERVALUE);line.SN=num(line.SN)||null;if(!line.LEGENDSCODE){valid=false;return;}list.push(line);total+=line.FOOTERVALUE;
               });
               if(!valid){invalid['footer:'+currentFd]=true;return;}delete invalid['footer:'+currentFd];
               s.footers=list;s.previousAmount=num(val(parent,'AMOUNT'));s.previousQuantity=num(val(parent,'QUANTITY1'));if(['set','insert','delete','revert'].indexOf(type)>=0)s.fdEdited=true;
               applying=true;try{set(parent,'FOOTERAMOUNT',money(total));set(parent,'TOTALAMOUNT',money(num(val(parent,'AMOUNT'))+total));summary();}finally{applying=false;}
               if(s.pending||list.some(function(line){return !line.SN;}))schedule(parent,'FOOTER');
              }finally{footerApplying=false;restore();}
             }
             function bindFooter(){var v=grid('Detail_Footer');if(!v||!v.model||v.model===footerModel)return;footerModel=v.model;var owner=footerModel;footerModel.subscribe({onChange:function(type,data){if(owner===footerModel)captureFooter(type,data);}});}
             function readFooterView(region,result){
              var host=region.element[0],old=host.querySelector('.p383-saved-fd');if(old)old.remove();var panel=document.createElement('div');panel.className='p383-saved-fd';var escape=apex.util.escapeHTML,total=0;
              var html='<table class="t-Report-report" role="grid" aria-label="Saved Detail Footer" style="width:100%"><thead><tr><th>Footer Head</th><th>Legends Code</th><th>Footer Percent</th><th>Footer Value</th></tr></thead><tbody>';
              result.footers.forEach(function(line){total+=num(line.FOOTERVALUE);html+='<tr><td>'+escape(String(line.FOOTERHEADCODE||''))+'</td><td>'+escape(String(line.LEGENDSCODE||''))+'</td><td style="text-align:right">'+escape(String(line.FOOTERPERCENT||0))+'</td><td style="text-align:right">'+num(line.FOOTERVALUE).toFixed(2)+'</td></tr>';});
              html+='</tbody><tfoot><tr><th colspan="3">Total</th><th style="text-align:right">'+money(total).toFixed(2)+'</th></tr></tfoot></table>';panel.innerHTML=html;host.appendChild(panel);region.element.find('.a-IG').hide();region.element.css('visibility','visible');
             }
             function renderFooter(){
              bindFooter();var parent=model&&model.getRecord(currentFd),s=states[currentFd];if(!parent||!s||!s.footers||!footerModel||footerModel.getTotalRecords()<0)return false;
              var restore=preserveEditor();footerApplying=true;try{
               var available=[];footerModel.forEach(function(r,i,id){var meta=footerModel.getRecordMetadata(id)||{};if(!meta.deleted&&!meta.agg)available.push(r);});
               s.footers.forEach(function(line){var index=available.findIndex(function(r){return String(raw(footerModel.getValue(r,'TNO')))==String(line.TNO)&&String(raw(footerModel.getValue(r,'SNO')))==String(line.SNO)&&(String(raw(footerModel.getValue(r,'SN')))==String(line.SN)||!raw(footerModel.getValue(r,'SN'))&&raw(footerModel.getValue(r,'FOOTERHEADCODE'))===line.FOOTERHEADCODE&&raw(footerModel.getValue(r,'LEGENDSCODE'))===line.LEGENDSCODE);});var r=index>=0?available.splice(index,1)[0]:footerModel.getRecord(footerModel.insertNewRecord());footerFields.forEach(function(f){var value=line[f]==null?'':String(line[f]);if(String(raw(footerModel.getValue(r,f))||'')!==value)footerModel.setValue(r,f,value);});});if(available.length)footerModel.deleteRecords(available);
               if(footerModel.clearChanges)footerModel.clearChanges();
              }finally{footerApplying=false;restore();}return true;
             }
             window.hsplP383OpenFd=function(anchor,event){
              if(event)event.preventDefault();var v=grid('Detail'),r;try{r=v.getContextRecord(anchor)[0];}catch(ignore){}if(!r)return false;
              var id=model.getRecordId(r);if(!val(r,'ITEMSPECIFICATIONCODE')){error('Select an item before opening FD.');return false;}
              if(currentFd&&currentFd!==id)captureFooter('switch');currentFd=id;var s=states[id]||(states[id]={revision:0}),readOnly=!model.allowEdit(r);if(!readOnly&&s.footers===undefined)schedule(r,'FD');
              var seq=++fdSequence,region=apex.region('Detail_Footer');region.element.css('visibility','hidden');openModal('Detail_Footer');var spinner=apex.util.showSpinner(region.element);spinner.css('visibility','visible');var deadline=Date.now()+10000;
              if(readOnly){var display=function(result){if(seq!==fdSequence){spinner.remove();return;}s.readOnlyResult=result;readFooterView(region,result);spinner.remove();};if(s.readOnlyResult)display(s.readOnlyResult);else apex.server.process('P383_CALCULATE_DETAIL',{x01:JSON.stringify({tno:num(val(r,'TNO')),sno:num(val(r,'SNO')),field:'READ_ONLY_FD'}),pageItems:'#P383_TNO'},{dataType:'json'}).done(display).fail(function(){spinner.remove();if(seq===fdSequence){apex.theme.closeRegion('Detail_Footer');error('Could not load this saved Proforma footer. Retry.');}});return false;}
              region.element.find('.p383-saved-fd').remove();region.element.find('.a-IG').show();
              (function show(){if(seq!==fdSequence){spinner.remove();return;}s=states[id];if(s&&s.error){spinner.remove();apex.theme.closeRegion('Detail_Footer');error('Correct this Proforma row before opening FD.');return;}var f=grid('Detail_Footer');if(s&&!s.pending&&f&&f.model&&f.model.getTotalRecords()>=0&&renderFooter()){apex.item('P383_DETAIL_SNO').setValue(val(r,'SNO'),null,true);spinner.remove();region.element.css('visibility','visible');return;}if(Date.now()>deadline){spinner.remove();apex.theme.closeRegion('Detail_Footer');error('Proforma footer is still loading; retry after row calculation finishes.');return;}setTimeout(show,25);}());return false;
             };
             function bind(){var v=grid('Detail');if(!v||!v.model||v.model.hsplP383RecordCalc)return;model=v.model;epoch++;states={};invalid={};currentFd=null;model.hsplP383RecordCalc=true;var owner=model;
              model.forEach(function(r,i,id){var meta=model.getRecordMetadata(id)||{};if(!meta.deleted&&!meta.agg)states[id]={revision:0,previousAmount:num(val(r,'AMOUNT')),previousQuantity:num(val(r,'QUANTITY1'))};});
              model.subscribe({onChange:function(type,data){if(applying||owner!==model)return;if(type==='set'&&data&&['QUANTITY1','RATE','ITEMCODE','ITEMSPECIFICATIONCODE'].indexOf(data.field)>=0){var r=data.record||model.getRecord(data.recordId);if(r)schedule(r,data.field,data.oldValue);}pruneInvalid();summary();}});summary();bindFooter();
             }
             $(bind);$(document).on('interactivegridviewmodelcreate.p383Calc apexafterrefresh.p383Calc',function(){bind();bindFooter();});
             $(document).on('change.p383Calc','#P383_PARTYCODE,#P383_TRANSACTIONTYPECODE',function(){if(model)model.forEach(function(r,i,id){var meta=model.getRecordMetadata(id)||{};if(!meta.deleted&&!meta.agg)schedule(r,'HEADER');});});
             $(document).on('input.p383Calc change.p383Calc','#P383_LESS_TDS_PERCENT,#P383_INTREST_ON_LC_PERCENT,#P383_INTREST_ON_LC_DAYS',headerSummary);
             $(document).on('input.p383Calc','#QUANTITY1,#RATE,#FOOTERPERCENT,#FOOTERVALUE,input[id^="C"]',function(){
              if(document.activeElement!==this)return;var owner=activeOwner(this);if(!owner||['QUANTITY1','RATE','FOOTERPERCENT','FOOTERVALUE'].indexOf(owner.field)<0)return;var property=owner.field,m=owner.view.model,r=owner.record,meta=m.getRecordMetadata(m.getRecordId(r))||{};if(meta.deleted||meta.agg||!m.allowEdit(r))return;
              var text=String(this.value).trim(),key=owner.region+':'+m.getRecordId(r)+':'+property,restore=preserveEditor();try{
               if(!text||!Number.isFinite(Number(text.replace(/,/g,'')))){invalid[key]=true;if(owner.region==='Detail'){var s=states[m.getRecordId(r)]||(states[m.getRecordId(r)]={revision:0});s.revision++;s.pending=false;s.error=true;clearTimeout(s.timer);}return;}
               delete invalid[key];if(String(raw(m.getValue(r,property))||'')!==text)m.setValue(r,property,text);if(owner.region==='Detail'&&states[m.getRecordId(r)]&&states[m.getRecordId(r)].error)schedule(r,property);
              }finally{restore();}
             });
             function pruneInvalid(){Object.keys(invalid).forEach(function(key){var parts=key.split(':'),id=parts[1],r=model&&model.getRecord(id);if(parts[0]==='Detail'||parts[0]==='footer'){if(!r||(model.getRecordMetadata(id)||{}).deleted)delete invalid[key];}else if(parts[0]==='Detail_Footer'){var f=footerModel&&footerModel.getRecord(id);if(!f||(footerModel.getRecordMetadata(id)||{}).deleted)delete invalid[key];}});}
             $(document).on('input.p383Dirty change.p383Dirty','[id^="P383_"]',function(){if(!/^(P383_FD_EDITS|P383_DETAIL_|P383_SUMOF|P383_PINVOICEAMOUNT|P383_LESS_TDS_AMOUNT|P383_AMOUNT_AFTER_TDS|P383_INTREST_ON_LC_AMOUNT|P383_GST_ON_INTREST|P383_ROUNDINGAMOUNT)/.test(this.id))headerDirty=true;});
             $(document).on('apexbeforepagesubmit.p383Calc',function(event,request){if(['CREATE','SAVE'].indexOf(request)<0)return;captureFooter('submit');pruneInvalid();
              var badHeader=['P383_LESS_TDS_PERCENT','P383_INTREST_ON_LC_PERCENT','P383_INTREST_ON_LC_DAYS'].some(function(id){var text=String(apex.item(id).getValue()||'').trim();return text&&!Number.isFinite(Number(text.replace(/,/g,'')));});
              if(badHeader||Object.keys(invalid).length||busy||Object.keys(states).some(function(id){var r=model.getRecord(id);return r&&!(model.getRecordMetadata(id)||{}).deleted&&(states[id].pending||states[id].error);})){event.preventDefault();error('Finish the Proforma detail/footer calculations and correct incomplete numbers before saving.');return false;}
              var payload={};model.forEach(function(r,i,id){var meta=model.getRecordMetadata(id)||{};if(!meta.deleted&&!meta.agg&&states[id]&&states[id].footers!==undefined)payload[String(val(r,'SNO'))]=states[id].footers;});apex.item('P383_FD_EDITS').setValue(JSON.stringify(payload),null,true);
             });
             window.hsplP383HasUnsaved=function(){pruneInvalid();return headerDirty||(model&&model.isChanged())||Object.keys(states).some(function(id){var r=model&&model.getRecord(id);return r&&!(model.getRecordMetadata(id)||{}).deleted&&(states[id].pending||states[id].error||states[id].fdEdited);})||Object.keys(invalid).length>0;};
            }(apex.jQuery));
            
