                    $('#STATUS').text($v('P383_STATUS'));
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @buttons
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P383_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action reload-page (
            name: Reload Page
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    location.reload()
                    
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action set-document-status (
            name: Set Document Status
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare l_guard boolean := :P383_STATUS='ACTIVE'; l_started boolean:=false; begin
                     savepoint imart_activation_request;
                     if l_guard then imart_txn_integrity.begin_change('PINVOICE',:P383_TNO);l_started:=true;end if;
                     SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P383_TNO,:P383_STATUS);
                     if l_started then imart_txn_integrity.finish_change('PINVOICE',:P383_TNO);l_started:=false;end if;
                     exception when others then
                     if l_started then imart_txn_integrity.abort_change('PINVOICE',:P383_TNO);end if;
                     begin rollback to imart_activation_request;exception when others then null;end;
                     raise;
                    end;
                    ```
                itemsToSubmit: [
                    P383_TNO
                    P383_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

