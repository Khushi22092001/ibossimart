    pageItem P383_CONSIGNEECODE (
        type: selectOne
        label {
            label: Consignee
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                partyname , 
                partycode from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) PARTY    
                where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
                and :P383_DOCTYPECODE = 'PURCHASERETURN'
                and partytypecode = 'SUPPLIER'
                
                union all    
                select partyname  , partycode from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) PARTY    
                where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
                and :P383_DOCTYPECODE != 'PURCHASERETURN'
                and partytypecode = 'CUSTOMER'
                and :P383_FORMSTATUS = 'NEWRECORD'
                
                union all    
                select partyname , partycode from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) PARTY    
                where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
                and :P383_DOCTYPECODE != 'PURCHASERETURN'
                and partytypecode = 'CUSTOMER'
                and :P383_FORMSTATUS = 'EDITRECORD'
                and partycode = :P383_CONSIGNEECODE
                
                --||' '||getcityname(officecitycode) 
                ```
        }
        cascadingLov {
            parentItems: P383_DOCTYPECODE
            itemsToSubmit: [
                P383_DOCTYPECODE
                P383_FORMSTATUS
                P383_CONSIGNEECODE
            ]
        }
        layout {
            sequence: 140
            region: @party-and-reference-details
            slot: regionBody
            alignment: left
            column: 1
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
            valuePlaceholder: Consignee
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @proforma-invoice
            column: CONSIGNEECODE
            dataType: varchar2
        }
    )

