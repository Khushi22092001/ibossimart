    dynamicAction disable-enable-delete-button (
        name: Disable/Enable Delete Button
        execution {
            sequence: 170
        }
        when {
            event: ready
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P383_TNO
        }

        action disabled-but-not-on-fire-initialization (
            name: Disabled but not on Fire Initialization
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 30
            }
            serverSideCondition {
                type: expression
                plsqlExpression:
                    ```plsql
                    CHECK_USER_PRIVILEGE(:GLOBAL_BOSSUSERCODE,:GLOBAL_COMPANYCODE,:APP_PAGE_ID,'DELETE') = 0
                    OR
                    GETDOCUMENTSTATUSCODE(GETMODULECODEFORPAGENO(:APP_PAGE_ID),:P383_TNO) IN ('ACTIVE', 'CANCELED', 'CANCELLED', 'CLOSED')
                    ```
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: expression
