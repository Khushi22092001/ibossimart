    process save-checked-cached-proforma-detail-footers (
        name: Save checked cached Proforma detail footers
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 payload json_object_t:=json_object_t.parse(nvl(:P383_FD_EDITS,'{}'));keys json_key_list:=payload.get_keys;
                 rows_json json_array_t;row_json json_object_t;l_sno number;l_sn number;l_hits number;l_head varchar2(100);l_legend varchar2(100);l_percent number;l_value number;
                 type seen_keys is table of boolean index by varchar2(100);seen seen_keys;
                begin
                 for k in 1..keys.count loop
                  l_sno:=to_number(keys(k));
                  select count(*) into l_hits from pinvoicedetail where tno=:P383_TNO and sno=l_sno;
                  if l_hits<>1 then raise_application_error(-20074,'Proforma footer owning detail is missing or duplicated');end if;
                  rows_json:=payload.get_array(keys(k));seen.delete;
                  for i in 0..rows_json.get_size()-1 loop
                   row_json:=treat(rows_json.get(i) as json_object_t);l_sn:=row_json.get_number('SN');
                   if row_json.get_number('TNO')<>:P383_TNO or row_json.get_number('SNO')<>l_sno or row_json.get_number('TNO') is null or row_json.get_number('SNO') is null then raise_application_error(-20074,'Proforma footer belongs to a different detail');end if;
                   if row_json.get_string('FOOTERHEADCODE') is null or row_json.get_string('LEGENDSCODE') is null then raise_application_error(-20074,'Proforma footer head or legend is missing');end if;
                   if l_sn is null or seen.exists(to_char(l_sn)) then raise_application_error(-20074,'Proforma footer identity is missing or duplicated');end if;seen(to_char(l_sn)):=true;
                   select count(*) into l_hits from pinvoicedetailfooter where sn=l_sn and (tno<>:P383_TNO or sno<>l_sno) and not exists(select 1 from pinvoicedetailfooter own where own.tno=:P383_TNO and own.sno=l_sno and own.sn=l_sn);
                   if l_hits>0 then raise_application_error(-20074,'Proforma footer identity belongs to another detail');end if;
                  end loop;
                  delete from pinvoicedetailfooter where tno=:P383_TNO and sno=l_sno;
                  for i in 0..rows_json.get_size()-1 loop
                   row_json:=treat(rows_json.get(i) as json_object_t);
                   l_sn:=row_json.get_number('SN');l_head:=row_json.get_string('FOOTERHEADCODE');l_legend:=row_json.get_string('LEGENDSCODE');l_percent:=row_json.get_number('FOOTERPERCENT');l_value:=row_json.get_number('FOOTERVALUE');
                   insert into pinvoicedetailfooter(tno,sno,sn,serialno,footerheadcode,legendscode,footerpercent,footervalue)
                   values(:P383_TNO,l_sno,l_sn,i+1,l_head,l_legend,l_percent,l_value);
                  end loop;
                 end loop;
                end;
                
                ```
        }
        execution {
            sequence: 45
        }
        advanced {
            executionMappingIdentifier: 99038320260929032
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

