                    OR 
                    GETDOCUMENTSTATUSCODE(GETMODULECODEFORPAGENO(:APP_PAGE_ID),:P383_TNO) IN ('ACTIVE', 'CANCELED', 'CANCELLED', 'CLOSED')
                    ```
            }
        )

