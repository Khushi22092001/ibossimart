    process save-ig-data-detail-region (
        name: Save- IG Data (Detail Region)
        type: interactiveGridAutoRowProcessing
        editableRegion: @details
        target {
            targetType: plsqlCode
            dmlPlsqlCode:
                ```plsql
                declare l_hits number;
                begin
                 if :APEX$ROW_STATUS='C' and :ITEMCODE is null and :ITEMSPECIFICATIONCODE is null and :DESCRIPTION is null and :REMARK is null and :PACKINGTYPECODE is null and nvl(:PACKINGNOS,0)=0 and nvl(:QUANTITY1,0)=0 and nvl(:RATE,0)=0 then return;end if;
                 if :TNO is not null and :TNO<>:P383_TNO then raise_application_error(-20074,'Proforma detail belongs to another document');end if;
                 if :APEX$ROW_STATUS in('U','D') then
                  select count(*) into l_hits from pinvoicedetail where tno=:P383_TNO and sno=:SNO;
                  if l_hits<>1 then raise_application_error(-20074,'Proforma detail is missing or duplicated');end if;
                 end if;
                 if :APEX$ROW_STATUS in('C','U') then
                  select count(*) into l_hits from itemspecification s join item i on i.tno=s.tno where s.itemspecificationcode=:ITEMSPECIFICATIONCODE and i.itemcode=:ITEMCODE;
                  if l_hits<>1 then raise_application_error(-20074,'Proforma item and specification do not match');end if;
                 end if;
                 case :APEX$ROW_STATUS
                 when 'C' then
                  :TNO:=:P383_TNO;if :SNO is null then :SNO:=globaltno.nextval;end if;
                  insert into pinvoicedetail(tno,sno,itemcode,itemspecificationcode,description,packingtypecode,packingnos,quantity1,rate,amount,footeramount,totalamount,remark,ratemeasuringunitcode,despatchcategorycode)
                  values(:TNO,:SNO,:ITEMCODE,:ITEMSPECIFICATIONCODE,:DESCRIPTION,:PACKINGTYPECODE,:PACKINGNOS,:QUANTITY1,:RATE,:AMOUNT,:FOOTERAMOUNT,:TOTALAMOUNT,:REMARK,getmeasuringunitcodefromitem(:ITEMCODE),:P383_TRANSACTIONTYPECODE)
                  returning rowid into :ROWID;
                 when 'U' then
                  update pinvoicedetail set itemcode=:ITEMCODE,itemspecificationcode=:ITEMSPECIFICATIONCODE,description=:DESCRIPTION,packingtypecode=:PACKINGTYPECODE,packingnos=:PACKINGNOS,quantity1=:QUANTITY1,rate=:RATE,amount=:AMOUNT,footeramount=:FOOTERAMOUNT,totalamount=:TOTALAMOUNT,remark=:REMARK,ratemeasuringunitcode=getmeasuringunitcodefromitem(:ITEMCODE),despatchcategorycode=:P383_TRANSACTIONTYPECODE
                  where tno=:P383_TNO and sno=:SNO;
                 when 'D' then
                  delete from pinvoicedetailfooter where tno=:P383_TNO and sno=:SNO;
                  delete from pinvoicedetail where tno=:P383_TNO and sno=:SNO;
                 end case;
                end;
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 6002571245719733
        }
    )

    process set-configutations (
        name: Set Configutations
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Set Allowed Back/Forward Dates
                    IF :P383_FORMSTATUS = 'NEWRECORD' THEN 
                
                    select
                    		trunc(sysdate) - nvl(b.AllowedBackDays, 0) as AllowedBack,
                    		trunc(sysdate) + nvl(b.AllowedForwardDays, 0) AllowedForward	
                            INTO :P383_ALLOWEDBACK,:P383_ALLOWEDFORWARD
                    from Module a, ModulePrivilege b, BossUser c
                    where a.ModuleCode = GetModuleCodeForpageNo(:APP_PAGE_ID)
                    		and a.ModuleCode = b.ModuleCode
                    		and b.BossUsercode = c.BossUserCode
                    		and c.LoginName = :GLOBAL_LOGINNAME
                    		and b.CompanyCode = :GLOBAL_CompanyCode
                            ;
                
                    else
                        :P383_ALLOWEDBACK       := :P383_PINVOICEDATE ; 
                        :P383_ALLOWEDFORWARD    := :P383_PINVOICEDATE ;
                     end if;
                
                --Set Status
                :P383_STATUS := NVL(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P383_TNO), 'Status');
                
                --Set Is Read Only
                BEGIN
                    SELECT COALESCE(MAX(1), 0)
                      INTO :P383_IS_READONLY
                      FROM DocumentStatusDetail 
                     WHERE MODULETNO = :P383_TNO 
                       AND DOCUMENTSTATUSCODE IN ('ACTIVE', 'CANCELED', 'CANCELLED', 'CLOSED')
                       AND ROWNUM = 1;
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3350810063559329
        }
    )

