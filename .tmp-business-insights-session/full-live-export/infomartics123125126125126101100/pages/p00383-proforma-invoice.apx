        action imart-proforma-dirty-activation (
            action: executeJsCode
            settings {
                jsCode: "if(apex.item('P383_STATUS').getValue()==='ACTIVE'&&window.hsplP383HasUnsaved&&window.hsplP383HasUnsaved()){apex.da.cancel();apex.message.showErrors([{type:'error',location:'page',message:'Save Proforma header, detail and footer changes before making it Active.',unsafe:false}]);}"
            }
            execution {
                sequence: 1
                fireOnInit: false
            }
        )

        action native-javascript-code (
