    process calculate-footer (
        name: Calculate Footer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    v_base_sno NUMBER := 0;
                BEGIN
                    DELETE FROM PINVOICEDETAILFOOTER A
                 WHERE A.TNO=:P383_TNO AND NOT EXISTS (
                        SELECT 1 FROM PINVOICEDETAIL AA  
                        WHERE AA.TNO = A.TNO
                          AND AA.SNO = A.SNO
                    );
                    
                    DELETE FROM PINVOICEFOOTER WHERE TNO = :P383_TNO;
                
                    SELECT COALESCE(MAX(SNO), 0)
                      INTO v_base_sno
                      FROM PINVOICEFOOTER;
                
                    INSERT INTO PINVOICEFOOTER (
                        TNO,
                        SNO,
                        SERIALNO,
                        FOOTERHEADCODE,
                        LEGENDSCODE,        
                        FOOTERPERCENT,
                        FOOTERVALUE
                    )
                    SELECT 
                        :P383_TNO,
                        v_base_sno + ROW_NUMBER() OVER (ORDER BY FOOTERHEADCODE, LEGENDSCODE) AS SNO, 
                        ROW_NUMBER() OVER (ORDER BY FOOTERHEADCODE, LEGENDSCODE) AS SERIALNO,        
                        FOOTERHEADCODE,
                        LEGENDSCODE,
                        FOOTERPERCENT, 
                        ROUND(SUM(FOOTERVALUE), 2) AS SUMOFVALUE 
                    FROM PINVOICEDETAILFOOTER
                    WHERE TNO = :P383_TNO
                    GROUP BY FOOTERHEADCODE, LEGENDSCODE,FOOTERPERCENT;
                END;
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 4815669909683239
        }
    )

