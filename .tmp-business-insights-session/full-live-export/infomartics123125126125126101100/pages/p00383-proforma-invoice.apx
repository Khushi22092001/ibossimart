            execution {
                sequence: 10
            }
            serverSideCondition {
                type: expression
                plsqlExpression:
                    ```plsql
                    CHECK_USER_PRIVILEGE(:GLOBAL_BOSSUSERCODE,:GLOBAL_COMPANYCODE,:APP_PAGE_ID,'DELETE') = 1
                    AND
                    GETDOCUMENTSTATUSCODE(GETMODULECODEFORPAGENO(:APP_PAGE_ID),:P383_TNO) NOT IN ('ACTIVE', 'CANCELED', 'CANCELLED', 'CLOSED')
                    ```
            }
        )

    )

