    dynamicAction check-codescheme (
        name: check codescheme
        execution {
            sequence: 660
        }
        when {
            event: focusout
            selectionType: items
            items: P146_GRNDATE
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P146_PARTYCODE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P146_CODESCHEME
                value: AUTO
            }
            serverSideCondition {
                type: never
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select CODESCHEME  from codescheme
                        where companycode = :global_companycode
                        and modulecode = GetModuleCodeForPageNo(:APP_PAGE_ID)
                        and FINANCIALYEARCODE = :global_FINANCIALYEARCODE;
                    ```
            }
            affectedElements {
                selectionType: items
                items: P146_CODESCHEME
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-qty (
        name: Check qty
        execution {
            sequence: 500
        }
        when {
            event: click
            selectionType: button
            button: @back-3
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @stockstoragedetail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P146_RECEIVEDQTY1 <> :P146_STOCKQTY1 then
                        raise_application_error(-20000,'Entered Stock Qty is Not Matching With Detail Quantity.');
                    end if;
                    ```
                itemsToSubmit: [
                    P146_STOCKQTY1
                    P146_RECEIVEDQTY1
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-received-qty (
        name: Check received qty
        execution {
            sequence: 400
        }
        when {
            event: click
            selectionType: button
            button: @back-2
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("DetailStorage").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("UNLOADINGQUANTITY1");
                    model.forEach(function(igrow) {
                        n_amt = parseFloat(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    var received = $v("P146_RECEIVEDQTY1");
                    var n_totamttmp = n_totamt.toFixed(3);
                    var detail = n_totamttmp.toString();
                    
                    //console.log(received,detail);
                    if (received !== detail) {
                       //raise_application_error(-20000,'RECEIVED QTY1 NOT MATCHING WITH DETAIL STORAGE RECEIVED QTY1.');
                       //console.log('Error.');
                       
                       //apex.message.showErrors("RECEIVED QTY1 NOT MATCHING WITH DETAIL STORAGE RECEIVED QTY1.", null, "error");
                       apex.message.showErrors([
                            {
                                type: apex.message.TYPE.ERROR,
                                location: ["page"],
                                message: "RECEIVED QTY1 NOT MATCHING WITH DETAIL STORAGE RECEIVED QTY1.",
                                unsafe: false
                            }
                            ]);
                    } 
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-ref-doc-no (
        name: Check ref doc no
        execution {
            sequence: 650
        }
        when {
            event: focusout
            selectionType: items
            items: P146_REFDOCNO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        tmp number;
                        tmp1 number;
                    begin
                    
                    
                        select count(*) into tmp from materialin
                        where FINANCIALYEARCODE = :P146_FINANCIALYEARCODE
                        and PARTYCODE = :P146_PARTYCODE
                        and REFDOCTYPECODE = :P146_REFDOCTYPECODE
                        and REFDOCNO = :P146_REFDOCNO;
                    
                        select count(*) into tmp1 from grn    
                        where FINANCIALYEARCODE = :P146_FINANCIALYEARCODE
                        and PARTYCODE = :P146_PARTYCODE
                        and REFDOCTYPECODE = :P146_REFDOCTYPECODE
                        and REFDOCNO = :P146_REFDOCNO;
                    
                        /* if nvl(tmp , 0)> 0   then 
                            raise_application_error(-20000,'REF DOC NO is already used in Matrial In.');
                        end if; */
                        if nvl(tmp1 , 0)> 0   then 
                            raise_application_error(-20000,'REF DOC NO is already used in GRN.');
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P146_FINANCIALYEARCODE
                    P146_PARTYCODE
                    P146_REFDOCTYPECODE
                    P146_REFDOCNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-shortage (
        name: Check shortage
        execution {
            sequence: 170
        }
        when {
            event: focusout
