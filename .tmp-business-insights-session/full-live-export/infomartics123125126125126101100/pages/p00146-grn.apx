                        END IF;
                    
                    END IF;
                    ```
                itemsToSubmit: [
                    RECEIVEDQUANTITY1
                    CHALANQUANTITY1
                    DISCREPANCYTYPECODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

