                layout {
                    show: false
                    sequence: 4
                }
            )

            displayColumn (
                column: @STOCKTNO
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @STORAGELOCATIONCODE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @QUANTITY1
                layout {
                    width: 131.069
                    sequence: 6
                }
            )

            displayColumn (
                column: @QUANTITY2
                layout {
                    width: 157.069
                    sequence: 7
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column QUANTITY1 (
            type: numberField
            heading {
                heading: Quantity1
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: QUANTITY1
                dataType: number
            }
            default {
                type: expression
                plsqlExpression: NVL(:P146_RECEIVEDQTY1,0) - NVL(:STOCKQTY1,0)
            }
            columnFilter {
                lovType: none
            }
        )

        column QUANTITY2 (
            type: numberField
            heading {
                heading: Quantity2
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: QUANTITY2
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 110
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SN (
            type: numberField
            heading {
                heading: Sn
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: SN
                dataType: number
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            columnFilter {
                lovType: none
            }
        )

        column SNO (
            type: textField
            heading {
                heading: sno
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            masterDetail {
                masterColumn: @SNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        column STOCKTNO (
            type: textField
            heading {
                heading: Stock No
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: STOCKTNO
                dataType: number
            }
        )

        column STORAGELOCATIONCODE (
            type: popupLov
            heading {
                heading: Storage Location
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select STORAGELOCATIONNAME , STORAGELOCATIONCODE from storagelocation
                    where :P146_DOCTYPECODE = 'CONVERSIONJOBOUTOFPREMISES'
                    and STORAGELOCATIONCODE in (select CONVERSIONSTORAGELOCATIONCODE from joborder 
                                                where tno = :P146_JOBORDERTNO)
                    union all
                    select STORAGELOCATIONNAME , STORAGELOCATIONCODE from storagelocation
                    where :P146_DOCTYPECODE = 'SALERETURN'
                    and  STORAGELOCATIONCODE in (select partyshortname from (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) PARTY where partycode = :P146_PARTYCODE)
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    P146_DOCTYPECODE
                    P146_JOBORDERTNO
                    P146_PARTYCODE
                ]
                parentRequired: false
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: STORAGELOCATIONCODE
                dataType: varchar2
            }
        )

        column TNO (
            type: textField
            heading {
                heading: tno
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P146_TNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: StockStorageDetail
        }
    )

    region transportation-info (
        name: Transportation Info
