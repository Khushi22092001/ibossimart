    process p146-quantity-rule (
        name: P146_QUANTITY_RULE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);l_spec varchar2(30):=j.get_string('spec');l_item varchar2(30):=j.get_string('item');
                 factor number;u1 varchar2(30);u2 varchar2(30);
                begin
                 select multiplyingfactor into factor from itemspecification where itemspecificationcode=l_spec;
                 select max(measuringunitcode1),max(measuringunitcode2) into u1,u2 from item where itemcode=l_item;
                 apex_json.open_object;apex_json.write('factor',nvl(factor,0));apex_json.write('u2',u2);
                 apex_json.write('dec1',nvl(getuomdecimal(u1),3));apex_json.write('dec2',case when u2 is null then 3 else nvl(getuomdecimal(u2),3) end);apex_json.close_object;
                end;
                
                ```
        }
        execution {
            sequence: 80
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 982026092814600001
        }
    )

