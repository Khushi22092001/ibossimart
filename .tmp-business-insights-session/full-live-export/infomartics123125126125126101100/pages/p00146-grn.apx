               model.forEach(function(r,i,key){var meta=model.getRecordMetadata(key)||{};if(meta.deleted||meta.agg)return;var sno=val(r,'SNO')||apex.item('P146_SNO').getValue();if(!sno)return;var total=sums[sno]||(sums[sno]=[0,0]);total[0]+=num(val(r,'REJECTEDQUANTITY1'));total[1]+=num(val(r,'REJECTEDQUANTITY2'));});
