            selectionType: columns
            interactiveGrid: @grndetail
            columns: CHALANQUANTITY2
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                        mfactor number(10,3);
                    begin
                            select MULTIPLYINGFACTOR into mfactor from ITEMSPECIFICATION where ITEMSPECIFICATIONCODE = :ITEMSPECIFICATIONCODE;
                            return round(nvl(:CHALANQUANTITY2,0)/nvl(mfactor,0),3);
                        exception when others then
                            return round(nvl(:CHALANQUANTITY1,0),3);
                    end;
                    ```
                itemsToSubmit: [
