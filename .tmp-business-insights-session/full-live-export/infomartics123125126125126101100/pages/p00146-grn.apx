        column JOBORDERTNO (
            type: popupLov
            heading {
                heading: Job order No
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select 
                             a.joborderno,
                             a.tno
                    from 
                             (select * from JOBORDER where COMPANYCODE=(select IMART_REFERENCE_SCOPE.company_code(:P146_TNO,:P146_COMPANYCODE) from dual)) a
                    where
                            a.partycode = :PARTYCODE
                            and a.companycode = (select IMART_REFERENCE_SCOPE.company_code(:P146_TNO,:P146_COMPANYCODE) from dual)
                            and exists (
                                 select aa.partycode from (select * from JOBORDER where COMPANYCODE=(select IMART_REFERENCE_SCOPE.company_code(:P146_TNO,:P146_COMPANYCODE) from dual)) aa , Joborderdetail bb
                                  where aa.tno = bb.tno
                                        and aa.partycode = a.partycode
                                        and bb.jobtypecode = :jobtypecode
                                        And aa.tno = a.tno 
                                  )
                     Order by 
                               a.joborderdate, a.joborderno
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: [
                    JOBTYPECODE
                    PARTYCODE
                ]
                itemsToSubmit: [
                    JOBTYPECODE
                    PARTYCODE
                    P146_TNO
                    P146_COMPANYCODE
                ]
                parentRequired: false
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: JOBORDERTNO
                dataType: number
            }
        )

