    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region attachment (
        name: Attachment
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       --A.SNO,
                       --DESCRIPTION,
                       A.ATTRIBUTEVALUE,
                       A.ATTACHMENTBLOB,
                       A.FILENAME,
                       A.ATTRIBUTECODE,
                       A.MODULETNO,
                       A.MODULESNO,
                       b.PARTYATTRIBUTEname
                  from MODULEATTACHMENT A, partyattribute b
                  WHERE A.MODULETNO = :P146_TNO
                  and a.ATTRIBUTECODE = b.PARTYATTRIBUTECODE
                ```
            pageItemsToSubmit: P146_TNO
        }
        layout {
            sequence: 90
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 1063
                items: {
                    P1063_MODULETNO: #MODULETNO#
                    P1063_ATTRIBUTECODE: #ATTRIBUTECODE#
                    P1063_PARENT_FORMSTATUS: &P146_FORMSTATUS.#SNO#
                }
                clearCache: 1063
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        heading {
            fixedTo: region
            maxReportHeight: 400
        }
        advanced {
            savedReportMappingIdentifier: 1375604733663055724
        }

        column ATTACHMENTBLOB (
            type: hidden
            heading {
                heading: Attachmentblob
            }
            layout {
                sequence: 50
            }
            source {
                dataType: OTHER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ATTRIBUTECODE (
            type: plainText
            heading {
                heading: Attributecode
            }
            layout {
                sequence: 90
