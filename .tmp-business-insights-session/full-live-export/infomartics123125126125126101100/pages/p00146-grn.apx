            /* P146_QUANTITY_MODEL_V1: cached unit rules, synchronous row math, preserve manual Q2. */
            (function(){
             var rules={},pending=0,failed=0;
             function raw(v){return v&&typeof v==='object'&&'v' in v?v.v:v;}
