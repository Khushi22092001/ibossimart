    process check-ref-no (
        name: check ref no
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                    tmp number;
                    tmp1 number;
                begin
                
                
                    select count(*) into tmp from materialin
                    where FINANCIALYEARCODE = :P146_FINANCIALYEARCODE
                    and PARTYCODE = :P146_PARTYCODE
                    and REFDOCTYPECODE = :P146_REFDOCTYPECODE
                    and REFDOCNO = :P146_REFDOCNO;
                
                    select count(*) into tmp1 from grn    
                    where FINANCIALYEARCODE = :P146_FINANCIALYEARCODE
                    and PARTYCODE = :P146_PARTYCODE
                    and REFDOCTYPECODE = :P146_REFDOCTYPECODE
                    and REFDOCNO = :P146_REFDOCNO;
                
                    /* if nvl(tmp , 0)> 0   then 
                        raise_application_error(-20000,'REF DOC NO is already used in Matrial In.');
                    end if; */
                    if nvl(tmp1 , 0)> 0   then 
                        raise_application_error(-20000,'REF DOC NO is already used in GRN.');
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8636107575410930
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process check-reference-company-before-save (
        name: Check reference company before Save
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                IMART_REFERENCE_SCOPE.assert_reference('CCINVOICE',:P146_CCINVOICETNO,IMART_REFERENCE_SCOPE.company_code,'P146_CCINVOICETNO');
                IMART_REFERENCE_SCOPE.assert_reference('GATEPASS',:P146_GATEPASSTNO,IMART_REFERENCE_SCOPE.company_code,'P146_GATEPASSTNO');
                IMART_REFERENCE_SCOPE.assert_reference('JOBORDER',:P146_JOBORDERTNO,IMART_REFERENCE_SCOPE.company_code,'P146_JOBORDERTNO');
                IMART_REFERENCE_SCOPE.assert_reference('LOADINGADVICE',:P146_LOADINGADVICETNO,IMART_REFERENCE_SCOPE.company_code,'P146_LOADINGADVICETNO');
                IMART_REFERENCE_SCOPE.assert_reference('MATERIALIN',:P146_MATERIALINTNO,IMART_REFERENCE_SCOPE.company_code,'P146_MATERIALINTNO');
                IMART_REFERENCE_SCOPE.assert_reference('POAMENDMENT',:P146_POAMENDMENTTNO,IMART_REFERENCE_SCOPE.company_code,'P146_POAMENDMENTTNO');
                IMART_REFERENCE_SCOPE.assert_reference('PURCHASEORDER',:P146_PURCHASEORDERTNO,IMART_REFERENCE_SCOPE.company_code,'P146_PURCHASEORDERTNO');
                IMART_REFERENCE_SCOPE.assert_reference('STOCKTRANSFER',:P146_STOCKTRANSFERTNO,IMART_REFERENCE_SCOPE.company_code,'P146_STOCKTRANSFERTNO');
