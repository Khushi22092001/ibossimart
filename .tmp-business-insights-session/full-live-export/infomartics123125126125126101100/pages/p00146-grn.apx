            /* GRN_DETAIL_HORIZONTAL_SYNC_NATIVE_V5 */
            (function () {
              function bindGrnDetailHeaderSync() {
                var grid = document.getElementById('GrnDetail_ig');
                if (!grid) { return; }
            
                var body = grid.querySelector('.a-GV-bdy');
                var header = grid.querySelector('.a-GV-w-hdr');
                if (!body || !header || body.dataset.grnHorizontalSyncV5 === 'Y') { return; }
            
                body.dataset.grnHorizontalSyncV5 = 'Y';
                header.scrollLeft = body.scrollLeft;
                body.addEventListener('scroll', function () {
                  header.scrollLeft = body.scrollLeft;
                }, { passive: true });
              }
            
              function scheduleBinding() {
                window.setTimeout(bindGrnDetailHeaderSync, 0);
              }
            
              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', scheduleBinding, { once: true });
              } else {
                scheduleBinding();
              }
            
              document.addEventListener('click', function (event) {
                if (event.target.closest('.t-Tabs-link')) { scheduleBinding(); }
              });
            
              new MutationObserver(scheduleBinding).observe(document.documentElement, {
                childList: true,
                subtree: true
              });
            })();
            
            /* HSPL_CROSSFORM_DETAIL_INTEGRITY_V1 */
            (function(){
              "use strict";
              if(Number(apex.env.APP_PAGE_ID||0)!==146||window.hsplCrossformDetailIntegrityV1)return;
              window.hsplCrossformDetailIntegrityV1=true;
              var heldFromDetail=false;
              function inDetail(target){return !!(target&&target.closest&&target.closest("#detail,#Detail_ig"));}
              document.addEventListener("keydown",function(event){
                if(event.key!=="Tab")return;
                if(!event.repeat){heldFromDetail=inDetail(event.target);return;}
                if(heldFromDetail&&!window.hsplP146TabReady){event.preventDefault();event.stopImmediatePropagation();}
              },true);
              document.addEventListener("keyup",function(event){if(event.key==="Tab")heldFromDetail=false;},true);
              window.addEventListener("blur",function(){heldFromDetail=false;});
              
            })();
            
            
            // Each master detail has its own UD model. APEX can return a newly selected
            // model to navigation mode even though the previous detail was being edited.
            function resumeGrnUdEditing(expectedModel) {
                window.setTimeout(function() {
                    var region = apex.region('DetailStorage');
                    if (!region || !region.element.is(':visible')) return;
                    var view = region.call('getViews', 'grid');
                    if (!view || (expectedModel && view.model !== expectedModel)) return;
                    var actions = region.call('getActions');
                    var edit = actions.lookup('edit');
                    if (edit && !edit.disabled) actions.set('edit', true);
                }, 0);
            }
            function syncGrnUdTotals(expectedModel) {
                window.setTimeout(function() {
                    var region = apex.region('DetailStorage');
                    if (!region || !region.element.is(':visible')) return;
                    var view = region.call('getViews', 'grid');
                    if (!view || (expectedModel && view.model !== expectedModel)) return;
                    var fields = {
                        C793150655749681640: 'UNLOADINGQUANTITY1',
                        C793150739800681641: 'UNLOADINGQUANTITY2',
                        C641802426138137687: 'REJECTEDQUANTITY1',
                        C641802499962137688: 'REJECTEDQUANTITY2'
                    };
                    var totals = {};
                    Object.keys(fields).forEach(function(id) { totals[fields[id]] = 0; });
                    view.model.forEach(function(record, index, recordId) {
                        var metadata = view.model.getRecordMetadata(recordId) || {};
                        if (metadata.deleted || metadata.agg || metadata.aggregate) return;
                        Object.keys(totals).forEach(function(field) {
                            var value = view.model.getValue(record, field);
                            if (value && typeof value === 'object') value = value.v;
                            var number = Number(String(value == null ? '' : value).replace(/,/g, ''));
                            if (isFinite(number)) totals[field] += number;
                        });
                    });
                    region.element.find('.hspl-live-total-row').each(function() {
                        var row = this;
                        Object.keys(fields).forEach(function(id) {
                            var header = document.getElementById(id + '_HDR');
                            var headerCell = header && header.closest('th,td');
                            var cell = headerCell && row.cells[headerCell.cellIndex];
                            if (cell) cell.textContent = totals[fields[id]].toLocaleString('en-IN', {
                                minimumFractionDigits: 3, maximumFractionDigits: 3
                            });
                        });
                    });
                }, 0);
            }
            apex.jQuery(document).on('interactivegridviewmodelcreate.grnUdEdit', '#DetailStorage', function(event, data) {
                if (data.viewId !== 'grid') return;
                var waitingForData = true;
                data.model.subscribe({
                    onChange: function(type) {
                        syncGrnUdTotals(data.model);
                        if (waitingForData && type === 'addData') {
                            waitingForData = false;
                            resumeGrnUdEditing(data.model);
                        }
                    }
                });
            });
            
