            ```javascript-browser
            // GRN UD is initialized while its inline dialog is hidden. Measure it again
            // after opening, without fetching or replacing the editable detail model.
            function ud(anchor, event) {
                if (event) event.preventDefault();
                if (anchor && anchor.nodeType === 1) {
                    var master = apex.region('GrnDetail').call('getViews', 'grid');
                    var records = master.getContextRecord(anchor);
                    var record = records && records[0];
                    if (!record) return false;
                    function value(name) {
                        var v = master.model.getValue(record, name);
                        return v && typeof v === 'object' && 'v' in v ? v.v : v;
                    }
                    apex.item('P146_TNO').setValue(value('TNO'), null, true);
                    apex.item('P146_SNO').setValue(value('SNO'), null, true);
                    apex.item('P146_RECEIVEDQTY1').setValue(value('RECEIVEDQUANTITY1'), null, true);
                    apex.item('P146_DETAILITEMCODE').setValue(value('ITEMCODE1'), null, true);
                    apex.item('P146_DETAILSPECIFICATIONCODE').setValue(value('ITEMSPECIFICATIONCODE1'), null, true);
                    master.setSelectedRecords([record], false);
                }
                openModal('DetailStorage');
                [0, 180, 450].forEach(function (delay) {
                    window.setTimeout(function () {
                        var region = apex.region('DetailStorage');
                        if (!region || !region.element.is(':visible')) return;
                        region.call('resize');
                        resumeGrnUdEditing();
                        syncGrnUdTotals();
                        // The shared FD totals use the same layout notification.
                        window.dispatchEvent(new Event('resize'));
                    }, delay);
                });
                return false;
            }
            
            function sd() {
                    // Get the modal element by ID
                    if (apex.item('P146_DOCTYPECODE').getValue()=='CONVERSIONJOBOUTOFPREMISES' ||
                    apex.item('P146_DOCTYPECODE').getValue()=='SALERETURN'
                     ) {
                            openModal('StockStorageDetail');
                    }
            }
            
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
