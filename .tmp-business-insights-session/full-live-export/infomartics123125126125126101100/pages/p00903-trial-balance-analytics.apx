        savedReport 1 (
            visibility: primaryDefault
            view {
                rowsPerPage: 25
            }

            displayColumn COMPANY (
                sequence: 4
            )

            displayColumn CREDIT (
                sequence: 8
            )

            displayColumn DEBIT (
                sequence: 7
            )

            displayColumn INTEGRITY (
                sequence: 9
            )

            displayColumn LOCATION (
                sequence: 5
            )

            displayColumn NARRATION (
                sequence: 11
            )

            displayColumn SOURCE_MODULE (
                sequence: 6
            )

            displayColumn TIMING (
                sequence: 10
            )

            displayColumn VOUCHER_DATE (
                sequence: 1
            )

            displayColumn VOUCHER_NO (
                sequence: 2
            )

            displayColumn VOUCHER_TYPE (
                sequence: 3
            )

        )

    )

    pageItem P903_ACCOUNTGROUP (
        type: selectList
        label {
            label: Account Group
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select p.PartyName d, p.PartyCode r
                  From (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) p
                 Where Exists (Select 1 From (select p.* from PARTY p where exists(select 1 from PARTYCOMPANY c where c.TNO=p.TNO and c.COMPANYCODE=:GLOBAL_COMPANYCODE)) c Where c.ParentCode = p.PartyCode)
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: Whole chart of accounts
        }
        layout {
            sequence: 20
            region: @filter-drawer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Restrict the trial balance to one group and everything beneath it. Only accounts that actually have children are listed.
        }
    )

    pageItem P903_COMPANY (
        type: selectList
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.CompanyCode = c.CompanyCode
                                  And (cast(null as varchar2(100)) Is Null
                                       Or cast(null as varchar2(100)) = cast(null as varchar2(100))))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P903_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: The first day of the movement window. Everything before it becomes the opening balance.
        }
    )

    pageItem P903_LEVEL (
        type: selectList
        label {
            label: Hierarchy Depth
        }
        lov {
            type: staticValues
            staticValues: STATIC:1 - Nature only;1,2 - Nature and group;2,3 - Down to subgroup;3,4 - Four levels;4,5 - Five levels;5,6 - Six levels;6,7 - Seven levels;7,8 - Every level, ledger accounts included;8
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter-drawer
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 3
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: How deep the trial balance is drawn. The chart of accounts is eight levels deep; level 8 lists every posting account, which is thousands of rows. Start shallow and click a group to go deeper.
        }
    )

    pageItem P903_LOCATION (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.LocationCode = l.LocationCode
                                  And (:P903_COMPANY Is Null Or v.CompanyCode = :P903_COMPANY)
                                  And (cast(null as varchar2(100)) Is Null
                                       Or cast(null as varchar2(100)) = cast(null as varchar2(100))))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P903_COMPANY
            itemsToSubmit: P903_COMPANY
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P903_NOMOVE (
        type: selectList
        label {
            label: Accounts With No Movement
        }
        lov {
            type: staticValues
            staticValues: STATIC:Include them - a carried balance is still a balance;Y,Only accounts that moved in the period;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @filter-drawer
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: Y
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: A dormant account still holds money and still belongs in a trial balance, so it is included by default.
        }
    )

    pageItem P903_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: The last day of the movement window, and the as-on date of the closing balance.
        }
    )

    pageItem P903_ZERO (
        type: selectList
        label {
            label: Zero-Balance Accounts
        }
        lov {
            type: staticValues
            staticValues: STATIC:Hide accounts that close at zero;N,Show every account;Y
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @filter-drawer
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: N
        }
        security {
            encryptSessionState: false
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
    )

    button open-filters (
        buttonName: OPENFILTERS
        label: Advanced Filters
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: ds-filter-trigger
            icon: fa-sliders
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.theme.openRegion('p675Drawer');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-filters (
        buttonName: RESETFILTERS
        label: Reset All Filters
        layout {
            sequence: 100
            region: @filter-drawer
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 903
                clearCache: 704
            }
        }
    )

)

