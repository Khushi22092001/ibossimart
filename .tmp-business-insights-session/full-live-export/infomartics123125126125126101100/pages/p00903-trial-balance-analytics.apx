    region movement-trend (
        name: Monthly Debit and Credit Movement
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select to_char(trunc(d.VoucherDate,'MM'),'Mon RRRR') As LABEL,
                       Round(Sum(Case When nvl(d.Amount,0) < 0 Then -d.Amount Else 0 End)/100000,2) As DEBIT_LAC,
                       Round(Sum(Case When nvl(d.Amount,0) > 0 Then  d.Amount Else 0 End)/100000,2) As CREDIT_LAC
                  From VoucherDetail d
                 Where d.VoucherDate >= to_date(:P903_FROMDATE,'DD-MM-RRRR')
                   And d.VoucherDate <  to_date(:P903_TODATE,'DD-MM-RRRR') + 1
                   And d.Tno Not In (Select v.Tno From Voucher v Where v.VoucherNo = 'OPENING')
                   And (cast(null as varchar2(100)) Is Null Or cast(null as varchar2(100)) = cast(null as varchar2(100)))
                   And (null    Is Null Or cast(null as varchar2(100))        = null)
                   And (:P903_COMPANY  Is Null Or d.CompanyCode  = :P903_COMPANY)
                   And (:P903_LOCATION Is Null Or d.LocationCode = :P903_LOCATION)
                 Group By trunc(d.VoucherDate,'MM')
                 Order By trunc(d.VoucherDate,'MM')
                ```
