    process voucher-posting (
        name: Voucher Posting
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare l_guard boolean := :P184_STATUS='ACTIVE'; l_started boolean:=false; begin
                 savepoint imart_activation_request;
                 if l_guard then imart_txn_integrity.begin_change('SALESGRN',:P184_TNO);l_started:=true;end if;
                 declare
                    tvoucherdate    date;
                    tCreditNoteTno  number;
                begin
                    if :P184_STATUS='ACTIVE' then
                            for vloop in (	
                            			Select VOUCHERPOSTINGDATE From moduleprivilege aa , BOSSUSER BB
                            			Where aa.modulecode='SALESGRN' 
                            			  And AA.BOSSUSERCODE = BB.BOSSUSERCODE
                            			  And BB.LOGINNAME=:GLOBAL_LOGINNAME
                            				And AA.COMPANYCODE = :GLOBAL_COMPANYCODE
                              ) 
                            loop
                            		if vloop.voucherpostingdate = 'SYSTEM' then
                            			tvoucherdate := trunc(sysdate);
                            		else
                            			tvoucherdate := :P184_SalesgrnDate;
                            		end if;
                            end loop;
                            for vcrnote in (
                            SELECT TNO FROM CREDITNOTE WHERE MODULETNO = :P184_TNO
                            ) loop
                                tCreditNoteTno := vcrnote.Tno;
                            end loop;
                			
                
                
                
                            for required_notes in(
                  select count(case when discrepancytypecode in('SHORT','SHORTAGE') and (nvl(discrepancyquantity1,0)>0 or nvl(rejectedquantity1,0)>0) and (nvl(ccinvoicequantity1,0)-nvl(acceptedquantity1,0))*nvl(rate,0)>0 then 1 end) short_rows,
                         count(case when discrepancytypecode='EXCESS' and abs(nvl(discrepancyquantity1,0))*nvl(rate,0)>0 then 1 end) excess_rows,
                         count(case when discrepancytypecode in('NONE','SHORT','SHORTAGE') then 1 end) stock_rows,
                         (select count(*) from creditnote where modulecode='SALESGRN' and moduletno=:P184_TNO) credit_notes,
                         (select count(*) from debitnote where modulecode='SALESGRN' and moduletno=:P184_TNO) debit_notes
                  from salesgrndetail where tno=:P184_TNO
                 )loop
                  if required_notes.short_rows>0 and required_notes.credit_notes=0 then Createcreditnoteforsalesgrn(:P184_TNO,tvoucherdate);end if;
                  if required_notes.excess_rows>0 and required_notes.debit_notes=0 then CreateDebitnoteforsalesgrn(:P184_TNO,tvoucherdate);end if;
                  -- Preserve the existing stock-post eligibility, once per document.
                  if tCreditNoteTno is null and required_notes.stock_rows>0 then PostSalesGrnStock(:P184_TNO);end if;
                 end loop;
                					  
                    END IF;
                end;
                 if l_started then imart_txn_integrity.finish_change('SALESGRN',:P184_TNO);l_started:=false;end if;
                 exception when others then
                 if l_started then imart_txn_integrity.abort_change('SALESGRN',:P184_TNO);end if;
                 begin rollback to imart_activation_request;exception when others then null;end;
                 raise;
                end;
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 173222790446762228
        }
        serverSideCondition {
            type: never
        }
    )

    branch (
        name: Go To Page 183
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 183
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

