    process p184-calculate-detail (
        name: P184_CALCULATE_DETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);v_acceptedquantity1 number:=j.get_number('ACCEPTEDQUANTITY1');
                v_quantity1 number:=j.get_number('q1');
                v_acceptedquantity2 number:=j.get_number('ACCEPTEDQUANTITY2');
                v_rejectedquantity1 number:=j.get_number('REJECTEDQUANTITY1');
                v_rejectedquantity2 number:=j.get_number('REJECTEDQUANTITY2');
                v_quantity2 number:=j.get_number('q2');
                v_ccinvoicequantity1 number:=j.get_number('CCINVOICEQUANTITY1');
                v_discrepancyquantity1 number:=j.get_number('DISCREPANCYQUANTITY1');
                v_discrepancytypecode varchar2(200):=j.get_string('DISCREPANCYTYPECODE');
                v_discrepancyamount number:=j.get_number('DISCREPANCYAMOUNT');
                v_rate number:=j.get_number('rate');
                v_frtdeductionquantity1 number:=j.get_number('FRTDEDUCTIONQUANTITY1');
                v_amount number:=j.get_number('AMOUNT');
                v_dfamount number:=j.get_number('DFAMOUNT');
                v_tno number:=j.get_number('tno');
                v_sno number:=j.get_number('sno');
                v_footeramount number:=j.get_number('FOOTERAMOUNT');
                v_totalamount number:=j.get_number('TOTALAMOUNT');
                v_itemcode varchar2(200):=j.get_string('item');
                v_itemspecificationcode varchar2(200):=j.get_string('spec');
                v_ratemeasuringunitcode varchar2(200):=j.get_string('unit');
                v_hsncode varchar2(200):=j.get_string('HSNCODE');
                v_dfquantity1 number:=j.get_number('DFQUANTITY1');
                v_is_job varchar2(200):=j.get_string('IS_JOB');
                 v_u1 varchar2(30);v_u2 varchar2(30);v_factor number;v_dec1 number;v_dec2 number;hits number;old_auto number;next_value number;
                 previous_amount number:=j.get_number('previousAmount');previous_qty number:=j.get_number('previousQuantity');
                 type footer_rows is table of salesgrndfooter%rowtype;old_rows footer_rows;
                 preview_started boolean:=false;
                 type seen_heads_t is table of boolean index by varchar2(100);seen_heads seen_heads_t;
                 type original_rids_t is table of varchar2(30) index by varchar2(100);original_rids original_rids_t;
                begin
                 if v_tno is null or v_tno!=:P184_TNO then raise_application_error(-20071,'Document identity changed. Reopen this form.');end if;
                 if v_sno is null then v_sno:=globaltno.nextval;end if;
                 select count(*) into hits from salesgrndetail where sno=v_sno and tno!=v_tno;
                 if hits>0 then raise_application_error(-20071,'Detail identity belongs to another document.');end if;
                 select count(*) into hits from salesgrndetail where tno=v_tno and sno=v_sno;
                 if hits>1 then raise_application_error(-20071,'Legacy duplicate detail identity requires document review before recalculation.');end if;
                 if v_itemcode is null  then raise_application_error(-20072,'Select an item/specification or applicable job first.');end if;
                
                 select count(*) into hits from SALESGRN where tno=v_tno and nvl(companycode,'~')<>nvl(:GLOBAL_COMPANYCODE,'~');
                 if hits>0 then raise_application_error(-20074,'Preview belongs to a different company');end if;
                 savepoint o2c_preview_184;preview_started:=true;
                 for f in(select sn,rowid rid from SALESGRNDFOOTER where tno=v_tno and sno=v_sno)loop
                  declare own_sn number:=f.sn;begin if own_sn is null then own_sn:=globaltno.nextval;update SALESGRNDFOOTER set sn=own_sn where rowid=f.rid;end if;original_rids(to_char(own_sn)):=f.rid;end;
                 end loop;
                 if j.has('footers') then
                  declare lines json_array_t:=j.get_array('footers');line json_object_t;r SALESGRNDFOOTER%rowtype;empty_row SALESGRNDFOOTER%rowtype;
                  type cache_rows_t is table of SALESGRNDFOOTER%rowtype;cache_rows cache_rows_t:=cache_rows_t();
                  type seen_keys_t is table of boolean index by varchar2(100);seen_keys seen_keys_t;l_sn number;l_rid varchar2(30);
                  begin
                   for k in 0..lines.get_size()-1 loop
                    line:=treat(lines.get(k) as json_object_t);
                    if nvl(line.get_number('TNO'),-1)<>v_tno or nvl(line.get_number('SNO'),-1)<>v_sno then raise_application_error(-20074,'Preview footer belongs to another detail');end if;
                    if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20074,'Preview footer head or legend missing');end if;
                    l_sn:=line.get_number('SN');
                    
                    if l_sn is null then l_sn:=globaltno.nextval;end if;
                    if seen_keys.exists(to_char(l_sn)) then raise_application_error(-20074,'Duplicate preview footer identity');end if;seen_keys(to_char(l_sn)):=true;
                    select count(*) into hits from SALESGRNDFOOTER where sn=l_sn and(tno<>v_tno or sno<>v_sno) and not exists(select 1 from SALESGRNDFOOTER own where own.tno=v_tno and own.sno=v_sno and own.sn=l_sn);
                    if hits>0 then raise_application_error(-20074,'Preview footer key belongs to another row');end if;
                    r:=empty_row;begin select * into r from SALESGRNDFOOTER where tno=v_tno and sno=v_sno and sn=l_sn;exception when no_data_found then null;end;
                    r.tno:=v_tno;r.sno:=v_sno;r.sn:=l_sn;r.serialno:=k+1;r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');if line.has('TAXFORMCODE') then r.TAXFORMCODE:=line.get_string('TAXFORMCODE');end if;cache_rows.extend;cache_rows(cache_rows.count):=r;
                   end loop;
                   delete from SALESGRNDFOOTER where tno=v_tno and sno=v_sno;
                   for k in 1..cache_rows.count loop r:=cache_rows(k);insert into SALESGRNDFOOTER values r;end loop;
                  end;
                 end if;
                
                 select * bulk collect into old_rows from salesgrndfooter where tno=v_tno and sno=v_sno;
                 if v_itemcode is not null then
                 select measuringunitcode1,measuringunitcode2 into v_u1,v_u2 from item where itemcode=v_itemcode;
                 select max(multiplyingfactor) into v_factor from itemspecification where itemspecificationcode=v_itemspecificationcode;
                 v_dec1:=nvl(getuomdecimal(v_u1),3);v_dec2:=case when v_u2 is null then 3 else nvl(getuomdecimal(v_u2),3) end;
                 
                 v_quantity1:=round(nvl(v_quantity1,0),v_dec1);
                 if v_u2 is not null and nvl(v_factor,0)>0 then
                  if j.get_string('field')='QUANTITY2' then v_quantity1:=round(nvl(v_quantity2,0)/v_factor,v_dec1);else v_quantity2:=round(v_quantity1*v_factor,v_dec2);end if;
                 end if;
                 v_ratemeasuringunitcode:=nvl(v_ratemeasuringunitcode,v_u1);
                 
                end if;
                 if j.get_string('field')='QUANTITY1' and abs(nvl(v_acceptedquantity1,0)-nvl(previous_qty,0))<=.0005 then v_acceptedquantity1:=v_quantity1;end if; if nvl(v_acceptedquantity1,0)>v_quantity1 or nvl(v_acceptedquantity1,0)<0 then raise_application_error(-20072,'Accepted quantity must be between zero and received quantity.');end if;
                 declare
                  tlegendscode varchar2(30);
                  tfooterheadcode varchar2(30);
                  tfooterpercent  number;
                  tfootervalue    number;
                  tfooteramount   number;
                  mfactor number;
                begin
                 mfactor:=v_factor;
                   null;
                   
                   null;
                   
                   v_acceptedquantity1     := nvl(v_acceptedquantity1,v_quantity1);
                   v_acceptedquantity2:=case when v_u2 is not null and v_factor>0 then v_factor*v_acceptedquantity1 else nvl(v_acceptedquantity2,0) end;
                   v_acceptedquantity2     := round(v_acceptedquantity2,v_dec2 ) ;
                   
                   v_rejectedquantity1     :=nvl(v_quantity1,0) -nvl(v_acceptedquantity1,0);
                   
                    v_rejectedquantity2:=case when v_u2 is not null and v_factor>0 then v_factor*v_rejectedquantity1 else nvl(v_quantity2,0)-nvl(v_acceptedquantity2,0) end;
                    v_rejectedquantity2     := round(v_rejectedquantity2,v_dec2 ) ;
                
                select CASE WHEN nvl(v_ccinvoicequantity1,0) - NVL(v_quantity1,0) > 0 then
                                    nvl(v_ccinvoicequantity1,0) - NVL(v_quantity1,0) 
                            WHEN nvl(v_ccinvoicequantity1,0) - NVL(v_quantity1,0) < 0 then
                                    (nvl(v_ccinvoicequantity1,0) - NVL(v_quantity1,0)) * (-1)
                            WHEN nvl(v_ccinvoicequantity1,0) - NVL(v_quantity1,0) = 0 then
                                    0
                 
                       end discrepancyqty,
                
                       CASE WHEN nvl(v_ccinvoicequantity1,0) - NVL(v_quantity1,0) > 0 then
                                    'SHORTAGE' 
                             WHEN nvl(v_ccinvoicequantity1,0) - NVL(v_quantity1,0) < 0 then
                                    'EXCESS'
                            WHEN nvl(v_ccinvoicequantity1,0) - NVL(v_quantity1,0) = 0 then
                                    'NONE'
                
                        end discrepancytype into v_discrepancyquantity1, v_discrepancytypecode
                 from dual;
                
                
                    v_discrepancyquantity1 := nvl(v_ccinvoicequantity1,0) - nvl(v_quantity1,0);
                   v_discrepancyamount     := nvl(v_discrepancyquantity1,0)*nvl(v_rate , 0);
                   
                   v_frtdeductionquantity1 := nvl(v_discrepancyquantity1,0);
                   
                   
                   v_amount := nvl(v_rejectedquantity1,0) *nvl(v_rate,0);
                   
                   v_dfamount := v_amount;
                
                
                
                
                
                   
                   BEGIN
                     for vfooter in (
                	    Select * From salesgrndfooter a where tno = v_tno and SNO = v_sno
                	 ) loop
                
                        tfootervalue:=vfooter.footervalue;
                		if vfooter.legendscode = 'PRA' then 
                			tfootervalue := round((v_amount * vfooter.footerpercent ) /100,0);
                		end if;
                
                		if vfooter.legendscode = 'PRD' then 
                			tfootervalue := (-1)* round((v_amount * vfooter.footerpercent ) /100,0);
                
                		end if;
                		if vfooter.legendscode = 'PAA' then 
                			tfootervalue := round((v_amount * vfooter.footerpercent ) /100,2);
                		end if;
                
                		if vfooter.legendscode = 'PAD' then 
                			tfootervalue := (-1)* round((v_amount * vfooter.footerpercent ) /100,2);
                		end if;
                		if vfooter.legendscode = 'OQA' then 
                			tfootervalue := (-1)* round((nvl(v_rejectedquantity1,0) * vfooter.footerpercent ) /100,2);
                		end if;
                        
                        
                
                		
                         DELETE FROM salesgrndfooter X
                         where x.tno = vfooter.tno
                		   and x.sno = vfooter.sno
                		   and x.sn = vfooter.sn
                		   and x.footerheadcode = vfooter.Footerheadcode
                           ;
                
                          INSERT INTO salesgrndfooter ( TNO,SNO,SN,SERIALNO,FOOTERHEADCODE,FOOTERPERCENT,LEGENDSCODE,FOOTERVALUE)
                          VALUES ( VFOOTER.TNO,VFOOTER.SNO,VFOOTER.SN,VFOOTER.SERIALNO,VFOOTER.FOOTERHEADCODE,VFOOTER.FOOTERPERCENT,VFOOTER.LEGENDSCODE,TFOOTERVALUE);
                
                 
                
                	 end loop;
                	 END;
                     select sum(footervalue) into tfooteramount 
                	 from salesgrndfooter 
                	 where tno = v_tno
                	   and sno = v_sno;
                	   
                	   v_footeramount := nvl(tfooteramount,0);
                	   v_totalamount  := nvl(v_amount,0) + nvl(v_footeramount,0);
                	 
                end;
                
                
                 -- Keep non-formula/manual footer rows; rescale only recognised matching automatic rows.
                 for i in 1..old_rows.count loop
                  if j.get_string('field') in('HEADER','ITEMCODE','ITEMSPECIFICATIONCODE','JOBTYPECODE') and old_rows(i).footerheadcode in('.CGST.','.SGST.','.IGST.') then continue;end if;
                  next_value:=old_rows(i).footervalue;
                  if upper(trim(old_rows(i).legendscode)) in('PRA','PRD','PAA','PAD') and previous_amount is not null then
                   old_auto:=imart_purchasebill_calc.footer_value(old_rows(i).legendscode,previous_amount,old_rows(i).footerpercent,old_rows(i).footervalue,previous_qty);
                   if old_rows(i).legendscode in('PAA','PAD') then old_auto:=round(old_auto,2);end if;
                   if abs(nvl(old_rows(i).footervalue,0)-nvl(old_auto,0))<=.0051 then
                    next_value:=imart_purchasebill_calc.footer_value(old_rows(i).legendscode,v_amount,old_rows(i).footerpercent,old_rows(i).footervalue,v_quantity1);if old_rows(i).legendscode in('PAA','PAD') then next_value:=round(next_value,2);end if;
                   end if;
                  end if;
                  if old_rows(i).footerheadcode='.TCS.' and false then continue;end if;
                  if not seen_heads.exists(old_rows(i).footerheadcode) then
                  delete from salesgrndfooter where tno=v_tno and sno=v_sno and footerheadcode=old_rows(i).footerheadcode;
                   seen_heads(old_rows(i).footerheadcode):=true;
                  end if;
                  insert into salesgrndfooter(tno,sno,sn,footerheadcode,footerpercent,footervalue,serialno,legendscode,taxformcode)values(old_rows(i).tno,old_rows(i).sno,old_rows(i).sn,old_rows(i).footerheadcode,old_rows(i).footerpercent,next_value,old_rows(i).serialno,old_rows(i).legendscode,old_rows(i).taxformcode);
                 end loop;
                 
                 select nvl(sum(footervalue),0) into v_footeramount from salesgrndfooter where tno=v_tno and sno=v_sno;
                 v_totalamount:=nvl(v_amount,0)+v_footeramount;
                 apex_json.open_object;
                 apex_json.write('sno',v_sno,true);
                apex_json.write('q1',v_quantity1,true);
                apex_json.write('q2',v_quantity2,true);
                apex_json.write('rate',v_rate,true);
                apex_json.write('unit',v_ratemeasuringunitcode,true);
                apex_json.write('amount',v_amount,true);
                apex_json.write('footer',v_footeramount,true);
                apex_json.write('total',v_totalamount,true);
                 
                 apex_json.write('ACCEPTEDQUANTITY1',v_acceptedquantity1,true);
                apex_json.write('ACCEPTEDQUANTITY2',v_acceptedquantity2,true);
                apex_json.write('REJECTEDQUANTITY1',v_rejectedquantity1,true);
                apex_json.write('REJECTEDQUANTITY2',v_rejectedquantity2,true);
                apex_json.write('CCINVOICEQUANTITY1',v_ccinvoicequantity1,true);
                apex_json.write('DISCREPANCYQUANTITY1',v_discrepancyquantity1,true);
                apex_json.write('DISCREPANCYTYPECODE',v_discrepancytypecode,true);
                apex_json.write('DISCREPANCYAMOUNT',v_discrepancyamount,true);
                apex_json.write('FRTDEDUCTIONQUANTITY1',v_frtdeductionquantity1,true);
                 apex_json.write('primaryUnit',v_u1,true);apex_json.write('secondaryUnit',v_u2,true);update SALESGRNDFOOTER set sn=globaltno.nextval where tno=v_tno and sno=v_sno and sn is null;
                 apex_json.open_array('footers');
                 for f in(select * from SALESGRNDFOOTER where tno=v_tno and sno=v_sno order by serialno,sn)loop
                  apex_json.open_object;apex_json.write('TNO',f.tno);apex_json.write('SNO',f.sno);apex_json.write('SN',f.sn);apex_json.write('SERIALNO',f.serialno);apex_json.write('FOOTERHEADCODE',f.footerheadcode);apex_json.write('LEGENDSCODE',f.legendscode);apex_json.write('FOOTERPERCENT',f.footerpercent);apex_json.write('FOOTERVALUE',f.footervalue);apex_json.write('TAXFORMCODE',f.TAXFORMCODE,true);apex_json.close_object;
                 end loop;
                 apex_json.close_array;
                 rollback to o2c_preview_184;preview_started:=false;
                 apex_json.close_object;
                exception when others then
                 if preview_started then rollback to o2c_preview_184;end if;raise;
                end;
                ```
        }
        execution {
            sequence: 80
            point: ajaxCallback
        }
