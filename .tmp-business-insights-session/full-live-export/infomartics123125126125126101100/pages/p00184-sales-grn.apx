    pageItem P184_CCINVOICETNO (
        type: popupLov
        label {
            label: CC Invoice No
            alignment: left
        }
        settings {
            popupWidth: 500
            popupHeight: 400
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ccinvoiceno , tno 
                from (select * from CCINVOICE where COMPANYCODE=(select IMART_REFERENCE_SCOPE.company_code(:P184_TNO,:P184_COMPANYCODE) from dual)) a 
                where (A.TNO = :P184_CCINVOICETNO OR 
                    not exists ( select 1 from (select * from SALESGRN where COMPANYCODE=(select IMART_REFERENCE_SCOPE.company_code(:P184_TNO,:P184_COMPANYCODE) from dual)) aa where aa.ccinvoicetno = a.tno))
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @sales-grn
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @sales-grn
            column: CCINVOICETNO
            dataType: number
        }
    )

