            heading {
                heading: Remark
            }
            layout {
                sequence: 130
            }
            validation {
                maxLength: 500
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 140
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SN (
            type: numberField
            heading {
                heading: Sn
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: SN
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            masterDetail {
                masterColumn: @SNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column STORAGELOCATIONCODE (
            type: popupLov
            heading {
                heading: Storage Location
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery: select storagelocationname , storagelocationcode from storagelocation
                displayNullValue: false
            }
            layout {
                sequence: 120
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: STORAGELOCATIONCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            masterDetail {
                masterColumn: @TNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: StockDetail
        }
    )

