    pageItem P184_CREDITNOTEVRNO (
        type: textField
        label {
            label: Credit Note Vr No
            alignment: left
        }
        layout {
            sequence: 30
            region: @other-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 50
        }
        advanced {
            customAttributes: readonly=true
            postText:
                ```html
                <a href="f?p=&APP_ID.:156:&SESSION.::NO:RP,156:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS,P156_CALLEDFROMTNO:&P184_CREDITNOTEVRTNO.,184,CALLED,&P184_TNO."><span class="fa fa-magic"></span></a>
                
                ```
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select VOUCHERNO from voucher 
                where moduletno in (
                                    select tno from creditnote
                                    where MODULETNO= :P184_TNO
                );
                ```
        }
    )

