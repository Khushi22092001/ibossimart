    process detail-footer-save-interactive-grid-data (
        name: Detail Footer - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail-footer
        source {
            plsqlCode:
                ```plsql
                declare l_rows number;
                begin
                 if :TNO is not null and :TNO<>:P159_TNO then raise_application_error(-20074,'Footer row belongs to a different document');end if;
                 if :SNO is null then raise_application_error(-20074,'Footer detail identity is missing');end if;
                 case :APEX$ROW_STATUS
                 when 'C' then
                  select count(*) into l_rows from DEBITNOTEDETAIL where tno=:P159_TNO and sno=:SNO;
                  if l_rows<>1 then raise_application_error(-20074,'Footer owning detail is missing or duplicated');end if;
                  :TNO:=:P159_TNO;
                  select globaltno.nextval into :SN from dual;
                  insert into DEBITNOTEDETAILFOOTER(TNO,SNO,SN,SERIALNO,FOOTERHEADCODE,FOOTERPERCENT,FOOTERVALUE,LEGENDSCODE)
                  values(:TNO,:SNO,:SN,:SERIALNO,:FOOTERHEADCODE,:FOOTERPERCENT,:FOOTERVALUE,:LEGENDSCODE);
                 when 'U' then
                  if :TNO is null or :SN is null then raise_application_error(-20074,'Footer identity is missing');end if;
                  update DEBITNOTEDETAILFOOTER set SERIALNO=:SERIALNO,FOOTERHEADCODE=:FOOTERHEADCODE,FOOTERPERCENT=:FOOTERPERCENT,FOOTERVALUE=:FOOTERVALUE,LEGENDSCODE=:LEGENDSCODE
                  where tno=:P159_TNO and sno=:SNO and sn=:SN;
                  if sql%rowcount<>1 then raise_application_error(-20074,'Footer row is missing or duplicated; update blocked');end if;
                 when 'D' then
                  if :TNO is null or :SN is null then raise_application_error(-20074,'Footer identity is missing');end if;
                  delete from DEBITNOTEDETAILFOOTER where tno=:P159_TNO and sno=:SNO and sn=:SN;
                  if sql%rowcount<>1 then raise_application_error(-20074,'Footer row is missing or duplicated; delete blocked');end if;
                 end case;
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 167665163340237882
        }
        serverSideCondition {
            type: never
        }
    )

