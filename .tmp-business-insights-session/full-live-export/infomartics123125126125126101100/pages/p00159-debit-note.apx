        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region detail-2 (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       TOLERANCE,
                       RATEMEASURINGUNITCODE,
                       RATE,
                       AMOUNT,
                       FOOTERAMOUNT,
                       TOTALAMOUNT,
                       REMARK,
                       DOCUMENTSTATUSCODE,
                       LOWERTOLERANCEPERCENT,
                       HIGHERTOLERANCEPERCENT,
                       DESPATCHADVICEQUANTITY1,
                       DESPATCHADVICEQUANTITY2,
                       CCINVOICEQUANTITY1,
                       CCINVOICEQUANTITY2,
                       PRORATA,
                       QUALITYCODE,
                       TAXRULECODE,
                       JOBTYPECODE,
                       MODULETNO,
                       MODULESNO,
                       MODULECODE,
                       PURCHASEORDERTNO,
                       ROUNDING,
                       'FD' as FD,
                       'SD' as SD, 
                       (select measuringunitcode1 from item where itemcode=DEBITNOTEDETAIL.ITEMCODE) as Unit1,
                       (select measuringunitcode2 from item where itemcode=DEBITNOTEDETAIL.ITEMCODE) as Unit2
                  from DEBITNOTEDETAIL
                  where tno = :P159_TNO
                ```
            pageItemsToSubmit: P159_TNO
        }
        layout {
            sequence: 10
            parentRegion: @detail
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail
