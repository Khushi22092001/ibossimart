              }finally{restore();}});
              function invalidEditor(){return Object.keys(invalid).some(function(key){var parts=key.split(':'),v=grid(parts[0]),r=v&&v.model.getRecord(parts[1]);return r&&!(v.model.getRecordMetadata(parts[1])||{}).deleted;});}
