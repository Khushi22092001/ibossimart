        action native-disable-4 (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 110
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P159_VOUCHERNO
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare l_guard boolean := GetDocumentStatusCode('DEBITNOTE',:P159_TNO)='ACTIVE'; l_started boolean:=false; begin
                     savepoint imart_activation_request;
                     if l_guard then imart_txn_integrity.begin_change('DEBITNOTE',:P159_TNO);l_started:=true;end if;
                     Declare 
                    	tVoucherDate Date := nvl(to_date(:P159_DEBITNOTEDATE, 'DD-MM-RRRR'), to_date(trunc(sysdate), 'DD-MM-RRRR'));
                        temp number;
                        tVouherNo Varchar2(100);
                        ttno number := :P159_TNO;
                    Begin
                        temp := 0;
                    	select
                    			count(a.tno) into temp
                    	from Voucher a
                    	where a.ModuleCode = GetModuleCodeForPageNo(:APP_PAGE_ID) 
                    			and a.ModuleTNo = ttno
                    	;
                       
                       if GetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID), ttno) = 'ACTIVE' then
                        	if nvl(temp, 0) = 0 then		
                        		Begin
                        			PostDebitNote_temp(:P159_TNO, tVoucherDate);
                                Exception
                        			when others then
                        					null;
                                            raise_application_error(-20000, 'Voucher not posting. ' || sqlerrm);
                        		End;
                        	end if;
                        end if;
                    end;
                     if l_started then imart_txn_integrity.finish_change('DEBITNOTE',:P159_TNO);l_started:=false;end if;
                     exception when others then
                     if l_started then imart_txn_integrity.abort_change('DEBITNOTE',:P159_TNO);end if;
                     begin rollback to imart_activation_request;exception when others then null;end;
                     raise;
                    end;
                    ```
                itemsToSubmit: [
                    P159_DEBITNOTEDATE
                    P159_TNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: items
                items: P159_VOUCHERNO
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                        rtvalue number;
                    begin
                        for vVoucher in
                            (
                            Select
                                a.Tno
                            From Voucher a
                            where a.ModuleTno = :P159_TNO
                            )
                        loop
                            rtvalue := vVoucher.Tno;
                            exit;
                        end loop;
                        return rtvalue;
                    end;
                    ```
                itemsToSubmit: P159_TNO
                escapeSpecialChars: false
            }
            affectedElements {
                selectionType: items
                items: P159_VOUCHERTNO
            }
            execution {
                sequence: 40
