    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 370
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action imart-debitnote-dirty-status (
            action: executeJsCode
            settings {
                jsCode: "if(window.hsplP159HasUnsaved&&window.hsplP159HasUnsaved()){apex.da.cancel();apex.message.showErrors([{type:'error',location:'page',message:'Save header, detail, stock allocation and FD edits before changing document status.',unsafe:false}]);}"
            }
            execution {
                sequence: 1
                fireOnInit: false
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P159_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    IMART_REFERENCE_SCOPE.assert_reference('VOUCHER',:P159_VOUCHERTNO,IMART_REFERENCE_SCOPE.company_code,'P159_VOUCHERTNO');
                    declare l_guard boolean := :P159_STATUS='ACTIVE'; l_started boolean:=false; begin
                     savepoint imart_activation_request;
                     if l_guard then imart_txn_integrity.begin_change('DEBITNOTE',:P159_TNO);l_started:=true;end if;
                     --SetDocumentStatusCode('PURCHASEORDER',13604,:P159_STATUS);
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P159_TNO,:P159_STATUS);
                    if :P159_STATUS = 'ACTIVE' and :P159_VOUCHERTNO  is null  then
                        -- POSTDEBITNOTE(:P159_TNO,TO_DATE(:P159_DEBITNOTEDATE));
                        PostDebitNote_temp(:P159_TNO,TO_DATE(:P159_DEBITNOTEDATE));  --Created by Vibhor
                    
                        IF :P159_STOCKREQUIRED = 'YES' THEN
                    
                            PostDebitNoteStock_Temp(:P159_TNO);
                    
                            apex_debug.message(
                                p_message => 'PostDebitNoteStock_Temp completed for TNO: %s', 
                                p0        => :P159_TNO
                            );
                        ELSE
                           apex_debug.message(
                                p_message => 'PostDebitNoteStock_Temp Not completed for TNO: %s', 
                                p0        => :P159_TNO
                            );
                        END IF;
                    
                    end if;
                     if l_started then imart_txn_integrity.finish_change('DEBITNOTE',:P159_TNO);l_started:=false;end if;
                     exception when others then
                     if l_started then imart_txn_integrity.abort_change('DEBITNOTE',:P159_TNO);end if;
                     begin rollback to imart_activation_request;exception when others then null;end;
                     raise;
                    end;
                    end;
                    ```
                itemsToSubmit: [
                    P159_TNO
                    P159_STATUS
                    P159_DEBITNOTEDATE
                    P159_VOUCHERTNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text($v('P159_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P159_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

