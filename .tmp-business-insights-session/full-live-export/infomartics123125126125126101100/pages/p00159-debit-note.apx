                                    CCINVOICEQUANTITY1=:CCINVOICEQUANTITY1,
                                    CCINVOICEQUANTITY2=:CCINVOICEQUANTITY2,
                                    PRORATA=:PRORATA,
                                    QUALITYCODE=:QUALITYCODE,
                                    TAXRULECODE=:TAXRULECODE,
