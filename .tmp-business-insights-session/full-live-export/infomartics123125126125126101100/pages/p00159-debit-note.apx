    process save-all-edited-debit-note-row-footers (
        name: Save all edited Debit Note row footers
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 edits json_object_t;keys json_key_list;lines json_array_t;line json_object_t;own_sno number;own_sn number;own_rid varchar2(30);hits number;
                 r DEBITNOTEDETAILFOOTER%rowtype;empty_row DEBITNOTEDETAILFOOTER%rowtype;
                 type rows_t is table of DEBITNOTEDETAILFOOTER%rowtype;pending_rows rows_t:=rows_t();
                 type seen_t is table of boolean index by varchar2(100);seen seen_t;
                begin
                 if :P159_FD_EDITS is null then return;end if;
                 edits:=json_object_t.parse(:P159_FD_EDITS);keys:=edits.get_keys;
                 for i in 1..keys.count loop
                  own_sno:=to_number(keys(i));select count(*) into hits from DEBITNOTEDETAIL where tno=:P159_TNO and sno=own_sno;
                  if hits<>1 then raise_application_error(-20073,'Footer does not belong to exactly one saved detail row.');end if;
                  lines:=edits.get_array(keys(i));pending_rows:=rows_t();seen.delete;
                  for k in 0..lines.get_size()-1 loop
                   line:=treat(lines.get(k) as json_object_t);
                   if nvl(line.get_number('TNO'),-1)<>:P159_TNO or nvl(line.get_number('SNO'),-1)<>own_sno then raise_application_error(-20073,'Footer owner changed.');end if;
                   if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20073,'Select a footer head and legend.');end if;
                   own_rid:=line.get_string('ROWID');own_sn:=line.get_number('SN');r:=empty_row;
                   if own_rid is not null and not regexp_like(own_rid,'^t[0-9]+$') then
                    begin select * into r from DEBITNOTEDETAILFOOTER where rowid=chartorowid(own_rid) and tno=:P159_TNO and sno=own_sno;exception when no_data_found then raise_application_error(-20073,'Footer ROWID is stale or belongs to another detail.');end;
                    if r.sn is not null and own_sn is not null and r.sn<>own_sn then raise_application_error(-20073,'Footer SN and ROWID disagree.');end if;own_sn:=nvl(own_sn,r.sn);
                   elsif own_rid is not null then
                    null; /* APEX temporary ROWID is a client key, not a durable footer SN. */
                   end if;
                   if own_sn is not null then
                    select count(*) into hits from DEBITNOTEDETAILFOOTER where sn=own_sn and(tno<>:P159_TNO or sno<>own_sno);
                    if hits>0 then raise_application_error(-20073,'Footer SN belongs to another detail.');end if;
                    if r.tno is null then begin select * into r from DEBITNOTEDETAILFOOTER where tno=:P159_TNO and sno=own_sno and sn=own_sn;exception when no_data_found then null;when too_many_rows then raise_application_error(-20073,'Duplicated stored footer SN requires review.');end;end if;
                   else own_sn:=globaltno.nextval;end if;
                   if seen.exists(to_char(own_sn)) then raise_application_error(-20073,'Duplicate footer SN in Save payload.');end if;seen(to_char(own_sn)):=true;
                   r.tno:=:P159_TNO;r.sno:=own_sno;r.sn:=own_sn;
                   if line.has('FOOTERHEADCODE') then r.FOOTERHEADCODE:=line.get_string('FOOTERHEADCODE');end if;
                   if line.has('FOOTERPERCENT') then r.FOOTERPERCENT:=line.get_number('FOOTERPERCENT');end if;
                   if line.has('FOOTERVALUE') then r.FOOTERVALUE:=line.get_number('FOOTERVALUE');end if;
                   if line.has('SERIALNO') then r.SERIALNO:=line.get_number('SERIALNO');end if;
                   if line.has('LEGENDSCODE') then r.LEGENDSCODE:=line.get_string('LEGENDSCODE');end if;
                   if line.has('TAXFORMCODE') then r.taxformcode:=line.get_string('TAXFORMCODE');end if;
                   if line.has('FOOTERNATURECODE') then r.footernaturecode:=line.get_string('FOOTERNATURECODE');end if;
                   if line.has('FOOTERNATUREUSER') then r.footernatureuser:=line.get_string('FOOTERNATUREUSER');end if;
                   r.serialno:=k+1;
                   pending_rows.extend;pending_rows(pending_rows.count):=r;
                  end loop;
                  delete from DEBITNOTEDETAILFOOTER where tno=:P159_TNO and sno=own_sno;
                  for k in 1..pending_rows.count loop r:=pending_rows(k);insert into DEBITNOTEDETAILFOOTER values r;end loop;
                 end loop;
                end;
                ```
        }
        execution {
            sequence: 55
        }
        advanced {
            executionMappingIdentifier: 99015920260929054
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE
        }
    )

    process save-footer (
        name: save footer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                  DELETE FROM debitnotefooter WHERE tno = :P159_TNO;
                
                  INSERT INTO debitnotefooter (TNO, SNO, SERIALNO, FOOTERHEADCODE, FOOTERVALUE)
                  SELECT 
                    TNO, 
                    GLOBALTNO.NEXTVAL, 
                    SERIALNO, 
                    FOOTERHEADCODE, 
                    sumofvalue
                  FROM (
                    SELECT 
                      :P159_TNO AS TNO, 
                      SERIALNO, 
                      FOOTERHEADCODE, 
                      SUM(FOOTERVALUE) AS sumofvalue
                    FROM debitnotedetailfooter 
                    WHERE tno = :P159_TNO 
                    GROUP BY FOOTERHEADCODE, SERIALNO
                  );
                END;
                
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 76785164954548638
        }
    )

