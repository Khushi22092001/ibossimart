              apex.jQuery(document).on('input.p159Immediate','#QUANTITY1,#QUANTITY2,#RATE,#FOOTERPERCENT,#FOOTERVALUE,input[id^="C"]',function(){var owner=activeOwner(this);if(!owner||["QUANTITY1","QUANTITY2","RATE","FOOTERPERCENT","FOOTERVALUE"].indexOf(owner.field)<0)return;var property=owner.field,m=owner.view.model,r=owner.record,id=m.getRecordId(r),key=owner.region+':'+id+':'+property,text=String(this.value).trim(),restore=preserveEditor();try{
