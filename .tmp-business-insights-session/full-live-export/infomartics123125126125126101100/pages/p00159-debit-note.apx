            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select Distinct
                    sl.StorageLocationName , 
                    sl.StorageLocationCode 
                    from Stock s 
                    Left join StorageLocation sl on sl.StorageLocationCode = s.StorageLocationCode
                    order by 1
                    ```
            }
            layout {
                sequence: 70
