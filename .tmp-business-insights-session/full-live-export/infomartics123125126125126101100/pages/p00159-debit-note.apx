    process p159-calculate-detail (
        name: P159_CALCULATE_DETAIL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 j json_object_t:=json_object_t.parse(apex_application.g_x01);
                 v_tno number:=j.get_number('tno');v_sno number:=j.get_number('sno');hits number;
                 q1 number;q2 number;amount number;footer number;total number;old_amount number:=j.get_number('previousAmount');old_qty number:=j.get_number('previousQuantity');
                 job_code varchar2(100):=j.get_string('JOBTYPECODE');item_code varchar2(100):=j.get_string('item');spec_code varchar2(100):=j.get_string('spec');sac_code varchar2(100);unit1 varchar2(100);unit2 varchar2(100);rate_unit varchar2(100):=j.get_string('unit');factor number;is_job number:=0;tax_round varchar2(3):=:P159_TAXINROUNDFIGURE;preview_started boolean:=false;
                 type footer_rows_t is table of DEBITNOTEDETAILFOOTER%rowtype;old_rows footer_rows_t;
                 type keys_t is table of boolean index by varchar2(100);seen_heads keys_t;
                 type rids_t is table of varchar2(30) index by varchar2(100);original_rids rids_t;
                 function job_footer_value(legend varchar2,base_amount number,percent number,current_value number,quantity number) return number is code varchar2(30):=upper(trim(legend));begin
                 case code when 'PRA' then return round(abs(nvl(base_amount,0)*nvl(percent,0)/100),0);when 'PRD' then return -round(abs(nvl(base_amount,0)*nvl(percent,0)/100),0);when 'PAA' then return round(abs(nvl(base_amount,0)*nvl(percent,0)/100),2);when 'PAD' then return -round(abs(nvl(base_amount,0)*nvl(percent,0)/100),2);when 'OQA' then return abs(nvl(quantity,0)*nvl(percent,0));when 'OQD' then return -abs(nvl(quantity,0)*nvl(percent,0));when 'LSA' then return abs(nvl(current_value,0));when 'LSD' then return -abs(nvl(current_value,0));else return nvl(current_value,0);end case;end;
                
                begin
                 if v_tno is null or v_tno<>:P159_TNO then raise_application_error(-20074,'Debit Note document identity changed');end if;
                 if v_sno is null then v_sno:=globaltno.nextval;end if;
                 select count(*) into hits from DEBITNOTEDETAIL where sno=v_sno and tno<>v_tno;
                 if hits>0 then raise_application_error(-20074,'Debit Note detail belongs to another document');end if;
                 select count(*) into hits from DEBITNOTE where tno=v_tno and nvl(companycode,'~')<>nvl(:GLOBAL_COMPANYCODE,'~');
                 if hits>0 then raise_application_error(-20074,'Debit Note belongs to another company');end if;
                 if old_amount is null then begin select amount,quantity1 into old_amount,old_qty from DEBITNOTEDETAIL where tno=v_tno and sno=v_sno;exception when no_data_found then old_amount:=0;old_qty:=0;end;end if;
                 savepoint debitnote_preview;preview_started:=true;
                 for f in(select sn,rowid rid from DEBITNOTEDETAILFOOTER where tno=v_tno and sno=v_sno)loop
                  declare own_sn number:=f.sn;begin if own_sn is null then own_sn:=globaltno.nextval;update DEBITNOTEDETAILFOOTER set sn=own_sn where rowid=f.rid;end if;original_rids(to_char(own_sn)):=f.rid;end;
                 end loop;
                 if j.has('footers') then
                  declare lines json_array_t:=j.get_array('footers');line json_object_t;r DEBITNOTEDETAILFOOTER%rowtype;empty_row DEBITNOTEDETAILFOOTER%rowtype;cache_rows footer_rows_t:=footer_rows_t();seen keys_t;own_sn number;own_rid varchar2(30);
                  begin
                   for k in 0..lines.get_size()-1 loop
                    line:=treat(lines.get(k) as json_object_t);r:=empty_row;
                    if nvl(line.get_number('TNO'),-1)<>v_tno or nvl(line.get_number('SNO'),-1)<>v_sno then raise_application_error(-20074,'Preview footer belongs to another detail');end if;
                    if line.get_string('FOOTERHEADCODE') is null or line.get_string('LEGENDSCODE') is null then raise_application_error(-20074,'Select a footer head and legend');end if;
                    own_sn:=line.get_number('SN');own_rid:=line.get_string('ROWID');
                    if own_rid is not null and not regexp_like(own_rid,'^t[0-9]+$') then
                     begin select * into r from DEBITNOTEDETAILFOOTER where rowid=chartorowid(own_rid) and tno=v_tno and sno=v_sno;exception when no_data_found then raise_application_error(-20074,'Footer ROWID is stale or belongs to another detail');end;
                     if own_sn is not null and r.sn<>own_sn then raise_application_error(-20074,'Footer SN and ROWID disagree');end if;own_sn:=nvl(own_sn,r.sn);
                    elsif own_rid is not null then
                     null; /* APEX temporary ROWID is a client key, not a durable footer SN. */
                    end if;
                    if own_sn is null then own_sn:=globaltno.nextval;end if;
                    if seen.exists(to_char(own_sn)) then raise_application_error(-20074,'Duplicate footer SN');end if;seen(to_char(own_sn)):=true;
                    select count(*) into hits from DEBITNOTEDETAILFOOTER where sn=own_sn and(tno<>v_tno or sno<>v_sno);if hits>0 then raise_application_error(-20074,'Footer SN belongs to another detail');end if;
                    if r.tno is null then begin select * into r from DEBITNOTEDETAILFOOTER where tno=v_tno and sno=v_sno and sn=own_sn;exception when no_data_found then null;end;end if;
                    r.tno:=v_tno;r.sno:=v_sno;r.sn:=own_sn;r.serialno:=k+1;r.footerheadcode:=line.get_string('FOOTERHEADCODE');r.legendscode:=line.get_string('LEGENDSCODE');r.footerpercent:=line.get_number('FOOTERPERCENT');r.footervalue:=line.get_number('FOOTERVALUE');
                    if line.has('TAXFORMCODE') then r.taxformcode:=line.get_string('TAXFORMCODE');end if;if line.has('FOOTERNATURECODE') then r.footernaturecode:=line.get_string('FOOTERNATURECODE');end if;if line.has('FOOTERNATUREUSER') then r.footernatureuser:=line.get_string('FOOTERNATUREUSER');end if;
                    cache_rows.extend;cache_rows(cache_rows.count):=r;
                   end loop;
                   delete from DEBITNOTEDETAILFOOTER where tno=v_tno and sno=v_sno;
                   for k in 1..cache_rows.count loop r:=cache_rows(k);insert into DEBITNOTEDETAILFOOTER values r;end loop;
                  end;
                 end if;
                 select * bulk collect into old_rows from DEBITNOTEDETAILFOOTER where tno=v_tno and sno=v_sno;
                 delete from DEBITNOTEDETAILFOOTER where tno=v_tno and sno=v_sno;
                 q1:=nvl(j.get_number('q1'),0);q2:=nvl(j.get_number('q2'),0);
                 if item_code is not null then
                  select count(*) into hits from item where itemcode=item_code;if hits<>1 then raise_application_error(-20074,'Select one valid item');end if;
                  select measuringunitcode1,measuringunitcode2 into unit1,unit2 from item where itemcode=item_code;
                  select count(*) into hits from itemspecification where itemspecificationcode=spec_code and tno in(select tno from item where itemcode=item_code);if hits<>1 then raise_application_error(-20074,'Specification does not belong to selected item');end if;
                  select multiplyingfactor,trim(hsncode) into factor,sac_code from itemspecification where itemspecificationcode=spec_code and tno in(select tno from item where itemcode=item_code);
                  if j.get_string('field')='QUANTITY2' then
                   if unit2 is null or nvl(factor,0)<=0 then raise_application_error(-20074,'Secondary Debit Note quantity requires a configured secondary UOM and positive conversion factor');end if;
                   q1:=q2/factor;
                  end if;
                  q1:=round(q1,getuomdecimal(unit1));q2:=round(q1*nvl(factor,1),3);
                  if rate_unit is null or j.get_string('field') in('ITEMCODE','ITEMSPECIFICATIONCODE') then rate_unit:=unit1;end if;
                  if rate_unit=unit1 then amount:=q1*nvl(j.get_number('rate'),0);elsif unit2 is not null and rate_unit=unit2 then amount:=q2*nvl(j.get_number('rate'),0);else raise_application_error(-20074,'Rate UOM does not belong to selected item');end if;
                 elsif job_code is not null then
                  select count(*) into hits from jobtype where jobtypecode=job_code;if hits<>1 then raise_application_error(-20074,'Select one valid Job Type');end if;
                  select trim(saccode) into sac_code from jobtype where jobtypecode=job_code;is_job:=1;amount:=q1*nvl(j.get_number('rate'),0);
                 else raise_application_error(-20074,'Select an item or Job Type');end if;
                 if amount>0 then
                  for f in(select rownum serialno,x.* from(
                   select a.legendscode,c.footerheadcode,b.taxrate footerpercent
                   from taxruledetail a join taxruledetailfooter b on b.tno=a.tno and b.sno=a.sno
                   join footerhead c on c.footerheadcode=b.footerheadcode join taxrule d on d.tno=a.tno
                   join party p on p.taxregistrationtypecode=d.taxregistrationtypecode
                   where p.partycode=:P159_PARTYCODE and d.transactiontypecode=:P159_TRANSACTIONTYPECODE and ((is_job=1 and exists(select 1 from taxrulesac e where e.tno=d.tno and trim(e.saccode)=sac_code)) or (is_job=0 and exists(select 1 from taxrulehsn e where e.tno=d.tno and trim(e.hsncode)=sac_code)))
                  )x)loop
                   declare legend varchar2(30):=f.legendscode;val number;begin
                    if tax_round='YES' and legend='PAA' then legend:='PRA';elsif tax_round='NO' and legend='PRA' then legend:='PAA';end if;
                    val:=job_footer_value(legend,amount,f.footerpercent,0,q1);
                    insert into DEBITNOTEDETAILFOOTER(tno,sno,sn,serialno,footerheadcode,footerpercent,footervalue,legendscode) values(v_tno,v_sno,globaltno.nextval,f.serialno,f.footerheadcode,f.footerpercent,val,legend);
                   end;
                  end loop;
                 end if;
                 for k in 1..old_rows.count loop
                  if j.get_string('field') in('HEADER','JOBTYPECODE','ITEMCODE','ITEMSPECIFICATIONCODE','TAX_ROUND') and old_rows(k).footerheadcode in('.CGST.','.SGST.','.IGST.') then continue;end if;
                  if not seen_heads.exists(old_rows(k).footerheadcode) then delete from DEBITNOTEDETAILFOOTER where tno=v_tno and sno=v_sno and footerheadcode=old_rows(k).footerheadcode;seen_heads(old_rows(k).footerheadcode):=true;end if;
                  if upper(trim(old_rows(k).legendscode)) in('PRA','PRD','PAA','PAD','OQA','OQD') and (
                   abs(nvl(old_rows(k).footervalue,0)-job_footer_value(old_rows(k).legendscode,old_amount,old_rows(k).footerpercent,old_rows(k).footervalue,old_qty))<=.0051
                   or (upper(trim(old_rows(k).legendscode))='OQA' and abs(nvl(old_rows(k).footervalue,0)+abs(nvl(old_qty,0)*nvl(old_rows(k).footerpercent,0)/100))<=.0051)
                   or (upper(trim(old_rows(k).legendscode))='OQA' and abs(nvl(old_rows(k).footervalue,0)-abs(nvl(old_qty,0)*nvl(old_rows(k).footerpercent,0)/100))<=.0051)
                   or (upper(trim(old_rows(k).legendscode))='OQD' and abs(nvl(old_rows(k).footervalue,0)+abs(nvl(old_qty,0)*nvl(old_rows(k).footerpercent,0)/100))<=.0051)) then
                   old_rows(k).footervalue:=job_footer_value(old_rows(k).legendscode,amount,old_rows(k).footerpercent,old_rows(k).footervalue,q1);
                  elsif upper(trim(old_rows(k).legendscode)) in('LSA','LSD') then old_rows(k).footervalue:=job_footer_value(old_rows(k).legendscode,amount,old_rows(k).footerpercent,old_rows(k).footervalue,q1);end if;
                  insert into DEBITNOTEDETAILFOOTER values old_rows(k);
                 end loop;
                 select nvl(sum(footervalue),0) into footer from DEBITNOTEDETAILFOOTER where tno=v_tno and sno=v_sno;total:=amount+footer;
                 apex_json.open_object;apex_json.write('sno',v_sno);apex_json.write('q1',q1);apex_json.write('q2',q2);apex_json.write('rate',j.get_number('rate'));apex_json.write('unit',rate_unit);apex_json.write('amount',amount);apex_json.write('footer',footer);apex_json.write('total',total);apex_json.write('primaryUnit',unit1);apex_json.write('secondaryUnit',unit2);
                 apex_json.open_array('footers');
                 for f in(select * from DEBITNOTEDETAILFOOTER where tno=v_tno and sno=v_sno order by serialno,sn)loop
                  apex_json.open_object;apex_json.write('TNO',f.tno);apex_json.write('SNO',f.sno);apex_json.write('SN',f.sn);apex_json.write('SERIALNO',f.serialno);apex_json.write('FOOTERHEADCODE',f.footerheadcode);apex_json.write('LEGENDSCODE',f.legendscode);apex_json.write('FOOTERPERCENT',f.footerpercent);apex_json.write('FOOTERVALUE',f.footervalue);apex_json.write('TAXFORMCODE',f.taxformcode,true);apex_json.write('FOOTERNATURECODE',f.footernaturecode,true);apex_json.write('FOOTERNATUREUSER',f.footernatureuser,true);declare incl varchar2(3);begin select includewithtaxableamount into incl from footerhead where footerheadcode=f.footerheadcode;apex_json.write('INCLUDEWITHTAXABLEAMOUNT',incl,true);end;
                  if original_rids.exists(to_char(f.sn)) then apex_json.write('ROWID',original_rids(to_char(f.sn)));else apex_json.write('ROWID','t'||to_char(f.sn));end if;apex_json.close_object;
                 end loop;
                 apex_json.close_array;rollback to debitnote_preview;preview_started:=false;apex_json.close_object;
                exception when others then if preview_started then rollback to debitnote_preview;end if;raise;
                end;
                
                ```
        }
        execution {
            sequence: 0
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99015920260929052
        }
    )

    process p159-footer-calculate (
        name: P159_FOOTER_CALCULATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare j json_object_t:=json_object_t.parse(apex_application.g_x01);head varchar2(100):=j.get_string('head');legend varchar2(100):=upper(trim(j.get_string('legend')));percent number:=j.get_number('percent');result_value number:=j.get_number('value');base_amount number:=j.get_number('amount');quantity number:=j.get_number('quantity');begin
                if legend in('OQA','OQD') then if quantity is null then raise_application_error(-20074,'Owning detail quantity is missing');end if;result_value:=abs(quantity*nvl(percent,0));if legend='OQD' then result_value:=-result_value;end if;elsif legend='LSA' then result_value:=abs(nvl(result_value,0));elsif legend='LSD' then result_value:=-abs(nvl(result_value,0));else
                declare	
                	cursor cFooterSchemeDetail is
                		select a.* 
                		from FooterSchemeList a, FooterSchemeList c
                		where a.tno = c.tno
                			and a.Status = 'ACTIVE'
                			and c.FooterHeadCode = head
                			and a.sno < c.sno 
                			and a.companycode = :global_CompanyCode
                			and a.financialyearcode = :global_financialyearcode
                			and a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                			and c.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                		order by a.sno;
                	vFooterSchemeDetail cFooterSchemeDetail%ROWTYPE;
                	
                	cursor c3FooterSchemeDetail is
                		select a.* 
                		from FooterSchemeList a, FooterSchemeList c
                		where a.tno = c.tno
                			and a.Status = 'ACTIVE'
                			and c.FooterHeadCode = head
                			and a.companycode = :global_CompanyCode
                			and a.financialyearcode = :global_financialyearcode
                			and a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                			and c.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                		order by a.sno;
                	v3FooterSchemeDetail c3FooterSchemeDetail%ROWTYPE;
                
                
                	cursor c2FooterSchemeDetail is
                		select a.* 
                		from FooterSchemeList a
                		where a.Status = 'ACTIVE'
                			and a.FooterHeadCode = head
                			and a.companycode = :global_CompanyCode
                			and a.financialyearcode = :global_financialyearcode
                			and a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                		order by a.sno;
                	v2FooterSchemeDetail c2FooterSchemeDetail%ROWTYPE;
                	
                	myFormula varchar2(1000);
                	isFound varchar2(10);
                	fvalue number;
                    tTotalDetailAmount number;
                    tmp varchar2(100);
                	
                BEGIN
                  /*for vBookingDetail in
                        (
                        Select
                            sum(a.Amount) as TotalAmount
                        From BookingDetail a
                        Where a.Tno = :P93_Tno
                        )
                    loop
                        tTotalDetailAmount := vBookingDetail.TotalAmount;
                    end loop;*/
                    tTotalDetailAmount := base_amount;
                
                  open c2FooterSchemeDetail;
                  fetch c2FooterSchemeDetail into v2FooterSchemeDetail;
                  if c2FooterSchemeDetail%FOUND then
                  		if length(nvl(v2FooterSchemeDetail.Formula,''))>0 then
                  				myFormula := v2FooterSchemeDetail.Formula;
                  				myFormula := replace(myFormula, '.A.', nvl(tTotalDetailAmount,0) );
                  				for vFooterSchemeDetail  in cFooterSchemeDetail 
                  				loop
                					if head = vFooterSchemeDetail.FooterHeadCode then
                							isFound := 'YES';
                							myFormula := replace(myFormula, vFooterSchemeDetail.FooterHeadCode, nvl(result_value,0) );
                							exit;
                					end if;
                  				end loop;
                  				
                  					myFormula := replace(myFormula, v2FooterSchemeDetail.FooterHeadCode, nvl(percent,0) );
                  			
                  				for v3FooterSchemeDetail  in c3FooterSchemeDetail 
                  				loop
                  						myFormula := replace(myFormula, v3FooterSchemeDetail.FooterHeadCode, '0' );
                  				end loop;
                  				if (legend is null and NVL(GetMYparametervalue('LEGENDS'),'YES') = 'NO') then 
                					myFormula := replace(myFormula, v2FooterSchemeDetail.FooterHeadCode, nvl(percent,0));
                					result_value := getvalue(myformula);
                			    end if;
                
                                
                
                		  		if (legend is not null and  NVL(GetMyparametervalue('LEGENDS'),'NO')= 'YES') then 
                		  				select getvalue(myFormula) into  fvalue 	from dual;
                
                                          
                                      
                		  				if legend = 'PRA' then 
                		  					 	result_value := nvl(round(fvalue,0),0);
                		  					
                
                                                 
                                                
                		  				end if;
                		  				
                		  				if legend = 'PRD' then 
                		  						result_value := (-1)* nvl(round(fvalue,0),0);
                		  					
                		  				end if;
                							if legend is null then 
                									myFormula := replace(myFormula, v2FooterSchemeDetail.FooterHeadCode, nvl(percent,0));
                							end if;
                							if legend = 'PAA' then 
                		  						result_value := nvl(fvalue,0);
                							end if;
                							
                							if legend = 'PAD' then 
                		  						result_value := (-1)* nvl(abs(fvalue),0);
                							end if;
                		  		END IF;
                		  	
                  			
                  		end if;
                 end if;
                 end;
                end if;
                apex_json.open_object;apex_json.write('value',result_value);declare incl varchar2(3);begin select includewithtaxableamount into incl from footerhead where footerheadcode=head;apex_json.write('included',incl,true);end;apex_json.close_object;end;
                ```
        }
        execution {
            sequence: 0
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 99015920260929053
        }
    )

