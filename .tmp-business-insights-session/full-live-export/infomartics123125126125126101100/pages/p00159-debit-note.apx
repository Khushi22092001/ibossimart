    dynamicAction delete-unsaved-record-from-detail-table (
        name: delete unsaved record from detail table
        execution {
            sequence: 660
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from debitnotedetail a
                        where not exists (
                            select 1 from debitnote  aa  
                            where aa.tno = a.tno
                        ) and a.tno = :P159_TNO; 
                    
                     delete from debitnotedetailfooter a
                        where not exists (
                            select 1 from debitnote  aa  
                            where aa.tno = a.tno
                        )and a.tno = :P159_TNO;  
                    
                    ```
                itemsToSubmit: P159_TNO
            }
            execution {
                sequence: 10
            }
        )

    )

