    region direct-supplier-customer-matrix (
        name: Direct Supplier &rarr; Customer Matrix
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select SupplierName Supplier,CustomerName Customer,Count(Distinct LoadingAdviceTNo) Deliveries,
                       Round(Sum(La_Qty),2) Quantity,Round(Sum(Allocated_Sales_Value)/1e7,2) Sales_Cr,
                       Round(Sum(Allocated_Purchase_Value)/1e7,2) Purchase_Cr,
                       Count(Distinct Case When Invoice_Count=0 Then LoadingAdviceTNo End) Invoice_Pending
                  From IMART_SLC_LOADING_ADVICE_V
                 Where Flow_Type='DIRECT DELIVERY' And Link_Quality='VALID'
                   And LoadingAdviceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                   And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)
                 Group By SupplierName,CustomerName Order By Sum(Allocated_Sales_Value) Desc Fetch First 50 Rows Only
                ```
            pageItemsToSubmit: [
                P721_FROMDATE
                P721_TODATE
                P721_COMPANY
                P721_LOCATION
            ]
        }
        layout {
            sequence: 50
            parentRegion: @unified-fulfilment-trading
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: direct-supplier-customer-matrix
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No direct supplier-to-customer movements in this scope.
        }
        componentAdvanced {
            stripHtml: true
        }
        download {
            csvExportEnabled: true
        }

