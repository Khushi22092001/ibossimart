    region direct-delivery-funnel (
        name: Direct Delivery Funnel
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With D As (
                 Select Count(Distinct SalesOrderTNo) So_Cnt,Count(Distinct PurchaseOrderTNo) Po_Cnt,Count(Distinct LoadingAdviceTNo) La_Cnt,
                        Count(Distinct Case When Grn_Count>0 Then LoadingAdviceTNo End) Grn_Cnt,
                        Count(Distinct Case When Invoice_Count>0 Then LoadingAdviceTNo End) Inv_Cnt
                   From IMART_SLC_LOADING_ADVICE_V
                  Where Flow_Type='DIRECT DELIVERY' And Link_Quality='VALID'
                    And LoadingAdviceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                    And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)),
                R As (Select 1 Ord,'Sales Orders' Label,So_Cnt Val From D Union All Select 2,'Purchase Orders',Po_Cnt From D Union All Select 3,'Loading Advice',La_Cnt From D Union All Select 4,'Purchase GRN',Grn_Cnt From D Union All Select 5,'CC Invoice',Inv_Cnt From D)
                Select '<div class="ds-fast-chart" data-chart-type="hbar" aria-label="Direct Delivery Funnel"><script type="application/json" class="ds-fast-chart-data">'||
                 replace(json_object('unit' value 'Documents','series' value json_array('Documents' returning clob) format json,
                 'rows' value json_arrayagg(json_object('l' value Label,'values' value json_array(Val returning clob) format json,
                 'u' value '#direct-delivery-register' returning clob) order by Ord returning clob) format json returning clob),'<','\\u003c')||'</script></div>' Chart_Row From R
                ```
            pageItemsToSubmit: [
                P721_FROMDATE
                P721_TODATE
                P721_COMPANY
                P721_LOCATION
            ]
        }
        layout {
            sequence: 30
            parentRegion: @unified-fulfilment-trading
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        advanced {
            htmlDomId: direct-delivery-funnel
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
