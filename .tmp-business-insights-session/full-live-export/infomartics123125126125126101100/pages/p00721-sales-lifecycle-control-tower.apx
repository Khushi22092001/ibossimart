                       Round(Ordered_Qty,3) Ordered_Qty,Round(Classified_Qty,3) Classified_Qty,
                       Round(Classified_Value/1e7,2) Value_Cr,Evidence_Strength,Evidence_Source,Evidence_Docs
                  From IMART_SLC_FULFILMENT_V
                 Where SalesOrderDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                   And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY)
