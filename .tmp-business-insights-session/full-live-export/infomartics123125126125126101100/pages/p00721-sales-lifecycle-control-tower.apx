    region loading-advice-destination (
        name: Loading Advice Destination &amp; Status
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With A As (Select Flow_Type,Current_Status,Count(Distinct LoadingAdviceTNo) Cnt,Sum(La_Qty) Qty
                 From IMART_SLC_LOADING_ADVICE_V Where LoadingAdviceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                 And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)
                 Group By Flow_Type,Current_Status),Q As (Select A.*,Row_Number() Over(Order By Cnt Desc) Ord From A)
                Select '<div class="ds-fast-chart" data-chart-type="hbar" aria-label="Loading Advice Destination"><script type="application/json" class="ds-fast-chart-data">'||
                 replace(json_object('unit' value 'Documents','series' value json_array('Loading Advice' returning clob) format json,
                 'rows' value json_arrayagg(json_object('l' value Flow_Type||' — '||Current_Status||' · '||to_char(Qty,'FM999G990D00')||' qty',
                 'values' value json_array(Cnt returning clob) format json,'u' value '#loading-advice-exceptions' returning clob) order by Ord returning clob) format json returning clob),'<','\\u003c')||'</script></div>' Chart_Row From Q
                ```
            pageItemsToSubmit: [
                P721_FROMDATE
                P721_TODATE
                P721_COMPANY
                P721_LOCATION
            ]
        }
        layout {
            sequence: 40
            parentRegion: @unified-fulfilment-trading
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        advanced {
            htmlDomId: loading-advice-destination
