                escapeSpecialChars: false
            }
        )

    )

    region direct-delivery-register (
        name: Direct Delivery &mdash; Loading Advice Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a href="'||apex_page.get_url(p_page=>155,p_clear_cache=>'155',p_items=>'P155_TNO',p_values=>LoadingAdviceTNo)||'">'||apex_escape.html(LoadingAdviceNo)||'</a>' LoadingAdviceNo,
                       LoadingAdviceDate,Flow_Type,Current_Status,Link_Quality,
                       '<a href="'||apex_page.get_url(p_page=>723,p_clear_cache=>'723',p_items=>'P723_TNO',p_values=>SalesOrderTNo)||'">'||apex_escape.html(SalesOrderNo)||'</a>' SalesOrderNo,
                       '<a href="'||apex_page.get_url(p_page=>118,p_clear_cache=>'118',p_items=>'P118_TNO',p_values=>PurchaseOrderTNo)||'">'||apex_escape.html(PurchaseOrderNo)||'</a>' PurchaseOrderNo,
                       SupplierName,CustomerName,ItemName,SpecificationName,Round(La_Qty,3) La_Qty,Round(Grn_Qty,3) Grn_Qty,Round(Invoiced_Qty,3) Invoiced_Qty,Round(Pending_Invoice_Qty,3) Pending_Qty,
                       Round(Allocated_Sales_Value/1e7,2) Sales_Cr,Round(Allocated_Purchase_Value/1e7,2) Purchase_Cr,
                       Case When GrnTNo Is Null Then '-' Else '<a href="'||apex_page.get_url(p_page=>146,p_clear_cache=>'146',p_items=>'P146_TNO',p_values=>GrnTNo)||'">'||apex_escape.html(GrnNo)||'</a>' End GrnNo,
                       Case When CCInvoiceTNo Is Null Then 'Pending' Else '<a href="'||apex_page.get_url(p_page=>175,p_clear_cache=>'175',p_items=>'P175_TNO,P175_FORMSTATUS',p_values=>CCInvoiceTNo||',EDITRECORD')||'">'||apex_escape.html(CCInvoiceNo)||'</a>' End CCInvoiceNo,
                       DestinationPlaceCode,SODeliveryAddress,VehicleNo,EWayBillNo,Age_Days
                  From IMART_SLC_LOADING_ADVICE_V
                 Where Flow_Type='DIRECT DELIVERY' And LoadingAdviceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                   And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)
                 Order By LoadingAdviceDate Desc,LoadingAdviceTNo Desc,ItemName
                ```
