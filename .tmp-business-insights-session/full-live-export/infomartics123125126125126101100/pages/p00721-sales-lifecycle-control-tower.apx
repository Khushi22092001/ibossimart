    region loading-advice-exceptions (
        name: Loading Advice &amp; Trading Exceptions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Severity,Exception_Type,
                       '<a href="'||apex_page.get_url(p_page=>155,p_clear_cache=>'155',p_items=>'P155_TNO',p_values=>LoadingAdviceTNo)||'">'||apex_escape.html(LoadingAdviceNo)||'</a>' LoadingAdviceNo,
                       LoadingAdviceDate,SalesOrderNo,PurchaseOrderNo,CustomerName,SupplierName,
                       Round(Affected_Qty,3) Affected_Qty,Round(Affected_Value/1e7,2) Value_Cr,Age_Days,Next_Action
                  From IMART_SLC_EXCEPTION_V
                 Where LoadingAdviceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                   And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)
                 Order By Decode(Severity,'CRITICAL',1,'HIGH',2,3),Age_Days Desc
                ```
