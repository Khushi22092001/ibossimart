    region margin-coverage-chart (
        name: Margin Coverage
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With I As (Select Sum(Case When Exists (Select 1 From CCInvoiceStockDetail cs Where cs.TNo=d.TNo And cs.SNo=d.SNo) Then Nvl(d.Amount,0) Else 0 End)/1e7 Covered_Cr,
                 Sum(Case When Not Exists (Select 1 From CCInvoiceStockDetail cs Where cs.TNo=d.TNo And cs.SNo=d.SNo) Then Nvl(d.Amount,0) Else 0 End)/1e7 Uncovered_Cr
                 From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                 Where ci.CCInvoiceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                 And (:P721_COMPANY Is Null Or ci.CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or ci.LocationCode=:P721_LOCATION)),
                R As (Select 1 Ord,'Covered — cost provenance available' Label,Nvl(Covered_Cr,0) Val From I Union All Select 2,'Uncovered — margin not claimed',Nvl(Uncovered_Cr,0) From I)
                Select '<div class="ds-fast-chart" data-chart-type="hbar" aria-label="Margin Coverage"><script type="application/json" class="ds-fast-chart-data">'||
                 replace(json_object('unit' value 'Invoice Rs Cr','series' value json_array('Invoice Value' returning clob) format json,
                 'rows' value json_arrayagg(json_object('l' value Label,'values' value json_array(round(Val,2) returning clob) format json,'u' value '#fulfilment-evidence-register' returning clob) order by Ord returning clob) format json returning clob),'<','\\u003c')||'</script></div>' Chart_Row From R
                ```
            pageItemsToSubmit: [
                P721_FROMDATE
                P721_TODATE
                P721_COMPANY
                P721_LOCATION
            ]
        }
        layout {
            sequence: 54
            parentRegion: @unified-fulfilment-trading
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        advanced {
            htmlDomId: margin-coverage-chart
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No invoices in this scope.
        }

        column CHART_ROW (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: " "
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region order-book-bottleneck (
        name: Order Book Bottleneck
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With A As (Select Fulfilment_Strategy Strategy,Sum(Case When Ordered_Qty=0 Then 0 Else Classified_Value*Open_Qty/Ordered_Qty End)/1e7 Open_Cr,Sum(Open_Qty) Open_Qty
                 From IMART_SLC_FULFILMENT_V Where SalesOrderDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                 And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)
                 Group By Fulfilment_Strategy),Q As (Select A.*,Row_Number() Over(Order By Open_Cr Desc) Ord From A Where Open_Cr>0)
                Select '<div class="ds-fast-chart" data-chart-type="hbar" aria-label="Order Book Bottleneck"><script type="application/json" class="ds-fast-chart-data">'||
                 replace(json_object('unit' value 'Open Rs Cr','series' value json_array('Open Exposure' returning clob) format json,
                 'rows' value json_arrayagg(json_object('l' value Strategy||' · '||to_char(Open_Qty,'FM999G990D00')||' open qty','values' value json_array(round(Open_Cr,2) returning clob) format json,
                 'u' value apex_page.get_url(p_page=>721,p_clear_cache=>'RIR',p_items=>'P721_FULFILMENT_FOCUS',p_values=>Strategy)||'#fulfilment-evidence-register' returning clob) order by Ord returning clob) format json returning clob),'<','\\u003c')||'</script></div>' Chart_Row From Q
                ```
            pageItemsToSubmit: [
                P721_FROMDATE
                P721_TODATE
                P721_COMPANY
                P721_LOCATION
            ]
        }
        layout {
            sequence: 52
            parentRegion: @unified-fulfilment-trading
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        advanced {
            htmlDomId: order-book-bottleneck
        }
