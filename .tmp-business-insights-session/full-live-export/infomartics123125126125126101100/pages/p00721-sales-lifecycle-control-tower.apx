            sqlQuery:
                ```sql
                Select Fulfilment_Strategy,Order_Strategy,
                       '<a href="'||apex_page.get_url(p_page=>723,p_clear_cache=>'723',p_items=>'P723_TNO',p_values=>SalesOrderTNo)||'">'||apex_escape.html(SalesOrderNo)||'</a>' SalesOrderNo,
