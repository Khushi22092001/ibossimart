    region trading-fulfilment-kpis (
        name: Trading &amp; Fulfilment KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With K As (
                  Select
                    (Select Count(Distinct LoadingAdviceTNo) From IMART_SLC_LOADING_ADVICE_V
                      Where Flow_Type='DIRECT DELIVERY' And LoadingAdviceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                        And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)
                        And Invoice_Count=0) DirectOpen,
                    (Select Nvl(Sum(Invoiced_Value),0) From IMART_SLC_LOADING_ADVICE_V
                      Where Flow_Type='DIRECT DELIVERY' And LoadingAdviceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                        And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)) DirectBilled,
                    (Select Nvl(Sum(Classified_Value),0) From IMART_SLC_FULFILMENT_V
                      Where Fulfilment_Strategy='PROCUREMENT-BACKED' And SalesOrderDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                        And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)) ProcExposure,
                    (Select Count(Distinct LoadingAdviceTNo) From IMART_SLC_LOADING_ADVICE_V
                      Where Flow_Type='WAREHOUSE PROCUREMENT' And Grn_Count=0 And LoadingAdviceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                        And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)) WhPending,
                    (Select Round(100*Sum(Case When Fulfilment_Strategy<>'UNCLASSIFIED' Then Classified_Value Else 0 End)/Nullif(Sum(Classified_Value),0),1)
                       From IMART_SLC_FULFILMENT_V Where SalesOrderDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                        And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)) ClassifiedPct,
                    (Select Nvl(Sum(Classified_Value),0) From IMART_SLC_FULFILMENT_V
                      Where Fulfilment_Strategy='UNCLASSIFIED' And SalesOrderDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                        And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)) UnclassifiedValue,
                    (Select Nvl(Sum(Pending_Invoice_Qty),0) From IMART_SLC_LOADING_ADVICE_V
                      Where Flow_Type='DIRECT DELIVERY' And LoadingAdviceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                        And (:P721_COMPANY Is Null Or CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or LocationCode=:P721_LOCATION)) DirectPendingQty,
                    (Select Round(100*Sum(Case When Exists (Select 1 From CCInvoiceStockDetail cs Where cs.TNo=d.TNo And cs.SNo=d.SNo) Then Nvl(d.Amount,0) Else 0 End)/Nullif(Sum(Nvl(d.Amount,0)),0),1)
                       From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                      Where ci.CCInvoiceDate Between to_date(:P721_FROMDATE,'DD-MM-RRRR') And to_date(:P721_TODATE,'DD-MM-RRRR')
                        And (:P721_COMPANY Is Null Or ci.CompanyCode=:P721_COMPANY) And (:P721_LOCATION Is Null Or ci.LocationCode=:P721_LOCATION)) MarginCoveragePct
                  From dual)
                Select Case x.Seq
                  When 1 Then '<a class="ds-kpi ds-kpi--risk" href="#direct-delivery-register"><span class="ds-kpi-ic"><span class="fa fa-truck"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Direct deliveries open</span><span class="ds-kpi-n">'||to_char(K.DirectOpen,'FM999G990')||'</span><span class="ds-kpi-sub">Loading Advice awaiting invoice</span></span></a>'
                  When 2 Then '<a class="ds-kpi ds-kpi--ok" href="#direct-delivery-register"><span class="ds-kpi-ic"><span class="fa fa-inr"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Direct delivery billed</span><span class="ds-kpi-n">&#8377; '||to_char(K.DirectBilled/1e7,'FM999G990D00')||' Cr</span><span class="ds-kpi-sub">Actual CC Invoice value</span></span></a>'
                  When 3 Then '<a class="ds-kpi ds-kpi--suppl" href="#fulfilment-evidence-register"><span class="ds-kpi-ic"><span class="fa fa-shopping-cart"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Purchase-backed exposure</span><span class="ds-kpi-n">&#8377; '||to_char(K.ProcExposure/1e7,'FM999G990D00')||' Cr</span><span class="ds-kpi-sub">SO value with proven PO link</span></span></a>'
                  When 4 Then '<a class="ds-kpi ds-kpi--bill" href="#loading-advice-exceptions"><span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Warehouse LA pending</span><span class="ds-kpi-n">'||to_char(K.WhPending,'FM999G990')||'</span><span class="ds-kpi-sub">No completed GRN</span></span></a>'
                  When 5 Then '<a class="ds-kpi ds-kpi--ok" href="#fulfilment-evidence-register"><span class="ds-kpi-ic"><span class="fa fa-check-circle"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Fulfilment classified</span><span class="ds-kpi-n">'||to_char(Nvl(K.ClassifiedPct,0),'FM990D0')||'%</span><span class="ds-kpi-sub">Value backed by transaction evidence</span></span></a>'
                  When 6 Then '<a class="ds-kpi ds-kpi--risk" href="#fulfilment-evidence-register"><span class="ds-kpi-ic"><span class="fa fa-question-circle"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Unclassified exposure</span><span class="ds-kpi-n">&#8377; '||to_char(K.UnclassifiedValue/1e7,'FM999G990D00')||' Cr</span><span class="ds-kpi-sub">Not guessed; requires evidence</span></span></a>'
                  When 7 Then '<a class="ds-kpi ds-kpi--risk" href="#direct-delivery-register"><span class="ds-kpi-ic"><span class="fa fa-clock-o"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Direct delivery pending invoice</span><span class="ds-kpi-n">'||to_char(K.DirectPendingQty,'FM999G990D00')||'</span><span class="ds-kpi-sub">Loading Advice quantity not billed</span></span></a>'
                  Else '<a class="ds-kpi ds-kpi--bill" href="#fulfilment-evidence-register"><span class="ds-kpi-ic"><span class="fa fa-pie-chart"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Proven margin coverage</span><span class="ds-kpi-n">'||to_char(Nvl(K.MarginCoveragePct,0),'FM990D0')||'%</span><span class="ds-kpi-sub">Invoice value with stock-cost provenance</span></span></a>'
                End Card From K,(Select Level Seq From dual Connect By Level<=8) x Order By x.Seq
                ```
            pageItemsToSubmit: [
                P721_FROMDATE
                P721_TODATE
                P721_COMPANY
                P721_LOCATION
            ]
        }
        layout {
            sequence: 10
            parentRegion: @unified-fulfilment-trading
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                ds-kpiwrap--4up
                slc-unified-kpis
            ]
        }
        advanced {
            htmlDomId: trading-fulfilment-kpis
        }
        reportLayout {
            numberOfRows: 10
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No trading or fulfilment data in this scope.
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
            exportPrinting {
                includeInExportPrint: false
            }
            security {
                escapeSpecialChars: false
            }
        )

