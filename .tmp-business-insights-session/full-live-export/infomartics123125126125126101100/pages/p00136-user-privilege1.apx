    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region passfailbuttons (
        name: PassFailButtons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region user-privilege (
        name: User Privilege
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select BOSSUSERCODE,
                       MODULECODE,
                       VIEWPRIVILEGE,
                       INSERTPRIVILEGE,
                       UPDATEPRIVILEGE,
                       DELETEPRIVILEGE,
                       STATUSPRIVILEGE,
                       REMARK,
                       UPDATEDAYS,
                       TNO,
                       COMPANYCODE,
                       CREATOR,
                       PRINTPRIVILEGE,
                       CREATIONTIME,
                       OTHERPRIVILEGE,
                       VOUCHERPOSTINGDATE,
                       ALLOWEDBACKDAYS,
                       ALLOWEDFORWARDDAYS,
                       CONTROLPRIVILEGE,
                       NVL(getdocumentstatuscode('MODULEPRIVILEGE',TNO),'STATUS') AS Status
                  from MODULEPRIVILEGE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P136_ALLOWEDBACKDAYS (
