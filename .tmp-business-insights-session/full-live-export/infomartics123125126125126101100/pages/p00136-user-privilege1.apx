                plsqlCode:
                    ```plsql
                    begin
                          FOR vModulePrivilege IN ( select
                      					a.BossUserCode,
                      					a.TNo,
                      					a.ViewPrivilege,
                      					a.InsertPrivilege,
                      					a.UpdatePrivilege,
