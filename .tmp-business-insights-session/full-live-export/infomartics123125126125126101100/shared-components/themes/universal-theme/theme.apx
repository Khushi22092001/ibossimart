theme universal-theme (
    name: Universal Theme
    themeNumber: 42
    baseTheme: ut-24.2
    style {
        currentThemeStyle: @vita-copy
    }
    javaScript {
        fileUrls: [
            #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.stickyWidget#MIN#.js?v=#APEX_VERSION#
            #THEME_FILES#js/theme42#MIN#.js?v=#APEX_VERSION#
        ]
    }
    css {
        fileUrls: #THEME_FILES#css/Core#MIN#.css?v=#APEX_VERSION#
    }
    componentDefaults {
        page: @/standard
        navigationBarList: @/navigation-bar
        navigationMenuListPosition: side
        navigationMenuListTop: @/top-navigation-menu
        navigationMenuListSide: @/side-navigation-menu
        loginPage: @/login
        errorPage: @/login
        printerFriendlyPage: @/standard
        breadcrumb: @/breadcrumb
        button: @/text
        defaultLabel: @/optional
        optionalLabel: @/optional
        requiredLabel: @/required
        list: @/links-list
        region: @/standard
        classicReport: @/standard
    }
    regionDefaults {
        breadcrumbs: @/title-bar
        charts: @/standard
        forms: @/standard
        lists: @/standard
        reports: @/standard
        wizards: @/standard
        interactiveReports: @myirr
    }
    dialogDefaults {
        dialogContentRegion: @/blank-with-attributes
        dialogButtonRegion: @/buttons-container
        dialogPage: @/modal-dialog
    }
    icons {
        library: fontApex
    }
    advanced {
        filePrefix: #APEX_FILES#themes/theme_42/24.2/
        identifier: UNIVERSAL_THEME
    }

    style vita-copy (
        name: Vita (copy_2)
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita.less
            outputCssFileUrl: #THEME_DB_FILES#29961636554202223.css
            jsonConfig: "{\"classes\":[],\"vars\":{},\"customCSS\":\"#P0_SEARCH{\\n    width: 25px;\\n    height: 25px;\\n    border-width: 0px;\\n    border-radius: 3px !important;\\n    background-color: transparent;\\n    color: #fff;\\n    outline-width: 0;\\n    margin-top: -6px;\\n    margin-bottom: -4px;\\n    margin-left: 5px;\\n}\\n.t-Header-navBar{\\n    margin-bottom: -5px;\\n}\\n.t-NavifationBar{\\n    margin-bottom: 5px;\\n}\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
            accessibilityTested: true
        }
    )

    style vita-copy-2 (
        name: Vita (copy_1)
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita.less
            outputCssFileUrl: #THEME_DB_FILES#133734817494866304.css
            jsonConfig: "{\"classes\":[],\"vars\":{\"@g_Accent-BG\":\"#1b2c5f\",\"@g_Nav-BG\":\"#0e0e53\",\"@g_Nav-FG\":\"#d6d6d6\",\"@g_Nav-Active-BG\":\"#0b1678\",\"@g_Nav-Active-FG\":\"#f2f2f2\"},\"customCSS\":\"\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            accessibilityTested: true
        }
    )

    style vita-orange (
        name: Vita - Orange
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita-Slate.less
            outputCssFileUrl: #THEME_DB_FILES#136079558373978777.css
            jsonConfig: "{\"classes\":[],\"vars\":{\"@g_Nav-Active-BG\":\"#aab3ba\",\"@g_Nav-Active-FG\":\"#ffffff\",\"@g_Nav-BG\":\"#505f6d\",\"@g_Nav-FG\":\"#f8f8f8\",\"@g_Accent-BG\":\"#f9bd5d\"},\"customCSS\":\"\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
        }
    )

    style vita-slate-copy (
        name: Vita - Slate (copy_1)
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita-Slate.less
            outputCssFileUrl: #THEME_DB_FILES#73265837802159159.css
            jsonConfig: "{\"classes\":[],\"vars\":{\"@g_Nav-Active-BG\":\"#aab3ba\",\"@g_Nav-Active-FG\":\"#ffffff\",\"@g_Nav-BG\":\"#c8ece2\",\"@g_Nav-FG\":\"#f8f8f8\",\"@g_Accent-BG\":\"#9fe9cf\"},\"customCSS\":\"#APP_FILES#mycss/MyIR (2)#MIN#.cs\\n\\n\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
        }
    )

    style vita-slate-original (
        name: Vita - Slate-original
        themeRollerAttributes {
            readOnly: true
            inputParameterFileUrls: #THEME_FILES#less/theme/Vita-Slate.less
            outputCssFileUrl: #THEME_FILES#css/Vita-Slate#MIN#.css?v=#APEX_VERSION#
        }
        subscription {
            master: @/8842/universal-theme/vita-slate
        }
    )

)

