plugin pretiusApexContextMenu (
    name: Pretius APEX Context Menu
    staticId: COM.PRETIUS.APEX.CONTEXTMENU
    type: dynamicAction
    component {
        standardAttributes: [
            forItem
            forButton
            forRegion
            forJquerySelector
            forJavaScriptExpression
            forTriggeringElement
            forEventSource
        ]
    }
    callbacks {
        apiInterface: function
        renderProcedureName: #OWNER#.PRETIUS_APEX_CONTEXT_MENU.render
    }
    advanced {
        category: navigation
        substituteAttributeValues: true
    }
    css {
        fileUrls: #PLUGIN_FILES#pretius.apexListMenu.css
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#pretius.apexListMenu.js
            #PLUGIN_FILES#pretius.handleDa.js
        ]
    }
    information {
        version: 1.1.0
        aboutUrl: https://github.com/bostrowski/Pretius-APEX-Context-Menu
        helpText:
            ```
            <strong>About plugin</strong>
            <p>
              Pretius APEX Context Menu is dynamic action plugin implementing context menu based on defined APEX list.
            </p>
            <p>
              Github: <code>https://github.com/bostrowski/Pretius-APEX-Context-Menu</code>
            </p>
            <strong>About author</strong>
            </p>
            <p>
              Author: <code>Bartosz Ostrowski</code><br/>
              E-mail: <code>ostrowski.bartosz@gmail.com</code><br/>
              Twitter: <code>@bostrowsk1</code><br/>
              Website: http://www.ostrowskibartosz.pl
            </p>
            <strong>About Pretius</strong>
            <p>
              Website: http://pretius.com
            </p>
            ```
    }
)

