plugin unitedCodesDateRangePicker (
    name: United Codes Date Range Picker
    staticId: UC_DATE_RANGE_PICKER
    type: item
    component {
        supports: pageItems
        standardAttributes: [
            visibleWidget
            standardFormElement
            sessionStateChangeable
            readOnlyAttr
            sourceAttrs
            formatMaskDateOnly
            elementAttrs
            widthAttrs
            placeholderAttr
        ]
    }
    callbacks {
        apiInterface: procedureWithLegacyAttributes
        renderProcedureName: #OWNER#.UC_DATE_RANGE_PICKER.render_daterange
    }
    advanced {
        substituteAttributeValues: true
    }
    css {
        fileUrls: #PLUGIN_FILES#uc.daterangepicker.css
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#moment.min.js
            #PLUGIN_FILES#daterangepicker.js
            #PLUGIN_FILES#uc.daterangepicker.js
        ]
    }
    information {
        version: 20.1
        aboutUrl: https://www.plug-ins-pro.com/
    }
)

