customAttribute attribute_01 (
    apexlangName: treeRegionStaticId
    attribute: 1
    name: Tree Region Static ID
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    help {
        helpText:
            ```
            Static ID of tree region that is filtered by item value.
            It should be the same as Static ID property of tree region.
            ```
    }
    examples {
        examples: rgnTree
    }
)

customAttribute attribute_02 (
    apexlangName: saveSearchOnRefresh
    attribute: 2
    name: Save Search on Refresh
    type: yesNo
    appearance {
        sequence: 20
    }
    help {
        helpText: Defines if value of search item is saved to session state - meaning that is available after page refresh.
    }
)

customAttribute attribute_03 (
    apexlangName: keydownSearchDelay
    attribute: 3
    name: Keydown Search Delay
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 30
    }
    default {
        value: 200
    }
    help {
        helpText: Delay in ms after each key press before the start of search action.
    }
)

