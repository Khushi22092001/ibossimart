list ironmart (
    name: IronMart
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select Level,
                   aa.MYBOXLABEL,
                   'f?p=&APP_ID.:' || TO_CHAR(aA.PAGENO) || ':&SESSION.:::'|| TO_CHAR(aA.PAGENO) ||'::' target,
                   aa.MYBOXKEY,
                    aa.iconname                             AS icon
              From (Select *
                      From myboxtree_apexmenu a
                     Where A.BossUserCode = :GLOBAL_BOSSUSERCODE
                       And A.COMPANYCODE  = :GLOBAL_COMPANYCODE
                     Union All
                    Select 4 serialno,
                           'BU:'||a.BossUserCode||'.C:'||a.CompanyCode||'.M:BUSINESSINSIGHTS' myboxkey,
                           'Business Insights' myboxlabel,
                           a.myboxkey parentkey,
                           'MODULE' myboxtype,
                           'BUSINESSINSIGHTS' modulecode,
                           'fa-chart-bar' iconname,
                           0 tno,
                           '901' pageno,
                           a.BossUserCode,
                           a.LoginName,
                           a.CompanyCode,
                           a.C2,
                           a.AppUser,
                           'YES' viewprivilege
                      From myboxtree_apexmenu a
                     Where a.BossUserCode = :GLOBAL_BOSSUSERCODE
                       And a.CompanyCode  = :GLOBAL_COMPANYCODE
                       And a.MyBoxType = 'MODULEGROUP'
                       And a.ModuleCode = 'MG:134'
                       ) AA
             Start With aA.ParentKey = 'ROOT'
            Connect By Prior aA.MyBoxKey = aA.ParentKey
            Order Siblings By aA.SerialNo
            /*
             UNION ALL
             Select 1,
                   'On The Table',--aa.MYBOXLABEL,
                   'f?p=&APP_ID.:' || '126' || ':&SESSION.:::'|| '126' ||'::' target,
                   null,
                   'YES' As is_current,
                  null image
              From DUAL
            */
             -- Order Siblings By aA.MyBoxLabel
            
            ```
    }
)

list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry install-app (
        label: Install App
        icon {
            imageIconCssClasses: fa-cloud-download
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                type: url
                url: #action$a-pwa-install
            }
        }
        userDefinedAttributes {
            2: a-pwaInstall
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry list_item-2 (
        label: " "
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 1
                clearCache: 1
                action: resetPagination
                request: 1
            }
        }
    )

    entry list_item-3 (
        label: " "
        icon {
            imageIconCssClasses: fa-search
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 9996
                clearCache: 9996
                request: 9996
            }
        }
        serverSideCondition {
            type: never
        }
    )

    entry list_item-4 (
        label: " "
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 6
                clearCache: 6
                action: resetPagination
            }
        }
    )

    entry nbsp (
        label: &nbsp;
        icon {
            imageIconCssClasses: fa-search
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: javascript:apex.theme.openRegion('global_search');
            }
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 40
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

