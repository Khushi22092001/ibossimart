searchConfig imart_module_search (
    name: Imart_Module_search
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT 
                 M.MODULECODE,
                 M.MODULENAME as TITLE,
                 'f?p=&APP_ID.:' || TO_CHAR(M.PAGENO) || ':&SESSION.:::::' TARGET,
                 M.PAGENO,
                 'Module --> '||MG.MODULEGROUPNAME as BADGE_VALUE,
                 'YES' As IS_CURRENT,
                 'u-color-' || MOD(rownum, 20 + 1) as MY_COLOR_CLASS,
                 MG.MODULEGROUPNAME
            FROM MODULE M 
            LEFT JOIN MODULEGROUP MG ON M.MODULEGROUPCODE = MG.MODULEGROUPCODE
            WHERE EXISTS (
              SELECT 1
                FROM MODULEPRIVILEGE mp
               WHERE mp.MODULECODE       = m.MODULECODE
                 AND mp.BOSSUSERCODE     = :GLOBAL_BOSSUSERCODE
                 AND mp.COMPANYCODE      = :GLOBAL_COMPANYCODE
                 AND mp.VIEWPRIVILEGE    = 'YES'
            )
            ```
        searchableColumns: [
            TITLE
            MODULECODE
        ]
    }
    columnMapping {
        primaryKey1Column: MODULECODE
        titleColumn: TITLE
        badgeColumn: BADGE_VALUE
    }
    link {
        type: redirectThisApp
        target: {
            page: &PAGENO.
        }
    }
    appearance {
        cssClasses: &MY_COLOR_CLASS.
    }
)

searchConfig transaction_search (
    name: Transaction Search
    searchQueryPrefix: TNO
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT
                 x.TNO,
                 x.TRANSACTION_NO,
                 x.TRANSACTION_DATE,
                 x.BADGE_VALUE,
                 GetDocumentStatusCode(x.BADGE_VALUE,x.TNO) AS STATUS,
                 M.ENTRYPAGENO AS ENTRYPAGENO,
                 'P'||M.ENTRYPAGENO||'_TNO' AS TARGETPAGEITEM,
                 'u-color-' || MOD(rownum, 20 + 1) as MY_COLOR_CLASS    
            FROM ERP_GLOBAL_SEARCH_VW x 
            JOIN MODULE M ON X.BADGE_VALUE = M.MODULECODE
            WHERE x.FINANCIALYEARCODE   = :GLOBAL_FINANCIALYEARCODE
              AND x.COMPANYCODE         = :GLOBAL_COMPANYCODE
              AND EXISTS (
                SELECT 1
                  FROM MODULEPRIVILEGE mp
                 WHERE mp.MODULECODE     = m.MODULECODE
                   AND mp.BOSSUSERCODE   = :GLOBAL_BOSSUSERCODE
                   AND mp.COMPANYCODE    = :GLOBAL_COMPANYCODE
                   AND mp.VIEWPRIVILEGE  = 'YES'
              )
            ```
        searchableColumns: TRANSACTION_NO
    }
    columnMapping {
        primaryKey1Column: TNO
        titleColumn: TRANSACTION_NO
        subtitleColumn: TRANSACTION_DATE
        badgeColumn: BADGE_VALUE
        customColumn1: STATUS
    }
    link {
        type: redirectThisApp
        target: {
            page: &ENTRYPAGENO.
            items: {
                "&TARGETPAGEITEM.": &TNO.
            }
        }
    }
    appearance {
        cssClasses: &MY_COLOR_CLASS.
    }
)

