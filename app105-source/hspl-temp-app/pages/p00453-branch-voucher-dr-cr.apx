    region branch-voucher-dr-cr-data (
        name: Branch Voucher DR CR Data
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     row_number() over(order by a.DRVoucherDate) SerialNo,
                     c.LocationName as DRLocationName,
                     f.ModuleNo as DRModuleNo,
                     a.DRVoucherNo,
                     a.DRVoucherDate,
                     a.DRAmount,
                     d.PartyName as DRAccountName, 
                     b.LocationName as CRLocationName,
                     g.ModuleNo as CRModuleNo,
                     a.CRVoucherNo,
                     a.CRVoucherDate,
                     a.CRAmount,
                     e.PartyName as CRAccountName,
                     h.CompanyName,
                     i.ModuleName as DrModule,
                     j.ModuleName as CrModule,
                     a.Matched
                From BranchVoucherWithoutDiffTab a, Location b, Location c, Party d, Party e, ModuleNoAndDate f, ModuleNoAndDate g,
                Company h, Module i, Module j
                Where a.CRLocationCode = b.LocationCode(+)
                  and a.DRLocationCode = c.LocationCode(+)
                  and a.DRAccountCode = d.PartyCode(+)
                  and a.CRAccountCode = e.PartyCode(+)
                  and a.DRModuleTno = f.Tno(+)
                  and a.CRModuleTno = g.Tno(+) 
                  and a.CompanyCode = h.CompanyCode(+)
                  and a.DrModuleCode = i.ModuleCode(+)
                  and a.CrModuleCode = j.ModuleCode(+)
                  
                ```
            pageItemsToSubmit: [
                P453_COMPANY
                P453_FROMDATE
                P453_TODATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
