                e.ItemSpecificationName as d,
                e.ItemSpecificationCode as r
                From InterunitTransferDetail a, ItemSpecification e
                Where a.ItemSpecificationCode = e.ItemSpecificationCode
                  and a.ItemCode = :P312_ITEM
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P312_ITEM
            itemsToSubmit: P312_ITEMSPECIFICATION
        }
