page 312 (
    name: InterUnitTransfer
    alias: INTERUNITTRANSFER
    title: InterUnitTransfer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Rownum as SerialNo,
                l.LocationName,
                dl.LocationName as ToLocation,
                a.InterUnitTransferNo,
                a.InterUnitTransferDate,
                p.PartyName,
                i.EmployeeName,
                '('||e.ItemCode||')'||e.ItemName ||' ~ '||ee.ItemSpecificationName as ItemDetail,
                mu.MeasuringUnitName as PUOM,
                mu2.MeasuringUnitName as SUOM,
                b.Quantity1 as PQty,
                b.Quantity2 as SQty,
                b.CCInvoiceQuantity1,
                b.CCInvoiceQuantity2,
                nvl(b.Quantity1,0)-nvl(b.CCInvoiceQuantity1,0) as BalancePQty,
                nvl(b.Quantity2,0)-nvl(b.CCInvoiceQuantity2,0) as BalanceSQty
                From InterUnitTransfer a,InterUnitTransferDetail b, Location l, Location dl, Employee i, Party p, Item e, ItemSpecification ee, MeasuringUnit mu, MeasuringUnit mu2
                Where 1=1
                  and a.TNo = b.TNo
                  and a.LocationCode = l.LocationCode
                  and a.ToLocationCode = dl.LocationCode
                  and a.EmployeeCode = i.EmployeeCode(+)
                  and a.PartyCode = p.PartyCode(+)
                  and b.ItemCode = e.ItemCode
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode
                  and e.MeasuringUnitCode1 = mu.MeasuringUnitCode
                  and e.MeasuringUnitCode2 = mu2.MeasuringUnitCode(+)
                  and a.InterUnitTransferDate between :P312_FROMDATE and :P312_TODATE
                  and instr(':'||:P312_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P312_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P312_ITEM IS NULL OR instr(':'||:P312_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P312_ITEMSPECIFICATION IS NULL OR instr(':'||:P312_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 39704284869348106
        }

