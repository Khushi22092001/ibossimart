page 184 (
    name: DIP Vs Book Stock
    alias: DIP-VS-BOOK-STOCK
    title: DIP Vs Book Stock
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region dip-vs-book-stock (
        name: DIP Vs Book Stock
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region dip-vs-book-stock-2 (
        name: DIP Vs Book Stock
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.storagelocationname,
                       getItemName(b.itemcode) Item,
                       b.dipmethod,
                       b.temperature,
                       b.diptype,
                       b.dipincm,
                       Round(b.quantityinmt, 3) As ClosingAsPerDIP,
                       getslitemopeningquantity1(b.storagelocationcode,
                                                 b.ITEMCODE,
                                                 Null,
                                                 '1',
                                                 a.DIPReadingDate + 1) As closingAsPerBook
                  From dipreading        a,
                       dipreadingdetail  b,
                       storagelocation   c,
                       item              d,
                       itemspecification e
                 Where a.tno = b.tno
                   And b.storagelocationcode = c.storagelocationcode(+)
                   And b.itemcode = d.itemcode(+)
                   And b.itemspecificationcode = e.itemspecificationcode(+)
                   And a.DIPReadingDate = NVL(:P184_FROMDATE ,SYSDATE)
                
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            flashback: false
            help: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 74550290753098351
        }

