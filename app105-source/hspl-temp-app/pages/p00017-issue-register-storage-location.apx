        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      a.ItemName||' ( '||a.ItemCode||' )' as  d,
                      a.ItemCode r
                From  Item a
                Where a.ItemType= 'GROUP'
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @issue-register-storage-location
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 75
            valuePlaceholder: Material Group
        }
    )

    pageItem P17_ISSUENO (
        type: textFieldWithAutocomplete
        label {
            label: IssueNo
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select IssueNo 
                From Issue 
                Where instr(':'||:P17_LOCATION||':',':'||LocationCode||':') > 0
                  and IssueDate Between :P17_FROMDATE and :P17_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P17_LOCATION
            itemsToSubmit: P17_ISSUENO
        }
        layout {
