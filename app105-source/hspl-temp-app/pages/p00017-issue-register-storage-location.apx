    region issue-register-storage-location-2 (
        name: Issue Register Storage Location
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                   a.LocationName as Location,
                   a.DoctypeName as Doctype,
                   a.IssueNo,
                   a.IssueDate,
                   a.RequisitionNo,
                   a.PartyName,
                   a.IssueToEmployee as IssuedTo,
                   a.StorageLocationName as StorageLocationName,
                   a.SerialNo,
                   a.ItemName as MaterialDescription,
                   a.Quantity1 as Qty,
                   ROUND(a.Rate,2) as Rate,
                   ROUND(a.Amount,2) as Amount,
                   a.DepartmentName,
                   a.IssueReturnNo,
                   a.IssueReturnDate,
                   ROUND(a.IssueReturnAmount,2) as IssueReturnAmt,
                   a.IssueReturnQuantity1 as IssueReturnQty,
                   Round(a.NetAmount,2) as NetItemAmount,
                --   a.HourMeterReading,
                --   a.KmMeterReading,
                   a.UserRaisedBy,
                   a.GRNNo,
                   a.CreationTime as TimeStamp,
                   a.ItemCategoryName,
                   a.VoucherNo,
                   a.VoucherDate,
                   a.DocumentStatusCode,
                   a.ConsumptionParty,
                   a.StockPartyName
                From IssueRegisterStorageLocation a
                WHERE A.ISSUEDATE BETWEEN :P17_FROMDATE AND :P17_TODATE
                  AND INSTR(':'||:P17_COMPANY||':',':'||A.COMPANYCODE||':') > 0
                  AND ( :P17_LOCATION IS NULL OR INSTR(':'||:P17_LOCATION||':',':'||A.LOCATIONCODE||':') > 0 ) 
                  AND INSTR(':'||:P17_DOCTYPE||':',':'||A.DOCTYPECODE||':') > 0
                  AND ( :P17_ITEM IS NULL OR INSTR(':'||:P17_ITEM||':',':'||a.ITEMCODE||':') > 0 ) 
                 AND ( :P17_ITEMSPECIFICATION IS NULL OR INSTR(':'||:P17_ITEMSPECIFICATION||':',':'||a.ITEMSPECIFICATIONCODE||':') > 0 ) 
                 AND ( :P17_DEPARTMENT IS NULL OR INSTR(':'||:P17_DEPARTMENT||':',':'||a.DEPARTMENTCODE||':') > 0 ) 
                 AND ( :P17_STORAGELOCATION IS NULL OR INSTR(':'||:P17_STORAGELOCATION||':',':'||a.STORAGELOCATIONCODE||':') > 0 ) 
                  AND ( :P17_ITEMCATEGORY IS NULL OR INSTR(':'||:P17_ITEMCATEGORY||':',':'||a.ITEMCATEGORYCODE||':') > 0 )  
                 AND  A.ISSUENO LIKE NVL(:P17_ISSUENO,'%')
                --  AND ( :P17_EQUIPMENT IS NULL OR INSTR(':'||:P17_EQUIPMENT||':',':'||EG.EQUIPMENTGROUPCODE||':') > 0 )
                --  AND ( :P17_GROUP IS NULL
                --      OR
                --      EXISTS (SELECT 1 FROM (SELECT ITEMCODE,
                --               PARENTCODE,
                --               RPAD('.', (LEVEL - 1) * 2, '.') || ITEMCODE AS TREE,
                --               LEVEL,
                --               CONNECT_BY_ROOT ITEMCODE AS ROOT_ID,
                --               '-' || LTRIM(SYS_CONNECT_BY_PATH(ITEMCODE, '-'), '-') || '-' AS PATH,
                --               CONNECT_BY_ISLEAF AS LEAF
                --          FROM ITEM A
                --         START WITH PARENTCODE IN ( SELECT ITEMCODE FROM ITEM XX WHERE
                --                                    INSTR(':'||:P17_GROUP||':',':'||XX.ITEMCODE||':') > 0)
                --                                    
                --        CONNECT BY PARENTCODE = PRIOR ITEMCODE
                --         ORDER SIBLINGS BY ITEMCODE) X WHERE X.ITEMCODE = E.ITEMCODE
                --        )
                --    );
                ;
                ```
            pageItemsToSubmit: P17_COMPANY
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
