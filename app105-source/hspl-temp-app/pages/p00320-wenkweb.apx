                and (:P249_COMPANY is Null Or Instr (':' || :P249_COMPANY || ':' , ':' || c.CompanyCode|| ':') > 0)
                and a.PlacementDate Between :P249_FromDate and :P249_ToDate
                and (:P249_LOCATION is Null Or Instr (':' || :P249_LOCATION || ':' , ':' || b.LocationCode|| ':') > 0)
                and (:P249_TRANSPORTER is Null Or Instr (':' || :P249_TRANSPORTER || ':' , ':' || d.TransporterCode|| ':') > 0)
                and (:P249_VEHICLE is Null Or Instr (':' || :P249_VEHICLE || ':' , ':' || a.VehicleNo || ':') > 0)
                and (:P249_PARTYDO is Null Or Instr (':' || :P249_PARTYDO || ':' , ':' || g.PartyRefNo|| ':') > 0)
                and (:P249_SO is Null Or Instr (':' || :P249_SO || ':' , ':' || sl.Tno|| ':') > 0)
                and (:P249_DESTINATION is Null Or Instr (':' || :P249_DESTINATION || ':' , ':' || dl.Tno|| ':') > 0)
                and (:P249_VEHICLEGROUP is Null Or Instr (':' || :P249_VEHICLEGROUP || ':' , ':' || vg.VehicleGroupCode|| ':') > 0)
                and (:P249_CREATOR is Null Or Instr (':' || :P249_CREATOR || ':' , ':' || a.creator|| ':') > 0)
                and (:P249_WITHLR is Null Or Instr (':' || :P249_WITHLR || ':' , ':' ||'YES'|| ':') > 0)
                
                UNION ALL
                
                Select
                c.CompanyName,
                'NO' as LRStatus,
                b.LocationName,
                a.PlacementNo,
                a.PlacementDate,
                null as LRNo,
                null as LRDate,
                a.VehicleNo,
                vt.VehicleTypeName,
                a.DriverName,
                a.DriverLicenceNo,
                a.DriverMobileNo,
                d.TransporterName,
                h.TransporterName as OwnerName,
                e.PartyName,
                a.MeterReading,
                sl.SourceLocationName,
                dl.DestinationLocationName,
                f.ItemName,
                g.LoadingOrderNo,
                g.WorkOrderNo,
                g.PartyRefNo,
                vg.vehicleGroupName,
                a.Creator
                From Placement a, Location b, Company c, Transporter d, Party e, SourceLocation sl,
                DestinationLocation dl,Item f, LoadingOrder g, CompanyVehicle cv, Transporter h, VehicleType vt, VehicleGroup vg
                Where not exists(
                Select
                aa.Tno
                From LR aa
                Where aa.PlacementTno = a.Tno
                )
                and a.LocationCode = b.LocationCode(+)
                and a.CompanyCode = c.CompanyCode(+)
                and a.TransporterCode = d.TransporterCode(+)
                and a.PartyCode = e.PartyCode(+)
                and a.SourceLocationTno = sl.Tno(+)
                and a.DestinationLocationTno = dl.Tno(+)
                and a.ItemCode = f.ItemCode(+)
                and a.LoadingOrderTno = g.Tno(+)
                and a.VehicleNo = cv.VehicleNo(+)
                and cv.OwnerCode = h.TransporterCode(+)
                and cv.VehicleTypeCode = vt.VehicleTypeCode(+)
                and a.vehiclegroupcode = vg.vehiclegroupcode(+)
                and (:P249_COMPANY is Null Or Instr (':' || :P249_COMPANY || ':' , ':' || c.CompanyCode|| ':') > 0)
                and a.PlacementDate Between :P249_FromDate and :P249_ToDate
                and (:P249_LOCATION is Null Or Instr (':' || :P249_LOCATION || ':' , ':' || b.LocationCode|| ':') > 0)
                and (:P249_TRANSPORTER is Null Or Instr (':' || :P249_TRANSPORTER || ':' , ':' || d.TransporterCode|| ':') > 0)
                and (:P249_VEHICLE is Null Or Instr (':' || :P249_VEHICLE || ':' , ':' || a.VehicleNo || ':') > 0)
                and (:P249_PARTYDO is Null Or Instr (':' || :P249_PARTYDO || ':' , ':' || g.PartyRefNo|| ':') > 0)
                and (:P249_SO is Null Or Instr (':' || :P249_SO || ':' , ':' || sl.Tno|| ':') > 0)
                and (:P249_DESTINATION is Null Or Instr (':' || :P249_DESTINATION || ':' , ':' || dl.Tno|| ':') > 0)
                and (:P249_VEHICLEGROUP is Null Or Instr (':' || :P249_VEHICLEGROUP || ':' , ':' || vg.VehicleGroupCode|| ':') > 0)
                and (:P249_CREATOR is Null Or Instr (':' || :P249_CREATOR || ':' , ':' || a.creator|| ':') > 0)
                and (:P249_WITHLR is Null Or Instr (':' || :P249_WITHLR || ':' , ':' ||'NO'|| ':') > 0)
                order by 1 asc */
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
