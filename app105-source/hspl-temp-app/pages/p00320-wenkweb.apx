    pageItem P320_FROMDATE (
        type: datePicker
        label {
            label: from date
            alignment: left
        }
        layout {
            sequence: 30
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P320_SO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: source
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                b.sourcelocationname d,
                b.SourcelocationCode r
                from Placement a, SourceLocation b
                where a.SourcelocationTno = b.Tno
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P320_TODATE (
        type: datePicker
        label {
            label: to date
            alignment: left
        }
        layout {
            sequence: 40
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button new (
        buttonName: New
        label: New
        layout {
            sequence: 50
            region: @new
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

