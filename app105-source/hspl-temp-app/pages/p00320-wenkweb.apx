page 320 (
    name: wenkweb
    alias: WENKWEB
    title: wenkweb
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new-2 (
        name: New
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                x.DayDate as VehiclePlacementDate,
                x.VehicleNo,
                y.PlacementNo,
                y.PlacementDate,
                y.LRNo,
                y.LRDate,
                z.EmptyVehiclePlacementNo,
                z.EmptyLRNo,
                z.EmptyLRDate,
                y.LRStatus,
                y.LocationName,
                y.CompanyName,
                y.TransporterName,
                y.PartyName,
                y.sourceLocationName,
                y.DestinationLocationName,
                y.ItemName,
                y.LoadingOrderNo,
                y.PartyRefNo,
                y.WorkOrderNo,
                y.VehicleGroupName,
                y.DriverName,
                y.DriverLicenceNo,
                y.DriverMobileNo,
                y.MeterReading,
                y.Creator,
                y.VehicleTypeName,
                y.OwnerName,
                y.CompanyCode,
                y.TransporterCode,
                y.LocationCode,
                y.SourceLocationCode,
                y.DestinationLocationCode,
                y.VehicleGroupCode
                From
                (
                Select
                a.CompanyVehicleNo as VehicleNo,
                b.DayDate
                From CompanyVehicle a, DateList b
                Where GetVehicleGroupCode(a.CompanyVehicleNo, b.DayDate) = 'SELF'
                and b.DayDate >= '01-apr-2023'
                ) x,
                (
                Select
                a.PlacementDate,
                a.PlacementNo,
                a.VehicleNo,
                b.LRNo,
                b.LRDate,
                'YES' as LRStatus,
                c.locationname,
                d.CompanyName,
                e.TransporterName,
                f.PartyName,
                g.SourcelocationName,
                h.DestinationLocationName,
                i.ItemName,
                j.LoadingOrderNo,
                j.PartyRefNo,
                j.WorkOrderNo,
                k.VehicleGroupName,
                a.DriverName,
                a.DriverLicenceNo,
                a.DriverMobileNo,
                a.MeterReading,
                a.Creator,
                vt.VehicleTypeName,
                ts.TransporterName as OwnerName,
                d.CompanyCode,
                e.TransporterCode,
                c.LocationCode,
                g.SourceLocationCode,
                h.DestinationLocationCode,
                k.VehicleGroupCode
                From Placement a, LR b,Location c,Company d, Transporter e, Party f, SourceLocation g, DestinationLocation h,
                Item i, LoadingOrder j, VehicleGroup k, CompanyVehicle cv, VehicleType vt, Transporter ts
                Where exists(
                Select
                aa.Tno
                From LR aa
                Where aa.PlacementTno = a.Tno
                )
                and a.Tno = b.PlacementTno(+)
                and a.LocationCode = c.LocationCode(+)
                and a.CompanyCode = d.CompanyCode(+)
                and a.TransporterCode = e.TransporterCode(+)
                and a.PartyCode = f.PartyCode(+)
                and a.SourceLOcationTno = g.Tno(+)
                and a.DestinationLocationTno = h.Tno(+)
                and a.ItemCode = i.ItemCode(+)
                and a.LOadingOrderTno = j.Tno(+)
                and a.VehicleGroupCode = k.VehicleGroupCode(+)
                and a.VehicleNo = cv.VehicleNo(+)
                and cv.VehicleTypeCode = vt.VehicleTypeCode(+)
                and cv.OwnerCode = ts.TransporterCode(+)
                UNION ALL
                Select
                a.PlacementDate,
                a.PlacementNo,
                a.VehicleNo,
                null as LRNo,
                null as LRDate,
                'NO' as LRStatus,
                b.locationname,
                c.CompanyName,
                d.TransporterName,
                e.PartyName,
                f.SourceLocationName,
                g.DestinationLocationName,
                h.ItemName,
                i.LoadingOrderNo,
                i.PartyRefNo,
                i.WorkOrderNo,
                j.VehicleGroupName,
                a.DriverName,
                a.DriverLicenceNo,
                a.DriverMobileNo,
                a.MeterReading,
                a.Creator,
                vt.VehicleTypeName,
                ts.TransporterName as OwnerName,
                c.CompanyCode,
                d.TransporterCode,
                b.LocationCode,
                f.SourceLocationCode,
                g.DestinationLocationCode,
                j.VehicleGroupCode
                From Placement a, Location b, Company c, Transporter d, Party e, SourceLocation f, DestinationLocation g, Item h,
                LoadingOrder i, VehicleGroup j, CompanyVehicle cv, VehicleType vt, Transporter ts
                Where not exists(
                Select
                aa.Tno
                From LR aa
                Where aa.PlacementTno = a.Tno)
                and a.LocationCode = b.Locationcode(+)
                and a.CompanyCode = c.CompanyCode(+)
                and a.TransporterCode = d.TransporterCode(+)
                and a.PartyCode = e.PartyCode(+)
                and a.SourceLocationTno = f.Tno(+)
                and a.DestinationLocationTno = g.Tno(+)
                and a.ItemCode = h.ItemCode(+)
                and a.LoadingOrderTno = i.Tno(+)
                and a.VehicleGroupCode = j.VehicleGroupCode(+)
                and a.VehicleNo = cv.VehicleNo(+)
                and cv.VehicleTypeCode = vt.VehicleTypeCode(+)
                and cv.OwnerCode = ts.TransporterCode(+)) y,
                (
                Select
                a.EmptyVehiclePlacementDate,
                a.EmptyVehiclePlacementNo,
                a.VehicleNo,
                b.LRNo as EmptyLRNo,
                b.LRDate as EmptyLRDate
                From EmptyVehiclePlacement a, LR b
                Where a.Tno = b.ModuleTno(+)
                ) z
                Where x.VehicleNo = y.VehicleNo(+)
                and x.DayDate = y.PlacementDate(+)
                and x.VehicleNo = z.VehicleNo(+)
                and x.DayDate = z.EmptyVehiclePlacementDate(+)
                --and (:P249_COMPANY is Null Or Instr (':' || :P249_COMPANY || ':' , ':' || y.CompanyCode|| ':') > 0)
                and y.PlacementDate Between :P320_FromDate and :P320_ToDate
                --and (:P249_WITHLR is Null Or Instr (':' || :P320_WITHLR || ':' , ':' ||y.LRStatus|| ':') > 0)
                --and (:P249_VEHICLE is Null Or Instr (':' || :P249_VEHICLE || ':' , ':' || x.VehicleNo || ':') > 0)
                --and (:P249_PARTYDO is Null Or Instr (':' || :P249_PARTYDO || ':' , ':' || y.PartyRefNo|| ':') > 0)
                --and (:P249_LOCATION is Null Or Instr (':' || :P249_LOCATION || ':' , ':' || y.LocationCode|| ':') > 0)
                --and (:P249_CREATOR is Null Or Instr (':' || :P249_CREATOR || ':' , ':' || y.creator|| ':') > 0)
                --and (:P249_VEHICLEGROUP is Null Or Instr (':' || :P249_VEHICLEGROUP || ':' , ':' || y.VehicleGroupCode|| ':') > 0)
                --and (:P249_TRANSPORTER is Null Or Instr (':' || :P249_TRANSPORTER || ':' , ':' || y.TransporterCode|| ':') > 0)
                and (:P320_SO is Null Or Instr (':' || :P320_SO || ':' , ':' || y.SourceLocationCode|| ':') > 0)
                --and (:P249_DESTINATION is Null Or Instr (':' || :P249_DESTINATION || ':' , ':' || y.DestinationLocationCode|| ':') > 0)
                
                
                
                
                
                
                
                
                
                
                
