                and a.PlacementDate Between :P249_FromDate and :P249_ToDate
                and (:P249_LOCATION is Null Or Instr (':' || :P249_LOCATION || ':' , ':' || b.LocationCode|| ':') > 0)
                and (:P249_TRANSPORTER is Null Or Instr (':' || :P249_TRANSPORTER || ':' , ':' || d.TransporterCode|| ':') > 0)
                and (:P249_VEHICLE is Null Or Instr (':' || :P249_VEHICLE || ':' , ':' || a.VehicleNo || ':') > 0)
                and (:P249_PARTYDO is Null Or Instr (':' || :P249_PARTYDO || ':' , ':' || g.PartyRefNo|| ':') > 0)
                and (:P249_SO is Null Or Instr (':' || :P249_SO || ':' , ':' || sl.Tno|| ':') > 0)
                and (:P249_DESTINATION is Null Or Instr (':' || :P249_DESTINATION || ':' , ':' || dl.Tno|| ':') > 0)
                and (:P249_VEHICLEGROUP is Null Or Instr (':' || :P249_VEHICLEGROUP || ':' , ':' || vg.VehicleGroupCode|| ':') > 0)
                and (:P249_CREATOR is Null Or Instr (':' || :P249_CREATOR || ':' , ':' || a.creator|| ':') > 0)
                and (:P249_WITHLR is Null Or Instr (':' || :P249_WITHLR || ':' , ':' ||'NO'|| ':') > 0)
                order by 1 asc */
                
                
                
                
                
                
                
                
                
                
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
