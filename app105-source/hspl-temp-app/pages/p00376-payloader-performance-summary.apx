    region payloader-performance-summary (
        name: "Payloader Performance Summary "
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  a.CompanyCode,
                  a.CompanyName,
                  sum(a.Quantity1) as Quantity,
                  sum(a.TotalHMR) as TotalHMR,
                  sum(a.Amount) as Amount,
                  sum(a.TyreAmount) as TyreAmount,
                  sum(a.DieselAmount) as DieselAmount,
                  decode(nvl(sum(a.Amount), 0), 0, 0, 
                  round((sum(a.DieselAmount) * 100) / sum(a.Amount), 2) 
                  ) as DieselPercent,
                  sum(a.SpareAmount) as SpareAmount,
                  sum(a.DAAmount) as DAAmount,
                  sum(a.SalaryAmount) as SalaryAmount,
                  sum(a.BatteryAmount) as BatteryAmount,
                  sum(a.TripExpensesAmount) as TripExpensesAmount,
                  sum(a.TollAmount) as TollAmount,
                  sum(a.EMIAmount) as EMIAmount,
                  sum(a.OtherAmount) as OtherAmount,
                  sum(a.ExpenseAmount) as ExpenseAmount,
                  sum(a.ProfitAndLossAmount) as ProfitAndLossAmount
                From PayloaderPerformanceTable a
                Where a.Creator = :APP_USER
                  and :P376_FROMDATE IS NOT NULL
                Group By
                  a.CompanyCode,
                  a.CompanyName
                Having nvl(sum(a.Amount), 0) + nvl(sum(a.ExpenseAmount), 0) > 0
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tab
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
