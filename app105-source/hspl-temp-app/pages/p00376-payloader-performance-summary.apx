    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 70
            region: @payloader-performance-report
            slot: regionBody
            startNewRow: false
            column: 10
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction createlocation (
        name: CreateLocation
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: CreatePayloaderPerformanceL(:P376_LOCATION, :APP_USER);
                itemsToSubmit: P376_LOCATION
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction prepareexpense (
        name: PrepareExpense
        execution {
            sequence: 80
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: PreparePayloaderExpense(:P376_COMPANY, :P376_LOCATION, :P376_EQUIPMENTID, :P376_FROMDATE,:P376_TODATE, :APP_USER);
                itemsToSubmit: [
                    P376_COMPANY
                    P376_FROMDATE
                    P376_TODATE
                    P376_EQUIPMENTID
                    P376_LOCATION
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction preparepayloaderaverage (
        name: PreparePayloaderAverage
        execution {
            sequence: 90
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: PreparePayloaderAverageDetail(:P376_COMPANY, :P376_LOCATION, :P376_EQUIPMENTID, :P376_FROMDATE,:P376_TODATE, :APP_USER);
                itemsToSubmit: [
                    P376_COMPANY
                    P376_FROMDATE
                    P376_TODATE
                    P376_EQUIPMENTID
                    P376_LOCATION
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction preparerecord (
        name: PrepareRecord
        execution {
            sequence: 100
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 50
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: PreparePayloaderPerformance(:P376_COMPANY, :P376_LOCATION, :P376_EQUIPMENTID, :P376_FROMDATE,:P376_TODATE, :APP_USER);
                itemsToSubmit: [
                    P376_COMPANY
                    P376_FROMDATE
                    P376_TODATE
                    P376_EQUIPMENTID
                    P376_LOCATION
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#apex_wait_overlay").remove();
                    $(".u-Processing").remove();
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @payloader-performance-summary
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @payloader-performance-payloader-wise
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction show-spinner (
        name: Show Spinner
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 10
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var lSpinner$ = apex.util.showSpinner( $( "#payloaderperformance" ) );
                    //var spinner = apex.util.showSpinner("", {size:"big",color:"blue"})
                    
                    //spinner.remove();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

