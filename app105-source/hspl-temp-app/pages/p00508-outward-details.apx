page 508 (
    name: Outward Details
    alias: OUTWARD-DETAILS
    title: Outward Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 800
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region outward-details (
        name: Outward Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.TNo,
                      a.SNo,
                      i.IssueNO as ModuleNo,
                      i.IssueDate as ModuleDate,
                      dt.DocTypeName,
                      a.Quantity1,
                      'ISSUE' as Module
                From  StockOut a , Issue i, DocType dt
                Where a.ModuleCode = 'ISSUE'
                  and a.TNo = i.TNo
                  and i.DocTypeCode = dt.DocTypeCode
                  and a.ItemCode = :P508_ITEMCODE
                  and (:P508_ITEMSPECIFICATIONCODE is null or a.ItemSpecificatioNCode = :P508_ITEMSPECIFICATIONCODE)
                  and i.LocationCode like nvl(:P508_LOCATION,'%')
                  and a.OutDate = :P508_DAYDATE
                  and ( GetUserPanelAB_apex() is null  or i.panel = GetUserPanelAB_apex())
                Union All
                Select
                      a.TNo,
                      a.SNo,
                      i.CCInvoiceNO as ModuleNo,
                      i.CCInvoiceDate as ModuleDate,
                      dt.DocTypeName,
                      a.Quantity1,
                      'CCINVOICE' as Module
                From  StockOut a , CCInvoice i, DocType dt
                Where a.ModuleCode = 'CCINVOICE'
                  and a.TNo = i.TNo
                  and i.DocTypeCode = dt.DocTypeCode
                  and a.ItemCode = :P508_ITEMCODE
                  and (:P508_ITEMSPECIFICATIONCODE is null or a.ItemSpecificatioNCode = :P508_ITEMSPECIFICATIONCODE)
                  and i.LocationCode like nvl(:P508_LOCATION,'%')
                  and a.OutDate = :P508_DAYDATE
                  and ( GetUserPanelAB_apex() is null  or i.panel = GetUserPanelAB_apex())
                Union All
                Select
                      a.TNo,
                      a.SNo,
                      i.ProductionNO as ModuleNo,
                      i.ProductionDate as ModuleDate,
                      dt.DocTypeName,
                      a.Quantity1,
                      'PRODUCTION' as Module
                From  StockOut a , Production i, DocType dt
                Where a.ModuleCode = 'PRODUCTION'
                  and a.TNo = i.TNo
                  and i.DocTypeCode = dt.DocTypeCode
                  and a.ItemCode = :P508_ITEMCODE
                  and (:P508_ITEMSPECIFICATIONCODE is null or a.ItemSpecificatioNCode = :P508_ITEMSPECIFICATIONCODE)
                  and i.LocationCode like nvl(:P508_LOCATION,'%')
                  and a.OutDate = :P508_DAYDATE
                  and ( GetUserPanelAB_apex() is null  or i.panel = GetUserPanelAB_apex())
                Union All
                Select
                      a.TNo,
                      a.SNo,
                      i.StockJournalNo as ModuleNo,
                      i.StockJournalDate as ModuleDate,
                      dt.DocTypeName,
                      a.Quantity1,
                      'STOCKJOURNAL' as Module
                From  StockOut a , StockJournal i, DocType dt
                Where a.ModuleCode = 'STOCKJOURNAL'
                  and a.TNo = i.TNo
                  and i.DocTypeCode = dt.DocTypeCode
                  and a.ItemCode = :P508_ITEMCODE
                  and (:P508_ITEMSPECIFICATIONCODE is null or a.ItemSpecificatioNCode = :P508_ITEMSPECIFICATIONCODE)
                  and i.LocationCode like nvl(:P508_LOCATION,'%')
                  and a.OutDate = :P508_DAYDATE
                  and ( GetUserPanelAB_apex() is null  or i.panel = GetUserPanelAB_apex())
                ```
            pageItemsToSubmit: [
                P508_DAYDATE
                P508_LOCATION
                P508_ITEMCODE
                P508_ITEMSPECIFICATIONCODE
            ]
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 70123531362482635
        }

        column DOCTYPENAME (
            type: plainText
            heading {
                heading: Doctype Name
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BC
            }
        )

        column MODULE (
            type: plainText
            heading {
                heading: Module
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BE
            }
        )

        column MODULEDATE (
            type: plainText
            heading {
                heading: Module Date
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: BB
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BA
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Quantity
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: BD
            }
        )

        column SNO (
            type: plainText
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AZ
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AY
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: NecessitySlip Detail Report
        }

        savedReport 232721 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn DOCTYPENAME (
                sequence: 3
            )

            displayColumn MODULEDATE (
                sequence: 2
            )

            displayColumn MODULENO (
                sequence: 1
            )

            displayColumn QUANTITY1 (
                sequence: 4
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: NECESSITYSLIPNO
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P508_DAYDATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    pageItem P508_ITEMCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P508_ITEMSPECIFICATIONCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P508_LOCATION (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 10
            slot: contentBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 506
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

