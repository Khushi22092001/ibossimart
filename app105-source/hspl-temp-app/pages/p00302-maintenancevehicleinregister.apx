                SELECT DISTINCT
                A.EQUIPMENTNAME D,
                A.EQUIPMENTNAME R 
                FROM EQUIPMENT A,MAINTENANCEVEHICLEIN B
                WHERE A.TNO = B.EQUIPMENTTNO
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @maintenance-vehicle-in
