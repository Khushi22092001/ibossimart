page 302 (
    name: Maintenance Vehicle In Register
    alias: MAINTENANCEVEHICLEINREGISTER
    title: Maintenance Vehicle In Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenance-vehicle-in (
        name: Maintenance Vehicle In
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                row_number() over(order by MVN.MAINTENANCEVEHICLEINDATE) SerialNo,
                co.companyname as Company,
                d.doctypename as Doctype,
                l.locationname as Location,
                mvn.MaintenanceVehicleInDate,
                mvn.MaintenanceVehicleInNo,
                emo.equipmentmaintenanceorderno,
                e.equipmentno,
                e.equipmentname,
                em.employeename as drivername,
                mvn.hrreading,
                mvn.kmreading
                FROM MAINTENANCEVEHICLEIN mvn,
                     company co,
                     location l,
                     doctype d,
                     equipmentmaintenanceorder emo,
                     equipment e,
                     employee em
                WHERE 
                mvn.companycode = co.companycode(+)
                and mvn.locationcode = l.locationcode(+)
                and mvn.doctypecode = d.doctypecode(+)
                and mvn.equipmentmaintenanceordertno = emo.tno(+)
                and mvn.equipmenttno = e.tno(+)
                and mvn.drivercode = em.employeecode(+)
                and MVN.MAINTENANCEVEHICLEINDATE between :P302_FROMDATE and :P302_TODATE
                and ( :P302_COMPANY IS NULL OR instr(':'||:P302_COMPANY||':',':'||co.companycode||':') > 0 ) 
                and (:P302_LOCATION IS NULL OR instr(':'||:P302_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P302_MAINTENANCEVEHICLEINNO IS NULL OR instr(':'||:P302_MAINTENANCEVEHICLEINNO||':',':'||MVN.MAINTENANCEVEHICLEINNO||':') > 0 ) 
                and (:P302_EQUIPMENTNAME IS NULL OR instr(':'||:P302_EQUIPMENTNAME||':',':'||E.EQUIPMENTNAME||':') > 0)
                and (:P302_DRIVERNAME IS NULL OR instr(':'||:P302_DRIVERNAME||':',':'||EM.EMPLOYEEcode||':') > 0)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 20893356145794636
        }

