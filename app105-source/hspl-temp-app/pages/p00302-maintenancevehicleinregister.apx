                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                A.EMPLOYEENAME D,
                A.EMPLOYEECODE R  
                FROM EMPLOYEE A, MAINTENANCEVEHICLEIN B 
                WHERE A.EMPLOYEECODE = B.DRIVERCODE
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @maintenance-vehicle-in
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Driver Name
        }
    )

    pageItem P302_EQUIPMENTNAME (
        type: plugin/pretiusApexEnhancedLovItem
        label {
