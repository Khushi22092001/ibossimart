page 496 (
    name: Salary OB Without Sheet (Actual)
    alias: SALARY-OB-WITHOUT-SHEET474
    title: Salary OB Without Sheet (Actual)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region salary-ob-without-sheet-actual (
        name: Salary OB Without Sheet (Actual)
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region salarysheet (
        name: SalarySheet
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName,
                       SUM(decode(c.salaryheadcode, 'PR', c.SALARYHEADAMOUNT))    AS Present_Days,
                       ----24-01-2025 ---OT COLUMN HIDE -----
                       --SUM(decode(c.salaryheadcode, 'OT', c.SALARYHEADAMOUNT))    AS OT,
                       SUM(decode(c.salaryheadcode, 'APD', c.SALARYHEADAMOUNT))   AS Actual_Paid_Days,
                       SUM(decode(c.salaryheadcode, 'MAP', c.SALARYHEADAMOUNT))   AS Munsoon_Percent,
                       SUM(decode(c.salaryheadcode, 'PD', c.SALARYHEADAMOUNT))    AS Paid_Days,
                       SUM(decode(c.salaryheadcode, 'BASIC', c.SALARYHEADAMOUNT)) AS Fixed_Salary_For_Month,
                       SUM(decode(c.salaryheadcode, 'GROSSEARNING', c.SALARYHEADAMOUNT)) AS Gross_Earning,
                       SUM(decode(c.salaryheadcode, 'CANTEENDED', c.SALARYHEADAMOUNT)) AS Food_Etc,
                       SUM(decode(c.salaryheadcode, 'PFEMPLOYEE', c.SALARYHEADAMOUNT)) AS EPF,
                       SUM(decode(c.salaryheadcode, 'ESICEMPLOYEECONTRIBUTION', c.SALARYHEADAMOUNT)) AS ESIC,
                       SUM(decode(c.salaryheadcode, 'PTAX', c.SALARYHEADAMOUNT)) AS PT,
                       SUM(decode(c.salaryheadcode, 'TDS', c.SALARYHEADAMOUNT)) AS TDS,
                       SUM(decode(c.salaryheadcode, 'RUNNINGADVANCE', c.SALARYHEADAMOUNT)) +
                       SUM(decode(c.salaryheadcode, 'SALARYADVANCE', c.SALARYHEADAMOUNT)) AS Advance_Dec,
                       SUM(decode(c.salaryheadcode, 'GROSSDEDUCTION', c.SALARYHEADAMOUNT)) AS Total_Deduction,
                       SUM(decode(c.salaryheadcode, 'NETEARNING', c.SALARYHEADAMOUNT)) AS Net_Salary,
                       SUM(decode(c.salaryheadcode, 'OTHER INCOME', c.SALARYHEADAMOUNT)) AS Other_Income,
                       SUM(decode(c.salaryheadcode, 'OTHERDEDUCTION', c.SALARYHEADAMOUNT)) AS Other_Deduction,
                       GetLocationName(a.LocationCode) Location,
                       a.SalaryNo
                From   Salary a,Employee b,SalaryDetail c,Designation d,EmployeeSalary e,SalaryScheme f
                Where  a.EmployeeCode = b.EmployeeCode(+)
                  and  a.TNo = c.TNo(+)
                  and  b.DesignationCode = d.DesignationCode(+)
                  and  a.EmployeeSalaryTno = e.Tno(+)
                  and  e.Salaryschemecode = f.SalarySchemeCode(+)
                  and  f.SalarySchemeCode = '999999999'
                  and  to_char(a.SalaryFromDate,'MON-RRRR') = :P496_MONTH
                  and  (:P496_COMPANY IS NULL OR instr(':'||:P496_COMPANY||':',':'||b.CompanyCode||':') > 0)
                  and  (:P496_LOCATION IS NULL OR instr(':'||:P496_LOCATION||':',':'||a.LocationCode||':') > 0)
                  and  (:P496_EMPLOYEE IS NULL OR instr(':'||:P496_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0)
                Group By b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName, GetLocationName(a.LocationCode),a.SalaryNo
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 64233904505051110
        }

