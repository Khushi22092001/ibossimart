page 438 (
    name: Test Page
    alias: TEST-PAGE
    title: Test Page
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: url
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            url: &P438_NEW.
        }
    )

    pageItem P438_NEW (
        type: textField
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: functionBody
            plsqlFunctionBody: return 'http://115.242.138.210:7777/reports/rwservlet?server=rep_wls_reports_appserver' || chr(38) || 'destype=cache' || chr(38) || 'desformat=pdf' || chr(38) || 'userid=CMPL/CMPLI28O123@ORA19C' || chr(38) || 'report=purchaseorderitemfooter.rep' || chr(38) || 'parameters%20P_TNO=1309261692';
        }
    )

)

