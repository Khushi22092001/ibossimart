page 41 (
    name: Cost Center Master
    alias: COST-CENTER-MASTER
    title: Cost Center Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region cost-center (
        name: Cost Center
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by a.CostCentreCode) SerialNo,
                      a.CostCentreCode,
                      a.CostCentreName,
                      c.WorkcentreName,
                      a.Creator,
                      a.CreationTime
                From  CostCentre a, WorkCentre c
                Where a.WorkcentreCode = c.WorkcentreCode(+)
                 --and ( :P41_COMPANY IS NOT NULL OR instr(':'||:P41_COMPANY||':',':'||a.CompanyCode||':') > 0)
                 --and ( :P41_COSTCENTRE IS NULL OR instr(':'||:P41_COSTCENTRE||':',':'||a.CostCentreCode||':') > 0 )
                 and a.COMPANYCODE is not null 
                Order by 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 4517079428684317
        }

        column COSTCENTRECODE (
            type: plainText
            heading {
                heading: COST CENTRE CODE
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column COSTCENTRENAME (
            type: plainText
            heading {
                heading: COST CENTRE NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: CREATION TIME
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            appearance {
                formatMask: DD-MM-YYYY HH:MIPM
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: CREATOR
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column WORKCENTRENAME (
            type: plainText
            heading {
                heading: WORK CENTRE
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cost Center
        }

        savedReport 46041 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COSTCENTRECODE (
                sequence: 2
            )

            displayColumn COSTCENTRENAME (
                sequence: 3
            )

            displayColumn CREATIONTIME (
                sequence: 5
            )

            displayColumn CREATOR (
                sequence: 4
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region cost-center-master (
        name: Cost Center Master
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P41_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName D,
                      c.CompanyCode R
                From  Company c
                
                
                
                  
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @cost-center-master
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Company Name
        }
    )

    pageItem P41_COSTCENTRE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Cost Centre
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                     a.CostCentreName d,     
                     a.CostCentreCode r
                From CostCentre a
                Order by 1
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P41_COMPANY
            itemsToSubmit: P41_COSTCENTRE
        }
        layout {
            sequence: 20
            region: @cost-center-master
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Cost Centre Name
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 30
            region: @cost-center-master
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

