    region item-opening-stock-consumption (
        name: Item Opening Stock Consumption
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    ROWNUM AS SerialNo,
                    io.CompanyCode,
                    a.TNo AS stockTNo,
                    io.TNo AS ItemOpeningTNo,
                    l.LocationName,
                    l.LocationCode,
                    sl.StorageLocationName,
                    sl.StorageLocationCode,
                    e.ItemName,
                    ee.ItemSpecificationName,
                --    CONCAT(e.ItemName, ' ~ ', ee.ItemSpecificationName) AS ItemDetail,
                    io.ItemOpeningNo,
                    io.OpeningQuantity1,
                    io.OpeningValue,
                    COALESCE(iu.IssuedQuantity, 0) AS IssuedQuantity,
                    COALESCE(iu.IssuedQuantity, 0) * COALESCE(iu.Rate, 0) AS IssuedAmount,
                    COALESCE(stu.TransferQuantity, 0) AS TransferQuantity,
                    COALESCE(stu.TransferQuantity, 0) * COALESCE(stu.Rate, 0) AS TransferAmount,
                    io.OpeningQuantity1 - (COALESCE(iu.IssuedQuantity, 0) + COALESCE(stu.TransferQuantity, 0)) as BalanceQuantity,
                    io.OpeningValue - ((COALESCE(iu.IssuedQuantity, 0) * COALESCE(iu.Rate, 0))+(COALESCE(stu.TransferQuantity, 0) * COALESCE(stu.Rate, 0))) as BalanceAmount
                FROM
                    Stock a
                    INNER JOIN ItemOpening io ON a.StockModuleTNo = io.TNo
                    INNER JOIN Item e ON a.ItemCode = e.ItemCode
                    INNER JOIN ItemSpecification ee ON a.ItemSpecificationCode = ee.ItemSpecificationCode
                    INNER JOIN StorageLocation sl ON a.StorageLocationCode = sl.StorageLocationCode
                    INNER JOIN Location l ON a.LocationCode = l.LocationCode
                    LEFT JOIN (
                        SELECT
                            StockTNo,
                            SUM(UsedStockQuantity1) AS IssuedQuantity,
                            ROUND(Rate, 2) AS Rate
                        FROM
                            UsedStock
                        WHERE
                            ModuleCode = 'ISSUE'
                        GROUP BY
                            StockTNo, Rate
                    ) iu ON a.TNo = iu.StockTNo
                    LEFT JOIN (
                        SELECT
                            StockTNo,
                            SUM(UsedStockQuantity1) AS TransferQuantity,
                            ROUND(Rate, 2) AS Rate
                        FROM
                            UsedStock
                        WHERE
                            ModuleCode in ('STOCKTRANSFER','CCINVOICE','STOCKJOURNAL')
                        GROUP BY
                            StockTNo, Rate
                    ) stu ON a.TNo = stu.StockTNo
                WHERE
                    StockModuleCode = 'ITEMOPENING'
                      -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and  instr(':'||:P377_COMPANY||':',':'||io.CompanyCode||':') > 0
                  and ( :P377_LOCATION IS NULL OR instr(':'||:P377_LOCATION||':',':'||io.LocationCode||':') > 0 ) 
                  and ( :P377_ITEM IS NULL OR instr(':'||:P377_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P377_ITEMSPECIFICATION IS NULL OR instr(':'||:P377_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 );
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
