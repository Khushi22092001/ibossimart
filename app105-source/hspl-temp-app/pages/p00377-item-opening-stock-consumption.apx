                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                ee.itemSpecificationName as d,
                ee.itemSpecificationCode as r
                From ItemOpening a,  itemSpecification ee
                Where a.ItemSpecificationCode = ee.ItemSpecificationCode
                  and a.ItemCode = :P377_ITEM
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P377_ITEM
            itemsToSubmit: P377_ITEMSPECIFICATION
        }
        layout {
            sequence: 80
            region: @filter
