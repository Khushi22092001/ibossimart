            highlight ir-condition (
                name: Excess Sanction
                condition {
                    column: DIFFSANCTIONANDINDENT
                    operator: <
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FF24FF
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: Equal
                condition {
                    column: DIFFSANCTIONANDINDENT
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #4AFF7A
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Short
                condition {
                    column: DIFFSANCTIONANDINDENT
                    operator: >
                    value: 0
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FF2946
                    text: #FFFFFF
                }
                execution {
                    sequence: 10
                }
            )

        )

