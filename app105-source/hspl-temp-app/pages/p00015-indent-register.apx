        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select IndentNo 
                From Indent 
                Where instr(':'||:P15_LOCATION||':',':'||LocationCode||':') > 0
                  and indentDate Between :P15_FROMDATE and :P15_TODATE
                Order by 1
