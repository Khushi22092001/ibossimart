    pageItem P15_CREATOR (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Creator
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                distinct
                bue.EmployeeName||' ( '||a.Creator||' )' d,
                bue.EmployeeName||' ( '||a.Creator||' )' r
                FROM Indent a, BossUser bu, Employee bue
                where a.Creator = bu.LoginName(+)
                and bu.EmployeeCode = bue.EmployeeCode(+)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P15_COMPANY
            itemsToSubmit: [
                P15_LOCATION
                P15_DOCTYPE
            ]
        }
        layout {
            sequence: 170
            region: @indent-register
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Creator Name
        }
    )

