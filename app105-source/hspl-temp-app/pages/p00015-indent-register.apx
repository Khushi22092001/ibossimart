    region indent-register (
        name: Indent Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region indent-register-report (
        name: Indent Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select row_number() over(order by XX.IndentDate) SerialNo,
                XX.*
                From 
                (Select
                      --row_number() over(order by a.IndentDate) SerialNo,
                      a.TNo,
                      b.SNo,
                      l.LocationName,
                      dt.DocTypeName,
                      dp.DepartmentName,
                      a.IndentNo,
                      a.IndentDate,
                      a.Remark,
                      e.ParentCode||' ~ '||GetItemname(e.ParentCode) as MaterialGroup,
                      b.ItemCode,
                      e.ItemName||' ~ '||ee.ItemSpecificationName as Material,
                      e.MeasuringUnitCode1 as UOM1,
                      round(b.IndentQuantity1,3) as IndentQuantity1,
                      e.MeasuringUnitCode2 as UOM2,
                      round(b.IndentQuantity2,3) as IndentQuantity2,
                      round(c.Quantity1,3) as SanctionQuantity1,
                      round(c.Quantity2,3) as SanctionQuantity2,
                      round(b.IndentQuantity1 - b.Quantity1,3)  as DiffSanctionandIndent,
                      b.Remark as Purpose,
                      b.DocumentStatusCode as DocumentStatus,
                      case when po.indenttno = a.tno then
                                'PREPARED'
                           when cp.Indenttno = a.tno then
                                'CASHPURCHASE'
                           when po.indenttno is null or cp.indenttno is null then
                                'PENDING'
                       end POStatus,
                      --nvl(decode(po.IndentTNo,a.TNo,'PREPARED'),'PENDING') as POStatus,
                      po.Tno as POTNO,
                      po.PurchaseOrderNo,
                      po.PurchaseOrderDate,
                      po.PartyName,
                      round(po.POQuantity1,3) as POQuantity1,
                      round(po.POQuantity2,3) as POQuantity2,
                      round(b.Quantity1 - po.POQuantity1,3) as Variance1,
                      round(b.Quantity2 - po.POQuantity2,3) as Variance2,
                      bue.EmployeeName||' ( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      cc.CostCentreName,
                      case When b.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When b.DocumentStatusCode is null Then 'NON-ACTIVE'
                           When b.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When b.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When b.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When b.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When b.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When b.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When b.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When b.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When b.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End as DocStatus,
                      b.Description,
                      ic.ItemCategoryName,
                      di.DealsInName,
                      Case When po.PurchaseOrderTno is null then 'PENDING'
                      When po.PurchaseOrderTno is not null then 'PREPAIRED'
                      end as GRNStatus,
                      eq.EnquiryNo
                From  Indent a, IndentDetail b, IndentCostCentreDetail c, CostCentre cc, Location l , Doctype dt, Department dp, Item e, ItemSpecification ee, MeasuringUnit mu, BossUser bu, Employee bue,
                      (Select
                            pp.TNo,
                            qq.IndentTNo,
                            pp.PurchaseOrderNo,
                            pp.PurchaseOrderDate,
                            ppp.PartyName,
                            ppp.PartyCode,
                            qq.ItemCode,
                            qq.ItemSpecificationCode,
                            qq.Quantity1 as POQuantity1,
                            qq.Quantity2 as POQuantity2,
                            gr.PurchaseOrderTno
                      From  PurchaseOrder pp, PurchaseOrderDetailIndent qq, Party ppp, PurchaseOrderDetail pd,GRNDetail gr
                      Where pp.TNo = qq.TNo(+)
                        and pp.PartyCode = ppp.PartyCode(+)
                        and qq.Tno = pd.Tno(+)
                        and qq.SNo = pd.SNo(+)
                        and pd.Tno = gr.PurchaseOrderTno(+)
                        and pd.ItemCode = gr.ItemCode(+)
                        and pd.ItemSpecificationCode = gr.ItemSpecificationCode(+)
                        and qq.ItemCode = gr.ItemCode(+)
                        and qq.ItemSpecificationCode = gr.ItemSpecificationCode(+)
                        ) po,
                       (Select pp.TNo,
                            qq.IndentTNo,
                            ppp.PartyName,
                            ppp.PartyCode,
                            qq.ItemCode,
                            qq.ItemSpecificationCode,
                            qq.Quantity1             As POQuantity1,
                            qq.Quantity2             As POQuantity2
                        From CashPurchase pp, CashPurchaseDetail qq, Party ppp
                        Where pp.TNo = qq.TNo
                        And pp.PartyCode = ppp.PartyCode(+) 
                        ) CP, DealsIn di, ItemCategory ic, Enquiry eq
                Where a.TNo = b.TNo(+)
                  and b.TNo = c.TNo(+)
                  and b.SNo = c.SNo(+)
                  and c.CostCentreCode = cc.CostCentreCode(+)
                  and a.LocationCode = l.LocationCode(+)
                  and a.DocTypeCode = dt.DocTypeCode(+)
                  and a.DepartmentCode = dp.DepartmentCode(+)
                  and b.ItemCode = e.ItemCode(+)
                  and B.Itemspecificationcode = ee.ItemSpecificationCode(+)
                  and E.Measuringunitcode1 = Mu.Measuringunitcode(+)
                  and b.Tno = po.IndentTNo(+)
                  and b.ItemCode = Po.Itemcode(+)
                  and b.Itemspecificationcode = po.ItemSpecificationCode(+)
                
                  and b.Tno = cp.IndentTNo(+)
                  and b.ItemCode = cp.Itemcode(+)
                  and b.Itemspecificationcode = cp.ItemSpecificationCode(+)
                  and e.DealsInCode = di.DealsInCode(+)
                  and e.ItemCategoryCode = ic.ItemCategoryCode(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)
                  and b.EnquiryTno = eq.Tno(+)
                  and ( :P15_TODOLIST = 'YES' OR :P15_NEXTPROCESS = 'YES' OR ( a.IndentDate BETWEEN TO_DATE(:P15_FROMDATE) and TO_DATE(:P15_TODATE)))
                  and ( :P15_TODOLIST = 'YES' OR :P15_NEXTPROCESS = 'YES' OR (instr(':'||:P15_DOCTYPE||':',':'||a.DocTypeCode||':') > 0))
                  and ( :P15_TODOLIST = 'YES' OR :P15_NEXTPROCESS = 'YES' OR (instr(':'||:P15_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and ( :P15_TODOLIST = 'YES' OR :P15_NEXTPROCESS = 'YES' OR (instr(':'||:P15_COMPANY||':',':'||a.CompanyCode||':') > 0))
                 
                 -- and nvl(decode(po.IndentTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P15_POSTATUS,'%')
                  and ( :P15_ITEM IS NULL OR instr(':'||:P15_ITEM||':',':'||e.ItemCode||':') > 0 )
                  and ( :P15_ITEMSPECIFICATION IS NULL OR instr(':'||:P15_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                 -- and ( :P15_GROUP IS NULL OR instr(':'||:P15_GROUP||':',':'||e.ParentCode||':') > 0 ) 
                  and ( :P15_DEPARTMENT IS NULL OR instr(':'||:P15_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0 ) 
                  and ( :P15_COSTCENTRE IS NULL OR instr(':'||:P15_COSTCENTRE||':',':'||cc.CostCentreCode||':') > 0 ) 
                  and a.IndentNo like nvl(:P15_INDENTNO,'%')
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  -- Added on 28-May-2022
                  and ( :P15_GROUP IS NULL
                      or
                      exists (select 1 from (Select ITEMCODE,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                               Level,
                               CONNECT_BY_ROOT itemcode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From item a
                         Start With parentcode in ( select itemcode from item xx where
                                                    instr(':'||:P15_GROUP||':',':'||xx.ItemCode||':') > 0)
                                                    
                        Connect By parentcode = Prior itemcode
                         Order Siblings By itemcode) x where x.itemcode = e.itemcode
                        )
                  )
                 
                  and case When b.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When b.DocumentStatusCode is null Then 'NON-ACTIVE'
                           When b.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When b.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When b.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When b.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When b.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When b.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When b.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When b.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When b.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End  like nvl(:P15_STATUS,'%')
                   
                ) xx
                where xx.postatus like nvl(:P15_POSTATUS,'%')
                
                AND  (:P15_TODOLIST='NO' OR  (:P15_TODOLIST='YES' AND EXISTS ( SELECT 1 FROM ONTHETABLE_APEX YY WHERE YY.MODULETNO=XX.TNO) ))
                AND ( :P15_NEXTPROCESS='NO' OR (:P15_NEXTPROCESS = 'YES' AND (  getdocumentstatuscode('INDENT',XX.TNO)='ACTIVE'
                                                    AND  NOT EXISTS ( Select 1 From ENQUIRYINDENTDETAIL AA Where AA.INDENTTNO = XX.TNO )
                                                ))
                
                 )
                ```
            pageItemsToSubmit: [
                P15_COMPANY
                P15_STATUS
                P15_FROMDATE
                P15_TODATE
                P15_LOCATION
                P15_DEPARTMENT
                P15_DOCTYPE
                P15_GROUP
                P15_INDENTNO
                P15_ITEM
                P15_POSTATUS
                P15_COSTCENTRE
                P15_INDENTSTATUS
                P15_ITEMSPECIFICATION
                P15_CREATOR
                P15_TODOLIST
                P15_NEXTPROCESS
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
