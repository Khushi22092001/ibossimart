                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    a.DestinationLocationName d,
                    a.Tno r
                From PODDetail c, LR b, DestinationLocation a
                Where c.LrTno = b.Tno(+)
                and b.DestinationLocationTno = a.Tno(+);
                ```
            displayNullValue: false
        }
        layout {
            sequence: 130
            region: @pod-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
