    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            
            ```
    }
    security {
        formAutoComplete: false
    }

    region pod-register (
        name: POD Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pod-register-report (
        name: POD Register Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    row_number() over(order by a.PODDate) SerialNo,
                    d.CompanyName,
                    c.VehicleNo,
                    e.LocationName as Location,
                    a.PODNo,
                    a.PODDate,
                    c.LRNO,
                    c.LRDate,
                    c.GPNo,
                    c.PartyRefNo as PartyDoNo,
                    c.InvoiceNo,
                    round(c.Quantity1,2) as DispatchedQuantity,
                    round(b.Quantity1,2) as ReachedQuantity,
                    round(nvl(b.Quantity1,0) - nvl(c.Quantity1,0),2) as ShortageQty,
                    to_char(b.DeliveryDate,'dd-Mon-rrrr') as DeliveryDate,
                    h.SourceLocationName,
                    g.DestinationLocationName,
                    i.RouteName,
                    b.DistanceInKm,
                    f.TransporterName,
                    vg.VehicleGroupName,
                    a.Creator,
                    to_char(a.CreationTime,'dd-Mon-rrrr') as CreationDate,
                    to_char(a.CreationTime,'HH:MI') as CreationTime
                From POD a, PODDetail b, LR c,VehicleGroup vg, Company d, Location e, Transporter f, DestinationLocation g,SourceLocation h,
                Route i
                Where a.Tno = b.Tno(+)
                and b.LRTno = c.Tno(+)
                and c.VehicleGroupCode = vg.VehicleGroupCode(+)
                and a.CompanyCode = d.CompanyCode(+)
                and a.LocationCode = e.LocationCode(+)
                and c.TransporterCode = f.TransporterCode(+)
                and c.Destinationlocationtno = g.Tno(+)
                and c.SourceLocationTno = h.Tno(+)
                and b.RouteCode = i.RouteCode(+)
                and a.PODDATE Between :P212_FromDate and :P212_ToDate
                and (:P212_COMPANY is Null Or Instr (':' || :P212_COMPANY || ':' , ':' || d.CompanyCode || ':') > 0)
                and (:P212_TRANSPORTER is Null Or Instr (':' || :P212_TRANSPORTER || ':' , ':' || f.TransporterCode || ':') > 0)
                and (:P212_LOCATION is Null Or Instr (':' || :P212_LOCATION || ':' , ':' || e.LocationCode || ':') > 0)
                and (:P212_VEHICLE is Null Or Instr (':' || :P212_VEHICLE || ':' , ':' || c.VehicleNo || ':') > 0)
                and (:P212_POD is Null Or Instr (':' || :P212_POD || ':' , ':' ||a.Tno || ':') > 0)
                and (:P212_PARTYDONO is Null Or Instr (':' || :P212_PARTYDONO || ':' , ':' || c.PartyRefNo || ':') > 0)
                and (:P212_SOURCE is Null Or Instr (':' || :P212_SOURCE || ':' , ':' || h.Tno || ':') > 0)
                and (:P212_DESTINATION is Null Or Instr (':' || :P212_DESTINATION || ':' , ':' || g.Tno || ':') > 0)
                and (:P212_VEHICLEGROUP is Null Or Instr (':' || :P212_VEHICLEGROUP || ':' , ':' || vg.VehicleGroupCode || ':') > 0)
                 
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            htmlDomId: REPORT
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                pdf
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                   
                ```
        }
        advanced {
            savedReportMappingIdentifier: 28217226201669797
        }

