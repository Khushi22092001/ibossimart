page 191 (
    name: TCS Collected
    alias: TCS-COLLECTED
    title: TCS Collected
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region tcs-collected (
        name: TCS COLLECTED
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       row_number() over(order by a.invoicedate) SerialNo,
                       a.LocationCode,
                       a.CompanyCode,
                       a.PartyCode,
                       GetPartyName(a.PartyCode) as PartyName,
                       a.InvoiceNo,
                       a.invoiceDate,
                       a.InvoiceAmount,
                       b.FooterValue as TCSAmount,
                       b.FooterPercent as TCSPercent,
                       c.CompanyName,
                       d.LocationName
                  From Invoice a, InvoiceDetailFooter b, Company c, Location d
                  Where Exists (Select 1
                          From InvoiceDetailFooter xx
                         Where xx.FooterHeadCode = '.TCS.'
                           and xx.Tno = a.Tno)
                  and a.Tno = b.Tno
                  and b.FooterHeadCode = '.TCS.'
                  and a.CompanyCode = c.CompanyCode
                  and a.LocationCode = d.LocationCode(+)
                  and To_Char(a.InvoiceDate, 'MON-RR')   = :P191_MONTH
                  and ( :P191_LOCATION IS NULL OR instr(':'||:P191_LOCATION||':',':'||d.LocationCode||':') > 0 )
                  and ( :P191_PARTY IS NULL OR instr(':'||:P191_PARTY||':',':'||a.PartyCode||':') > 0 )
                   and :P191_COMPANY = a.CompanyCode
                  --and ( :P172_PARTY IS NULL OR instr(':'||:P172_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                  and :P191_MONTH is not null
                
                /* 07-nov-2024 
                Select 
                       row_number() over(order by a.ccinvoicedate) SerialNo,
                       a.LocationCode,
                       a.CompanyCode,
                       a.PartyCode,
                       GetPartyName(a.PartyCode) as PartyName,
                       a.CCInvoiceNo,
                       a.CCinvoiceDate,
                       a.CCInvoiceAmount,
                       b.FooterValue as TCSAmount,
                       b.FooterPercent as TCSPercent,
                       c.CompanyName,
                       d.LocationName
                  From CCInvoice a, CCInvoiceDetailFooter b, Company c, Location d
                  Where Exists (Select 1
                          From CCInvoiceDetailFooter xx
                         Where xx.FooterHeadCode = '.TCS.'
                           and xx.Tno = a.Tno)
                  and a.Tno = b.Tno
                  and b.FooterHeadCode = '.TCS.'
                  and a.CompanyCode = c.CompanyCode
                  and a.LocationCode = d.LocationCode(+)
                  and To_Char(a.CCInvoiceDate, 'MON-RR')   = :P191_MONTH
                  and ( :P191_LOCATION IS NULL OR instr(':'||:P191_LOCATION||':',':'||d.LocationCode||':') > 0 )
                  and ( :P191_PARTY IS NULL OR instr(':'||:P191_PARTY||':',':'||a.PartyCode||':') > 0 )
                   and :P191_COMPANY = a.CompanyCode
                  --and ( :P172_PARTY IS NULL OR instr(':'||:P172_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                  and :P191_MONTH is not null
                */
                ```
        }
