page 429 (
    name: Sitewise Service Expense Summary
    alias: SITEWISE-SERVICE-EXPENSE-SUMMARY
    title: Sitewise Service Expense Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                 row_number() over(order by a.LocationCode) SerialNo,
                 a.LocationName,
                 a.LocationCode,
                 sum(a.Quantity) as Quantity,
                 sum(a.Amount) as Amount
                 From 
                 (Select 
                  c.LocationName,
                  a.LocationCode,
                  nvl(b.Quantity,d.Quantity) as Quantity,
                  nvl(b.Amount,d.Amount) as Amount
                  From ExternalServicesEntry a, ExternalSpareEntryDetail b, ExternalServicesEntryDetail d,Location c
                  Where a.Tno = b.Tno(+)  
                  and a.Tno = d.Tno(+)
                  and a.LocationCode = c.LocationCode(+)
                  and a.ExternalServicesEntryDate between :P429_FROMDATE and :P429_TODATE
                --   Group by 
                --   c.LocationName,
                --   a.LocationCode
                UNION ALL
                Select
                   c.LocationName,
                   a.LocationCode,
                   NVL(b.Quantity1,0) as Quantity,
                   NVL(b.Amount,0) as Amount
                From JBPass a, JBPassDetail b, Location c
                Where a.Tno = b.Tno(+)
                  and a.LocationCode = c.LocationCode(+)
                  and a.JBPassDate between :P429_FROMDATE and :P429_TODATE
                --   Group by 
                --   c.LocationName,
                --   a.LocationCode
                  ) a
                Where ( :P429_LOCATION IS NULL OR instr(':'||:P429_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                Group by  a.LocationName,
                 a.LocationCode
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 27628178015844503
        }

        column AMOUNT (
            type: link
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            link {
                target: {
                    page: 417
                    items: {
                        P417_FROMDATE: &P429_FROMDATE.
                        P417_TODATE: &P429_TODATE.
                        P417_LOCATION: #LOCATIONCODE#
                    }
                    clearCache: 417
                }
                linkText: #AMOUNT#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: Locationcode
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location Name
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 276364 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 4
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn QUANTITY (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: LOCATIONNAME
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region site-wise-service-expense-summary (
        name: Site Wise Service Expense Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P429_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @site-wise-service-expense-summary
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P429_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                a.*
                 From 
                 (Select 
                  c.LocationName d,
                  c.LocationCode r
                  From ExternalServicesEntry a, Location c
                  Where a.LocationCode = c.LocationCode
                UNION ALL
                Select
                   c.LocationName d,
                   c.LocationCode r
                From JBPass a, Location c
                Where a.LocationCode = c.LocationCode) a
                ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @site-wise-service-expense-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Location Name
        }
    )

    pageItem P429_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @site-wise-service-expense-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 40
            region: @site-wise-service-expense-summary
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

