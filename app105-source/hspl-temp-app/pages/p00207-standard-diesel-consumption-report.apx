page 207 (
    name: Standard Diesel Consumption Report
    alias: STANDARD-DIESEL-CONSUMPTION-REPORT
    title: Standard Diesel Consumption Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                row_number() over(order by a.StandardDieselConsumptionName) SerialNo,
                a.StandardDieselConsumptionName,
                a.DistanceInKm,
                a.DieselForLoadedVehicle,
                a.DieselForEmptyVehicle,
                b. SourceLocationName,
                c.DestinationLocationName
                from StandardDieselConsumption a, SourceLocation b, DestinationLocation c
                Where a.SourceLocationTno = b.Tno
                and a.DestinationLocationTno = c.Tno;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 56327214339856838
        }

        savedReport 578090 (
            visibility: primary
            view {
                default: grid
                settingsAreaExpanded: false
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @SERIALNO
                layout {
                    width: 87.375
                    sequence: 1
                }
            )

            displayColumn (
                column: @STANDARDDIESELCONSUMPTIONNAME
                layout {
                    width: 371
                    sequence: 2
                }
            )

            displayColumn (
                column: @DISTANCEINKM
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @DIESELFORLOADEDVEHICLE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @DIESELFOREMPTYVEHICLE
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @SOURCELOCATIONNAME
                layout {
                    width: 234
                    sequence: 3
                }
            )

            displayColumn (
                column: @DESTINATIONLOCATIONNAME
                layout {
                    sequence: 4
                }
            )

            sort (
                column: @SERIALNO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            aggregate count (
                column: @SERIALNO
                function: count
                showGrandTotal: true
            )

            aggregate sum (
                column: @DISTANCEINKM
            )

        )

        column DESTINATIONLOCATIONNAME (
            type: textarea
            heading {
                heading: Destination Location
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: DESTINATIONLOCATIONNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column DIESELFOREMPTYVEHICLE (
            type: numberField
            heading {
                heading: Diesel For Empty Vehicle
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: DIESELFOREMPTYVEHICLE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column DIESELFORLOADEDVEHICLE (
            type: numberField
            heading {
                heading: Diesel For Loaded Vehicle
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                databaseColumn: DIESELFORLOADEDVEHICLE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column DISTANCEINKM (
            type: numberField
            heading {
                heading: Distance In Km
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                databaseColumn: DISTANCEINKM
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SERIALNO (
            type: numberField
            heading {
                heading: Serial  No
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: SERIALNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SOURCELOCATIONNAME (
            type: textarea
            heading {
                heading: Source Location
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: SOURCELOCATIONNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column STANDARDDIESELCONSUMPTIONNAME (
            type: textarea
            heading {
                heading: "Standard Diesel Consumption "
            }
            layout {
                sequence: 10
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: STANDARDDIESELCONSUMPTIONNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }
    )

)

