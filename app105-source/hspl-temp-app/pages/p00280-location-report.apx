page 280 (
    name: Location Master
    alias: LOCATION-REPORT
    title: Location Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
            overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region location-master (
        name: Location Master
        type: staticContent
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region location-master-2 (
        name: Location Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                  row_number() over(order by a.Tno) SerialNo,
                a.Tno,
                a.LocationName,
                a.LocationShortName, 
                g.LocationName as ParentName,
                b.PartyName as CreditName,
                c.PartyName as DebitName,
                d.PartyName as  BranchAccountName,
                a.Latitude,
                a.Longitude,
                a.IsDivision,
                e.StateName,
                a.AllowLRWithoutPlacement,
                a.AllowChangeFreightRate,
                a.ShiftWiseDriver,
                f.PartyName as ImprestAccount,
                ds.DocumentStatusName
                From Location a,Party b, Party c, Party d, State e, Party f, Location g,
                Documentstatusdetail dsd, Documentstatus ds
                Where a.IUTCreditAccountCode = b.PartyCode(+)
                and a.IUTDebitAccountCode = c.PartyCode(+)
                and a.BranchAccountCode = d.PartyCode(+)
                and a.StateCode = e.StateCode(+)
                and a.ImprestAccountCode = f.PartyCode(+)
                and a.ParentCode = g.LocationCode(+)
                and a.Tno = dsd.ModuleTno(+)
                and dsd.documentstatuscode = ds.documentstatuscode(+)
                and (:P280_LOCATION is Null Or Instr (':' || :P280_LOCATION || ':' , ':' || a.Tno || ':') > 0)
                and (:P280_PARENT is Null Or Instr (':' || :P280_PARENT || ':' , ':' || g.LocationCode || ':') > 0);
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 15066159839940229
        }

        column ALLOWCHANGEFREIGHTRATE (
            type: hidden
            heading {
                heading: Allowchangefreightrate
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ALLOWLRWITHOUTPLACEMENT (
