page 483 (
    name: Yearly Store Purchase Inventory
    alias: YEARLY-STORE-PURCHASE-INVENTORY1
    title: Yearly Store Purchase Inventory
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region yearly-store-purchase-inventory (
        name: Yearly Store Purchase Inventory
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region yearly-store-purchase-inventory-2 (
        name: Yearly Store Purchase Inventory
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  a.Item,
                  ROWNUM AS SERIALNO,
                  a.PurchaseQty,
                  a.PurchaseAmt,
                  a.TransferInQty,
                  a.TransferInAmount,
                  a.IssueQty,
                  a.IssueAmtount,
                  a.TransferOutQty,
                  a.TransferfrOutAmount,
                  a.StockJournalQty,
                  a.StockJournalAmount
                From YearlyStorePurchaseInventory a
                Where :P483_FINANCIALYEAR = a.FinancialYearCode
                and ( :P483_ITEM IS NULL OR instr(':'||:P483_ITEM||':',':'||a.Item||':') > 0 )
                and ( :P483_COMPANY IS NULL OR instr(':'||:P483_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                ;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 137511312486902365
        }

        column ISSUEAMTOUNT (
            type: plainText
            heading {
                heading: Issue Amount
                alignment: center
            }
            layout {
                sequence: 260
                columnAlignment: end
            }
            appearance {
                formatMask: 999999990.99
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:100px">#ISSUEAMTOUNT#</div>
            }
            source {
                dataType: NUMBER
            }
            advanced {
