    )

    pageItem P483_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                 a.CompanyName d,
                 a.CompanyCode r
                From Company a
                Where exists
                (Select 
                    aa.CompanyCode
                    From YearlyStorePurchaseInventory aa
                    Where aa.CompanyCode = a.CompanyCode);
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @yearly-store-purchase-inventory
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Company Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P483_FINANCIALYEAR (
        type: popupLov
        label {
            label: Financial Year
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                  a.FinancialYearCode d,
                  a.FinancialYearCode r
                From YearlyStorePurchaseInventory a;
                ```
        }
        layout {
            sequence: 20
            region: @yearly-store-purchase-inventory
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P483_ITEM (
        type: popupLov
        label {
            label: item Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct 
                 a.Item d,
                 a.Item r
                From YearlyStorePurchaseInventory a
                ```
            displayExtraValues: false
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 40
            region: @yearly-store-purchase-inventory
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Item Name
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 50
            region: @yearly-store-purchase-inventory
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

