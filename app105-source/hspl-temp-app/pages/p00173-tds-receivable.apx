    region tds-receivable (
        name: TDS RECEIVABLE
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                       row_number() over(order by C.VOUCHERDATE) SerialNo,
                       A.LOCATIONCODE,
                       A.DFREIGHTBILLRECEIPTNO AS ENTRYNO,
                       A.DFREIGHTBILLRECEIPTDATE AS ENTRYDATE,
                       C.VOUCHERNO,
                       C.VOUCHERDATE,
                       D.PARTYNAME,
                       B.AMOUNT,
                       B.TDSAMOUNT,
                       NULL AS MATCHEDWITH26AS,
                       getpartyattributevalue(D.PARTYCODE, 'PANNO') AS PANNO,
                       NULL AS GROSSAMOUNTASPER26AS,
                       NULL AS TDSRECEIVABLEASPER26AS,
                       NULL AS TDSDATEASPER26AS,
                       NULL AS QUARTERASPER26AS,
                       NULL AS YEARASPER26AS,
                       NULL AS DIFFINGROSSFROM16AS,
                       NULL AS DIFFINTDSFROM26AS,
                       NULL AS REMARK
                  FROM DFREIGHTBILLRECEIPT       A,
                       DFREIGHTBILLRECEIPTDETAIL B,
                       VOUCHER                   C,
                       PARTY                     D
                 WHERE A.TNO = B.TNO
                   AND A.TNO = C.MODULETNO(+)
                   AND A.DEPOCODE = D.PARTYCODE(+)
                   AND NVL(B.TDSAMOUNT, 0) > 0
                
                   -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and instr(':'||:P173_LOCATION||':',':'||a.LocationCode||':') > 0
                  and C.VoucherDate between :P173_FROMDATE and :P173_TODATE
                  and ( :P173_PartyCode IS NULL OR instr(':'||:P173_PartyCode||':',':'||a.DepoCode||':') > 0 )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
