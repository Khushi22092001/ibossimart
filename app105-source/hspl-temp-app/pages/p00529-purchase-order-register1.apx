    pageItem P529_PARTYNAME (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vendor
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
