            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P529_ITEM (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Material
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      e.ItemName||'( '||e.ItemCode||' )' as d,
                      e.ItemCode r
                From PurchaseOrderDetail a,Item e
                Where a.ItemCode = e.ItemCode
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @purchase-order-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 74
            valuePlaceholder: Material
        }
    )

    pageItem P529_ITEMSPECIFICATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Specification
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
