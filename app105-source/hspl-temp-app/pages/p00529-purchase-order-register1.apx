        }
    )

    pageItem P529_PONO (
        type: textFieldWithAutocomplete
        label {
            label: PoNo
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select PurchaseOrderNo From PurchaseOrder 
                Where instr(':'||:P529_LOCATION||':',':'||LocationCode||':') > 0
                  and PurchaseOrderDate Between :P529_FROMDATE and :P529_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P529_LOCATION
            itemsToSubmit: P529_PONO
        }
        layout {
