    region purchase-order-register (
        name: Purchase Order Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region purchase-order-report (
        name: Purchase Order Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by xxx.PurchaseOrderDate) SerialNo,
                      xxx.TNo,
                      xxx.SNo,
                      xxx.LocationName,
                      xxx.DocTypeName,
                      xxx.PurchaseOrderNo,
                      xxx.PurchaseOrderDate,
                      xxx.PartyName,
                      xxx.DeliveryDate as DeliveryDate,
                       XXX.DELIVERYDATE - TRUNC(SYSDATE)  AS DeliveryRemainingDays,
                      xxx.ItemCode,
                      xxx.MaterialDetail,
                      xxx.UOM,
                      round(xxx.Quantity1,3) as Quantity1,
                      xxx.UOM2,
                      round(xxx.Quantity2,3) as Quantity2,
                      xxx.AgentName,
                      XXX.WITHOUTDISCOUNTRATE,
                      XXX.DISCOUNTRATE,
                      xxx.Rate,
                      round(xxx.Amount,2) as Amount,
                      xxx.CGST,
                      xxx.SGST,
                      xxx.IGST,
                      xxx.TCS,
                      round(xxx.FooterAmount,2) as FooterAmount,
                      round((xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS)),2) as OtherAmount,
                      round(xxx.TotalAmount,2) as TotalAmount,
                      round(xxx.GRNReceivedQty,3) as GRNReceivedQty,
                      round(xxx.GRNReceivedQty2,3) as GRNReceivedQty2,
                      round(xxx.WBAcceptedWeight,3) as WBAcceptedWeight,
                      round(xxx.WBNetWeight,3) as WBNetWeight,
                      round(xxx.balanceQty,3) as BalanceQty,
                      xxx.DocumentStatusCode,
                      xxx.DocStatus,
                      xxx.FreightTypeCode,
                      xxx.GRNStatus,
                      xxx.POStatus,
                      xxx.Creator,
                      xxx.CreationTime,
                      'Attachment' as Attachment,
                      xxx.Description,
                      xxx.WarrantyDescription,
                      xxx.MaterialInStatus,
                      round(xxx.MaterialInQty, 3) as MaterialInQty
                From (
                Select
                      xx.TNo,
                      xx.SNo,
                      xx.LocationName,
                      xx.DocTypeName,
                      xx.PurchaseOrderNo,
                      xx.PurchaseOrderDate,
                      xx.PartyName,
                      xx.DeliveryDate,
                      xx.ItemCode,
                      xx.MaterialDetail,
                      xx.UOM,
                      xx.Quantity1,
                      xx.UOM2,
                      xx.Quantity2,
                      xx.AgentName,
                      XX.WITHOUTDISCOUNTRATE,
                      XX.DISCOUNTRATE,
                      xx.Rate,
                      xx.Amount,
                      sum(xx.CGST)CGST,
                      sum(xx.SGST)SGST,
                      sum(xx.IGST)IGST,
                      sum(xx.TCS)TCS,
                      xx.FooterAmount,
                      xx.TotalAmount,
                      xx.GRNReceivedQty,
                      xx.GRNReceivedQty2,
                      xx.WBAcceptedWeight,
                      xx.WBNetWeight,
                      xx.balanceQty,
                      xx.DocumentStatusCode,
                      xx.DocStatus,
                      xx.FreightTypeCode,
                      xx.GRNStatus,
                      xx.POStatus,
                      xx.Creator,
                      xx.CreationTime,
                      xx.Description,
                      xx.WarrantyDescription,
                      xx.MaterialInStatus,
                      xx.MaterialInQty
                From (
                Select
                      a.TNo,
                      b.SNo,
                      l.LocationName,
                      d.DocTypeName,
                      a.PurchaseOrderNo,
                      a.PurchaseOrderDate,
                      p.PartyCode,
                      p.PartyName,
                      a.DeliveryDate,
                      e.ItemCode,
                      e.ItemName,
                      ee.ItemSpecificationName,
                      e.ItemName||' ( '||ee.ItemSpecificationName||' )' as MaterialDetail,
                      mu.MeasuringUnitName as UOM,
                      b.Quantity1,
                      e.MeasuringUnitCode2 as UOM2,
                      b.Quantity2,
                      GetPartyName(a.AgentCode) AgentName,
                      B.WITHOUTDISCOUNTRATE,
                      B.DISCOUNTRATE,
                      B.Rate,
                      b.Amount,
                      Nvl(Decode(c.FooterHeadCode,'.CGST.',c.FooterValue),0) as CGST,
                      Nvl(Decode(c.FooterHeadCode,'.SGST.',c.FooterValue),0) as SGST,
                      Nvl(Decode(c.FooterHeadCode,'.IGST.',c.FooterValue),0) as IGST,
                      Nvl(Decode(c.FooterHeadCode,'.TCS.',c.FooterValue),0) as TCS,
                      b.FooterAmount,
                      b.TotalAmount,
                      g.GRNReceivedQuantity1 as GRNReceivedQty,
                      g.GRNReceivedQuantity2 as GRNReceivedQty2,
                      g.WBAcceptedWeight as WBAcceptedWeight,
                      g.WBNetWeight as WBNetWeight,
                      b.Quantity1 - NVL(g.GRNReceivedQuantity1,0) as balanceQty,
                      dsd.DocumentStatusCode,
                      case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                           When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When dsd.DocumentStatusCode = 'APPROVAL' Then 'APPROVAL'
                           When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                           When dsd.DocumentStatusCode = 'AUDITED' Then 'AUDITED'
                           When dsd.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End as DocStatus,
                      ft.FreightTypeName as FreightTypeCode,
                      Case When g.GRNReceivedQuantity1 >= b.quantity1 - (b.quantity1 * b.lowertolerancepercent) / 100 Then 'DONE'--  g.GRNReceivedQuantity1 Then 'DONE'
                           --When b.Quantity1 > g.GRNReceivedQuantity1 Then 'PARTIAL'
                	       When g.GRNReceivedQuantity1 is null or  b.Quantity1 > g.GRNReceivedQuantity1 Then 'PENDING'
                      End as GRNStatus,
                      nvl(decode(poc.PurchaseOrderTno,a.TNo,'SHORT-CLOSE'),'OPEN') as POStatus,
                      'Attachment' as Attachment,
                      'Details' as Property,
                      'PURCHASEORDER' as Module,
                      bue.EmployeeName||'( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      b.Description,
                      b.WarrantyDescription,
                      h.MaterialInStatus,
                      h.MaterialInQty
                From  PurchaseOrder a, PurchaseOrderDetail b, PurchaseOrderDetailFooter c, Location l, DocType d, Party p,  Item e, ItemSpecification ee, MeasuringUnit mu, BossUser bu, Employee bue,
                      (Select
                            b.ItemCode,
                            b.ItemSpecificationCode,
                            a.PurchaseOrderTNo,
                            sum(b.ReceivedQuantity1) as GRNReceivedQuantity1,
                            sum(b.ReceivedQuantity2) as GRNReceivedQuantity2,
                            sum(w.AcceptedWeight) as WBAcceptedWeight,
                            sum(w.NetWeight) as WBNetWeight
                      From  GRN a, GRNDetail b, Weighment w
                      Where a.TNo = b.TNo
                        and a.PurchaseOrderTNo is not null
                        and a.WeighmentTNo = w.TNo(+)
                      Group By b.ItemCode,
                            b.ItemSpecificationCode,
                            a.PurchaseOrderTNo
                      ) g, 
                      (
                       Select 
                            aa.tno,
                            sum(b.Quantity1) as MaterialInQty,
                            Case When Max(b.Tno) is not null then 'PREPARED'
                            When Max(b.Tno) is null then 'PENDING'
                            End as MaterialInStatus
                        From PurchaseOrderDetail aa, MaterialInDetail b
                        Where aa.Tno = b.PurchaseOrderTno(+)
                            and aa.ItemCode = b.ItemCode(+)
                            and aa.ItemSpecificationCode = b.ItemSpecificationCode(+)
                        Group By aa.tno
                         )h, DocumentStatusDetail dsd, PurchaseOrderClose poc, FreightType ft
                Where a.TNo = b.TNo(+)
                  and b.TNo = c.TNo(+)
                  and b.SNo = c.SNo(+)
                  and a.LocationCode = l.LocationCode(+)
                  and a.DocTypeCode = d.DocTypeCode(+)
                  and a.PartyCode = p.PartyCode(+)
                  and e.TNo = ee.TNo
                  and b.ItemCode = e.ItemCode(+)
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and e.MeasuringUnitCode1 = mu.MeasuringUnitCode(+)
                  and e.ItemClassificationCode = 'MATERIAL'
                  and b.TNo = g.PurchaseOrderTNo(+)
                  and b.ItemCode = g.ItemCode(+)
                  and b.ItemSpecificationCode = g.ItemSpecificationCode(+)
                  and b.Tno = h.Tno(+)
                  and a.TNo = dsd.ModuleTno(+)
                  and a.TNo = poc.PurchaseOrderTNo(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)	
                  and a.FreightTypeCode = ft.FreightTypeCode(+)
                  and (:P529_TODOLIST = 'YES' OR :P529_NEXTPROCESS = 'YES' OR (a.PurchaseOrderDate between NVL(:P529_FROMDATE,ADD_MONTHS(TRUNC(SYSDATE),-6)) and NVL(:P529_TODATE,TRUNC(SYSDATE)) ))
                  and (:P529_TODOLIST = 'YES' OR :P529_NEXTPROCESS = 'YES' OR (:P529_COMPANY IS NULL OR instr(':'||:P529_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  and (:P529_TODOLIST = 'YES' OR :P529_NEXTPROCESS = 'YES' OR (:P529_LOCATION IS NULL OR instr(':'||:P529_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and (:P529_TODOLIST = 'YES' OR :P529_NEXTPROCESS = 'YES' OR (:P529_DOCTYPE IS NULL OR instr(':'||:P529_DOCTYPE||':',':'||a.DocTypeCode||':') > 0))
                  and ( :P529_PARTYNAME IS NULL OR instr(':'||:P529_PARTYNAME||':',':'||a.PartyCode||':') > 0 ) 
                  and ( :P529_ITEM IS NULL OR instr(':'||:P529_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P529_ITEMSPECIFICATION IS NULL OR instr(':'||:P529_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                  and nvl(decode(poc.PurchaseOrderTno,a.TNo,'SHORT-CLOSE'),'OPEN') like nvl(:P529_POSTATUS,'%')
                 /*Case When g.GRNReceivedQuantity1 >= b.quantity1 - (b.quantity1 * b.lowertolerancepercent) / 100 Then 'DONE'--  g.GRNReceivedQuantity1 Then 'DONE'
                           --When b.Quantity1 > g.GRNReceivedQuantity1 Then 'PARTIAL'
                	       When g.GRNReceivedQuantity1 is null or  b.Quantity1 > g.GRNReceivedQuantity1 Then 'PENDING'
                      End like nvl(:P529_GRNSTATUS,'%')
                */
                /*  and Case When b.Quantity1 <= g.GRNReceivedQuantity1 Then 'DONE'
                           When b.Quantity1 > g.GRNReceivedQuantity1 Then 'PARTIAL'
                	       When g.GRNReceivedQuantity1 is null Then 'PENDING'
                      End like nvl(:P529_GRNSTATUS,'%')
                */
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                           When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When dsd.DocumentStatusCode = 'APPROVAL' Then 'APPROVAL'
                           When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                           When dsd.DocumentStatusCode = 'AUDITED' Then 'AUDITED'
                           When dsd.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End  like nvl(:P529_STATUS,'%')
                  and a.PurchaseOrderNo like nvl(:P529_PONO,'%')
                  )xx
                  where xx.GRNSTATUS like nvl(:P529_GRNSTATUS,'%')
                    
                Group By 
                        xx.TNo,
                      xx.SNo,
                      xx.LocationName,
                      xx.DocTypeName,
                      xx.PurchaseOrderNo,
                      xx.PurchaseOrderDate,
                      xx.PartyName,
                      xx.DeliveryDate,
                      xx.ItemCode,
                      xx.MaterialDetail,
                      xx.UOM,
                      xx.Quantity1,
                      xx.UOM2,
                      xx.Quantity2,
                      xx.AgentName,
                      XX.WITHOUTDISCOUNTRATE,
                      XX.DISCOUNTRATE,
                      xx.Rate,
                      xx.Amount,
                      xx.FooterAmount,
                      xx.TotalAmount,
                      xx.GRNReceivedQty,
                      xx.GRNReceivedQty2,
                      xx.WBAcceptedWeight,
                      xx.WBNetWeight,
                      xx.balanceQty,
                      xx.DocumentStatusCode,
                      xx.DocStatus,
                      xx.FreightTypeCode,
                      xx.GRNStatus,
                      xx.POStatus,
                      xx.Creator,
                      xx.CreationTime,
                      xx.Description,
                      xx.WarrantyDescription,
                      xx.MaterialInStatus,
                      xx.MaterialInQty
                )xxx
                where (:P529_TODOLIST='NO' OR  (:P529_TODOLIST='YES' AND EXISTS ( SELECT 1 FROM ONTHETABLE_APEX YY WHERE YY.TNO=XXX.TNO) ))
                AND ( :P529_NEXTPROCESS='NO' OR (:P529_NEXTPROCESS = 'YES' AND (  getdocumentstatuscode('PURCHASEORDER',XXX.TNO)='ACTIVE'
                                                    AND  NOT EXISTS (Select 1 From MaterialIn AA Where AA.Purchaseordertno = XXX.TNO)
                                                ))
                                                
                 )
                 and ( nvl(:P529_REMAININGDELIVERYDAYS,0) = 0 or XXX.DELIVERYDATE - TRUNC(SYSDATE) <= nvl(:P529_REMAININGDELIVERYDAYS,0) )
                 and xxx.MaterialInStatus like nvl(:P529_MATERIALSTATUS,'%')
                ```
        }
