    region general (
        name: General
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select COMPANYCODE,
                       COMPANYNAME,
                       COMPANYTYPECODE,
                       PARENTCODE,
                       OWNERNAME,
                       CGSTNO,
                       CSTNO,
                       NEWREGISTRATIONNO,
                       TINNO,
                       ECCNO,
                       COMMISSIONER,
                       DIVISION,
                       RANGE,
                       OFFICEADDRESS,
                       OFFICECITYCODE,
                       OFFICESTATECODE,
                       OFFICEPINCODE,
                       OFFICEPHONENO,
                       OFFICEFAXNO,
                       OFFICEEMAIL,
                       WORKSADDRESS,
                       WORKSCITYCODE,
                       WORKSSTATECODE,
                       WORKSPINCODE,
                       WORKSPHONENO,
                       WORKSFAXNO,
                       WORKSEMAIL,
                       REMARK,
                       COMPANYSHORTNAME,
                       TNO,
                       SELFCODE,
                       OFFICEADDRESS1,
                       OFFICEADDRESS2,
                       OFFICEADDRESS3,
                       OFFICEADDRESS4,
                       WORKSADDRESS4,
                       WORKSADDRESS3,
                       WORKSADDRESS2,
                       WORKSADDRESS1,
                       CREATOR,
                     --  TMP,
                       CREATIONTIME,
                       EMPLOYEECODERESPONSIBLEFORTDS,
                       NAMERESPONSIBLEFORTDS,
                       DESIGNATIONRESPONSIBLEFORTDS,
                       ADDRESS1RESPONSIBLEFORTDS,
                       ADDRESS2RESPONSIBLEFORTDS,
                       ADDRESS3RESPONSIBLEFORTDS,
                       ADDRESS4RESPONSIBLEFORTDS,
                       CITYRESPONSIBLEFORTDS,
                       STATERESPONSIBLEFORTDS,
                       PINCODERESPONSIBLEFORTDS,
                       PHONENORESPONSIBLEFORTDS,
                       EMAILRESPONSIBLEFORTDS,
                       TAXREGISTRATIONTYPECODE,
                    --   PRINTNAME ,
                       NVL(getdocumentstatuscode('COMPANY',TNO),'STATUS') AS Status
                  from COMPANY
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
                t-Form--stretchInputs
