                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Attributes
        }

        savedReport 394812 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMPANYATTRIBUTECODE (
