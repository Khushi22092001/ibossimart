    dynamicAction attribute-refresh (
        name: attribute refresh
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @attributes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attributes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }
        serverSideCondition {
            type: never
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction city-select (
        name: CITY SELECT
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P546_OFFICECITYCODE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT STATECODE FROM CITY WHERE CITYCODE = :P546_OFFICECITYCODE
                itemsToSubmit: [
                    P546_OFFICECITYCODE
                    P546_OFFICESTATECODE
                ]
            }
            affectedElements {
                selectionType: items
                items: P546_OFFICESTATECODE
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 120
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P546_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
        execution {
            sequence: 150
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @print
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.PRINTPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-enable (
            action: enable
