    button addnew (
        buttonName: ADDNEW
        label: Add New
        layout {
            sequence: 30
            region: @attributes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                items: {
                    P5_TNO: &P546_TNO.
                }
                clearCache: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

