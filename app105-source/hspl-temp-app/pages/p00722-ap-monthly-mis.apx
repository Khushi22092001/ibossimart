page 722 (
    name: Monthly AP Management MIS
    alias: AP-MONTHLY-MIS
    title: Monthly AP Management MIS
    pageGroup: @payables-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: The management pack, in nine sections: Executive Summary, Ageing, Payments, Creditor Exposure, Advances, Risk, Reconciliation, Exceptions and Management Actions. Every line states its own basis, and lines whose data does not exist in this ERP say so rather than reading zero - credit limit and credit utilisation in particular, which cannot be computed because Party.CreditAmount is greater than zero on 0 of 954 creditor accounts. Positions are measured at the To Date, flows across the From-To window, and the Reconciliation section proves the pack against the general-ledger control account rather than asserting it.
    }

    region by-company (
        name: Position by Company and Location
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Sd As (
                       Select PartyCode From Party
                        Start With PartyCode = 'SUNDRYCREDITORS'
                        Connect By Prior PartyCode = ParentCode),
                     Asof As (Select to_date(:P722_TODATE,'DD-MM-RRRR') D From dual),
                     Alc As (
                       Select a.DrVoucherTno Tno, a.DrVoucherSno Sno, -Sum(a.Amount) Amt
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                        Group By a.DrVoucherTno, a.DrVoucherSno
                       Union All
                       Select a.CrVoucherTno, a.CrVoucherSno, Sum(a.Amount)
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                        Group By a.CrVoucherTno, a.CrVoucherSno),
                     Al As (Select Tno, Sno, Sum(Amt) Amt From Alc Group By Tno, Sno)
                Select apex_escape.html(nvl(c.CompanyName, d.CompanyCode))   As COMPANY,
                       apex_escape.html(nvl(l.LocationName, d.LocationCode)) As LOCATION,
                       Round(Sum(Case When -(d.Amount-nvl(al.Amt,0))>0
                                      Then -(d.Amount-nvl(al.Amt,0)) Else 0 End),2) As GROSS,
                       Round(Sum(Case When -(d.Amount-nvl(al.Amt,0))<0
                                      Then  (d.Amount-nvl(al.Amt,0)) Else 0 End),2) As CREDIT_HELD,
                       Round(Sum(-(d.Amount-nvl(al.Amt,0))),2)                      As NET_EXPOSURE,
                       Round(Sum(-d.Amount),2)                                      As GL_CONTROL,
                       Round(Sum(-(d.Amount-nvl(al.Amt,0))) - Sum(-d.Amount),2)     As DIFFERENCE
                  From VoucherDetail d
                  Left Join Al al On al.Tno = d.Tno And al.Sno = d.Sno
                  Left Join Company c On c.CompanyCode = d.CompanyCode
                  Left Join Location l On l.LocationCode = d.LocationCode
                  Cross Join Asof
                 Where d.AccountCode In (Select PartyCode From Sd)
                   And d.VoucherDate <= Asof.D
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P722_PANEL    Is Null Or d.Panel        = :P722_PANEL)
                   And (:P722_COMPANY  Is Null Or d.CompanyCode  = :P722_COMPANY)
                   And (:P722_LOCATION Is Null Or d.LocationCode = :P722_LOCATION)
                 Group By d.CompanyCode, c.CompanyName, d.LocationCode, l.LocationName
                 Order By 1, 2
                ```
            pageItemsToSubmit: [
                P722_TODATE
                P722_COMPANY
                P722_LOCATION
                P722_PANEL
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No payable position in this scope.
        }

        column COMPANY (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Company
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column CREDIT_HELD (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Credit Held (₹)
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column DIFFERENCE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Difference (₹)
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
        )

        column GL_CONTROL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: GL Control (₹)
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

        column GROSS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Gross (₹)
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column LOCATION (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Location
            }
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
        )

        column NET_EXPOSURE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Net Exposure (₹)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

    )

    region command-header (
        name: Monthly AP Management MIS
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-ap-head">'
                    || '<div class="ds-ap-eyebrow">Payables &middot; Monthly Management MIS</div>'
                    || '<h1 class="ds-ap-title">Monthly AP Management MIS</h1>'
                    || '<div class="ds-ap-sub">Nine sections, every line carrying its own basis, reconciled to the general ledger at the foot</div>'
                    || '<div class="ds-ap-context">'
                    || '<span class="ds-ap-chip"><span class="fa fa-calendar"></span>Period <b>'
                       || :P722_FROMDATE || ' &rarr; ' || :P722_TODATE || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-crosshairs"></span>Positions as at <b>' || :P722_TODATE || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P722_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P722_LOCATION),'All locations')) || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                               Then (Select GetUserPanelAB_apex() From dual) || ' (enforced)'
                               When :P722_PANEL Is Not Null Then :P722_PANEL Else 'A + B' End || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
            pageItemsToSubmit: [
                P722_FROMDATE
                P722_TODATE
                P722_COMPANY
                P722_LOCATION
                P722_PANEL
            ]
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-ap-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

