    region top-overdue (
        name: Largest Overdue Positions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Capped at 20 and the cap is stated in the heading - a silently
                   truncated "top" list reads as a complete one. */
                With Sd As (
                       Select PartyCode From Party
                        Start With PartyCode = 'SUNDRYDEBTORS'
                        Connect By Prior PartyCode = ParentCode),
                     D As (Select to_date(:P700_DAY,'DD-MM-RRRR') Dy From dual),
                     Alc As (
                       Select a.DrVoucherTno Tno, a.DrVoucherSno Sno, -Sum(a.Amount) Amt
                         From DrCrAllocation a, Voucher dv, Voucher cv, D dd
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= dd.Dy And cv.VoucherDate <= dd.Dy
                        Group By a.DrVoucherTno, a.DrVoucherSno
                       Union All
                       Select a.CrVoucherTno, a.CrVoucherSno, Sum(a.Amount)
                         From DrCrAllocation a, Voucher dv, Voucher cv, D dd
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= dd.Dy And cv.VoucherDate <= dd.Dy
                        Group By a.CrVoucherTno, a.CrVoucherSno),
                     Al As (Select Tno, Sno, Sum(Amt) Amt From Alc Group By Tno, Sno),
                     G As (
                       Select d.AccountCode Pty,
                              Sum(Case When -(d.Amount - nvl(al.Amt,0)) > 0
                                        And coalesce(i.DueDate, sb.DueDate, ao.BillDueDate) < (Select Dy From D)
                                       Then -(d.Amount - nvl(al.Amt,0)) Else 0 End) Overdue,
                              Sum(Case When -(d.Amount - nvl(al.Amt,0)) > 0
                                       Then -(d.Amount - nvl(al.Amt,0)) Else 0 End) Gross,
                              Sum(Case When -(d.Amount - nvl(al.Amt,0)) < 0
                                       Then  (d.Amount - nvl(al.Amt,0)) Else 0 End) Credit
                         From VoucherDetail d
                         Join Voucher v On v.Tno = d.Tno
                         Left Join Al al On al.Tno = d.Tno And al.Sno = d.Sno
                         Left Join Invoice     i  On v.ModuleCode = 'INVOICE'     And i.Tno  = v.ModuleTno
                         Left Join ServiceBill sb On v.ModuleCode = 'SERVICEBILL' And sb.Tno = v.ModuleTno
                         Left Join AccountOpening ao On v.VoucherNo = 'OPENING'   And ao.Tno = d.ModuleTno
                         Cross Join D dd
                        Where d.AccountCode In (Select PartyCode From Sd)
                          And d.VoucherDate <= dd.Dy
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (:P700_PANEL    Is Null Or d.Panel        = :P700_PANEL)
                          And (:P700_COMPANY  Is Null Or d.CompanyCode  = :P700_COMPANY)
                          And (:P700_LOCATION Is Null Or d.LocationCode = :P700_LOCATION)
                        Group By d.AccountCode)
                Select * From (
                  Select apex_escape.html(nvl(p.PartyName, g.Pty)) As CUSTOMER,
                         g.Pty                                     As PARTY_CODE,
                         Round(g.Overdue,2)                        As OVERDUE,
                         Round(g.Gross,2)                          As GROSS,
                         Round(g.Credit,2)                         As CREDIT_HELD,
                         Round(Least(g.Gross, g.Credit),2)         As ADJUSTABLE_NOW
                    From G g Left Join Party p On p.PartyCode = g.Pty
                   Where g.Overdue > 0.005
                   Order By g.Overdue Desc)
                 Where rownum <= 20
                ```
            pageItemsToSubmit: [
                P700_DAY
                P700_COMPANY
                P700_LOCATION
                P700_PANEL
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No customer is overdue as at this day, on the due-date basis.
        }

        column ADJUSTABLE_NOW (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Adjustable Now (₹)
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
        )

        column CREDIT_HELD (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Credit Held (₹)
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

        column CUSTOMER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Customer (top 20 by overdue)
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column GROSS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Gross Receivable (₹)
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column OVERDUE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Overdue (₹)
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column PARTY_CODE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
        )

    )

    pageItem P700_COMPANY (
        type: selectList
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.CompanyCode = c.CompanyCode
                                  And v.AccountCode In (Select PartyCode From Party
                                        Start With PartyCode = 'SUNDRYDEBTORS' Connect By Prior PartyCode = ParentCode))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P700_DAY (
        type: datePicker
        label {
            label: Report Day
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: Select to_char(trunc(sysdate),'DD-MM-RRRR') From dual
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P700_LOCATION (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.LocationCode = l.LocationCode
                                  And v.AccountCode In (Select PartyCode From Party
                                        Start With PartyCode = 'SUNDRYDEBTORS' Connect By Prior PartyCode = ParentCode)
                                  And (:P700_COMPANY Is Null Or v.CompanyCode = :P700_COMPANY))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P700_COMPANY
            itemsToSubmit: P700_COMPANY
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P700_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            displayExtraValues: false
            nullDisplayValue: A + B
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
    )

    button back (
        buttonName: BACK
        label: Command Centre
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 690
                items: {
                    P690_TODATE: &P700_DAY.
                    P690_COMPANY: &P700_COMPANY.
                    P690_LOCATION: &P700_LOCATION.
                    P690_PANEL: &P700_PANEL.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

