    region command-header (
        name: Daily Collection MIS
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-ar-head">'
                    || '<div class="ds-ar-eyebrow">Receivables &middot; Daily MIS</div>'
                    || '<h1 class="ds-ar-title">Daily Collection MIS</h1>'
                    || '<div class="ds-ar-sub">Opening, movement and closing receivables for a single day, with the collection detail behind it</div>'
                    || '<div class="ds-ar-context">'
                    || '<span class="ds-ar-chip"><span class="fa fa-calendar-o"></span>Report day <b>' || :P700_DAY || '</b></span>'
                    || '<span class="ds-ar-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P700_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-ar-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P700_LOCATION),'All locations')) || '</b></span>'
                    || '<span class="ds-ar-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                               Then (Select GetUserPanelAB_apex() From dual) || ' (enforced)'
                               When :P700_PANEL Is Not Null Then :P700_PANEL Else 'A + B' End || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
