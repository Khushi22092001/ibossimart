page 473 (
    name: Creditors Subsequent  Payment
    alias: CREDITORS-SUBSEQUENT-PAYMENT
    title: Creditors Subsequent  Payment
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region creditors-subsequence-payment (
        name: Creditors Subsequence  Payment
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                rownum as SNO,
                a.CompanyCode,
                c.CompanyName,
                a.FinancialYearCode,
                a.AccountCode,
                b.PartyName,
                e.PartyName as ParentGroup,
                ROUND(a.OpeningAmount,0) AS OpeningAmount,
                a.AprDebitAmount,
                a.MayDebitAmount,
                a.JunDebitAmount,
                a.JulDebitAmount,
                a.AugDebitAmount,
                a.SepDebitAmount,
                a.OctDebitAmount,
                a.NovDebitAmount,
                a.DecDebitAmount,
                a.JanDebitAmount,
                a.FebDebitAmount,
                a.MarDebitAmount,
                a.Balance
                from SubsequentDebit a , Party b, Company c, FinancialYear d, Party e 
                where a.Accountcode = b.PartyCode 
                    and a.CompanyCode = c.CompanyCode
                    and a.FinancialYearCode = d.FinancialYearCode
                    and b.ParentCode = e.PartyCode
                    and a.AccountCode in (
                        select 
                            aa.PartyCode
                        from Party aa 
                        start with aa.PartyCode = NVL(:P473_ACCOUNTGROUPS,'SUNDRYCREDITORS')
                        connect by prior aa.PartyCode = aa.ParentCode
                    )
                    and :P473_COMPANY = a.CompanyCode
                     and :P473_FINANCIALYEAR = a.FinancialYearCode  
                    --  and ( :P473_ACCOUNTGROUP IS NULL OR INSTR(':'||:P473_ACCOUNTGROUP||':',':'||e.PartyCode||':') > 0 )
                
                ```
            pageItemsToSubmit: [
                P473_FINANCIALYEAR
                P473_COMPANY
                P473_ACCOUNTGROUPS
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            savePublicReport: true
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 34691886574405302
        }

