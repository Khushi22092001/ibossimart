page 466 (
    name: Mines Wise Daily Detail
    alias: MINES-WISE-DAILY-DETAIL
    title: Mines Wise Daily Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        formAutoComplete: false
    }

    region mines-wise-daily-detail (
        name: Mines Wise Daily Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by a.LRDATE) SerialNo,
                   b.LocationName,
                   c.SourceLocationName,
                   d.DestinationLocationName,
                   a.LRNo,
                   a.LRDate,
                   a.VehicleNo,
                   a.PartyRefNo,
                   a.GPNo,
                   a.Quantity1 as Qty,
                   e.TransporterName
                From LR a, Location b, SourceLocation c, DestinationLocation d, Transporter e
                Where a.LocationCode = b.LocationCode(+)
                  and a.SourceLocationTno = c.Tno(+)
                  and a.DestinationLocationTno = d.Tno(+)
                  and a.TransporterCode = e.TransporterCode(+)
                  and a.VehicleGroupCode = 'SELF'
                  and (:P466_COMPANY is Null Or Instr (':' || :P466_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                  and a.LRDATE Between :P466_FROMDATE and :P466_TODATE 
                  and (:P466_LOCATION is Null Or Instr (':' || :P466_LOCATION || ':' , ':' || b.LocationCode || ':') > 0)
                  And  (:P466_SOURCE is Null Or Instr (':' || :P466_SOURCE || ':' , ':' ||c.SourceLocationCode|| ':') > 0)
                  And  (:P466_DESTINATION is Null Or Instr (':' || :P466_DESTINATION || ':' , ':' ||d.DestinationLocationCode|| ':') > 0) 
                
                UNION ALL
                
                Select
                   row_number() over(order by a.InternalTransferDate) SerialNo,
                   b.LocationName,
                   c.SourceLocationName,
                   d.DestinationLocationName,
                   a.InternalTransferNo,
                   a.InternalTransferDate,
                   a.VehicleNo,
                   g.PartyDONo as PartyRefNo,
                   a.GPNo,
                   a.LoadingQuantity1 as Qty,
                   e.TransporterName
                From InternalTransfer a, Location b, SourceLocation c, DestinationLocation d, Transporter e, DeliveryOrderDetail f, DeliveryOrder g
                Where a.LocationCode = b.LocationCode(+)
                  and a.SourceLocationTno = c.Tno(+)
                  and a.DestinationLocationTno = d.Tno(+)
                  and a.TransporterCode = e.TransporterCode(+)
                  and a.DeliveryOrderTno = f.Tno(+)
                  and a.DeliveryOrderSno = f.Sno(+)
                  and f.Tno = g.Tno(+)
                  and a.VehicleGroupCode = 'SELF'
                  and (:P466_COMPANY is Null Or Instr (':' || :P466_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                  and a.InternalTransferDate Between :P466_FROMDATE and :P466_TODATE 
                  and (:P466_LOCATION is Null Or Instr (':' || :P466_LOCATION || ':' , ':' || b.LocationCode || ':') > 0)
                  And  (:P466_SOURCE is Null Or Instr (':' || :P466_SOURCE || ':' , ':' ||c.SourceLocationCode|| ':') > 0)
                  And  (:P466_DESTINATION is Null Or Instr (':' || :P466_DESTINATION || ':' , ':' ||d.DestinationLocationCode|| ':') > 0) 
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
