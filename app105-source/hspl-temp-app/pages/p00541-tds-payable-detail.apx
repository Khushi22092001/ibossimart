page 541 (
    name: "TDS Payable Detail "
    alias: TDS-PAYABLE-DETAIL
    title: "TDS Payable Detail "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    row_number() over(order by B.VOUCHERDATE) SerialNo,
                    CO.COMPANYNAME,
                    B.LOCATIONCODE,
                    B.DOCTYPECODE,
                    B.MODULECODE,
                    A.PARTYCODE,
                    B.VOUCHERNO,
                    B.VOUCHERDATE,
                    NULL AS ITEMNATUREONWHICHTDSDEDECTABLE,
                    A.TDSPAYEECATEGORYCODE,
                    NULL AS TDSDEDUCTABLERATE,
                    F.TAXSECTIONCODE,
                    GETPARTYNAME(A.PARTYCODE) AS PARTY,
                    A.PANNO,
                    DECODE(H.ISCOMPANY, 'YES', 'COMPANY', NULL) ISCOMPANY,
                    F.TDSNATURENAME,
                    ROUND(A.TDSDEDUCTEDON,2) AS BASICAMOUNT,
                    A.TDSPERCENT,
                    A.TDSAMOUNT,
                    A.CESSPERCENT,
                    A.CESSAMOUNT,
                    A.SURCHARGEPERCENT,
                    A.SURCHARGEAMOUNT,
                    CHLN.CHALLANNO AS CHALLANNO,
                    CHLN.CHALLANDATE AS CHALLANDATE,
                    CHLN.BSRCODE AS CHALLANBSRCODE,
                    CHLN.CHALLANAMOUNT AS CHALLANAMOUNT,
                    CASE
                      WHEN C.JBPASSNO IS NOT NULL THEN
                       'JBPASS' END TRANSACTIONMODULE,
                    CASE
                      WHEN C.JBPASSNO IS NOT NULL THEN
                       C.JBPASSNO END TRANSACTIONNO,
                    CASE
                      WHEN C.JBPASSNO IS NOT NULL THEN
                       C.JBPASSDATE END TRANSACTIONDATE,
                    CASE
                      WHEN C.JOBBILLTNO IS NOT NULL THEN
                       C1.PARTYBILLNO END PARTYBILLNO,
                        CASE
                      WHEN C.JOBBILLTNO IS NOT NULL THEN
                       C1.PARTYBILLDATE END PARTYBILLDATE,
                    C.JBPASSNO AS MODULENO
                  FROM VOUCHERTDSDEDUCTED    A,
                       VOUCHER               B,
                       VOUCHER               CC,
                       JBPASS                C,
                       JOBBILL               C1,
                       TDSNATURE             F,
                       TDSTAXCATEGORY        G,
                       PARTY                 H,
                       COMPANY               CO,
                       (SELECT A.CHALLANNO,
                               A.CHALLANDATE,
                               E.BSRCODE,
                               D.MODULETNO,
                               A.CHALLANAMOUNT
                          FROM CHALLAN                  A,
                               TDSCHALLAN               C,
                               TDSCHALLANDEDUCTEEDETAIL D,
                               BANK                     E
                         WHERE  A.DOCTYPECODE = 'TDSCHALLAN'
                           AND A.MODULETNO = C.TNO
                           AND C.TNO = D.TNO
                           AND A.TAXSECTIONCODE = D.TAXSECTIONCODE
                           AND A.DEPOSITEDINBANKCODE = E.BANKCODE
                       ) CHLN,
                       (
                          Select
                                a.Tno
                         From Voucher a
                         Where exists(
                                     Select
                                        aa.Tno
                                     From VoucherDetail aa, TDSNature bb
                                     Where aa.AccountCode = bb.TDSAccountCode
                                       and aa.Tno = a.Tno
                                     )) x
                 WHERE A.TNO = B.TNO(+)
                 AND B.MODULETNO = CC.TNO
                   AND CC.MODULETNO = C.TNO
                   AND C.JOBBILLTNO = C1.TNO
                   AND A.TDSNATURECODE = F.TDSNATURECODE(+)
                   AND A.TDSTAXCATEGORYCODE = G.TDSTAXCATEGORYCODE(+)
                   AND A.PARTYCODE = H.PARTYCODE(+)
                   AND B.COMPANYCODE = CO.COMPANYCODE(+)
                   AND B.MODULETNO = CHLN.MODULETNO(+)
                   AND A.TNO = X.TNO
                      and ( :P541_COMPANY IS NULL OR instr(':'||:P541_COMPANY||':',':'||CO.CompanyCode||':') > 0 )
                 --  And TO_DATE(TO_CHAR(b.VoucherDate,'DD-MM-RRRR')) between LAST_DAY(TO_DATE('01-' || NVL(:P541_FROMDATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))) and TO_DATE('01-' || NVL(:P541_TODATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))
                 --  and B.ModuleCode like nvl(:P541_MODULECODE,'%')
                 --  and TO_CHAR(b.VoucherDate,'MON-RR') = TO_CHAR(:P541_MONTH,'MON-RR')
                 --  and To_Char(b.VoucherDate, 'MON-RR')   = :P541_MONTH
                   and TO_CHAR(TO_DATE(b.VoucherDate),('MON-RRRR')) = :P541_MONTH
                   --and b.voucherdate between :P541_FROMDATE AND :P541_TODATE
                   and ( :P541_SECTION IS NULL OR instr(':'||:P541_SECTION||':',':'||F.TAXSECTIONCODE||':') > 0 )
                  -- and ( :P541_TDSNATURE IS NULL OR instr(':'||:P541_TDSNATURE||':',':'||F.TDSNATURECODE||':') > 0 )
                   and ( :P541_PARTY IS NULL OR instr(':'||:P541_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                   and :P541_MONTH is not null
                   
                   UNION ALL
                   
                   SELECT 
                    row_number() over(order by B.VOUCHERDATE) SerialNo,
                    CO.COMPANYNAME,
                    B.LOCATIONCODE,
                    B.DOCTYPECODE,
                    B.MODULECODE,
                    A.PARTYCODE,
                    B.VOUCHERNO,
                    B.VOUCHERDATE,
                    NULL AS ITEMNATUREONWHICHTDSDEDECTABLE,
                    A.TDSPAYEECATEGORYCODE,
                    NULL AS TDSDEDUCTABLERATE,
                    F.TAXSECTIONCODE,
                    GETPARTYNAME(A.PARTYCODE) AS PARTY,
                    A.PANNO,
                    DECODE(H.ISCOMPANY, 'YES', 'COMPANY', NULL) ISCOMPANY,
                    F.TDSNATURENAME,
                    ROUND(A.TDSDEDUCTEDON,2) AS BASICAMOUNT,
                    A.TDSPERCENT,
                    A.TDSAMOUNT,
                    A.CESSPERCENT,
                    A.CESSAMOUNT,
                    A.SURCHARGEPERCENT,
                    A.SURCHARGEAMOUNT,
                    CHLN.CHALLANNO AS CHALLANNO,
                    CHLN.CHALLANDATE AS CHALLANDATE,
                    CHLN.BSRCODE AS CHALLANBSRCODE,
                    CHLN.CHALLANAMOUNT AS CHALLANAMOUNT,
                    CASE
                      WHEN C2.PBPASSNO IS NOT NULL THEN
                       'PBPASS'
                    END TRANSACTIONMODULE,
                    CASE
                       WHEN C2.PBPASSNO IS NOT NULL THEN
                       C2.PBPASSNO
                    END TRANSACTIONNO,
                    CASE
                      WHEN C2.PBPASSNO IS NOT NULL THEN
                       C2.PBPASSDATE
                    END TRANSACTIONDATE,
                    CASE
                      WHEN C2.PURCHASEBILLTNO IS NOT NULL THEN
                       C3.PARTYBILLNO
                    END PARTYBILLNO,
                        CASE
                      WHEN C2.PURCHASEBILLTNO IS NOT NULL THEN
                       C3.PARTYBILLDATE END PARTYBILLDATE,
                    C2.PBPASSNO AS MODULENO
                  FROM VOUCHERTDSDEDUCTED    A,
                       VOUCHER               B,
                       VOUCHER               CC,
                       PBPASS                C2,
                       PURCHASEBILL          C3,
                       TDSNATURE             F,
                       TDSTAXCATEGORY        G,
                       PARTY                 H,
                       COMPANY               CO,
                       (SELECT A.CHALLANNO,
                               A.CHALLANDATE,
                               E.BSRCODE,
                               D.MODULETNO,
                               A.CHALLANAMOUNT
                          FROM CHALLAN                  A,
                               TDSCHALLAN               C,
                               TDSCHALLANDEDUCTEEDETAIL D,
                               BANK                     E
                         WHERE  A.DOCTYPECODE = 'TDSCHALLAN'
                           AND A.MODULETNO = C.TNO
                           AND C.TNO = D.TNO
                           AND A.TAXSECTIONCODE = D.TAXSECTIONCODE
                           AND A.DEPOSITEDINBANKCODE = E.BANKCODE
                       ) CHLN,
                       (
                          Select
                                a.Tno
                         From Voucher a
                         Where exists(
                                     Select
                                        aa.Tno
                                     From VoucherDetail aa, TDSNature bb
                                     Where aa.AccountCode = bb.TDSAccountCode
                                       and aa.Tno = a.Tno
                                     )) x
                 WHERE A.TNO = B.TNO(+)
                 AND B.MODULETNO = CC.TNO
                    AND CC.MODULETNO = C2.TNO
                    AND C2.PURCHASEBILLTNO = C3.TNO
                   AND A.TDSNATURECODE = F.TDSNATURECODE(+)
                   AND A.TDSTAXCATEGORYCODE = G.TDSTAXCATEGORYCODE(+)
                   AND A.PARTYCODE = H.PARTYCODE(+)
                   AND B.COMPANYCODE = CO.COMPANYCODE(+)
                   AND B.MODULETNO = CHLN.MODULETNO(+)
                   AND A.TNO = X.TNO
                      and ( :P541_COMPANY IS NULL OR instr(':'||:P541_COMPANY||':',':'||CO.CompanyCode||':') > 0 )
                 --  And TO_DATE(TO_CHAR(b.VoucherDate,'DD-MM-RRRR')) between LAST_DAY(TO_DATE('01-' || NVL(:P541_FROMDATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))) and TO_DATE('01-' || NVL(:P541_TODATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))
                 --  and B.ModuleCode like nvl(:P541_MODULECODE,'%')
                 --  and TO_CHAR(b.VoucherDate,'MON-RR') = TO_CHAR(:P541_MONTH,'MON-RR')
                 --  and To_Char(b.VoucherDate, 'MON-RR')   = :P541_MONTH
                   and TO_CHAR(TO_DATE(b.VoucherDate),('MON-RRRR')) = :P541_MONTH
                   --and b.voucherdate between :P541_FROMDATE AND :P541_TODATE
                   and ( :P541_SECTION IS NULL OR instr(':'||:P541_SECTION||':',':'||F.TAXSECTIONCODE||':') > 0 )
                  -- and ( :P541_TDSNATURE IS NULL OR instr(':'||:P541_TDSNATURE||':',':'||F.TDSNATURECODE||':') > 0 )
                   and ( :P541_PARTY IS NULL OR instr(':'||:P541_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                   and :P541_MONTH is not null
                   
                   UNION ALL
                   
                   SELECT 
                    row_number() over(order by B.VOUCHERDATE) SerialNo,
                    CO.COMPANYNAME,
                    B.LOCATIONCODE,
                    B.DOCTYPECODE,
                    B.MODULECODE,
                    A.PARTYCODE,
                    B.VOUCHERNO,
                    B.VOUCHERDATE,
                    NULL AS ITEMNATUREONWHICHTDSDEDECTABLE,
                    A.TDSPAYEECATEGORYCODE,
                    NULL AS TDSDEDUCTABLERATE,
                    F.TAXSECTIONCODE,
                    GETPARTYNAME(A.PARTYCODE) AS PARTY,
                    A.PANNO,
                    DECODE(H.ISCOMPANY, 'YES', 'COMPANY', NULL) ISCOMPANY,
                    F.TDSNATURENAME,
                    ROUND(A.TDSDEDUCTEDON,2) AS BASICAMOUNT,
                    A.TDSPERCENT,
                    A.TDSAMOUNT,
                    A.CESSPERCENT,
                    A.CESSAMOUNT,
                    A.SURCHARGEPERCENT,
                    A.SURCHARGEAMOUNT,
                    CHLN.CHALLANNO AS CHALLANNO,
                    CHLN.CHALLANDATE AS CHALLANDATE,
                    CHLN.BSRCODE AS CHALLANBSRCODE,
                    CHLN.CHALLANAMOUNT AS CHALLANAMOUNT,
                    CASE 
                      WHEN C4.FREIGHTADVICENO IS NOT NULL THEN
                       'FREIGHT ADVICE'
                    END TRANSACTIONMODULE,
                    CASE
                      WHEN C4.FREIGHTADVICENO IS NOT NULL THEN
                       C4.FREIGHTADVICENO
                    END TRANSACTIONNO,
                    CASE
                      WHEN C4.FREIGHTADVICENO IS NOT NULL THEN
                       C4.FREIGHTADVICEDATE
                    END TRANSACTIONDATE,
                    CASE
                      WHEN CC.MODULETNO IS NOT NULL THEN
                       C4.PARTYBILLNO END PARTYBILLNO,
                   CASE
                     WHEN CC.MODULETNO IS NOT NULL THEN
                       C4.PARTYBILLDATE END PARTYBILLDATE,
                    C4.FREIGHTADVICENO AS MODULENO
                  FROM VOUCHERTDSDEDUCTED    A,
                       VOUCHER               B,
                       VOUCHER               CC,
                       FREIGHTADVICE         C4,
                       TDSNATURE             F,
                       TDSTAXCATEGORY        G,
                       PARTY                 H,
                       COMPANY               CO,
                       (SELECT A.CHALLANNO,
                               A.CHALLANDATE,
                               E.BSRCODE,
                               D.MODULETNO,
                               A.CHALLANAMOUNT
                          FROM CHALLAN                  A,
                               TDSCHALLAN               C,
                               TDSCHALLANDEDUCTEEDETAIL D,
                               BANK                     E
                         WHERE  A.DOCTYPECODE = 'TDSCHALLAN'
                           AND A.MODULETNO = C.TNO
                           AND C.TNO = D.TNO
                           AND A.TAXSECTIONCODE = D.TAXSECTIONCODE
                           AND A.DEPOSITEDINBANKCODE = E.BANKCODE
                       ) CHLN,
                       (
                          Select
                                a.Tno
                         From Voucher a
                         Where exists(
                                     Select
                                        aa.Tno
                                     From VoucherDetail aa, TDSNature bb
                                     Where aa.AccountCode = bb.TDSAccountCode
                                       and aa.Tno = a.Tno
                                     )) x
                 WHERE A.TNO = B.TNO(+)
                    AND B.MODULETNO = CC.TNO
                    AND CC.MODULETNO = C4.TNO
                    AND A.TDSNATURECODE = F.TDSNATURECODE(+)
                    AND A.TDSTAXCATEGORYCODE = G.TDSTAXCATEGORYCODE(+)
                    AND A.PARTYCODE = H.PARTYCODE(+)
                    AND B.COMPANYCODE = CO.COMPANYCODE(+)
                    AND B.MODULETNO = CHLN.MODULETNO(+)
                    AND A.TNO = X.TNO
                       and ( :P541_COMPANY IS NULL OR instr(':'||:P541_COMPANY||':',':'||CO.CompanyCode||':') > 0 )
                 --  And TO_DATE(TO_CHAR(b.VoucherDate,'DD-MM-RRRR')) between LAST_DAY(TO_DATE('01-' || NVL(:P541_FROMDATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))) and TO_DATE('01-' || NVL(:P541_TODATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))
                 --  and B.ModuleCode like nvl(:P541_MODULECODE,'%')
                 --  and TO_CHAR(b.VoucherDate,'MON-RR') = TO_CHAR(:P541_MONTH,'MON-RR')
                 --  and To_Char(b.VoucherDate, 'MON-RR')   = :P541_MONTH
                   and TO_CHAR(TO_DATE(b.VoucherDate),('MON-RRRR')) = :P541_MONTH
                   --and b.voucherdate between :P541_FROMDATE AND :P541_TODATE
                   and ( :P541_SECTION IS NULL OR instr(':'||:P541_SECTION||':',':'||F.TAXSECTIONCODE||':') > 0 )
                  -- and ( :P541_TDSNATURE IS NULL OR instr(':'||:P541_TDSNATURE||':',':'||F.TDSNATURECODE||':') > 0 )
                   and ( :P541_PARTY IS NULL OR instr(':'||:P541_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                   and :P541_MONTH is not null
                    
                    UNION ALL
                    
                    SELECT 
                    row_number() over(order by B.VOUCHERDATE) SerialNo,
                    CO.COMPANYNAME,
                    B.LOCATIONCODE,
                    B.DOCTYPECODE,
                    B.MODULECODE,
                    A.PARTYCODE,
                    B.VOUCHERNO,
                    B.VOUCHERDATE,
                    NULL AS ITEMNATUREONWHICHTDSDEDECTABLE,
                    A.TDSPAYEECATEGORYCODE,
                    NULL AS TDSDEDUCTABLERATE,
                    F.TAXSECTIONCODE,
                    GETPARTYNAME(A.PARTYCODE) AS PARTY,
                    A.PANNO,
                    DECODE(H.ISCOMPANY, 'YES', 'COMPANY', NULL) ISCOMPANY,
                    F.TDSNATURENAME,
                    ROUND(A.TDSDEDUCTEDON,2) AS BASICAMOUNT,
                    A.TDSPERCENT,
                    A.TDSAMOUNT,
                    A.CESSPERCENT,
                    A.CESSAMOUNT,
                    A.SURCHARGEPERCENT,
                    A.SURCHARGEAMOUNT,
                    CHLN.CHALLANNO AS CHALLANNO,
                    CHLN.CHALLANDATE AS CHALLANDATE,
                    CHLN.BSRCODE AS CHALLANBSRCODE,
                    CHLN.CHALLANAMOUNT AS CHALLANAMOUNT,
                    CASE
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       'PAYMENT ADVICE'
                    END TRANSACTIONMODULE,
                    CASE
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       E.PAYMENTADVICENO
                    END TRANSACTIONNO,
                    CASE
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       E.PAYMENTADVICEDATE
                    END TRANSACTIONDATE,
                    CASE
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       GETMODULENO(E1.REFERENCEMODULECODE,E1.REFERENCEMODULETNO)
                    END PARTYBILLNO,
                     CASE WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       GETMODULEDATE(E1.REFERENCEMODULECODE,E1.REFERENCEMODULETNO)
                    END PARTYBILLDATE,
                    E.PAYMENTADVICENO AS MODULENO
                  FROM VOUCHERTDSDEDUCTED    A,
                       VOUCHER               B,
                       VOUCHER               B1,
                       PAYMENTADVICE         E,
                       PAYMENTADVICEREFERENCE E1,
                       TDSNATURE             F,
                       TDSTAXCATEGORY        G,
                       PARTY                 H,
                       COMPANY               CO,
                       (SELECT A.CHALLANNO,
                               A.CHALLANDATE,
                               E.BSRCODE,
                               D.MODULETNO,
                               A.CHALLANAMOUNT
                          FROM CHALLAN                  A,
                               TDSCHALLAN               C,
                               TDSCHALLANDEDUCTEEDETAIL D,
                               BANK                     E
                         WHERE  A.DOCTYPECODE = 'TDSCHALLAN'
                           AND A.MODULETNO = C.TNO
                           AND C.TNO = D.TNO
                           AND A.TAXSECTIONCODE = D.TAXSECTIONCODE
                           AND A.DEPOSITEDINBANKCODE = E.BANKCODE
                       ) CHLN,
                       (
                          Select
                                a.Tno
                         From Voucher a
                         Where exists(
                                     Select
                                        aa.Tno
                                     From VoucherDetail aa, TDSNature bb
                                     Where aa.AccountCode = bb.TDSAccountCode
                                       and aa.Tno = a.Tno
                                     )) x
                 WHERE A.TNO = B.TNO(+)
                 ---Requirment for change 07-08-2026----
                   AND B.MODULETNO = B1.TNo(+)
                   AND NVL(B1.MODULETNO,B.MODULETNO) = E.TNO
                   AND E.TNO = E1.TNO(+)
                   AND A.TDSNATURECODE = F.TDSNATURECODE(+)
                   AND A.TDSTAXCATEGORYCODE = G.TDSTAXCATEGORYCODE(+)
                   AND A.PARTYCODE = H.PARTYCODE(+)
                   AND B.COMPANYCODE = CO.COMPANYCODE(+)
                   AND B.MODULETNO = CHLN.MODULETNO(+)
                   AND A.TNO = X.TNO
                   and ( :P541_COMPANY IS NULL OR instr(':'||:P541_COMPANY||':',':'||CO.CompanyCode||':') > 0 )
                 --  And TO_DATE(TO_CHAR(b.VoucherDate,'DD-MM-RRRR')) between LAST_DAY(TO_DATE('01-' || NVL(:P541_FROMDATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))) and TO_DATE('01-' || NVL(:P541_TODATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))
                 --  and B.ModuleCode like nvl(:P541_MODULECODE,'%')
                 --  and TO_CHAR(b.VoucherDate,'MON-RR') = TO_CHAR(:P541_MONTH,'MON-RR')
                 --  and To_Char(b.VoucherDate, 'MON-RR')   = :P541_MONTH
                   and TO_CHAR(TO_DATE(b.VoucherDate),('MON-RRRR')) = :P541_MONTH
                   --and b.voucherdate between :P541_FROMDATE AND :P541_TODATE
                   and ( :P541_SECTION IS NULL OR instr(':'||:P541_SECTION||':',':'||F.TAXSECTIONCODE||':') > 0 )
                  -- and ( :P541_TDSNATURE IS NULL OR instr(':'||:P541_TDSNATURE||':',':'||F.TDSNATURECODE||':') > 0 )
                   and ( :P541_PARTY IS NULL OR instr(':'||:P541_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                   and :P541_MONTH is not null
                /*SELECT 
                    row_number() over(order by B.VOUCHERDATE) SerialNo,
                    CO.COMPANYNAME,
                    B.LOCATIONCODE,
                    B.DOCTYPECODE,
                    B.MODULECODE,
                    A.PARTYCODE,
                    B.VOUCHERNO,
                    B.VOUCHERDATE,
                    NULL AS ITEMNATUREONWHICHTDSDEDECTABLE,
                    A.TDSPAYEECATEGORYCODE,
                    NULL AS TDSDEDUCTABLERATE,
                    F.TAXSECTIONCODE,
                    GETPARTYNAME(A.PARTYCODE) AS PARTY,
                    A.PANNO,
                    DECODE(H.ISCOMPANY, 'YES', 'COMPANY', NULL) ISCOMPANY,
                    F.TDSNATURENAME,
                    ROUND(A.TDSDEDUCTEDON,2) AS BASICAMOUNT,
                    A.TDSPERCENT,
                    A.TDSAMOUNT,
                    A.CESSPERCENT,
                    A.CESSAMOUNT,
                    A.SURCHARGEPERCENT,
                    A.SURCHARGEAMOUNT,
                    CHLN.CHALLANNO AS CHALLANNO,
                    CHLN.CHALLANDATE AS CHALLANDATE,
                    CHLN.BSRCODE AS CHALLANBSRCODE,
                    CHLN.CHALLANAMOUNT AS CHALLANAMOUNT,
                    CASE
                      WHEN C.JBPASSNO IS NOT NULL THEN
                       'JBPASS'
                      WHEN D.EXTERNALSERVICESENTRYNO IS NOT NULL THEN
                       'EXTERNAL SERVICE ENTRY '
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       'PAYMENT ADVICE'
                    END TRANSACTIONMODULE,
                    CASE
                      WHEN C.JBPASSNO IS NOT NULL THEN
                       C.JBPASSNO
                      WHEN D.EXTERNALSERVICESENTRYNO IS NOT NULL THEN
                       D.EXTERNALSERVICESENTRYNO
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       E.PAYMENTADVICENO
                    END TRANSACTIONNO,
                    CASE
                      WHEN C.JBPASSNO IS NOT NULL THEN
                       C.JBPASSDATE
                      WHEN D.EXTERNALSERVICESENTRYNO IS NOT NULL THEN
                       D.EXTERNALSERVICESENTRYDATE
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       E.PAYMENTADVICEDATE
                    END TRANSACTIONDATE,
                    CASE
                      WHEN C.JOBBILLTNO IS NOT NULL THEN
                       C1.PARTYBILLNO
                      WHEN D.EXTERNALSERVICESENTRYNO IS NOT NULL THEN
                       D.BILLNO
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       NULL
                    END PARTYBILLNO,
                        CASE
                      WHEN C.JOBBILLTNO IS NOT NULL THEN
                       C1.PARTYBILLDATE
                      WHEN D.EXTERNALSERVICESENTRYNO IS NOT NULL THEN
                       D.BILLDATE
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       NULL
                    END PARTYBILLDATE,
                    C.JBPASSNO,
                    D.EXTERNALSERVICESENTRYNO,
                    E.PAYMENTADVICENO
                  FROM VOUCHERTDSDEDUCTED    A,
                       VOUCHER               B,
                       JBPASS                C,
                       JOBBILL               C1,
                       EXTERNALSERVICESENTRY D,
                       PAYMENTADVICE         E,
                       TDSNATURE             F,
                       TDSTAXCATEGORY        G,
                       PARTY                 H,
                       COMPANY               CO,
                       (SELECT A.CHALLANNO,
                               A.CHALLANDATE,
                               E.BSRCODE,
                               D.MODULETNO,
                               A.CHALLANAMOUNT
                          FROM CHALLAN                  A,
                               TDSCHALLAN               C,
                               TDSCHALLANDEDUCTEEDETAIL D,
                               BANK                     E
                         WHERE  A.DOCTYPECODE = 'TDSCHALLAN'
                           AND A.MODULETNO = C.TNO
                           AND C.TNO = D.TNO
                           AND A.TAXSECTIONCODE = D.TAXSECTIONCODE
                           AND A.DEPOSITEDINBANKCODE = E.BANKCODE
                       ) CHLN,
                       (
                          Select
                                a.Tno
                         From Voucher a
                         Where exists(
                                     Select
                                        aa.Tno
                                     From VoucherDetail aa, TDSNature bb
                                     Where aa.AccountCode = bb.TDSAccountCode
                                       and aa.Tno = a.Tno
                                     )) x
                 WHERE A.TNO = B.TNO(+)
                   AND B.MODULETNO = C.TNO(+)
                   AND C.JOBBILLTNO = C1.TNO(+)
                   AND B.MODULETNO = D.TNO(+)
                   AND B.MODULETNO = E.TNO(+)
                   AND A.TDSNATURECODE = F.TDSNATURECODE(+)
                   AND A.TDSTAXCATEGORYCODE = G.TDSTAXCATEGORYCODE(+)
                   AND A.PARTYCODE = H.PARTYCODE(+)
                   AND B.COMPANYCODE = CO.COMPANYCODE(+)
                   AND B.MODULETNO = CHLN.MODULETNO(+)
                   AND A.TNO = X.TNO
                   and ( :P541_COMPANY IS NULL OR instr(':'||:P541_COMPANY||':',':'||CO.CompanyCode||':') > 0 )
                 --  And TO_DATE(TO_CHAR(b.VoucherDate,'DD-MM-RRRR')) between LAST_DAY(TO_DATE('01-' || NVL(:P541_FROMDATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))) and TO_DATE('01-' || NVL(:P541_TODATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))
                 --  and B.ModuleCode like nvl(:P541_MODULECODE,'%')
                 --  and TO_CHAR(b.VoucherDate,'MON-RR') = TO_CHAR(:P541_MONTH,'MON-RR')
                 --  and To_Char(b.VoucherDate, 'MON-RR')   = :P541_MONTH
                   and TO_CHAR(TO_DATE(b.VoucherDate),('MON-RRRR')) = :P541_MONTH
                   --and b.voucherdate between :P541_FROMDATE AND :P541_TODATE
                   and ( :P541_SECTION IS NULL OR instr(':'||:P541_SECTION||':',':'||F.TAXSECTIONCODE||':') > 0 )
                  -- and ( :P541_TDSNATURE IS NULL OR instr(':'||:P541_TDSNATURE||':',':'||F.TDSNATURECODE||':') > 0 )
                   and ( :P541_PARTY IS NULL OR instr(':'||:P541_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                  -- and :P541_MONTH is not null
                  */
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 109944579827809431
        }

