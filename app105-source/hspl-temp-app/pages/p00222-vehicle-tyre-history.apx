page 222 (
    name: Vehicle Tyre History
    alias: VEHICLE-TYRE-HISTORY
    title: Vehicle Tyre History
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region vehicle-tyre-history (
        name: Vehicle Tyre History
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vehicle-tyre-history-2 (
        name: Vehicle Tyre History
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        c.*
                        /*
                        c.COMPANYSERIALNO,
                        c.METERREADING,
                        c.WARRANTYUPTODATE,
                        c.WARRANTYPROVIDERCODE,
                        c.REMARK*/
                From
                      COMPANYVEHICLESERIALNO c,
                      COMPANYVEHICLEDETAIL b,
                      COMPANYVEHICLE a
                Where 
                      a.TNO = B.TNO(+)
                and   b.SNO = c.SNO(+)
                and   a.VehicleNo = :P222_VEHICLE
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 49785668301824718
        }

        column COMPANYSERIALNO (
            type: plainText
            heading {
                heading: Serial_No
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column METERREADING (
            type: plainText
            heading {
                heading: Meter_Reading
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column SN (
            type: hidden
            heading {
                heading: Sn
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SNO (
            type: hidden
            heading {
                heading: Sno
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
            security {
                escapeSpecialChars: false
            }
        )

        column WARRANTYPROVIDERCODE (
            type: plainText
            heading {
                heading: Warrantyprovider
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column WARRANTYUPTODATE (
            type: plainText
            heading {
                heading: WarrantyUptoDate
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            width: 8.5
            height: 11
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Vehicle Tyre History
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 50713 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn COMPANYSERIALNO (
                sequence: 1
            )

            displayColumn METERREADING (
                sequence: 2
            )

            displayColumn REMARK (
                sequence: 5
            )

            displayColumn SN (
                sequence: 7
            )

            displayColumn TNOO (
                sequence: 6
            )

            displayColumn WARRANTYPROVIDERCODE (
                sequence: 4
            )

            displayColumn WARRANTYUPTODATE (
                sequence: 3
            )

        )

    )

    pageItem P222_NOS (
        type: displayOnly
        label {
            label: No of Tyres
            alignment: left
        }
        layout {
            sequence: 20
            region: @vehicle-tyre-history
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                Select a.MinNos from COMPANYVEHICLEDETAIL a, COMPANYVEHICLE b
                Where a.TNO = b.TNO
                and   b.VehicleNo = :P222_VEHICLE
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P222_VEHICLE (
        type: textFieldWithAutocomplete
        label {
            label: Vehicle No
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnType: false
        }
        lov {
            type: sqlQuery
            sqlQuery: Select a.VehicleNo from CompanyVehicle a where a.OwnerCode = 'SELF'
        }
        layout {
            sequence: 10
            region: @vehicle-tyre-history
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 10
            valuePlaceholder: Vehicle No
        }
        security {
            encryptSessionState: false
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 30
            region: @vehicle-tyre-history
            slot: regionBody
            startNewRow: false
            column: 10
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

