    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region vehicle-log-book (
        name: Vehicle Log Book
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,
                       row_number() over(order by a.VehicleLogBookDate) SerialNo,
                       a.vehiclelogbookno,
                       a.vehiclelogbookdate,
                       a.shiftcode,
                       a.vehicleno,
                       b.dno As DoorNo,
                       a.openingmeterreading,
                       a.closingmeterreading,
                       a.openingworkinghrs,
                       a.closingworkinghrs
                  From vehiclelogbook a, equipment b, shift c, CompanyVehicle d
                 Where a.equipmenttno = b.tno
                   And a.shiftcode = c.shiftcode
                   and a.vehicleno = d.vehicleno(+)
                   and ( :P238_VEHICLENO IS NULL OR instr(':'||:P238_VEHICLENO||':',':'||d.vehicleno||':') > 0 )
                    and ( :P238_VEHICLEGROUP IS NULL OR instr(':'||:P238_VEHICLEGROUP||':',':'||d.vehiclegroupcode||':') > 0 )
                    and ( :P238_TRANSPORTER IS NULL OR instr(':'||:P238_TRANSPORTER||':',':'||d.transportercode||':') > 0 )
                    and ( :P238_VEHICLETYPE IS NULL OR instr(':'||:P238_VEHICLETYPE||':',':'||d.vehicletypecode||':') > 0 )
                    and ( :P238_OPERATOR IS NULL OR instr(':'||:P238_OPERATOR||':',':'||d.VehicleOperatorCode||':') > 0 )
                    and :P238_COMPANY  = a.companycode
                    and ( :P238_LOCATION IS NULL OR instr(':'||:P238_LOCATION||':',':'||a.locationcode||':') > 0 )
                 
                ```
            pageItemsToSubmit: [
                P238_COMPANY
                P238_LOCATION
                P238_VEHICLENO
                P238_VEHICLEGROUP
                P238_TRANSPORTER
                P238_VEHICLETYPE
                P238_OPERATOR
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 23992918240641908
        }

