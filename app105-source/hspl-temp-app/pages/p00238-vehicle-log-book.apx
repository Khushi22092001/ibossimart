            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 40
            valuePlaceholder: Select Vehicle Type
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 110
            region: @filter
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
                t-Button--pillStart
                t-Button--padLeft
                t-Button--gapRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction selection-change (
        name: Selection Change
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @vehicle-log-book
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var tno,
                    model = this.data.model;
                    
                    tno = model.getValue( this.data.selectedRecords[0], "TNO");
                    
                    apex.item( "P238_TNO" ).setValue (tno);
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @vehicle-log-book-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

