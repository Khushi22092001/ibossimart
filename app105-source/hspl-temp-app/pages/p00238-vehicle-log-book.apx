    region vehicle-log-book-detail (
        name: Vehicle Log Book Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                row_number() over(order by a.Tno) SerialNo,
                a.tno,
                a.sno,
                b.dno As DoorNo,
                b.EquipmentName,
                a.loadingtime,
                a.Unloadingtime
                From vehiclelogbookdetail a, Equipment b
                Where a.EquipmentTno = b.tno(+)
                and a.tno = :P238_TNO
                
                ```
            pageItemsToSubmit: P238_TNO
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: page
        }
        toolbar {
            show: false
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        heading {
            fixedTo: region
            fixedReportHeight: 250
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
