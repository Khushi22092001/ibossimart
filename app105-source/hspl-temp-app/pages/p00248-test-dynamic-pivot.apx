page 248 (
    name: test dynamic pivot
    alias: TEST-DYNAMIC-PIVOT
    title: test dynamic pivot
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region new-2 (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select e.Equipmentid,
                       a.Maintenancerequestdate,
                       a.dueon,
                       d.activitycode,
                       getactivityname(d.activitycode) As Activity,
                       getequipmentlocationcode(e.tno, a.maintenancerequestdate) As Location,
                       Count(*)
                  From MaintenanceRequest       a,
                       Equipmentmaintenanceplan b,
                       Equipmenttasklist        C,
                       Equipmenttasklistdetail  d,
                       Equipment                e
                 Where a.plantno = b.tno(+)
                   And a.maintenancetypecode = 'PM'
                   And b.Equipmenttasklisttno = c.tno(+)
                   And c.tno = d.tno(+)
                   And a.Equipmenttno = e.tno(+)
                 Group By e.Equipmentid,
                          a.Maintenancerequestdate,
                          a.dueon,
                          d.activitycode,
                          getequipmentlocationcode(e.tno, a.maintenancerequestdate)
                 Order By 1, 2, 3
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 8522252088696015
        }

        column ACTIVITY (
            type: plainText
            heading {
                heading: Activity
                alignment: center
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column ACTIVITYCODE (
            type: plainText
            heading {
                heading: Activity Code
                alignment: center
            }
            layout {
                sequence: 70
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:150px">#ACTIVITYCODE#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column "COUNT(*)" (
            type: plainText
            heading {
                heading: Count(*)
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column DUEON (
            type: plainText
            heading {
                heading: Due On
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column EQUIPMENTID (
            type: plainText
            heading {
                heading: Equipment ID
                alignment: center
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:150px">#EQUIPMENTID#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column LOCATION (
            type: plainText
            heading {
                heading: Location
                alignment: center
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column MAINTENANCEREQUESTDATE (
            type: plainText
            heading {
                heading: Maintenance Request Date
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:170px">#MAINTENANCEREQUESTDATE#</div>
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: New
        }

        savedReport 90159 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTIVITYCODE (
                sequence: 1
            )

            displayColumn EQUIPMENTID (
                sequence: 2
            )

            displayColumn MAINTENANCEREQUESTDATE (
                sequence: 3
            )

        )

    )

    pageItem P248_LIST (
        type: textField
        label {
            label: List
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

)

