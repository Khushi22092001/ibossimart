page 433 (
    name: Unallocated 26AS
    alias: UNALLOCATED-26AS
    title: Unallocated 26AS
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                   a.*
                From TaxCreditAssessmentAllocation a
                Where a.BillDate BETWEEN :P433_FROMDATE AND :P433_TODATE;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 42524463736454529
        }

        column BALANCETDSAMOUNT (
            type: plainText
            heading {
                heading: Balance TDS Amount
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column BILLAMOUNT (
            type: plainText
            heading {
                heading: Bill Amount
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column BILLDATE (
            type: plainText
            heading {
                heading: Bill Date
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column BILLNO (
            type: plainText
            heading {
                heading: BillNo
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DFREIGHTBILLRECEIPTNO (
            type: plainText
            heading {
                heading: DFreight Bill Receipt No
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column DFREIGHTBILLRECEIPTSNO (
            type: plainText
            heading {
                heading: Dfreightbillreceiptsno
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column DFREIGHTBILLRECEIPTTNO (
            type: plainText
            heading {
                heading: Dfreightbillreceipttno
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: Locationcode
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: Modulecode
                alignment: center
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column MODULETNO (
            type: plainText
            heading {
                heading: Moduletno
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column TDSALLOCATEDAMOUNT (
            type: plainText
            heading {
                heading: TDS Allocated Amount
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column TDSAMOUNT (
            type: plainText
            heading {
                heading: TDS Amount
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 452581 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BALANCETDSAMOUNT (
                sequence: 7
            )

            displayColumn BILLAMOUNT (
                sequence: 4
            )

            displayColumn BILLDATE (
                sequence: 3
            )

            displayColumn BILLNO (
                sequence: 1
            )

            displayColumn DFREIGHTBILLRECEIPTNO (
                sequence: 2
            )

            displayColumn TDSALLOCATEDAMOUNT (
                sequence: 6
            )

            displayColumn TDSAMOUNT (
                sequence: 5
            )

        )

    )

    region unallocated-26as (
        name: Unallocated 26AS
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P433_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @unallocated-26as
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P433_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @unallocated-26as
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 30
            region: @unallocated-26as
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

