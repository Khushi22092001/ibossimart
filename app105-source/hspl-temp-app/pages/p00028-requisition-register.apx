    button custom (
        buttonName: CUSTOM
        label: Custom
        layout {
            sequence: 20
            region: @material-requisition-register
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/mrregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P28_FROMDATE=&P28_FROMDATE.&P28_TODATE=&P28_TODATE.&P28_LOCATION=&P28_LOCATION.&P28_STATUS=&P28_STATUS.&P28_BREAKUPAS=&P28_BREAKUPAS.&P28_BREAKUP=&P28_BREAKUP.&P28_DEPARTMENT=&P28_DEPARTMENT.&P28_GROUPLEVEL=&P28_GROUPLEVEL.&P28_GROUP=&P28_GROUP.&P28_ITEM=&P28_ITEM.&P28_ITEMSPECIFICATION=&P28_ITEMSPECIFICATION.&P28_COSTCENTRE=&P28_COSTCENTRE.&P28_PARTY=&P28_PARTY.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 2
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @material-requisition-register
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 130
            region: @requisition-register
            slot: regionBody
            column: 9
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/mrregister.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P28_COMPANY.","_paramsP_LOCATION":"&P28_LOCATION.","_paramsP_FROMDATE":"&P28_FROMDATE.","_paramsP_TODATE":"&P28_TODATE.","_paramsP_GROUP":"&P28_GROUP.","_paramsP_ITEM":"&P28_ITEM.","_paramsP_ISSUESTATUS":"&P28_ISSUESTATUS.","_paramsP_ITEMSPECIFICATION":"&P28_ITEMSPECIFICATION.","_paramsP_DEPARTMENT":"&P28_DEPARTMENT.","_paramsP_DOCTYPE":"&P28_DOCTYPE.","_paramsP_COSTCENTRE":"&P28_COSTCENTRE."}');
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

