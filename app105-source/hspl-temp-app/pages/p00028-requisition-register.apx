    )

    pageItem P28_ITEMSPECIFICATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Specification
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      ee.ItemSpecificationName as d,
                      ee.ItemSpecificationCode as r
                From Item e, ItemSpecification ee
                Where e.TNo = ee.TNo
                  and e.ItemCode = :P28_ITEM
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P28_ITEM
            itemsToSubmit: P28_ITEMSPECIFICATION
        }
        layout {
            sequence: 110
            region: @requisition-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
