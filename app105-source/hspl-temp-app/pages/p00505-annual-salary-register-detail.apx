page 505 (
    name: Annual Salary Register Detail
    alias: ANNUAL-SALARY-REGISTER-DETAIL
    title: Annual Salary Register Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region annual-salary-register-detail (
        name: Annual Salary Register Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region annual-salary-register-detail-2 (
        name: Annual Salary Register Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                  Select 
                       b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName,
                       b.DateOfJoining,
                       a.LocationCode,
                       b.EmployeeCode,
                       a.CompanyCode,
                       SUM(decode(c.SalaryHeadCode, 'PD', c.SalaryHeadAmount))  as PaidDays,
                       SUM(decode(c.SalaryHeadCode, 'GROSSSALARY', c.SalaryHeadAmount)) as GrossSalary,
                       SUM(decode(c.SalaryHeadCode, 'PTAX', c.SalaryHeadAmount)) as PT,
                       SUM(decode(c.SalaryHeadCode, 'PFEMPLOYEE', c.SalaryHeadAmount)) as PF,
                       SUM(decode(c.SalaryHeadCode, 'ESICEMPLOYEECONTRIBUTION', c.SalaryHeadAmount)) as ESIC,
                       SUM(decode(c.SalaryHeadCode, 'RUNNINGADVANCEDED', c.SalaryHeadAmount)) +
                       SUM(decode(c.SalaryHeadCode, 'SALARYADVANCEDED', c.SalaryHeadAmount)) as AdvanceDed,
                       SUM(decode(c.SalaryHeadCode, 'CANTEENDED', c.SalaryHeadAmount)) as Mess,   
                       SUM(decode(c.SalaryHeadCode, 'TDS', c.SalaryHeadAmount)) as TDS,
                       SUM(decode(c.SalaryHeadCode, 'OTHERDEDUCTION', c.SalaryHeadAmount)) as OtherDeduction,
                       SUM(decode(c.SalaryHeadCode, 'GROSSDEDUCTION', c.SalaryHeadAmount)) as TotalDeduction,
                       SUM(decode(c.SalaryHeadCode, 'NETEARNING', c.SalaryHeadAmount)) as NetPayment,
                       GetLocationName(a.LocationCode) Location,
                       g.DepartmentName
                From   Salary a,Employee b,SalaryDetail c,Designation d,EmployeeSalary e,SalaryScheme f, Department g
                Where  a.EmployeeCode = b.EmployeeCode(+)
                  and  a.TNo = c.TNo(+)
                  and  b.DesignationCode = d.DesignationCode(+)
                  and  a.EmployeeSalaryTno = e.Tno(+)
                  and  e.Salaryschemecode = f.SalarySchemeCode(+)
                  and  a.DepartmentCode = g.DepartmentCode(+)
                  and  a.FinancialYearCode = :P505_FINANCIALYEAR
                  and  (:P505_EMPLOYEE IS NULL OR instr(':'||:P505_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0)
                  and  (:P505_COMPANY IS NULL OR instr(':'||:P505_COMPANY||':',':'||a.CompanyCode||':') > 0)
                  and  (:P505_LOCATION IS NULL OR instr(':'||:P505_LOCATION||':',':'||a.LocationCode||':') > 0)
                Group By b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName,
                       b.DateOfJoining,
                       GetLocationName(a.LocationCode),
                       a.SalaryNo,
                       g.DepartmentName,
                       a.LocationCode,
                       b.EmployeeCode,
                       a.CompanyCode
                ```
            pageItemsToSubmit: [
                P505_FINANCIALYEAR
                P505_COMPANY
                P505_LOCATION
            ]
        }
        layout {
            sequence: 20
