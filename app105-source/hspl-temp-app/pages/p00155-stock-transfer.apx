        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      ee.ItemSpecificationName as d,
                      ee.ItemSpecificationCode as r
                From   Item e, ItemSpecification ee
                Where e.ItemCode = :P155_ITEM
                  and e.TNO = ee.TNO
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P155_ITEM
            itemsToSubmit: [
                P155_ITEM
                P155_SPECIFICATION
            ]
        }
        layout {
            sequence: 100
            region: @stock-transfer-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 74
            valuePlaceholder: Material Specification
        }
    )

    pageItem P155_STNO (
        type: textFieldWithAutocomplete
        label {
            label: Entry No
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                StockTransferNo
                From StockTransfer
                Where instr(':'||:P155_LOCATION||':',':'||LocationCode||':') > 0
                  and StockTransferDate Between :P155_FROMDATE and :P155_TODATE
                Order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P155_LOCATION
            itemsToSubmit: P155_STNO
        }
        layout {
            sequence: 30
            region: @stock-transfer-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Stock Journal No
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P155_TODATE (
        type: datePickerJquery
        label {
            label: To Date
            alignment: left
        }
        settings {
            show: both
            navigationListFor: monthAndYear
        }
        layout {
            sequence: 60
            region: @stock-transfer-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 45
            valuePlaceholder: To Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P155_TOSTORAGE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: To Storage
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select storagelocationname d, storagelocationcode r from storagelocation A
                where getdocumentstatuscode('STORAGELOCATION',A.TNO)='ACTIVE'
                ORDER BY 1
                ```
        }
        layout {
            sequence: 90
            region: @stock-transfer-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @stock-transfer
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 110
            region: @stock-transfer-register
            slot: regionBody
            startNewRow: false
            column: 10
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/Stock Transfer Register.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P155_COMPANY.","_paramsP_LOCATION":"&P155_LOCATION.","_paramsP_STNO":"&P155_STNO.","_paramsP_FROMDATE":"&P155_FROMDATE.","_paramsP_TODATE":"&P154_TODATE.","_paramsP_ITEM":"&P155_ITEM.","_paramsP_SPECIFICATION":"&P155_SPECIFICATION."}');
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P155_SJNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P155_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P155_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 12732920235879179
        }
    )

)

