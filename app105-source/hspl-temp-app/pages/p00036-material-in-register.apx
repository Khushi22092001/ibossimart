    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P36_MINO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P36_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P36_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 5671139570666581
        }
    )

)

