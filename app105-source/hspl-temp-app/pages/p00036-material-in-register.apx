page 36 (
    name: Material In Register
    alias: MATERIAL-IN-REGISTER
    title: Material In Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/materialinregister.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P36_FROMDATE').val());
              var toDate = new Date($('#P36_TODATE').val());
            
              var reportParams = 
                  '&P_COMPANY='+ $('#P36_COMPANY').val() +  
                  '&P_LOCATION=' + $('#P36_LOCATION').val() +    
                  '&P_FROMDATE=' +$('#P36_FROMDATE').val() + 
                  '&P_TODATE=' +$('#P36_TODATE').val() + 
                  '&P_DOCTYPE=' +$('#P36_DOCTYPE').val() +
                  '&P_PARTY=' +$('#P36_PARTY').val() +
                  '&P_GRNSTATUS=' +$('#P36_GRNSTATUS').val() +
                  '&P_TRANSPORTER=' +$('#P36_TRANSPORTER').val() +
                  '&P_VEHICLENO=' +$('#P36_VEHICLENO').val() +
                  '&P_ITEM=' +$('#P36_ITEM').val() +
                  '&P_MINO=' +$('#P36_MINO').val() +
            	    '&P_ITEMSPECIFICATION=' +$('#P36_ITEMSPECIFICATION').val() +
                  '&P_CREATOR=' +$('#P36_CREATOR').val()  
                  ;
              
              var reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            ```
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region material-in-register (
        name: Material In Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report-material-in (
        name: Report(Material In)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       row_number() over(order by a.Tno) SerialNo,
                       a.LOCATIONCODE,
                       a.DOCTYPECODE,
                       a.LOCATIONNAME,
                       PO.LOCATIONCODE AS POLOCATIONCODE,
                       PO.DOCTYPECODE  AS PODOCTYPECODE,
                       GETLOCATIONNAME(PO.LOCATIONCODE) POLOCATIONNAME,
                       GETDOCTYPENAME(PO.DOCTYPECODE) AS PODOCTYPENAME,
                       Upper(a.DOCTYPENAME) DOCTYPENAME,
                       a.MATERIALINNO,
                       a.MATERIALINDATE,
                       a.PARTYCODE,
                       a.PARTYNAME,
                       a.REFDOCNO,
                       a.REFDOCDATE,
                       a.REFDOCAMOUNT,
                       a.TRANSPORTERCODE,
                       a.TRANSPORTER,
                       a.VEHICLENO,
                       a.VEHICLETYPENAME,
                       a.DRIVERNAME,
                       a.LRNO,
                       a.LRDATE,
                       a.ITEMCODE,
                       a.ITEMNAME,
                       a.ITEMSPECIFICATIONCODE,
                       a.ITEMSPECIFICATIONNAME,
                       a.ITEMNAME||' ~ '||a.ITEMSPECIFICATIONNAME as MATERIALDESCRIPTION,
                       a.UOM,
                       a.UOM2,
                       round(a.QUANTITY1,3) as QUANTITY1,
                       ROUND(a.Quantity2,3) AS Quantity2,
                       a.PACKINGTYPENAME,
                       Upper(a.MODULE) MODULE,
                       a.MODULENO,
                       a.MODULEDATE,
                       a.WEIGHMENTTNO,
                       a.WEIGHMENTNO,
                     --  a.WEIGHMENTDATE,
                       a.FIRSTWEIGHT,
                       a.SECONDWEIGHT,
                       a.NETWEIGHT,
                       a.ACCEPTEDWEIGHT,
                       a.Creator,
                       a.CreationTime,
                       a.CreatedFrom,
                       Case When a.AcceptedWeight < a.Quantity1 then 'RED_COLOR'
                            When a.AcceptedWeight = a.Quantity1 then 'GREEN_COLOR'
                       Else 'YELLOW_COLOR'
                       End as Color_Value,
                       a.GRNStatus,
                       a.GRNNO,
                       a.GRNDate,
                       GetEmployeeName(bu.EmployeeCode)||'( '||g.Creator||' )' as GRNCreator,
                       g.CreationTime as GRNCreationTime,
                       a.RakeTno,
                       a.RakeNo,
                       A.GATEINTIME,
                       to_char(a.SecondWeightTime,'DD-MM-RRRR HH24:MI:SS PM') as WEIGHMENTDATE,
                       A.GATEOUTTIME,
                       a.TotalTime,
                       dsd.DocumentStatusCode as Status
                From GATEINREGISTER_VIEW a, Grn g, Bossuser bu, MaterialIn mn, Purchaseorder po, DocumentStatusDetail dsd
                Where a.MaterialInDate between :P36_FROMDATE and :P36_TODATE
                  and instr(':'||:P36_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P36_LOCATION||':',':'||a.LocationCode||':') > 0
                  
                  --(:P36_TODOLIST = 'YES' OR :P36_NEXTPROCESS = 'YES' OR (a.MaterialInDate between :P36_FROMDATE and :P36_TODATE))
                  --and (:P36_TODOLIST = 'YES' OR :P36_NEXTPROCESS = 'YES' OR (instr(':'||:P36_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  --and (:P36_TODOLIST = 'YES' OR :P36_NEXTPROCESS = 'YES' OR (instr(':'||:P36_LOCATION||':',':'||a.LocationCode||':') > 0))
                 
                  and (:P36_DOCTYPE IS NULL OR instr(':'||:P36_DOCTYPE||':',':'||mn.DocTypeCode||':') > 0 )
                  AND (:P36_POLOCATION IS NULL OR (instr(':'||:P36_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and (:P36_PODOCTYPE IS NULL OR instr(':'||:P36_PODOCTYPE||':',':'||PO.DocTypeCode||':') > 0 )
                 
                  and (:P36_PARTY IS NULL OR instr(':'||:P36_PARTY||':',':'||a.PartyCode||':') > 0 )
                  and (:P36_TRANSPORTER IS NULL OR instr(':'||:P36_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 )
                  and (:P36_ITEM IS NULL OR instr(':'||:P36_ITEM||':',':'||a.ItemCode||':') > 0 ) 
                  and (:P36_ITEMSPECIFICATION IS NULL OR instr(':'||:P36_ITEMSPECIFICATION||':',':'||a.ItemSpecificationCode||':') > 0 ) 
                 -- and a.VehicleNo like nvl(:P36_VEHICLENO,'%')
                  and a.GRNSTATUS like nvl(:P36_GRNSTATUS,'%')
                  and (:P36_STATUS IS NULL OR instr(':'||:P36_STATUS||':',':'||dsd.DocumentStatusCode||':') > 0 ) 
                 -- and a.MaterialInNo like nvl(:P36_MINO,'%')
                  and (:P36_RAKENO is null or mn.raketno = :P36_RAKENO)
                 -- and a.RakeTno like nvl(:P36_RAKENO,'%')
                  and ( :P36_CREATOR IS NULL OR instr(':'||:P36_CREATOR||':',':'||a.Creator||':') > 0 )
                  and  a.GRNTNo = g.TNo(+)
                  and g.Creator = bu.LoginName(+)
                  and a.Tno = mn.Tno(+)
                  and mn.purchaseordertno = po.tno(+)
                  and a.Tno = dsd.ModuleTno(+)
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or MN.panel = GetUserPanelAB_apex())
                --   AND ( :P36_TODOLIST='NO' OR (:P36_TODOLIST='YES' AND EXISTS ( SELECT 1 FROM ONTHETABLE_APEX YY WHERE YY.TNO=A.TNO) ))
                -- AND ( :P36_NEXTPROCESS = 'NO' OR (:P36_NEXTPROCESS = 'YES' AND (  getdocumentstatuscode('MATERIALIN',A.TNO)='ACTIVE'
                --                                     AND  NOT EXISTS (Select 1 From GRN AA Where AA.Materialintno = A.TNO)
                --                                 ))
                
                --  )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: t-Form--search
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
