    pageItem P36_ITEM (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Material
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        e.ItemName||' ( '||e.ItemCode as d,
                        e.ItemCode r
                From MaterialInDetail a, Item e
                Where a.ItemCode = e.itemCode
                
                Union
                
                Select
                        Distinct
                        e.ItemName||' ( '||e.ItemCode as ItemName,
                        e.ItemCode
                From MaterialOutDetail a, Item e
                Where a.ItemCode = e.itemCode
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @material-in-register
            slot: regionBody
            alignment: left
