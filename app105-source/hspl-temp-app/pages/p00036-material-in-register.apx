        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select MaterialInNo 
                From MaterialIn 
                Where instr(':'||:P36_LOCATION||':',':'||LocationCode||':') > 0
                --  and instr(':'||:P114_DOCTYPE||':',':'||DocTypeCode||':') > 0
                  and MaterialInDate Between :P36_FROMDATE and :P36_TODATE
                Order by 1
                ```
