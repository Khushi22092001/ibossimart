            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/materialinregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P36_FROMDATE=&P36_FROMDATE.&P36_TODATE=&P36_TODATE.&P36_LOCATION=&P36_LOCATION.&P36_DOCTYPE=&P36_DOCTYPE.&P36_GRNSTATUS=&P36_GRNSTATUS.&P36_VEHICLENO=&P36_VEHICLENO.&P36_PARTY=&P36_PARTY.&P36_TRANSPORTER=&P36_TRANSPORTER.&P36_ITEM=&P36_ITEM.&P36_ITEMSPECIFICATION=&P36_ITEMSPECIFICATION.&P36_MINO=&P36_MINO.
            warnOnUnsavedChanges: doNotCheck
