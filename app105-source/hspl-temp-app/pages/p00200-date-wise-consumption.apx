page 200 (
    name: Date Wise Consumption
    alias: DATE-WISE-CONSUMPTION
    title: Date Wise Consumption
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        height: 700
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region consumption-report (
        name: Consumption Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct e.fin_date,
                                A.ITEMCODE,
                                A.ITEMNAME,
                                B.ITEMSPECIFICATIONNAME,
                                B.ITEMSPECIFICATIONCODE,
                                
                                getslitemconsumptionquantity1(Null,
                                                              A.ITEMCODE,
                                                              B.ITEMSPECIFICATIONCODE,
                                                              '1',
                                                              e.FIN_DATE,
                                                              e.FIN_DATE) As Quantity,
                                getslitemconsumptionValue(Null,
                                                          A.ITEMCODE,
                                                          B.ITEMSPECIFICATIONCODE,
                                                          '1',
                                                          e.FIN_DATE,
                                                          E.FIN_DATE) As Value
                  From ITEM A, ITEMSPECIFICATION B, BI_DATETIME e
                 Where A.TNO = B.TNO
                   And E.FIN_DATE Between :P200_FROMDATE And :P200_TODATE
                   And a.ItemCode = :P200_ITEM
                   And b.ItemSpecificationCode = :P200_SPECIFICATION
                
                 Order By E.FIN_DATE
                
                ```
            pageItemsToSubmit: [
                P200_COMPANY
                P200_LOCATION
                P200_FROMDATE
                P200_TODATE
                P200_ITEM
                P200_SPECIFICATION
            ]
        }
        layout {
            sequence: 60
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: STOCK POSITION
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 82558111055588197
        }

        column FIN_DATE (
            type: link
            heading {
                heading: Fin Date
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            link {
                target: {
                    page: 201
                    items: {
                        P201_COMPANY: &P200_COMPANY.
                        P201_LOCATION: &P200_LOCATION.
                        P201_ITEM: #ITEMCODE#
                        P201_SPECIFICATION: #ITEMSPECIFICATIONCODE#
                        P201_FROMDATE: #FIN_DATE#
                        P201_TODATE: #FIN_DATE#
                    }
                    clearCache: 201
                }
                linkText: #FIN_DATE#
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ITEMCODE (
            type: hidden
            heading {
                heading: Itemcode
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ITEMNAME (
            type: plainText
            heading {
                heading: ITEM NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: plainText
            heading {
                heading: Itemspecificationcode
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ITEMSPECIFICATIONNAME (
            type: plainText
            heading {
                heading: ITEM SPECIFICATION
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 99,99,999.999
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column VALUE (
            type: plainText
            heading {
                heading: Value
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: 99,99,99,99,999.99
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        savedReport 242756 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FIN_DATE (
                sequence: 5
            )

            displayColumn ITEMNAME (
                sequence: 1
            )

            displayColumn ITEMSPECIFICATIONNAME (
                sequence: 2
            )

            displayColumn QUANTITY (
                sequence: 3
            )

            displayColumn VALUE (
                sequence: 4
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: VALUE
            )

        )

    )

    region consumption-report-2 (
        name: Consumption Report
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-left-none
                margin-right-none
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P200_COMPANY (
        type: hidden
        layout {
            sequence: 10
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P200_DIPNO (
        type: hidden
        layout {
            sequence: 30
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P200_FROMDATE (
        type: hidden
        layout {
            sequence: 40
            region: @consumption-report-2
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P200_ITEM (
        type: hidden
        layout {
            sequence: 60
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P200_LOCATION (
        type: hidden
        layout {
            sequence: 20
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P200_SPECIFICATION (
        type: hidden
        layout {
            sequence: 70
            region: @consumption-report-2
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P200_TODATE (
        type: hidden
        layout {
            sequence: 50
            region: @consumption-report-2
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: Trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P200_SJNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P200_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P200_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 25705248505003173
        }
    )

)

