    pageItem P266_COMPANYNAME (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                a.CompanyNAME,
                a.companyCode
                From Company a, NecessitySlip ns
                where ns.CompanyCode = a.CompanyCode
                ```
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 40
            region: @pumpwise-diesel-details
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

