page 266 (
    name: PumpWise Diesel Details
    alias: PUMPWISE-DIESEL-DETAILS
    title: PumpWise Diesel Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region pumpwise-diesel-details (
        name: Pumpwise Diesel Details
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pumpwise-diesel-details-report (
        name: PumpWise Diesel Details Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Rownum as SerialNo,
                c.companyname,
                l.locationname,
                a.necessityslipno,
                a.necessityslipdate,
                p.partyname as PetrolPump,
                r.lrno,
                r.lrDate,
                e.employeename,
                a.vehicleno,
                v.vehiclenecessityname as Necessity,
                round(b.quantity1,3) as Quantity,
                b.DieselRate,
                round(nvl(b.Quantity1,0) * nvl(b.DieselRate,0),2) as Amount,
                a.Creator
                From necessityslip a,necessityslipdetail b, location l, lr r,
                Party p,employee e,vehiclenecessity v,company c
                Where a.tno = b.tno(+)
                and a.locationcode = l.locationcode(+)
                and a.partycode = p.PartyCode(+)
                and a.lrtno = r.tno(+)
                and a.employeecode = e.employeecode(+)
                and b.vehiclenecessitycode = v.vehiclenecessitycode(+)
                and a.companycode = c.companycode(+) 
                and p.PartyTypeCode = 'SUPPLIER'
                and a.necessityslipdate Between :P266_FROMDATE and :P266_TODATE
                and (:P266_COMPANYNAME is Null Or Instr (':' || :P266_COMPANYNAME || ':' , ':' || c.CompanyCode || ':') > 0)
                and (:P266_PUMPNAME is Null Or Instr (':' || :P266_PUMPNAME || ':' , ':' || p.PartyCode || ':') > 0)
                and (:P266_LOCATION is Null Or Instr (':' || :P266_LOCATION || ':' , ':' || l.LocationCode || ':') > 0)
                ;
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 10355997310029622
        }

