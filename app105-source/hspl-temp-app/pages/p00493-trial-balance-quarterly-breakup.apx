    dynamicAction new-3 (
        name: New_2
        execution {
            sequence: 50
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @new
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    alert($(this).text());
                    $('td[headers="ACCOUNTLEVEL"]').each(function() {
                      if ( $(this).text() = '1' ) {
                        $(this).closest('tr').find('td').css({"background-color":"#COLOUR !important"});
                      }
                      
                    });
                    ```
            }
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-4 (
        name: New_3
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @show
        }

        action native-refresh (
