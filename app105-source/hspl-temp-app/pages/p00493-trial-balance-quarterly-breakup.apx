    dynamicAction new (
        name: New
        execution {
            sequence: 30
        }
        when {
            event: focusout
            selectionType: items
            items: P493_FINANCIALYEARCODE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select a.financialyearbegin,
                           case when trunc(sysdate) < A.Financialyearend then
                                trunc(sysdate)
                                else a.financialyearend
                            end financialyearend
                    from financialyear a
                    where a.financialyearcode = :P493_FINANCIALYEARCODE;
                    ```
                itemsToSubmit: P493_FINANCIALYEARCODE
            }
            affectedElements {
                selectionType: items
                items: [
                    P493_FROMDATE
                    P493_TODATE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action set-qtr (
            name: SET QTR 1
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT X.todate FROM (
                    Select a.fromdate,
                           a.todate,
                            Case
                             When to_char(a.fromdate, 'MM') In ('04', '05', '06') Then
                              'Q1'
                             When to_char(a.fromdate, 'MM') In ('07', '08', '08') Then
                              'Q2'
                             When to_char(a.fromdate, 'MM') In ('10', '11', '12') Then
                              'Q3'
                             When to_char(a.fromdate, 'MM') In ('01', '02', '03') Then
                              'Q4'
                           End QUARTER
                      From PERIODLIST A, FINANCIALYEAR B
                     Where B.FINANCIALYEARCODE = :P493_FINANCIALYEARCODE
                       And FROMDATE >= B.FINANCIALYEARBEGIN
                       And TODATE <= B.FINANCIALYEAREND
                       And PERIODTYPE = 'QUATER'
                        ) X
                        WHERE X.QUARTER='Q1'
                    ```
                itemsToSubmit: P493_FINANCIALYEARCODE
            }
            affectedElements {
                selectionType: items
                items: P493_QTR1END
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action set-qtr-2 (
            name: SET QTR 2
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT X.todate FROM (
                    Select a.fromdate,
                           a.todate,
                            Case
                             When to_char(a.fromdate, 'MM') In ('04', '05', '06') Then
                              'Q1'
                             When to_char(a.fromdate, 'MM') In ('07', '08', '08') Then
                              'Q2'
                             When to_char(a.fromdate, 'MM') In ('10', '11', '12') Then
                              'Q3'
                             When to_char(a.fromdate, 'MM') In ('01', '02', '03') Then
                              'Q4'
                           End QUARTER
                      From PERIODLIST A, FINANCIALYEAR B
                     Where B.FINANCIALYEARCODE = :P493_FINANCIALYEARCODE
                       And FROMDATE >= B.FINANCIALYEARBEGIN
                       And TODATE <= B.FINANCIALYEAREND
                       And PERIODTYPE = 'QUATER'
                        ) X
                        WHERE X.QUARTER='Q2'
                    ```
                itemsToSubmit: P493_FINANCIALYEARCODE
            }
            affectedElements {
                selectionType: items
                items: P493_QTR2END
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action set-qtr-3 (
            name: SET QTR 3
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
