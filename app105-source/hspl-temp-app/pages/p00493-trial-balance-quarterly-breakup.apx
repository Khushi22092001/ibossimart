            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-5 (
        name: New_4
        execution {
            sequence: 80
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @create
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    		declare
                                	tFromDate Date := to_date(:P493_FromDate,'DD-MM-RRRR');
                    				tToDate Date := to_date(:P493_ToDate,'DD-MM-RRRR');
                    				tStartDate Date := GetFinancialYearBegin(:P493_FinancialYearCode);
                    				tDetailLevel number := :P493_DetailLevel;
                                    tFinancialyearcode  varchar2(30) ;
                    				tLedgerOnly Varchar2(30) := :P493_LedgerOnly;
                    				tIncludeChild Varchar2(30) := :P493_IncludeChild;		
                    				tLocationCode Varchar2(30) := :P493_LocationCode;
                    				-- tLocationName Varchar2(2000) := :P493_LocationName;
                    				tDivisionWise Varchar2(3) := :P493_DivisionWise;
                    		begin 
                                   -- RAISE_APPLICATION_ERROR(-20025,' c '||:P493_COMPANYCODE||' L '||:P493_LOCATIONCODE|| 'from date '||tfromdate||' to date '||ttodate); 
                                 Delete From MyAccountIncludeRevised a
                                   Where a.CompanyCode = :P493_CompanyCode
                                     And a.FromDate = tFromDate
                                     And a.ToDate = tToDate
                                     and (a.locationcode is null or a.locationcode = :P493_LOCATIONCODE)
                                     and a.creator='&APP_USER.'
                                     ;
                                     COMMIT;
                                    APEX_CreateMyAccountIncludeRevised(:P493_CompanyCode, :P493_LOCATIONCODE, tFromDate, tToDate);
                                    --RefreshMyAccountIncludeForAll;
                                  --  COMMIT;
                    
                                             
                                    /*----------------------------
                    				-- EXECUTE REFRESH OPENING ON INSTRUCTION FROM TIWARI SIR DATE 30 APR 2018
                    				*/
                                  -- RefreshOpening(nvl(:P493_FinancialYearCode,tFinancialyearcode), :P493_CompanyCode);			
                    				
                    				/*----------------------------*/
                    				
                    				delete 
                    						from TRIALBALANCEQUARTER a 
                    						where a.CompanyCode = :P493_CompanyCode
                    								and nvl(a.LocationCode, 'null') = nvl(tLocationCode, 'null')
                    								and a.FromDate = tFromDate
                    								and a.ToDate = tToDate
                    								and a.Creator = '&APP_USER.'
                    				;
                                  --  RAISE_APPLICATION_ERROR(-20025,'CALLED'); 
                     				CreateTrialBalanceQuarter(:P493_CompanyCode,:P493_FinancialYearCode,:P493_LOCATIONCODE,'&APP_USER.',:P493_FROMDATE,:P493_TODATE);
                    
                    		end;  
                    END;
                    ```
                itemsToSubmit: [
                    P493_COMPANYCODE
                    P493_FINANCIALYEARCODE
                    P493_LOCATIONCODE
                    P493_FROMDATE
                    P493_TODATE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#apex_wait_overlay").remove();
                    $(".u-Processing").remove();
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction show-spinner (
        name: show spinner
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @create
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @create
