page 493 (
    name: Trial Balance Quarterly Breakup
    alias: TRIAL-BALANCE-QUARTERLY-BREAKUP
    title: Trial Balance Quarterly Breakup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region new (
        name: New
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.partycode,
                       a.partyname,
                       A.QUARTERLYVERIFICATIONUSERCODE,
                       b.Bossusername,
                       getTrialBalancePosition(a.PartyCode) As currentposition,
                       a.partytypecode,
                       c.AccountLevel,
                       c.openingamount,
                       c.q1debitamount,
                       c.q1creditamount,
                       c.q2debitamount,
                       c.q2creditamount,
                       c.q3debitamount,
                       c.q3creditamount,
                       c.q4debitamount,
                       c.q4creditamount,
                       Case
                         When A.PARTYTYPECODE != 'ACCOUNTGROUP' Then
                          99999
                         Else
                          c.accountlevel
                       End colorlevel
                
                --CASE WHEN nvl(:P493_LedgerOnly,'NO') = 'NO' and A.partytypecode='ACCOUNTGROUP' and NVL(:P493_WITHINDENT,'NO') = 'YES' then
                /*CASE WHEN  A.partytypecode='ACCOUNTGROUP' and NVL(:P493_WITHINDENT,'NO') = 'YES' then
                  
                      '<B>'||'<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||401||':'||:APP_SESSION||'::::'||'P493_ACCOUNTCODE,P493_FROMDATE,P493_ACCOUNTLEVEL,P493_ACCOUNTCODE,P493_TODATE,P493_WITHINDENT'||':'||A.PARTYCODE||','||nvl(:P493_FROMDATE,:P400_FROMDATE)||','||C.ACCOUNTLEVEL ||','||A.PARTYCODE||','||NVL(:P493_TODATE,:P400_TODATE)||','||'YES'||':NO')||'">'||rpad('-',2 * (C.AccountLevel),'-')  || A.PARTYNAME||'</a>'||'</b>'
                 
                   WHEN   A.partytypecode='ACCOUNTGROUP' and NVL(:P493_WITHINDENT,'NO') = 'NO' then
                 
                      '<B>'||'<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||401||':'||:APP_SESSION||'::::'||'P493_ACCOUNTCODE,P493_FROMDATE,P493_ACCOUNTLEVEL,P493_ACCOUNTCODE,P493_TODATE,P493_WITHINDENT'||':'||A.PARTYCODE||','||nvl(:P493_FROMDATE,:P400_FROMDATE)||','||C.ACCOUNTLEVEL ||','||A.PARTYCODE||','||NVL(:P493_TODATE,:P400_TODATE)||','||'YES'||':NO')||'">'||A.PARTYNAME||'</a>'||'</b>'
                 
                   WHEN  A.partytypecode ! ='ACCOUNTGROUP' and NVL(:P493_WITHINDENT,'NO') = 'YES' then
                     --  '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':141:'||:APP_SESSION||'::'||'P141_fromdate:'|| c.fromdate||':'||'P141_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||a.partyname||'</a>'  
                      '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':11:'||:APP_SESSION||'::'||'P11_fromdate:'|| c.fromdate||':'||'P11_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||rpad('-',2 * (C.AccountLevel ),'-')  || A.PARTYNAME||'</a>'
                 
                   WHEN  A.partytypecode ! ='ACCOUNTGROUP' and NVL(:P493_WITHINDENT,'NO') = 'NO' then
                     --  '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':141:'||:APP_SESSION||'::'||'P141_fromdate:'|| c.fromdate||':'||'P141_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||a.partyname||'</a>'  
                      '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':11:'||:APP_SESSION||'::'||'P11_fromdate:'|| c.fromdate||':'||'P11_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||A.PARTYNAME||'</a>'
                end ACCOUNTNAMEDISPLAY
                */
                  From Party a,
                       (Select b.LocationCode,
                               b.CompanyCode,
                               a.AccountCode,
                               b.FromDate,
                               b.ToDate,
                               b.IncludeChild,
                               b.creator,
                               a.AccountLevel,
                               a.TrialBalancePosition,
                               --b.financialyearcode,
                               Sum(nvl(b.openingamount, 0)) As OpeningAmount,
                               Sum(nvl(b.q1debitamount, 0)) As q1debitamount,
                               Sum(nvl(b.q1creditamount, 0)) As q1creditamount,
                               Sum(nvl(b.q2debitamount, 0)) As q2debitamount,
                               Sum(nvl(b.q2creditamount, 0)) As q2creditamount,
                               Sum(nvl(b.q3debitamount, 0)) As q3debitamount,
                               Sum(nvl(b.q3creditamount, 0)) As q3creditamount,
                               Sum(nvl(b.q4debitamount, 0)) As q4debitamount,
                               Sum(nvl(b.q4creditamount, 0)) As q4creditamount
                          From MyAccountIncludeRevised a, TRIALBALANCEQUARTER b
                         Where a.ChildCode = b.AccountCode
                           And NVL(A.LOCATIONCODE, 'NULL') = NVL(B.LOCATIONCODE, 'NULL')
                              
                           And a.CompanyCode = b.CompanyCode
                           And a.FromDate = b.FromDate
                           And a.ToDate = b.ToDate
                           And a.Creator = b.Creator
                           And a.fromdate = :P493_FROMDATE
                           And a.todate = :P493_TODATE
                        
                         Group By b.LocationCode,
                                  b.CompanyCode,
                                  a.AccountCode,
                                  b.FromDate,
                                  b.ToDate,
                                  b.IncludeChild,
                                  b.creator,
                                  
                                  a.AccountLevel,
                                  a.TrialBalancePosition
                        
                        ) c,
                       Bossuser b
                 Where 1 = 1
                   And a.QUARTERLYVERIFICATIONUSERCODE = b.bossusercode(+)
                   And C.CREATOR = '&APP_USER.'
                   And a.PartyCode = c.AccountCode
                
                  
                ---
                
                and (
                     exists (
                           select
                                aa.ChildCode
                           from MyAccountIncludeRevised aa
                           where aa.CompanyCode = :P493_CompanyCode
                               and aa.FromDate = :P493_FromDate
                               and aa.ToDate = :P493_ToDate
                               and nvl(aa.LocationCode, 'NULL') = nvl(:P493_LocationCode, 'NULL')
                               and aa.AccountCode = :P493_AccountCode
                
                               and (:P493_ACCOUNTCODE is null or aa.AccountCode = :P493_AccountCode)
                               and aa.ChildCode = a.PartyCode
                     )
                     or
                     :P493_AccountCode is null
                )
                
                and ( 
                     nvl(:P493_LedgerOnly,'NO') = 'YES'          
                     or
                     c.AccountLevel <= nvl(:P493_AccountLevel,1)
                     
                )
                and ( 
                     nvl(:P493_LedgerOnly,'NO') = 'NO' 
                     OR
                     a.PartyTypeCode != 'ACCOUNTGROUP'
                )
                and (
                     nvl(:P493_IncludeZeroTransaction ,'NO') = 'YES'
                     or ( 
                         nvl(c.Q1DEBITAMOUNT,0) != 0
                         or
                         nvl(c.Q1CreditAmount,0) != 0
                         or
                         nvl(c.Q2DebitAmount,0) != 0
                         or
                         nvl(c.Q2CreditAmount,0) != 0
                         or
                         nvl(c.Q3DebitAmount,0) != 0
                         or
                         nvl(c.Q3CreditAmount,0) != 0
                         or
                         nvl(c.Q4CreditAmount,0) != 0
                         or
                         nvl(c.Q4CreditAmount,0) != 0
                     )     
                )
                
                 and c.FromDate = '&P493_FROMDATE.'--TO_DATE(:P493_FROMDATE,'DD-MM-RRRR')
                 and c.ToDate = '&P493_TODATE.'--TO_DATE(:P493_TODATE,'DD-MM-RRRR')
                
                and c.CompanyCode = :P493_COMPANYCODE
                 and ( :P493_LOCATIONCODE is null or c.locationcode = :P493_LOCATIONCODE)
                
                --ORDER BY getTrialBalancePosition(a.PartyCode), a.PartyName
                
                ```
            pageItemsToSubmit: [
                P493_FROMDATE
                P493_TODATE
                P493_WITHINDENT
                P493_LEDGERONLY
                P493_NARRATION
                P493_PRINTDRCR
                P493_LOCATIONCODE
                P493_ACCOUNTCODE
                P493_INCLUDECHILD
                P493_INCLUDEZEROTRANSACTION
                P493_NEW
                P493_REPORTTITLE
                P493_DIVISIONWISE
                P493_ACCOUNTLEVEL
                P493_DETAILLEVEL
                P493_EXCLUDE0CLOSING
                P493_COMPANYCODE
                P493_FINANCIALYEARCODE
                P493_QTR1END
                P493_QTR2END
                P493_QTR3END
                P493_QTR4END
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
