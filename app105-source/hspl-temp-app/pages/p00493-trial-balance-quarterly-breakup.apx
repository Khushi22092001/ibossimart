            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action show-spinner (
            name: show spinner
            action: executeJsCode
            settings {
                jsCode: var lSpinner$ = apex.util.showSpinner( $( "#td" ) );
            }
