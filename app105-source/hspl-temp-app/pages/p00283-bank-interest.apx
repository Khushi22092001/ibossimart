            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: ACCOUNTNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
