page 283 (
    name: Bank Interest
    alias: BANK-INTEREST
    title: Bank Interest
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bank-interest (
        name: Bank Interest
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                a.SNo AS SERIALNO,
                a.ForDate as FromDate,
                a.AccountCode,
                getPartyName(a.AccountCode) as AccountName,
                a.Balance,
                a.InterestAmount,
                a.ODInterestAmount,
                (a.InterestAmount + a.ODInterestAmount) as Total,
                a.LimitAmount as CClimit,
                a.InterestRate as Interest,
                a.ODInterestRate as ODInterest
                from BankInterestReport a   
                where a.FromDate =  :P283_FROMDATE 
                and a.ToDAte = :P283_TODATE
                and a.AccountCode = :P283_ACCOUNT
                and a.CompanyCode = :P283_COMPANYCODE
                
                
                /*
                Select 
                rOWNUM AS SERIALNO,
                a.FromDate,
                a.AccountCode,
                a.AccountName,
                a.DateOnward,
                a.Balance,
                a.InterestAmount,
                a.ODInterestAmount,
                (a.InterestAmount + a.ODInterestAmount) as Total,
                a.Limit as CClimit,
                a.Interest,
                a.ODInterest
                
                
                From (Select 
                a.FromDate,
                a.AccountCode,
                a.AccountName,
                a.DateOnward,
                a.Balance,
                a.Interest,
                a.ODInterest,
                Nvl(a.Limit,0) as Limit,
                Case When a.Balance > a.Limit then
                Nvl(a.Limit,0) * Nvl(a.Interest,0) / 36500
                else
                Nvl(a.Balance,0) * Nvl(a.Interest,0) / 36500
                end as InterestAmount,
                Case When a.Balance > a.Limit then
                (Nvl(a.Balance,0)- Nvl(a.Limit,0)) * (Nvl(a.ODInterest,0)+ Nvl(a.Interest,0)) / 36500
                else
                0
                end as ODInterestAmount
                
                
                from 
                
                
                (Select 
                a.FromDate,
                b.AccountCode,
                c.PartyName as AccountName,
                b.DateOnward,
                GetAccountClosingasonRD(b.AccountCode,:P283_COMPANYCODE,:P283_FROMDATE,'NO') as Balance,
                Case When GetAccountClosingasonRD(b.AccountCode,:P283_COMPANYCODE,:P283_FROMDATE,'NO') > 0 Then 
                Nvl(b.CrInterestRate,0) else
                Nvl(b.DrInterestRate,0) end as Interest,
                Case When GetAccountClosingasonRD(b.AccountCode,:P283_COMPANYCODE,:P283_FROMDATE,'NO') > 0 Then 
                Nvl(b.CrODInterestRate,0) else
                Nvl(b.DrODInterestRate,0) end as ODInterest,
                Case When GetAccountClosingasonRD(b.AccountCode,:P283_COMPANYCODE,:P283_FROMDATE,'NO') > 0 Then 
                Nvl(b.CrCCLimit,0) else
                Nvl(b.DrCCLimit,0) end as Limit
                From
                
                (Select Rownum as Sno, a.DayDate As FromDate from DateList a 
                Where a.DayDate Between :P283_FROMDATE and :P283_TODATE ) a,InterestRate b, Party C
                Where b.DateOnWard < :P283_TODATE
                and b.AccountCode = c.PartyCode
                and (:P283_ACCOUNT is Null Or Instr (':' || :P283_ACCOUNT || ':' , ':' || b.AccountCode || ':') > 0)
                and (:P283_COMPANYCODE is Null Or Instr (':' || :P283_COMPANYCODE || ':' , ':' || b.CompanyCode || ':') > 0)) a) a;
                
                */
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                   
                ```
        }
        advanced {
            savedReportMappingIdentifier: 14700294166236620
        }

        savedReport 154580 (
            visibility: primary
            view {
                default: grid
                settingsAreaExpanded: false
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @SERIALNO
                layout {
                    width: 99.375
                    sequence: 1
                }
            )

            displayColumn (
                column: @FROMDATE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ACCOUNTCODE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @ACCOUNTNAME
                layout {
                    width: 217
                    sequence: 4
                }
            )

            displayColumn (
                column: @BALANCE
                layout {
                    width: 85
                    sequence: 6
                }
            )

            displayColumn (
                column: @INTERESTAMOUNT
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @ODINTERESTAMOUNT
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @TOTAL
                layout {
                    width: 89
                    sequence: 9
                }
            )

            displayColumn (
                column: @CCLIMIT
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @INTEREST
                layout {
                    width: 91
                    sequence: 11
                }
            )

            displayColumn (
                column: @ODINTEREST
                layout {
                    sequence: 12
                }
            )

            sort (
                column: @SERIALNO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            aggregate count (
                column: @FROMDATE
                function: count
            )

            aggregate sum (
                column: @INTERESTAMOUNT
                showGrandTotal: true
            )

            aggregate sum-2 (
                column: @ODINTERESTAMOUNT
                showGrandTotal: true
            )

            aggregate sum-3 (
                column: @TOTAL
                showGrandTotal: true
            )

        )

        column ACCOUNTCODE (
            type: textField
