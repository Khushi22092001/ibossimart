    pageItem P283_ACCOUNT (
        type: popupLov
        label {
            label: Account
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select PartyName D,
                PartyCode R 
                from Party 
                where PartyTypeCode in( 'ACCOUNTRESERVE','BANK');
                ```
        }
        layout {
            sequence: 40
            region: @bank-interest
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P283_COMPANYCODE (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct 
                CompanyName D,
                CompanyCode R
                From Company;
                ```
        }
        layout {
            sequence: 30
            region: @bank-interest
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P283_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @bank-interest
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P283_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @bank-interest
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button prepare (
        buttonName: Prepare
        label: Preapre
        layout {
            sequence: 10
            region: @bank-interest
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 20
            region: @bank-interest
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_2
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @prepare
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: PrepareBankInterest(:P283_ACCOUNT, :P283_COMPANYCODE, :P283_FROMDATE, :P283_TODATE);
                itemsToSubmit: [
                    P283_FROMDATE
                    P283_TODATE
                    P283_COMPANYCODE
                    P283_ACCOUNT
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

