            .hs-shortcuts tbody{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 12px}.hs-shortcut-card{--shortcut-accent:#6554e8;--shortcut-soft:#f3f1ff;position:relative;min-width:0;min-height:58px;border:1px solid #e5e7f1;border-radius:11px;background:linear-gradient(135deg,var(--shortcut-soft),#fff 76%);overflow:hidden;transition:border-color .15s ease,box-shadow .15s ease,transform .15s ease}.hs-shortcut-card.c2{--shortcut-accent:#1587bd;--shortcut-soft:#eef8ff}.hs-shortcut-card.c3{--shortcut-accent:#26a269;--shortcut-soft:#eefaf3}.hs-shortcut-card.c4{--shortcut-accent:#e18a1c;--shortcut-soft:#fff8ed}.hs-shortcut-card.c5{--shortcut-accent:#d95473;--shortcut-soft:#fff2f5}.hs-shortcut-card.c6{--shortcut-accent:#0a9e9c;--shortcut-soft:#eefafa}.hs-shortcut-card:hover{border-color:color-mix(in srgb,var(--shortcut-accent) 40%,#dfe3ec);box-shadow:0 7px 16px rgba(38,52,85,.08);transform:translateY(-1px)}.hs-shortcut-link{display:flex;align-items:center;gap:10px;min-height:58px;padding:8px 12px;color:#25304e;text-decoration:none}.hs-shortcut-link:after{content:'\f105';margin-left:auto;font-family:"Font APEX Small";color:#53617e;font-size:14px}.hs-shortcut-link:hover,.hs-shortcut-link:focus{color:var(--shortcut-accent);outline:0}.hs-shortcut-link .fa{display:grid;place-items:center;width:32px;height:32px;flex:0 0 auto;border-radius:9px;background:#fff;color:var(--shortcut-accent);box-shadow:0 3px 10px rgba(48,56,92,.08)}.hs-shortcut-link b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11.5px;line-height:1.25}.hs-shortcut-link.is-empty{color:#8b93a6}.hs-shortcut-editor{display:none;padding:7px}.hs-shortcut-editing .hs-shortcut-link{display:none}.hs-shortcut-editing .hs-shortcut-editor{display:block}.hs-shortcut-select-col{width:100%!important;max-width:none!important;padding:0!important}.hs-shortcut-editor .t-Form-fieldContainer,.hs-shortcut-editor .t-Form-inputContainer,.hs-shortcut-editor .t-Form-itemWrapper,.hs-shortcut-editor select{width:100%!important;max-width:none!important;margin:0!important}.hs-shortcut-editor .t-Form-labelContainer{display:none!important}.hs-shortcut-editor select{height:42px!important;min-height:42px!important;border:1px solid #d8ddeb!important;border-radius:9px!important;background-color:#fff!important;font-size:11px!important}
            #sampleEditShortcuts{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;min-height:34px!important;padding:0 13px!important;border:1px solid #dcd8ff!important;border-radius:9px!important;background:#f7f5ff!important;color:#5e50d2!important;box-shadow:none!important;font-size:10.5px!important;font-weight:800!important;line-height:1!important;transition:background .15s ease,border-color .15s ease,transform .15s ease!important}#sampleEditShortcuts:hover,#sampleEditShortcuts:focus{border-color:#8a7ff0!important;background:#eeebff!important;color:#493bbd!important;transform:translateY(-1px);outline:0!important}#sampleEditShortcuts .t-Icon--right{display:none!important}#sampleEditShortcuts .t-Icon--left{display:inline-flex!important;margin:0!important;font-size:12px!important}
