    dynamicAction add-task-without-reload (
        name: Add task without page reload
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @add-task
        }

        action confirm-task-added (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.item('P736_TASK_TEXT').setValue('');
                    apex.item('P736_TASK_DUE').setValue('');
                    apex.item('P736_TASK_PRIORITY').setValue('MEDIUM');
                    $('#P736_TASK_TEXT').trigger('input');
                    apex.message.showPageSuccess('Task added.');
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action refresh-task-list (
            action: refresh
            affectedElements {
                selectionType: region
                region: @my-tasks
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action save-task (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    Declare
                      lText Varchar2(3900):=trim(regexp_replace(:P736_TASK_TEXT,'[[:space:]]+',' '));
                      lWords PLS_INTEGER;
                      lSaved Boolean:=False;
                    Begin
                      If lText Is Null Then
                        raise_application_error(-20001,'Enter a task note.');
                      End If;
                      lWords:=regexp_count(lText,'[^[:space:]]+');
                      If lWords>100 Then
                        raise_application_error(-20004,'Task note can contain a maximum of 100 words.');
                      End If;
                      For i In 1..10 Loop
                        If apex_util.get_preference('HS_HOME_TASK_TEXT_'||i) Is Null Then
                          apex_util.set_preference('HS_HOME_TASK_TEXT_'||i,lText);
                          apex_util.set_preference('HS_HOME_TASK_DUE_'||i,:P736_TASK_DUE);
                          apex_util.set_preference('HS_HOME_TASK_PRIORITY_'||i,nvl(:P736_TASK_PRIORITY,'MEDIUM'));
                          lSaved:=True;
                          Exit;
                        End If;
                      End Loop;
                      If Not lSaved Then
                        raise_application_error(-20002,'Maximum 10 active tasks reached. Complete one task before adding another.');
                      End If;
                      :P736_TASK_TEXT:=Null;
                      :P736_TASK_DUE:=Null;
                      :P736_TASK_PRIORITY:='MEDIUM';
                    End;
                    ```
                itemsToSubmit: [
                    P736_TASK_TEXT
                    P736_TASK_DUE
                    P736_TASK_PRIORITY
                ]
                itemsToReturn: [
                    P736_TASK_TEXT
                    P736_TASK_DUE
                    P736_TASK_PRIORITY
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction complete-task-without-reload (
        name: Complete task without page reload
        execution {
            sequence: 20
            eventScope: dynamic
            staticContainer: body
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .hs-task-complete
        }

        action capture-task-slot (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    this.browserEvent.preventDefault();
                    apex.item('P736_TASK_SLOT').setValue(this.triggeringElement.dataset.slot);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action confirm-task-complete (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Task completed and removed.');
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action refresh-after-complete (
            action: refresh
            affectedElements {
                selectionType: region
                region: @my-tasks
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action remove-task-preference (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    Declare
                      lSlot PLS_INTEGER:=to_number(:P736_TASK_SLOT Default Null On Conversion Error);
                    Begin
                      If lSlot Between 1 And 10 Then
                        apex_util.set_preference('HS_HOME_TASK_TEXT_'||lSlot,null);
                        apex_util.set_preference('HS_HOME_TASK_DUE_'||lSlot,null);
                        apex_util.set_preference('HS_HOME_TASK_PRIORITY_'||lSlot,null);
                      Else
                        raise_application_error(-20003,'The selected task is no longer available.');
                      End If;
                      :P736_TASK_SLOT:=Null;
                    End;
                    ```
                itemsToSubmit: P736_TASK_SLOT
                itemsToReturn: P736_TASK_SLOT
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction save-shortcuts-without-reload (
        name: Save shortcuts without page reload
        execution {
            sequence: 5
        }
        when {
            event: click
            selectionType: button
            button: @save-shortcuts
        }

        action confirm-shortcuts-saved (
            action: executeJsCode
            settings {
                jsCode: apex.message.showPageSuccess('Shortcuts saved.');
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action persist-shortcut-preferences (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    Declare
                      Procedure SaveOne(pName Varchar2,pValue Varchar2) Is
                        lOk Number;
                      Begin
                        If pValue Is Null Then
                          apex_util.set_preference(pName,null);
                          Return;
                        End If;
                        Select Count(*) Into lOk
                          From apex_application_pages a
                         Where a.application_id=:APP_ID
                           And to_char(a.page_id)=pValue
                           And a.page_id Not In (1,162,736,9999)
                           And GetApexReportPrivilege_varchar('1',a.page_id,:APP_USER)='True';
                        If lOk=0 Then
                          raise_application_error(-20003,'A selected shortcut is not available to this user.');
                        End If;
                        apex_util.set_preference(pName,pValue);
                      End;
                    Begin
                      SaveOne('HS_HOME_SHORTCUT_1',:P736_SHORTCUT_1);
                      SaveOne('HS_HOME_SHORTCUT_2',:P736_SHORTCUT_2);
                      SaveOne('HS_HOME_SHORTCUT_3',:P736_SHORTCUT_3);
                      SaveOne('HS_HOME_SHORTCUT_4',:P736_SHORTCUT_4);
                      SaveOne('HS_HOME_SHORTCUT_5',:P736_SHORTCUT_5);
                      SaveOne('HS_HOME_SHORTCUT_6',:P736_SHORTCUT_6);
                    End;
                    ```
                itemsToSubmit: [
                    P736_SHORTCUT_1
                    P736_SHORTCUT_2
                    P736_SHORTCUT_3
                    P736_SHORTCUT_4
                    P736_SHORTCUT_5
                    P736_SHORTCUT_6
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-shortcut-cards (
            action: refresh
            affectedElements {
                selectionType: region
                region: @my-shortcuts
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action restore-inline-editors (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (window.hsHomeShortcuts) {
                        window.hsHomeShortcuts.close();
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

