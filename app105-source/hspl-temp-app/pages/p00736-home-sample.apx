page 736 (
    name: Home
    alias: HOME-SAMPLE
    title: Home
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            apex.jQuery(function($){
              var d=new Date(),h=d.getHours(),g=h<12?'Good morning':h<17?'Good afternoon':'Good evening';
              $('#hsGreeting').text(g+', &APP_USER.');
              $('#hsToday').text(d.toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}));
              $('#hsNow').text(d.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}));
              function restoreShortcutEditors(){
                for(var i=1;i<=6;i++){
                  var $col=$('#P736_SHORTCUT_'+i+'_CONTAINER').closest('.col'),$origin=$('#hsShortcutOrigin'+i);
                  if($col.length&&$origin.length){$col.removeClass('hs-shortcut-select-col').insertBefore($origin);}
                }
              }
              function closeShortcutEditors(){
                restoreShortcutEditors();
                $('body').removeClass('hs-shortcut-editing');
                $('#sampleEditShortcuts').attr('aria-expanded','false').find('.t-Button-label').text('Edit Shortcuts');
                $('#sampleInlineSave').remove();
              }
              function openShortcutEditors(){
                $('body').addClass('hs-shortcut-editing');
                for(var i=1;i<=6;i++){
                  var $col=$('#P736_SHORTCUT_'+i+'_CONTAINER').closest('.col');
                  if(!$col.length){continue;}
                  if(!$('#hsShortcutOrigin'+i).length){$col.after('<span hidden id="hsShortcutOrigin'+i+'"></span>');}
                  $col.addClass('hs-shortcut-select-col').appendTo('.hs-shortcut-editor[data-slot="'+i+'"]');
                }
                $('#sampleEditShortcuts').attr('aria-expanded','true').find('.t-Button-label').text('Cancel');
                if(!$('#sampleInlineSave').length){
                  $('<button type="button" id="sampleInlineSave" class="hs-inline-save"><span class="fa fa-check"></span><span>Save changes</span></button>').insertAfter('#sampleEditShortcuts');
                }
              }
              window.hsHomeShortcuts={restore:restoreShortcutEditors,close:closeShortcutEditors,open:openShortcutEditors};
              $(document).on('click','#sampleEditShortcuts',function(e){
                e.preventDefault();
                $('body').hasClass('hs-shortcut-editing')?closeShortcutEditors():openShortcutEditors();
              });
              $(document).on('click','#sampleInlineSave',function(e){e.preventDefault();$('#sampleSaveShortcuts').trigger('click');});
              $(document).on('click','.hs-task-expand',function(){
                var copy=$(this).closest('.hs-task-copy'),open=!copy.hasClass('is-expanded');
                copy.toggleClass('is-expanded',open);
                $(this).attr('aria-expanded',open).text(open?'Collapse':'View full task');
              });
              var syncTaskWordLimit=function(){
                var $task=$('#P736_TASK_TEXT');
                if(!$task.length){return;}
                if(!$('#hsTaskWordLimit').length){
                  $task.attr('aria-describedby','hsTaskWordLimit');
                  $task.closest('.t-Form-inputContainer').append('<div class="hs-task-limit" id="hsTaskWordLimit"><span>0</span>/100 words</div>');
                }
                var text=$task.val().trim(),parts=text?text.split(/\s+/):[],$limit=$('#hsTaskWordLimit');
                if(parts.length>100){
                  $task.val(parts.slice(0,100).join(' '));
                  parts=parts.slice(0,100);
                }
                $limit.toggleClass('is-max',parts.length===100).find('span').text(parts.length);
              };
              $(document).on('input','#P736_TASK_TEXT',syncTaskWordLimit);
              $(document).on('apexafterrefresh','#hsMyTasks',syncTaskWordLimit);
              syncTaskWordLimit();
            });
            ```
    }
    css {
        inline:
            ```css
            body:has(.hs-sample-home){background:#f7f8fc}
            #t_Body_title{display:none!important}
            body:has(.hs-sample-home) .t-Body-contentInner{padding:16px 18px 28px!important}
            .hs-welcome{position:relative;min-height:244px;overflow:hidden;padding:30px 36px;border:1px solid #e5e7f3;border-radius:18px;background:#fff url("#APP_FILES#home-welcome-banner.webp") center/cover no-repeat;box-shadow:0 8px 25px rgba(34,46,80,.06)}
            .hs-welcome-copy{position:relative;z-index:1;max-width:560px}
            .hs-greeting{display:flex;align-items:center;gap:10px;color:#344066;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
            .hs-sun{display:grid;place-items:center;width:42px;height:42px;border-radius:12px;background:#fff0f0;color:#ff6b6b;font-size:18px}
            .hs-welcome h1{margin:12px 0 5px;font-size:28px;line-height:1.15;color:#101936;letter-spacing:-.025em}
            .hs-welcome p{margin:0;color:#58647f;font-size:13px}
            .hs-dayfacts{display:flex;gap:12px;margin-top:24px}
            .hs-dayfact{display:flex;align-items:center;gap:12px;min-width:190px;padding:12px 14px;border:1px solid #e8ebf4;border-radius:12px;background:rgba(255,255,255,.88);box-shadow:0 4px 12px rgba(22,33,64,.05)}
            .hs-dayfact .fa{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#f0efff;color:#6554e8;font-size:16px}
            .hs-dayfact b{display:block;color:#1d2848;font-size:12px}.hs-dayfact small{display:block;margin-top:2px;color:#7a849c;font-size:10.5px}
            .hs-section{margin-top:16px!important;border:1px solid #e4e8f1!important;border-radius:16px!important;background:#fff!important;box-shadow:0 6px 20px rgba(38,52,85,.05)!important;overflow:hidden}
            .hs-section .t-Region-header{min-height:52px;border-bottom:1px solid #edf0f5!important;background:#fff!important}
            .hs-section .t-Region-title{font-size:14px!important;font-weight:800!important;color:#18213d!important}
            .hs-section .t-Region-body{padding:16px 18px 18px!important}
            .hs-section .t-Region-headerItems--buttons .t-Icon--right{display:none!important}
            .hs-quick .t-Report-report,.hs-shortcuts .t-Report-report,.hs-tasks .t-Report-report{width:100%}
            .hs-quick thead,.hs-shortcuts thead,.hs-tasks thead{display:none}
            .hs-quick tbody{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
            .hs-quick tbody tr,.hs-quick td,.hs-shortcuts tbody tr,.hs-shortcuts td,.hs-tasks tbody tr,.hs-tasks td{display:block!important;padding:0!important;border:0!important;background:transparent!important}
            .hs-access-card{display:flex;align-items:center;gap:12px;min-height:68px;padding:11px 14px;border:1px solid var(--card-line,#dcebe2);border-radius:12px;background:var(--card-bg,#f6fbf8);color:#15203b;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease}
            .hs-access-card:hover,.hs-access-card:focus{transform:translateY(-2px);box-shadow:0 8px 18px rgba(39,55,92,.10);border-color:var(--card-accent,#4cb779);outline:0}
            .hs-access-ic{display:grid;place-items:center;width:40px;height:40px;flex:0 0 auto;border-radius:50%;background:var(--card-icbg,#e6f6ec);color:var(--card-accent,#24a260);font-size:17px}
            .hs-access-card b{font-size:12px;line-height:1.3}.hs-access-go{margin-left:auto;color:#455473;font-size:16px}
            .hs-access-card.c2{--card-bg:#fff9f1;--card-line:#f4e5ce;--card-icbg:#fff0db;--card-accent:#ed8b1c}.hs-access-card.c3{--card-bg:#fff7f8;--card-line:#f3e0e4;--card-icbg:#ffe9ed;--card-accent:#e85d78}.hs-access-card.c4{--card-bg:#f6f8ff;--card-line:#e1e6f6;--card-icbg:#e8f1ff;--card-accent:#3485dc}.hs-access-card.c5{--card-bg:#f8f6ff;--card-line:#e7e0f5;--card-icbg:#eee9ff;--card-accent:#7658e8}.hs-access-card.c6{--card-bg:#f2fbfb;--card-line:#d9eeee;--card-icbg:#def6f5;--card-accent:#10a3a3}.hs-access-card.c7{--card-bg:#f4fbf6;--card-line:#dcecdf;--card-icbg:#e4f6e8;--card-accent:#32a852}.hs-access-card.c8{--card-bg:#fafafa;--card-line:#e6e8ec;--card-icbg:#eef0f4;--card-accent:#5c6578}
            .row:has(.hs-shortcuts):has(.hs-tasks){align-items:stretch!important}.row:has(.hs-shortcuts):has(.hs-tasks)>.col{display:flex!important}.row:has(.hs-shortcuts):has(.hs-tasks) .hs-shortcuts,.row:has(.hs-shortcuts):has(.hs-tasks) .hs-tasks{width:100%;height:100%}
