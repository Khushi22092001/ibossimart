            .hs-approval .t-Region-title{display:flex;align-items:center;gap:9px}.hs-approval .t-Region-title:before{content:'\f0e3';display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:#fff2e5;color:#d66a08;font-family:"Font APEX Small";font-size:13px;font-weight:400}.hs-approval .t-Report-report{width:100%}.hs-approval thead{display:none}.hs-approval tbody{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.hs-approval tbody tr,.hs-approval td{display:block!important;padding:0!important;border:0!important;background:transparent!important}.hs-approval-card{display:flex;min-height:76px;align-items:center;gap:11px;padding:11px 12px;border:1px solid #e8e4dc;border-radius:12px;background:linear-gradient(135deg,#fffaf4,#fff);color:#202943;text-decoration:none;transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease}.hs-approval-card:hover,.hs-approval-card:focus{transform:translateY(-2px);border-color:#efb36f;box-shadow:0 8px 18px rgba(108,65,17,.09);outline:0}.hs-approval-ic{display:grid;place-items:center;width:38px;height:38px;flex:0 0 auto;border-radius:11px;background:#fff0df;color:#d66a08;font-size:15px}.hs-approval-copy{min-width:0}.hs-approval-copy b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px}.hs-approval-copy small{display:block;overflow:hidden;margin-top:3px;color:#788197;font-size:9.5px;line-height:1.25}.hs-approval-age{margin-left:auto;padding:3px 6px;border-radius:999px;background:#fff0df;color:#a64d00;font-size:9px;font-weight:800;white-space:nowrap}.hs-approval button[data-otel-label='OPEN_APPROVALS']{min-height:34px;border:1px solid #f0d1ae!important;border-radius:9px!important;background:#fff8ef!important;color:#b75b06!important;font-size:10.5px!important;font-weight:800!important;box-shadow:none!important}.hs-approval button[data-otel-label='OPEN_APPROVALS']:hover{background:#fff0df!important}.hs-approval button[data-otel-label='OPEN_APPROVALS'] .t-Icon--right{display:none!important}.hs-approval-empty{overflow:hidden;border:1px solid #e6e8f0;border-radius:12px;background:#fff}.hs-approval-empty-head{display:grid;grid-template-columns:1.3fr 1fr 100px 90px;gap:12px;padding:10px 14px;background:#f3f3fb;color:#6664d8;font-size:9px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}.hs-approval-empty-body{display:flex;align-items:center;justify-content:center;gap:13px;min-height:94px;padding:18px;color:#788197}.hs-approval-empty-art{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#fff3e6;color:#d66a08;font-size:20px}.hs-approval-empty-body b{display:block;color:#26304b;font-size:12px}.hs-approval-empty-body small{display:block;margin-top:3px;font-size:10px}
            #sampleShortcutConfig{display:none!important}#sampleSaveShortcuts{display:none!important}.hs-shortcut-header-actions{display:inline-flex;align-items:center;gap:7px}.hs-inline-save{display:inline-flex;align-items:center;gap:6px;min-height:34px;padding:0 13px;border:1px solid #6554e8;border-radius:9px;background:#6554e8;color:#fff;font-size:10.5px;font-weight:800;cursor:pointer}.hs-inline-save:hover,.hs-inline-save:focus{background:#5042c7;outline:0}.hs-empty{padding:16px;text-align:center;color:#7b8498;font-size:11px}.hs-tasks .nodatafound{display:block!important}.hs-task-empty{display:flex;align-items:center;justify-content:center;gap:13px;min-height:82px;margin-top:8px;padding:15px;border:1px dashed #dfe3ec;border-radius:11px;background:linear-gradient(135deg,#fbfbff,#fff);color:#737e96}.hs-task-empty-art{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#f0edff;color:#6957e8;font-size:19px}.hs-task-empty b{display:block;color:#26304b;font-size:11.5px}.hs-task-empty small{display:block;margin-top:3px;font-size:9.5px}.hs-task-legend{display:flex;justify-content:center;gap:18px;margin-top:9px;color:#7b8498;font-size:9px}.hs-task-legend span:before{content:'';display:inline-block;width:7px;height:7px;margin-right:5px;border-radius:50%;background:#3d8ee6}.hs-task-legend .medium:before{background:#f59e0b}.hs-task-legend .high:before{background:#ef476f}
            @media(max-width:1100px){.hs-quick tbody{grid-template-columns:repeat(3,minmax(0,1fr))}.hs-approval tbody{grid-template-columns:repeat(3,minmax(0,1fr))}.hs-welcome{background-position:62% center}}
            @media(max-width:900px){.hs-tasks .t-Region-body>.container>.row{grid-template-columns:minmax(0,1fr) 150px}.hs-tasks button[data-otel-label='ADD_TASK']{width:100%}.hs-task-row{grid-template-columns:1fr}.hs-task-complete{justify-self:start}#sampleShortcutConfig .t-Region-body>.container>.row{grid-template-columns:repeat(2,minmax(0,1fr))}}
            @media(max-width:760px){body:has(.hs-sample-home) .t-Body-contentInner{padding:10px!important}.hs-welcome{padding:22px;min-height:280px;background-position:70% center}.hs-welcome-copy{max-width:90%}.hs-dayfacts{flex-direction:column}.hs-dayfact{min-width:0}.hs-quick tbody{grid-template-columns:1fr 1fr}.hs-approval tbody{grid-template-columns:1fr}.hs-shortcuts tbody{grid-template-columns:1fr}.hs-tasks .t-Region-body>.container>.row,#sampleShortcutConfig .t-Region-body>.container>.row{grid-template-columns:1fr!important}.hs-tasks .t-Region-body>.container>.row>.col:last-child{grid-column:auto}.hs-task-complete{width:100%}}
            ```
    }
    security {
        formAutoComplete: false
    }

    region approval (
        name: Approval
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Q As (
                  Select q.*,
                         Row_Number() Over(Order By q.QueueDate Nulls Last,q.TNo) rn
                    From ONTHETABLE_APEX q)
                Select '<a class="hs-approval-card" href="'
                       ||apex_escape.html_attribute(apex_page.get_url(p_page=>737,p_clear_cache=>'737'))||'">'
                       ||'<span class="hs-approval-ic"><span class="fa fa-gavel"></span></span>'
                       ||'<span class="hs-approval-copy"><b>'||apex_escape.html(Nvl(ModuleName,'Approval'))||'</b>'
                       ||'<small>'||apex_escape.html(Nvl(MenuLabel,'Work item #'||ModuleTNo))||'</small></span>'
                       ||'<span class="hs-approval-age">'||Case When QueueDate Is Null Then 'Waiting'
                              When trunc(sysdate-QueueDate)=0 Then 'Today'
                              Else trunc(sysdate-QueueDate)||'d' End||'</span></a>' Card
                  From Q
                 Where rn<=5
                 Order By rn
                ```
        }
        layout {
            sequence: 25
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                hs-section
                hs-approval
            ]
        }
        advanced {
            htmlDomId: hsHomeApproval
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: <div class="hs-approval-empty"><div class="hs-approval-empty-head"><span>Work item</span><span>Module</span><span>Waiting</span><span>Action</span></div><div class="hs-approval-empty-body"><span class="hs-approval-empty-art"><span class="fa fa-check-square-o"></span></span><span><b>No approval is waiting for you</b><small>Your decision queue is clear. New approval requests will appear here.</small></span></div></div>
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region my-shortcuts (
        name: My Shortcuts
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Picks As (
                  Select 1 ord,nvl(apex_util.get_preference('HS_HOME_SHORTCUT_1'),'27') page_id From dual Union All
                  Select 2,nvl(apex_util.get_preference('HS_HOME_SHORTCUT_2'),'37') From dual Union All
                  Select 3,nvl(apex_util.get_preference('HS_HOME_SHORTCUT_3'),'16') From dual Union All
                  Select 4,nvl(apex_util.get_preference('HS_HOME_SHORTCUT_4'),'58') From dual Union All
                  Select 5,nvl(apex_util.get_preference('HS_HOME_SHORTCUT_5'),'73') From dual Union All
                  Select 6,nvl(apex_util.get_preference('HS_HOME_SHORTCUT_6'),'36') From dual)
                Select '<div class="hs-shortcut-card c'||p.ord||'" data-slot="'||p.ord||'">'
                       ||Case When a.page_id Is Not Null Then
                           '<a class="hs-shortcut-link" href="'
                           ||apex_escape.html_attribute(apex_page.get_url(p_page=>a.page_id,p_clear_cache=>to_char(a.page_id)))||'">'
                           ||'<span class="fa fa-bookmark-o"></span><b>'||apex_escape.html(a.page_name)||'</b></a>'
                         Else '<span class="hs-shortcut-link is-empty"><span class="fa fa-plus"></span><b>Choose a page</b></span>' End
                       ||'<div class="hs-shortcut-editor" data-slot="'||p.ord||'"></div></div>' Card
                  From Picks p
                  Left Join apex_application_pages a
                    On a.application_id=:APP_ID
                   And to_char(a.page_id)=p.page_id
                   And GetApexReportPrivilege_varchar('1',a.page_id,:APP_USER)='True'
                 Order By p.ord
                ```
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                hs-section
                hs-shortcuts
            ]
        }
        advanced {
            htmlDomId: hsMyShortcuts
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: <div class="hs-empty">Choose up to six pages using Edit Shortcuts.</div>
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region my-tasks (
        name: My Tasks
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With T As (
                  Select level slot_no,
                         apex_util.get_preference('HS_HOME_TASK_TEXT_'||level) task_text,
                         apex_util.get_preference('HS_HOME_TASK_DUE_'||level) due_text,
                         nvl(apex_util.get_preference('HS_HOME_TASK_PRIORITY_'||level),'MEDIUM') priority_code
                    From dual Connect By level<=10),
                Ranked As (
                  Select slot_no,task_text,due_text,priority_code,
                         row_number() Over (
                           Order By decode(priority_code,'HIGH',1,'MEDIUM',2,'LOW',3,2),
                                    Case When due_text Is Null Then 1 Else 0 End,
                                    to_date(due_text Default Null On Conversion Error,'DD-MM-RRRR'),slot_no) display_no
                    From T
                   Where task_text Is Not Null)
                Select '<div class="hs-task-row is-priority-'||lower(priority_code)
                       ||Case When due_text Is Not Null And to_date(due_text Default Null On Conversion Error,'DD-MM-RRRR')<trunc(sysdate) Then ' is-overdue' End||'">'
                       ||'<span class="hs-task-main"><span class="hs-task-index" title="Task '||display_no||'">'||display_no||'</span><span class="hs-task-copy">'
                       ||'<span class="hs-task-text">'||apex_escape.html(task_text)||'</span>'
                       ||Case When length(task_text)>120 Then '<button type="button" class="hs-task-expand" aria-expanded="false">View full task</button>' End
                       ||'<span class="hs-task-meta '
                       ||Case When due_text Is Null Then 'is-none'
                              When to_date(due_text Default Null On Conversion Error,'DD-MM-RRRR')=trunc(sysdate) Then 'is-today'
                              When to_date(due_text Default Null On Conversion Error,'DD-MM-RRRR')<trunc(sysdate) Then 'is-overdue'
                              Else 'is-future' End||'">'
                       ||Case When due_text Is Null Then 'No due date'
                              When to_date(due_text Default Null On Conversion Error,'DD-MM-RRRR')=trunc(sysdate) Then 'Due today'
                              When to_date(due_text Default Null On Conversion Error,'DD-MM-RRRR')<trunc(sysdate) Then 'Overdue · '||apex_escape.html(due_text)
                              Else 'Due '||apex_escape.html(due_text) End||'</span>'
                       ||'<span class="hs-task-priority is-'||lower(priority_code)||'">'||initcap(lower(priority_code))||'</span></span></span>'
                       ||'<button type="button" class="hs-task-complete" data-slot="'||slot_no||'" title="Mark task completed and remove it">'
                       ||'<span class="fa fa-check-circle-o"></span><span>Task completed</span></button></div>' Row_Html
                  From Ranked
                 Order By display_no
                ```
        }
        layout {
            sequence: 31
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                hs-section
                hs-tasks
            ]
        }
        advanced {
            htmlDomId: hsMyTasks
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: <div class="hs-task-empty"><span class="hs-task-empty-art"><span class="fa fa-list-alt"></span></span><span><b>No personal tasks yet</b><small>Add a task above to stay organised and keep track of what matters.</small></span></div><div class="hs-task-legend"><span>Low</span><span class="medium">Medium</span><span class="high">High</span></div>
        }

        column ROW_HTML (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region quick-access (
        name: Quick Access
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a class="hs-access-card c'||to_char(x.ord)||'" href="'
                       ||apex_escape.html_attribute(apex_page.get_url(p_page=>a.page_id,p_clear_cache=>to_char(a.page_id)))||'">'
                       ||'<span class="hs-access-ic"><span class="fa '||x.icon||'"></span></span>'
                       ||'<b>'||apex_escape.html(a.page_name)||'</b><span class="hs-access-go fa fa-angle-right"></span></a>' Card
                  From (Select 1 ord,27 page_id,'fa-shopping-cart' icon From dual Union All
                        Select 2,37,'fa-truck' From dual Union All
                        Select 3,73,'fa-file-text-o' From dual Union All
                        Select 4,58,'fa-database' From dual Union All
                        Select 5,36,'fa-sign-in' From dual Union All
                        Select 6,28,'fa-clipboard' From dual Union All
                        Select 7,16,'fa-list-alt' From dual Union All
                        Select 8,144,'fa-book' From dual) x
                  Join apex_application_pages a On a.application_id=:APP_ID And a.page_id=x.page_id
                 Where GetApexReportPrivilege_varchar('1',a.page_id,:APP_USER)='True'
                 Order By x.ord
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                hs-section
                hs-quick
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: <div class="hs-empty">No quick-access page is available for your current privileges.</div>
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

