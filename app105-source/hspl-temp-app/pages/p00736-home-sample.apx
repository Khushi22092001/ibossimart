            .hs-task-main{display:grid;grid-template-columns:30px minmax(0,1fr);column-gap:10px;align-items:center}.hs-task-index{display:grid;grid-row:1/3;place-items:center;width:30px;height:30px;border-radius:9px;background:var(--task-soft);color:var(--task-ink);font-size:10px;font-weight:900;font-variant-numeric:tabular-nums}.hs-task-row.is-overdue .hs-task-index{box-shadow:inset 0 0 0 1px rgba(201,45,56,.18)}.hs-task-copy{min-width:0}.hs-task-text{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow-wrap:anywhere;color:#1e2945;font-size:11.5px;line-height:1.4}.hs-task-copy.is-expanded .hs-task-text{display:block;overflow:visible}.hs-task-expand{display:inline-flex;margin:4px 0 0;padding:0;border:0;background:transparent;color:#5f51d8;font-size:9.5px;font-weight:800;cursor:pointer}.hs-task-expand:hover{text-decoration:underline}.hs-task-meta,.hs-task-priority{display:inline-flex;align-items:center;width:max-content;margin-top:5px;padding:3px 7px;border-radius:999px;font-size:9.5px;font-weight:800}.hs-task-meta{background:#f0f2f7;color:#68728a}.hs-task-meta.is-today{background:#e9f9f8;color:#087d78}.hs-task-meta.is-future{background:#fff5e6;color:#a35f00}.hs-task-meta.is-overdue{background:#ffedef;color:#c92d38}.hs-task-priority{margin-left:5px}.hs-task-priority.is-high{background:#ffedef;color:#c92d38}.hs-task-priority.is-medium{background:#fff3dc;color:#a85b00}.hs-task-priority.is-low{background:#eaf5ff;color:#216fa8}.hs-task-limit{position:absolute;top:48px;right:0;display:flex;justify-content:flex-end;color:#8a93a7;font-size:9.5px}.hs-task-limit.is-max{color:#b15f00;font-weight:800}
