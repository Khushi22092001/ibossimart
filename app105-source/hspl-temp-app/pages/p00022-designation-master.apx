page 22 (
    name: Designation Master
    alias: DESIGNATION-MASTER
    title: Designation Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region designation-master (
        name: Designation Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      ROWNUM AS SERIALNO,
                      a.DesignationCode,
                      a.DesignationName,
                      eg.EmployeeGradeName,
                      c.CategoryName,
                      cg.CategoryName as GroupName
                From  Designation a, EmployeeGrade eg, Category c, Category cg
                Where a.EmployeeGradeCode = eg.EmployeeGradeCode(+)
                  and eg.CategoryCode = c.CategoryCode(+)
                  and c.GroupCode = cg.CategoryCode(+)
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            saveReport: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 3709078699052108
        }

        column CATEGORYNAME (
            type: plainText
            heading {
                heading: CATEGORY
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column DESIGNATIONCODE (
            type: plainText
            heading {
                heading: DESIGNATION CODE
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DESIGNATIONNAME (
            type: plainText
            heading {
                heading: DESIGNATION NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EMPLOYEEGRADENAME (
            type: plainText
            heading {
                heading: EMPLOYEE GRADE
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column GROUPNAME (
            type: plainText
            heading {
                heading: GROUP
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Designation Master
        }

        savedReport 37486 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CATEGORYNAME (
                sequence: 5
            )

            displayColumn DESIGNATIONCODE (
                sequence: 2
            )

            displayColumn DESIGNATIONNAME (
                sequence: 3
            )

            displayColumn EMPLOYEEGRADENAME (
                sequence: 4
            )

            displayColumn GROUPNAME (
                sequence: 6
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DESIGNATIONNAME
                sort {
                    sequence: 2
                }
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

