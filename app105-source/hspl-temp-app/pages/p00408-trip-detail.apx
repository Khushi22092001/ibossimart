page 408 (
    name: Trip Detail
    alias: TRIP-DETAIL
    title: Trip Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report-detail (
        name: Report Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	row_number() over(order by x.DriverName) SerialNo,
                	x.LocationCode,
                	x.LocationName,
                	x.DriverName,
                	x.VehicleNo,
                	x.PartyCode,
                	x.PartyName,
                	x.TransporterName,
                	x.CompanyName,
                	x.CompanyCode,
                	x.DriverCode,
                	x.TransportAreaCode,
                	x.TransportAreaName,
                	count(x.Tno) as NoOfTrip,
                	sum(x.LoadingQuantity1) as LoadingQuantity,
                	sum(x.UnloadingQuantity1) as UnloadingQuantity
                From
                (
                Select 
                	a.Tno,
                	b.LocationCode,
                	c.LocationName,
                	b.PartyRefNo as PartyDONo,
                	b.GPDate,
                	b.GPNo,
                	b.Quantity1 as LoadingQuantity1,
                	f.PODDate as UnloadingDate,
                	e.Quantity1 as UnloadingQuantity1,
                	g.SourceLocationName,
                	h.DestinationLocationName,
                	i.EmployeeName as DriverName,
                	d.DriverCode,
                	b.VehicleNo,
                	b.PartyCode,
                	j.PartyName,
                	m.TransporterName,
                	n.CompanyName,
                	n.CompanyCode,
                	k.TransportAreaCode,
                	o.TransportAreaName
                From NecessitySlipTrip a, LR b, Location c, Placement d,PODDetail e, POD f, SourceLocation g, DestinationLocation h, Employee i,
                Party j, CompanyVehicle k, VehicleType l, Transporter m, Company n, TransportArea o
                Where a.ModuleTno = b.Tno
                	and b.LocationCode = c.LocationCode(+)
                	and b.PlacementTno = d.Tno(+)
                	and b.Tno = e.LRTno(+)
                	and e.Tno = f.Tno(+)
                	and b.SourceLocationTno = g.Tno(+) 
                	and b.DestinationLOcationTno = h.Tno(+)
                	and d.DriverCode = i.EmployeeCode(+)
                	and b.PartyCode = j.PartyCode (+)
                	and b.VehicleNo = k.CompanyVehicleNo(+)
                	and k.VehicleTypeCode = l.VehicleTypeCode(+)
                	and b.TransporterCode = m.TransporterCode(+)
                	and b.CompanyCode = n.CompanyCode(+)
                	and k.TransportAreaCode = o.TransportAreaCode(+)
                UNION ALL
                Select 
                	a.Tno,
                	b.LocationCode,
                	c.LocationName,
                	h.PartyDONo,
                	b.LoadingDate as GPDate,
                	b.GPNo,
                	b.LoadingQuantity1,
                	b.UnloadingDate,
                	b.UnloadingQuantity1,
                	d.SourceLocationName,
                	e.DestinationLocationName,
                	f.EmployeeName as DriverName,
                	b.DriverCode,
                	b.VehicleNo,
                	b.PartyCode,
                	i.PartyName,
                	l.TransporterName,
                	m.CompanyName,
                	m.CompanyCode,
                	j.TransportAreaCode,
                	o.TransportAreaName
                From NecessitySlipTrip a, InternalTransfer b, Location c, SourceLocation d, DestinationLocation e, Employee f, DeliveryOrderDetail g,
                DeliveryOrder h, Party i, CompanyVehicle j, VehicleType k, Transporter l, Company m, TransportArea o
                Where a.ModuleTno = b.Tno
                	and b.LocationCode = c.LocationCode(+)
                	and b.SourceLocationTno = d.Tno(+)
                	and b.DestinationLocationTno = e.Tno(+)
                	and b.DriverCode = f.EmployeeCode(+)
                	and b.DeliveryOrderTno = g.Tno(+)
                	and b.DeliveryOrderSno = g.Sno(+)
                	and g.Tno = h.Tno(+)
                	and b.PartyCode = i.PartyCode(+)
                	and b.VehicleNo = j.CompanyVehicleNo(+)
                	and j.VehicleTypeCode = k.VehicleTypeCode(+)
                	and b.TransporterCode = l.TransporterCode(+)
                	and b.CompanyCode = m.CompanyCode(+)
                	and j.TransportAreaCode = o.TransportAreaCode(+)
                ) x
                Where :P408_FILTERFROM = 'PARENT'
                and exists(
                	Select
                		aa.Tno
                	From TruckDieselReportTable aa
                	Where ( :P408_COMPANY IS NULL OR instr(':'||:P408_COMPANY||':',':'||aa.CompanyCode||':') > 0)
                		and ( :P408_VEHICLE IS NULL OR instr(':'||:P408_VEHICLE||':',':'||aa.VehicleNO||':') > 0)
                		and aa.Creator = :APP_USER
                		and aa.PageNo = 400
                		and aa.Tno = x.Tno
                )
                Group By
                	x.LocationCode,
                	x.LocationName,
                	x.DriverName,
                	x.VehicleNo,
                	x.PartyCode,
                	x.PartyName,
                	x.TransporterName,
                	x.CompanyName,
                	x.CompanyCode,
                	x.DriverCode,
                	x.TransportAreaCode,
                	x.TransportAreaName
                UNION ALL
                Select
                	row_number() over(order by x.DriverName) SerialNo,
                	x.LocationCode,
                	x.LocationName,
                	x.DriverName,
                	x.VehicleNo,
                	x.PartyCode,
                	x.PartyName,
                	x.TransporterName,
                	x.CompanyName,
                	x.CompanyCode,
                	x.DriverCode,
                	x.TransportAreaCode,
                	x.TransportAreaName,
                	count(x.Tno) as NoOfTrip,
                	sum(x.LoadingQuantity1) as LoadingQuantity,
                	sum(x.UnloadingQuantity1) as UnloadingQuantity
                From
                (
                Select 
                	a.Tno,
                	b.LocationCode,
                	c.LocationName,
                	b.PartyRefNo as PartyDONo,
                	b.GPDate,
                	b.GPNo,
                	b.Quantity1 as LoadingQuantity1,
                	f.PODDate as UnloadingDate,
                	e.Quantity1 as UnloadingQuantity1,
                	g.SourceLocationName,
                	h.DestinationLocationName,
                	i.EmployeeName as DriverName,
                	d.DriverCode,
                	b.VehicleNo,
                	b.PartyCode,
                	j.PartyName, 
                	m.TransporterName,
                	n.CompanyName,
                	n.CompanyCode,
                	k.TransportAreaCode,
                	o.TransportAreaName
                From NecessitySlipTrip a, LR b, Location c, Placement d,PODDetail e, POD f, SourceLocation g, DestinationLocation h, Employee i,
                Party j, CompanyVehicle k, VehicleType l, Transporter m, Company n, TransportArea o
                Where a.ModuleTno = b.Tno
                	and b.LocationCode = c.LocationCode(+)
                	and b.PlacementTno = d.Tno(+)
                	and b.Tno = e.LRTno(+)
                	and e.Tno = f.Tno(+)
                	and b.SourceLocationTno = g.Tno(+) 
                	and b.DestinationLOcationTno = h.Tno(+)
                	and d.DriverCode = i.EmployeeCode(+)
                	and b.PartyCode = j.PartyCode (+)
                	and b.VehicleNo = k.CompanyVehicleNo(+)
                	and k.VehicleTypeCode = l.VehicleTypeCode(+)
                	and b.TransporterCode = m.TransporterCode(+)
                	and b.CompanyCode = n.CompanyCode(+)
                	and k.TransportAreaCode = o.TransportAreaCode(+)
                UNION ALL
                Select 
                	a.Tno,
                	b.LocationCode,
                	c.LocationName,
                	h.PartyDONo,
                	b.LoadingDate as GPDate,
                	b.GPNo,
                	b.LoadingQuantity1,
                	b.UnloadingDate,
                	b.UnloadingQuantity1,
                	d.SourceLocationName,
                	e.DestinationLocationName,
                	f.EmployeeName as DriverName,
                	b.DriverCode,
                	b.VehicleNo,
                	b.PartyCode,
                	i.PartyName,
                	l.TransporterName,
                	m.CompanyName,
                	m.CompanyCode,
                	j.TransportAreaCode,
                	o.TransportAreaName
                From NecessitySlipTrip a, InternalTransfer b, Location c, SourceLocation d, DestinationLocation e, Employee f, DeliveryOrderDetail g,
                DeliveryOrder h, Party i, CompanyVehicle j, VehicleType k, Transporter l, Company m, TransportArea o
                Where a.ModuleTno = b.Tno
                	and b.LocationCode = c.LocationCode(+)
                	and b.SourceLocationTno = d.Tno(+)
                	and b.DestinationLocationTno = e.Tno(+)
                	and b.DriverCode = f.EmployeeCode(+)
                	and b.DeliveryOrderTno = g.Tno(+)
                	and b.DeliveryOrderSno = g.Sno(+)
                	and g.Tno = h.Tno(+)
                	and b.PartyCode = i.PartyCode(+)
                	and b.VehicleNo = j.CompanyVehicleNo(+)
                	and j.VehicleTypeCode = k.VehicleTypeCode(+)
                	and b.TransporterCode = l.TransporterCode(+)
                	and b.CompanyCode = m.CompanyCode(+)
                	and j.TransportAreaCode = o.TransportAreaCode(+)
                ) x
                Where nvl(:P408_FILTERFROM, 'SELF') = 'SELF'
                and exists(
                	Select
                		aa.Tno
                	From TruckDieselReportTable aa
                	Where aa.Creator = :APP_USER
                		and aa.PageNo = 408
                		and aa.Tno = x.Tno
                	)
                Group By
                	x.LocationCode,
                	x.LocationName,
                	x.DriverName,
                	x.VehicleNo,
                	x.PartyCode,
                	x.PartyName,
                	x.TransporterName,
                	x.CompanyName,
                	x.CompanyCode,
                	x.DriverCode,
                	x.TransportAreaCode,
                	x.TransportAreaName
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 14106008017117719
        }

