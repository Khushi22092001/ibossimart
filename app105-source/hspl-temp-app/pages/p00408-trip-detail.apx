    region trip-detail (
        name: "Trip Detail "
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
            column: 1
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P408_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct 
                CompanyName D,
                CompanyCode R
                From Company;
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 10
            region: @trip-detail
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P408_DRIVER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Driver
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.EmployeeName || ' - ' || a.EmployeeID as d,
                a.EmployeeCode as r
                From Employee a
                Where exists(
                Select
                aa.Tno
                From NecessitySlip aa
                Where aa.DriverCode = a.EmployeeCode
                )
                Order by 1
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 60
            region: @trip-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

