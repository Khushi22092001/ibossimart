                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    distinct c.VehicleTypeName d , 
                    c.VehicleTypeCode r  
                from CompanyVehicle a, NecessitySlip b , VehicleType c
                where a.COMPANYVEHICLENO = b.EQUIPMENTID
                  and a.VehicleTypeCode = c.VehicleTypeCode
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 80
            region: @trip-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 110
            region: @trip-detail
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction preparerecord (
        name: PrepareRecord
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    PrepareTruckDieselReport(:P408_COMPANY, :P408_LOCATION, :P408_VEHICLE, :P408_VEHICLETYPE, :P408_TRANSPORTER, :P408_DRIVER, :P408_TRANSPORTAREA, :P408_FROMDATE, :P408_TODATE, :APP_USER, 408);
                    
                    
                    ```
                itemsToSubmit: [
                    P408_COMPANY
                    P408_LOCATION
                    P408_VEHICLE
                    P408_VEHICLETYPE
                    P408_DRIVER
                    P408_FROMDATE
                    P408_TODATE
                    P408_TRANSPORTER
                    P408_TRANSPORTAREA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report-detail
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction setfilterfrom (
        name: SetFilterFrom
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: :P408_FILTERFROM := 'SELF';
                itemsToReturn: P408_FILTERFROM
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

