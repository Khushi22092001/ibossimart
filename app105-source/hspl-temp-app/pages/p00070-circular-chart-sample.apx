page 70 (
    name: Circular chart sample
    alias: CIRCULAR-CHART-SAMPLE
    title: Circular chart sample
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: https://cdnjs.cloudflare.com/ajax/libs/jquery-circle-progress/1.2.0/circle-progress.min.js
    }
    css {
        inline:
            ```css
            .round {
              min-height: 75px;
              margin-top: 30px;
              position: relative;
              margin-bottom: 20px;
            }
            .round strong {
              position: absolute;
              top: 50%;
              left: 50%;
              margin-top: -25px;
              transform: translate(-50%);
              font-size: 20px;
              color: #212121;
              font-weight: 100;
            }
            .round span {
              display: block;
              color: #999;
              font-size: 16px;
              margin-top: 10px;
            }
            .round span i {
              color: #ff5c5c;
              font-size: 22px;
              margin-right: 6px;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region department-chart (
        name: DEPARTMENT CHART
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     a.DepartmentName,
                     (Select count(EmployeeCode) from Employee e Where e.DepartmentCode = a.DepartmentCode) as Dept_Emp,
                     (Select Count(EmployeeCode) From Employee) as TotalEmp
                From Department a
                Where DepartmentCode in (Select ee.DepartmentCode from Employee ee Where ee.DepartmentCode = a.DepartmentCode)
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 2
        }
        chart {
            type: donut
        }
        title {
            title: Department
        }
        chartLayout {
            height: 400
        }
        dataCursor {
            behavior: smooth
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            title: DEPARTMENTS
            position: start
            fontStyle: italic
            fontSize: 10
            fontColor: #000000
        }

        series dept (
            name: DEPT
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                         a.DepartmentCode,
                         a.DepartmentName,
                         (Select count(EmployeeCode) from Employee e Where e.DepartmentCode = a.DepartmentCode) as Dept_Emp,
                         (Select Count(EmployeeCode) From Employee) as TotalEmp,
                         '#f02222' as Color_Value
                    From Department a
                    Where DepartmentCode in (Select ee.DepartmentCode from Employee ee Where ee.DepartmentCode = a.DepartmentCode)
                      and a.DepartmentCode = 'PACKING'
                    Union All
                    Select
                         a.DepartmentCode,
                         a.DepartmentName,
                         (Select count(EmployeeCode) from Employee e Where e.DepartmentCode = a.DepartmentCode) as Dept_Emp,
                         (Select Count(EmployeeCode) From Employee) as TotalEmp,
                         '#edeb5f' as Color_Value
                    From Department a
                    Where DepartmentCode in (Select ee.DepartmentCode from Employee ee Where ee.DepartmentCode = a.DepartmentCode)
                      and a.DepartmentCode = 'MARKETING'
                    Union All
                    Select
                         a.DepartmentCode,
                         a.DepartmentName,
                         (Select count(EmployeeCode) from Employee e Where e.DepartmentCode = a.DepartmentCode) as Dept_Emp,
                         (Select Count(EmployeeCode) From Employee) as TotalEmp,
                         '#70bfe5' as Color_Value
                    From Department a
                    Where DepartmentCode in (Select ee.DepartmentCode from Employee ee Where ee.DepartmentCode = a.DepartmentCode)
                      and a.DepartmentCode = 'REFINERY'
                    Union All
                    Select
                         a.DepartmentCode,
                         a.DepartmentName,
                         (Select count(EmployeeCode) from Employee e Where e.DepartmentCode = a.DepartmentCode) as Dept_Emp,
                         (Select Count(EmployeeCode) From Employee) as TotalEmp,
                         '#70e574' as Color_Value
                    From Department a
                    Where DepartmentCode in (Select ee.DepartmentCode from Employee ee Where ee.DepartmentCode = a.DepartmentCode)
                      and a.DepartmentCode = 'BOILER'
                    ```
            }
            columnMapping {
                seriesName: TOTALEMP
                label: DEPARTMENTNAME
                value: DEPT_EMP
                customTooltip: DEPARTMENTNAME
                customColumn: DEPT_EMP
            }
            appearance {
                color: &COLOR_VALUE.
            }
            link {
                type: redirectUrl
                targetUrl: javascript(void);
            }
            label {
                show: true
                position: insideBarEdge
                displayAs: percentage
            }
        )

    )

    region gauge (
        name: GAUGE
        type: chart
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 2
        }
        chart {
            type: statusMeterGauge
        }
        chartLayout {
            maxWidth: 90
            height: 100
        }
        gauge {
            indicatorSize: 3
            innerRadius: 0.7
        }
        value {
            valueType: percent
        }

        series gauge (
            name: GAUGE
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                    a.DepartmentCode,     
                    a.DepartmentName,
                         (Select count(EmployeeCode) from Employee e Where e.DepartmentCode = a.DepartmentCode) as Dept_Emp,
                         (Select Count(EmployeeCode) From Employee) as TotalEmp
                    From Department a
                    Where DepartmentCode in (Select ee.DepartmentCode from Employee ee Where ee.DepartmentCode = a.DepartmentCode)
                      and a.DepartmentCode = :P70_DEPT;
                    ```
                pageItemsToSubmit: P70_DEPT
            }
            columnMapping {
                value: DEPT_EMP
                maxValue: TOTALEMP
            }
            appearance {
                color: #70e574
                plotAreaColor: #edeb5f
            }
            thresholds {
                display: onIndicator
            }
        )

    )

    region test (
        name: test
        type: chart
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                         partycode,
                         To_Char(ccinvoicedate,'mon-yyyy') as months,
                         sum(ccinvoiceamount)
                    From CCINvoice
                    group by To_Char(ccinvoicedate,'mon-yyyy'), partycode
                    ```
            }
            columnMapping {
                label: MONTHS
                value: SUM(CCINVOICEAMOUNT)
            }
            link {
                type: redirectThisApp
                target: {
                    page: 92
                    items: {
                        P92_MONTH: &MONTHS.
                        P92_CUSTOMERCODE: &PARTYCODE.
                    }
                }
            }
            label {
                show: true
                fontStyle: italic
                fontSize: 20
            }
        )

    )

    pageItem P70_DEPT (
        type: textField
        label {
            label: Dept
            alignment: left
        }
        layout {
            sequence: 10
            region: @department-chart
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: region
            region: @test
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: region
                region: @test
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

