    pageItem P502_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                    a.CompanyName d,
                    a.CompanyCode r
                From Company a
                Where exists
                (Select 
                  b.CompanyCode
                  From NecessitySlip b
                  Where b.CompanyCode = a.CompanyCode)
                Order by 1
                  ;
                ```
        }
        layout {
            sequence: 10
            region: @annual-salary-register-report-employee-wise
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

