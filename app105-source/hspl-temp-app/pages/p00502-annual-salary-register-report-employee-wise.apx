page 502 (
    name: Annual Salary Register Report (Employee Wise)
    alias: ANNUAL-SALARY-REGISTER-REPORT-EMPLOYEE-WISE
    title: Annual Salary Register Report (Employee Wise)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region annual-salary-register-report (
        name: Annual Salary Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     a.EmployeeID,
                     a.EmployeeName,
                     a.DesignationName,
                     a.DateOfJoining,
                     a.Location,
                      a.LocationCode,
                      a.EmployeeCode,
                       a.CompanyCode,
                     'DETAIL'  as Detail,
                     a.DepartmentName,
                    SUM(a.PaidDays) as PaidDays,
                    SUM(a.GrossSalary) as GrossSalary,
                    SUM(a.PT) as PT,
                    SUM(a.PF) as PF,
                    SUM(a.ESIC) as ESIC,
                    SUM(a.AdvanceDed) as AdvanceDed,
                    SUM(a.Mess) as Mess,   
                    SUM(a.TDS) as TDS,
                    SUM(a.OtherDeduction) as OtherDeduction,
                    SUM(a.TotalDeduction) as TotalDeduction,
                    SUM(a.NetPayment) as NetPayment
                From
                 (
                  Select 
                       b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName,
                       b.DateOfJoining,
                       a.LocationCode,
                       b.EmployeeCode,
                       a.CompanyCode,
                       SUM(decode(c.SalaryHeadCode, 'PD', c.SalaryHeadAmount))  as PaidDays,
                       SUM(decode(c.SalaryHeadCode, 'GROSSSALARY', c.SalaryHeadAmount)) as GrossSalary,
                       SUM(decode(c.SalaryHeadCode, 'PTAX', c.SalaryHeadAmount)) as PT,
                       SUM(decode(c.SalaryHeadCode, 'PFEMPLOYEE', c.SalaryHeadAmount)) as PF,
                       SUM(decode(c.SalaryHeadCode, 'ESICEMPLOYEECONTRIBUTION', c.SalaryHeadAmount)) as ESIC,
                       SUM(decode(c.SalaryHeadCode, 'RUNNINGADVANCEDED', c.SalaryHeadAmount)) +
                       SUM(decode(c.SalaryHeadCode, 'SALARYADVANCEDED', c.SalaryHeadAmount)) as AdvanceDed,
                       SUM(decode(c.SalaryHeadCode, 'CANTEENDED', c.SalaryHeadAmount)) as Mess,   
                       SUM(decode(c.SalaryHeadCode, 'TDS', c.SalaryHeadAmount)) as TDS,
                       SUM(decode(c.SalaryHeadCode, 'OTHERDEDUCTION', c.SalaryHeadAmount)) as OtherDeduction,
                       SUM(decode(c.SalaryHeadCode, 'GROSSDEDUCTION', c.SalaryHeadAmount)) as TotalDeduction,
                       SUM(decode(c.SalaryHeadCode, 'NETEARNING', c.SalaryHeadAmount)) as NetPayment,
                       GetLocationName(a.LocationCode) Location,
                       g.DepartmentName
                From   Salary a,Employee b,SalaryDetail c,Designation d,EmployeeSalary e,SalaryScheme f, Department g
                Where  a.EmployeeCode = b.EmployeeCode(+)
                  and  a.TNo = c.TNo(+)
                  and  b.DesignationCode = d.DesignationCode(+)
                  and  a.EmployeeSalaryTno = e.Tno(+)
                  and  e.Salaryschemecode = f.SalarySchemeCode(+)
                  and  a.DepartmentCode = g.DepartmentCode(+)
                  and  a.FinancialYearCode = :P502_FINANCIALYEAR
                  and  (:P502_EMPLOYEE IS NULL OR instr(':'||:P502_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0)
                  and  (:P502_COMPANY IS NULL OR instr(':'||:P502_COMPANY||':',':'||a.CompanyCode||':') > 0)
                  and  (:P502_LOCATION IS NULL OR instr(':'||:P502_LOCATION||':',':'||a.LocationCode||':') > 0)
                Group By b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName,
                       b.DateOfJoining,
                       GetLocationName(a.LocationCode),
                       a.SalaryNo,
                       g.DepartmentName,
                       a.LocationCode,
                       b.EmployeeCode,
                       a.CompanyCode) a
                Group By a.EmployeeID,
                     a.EmployeeName,
                     a.DesignationName,
                     a.DateOfJoining,
                     a.Location,
                     a.DepartmentName,
                     a.LocationCode,
                     a.EmployeeCode,
                     a.CompanyCode
                ```
            pageItemsToSubmit: [
                P502_FINANCIALYEAR
                P502_COMPANY
                P502_LOCATION
            ]
        }
