    region testtttttttttt-ccin (
        name: TESTTTTTTTTTTT CCIN
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Rownum,
                      xxx.Tno,
                      xxx.LocationName,
                      xxx.DocTypeName,
                      xxx.CCInvoiceNo,
                      xxx.CCInvoiceDate,
                      xxx.DespatchAdviceNo,
                      xxx.DespatchAdviceDate,
                      xxx.SalesOrderNo,
                      xxx.SalesOrderDate,
                      xxx.PartyName,
                      xxx.Consignee,
                      xxx.Transporter,
                      xxx.VehicleNo,
                      xxx.LorryNo,
                      xxx.LorryDate,
                      xxx.FreightTypeName,
                      xxx.FreightRate,
                      xxx.FreightUnitCode,
                      xxx.ItemCode,
                      xxx.ItemName,
                      xxx.Item,
                      xxx.ItemSpecificationName,
                      xxx.UOM,
                      xxx.UOM2,
                      xxx.Quantity1,
                      xxx.Quantity2,
                      xxx.Rate,
                      xxx.Amount,
                      xxx.CGST,
                      xxx.SGST,
                      xxx.IGST,
                      xxx.TCS,
                      xxx.INSURANCE,  
                      xxx.LOADINGCHARGES,    
                      xxx.BasicRate,
                      xxx.ConversionRate,
                      xxx.FooterAmount,
                      ABS(xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS + xxx.INSURANCE + xxx.LOADINGCHARGES)) as OtherAmount,
                      xxx.TotalAmount,
                      xxx.Creator,
                      xxx.CreationTime,
                      xxx.AgentName,
                      xxx.CityName,
                      xxx.StateName,
                      xxx.ReferenceModuleNo,
                      xxx.Description,
                      xxx.ComponentSerialNo,
                      xxx.ItemCategoryName
                From (
                        Select
                              xx.Tno,
                              xx.LocationName,
                              xx.DocTypeName,
                              xx.CCInvoiceNo,
                              xx.CCInvoiceDate,
                              xx.DespatchAdviceNo,
                              xx.DespatchAdviceDate,
                              xx.SalesOrderNo,
                              xx.SalesOrderDate,
                              xx.PartyName,
                              xx.Consignee,
                              xx.Transporter,
                              xx.VehicleNo,
                              xx.LorryNo,
                              xx.LorryDate,
                              xx.FreightTypeName,
                              xx.FreightRate,
                              xx.FreightUnitCode,
                              xx.ItemCode,
                              xx.ItemName,
                              xx.Item,
                              xx.ItemSpecificationName,
                              xx.UOM,
                              xx.UOM2,
                              xx.Quantity1,
                              XX.Quantity2,
                              xx.Rate,
                              xx.Amount,
                              sum(xx.CGST) CGST,
                              sum(xx.SGST) SGST,
                              sum(xx.IGST) IGST,
                              sum(xx.TCS) TCS,
                              sum(xx.INSURANCE) INSURANCE,  
                              sum(xx.LOADINGCHARGES) LOADINGCHARGES,   
                              xx.BasicRate,
                              xx.ConversionRate,
                              xx.FooterAmount,
                              xx.TotalAmount,
                              xx.Creator,
                              xx.CreationTime,
                              xx.AgentName,
                              xx.CityName,
                              xx.StateName,
                              xx.ReferenceModuleNo,
                              xx.Description,
                              xx.ItemCategoryName,
                            --   xx.ComponentSerialNo
                             LISTAGG(XX.ComponentSerialNo, ' , ') as ComponentSerialNo
                        From (
                                Select
                                      a.Tno,
                                      l.LocationName,
                                      dt.DocTypeName,
                                      a.CCInvoiceNo,
                                      a.CCInvoiceDate,
                                      da.DespatchAdviceNo,
                                      da.DespatchAdviceDate,
                                      so.SalesOrderNo,
                                      so.SalesOrderDate,
                                      GetPartyName(so.AgentCode) as AgentName,
                                      p.PartyName,
                                      GetCityName(p.OfficeCityCode) as CityName,
                                      GetStateName(p.OfficeStateCode) as StateName,
                                      GetPartyName(so.ConsigneeCode) as Consignee,
                                      t.PartyName as Transporter,
                                      a.VehicleNo,
                                      a.LorryNo,
                                      a.LorryDate,
                                      ft.FreightTypeName,
                                      a.FreightRate,
                                      a.FreightUnitCode,
                                      b.ItemCode,
                                      e.ItemName,
                                      e.ItemName as Item,
                                      ee.ItemSpecificationName,
                                      e.MeasuringUnitCode1 as UOM,
                                      e.MeasuringUnitCode2 as UOM2,
                                      b.Quantity1,
                                      b.Quantity2,
                                      b.Rate,
                                      b.Amount,
                                      nvl(Decode(c.FooterHeadCode,'.CGST.', c.FooterValue),0) as CGST,
                                      nvl(Decode(c.FooterHeadCode,'.SGST.', c.FooterValue),0) as SGST,
                                      nvl(Decode(c.FooterHeadCode,'.IGST.', c.FooterValue),0)as IGST,
                                      nvl(Decode(c.FooterHeadCode,'.TCS.', c.FooterValue),0) as TCS,
                                      nvl(Decode(c.FooterHeadCode,'.INSURANCE.', c.FooterValue),0) as INSURANCE,  
                                      nvl(Decode(c.FooterHeadCode,'.LOADINGCHARGES.', c.FooterValue),0) +
                                      nvl(Decode(c.FooterHeadCode,'.LOADINGUNLOADING.', c.FooterValue),0) as LOADINGCHARGES,    
                                      b.BasicRate,
                                      b.ConversionRate,
                                      b.FooterAmount,
                                      b.TotalAmount,
                                      bue.EmployeeName||' ( '||a.Creator||')' as Creator,
                                      a.CreationTime,
                                      st.StockModuleCode ||'-'|| GetModuleNo(st.StockModuleCode, st.StockModuleTno) as ReferenceModuleNo,
                                      cos.ComponentSerialNo,
                                      b.Description,
                                      ic.ItemCategoryName
                                From  CCInvoice a, CCInvoiceDetail b, CCInvoiceDetailFooter c, Location l, DocType dt, Party p, Party t, Item e, itemSpecification ee, DespatchAdvice da, CCInvoiceStockStorageDetail ccs,Stock st,
                                CCInvoiceDetailSerialNo ccds, ComponentStock cos,
                                (
                                    Select
                                         s.TNo,
                                         s.SalesOrderNo,
                                         s.SalesOrderDate,
                                         s.PartyCode,
                                         s.ConsigneeCode,
                                         s.AgentCode,
                                         S.TradeTypeCode
                                   From SalesOrder s )so,BossUser bu, Employee bue, DocumentStatusDetail dsd, FreightType ft, ItemCategory ic
                                Where a.TNo = b.TNo(+)
                                  and b.TNo = c.TNo(+)
                                  and b.SNo = c.SNo(+)
                                  and a.LocationCode = l.LocationCode(+)
                                  and a.DocTypeCode =  dt.DocTypeCode(+)
                                  and a.DespatchAdviceTNo = da.TNo(+)
                                  and b.Tno = ccs.Tno(+)         
                                  and b.Sno = ccs.Sno(+)
                                  and ccs.StockTno = st.Tno(+)
                                  and b.Tno = ccds.Tno(+)
                                  and b.Sno = ccds.Sno(+)
                                  and ccds.ComponentStockTno = cos.Tno(+)
                                  and a.SalesOrderTNo = so.TNo(+)
                                  and a.PartyCode = p.PartyCode(+)
                                  and a.TransporterCode = t.PartyCode(+)
                                  and b.ItemCode = e.ItemCode(+)
                                  and b.ItemSpecificationCode = ee.itemSpecificationCode(+)
                                  and a.Creator = bu.LoginName(+)
                                  and bu.EmployeeCode = bue.EMployeeCode(+)
                                  and a.TNO = dsd.ModuleTNO(+)
                                  and a.FreightTypeCode = ft.FreightTypeCode(+)
                                  and ee.ItemCategoryCode = ic.ItemCategoryCode(+)
                                  and a.CCInvoiceDate between :P521_FROMDATE and :P521_TODATE
                                  and instr(':'||:P521_LOCATION||':',':'||a.LocationCode||':') > 0
                                  and instr(':'||:P521_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                                  and ( :P521_AGENTCODE IS NULL OR SO.AGENTCODE = :P521_AGENTCODE)
                                  and ( :P521_TRADETYPE IS NULL OR SO.TRADETYPECODE = :P521_TRADETYPE)
                                  and ( :P521_PARTY IS NULL OR instr(':'||:P521_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                                  and ( :P521_TRANSPORTER IS NULL OR instr(':'||:P521_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 ) 
                                  and ( :P521_ITEM IS NULL OR instr(':'||:P521_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                                  and ( :P521_ITEMSPECIFICATION IS NULL OR instr(':'||:P521_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                                  and ( :P521_ITEMCATEGORY IS NULL OR instr(':'||:P521_ITEMCATEGORY||':',':'||ee.ItemCategoryCode||':') > 0 ) 
                                  and a.CCInvoiceNo like nvl(:P521_CCINO,'%')
                                  and (:P521_VEHICLENO is null or a.VehicleNo = :P521_VEHICLENO)
                                    -- 22-APR-2025
                                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                                  and case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                                           When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                                           When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                                           When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                                           When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                                           When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                                           When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                                           When dsd.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                                           When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                                           When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                                      End  like nvl(:P521_STATUS,'%')
                                 AND (:P521_ITEMGROUP IS NULL 
                                      OR
                                      EXISTS
                                        (Select 1
                                            From (Select ITEMCODE,
                                                        parentcode,
                                                        RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                                        Level,
                                                        CONNECT_BY_ROOT itemcode As root_id,
                                                        '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                                        CONNECT_BY_ISLEAF As leaf
                                                    From item a
                                                    Start With parentcode Is Null
                                                    Connect By parentcode = Prior itemcode
                                                    Order Siblings By itemcode
                                                  ) x
                                            Where X.ROOT_ID = :P521_ITEMGROUP
                                              AND X.ITEMCODE = B.ITEMCODE
                                        )
                                    )                        
                        )xx
                        Group By
                              xx.Tno,
                              xx.LocationName,
                              xx.DocTypeName,
                              xx.CCInvoiceNo,
                              xx.CCInvoiceDate,
                              xx.DespatchAdviceNo,
                              xx.DespatchAdviceDate,
                              xx.SalesOrderNo,
                              xx.SalesOrderDate,
                              xx.PartyName,
                              xx.Consignee,
                              xx.Transporter,
                              xx.VehicleNo,
                              xx.LorryNo,
                              xx.LorryDate,
                              xx.FreightTypeName,
                              xx.FreightRate,
                              xx.FreightUnitCode,
                              xx.ItemCode,
                              xx.ItemName,
                              xx.Item,
                              xx.ItemSpecificationName,
                              xx.UOM,
                              xx.UOM2,
                              xx.Quantity1,
                              xx.Quantity2,
                              xx.Rate,
                              xx.Amount,
                              xx.BasicRate,
                              xx.ConversionRate,
                              xx.FooterAmount,
                              xx.TotalAmount,
                              xx.Creator,
                              xx.CreationTime,
                              xx.AgentName,
                              xx.CityName,
                              xx.StateName,
                              xx.ReferenceModuleNo,
                              xx.Description,
                              xx.ItemCategoryName
                )xxx
                Order by 1
                /*
                ---
                Select
                      xxx.Tno,
                      xxx.LocationName,
                      xxx.DocTypeName,
                      xxx.CCInvoiceNo,
                      xxx.CCInvoiceDate,
                      xxx.DespatchAdviceNo,
                      xxx.DespatchAdviceDate,
                      xxx.InterUnitTransferNo,
                      xxx.InterUnitTransferDate,
                      xxx.PartyName,
                      xxx.Transporter,
                      xxx.VehicleNo,
                      xxx.LorryNo,
                      xxx.LorryDate,
                      xxx.FreightTypeCode,
                      xxx.FreightRate,
                      xxx.FreightUnitCode,
                      xxx.FreightContractNo,
                      xxx.ItemCode,
                      xxx.Item,
                      xxx.UOM,
                      xxx.Quantity1,
                      xxx.Rate,
                      xxx.Amount,
                      xxx.CGST,
                      xxx.SGST,
                      xxx.IGST,
                      xxx.TCS,
                      xxx.FooterAmount,
                      (xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS)) as OtherAmount,
                      xxx.TotalAmount,
                      xxx.VStatus,
                      xxx.VoucherNo,
                      xxx.VoucherDate,
                      xxx.MIStatus,
                      xxx.MaterialInNo,
                      xxx.MaterialInDate,
                      xxx.Creator,
                      xxx.CreationTime
                From (
                        Select
                              xx.Tno,
                              xx.LocationName,
                              xx.DocTypeName,
                              xx.CCInvoiceNo,
                              xx.CCInvoiceDate,
                              xx.DespatchAdviceNo,
                              xx.DespatchAdviceDate,
                              xx.InterUnitTransferNo,
                              xx.InterUnitTransferDate,
                              xx.PartyName,
                              xx.Transporter,
                              xx.VehicleNo,
                              xx.LorryNo,
                              xx.LorryDate,
                              xx.FreightTypeCode,
                              xx.FreightRate,
                              xx.FreightUnitCode,
                              xx.FreightContractNo,
                              xx.ItemCode,
                              xx.Item,
                              xx.UOM,
                              xx.Quantity1,
                              xx.Rate,
                              xx.Amount,
                              sum(xx.CGST) CGST,
                              sum(xx.SGST) SGST,
                              sum(xx.IGST) IGST,
                              sum(xx.TCS) TCS,
                              xx.FooterAmount,
                              xx.TotalAmount,
                              xx.VStatus,
                              xx.VoucherNo,
                              xx.VoucherDate,
                              xx.MIStatus,
                              xx.MaterialInNo,
                              xx.MaterialInDate,
                              xx.Creator,
                              xx.CreationTime
                        From (
                                Select
                                      a.Tno,
                                      l.LocationName,
                                      dt.DocTypeName,
                                      a.CCInvoiceNo,
                                      a.CCInvoiceDate,
                                      da.DespatchAdviceNo,
                                      da.DespatchAdviceDate,
                                      iut.InterUnitTransferNo,
                                      iut.InterUnitTransferDate,
                                      p.PartyName,
                                      t.PartyName as Transporter,
                                      a.VehicleNo,
                                      a.LorryNo,
                                      a.LorryDate,
                                      a.FreightTypeCode,
                                      a.FreightRate,
                                      a.FreightUnitCode,
                                      jo.JobOrderNo as FreightContractNo,
                                      b.ItemCode,
                                      e.ItemName||' ~ '||ee.ItemSpecificationName as Item,
                                      e.MeasuringUnitCode1 as UOM,
                                      b.Quantity1,
                                      b.Rate,
                                      b.Amount,
                                      nvl(Decode(c.FooterHeadCode,'.CGST.', c.FooterValue),0) as CGST,
                                      nvl(Decode(c.FooterHeadCode,'.SGST.', c.FooterValue),0) as SGST,
                                      nvl(Decode(c.FooterHeadCode,'.IGST.', c.FooterValue),0)as IGST,
                                      nvl(Decode(c.FooterHeadCode,'.TCS.', c.FooterValue),0) as TCS,
                                      b.FooterAmount,
                                      b.TotalAmount,
                                      nvl(Decode(v.ModuleTNo,a.TNo,'PREPARED'),'PENDING') as VStatus,
                                      v.VoucherNo,
                                      v.VoucherDate,
                                      nvl(Decode(mi.InterunitTransferCCInvoiceTNo,a.TNo,'PREPARED'),'PENDING') as MIStatus,
                                      mi.MaterialInNo,
                                      mi.MaterialInDate,
                                      bue.EmployeeName||' ( '||a.Creator||')' as Creator,
                                      a.CreationTime
                                From  CCInvoice a, CCInvoiceDetail b, CCInvoiceDetailFooter c, Location l, DocType dt, Party p, Party t, Item e, itemSpecification ee, DespatchAdvice da, Interunittransfer iut,
                                      JobOrder jo, Voucher v, MaterialIn mi, BossUser bu, Employee bue
                                Where a.TNo = b.TNo(+)
                                  and b.TNo = c.TNo(+)
                                  and b.SNo = c.SNo(+)
                                  and a.LocationCode = l.LocationCode(+)
                                  and a.DocTypeCode =  dt.DocTypeCode(+)
                                  and a.DespatchAdviceTNo = da.TNo(+)
                                  and a.InterUnitTransferTno = iut.TNo(+)
                                  and a.PartyCode = p.PartyCode(+)
                                  and a.TransporterCode = t.PartyCode(+)
                                  and b.ItemCode = e.ItemCode(+)
                                  and b.ItemSpecificationCode = ee.itemSpecificationCode(+)
                                  and a.FreightContractTno = jo.TNo(+)
                                  and a.TNo = v.ModuleTNo(+)
                                  and a.TNo = mi.InterunitTransferCCInvoiceTNo(+)
                                  and a.Creator = bu.LoginName(+)
                                  and bu.EmployeeCode = bue.EMployeeCode(+)
                                  and a.CCInvoiceDate between :P521_FROMDATE and :P521_TODATE
                                  and instr(':'||:P521_LOCATION||':',':'||a.LocationCode||':') > 0
                                  --and instr(':'||:P160_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                                  and ( :P521_PARTY IS NULL OR instr(':'||:P521_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                                  and ( :P521_TRANSPORTER IS NULL OR instr(':'||:P521_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 ) 
                                  and ( :P521_ITEM IS NULL OR instr(':'||:P521_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                                  and ( :P521_ITEMSPECIFICATION IS NULL OR instr(':'||:P521_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                                  and a.CCInvoiceNo like nvl(:P521_CCINO,'%')
                                  and (:P521_VEHICLENO is null or a.VehicleNo = :P521_VEHICLENO)
                                  and nvl(Decode(v.ModuleTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P521_VSTATUS,'%')
                                  and nvl(Decode(mi.InterunitTransferCCInvoiceTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P521_MISTATUS,'%')
                        )xx
                        Group By
                              xx.Tno,
                              xx.LocationName,
                              xx.DocTypeName,
                              xx.CCInvoiceNo,
                              xx.CCInvoiceDate,
                              xx.DespatchAdviceNo,
                              xx.DespatchAdviceDate,
                              xx.InterUnitTransferNo,
                              xx.InterUnitTransferDate,
                              xx.PartyName,
                              xx.Transporter,
                              xx.VehicleNo,
                              xx.LorryNo,
                              xx.LorryDate,
                              xx.FreightTypeCode,
                              xx.FreightRate,
                              xx.FreightUnitCode,
                              xx.FreightContractNo,
                              xx.ItemCode,
                              xx.Item,
                              xx.UOM,
                              xx.Quantity1,
                              xx.Rate,
                              xx.Amount,
                              xx.FooterAmount,
                              xx.TotalAmount,
                              xx.VStatus,
                              xx.VoucherNo,
                              xx.VoucherDate,
                              xx.MIStatus,
                              xx.MaterialInNo,
                              xx.MaterialInDate,
                              xx.Creator,
                              xx.CreationTime
                )xxx
                Order by 1
                
                */
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
