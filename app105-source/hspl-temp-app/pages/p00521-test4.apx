        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/ccinvoiceregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P521_FROMDATE=&P521_FROMDATE.&P521_TODATE=&P521_TODATE.&P521_LOCATION=&P521_LOCATION.&P521_DOCTYPE=&P521_DOCTYPE.&P521_PARTY=&P521_PARTY.&P521_TRANSPORTER=&P521_TRANSPORTER.&P521_ITEM=&P521_ITEM.&P521_ITEMSPECIFICATION=&P521_ITEMSPECIFICATION.&P521_CCINO=&P521_CCINO.&P521_VEHICLENO=&P521_VEHICLENO.&P521_VSTATUS=&P521_VSTATUS.&P521_MISTATUS=&P521_MISTATUS.
            warnOnUnsavedChanges: doNotCheck
