        }
    )

    pageItem P159_STORAGELOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Storage Loc
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT STORAGELOCATIONNAME AS D,
                STORAGELOCATIONCODE AS R
                FROM STORAGELOCATION 
                WHERE ( :P159_LOCATION IS NULL OR LOCATIONCODE = :P159_LOCATION)
                ```
        }
        layout {
            sequence: 50
            region: @stock-statement
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Storage Location Name
        }
    )

