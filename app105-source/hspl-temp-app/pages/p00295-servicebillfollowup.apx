page 295 (
    name: ServiceBillFollowup
    alias: SERVICEBILLFOLLOWUP
    title: ServiceBillFollowup
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                c.CompanyName as Company,
                l.LOCATIONNAME AS LOCATION,
                sb.SERVICEBillno AS BillNo,
                sb.SERVICEBilldate AS BillDate,
                p.partyname as Party,
                sb.servicebillamount as BillAmount,
                '0' as receivedamount,
                sb.deductedamount,
                sb.SUMOFAMOUNT as Amount
                from servicebill SB,PARTY P,PARTYTYPE PT,
                LOCATION L,Company c
                where sb.locationcode = l.locationcode(+)
                and sb.CompanyCode =c.CompanyCode(+)
                AND SB.PARTYCODE = P.PARTYCODE(+)
                AND P.PARTYTYPECODE = PT.PARTYTYPECODE(+)
                and sb.servicebilldate between :P295_FROMDATE and :P295_TODATE
                and (:P295_COMPANY IS NULL OR instr(':'||:P295_COMPANY||':',':'||c.Companycode||':') > 0)
                and (:P295_PARTY IS NULL OR instr(':'||:P295_PARTY||':',':'||p.Partycode||':') > 0)
                /*
                UNION ALL
                
                select
                l.LOCATIONNAME AS LOCATION,
                sb.SERVICEBillno AS BillNo,
                sb.SERVICEBilldate AS BillDate,
                sb.partyname as Customer,
                sb.servicebillamount as BillAmount,
                '0' as receivedamount,
                sb.deductedamount,
                sb.pendingamount as amount
                from servicebillfollowup SB,
                LOCATION L
                where sb.locationcode = l.locationcode(+)
                and sb.servicebilldate between :P295_FROMDATE and :P295_TODATE
                --and (:P295_LOCATION IS NULL OR instr(':'||:P295_LOCATION||':',':'||L.locationcode||':') > 0)
                
                union all
                
                select
                L.LOCATIONNAME AS Location,
                a.InvoiceNo as ServiceBillNo,
                a.InvoiceDate AS ServiceBillDate,
                b.PartyName,
                a.InvoiceAmount as ServicebillAmount,
                e.DeductedAmount,
                nvl(a.paidamount,0) as receivedamount,
                a.InvoiceAmount - nvl(e.PaidAmount, 0) - nvl(e.DeductedAmount, 0) as PendingAmount
                from Invoice a, Party b,PARTYTYPE pt,location l, (
                select
                ax.InvoiceTNo,
                ax.PaidAmount,
                ax.DeductedAmount
                from ServicebillPaidAsOnDate ax
                ) e
                where
                a.PartyCode = b.PartyCode
                and a.locationcode = l.locationcode
                and a.TNo = e.InvoiceTNO
                and b.partytypecode = pt.partytypecode
                and a.Invoicedate between :P295_FROMDATE and :P295_TODATE
                --and (:P295_LOCATION IS NULL OR instr(':'||:P295_LOCATION||':',':'||L.locationcode||':') > 0)
                */
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 18262772589558142
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column BILLAMOUNT (
            type: plainText
            heading {
                heading: Bill Amount
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column BILLDATE (
            type: plainText
            heading {
                heading: Bill Date
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column BILLNO (
            type: plainText
            heading {
                heading: Bill No
                alignment: center
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column COMPANY (
            type: plainText
            heading {
                heading: Company
                alignment: center
            }
            layout {
                sequence: 180
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column DEDUCTEDAMOUNT (
            type: plainText
            heading {
                heading: Deducted Amount
                alignment: center
            }
            layout {
                sequence: 150
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column LOCATION (
            type: plainText
            heading {
                heading: Location
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column PARTY (
            type: plainText
            heading {
                heading: Party
                alignment: center
            }
            layout {
                sequence: 170
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column RECEIVEDAMOUNT (
            type: plainText
            heading {
                heading: Received Amount
                alignment: center
            }
            layout {
                sequence: 160
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 205558 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 8
            )

            displayColumn BILLAMOUNT (
                sequence: 5
            )

            displayColumn BILLDATE (
                sequence: 4
            )

            displayColumn BILLNO (
                sequence: 3
            )

            displayColumn COMPANY (
