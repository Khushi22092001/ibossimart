page 47 (
    name: test
    alias: TEST
    title: test
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region chart (
        name: Chart 1
        type: chart
        source {
            pageItemsToSubmit: P47_PARTYCODE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chartLayout {
            height: 400
        }
        legend {
            show: false
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select TO_CHAR(A.PDATE, 'Mon') As PMONTH, Sum(b.TOTALAMOUNT) As Amount, to_char(a.pdate,'MMYYYY') As PDATE
                      From BI_DATETIME A, BI_PREVENUE B
                     Where A.PDATE = B.PBPASSDATE
                     Group By TO_CHAR(A.PDATE, 'Mon'),to_char(a.pdate,'MMYYYY')
                     Order By PDATE
                    ```
            }
            columnMapping {
                label: PMONTH
                value: AMOUNT
            }
            performance {
                maxRowsToProcess: 20
            }
        )

        axis x (
            name: x
            majorTicks {
                show: auto
            }
        )

        axis y (
            name: y
            majorTicks {
                show: auto
            }
        )

    )

    region chart-2 (
        name: Chart 2
        type: chart
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        chart {
            type: pie
        }
        legend {
            show: false
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select C.PARTYNAME, Sum(b.TOTALAMOUNT) As Amount, to_char(a.pdate,'MMYYYY') As PDATE, C.PARTYCODE
                      From BI_DATETIME A, BI_PREVENUE B, BI_PARTY C
                     Where A.PDATE = B.PBPASSDATE
                       And B.PARTYCODE = C.PARTYCODE
                     Group By C.PARTYNAME,to_char(a.pdate,'MMYYYY'),C.PARTYCODE
                     Order By PDATE
                    ```
            }
            columnMapping {
                label: PARTYNAME
                value: AMOUNT
            }
            link {
                type: redirectThisApp
                target: {
                    page: 47
                    items: {
                        P47_PARTYCODE: &PARTYCODE.
                    }
                }
            }
            label {
                show: true
            }
            performance {
                maxRowsToProcess: 20
            }
        )

    )

    region chart-3 (
        name: Chart 3
        type: chart
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            escapeSpecialChars: false
        }
        legend {
            show: false
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select C.ITEMNAME, Sum(b.TOTALAMOUNT) As Amount, to_char(a.pdate,'MMYYYY') As PDATE
                      From BI_DATETIME A, BI_PREVENUE B, BI_PRODUCTS C
                     Where A.PDATE = B.PBPASSDATE
                       And B.ITEMCODE = C.ITEMCODE
                       AND(B.PARTYCODE = :P47_PARTYCODE OR :P47_PARTYCODE IS NULL )
                     Group By C.ITEMNAME,to_char(a.pdate,'MMYYYY')
                     Order By ITEMNAME
                    ```
            }
            columnMapping {
                label: ITEMNAME
                value: AMOUNT
            }
            performance {
                maxRowsToProcess: 20
            }
        )

        axis x (
            name: x
            majorTicks {
                show: auto
            }
        )

        axis y (
            name: y
            majorTicks {
                show: auto
            }
        )

    )

    pageItem P47_PARTYCODE (
        type: textField
        label {
            label: Partycode
            alignment: left
        }
        layout {
            sequence: 10
            region: @chart
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

)

