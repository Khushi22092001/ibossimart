page 468 (
    name: Fixed Asset Register
    alias: FIXED-ASSET-REGISTER
    title: Fixed Asset Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region fixed-asset-register (
        name: Fixed Asset Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region fixed-asset-register-2 (
        name: Fixed Asset Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.TNo,
                f.CompanyName,
                d.LocationName,
                e.DocTypeName,
                c.PartyName as AccountName,
                a.AssetNo,
                a.AssetDate,
                g.VoucherNo,
                g.VoucherDate,
                h.ItemName,
                i.ItemSpecificationName,
                b.AssetCode,
                b.AssetValue,
                b.DepreciatedAmount
                from Asset a, AssetCodeDetail b, Party c, Location d, DocType e, Company f, Voucher g, Item h, ItemSpecification i
                where a.tno = b.tno 
                and a.AccountCode = c.PartyCode
                and a.LocationCode = d.LocationCode
                and a.DocTypeCode = e.DocTypeCode
                and a.CompanyCode = f.CompanyCode
                and a.TNO = g.ModuleTNo(+)
                and a.ItemCode = h.ItemCode
                and a.ItemSpecificationCode = i.ItemSpecificationCode
                and a.AssetDate Between :P468_FROMDATE and :P468_TODATE
                and ( :P468_COMPANY IS NULL OR INSTR(':'||:P468_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 23202239661913602
        }

        column ACCOUNTNAME (
            type: plainText
            heading {
                heading: Account Name
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ASSETCODE (
            type: plainText
            heading {
                heading: Asset Code
