page 219 (
    name: Destination
    alias: DESTINATION
    title: Destination
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region destination (
        name: Destination
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.PartyName,
                       a.DESTINATIONLOCATIONCODE,
                       a.DESTINATIONLOCATIONNAME,
                       c.DestinationTypeName,
                       a.REMARK
                  from DESTINATIONLOCATION a, Party b, DestinationType c
                  where a.PartyCode = b.PartyCode(+)
                      and a.DestinationTypeCode = c.DestinationTypeCode(+)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 55637776456632378
        }

