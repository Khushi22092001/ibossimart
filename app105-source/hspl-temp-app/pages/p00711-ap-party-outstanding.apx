                        P713_PARTY: #PARTY_CODE#
                        P713_FROMDATE: &P711_FROMDATE.
                        P713_TODATE: &P711_TODATE.
                        P713_COMPANY: &P711_COMPANY.
                        P713_LOCATION: &P711_LOCATION.
                        P713_PANEL: &P711_PANEL.
                        P713_AGEBASIS: &P711_AGEBASIS.
                    }
                    clearCache: 713
