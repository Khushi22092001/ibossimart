page 225 (
    name: Freight Advice Transport Wise TDS Report
    alias: FREIGHT-ADVICE-TRANSPORT-WISE-TDS-REPORT
    title: Freight Advice Transport Wise TDS Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region freight-advice-transport-wise-tds (
        name: "Freight Advice Transport Wise TDS "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region freight-advice-transport-wise-tds-report (
        name: Freight Advice Transport Wise TDS Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	  a.FreightAdviceNo,
                	  a.FreightAdviceDate,
                	  a.PaidTo,
                	  bb.TDSMasterName,
                	  bb.TotalTDSRate,
                	  a.FreightAdviceAmount
                From FreightAdvice a, Transporter T, TransporterTDS aa, TDSMaster bb
                where a.PaidToCode = T.TransporterCode(+)
                      and T.Tno = aa.Tno(+)
                      and aa.TDSMasterCode = bb.TDSMasterCode(+)
                      and a.FreightAdviceDate between :P225_FROMDATE and :P225_TODATE
                      and (a.TransporterCode = :P225_TRANSPORTERNAME
                      or :P225_TRANSPORTERNAME is null
                       )
                ;
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12283571203941928
        }

        savedReport 130265 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @FREIGHTADVICENO
                layout {
                    width: 187
                    sequence: 1
                }
            )

            displayColumn (
                column: @FREIGHTADVICEDATE
                layout {
                    width: 255
                    sequence: 2
                }
            )

            displayColumn (
                column: @PAIDTO
                layout {
                    width: 301
                    sequence: 3
                }
            )

            displayColumn (
                column: @TDSMASTERNAME
                layout {
                    width: 213
                    sequence: 4
                }
            )

            displayColumn (
                column: @TOTALTDSRATE
                layout {
                    width: 200
                    sequence: 6
                }
            )

            displayColumn (
                column: @FREIGHTADVICEAMOUNT
                layout {
                    width: 187
                    sequence: 5
                }
            )

            filter (
                type: rowSearch
                search: 125
            )

        )

        column FREIGHTADVICEAMOUNT (
            type: numberField
            heading {
                heading: Freight Advice Amount
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: FREIGHTADVICEAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column FREIGHTADVICEDATE (
            type: datePicker
            heading {
                heading: Freight Advice Date
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                databaseColumn: FREIGHTADVICEDATE
                dataType: date
            }
        )

        column FREIGHTADVICENO (
            type: textarea
            heading {
                heading: Freight Advice No
            }
            layout {
                sequence: 10
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: FREIGHTADVICENO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column PAIDTO (
            type: textarea
            heading {
                heading: Paid To
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: PAIDTO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column TDSMASTERNAME (
            type: textarea
            heading {
                heading: TDS Master Name
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: TDSMASTERNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column TOTALTDSRATE (
            type: numberField
            heading {
                heading: Total TDS Rate
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: TOTALTDSRATE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Freight Advice Transport Wise TDS Report
        }
    )

    pageItem P225_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @freight-advice-transport-wise-tds
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P225_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @freight-advice-transport-wise-tds
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P225_TRANSPORTERNAME (
        type: popupLov
        label {
            label: Transporter Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.TransporterName,
                a.TransporterCode
                From transporter a
                Order by a.TransporterName
                ```
            nullDisplayValue: -SELECT LIST-
        }
        layout {
            sequence: 40
            region: @freight-advice-transport-wise-tds
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 50
            region: @freight-advice-transport-wise-tds
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 4
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

