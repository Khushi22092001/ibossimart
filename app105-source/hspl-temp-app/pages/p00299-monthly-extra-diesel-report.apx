page 299 (
    name: Monthly Extra Diesel Report
    alias: MONTHLY-EXTRA-DIESEL-REPORT
    title: Monthly Extra Diesel Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region monthly-extra-diesel-report (
        name: MONTHLY EXTRA DIESEL REPORT
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region monthly-extra-diesel-report-2 (
        name: Monthly Extra Diesel Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    a.DriverName,
                    a.VehicleNo,
                    b.SourceLocationName,
                    c.DestinationLocationName,
                    Count(a.VehicleNo) as trips,
                    round(nvl(d.DistanceinKm,0)/nvl(d.DieselForLoadedVehicle,1),4) as FixAverage,
                    Count(Nvl(a.VehicleNo,1))* Nvl(d.DieselForLoadedVehicle,0) as FixDiesel,
                    round(SUM(e.RunningDieselQuantity),3) as TotalConsumption,
                    Case When Sum(Nvl(e.RunningDieselQuantity,0)) != 0 then
                    Sum(Nvl(e.RunningDieselQuantity,0))  - (Count(Nvl(a.VehicleNo,1)) *
                    Nvl(d.DieselForLoadedVehicle,0)) else 0 end as "Extra Diesel",
                    a.Creator
                from Placement a, SourceLocation b, DestinationLocation c, 
                     StandardDieselConsumption d, NecessitySlip e, 
                     (Select a.vehicleno from CompanyVehicle a,
                     HIREDVEHICLE b 
                     where b.VehicleNo = a.VehicleNo
                     and a.VehicleGroupCode = 'COMMON'
                     union all
                     Select a.vehicleno from CompanyVehicle a
                     where a.VehicleGroupCode = 'SELF') f
                Where a.SourceLocationTno = b.Tno
                    and a.DestinationLocationTno = c.Tno
                    and a.SourceLocationTno = d.SourceLocationTno(+)
                    and a.DestinationLocationTno = d.DestinationLocationTno(+)
                    and a.VehicleNo = e.Vehicleno(+)
                    and a.PlacementDate = e.NecessitySlipDate(+)
                    and a.Vehicleno = f.VehicleNo
                    --and b.SourceLocationCode = e.LocationCode
                    and a.PlacementDate Between :P299_FROMDATE and :P299_TODATE
                    and ( :P299_COMPANY IS NULL OR instr(':'||:P299_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and ( :P299_VEHICLENO IS NULL OR instr(':'||:P299_VEHICLENO||':',':'||a.VehicleNo||':') > 0 )
                    and ( :P299_DRIVER IS NULL OR instr(':'||:P299_DRIVER||':',':'||a.DriverName||':') > 0 ) 
                Group by 
                    a.DriverName,
                    a.VehicleNo ,
                    b.SourceLocationName,
                    c.DestinationLocationName,
                    d.DistanceinKm,
                    d.DieselForLoadedVehicle,
                    a.Creator;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 18738009880068305
        }

