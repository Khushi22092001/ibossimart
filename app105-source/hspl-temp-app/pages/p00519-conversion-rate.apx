page 519 (
    name: Conversion Rate
    alias: CONVERSION-RATE
    title: Conversion Rate
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region conversion-rate (
        name: Conversion Rate
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.COMPANYCODE,
                       A.ITEMCODE,
                       A.ITEMSPECIFICATIONCODE,
                       B.ITEMNAME,
                       C.ITEMSPECIFICATIONNAME,
                       A.DATEONWARD,
                       A.CONVERSIONRATE,
                       A.CREATOR,
                       TO_CHAR(A.CREATIONTIME,'DD-MM-RRRR HH24:MI') CREATIOTIME
                 from conversionrate A , ITEM B, ITEMSPECIFICATION C
                 WHERE A.ITEMCODE = B.ITEMCODE
                   AND A.ITEMSPECIFICATIONCODE = C.ITEMSPECIFICATIONCODE
                 order by a.itemcode, a.itemspecificationcode, a.dateonward desc 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 10098712798145120
        }

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CONVERSIONRATE (
            type: plainText
            heading {
                heading: Conversionrate
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column CREATIOTIME (
            type: plainText
            heading {
                heading: Creatiotime
            }
            layout {
                sequence: 38
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column DATEONWARD (
            type: plainText
            heading {
                heading: Dateonward
            }
            layout {
                sequence: 5
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column ITEMCODE (
            type: plainText
            heading {
                heading: Itemcode
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ITEMNAME (
            type: plainText
            heading {
                heading: Itemname
            }
            layout {
                sequence: 18
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: plainText
            heading {
                heading: Itemspecificationcode
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ITEMSPECIFICATIONNAME (
            type: plainText
            heading {
                heading: Itemspecificationname
            }
            layout {
                sequence: 28
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Conversion Rate
        }

        savedReport 101101 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CONVERSIONRATE (
                sequence: 4
            )

            displayColumn CREATIOTIME (
                sequence: 6
            )

            displayColumn CREATOR (
                sequence: 5
            )

            displayColumn DATEONWARD (
                sequence: 3
            )

            displayColumn ITEMNAME (
                sequence: 1
            )

            displayColumn ITEMSPECIFICATIONNAME (
                sequence: 2
            )

        )

    )

)

