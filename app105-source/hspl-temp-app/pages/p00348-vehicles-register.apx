page 348 (
    name: Vehicles Register
    alias: VEHICLES-REGISTER
    title: Vehicles Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: " Report"
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    c.CompanyName,
                    a.CompanyVehicleNo as VehicleNo,
                    b.VehicleType,
                    d.VehicleGroupName,
                    e.TransporterName as OwnerName,
                    f.TransporterName
                from CompanyVehicle a, VehicleType b, Company c, VehicleGroup d, Transporter e, Transporter f
                Where a.VehicleTypeCode = b.VehicleTypeCode(+)
                  and a.CompanyCode = c.CompanyCode(+)
                  and a.VehicleGroupCode = d.VehicleGroupCode(+)
                  and a.TransporterCode = e.TransporterCode(+)
                  and a.OwnerCode = f.TransporterCode(+)
                  and (a.VehicleNo = :P348_VEHICLENO
                    or :P348_VEHICLENO is null)
                  and (e.TransporterName = :P348_TRANSPORTERNAME
                    or :P348_TRANSPORTERNAME is null
                  )
                ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 70147721410319463
        }

        savedReport 153994 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @COMPANYNAME
                layout {
                    width: 277
                    sequence: 1
                }
            )

            displayColumn (
                column: @VEHICLENO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @VEHICLETYPE
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @VEHICLEGROUPNAME
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @OWNERNAME
                layout {
                    width: 223.547
                    sequence: 5
                }
            )

            displayColumn (
                column: @TRANSPORTERNAME
                layout {
                    width: 255.000125
                    sequence: 6
                }
            )

        )

        column COMPANYNAME (
            type: textarea
            heading {
                heading: Company Name
            }
            layout {
                sequence: 10
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: COMPANYNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column OWNERNAME (
            type: textarea
            heading {
                heading: Owner Name
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: OWNERNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column TRANSPORTERNAME (
            type: textarea
            heading {
                heading: Transporter Name
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: TRANSPORTERNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column VEHICLEGROUPNAME (
            type: textarea
            heading {
                heading: Vehicle Group Name
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: VEHICLEGROUPNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column VEHICLENO (
            type: textarea
            heading {
                heading: Vehicle No
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: VEHICLENO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column VEHICLETYPE (
            type: textField
            heading {
                heading: Vehicle Type
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: VEHICLETYPE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: " Report"
        }
    )

    region vehicle-register (
        name: Vehicle Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P348_TRANSPORTERNAME (
        type: popupLov
        label {
            label: Transporter Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.TransporterName from Transporter a;
                
                ```
            nullDisplayValue: -SELECT LIST-
        }
        layout {
            sequence: 20
            region: @vehicle-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 6
            columnSpan: 5
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P348_VEHICLENO (
        type: popupLov
        label {
            label: Vehicle No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.CompanyVehicleNo as VehicleNo
                From CompanyVehicle a;
                ```
            nullDisplayValue: -SELECT LIST-
        }
        layout {
            sequence: 10
            region: @vehicle-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 30
            region: @vehicle-register
            slot: regionBody
            column: 11
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

