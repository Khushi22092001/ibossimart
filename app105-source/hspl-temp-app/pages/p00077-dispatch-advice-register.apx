page 77 (
    name: Dispatch Advice Register
    alias: DISPATCH-ADVICE-REGISTER
    title: Dispatch Advice Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region dispatch-advice-register (
        name: Dispatch Advice Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region dispatch-advice-register-report (
        name: Dispatch Advice Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                --- Interunit Transfer ---
                Select
                      a.TNo,
                      l.LocationName,
                      dt.DocTypeName,
                      a.DespatchAdviceNo,
                      a.DespatchAdviceDate,
                      iut.InterUnitTransferNo as ReferenceNo,
                      iut.InterUnitTransferDate as ReferenceDate,
                      'InterUnit Transfer' as Reference,
                      p.PartyName,
                      t.PartyName as Transporter,
                      e.EmployeeName||' ( '||e.EmployeeID||' )' as Employee,
                      a.Drivername,
                      a.VehicleNo,
                      e.ItemCode,
                      e.Itemname||' ~ '||ee.itemSpecificationName as Item,
                      e.MeasuringUnitCode1,
                      b.Quantity1,
                      e.MeasuringUnitCode2,
                      b.Quantity2,
                      nvl(Decode(mo.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') as MSTATUS,
                      mo.MaterialOutNo,
                      mo.MaterialOutDate,
                      nvl(Decode(w.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') as WSTATUS,
                      w.WeighmentNo,
                      w.WeighmentDate,
                      bue.EmployeeName||' ( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      To_Char(a.CreationTime,'DD-MM-RRRR HH24:MI:SS') as DispatchCreation,
                      --x.FinalWeight,
                      w.SecondWeight - w.FirstWeight FinalWeight,
                	  w.FirstWeight,
                	  w.SecondWeight,
                      nvl(Decode(ci.DespatchAdviceTno,a.TNo,'PREPARED'),'PENDING') as InvoiceSTATUS,
                      TO_CHAR(TRUNC(SYSDATE) + abs(x.SecondWeightTime - a.creationtime), 'HH24:MI:SS') as  TimeTaken
                From  DespatchAdvice a, DespatchAdviceDetail b, Location l, DocType dt, Party p, Party t, Employee e, BossUser bu, Employee bue, Item e, itemSpecification ee, InterunitTransfer iut,
                      MaterialOut mo, Weighment w,
                      (Select
                        aa.ReferenceTno,
                        max(To_Char(aa.SecondWeightTime,'DD-MM-RRRR HH24:MI:SS')) as FinalWeight,
                        max(aa.SecondWeightTime) as SecondWeightTime
                        From Weighment aa
                        Group By aa.ReferenceTno)x, CCInvoice ci, DocumentStatusDetail dsd
                Where a.TNo = b.TNo(+)
                  and a.Locationcode = l.LocationCode(+)
                  and a.DocTypeCode = dt.DocTypeCode(+)
                  and a.PartyCode = p.PartyCode(+)
                  and a.TransporterCode = t.PartyCode(+)
                  and a.EmployeeCode = e.EmployeeCode(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)
                  and b.ItemCode = e.ItemCode(+)
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and a.ReferenceTNo = iut.TNo
                  and a.TNo = mo.ReferenceTNo(+)
                  and a.TNo = w.ReferenceTNo(+)
                  and b.ItemCode = w.ItemCode(+)
                  and b.ItemSpecificationCode = w.ItemSpecificationCode(+)
                  and a.Tno = x.ReferenceTno(+)
                  and a.Tno = ci.DespatchAdviceTno(+)
                  and a.Tno = dsd.ModuleTno(+)
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and trunc(a.DespatchAdviceDate) between :P77_FROMDATE and :P77_TODATE
                  and instr(':'||:P77_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P77_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P77_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                  and ( :P77_PARTY IS NULL OR instr(':'||:P77_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                  and ( :P77_TRANSPORTER IS NULL OR instr(':'||:P77_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 ) 
                  and ( :P77_ITEM IS NULL OR instr(':'||:P77_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P77_ITEMSPECIFICATION IS NULL OR instr(':'||:P77_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                  --and a.DespatchAdviceNo like nvl(:P77_DANO,'%')
                  and (:P77_VEHICLENO is null or a.VehicleNo = :P77_VEHICLENO)
                  and nvl(Decode(w.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P77_WSTATUS,'%')
                  and nvl(Decode(mo.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P77_MSTATUS,'%')
                 and ( :P77_STATUS IS NULL OR instr(':'||:P77_STATUS||':',':'||dsd.DocumentStatusCode||':') > 0 ) 
                  and nvl(Decode(ci.DespatchAdviceTno,a.TNo,'PREPARED'),'PENDING') like nvl(:P77_CCINVOICESTATUS,'%')
                Union All
                --- MRN ---
                Select
                      a.TNo,
                      l.LocationName,
                      dt.DocTypeName,
                      a.DespatchAdviceNo,
                      a.DespatchAdviceDate,
                      m.MRNNo as ReferenceNo,
                      m.MRNDate as ReferenceDate,
                      'MRN' as Reference,
                      p.PartyName,
                      t.PartyName as Transporter,
                      e.EmployeeName||' ( '||e.EmployeeID||' )' as Employee,
                      a.Drivername,
                      a.VehicleNo,
                      e.ItemCode,
                      e.Itemname||' ~ '||ee.itemSpecificationName as Item,
                      e.MeasuringUnitCode1,
                      b.Quantity1,
                      e.MeasuringUnitCode2,
                      b.Quantity2,
                      nvl(Decode(mo.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') as MSTATUS,
                      mo.MaterialOutNo,
                      mo.MaterialOutDate,
                      nvl(Decode(w.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') as WSTATUS,
                      w.WeighmentNo,
                      w.WeighmentDate,
                      bue.EmployeeName||' ( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      To_Char(a.CreationTime,'DD-MM-RRRR HH24:MI:SS') as DispatchCreation,
                      --x.FinalWeight,
                      w.SecondWeight - w.FirstWeight FinalWeight,
                	  w.FirstWeight,
                	  w.SecondWeight,
                      nvl(Decode(ci.DespatchAdviceTno,a.TNo,'PREPARED'),'PENDING') as InvoiceSTATUS,
                      TO_CHAR(TRUNC(SYSDATE) + abs(x.SecondWeightTime - a.creationtime), 'HH24:MI:SS') as  TimeTaken
                From  DespatchAdvice a, DespatchAdviceDetail b, Location l, DocType dt, Party p, Party t, Employee e, BossUser bu, Employee bue, Item e, itemSpecification ee, MRN m,
                      MaterialOut mo, Weighment w,
                      (Select
                        aa.ReferenceTno,
                        max(To_Char(aa.SecondWeightTime,'DD-MM-RRRR HH24:MI:SS')) as FinalWeight,
                        max(aa.SecondWeightTime) as SecondWeightTime
                        From Weighment aa
                        Group By aa.ReferenceTno)x, CCInvoice ci, DocumentStatusDetail dsd
                Where a.TNo = b.TNo(+)
                  and a.Locationcode = l.LocationCode(+)
                  and a.DocTypeCode = dt.DocTypeCode(+)
                  and a.PartyCode = p.PartyCode(+)
                  and a.TransporterCode = t.PartyCode(+)
                  and a.EmployeeCode = e.EmployeeCode(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)
                  and b.ItemCode = e.ItemCode(+)
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and a.ReferenceTNo = m.TNo
                  and a.TNo = mo.ReferenceTNo(+)
                  and a.TNo = w.ReferenceTNo(+)
                  and b.ItemCode = w.ItemCode(+)
                  and b.ItemSpecificationCode = w.ItemSpecificationCode(+)
                  and a.Tno = x.ReferenceTno(+)
                  and a.Tno = ci.DespatchAdviceTno(+)
                  and a.Tno = dsd.ModuleTno(+)
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and trunc(a.DespatchAdviceDate) between :P77_FROMDATE and :P77_TODATE
                  and instr(':'||:P77_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P77_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P77_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                  and ( :P77_PARTY IS NULL OR instr(':'||:P77_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                  and ( :P77_TRANSPORTER IS NULL OR instr(':'||:P77_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 ) 
                  and ( :P77_ITEM IS NULL OR instr(':'||:P77_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P77_ITEMSPECIFICATION IS NULL OR instr(':'||:P77_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                  --and a.DespatchAdviceNo like nvl(:P77_DANO,'%')
                  and (:P77_VEHICLENO is null or a.VehicleNo = :P77_VEHICLENO)
                  and nvl(Decode(w.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P77_WSTATUS,'%')
                  and nvl(Decode(mo.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P77_MSTATUS,'%')
                  and ( :P77_STATUS IS NULL OR instr(':'||:P77_STATUS||':',':'||dsd.DocumentStatusCode||':') > 0 ) 
                  and nvl(Decode(ci.DespatchAdviceTno,a.TNo,'PREPARED'),'PENDING') like nvl(:P77_CCINVOICESTATUS,'%')
                
                Union All
                --- Sales Order ---
                Select
                      a.TNo,
                      l.LocationName,
                      dt.DocTypeName,
                      a.DespatchAdviceNo,
                      a.DespatchAdviceDate,
                      iut.SalesOrderNo as ReferenceNo,
                      iut.SalesOrderDate as ReferenceDate,
                      'Sales Order' as Reference,
                      p.PartyName,
                      t.PartyName as Transporter,
                      e.EmployeeName||' ( '||e.EmployeeID||' )' as Employee,
                      a.Drivername,
                      a.VehicleNo,
                      e.ItemCode,
                      e.Itemname||' ~ '||ee.itemSpecificationName as Item,
                      e.MeasuringUnitCode1,
                      b.Quantity1,
                      nvl(pt.PackingTypeName,e.MeasuringUnitCode2) as MeasuringUnitCode2 ,
                      b.Quantity2,
                      nvl(Decode(mo.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') as MSTATUS,
                      mo.MaterialOutNo,
                      mo.MaterialOutDate,
                      nvl(Decode(w.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') as WSTATUS,
                      w.WeighmentNo,
                      w.WeighmentDate,
                      bue.EmployeeName||' ( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      To_Char(a.CreationTime,'DD-MM-RRRR HH24:MI:SS') as DispatchCreation,
                      --x.FinalWeight,
                      w.SecondWeight - w.FirstWeight FinalWeight,
                	  w.FirstWeight,
                	  w.SecondWeight,
                      nvl(Decode(ci.DespatchAdviceTno,a.TNo,'PREPARED'),'PENDING') as InvoiceSTATUS,
                      TO_CHAR(TRUNC(SYSDATE) + abs(x.SecondWeightTime - a.creationtime), 'HH24:MI:SS') as  TimeTaken
                From  DespatchAdvice a, DespatchAdviceDetail b, Location l, DocType dt, Party p, Party t, Employee e, BossUser bu, Employee bue, Item e, itemSpecification ee, SalesOrder iut,
                      MaterialOut mo, Weighment w, PackingType pt,
                      (Select
                        aa.ReferenceTno,
                        max(To_Char(aa.SecondWeightTime,'DD-MM-RRRR HH24:MI:SS')) as FinalWeight,
                        max(aa.SecondWeightTime) as SecondWeightTime
                        From Weighment aa
                        Group By aa.ReferenceTno)x, CCinvoice ci, DocumentStatusDetail dsd
                Where a.TNo = b.TNo(+)
                  and a.Locationcode = l.LocationCode(+)
                  and a.DocTypeCode = dt.DocTypeCode(+)
                  and a.PartyCode = p.PartyCode(+)
                  and a.TransporterCode = t.PartyCode(+)
                  and a.EmployeeCode = e.EmployeeCode(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)
                  and b.ItemCode = e.ItemCode(+)
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and a.ReferenceTNo = iut.TNo
                  and a.TNo = mo.ReferenceTNo(+)
                  and a.TNo = w.ReferenceTNo(+)
                  and b.ItemCode = w.ItemCode(+)
                  and b.ItemSpecificationCode = w.ItemSpecificationCode(+)
                  and b.PackingTypeCode = pt.PackingTypeCode(+)
                  and a.Tno = x.ReferenceTno(+)
                  and a.Tno = ci.DespatchAdviceTno(+)
                  and a.Tno = dsd.ModuleTno(+)
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    and trunc(a.DespatchAdviceDate) between :P77_FROMDATE and :P77_TODATE
                  and instr(':'||:P77_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P77_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P77_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                  and ( :P77_PARTY IS NULL OR instr(':'||:P77_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                  and ( :P77_TRANSPORTER IS NULL OR instr(':'||:P77_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 ) 
                  and ( :P77_ITEM IS NULL OR instr(':'||:P77_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P77_ITEMSPECIFICATION IS NULL OR instr(':'||:P77_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                  --and a.DespatchAdviceNo like nvl(:P77_DANO,'%')
                  and (:P77_VEHICLENO is null or a.VehicleNo = :P77_VEHICLENO)
                  and nvl(Decode(w.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P77_WSTATUS,'%')
                  and nvl(Decode(mo.ReferenceTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P77_MSTATUS,'%')
                  and ( :P77_STATUS IS NULL OR instr(':'||:P77_STATUS||':',':'||dsd.DocumentStatusCode||':') > 0 ) 
                   and nvl(Decode(ci.DespatchAdviceTno,a.TNo,'PREPARED'),'PENDING') like nvl(:P77_CCINVOICESTATUS,'%')
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
