    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P77_DANO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P77_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P77_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 5843254873719533
        }
    )

)

