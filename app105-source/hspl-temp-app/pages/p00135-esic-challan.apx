page 135 (
    name: ESIC Challan
    alias: ESIC-CHALLAN
    title: ESIC Challan
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region esic-challan (
        name: ESIC Challan
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.TNO,
                       row_number() over(order by A.ESICHALLANDATE) SerialNo,
                       A.ESICHALLANNO,
                       A.ESICHALLANDATE,
                       TO_CHAR(A.FORMONTH, 'MON-RRRR') As FORMONTH,
                       A.NOOFEMPLOYEES,
                       A.TOTALWAGES,
                       round(A.EMPLOYEESCONTRIBUTIONAMOUNT,2) as EMPLOYEESCONTRIBUTIONAMOUNT,
                       round(A.EMPLOYERSCONTRIBUTIONAMOUNT,2) as EMPLOYERSCONTRIBUTIONAMOUNT,
                       round(A.TOTALAMOUNT,2) as TOTALAMOUNT,
                       A.ESICESTABLISHMENTCODENO,
                       A.PAYMENTMODE,
                       GETPARTYNAME(A.Bankaccountcode) As BankName,
                       round(a.remittanceamount,2) as remittanceamount
                  From esichallan A
                  where a.FORMONTH between :P135_FROMDATE and :P135_TODATE
                  and instr(':'||:P135_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P135_LOCATION||':',':'||a.LocationCode||':') > 0
                 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 136
                items: {
                    P136_TNO: #TNO#
                }
                clearCache: 134
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
            authorizationScheme: @hr-salary-sheet
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 100000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            groupBy: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        heading {
            fixedTo: region
            maxReportHeight: 340
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 20420818129809024
        }

