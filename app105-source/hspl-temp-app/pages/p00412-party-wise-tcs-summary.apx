page 412 (
    name: Party WiseTCS Summary
    alias: PARTY-WISE-TCS-SUMMARY
    title: Party Wise TCS Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region party-wise-tcs-summary (
        name: Party Wise TCS Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       a.LocationCode,
                       a.CompanyCode,
                       a.PartyCode,
                       TO_CHAR(max(a.InvoiceDate),('MON-YY')) AS Month,
                       GetPartyName(a.PartyCode) as PartyName,
                       Round(SUM(a.InvoiceAmount),2) as InvoiceAmount,
                       SUM(b.FooterValue)as TCSAmount,
                       c.CompanyName,
                       d.LocationName,
                       'DETAIL'
                  From Invoice a, InvoiceDetailFooter b, Company c, Location d
                  Where Exists (Select 1
                          From InvoiceDetailFooter xx
                         Where xx.FooterHeadCode = '.TCS.'
                           and xx.Tno = a.Tno)
                    and a.Tno = b.Tno 
                    and b.FooterHeadCode = '.TCS.'
                    and a.CompanyCode = c.CompanyCode 
                    and a.LocationCode = d.LocationCode
                
                    -- 22-APR-2025
                    and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    and TO_CHAR(TO_DATE(a.InvoiceDate),('MON-RRRR'))  = :P412_MONTH
                    and ( :P412_COMPANY IS NULL OR instr(':'||:P412_COMPANY||':',':'||c.CompanyCode||':') > 0 )
                    and ( :P412_PARTY IS NULL OR instr(':'||:P412_PARTY||':',':'||a.Partycode||':') > 0 )
                    and ( :P412_LOCATION IS NULL OR instr(':'||:P412_LOCATION||':',':'||d.LocationCode||':') > 0 )
                    and :P412_MONTH is not null
                Group by a.LocationCode,
                       d.LocationName,
                       a.CompanyCode,
                       c.CompanyName,
                       a.PartyCode
                /* old code 07-nov-2024 
                Select
                       a.LocationCode,
                       a.CompanyCode,
                       a.PartyCode,
                       TO_CHAR(max(a.CCInvoiceDate),('MON-YY')) AS Month,
                       GetPartyName(a.PartyCode) as PartyName,
                       Round(SUM(a.CCInvoiceAmount),2) as CCInvoiceAmount,
                       SUM(b.FooterValue)as TCSAmount,
                       c.CompanyName,
                       d.LocationName,
                       'DETAIL'
                  From CCInvoice a, CCInvoiceDetailFooter b, Company c, Location d
                  Where Exists (Select 1
                          From CCInvoiceDetailFooter xx
                         Where xx.FooterHeadCode = '.TCS.'
                           and xx.Tno = a.Tno)
                    and a.Tno = b.Tno 
                    and b.FooterHeadCode = '.TCS.'
                    and a.CompanyCode = c.CompanyCode 
                    and a.LocationCode = d.LocationCode
                    and TO_CHAR(TO_DATE(a.CCInvoiceDate),('MON-RRRR'))  = :P412_MONTH
                    and ( :P412_COMPANY IS NULL OR instr(':'||:P412_COMPANY||':',':'||c.CompanyCode||':') > 0 )
                    and ( :P412_PARTY IS NULL OR instr(':'||:P412_PARTY||':',':'||a.Partycode||':') > 0 )
                    and ( :P412_LOCATION IS NULL OR instr(':'||:P412_LOCATION||':',':'||d.LocationCode||':') > 0 )
                    and :P412_MONTH is not null
                Group by a.LocationCode,
                       d.LocationName,
                       a.CompanyCode,
                       c.CompanyName,
                       a.PartyCode
                */
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
