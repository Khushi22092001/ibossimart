            }
            advanced {
                endUserAlias: AH
            }
        )

        column NOOFTIPPER (
            type: plainText
            heading {
                heading: No of Tipper
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AC
            }
        )

        column NOOFWAGON (
            type: plainText
            heading {
                heading: No of Wagon
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AD
            }
        )

        column PAYLOADERENTRYDATE (
            type: plainText
            heading {
                heading: Payloader Entry Date
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AJ
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: S No.
                alignment: center
            }
