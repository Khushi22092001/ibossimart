page 403 (
    name: Payloader Average
    alias: PAYLOADER-AVERAGE
    title: Payloader Average
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-diesel-detail (
        name: PayLoader Diesel Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 Select
                  row_number() over(order by a.PayloaderEntryDate) SerialNo,
                  a.CompanyName,
                  a.PayloaderEntryDate, 
                  a.EquipmentTno,
                  a.EquipmentID,
                  nvl(a.DieselQuantity1, 0) as DieselQuantity1,
                  nvl(a.NoOfTipper, 0) as NoOfTipper,
                  nvl(a.NoOfWagon, 0) as NoOfWagon,
                  nvl(a.TotalHMR, 0) as TotalHMR,
                  nvl(a.TipperAverage, 0) as TipperAverage,
                  nvl(a.WagonAverage, 0) as WagonAverage,
                  nvl(a.HMRAverage, 0) as HMRAverage
                From PayloaderDieselAverageDetail a
                Where a.Creator = :APP_USER
                	/*and (:P403_LOCATION is null
                		or exists(
                			 Select
                				aa.LocationCode
                			  From PayloaderPerformanceLocation aa
                			  Where aa.LocationCode = a.LocationCode
                				  and aa.Creator = :APP_USER
                			)
                		)*/
                	and (:P403_COMPANYCODE is Null Or Instr (':' || :P403_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                	and (:P403_EQUIPMENTID is Null Or Instr (':' || :P403_EQUIPMENTID || ':' , ':' || a.EquipmentTno || ':') > 0)
                ```
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 452977976043589218
        }

        column COMPANYNAME (
            type: plainText
            heading {
                heading: Company
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AI
            }
        )

        column DIESELQUANTITY1 (
            type: plainText
            heading {
                heading: Liters
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AB
            }
        )

        column EQUIPMENTID (
            type: plainText
            heading {
                heading: Equipment  ID
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column EQUIPMENTTNO (
            type: hidden
            heading {
                heading: Equipmenttno
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column HMRAVERAGE (
            type: plainText
            heading {
                heading: HMR Average
                alignment: center
            }
