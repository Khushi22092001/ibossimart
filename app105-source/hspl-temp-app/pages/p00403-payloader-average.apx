            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AK
            }
        )

        column TIPPERAVERAGE (
            type: plainText
            heading {
                heading: Tipper Avereage
                alignment: center
            }
            layout {
                sequence: 100
