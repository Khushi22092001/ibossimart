            }
        )

        column WAGONAVERAGE (
            type: plainText
            heading {
                heading: Wagon Average
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AG
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Open Billed Detail
        }

        savedReport 1102245 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn COMPANYNAME (
                sequence: 2
            )

            displayColumn DIESELQUANTITY1 (
                sequence: 5
            )

            displayColumn EQUIPMENTID (
                sequence: 4
            )

            displayColumn HMRAVERAGE (
                sequence: 11
            )

            displayColumn NOOFTIPPER (
                sequence: 7
            )

            displayColumn NOOFWAGON (
                sequence: 6
            )

            displayColumn PAYLOADERENTRYDATE (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TIPPERAVERAGE (
                sequence: 10
            )

            displayColumn TOTALHMR (
                sequence: 8
            )

            displayColumn WAGONAVERAGE (
                sequence: 9
            )

            sort (
                column: PAYLOADERENTRYDATE
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: DIESELQUANTITY1
            )

            aggregate (
                column: NOOFWAGON
            )

            aggregate (
                column: NOOFTIPPER
            )

            aggregate (
                column: TOTALHMR
            )

            aggregate (
                function: average
                column: WAGONAVERAGE
            )

            aggregate (
                function: average
                column: TIPPERAVERAGE
            )

            aggregate (
                function: average
                column: HMRAVERAGE
            )

        )

    )

    pageItem P403_COMPANYCODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P403_EQUIPMENTID (
        type: hidden
        layout {
            sequence: 50
