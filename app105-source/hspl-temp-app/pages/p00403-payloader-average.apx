            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AF
            }
        )

        column TOTALHMR (
            type: plainText
            heading {
                heading: Total HMR
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
