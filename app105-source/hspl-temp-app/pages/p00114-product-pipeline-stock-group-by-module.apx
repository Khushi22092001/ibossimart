page 114 (
    name: Product Pipeline Stock group by Module
    alias: PRODUCT-PIPELINE-STOCK-GROUP-BY-MODULE
    title: Product Pipeline Stock group by Module
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            .reportheight{height: 300px;overflow: auto !important}
            ```
    }
    security {
        formAutoComplete: false
    }

    region module-wise-pipeline-stock (
        name: Module wise Pipeline Stock
        type: chart
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 250
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 
                           MODULECODE,
                           ITEMSPECIFICATIONCODE,
                           sum(QUANTITY1)QUANTITY1
                      from D_PRODUCT360VIEW_PIPELINESTOCK
                     where ItemCode like nvl(:P114_ITEMCODE,'%')
                       and ItemSpecificationCode like nvl(:P114_ITEMSPECIFICATIONCODE,'%')
                     Group by MODULECODE,
                           ITEMSPECIFICATIONCODE
                    ```
            }
            columnMapping {
                label: MODULECODE
                value: QUANTITY1
            }
            link {
                type: redirectThisApp
                target: {
                    page: 108
                    items: {
                        P108_ITEMSPECIFICATIONCODE: &ITEMSPECIFICATIONCODE.
                        P108_MODULECODE: &MODULECODE.
                    }
                    clearCache: 108
                }
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )

    region product-pipeline-stock-group-by-module (
        name: Product Pipeline Stock group by Module
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       MODULECODE,
                       ITEMSPECIFICATIONCODE,
                       sum(QUANTITY1)QUANTITY1
                  from D_PRODUCT360VIEW_PIPELINESTOCK
                 where ItemCode like nvl(:P114_ITEMCODE,'%')
                   and ItemSpecificationCode like nvl(:P114_ITEMSPECIFICATIONCODE,'%')
                 Group by MODULECODE,
                       ITEMSPECIFICATIONCODE
                ```
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: reportheight
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            compute: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 58248006375503623
        }

        column ITEMSPECIFICATIONCODE (
            type: plainText
            heading {
                heading: Item Specification Code
                alignment: center
            }
            layout {
                sequence: 280
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: CP
            }
        )

        column MODULECODE (
            type: link
            heading {
                heading: Module
                alignment: center
            }
            layout {
                sequence: 240
                columnAlignment: center
            }
            link {
                target: {
                    page: 108
                    items: {
                        P108_ITEMSPECIFICATIONCODE: #ITEMSPECIFICATIONCODE#
                        P108_MODULECODE: #MODULECODE#
                    }
                    clearCache: 108
                }
                linkText: #MODULECODE#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: CL
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Base Qty
                alignment: center
            }
            layout {
                sequence: 230
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:60px">#QUANTITY1#</div>
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: W
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Customer Overdue Invoices
        }

        savedReport 75103 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn MODULECODE (
                sequence: 1
            )

            displayColumn QUANTITY1 (
                sequence: 2
            )

            sort (
                column: PBPASSNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: QUANTITY2
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: CGST
            )

            aggregate (
                column: SGST
            )

            aggregate (
                column: IGST
            )

            aggregate (
                column: TCS
            )

            aggregate (
                column: OTHERAMOUNT
            )

            aggregate (
                column: TOTALAMOUNT
            )

            aggregate (
                column: DESPATCHQUANTITY
            )

            aggregate (
                column: INVOICEQUANTITY
            )

            aggregate (
                column: BALANCEQUANTITY
            )

        )

    )

    pageItem P114_FROMAGE (
        type: hidden
        layout {
            sequence: 30
            region: @product-pipeline-stock-group-by-module
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_ITEMCODE (
        type: hidden
        layout {
            sequence: 50
            region: @product-pipeline-stock-group-by-module
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_ITEMSPECIFICATIONCODE (
        type: hidden
        layout {
            sequence: 60
            region: @product-pipeline-stock-group-by-module
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_MONTH (
        type: hidden
        layout {
            sequence: 20
            region: @product-pipeline-stock-group-by-module
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_PARTYCODE (
        type: hidden
        layout {
            sequence: 10
            region: @product-pipeline-stock-group-by-module
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P114_TOAGE (
        type: hidden
        layout {
            sequence: 40
            region: @product-pipeline-stock-group-by-module
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

