    region degum-oil-receipt-summary (
        name: DEGUM  OIL RECEIPT SUMMARY
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 1 As MYSNO,
                       Sum(1) Over(Order By TNO) SNO,
                       round(a.stockquantity1, 3) As PBS
                  From Stock A
                 Where A.ITEMCODE = '429'
                   And a.companycode = '1'
                   And (a.stockmodulecode = 'INSPECTION' Or Exists
                        (Select 1
                           From grn aA, stocktransfer Bb, stock Cc, StockStorageDetail Dd
                          Where aA.tno = bB.moduletno
                            And bB.tno = cC.stockmoduletno
                            And cC.tno = dD.tno
                            And CC.TNO = A.TNO
                               --And d.StorageLocationCode = 'VAPL'
                            And aA.DOCTYPECODE = 'CONVERSIONJOBOUTOFPREMISES'))
                   And a.stockdate = :P157_FROMDATE
                   
                 Order By TNO
                
                ```
        }
        layout {
            sequence: 70
            slot: body
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: DEGUM OIL RECEIPT SUMMARY
