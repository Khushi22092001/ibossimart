    region bleacher-production (
        name: BLEACHER PRODUCTION
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.BATCHNO,
                       Round(B.QUANTITY1, 3) As ISSUEDQTY,
                       Round(C.QUANTITY1, 3) As RECEIPTQTY,
                       Round(B.QUANTITY1 - C.QUANTITY1, 3) As LOSSQTY
                  From PRODUCTION A,
                       (Select TNO, Sum(QUANTITY1) As QUANTITY1
                          From PRODUCTIONRAW
                         Where ITEMCODE In ('429', '902')
                         Group By TNO) B,
                       (Select TNO, Sum(QUANTITY1) As QUANTITY1
                          From PRODUCTIONFINISHED
                         Where ITEMCODE In ('435')
                         Group By TNO) C
                 Where A.TNO = B.TNO
                   And A.TNO = C.TNO
                   And A.PRODUCTIONDATE = :P157_FROMDATE
                ORDER BY A.TNO
                ```
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            column: 5
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: BLEACHER PRODUCTION
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        heading {
            fixedTo: region
            maxReportHeight: 540
        }
        advanced {
            savedReportMappingIdentifier: 9930110807693135
        }

