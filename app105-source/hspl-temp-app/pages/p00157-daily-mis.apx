    region dip-reading (
        name: DIP Reading
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.storagelocationname,
                        b.quantityinmt
                  From dipreading       a,
                       dipreadingdetail  b,
                       storagelocation   c,
                       item              d,
                       itemspecification e
                 Where a.tno = b.tno
                   And b.storagelocationcode = c.storagelocationcode(+)
                   And b.itemcode = d.itemcode(+)
                   And b.itemspecificationcode = e.itemspecificationcode(+)
                   And c.parentcode = 'WIP'
                   And a.DIPReadingDate = :P157_FROMDATE 
                   order by 1
                
                ```
        }
        layout {
            sequence: 50
            slot: body
            column: 1
            columnSpan: 4
        }
        appearance {
