    region stock-position (
        name: STOCK POSITION
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.ITEMCODE,A.ITEMNAME,B.ITEMSPECIFICATIONNAME,B.ITEMSPECIFICATIONCODE,
                   getslitemopeningquantity1(Null,
                                                 A.ITEMCODE,
                                                 B.ITEMSPECIFICATIONCODE,
                                                 '1',
                                                 :P157_FROMDATE,null,null,null,null) As OPENING,
                       GETSLITEMPRODUCTIONQUANTITY1(Null,
                                                    A.ITEMCODE,
                                                    B.ITEMSPECIFICATIONCODE,
                                                    '1',
                                                    :P157_FROMDATE,
                                                    :P157_FROMDATE) As PRODUCTION,
                       getslitempurchasequantity1(Null,
                                                  A.ITEMCODE,
                                                  B.ITEMSPECIFICATIONCODE,
                                                  '1',
                                                  :P157_FROMDATE,
                                                  :P157_FROMDATE) As PURCHASE,
                       getslitemconsumptionquantity1(Null,
                                                     A.ITEMCODE,
                                                     B.ITEMSPECIFICATIONCODE,
                                                     '1',
                                                     :P157_FROMDATE,
                                                     :P157_FROMDATE) As consumption,
                       getslitemDespatchquantity1(Null,
                                                  A.ITEMCODE,
                                                  B.ITEMSPECIFICATIONCODE,
                                                  '1',
                                                  :P157_FROMDATE,
                                                  :P157_FROMDATE) As despatch,
                       getslitemopeningquantity1(Null,
                                                 A.ITEMCODE,
                                                 B.ITEMSPECIFICATIONCODE,
                                                 '1',
                                                 TO_DATE(:P157_FROMDATE,'DD-MON-RRRR')+1,null,null,null,null ) As closing
                  From ITEM A, ITEMSPECIFICATION B
                 Where A.TNO=B.TNO(+)
                 AND (A.ITEMNATURECODE In
                       ('FINISHEDITEM', 'SEMIFINISHEDITEM', 'BYPRODUCTS') or  A.itemclasscode='GENERALMATERIAL')
                    and Nvl(A.ITEMCLASSCODE, 'NO') != 'PACKED'
                 ORDER BY A.ITEMNAME
                ```
        }
        layout {
            sequence: 60
            slot: body
            startNewRow: false
            column: 5
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: STOCK POSITION
        }
        pagination {
            type: rowRangesXToY
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 9930942691693143
        }

