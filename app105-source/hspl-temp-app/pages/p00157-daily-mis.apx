    region degum-oil-stock-summary (
        name: DEGUM  OIL STOCK SUMMARY
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.STORAGELOCATIONNAME,
                       GetSLItemOpeningQuantity1(A.STORAGELOCATIONCODE,
                                                A.ITEMCODE,
                                                Null,
                                                '1',
                                                TO_DATE(:P157_FROMDATE,'DD-MON-RRRR')+1, null, null, null,null) As Stock
                  From Storagelocation A
                 Where A.ITEMCODE = '429'
                   And Nvl(GetSLItemOpeningQuantity1(A.STORAGELOCATIONCODE,
                                                    A.ITEMCODE,
                                                    Null,
                                                    '1',
                                                    TO_DATE(:P157_FROMDATE,'DD-MON-RRRR')+1, null,null,null,null),
                           0) > 0
                order by 1
                ```
