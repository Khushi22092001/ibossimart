page 273 (
    name: RepairingRequisitionReport
    alias: REPAIRINGREQUISITION
    title: RepairingRequisitionReport
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region repairingrequisition (
        name: RepairingRequisition
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                l.LOCATIONname as location,
                dt.DOCTYPEname as doctype,
                rr.REPAIRINGREQUISITIONDATE as requestdate,  
                rr.REPAIRINGREQUISITIONNO as requestno,
                d.departmentname as department,
                p.partyname as party,
                emo.equipmentmaintenanceorderno,
                e.equipmentname as equipment,
                i.itemname as item,
                rrd.remark,
                sri.storeinrepairingitemno
                FROM REPAIRINGREQUISITION rr,
                     REPAIRINGREQUISITIONDETAIL rrd,
                     equipment e,
                     item i,
                     LOCATION l,
                     DOCTYPE dt,
                     DEPARTMENT d,
                     PARTY p,
                     EQUIPMENTMAINTENANCEORDER emo,
                     storeinrepairingitem sri
                where rr.tno = rrd.tno(+)
                and rrd.equipmenttno = e.tno(+)
                and e.itemcode = i.itemcode(+)
                and rr.locationcode = l.locationcode(+)
                and rr.doctypecode = dt.doctypecode(+)
                and rr.partycode = p.partycode(+)
                and rr.departmentcode = d.departmentcode(+)
                and rr.tno = sri.repairingrequisitiontno(+)
                and rr.equipmentmaintenanceordertno = emo.tno(+)
                and rr.repairingrequisitiondate between :P273_FROMDATE and :P273_TODATE
                --and ( :P273_DOCTYPE IS NULL OR instr(':'||:P273_DOCTYPE||':',':'||dt.DocTypeCode||':') > 0 ) 
                and (:P273_LOCATION IS NULL OR instr(':'||:P273_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P273_REQUESTNO IS NULL OR instr(':'||:P273_REQUESTNO||':',':'||RR.REPAIRINGREQUISITIONNO||':') > 0)
                and (:P273_ORDERNO IS NULL OR instr(':'||:P273_ORDERNO||':',':'||EMO.equipmentmaintenanceorderNO||':') > 0)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 10926134876547719
        }

        column DEPARTMENT (
            type: plainText
            heading {
                heading: Department
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column DOCTYPE (
            type: plainText
            heading {
                heading: Doctype
                alignment: center
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:220px">#DOCTYPE#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
