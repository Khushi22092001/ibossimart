            templateOptions: #DEFAULT#
            width: 25
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P273_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                l.locationname d,
                l.locationcode r
                from location l, repairingrequisition rr
                where l.locationcode = rr.locationcode
                ```
        }
        layout {
            sequence: 40
            region: @repairingrequisition
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P273_ORDERNO (
