    region multiple-grn-one-bill-and-one-grn-multiple-bill (
        name: Multiple GRN One Bill and One GRN Multiple Bill
        title: Multiple GRN One Bill and One GRN Multiple Bill
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with t_Purchase as (
                    SELECT
                        a.PURCHASEVOUCHERTNO,
                        A.PURCHASEVOUCHERNO,
                        A.PURCHASEVOUCHERDATE,
                        A.PURCHASEVOUCHERAMOUNT,
                        SUM(B.PurchasePostedToStock) as PurchasePostedToStock
                    FROM OPENGRIRCOST A, GRNDETAIL B
                    WHERE A.GRNTNO = B.TNO 
                    GROUP BY a.PURCHASEVOUCHERTNO,
                        A.PURCHASEVOUCHERNO,
                        A.PURCHASEVOUCHERDATE,
                        A.PURCHASEVOUCHERAMOUNT
                    HAVING A.PURCHASEVOUCHERAMOUNT !=  SUM(B.PurchasePostedToStock)
                )
                Select 
                   row_number() over(order by a.VoucherDate) SerialNo,
                   a.VoucherNo,
                   a.VoucherDate,
                   a.Amount,
                   a.GRNNo,
                   a.GRNDate,
                   a.VehicleNo,
                   a.PartyName,
                   b.CompanyName,
                   c.LocationName,
                   d.DoctypeName,
                   a.TransporterName,
                   a.Status,
                   a.PurchaseVoucherNo,
                   a.PurchaseVoucherDate,
                   a.PurchaseVoucherAmount
                From OpenGRIRCost a, Company b, Location c, Doctype d, t_Purchase e 
                Where a.CompanyCode = b.CompanyCode
                 and a.LocationCode = c.LocationCode
                 and a.DoctypeCode = d.DoctypeCode
                 and a.PurchaseVoucherTNO = e.PurchaseVoucherTNO
                 and a.Status = 'BILLED'
                 and a.VoucherDate Between :P439_FROMDATE and :P439_TODATE
                 and ( :P439_COMPANY IS NULL OR instr(':'||:P439_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                 and ( :P439_LOCATION IS NULL OR instr(':'||:P439_LOCATION||':',':'||a.LocationCode||':') > 0 )
                 and ( :P439_VOUCHER IS NULL OR instr(':'||:P439_VOUCHER||':',':'||a.Tno||':') > 0 )
                
                ```
        }
        layout {
            sequence: 10
            parentRegion: @1-multiple-grn-one-bill-2-one-grn-multiple-bill
            slot: subRegions
        }
        appearance {
            template: @myirr
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                t-Form--noPadding
                margin-left-none
                margin-right-none
            ]
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 17223797461087803
        }

