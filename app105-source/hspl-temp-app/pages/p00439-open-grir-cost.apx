    pageItem P439_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                    a.CompanyName d,
                    a.CompanyCode r
                From Company a
                Where exists
                (Select 
                  b.CompanyCode
                  From Voucher b
                  Where b.CompanyCode = a.CompanyCode)
                Order by 1
                  ;
                ```
            displayExtraValues: false
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 10
            region: @open-grir-cost
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
    )

