    pageItem P439_VOUCHER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Voucher No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                	a.VoucherNo d,
                   a.Tno r
                From Voucher a, VoucherDetail b,Inspection d, GRN e, Party f
                Where a.TNo = b.TNo
                  and a.ModuleTNo = d.TNo(+)
                  and d.GRNTNO = e.TNo(+)
                  and b.Amount > 0
                  and e.PartyCode = f.PartyCode
                  and not exists(
                        Select
                            aa.TNo
                         From PBPass aa, Voucher bb, PBPassDetailGRN cc
                         Where aa.TNO = bb.ModuleTNO
                           and aa.TNO = cc.TNo
                           and cc.GRNTNO = d.GRNTNO
                         )
                Order by 1
                  ;
                ```
            displayExtraValues: false
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 80
            region: @open-grir-cost
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Voucher No
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 90
            region: @open-grir-cost
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New_1
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P439_NEXTPROCESS
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @open-grir-cost-2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P439_INDENTNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P439_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P439_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 51935495619674676
        }
        serverSideCondition {
            type: never
        }
    )

)

