page 224 (
    name: "Freight Advice "
    alias: FREIGHT-ADVICE
    title: "Freight Advice "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region freight-advice (
        name: Freight Advice
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region freight-advice-report (
        name: Freight Advice Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.FreightAdviceNo,
                	a.FreightAdviceDate,
                	lr.LRNo,
                	lr.LRDate,
                	lr.VehicleNo,
                	sl.SourceLocationName,
                	dl.DestinationLocationName,
                	b.Quantity1,
                	b.Nos,
                	b.Rate,
                	b.Amount,
                	b.DeductionAmount,
                	b.PaymentCommission,
                	b.RateMeasuringUnitCode,
                	b.NetFreightAmount,
                	b.AdvanceAmount,
                	b.NetPayableAmount,
                	a.PaymentMethodCode,
                	a.MoneyTransferModeCode,
                	cr.PartyName as CreditAccountName,
                	dr.PartyName as DebitAccountName,
                	a.FreightAdviceAmount,
                	a.PaidTo,
                	a.Narration,
                	bk.BankName,
                	a.BankAccountNo,
                	a.IFSCCODE,
                	t.TransporterName as PaidToTransporter,
                	v.ReconsilationDate
                From FreightAdvice a, FreightAdviceDetail b, LR lr, Party cr, Party dr, Bank bk, 
                	Transporter t, SourceLocation sl, DestinationLocation dl,
                	(
                	Select 
                		a.TNo,
                		c.ReconsilationDate
                	From FreightAdvice a, Voucher b, VoucherDetail c 
                	Where a.tno = b.moduletno 
                		and b.tno = c.tno 
                		and a.CreditAccountCode = c.AccountCode 
                	) v
                Where a.TNo = b.TNo(+)
                	and b.ModuleTNo = lr.TNo(+)
                	and a.CreditAccountCode = cr.PartyCode(+)
                	and a.DebitAccountCode = dr.PartyCode(+)
                	and a.BankCode = bk.BankCode(+)
                	and a.PaidTOCode = t.TransporterCode(+)
                	and lr.SourceLocationTNo = sl.TNo(+)
                	and lr.DestinationLocationTNo = dl.TNo(+)
                	and a.TNO = v.TNo(+)
                    and a.FreightAdviceDate between :P224_FROMDATE and :P224_TODATE
                    and (a.LocationCode = :P224_LOCATIONNAME 
                     or :P224_LOCATIONNAME is null
                    )
                    and (a.TransporterCode = :P224_TRANSPORTERNAME
                    or :P224_TRANSPORTERNAME is null
                    )
                ;
                ```
        }
        layout {
            sequence: 40
            slot: body
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12228047157487631
        }

