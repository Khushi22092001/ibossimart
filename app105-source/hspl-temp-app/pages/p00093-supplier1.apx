    pageItem P93_RUNDATE (
        type: hidden
        layout {
            sequence: 10
            region: @supplier-360-view-report
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT
                     TO_CHAR(LASTRUNDATE,'DD-MM-YYYY HH:MI AM') LASTRUNDATE
                FROM D_SUPPLIER_360VIEW
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button lastrun (
        buttonName: LASTRUN
        label: <p style="text-size:12px; color:#da1b1b;font-weight:bold">Last Run Date : &P93_RUNDATE.</p>
        layout {
            sequence: 10
            region: @supplier-360-view-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

