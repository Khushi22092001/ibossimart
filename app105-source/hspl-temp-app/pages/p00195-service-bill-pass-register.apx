            displayColumn RATE (
                sequence: 9
            )

            displayColumn ROWNUM (
                sequence: 1
            )

            displayColumn TCS (
                sequence: 14
            )

            displayColumn TDSAMOUNT (
                sequence: 13
            )

            displayColumn TOTALAMOUNT (
                sequence: 17
            )

            displayColumn UOM (
                sequence: 10
            )

            displayColumn VOUCHERDATE (
                sequence: 20
            )

            displayColumn VOUCHERNO (
                sequence: 19
            )

            displayColumn VSTATUS (
                sequence: 18
            )

            computation APXWS_CC_001 (
                identifier: C01
                source {
                    expression: P + Q + R
                    dataType: number
                }
                label {
                    column: GST AMOUNT
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
            )

            sort (
                column: ROWNUM
                sort {
                    sequence: 1
                }
            )

            sort (
                column: PARTYNAME
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: OTHERAMOUNT
            )

            aggregate (
                column: TOTALAMOUNT
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: QUANTITY2
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: CGST
            )

            aggregate (
                column: SGST
            )

            aggregate (
                column: IGST
            )

            aggregate (
                column: TCS
            )

            aggregate (
                column: APXWS_CC_001
            )

            aggregate (
                column: TDSAMOUNT
            )

            aggregate (
                column: DISCOUNT
            )

            controlBreak (
                column: PARTYBILLNO
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P195_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'PBPASS'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                Order by 1
                  ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @service-bill-pass-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Select Company Name
        }
    )

