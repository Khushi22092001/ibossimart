    button custom (
        buttonName: CUSTOM
        label: Custom
        layout {
            sequence: 20
            region: @service-bill-pass-register-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/purchasebillpassregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P195_FROMDATE=&P195_FROMDATE.&P195_TODATE=&P195_TODATE.&P195_PBPASSNO=&P195_PBPASSNO.&P195_VSTATUS=&P195_VSTATUS.&P195_ITEMSPECIFICATION=&P195_ITEMSPECIFICATION.&P195_ITEM=&P195_ITEM.&P195_LOCATION=&P195_LOCATION.&P195_PARTYNAME=&P195_PARTYNAME.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 1
        }
    )

