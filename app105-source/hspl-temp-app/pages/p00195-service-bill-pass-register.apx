    region service-bill-pass-register-report (
        name: Service Bill Pass Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       Rownum,
                       xxx.TNo,
                       xxx.LocationName,
                       xxx.JBPassNo,
                       xxx.JBPassDate,
                       xxx.PartyName,
                       xxx.PartyBillNo,
                       xxx.PartyBillDate,
                       xxx.JobOrderNo,
                       xxx.PartyAmount,
                       xxx.JobTypeCode,
                       xxx.JobTypeName,
                       --xxx.UOM1,
                       xxx.Quantity1,
                       --xxx.UOM2,
                       xxx.Quantity2,
                       xxx.Rate,
                       xxx.UOM,
                       xxx.Amount,
                       xxx.CGST,
                       xxx.SGST,
                       xxx.IGST,
                       xxx.TCS,
                       xxx.Discount,
                       xxx.FooterAmount,
                       (xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS + xxx.Discount)) OtherAmount,
                       xxx.TotalAmount,
                       xxx.VoucherNo,
                       xxx.VoucherDate,
                       xxx.DebitNoteNo,
                       --  xxx.DebitNoteDate,
                       xxx.DebitNoteVoucher,
                       xxx.DebitNoteVoucherDate,
                       xxx.Attachment,
                       xxx.VSTATUS,
                       xxx.ItemName,
                       CEIL(xxx.TDSAmount) AS TDSAMOUNT
                  From (Select xx.TNo,
                               xx.LocationName,
                               xx.JBPassNo,
                               xx.JBPassDate,
                               xx.PartyName,
                               xx.PartyBillNo,
                               xx.PartyBillDate,
                               xx.JobOrderNo,
                               xx.PartyAmount,
                               xx.JobTypeCode,
                               xx.JobTypename As JobTypeName,
                               --xx.UOM1,
                               xx.Quantity1,
                               --xx.UOM2,
                               xx.Quantity2,
                               xx.Rate,
                               xx.RateMeasuringUnitCode As UOM,
                               xx.Amount,
                               Sum(xx.CGST) CGST,
                               Sum(xx.SGST) SGST,
                               Sum(xx.IGST) IGST,
                               Sum(xx.TCS) TCS,
                               Sum(xx.Discount) Discount,
                               xx.FooterAmount,
                               xx.TotalAmount,
                               xx.VoucherNo,
                               xx.VoucherDate,
                               xx.DebitNoteNo,
                               -- xx.DebitNoteDate,
                               xx.DebitNoteVoucher,
                               xx.DebitNoteVoucherDate,
                               xx.Attachment,
                               xx.VSTATUS,
                               xx.ItemName,
                               xx.TDSAMOUNT
                          From (Select a.TNo,
                                       l.LocationName,
                                       a.JBPassNo,
                                       a.JBPassDate,
                                       p.PartyName,
                                       pb.PartyBillNo,
                                       pb.PartyBillDate,
                                       po.JobOrderNo,
                                       pb.SUMOFAMOUNT As PartyAmount,
                                       e.JobTypeCode,
                                       e.JobTypeName,
                                       --e.MeasuringUnitCode1 As UOM1,
                                       b.Quantity1,
                                       --e.MeasuringUnitCode2 As UOM2,
                                       b.Quantity2,
                                       b.Rate,
                                       b.RateMeasuringUnitCode,
                                       b.Amount,
                                       nvl(Decode(c.FooterHeadCode, '.CGST.', c.FooterValue),
                                           0) As CGST,
                                       nvl(Decode(c.FooterHeadCode, '.SGST.', c.FooterValue),
                                           0) As SGST,
                                       nvl(Decode(c.FooterHeadCode, '.IGST.', c.FooterValue),
                                           0) As IGST,
                                       nvl(Decode(c.FooterHeadCode, '.DISCOUNT.', c.FooterValue),
                                           0) As DISCOUNT,
                                       nvl(Decode(c.FooterHeadCode, '.TCS.', c.FooterValue),
                                           0) As TCS,
                                       b.FooterAmount,
                                       b.TotalAmount,
                                       vv.VoucherNo,
                                       vv.VoucherDate,
                                       (Select Distinct dn.DebitNoteNo
                                          From DebitNote Dn
                                         Where dn.ReferenceModuleTNo = A.TNo
                                           And Rownum = 1) As DebitNoteNo,
                                       --dn.DebitNoteNo,
                                       -- dn.DebitNoteDate,
                                       dv.VoucherNo As DebitNoteVoucher,
                                       dv.VoucherDate As DebitNoteVoucherDate,
                                       'Attachment' As Attachment,
                                       nvl(Decode(vv.ModuleTNo, a.TNo, 'PREPARED'), 'PENDING') As VSTATUS,
                                       d.ItemName ||'-'|| f.ItemSpecificationName as ItemName,
                                       (B.Amount * A.TOTALTDSPercent)/100  as TDSAmount
                                  From JBPass             a,
                                       JBPassDetail       b,
                                       JBPassDetailFooter c,
                                       Location           l,
                                       JobBill       pb,
                                       JobType            e,
                                       Party              p,
                                       JobOrder           po,
                                       /*(Select dn.ReferenceModuleTNo,
                                             dn.DebitNoteNo,
                                             dn.DebitNoteDate,
                                             dd.JobTypeCode,
                                             dd.ItemSpecificationCode
                                        From DebitNote dn, DebitNoteDetail dd
                                       Where dn.TNo = dd.TNo) dn,*/
                                       (Select V.TNo, v.ModuleTNo, v.VoucherNo, v.VoucherDate
                                          From Voucher v
                                         Where v.DocTypeCode = 'JOURNAL') vv,
                                       (Select V.TNo, v.ModuleTNo, v.VoucherNo, v.VoucherDate
                                          From Voucher v
                                         Where v.DocTypeCode = 'DEBITNOTE') dv,
                                      Item d,
                                      ItemSpecification f
                                 Where a.TNo = b.TNo(+)
                                   And b.TNo = c.TNo(+)
                                   And b.SNo = c.SNo(+)
                                   And a.LocationCode = l.LocationCode(+)
                                   And a.JobBillTNo = pb.TNo(+)
                                   And b.JobOrderTNo = po.TNo(+)
                                   And b.JobTypeCode = e.JobTypeCode(+)
                                   And pb.PartyCode = p.PartyCode(+)
                                   And a.TNo = vv.ModuleTno(+)
                                      --And b.TNo = dn.ReferenceModuleTNo(+)
                                      --And b.JobTypeCode = dn.JobTypeCode(+)
                                      --And b.ItemSpecificationCode = dn.ItemSpecificationCode(+)
                                   And a.TNo = dv.ModuleTNo(+)
                                   And b.ItemCode = d.ItemCode(+)
                                   And b.ItemSpecificationCode = f.ItemSpecificationCode(+)
                                     and a.JBPassDate between :P195_FROMDATE and :P195_TODATE
                                         and instr(':'||:P195_COMPANY||':',':'||a.CompanyCode||':') > 0
                                         and instr(':'||:P195_LOCATION||':',':'||a.LocationCode||':') > 0
                                         and ( :P195_PARTYNAME IS NULL OR instr(':'||:P195_PARTYNAME||':',':'||pb.PartyCode||':') > 0 )
                                         and ( :P195_JOBTYPE IS NULL OR instr(':'||:P195_JobType||':',':'||e.JobTypeCode||':') > 0 )
                                         and ( :P195_DOCTYPE IS NULL OR instr(':'||:P195_DOCTYPE||':',':'||a.DoctypeCode||':') > 0 )
                                         and nvl(Decode(vv.ModuleTNo,a.TNo,'PREPARED'),'PENDING') like nvl(:P195_VSTATUS,'%')
                                         and a.JBPassNo like nvl(:P195_JBPassNO,'%')
                                           -- 22-APR-2025
                                         and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                                
                                ) xx
                         Group By xx.TNo,
                                  xx.LocationName,
                                  xx.JBPassNo,
                                  xx.JBPassDate,
                                  xx.PartyName,
                                  xx.PartyBillNo,
                                  xx.PartyBillDate,
                                  xx.JobOrderNo,
                                  xx.PartyAmount,
                                  xx.JobTypeCode,
                                  xx.JobTypeName,
                                  --xx.UOM1,
                                  xx.Quantity1,
                                  --xx.UOM2,
                                  xx.Quantity2,
                                  xx.Rate,
                                  xx.RateMeasuringUnitCode,
                                  xx.Amount,
                                  xx.FooterAmount,
                                  xx.TotalAmount,
                                  xx.VoucherNo,
                                  xx.VoucherDate,
                                  xx.DebitNoteNo,
                                  --xx.DebitNoteDate,
                                  xx.DebitNoteVoucher,
                                  xx.DebitNoteVoucherDate,
                                  xx.Attachment,
                                  xx.VSTATUS,
                                  xx.ItemName,
                                  xx.TDSAmount) xxx
                
                ```
        }
