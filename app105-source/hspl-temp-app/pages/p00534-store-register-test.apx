    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region report (
        name: REPORT
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                              xxx.TNo,
                              xxx.LocationName,
                              xxx.PBPassNo,
                              xxx.PBPassDate,
                              xxx.PartyName,
                              xxx.PartyBillNo,
                              xxx.PartyBillDate,
                              xxx.PurchaseOrderNo,
                              xxx.PartyAmount,
                              xxx.ItemCode,
                              xxx.Item,
                              xxx.UOM1,
                              round(xxx.Quantity1,3) as Quantity1,
                              xxx.UOM2,
                              round(xxx.Quantity2,3) as Quantity2,
                              xxx.Rate,
                              xxx.UOM,
                              round(xxx.Amount,2) as Amount,
                              xxx.CGST,
                              xxx.SGST,
                              xxx.IGST,
                              xxx.TCS,
                              xxx.DISCOUNT,
                              round(xxx.FooterAmount,2) as FooterAmount,
                            --   round((xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS)),2) as 
                              xxx.OtherAmount,
                              round(xxx.TotalAmount,2) as TotalAmount,
                              xxx.Description,
                              xxx.FreighttypeName,
                              xxx.TransporterName,
                              xxx.VehicleNo,
                              xxx.FreightAmount,
                              xxx.TDS194C,
                              xxx.TDS194Q,
                              xxx.Remark,
                              xxx.DeductionAmt,
                              xxx.FreightAdviceAmt,
                              xxx.NetFreight,
                              XXX.DoctypeCode
                From (
                Select
                              xx.TNo,
                              xx.LocationName,
                              xx.PBPassNo,
                              xx.PBPassDate,
                              xx.PartyName,
                              xx.PartyBillNo,
                              xx.PartyBillDate,
                              xx.PurchaseOrderNo,
                              xx.PartyAmount,
                              xx.ItemCode,
                              xx.ItemName||' - '||xx.ItemSpecificationName as Item,
                              xx.UOM1,
                              xx.Quantity1,
                              xx.UOM2,
                              xx.Quantity2,
                              xx.Rate,
                              xx.RateMeasuringUnitCode as UOM,
                              xx.Amount,
                              sum(xx.CGST) CGST,
                              sum(xx.SGST) SGST,
                              sum(xx.IGST) IGST,
                              sum(xx.TCS) TCS,
                              sum(xx.OtherAmount) OtherAmount,
                              sum(xx.DISCOUNT) DISCOUNT,
                              xx.FooterAmount,
                              xx.TotalAmount,
                              xx.Description,
                              xx.FreighttypeName,
                              xx.TransporterName,
                              xx.VehicleNo,
                              xx.FreightAmount,
                              xx.TDS194C,
                              xx.TDS194Q,
                              xx.DeductionAmt,
                              xx.FreightAdviceAmt,
                              xx.Remark,
                              xx.NetFreight,
                              XX.DoctypeCode
                From (
                        Select         a.TNo,
                                       l.LocationName,
                                       a.PBPassNo,
                                       a.PBPassDate,
                                       p.PartyName,
                                       pb.PartyBillNo,
                                       pb.PartyBillDate,
                                       po.PurchaseOrderNo,
                                       pb.SUMOFAMOUNT As PartyAmount,
                                       e.ItemCode,
                                       e.ItemName,
                                       ee.ItemSpecificationName,
                                       e.MeasuringUnitCode1 As UOM1,
                                       b.Quantity1,
                                       e.MeasuringUnitCode2 As UOM2,
                                       b.Quantity2,
                                       b.Rate,
                                       b.RateMeasuringUnitCode,
                                       b.Amount,
                                       nvl(Decode(c.FooterHeadCode, '.CGST.', c.FooterValue),
                                           0) As CGST,
                                       nvl(Decode(c.FooterHeadCode, '.SGST.', c.FooterValue),
                                           0) As SGST,
                                       nvl(Decode(c.FooterHeadCode, '.IGST.', c.FooterValue),
                                           0) As IGST,
                                       nvl(Decode(c.FooterHeadCode, '.TCS.', c.FooterValue),
                                           0) As TCS,
                                       Case When c.FooterHeadCode not in ('.CGST.','.SGST.', '.IGST.','.TCS.','.DISCOUNT.') then c.FooterValue
                                        end as OtherAmount,
                                        nvl(Decode(c.FooterHeadCode, '.DISCOUNT.', c.FooterValue),
                                           0) As DISCOUNT,
                                       b.FooterAmount,
                                       b.TotalAmount,
                                       b.Description,
                                       i.FreighttypeName,
                                       h.VehicleNo,
                                       j.TransporterName,
                                       h.FreightAmount,
                                      a.SumOfTDSAmount as TDS194C,
                                      ff.SumOfTDSAmount as TDS194Q,
                                       ff.SumOfDeductionAmount as DeductionAmt,
                                       h.FreightAdvanceAmount as FreightAdviceAmt,
                                       ff.SumOfNetPayableAmount as NetFreight,
                                       b.Remark,
                                       po.DoctypeCode
                                  From PurchaseBill       pb,
                                       PurchaseBillDetail pbd,
                                       PBPass             a,
                                       PBPassDetail       b,
                                       PBPassDetailFooter c,
                                       Location           l,
                                       Item               e,
                                       ItemSpecification  ee,
                                       Party              p,
                                       PurchaseOrder      po,
                                       PurchaseBillGRNDetail f,
                                       GRNDetail g,
                                       GRN h,
                                       Freighttype i,
                                       Transporter j,
                                       FreightAdviceDetail fd,
                                       FreightAdvice ff
                                 Where pb.TNo = pbd.TNo(+)
                                   And pb.TNo = a.PurchaseBillTNo(+)
                                   And a.TNo = b.TNo(+)
                                   And b.TNo = c.TNo(+)
                                   And b.SNo = c.SNo(+)
                                   And a.LocationCode = l.LocationCode(+)
                                   And b.PurchaseOrderTNo = po.TNo(+)
                                   
                                   ------add this join 26-05-2026---
                                   And pbd.ItemCode = b.ItemCode(+)
                                   And pbd.ItemSpecificationCode = b.ItemSpecificationCode(+)
                
                                   And b.ItemCode = e.ItemCode(+)
                                   And b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                                   And pb.PartyCode = p.PartyCode(+)
                                   And pbd.Tno = f.Tno(+)
                                   and pbd.SNo = f.SNo(+)
                                   And f.GRNTno = g.Tno(+)
                                   And f.GRNSno = g.Sno(+)
                                   And g.Tno = h.Tno(+)
                                   And h.FreighttypeCode = i.FreighttypeCode
                                   and h.TransporterCode = j.TransporterCode(+)
                                   and h.Tno = fd.ModuleTno(+)
                                   and fd.Tno = ff.Tno(+)
                                   and po.DoctypeCode in ('URGENT','REVENUE')
                --           and pb.PartyBillDate between :P522_FROMDATE and :P522_TODATE
                --           and ( :P522_COMPANY IS NULL OR instr(':'||:P522_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                --           and ( :P522_LOCATION IS NULL OR instr(':'||:P522_LOCATION||':',':'||a.LocationCode||':') > 0 )
                --           and ( :P522_PARTYNAME IS NULL OR instr(':'||:P522_PARTYNAME||':',':'||pb.PartyCode||':') > 0 )
                --           and ( :P522_ITEM IS NULL OR instr(':'||:P522_ITEM||':',':'||e.ItemCode||':') > 0 )
                --           and ( :P522_ITEMSPECIFICATION IS NULL OR instr(':'||:P522_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                -- --            -- 22-APR-2025
                          and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                 )xx
                Group By 
                              xx.TNo,
                              xx.LocationName,
                              xx.PBPassNo,
                              xx.PBPassDate,
                              xx.PartyName,
                              xx.PartyBillNo,
                              xx.PartyBillDate,
                              xx.PurchaseOrderNo,
                              xx.PartyAmount,
                              xx.ItemCode,
                              xx.ItemName||' - '||xx.ItemSpecificationName,
                              xx.UOM1,
                              xx.Quantity1,
                              xx.UOM2,
                              xx.Quantity2,
                              xx.Rate,
                              xx.RateMeasuringUnitCode,
                              xx.Amount,
                              xx.FooterAmount,
                              xx.TotalAmount,
                              xx.Description,
                              xx.FreighttypeName,
                              xx.VehicleNo,
                              xx.TransporterName,
                              xx.FreightAmount,
                              xx.TDS194C,
                              xx.Remark,
                              xx.TDS194Q,
                              xx.DeductionAmt,
                              xx.FreightAdviceAmt,
                              xx.NetFreight,
                              XX.DoctypeCode
                )xxx              
                
                ```
        }
