    region gstr2b-reconsilation-duplicate (
        name: GSTR2B Reconsilation duplicate
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                nvl(nvl(a.SupplierDataInvoiceDate, a.MyDataVoucherDate), a.VoucherDate) AS TDATE,
                case when a.VoucherDate > dl.DayDate then null else a.VOUCHERNO end as VOUCHERNO                     ,
                case when a.VoucherDate > dl.DayDate then null else a.VOUCHERDATE end as VOUCHERDATE            ,
                case when a.VoucherDate > dl.DayDate then null else b.PartyName end as PartyName,
                case when a.VoucherDate > dl.DayDate then null else a.GSTINNo end as GSTINNO                ,
                case when a.VoucherDate > dl.DayDate then null else a.InvoiceNo end as INVOICENO              ,
                case when a.VoucherDate > dl.DayDate then null else a.InvoiceDate end as INVOICEDATE            ,
                
                --a.CGSTAMOUNT             ,
                --a.SGSTAMOUNT             ,
                --a.IGSTAMOUNT             ,
                case when a.VoucherDate > dl.DayDate then 0 else 1 end *  a.CGSTAMOUNT as CGSTAMOUNT            ,
                case when a.VoucherDate > dl.DayDate then 0 else 1 end *  a.SGSTAMOUNT as SGSTAMOUNT            ,
                case when a.VoucherDate > dl.DayDate then 0 else 1 end *  a.IGSTAMOUNT as IGSTAMOUNT            ,
                
                a.MYDATAVOUCHERNO        ,
                a.MYDATAVOUCHERDATE      ,
                c.PartyName as MydataPartyName,
                a.MYDATAGSTINNO          ,
                a.MYDATAINVOICENO        ,
                a.MYDATAINVOICEDATE      ,
                a.MYDATACGSTAMOUNT       ,
                a.MYDATASGSTAMOUNT       ,
                a.MYDATAIGSTAMOUNT       ,
                d.PartyName as SuplierDataPartyName,
                a.SUPPLIERDATAGSTINNO    ,
                a.SUPPLIERDATAINVOICENO  ,
                a.GSTR1FillingDate,
                a.SUPPLIERDATAINVOICEDATE,
                a.SUPPLIERDATACGSTAMOUNT ,
                a.SUPPLIERDATASGSTAMOUNT ,
                a.SUPPLIERDATAIGSTAMOUNT ,
                nvl(a.CGSTAMOUNT, 0)- nvl(a.MyDataCGSTAMOUNT, 0) CGST_Diff_LedgerAndTransaction,
                nvl(a.SGSTAMOUNT, 0) - nvl(a.MyDataSGSTAMOUNT, 0) SGST_Diff_LedgerAndTransaction,
                nvl(a.IGSTAMOUNT, 0)- nvl(a.MyDataIGSTAMOUNT, 0) IGST_Diff_LedgerAndTransaction,
                nvl(a.MyDataCGSTAMOUNT, 0)- nvl(a.SupplierDataCGSTAMOUNT, 0) CGST_Diff_TransactionAndSupplier,
                nvl(a.MyDataSGSTAMOUNT, 0) - nvl(a.SupplierDataSGSTAMOUNT, 0) SGST_Diff_TransactionAndSupplier,
                nvl(a.MyDAtaIGSTAMOUNT, 0)- nvl(a.SupplierDataIGSTAMOUNT, 0) IGST_Diff_TransactionAndSupplier
                
                from GSTR2BReconsilation a, Party b, Party c, Party d, DateList dl 
                where a.PartyCode = b.PartyCode(+)
                and a.MyDataPartyCode = c.PartyCode(+)
                and a.SupplierDataPartyCode = d.PartyCode(+)
                and dl.DayDAte = TO_DATE(:P491_TODATE)
                and ( 
                    a.voucherdate between TO_DATE(:P491_FROMDATE) AND TO_DATE(:P491_TODATE)
                    or 
                    a.voucherdate is null
                )
                /*
                and  (:P491_COMPANY IS NULL OR instr(':'||:P491_COMPANY||':',':'||a.CompanyCode||':') > 0)
                --and nvl(nvl(a.SupplierDataInvoiceDate, a.MyDataVoucherDate), a.VoucherDate) between TO_DATE(:P491_FROMDATE) AND TO_DATE(:P491_TODATE)
                and  (
                    a.VoucherDate between TO_DATE(:P491_FROMDATE) AND TO_DATE(:P491_TODATE)
                    OR
                    :P491_LEDGERDATADATE = 'NO'
                )
                and  (
                    a.VoucherDate between TO_DATE(:P491_FROMDATE) AND TO_DATE(:P491_TODATE)
                    OR
                    :P491_LEDGERDATADATE = 'NO'
                )
                and  (
                    a.MyDataVoucherDate between TO_DATE(:P491_FROMDATE) AND TO_DATE(:P491_TODATE)
                    OR
                    :P491_TRANSACTIONDATADATE= 'NO'
                )
                and  (
                    a.GSTR1FillingDate between TO_DATE(:P491_FROMDATE) AND TO_DATE(:P491_TODATE)
                    OR
                    :P491_SUPPLIERDATADATE= 'NO'
                )
                and (
                    (
                        (
                            a.GSTR1FillingDate between TO_DATE(:P491_FROMDATE) AND TO_DATE(:P491_TODATE)
                            or 
                            a.MyDataVoucherDate between TO_DATE(:P491_FROMDATE) AND TO_DATE(:P491_TODATE)
                            or
                            a.VoucherDate between TO_DATE(:P491_FROMDATE) AND TO_DATE(:P491_TODATE)
                        )
                        and :P491_LEDGERDATADATE = 'NO'
                        and :P491_TRANSACTIONDATADATE= 'NO'
                        and :P491_SUPPLIERDATADATE= 'NO'
                    )
                    OR (
                        'YES' IN (:P491_LEDGERDATADATE, :P491_TRANSACTIONDATADATE, :P491_SUPPLIERDATADATE)
                    )
                )
                */
                ```
            pageItemsToSubmit: [
                P491_COMPANY
                P491_FROMDATE
                P491_TODATE
                P491_LEDGERDATADATE
                P491_TRANSACTIONDATADATE
                P491_SUPPLIERDATADATE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: [
