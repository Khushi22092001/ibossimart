page 491 (
    name: GSTR2B Reconsilation
    alias: GSTR2B-RECONSILATION
    title: GSTR2B Reconsilation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region gstr2b-reconsilation (
        name: GSTR2B Reconsilation
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
    )

    region gstr2b-reconsilation-2 (
        name: GSTR2B Reconsilation
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                to_char(a.fromdate, 'mon-rrrr') as SupplierDataForMonth,
                a.VOUCHERDATE as TDATE,  
                a.OurGSTINNo,
                a.VOUCHERNO as VOUCHERNO                     ,
                a.VOUCHERDATE as VOUCHERDATE            ,
                b.PartyName  as PartyName,
                a.GSTINNo  as GSTINNO                ,
                a.InvoiceNo  as INVOICENO              ,
                a.InvoiceDate  as INVOICEDATE            ,
                
                a.CGSTAMOUNT             ,
                a.SGSTAMOUNT             ,
                a.IGSTAMOUNT             ,
                
                a.MyDataOurGSTINNo,
                a.MYDATAVOUCHERNO        ,
                a.MYDATAVOUCHERDATE      ,
                c.PartyName as MydataPartyName,
                a.MYDATAGSTINNO          ,
                a.MYDATAINVOICENO        ,
                a.MYDATAINVOICEDATE      ,
                a.MYDATACGSTAMOUNT       ,
                a.MYDATASGSTAMOUNT       ,
                a.MYDATAIGSTAMOUNT       ,
                --
                a.SupplierDataOurGSTINNo,
                d.PartyName as SuplierDataPartyName,
                a.SUPPLIERDATAGSTINNO    ,
                a.SUPPLIERDATAINVOICENO  ,
                a.SUPPLIERDATANOTENO  ,
                a.GSTR1FillingDate,
                a.SUPPLIERDATAINVOICEDATE,
                a.SUPPLIERDATACGSTAMOUNT ,
                a.SUPPLIERDATASGSTAMOUNT ,
                a.SUPPLIERDATAIGSTAMOUNT ,
                --
                nvl(a.CGSTAMOUNT, 0)- nvl(a.MyDataCGSTAMOUNT, 0) CGST_Diff_LedgerAndTransaction,
                nvl(a.SGSTAMOUNT, 0) - nvl(a.MyDataSGSTAMOUNT, 0) SGST_Diff_LedgerAndTransaction,
                nvl(a.IGSTAMOUNT, 0)- nvl(a.MyDataIGSTAMOUNT, 0) IGST_Diff_LedgerAndTransaction,
                --
                nvl(a.MyDataCGSTAMOUNT, 0)- nvl(a.SupplierDataCGSTAMOUNT, 0) CGST_Diff_TransactionAndSupplier,
                nvl(a.MyDataSGSTAMOUNT, 0) - nvl(a.SupplierDataSGSTAMOUNT, 0) SGST_Diff_TransactionAndSupplier,
                nvl(a.MyDAtaIGSTAMOUNT, 0)- nvl(a.SupplierDataIGSTAMOUNT, 0) IGST_Diff_TransactionAndSupplier,
                --
                nvl(a.CGSTAMOUNT, 0)- nvl(a.SupplierDataCGSTAMOUNT, 0) CGST_Diff_LedgerAndSupplier,
                nvl(a.SGSTAMOUNT, 0) - nvl(a.SupplierDataSGSTAMOUNT, 0) SGST_Diff_LedgerAndSupplier,
                nvl(a.IGSTAMOUNT, 0)- nvl(a.SupplierDataIGSTAMOUNT, 0) IGST_Diff_LedgerAndSupplier
                
                from GSTR2BReconsilationData a, Party b, Party c, Party d
                where a.PartyCode = b.PartyCode(+)
                and a.MyDataPartyCode = c.PartyCode(+)
                and a.SupplierDataPartyCode = d.PartyCode(+)
                ```
            pageItemsToSubmit: [
                P491_COMPANY
                P491_FROMDATE
                P491_TODATE
                P491_LEDGERDATADATE
                P491_TRANSACTIONDATADATE
                P491_SUPPLIERDATADATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        advanced {
            htmlDomId: gstr2breconsilation
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        download {
            authorization: @candownload
        }
        heading {
            fixedTo: region
            maxReportHeight: 500
        }
        advanced {
            savedReportMappingIdentifier: 36957052544579142
        }

