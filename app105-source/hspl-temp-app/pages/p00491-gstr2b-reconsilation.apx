    pageItem P491_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  Distinct 
                        b.CompanyName d,
                        b.CompanyCode r
                From Company b
                Order By 1
                ```
        }
        layout {
            sequence: 10
            region: @gstr2b-reconsilation
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P491_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @gstr2b-reconsilation
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT MIN(A.FINANCIALYEARBEGIN) FROM FINANCIALYEAR A WHERE A.FINANCIALYEAREND > TRUNC(SYSDATE)
        }
    )

    pageItem P491_LEDGERDATADATE (
        type: hidden
        layout {
            sequence: 40
            region: @gstr2b-reconsilation
            slot: regionBody
        }
        default {
            type: static
            staticValue: YES
        }
    )

    pageItem P491_SUPPLIERDATADATE (
