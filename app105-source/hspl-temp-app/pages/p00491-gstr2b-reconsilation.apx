            staticValue: NO
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 70
            region: @gstr2b-reconsilation
            slot: regionBody
            startNewRow: false
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refesh (
        name: Refesh
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-alert (
            action: alert
            settings {
                title: "Reconsilation Data Refresh "
                message: Reconsilation Data Refreshed.
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 10
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @refresh
            }
            execution {
                sequence: 60
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: PrepareGSTR2BReconsilationData('1', :P491_FROMDATE, :P491_TODATE);
                itemsToSubmit: [
                    P491_COMPANY
                    P491_FROMDATE
                    P491_TODATE
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: var lSpinner$ = apex.util.showSpinner( $( "#gstr2breconsilation" ) );
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("#apex_wait_overlay").remove();
                    $(".u-Processing").remove();
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @gstr2b-reconsilation-2
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

)

