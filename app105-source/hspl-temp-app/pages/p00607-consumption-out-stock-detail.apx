page 607 (
    name: Consumption Out Stock Detail
    alias: CONSUMPTION-OUT-STOCK-DETAIL
    title: Consumption Out Stock Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1200
        height: 800
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region consumption-out-stock-detail (
        name: Consumption Out Stock Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.ItemCode,
                	b.ItemSpecificationCode,
                	a.ItemName || ' - ' || b.ItemSpecificationName as Item,
                	x.Panel,
                    x1.ModuleNo,
                    b.ItemCategoryCode,
                    x1.ModuleDate,
                	x1.UsedStockQuantity1 as Consumption_Stock_Quantity
                From Item a, ItemSpecification b,
                	(
                    Select
                        y.ItemCode,
                		y.ItemSpecificationCode,
                		y.Panel
                    From
                        (
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From GRN a, GRNDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P607_COMPANY
                            and ( :P607_LOCATION IS NULL OR instr(':'||:P607_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.GRNDate <= :P607_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From CCInvoice a, CCInvoiceDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P607_COMPANY
                            and ( :P607_LOCATION IS NULL OR instr(':'||:P607_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.CCInvoiceDate <= :P607_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From StockJournal a, StockJournalDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P607_COMPANY
                            and ( :P607_LOCATION IS NULL OR instr(':'||:P607_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.StockJournalDate <= :P607_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From CashPurchase a, CashPurchaseDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P607_COMPANY
                            and ( :P607_LOCATION IS NULL OR instr(':'||:P607_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.CashPurchaseDate <= :P607_TODATE
                        UNION ALL
                        Select
                    		a.ItemCode,
                    		a.ItemSpecificationCode,
                    		a.Panel
                    	From ItemOpening a
                    	Where a.CompanyCode = :P607_COMPANY
                            and ( :P607_LOCATION IS NULL OR instr(':'||:P607_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.ItemOpeningDate <= :P607_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From Issue a, IssueDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P607_COMPANY
                            and ( :P607_LOCATION IS NULL OR instr(':'||:P607_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.IssueDate <= :P607_TODATE
                        ) y
                	Group by 
                		y.ItemCode,
                		y.ItemSpecificationCode,
                		y.Panel
                	) x,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		xx.UsedStockQuantity1,
                        xx.ModuleDate,
                        xx.ModuleNo
                	From
                		(
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as UsedStockQuantity1,
                            a.IssueNo as ModuleNo,
                            a.IssueDate as ModuleDate
                		From Issue a, IssueDetail b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P607_COMPANY
                            and ( :P607_LOCATION IS NULL OR instr(':'||:P607_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.IssueDate between :P607_FROMDATE and :P607_TODATE
                		) xx
                	) x1
                Where a.Tno = b.Tno
                	and a.ItemCode = x.ItemCode
                	and b.ItemSpecificationCode = x.ItemSpecificationCode	
                	and x.ItemCode = x1.ItemCode(+)
                	and x.ItemSpecificationCode = x1.ItemSpecificationCode(+)
                	and x.Panel = x1.Panel(+)
                    and a.ItemCode = :P607_ITEMCODE
                    and b.ItemSpecificationCode = :P607_SPECIFICATIONCODE
                    and b.ItemCategoryCode = :P607_ITEMCATEGORY
                    and x.Panel = :P607_PANEL
                ;
                ```
            pageItemsToSubmit: [
                P607_FROMDATE
                P607_TODATE
            ]
        }
        layout {
            sequence: 100
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 206120290787457115
        }

        column CONSUMPTION_STOCK_QUANTITY (
            type: plainText
            heading {
