        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: NecessitySlip Detail Report
        }

        savedReport 232721 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn CONSUMPTION_STOCK_QUANTITY (
                sequence: 5
            )

            displayColumn ITEM (
                sequence: 3
            )

            displayColumn MODULEDATE (
                sequence: 2
            )

            displayColumn MODULENO (
                sequence: 1
            )

            displayColumn PANEL (
                sequence: 4
            )

            sort (
                column: DAYDATE
                sort {
                    sequence: 1
                }
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 2
                }
            )

            sort (
                column: NECESSITYSLIPNO
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: INQUANTITY
            )

            aggregate (
                column: OUTQUANTITY
            )

            aggregate (
                column: OPENINGINSTOCKQTY1
            )

            aggregate (
                column: PURCHASEINSTOCKQTY1
            )

            aggregate (
                column: USEDSTOCKQUANTITY1
            )

            aggregate (
                column: CONSUMPTION_STOCK_QUANTITY
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

