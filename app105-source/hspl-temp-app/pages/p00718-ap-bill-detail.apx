page 718 (
    name: Bill Detail
    alias: AP-BILL-DETAIL
    title: Bill Detail
    pageGroup: @payables-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: One open item, end to end. A "bill" in this ERP is a VoucherDetail line identified by (Tno, Sno) - there is no BillReference table - so this page is keyed on that pair. The movement band proves the arithmetic: Original amount, less allocations settled on or before the As-of Date, equals Outstanding. Settlement is a many-to-many bridge (one payment settles many bills, one bill takes many payments), so the settlement region lists the bridge rows with their counterpart voucher rather than joining them into the header - joining would duplicate the outstanding amount on every row. The GL region shows the complete double entry the item belongs to, which is how a reader confirms the bill against the ledger rather than against another report.
    }

    region command-header (
        name: Bill Detail
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Asof As (Select to_date(nvl(:P718_TODATE, to_char(trunc(sysdate),'DD-MM-RRRR')),'DD-MM-RRRR') D From dual),
                     B As (
                       Select d.AccountCode Pty, d.CompanyCode Cmp, d.LocationCode Loc, d.Panel Pnl,
                              v.VoucherNo Vno, v.DocTypeCode Dtc, v.ModuleCode Mc,
                              coalesce(i.PbPassNo, sb.ServiceBillNo, cn.CreditNoteNo, ao.BillNo, v.VoucherNo) Ref,
                              Case When v.VoucherNo = 'OPENING'      Then 'Opening Carry-forward'
                                   When v.ModuleCode = 'PBPASS'     Then 'Purchase Bill'
                                   When v.ModuleCode = 'SERVICEBILL' Then 'Service Bill'
                                   When v.ModuleCode = 'DEBITNOTE'  Then 'Credit Note'
                                   When v.ModuleCode = 'CREDITNOTE'   Then 'Debit Note'
                                   When v.ModuleCode = 'INVOICE'      Then 'Contra Purchase'
                                   When v.DocTypeCode In ('PAYMENT','CASHPAYMENT','BANKPAYMENT')    Then 'Payment / On-account'
                                   When v.DocTypeCode = 'RECEIPT'
                                                                     Then 'Payment to Vendor'
                                   Else 'Journal' End Cls
                         From VoucherDetail d
                         Join Voucher v On v.Tno = d.Tno
                         Left Join PBPass     i  On v.ModuleCode = 'PBPASS'     And i.Tno  = v.ModuleTno
                         Left Join ServiceBill sb On v.ModuleCode = 'SERVICEBILL' And sb.Tno = v.ModuleTno
                         Left Join CreditNote  cn On v.ModuleCode = 'DEBITNOTE'  And cn.Tno = v.ModuleTno
                         Left Join AccountOpening ao On v.VoucherNo = 'OPENING'   And ao.Tno = d.ModuleTno
                        Where d.Tno = :P718_TNO And d.Sno = :P718_SNO)
                Select '<div class="ds-ap-head">'
                    || '<div class="ds-ap-eyebrow">Payables &middot; Open Item Detail</div>'
                    || '<h1 class="ds-ap-title">' || apex_escape.html(nvl(b.Ref,'Open item')) || '</h1>'
                    || '<div class="ds-ap-sub">'
                       || apex_escape.html(nvl(p.PartyName, b.Pty))
                       || ' &middot; voucher ' || apex_escape.html(b.Vno) || '</div>'
                    || '<div class="ds-ap-context">'
                    || '<span class="ds-ap-chip"><span class="fa fa-tag"></span>Class <b>' || b.Cls || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-crosshairs"></span>As at <b>' || to_char(a.D,'DD-MM-RRRR') || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl(c.CompanyName, b.Cmp)) || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl(l.LocationName, b.Loc)) || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-shield"></span>Panel <b>' || nvl(b.Pnl,'&mdash;') || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-hashtag"></span>Ledger line <b>'
                       || :P718_TNO || ' / ' || :P718_SNO || '</b></span>'
                    || '</div></div>' As HEAD
                  From B b Cross Join Asof a
                  Left Join Party p On p.PartyCode = b.Pty
                  Left Join Company c On c.CompanyCode = b.Cmp
                  Left Join Location l On l.LocationCode = b.Loc
                ```
            pageItemsToSubmit: [
                P718_TNO
                P718_SNO
                P718_TODATE
            ]
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-ap-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No open item was selected, or the ledger line no longer exists.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region exceptions (
        name: Exceptions on This Item
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* The same control predicates as page 696, narrowed to this one item.
                   A control that does not fire is not listed - this is a per-item
                   finding list, not the full matrix. */
                With Asof As (Select to_date(nvl(:P718_TODATE, to_char(trunc(sysdate),'DD-MM-RRRR')),'DD-MM-RRRR') D From dual),
                     Alc As (
                       Select -Sum(a.Amount) Amt From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                          And a.DrVoucherTno = :P718_TNO And a.DrVoucherSno = :P718_SNO
                       Union All
                       Select Sum(a.Amount) From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                          And a.CrVoucherTno = :P718_TNO And a.CrVoucherSno = :P718_SNO),
                     A As (Select nvl(Sum(Amt),0) Amt From Alc),
                     I As (
                       Select d.Amount Amt, d.Panel Pnl, d.LocationCode Loc, d.VoucherDate Vdt,
                              v.VoucherNo Vno, v.DocTypeCode Dtc,
                              coalesce(i.DueDate, sb.DueDate, ao.BillDueDate) DueDate,
                              ao.BillDate AoBillDate, ao.BillDueDate AoBillDue,
                              -(d.Amount - (Select Amt From A)) Recv
                         From VoucherDetail d
                         Join Voucher v On v.Tno = d.Tno
                         Left Join PBPass     i  On v.ModuleCode = 'PBPASS'     And i.Tno  = v.ModuleTno
                         Left Join ServiceBill sb On v.ModuleCode = 'SERVICEBILL' And sb.Tno = v.ModuleTno
                         Left Join AccountOpening ao On v.VoucherNo = 'OPENING'   And ao.Tno = d.ModuleTno
                        Where d.Tno = :P718_TNO And d.Sno = :P718_SNO)
                Select Code, Nm, Sev, Detail From (
                  Select 'AR-B02' Code, 'Cannot be aged' Nm, 'High' Sev,
                         'The source document carries no due date and this ERP holds no credit terms to derive one from.' Detail
                    From I i Where i.Recv > 0.005 And i.DueDate Is Null
                  Union All
                  Select 'AR-O01','Opening item, original bill date lost','High',
                         'Migrated at the 31-03-2026 cutover without its original bill date, so its age is understated.'
                    From I i Where i.Vno = 'OPENING' And i.AoBillDate Is Null And Abs(i.Recv) > 0.005
                  Union All
                  Select 'AR-O02','Opening item, original due date lost','Medium',
                         'Cannot be aged on the Due Date basis; falls into Cannot Age.'
                    From I i Where i.Vno = 'OPENING' And i.AoBillDue Is Null And i.Recv > 0.005
                  Union All
                  Select 'AR-R03','Payment cash unapplied over 90 days','Critical',
                         'Paid ' || to_char((Select D From Asof) - i.Vdt) || ' days ago and still not applied to any bill.'
                    From I i Cross Join Asof Where i.Dtc = 'RECEIPT' And i.Recv < -0.005 And Asof.D - i.Vdt > 90
                  Union All
                  Select 'AR-A07','Allocation exceeds the item','Critical',
                         'More has been allocated against this line than the line is worth; its balance has flipped sign.'
                    From I i Where Abs((Select Amt From A)) > Abs(i.Amt) + 0.005
                  Union All
                  Select 'AR-M01','Posted with no Panel','Critical',
                         'Panel drives row-level security; a null Panel is invisible to a panel-locked login.'
                    From I i Where i.Pnl Is Null
                  Union All
                  Select 'AR-M02','Location marked DO NOT USE','High',
                         'The location master names this location as unusable, yet this payable is posted to it.'
                    From I i Join Location l On l.LocationCode = i.Loc
                   Where upper(l.LocationName) Like '%DO NOT USE%'
                ) Order By Case Sev When 'Critical' Then 1 When 'High' Then 2 Else 3 End, Code
                ```
            pageItemsToSubmit: [
                P718_TNO
                P718_SNO
                P718_TODATE
            ]
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No control fires on this item.
        }

        column CODE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Control
            }
            layout {
                sequence: 10
            }
        )

        column DETAIL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Why
            }
            layout {
                sequence: 40
            }
        )

        column NM (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Exception
            }
            layout {
                sequence: 20
            }
        )

        column SEV (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Severity
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
        )

    )

    region gl-lines (
        name: General Ledger Entry
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Every line of the voucher this item belongs to, so the reader can see
                   the complete double entry. The item itself is marked. A DEBIT is a
                   NEGATIVE Amount, so the two sides are split by sign and shown as
                   positive figures under their own headings. */
                Select Case When d.Sno = :P718_SNO Then
                            '<b>' || apex_escape.html(nvl(p.PartyName, d.AccountCode)) || '</b>'
                            || ' <span class="ds-archip ds-archip--info">this item</span>'
                       Else apex_escape.html(nvl(p.PartyName, d.AccountCode)) End As ACCOUNT,
                       d.AccountCode                                    As ACCOUNT_CODE,
                       Round(Case When d.Amount < 0 Then -d.Amount End,2) As DEBIT,
                       Round(Case When d.Amount > 0 Then  d.Amount End,2) As CREDIT,
                       apex_escape.html(substr(d.Narration,1,200))      As NARRATION
                  From VoucherDetail d
                  Left Join Party p On p.PartyCode = d.AccountCode
                 Where d.Tno = :P718_TNO
                 Order By d.Sno
                ```
            pageItemsToSubmit: [
                P718_TNO
                P718_SNO
            ]
        }
        layout {
            sequence: 32
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: This voucher carries no lines.
        }

        column ACCOUNT (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Account
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ACCOUNT_CODE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
        )

        column CREDIT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Credit (₹)
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

        column DEBIT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Debit (₹)
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

        column NARRATION (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Narration
            }
            layout {
                sequence: 50
            }
        )

    )

    region movement (
        name: Financial Movement
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* THE ARITHMETIC, SHOWN RATHER THAN ASSERTED.
                     Original amount
                   - allocations settled on or before the As-of Date
                   = Outstanding
                   Both allocation directions are handled: for a DEBIT item the
                   allocations are the credits applied to it, for a CREDIT item they
                   are the debits it was applied against. The two are summed with
                   opposite signs, exactly as the canonical layer does. */
                With Asof As (Select to_date(nvl(:P718_TODATE, to_char(trunc(sysdate),'DD-MM-RRRR')),'DD-MM-RRRR') D From dual),
                     Alc As (
                       Select -Sum(a.Amount) Amt, Count(*) N
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                          And a.DrVoucherTno = :P718_TNO And a.DrVoucherSno = :P718_SNO
                       Union All
                       Select Sum(a.Amount), Count(*)
                         From DrCrAllocation a, Voucher dv, Voucher cv, Asof
                        Where dv.Tno = a.DrVoucherTno And cv.Tno = a.CrVoucherTno
                          And dv.VoucherDate <= Asof.D And cv.VoucherDate <= Asof.D
                          And a.CrVoucherTno = :P718_TNO And a.CrVoucherSno = :P718_SNO),
                     A As (Select nvl(Sum(Amt),0) Amt, nvl(Sum(N),0) N From Alc),
                     D As (
                       Select d.Amount Amt,
                              coalesce(i.PbPassDate, ao.BillDate, d.VoucherDate) DocDate,
                              coalesce(i.DueDate, sb.DueDate, ao.BillDueDate) DueDate
                         From VoucherDetail d
                         Join Voucher v On v.Tno = d.Tno
                         Left Join PBPass     i  On v.ModuleCode = 'PBPASS'     And i.Tno  = v.ModuleTno
                         Left Join ServiceBill sb On v.ModuleCode = 'SERVICEBILL' And sb.Tno = v.ModuleTno
                         Left Join AccountOpening ao On v.VoucherNo = 'OPENING'   And ao.Tno = d.ModuleTno
                        Where d.Tno = :P718_TNO And d.Sno = :P718_SNO)
                Select '<div class="ds-arexp">'
                    || '<div class="ds-arexp-cell ds-arexp-cell--recv"><dl>'
                    || '<dt>' || Case When d.Amt < 0 Then 'Original Payable' Else 'Original Credit' End || '</dt><dd>&#8377;'
                    || to_char(Round(Abs(d.Amt),2),'FM999G99G99G990D00') || '</dd>'
                    || '<div class="ds-arexp-sub">document dated ' || to_char(d.DocDate,'DD-MM-RRRR')
                    || Case When d.DueDate Is Not Null Then ' &middot; due ' || to_char(d.DueDate,'DD-MM-RRRR')
                            Else ' &middot; <b>no due date on the source document</b>' End
                    || '</div></dl></div>'
                    || '<div class="ds-arexp-cell ds-arexp-cell--cred"><dl>'
                    || '<dt>Settled</dt><dd>&#8377;'
                    || to_char(Round(Abs(a.Amt),2),'FM999G99G99G990D00') || '</dd>'
                    || '<div class="ds-arexp-sub">' || to_char(a.N,'FM999G990')
                    || Case When a.N = 1 Then ' settlement' Else ' settlements' End
                    || ' dated on or before the As-of Date</div></dl></div>'
                    || '<div class="ds-arexp-cell ds-arexp-cell--net"><dl>'
                    || '<dt>' || Case When -(d.Amt - a.Amt) >= 0 Then 'Outstanding' Else 'Credit Remaining' End || '</dt><dd>&#8377;'
                    || to_char(Round(Abs(d.Amt - a.Amt),2),'FM999G99G99G990D00') || '</dd>'
                    || '<div class="ds-arexp-sub">original less settled</div>'
                    /* The arithmetic is spelled out so a reader never has to take on
                       trust that the three figures above belong together. */
                    || '<span class="ds-arexp-tie ds-arexp-tie--ok"><span class="fa fa-check"></span>'
                    || to_char(Round(Abs(d.Amt),2),'FM999G99G99G990D00') || ' &minus; '
                    || to_char(Round(Abs(a.Amt),2),'FM999G99G99G990D00') || ' = '
                    || to_char(Round(Abs(d.Amt - a.Amt),2),'FM999G99G99G990D00') || '</span>'
                    || '</dl></div></div>' As BAND
                  From D d Cross Join A a
                ```
            pageItemsToSubmit: [
                P718_TNO
                P718_SNO
                P718_TODATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column BAND (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: BAND
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

