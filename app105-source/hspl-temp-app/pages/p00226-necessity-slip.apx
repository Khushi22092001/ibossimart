page 226 (
    name: Necessity Slip
    alias: NECESSITY-SLIP
    title: Necessity Slip
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region necessity-slip (
        name: NECESSITY SLIP
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region necessityslip-detail-report (
        name: NecessitySlip Detail Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    a.CompanyCode,
                    co.CompanyName,
                    lo.LocationName,
                    do.DoctypeName,
                    a.NecessitySlipNo,
                    a.NecessitySlipDate,
                    a.EquipmentID,
                    a.DriverName,
                    sn.ShiftName,
                    a.PreviousReading as OpeningMtr,
                    a.MeterReading as ClosingKmr,
                    round(a.HourMeterReading,2) as ClosingHmr,
                    b.Quantity1 as Quantity,
                    a.VehicleNo,
                    vn.VehicleNecessityName,
                    l.LRNo,
                    a.NoOfTrip,
                    sl.StorageLocationName,
                    lt.LocationName as FromLocation,
                    eg.EquipmentGroupName,
                    p.PartyName as PumpName,
                    t.PartyName as TransporterName,
                    round(nvl(b.Quantity1, 0) * nvl(b.DieselRate, 0),2) as Amount,
                    b.Remark,
                    v.VehicletypeName
                From NecessitySlip a, NecessitySlipDetail b, DocumentStatusDetail dsd, VehicleNecessity vn, Company co,
                Location lo, Doctype do, Shift sn, LR l, StorageLocation sl, Location lt, Equipment e, EquipmentGroup eg, Party p, 
                Party t, CompanyVehicle u, Vehicletype v
                Where a.Tno = b.Tno(+)
                    and a.Tno = dsd.ModuleTno(+)
                    and b.VehicleNecessityCode = vn.VehicleNecessityCode(+)
                    and a.CompanyCode = co.CompanyCode(+)
                    and a.LocationCode = lo.LocationCode(+)
                    and a.DoctypeCode = do.DoctypeCode(+)
                    and a.ShiftCode = sn.ShiftCode(+)
                    and a.LRTno = l.Tno(+)
                    and a.StorageLocationCode = sl.StorageLocationCode(+)
                    and a.FromLocationCode = lt.LocationCode(+)
                    and a.EquipmentTno = e.Tno(+)
                    and e.EquipmentGroupCode = eg.EquipmentGroupCode(+)
                    and a.PartyCode = p.PartyCode(+)
                    and a.TransporterCode = t.PartyCode(+)
                    and a.VehicleNo = u.CompanyVehicleNo(+)
                    and u.VehicletypeCode = v.VehicletypeCode(+)
                    and dsd.DocumentStatusCode = 'ACTIVE'
                    and a.StorageLocationCode is null
                    and a.DocTypeCode = 'GENERAL'
                    and b.VehicleNecessityCode in (Select a.VehicleNecessityCode From VehicleNecessityForFuel a)
                    and a.NecessitySlipDate between :P226_FROMDATE and :P226_TODATE
                    and (:P226_COMPANY IS NULL OR instr(':'||:P226_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and (:P226_LOCATION IS NULL OR instr(':'||:P226_LOCATION||':',':'||lo.LocationCode||':') > 0 )
                    and (:P226_DOCTYPE IS NULL OR instr(':'||:P226_DOCTYPE||':',':'||do.DoctypeCode||':') > 0 )
                    and (:P226_PUMP IS NULL OR instr(':'||:P226_PUMP||':',':'||p.PartyCode||':') > 0 )
                    and (:P226_TRANSPORTER IS NULL OR instr(':'||:P226_TRANSPORTER||':',':'||t.PartyCode||':') > 0 )
                    and (:P226_EQUIPMENTGROUP IS NULL OR instr(':'||:P226_EQUIPMENTGROUP||':',':'||eg.EquipmentGroupCode||':') > 0 )
                     and (:P226_EQUIPMENT IS NULL OR instr(':'||:P226_EQUIPMENT||':',':'||e.Tno||':') > 0 )
                     
                UNION ALL
                Select
                    a.CompanyCode,
                    co.CompanyName,
                    lo.LocationName,
                    do.DoctypeName,
                    a.NecessitySlipNo,
                    a.NecessitySlipDate,
                    a.EquipmentID,
                    a.DriverName,
                    sn.ShiftName,
                    a.PreviousReading as OpeningMtr,
                    a.MeterReading as ClosingKmr,
                    round(a.HourMeterReading,2) as ClosingHmr,
                    nvl(b.Quantity1,d1.Quantity) as Quantity,
                    a.VehicleNo,
                    vn.VehicleNecessityName,
                    l.LRNo,
                    a.NoOfTrip,
                    sl.StorageLocationName,
                    fl.LocationName as FromLocation,
                    eg.EquipmentGroupName,
                    p.PartyName as PumpName,
                    t.PartyName as TransporterName,
                    e.Amount,
                    b.Remark,
                    v.VehicletypeName
                From NecessitySlip a, NecessitySlipDetail b, Requisition c, Issue d,Company co,Location lo,
                Doctype do,Shift sn, LR l, VehicleNecessity vn, StorageLocation sl, Location fl, Equipment eq,
                EquipmentGroup eg, Party p,Party t, CompanyVehicle u, Vehicletype v,
                  (
                  Select
                      b.Tno,
                      b.Quantity1 as Quantity
                  From IssueDetail b, Item c
                  Where b.ItemCode = c.ItemCode
                     and c.MeasuringUnitCode1 = 'LTR'
                  UNION ALL
                  Select
                      b.Tno,
                      b.Quantity2 as Quantity
                  From IssueDetail b, Item c
                  Where b.ItemCode = c.ItemCode
                    and c.MeasuringUnitCode2 = 'LTR'
                  ) d1, 
                  (
                  Select
                      a.ModuleTno,
                      d.CostCentreName,
                      abs(b.Amount) as Amount
                  from Voucher a, VoucherDetail b, VoucherCostCentreDetail c, CostCentre d
                  where 1=1
                    and a.Tno = b.Tno(+)
                    and b.Tno = c.Tno(+)
                    and b.Sno = c.Sno(+)
                    and c.CostCentreCode = d.CostCentreCode(+)
                    and b.Amount < 0
                  ) e, 
                DocumentStatusDetail dsd
                Where a.Tno = b.Tno(+)
                    and a.Tno = c.ModuleTno(+)
                    and c.Tno = d.RequisitionTno(+)
                    and a.CompanyCode = co.CompanyCode(+)
                    and a.LocationCode = lo.LocationCode(+)
                    and a.DoctypeCode = do.DoctypeCode(+)
                    and a.ShiftCode = sn.ShiftCode(+)
                    and a.LRTno = l.Tno(+)
                    and b.VehicleNecessityCode = vn.VehicleNecessityCode(+)
                    and a.StorageLocationCode = sl.StorageLocationCode
                    and a.FromLocationCode = fl.LocationCode(+)
                    and a.EquipmentTno = eq.Tno(+)
                    and eq.EquipmentGroupCode = eg.EquipmentGroupCode(+)
                    and a.PartyCode = p.PartyCode(+)
                    and a.TransporterCode = t.PartyCode(+)
                    and a.VehicleNo = u.CompanyVehicleNo(+)
                    and u.VehicletypeCode = v.VehicletypeCode(+)
                    and d.Tno = d1.Tno(+)
                    and d.Tno = e.ModuleTno(+)
                    and a.EquipmentID = e.CostCentreName(+)
                    and a.StorageLocationCode is not null
                    and b.VehicleNecessityCode in (Select a.VehicleNecessityCode From VehicleNecessityForFuel a)
                    and a.Tno = dsd.ModuleTno(+)
                    and dsd.DocumentStatusCode = 'ACTIVE'
                    and a.DocTypeCode = 'DIRECTISSUE'
                    and a.NecessitySlipDate between :P226_FROMDATE and :P226_TODATE
                    and (:P226_COMPANY IS NULL OR instr(':'||:P226_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and (:P226_LOCATION IS NULL OR instr(':'||:P226_LOCATION||':',':'||lo.LocationCode||':') > 0 )
                    and (:P226_DOCTYPE IS NULL OR instr(':'||:P226_DOCTYPE||':',':'||do.DoctypeCode||':') > 0 )
                    and (:P226_PUMP IS NULL OR instr(':'||:P226_PUMP||':',':'||p.PartyCode||':') > 0 )
                    and (:P226_TRANSPORTER IS NULL OR instr(':'||:P226_TRANSPORTER||':',':'||t.PartyCode||':') > 0 )
                    and (:P226_EQUIPMENTGROUP IS NULL OR instr(':'||:P226_EQUIPMENTGROUP||':',':'||eg.EquipmentGroupCode||':') > 0 )
                     and (:P226_EQUIPMENT IS NULL OR instr(':'||:P226_EQUIPMENT||':',':'||eq.Tno||':') > 0 )
                ```
            pageItemsToSubmit: [
                P226_FROMDATE
                P226_TODATE
                P226_COMPANY
                P226_LOCATION
                P226_DOCTYPE
                P226_PUMP
                P226_TRANSPORTER
                P226_EQUIPMENTGROUP
                P226_EQUIPMENT
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
