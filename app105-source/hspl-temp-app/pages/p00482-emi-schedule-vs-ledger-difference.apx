            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      b.PartyName d,
                      b.PartyCode r
                  From Party b
                  Where exists
                  (Select
                     a.Tno
                     From Loan a
                     Where a.PartyCode = b.PartyCode)
                ```
            displayNullValue: false
        }
        layout {
