page 482 (
    name: EMI Schedule VS  Ledger Difference
    alias: EMI-SCHEDULE-VS-LEDGER-DIFFERENCE
    title: EMI Schedule VS  Ledger Difference
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region emi-schedule-vs-ledger-difference (
        name: EMI Schedule VS  Ledger Difference
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region emi-schedule-vs-ledger-difference-2 (
        name: EMI Schedule VS  Ledger Difference
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   Rownum as SerialNo,
                   a.PartyName,
                   a.BalanceAsPerSchedule,
                   a.BalanceAsPerLedger,
                   a.Difference,
                   a.PartyCode,
                   a.Status
                From 
                (
                    Select
                        c.PartyName,
                        c.PartyCode,
                        round(sum(b.PrincipleBalanceAmount),2) as BalanceAsPerSchedule,
                        round(GetAccountClosing(a.PartyCode,:P482_ASONDATE,null,a.CompanyCode),2) as BalanceAsPerLedger,
                        round(nvl(sum(b.PrincipleBalanceAmount),0) - GetAccountClosing(a.PartyCode,:P482_ASONDATE,null,a.CompanyCode),2) as Difference,
                        Case when nvl(sum(b.PrincipleBalanceAmount),0) - GetAccountClosing(a.PartyCode,:P482_ASONDATE,null,a.CompanyCode) != 0 then 'DIFFERENCE'
                        End as Status 
                    From Loan a, LoanDetail b, Party c
                    Where a.Tno = b.Tno
                    and a.PartyCode = c.PartyCode
                    and to_char(b.DueDate, 'MON-RRRR') =
                  (
                   Select
                      to_char(max(b.DueDate), 'MON-RRRR') as DueDate
                    From Loan a, LoanDetail b, Party c
                    Where a.Tno = b.Tno
                    and a.PartyCode = c.PartyCode
                --and a.PartyCode = '2854'
                    and ( :P482_ACCOUNT IS NULL OR instr(':'||:P482_ACCOUNT||':',':'||a.PartyCode||':') > 0 )
                    and ( :P482_COMPANY IS NULL OR instr(':'||:P482_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                    and b.DueDate <= :P482_ASONDATE
                )
                and ( :P482_ACCOUNT IS NULL OR instr(':'||:P482_ACCOUNT||':',':'||a.PartyCode||':') > 0 )
                and ( :P482_COMPANY IS NULL OR instr(':'||:P482_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                Group by c.PartyName,
                c.PartyCode,
                GetAccountClosing(a.PartyCode,:P482_ASONDATE,null,a.CompanyCode)
                ) a
                Where (:P482_STATUS IS NULL OR instr(':'||:P482_STATUS||':',':'||a.Status||':') > 0 )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 85563945898374670
        }

