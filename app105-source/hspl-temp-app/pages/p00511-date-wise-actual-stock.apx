page 511 (
    name: "Date Wise Actual Stock "
    alias: DATE-WISE-ACTUAL-STOCK
    title: "Date Wise Actual Stock "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region date-wise-actual-stock (
        name: Date Wise Actual Stock
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With
                -- Calendar of days
                DT As
                 (Select X.DAYDATE
                    From DATELIST X
                   Where X.DAYDATE Between :P511_FROMDATE And :P511_TODATE),
                
                -- Stock in (qty + amt) during range
                STK As
                 (Select STOCKDATE,
                         itemcode,
                         ROUND(Sum(stockquantity1), 3) As STOCKQUANTITY,
                         ROUND(Sum(amount), 2) As STOCKAMOUNT
                    From stock bb
                   Where bb.stockdate Between :P511_FROMDATE And :P511_TODATE
                     AND BB.STOCKMODULECODE != 'ITEMOPENING'
                   Group By STOCKDATE, itemcode),
                
                -- Stock used (qty + amt) during range
                USTK As
                 (Select bb.usedstockdate As USEDSTOCKDATE,
                         aa.itemcode,
                         ROUND(Sum(bb.usedstockquantity1), 3) As USEDSTOCKQUANTITY,
                         ROUND(Sum(aa.rate * bb.usedstockquantity1), 2) As USEDAMOUNT
                    From stock aa
                    Join usedstock bb
                      On aa.tno = bb.stocktno
                   Where bb.usedstockdate Between :P511_FROMDATE And :P511_TODATE
                   Group By bb.usedstockdate, aa.itemcode),
                
                -- Physical transactions (qty + amt)
                PHY As
                 (Select d.TransactionDate,
                         d.physicalgapitemcode,
                         ROUND(Sum(d.stockquantity1), 3) As PHYSTOCKQUANTITY,
                         ROUND(Sum(d.stockamount), 2) As PHYSTOCKAMOUNT,
                         ROUND(Sum(d.usedstockquantity1), 3) As PHYUSEDSTOCKQUANTITY,
                         ROUND(Sum(d.usedstockamount), 2) As PHYUSEDAMOUNT
                    From physicalgapitemtransaction d
                   Where d.transactiondate Between :P511_FROMDATE And :P511_TODATE
                   Group By d.TransactionDate, d.physicalgapitemcode),
                
                -- Item master (optional filter by item)
                IT As
                 (Select ITEMCODE, ITEMNAME, PHYSICALGAPITEMCODE
                    From ITEM X
                   Where X.PHYSICALGAPITEMCODE Is Not Null
                     And (:P511_ITEM Is Null Or X.ITEMCODE = :P511_ITEM)),
                
                -- Opening balance before start date
                OPENBAL As
                 (Select itemcode,
                         ROUND(Sum(in_qty - out_qty), 3) As OPENING_BAL_QTY,
                         ROUND(Sum(in_amt - out_amt), 2) As OPENING_BAL_AMT
                    From (Select bb.itemcode,
                                 Sum(bb.stockquantity1) As in_qty,
                                 0 As out_qty,
                                 Sum(amount) As in_amt,
                                 0 As out_amt
                            From stock bb
                           Where bb.stockdate <= :P511_FROMDATE
                             AND BB.STOCKMODULECODE='ITEMOPENING'
                           Group By bb.itemcode
                          
                          Union All
                          Select aa.itemcode,
                                 0,
                                 Sum(bb.usedstockquantity1),
                                 0,
                                 Sum(aa.rate * bb.usedstockquantity1)
                            From stock aa
                            Join usedstock bb
                              On aa.tno = bb.stocktno
                           Where bb.usedstockdate < :P511_FROMDATE
                           Group By aa.itemcode
                          
                          Union All
                          Select d.physicalgapitemcode,
                                 Sum(d.stockquantity1),
                                 Sum(d.usedstockquantity1),
                                 Sum(d.stockamount),
                                 Sum(d.usedstockamount)
                            From physicalgapitemtransaction d
                           Where d.transactiondate < :P511_FROMDATE
                           Group By d.physicalgapitemcode)
                   Group By itemcode),
                
                -- Daily movements (qty + amt)
                TXN As
                 (Select DT.DAYDATE,
                         IT.ITEMCODE,
                         IT.ITEMNAME,
                         COALESCE(STK.STOCKQUANTITY, 0) As STOCKQUANTITY,
                         COALESCE(STK.STOCKAMOUNT, 0) As STOCKAMOUNT,
                         COALESCE(USTK.USEDSTOCKQUANTITY, 0) As USEDSTOCKQUANTITY,
                         COALESCE(USTK.USEDAMOUNT, 0) As USEDAMOUNT,
                         COALESCE(PHY.PHYSTOCKQUANTITY, 0) As PHYSTOCKQUANTITY,
                         COALESCE(PHY.PHYSTOCKAMOUNT, 0) As PHYSTOCKAMOUNT,
                         COALESCE(PHY.PHYUSEDSTOCKQUANTITY, 0) As PHYUSEDSTOCKQUANTITY,
                         COALESCE(PHY.PHYUSEDAMOUNT, 0) As PHYUSEDAMOUNT
                    From DT
                   Cross Join IT
                    Left Join STK
                      On IT.ITEMCODE = STK.ITEMCODE
                     And DT.DAYDATE = STK.STOCKDATE
                    Left Join USTK
                      On IT.ITEMCODE = USTK.ITEMCODE
                     And DT.DAYDATE = USTK.USEDSTOCKDATE
                    Left Join PHY
                      On IT.PHYSICALGAPITEMCODE = PHY.PHYSICALGAPITEMCODE
                     And DT.DAYDATE = PHY.TransactionDate),
                
                -- Running balances (qty + amt)
                TXN_BAL As
                 (Select t.DAYDATE,
                         t.ITEMCODE,
                         t.ITEMNAME,
                         t.STOCKQUANTITY,
                         t.STOCKAMOUNT,
                         t.PHYSTOCKQUANTITY,
                         t.PHYSTOCKAMOUNT,
                         t.USEDSTOCKQUANTITY,
                         t.USEDAMOUNT,
                         t.PHYUSEDSTOCKQUANTITY,
                         t.PHYUSEDAMOUNT,
                         ROUND(NVL(ob.OPENING_BAL_QTY, 0) +
                               Sum(t.STOCKQUANTITY + t.PHYSTOCKQUANTITY -
                                   t.USEDSTOCKQUANTITY - t.PHYUSEDSTOCKQUANTITY)
                               OVER(Partition By t.ITEMCODE Order By t.DAYDATE
                                    ROWS Between UNBOUNDED PRECEDING And Current Row),
                               3) As CLOSING_QTY,
                         ROUND(NVL(ob.OPENING_BAL_AMT, 0) +
                               Sum(t.STOCKAMOUNT + t.PHYSTOCKAMOUNT - t.USEDAMOUNT -
                                   t.PHYUSEDAMOUNT)
                               OVER(Partition By t.ITEMCODE Order By t.DAYDATE
                                    ROWS Between UNBOUNDED PRECEDING And Current Row),
                               2) As CLOSING_AMT
                    From TXN t
                    Left Join OPENBAL ob
                      On t.ITEMCODE = ob.ITEMCODE)
                
                -- Final output
                Select DAYDATE,
                       ITEMCODE,
                       ITEMNAME,
                       -- Opening = previous day closing or opening balance if first day
                       ROUND(LAG(CLOSING_QTY,
                                 1,
                                 NVL((Select OPENING_BAL_QTY
                                       From OPENBAL ob
                                      Where ob.ITEMCODE = tx.ITEMCODE),
                                     0)) OVER(Partition By ITEMCODE Order By DAYDATE),
                             3) As OPENING_QTY,
                       STOCKQUANTITY,
                       PHYSTOCKQUANTITY,
                       USEDSTOCKQUANTITY,
                       PHYUSEDSTOCKQUANTITY,
                       CLOSING_QTY,
                       ROUND(LAG(CLOSING_AMT,
                                 1,
                                 NVL((Select OPENING_BAL_AMT
                                       From OPENBAL ob
                                      Where ob.ITEMCODE = tx.ITEMCODE),
                                     0)) OVER(Partition By ITEMCODE Order By DAYDATE),
                             2) As OPENING_AMT,
                       STOCKAMOUNT,
                       PHYSTOCKAMOUNT,
                       USEDAMOUNT,
                       PHYUSEDAMOUNT,
                       CLOSING_AMT
                  From TXN_BAL tx
                  ;
                
                ```
            pageItemsToSubmit: [
                P511_FROMDATE
                P511_TODATE
                P511_ITEM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 38362132536395127
        }

        savedReport 221620 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @DAYDATE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @STOCKQUANTITY
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @PHYSTOCKQUANTITY
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @USEDSTOCKQUANTITY
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @PHYUSEDSTOCKQUANTITY
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @STOCKAMOUNT
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @PHYSTOCKAMOUNT
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @USEDAMOUNT
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @PHYUSEDAMOUNT
                layout {
                    sequence: 14
                }
            )

            displayColumn (
                column: @ITEMCODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ITEMNAME
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @OPENING_QTY
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @CLOSING_QTY
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @CLOSING_AMT
                layout {
                    sequence: 15
                }
            )

            displayColumn (
                column: @OPENING_AMT
                layout {
                    sequence: 10
                }
            )

            sort (
                column: @DAYDATE
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            aggregate sum (
                column: @STOCKQUANTITY
            )

            aggregate sum-2 (
                column: @PHYSTOCKQUANTITY
                showGrandTotal: true
            )

            aggregate sum-3 (
                column: @USEDSTOCKQUANTITY
                showGrandTotal: true
            )

            aggregate sum-4 (
                column: @PHYUSEDSTOCKQUANTITY
                showGrandTotal: true
            )

            aggregate sum-5 (
                column: @STOCKAMOUNT
                showGrandTotal: true
            )

            aggregate sum-6 (
                column: @PHYSTOCKAMOUNT
                showGrandTotal: true
            )

            aggregate sum-7 (
                column: @USEDAMOUNT
                showGrandTotal: true
            )

            aggregate sum-8 (
                column: @PHYUSEDAMOUNT
                showGrandTotal: true
            )

        )

        columnGroup amount (
            heading: Amount
        )

        columnGroup quantity (
            heading: Quantity
        )

        column CLOSING_AMT (
            type: numberField
            heading {
                heading: Closing
                alignment: end
            }
            layout {
                sequence: 150
                columnAlignment: end
                group: @amount
            }
            source {
                databaseColumn: CLOSING_AMT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column CLOSING_QTY (
            type: numberField
            heading {
                heading: Closing
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
                group: @quantity
            }
            source {
                databaseColumn: CLOSING_QTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column DAYDATE (
            type: datePicker
            heading {
                heading: Daydate
            }
            layout {
                sequence: 10
            }
            source {
                databaseColumn: DAYDATE
                dataType: date
            }
        )

        column ITEMCODE (
            type: textField
            heading {
                heading: Itemcode
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ITEMNAME (
            type: textField
            heading {
                heading: Item Name
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ITEMNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column OPENING_AMT (
            type: numberField
            heading {
                heading: Opening
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
                group: @amount
            }
            source {
                databaseColumn: OPENING_AMT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column OPENING_QTY (
            type: numberField
            heading {
                heading: Opening
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
                group: @quantity
            }
            source {
                databaseColumn: OPENING_QTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PHYSTOCKAMOUNT (
            type: numberField
            heading {
                heading: Phy Stock
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
                group: @amount
            }
            source {
                databaseColumn: PHYSTOCKAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PHYSTOCKQUANTITY (
            type: numberField
            heading {
                heading: Phy. Stock
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
                group: @quantity
            }
            source {
                databaseColumn: PHYSTOCKQUANTITY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PHYUSEDAMOUNT (
            type: numberField
            heading {
                heading: "Phy. Used "
                alignment: end
            }
            layout {
                sequence: 140
                columnAlignment: end
                group: @amount
            }
            source {
                databaseColumn: PHYUSEDAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PHYUSEDSTOCKQUANTITY (
            type: numberField
            heading {
                heading: "Phy. Used "
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
                group: @quantity
            }
            source {
                databaseColumn: PHYUSEDSTOCKQUANTITY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column STOCKAMOUNT (
            type: numberField
            heading {
                heading: "Stock "
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
                group: @amount
            }
            source {
                databaseColumn: STOCKAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column STOCKQUANTITY (
            type: numberField
            heading {
                heading: Stock
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
                group: @quantity
            }
            source {
                databaseColumn: STOCKQUANTITY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column USEDAMOUNT (
            type: numberField
            heading {
                heading: Used
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
                group: @amount
            }
            source {
                databaseColumn: USEDAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column USEDSTOCKQUANTITY (
            type: numberField
            heading {
                heading: Used
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
                group: @quantity
            }
            source {
                databaseColumn: USEDSTOCKQUANTITY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    pageItem P511_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P511_ITEM (
        type: popupLov
        label {
            label: Item
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ITEMNAME, ITEMCODE FROM ITEM A
                WHERE A.PHYSICALGAPITEMCODE IS NOT NULL 
                ORDER BY 1
                ```
        }
        layout {
            sequence: 30
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P511_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        settings {
            minDate: item
            minItem: P511_FROMDATE
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: &nbsp Refresh
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            cssClasses: [
                fa
                fa-refresh
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @date-wise-actual-stock
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

