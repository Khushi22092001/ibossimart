page 118 (
    name: Sales Dashboard
    alias: SALES-DASHBOARD
    title: Sales Dashboard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .mycardtext{color:white;}
            .mycardsize{font-size: 15px;font-weight:bold;}
            ```
    }
    security {
        formAutoComplete: false
    }

    region parameters (
        name: Parameters
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region posted (
        name: Posted
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                '₹ '||to_number(Round(sum(a.InvoiceAmount)/100000,2),'99999999999.99') ||' Lac' Value,
                'Posted' as Text,
                'u-color-18' as card_color
                From  Invoice a, Financialyear b
                Where to_Char(a.InvoiceDate,'YYYY') = to_Char(To_Date(:P118_DATE,'DD-MM-YYYY'),'YYYY')
                  and exists (Select 1 from Voucher v where v.ModuleTNo = a.TNo)
                  and a.FinancialYearCode = b.FinancialyearCode
                  and :P118_DATE between b.FinancialYearBegin and b.FinancialyearEnd
                  and a.InvoiceDate <= :P118_DATE
                ```
            pageItemsToSubmit: P118_DATE
        }
        layout {
            sequence: 60
            parentRegion: @top-kpi-trends
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardtext
                mycardsize
            ]
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 56
                    items: {
                        P56_COMPANY: 1
                        P56_DOCTYPE: &P118_DOCTYPE.
                        P56_LOCATION: &P118_LOCATION.
                        P56_FROMDATE: &P118_FROMDATE.
                        P56_TODATE: &P118_DATE.
                        P56_STATUS: ACTIVE
                    }
                }
            }
        )

    )

    region sales-per-day (
        name: Sales Per Day
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                '₹ '||to_number(Round(sum(a.CCInvoiceAmount) /
                GetDayofYear(To_Date(:P118_DATE,'DD-MM-YYYY'))/ 1000000
                ,0),'99999999999.99') ||' Lac'
                 Value,
                'Sales per Day' as Text,
                'u-color-5' as card_color
                From CCInvoice a, financialyear b
                 Where a.financialyearcode = b.financialyearcode
                   And :P118_DATE Between b.financialyearbegin And b.financialyearend
                   And to_Char(a.CCInvoiceDate, 'YYYY') = to_Char(To_Date(:P118_DATE, 'DD-MM-YYYY'), 'YYYY')
                   And a.CCInvoiceDate <= :P118_DATE
                ```
            pageItemsToSubmit: P118_DATE
        }
        layout {
            sequence: 40
            parentRegion: @top-kpi-trends
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardsize
                mycardtext
            ]
        }
    )

    region sales-trend (
        name: Sales Trend
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Select
                      Case When :P118_COMPARE = 'MONTH' then To_Char(a.CCInvoiceDate,'MON-YY')
                           else To_Char(a.CCInvoiceDate,'YYYY')
                      End as MONTHYEAR,
                      sum(a.CCInvoiceAmount) CMA,
                      (
                          Select
                                sum(aa.CCInvoiceAmount)
                          From  CCInvoice aa
                          Where to_Char(aa.CCInvoiceDate,'YYYYMM') = 
                                to_Char(Add_Months(to_date(:P118_DATE,'DD-MON-YYYY'),-1 * (Decode(:P118_COMPARE,'MONTH',1,12)) * nvl(:P118_VALUE,1)) ,'YYYYMM'
                                )
                      ) as PMA
                
                From  CCInvoice a
                Where To_Char(a.CCInvoiceDate,'YYYY') = To_Char(to_date(:P118_DATE,'DD-MON-YYYY'),'YYYY')
                Group by 
                        Case When :P118_COMPARE = 'MONTH' then To_Char(a.CCInvoiceDate,'MON-YY')
                           else To_Char(a.CCInvoiceDate,'YYYY')
                        End
                
                */
                Select Decode(:P118_COMPARE,
                              'MONTH',
                              to_char(a.ccinvoicedate, 'MON-YY'),
                              to_char(a.ccinvoicedate, 'YYYY')) CurrentYear,
                       Sum(a.ccinvoiceamount) As CurrentMOnthAmount,
                       NVL((Select Sum(AA.CCINVOICEAMOUNT)
                          From ccinvoice aa
                         Where to_char(aa.ccinvoicedate, 'YYYYMM') =
                               to_char(ADD_MONTHS(to_date(:P118_DATE,'DD-MON-YYYY'),
                                                  -1 * (Decode(:P118_COMPARE, 'MONTH', 1, 12)) *
                                                  Nvl(:P118_VALUE, 1)),
                                       'YYYYMM')),0) As PrevAmount
                  From CCINVOICE A
                 Where Decode(:P118_COMPARE,
                              'MONTH',
                              to_char(a.ccinvoicedate, 'MON-YY'),
                              to_char(a.ccinvoicedate, 'YYYY')) =
                       Decode(:P118_COMPARE,
                              'MONTH',
                              TO_CHAR(TO_DATE(:P118_DATE, 'DD-MON-YYYY'), 'MON-YY'),
                              TO_CHAR(TO_DATE(:P118_DATE, 'DD-MON-YYYY'), 'YYYY'))
                 Group By Decode(:P118_COMPARE,
                                 'MONTH',
                                 to_char(a.ccinvoicedate, 'MON-YY'),
                                 to_char(a.ccinvoicedate, 'YYYY'))
                
                
                ```
        }
        layout {
            sequence: 80
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 2
        }
        chartLayout {
            height: 400
        }
        legend {
            position: top
        }

        series jet_chart_series (
            name: 1
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: CURRENTYEAR
                value: CURRENTMONTHAMOUNT
            }
            label {
                show: true
                position: outsideSlice
                fontStyle: italic
            }
        )

        series jet_chart_series-2 (
            name: 2
            execution {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: CURRENTYEAR
                value: PREVAMOUNT
            }
            label {
                show: true
                position: outsideSlice
                fontStyle: italic
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region sales-trend-2 (
        name: Sales Trend 2
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    x.LabelName,
                    x.ValueName,
                    Case When rownum = 1 then '#76B947'
                         When rownum = 2 then '#2E8BC0'
                         When rownum = 3 then '#FFA384'
                         When rownum = 4 then '#FF8300'
                         When rownum = 5 then '#B7AC44'
                         When rownum = 6 then '#FF4500'
                         When rownum = 7 then '#DF362D'
                         When rownum = 8 then '#FAD02C'
                         When rownum = 9 then '#333652'
                         When rownum = 10 then '#90ADC6'
                         When rownum = 11 then '#94C973'
                         When rownum = 12 then 'u-color-12'
                    End as Color
                
                From
                (Select
                      
                      Decode(nvl(:P118_COMPARE,'MONTH'),
                              'MONTH',
                              to_char(a.ccinvoicedate, 'MON-YY'),
                              to_char(a.ccinvoicedate, 'YYYY')) LabelName,
                      Decode(nvl(:P118_COMPARE,'MONTH'),
                               'MONTH',
                               to_char(a.ccinvoicedate, 'YYYYMM'),
                               to_char(a.ccinvoicedate, 'YYYY')) OrderName,       
                      Round(sum(TotalAmount),2)as ValueName
                From  BI_SRevenue a, FinancialYear b
                Where a.CCInvoiceDate <= NVL(:P118_DATE,TRUNC(SYSDATE))
                  and a.FinancialyearCode = b.Financialyearcode
                  and :P118_DATE between b.FinancialyearBegin and b.FinancialyearEnd
                Group by Decode(nvl(:P118_COMPARE,'MONTH'),
                              'MONTH',
                              to_char(a.ccinvoicedate, 'MON-YY'),
                              to_char(a.ccinvoicedate, 'YYYY')) ,
                      Decode(nvl(:P118_COMPARE,'MONTH'),
                               'MONTH',
                               to_char(a.ccinvoicedate, 'YYYYMM'),
                               to_char(a.ccinvoicedate, 'YYYY'))
                Order by Decode(nvl(:P118_COMPARE,'MONTH'),
                               'MONTH',
                               to_char(a.ccinvoicedate, 'YYYYMM'),
                               to_char(a.ccinvoicedate, 'YYYY')) desc
                )x
                Where Rownum <= NVL(:P118_VALUE,1)
                ```
            pageItemsToSubmit: [
                P118_VALUE
                P118_DATE
                P118_COMPARE
            ]
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                js-showMaximizeButton
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 400
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        legend {
            show: false
        }

        series jet_chart_series (
            name: 1
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABELNAME
                value: VALUENAME
            }
            appearance {
                color: &COLOR.
            }
            label {
                show: true
                position: outsideBarEdge
                fontStyle: italic
                fontSize: 10
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
