            sequence: 50
            region: @parameters
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select a.financialyearbegin
                From financialyear a 
                Where nvl(:P118_DATE,TRUNC(SYSDATE)) Between a.financialyearbegin And a.financialyearend
                ```
        }
        security {
            encryptSessionState: false
        }
    )

