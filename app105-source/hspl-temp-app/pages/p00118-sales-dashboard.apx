    region top-kpi-trends (
        name: Top KPI Trends
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent1
                t-Region--scrollBody
            ]
            icon: fa-credit-card
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region total-quantity (
        name: Total Quantity
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Round(sum(a.Quantity1),3) ||' MT' Value,
                'Total Quantity' as Text,
                'u-color-11' as card_color
                From  BI_SRevenue a, Item e, FinancialYear f
                Where to_Char(a.CCInvoiceDate,'YYYY') = to_Char(To_Date(:P118_DATE,'DD-MM-YYYY'),'YYYY')
                  and e.MeasuringUnitCode1 = 'MT'
                  and a.ItemCode = e.ItemCode
                  and a.financialyearcode = f.financialyearCode
                  and :P118_DATE between f.financialyearbegin and f.financialyearend
                  and a.CCInvoiceDate <= :P118_DATE
                ```
            pageItemsToSubmit: P118_DATE
        }
        layout {
            sequence: 50
            parentRegion: @top-kpi-trends
            slot: subRegions
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardtext
                mycardsize
            ]
        }
    )

    region total-sales (
        name: Total Sales
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                '₹ '||to_number(Round(sum(a.CCInvoiceAmount)/100000,2),'99999999999.99') ||' Lac' Value,
                'Total Sales' as Text,
                'u-color-22' as card_color
                From CCInvoice a, financialyear b
                 Where a.financialyearcode = b.financialyearcode
                   And :P118_DATE Between b.financialyearbegin And b.financialyearend
                   And to_Char(a.CCInvoiceDate, 'YYYY') = to_Char(To_Date(:P118_DATE, 'DD-MM-YYYY'), 'YYYY')
                   And a.CCInvoiceDate <= :P118_DATE
                ```
            pageItemsToSubmit: P118_DATE
        }
        layout {
            sequence: 20
            parentRegion: @top-kpi-trends
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardsize
            ]
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 119
                    items: {
                        P119_DATE: &P118_DATE.
                    }
                    clearCache: 119
                }
            }
        )

    )

    region total-transactions (
        name: Total Transactions
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                count(a.TNo),
                'Total Transaction' as Text,
                'u-color-14' as card_color
                From CCInvoice a, financialyear b
                 Where a.financialyearcode = b.financialyearcode
                   And a.CCINvoiceDate Between B.FinancialYearBegin And :P118_DATE
                   And to_Char(a.CCInvoiceDate, 'YYYY') = to_Char(To_Date(:P118_DATE, 'DD-MM-YYYY'), 'YYYY')
                   And a.CCInvoiceDate <= To_Date(:P118_DATE, 'DD-MM-YYYY')
                
                ```
            pageItemsToSubmit: P118_DATE
        }
        layout {
            sequence: 10
            parentRegion: @top-kpi-trends
            slot: subRegions
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: COUNT(A.TNO)
            cssClasses: [
                u-color-13-text
                mycardsize
            ]
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 56
                    items: {
                        P56_COMPANY: 1
                        P56_FROMDATE: &P118_FROMDATE.
                        P56_TODATE: &P118_DATE.
                        P56_LOCATION: &P118_LOCATION.
                        P56_DOCTYPE: &P118_DOCTYPE.
                    }
                }
            }
        )

    )

    region un-posted (
        name: Un-Posted
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                '₹ '||to_number(Round(sum(a.InvoiceAmount)/100000,2),'99999999999.99') ||' Lac' Value,
                'Un-Posted' as Text,
                'u-color-9' as card_color
                From  Invoice a, Financialyear b
                Where to_Char(a.InvoiceDate,'YYYY') = to_Char(To_Date(:P118_DATE,'DD-MM-YYYY'),'YYYY')
                  and not exists (Select 1 from Voucher v where v.ModuleTNo = a.TNo)
                  and a.FinancialyearCode = b.Financialyearcode
                  and :P118_DATE between b.Financialyearbegin and b.FinancialyearEnd
                  and a.InvoiceDate <= :P118_DATE
                ```
            pageItemsToSubmit: P118_DATE
        }
        layout {
            sequence: 70
            parentRegion: @top-kpi-trends
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardtext
                mycardsize
            ]
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 56
                    items: {
                        P56_COMPANY: 1
                        P56_FROMDATE: &P118_FROMDATE.
                        P56_TODATE: &P118_DATE.
                        P56_LOCATION: &P118_LOCATION.
                        P56_DOCTYPE: &P118_DOCTYPE.
                        P56_STATUS: NONACTIVE
                    }
                }
            }
        )

    )

    pageItem P118_COMPARE (
