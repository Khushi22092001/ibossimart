page 176 (
    name: Trial Balance Group
    alias: TRIAL-BALANCE-GROUP
    title: Trial Balance Group
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                a.partycode,
                a.partyname,
                getTrialBalancePosition(a.PartyCode) AS ccurrentposition,
                a.partytypecode,
                c.AccountLevel,
                decode(c.openingamount, 0, null, round(C.OPENINGAMOUNT,2)) as openingamount,
                round(C.CLOSINGAMOUNT,2) as closingamount,
                decode(c.OpeningDebitAmount, 0, null, round(c.OpeningDebitAmount,2)) as OpeningDebitAmount,
                decode(c.OpeningCreditAmount, 0, null, round(c.OpeningCreditAmount,2)) as OpeningCreditAmount,
                round(decode(C.DEBITAMOUNT, 0, null, c.DebitAmount),2) AS debitamount,
                round(decode(C.CREDITAMOUNT, 0 , null, round(c.CreditAmount,2)),2) AS CreditAmount,
                decode(C.PDEBITAMOUNT, 0, null, round(c.PDebitAmount,2)) AS pdebitamount,
                decode(C.PCREDITAMOUNT, 0 , null, round(c.PCreditAmount,2)) AS pcreditamount,
                decode(c.ClosingDebitAmount, 0, null, round(c.ClosingDebitAmount,2)) AS debitclosing,
                decode(c.ClosingCreditAmount, 0, null, round(c.ClosingCreditAmount,2)) AS creditclosing,
                CASE WHEN nvl(:P309_LedgerOnly,'NO') = 'NO' and A.partytypecode='ACCOUNTGROUP' then
                
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':176:'||:APP_SESSION||'::'||'P176_accountcode:'|| a.partycode||':'||'P176_FROMDATE,P176_ACCOUNTLEVEL,P176_ACCOUNTCODE,P176_TODATE:'||:P309_FROMDATE||','||C.ACCOUNTLEVEL||','||A.PARTYCODE||','||:P309_TODATE,NULL,'SESSION') ||'">'||rpad('-',5 * (C.AccountLevel - (nvl( (TO_NUMBER(:P309_AccountLevel,99)),1)) ),'-')  || A.PARTYNAME||'</a>'
                
                     WHEN nvl(:P309_LedgerOnly,'NO') = 'NO' and A.partytypecode NOT IN ('ACCOUNTGROUP','ACCOUNT') then
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':177:'||:APP_SESSION||'::'||'P177_fromdate:'|| c.fromdate||':'||'P177_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||rpad('-',5 * (C.AccountLevel - (nvl( (TO_NUMBER(:P309_AccountLevel,99)),1)) ),'-')  || A.PARTYNAME||'</a>'	
                
                 /*    when   A.partytypecode = 'ACCOUNTGROUP' AND then
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':176:'||:APP_SESSION||'::'||'P176_accountcode:'|| a.partycode||':'||'P176_FROMDATE,P176_ACCOUNTLEVEL,P176_ACCOUNTCODE,P176_TODATE:'||:P309_FROMDATE||','||C.ACCOUNTLEVEL||','||A.PARTYCODE||','||:P309_TODATE,NULL,'SESSION') ||'">'|| A.PARTYNAME||'</a>'
                      
                     when  A.partytypecode NOT IN ('ACCOUNTGROUP','ACCOUNT') then
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':177:'||:APP_SESSION||'::'||'P178_fromdate:'|| c.fromdate||':'||'P178_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||a.partyname||'</a>'	
                 */    
                     ELSE
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':178:'||:APP_SESSION||'::'||'P178_fromdate:'|| c.fromdate||':'||'P178_PARTY:'||a.partycode,NULL,'SESSION' )||'">'||a.partyname||'</a>'	
                     
                end ACCOUNTNAMEDISPLAY,
                
                
                CASE WHEN C.AccountLevel  = nvl(:P176_AccountLevel,1) or NVL(:P176_LedgerOnly, 'NO') = 'YES'  then
                       c.OpeningDebitAmount  
                     ELSE
                        0
                END  DebitOpeningC,    
                CASE WHEN C.AccountLevel  = nvl(:P176_AccountLevel,1) or NVL(:P176_LedgerOnly, 'NO') = 'YES'  then
                       c.OpeningCreditAmount 
                     ELSE
                        0
                END  CreditOpeningC,
                CASE WHEN C.AccountLevel  = nvl(:P176_AccountLevel,1) or NVL(:P176_LedgerOnly, 'NO') = 'YES'  then
                       c.DebitAmount  
                     ELSE
                        0
                END  DebitAmountC,    
                CASE WHEN C.AccountLevel  = nvl(:P176_AccountLevel,1) or NVL(:P176_LedgerOnly, 'NO') = 'YES'  then
                       c.CreditAmount 
                     ELSE
                        0
                END  CreditAmountC,
                CASE WHEN C.AccountLevel  = nvl(:P176_AccountLevel,1) or NVL(:P176_LedgerOnly, 'NO') = 'YES'  then
                       c.ClosingDebitAmount  
                     ELSE
                        0
                END  DebitClosingC,    
                CASE WHEN C.AccountLevel  = nvl(:P176_AccountLevel,1) or NVL(:P176_LedgerOnly, 'NO') = 'YES'  then
                       c.ClosingCreditAmount 
                     ELSE
                        0
                END  CreditClosingC
                
                
                
                FROM 
                Party a, ApexTrialBalanceRevisedGroup c
                WHERE C.CREATOR = '&APP_USER.'
                AND a.PartyCode = c.AccountCode
                and (
                     exists (
                           select
                                aa.ChildCode
                           from MyAccountIncludeRevised aa
                           where aa.CompanyCode = :P176_CompanyCode
                               and aa.FromDate = :P176_FROMDATE
                               and aa.ToDate = :P176_TODATE
                               and nvl(aa.LocationCode, 'NULL') = nvl(:P176_LocationCode, 'NULL')
                               and aa.AccountCode = :P176_AccountCode
                               and aa.ChildCode = a.PartyCode
                     )
                     or
                     :P176_AccountCode is null
                )
                
                and ( 
                     nvl(:P176_LedgerOnly,'NO') = 'YES'          
                     or
                     c.AccountLevel <= nvl(:P176_DetailLevel,1)
                     or
                     ( c.AccountLevel <= :P176_AccountLevel+ nvl(:P176_DetailLevel,1) and :P176_AccountCode is not null )
                )
                and ( 
                     nvl(:P176_LedgerOnly,'NO') = 'NO' 
                     OR
                     a.PartyTypeCode != 'ACCOUNTGROUP'
                )
                and (
                     nvl(:P176_IncludeZeroTransaction ,'NO') = 'YES'
                     or ( 
                         nvl(c.OpeningAmount,0) != 0
                         or
                         nvl(c.DebitAmount,0) != 0
                         or
                         nvl(c.CreditAmount,0) != 0
                         or
                         nvl(c.PDebitAmount,0) != 0
                         or
                         nvl(c.PCreditAmount,0) != 0
                     )     
                )
                and (
                     nvl(:P176_Exclude0Closing ,'NO') = 'NO'
                     or (
                         ROUND(nvl(c.OpeningAmount,0) - nvl(c.DebitAmount,0) + nvl(c.CreditAmount,0)   - nvl(c.PDebitAmount,0) + nvl(c.PCreditAmount,0), 2) != 0
                     )     
                )
                and c.FromDate = trunc(TO_DATE(:P176_FROMDATE,'DD-MON-RRRR'))
                and c.ToDate = trunc(TO_DATE(:P176_TODATE,'DD-MON-RRRR'))
                and c.IncludeChild = nvl(:P176_IncludeChild , 'NO')
                and c.CompanyCode = :P176_CompanyCode
                and nvl(c.LocationCode, 'null') = nvl(:P176_Locationcode, 'null') 
                ORDER BY c.TrialBalancePosition, a.PartyName ;
                
                ```
            pageItemsToSubmit: [
                P176_FROMDATE
                P176_TODATE
                P176_DETAILLEVEL
                P176_FINANCIALYEARCODE
                P176_COMPANYCODE
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
