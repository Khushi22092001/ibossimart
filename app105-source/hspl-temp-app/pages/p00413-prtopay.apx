    dynamicAction createtodolist (
        name: CreateToDoList
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: cREATETODOLIST(:APP_USER);
                itemsToSubmit: P1_TNO
            }
            execution {
                sequence: 10
            }
        )

    )

