    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region procure-to-pay (
        name: PROCURE TO PAY
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: PR
            regionDisplaySelector: true
        }
    )

    region prtopay (
        name: PRTOPAY
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  A.MODULESHORTNAME AS TEXT,
                       'u-color-2' As card_color,
                       '#APP_IMAGES#'||A.ICONNAME Iconname,
                       --APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||to_char(a.apexpageno)||':'||:APP_SESSION||':::::'||':NO')  as url
                      CASE WHEN GetApexReportPrivilege_varchar('1',TO_CHAR(a.apexpageno),:APP_USER) = 'True' then
                                APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||to_char(a.apexpageno)||':'||:APP_SESSION||':::::'||':NO') 
                            else 
                                APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||'414'||':'||:APP_SESSION||':::::'||':NO')
                        end as url
                      
                  From module a 
                  where processname = 'PRTOPAY'
                  --and GetApexReportPrivilege_varchar('1',TO_CHAR(a.apexpageno),:APP_USER)='True'
                 --   and exists ( select 1 from myboxtree x where x.modulecode = a.modulecode)
                ORDER BY PROCESSSERIALNO
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                js-headingLevel-1
                t-Form--slimPadding
                margin-top-none
                margin-bottom-none
                margin-left-none
                margin-right-none
            ]
        }
        componentAppearance {
            cssClasses: cards
        }
        card {
            cssClasses: cards
        }
        title {
            column: TEXT
        }
        iconAndBadge {
            iconSource: imageUrl
            imageUrl: &ICONNAME.
            iconCssClasses: cards
            iconPosition: top
        }
        media {
            cssClasses: cards
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: &URL.
            }
        )

    )

    region to-do-list (
        name: To Do List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.MODULECODE,
                       B.ModuleName,
                       b.formname,
                       --'f?p=&APP_ID.:' || TO_CHAR(b.APEXPAGENO) || ':&SESSION.:::'|| TO_CHAR(B.APEXPAGENO) ||'::' target,
                       'f?p=' || :APP_ID || ':' ||to_char(b.APEXPAGENO) || ':' ||:APP_SESSION || '::NO::' || 'P' ||to_char(b.APEXPAGENO) ||'_TODOLIST' || ':' ||'YES'||':NO' target,
                       a.PENDINGTOAPPROVAL,
                       a.PENDINGTONEXTPROCESS,
                       'f?p=' || :APP_ID || ':' ||to_char(b.APEXPAGENO) || ':' ||:APP_SESSION || '::NO::' || 'P' ||to_char(b.APEXPAGENO) ||'_NEXTPROCESS' || ':' ||'YES'||':NO' nextprocess,
                      
                       a.REJECTED,
                       a.CORRECTED,
                       a.CREATOR
                  from TODOLIST a,module b
                  where a.modulecode = b.modulecode 
                    and a.creator = :APP_USER
                  ORDER BY PROCESSSERIALNO
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 44089920923695238
        }

