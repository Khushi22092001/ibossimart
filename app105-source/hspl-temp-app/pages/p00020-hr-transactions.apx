page 20 (
    name: HR Transactions
    alias: HR-TRANSACTIONS
    title: HR Transactions
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region transactions (
        name: Transactions
        type: list
        source {
            list: @human-resource-transaction-list
        }
        layout {
            sequence: 10
            slot: body
            columnCssClasses: hspl-module-tiles
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            listTemplate: @/media-list
            templateOptions: [
                #DEFAULT#
                u-colors
                t-MediaList--cols t-MediaList--3cols
                t-MediaList--iconsRounded
            ]
        }
    )

)

