page 46 (
    name: Employee Master
    alias: EMPLOYEE-MASTER
    title: Employee Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region employee-master (
        name: Employee Master
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--noBorder
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-left-none
                margin-right-none
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region employee-master-report (
        name: Employee Master Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct 
                      a.TNo,
                      row_number() over(order by a.Tno) SerialNo,
                      a.CompanyCode,
                      cc.CompanyName,
                      a.EmployeeCode,
                      a.EmployeeID,
                      a.EmployeeName,
                      a.EmployeeShortName,
                      a.FatherName,
                      a.DepartmentCode,
                      dp.DepartmentName,
                      GetEmployeeDepartmentName(a.EmployeeCode,sysdate)as CurrentDepartmentName,
                      a.DesignationCode,
                      dg.DesignationName,
                      eg.EmployeeGradeName,
                      GetEmployeeDesignationName(a.EmployeeCode,sysdate)as CurrentDesignationName,
                      a.HusbandName,
                      GetPartyName(a.SalaryAccountCode) as SalaryAccountCode,
                      a.DateofBirth,
                      a.DateofAppointment,
                      a.DateofJoining,
                      a.ShiftCode,
                      s.ShiftName,
                      a.StaffTypeCode,
                      st.StaffTypeName,
                      a.EmployeeTypeCode,
                      et.EmployeeTypeName,
                      a.PFDeductionOn,
                      a.ISESICApplicable,
                      a.MaritalStatus,
                      a.Gender,
                      a.OffDay,
                      a.PresentAddress,
                      pc.CityName as PresentCityName,
                      ps.StateName as PresentStateName,
                      a.PresentPhoneNo,
                      a.PermanentAddress,
                      c.Cityname as PermanentCityName,
                      s.StateName as PermanentStateName,
                      a.LocationCode,
                      GetEmployeeLocationName(a.employeeCode,NVL(:P46_FROMDATE,TRUNC(SYSDATE))) as LocationName,
                      GetEmployeeLocationName(a.EmployeeCode,sysdate) as CurrentLocationName,
                      a.OfficeMobileNo,
                      a.OfficeEmailID,
                      a.PersonalMobileNo,
                      a.PersonalEmailID,
                      a.MonthlyCTC,
                      (SELECT SUM(SALARYHEADFORMULA) 
                        FROM EMPLOYEESALARYDETAIL AA
                        WHERE AA.TNO =getemployeesalarytno(a.employeecode,TRUNC(SYSDATE)) 
                          AND AA.SALARYHEADCODE='CTC'
                      ) as CurrentCTC,
                      a.ISHOD,
                      a.CanAllowVisitor,
                      a.IsSignatory,
                      a.IsGroupSignatory,
                      a.LeaveSchemeCode,
                      ls.LeaveSchemeName,
                      a.SalarySchemeCode,
                      ss.SalarySchemeName,
                      a.AdharNo,
                      a.PFAccountNo,
                      a.ESICAccountNo,
                      a.ESICEstablishmentCodeNo,
                      a.PANNo,
                      a.UAN,
                      a.BloodGroup,
                      a.DrivingLicenseNo,
                      a.DrivingLicenseExpiryDate,
                      a.MoneyTransferModeCode,
                      a.BankCode,
                      b.BankName,
                      a.IFSCCode,
                      a.BankAccountNo,
                      a.SkillsCode,
                      sk.SkillsName,
                      CO.COSTCENTRENAME,
                      w.workcentrename,
                      rg.Resignationacceptencedate,
                      Case When rg.Resignationacceptencedate is not null Then 'YES'
                           When rg.Resignationacceptencedate is null Then 'NO'
                      End ResignationStatus,
                      getdocumentstatuscode('EMPLOYEE',A.TNO) AS STATUS,
                      a.coffallowed,a.issinglepunchallowed
                
                From  Employee a, Company cc, Department  dp, Designation dg, EmployeeType et, Shift s, StaffType st, City pc, State ps, City c, State s, LeaveScheme ls, SalaryScheme ss, Bank b, 
                      Skills sk , Resignation rg, EmployeeGrade eg, MyEmployeeInclude m, CostCentre co, Workcentre w
                Where a.CompanyCode = cc.CompanyCode(+)
                  and a.tno = co.moduletno(+)
                  and a.DepartmentCode = dp.DepartmentCode(+)
                  and a.DesignationCode = dg.DesignationCode(+)
                  and dg.EmployeeGradeCode = eg.EmployeeGradeCode(+)
                  and a.ShiftCode = s.ShiftCode(+)
                  and a.StaffTypeCode = st.StaffTypeCode(+)
                  and a.EmployeeTypeCode = et.EmployeeTypeCode(+)
                  and a.PresentCityCode = pc.CityCode(+)
                  and a.PermanentCityCode = c.CityCode(+)
                  and a.PresentStateCode = ps.StateCode(+)
                  and a.PermanentStateCode = s.StateCode(+)
                  and a.LeaveSchemeCode = ls.LeaveSchemeCode(+)
                  and a.SalarySchemeCode = ss.SalarySchemeCode(+)
                  and a.BankCode = b.BankCode(+)
                  and a.SkillsCode = sk.SkillsCode(+)
                  and a.Workcentrecode = w.workcentrecode(+)
                  and a.EmployeeCode = rg.EmployeeCode(+)
                  and a.employeecode = m.childcode(+)
                  and instr(':'||:P46_COMPANY||':',':'||GETEMPLOYEECOMPANYCODE(A.EMPLOYEECODE,TRUNC(SYSDATE))||':') > 0
                  and instr(':'||:P46_LOCATION||':',':'||GETEMPLOYEELOCATIONCODE(A.EMPLOYEECODE,TRUNC(SYSDATE))||':') > 0
                  and ( :P46_DESIGNATION IS NULL OR instr(':'||:P46_DESIGNATION||':',':'||a.DesignationCode||':') > 0 ) 
                  and ( :P46_DEPARTMENT IS NULL OR instr(':'||:P46_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0 ) 
                  and Case When rg.Resignationacceptencedate is not null Then 'YES'
                           When rg.Resignationacceptencedate is null Then 'NO'
                  End like nvl(:P46_RESIGNATIONSTATUS,'%')  
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 500
        }
        advanced {
            savedReportMappingIdentifier: 15785725601459919
        }

