    pageItem P46_RESIGNATIONSTATUS (
        type: selectList
        label {
            label: Resignation
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:YES;YES,NO;NO
            nullDisplayValue: -Select Resignation Status-
        }
        layout {
            sequence: 50
            region: @employee-master
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
