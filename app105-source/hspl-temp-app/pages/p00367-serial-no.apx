page 367 (
    name: SERIAL NO
    alias: SERIAL-NO
    title: SERIAL NO
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                b.CostCentreName,
                c.StorageLocationName,
                d.ComponentSerialNo
                From IssueDetail aa,IssueDetailSerialNo a, CostCentre b, StorageLocation c, ComponentStock d, ComponentStock e
                Where aa.Tno = a.Tno(+)
                and aa.Sno = a.Sno(+)
                and a.CostCentreCode = b.CostCentreCode(+)
                and a.StorageLocationCode = c.StorageLocationCode(+)
                and a.ComponentStockTno = d.Tno(+)
                and a.OldComponentStockTno = e.Tno(+)
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 99610979480404739
        }

        column COMPONENTSERIALNO (
            type: plainText
            heading {
                heading: Component Serial No
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column COSTCENTRENAME (
            type: plainText
            heading {
                heading: Cost Centre Name
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column STORAGELOCATIONNAME (
            type: plainText
            heading {
                heading: Storage Location Name
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }
    )

)

