page 33 (
    name: Dashboard Privilege Report
    alias: DASHBOARD-PRIVILEGE-REPORT
    title: Dashboard Privilege Report
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region dashboard-privilege-report (
        name: Dashboard Privilege Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report 1
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.Tno,
                      a.SNo,
                      a.ExtraPrivilegeCode,
                      c.ExtraPrivilegeName,
                      bu.LoginName,
                      b.ModuleCode,
                      A.REMARK
                From  ModulePrivilegeExtra a, ModulePrivilege b, ExtraPrivilege c, BossUser bu
                Where a.TNo = b.TNo
                  and a.ExtraPrivilegeCode = c.ExtraPrivilegeCode
                  and b.ModuleCode = 'DASHBOARD'
                  and b.BossUserCode = bu.BossUserCode
                  and b.BossUserCode = :P33_USER
                  and b.CompanyCode = :P33_COMPANY
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 32
                items: {
                    P32_TNO: #TNO#
                    P32_SNO: #SNO#
                    P32_EXTRAPRIVILEGECODE: #EXTRAPRIVILEGECODE#
                    P32_REMARK: #REMARK#
                }
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4052888941134359
        }

        column EXTRAPRIVILEGECODE (
            type: plainText
            heading {
                heading: EXTRAPRIVILEGECODE
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column EXTRAPRIVILEGENAME (
            type: plainText
            heading {
                heading: EXTRA PRIVILEGE
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column LOGINNAME (
            type: plainText
            heading {
                heading: LOGIN NAME
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: MODULE
                alignment: center
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: REMARK
                alignment: center
            }
            layout {
                sequence: 16
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column SNO (
            type: hidden
            heading {
                heading: Sno
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
            security {
                escapeSpecialChars: false
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
            security {
                escapeSpecialChars: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report 1
        }

        savedReport 40581 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EXTRAPRIVILEGENAME (
                sequence: 3
            )

            displayColumn LOGINNAME (
                sequence: 2
            )

            displayColumn MODULECODE (
                sequence: 1
            )

            displayColumn REMARK (
                sequence: 4
            )

        )

    )

    pageItem P33_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'DASHBOARD'
                 -- and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @dashboard-privilege-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Company Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P33_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @dashboard-privilege-report
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                Select
                      a.Tno
                From  ModulePrivilege a, BossUser bu
                Where a.BossUserCode = bu.BossUserCode
                  and bu.BossUserCode = :P33_USER
                  and a.CompanyCode = :P33_COMPANY
                  and ModuleCode = 'DASHBOARD'
                ```
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P33_USER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: User
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      a.LoginName d,
                      a.BossUserCode r
                From  Bossuser a, BossUserRole b
                Where a.TNo = b.TNo
                 and b.CompanyCode = :P33_COMPANY
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P33_COMPANY
            itemsToSubmit: P33_USER
        }
        layout {
            sequence: 30
            region: @dashboard-privilege-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter User Name
        }
        validation {
            valueRequired: true
        }
    )

    button create (
        buttonName: CREATE
        label: Add
        layout {
            sequence: 20
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-plus-square
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 32
                items: {
                    P32_TNO: &P33_TNO.
                    P32_USER: &P33_USER.
                }
                clearCache: 32
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button pass (
        buttonName: PASS
        label: Pass Privilege
        layout {
            sequence: 10
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-arrow-circle-right
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 34
                items: {
                    P34_PUSER: &P33_USER.
                    P34_TNO: &P33_TNO.
                }
                clearCache: 34
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 40
            region: @dashboard-privilege-report
            slot: regionBody
            column: 10
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

