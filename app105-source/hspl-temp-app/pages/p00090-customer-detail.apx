    process fetch-customer-detail (
        name: Fetch Customer Detail
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Select
                      a.TNo,
                      a.PartyCode,
                      a.PartyName,
                      a.PartyTypeCode,
                      a.PrintName,
                      a.PartyShortName,
                      GetPartyName(a.ParentCode) as ParentGroup,
                      a.OfficeAddress1||''||a.OfficeAddress2 as OfficeAddress,
                      GetCityName(a.OfficeCityCode) as OfficeCity,
                      GetStateName(a.OfficeStateCode) as OfficeState,
                      a.OfficePinCode,
                      a.OfficePhoneNo,
                      a.OfficeEmail,
                      a.WorksAddress1||''||a.WorksAddress2 as WorksAddress,
                      GetCityName(a.WorksCityCode) as WorksCity,
                      GetStateName(a.WorksStateCode) as WorksState,
                      a.WorksPinCode,
                      a.WorksPhoneNo,
                      a.WorksEmail,
                      GetPartyAttributeValue(a.PartyCode,'GSTINNO') as GSTNO,
                      GetPartyAttributeValue(a.PartyCode,'PANNO') as PANNO,
                      a.ContactPerson,
                      a.ContactNo,
                      a.OwnerName
                      into
                      :P90_TNO,
                      :P90_PARTYCODE,
                      :P90_PARTYNAME,
                      :P90_PARTYTYPECODE,
                      :P90_PRINTNAME,
                      :P90_PARTYSHORTNAME,
                      :P90_PARENTGROUP,
                      :P90_OFFICEADDRESS,
                      :P90_OFFICECITY,
                      :P90_OFFICESTATE,
                      :P90_OFFICEPINCODE,
                      :P90_OFFICEPHONENO,
                      :P90_OFFICEEMAIL,
                      :P90_WORKSADDRESS,
                      :P90_WORKSCITY,
                      :P90_WORKSSTATE,
                      :P90_WORKSPINCODE,
                      :P90_WORKSPHONENO,
                      :P90_WORKSEMAIL,
                      :P90_GSTNO,
                      :P90_PANNO,
                      :P90_CONTACTPERSON,
                      :P90_CONTACTNO,
                      :P90_OWNERNAME
                From  Party a
                Where a.PartyCode = :P90_PARTYCODE;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 7262399014530222
        }
    )

)

