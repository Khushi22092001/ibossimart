page 324 (
    name: Diesel Stock
    alias: DIESEL-STOCK
    title: Diesel Stock
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region diesel-stock-report (
        name: Diesel Stock Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region diesel-stock-report-2 (
        name: Diesel Stock Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                rownum as serialno,
                x.DayDate,
                x.LocationCode,
                y.ModuleNo as DocumentNo,
                y.PurchaseQuantity,
                y.TransferInQuantity,
                y.TransferOutQuantity,
                y.IssueQuantity
                From
                (
                Select
                b.DayDate,
                a.LocationCode
                From Location a, DateList b
                Where b.DayDate >= '01-apr-2023'
                and exists(
                Select
                aa.Tno
                From Stock aa, Item bb
                Where aa.LocationCode = a.LocationCode
                and aa.StockDate = b.DayDate
                and upper(bb.ItemName) like '%DIESEL%'
                and (
                bb.MeasuringUnitCode1 in ('KL', 'LTR')
                or
                bb.MeasuringUnitCode2 in ('KL', 'LTR')
                )
                )
                ) x,
                (
                Select
                a.GRNNo as ModuleNo,
                d.StockDate,
                d.LocationCode,
                sum(d.StockQuantity1) as PurchaseQuantity,
                null as TransferInQuantity,
                null as TransferOutQuantity,
                null as IssueQuantity
                From GRN a, GRNDetail b, InspectionDetail c, Stock d, Item e
                Where a.Tno = b.Tno
                and b.Tno = c.GRNTno
                and b.ItemCode = c.ItemCode
                and b.ItemSpecificationCode = c.ItemSpecificationCode
                and c.Tno = d.StockModuleTno
                and c.Sno = d.StockModuleSno
                and d.ItemCode = e.ItemCode
                and e.MeasuringUnitCode2 is null
                and a.PurchaseOrderTno is not null
                Group by
                a.GRNNo,
                d.StockDate,
                d.LocationCode
                UNION ALL
                Select
                a.GRNNo as ModuleNo,
                d.StockDate,
                d.LocationCode,
                sum(d.StockQuantity2) as PurchaseQuantity,
                null as TransferInQuantity,
                null as TransferOutQuantity,
                null as IssueQuantity
                From GRN a, GRNDetail b, InspectionDetail c, Stock d, Item e
                Where a.Tno = b.Tno
                and b.Tno = c.GRNTno
                and b.ItemCode = c.ItemCode
                and b.ItemSpecificationCode = c.ItemSpecificationCode
                and c.Tno = d.StockModuleTno
                and c.Sno = d.StockModuleSno
                and d.ItemCode = e.ItemCode
                and e.MeasuringUnitCode2 is not null
                and a.PurchaseOrderTno is not null
                Group by
                a.GRNNo,
                d.StockDate,
                d.LocationCode
                UNION ALL
                Select
                a.GRNNo as ModuleNo,
                d.StockDate,
                d.LocationCode,
                null as PurchageQuantity,
                sum(d.StockQuantity1) as TransferInQuantity,
                null as TransferOutQuantity,
                null as IssueQuantity
                From GRN a, GRNDetail b, InspectionDetail c, Stock d, Item e
                Where a.Tno = b.Tno
                and b.Tno = c.GRNTno
                and b.ItemCode = c.ItemCode
                and b.ItemSpecificationCode = c.ItemSpecificationCode
                and c.Tno = d.StockModuleTno
                and c.Sno = d.StockModuleSno
                and d.ItemCode = e.ItemCode
                and e.MeasuringUnitCode2 is null
                and a.InterUnitTransferCCInvoiceTno is not null
                Group by
                a.GRNNo,
                d.StockDate,
                d.LocationCode
                UNION ALL
                Select
                a.GRNNo,
                d.StockDate,
                d.LocationCode,
                null as PurchageQuantity,
                sum(d.StockQuantity2) as TransferInQuantity,
                null as TransferOutQuantity,
                null as IssueQuantity
                From GRN a, GRNDetail b, InspectionDetail c, Stock d, Item e
                Where a.Tno = b.Tno
                and b.Tno = c.GRNTno
                and b.ItemCode = c.ItemCode
                and b.ItemSpecificationCode = c.ItemSpecificationCode
                and c.Tno = d.StockModuleTno
                and c.Sno = d.StockModuleSno
                and d.ItemCode = e.ItemCode
                and e.MeasuringUnitCode2 is not null
                and a.InterUnitTransferCCInvoiceTno is not null
                Group by
                a.GRNNo,
                d.StockDate,
                d.LocationCode
                UNION ALL
                Select
                a.CCInvoiceNo,
                a.CCInvoiceDate,
                a.LocationCode,
                null as PurchageQuantity,
                null as TransferInQuantity,
                sum(c.Quantity1) as TransferOutQuantity,
                null as IssueQuantity
                From CCInvoice a, CCInvoiceDetail b, CCInvoiceStockStorageDetail c, Item d
                Where a.Tno = b.Tno
                and b.Tno = c.Tno
                and b.Sno = c.Sno
                and b.ItemCode = d.ItemCode
                and d.MeasuringUnitCode2 is not null
                Group by
                a.CCInvoiceNo,
                a.CCInvoiceDate,
                a.LocationCode
                UNION ALL
                Select
                a.CCInvoiceNo,
                a.CCInvoiceDate,
                a.LocationCode,
                null as PurchageQuantity,
                null as TransferInQuantity,
                sum(c.Quantity2) as TransferOutQuantity,
                null as IssueQuantity
                From CCInvoice a, CCInvoiceDetail b, CCInvoiceStockStorageDetail c, Item d
                Where a.Tno = b.Tno
                and b.Tno = c.Tno
                and b.Sno = c.Sno
                and b.ItemCode = d.ItemCode
                and d.MeasuringUnitCode2 is not null
                Group by
                a.CCInvoiceNo,
                a.CCInvoiceDate,
                a.LocationCode
                UNION ALL
                Select
                c.IssueNo,
                c.IssueDate,
                c.LocationCode,
                null as PurchageQuantity,
                null as TransferInQuantity,
                null as TransferOuteQuantity,
                sum(e.Quantity1) as IssueQuantity
                From NecessitySlip a, Requisition b, Issue c, IssueDetail d, IssueStockDetail e,Item f
                Where a.Tno = b.ModuleTno
                and b.ModuleTno = c.ModuleTno
                and c.Tno = d.Tno
                and d.Tno = e.Tno
                and d.ItemCode = f.ItemCode
                and f.MeasuringUnitCode1 is null
                --and b.ModuleTno is not null
                Group by
                c.IssueNo,
                c.IssueDate,
                c.LocationCode
                UNION ALL
                Select
                c.IssueNo,
                c.IssueDate,
                c.LocationCode,
                null as PurchageQuantity,
                null as TransferInQuantity,
                null as TransferOuteQuantity,
                sum(e.Quantity1) as IssueQuantity
                From NecessitySlip a, Requisition b, Issue c, IssueDetail d, IssueStockDetail e,Item f
                Where a.Tno = b.ModuleTno
                and b.ModuleTno = c.ModuleTno
                and c.Tno = d.Tno
                and d.Tno = e.Tno
                and d.ItemCode = f.ItemCode
                and f.MeasuringUnitCode2 is not null
                Group by
                c.IssueNo,
                c.IssueDate,
                c.LocationCode
                ) y
                Where x.DayDate = y.StockDate(+)
                and x.LocationCode = y.LocationCode(+)
                and x.DayDate Between :P324_FROMDATE and :P324_TODATE
                and x.DayDate is not null
                and (:P324_LOCATION is Null Or Instr (':' || :P324_LOCATION || ':' , ':' || x.LocationCode || ':') > 0)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                    //    rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 47499302759144532
        }

        savedReport 489063 (
            visibility: primary
            view {
                default: grid
                settingsAreaExpanded: false
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @SERIALNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DAYDATE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @LOCATIONCODE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @PURCHASEQUANTITY
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @TRANSFERINQUANTITY
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @TRANSFEROUTQUANTITY
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @ISSUEQUANTITY
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @DOCUMENTNO
                layout {
                    width: 254
                    sequence: 3
                }
            )

            sort (
                column: @SERIALNO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            sort (
                column: @DAYDATE
                sort {
                    nulls: last
                    sequence: 2
                }
            )

            aggregate count (
                column: @DAYDATE
                function: count
            )

            aggregate sum (
                column: @PURCHASEQUANTITY
                showGrandTotal: true
            )

            aggregate sum-2 (
                column: @TRANSFERINQUANTITY
                showGrandTotal: true
            )

            aggregate sum-3 (
                column: @TRANSFEROUTQUANTITY
                showGrandTotal: true
            )

            aggregate sum-4 (
                column: @ISSUEQUANTITY
                showGrandTotal: true
            )

        )

        column DAYDATE (
            type: datePicker
            heading {
                heading: Day Date
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                databaseColumn: DAYDATE
                dataType: date
            }
        )

        column DOCUMENTNO (
            type: textarea
            heading {
                heading: Document No
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: DOCUMENTNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
        )

        column ISSUEQUANTITY (
            type: numberField
            heading {
                heading: Issue Quantity
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: ISSUEQUANTITY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column LOCATIONCODE (
            type: textField
            heading {
                heading: Location
            }
            layout {
                sequence: 20
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                databaseColumn: LOCATIONCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column PURCHASEQUANTITY (
            type: numberField
            heading {
                heading: Purchase Quantity
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: PURCHASEQUANTITY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SERIALNO (
            type: numberField
            heading {
                heading: Serial No
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                databaseColumn: SERIALNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TRANSFERINQUANTITY (
            type: numberField
            heading {
                heading: Transfer In Quantity
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: TRANSFERINQUANTITY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TRANSFEROUTQUANTITY (
            type: numberField
            heading {
                heading: Transfer Out Quantity
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: TRANSFEROUTQUANTITY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Diesel Stock Report
        }
    )

    pageItem P324_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @diesel-stock-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P324_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                b.LocationName d,
                b.locationCode r
                From Location b
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @diesel-stock-report
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P324_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @diesel-stock-report
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 40
            region: @diesel-stock-report
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

