page 350 (
    name: Test Form
    alias: TEST-FORM
    title: Test Form
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region forms (
        name: FORMS
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: Select * from Employee;
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P350_AADHARNO (
        type: numberField
