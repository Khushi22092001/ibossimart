    region kpi-strip (
        name: Customer Snapshot
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Cur As (
                       Select a.TNo, b.SNo, b.ItemCode, b.Amount, b.TotalAmount, a.CCInvoiceDate
                         From CCInvoice a
                         Left Join CCInvoiceDetail b On b.TNo = a.TNo
                        Where a.CCInvoiceDate >= to_date(:P655_FROMDATE,'DD-MM-RRRR')
                          And a.CCInvoiceDate <  to_date(:P655_TODATE,'DD-MM-RRRR') + 1
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (
                              :P655_PANEL   Is Null Or a.Panel        = :P655_PANEL
                          )
                          And (
                              :P655_COMPANY Is Null Or a.CompanyCode  = :P655_COMPANY
                          )
                          And (
                              :P655_LOCATION Is Null Or a.LocationCode = :P655_LOCATION
                          )
                          And a.PartyCode = :P655_PARTY_CODE),
                Agg As (
                       Select Sum(Amount) Val, Sum(TotalAmount) Inv, Count(SNo) Lines,
                              Count(Distinct TNo) Invoices, Count(Distinct ItemCode) Items,
                              Max(CCInvoiceDate) LastInv
                         From Cur)
                Select
                  '<div class="ds-kpi ds-kpi--value"><span class="ds-kpi-ic"><span class="fa fa-inr"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Sales Value</span><span class="ds-kpi-n">'
                  || Case When nvl(Val,0) >= 10000000 Then 'Rs ' || to_char(Round(Val/10000000,2),'FM99G990D00') || ' Cr'
                          When nvl(Val,0) >= 100000 Then 'Rs ' || to_char(Round(Val/100000,2),'FM99G990D00') || ' L'
                          Else 'Rs ' || to_char(nvl(Val,0),'FM99G99G990D00') End
                  || '</span><span class="ds-kpi-sub">taxable line value</span></span></div>' As KPI1,
                  '<div class="ds-kpi ds-kpi--input"><span class="ds-kpi-ic"><span class="fa fa-list-alt"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Invoices</span><span class="ds-kpi-n">'
                  || to_char(nvl(Invoices,0),'FM999G999') || '</span><span class="ds-kpi-sub">last '
                  || nvl(to_char(LastInv,'DD-Mon-RRRR'),'—') || '</span></span></div>' As KPI2,
                  '<div class="ds-kpi ds-kpi--suppl"><span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Items Bought</span><span class="ds-kpi-n">'
                  || to_char(nvl(Items,0),'FM999G999') || '</span><span class="ds-kpi-sub">'
                  || to_char(nvl(Lines,0),'FM999G999') || ' invoice lines</span></span></div>' As KPI3,
                  '<div class="ds-kpi ds-kpi--struct"><span class="ds-kpi-ic"><span class="fa fa-calculator"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Average Invoice Value</span><span class="ds-kpi-n">'
                  || Case When nvl(Invoices,0) = 0 Then 'Rs 0'
                          Else Case When Inv/Invoices >= 100000 Then 'Rs ' || to_char(Round(Inv/Invoices/100000,2),'FM99G990D00') || ' L'
                                    Else 'Rs ' || to_char(Round(Inv/Invoices),'FM99G99G990') End End
                  || '</span><span class="ds-kpi-sub">across ' || to_char(nvl(Invoices,0),'FM999G999') || ' invoices</span></span></div>' As KPI4
                From Agg
                ```
            pageItemsToSubmit: [
                P655_FROMDATE
                P655_TODATE
                P655_PARTY_CODE
                P655_LOCATION
                P655_PANEL
                P655_COMPANY
            ]
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No sales to this customer in this period.
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI2 (
            reportColumnQueryId: 2
            derivedColumn: N
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI3 (
            reportColumnQueryId: 3
            derivedColumn: N
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI4 (
            reportColumnQueryId: 4
            derivedColumn: N
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region monthly-chart (
        name: Monthly Sales to this Customer
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select to_char(Trunc(a.CCInvoiceDate,'MM'),'Mon-RR') MONTH_LABEL,
                       Round(Sum(b.Amount)/100000,2) VALUE_LAC,
                       Trunc(a.CCInvoiceDate,'MM') SORT_KEY
                  From CCInvoice a Join CCInvoiceDetail b On b.TNo = a.TNo
                 Where a.CCInvoiceDate >= to_date(:P655_FROMDATE,'DD-MM-RRRR')
                   And a.CCInvoiceDate <  to_date(:P655_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P655_PANEL   Is Null Or a.Panel        = :P655_PANEL
                   )
                   And (
                       :P655_COMPANY Is Null Or a.CompanyCode  = :P655_COMPANY
                   )
                   And (
                       :P655_LOCATION Is Null Or a.LocationCode = :P655_LOCATION
                   )
                   And a.PartyCode = :P655_PARTY_CODE
                 Group By Trunc(a.CCInvoiceDate,'MM')
                 Order By SORT_KEY
                ```
            pageItemsToSubmit: [
                P655_FROMDATE
                P655_TODATE
                P655_PARTY_CODE
                P655_LOCATION
                P655_PANEL
                P655_COMPANY
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: line
        }
        chartLayout {
            height: 300
        }
        messages {
            whenNoDataFound: No sales to this customer to plot.
        }

        series sv (
            name: Sales Value (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: MONTH_LABEL
                value: VALUE_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region page-style (
        name: Sales Theme
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                body:has(.ds-sales-headregion){
                  --ds-dash-gold:#4F46E5; --ds-dash-gold-bg:#EEF0FE;
                  --ds-dash-ink:#1E1B4B; --ds-dash-ink2:#4C4A6E;
                  --ds-dash-canvas:#F7F7FB; --ds-dash-tinted:#F2F2F9; --ds-dash-line:#E4E4F0;
                }
                body:has(.ds-sales-headregion) .ds-kpi--value{--ds-kpi-accent:#4F46E5;--ds-kpi-accent-bg:#EEF0FE;}
                body:has(.ds-sales-headregion) .ds-kpi--bill {--ds-kpi-accent:#6D5CE7;--ds-kpi-accent-bg:#EEF0FE;}
                body:has(.ds-sales-headregion) .ds-kpi--input{--ds-kpi-accent:#0E7C86;--ds-kpi-accent-bg:#E4F4F5;}
                body:has(.ds-sales-headregion) .ds-purchase-section::before{background:linear-gradient(180deg,#6D5CE7,#3730A3);}
                body:has(.ds-sales-headregion) .ds-dash-filters::after{display:none;}
                .ds-sales-head{position:relative;overflow:hidden;padding:24px 26px 20px;border:1px solid #C7C5EE;border-radius:16px;background:radial-gradient(130% 130% at 92% 8%, rgba(109,92,231,.30) 0%, rgba(109,92,231,0) 48%),radial-gradient(120% 120% at 0% 100%, rgba(55,48,163,.20) 0%, rgba(55,48,163,0) 44%),linear-gradient(120deg,#D9D8F4 0%,#D2CFF0 34%,#DED9F6 66%,#EAE7FC 100%);box-shadow:0 1px 2px rgba(16,24,40,.05),0 12px 34px rgba(79,70,229,.12);}.ds-sales-head-eyebrow,.ds-sales-head-title,.ds-sales-head-sub,.ds-sales-head-context{position:relative;z-index:1;}.ds-sales-head-context{max-width:64%;}
                .ds-sales-head-eyebrow{font-size:11px;font-weight:700;letter-spacing:.10em;
                  text-transform:uppercase;color:#4F46E5;margin-bottom:4px;}
                .ds-sales-head-title{margin:0;font-size:25px;font-weight:600;letter-spacing:-.01em;
                  line-height:1.2;color:#1E1B4B;}
                .ds-sales-head-sub{margin:5px 0 0;font-size:13px;line-height:1.5;color:#4C4A6E;max-width:74ch;}
                .ds-sales-head-context{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px;}
                html.page-655 .t-Body-title.hspl-hero-card,html.page-655 .t-Body-title{display:none !important;}
                </style>
                ```
        }
        layout {
            sequence: 1
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
        }
    )

    pageItem P655_COMPANY (
        type: hidden
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P655_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate,'MM'),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P655_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r From Location l
                 Where Exists (Select 1 From CCInvoice a Where a.LocationCode = l.LocationCode
                                And ((Select GetUserPanelAB_apex() From dual) Is Null
                                     Or a.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P655_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            nullDisplayValue: A + B
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 9
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P655_PARTY_CODE (
        type: popupLov
        label {
            label: Customer
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select GetPartyName(a.PartyCode) d, a.PartyCode r
                  From CCInvoice a
                 Where ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                 Group By a.PartyCode
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: Select a customer
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 5
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Switchable — populated from invoiced parties, so only real customers appear.
        }
    )

    pageItem P655_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back-to-dash (
        buttonName: BACKTODASH
        label: Sales Command Centre
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 653
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

