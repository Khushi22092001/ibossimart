page 655 (
    name: Customer Sales Analysis
    alias: CUSTOMER-SALES-ANALYSIS
    title: Customer Sales Analysis
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            CUSTOMER SALES ANALYSIS (HSPL) — one customer for the period.
            Value = SUM(CCInvoiceDetail.Amount); tax pre-aggregated to (Tno,Sno).
            GSTIN is GetPartyAttributeValue(PartyCode,'GSTINNO') — the only GSTIN
            attribute code corroborated in this application ('GSTNO' is not one) —
            falling back to "Not on file". LOCATION arrives inherited and live;
            COMPANY arrives hidden. Item views drill to Item Analysis carrying the
            customer + location forward. Read-only. Back returns to 653.
            ```
    }

    region command-header (
        name: Customer Sales Analysis
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-sales-head">'
                  || '<div class="ds-sales-head-eyebrow">Customer &middot; Sales Intelligence</div>'
                  || '<h1 class="ds-sales-head-title">'
                     || apex_escape.html(nvl(GetPartyName(:P655_PARTY_CODE),'Select a customer')) || '</h1>'
                  || '<div class="ds-sales-head-sub">Everything the commercial book holds about '
                     || 'this customer over the selected period.</div>'
                  || '<div class="ds-sales-head-context">'
                  || '<span class="ds-chip"><span class="fa fa-calendar ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Period</span><b>'
                     || apex_escape.html(:P655_FROMDATE) || ' &ndash; ' || apex_escape.html(:P655_TODATE) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-map-marker ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Location</span><b>'
                     || apex_escape.html(nvl(GetLocationName(:P655_LOCATION),'All locations')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-id-card-o ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">GSTIN</span><b>'
                     || apex_escape.html(nvl(GetPartyAttributeValue(:P655_PARTY_CODE,'GSTINNO'),'Not on file')) || '</b></span>'
                  || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                          Then '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                               || '<span class="ds-chip-k">Panel</span><b>'
                               || apex_escape.html((Select GetUserPanelAB_apex() From dual)) || ' (enforced)</b></span>'
                          Else '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                               || '<span class="ds-chip-k">Panel</span><b>'
                               || apex_escape.html(nvl(:P655_PANEL,'A + B')) || '</b></span>' End
                  || '</div></div>' As HEAD
                From dual
                ```
            pageItemsToSubmit: [
                P655_FROMDATE
                P655_TODATE
                P655_PARTY_CODE
                P655_LOCATION
                P655_PANEL
            ]
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
            cssClasses: ds-sales-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Header unavailable.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region doctype-chart (
        name: Sales by Document Type
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nvl(dt.DocTypeName, a.DocTypeCode) DOCTYPE,
                       Round(Sum(b.Amount)/100000,2) VALUE_LAC
                  From CCInvoice a Join CCInvoiceDetail b On b.TNo = a.TNo
                  Left Join DocType dt On dt.DocTypeCode = a.DocTypeCode
                 Where a.CCInvoiceDate >= to_date(:P655_FROMDATE,'DD-MM-RRRR')
                   And a.CCInvoiceDate <  to_date(:P655_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P655_PANEL   Is Null Or a.Panel        = :P655_PANEL
                   )
                   And (
                       :P655_COMPANY Is Null Or a.CompanyCode  = :P655_COMPANY
                   )
                   And (
                       :P655_LOCATION Is Null Or a.LocationCode = :P655_LOCATION
                   )
                   And a.PartyCode = :P655_PARTY_CODE
                 Group By nvl(dt.DocTypeName, a.DocTypeCode)
                Having Sum(b.Amount) <> 0
                 Order By 2 Desc
                ```
            pageItemsToSubmit: [
                P655_FROMDATE
                P655_TODATE
                P655_PARTY_CODE
                P655_LOCATION
                P655_PANEL
                P655_COMPANY
            ]
        }
        layout {
            sequence: 40
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 300
        }
        messages {
            whenNoDataFound: No sales to this customer by document type.
        }

        series dt (
            name: Rs Lac
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: DOCTYPE
                value: VALUE_LAC
            }
        )

    )

    region filter-bar (
        name: Filters
        type: staticContent
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
            cssClasses: ds-dash-filters
        }
        advanced {
            htmlDomId: p655Filters
        }
    )

    region item-chart (
        name: Item-wise Sales to this Customer
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select ITEM_NAME, ITEM_CODE, VALUE_LAC From (
                  Select nvl(Max(i.ItemName), b.ItemCode) ITEM_NAME, b.ItemCode ITEM_CODE,
                         Round(Sum(b.Amount)/100000,2) VALUE_LAC
                    From CCInvoice a Join CCInvoiceDetail b On b.TNo = a.TNo
                    Left Join Item i On i.ItemCode = b.ItemCode
                   Where a.CCInvoiceDate >= to_date(:P655_FROMDATE,'DD-MM-RRRR')
                     And a.CCInvoiceDate <  to_date(:P655_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (
                         :P655_PANEL   Is Null Or a.Panel        = :P655_PANEL
                     )
                     And (
                         :P655_COMPANY Is Null Or a.CompanyCode  = :P655_COMPANY
                     )
                     And (
                         :P655_LOCATION Is Null Or a.LocationCode = :P655_LOCATION
                     )
                     And a.PartyCode = :P655_PARTY_CODE
                   Group By b.ItemCode
                  Having Sum(b.Amount) > 0
                   Order By Sum(b.Amount) Desc)
                 Where Rownum <= 12
                 Order By VALUE_LAC
                ```
            pageItemsToSubmit: [
                P655_FROMDATE
                P655_TODATE
                P655_PARTY_CODE
                P655_LOCATION
                P655_PANEL
                P655_COMPANY
            ]
        }
        layout {
            sequence: 50
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 320
        }
        messages {
            whenNoDataFound: No item sales to this customer.
        }

        series itm (
            name: Sales Value (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: ITEM_NAME
                value: VALUE_LAC
            }
            link {
                type: redirectThisApp
                target: {
                    page: 656
                    items: {
                        P656_ITEM_CODE: &ITEM_CODE.
                        P656_FROMDATE: &P655_FROMDATE.
                        P656_TODATE: &P655_TODATE.
                        P656_COMPANY: &P655_COMPANY.
                        P656_LOCATION: &P655_LOCATION.
                        P656_PANEL: &P655_PANEL.
                        P656_PARTY_CODE: &P655_PARTY_CODE.
                    }
                    clearCache: 656
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region item-summary (
        name: Item Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.ItemCode As ITEMCODE,
                       nvl(Max(i.ItemName), b.ItemCode) As ITEM_NAME,
                       b.ItemSpecificationCode As SPEC,
                       Max(i.MeasuringUnitCode1) As UOM,
                       Count(Distinct a.TNo) As INVOICES,
                       Sum(b.Quantity1) As QTY1,
                       Sum(b.Amount) As SALES_VALUE,
                       Case When Sum(b.Quantity1) > 0
                            Then Round(Sum(b.Amount)/Sum(b.Quantity1),2) End As AVG_RATE
                  From CCInvoice a
                  Join CCInvoiceDetail b On b.TNo = a.TNo
                  Left Join Item i On i.ItemCode = b.ItemCode
                 Where a.CCInvoiceDate >= to_date(:P655_FROMDATE,'DD-MM-RRRR')
                   And a.CCInvoiceDate <  to_date(:P655_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P655_PANEL   Is Null Or a.Panel        = :P655_PANEL
                   )
                   And (
                       :P655_COMPANY Is Null Or a.CompanyCode  = :P655_COMPANY
                   )
                   And (
                       :P655_LOCATION Is Null Or a.LocationCode = :P655_LOCATION
                   )
                   And a.PartyCode = :P655_PARTY_CODE
                 Group By b.ItemCode, b.ItemSpecificationCode
                 Order By Sum(b.Amount) Desc
                ```
            pageItemsToSubmit: [
                P655_FROMDATE
                P655_TODATE
                P655_PARTY_CODE
                P655_LOCATION
                P655_PANEL
                P655_COMPANY
            ]
        }
        layout {
            sequence: 60
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No items for this customer in this period.
        }
        advanced {
            savedReportMappingIdentifier: 28086904980250108
        }

