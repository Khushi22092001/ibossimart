            valueRequired: true
        }
    )

    pageItem P258_TRANSPORTER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Transporter
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.PartyName d,
                a.PartyCode r
                From Party a
                Where exists(
                   Select
                      aa.TransporterCode
                   From OurFreightRateList aa
                   Where a.PartyCode = aa.TransporterCode
                )
                Order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @transporter-contract-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--preTextBlock
            ]
            width: 30
        }
    )

    pageItem P258_VEHICLEGROUP (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vehicle Group
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
