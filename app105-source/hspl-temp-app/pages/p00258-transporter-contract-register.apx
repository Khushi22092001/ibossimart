                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.VehicleGroupName d,
                a.VehicleGroupCode r
                From VehicleGroup a
                Where exists(
                   Select
                      aa.VehicleGroupCode
                   From OurFreightRateList aa
                   Where aa.VehicleGroupCode = a.VehicleGroupCode
                )
                Order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @transporter-contract-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
                t-Form-fieldContainer--large
                t-Form-fieldContainer--preTextBlock
            ]
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 120
            region: @transporter-contract-register
