page 258 (
    name: Transporter Contract Register
    alias: TRANSPORTER-CONTRACT-REGISTER
    title: Transporter Contract Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region transport-contract-register-report (
        name: Transport Contract Register Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.OurFreightRateListNo) SerialNo,
                co.CompanyName,
                a.OurFreightRateListNo,
                a.OurFreightRateListDate,
                c.LocationName,
                d.DoctypeName,
                e.PartyName,
                fr.FreightRateListNo,
                f.ItemName,
                g.VehicleGroupName,
                h.PartyName as Transporter,
                sl.SourceLocationName,
                dl.DestinationLocationName,
                fb.FreightBasisName,
                round(b.FreightRate,2) as FreightRate,
                r.RouteName,
                round(b.Quantity1,3) as Quantity,
                b.DistanceInKm,
                a.Creator
                From OurFreightRateList a, OurFreightRateListDetail b, Location c,Doctype d, Party e, Item f,
                VehicleGroup g, Party h, SourceLocation sl, DestinationLocation dl, FreightBasis fb, FreightRateList fr, Company co,Route r
                Where a.Tno = b.Tno(+)
                and a.LOcationCode = c.LocationCode(+)
                and a.DoctypeCode = d.DoctypeCode(+)
                and a.PartyCode = e.PartyCode(+)
                and a.ItemCode = f.ItemCode(+)
                and a.VehicleGroupCode = g.VehicleGroupCode(+)
                and a.TransporterCode = h.PartyCode(+)
                and b.SourceLocationTno = sl.Tno(+)
                and b.DestinationLocationTno = dl.Tno(+)
                and b.FreightBasisCode = fb.FreightBasisCode(+)
                and a.FreightRateListTno = fr.Tno(+)
                and a.CompanyCode = co.CompanyCode(+)
                and b.RouteCode = r.RouteCode(+)
                and  (:P258_COMPANY is Null Or Instr (':' || :P258_COMPANY || ':' , ':' || a.CompanyCode|| ':') > 0)
                and a.OurFreightRateListDate between :P258_FROMDATE and :P258_TODATE
                and (:P258_TRANSPORTER is Null Or Instr (':' || :P258_TRANSPORTER || ':' , ':' || h.Partycode|| ':') > 0)
                and (:P258_SOURCE is Null Or Instr (':' || :P258_SOURCE|| ':' , ':' || sl.SourceLocationCode|| ':') > 0)
                and (:P258_DESTINATION is Null Or Instr (':' || :P258_DESTINATION || ':' , ':' || dl.DestinationLocationCode|| ':') > 0)
                and (:P258_FREIGHTCONTRACT is Null Or Instr (':' || :P258_FREIGHTCONTRACT || ':' , ':' || fr.Tno|| ':') > 0)
                and (:P258_VEHICLEGROUP is Null Or Instr (':' || :P258_VEHICLEGROUP || ':' , ':' || g.VehicleGroupCode|| ':') > 0)
                and (:P258_PARTY is Null Or Instr (':' || :P258_PARTY || ':' , ':' || e.PartyCode|| ':') > 0)
                ;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                   
                ```
        }
        advanced {
            savedReportMappingIdentifier: 28372203787120221
        }

