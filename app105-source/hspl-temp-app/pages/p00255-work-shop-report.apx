    region work-shop-pending (
        name: Work Shop Pending
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                a.*,
                b.LocationName as Location
                From (Select
                    Rownum as "Serial No",
                    a.MaintenanceRequestDate as "Maintenance Request Date",
                    ( to_date(:P255_DATE,'dd-mm-rrrr') - a.MaintenanceRequestDate )as "No of Days",
                    h.VehicleNo as "Vehicle No",
                    b.EquipmentID as "Equipment ID",
                    null as "TP",
                    null as "Driver Name",
                    GetEquipmentLocationcode(b.Tno,( to_date(:P255_DATE,'dd-mm-rrrr'))) as LocationName,
                    nvl(a.NotificationShortText,a.NotificationLongText) as "Complaints",
                    Case when g.JobCardNo is null then null 
                    end as "Status",
                    GetemployeeName(g.MechnicCode) as "Mechanic"
                from MaintenanceRequest a, Equipment b ,EquipmentMaintenanceOrder c, 
                     MaintenanceOrderCompletion d, Location e, JobOrder f ,
                     JobCard g, Companyvehicle h
                Where a.Equipmenttno = b.tno (+)
                    and a.Tno = c.MaintenanceRequestTno(+) 
                    and c.Tno = d.EquipmentMaintenanceOrderTno(+)
                    and c.LocationCode = e.LocationCode (+)
                    and c.Tno = f.EquipmentMaintenanceOrderTno(+)
                    and c.Tno = g.EquipmentMaintenanceOrderTno(+)
                    and b.Tno = h.ModuleTno(+)
                    and (:P255_EQUIPMENTGROUP is Null Or Instr (':' || :P255_EQUIPMENTGROUP || ':' , ':' || b.EquipmentGroupCode || ':') > 0)
                    and (:P255_LOCATION is Null Or Instr (':' || :P255_LOCATION || ':' , ':' || e.LocationCode || ':') > 0)
                    and g.JobCardNo is null
                    and d.Tno is null) a, location b
                    Where a.LocationName = b.LocationCode(+)
                    ;
                ```
            pageItemsToSubmit: P255_DATE
        }
        layout {
            sequence: 40
            slot: body
        }
