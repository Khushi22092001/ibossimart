page 321 (
    name: Open Billed Detail
    alias: OPEN-BILLED-DETAIL
    title: Open Billed Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region open-billed-detail (
        name: Open Billed Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    row_number() over(order by a.GPDate) SerialNo,
                    a.Tno,
                	 a.CompanyCode,
                	 a.LRNo,
                    a.LRDate,
                    a.GPNo,
                    a.GPDate,
                    j.PartyName,
                    k.TransporterName,
                    a.VehicleNo,
                    m.TransportAreaName,
                    f.SourceLocationName,
                    g.DestinationLocationName,
                    i.DOExpensesNo,
                    i.DOExpensesDate,
                    a.Quantity1,
                    h.NetFreightRate,
                    round(nvl(a.Quantity1,0)* nvl(h.NetFreightRate,0), 2) as Amount
                From LR a, LoadingOrder b, DeliveryOrderDetail c, DeliveryOrder d, SourceLocation f, DestinationLocation g, DOExpensesDetail h,
                    DOExpenses i, Party j, Transporter k, CompanyVehicle l, TransportArea m, DocumentStatusDetail dsd
                Where a.LoadingOrderTno = b.Tno
                	and b.DeliveryOrderTno = c.Tno
                	and b.DeliveryOrderSno = c.Sno
                	and c.Tno = d.Tno
                   and a.SourceLocationTno = f.Tno
                   and a.DestinationLocationTno = g.Tno
                   and c.Tno = h.DeliveryOrderTno(+)
                   and c.Sno = h.DeliveryOrderSno(+)
                   and GetDOExpensesTno(c.Tno, c.Sno, nvl(a.GPDate, a.LRDate)) = h.Tno(+)
                   and h.Tno = i.Tno(+)
                   and a.PartyCode = j.PartyCode(+)
                   and a.TransporterCode = k.TransporterCode(+)
                   and a.VehicleNo = l.CompanyVehicleNo(+)
                   and l.TransportAreaCode = m.TransportAreaCode(+)
                   and a.Tno = dsd.ModuleTno
                   and dsd.DocumentStatusCode = 'ACTIVE'
                   and a.VehicleGroupCode = 'SELF'
                	and d.DocTypeCode = 'OPEN'
                   and exists(
                		Select
                			aa.Tno
                		From CompanyVehicle aa, Equipment bb
                		Where aa.ModuleTno = bb.Tno
                			and bb.EquipmentGroupCode = 'CT'
                			and aa.CompanyVehicleNo = a.VehicleNo
                		)
                	and exists(
                		Select
                			aa.Tno
                		From ServiceBillLR aa
                		Where aa.LRTno = a.Tno
                   )
                  and nvl(a.GPDate, a.LRDate) between :P321_FROMDATE and :P321_TODATE
                  and a.CompanyCode = :P321_COMPANYCODE
                  and (:P321_VEHICLENO is Null Or Instr (':' || :P321_VEHICLENO || ':' , ':' || a.VehicleNo || ':') > 0)
                  and (:P321_VEHICLENO2 is null
                       or exists(
                         Select
                            aa.VehicleNo
                          From VPVehicleNo aa
                          Where aa.VehicleNo = a.VehicleNo
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P321_VEHICLETYPE is null
                       or exists(
                         Select
                            aa.VehicleTypeCode
                          From VPVehicleType aa
                          Where aa.VehicleTypeCode = l.VehicleTypeCode
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P321_TRANSPORTAREA is null
                       or exists(
                         Select
                            aa.TransportAreaCode
                          From VPTransportArea aa
                          Where aa.TransportAreaCode = l.TransportAreaCode
                              and aa.Creator = :APP_USER
                       )
                   )
                		
                ```
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 110199442707607804
        }

