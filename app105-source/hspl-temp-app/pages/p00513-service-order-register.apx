        column JOBORDERNO (
            type: plainText
            heading {
                heading: SERVICE ORDER NO
            }
            layout {
                sequence: 470
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:190px">#JOBORDERNO#</div>
