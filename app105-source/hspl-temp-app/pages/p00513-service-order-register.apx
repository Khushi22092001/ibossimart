    pageItem P513_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'JOBORDER'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @service-order-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P513_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      dt.DocTypeName d,
                      dt.DocTypeCode r
                From  ModulePrivilege a, ModulePrivilegeDocType b, DocType dt, BossUser bu, ModuleDocType md, ModuleDocTypeDetail mdd
                Where a.TNo = b.TNo(+)
                  and (b.DocTypeCode = dt.DocTypeCode or b.DocTypeCode is null)
                  and a.ModuleCode = md.ModuleCode
                  and md.TNo = mdd.TNo
                  and mdd.DocTypeCode = dt.DocTypeCode
                  and a.ModuleCode = 'JOBORDER'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                  and instr(':'||:P513_COMPANY||':',':'||a.CompanyCode||':') > 0
                Order by 1
                ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P513_COMPANY
            itemsToSubmit: P513_DOCTYPE
        }
        layout {
            sequence: 100
            region: @service-order-register
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Doc Type Name
        }
        validation {
            valueRequired: true
        }
    )

