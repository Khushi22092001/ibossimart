                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       Distinct
                       p.PartyName d,
                       p.PartyCode r
                From PurchaseOrder a, Party p
                Where a.PartyCode = p.PartyCode
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @service-order-register
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 74
            valuePlaceholder: Vendor Name
        }
    )

    pageItem P513_STATUS (
        type: selectList
        label {
            label: Status
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Active;ACTIVE,Non-Active;NONACTIVE,Canceled;CANCELED,Closed;CLOSED,Preparing;PREPARING,Prepared;PREPARED,Authorised;AUTHORISED,On Hold;ONHOLD,Approval;APPROVAL,Dept Approved;DEPTAPPROVED,Store Approval;STOREAPPROVED
            nullDisplayValue: --Select Status--
        }
        layout {
            sequence: 20
            region: @service-order-register
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P513_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @service-order-register
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: To Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P513_TODOLIST (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @service-order-register
            slot: regionBody
        }
        default {
            type: static
            staticValue: NO
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 190
            region: @service-order-register
            slot: regionBody
            column: 10
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P513_PONO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P513_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P513_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 44022431752300880
        }
    )

)

