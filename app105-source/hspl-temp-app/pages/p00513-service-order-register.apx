page 513 (
    name: Service Order Register
    alias: SERVICE-ORDER-REGISTER
    title: Service Order Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/poregister.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P27_FROMDATE').val());
              var toDate = new Date($('#P27_TODATE').val());
            
            var reportParams = 
                  '&P_COMPANY='+ $('#P27_COMPANY').val() + 
                  '&P_FROMDATE='+ $('#P27_FROMDATE').val() +  
                  '&P_TODATE=' + $('#P27_TODATE').val() +  
                  '&P_LOCATION=' +$('#P27_LOCATION').val() +  
                  '&P_STATUS=' +$('#P27_STATUS').val() + 
                  '&P_ITEM=' +$('#P27_ITEM').val() + 
                  '&P_ITEMSPECIFICATION=' +$('#P27_ITEMSPECIFICATION').val() + 
                  '&P_PARTYNAME=' +$('#P27_PARTYNAME').val() + 
                  '&P_DOCTYPE=' +$('#P27_DOCTYPE').val() + 
                  '&P_GRNSTATUS=' +$('#P27_GRNSTATUS').val() + 
                  '&P_PONO=' +$('#P27_PONO').val()
                  ;
             
                  
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              var reportURL = 'http://13.203.6.83:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            
            ```
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            .a-IRR-highlight {
              font-weight: bold !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region service-order-register (
        name: Service Order Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region service-order-report (
        name: Service Order Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by xxx.JOBORDERDate) SerialNo,
                      xxx.TNo,
                      xxx.SNo,
                      xxx.LocationName,
                      xxx.DocTypeName,
                      xxx.JOBORDERNo,
                      xxx.JOBORDERDate,
                      xxx.PartyName,
                      xxx.DeliveryDate as DeliveryDate,
                       XXX.DELIVERYDATE - TRUNC(SYSDATE)  AS DeliveryRemainingDays,
                      xxx.ItemCode,
                      xxx.MaterialDetail,
                      xxx.UOM,
                      round(xxx.Quantity1,3) as Quantity1,
                      xxx.UOM2,
                      round(xxx.Quantity2,3) as Quantity2,
                      --xxx.AgentName,
                      XXX.WITHOUTDISCOUNTRATE,
                      XXX.DISCOUNTRATE,
                      xxx.Rate,
                      round(xxx.Amount,2) as Amount,
                      xxx.CGST,
                      xxx.SGST,
                      xxx.IGST,
                      xxx.TCS,
                      round(xxx.FooterAmount,2) as FooterAmount,
                      round((xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS)),2) as OtherAmount,
                      round(xxx.TotalAmount,2) as TotalAmount,
                    --   round(xxx.GRNReceivedQty,3) as GRNReceivedQty,
                    --   round(xxx.GRNReceivedQty2,3) as GRNReceivedQty2,
                    --   round(xxx.WBAcceptedWeight,3) as WBAcceptedWeight,
                    --   round(xxx.WBNetWeight,3) as WBNetWeight,
                    --   round(xxx.balanceQty,3) as BalanceQty,
                      xxx.DocumentStatusCode,
                      xxx.DocStatus,
                      --xxx.FreightTypeCode,
                      --xxx.GRNStatus,
                      --xxx.POStatus,
                      xxx.Creator,
                      xxx.CreationTime,
                      'Attachment' as Attachment,
                      xxx.Description,
                      xxx.JobTypeName,
                      xxx.SAC,
                      xxx.StartDate,
                      xxx.ExpiaryDate,
                      xxx.ReferenceText,
                      xxx.Remark,
                      xxx.RepairingRequisitionsNo
                From (
                Select
                      xx.TNo,
                      xx.SNo,
                      xx.LocationName,
                      xx.DocTypeName,
                      xx.JOBORDERNo,
                      xx.JOBORDERDate,
                      xx.PartyName,
                      xx.DeliveryDate,
                      xx.ItemCode,
                      xx.MaterialDetail,
                      xx.UOM,
                      xx.Quantity1,
                      xx.UOM2,
                      xx.Quantity2,
                      --xx.AgentName,
                      XX.WITHOUTDISCOUNTRATE,
                      XX.DISCOUNTRATE,
                      xx.Rate,
                      xx.Amount,
                      sum(xx.CGST)CGST,
                      sum(xx.SGST)SGST,
                      sum(xx.IGST)IGST,
                      sum(xx.TCS)TCS,
                      xx.FooterAmount,
                      xx.TotalAmount,
                    --   xx.GRNReceivedQty,
                    --   xx.GRNReceivedQty2,
                    --   xx.WBAcceptedWeight,
                    --   xx.WBNetWeight,
                    --   xx.balanceQty,
                      xx.DocumentStatusCode,
                      xx.DocStatus,
                      --xx.FreightTypeCode,
                      --xx.GRNStatus,
                      --xx.POStatus,
                      xx.Creator,
                      xx.CreationTime,
                      xx.Description,
                      xx.JobTypeName,
                      xx.SAC,
                      xx.StartDate,
                      xx.ExpiaryDate,
                      xx.ReferenceText,
                      xx.Remark,
                      xx.RepairingRequisitionsNo
                From (
                Select
                      a.TNo,
                      b.SNo,
                      l.LocationName,
                      d.DocTypeName,
                      a.JOBORDERNo,
                      a.JOBORDERDate,
                      p.PartyCode,
                      p.PartyName,
                      a.DeliveryDate,
                      e.ItemCode,
                      e.ItemName,
                      ee.ItemSpecificationName,
                      e.ItemName||' ( '||ee.ItemSpecificationName||' )' as MaterialDetail,
                      mu.MeasuringUnitName as UOM,
                      b.Quantity1,
                      e.MeasuringUnitCode2 as UOM2,
                      b.Quantity2,
                      --GetPartyName(a.AgentCode) AgentName,
                      B.WITHOUTDISCOUNTRATE,
                      B.DISCOUNTRATE,
                      B.Rate,
                      b.Amount,
                      Nvl(Decode(c.FooterHeadCode,'.CGST.',c.FooterValue),0) as CGST,
                      Nvl(Decode(c.FooterHeadCode,'.SGST.',c.FooterValue),0) as SGST,
                      Nvl(Decode(c.FooterHeadCode,'.IGST.',c.FooterValue),0) as IGST,
                      Nvl(Decode(c.FooterHeadCode,'.TCS.',c.FooterValue),0) as TCS,
                      b.FooterAmount,
                      b.TotalAmount,
                    --   g.GRNReceivedQuantity1 as GRNReceivedQty,
                    --   g.GRNReceivedQuantity2 as GRNReceivedQty2,
                    --   g.WBAcceptedWeight as WBAcceptedWeight,
                    --   g.WBNetWeight as WBNetWeight,
                    --   b.Quantity1 - NVL(g.GRNReceivedQuantity1,0) as balanceQty,
                      dsd.DocumentStatusCode,
                      case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                           When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When dsd.DocumentStatusCode = 'APPROVAL' Then 'APPROVAL'
                           When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End as DocStatus,
                      --ft.FreightTypeName as FreightTypeCode,
                --      Case When g.GRNReceivedQuantity1 >= b.quantity1 - (b.quantity1 * b.lowertolerancepercent) / 100 Then 'DONE'--  g.GRNReceivedQuantity1 Then 'DONE'
                --           --When b.Quantity1 > g.GRNReceivedQuantity1 Then 'PARTIAL'
                --	       When g.GRNReceivedQuantity1 is null or  b.Quantity1 > g.GRNReceivedQuantity1 Then 'PENDING'
                --      End as GRNStatus,
                      ---nvl(decode(poc.JOBORDERTno,a.TNo,'SHORT-CLOSE'),'OPEN') as POStatus,
                      'Attachment' as Attachment,
                      'Details' as Property,
                      'JOBORDER' as Module,
                      bue.EmployeeName||'( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      b.Description,
                      jt.JobTypeName,
                      jt.SACCode SAC,
                      a.AMCStartDate StartDate,
                       a.AMCEndDate ExpiaryDate,
                       a.ReferenceText,
                       a.Remark,
                       a.RepairingRequisitionsNo
                From  JOBORDER a, JOBORDERDetail b, JOBORDERDetailFooter c, Location l, DocType d, Party p,  Item e, ItemSpecification ee, MeasuringUnit mu, BossUser bu, Employee bue,
                    --   (Select
                    --         b.ItemCode,
                    --         b.ItemSpecificationCode,
                    --         a.JOBORDERTNo,
                    --         sum(b.ReceivedQuantity1) as GRNReceivedQuantity1,
                    --         sum(b.ReceivedQuantity2) as GRNReceivedQuantity2,
                    --         sum(w.AcceptedWeight) as WBAcceptedWeight,
                    --         sum(w.NetWeight) as WBNetWeight
                    --   From  GRN a, GRNDetail b, Weighment w
                    --   Where a.TNo = b.TNo
                    --     and a.JOBORDERTNo is not null
                    --     and a.WeighmentTNo = w.TNo(+)
                    --   Group By b.ItemCode,
                    --         b.ItemSpecificationCode,
                    --         a.JOBORDERTNo
                    --   ) g, 
                      DocumentStatusDetail dsd ,
                      ---JOBORDERClose poc, 
                      --FreightType ft,
                      JobType jt
                Where a.TNo = b.TNo(+)
                  and b.TNo = c.TNo(+)
                  and b.SNo = c.SNo(+)
                  and a.LocationCode = l.LocationCode(+)
                  and a.DocTypeCode = d.DocTypeCode(+)
                  and a.PartyCode = p.PartyCode(+)
                  and e.TNo = ee.TNo(+)
                  and b.ItemCode = e.ItemCode(+)
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and e.MeasuringUnitCode1 = mu.MeasuringUnitCode(+)
                  ---and e.ItemClassificationCode = 'MATERIAL'
                --   and b.TNo = g.JOBORDERTNo(+)
                --   and b.ItemCode = g.ItemCode(+)
                --   and b.ItemSpecificationCode = g.ItemSpecificationCode(+)
                  and a.TNo = dsd.ModuleTno(+)
                  ---and a.TNo = poc.JOBORDERTNo(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)	
                  and b.JobTypeCode = jt.JobTypeCode(+)
                  --and a.FreightTypeCode = ft.FreightTypeCode(+)
                --   and (:P513_TODOLIST = 'YES' OR :P513_NEXTPROCESS = 'YES' OR 
                  --and to_date(a.JOBORDERDate) between NVL(:P513_FROMDATE,ADD_MONTHS(TRUNC(SYSDATE),-6)) and NVL(:P513_TODATE,TRUNC(SYSDATE)) 
                  and to_date(a.JobOrderDate) Between :P513_FROMDATE and :P513_TODATE
                --   and (:P513_TODOLIST = 'YES' OR :P513_NEXTPROCESS = 'YES' OR 
                  and (:P513_COMPANY IS NULL OR instr(':'||:P513_COMPANY||':',':'||a.CompanyCode||':') > 0)
                --   and (:P513_TODOLIST = 'YES' OR :P513_NEXTPROCESS = 'YES' OR 
                  and (:P513_LOCATION IS NULL OR instr(':'||:P513_LOCATION||':',':'||a.LocationCode||':') > 0)
                --   and (:P513_TODOLIST = 'YES' OR :P513_NEXTPROCESS = 'YES' OR 
                  and ( :P513_DOCTYPE IS NULL OR instr(':'||:P513_DOCTYPE||':',':'||a.DocTypeCode||':') > 0)
                  and ( :P513_PARTYNAME IS NULL OR instr(':'||:P513_PARTYNAME||':',':'||a.PartyCode||':') > 0 ) 
                  and ( :P513_ITEM IS NULL OR instr(':'||:P513_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P513_ITEMSPECIFICATION IS NULL OR instr(':'||:P513_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                  --and nvl(decode(poc.JOBORDERTno,a.TNo,'SHORT-CLOSE'),'OPEN') like nvl(:P513_POSTATUS,'%')
                 /*Case When g.GRNReceivedQuantity1 >= b.quantity1 - (b.quantity1 * b.lowertolerancepercent) / 100 Then 'DONE'--  g.GRNReceivedQuantity1 Then 'DONE'
                           --When b.Quantity1 > g.GRNReceivedQuantity1 Then 'PARTIAL'
                	       When g.GRNReceivedQuantity1 is null or  b.Quantity1 > g.GRNReceivedQuantity1 Then 'PENDING'
                      End like nvl(:P513_GRNSTATUS,'%')
                */
                /*  and Case When b.Quantity1 <= g.GRNReceivedQuantity1 Then 'DONE'
                           When b.Quantity1 > g.GRNReceivedQuantity1 Then 'PARTIAL'
                	       When g.GRNReceivedQuantity1 is null Then 'PENDING'
                      End like nvl(:P513_GRNSTATUS,'%')
                */
                  -- 22-APR-2025
                  --and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                           When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When dsd.DocumentStatusCode = 'APPROVAL' Then 'APPROVAL'
                           When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End  like nvl(:P513_STATUS,'%')
                  and a.JOBORDERNo like nvl(:P513_JONO,'%')
                  )xx
                --  where xx.GRNSTATUS like nvl(:P513_GRNSTATUS,'%')
                Group By 
                        xx.TNo,
                      xx.SNo,
                      xx.LocationName,
                      xx.DocTypeName,
                      xx.JOBORDERNo,
                      xx.JOBORDERDate,
                      xx.PartyName,
                      xx.DeliveryDate,
                      xx.ItemCode,
                      xx.MaterialDetail,
                      xx.UOM,
                      xx.Quantity1,
                      xx.UOM2,
                      xx.Quantity2,
                      --xx.AgentName,
                      XX.WITHOUTDISCOUNTRATE,
                      XX.DISCOUNTRATE,
                      xx.Rate,
                      xx.Amount,
                      xx.FooterAmount,
                      xx.TotalAmount,
                    --   xx.GRNReceivedQty,
                    --   xx.GRNReceivedQty2,
                    --   xx.WBAcceptedWeight,
                    --   xx.WBNetWeight,
                    --   xx.balanceQty,
                      xx.DocumentStatusCode,
                      xx.DocStatus,
                      --xx.FreightTypeCode,
                      --xx.GRNStatus,
                      --xx.POStatus,
                      xx.Creator,
                      xx.CreationTime,
                      xx.Description,
                      xx.JobTypeName,
                      xx.SAC,
                      xx.StartDate,
                      xx.ExpiaryDate,
                      xx.ReferenceText,
                      xx.Remark,
                      xx.RepairingRequisitionsNo
                )xxx
                --where 
                -- (:P513_TODOLIST='NO' OR  (:P513_TODOLIST='YES' AND EXISTS ( SELECT 1 FROM ONTHETABLE_APEX YY WHERE YY.TNO=XXX.TNO) ))
                -- AND ( :P513_NEXTPROCESS='NO' OR (:P513_NEXTPROCESS = 'YES' AND (  getdocumentstatuscode('JOBORDER',XXX.TNO)='ACTIVE'
                --                                     AND  NOT EXISTS (Select 1 From MaterialIn AA Where AA.JOBORDERtno = XXX.TNO)
                --                                 )
                -- )
                                                
                --  )
                --  and 
                -- ( nvl(:P513_REMAININGDELIVERYDAYS,0) = 0 or XXX.DELIVERYDATE - TRUNC(SYSDATE) <= nvl(:P513_REMAININGDELIVERYDAYS,0) )
                ```
        }
