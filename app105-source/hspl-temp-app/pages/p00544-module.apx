page 544 (
    name: Module
    alias: MODULE
    title: Module
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region module (
        name: Module
        type: tree
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case when connect_by_isleaf = 1 then 0
                            when level = 1             then 1
                            else                           -1
                       end as status, 
                       level, 
                       "MYBOXLABEL" as title, 
                       null as icon, 
                       "MYBOXKEY" as value, 
                       null as tooltip, 
                       null as link 
                from "HSPL"."MYBOXTREE"
                start with "PARENTKEY"='ROOT' OR PARENTKEY is null
                connect by prior "MYBOXKEY" = "PARENTKEY"
                order siblings by "MYBOXLABEL"
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        settings {
            nodeLabelColumn: TITLE
            nodeValueColumn: VALUE
            hierarchy: notComputed
            nodeStatusColumn: STATUS
            hierarchyLevelColumn: LEVEL
            linkColumn: LINK
            iconCssClassColumn: ICON
            defaultIconCssClass: icon-tree-folder
            iconTypeCssClass: a-Icon
        }
    )

    button contract-all (
        buttonName: CONTRACT_ALL
        label: Collapse All
        layout {
            sequence: 10
            region: @module
            slot: create
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button expand-all (
        buttonName: EXPAND_ALL
        label: Expand All
        layout {
            sequence: 10
            region: @module
            slot: create
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction contract-all (
        name: CONTRACT_ALL
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @contract-all
        }

        action native-tree-collapse (
            action: collapseTree
            affectedElements {
                selectionType: region
                region: @module
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction expand-all (
        name: EXPAND_ALL
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @expand-all
        }

        action native-tree-expand (
            action: expandTree
            affectedElements {
                selectionType: region
                region: @module
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

