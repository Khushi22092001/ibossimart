page 8 (
    name: Account Master
    alias: ACCOUNT-MASTER
    title: Account Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region account-master (
        name: Account Master
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region account-master-report (
        name: Account Master Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by a.PartyCode) SerialNo,
                      c.companyname,
                      a.partyCode,
                      a.PartyName,
                      a.PrintName,
                      a.PartyShortName,
                      pt.PartyTypeName,
                      p.PartyName as ParentGroup,
                      pow.PartyName as ParentOtherWise,
                      a.TaxRegistrationTypeCode,
                      a.OwnerName,
                      a.IsCompany,
                      b.BankName,
                      a.PartyBankAccountNo,
                      a.BasicNature,
                      e.EmployeeName||' ( '||e.EmployeeID||' )' as Employee,
                      dp.DepartmentName,
                      dg.DesignationName,
                      l.LocationName,
                      a.OfficeAddress1||' '||a.OfficeAddress2||' '||a.OfficeAddress3||' '||a.OfficeAddress4 as OfficeAddress,
                      oc.CityName as OfficeCityName,
                      os.StateName as OfficeStateName,
                      a.OfficePinCode,
                      a.OfficePhoneNo,
                      a.OfficeMobileNo,
                      a.OfficeEMail,
                      a.WorksAddress1||' '||a.WorksAddress2||' '||a.WorksAddress3||' '||a.WorksAddress4 as WorkAddress,
                      wc.CityName as WorkCityName,
                      ws.StateName as WorkStateName,
                      a.WorksPinCode,
                      a.WorksPhoneNo,
                      a.WorksMobileNo,
                      a.WorksEMail,
                      bue.EmployeeName||' ( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      Getpartyattributevalue(a.PartyCode,'GSTINNO') as GSTNO,
                      Getpartyattributevalue(a.PartyCode,'PANNO') as PANNO,
                      Getpartyattributevalue(a.PartyCode,'FOSCOS') as FOSCOS,
                      a.Distance,
                      a.TDSApplicable,
                      td.TDSPayeeCategoryName,
                      t.TDSNatureName,
                      bou.BossUserName as ResponsibleUser,
                      a.MSME,
                      X.MSMERegistrationNo,
                      X.DocumentAttachedStatus,
                      rbe.EmployeeName as ResponsibleEmployeeName,
                      tr.TradetypeName,
                      bn.BusinessNatureName,
                      it.IndustrytypeName,
                      a.QuarterlyVerificationUserCode as UserRepForQuarterlyVerification,
                      a.VendorClass,
                      Decode(dsd.ModuleTno,null,'STATUS',dsd.DocumentStatusCode) as Status
                From  Party a, PartyType pt, Party p, Employee e, Department dp, Designation dg, Location l, City oc, State os, City wc, State ws,
                      Bossuser bu, Employee bue, Employee rbe, Bank b, Party pow, PartyCompany  pc, BossUser bou, Company c, TDSPayeecategory td, TDSNature t,
                      TradeType tr, BusinessNature bn, IndustryType it, DocumentStatusDetail dsd,
                      (
                         Select
                            a.Tno,
                            b.Sno,
                            GetPartyAttributeValue(a.PartyCode, 'MSMEREGISTRATIONNO') as MSMERegistrationNo,
                            decode(c.Tno, null, 'NOT ATTACHED', 'ATTACHED') as DocumentAttachedStatus
                            From Party a, PartyAttributeDetail b, ModuleAttachment c
                            Where a.Tno = b.Tno
                            and b.Tno = c.ModuleTno(+)
                            and b.Sno = c.ModuleSno(+)
                           -- and a.PartyCode = '6006'
                            and  b.AttributeCode = 'MSMEREGISTRATIONNO'
                      ) x
                Where a.PartyTypeCode = pt.PartyTypeCode(+)
                  and a.ParentCode = p.PartyCode(+)
                  and a.PartyCode = pc.PartyCode(+)
                  and pc.Companycode = c.companycode(+)
                  and a.EmployeeCode = e.EmployeeCode(+)
                  and GetEmployeeDepartmentCode(e.EmployeeCode,sysdate) = dp.DepartmentCode(+)
                  and GetEmployeeDesignationCode(e.EmployeeCode,sysdate) = dg.DesignationCode(+)
                  and GetEmployeeLocationCode(e.EmployeeCode,sysdate) = l.LocationCode(+)
                  and a.OfficeCityCode = oc.CityCode(+)
                  and a.OfficeStateCode = os.StateCode(+)
                  and a.WorksCityCode = wc.CityCode(+)
                  and a.WorksStateCode = ws.StateCode(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)
                  and a.PartyBankCode = b.bankCode(+)
                  and a.ParentCodeOtherWise = pow.PartyCode(+)
                  and a.TNo = pc.TNo(+)
                  and a.ResponsibleBossUserCode = bou.BossUserCode(+)
                  and a.TDSPayeeCategoryCode = td.TDSPayeeCategoryCode(+)
                  and a.TDSNatureCode = t.TDSNatureCode(+)
                  and a.Tno = x.Tno(+)
                  and bou.Employeecode = rbe.Employeecode(+)
                  and a.TradeTypeCode = tr.TradeTypeCode(+)
                  and a.BusinessNatureCode = bn.BusinessNatureCode(+)
                  and a.IndustryTypeCode = it.IndustryTypeCode(+)
                  and a.Tno = dsd.ModuleTno(+)
                  and instr(':'||:P8_COMPANY||':',':'||pc.CompanyCode||':') > 0
                --  and ( :P8_PARTYTYPE IS NULL OR instr(':'||:P8_PARTYTYPE||':',':'||a.PartyTypeCode||':') > 0 ) 
                    and instr(':'||:P8_PARTYTYPE||':',':'||a.PartyTypeCode||':') > 0  
                  and ( :P8_PARENTGROUP IS NULL OR instr(':'||:P8_PARENTGROUP||':',':'||a.ParentCode||':') > 0 ) 
                  and ( :P8_ACCOUNT IS NULL OR instr(':'||:P8_ACCOUNT||':',':'||a.PartyCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 8403761664737552
        }

