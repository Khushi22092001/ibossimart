                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 1
                }
            )

            pivotAggregate ir-pivot-agg-2 (
                heading: OutTime
                aggregate {
                    function: max
                    column: OUTTIME
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 2
                }
            )

