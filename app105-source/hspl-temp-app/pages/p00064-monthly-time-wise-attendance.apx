    pageItem P64_EMPLOYEE (
        type: popupLov
        label {
            label: Employee
            alignment: left
        }
        settings {
            displayAs: modalDialog
            initialFetch: onUserRequest
            fetchOnSearch: true
            title: Select Employee
            popupWidth: 450
            popupHeight: 350
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     Distinct
                     a.EmployeeName||' ( '||a.EmployeeID||' )' as EmployeeName,
                     a.Employeecode as EmployeeCode
                
                From Employee a
                ```
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 70
            region: @time-wise-attendence
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
