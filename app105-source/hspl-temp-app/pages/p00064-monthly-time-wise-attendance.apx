page 64 (
    name: Monthly Time Wise Attendance
    alias: MONTHLY-TIME-WISE-ATTENDANCE
    title: Monthly Time Wise Attendance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region time-wise-attendence (
        name: Time Wise Attendence
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region time-wise-attendence-2 (
        name: Time Wise Attendence
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                row_number() over(order by a.attendenceDate) SerialNo,
                a.attendencedate,
                b.employeecode,
                c.EmployeeID,
                c.employeename as Employee,
                GetDepartmentName(GetEmployeeDepartmentCode(c.EmployeeCode,sysdate)) as Department,
                GetDesignationName(GetEmployeeDesignationCode(c.EmployeeCode,sysdate)) as Designation,
                b.attendenceheadcode,
                To_Char(b.InTime,'DD-MM-RRRR HH:MI AM') as INTIME2,
                To_Char(b.OutTime,'DD-MM-RRRR HH:MI AM') as OUTTIME2,
                to_number(To_Char(b.InTime,'HH.MI')) as INTIME,
                to_number(To_Char(b.OutTime,'HH.MI')) as OUTTIME,
                getshiftname(b.SHIFTCODE) As Shift, 
                get_hr_time((B.OUTTIME - B.INTIME) * 60 * 60 * 24) || '.' ||
                       Substr(get_MINT_time((B.OUTTIME - B.INTIME) * 60 * 60 * 24), 1, 2) As PRESENTHOUR
                --b.PRESENTHOUR
                --TO_NUMBER(TO_NUMBER(to_char(b.intime,'HH24'),999.99)||'.'||TO_NUMBER(to_char(b.intime,'MI'),999.99),999.99) intime,
                --TO_NUMBER(TO_NUMBER(to_char(b.outtime,'HH24'),999.99)||'.'||TO_NUMBER(to_char(b.outtime,'MI'),999.99),999.99) outtime 
                from attendence a, attendencedetail b , employee c
                where a.tno = b.tno
                  and b.employeecode = c.employeecode
                  and b.EmployeeCode not in ('AS','VAS')
                  and  a.attendencedate between :p64_fromdate and :p64_todate
                  --and getemployeelocationcode(b.employeecode,a.attendencedate) = nvl(:p64_location,getemployeelocationcode(b.employeecode,a.attendencedate))
                  --and getemployeelocationcode(b.employeecode,a.attendencedate) = :p64_location
                  --and getemployeedepartmentcode(b.employeecode,a.attendencedate) = nvl(:p64_department,getemployeedepartmentcode(b.employeecode,a.attendencedate))
                  --and getemployeedesignationcode(b.employeecode,a.attendencedate) = nvl(:p64_designatin,getemployeedesignationcode(b.employeecode,a.attendencedate))
                  and ( :P64_COMPANY IS NULL OR instr(':'||:P64_COMPANY||':',':'|| a.CompanyCode ||':') > 0 ) 
                  and ( :P64_LOCATION IS NULL OR instr(':'||:P64_LOCATION||':',':'|| a.LocationCode ||':') > 0 ) 
                  --and ( :P64_DEPARTMENT IS NULL OR instr(':'||:P64_DEPARTMENT||':',':'||getemployeedepartmentcode(b.employeecode,a.attendencedate) ||':') > 0 ) 
                  and ( :P64_DEPARTMENT IS NULL OR instr(':'||:P64_DEPARTMENT||':',':'|| a.DepartmentCode ||':') > 0 ) 
                  and ( :P64_DESIGNATION IS NULL OR instr(':'||:P64_DESIGNATION||':',':'||getemployeedesignationcode(b.employeecode,a.attendencedate) ||':') > 0 ) 
                  and ( :P64_EMPLOYEE IS NULL OR instr(':'||:P64_EMPLOYEE||':',':'|| b.employeecode ||':') > 0 ) 
                  and :P64_COMPANY is not null
                  
                
                ```
            pageItemsToSubmit: P64_FROMDATE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                csv
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 43474041697395369
        }

