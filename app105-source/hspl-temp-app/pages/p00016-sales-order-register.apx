        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select SalesOrderNo 
                From SalesOrder 
                Where instr(':'||:P16_LOCATION||':',':'||LocationCode||':') > 0
                  and SalesOrderDate Between :P16_FROMDATE and :P16_TODATE
                Order by 1
                ```
