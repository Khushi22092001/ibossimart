    region sales-order-register (
        name: Sales Order Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      rownum as Sno,
                      xxx.TNo,
                      xxx.SalesOrderNo,
                      xxx.SalesOrderDate,
                      xxx.Vendor,
                      xxx.Consignee,
                      xxx.cityname,
                      xxx.Agent,
                      xxx.PartyPONo,
                      xxx.PartyPODate,
                      xxx.ValidityUptoDate,
                      xxx.ItemCode,
                      xxx.ItemName,
                      xxx.Item,
                      xxx.UOM,
                      xxx.Quantity1,
                      xxx.UOM2,
                      XXX.Quantity2,
                      xxx.Rate,
                      xxx.Amount,
                      xxx.CGST,
                      xxx.SGST,
                      xxx.IGST,
                      xxx.TCS,
                      xxx.FooterAmount,
                      (xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS)) as OtherAmount,
                      xxx.TotalAmount,
                      xxx.Creator,
                      xxx.CreationTime,
                      xxx.DespatchQuantity,
                      xxx.InvoiceQuantity,
                      xxx.BalanceQuantity,
                      xxx.freighttypename,
                      xxx.duedays
                From 
                    (Select
                          xx.TNo,
                          xx.SalesOrderNo,
                          xx.SalesOrderDate,
                          xx.Vendor,
                          xx.Consignee,
                          xx.cityname,
                          xx.Agent,
                          xx.PartyPONo,
                          xx.PartyPODate,
                          xx.ValidityUptoDate,
                          xx.ItemCode,
                          xx.ItemName,
                          xx.Item,
                          xx.UOM,
                          xx.Quantity1,
                          xx.uom2,
                          xx.Quantity2,
                          xx.Rate,
                          xx.Amount,
                          sum(xx.CGST) CGST,
                          sum(xx.SGST) SGST,
                          sum(xx.IGST) IGST,
                          sum(xx.TCS) TCS,
                          xx.FooterAmount,
                          xx.TotalAmount,
                          xx.Creator,
                          xx.CreationTime,
                          xx.DespatchQuantity,
                          xx.InvoiceQuantity,
                          xx.BalanceQuantity,
                          xx.freighttypename,
                          xx.duedays
                    From 
                        (Select
                              a.Tno,
                              a.SalesOrderNo,
                              a.SalesOrderDate,
                              GetPartyName(a.PartyCode) as  Vendor,
                              GetPartyName(a.ConsigneeCode) as Consignee,
                              ct.cityname,
                              GetPartyName(a.AgentCode) as Agent,
                              a.PartyPONo,
                              a.PartyPODate,
                              a.ValidityUptoDate,
                              e.ItemCode,
                              e.ItemName,
                              e.ItemName||' ~ '||ee.ItemSpecificationName as Item,
                              e.MeasuringUnitCode1 UOM,
                              b.Quantity1,
                              NVL(B.PACKINGTYPECODE,e.MeasuringUnitCode2) UOM2,
                              b.quantity2,
                              b.Rate,
                              b.Amount,
                              nvl(Decode(c.FooterHeadCode,'.CGST.', c.FooterValue),0) as CGST,
                              nvl(Decode(c.FooterHeadCode,'.SGST.', c.FooterValue),0) as SGST,
                              nvl(Decode(c.FooterHeadCode,'.IGST.', c.FooterValue),0)as IGST,
                              nvl(Decode(c.FooterHeadCode,'.TCS.', c.FooterValue),0) as TCS,
                              b.FooterAmount,
                              b.TotalAmount,
                              bue.EmployeeName||' ( '||a.Creator||')' as Creator,
                              a.CreationTime,
                              da.DespatchQuantity,
                              cc.InvoiceQuantity,
                              --NVL(da.DespatchQuantity,0) + NVL(cc.InvoiceQuantity,0) as BalanceQuantity,
                              nvl(b.Quantity1,b.Quantity2) - NVL(nvl(da.DespatchQuantity,cc.InvoiceQuantity),0) as BalanceQuantity,
                              getfreighttypename(a.freighttypecode) as freighttypename,
                              case when NVL(b.Quantity1,0) - NVL(cc.InvoiceQuantity,0) > 0 then
                                        trunc(sysdate) - a.validityuptodate 
                                    else
                                       0
                              end duedays,
                              Case  When b.Quantity1 <= cc.InvoiceQuantity Then 'DONE'
                                    When b.Quantity1 > cc.InvoiceQuantity Then 'PARTIAL'
                                    When cc.InvoiceQuantity is null Then 'PENDING'
                             End as InvoiceStatus,
                             case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                                When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                                When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                                When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                                When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                                When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                                When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                                When dsd.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                                When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                                When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                                When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                            End as DocStatus
                        From  SalesOrder a, SalesOrderDetail b, SalesOrderDetailFooter c, Item e, ItemSpecification ee, BossUser bu, Employee bue, party p,city ct,
                              DocumentStatusDetail dsd,
                              (
                               Select
                                    cd.ReferenceTno as SalesOrderTNo,
                                    cd.ItemCode,
                                    cd.ItemSpecificationCode,
                                    sum(cd.Quantity1) as DespatchQuantity
                              From  CCInvoice cc, CCInvoiceDetail cd
                              Where cc.Tno = cd.TNo
                                and cc.DocTypeCode = 'CHALAN'
                              Group By cd.ReferenceTno,
                                    cd.ItemCode,
                                    cd.ItemSpecificationCode
                              )da,
                              (
                              Select
                                    cd.ReferenceTno as SalesOrderTNo,
                                    cd.ItemCode,
                                    cd.ItemSpecificationCode,
                                    sum(cd.Quantity1) as InvoiceQuantity
                              From  CCInvoice cc, CCInvoiceDetail cd
                              Where cc.Tno = cd.TNo
                                and cc.DocTypeCode = 'CHALANCUMINVOICE'
                              Group By cd.ReferenceTno,
                                    cd.ItemCode,
                                    cd.ItemSpecificationCode
                              )cc
                        Where a.TNo = b.TNo
                          and b.TNo = c.TNo
                          and b.SNo = c.SNo
                          and b.ItemCode = e.ItemCode
                          and b.ItemSpecificationCode = ee.ItemSpecificationCode
                          and a.Creator = bu.LoginName(+)
                          and nvl(a.consigneecode,a.partycode)=p.partycode
                          and nvl(p.workscitycode,p.officecitycode)=ct.citycode
                          and bu.EmployeeCode = bue.EMployeeCode(+)
                          and b.TNo = da.SalesOrderTNo(+)
                          and b.ItemCode = da.ItemCode(+)
                          and b.ItemSpecificationCode = da.ItemSpecificationCode(+)
                          and b.TNo = cc.SalesOrderTNo(+)
                          and b.ItemCode = cc.ItemCode(+)
                          and b.ItemSpecificationCode = cc.ItemSpecificationCode(+)
                          and a.tno = dsd.moduletno(+)
                            -- 22-APR-2025
                          and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                          and a.SalesOrderDate between :P16_FROMDATE and :P16_TODATE
                          and instr(':'||:P16_COMPANY||':',':'||a.CompanyCode||':') > 0
                          and instr(':'||:P16_LOCATION||':',':'||a.LocationCode||':') > 0
                          and instr(':'||:P16_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                          and ( :P16_PARTY IS NULL OR instr(':'||:P16_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                      --    and ( :P16_TRANSPORTER IS NULL OR instr(':'||:P16_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 ) 
                          and ( :P16_ITEM IS NULL OR instr(':'||:P16_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                          and ( :P16_ITEMSPECIFICATION IS NULL OR instr(':'||:P16_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 ) 
                       --   and ( :P16_TRADETYPE IS NULL OR instr(':'||:P16_TRADETYPE||':',':'||A.TRADETYPECODE||':') > 0 ) 
                          and a.SalesOrderNo like nvl(:P16_SONO,'%')
                          and Case  When b.Quantity1 <= cc.InvoiceQuantity Then 'DONE'
                                    When b.Quantity1 > cc.InvoiceQuantity Then 'PARTIAL'
                                    When cc.InvoiceQuantity is null Then 'PENDING'
                             End like nvl(:P16_INVOICESTATUS,'%')
                           and case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                                When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                                When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                                When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                                When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                                When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                                When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                                When dsd.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                                When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                                When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                                When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                          End like nvl(:P16_STATUS,'%')
                
                         )xx
                    Group By xx.TNo,
                          xx.SalesOrderNo,
                          xx.SalesOrderDate,
                          xx.Vendor,
                          xx.Consignee,
                          xx.cityname,
                          xx.Agent,
                          xx.PartyPONo,
                          xx.PartyPODate,
                          xx.ValidityUptoDate,
                          xx.ItemCode,
                          xx.ItemName,
                          xx.Item,
                          xx.UOM,
                          xx.Quantity1,
                          XX.UOM2,
                          XX.QUANTITY2,
                          xx.Rate,
                          xx.Amount,
                          xx.FooterAmount,
                          xx.TotalAmount,
                          xx.Creator,
                          xx.CreationTime,
                          xx.DespatchQuantity,
                          xx.InvoiceQuantity,
                          xx.BalanceQuantity,
                          xx.freighttypename,
                          xx.duedays
                    )xxx
                ```
        }
