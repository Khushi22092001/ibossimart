        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/ccinvoiceregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P16_FROMDATE=&P16_FROMDATE.&P16_TODATE=&P16_TODATE.&P16_LOCATION=&P16_LOCATION.&P16_DOCTYPE=&P16_DOCTYPE.&P16_PARTY=&P16_PARTY.&P16_TRANSPORTER=&P16_TRANSPORTER.&P16_ITEM=&P16_ITEM.&P16_ITEMSPECIFICATION=&P16_ITEMSPECIFICATION.&P16_CCINO=&P16_CCINO.&P16_VEHICLENO=&P16_VEHICLENO.&P16_VSTATUS=&P16_VSTATUS.&P16_MISTATUS=&P16_MISTATUS.
            warnOnUnsavedChanges: doNotCheck
        }
