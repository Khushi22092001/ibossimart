page 175 (
    name: Trial Balance
    alias: TRIAL-BALANCE
    title: Trial Balance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                a.partycode,
                a.partyname,
                getTrialBalancePosition(a.PartyCode) AS ccurrentposition,
                a.partytypecode,
                c.AccountLevel,
                decode(c.openingamount, 0, null, round(C.OPENINGAMOUNT,2)) as openingamount,
                round(C.CLOSINGAMOUNT,2) as closingamount,
                decode(c.OpeningDebitAmount, 0, null, round(c.OpeningDebitAmount,2)) as OpeningDebitAmount,
                decode(c.OpeningCreditAmount, 0, null, round(c.OpeningCreditAmount,2)) as OpeningCreditAmount,
                round(decode(C.DEBITAMOUNT, 0, null, c.DebitAmount),2) AS debitamount,
                round(decode(C.CREDITAMOUNT, 0 , null, round(c.CreditAmount,2)),2) AS CreditAmount,
                decode(C.PDEBITAMOUNT, 0, null, round(c.PDebitAmount,2)) AS pdebitamount,
                decode(C.PCREDITAMOUNT, 0 , null, round(c.PCreditAmount,2)) AS pcreditamount,
                decode(c.ClosingDebitAmount, 0, null, round(c.ClosingDebitAmount,2)) AS debitclosing,
                decode(c.ClosingCreditAmount, 0, null, round(c.ClosingCreditAmount,2)) AS creditclosing,
                CASE WHEN nvl(:P175_LedgerOnly,'NO') = 'NO' then
                	    rpad('-',5 * (C.AccountLevel - (nvl( (TO_NUMBER(:P175_AccountLevel,99)),1)) ),'-')  || A.PARTYNAME 
                	else
                		A.PARTYNAME		
                end ACCOUNTNAMEDISPLAY ,
                
                CASE WHEN C.AccountLevel  = nvl(:P175_AccountLevel,1) or NVL(:P175_LedgerOnly, 'NO') = 'YES'  then
                       c.OpeningDebitAmount  
                     ELSE
                        0
                END  DebitOpeningC,    
                CASE WHEN C.AccountLevel  = nvl(:P175_AccountLevel,1) or NVL(:P175_LedgerOnly, 'NO') = 'YES'  then
                       c.OpeningCreditAmount 
                     ELSE
                        0
                END  CreditOpeningC,
                CASE WHEN C.AccountLevel  = nvl(:P175_AccountLevel,1) or NVL(:P175_LedgerOnly, 'NO') = 'YES'  then
                       c.DebitAmount  
                     ELSE
                        0
                END  DebitAmountC,    
                CASE WHEN C.AccountLevel  = nvl(:P175_AccountLevel,1) or NVL(:P175_LedgerOnly, 'NO') = 'YES'  then
                       c.CreditAmount 
                     ELSE
                        0
                END  CreditAmountC,
                CASE WHEN C.AccountLevel  = nvl(:P175_AccountLevel,1) or NVL(:P175_LedgerOnly, 'NO') = 'YES'  then
                       c.ClosingDebitAmount  
                     ELSE
                        0
                END  DebitClosingC,    
                CASE WHEN C.AccountLevel  = nvl(:P175_AccountLevel,1) or NVL(:P175_LedgerOnly, 'NO') = 'YES'  then
                       c.ClosingCreditAmount 
                     ELSE
                        0
                END  CreditClosingC
                
                
                
                FROM 
                Party a, ApexTrialBalanceRevisedGroup c
                WHERE C.CREATOR = '&APP_USER.'
                AND a.PartyCode = c.AccountCode
                and (
                     exists (
                           select
                                aa.ChildCode
                           from MyAccountIncludeRevised aa
                           where aa.CompanyCode = :P175_CompanyCode
                               and aa.FromDate = :P175_FROMDATE
                               and aa.ToDate = :P175_TODATE
                               and nvl(aa.LocationCode, 'NULL') = nvl(:P175_LocationCode, 'NULL')
                               and aa.AccountCode = :P175_AccountCode
                               and aa.ChildCode = a.PartyCode
                     )
                     or
                     :P175_AccountCode is null
                )
                
                and ( 
                     nvl(:P175_LedgerOnly,'NO') = 'YES'          
                     or
                     c.AccountLevel <= nvl(:P175_DetailLevel,1)
                     or
                     ( c.AccountLevel <= :P175_AccountLevel+ nvl(:P175_DetailLevel,1) and :P175_AccountCode is not null )
                )
                and ( 
                     nvl(:P175_LedgerOnly,'NO') = 'NO' 
                     OR
                     a.PartyTypeCode != 'ACCOUNTGROUP'
                )
                and (
                     nvl(:P175_IncludeZeroTransaction ,'NO') = 'YES'
                     or ( 
                         nvl(c.OpeningAmount,0) != 0
                         or
                         nvl(c.DebitAmount,0) != 0
                         or
                         nvl(c.CreditAmount,0) != 0
                         or
                         nvl(c.PDebitAmount,0) != 0
                         or
                         nvl(c.PCreditAmount,0) != 0
                     )     
                )
                and (
                     nvl(:P175_Exclude0Closing ,'NO') = 'NO'
                     or (
                         ROUND(nvl(c.OpeningAmount,0) - nvl(c.DebitAmount,0) + nvl(c.CreditAmount,0)   - nvl(c.PDebitAmount,0) + nvl(c.PCreditAmount,0), 2) != 0
                     )     
                )
                and c.FromDate = trunc(TO_DATE(:P175_FROMDATE,'DD-MON-RRRR'))
                and c.ToDate = trunc(TO_DATE(:P175_TODATE,'DD-MON-RRRR'))
                and c.IncludeChild = nvl(:P175_IncludeChild , 'NO')
                and c.CompanyCode = :P175_CompanyCode
                and nvl(c.LocationCode, 'null') = nvl(:P175_Locationcode, 'null') 
                ORDER BY c.TrialBalancePosition, a.PartyName ;
                
                ```
            pageItemsToSubmit: [
                P175_FROMDATE
                P175_TODATE
                P175_DETAILLEVEL
                P175_FINANCIALYEARCODE
                P175_COMPANYCODE
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
