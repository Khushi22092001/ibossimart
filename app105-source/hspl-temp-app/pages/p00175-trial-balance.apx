    process create (
        name: create
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                		declare
                            	tFromDate Date := to_date(:P175_FromDate,'dd-mon-rrrr');
                				tToDate Date := to_date(:P175_ToDate,'dd-mon-rrrr');
                				tStartDate Date := GetFinancialYearBegin(:P175_FinancialYearCode);
                				tDetailLevel number := :P175_DetailLevel;
                                tFinancialyearcode  varchar2(30) ;
                				tLedgerOnly Varchar2(30) := :P175_LedgerOnly;
                				tIncludeChild Varchar2(30) := :P175_IncludeChild;		
                				tLocationCode Varchar2(30) := :P175_LocationCode;
                				tLocationName Varchar2(2000) := :P175_LocationName;
                				tDivisionWise Varchar2(3) := :P175_DivisionWise;
                		begin 
                                Select aa.financialyearcode,aa.financialyearbegin 
                                into tFinancialyearcode,tStartDate
                                From financialyear aa
                                Where to_date(:p175_fromdate,'dd-Mon-rrrr') Between aa.financialyearbegin And aa.financialyearend ;
                 
                                
                                DELETE FROM MyAccountIncludeRevised 
                                WHERE CREATOR = 'BOSS' ;
                                
                                DELETE FROM MyAccountIncludeRevised 
                                WHERE CREATOR = 'APEX_PUBLIC_USER' ;
                                           
                                
                                CreateMyAccountIncludeRevised(:P175_CompanyCode, tLocationCode, tFromDate, tToDate);
                                --RefreshMyAccountIncludeForAll;
                  
                                 UPDATE MyAccountIncludeRevised 
                                  SET CREATOR = '&APP_USER.'
                                WHERE CREATOR = 'APEX_PUBLIC_USER' ;
                   
                                
                                /*----------------------------
                				-- EXECUTE REFRESH OPENING ON INSTRUCTION FROM TIWARI SIR DATE 30 APR 2018
                				*/
                               RefreshOpening(nvl(:P175_FinancialYearCode,tFinancialyearcode), :P175_CompanyCode);			
                				
                				/*----------------------------*/
                				
                				delete 
                						from TrialBalanceRevised a 
                						where a.CompanyCode = :P175_CompanyCode
                								and nvl(a.LocationCode, 'null') = nvl(tLocationCode, 'null')
                								and a.FromDate = tFromDate
                								and a.ToDate = tToDate
                								and a.Creator = '&APP_USER.'
                				;
                				
                				
                				insert into TrialBalanceRevised(
                						LocationCode,
                						CompanyCode,
                						Accountcode,
                						FromDate,
                						ToDate,
                						OpeningAmount,
                						DebitAmount,
                						CreditAmount,
                						PDebitAmount,
                						PCreditAmount,
                						IncludeChild
                				) 
                					select
                							tLocationCode,
                							:P175_companycode,
                							a.PartyCode,
                							tFromDate,
                							tToDate,
                							b.OpeningAmount,
                							b.DebitAmount,
                							b.CreditAmount,
                							b.PDebitAmount,
                							b.PCreditAmount,
                							nvl(tIncludeChild, 'NO')
                					from Party a, (
                							select
                							/*	--------------------------- --
                								-- date 25-feb-2021
                								-- a11.LocationCode,
                								null as LocationCode,
                								--------------------------- --
                                            */
                								a11.AccountCode,
                								sum(a11.OpeningAmount) as OpeningAmount,
                								sum(a11.DebitAmount) as DebitAmount,
                								sum(a11.CreditAmount) as CreditAmount,
                								sum(a11.PDebitAmount) as PDebitAmount,
                								sum(a11.PCreditAmount) as PCreditAmount	
                							from (
                								select
                									nvl(tLocationCode, a1.LocationCode) as LocationCode,
                									a1.AccountCode,
                									a1.OpeningAmount as OpeningAmount,
                									null DebitAmount,
                									null as CreditAmount,
                									null as PDebitAmount,
                									null as PCreditAmount
                								from Opening a1
                								where a1.CompanyCode = :P175_CompanyCode
                									and a1.OpeningDate = tStartDate
                								/*	----------------------------------- --
                									-- date 02-jna-2020
                									-- and a1.LocationCode = nvl(tLocationCode, a1.LocationCode)
                								*/
                                                    and a1.LocationCode in(
                											select
                													a1a.LocationCode 
                											from TrialBalanceForLocation a1a
                									)
                								/*	----------------------------------- --*/
                								
                								union all
                								select
                									nvl(tLocationCode, a1.LocationCode) as LocationCode,
                									a1.AccountCode,
                									a1.Amount as OpeningAmount,
                									null DebitAmount,
                									null as CreditAmount,
                									null as PDebitAmount,
                									null as PCreditAmount
                								from VoucherDetail a1
                								where a1.CompanyCode = :P175_CompanyCode
                									and a1.VoucherDate between tStartDate and (tFromDate-1)
                								/*	----------------------------------- --
                									-- date 02-jna-2020
                									-- and a1.LocationCode = nvl(tLocationCode, a1.LocationCode)
                								*/	and a1.LocationCode in(
                											select
                													a1a.LocationCode 
                											from TrialBalanceForLocation a1a
                									)
                								/*	----------------------------------- --
                								--
                                                  */  
                								union all
                								select
                									nvl(tLocationCode, a1.LocationCode) as LocationCode,
                									a1.AccountCode,
                									null as OpeningAmount,
                									-1 *a1.Amount DebitAmount,
                									null as CreditAmount,
                									null as PDebitAmount,
                									null as PCreditAmount
                								from VoucherDetail a1
                								where a1.Amount < 0
                									and a1.CompanyCode = :P175_CompanyCode
                									and a1.VoucherDate between tFromDate and tToDate				
                								/*	----------------------------------- --
                									-- date 02-jna-2020
                									-- and a1.LocationCode = nvl(tLocationCode, a1.LocationCode)
                								*/
                                                    and a1.LocationCode in(
                											select
                													a1a.LocationCode 
                											from TrialBalanceForLocation a1a
                									)
                								/*	----------------------------------- --
                								--
                                                 */
                								union all
                								select
                									nvl(tLocationCode, a1.LocationCode) as LocationCode,
                									a1.AccountCode,
                									null as OpeningAmount,
                									null as DebitAmount,
                									a1.Amount as CreditAmount,
                									null as PDebitAmount,
                									null as PCreditAmount
                								from VoucherDetail a1
                								where a1.Amount > 0
                									and a1.CompanyCode = :P175_CompanyCode
                									and a1.VoucherDate between tFromDate and tToDate
                								/*----------------------------------- --
                									-- date 02-jna-2020
                									-- and a1.LocationCode = nvl(tLocationCode, a1.LocationCode)
                								*/	and a1.LocationCode in(
                											select
                													a1a.LocationCode 
                											from TrialBalanceForLocation a1a
                									)
                								/*	----------------------------------- --
                								--
                                                */
                								union all
                								select
                									nvl(tLocationCode, a1.LocationCode) as LocationCode,
                									a1.AccountCode,
                									null as OpeningAmount,
                									null as DebitAmount,
                									null as CreditAmount,
                									-1 *a1.Amount as PDebitAmount,
                									null as PCreditAmount
                								from PVoucherDetail a1
                								where a1.Amount < 0
                									and a1.CompanyCode = :P175_CompanyCode
                									and a1.PVoucherDate between tFromDate and tToDate
                								/*	----------------------------------- --
                									-- date 02-jna-2020
                									-- and a1.LocationCode = nvl(tLocationCode, a1.LocationCode)
                								*/	and a1.LocationCode in(
                											select
                													a1a.LocationCode 
                											from TrialBalanceForLocation a1a
                									)
                								/*	----------------------------------- -- */
                									and not exists(
                											select
                													aa.TNo
                											from Voucher aa
                											where aa.MOduleTNo = a1.TNo
                									)
                								
                								union all
                								select
                									nvl(tLocationCode, a1.LocationCode) as LocationCode,
                									a1.AccountCode,
                									null as OpeningAmount,
                									null as DebitAmount,
                									null as CreditAmount,
                									null as PDebitAmount,
                									a1.Amount as PCreditAmount
                								from PVoucherDetail a1
                								where a1.Amount > 0
                									and a1.CompanyCode = :P175_CompanyCode
                									and a1.PVoucherDate between tFromDate and tToDate
                								/*	----------------------------------- --
                									-- date 02-jna-2020
                									-- and a1.LocationCode = nvl(tLocationCode, a1.LocationCode)
                								*/
                                                    and a1.LocationCode in(
                											select
                													a1a.LocationCode 
                											from TrialBalanceForLocation a1a
                									)
                								/*	----------------------------------- -- */
                									and not exists(
                											select
                													aa.TNo
                											from Voucher aa
                											where aa.MOduleTNo = a1.TNo
                									)							
                							) a11
                							group by
                							/*	--------------------------- --
                								-- date 25-feb-2021
                								-- a11.LocationCode,
                								--------------------------- --
                							*/
                                            a11.AccountCode						
                					) b
                					where a.PartyTypeCode != 'ACCOUNTGROUP'
                							and a.PartyCode = b.AccountCode
                				;
                				
                						
                				update TrialBalanceRevised a
                						set a.ClosingAmount = nvl(a.OpeningAmount,0) - nvl(a.Debitamount,0) +  nvl(a.CreditAmount,0) - nvl(a.PDebitamount,0) +  nvl(a.PCreditAmount,0),
                                        CREATOR = '&APP_USER.'
                				where a.CompanyCode = :P175_CompanyCode
                						and a.FromDate = tFromDate
                						and a.ToDate = tToDate
                						and nvl(a.IncludeChild,'NO') = nvl(tIncludeChild, 'NO' )
                				;
                				
                				commit;
                				/*CreateMyAccountIncludeRevised(:P175_CompanyCode, tLocationCode, tFromDate, tToDate);*/
                				commit;
                /*				
                				:P175_FromDate := tFromDate;
                				:P175_ToDate := tToDate;
                				:P175_LedgerOnly := tLedgerOnly;
                				:P175_IncludeChild := tIncludeChild;
                				:P175_DetailLevel := tDetailLevel;
                				
                				:P175_LocationCode := tLocationCode;
                				:P175_LocationName := tLocationName;
                				:P175_DivisionWise := tDivisionWise;
                				
                				go_block('masterblock');
                				
                				execute_query(no_validate);
                				
                				clear_message;
                */				
                		end;  
                END;
                ```
        }
        execution {
            sequence: 10
            runProcess: oncePerSessionOrWhenReset
        }
        advanced {
            executionMappingIdentifier: 14741926934729246
        }
    )

