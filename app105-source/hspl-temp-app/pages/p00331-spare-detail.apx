page 331 (
    name: Spare Detail
    alias: SPARE-DETAIL
    title: Spare Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #spd .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region spare-detail (
        name: Spare Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Select
                  Rownum as SerialNo,
                	md.ModuleName,
                	a.IssueNo as ModuleNo,
                	a.IssueDate as ModuleDate,
                	a.CompanyCode,
                	x.VehicleNo,
                  round(x.Amount,2) as Amount
                From Issue a, Module md, DocumentStatusDetail dsd,
                (
                Select
                	a.ModuleTno,
                	c.CostCentreName as VehicleNo,
                	round(sum(b.Amount), 2) as Amount
                From Voucher a, VoucherCostCentreDetail b, CostCentre c, CompanyVehicle d, Equipment e
                Where a.Tno = b.Tno
                	and b.CostCentreCode = c.CostCentreCode
                	and c.CostCentreName = d.CompanyVehicleNo
                	and d.ModuleTno = e.Tno
                	and e.EquipmentGroupCode = 'CT'
                Group by
                	a.ModuleTno,
                	c.CostCentreName
                ) x
                Where 1=1
                	and a.Tno = x.ModuleTno
                	and md.ModuleCode = 'ISSUE'
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and a.IssueDate between :P331_FROMDATE and :P331_TODATE
                  and x.VehicleNo like nvl(:P331_VEHICLENO, '%')
                  and a.CompanyCode = :P331_COMPANYCODE
                  and exists(
                			Select
                				  aa.Tno
                			From IssueDetail aa, Item bb
                			Where aa.ItemCode = bb.ItemCode
                				  and bb.ItemCategoryCode not in ('TYRE', 'BATTERY', 'FUEL', 'ADBLUE')
                				  and aa.Tno = a.Tno
                			)
                  and exists(
                    Select
                        aa.Tno
                    From IssueStockStorageDetail aa
                    Where aa.Tno = a.Tno
                        and aa.StorageLocationCode != '291'
                   )
                UNION ALL
                Select 
                  Rownum as SerialNo,
                	d.ModuleName,
                	a.AccessoriesManagementNo as ModuleNo,
                	a.AccessoriesManagementDate as ModuleDate,
                	a.CompanyCode,
                	c.CompanyVehicleNo as VehicleNo,
                	round(a.Amount, 2) as Amount
                From AccessoriesManagement a, Equipment b, CompanyVehicle c, Module d
                Where a.SourceEquipmentTno = b.Tno
                	and b.Tno = c.ModuleTno
                	and d.ModuleCode = 'ACCESSORIESMANAGEMENT'
                	and b.EquipmentGroupCode = 'CT'
                	and a.Activity = 'Fitting' 
                	and a.ItemCategoryCode not in ('TYRE', 'BATTERY')
                	and a.AccessoriesManagementDate between :P331_FROMDATE and :P331_TODATE
                  and c.CompanyVehicleNo like nvl(:P331_VEHICLENO, '%')
                  and a.CompanyCode = :P331_COMPANYCODE
                Order by 3, 2 
                */
                
                Select
                  row_number() over(order by a.ModuleDate) SerialNo,
                	a.ModuleName,
                	a.ModuleNo,
                	a.ModuleDate,
                	a.VehicleNo,
                  b.VehicleTypeName,
                  c.TransportAreaName,
                	a.Amount
                From VehicleExpenseTable a, VehicleType b, TransportArea c
                Where a.VehicleTypeCode = b.VehicleTypeCode(+)
                    and a.TransportAreaCode = c.TransportAreaCode(+)
                    and a.ModuleDate between :P331_FROMDATE and :P331_TODATE
                		and a.VehicleNo like nvl(:P331_VEHICLENO, '%')
                		and a.CompanyCode = :P331_COMPANYCODE
                    and a.Creator = :APP_USER
                    and a.Categories = 'SPARE'
                    and (:P331_VEHICLENO2 is null
                       or exists(
                         Select
                            aa.VehicleNo
                          From VPVehicleNo aa
                          Where aa.VehicleNo = a.VehicleNo
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P331_VEHICLETYPE is null
                       or exists(
                         Select
                            aa.VehicleTypeCode
                          From VPVehicleType aa
                          Where aa.VehicleTypeCode = a.VehicleTypeCode
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P331_TRANSPORTAREA is null
                       or exists(
                         Select
                            aa.TransportAreaCode
                          From VPTransportArea aa
                          Where aa.TransportAreaCode = a.TransportAreaCode
                              and aa.Creator = :APP_USER
                       )
                   )
                ```
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: spd
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 151450611650329246
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Spare Amount
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column MODULEDATE (
            type: plainText
            heading {
                heading: Module Date
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Q
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: Module
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No.
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: R
            }
        )

        column TRANSPORTAREANAME (
            type: plainText
            heading {
                heading: Transport Area
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: Vehicle No.
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column VEHICLETYPENAME (
            type: plainText
            heading {
                heading: Vehicle Type
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Spare Detail
        }

        savedReport 505176 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn AMOUNT (
                sequence: 8
            )

            displayColumn MODULEDATE (
                sequence: 4
            )

            displayColumn MODULENAME (
                sequence: 2
            )

            displayColumn MODULENO (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TRANSPORTAREANAME (
                sequence: 7
            )

            displayColumn VEHICLENO (
                sequence: 5
            )

            displayColumn VEHICLETYPENAME (
                sequence: 6
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                function: count
                column: NECESSITYSLIPDATE
            )

            aggregate (
                function: count
                column: ISSUEDATE
            )

            controlBreak (
                column: TRANSPORTAREANAME
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P331_COMPANYCODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P331_FROMDATE (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P331_TODATE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P331_TRANSPORTAREA (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P331_VEHICLENO (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P331_VEHICLENO2 (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P331_VEHICLETYPE (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

