page 382 (
    name: Payloader Tyre Detail
    alias: PAYLOADER-TYRE-DETAIL
    title: Payloader Tyre Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-tyre-detail (
        name: PayLoader Tyre Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Select
                   a.CompanyCode,
                   g.EquipmentTno,
                   g.EquipmentID,
                   a.IssueNo as ModuleNo,
                   a.IssueDate as ModuleDate,
                   g.Amount as Amount,
                   c.ModuleName,
                   d.LocationName
                From Issue a, DocumentStatusDetail dsd,Module c, Location d,
                   (
                   Select
                         a.ModuleTno,
                         c.Tno as EquipmentTno,
                         c.EquipmentID,
                         round(sum(b.Amount), 2) as Amount
                   From Voucher a, VoucherCostCentreDetail b, Equipment c
                   Where a.Tno = b.Tno
                         and b.CostCentreCode = c.CostCentreCode
                         and c.EquipmentGroupCode = 'PL'
                   Group by
                   a.ModuleTno,
                   c.Tno,
                   c.EquipmentID
                ) g
                   Where c.ModuleCode = 'ISSUE'
                   and a.LocationCode = d.LocationCode
                   and a.Tno = g.ModuleTno
                   and a.Tno = dsd.ModuleTno
                   and dsd.DocumentStatusCode = 'ACTIVE'
                   and exists(
                   Select
                        aa.Tno
                   From IssueDetail aa
                   Where aa.ItemCode = 'TYRE'
                      and aa.Tno = a.Tno
                   )
                   and exists(
                   Select
                       aa.Tno
                   From IssueStockStorageDetail aa
                   Where aa.StorageLocationCode != '291'
                      and aa.Tno = a.Tno
                   )
                   and not exists(
                   Select
                   	aa.Tno
                   From AccessoriesManagement aa
                   Where aa.IssueTno = a.Tno
                   and c.ModuleCode = 'ISSUE'
                   )
                  and (:P382_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                and a.IssueDate between :P382_FROMDATE and :P382_TODATE
                and (:P382_COMPANYCODE is Null Or Instr (':' || :P382_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P382_EQUIPMENTID is Null Or Instr (':' || :P382_EQUIPMENTID || ':' , ':' || g.EquipmentTno || ':') > 0)
                UNION ALL
                Select 
                   a.CompanyCode,
                   b.Tno as EquipmentTno,
                   b.EquipmentID,
                   a.AccessoriesManagementNo as ModuleNo,
                   a.AccessoriesManagementDate as ModuleDate,
                   a.Amount as Amount,
                   c.ModuleName,
                   d.LocationName
                From AccessoriesManagement a, Equipment b, Module c, Location d
                Where a.SourceEquipmentTno = b.Tno
                   and c.ModuleCode = 'ACCESSORIESMANAGEMENT'
                   and a.LocationCode = d.LocationCode
                   and b.EquipmentGroupCode = 'PL'
                   and a.Activity = 'Fitting' 
                   and a.ItemCategoryCode = 'TYRE'
                  and (:P382_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                
                and a.AccessoriesManagementDate between :P382_FROMDATE and :P382_TODATE
                and (:P382_COMPANYCODE is Null Or Instr (':' || :P382_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P382_EQUIPMENTID is Null Or Instr (':' || :P382_EQUIPMENTID || ':' , ':' || b.Tno || ':') > 0)
                */
                Select 
                    row_number() over(order by a.ModuleDate) SerialNo,
                  a.CompanyCode,
                  b.LocationName,
                  a.EquipmentTno,
                  a.EquipmentID,
                	a.ModuleName,
                	a.ModuleNo,
                	a.ModuleDate,
                	a.Amount
                From PayloaderExpenseTable a, Location b
                Where a.Creator = :APP_USER
                	and a.LocationCode = b.LocationCode
                	and (:P382_LOCATION is null
                		or exists(
                			 Select
                				aa.LocationCode
                			  From PayloaderPerformanceLocation aa
                			  Where aa.LocationCode = a.LocationCode
                				  and aa.Creator = :APP_USER
                			)
                		)
                	and a.Categories = 'TYRE'
                	and a.ModuleDate between :P382_FROMDATE and :P382_TODATE
                	and (:P382_COMPANYCODE is Null Or Instr (':' || :P382_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                	and (:P382_EQUIPMENTID is Null Or Instr (':' || :P382_EQUIPMENTID || ':' , ':' || a.EquipmentTno || ':') > 0)
                ```
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 333004487426696253
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: " Amount"
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EQUIPMENTID (
            type: plainText
            heading {
                heading: Equipment  ID
                alignment: center
            }
            layout {
                sequence: 200
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column EQUIPMENTTNO (
            type: plainText
            heading {
                heading: Equipmenttno
                alignment: center
            }
            layout {
                sequence: 190
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location Name
                alignment: center
            }
            layout {
                sequence: 240
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AA
            }
        )

        column MODULEDATE (
            type: plainText
            heading {
                heading: Module Date
                alignment: center
            }
            layout {
                sequence: 220
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Y
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: Module Name
                alignment: center
            }
            layout {
                sequence: 230
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No.
                alignment: center
            }
            layout {
                sequence: 210
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: X
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 250
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AB
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Open Billed Detail
        }

        savedReport 1102245 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 7
            )

            displayColumn EQUIPMENTID (
                sequence: 6
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn MODULEDATE (
                sequence: 5
            )

            displayColumn MODULENAME (
                sequence: 3
            )

            displayColumn MODULENO (
                sequence: 4
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: QUANTITY1
            )

        )

    )

    pageItem P382_COMPANYCODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P382_EQUIPMENTID (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P382_FROMDATE (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P382_LOCATION (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    pageItem P382_TODATE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

