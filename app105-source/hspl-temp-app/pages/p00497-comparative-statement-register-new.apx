            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select    Distinct
                          e.ItemName||' ( '||e.ItemCode||' )' as d,
                          e.ItemCode r
                From ComparativeStatementItem a, Item e
                Where a.ItemCode = e.ItemCode
                Order by 2
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @comparative-statement-register
            slot: regionBody
