page 497 (
    name: Comparative Statement Register
    alias: COMPARATIVE-STATEMENT-REGISTER-NEW
    title: "Comparative Statement Register "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region comparative-statement-register (
        name: "Comparative Statement Register "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   a.Tno,
                   row_number() over(order by a.comparativeStatementDate) SerialNo,
                   a.ComparativeStatementNo,
                   a.ComparativeStatementDate,
                   d.LocationName,
                   f.VendorName,
                   g.ItemName,
                   h.ItemSpecificationName,
                   ee.Description,
                   ee.Quantity1,
                   ee.Rate,
                   round(ee.Amount,2) as Amount,
                   ee.FooterAmount as GSTAmount,
                   ee.TotalAmount,
                   Round(ee.Amount,2) as LandingCost,
                --    Round((ee.Amount)/ nvl(ee.Quantity1,1),2) as LandedRate,
                   l.EmployeeName||' ( '||a.Creator||' )' as Creator,
                   a.CreationTime,
                   m.PurchaseOrderNo,
                   e.QuotationNo,
                   e.QuotationDate,
                   n.EnquiryNo,
                   n.EnquiryDate
                From ComparativeStatement a,ComparativeStatementDetail b, Location d, Quotation e, QuotationDetail ee, Vendor f, Item g, ItemSpecification h,
                (Select
                               x.Tno,
                               Sum(x.FooterValue) as GSTAmount
                              From QuotationDetailFooter x
                              Where x.FooterHeadCode in ('.IGST.','.CGST.','.SGST.')
                              Group By x.Tno
                            )i,
                 (Select
                               x.Tno,
                               Sum(x.FooterValue) as OtherAmount
                              From QuotationDetailFooter x
                              Where x.FooterHeadCode not in ('.IGST.','.CGST.','.SGST.')
                              Group By x.Tno
                            )j, BossUser k, Employee l , 
                           (
                             select aa.quotationtno,aa.itemcode,aa.itemspecificationcode , cc.purchaseorderno
                             from comparativestatementitem aa, purchaseorderdetail bb, purchaseorder cc
                             where aa.quotationtno = cc.quotationtno
                             and aa.itemcode = bb.itemcode
                             and aa.itemspecificationcode = bb.itemspecificationcode
                             and bb.tno = cc.tno
                           ) m, Enquiry n
                            
                
                Where a.Tno = b.Tno(+)
                and a.LocationCode = d.LocationCode(+)
                and b.QuotationTno = e.Tno(+)
                and e.Tno = ee.Tno(+)
                and e.PartyCode = f.VendorCode(+)
                and ee.ItemCode = g.ItemCode(+)
                and ee.ItemSpecificationCode = h.ItemSpecificationCode(+)
                and ee.Tno = i.Tno(+)
                and ee.Tno = j.Tno(+)
                and a.Creator = k.LoginName(+)
                and k.EmployeeCode = l.EmployeeCode(+)
                and ee.Tno = m.QuotationTno(+)
                and ee.itemcode = m.itemcode(+)
                and ee.itemspecificationcode=m.itemspecificationcode(+)
                and a.EnquiryTno = n.Tno(+)
                  and a.ComparativeStatementDate between :P497_FROMDATE and :P497_TODATE
                  and ( :P497_COMPANY IS NULL OR instr(':'||:P497_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                  and ( :P497_LOCATION IS NULL OR instr(':'||:P497_LOCATION||':',':'||a.LocationCode||':') > 0 )
                  and ( :P497_PARTY IS NULL OR instr(':'||:P497_PARTY||':',':'||f.VendorCode||':') > 0 ) 
                  and ( :P497_ITEM IS NULL OR instr(':'||:P497_ITEM||':',':'||ee.ItemCode||':') > 0 ) 
                  and ( :P497_ITEMSPECIFICATION IS NULL OR instr(':'||:P497_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                
                
                ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 75078933466009312
        }

