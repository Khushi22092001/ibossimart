page 156 (
    name: Punch Time Detail
    alias: PUNCH-TIME-DETAIL
    title: Punch Time Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region punch-time-detail (
        name: Punch Time Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region punch-time-detail-report (
        name: Punch Time Detail Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyCode,
                      row_number() over(order by trunc(a.punchtime)) SerialNo,
                      c.CompanyName,
                      l.LocationCode,
                      l.LocationName,
                      trunc(a.punchtime) PunchDate,
                      a.punchtime,
                      a.punchfrom,
                      e.EmployeeName,
                      e.EmployeeID,
                      To_Char(a.PunchTime,'MON-YYYY') Month,
                      a.Longitude,
                      a.Latitude,
                      a.LocationDescription
                From  punchtime_view a, Employee e, Company c, Location l
                Where a.EmployeeCode = e.EmployeeCode
                  and e.CompanyCode = c.CompanyCode
                  and getemployeelocationcode(e.employeecode,trunc(a.punchtime)) = l.LocationCode
                --  and a.EmployeeCode = '247'
                  and TRUNC(a.PUNCHTIME) between :P156_FROMDATE and :P156_TODATE
                  and instr(':'||:P156_LOCATION||':',':'||l.LocationCode||':') > 0
                  and instr(':'||:P156_COMPANY||':',':'||c.CompanyCode||':') > 0
                  and ( :P156_EMPLOYEE IS NULL OR instr(':'||:P156_EMPLOYEE||':',':'||e.EmployeeCode||':') > 0 )
                  and ( :P156_DEPARTMENT IS NULL OR instr(':'||:P156_DEPARTMENT||':',':'||GetEmployeeDepartmentCode(e.EmployeeCode,TRUNC(A.PUNCHTIME))||':') > 0 )
                
                 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 13279901392737286
        }

