            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      EmployeeName d,
                      EmployeeCode r
                From  Employee
                Where CompanyCode = :P156_COMPANY
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P156_COMPANY
            itemsToSubmit: P156_EMPLOYEE
        }
        layout {
            sequence: 70
            region: @punch-time-detail
            slot: regionBody
            alignment: left
            column: 1
