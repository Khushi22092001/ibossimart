    region freight-advance-debit-credit-2 (
        name: Freight Advance Debit Credit
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  row_number() over(order by a.FreightAdviceNo) SerialNo,
                  a.FreightAdviceNo,
                  a.DRAmount,
                  a.CRAmount,
                  a.DrAmount - a.CrAmount as Difference
                From FREIGHTADVANCEDRCR a
                --Where a.DRAmount != a.CRAmount
                -- and ( :P441_VOUCHER IS NULL OR instr(':'||:P441_VOUCHER||':',':'||a.Tno||':') > 0 );
                -- and ( :P441_COMPANY IS NULL OR instr(':'||:P441_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                -- and ( :P441_LOCATION IS NULL OR instr(':'||:P441_LOCATION||':',':'||a.LocationCode||':') > 0 )
                -- and ( :P441_VOUCHER IS NULL OR instr(':'||:P441_VOUCHER||':',':'||a.Tno||':') > 0 );
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
