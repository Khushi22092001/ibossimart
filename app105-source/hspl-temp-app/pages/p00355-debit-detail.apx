page 355 (
    name: Debit Detail
    alias: DEBIT-DETAIL
    title: Debit Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region debit-detail (
        name: Debit Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                row_number() over(order by B.ACCOUNTCode) SerialNo,
                b.AccountCode,
                c.PartyName,
                a.VoucherNo,
                a.VoucherDate,
                abs(b.Amount) as DebitAmount
                From Voucher a,VoucherDetail b, Party c
                Where a.Tno = b.Tno
                and b.AccountCode = c.PartyCode
                and b.Amount < 0
                and b.accountCode = :P355_PARTYCODE
                and a.voucherDate between :P355_FROMDATE and :P355_TODATE
                
                
                /*select
                b.AccountCode,
                c.PartyName,
                a.VoucherNo,
                b.VoucherDate,
                abs(b.Amount) as DebitAmount
                From Voucher a,VoucherDetail b, Party c
                Where a.Tno = b.Tno(+)
                and b.AccountCode = c.PartyCode
                and b.Amount > 0
                and b.accountCode = :P355_PARTYCODE
                and b.voucherDate between :P355_FROMDATE and :P355_TODATE;*/
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 73872461332731520
        }

        column ACCOUNTCODE (
            type: plainText
            heading {
                heading: Accountcode
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DEBITAMOUNT (
            type: plainText
            heading {
                heading: Debit Amount
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column PARTYNAME (
            type: plainText
            heading {
                heading: Party Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column VOUCHERDATE (
            type: plainText
            heading {
                heading: Voucher Date
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column VOUCHERNO (
            type: plainText
            heading {
                heading: Voucher No
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Debit Detail
        }

        savedReport 739447 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEBITAMOUNT (
                sequence: 5
            )

            displayColumn PARTYNAME (
                sequence: 2
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn VOUCHERDATE (
                sequence: 4
            )

            displayColumn VOUCHERNO (
                sequence: 3
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: DEBITAMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P355_FROMDATE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P355_PARTYCODE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P355_TODATE (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

