        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        A.modulecode as modulename,
                        A.modulecode r
                From gsttaxinoutdetail a
                Where a.Type ='OUTWARD'
                ```
            displayExtraValues: false
            nullReturnValue: -Select Module-
        }
        layout {
            sequence: 60
            region: @gst-output-report-new
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
