    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region daily-production-with-diesel-average-summary (
        name: Daily Production With Diesel Average Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select row_number() over(Order By x.Location) SerialNo,
                       x.locationcode,
                       x.location,
                       Count(Distinct x.equipmentid) As "Total PC",
                       Sum(x.workinghrs) As "Working Hrs",
                       Sum(x.vlogbooktrips) As "Total Trips",
                       ROUND(Sum(x.vlogbooktrips) / NVL(Sum(x.workinghrs),1) ,3) As "Avg.",
                       Sum(x.requiredquantity) As "Required Quantity",
                       Sum(x.AchivedQuantity) As "Achived Quantity",
                       Sum(x.requiredquantity) - Sum(x.AchivedQuantity) As "Short/Excess Qty",
                       Nvl(Sum(x.dayshiftdieselqty), 0) +
                       Nvl(Sum(x.nightshiftdieselqty), 0) As "Diesel Quantity",
                              Case
                         When Sum(x.AchivedQuantity) > 0 Then
                          ROUND((Sum(x.dayshiftdieselqty) + Sum(x.nightshiftdieselqty)) /
                                Sum(x.AchivedQuantity),
                                3)
                         Else
                          0
                       End "Avg/m3"
                  From (Select --row_number() over(Order By a.Equipmentlogbookdate) SerialNo,
                         GetLocationName(a.LocationCode) As Location,
                         a.locationcode,
                         c.EquipmentId,
                         a.EquipmentLogBookDate,
                         --       j.JobTypeName,
                         Min(a.OpeningWorkingHrs) As OpeningWorkingHrs,
                         Max(a.ClosingWorkingHrs) As ClosingWorkingHrs,
                         (Max(a.ClosingWorkingHrs) - Min(a.OpeningWorkingHrs)) As WorkingHrs,
                         nvl(Sum(b.TotalTrip), 0) As TotalTrip,
                         Case
                           When (Max(a.ClosingWorkingHrs) - Min(a.OpeningWorkingHrs)) = 0 Then
                            Sum(b.TotalTrip) / 1
                           Else
                            round(Sum(b.TotalTrip) /
                                  NVL((Max(a.ClosingWorkingHrs) - Min(a.OpeningWorkingHrs)),1),
                                  2)
                         End As AvgTrip,
                         (getdailyproductionCapacity(a.companycode,
                                                     a.locationcode,
                                                     Null,
                                                     c.manufacturemodelcode,
                                                     a.EquipmentLogBookDate) *
                         ((to_date(:P410_TODATE, 'DD-MON-YYYY') -
                         TO_DATE(:P410_FROMDATE, 'DD-MON-YYYY')) + 1)) As RequiredQuantity,
                         
                         Case
                         
                           When ROW_NUMBER()
                            Over(Partition By
                                     (Select Sum(c.quantity1)
                                        From NecessitySlip b, NecessitySlipDetail c
                                       Where b.tno = c.tno
                                         And b.Locationcode = a.locationcode
                                         And b.NecessitySlipDate = a.EquipmentLogBookDate
                                         And b.shiftcode = 'DS') Order By
                                     (Select Sum(c.quantity1)
                                        From NecessitySlip b, NecessitySlipDetail c
                                       Where b.tno = c.tno
                                         And b.Locationcode = a.locationcode
                                         And b.NecessitySlipDate = a.EquipmentLogBookDate
                                         And b.shiftcode = 'DS')) = 1 Then
                            (Select Sum(c.quantity1)
                               From NecessitySlip b, NecessitySlipDetail c
                              Where b.tno = c.tno
                                And b.Locationcode = a.locationcode
                                And b.NecessitySlipDate = a.EquipmentLogBookDate
                                And b.shiftcode = 'DS')
                           Else
                            Null
                         End As DayShiftDieselQty,
                         Case
                           When ROW_NUMBER()
                            Over(Partition By
                                     (Select Sum(c.quantity1)
                                        From NecessitySlip b, NecessitySlipDetail c
                                       Where b.tno = c.tno
                                         And b.Locationcode = a.locationcode
                                         And b.NecessitySlipDate = a.EquipmentLogBookDate
                                         And b.shiftcode = 'NS') Order By
                                     (Select Sum(c.quantity1)
                                        From NecessitySlip b, NecessitySlipDetail c
                                       Where b.tno = c.tno
                                         And b.Locationcode = a.locationcode
                                         And b.NecessitySlipDate = a.EquipmentLogBookDate
                                         And b.shiftcode = 'NS')) = 1 Then
                            (Select Sum(c.quantity1)
                               From NecessitySlip b, NecessitySlipDetail c
                              Where b.tno = c.tno
                                And b.Locationcode = a.locationcode
                                And b.NecessitySlipDate = a.EquipmentLogBookDate
                                And b.shiftcode = 'NS')
                           Else
                            Null
                         End As NightShiftDieselQty,
                         Sum(d.nooftrips) As VLogBookTrips,
                         
                         Sum(d.qty) As AchivedQuantity
                        
                          From EquipmentLogBook a,
                               EquipmentLogBookDetail b,
                               Equipment c, --, JobType j
                               (Select aa.locationcode,
                                       bb.EquipmentTno,
                                       bb.Jobtypecode,
                                       aa.shiftcode,
                                       aa.vehiclelogbookdate,
                                       
                                       Sum(bb.nooftrips) As nooftrips,
                                       Sum(gettripaverageweight(aa.companycode,
                                                                aa.locationcode,
                                                                BB.JOBTYPECODE,
                                                                DD.manufacturemodelcode,
                                                                AA.vEHICLELogBookDate) *
                                           bb.nooftrips) As qty
                                  From Vehiclelogbook       aa,
                                       VehicleLogBookDetail bb,
                                       CompanyVehicle       cc,
                                       Equipment            DD
                                 Where aa.tno = bb.tno
                                   And AA.VEHICLENO = CC.COMPANYVEHICLENO
                                   And CC.MODULETNO = DD.TNO
                                   And VehicleLogbookDate Between :P410_FROMDATE and :P410_TODATE
                                --          And aa.locationcode = :P405_LOCATION
                                 Group By aa.locationcode,
                                          bb.EquipmentTno,
                                          bb.Jobtypecode,
                                          aa.shiftcode,
                                          aa.vehiclelogbookdate) d
                         Where 1 = 1
                           And a.TNo = b.TNo
                           And a.EquipmentTNo = c.TNo
                           And a.Locationcode = d.Locationcode
                           And a.EquipmentLogBookDate = d.VehicleLogBookDate
                           And c.tno = d.Equipmenttno
                           And a.shiftcode = d.shiftcode
                              
                					and a.Equipmentlogbookdate between :P410_FROMDATE and :P410_TODATE
                					and instr(':'||:P410_COMPANY||':',':'||a.CompanyCode||':') > 0
                          and ( :P410_LOCATION IS NULL OR instr(':'||:P410_LOCATION||':',':'||a.LocationCode||':') > 0 )
                					and ( :P410_DOORNO IS NULL OR instr(':'||:P410_DOORNO||':',':'||c.equipmentid||':') > 0 ) 
                					and ( :P410_EQUIPMENTGROUP IS NULL OR instr(':'||:P410_EQUIPMENTGROUP||':',':'||c.EquipmentGroupCode||':') > 0 )
                         Group By GetLocationName(a.LocationCode),
                                  c.EquipmentId,
                                  a.EquipmentLogBookDate,
                                  --j.JobTypeName,
                                  A.LOCATIONCODE,
                                  getdailyproductionCapacity(a.companycode,
                                                             a.locationcode,
                                                             Null,
                                                             c.manufacturemodelcode,
                                                             a.EquipmentLogBookDate)) x
                
                 Group By x.location,x.locationcode
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
