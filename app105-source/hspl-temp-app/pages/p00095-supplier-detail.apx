    process fetch-supplier-detail (
        name: Fetch Supplier Detail
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Select
                      a.TNo,
                      a.PartyCode,
                      a.PartyName,
                      a.PartyTypeCode,
                      a.PrintName,
                      a.PartyShortName,
                      GetPartyName(a.ParentCode) as ParentGroup,
                      a.OfficeAddress1||''||a.OfficeAddress2 as OfficeAddress,
                      GetCityName(a.OfficeCityCode) as OfficeCity,
                      GetStateName(a.OfficeStateCode) as OfficeState,
                      a.OfficePinCode,
                      a.OfficePhoneNo,
                      a.OfficeEmail,
                      a.WorksAddress1||''||a.WorksAddress2 as WorksAddress,
                      GetCityName(a.WorksCityCode) as WorksCity,
                      GetStateName(a.WorksStateCode) as WorksState,
                      a.WorksPinCode,
                      a.WorksPhoneNo,
                      a.WorksEmail,
                      GetPartyAttributeValue(a.PartyCode,'GSTINNO') as GSTNO,
                      GetPartyAttributeValue(a.PartyCode,'PANNO') as PANNO,
                      a.ContactPerson,
                      a.ContactNo,
                      a.OwnerName
                      into
                      :P95_TNO,
                      :P95_PARTYCODE,
                      :P95_PARTYNAME,
                      :P95_PARTYTYPECODE,
                      :P95_PRINTNAME,
                      :P95_PARTYSHORTNAME,
                      :P95_PARENTGROUP,
                      :P95_OFFICEADDRESS,
                      :P95_OFFICECITY,
                      :P95_OFFICESTATE,
                      :P95_OFFICEPINCODE,
                      :P95_OFFICEPHONENO,
                      :P95_OFFICEEMAIL,
                      :P95_WORKSADDRESS,
                      :P95_WORKSCITY,
                      :P95_WORKSSTATE,
                      :P95_WORKSPINCODE,
                      :P95_WORKSPHONENO,
                      :P95_WORKSEMAIL,
                      :P95_GSTNO,
                      :P95_PANNO,
                      :P95_CONTACTPERSON,
                      :P95_CONTACTNO,
                      :P95_OWNERNAME
                From  Party a
                Where a.PartyCode = :P95_SUPPLIERCODE;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 7882651484629856
        }
    )

)

