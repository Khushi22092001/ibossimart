page 95 (
    name: Supplier Detail
    alias: SUPPLIER-DETAIL
    title: Supplier Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .background1{background-color: gainsboro;}
            #MYID .t-Form-label {font-weight: bold;}
            #MYID .apex-item-display-only {font-weight: normal;}
            ```
    }
    security {
        formAutoComplete: false
    }

    region supplier-details (
        name: Supplier Details
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--stacked
                t-Region--hiddenOverflow
                t-Form--standardPadding
                t-Form--stretchInputs
                t-Form--leftLabels
            ]
            cssClasses: background1
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
    )

