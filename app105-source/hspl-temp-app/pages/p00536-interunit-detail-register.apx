    region interunit-detail-register (
        name: Interunit Detail Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region interunit-detail-register-2 (
        name: Interunit Detail Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    x.*
                From 
                (Select 
                    c.LocationName,
                    a.CCInvoiceNo,
                    a.CCInvoiceDate,
                    d.ItemName as Material,
                    e.ItemSpecificationName,
                    f.ItemLengthName,
                    b.Quantity1 as CCInvoiceQty,
                    i.LocationName as MaterialLoc,
                    h.MaterialInNo,
                    h.MaterialInDate,
                    j.ItemName as MaterialInItem,
                    k.ItemSpecificationName as MaterialInSpec,
                    l.ItemLengthName as MaterialLength,
                    g.Quantity1 as MaterialQty,
                    r.LocationName as GRNLocation,
                    m.GRNNo,
                    m.GRNDate,
                    o.ItemName as GRNItem,
                    p.ItemSpecificationName as GRNSpec,
                    q.ItemLengthName as GRNLength,
                    n.ChalanQuantity1 as GRNQty,
                    s.InspectionNo,
                    t.DInspectionNo,
                    t.DInspectionDate,
                    Case When u.VoucherNo is not null then 'POSTED'
                    When u.VoucherNo is null then 'NOT POSTED'
                    End as DVoucherStatus 
                From CCInvoice a, CCInvoiceDetail b, Location c, Item d, ItemSpecification e, ItemLength f, MaterialInDetail g, MaterialIn h, Location i,
                Item j, ItemSpecification k, ItemLength l, GRN m, GRNDetail n, Item o, ItemSpecification p, ItemLength q, Location r, Inspection s, 
                DInspection t, Voucher u
                Where a.Tno = b.Tno(+)
                    and a.LocationCode = c.LocationCode(+)
                    and b.ItemCode = d.ItemCode(+)
                    and b.ItemSpecificationCode = e.ItemSpecificationCode(+)
                    and b.ItemLengthCode = f.ItemLengthCode(+)
                    and a.Tno = g.ReferenceTno(+)
                    and b.ItemCode = g.ItemCode(+)
                    and b.ItemSpecificationCode = g.ItemSpecificationCode(+)
                    and b.ItemLengthCode = g.ItemLengthCode(+)
                --    and b.Quantity1 = g.Quantity1(+)
                    and g.Tno = h.Tno(+)
                    and h.LocationCode = i.LocationCode(+)
                    and g.ItemCode = j.ItemCode(+)
                    and g.ItemSpecificationCode = k.ItemSpecificationCode(+)
                    and g.ItemLengthCode = l.ItemLengthCode(+)
                    and h.Tno = m.MaterialInTno
                    and m.Tno = n.Tno(+)
                    and g.ItemCode = n.ItemCode(+)
                    and g.ItemSpecificationCode = n.ItemSpecificationCode(+)
                    and g.ItemLengthCode = n.ItemLengthCode(+)
                --    and g.Quantity1 = n.ReceivedQuantity1WithoutQC(+)
                    and n.ItemCode = o.ItemCode
                    and n.ItemSpecificationCode = p.ItemSpecificationCode
                    and n.ItemLengthCode = q.ItemLengthCode
                    and m.LocationCode = r.LocationCode(+)
                    and m.Tno = s.GRNTno(+)
                    and s.ModuleTno = t.Tno(+)
                    and s.Tno = u.ModuleTno(+)
                    and a.DoctypeCode = 'INTERUNITTRANSFER'
                    and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    and a.CCInvoiceDate between :P536_FROMDATE and :P536_TODATE
                    -- and ( :P536_PARTYNAME IS NULL OR instr(':'||:P536_PARTYNAME||':',':'||pb.PartyCode||':') > 0 )
                    ) x
                    Where ( :P536_STATUS IS NULL OR instr(':'||:P536_STATUS||':',':'||x.DVoucherStatus||':') > 0 )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
