    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P536_PBPASSNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P536_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P536_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
