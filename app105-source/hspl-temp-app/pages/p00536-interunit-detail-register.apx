    pageItem P536_CCINVOICE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: CC Invoice No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
