page 181 (
    name: Storage Location
    alias: STORAGE-LOCATION1
    title: Storage Location
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: false
    }

    region storagelocation (
        name: StorageLocation
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       STORAGELOCATIONCODE,
                       STORAGELOCATIONNAME,
                       STORAGELOCATIONSHORTNAME,
                       PARENTCODE,
                       REMARK,
                       DATECREATED,
                       DATEMODIFY,
                       CREATOR,
                       MODULECODE,
                       MODULETNO,
                       ISOUTOFPREMISES,
                       LOCATIONCODE,
                       CREATIONTIME,
                       COMPANYCODE,
                       ISTANK,
                       LATITUDE,
                       LONGITUDE,
                       HEIGHTINCM,
                       LENGTHINCM,
                       WIDTHINCM,
                       CAPACITYINMT,
                       CALIBRATION,
                       ISCONICAL,
                       CONEVOLUMEINMT,
                       DIAINCM,
                       TANKTYPECODE,
                       READINGMETHOD,
                       ITEMCODE
                  from PBS.STORAGELOCATION
                ```
            pageItemsToSubmit: P181_STORAGELOCATION
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

