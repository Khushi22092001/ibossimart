    process initialize-form-storage-location (
        name: Initialize form Storage Location
        type: formInitialization
        formRegion: @storagelocation
        navigation {
            nextPkItems: P181_TNO
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 18190856046995097
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select TNO,
                       STORAGELOCATIONCODE,
                       STORAGELOCATIONNAME,
                       STORAGELOCATIONSHORTNAME,
                       PARENTCODE,
                       REMARK,
                       DATECREATED,
                       DATEMODIFY,
                       CREATOR,
                       MODULECODE,
                       MODULETNO,
                       ISOUTOFPREMISES,
                       LOCATIONCODE,
                       CREATIONTIME,
                       COMPANYCODE,
                       ISTANK,
                       LATITUDE,
                       LONGITUDE,
                       HEIGHTINCM,
                       LENGTHINCM,
                       WIDTHINCM,
                       CAPACITYINMT,
                       CALIBRATION,
                       ISCONICAL,
                       CONEVOLUMEINMT,
                       DIAINCM,
                       TANKTYPECODE,
                       READINGMETHOD,
                       ITEMCODE
                 INTO  :P181_TNO,
                       :P181_STORAGELOCATIONCODE,
                       :P181_STORAGELOCATIONNAME,
                       :P181_STORAGELOCATIONSHORTNAME,
                       :P181_PARENTCODE,
                       :P181_REMARK,
                       :P181_DATECREATED,
                       :P181_DATEMODIFY,
                       :P181_CREATOR,
                       :P181_MODULECODE,
                       :P181_MODULETNO,
                       :P181_ISOUTOFPREMISES,
                       :P181_LOCATIONCODE,
                       :P181_CREATIONTIME,
                       :P181_COMPANYCODE,
                       :P181_ISTANK,
                       :P181_LATITUDE,
                       :P181_LONGITUDE,
                       :P181_HEIGHTINCM,
                       :P181_LENGTHINCM,
                       :P181_WIDTHINCM,
                       :P181_CAPACITYINMT,
                       :P181_CALIBRATION,
                       :P181_ISCONICAL,
                       :P181_CONEVOLUMEINMT,
                       :P181_DIAINCM,
                       :P181_TANKTYPECODE,
                       :P181_READINGMETHOD,
                       :P181_ITEMCODE
                  from PBS.STORAGELOCATION
                  WHERE STORAGELOCATIONCODE = :P181_STORAGELOCATION;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 18193878731995127
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 11
            }
        }
    )

)

