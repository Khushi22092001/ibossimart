    region kpi-strip (
        name: Group KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Fy As (
                       /* Always exactly one row. A From Date outside every defined
                          financial year would otherwise empty this CTE and, with it,
                          every aggregate downstream. Falling back to the From Date
                          itself makes the opening nil and leaves movement intact; the
                          header chip already says the date is outside any known year. */
                       Select nvl((Select f.FinancialYearBegin From FinancialYear f
                                    Where to_date(:P676_FROMDATE,'DD-MM-RRRR') Between f.FinancialYearBegin And f.FinancialYearEnd),
                                  to_date(:P676_FROMDATE,'DD-MM-RRRR')) Fb From dual),
                     Carry As (Select v.Tno From Voucher v Where v.VoucherNo = 'OPENING'),
                     Members As (
                       Select p.PartyCode From Party p
                        Start With p.PartyCode = :P676_GROUP
                      Connect By Prior p.PartyCode = p.ParentCode),
                     Op As (Select o.AccountCode Acct, Sum(nvl(o.OpeningAmount,0)) Amt From Opening o, Fy
                             Where o.OpeningDate = Fy.Fb
                               And o.AccountCode In (Select PartyCode From Members)
                               And ((Select GetUserPanelAB_apex() From dual) Is Null Or 'A' = (Select GetUserPanelAB_apex() From dual))
                               And (:P676_PANEL Is Null Or 'A' = :P676_PANEL)
                               And (:P676_COMPANY Is Null Or o.CompanyCode = :P676_COMPANY)
                               And (:P676_LOCATION Is Null Or o.LocationCode = :P676_LOCATION)
                             Group By o.AccountCode),
                     Mv As (Select d.AccountCode Acct,
                                   Sum(Case When d.VoucherDate < to_date(:P676_FROMDATE,'DD-MM-RRRR') Then nvl(d.Amount,0) Else 0 End) Pre,
                                   Sum(Case When d.VoucherDate >= to_date(:P676_FROMDATE,'DD-MM-RRRR') And nvl(d.Amount,0) < 0 Then -d.Amount Else 0 End) Dr,
                                   Sum(Case When d.VoucherDate >= to_date(:P676_FROMDATE,'DD-MM-RRRR') And nvl(d.Amount,0) > 0 Then  d.Amount Else 0 End) Cr,
                                   Count(Case When d.VoucherDate >= to_date(:P676_FROMDATE,'DD-MM-RRRR') Then 1 End) Lines,
                                   Max(d.VoucherDate) LastMove
                              From VoucherDetail d, Fy
                             Where d.VoucherDate >= Fy.Fb And d.VoucherDate < to_date(:P676_TODATE,'DD-MM-RRRR') + 1
                               And d.Tno Not In (Select Tno From Carry)
                               And d.AccountCode In (Select PartyCode From Members)
                               And ((Select GetUserPanelAB_apex() From dual) Is Null Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                               And (:P676_PANEL Is Null Or d.Panel = :P676_PANEL)
                               And (:P676_COMPANY Is Null Or d.CompanyCode = :P676_COMPANY)
                               And (:P676_LOCATION Is Null Or d.LocationCode = :P676_LOCATION)
                             Group By d.AccountCode),
                     Bal As (Select nvl(o.Acct,m.Acct) Acct, nvl(o.Amt,0)+nvl(m.Pre,0) Opn,
                                    nvl(m.Dr,0) Dr, nvl(m.Cr,0) Cr, nvl(m.Lines,0) Lines, m.LastMove
                               From Op o Full Outer Join Mv m On m.Acct = o.Acct),
                     T As (Select Sum(Greatest(-Opn,0)) OpDr, Sum(Greatest(Opn,0)) OpCr,
                                  Sum(Dr) PDr, Sum(Cr) PCr,
                                  Sum(Greatest(-(Opn-Dr+Cr),0)) ClDr, Sum(Greatest((Opn-Dr+Cr),0)) ClCr,
                                  Count(*) Accts, Count(Case When Lines > 0 Then 1 End) Moved,
                                  Max(LastMove) LastMove
                             From Bal),
                     Kids As (Select Count(*) N From Party p Where p.ParentCode = :P676_GROUP)
                Select '<div class="ds-kpi ds-kpi--dr" title="Closing debit for every posting account beneath this group.">'
                    || '<span class="ds-kpi-ic fa fa-arrow-circle-o-left"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Closing Debit</div><div class="ds-kpi-n">&#8377;'
                    || Case When t.ClDr >= 10000000 Then to_char(t.ClDr/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When t.ClDr >= 100000   Then to_char(t.ClDr/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(nvl(t.ClDr,0),'FM99G99G990D00') End || '</div>'
                    || '<div class="ds-kpi-sub">as at ' || :P676_TODATE || '</div></div></div>' As KPI1,
                
                       '<div class="ds-kpi ds-kpi--cr" title="Closing credit for every posting account beneath this group.">'
                    || '<span class="ds-kpi-ic fa fa-arrow-circle-o-right"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Closing Credit</div><div class="ds-kpi-n">&#8377;'
                    || Case When t.ClCr >= 10000000 Then to_char(t.ClCr/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When t.ClCr >= 100000   Then to_char(t.ClCr/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(nvl(t.ClCr,0),'FM99G99G990D00') End || '</div>'
                    || '<div class="ds-kpi-sub">as at ' || :P676_TODATE || '</div></div></div>' As KPI2,
                
                       '<div class="ds-kpi ds-kpi--value" title="Opening debit less opening credit for this group, carried in from the year begin.">'
                    || '<span class="ds-kpi-ic fa fa-flag-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Opening Net</div><div class="ds-kpi-n">&#8377;'
                    || Case When Abs(t.OpDr-t.OpCr) >= 10000000 Then to_char(Abs(t.OpDr-t.OpCr)/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When Abs(t.OpDr-t.OpCr) >= 100000   Then to_char(Abs(t.OpDr-t.OpCr)/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(Abs(nvl(t.OpDr,0)-nvl(t.OpCr,0)),'FM99G99G990D00') End || '</div>'
                    || '<div class="ds-kpi-sub">' || Case When t.OpDr >= t.OpCr Then 'debit' Else 'credit' End
                       || ' at ' || :P676_FROMDATE || '</div></div></div>' As KPI3,
                
                       '<div class="ds-kpi ds-kpi--move" title="Debit and credit posted to this group between From Date and To Date.">'
                    || '<span class="ds-kpi-ic fa fa-exchange"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Period Movement</div><div class="ds-kpi-n">&#8377;'
                    || Case When (t.PDr+t.PCr) >= 10000000 Then to_char((t.PDr+t.PCr)/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When (t.PDr+t.PCr) >= 100000   Then to_char((t.PDr+t.PCr)/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(nvl(t.PDr,0)+nvl(t.PCr,0),'FM99G99G990D00') End || '</div>'
                    || '<div class="ds-kpi-sub">Dr &#8377;' || to_char(nvl(t.PDr,0)/100000,'FM99G990D00') || ' L &middot; Cr &#8377;'
                       || to_char(nvl(t.PCr,0)/100000,'FM99G990D00') || ' L</div></div></div>' As KPI4,
                
                       '<div class="ds-kpi ds-kpi--struct" title="Posting accounts beneath this group that carry an opening balance or a movement.">'
                    || '<span class="ds-kpi-ic fa fa-list-ul"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Member Accounts</div><div class="ds-kpi-n">'
                    || to_char(nvl(t.Accts,0),'FM999G99G990') || '</div>'
                    || '<div class="ds-kpi-sub">' || to_char(nvl(t.Moved,0),'FM999G990') || ' moved &middot; '
                       || to_char(k.N,'FM999G990') || ' direct child node(s)</div></div></div>' As KPI5,
                
                       '<div class="ds-kpi ds-kpi--slate" title="Newest voucher date touching this group within the financial year and scope.">'
                    || '<span class="ds-kpi-ic fa fa-clock-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Last Posting</div><div class="ds-kpi-n">'
                    || nvl(to_char(t.LastMove,'DD-MM-RRRR'),'&mdash;') || '</div>'
                    || '<div class="ds-kpi-sub">'
                       || Case When t.LastMove Is Null Then 'Nothing posted to this group this year'
                               Else 'within the current financial year' End || '</div></div></div>' As KPI6
                  From T t Cross Join Kids k
                ```
            pageItemsToSubmit: [
                P676_GROUP
                P676_FROMDATE
                P676_TODATE
                P676_COMPANY
                P676_LOCATION
                P676_PANEL
            ]
        }
        layout {
            sequence: 12
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: KPI1
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI2 (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: KPI2
            }
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
        )

        column KPI3 (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: KPI3
            }
