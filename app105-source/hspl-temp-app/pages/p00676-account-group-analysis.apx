page 676 (
    name: Account Group Analysis
    alias: ACCOUNT-GROUP-ANALYSIS
    title: Account Group Analysis
    pageGroup: @financial-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Second level of the Trial Balance drill-down: one account group, everything beneath it. Balances are built exactly as on page 675 - Opening table at the financial-year begin, plus VoucherDetail movement, with a debit stored as a negative Amount - so any figure here ties straight back to the trial balance row that was clicked.
    }

    region children (
        name: Direct Children
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Fy As (
                       /* Always exactly one row. A From Date outside every defined
                          financial year would otherwise empty this CTE and, with it,
                          every aggregate downstream. Falling back to the From Date
                          itself makes the opening nil and leaves movement intact; the
                          header chip already says the date is outside any known year. */
                       Select nvl((Select f.FinancialYearBegin From FinancialYear f
                                    Where to_date(:P676_FROMDATE,'DD-MM-RRRR') Between f.FinancialYearBegin And f.FinancialYearEnd),
                                  to_date(:P676_FROMDATE,'DD-MM-RRRR')) Fb From dual),
                     Carry As (Select v.Tno From Voucher v Where v.VoucherNo = 'OPENING'),
                     /* Every posting account mapped to the direct child it hangs under.
                        Connect_By_Root gives the mapping in one walk of the subtree. */
                     Map As (
                       Select Connect_By_Root p.PartyCode Child, p.PartyCode Leaf
                         From Party p
                        Start With p.ParentCode = :P676_GROUP
                      Connect By Prior p.PartyCode = p.ParentCode),
                     Op As (Select o.AccountCode Acct, Sum(nvl(o.OpeningAmount,0)) Amt From Opening o, Fy
                             Where o.OpeningDate = Fy.Fb
                               And ((Select GetUserPanelAB_apex() From dual) Is Null Or 'A' = (Select GetUserPanelAB_apex() From dual))
                               And (:P676_PANEL Is Null Or 'A' = :P676_PANEL)
                               And (:P676_COMPANY Is Null Or o.CompanyCode = :P676_COMPANY)
                               And (:P676_LOCATION Is Null Or o.LocationCode = :P676_LOCATION)
                             Group By o.AccountCode),
                     Mv As (Select d.AccountCode Acct,
                                   Sum(Case When d.VoucherDate < to_date(:P676_FROMDATE,'DD-MM-RRRR') Then nvl(d.Amount,0) Else 0 End) Pre,
                                   Sum(Case When d.VoucherDate >= to_date(:P676_FROMDATE,'DD-MM-RRRR') And nvl(d.Amount,0) < 0 Then -d.Amount Else 0 End) Dr,
                                   Sum(Case When d.VoucherDate >= to_date(:P676_FROMDATE,'DD-MM-RRRR') And nvl(d.Amount,0) > 0 Then  d.Amount Else 0 End) Cr,
                                   Max(d.VoucherDate) LastMove
                              From VoucherDetail d, Fy
                             Where d.VoucherDate >= Fy.Fb And d.VoucherDate < to_date(:P676_TODATE,'DD-MM-RRRR') + 1
                               And d.Tno Not In (Select Tno From Carry)
                               And ((Select GetUserPanelAB_apex() From dual) Is Null Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                               And (:P676_PANEL Is Null Or d.Panel = :P676_PANEL)
                               And (:P676_COMPANY Is Null Or d.CompanyCode = :P676_COMPANY)
                               And (:P676_LOCATION Is Null Or d.LocationCode = :P676_LOCATION)
                             Group By d.AccountCode),
                     /* Sides settled at the posting account, then rolled to the child. */
                     Bal As (Select nvl(o.Acct,m.Acct) Acct,
                                    Greatest(-(nvl(o.Amt,0)+nvl(m.Pre,0)),0) OpDr,
                                    Greatest( (nvl(o.Amt,0)+nvl(m.Pre,0)),0) OpCr,
                                    nvl(m.Dr,0) Dr, nvl(m.Cr,0) Cr,
                                    Greatest(-(nvl(o.Amt,0)+nvl(m.Pre,0)-nvl(m.Dr,0)+nvl(m.Cr,0)),0) ClDr,
                                    Greatest( (nvl(o.Amt,0)+nvl(m.Pre,0)-nvl(m.Dr,0)+nvl(m.Cr,0)),0) ClCr,
                                    m.LastMove
                               From Op o Full Outer Join Mv m On m.Acct = o.Acct)
                Select Case When Exists (Select 1 From Party c Where c.ParentCode = mp.Child)
                            Then '<a href="' || apex_page.get_url(p_page => 676, p_clear_cache => '676',
                                     p_items => 'P676_GROUP,P676_FROMDATE,P676_TODATE,P676_COMPANY,P676_LOCATION,P676_PANEL',
                                     p_values => mp.Child || ',' || :P676_FROMDATE || ',' || :P676_TODATE || ','
                                                 || :P676_COMPANY || ',' || :P676_LOCATION || ',' || :P676_PANEL)
                                 || '">' || apex_escape.html(cp.PartyName) || '</a>'
                            Else '<a href="' || apex_page.get_url(p_page => 677, p_clear_cache => '677',
                                     p_items => 'P677_ACCOUNT,P677_FROMDATE,P677_TODATE,P677_COMPANY,P677_LOCATION,P677_PANEL',
                                     p_values => mp.Child || ',' || :P676_FROMDATE || ',' || :P676_TODATE || ','
                                                 || :P676_COMPANY || ',' || :P676_LOCATION || ',' || :P676_PANEL)
                                 || '">' || apex_escape.html(cp.PartyName) || '</a>' End As CHILD,
                       mp.Child                                As CHILD_CODE,
                       Case When Exists (Select 1 From Party c Where c.ParentCode = mp.Child) Then 'Group' Else 'Ledger' End As KIND,
                       Count(Distinct b.Acct)                  As MEMBER_ACCOUNTS,
                       Round(Sum(b.OpDr),2)                    As OPENING_DEBIT,
                       Round(Sum(b.OpCr),2)                    As OPENING_CREDIT,
                       Round(Sum(b.Dr),2)                      As PERIOD_DEBIT,
                       Round(Sum(b.Cr),2)                      As PERIOD_CREDIT,
                       Round(Sum(b.ClDr),2)                    As CLOSING_DEBIT,
                       Round(Sum(b.ClCr),2)                    As CLOSING_CREDIT,
                       Round(Abs(Sum(b.ClDr)-Sum(b.ClCr))
                             / nullif(Sum(Abs(Sum(b.ClDr)-Sum(b.ClCr))) Over (),0) * 100, 2) As SHARE_PCT,
                       Max(b.LastMove)                         As LAST_POSTING
                  From Map mp
                  Join Bal b   On b.Acct = mp.Leaf
                  Join Party cp On cp.PartyCode = mp.Child
                 Group By mp.Child, cp.PartyName
                 Order By Abs(Sum(b.ClDr)-Sum(b.ClCr)) Desc
                ```
            pageItemsToSubmit: [
                P676_GROUP
                P676_FROMDATE
                P676_TODATE
                P676_COMPANY
                P676_LOCATION
                P676_PANEL
            ]
        }
        layout {
            sequence: 22
            slot: body
        }
