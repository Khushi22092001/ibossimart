    region command-header (
        name: Account Group Analysis
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-fin-head">'
                    || '<div class="ds-fin-eyebrow">Finance &middot; General Ledger &middot; Group</div>'
                    || '<h1 class="ds-fin-title">'
                       || apex_escape.html(nvl((Select p.PartyName From Party p Where p.PartyCode = :P676_GROUP),'Account Group')) || '</h1>'
                    || '<div class="ds-fin-sub">Every posting account beneath this group, its direct children, and how the position moved through the period</div>'
                    || '<div class="ds-fin-context">'
                    || '<span class="ds-fin-chip"><span class="fa fa-hashtag"></span>Group code <b>' || apex_escape.html(:P676_GROUP) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-level-up"></span>Sits under <b>'
                       || apex_escape.html(nvl((Select gp.PartyName From Party p Join Party gp On gp.PartyCode = p.ParentCode
                                                 Where p.PartyCode = :P676_GROUP),'top of the chart of accounts')) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-calendar"></span>Period <b>' || :P676_FROMDATE || ' &rarr; ' || :P676_TODATE || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P676_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P676_LOCATION),'All locations')) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                               Then (Select GetUserPanelAB_apex() From dual) || ' (enforced)'
                               When :P676_PANEL Is Not Null Then :P676_PANEL Else 'A + B' End || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
            pageItemsToSubmit: [
                P676_GROUP
                P676_FROMDATE
                P676_TODATE
                P676_COMPANY
                P676_LOCATION
                P676_PANEL
            ]
