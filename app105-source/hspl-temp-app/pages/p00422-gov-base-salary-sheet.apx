page 422 (
    name: GOV BASE SALARY SHEET
    alias: GOV-BASE-SALARY-SHEET
    title: GOV BASE SALARY SHEET
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region gov-base-salary-sheet (
        name: GOV BASE SALARY SHEET
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                GetCompanyName(a.CompanyCode) as Company,
                a.SalaryNo,
                A.FINANCIALYEARCODE,
                GETPARTYNAME(B.SALARYACCOUNTCODE) SALARYPOSTINGAC,
                a.SalaryDate,
                a.SalaryFromDate,
                a.SalaryToDate,
                getemployeestafftypecode(B.EMPLOYEECODE,A.SALARYFROMDATE) staffType,
                to_char(a.SalaryFromDate,'MON-RRRR') SalaryMonth,
                --getdepartmentname(b.departmentcode) Department ,
                getemployeedepartmentname(a.employeecode,A.SALARYFROMDATE) Department,
                getemployeedesignationname(a.employeecode,a.salaryfromdate) Designation,
                getemployeelocationname(a.employeecode,a.salaryfromdate) Location,
                
                --getemployeelocationcode(a.employeecode,a.salaryfromdate) locationcode,
                --getemployeedepartmentcode(a.employeecode,a.salaryfromdate) departmentcode,
                --getemployeedesignationcode(a.employeecode,a.salaryfromdate) designationcode,
                
                --A.COMPANYCODE,
                b.pfaccountno,
                B.UAN As UANNO,
                b.EmployeeName,
                --B.EMPLOYEECODE,
                B.DATEOFJOINING As DOJ,
                B.ESICACCOUNTNO As ESICNO,
                NULL AS NoOfTrip,
                getEmployeeEmployeeID(a.EmployeeCode, a.SalaryFromDate) EmpID,
                C.BANKNAME,
                B.BANKACCOUNTNO,
                GetSalarySalaryHeadAmount(A.TNO,'TD') TD,
                GetSalarySalaryHeadAmount(A.TNO,'PR') PR,
                GetSalarySalaryHeadAmount(A.TNO,'CL') CL,
                GetSalarySalaryHeadAmount(A.TNO,'EL') EL,
                GetSalarySalaryHeadAmount(A.TNO,'ML') ML,
                GetSalarySalaryHeadAmount(A.TNO,'AB') AB,
                GetSalarySalaryHeadAmount(A.TNO,'WD') WD,
                GetSalarySalaryHeadAmount(A.TNO,'OH') OH,
                GetSalarySalaryHeadAmount(A.TNO,'NH') NH,
                GetSalarySalaryHeadAmount(A.TNO,'OD') OD,
                GetSalarySalaryHeadAmount(A.TNO,'LWP') LWP,
                GetSalarySalaryHeadAmount(A.TNO,'COFF') COFF,
                GetSalarySalaryHeadAmount(A.TNO,'PL') PL,
                GetSalarySalaryHeadAmount(A.TNO,'PD') PD,
                GetSalarySalaryHeadAmount(A.TNO,'WOFF') WOFF,
                
                
                (SELECT Y.SALARYSCHEMENAME FROM EMPLOYEESALARY X, SALARYSCHEME Y WHERE X.SALARYSCHEMECODE=Y.SALARYSCHEMECODE
                AND X.TNO = A.EMPLOYEESALARYTNO) SALARYSCHEME,
                GetSalarySalaryHeadAmount(a.TNo, 'CTC') PAY_CTC,
                GetSalarySalaryHeadAmount(a.TNo, 'BASIC')  Pay_Basic,
                GetSalarySalaryHeadAmount(a.TNo, 'HRA')    Pay_HRA        ,
                GetSalarySalaryHeadAmount(a.TNo, 'MEDICAL') Pay_Medical,
                GetSalarySalaryHeadAmount(a.TNo, 'CONVEYANCE') Pay_Conv,
                GetSalarySalaryHeadAmount(a.TNo, 'SPECIAL') Pay_Spl,
                GetSalarySalaryHeadAmount(a.TNo, 'LTA') Pay_LTA,
                GetSalarySalaryHeadAmount(a.TNo, 'MISCALL') Pay_MISCALL,
                GetSalarySalaryHeadAmount(a.TNo, 'CARREIMBURSEMENT') PAY_CARREIMBURSEMENT,
                GetSalarySalaryHeadAmount(a.TNo, 'CEA') PAY_CEA,
                GetSalarySalaryHeadAmount(a.TNo, 'HOSTEL') PAY_HOSTEL,
                GetSalarySalaryHeadAmount(a.TNo, 'SPECIAL') PAY_SPECIAL,
                GetSalarySalaryHeadAmount(a.TNo, 'SOED') SOED,
                GetSalarySalaryHeadAmount(a.TNo, 'PFEMPLOYER') PAY_PFEMPLOYER,
                GetSalarySalaryHeadAmount(a.TNo, 'PFEMPLOYEE') PAY_PFEMPLOYEE,
                GetSalarySalaryHeadAmount(a.TNo, 'ADMINCHARGE') PAY_ACEMPLOYER,
                GetSalarySalaryHeadAmount(a.TNo, 'BONUS') PAY_BONUS,
                GetSalarySalaryHeadAmount(a.TNo, 'LEAVEINCASH') PAY_LEAVEINCASH,
                GetSalarySalaryHeadAmount(a.TNo, 'ESICEMPLOYER') PAY_ESICEMPLOYER,
                GetSalarySalaryHeadAmount(a.TNo, 'ESICEMPLOYEE') PAY_ESICEMPLOYEE,
                GetSalarySalaryHeadAmount(a.TNo, 'GROSSSALARY') PAY_GROSSSALARY,
                GetSalarySalaryHeadAmount(a.TNo, 'PAYGROSSDEDUCTION') PAY_GROSSDEDUCTION,
                GetSalarySalaryHeadAmount(a.TNo, 'PAYNET') PAY_NET,
                
                
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDCTC') EARNEDCTC,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDBASIC')  EarnedBasic,
                GetSalarySalaryHeadAmount(a.TNo, 'GOVBASIC')  EarnedGOVBASIC,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDHRA')    EarnedHRA        ,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDMEDICAL') EarnedMedical,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDCONVEYANCE') EarnedConv,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDSPECIAL') EarnedSpl,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDLTA') EarnedLTA,
                GetSalarySalaryHeadAmount(a.TNo, 'FOODALLOWANCE') EarnedFOODALLOWANCE,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDCARREIMB') EARNEDCARREIMB,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDCEA') EARNEDCEA,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDHOSTEL') EARNEDHOSTEL,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDOTHERINCOME') EARNEDOTHERINCOME,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDBONUS') EARNEDEARNEDBONUS,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDLEAVEINCASH') EARNEDEARNEDLEAVEINCASH,
                
                GetSalarySalaryHeadAmount(a.TNo, 'REFUNDAMOUNT') REFUND,
                
                
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDMISCALL') MISCALL,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDARREAR') ARREAR ,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDPERK') Perk,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDOTHERINCOME') OtherEarning ,
                GetSalarySalaryHeadAmount(a.TNo,'EARNEDANREWRAD') Annual,
                GetSalarySalaryHeadAmount(a.TNo, 'PFCOMPCONTRIBUTION') EARNEDPFCOMPCONTRIBUTION,
                GetSalarySalaryHeadAmount(a.TNo,'PFEMPLOYEECONTRIBUTION') EARNEDPFEMPLOYEECONTRIBUTION,
                GetSalarySalaryHeadAmount(a.TNo,'ADMINCHARGECOMPCONTRIBUTION') EARNEDADMINCHARGECOMPCONTRIBUTION,
                GetSalarySalaryHeadAmount(a.TNo, 'ESICCOMPCONTRIBUTION') EARNEDESICCOMPCONTRIBUTION,
                GetSalarySalaryHeadAmount(a.TNo,'ESICEMPLOYEECONTRIBUTION') EARNEDESICEMPLOYEECONTRIBUTION,
                GetSalarySalaryHeadAmount(a.TNo, 'TEMPESICCOMP') TEMPESICCOMP,
                GetSalarySalaryHeadAmount(a.TNo,'TEMPESICEMP') TEMPESICEMP,
                GetSalarySalaryHeadAmount(a.TNo,'PTAX') PTAX,
                
                
                GetSalarySalaryHeadAmount(a.TNo, 'SALARYADVANCEDED') SalAdv,
                GetSalarySalaryHeadAmount(a.TNo, 'SALARYADVANCE') SalaryAdvance,
                GetSalarySalaryHeadAmount(a.TNo, 'RUNNINGADVANCE') RunningAdvance,
                GetSalarySalaryHeadAmount(a.TNo, 'CALCULATEPAIDDAYS') CALCULATEPAIDDAYS,
                
                
                GetSalarySalaryHeadAmount(a.TNo, 'LOANDED') LoanDed,
                GetSalarySalaryHeadAmount(a.TNo, 'CANTEENDED') CanteenDed,
                GetSalarySalaryHeadAmount(a.TNo, 'MOBILEBILLDED') MOBILEBILLDED,
                GetSalarySalaryHeadAmount(a.TNo, 'OTHERDEDUCTION') OtherDed,
                GetSalarySalaryHeadAmount(a.TNo, 'LWF') MLWF,
                
                GetSalarySalaryHeadAmount(a.TNo, 'ITAX') ITax,
                GetSalarySalaryHeadAmount(a.TNo, 'GROSSDEDUCTION') GrossDed ,
                GetSalarySalaryHeadAmount(a.TNo, 'GROSSEARNING') GrossEar ,
                GetSalarySalaryHeadAmount(a.TNo, 'NETEARNING') NetEarning,
                
                GetSalarySalaryHeadAmount(a.TNo, 'OTHOURS') OTHours ,
                GetSalarySalaryHeadAmount(a.TNo, 'OTRATE') OTRate ,
                GetSalarySalaryHeadAmount(a.TNo, 'OTAMOUNT') OTAmount ,
                GetSalarySalaryHeadAmount(a.TNo, 'EARNEDGROSSOT') EarnedGrossOT,
                
                
                b.IFSCCODE,
                --b.BankBranchName,
                d.WorkCentreName,
                f.salaryvoucherno,
                f.salaryvoucherdate
                
                --(SELECT 'HOLD' FROM HOLDSALARY X WHERE X.EMPLOYEECODE = A.EMPLOYEECODE AND getdocumentstatuscode('HOLDSALARY',X.TNO)='ACTIVE') PAYMENTSTATUS
                
                from Salary a,
                Employee b,BANK C, Workcentre d, Salaryvoucherdetail e, Salaryvoucher f
                where
                a.EmployeeCode = b.EmployeeCode
                And b.WorkcentreCode = d.WorkCentreCode(+)
                AND B.BANKCODE = C.BANKCODE(+)
                and a.tno= e.salarytno(+)
                and e.tno = f.tno(+)
                and ( :P422_DEPARTMENT IS NULL OR instr(':'||:P422_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0 )
                and ( :P422_COMPANY IS NULL OR instr(':'||:P422_COMPANY||':',':'||a.CompanyCode||':') > 0)
                and ( :P422_LOCATION IS NULL OR instr(':'||:P422_LOCATION||':',':'||a.LocationCode||':') > 0)
                and ( :P422_EMPLOYEE IS NULL OR instr(':'||:P422_EMPLOYEE||':',':'||a.EmployeeCode||':') > 0) 
                and a.SalaryFromDate between :P422_FROMDATE and :P422_TODATE
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 26012256930705636
        }

