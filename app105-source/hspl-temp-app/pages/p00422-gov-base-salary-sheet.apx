        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.EmployeeName d,
                a.EmployeeCode r
                From Employee a
                Where exists(
                   Select
                      aa.EmployeeCode
                   From Salary aa
                   Where aa.EmployeeCode = a.EmployeeCode
                )
                Order by 1
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @gov-base-salary-sheet-2
