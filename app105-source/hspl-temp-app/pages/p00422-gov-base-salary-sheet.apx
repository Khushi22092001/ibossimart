        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontSize: 14
            pageHeaderText:
                ```
                GOV BASE SALARY SHEET
                From : &P422_FROMDATE. TO &P422_TODATE.
                ```
        }

        savedReport 261445 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BANKACCOUNTNO (
