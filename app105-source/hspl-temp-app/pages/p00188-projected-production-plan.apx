    pageItem P188_ITEM (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Material
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct e.ItemName || ' ( ' || e.ItemCode As d, e.ItemCode r
                  From Item e
                 Where Exists (Select 1
                          From DAILYPRODUCTIONPLANDETAIL X
                         Where X.ITEMCODE = E.ITEMCODE)
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @projected-production-plan-2
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 50
            valuePlaceholder: "Material "
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P188_ITEMSPECIFICATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Specification
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        ee.ItemSpecificationName as d,
                        ee.ItemSpecificationCode as r
                From Item e, ItemSpecification ee
                Where ( :P188_ITEM IS NULL OR instr(':'||:P188_ITEM||':',':'||e.ItemCode||':') > 0 )
                and   e.TNo = ee.TNo
                AND EXISTS (
                    SELECT 1 FROM DAILYPRODUCTIONPLANDETAIL X
                    WHERE X.ITEMCODE = E.ITEMCODE 
                      AND X.ITEMSPECIFICATIONCODE = EE.ITEMSPECIFICATIONCODE
                
                )
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P188_ITEM
            itemsToSubmit: P188_ITEMSPECIFICATION
        }
        layout {
            sequence: 120
            region: @projected-production-plan-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
