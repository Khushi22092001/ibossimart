    process create-projected-production (
        name: create projected production
        type: executeCode
        source {
            plsqlCode: CREATEPROJECTEDPRODUCTION(:P188_FROMDATE,:P188_TODATE,:P188_ITEM,:P188_ITEMSPECIFICATION,'CO');
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 19922829418326116
        }
    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P188_MINO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P188_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P188_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 20043935147018762
        }
    )

)

