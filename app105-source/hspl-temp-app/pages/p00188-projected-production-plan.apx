page 188 (
    name: Projected Production Plan
    alias: PROJECTED-PRODUCTION-PLAN
    title: Projected Production Plan
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region projected-production (
        name: Projected Production
        type: calendar
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Rownum As TNO,
                       X.SNO As EVENT_ID,
                       x.plandate As START_DATE,
                       x.plandate As END_DATE,
                       RPAD(x.stocktype, 15, Chr(13)) || ': ' || round(x.quantity, 3) As TITLE,
                       Case
                         When Nvl(x.quantity, 0) > 0 Then
                          'apex-cal-green'
                         When Nvl(x.quantity, 0) < 0 Then
                          'apex-cal-red'
                       End As css_class
                  From (Select plandate,
                               1 As SNO,
                               '1.OPENING' As StockType,
                               openingquantity1 As Quantity
                          From temp_productionplan
                        Union All
                        Select plandate,
                               2 As SNO,
                               '2.PRODUCTION' As StockType,
                               ProductionQuantity1
                          From temp_productionplan
                        Union All
                        Select plandate,
                               3 As SNO,
                               '3.DESPATCH' As StockType,
                               DespatchQuantity1
                          From temp_productionplan
                        Union All
                        Select plandate,
                               4 As SNO,
                               '4.CLOSING' As StockType,
                               ClosingQuantity1
                          From temp_productionplan) x
                 Order By plandate, SNO
                
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                i-h640
                t-Region--hiddenOverflow
                t-Form--standardPadding
            ]
        }
        advanced {
            htmlDomId: ID_calendar
            regionDisplaySelector: true
        }
        settings {
            displayColumn: TITLE
            startDateColumn: START_DATE
            endDateColumn: END_DATE
            pkColumn: TNO
            multipleLineEvents: false
            additionalCalendarViews: [
                list
                navigation
            ]
            maxEventsDay: 4
            export: csv
        }
    )

