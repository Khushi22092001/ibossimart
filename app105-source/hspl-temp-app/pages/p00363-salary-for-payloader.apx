page 363 (
    name: Salary For Payloader
    alias: SALARY-FOR-PAYLOADER
    title: Salary For Payloader
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by aa.SalaryDate) SerialNo,
                a.EmployeeName,
                a.EMPId,
                c.DepartmentName,
                b.DesignationName,
                a.PFAccountNo,
                a.TD as TotalDays,
                a.PD as WorkingDays,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='BASIC'
                AND A.TNO = AA.TNO),0) as SalaryPerDay,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='FOODALLOWANCE'
                AND A.TNO = AA.TNO),0) as BhattaPerDay,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='EARNEDBASIC'
                AND A.TNO = AA.TNO),0) as EarnedSalary,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='EARNEDFOOD'
                AND A.TNO = AA.TNO),0) as EarnedBhatta,
                a.PAY_BONUS,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='GOVBASIC'
                AND A.TNO = AA.TNO),0) as SalaryRatePerDay,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='CALCULATEPAIDDAYS'
                AND A.TNO = AA.TNO),0) as CALCULATEDAYS,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='GROSSEARNING'
                AND A.TNO = AA.TNO),0) as GrossSalary,
                a.PAY_PFEMPLOYER,
                a.PAY_PFEMPLOYEE,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='RUNNINGADVANCE'
                AND A.TNO = AA.TNO),0) as Deduction,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='SALARYADVANCE'
                AND A.TNO = AA.TNO),0) as Salary,
                a.SalAdv,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='GROSSDEDUCTION'
                AND A.TNO = AA.TNO),0) as GROSSDEDUCTION,
                NVL((Select
                a.SalaryHeadAmount
                from SalaryDetail a
                where a.SalaryHeadCode='NETEARNING'
                AND A.TNO = AA.TNO),0) as NetPayable,
                a.REFUND
                From Salary aa,SalaryEngineDetail a, Designation b, Department c, Employee d
                Where aa.EmployeeCode = a.EmployeeCode
                and a.DesignationCode = b.DesignationCode
                and a.DepartmentCode = c.DepartmentCode
                and a.EmployeeCode = d.EmployeeCode
                and d.StaffTypeCode = 'PAYLOADER'
                and aa.SalaryDate between :P363_FROMDATE and :P363_TODATE
                and ( :P363_COMPANY IS NULL OR instr(':'||:P363_COMPANY||':',':'||aa.CompanyCode||':') > 0)
                and ( :P363_LOCATION IS NULL OR instr(':'||:P363_LOCATION||':',':'||aa.LocationCode||':') > 0)
                and ( :P363_EMPLOYEE IS NULL OR instr(':'||:P363_EMPLOYEE||':',':'||aa.EmployeeCode||':') > 0)
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 91528758159098946
        }

