page 281 (
    name: BankGaurantyType
    alias: BANKGAURANTYTYPE
    title: BankGaurantyType
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWNUM AS SERIALNO,
                       BANKGAURANTYTYPECODE AS Code,
                       BANKGAURANTYTYPENAME as Name,
                       remark 
                        from bankgaurantytype;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 15154814801592403
        }

        column CODE (
            type: plainText
            heading {
                heading: Code
                alignment: center
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:60px">#CODE#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:60px">#NAME#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 158425 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CODE (
                sequence: 2
            )

            displayColumn NAME (
                sequence: 3
            )

            displayColumn REMARK (
                sequence: 4
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

