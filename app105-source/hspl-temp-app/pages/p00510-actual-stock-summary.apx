                    show: false
                    sequence: 16
                }
            )

            sort (
                column: @ITEMNAME
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        columnGroup amount (
            heading: Amount
        )

        columnGroup quantity (
            heading: Quantity
        )

