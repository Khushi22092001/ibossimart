page 510 (
    name: Actual Stock Summary
    alias: ACTUAL-STOCK-SUMMARY
    title: Actual Stock Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region actual-stock-summary (
        name: Actual Stock Summary
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With
                -- Opening balance before from-date
                OPENBAL As
                 (Select itemcode,
                         Sum(in_qty - out_qty) As OPENING_QTY,
                         Sum(in_amt - out_amt) As OPENING_AMT
                    From (
                          -- Stock receipts before fromdate
                          Select bb.itemcode,
                                  Sum(bb.stockquantity1) As in_qty,
                                  0 As out_qty,
                                  Sum(bb.amount) As in_amt,
                                  0 As out_amt
                            From stock bb
                           Where (bb.stockdate < :P510_FROMDATE OR BB.STOCKMODULECODE='ITEMOPENING')
                           Group By bb.itemcode
                          
                          Union All
                          -- Stock usage before fromdate
                          Select aa.itemcode,
                                  0,
                                  Sum(bb.usedstockquantity1),
                                  0,
                                  Sum(aa.rate * bb.usedstockquantity1)
                            From stock aa
                            Join usedstock bb
                              On aa.tno = bb.stocktno
                           Where bb.usedstockdate < :P510_FROMDATE
                           Group By aa.itemcode
                          
                          Union All
                          -- Physical gap transactions before fromdate
                          Select d.physicalgapitemcode,
                                  Sum(d.stockquantity1), -- in_qty
                                  Sum(d.usedstockquantity1), -- out_qty
                                  Sum(d.stockamount), -- in_amt
                                  Sum(d.usedstockamount) -- out_amt
                            From physicalgapitemtransaction d
                           Where d.transactiondate < :P510_FROMDATE
                           Group By d.physicalgapitemcode)
                   Group By itemcode),
                
                -- Movements within date range
                TXN As
                 (Select itemcode,
                         Sum(stock_in) As STOCK_QTY,
                         Sum(stock_out) As USED_QTY,
                         Sum(phy_in) As PHYIN_QTY,
                         Sum(phy_out) As PHYOUT_QTY,
                         Sum(stock_in_amt) As STOCK_AMT,
                         Sum(stock_out_amt) As USED_AMT,
                         Sum(phy_in_amt) As PHYIN_AMT,
                         Sum(phy_out_amt) As PHYOUT_AMT
                    From (
                          -- Stock in
                          Select bb.itemcode,
                                  Sum(bb.stockquantity1) As stock_in,
                                  0 As stock_out,
                                  0 As phy_in,
                                  0 As phy_out,
                                  Sum(bb.amount) As stock_in_amt,
                                  0 As stock_out_amt,
                                  0 As phy_in_amt,
                                  0 As phy_out_amt
                            From stock bb
                           Where bb.stockdate Between :P510_FROMDATE And :P510_TODATE
                             AND BB.STOCKMODULECODE != 'ITEMOPENING'
                           Group By bb.itemcode
                          
                          Union All
                          -- Stock used
                          Select aa.itemcode,
                                  0,
                                  Sum(bb.usedstockquantity1),
                                  0,
                                  0,
                                  0,
                                  Sum(aa.rate * bb.usedstockquantity1),
                                  0,
                                  0
                            From stock aa
                            Join usedstock bb
                              On aa.tno = bb.stocktno
                           Where bb.usedstockdate Between :P510_FROMDATE And :P510_TODATE
                           Group By aa.itemcode
                          
                          Union All
                          -- Physical gap transactions
                          Select --d.physicalgapitemcode,
                                  E.ITEMCODE,
                                  0,
                                  0,
                                  Sum(d.stockquantity1),
                                  Sum(d.usedstockquantity1),
                                  0,
                                  0,
                                  Sum(d.stockamount),
                                  Sum(d.usedstockamount)
                            From physicalgapitemtransaction d, ITEM E
                           Where d.transactiondate Between :P510_FROMDATE And :P510_TODATE
                             AND D.PHYSICALGAPITEMCODE = E.PHYSICALGAPITEMCODE
                           Group By E.ITEMCODE --d.physicalgapitemcode
                           )
                   Group By itemcode),
                
                -- Item master
                IT As
                 (Select ITEMCODE, ITEMNAME, PHYSICALGAPITEMCODE
                    From ITEM X
                   Where X.PHYSICALGAPITEMCODE Is Not Null
                     And (:P510_ITEM Is Null Or X.ITEMCODE = :P510_ITEM) -- optional filter
                  )
                
                -- Final summary
                Select :P510_FROMDATE FROMDATE,
                       :P510_TODATE TODATE,
                       it.ITEMCODE,
                       it.ITEMNAME,
                       
                       ROUND(NVL(ob.OPENING_QTY, 0), 3) As OPENING_QTY,
                       ROUND(NVL(tx.STOCK_QTY, 0), 3) As STOCK_QTY,
                       ROUND(NVL(tx.PHYIN_QTY, 0), 3) As PHYIN_QTY,
                       ROUND(NVL(tx.USED_QTY, 0), 3) As USED_QTY,
                       ROUND(NVL(tx.PHYOUT_QTY, 0), 3) As PHYOUT_QTY,
                       ROUND(NVL(ob.OPENING_QTY, 0) + NVL(tx.STOCK_QTY, 0) +
                             NVL(tx.PHYIN_QTY, 0) - NVL(tx.USED_QTY, 0) -
                             NVL(tx.PHYOUT_QTY, 0),
                             3) As CLOSING_QTY,
                       ROUND(NVL(ob.OPENING_AMT, 0), 2) As OPENING_AMT,
                       ROUND(NVL(tx.STOCK_AMT, 0), 2) As STOCK_AMT,
                       ROUND(NVL(tx.PHYIN_AMT, 0), 2) As PHYIN_AMT,
                       ROUND(NVL(tx.USED_AMT, 0), 2) As USED_AMT,
                       ROUND(NVL(tx.PHYOUT_AMT, 0), 2) As PHYOUT_AMT,
                       ROUND(NVL(ob.OPENING_AMT, 0) + NVL(tx.STOCK_AMT, 0) +
                             NVL(tx.PHYIN_AMT, 0) - NVL(tx.USED_AMT, 0) -
                             NVL(tx.PHYOUT_AMT, 0),
                             2) As CLOSING_AMT
                
                  From IT it
                  Left Join OPENBAL ob
                    On it.ITEMCODE = ob.ITEMCODE
                  Left Join TXN tx
                    On it.ITEMCODE = tx.ITEMCODE
                    ;
                
                
                ```
            pageItemsToSubmit: [
                P510_FROMDATE
                P510_TODATE
                P510_ITEM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 16175721001890324
        }

