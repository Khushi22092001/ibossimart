    process fetch-products-detail (
        name: Fetch Products Detail
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Select
                      e.ItemCode,
                      e.ItemName,
                      e.ItemClassificationCode,
                      GetItemName(e.ParentCode),
                      ic.ItemClassName,
                      icc.ItemCategoryName,
                      GetLocationName(e.LocationCode),
                      GetDepartmentName(e.DepartmentCode),
                      mu1.MeasuringUnitName AS PUOM,
                      mu2.MeasuringUnitName AS SUOM,
                      GetPartyName(e.StockAccountCode),
                      GetPartyName(e.ConsumptionAccountCode),
                      GetPartyName(e.CWIPAccountCode),
                      inn.ItemNatureName,
                      e.IsEquipment,
                      e.SerialNoRequired,
                      e.BulkDensity,
                      e.Remark,
                      ee.ItemSpecificationName,
                      ee.HSNCode,
                      ee.Multiplyingfactor
                      Into
                      :P110_ITEMCODE,
                      :P110_ITEMNAME,
                      :P110_ITEMTYPE,
                      :P110_ITEMGROUP,
                      :P110_ITEMCLASS,
                      :P110_ITEMCATEGORY,
                      :P110_LOCATION,
                      :P110_DEPARTMENT,
                      :P110_PUOM,
                      :P110_SUOM,
                      :P110_STOCKACC,
                      :P110_CONSUMPTIONACC,
                      :P110_CWIPACC,
                      :P110_ITEMNATURE,
                      :P110_ISEQUIPMENT,
                      :P110_SERIALNOREQUIRED,
                      :P110_BULKDENSITY,
                      :P110_REMARK,
                      :P110_ITEMSPECIFICATIONNAME,
                      :P110_HSNCODE,
                      :P110_MULTIPLYINGFACTOR
                From  Item e, ItemSpecification ee, ItemClass ic, ItemCategory icc, MeasuringUnit mu1, MeasuringUnit mu2, ItemNature inn
                Where e.TNo = ee.TNo
                  and e.ItemClassCode = ic.ItemClassCode(+)
                  and e.ItemCategoryCode = icc.ItemCategoryCode(+)
                  and e.MeasuringUnitCode1 = mu1.MeasuringUnitCode
                  and e.MeasuringUnitCode2 = mu2.MeasuringUnitCode(+)
                  and e.ItemNatureCode = inn.ItemNatureCode(+)
                  and e.ItemCode LIKE NVL(:P110_PRODUCTCODE,'%')
                  and ee.ItemSpecificationCode LIKE NVL(:P110_ITEMSPECIFICATIONCODE,'%')
                  ;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 8452224913777239
        }
    )

)

