    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @new
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                     DECLARE
                      jobtype_list varchar2(4000);
                      query_str    varchar2(4000);
                      fromdate  date := :P310_FROMDATE;
                      todate  date := :P310_TODATE;
                      TLOCATION VARCHAR2(30) := :P310_LOCATION;
                      TCOMPANY VARCHAR2(30) := :P310_COMPANY;
                      
                    BEGIN
                      Select '''' || LISTAGG(jobtypename || ''',''') WITHIN Group(Order By jobtypename) || '''' As concatenated_string
                      Into jobtype_list
                      From (Select Distinct JOBTYPENAME
                              From SERVICEENTRYSHEETDETAIL A, JOBTYPE B, ServiceEntrySheet c, EquipmentMaintenanceOrder d, 
                                    MaintenanceRequest e, Equipment f
                             Where A.JOBTYPECODE = B.JOBTYPECODE
                               and a.tno = c.tno
                               and c.EquipmentMaintenanceorderTno=d.tno(+)
                               and d.MaintenanceRequestTno=e.tno(+)
                               and e.EquipmentTno = f.tno(+)
                               --- Filter Condition
                              and e.CompanyCode = TCOMPANY
                              and e.FinancialYearCode = :global_FinancialYearCode
                              and e.MaintenanceRequestDate between  FROMDATE AND todate
                              and ( TLOCATION IS NULL OR instr(':'|| TLOCATION||':',':'||e.LocationCode||':') > 0)
                              --and ( :P241_DOCTYPE IS NULL OR dc.DOCTYPECODE = :P241_DOCTYPE)
                              --and GetDoctypePrivilege(dc.doctypecode,:P241_MODULECODE, bk.companycode,:global_loginname) = 'YES'
                             --and GetLocationPrivilege(dc.LocationCode,:P241_MODULECODE, bk.companycode,:global_loginname) = 'YES'
                    
                             );
                    
                    -- query_str := 'SELECT *
                    --     FROM jobcarddetail a
                    --     PIVOT (
                    --       COUNT(jobtypecode)
                    --       FOR jobtypecode IN (' || jobtype_list || ')
                    --     )';
                    
                    -- query_str :=  'Select *
                    --   From (Select e.EquipmentName,
                    --                c.MaintenancerequestDate,
                    --                c.DueDate,
                    --                b.JobTypename
                    --           From serviceentrysheetdetail   a,
                    --                jobtype                   b,
                    --                maintenancerequest        c,
                    --                EquipmentMaintenanceorder d,
                    --                Equipment                 e,
                    --                ServiceEntrySheet         a1
                    --          Where a.jobtypecode = b.jobtypecode
                    --            And a.tno = a1.tno
                    --            And a1.EquipmentMaintenanceOrdertno = d.tno(+)
                    --            And d.maintenancerequesttno = c.tno(+)
                    --            And d.Equipmenttno = e.tno(+)
                    --            and c.CompanyCode = :P310_COMPANY
                    --           and c.MaintenanceRequestDate between :P310_FROMDATE AND :P310_TODATE
                    --            )
                    --            PIVOT (
                    --       COUNT(jobtypename)
                    --       FOR jobtypename IN (' || jobtype_list || ')
                    --     )';   
                    query_str := 'create or replace view pivot_test as (SELECT EQUIPMENTNAME, MAINTENANCEREQUESTDATE, DUEDATE, ' || jobtype_list || '
                                  FROM (
                                    SELECT e.EquipmentName, c.MaintenancerequestDate, c.DueDate, b.JobTypename
                                    FROM serviceentrysheetdetail a, jobtype b, maintenancerequest c, EquipmentMaintenanceOrder d, Equipment e, ServiceEntrySheet a1
                                    WHERE a.jobtypecode = b.jobtypecode
                                    AND a.tno = a1.tno
                                    AND a1.EquipmentMaintenanceOrdertno = d.tno(+)
                                    AND d.maintenancerequesttno = c.tno(+)
                                    AND d.Equipmenttno = e.tno(+)
                                   -- AND c.CompanyCode = TCOMPANY
                                   -- AND c.MaintenanceRequestDate BETWEEN FROMDATE AND todate
                                  )
                                  PIVOT (
                                    COUNT(jobtypename)
                                    FOR jobtypename IN (' || jobtype_list || ')
                                  ))';
                        :P310_JOBTYPENAME := query_str;
                        execute immediate query_str;
                      --RETURN (query_str);
                    END;
                    ```
                itemsToSubmit: [
                    P310_COMPANY
                    P310_LOCATION
                    P310_FROMDATE
                    P310_TODATE
                ]
                itemsToReturn: P310_JOBTYPENAME
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: expression
                plsqlExpression: 1 != 1
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                     DECLARE
                      jobtype_list varchar2(4000);
                      query_str    varchar2(4000);
                    BEGIN
                      Select '''' || LISTAGG(jobtypename || ''',''') WITHIN Group(Order By jobtypename) || '''' As concatenated_string
                      Into jobtype_list
                      From (Select Distinct JOBTYPENAME
                              From SERVICEENTRYSHEETDETAIL A, JOBTYPE B, ServiceEntrySheet c, EquipmentMaintenanceOrder d, 
                                    MaintenanceRequest e, Equipment f
                             Where A.JOBTYPECODE = B.JOBTYPECODE
                               and a.tno = c.tno
                               and c.EquipmentMaintenanceorderTno=d.tno(+)
                               and d.MaintenanceRequestTno=e.tno(+)
                               and e.EquipmentTno = f.tno(+)
                               --- Filter Condition
                              and e.CompanyCode = :P310_COMPANY
                              --and e.FinancialYearCode = :global_FinancialYearCode
                              and e.MaintenanceRequestDate between  nvl(to_date(:P310_FROMDATE,'DD-MM-RRRR'),trunc(sysdate) - 3) AND NVL(TO_DATE(:P310_TODATE,'DD-MM-RRRR'),TRUNC(SYSDATE))
                              and ( :P310_LOCATION IS NULL OR instr(':'||:P310_LOCATION||':',':'||e.LocationCode||':') > 0)
                              --and ( :P241_DOCTYPE IS NULL OR dc.DOCTYPECODE = :P241_DOCTYPE)
                              --and GetDoctypePrivilege(dc.doctypecode,:P241_MODULECODE, bk.companycode,:global_loginname) = 'YES'
                             --and GetLocationPrivilege(dc.LocationCode,:P241_MODULECODE, bk.companycode,:global_loginname) = 'YES'
                    
                             );
                    
                    -- query_str := 'SELECT *
                    --     FROM jobcarddetail a
                    --     PIVOT (
                    --       COUNT(jobtypecode)
                    --       FOR jobtypecode IN (' || jobtype_list || ')
                    --     )';
                    
                    query_str :=  'Select *
                      From (Select e.EquipmentName,
                                   c.MaintenancerequestDate,
                                   c.DueDate,
                                   b.JobTypename
                              From serviceentrysheetdetail   a,
                                   jobtype                   b,
                                   maintenancerequest        c,
                                   EquipmentMaintenanceorder d,
                                   Equipment                 e,
                                   ServiceEntrySheet         a1
                             Where a.jobtypecode = b.jobtypecode
                               And a.tno = a1.tno
                               And a1.EquipmentMaintenanceOrdertno = d.tno(+)
                               And d.maintenancerequesttno = c.tno(+)
                               And d.Equipmenttno = e.tno(+)
                               and c.CompanyCode = :P310_COMPANY
                              and c.MaintenanceRequestDate between :P310_FROMDATE AND :P310_TODATE
                               )
                               PIVOT (
                          COUNT(jobtypename)
                          FOR jobtypename IN (' || jobtype_list || ')
                        )';   
                    
                      RETURN query_str;
                    END;
                    
                    ```
                itemsToSubmit: [
                    P310_COMPANY
                    P310_LOCATION
                    P310_FROMDATE
                    P310_TODATE
                    P310_EQUIPMENT
                ]
            }
            affectedElements {
                selectionType: items
                items: P310_NEW
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

