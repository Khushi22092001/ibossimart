    region maintenance-report (
        name: Maintenance Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                 DECLARE
                  jobtype_list varchar2(4000);
                  query_str    varchar2(4000);
                BEGIN
                  Select '''' || LISTAGG(jobtypename || ''',''') WITHIN Group(Order By jobtypename) || '''' As concatenated_string
                  Into jobtype_list
                  From (Select Distinct JOBTYPENAME
                          From SERVICEENTRYSHEETDETAIL A, JOBTYPE B, ServiceEntrySheet c, EquipmentMaintenanceOrder d, 
                                MaintenanceRequest e, Equipment f
                         Where A.JOBTYPECODE = B.JOBTYPECODE
                           and a.tno = c.tno
                           and c.EquipmentMaintenanceorderTno=d.tno(+)
                           and d.MaintenanceRequestTno=e.tno(+)
                           and e.EquipmentTno = f.tno(+)
                           --- Filter Condition
                          and e.CompanyCode = :P310_COMPANY
                          --and e.FinancialYearCode = :global_FinancialYearCode
                          and e.MaintenanceRequestDate between  nvl(to_date(:P310_FROMDATE,'DD-MM-RRRR'),trunc(sysdate) - 3) AND NVL(TO_DATE(:P310_TODATE,'DD-MM-RRRR'),TRUNC(SYSDATE))
                          and ( :P310_LOCATION IS NULL OR instr(':'||:P310_LOCATION||':',':'||e.LocationCode||':') > 0)
                          --and ( :P241_DOCTYPE IS NULL OR dc.DOCTYPECODE = :P241_DOCTYPE)
                          --and GetDoctypePrivilege(dc.doctypecode,:P241_MODULECODE, bk.companycode,:global_loginname) = 'YES'
                         --and GetLocationPrivilege(dc.LocationCode,:P241_MODULECODE, bk.companycode,:global_loginname) = 'YES'
                
                         );
                
                -- query_str := 'SELECT *
                --     FROM jobcarddetail a
                --     PIVOT (
                --       COUNT(jobtypecode)
                --       FOR jobtypecode IN (' || jobtype_list || ')
                --     )';
                
                -- query_str :=  'Select *
                --   From (Select e.EquipmentName,
                --                c.MaintenancerequestDate,
                --                c.DueDate,
                --                b.JobTypename
                --           From serviceentrysheetdetail   a,
                --                jobtype                   b,
                --                maintenancerequest        c,
                --                EquipmentMaintenanceorder d,
                --                Equipment                 e,
                --                ServiceEntrySheet         a1
                --          Where a.jobtypecode = b.jobtypecode
                --            And a.tno = a1.tno
                --            And a1.EquipmentMaintenanceOrdertno = d.tno(+)
                --            And d.maintenancerequesttno = c.tno(+)
                --            And d.Equipmenttno = e.tno(+)
                --            and c.CompanyCode = :P310_COMPANY
                --           and c.MaintenanceRequestDate between :P310_FROMDATE AND :P310_TODATE
                --            )
                --            PIVOT (
                --       COUNT(jobtypename)
                --       FOR jobtypename IN (' || jobtype_list || ')
                --     )';   
                query_str := 'SELECT EQUIPMENTNAME, MAINTENANCEREQUESTDATE, DUEDATE, ' || jobtype_list || '
                              FROM (
                                SELECT e.EquipmentName, c.MaintenancerequestDate, c.DueDate, b.JobTypename
                                FROM serviceentrysheetdetail a, jobtype b, maintenancerequest c, EquipmentMaintenanceOrder d, Equipment e, ServiceEntrySheet a1
                                WHERE a.jobtypecode = b.jobtypecode
                                AND a.tno = a1.tno
                                AND a1.EquipmentMaintenanceOrdertno = d.tno(+)
                                AND d.maintenancerequesttno = c.tno(+)
                                AND d.Equipmenttno = e.tno(+)
                                AND c.CompanyCode = :P310_COMPANY
                                AND c.MaintenanceRequestDate BETWEEN :P310_FROMDATE AND :P310_TODATE
                              )
                              PIVOT (
                                COUNT(jobtypename)
                                FOR jobtypename IN (' || jobtype_list || ')
                              )';
                
                  RETURN (query_str);
                END;
                ```
            pageItemsToSubmit: [
                P310_COMPANY
                P310_LOCATION
                P310_FROMDATE
                P310_TODATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
