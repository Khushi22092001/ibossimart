page 308 (
    name: DebitDetails
    alias: DEBITDETAILS
    title: DebitDetails
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region debitdetails (
        name: DebitDetails
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                b.AccountCode,
                c.PartyName,
                a.VoucherNo,
                b.VoucherDate,
                abs(b.Amount) as DebitAmount
                From Voucher a,VoucherDetail b, Party c
                Where a.Tno = b.Tno(+)
                and b.AccountCode = c.PartyCode(+)
                and b.Amount < 0
                and b.accountCode = :P308_PARTYCODE
                and b.voucherDate between :P308_FROMDATE and :P308_TODATE;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 28947404618745323
        }

        column ACCOUNTCODE (
            type: plainText
            heading {
                heading: Accountcode
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DEBITAMOUNT (
            type: plainText
            heading {
                heading: Debitamount
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column PARTYNAME (
            type: plainText
            heading {
                heading: Partyname
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column VOUCHERDATE (
            type: plainText
            heading {
                heading: Voucherdate
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column VOUCHERNO (
            type: plainText
            heading {
                heading: Voucherno
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: DebitDetails
        }

        savedReport 289790 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTCODE (
                sequence: 1
            )

            displayColumn DEBITAMOUNT (
                sequence: 5
            )

            displayColumn PARTYNAME (
                sequence: 2
            )

            displayColumn VOUCHERDATE (
                sequence: 4
            )

            displayColumn VOUCHERNO (
                sequence: 3
            )

        )

    )

    pageItem P308_FROMDATE (
        type: hidden
        layout {
            sequence: 10
            region: @debitdetails
            slot: regionBody
        }
    )

    pageItem P308_PARTYCODE (
        type: hidden
        layout {
            sequence: 30
            region: @debitdetails
            slot: regionBody
        }
    )

    pageItem P308_TODATE (
        type: hidden
        layout {
            sequence: 20
            region: @debitdetails
            slot: regionBody
        }
    )

)

