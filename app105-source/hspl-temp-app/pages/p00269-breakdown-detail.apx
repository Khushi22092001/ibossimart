page 269 (
    name: Breakdown Detail
    alias: BREAKDOWN-DETAIL
    title: Breakdown Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                Rownum as "SerialNo",
                c.EquipmentId as "Door No",
                To_Char(a.BreakDownInTime,'HH:MM:SS') as "BreakDown In Time",
                a.BreakDownInTime as "BreakDown In Date",
                To_Char(a.BreakDownOutTime,'HH:MM:SS') as "BreakDown Out Time",
                a.BreakDownOutTime as "BreakDown Out Date",
                b.OpeningMeterReading as "KMR",
                b.OpeningWorkingHrs as "HMR",
                initcap(a.BreakDownDetail) as "Complaint",
                initcap(a.ActionTaken) as "Action",
                b.EquipmentLogBookDate,
                d.EquipmentGroupCode
                From EquipmentLogBookBreakDown a,EquipmentLogBook b, Equipment c , EquipmentGroup d
                Where a.tno = b.Tno (+)
                and  b.EquipmentTno = c.Tno(+)
                and c.EquipmentGroupCode = d.EquipmentGroupCode(+)
                and a.BreakDownInTime is not null
                and b.EquipmentLogBookDate <= :P269_ONDATE
                and :P269_EQUIPMENTCATEGORY = 'EQUIPMENTLOGBOOK'
                and (:P269_GROUPCODE IS NULL OR instr(':'||:P269_GROUPCODE||':',':'||d.EquipmentGroupCode||':') > 0)
                and (:P268_LOCATION IS NULL OR instr(':'||:P268_LOCATION||':',':'||b.LocationCode||':') > 0)
                
                Union All
                
                
                Select 
                Rownum as "SerialNo",
                c.EquipmentId as "Door No",
                To_Char(a.BreakDownInTime,'HH:MM:SS') as "BreakDown In Time",
                a.BreakDownInTime as "BreakDown In Date",
                To_Char(a.BreakDownOutTime,'HH:MM:SS') as "BreakDown Out Time",
                a.BreakDownOutTime as "BreakDown Out Date",
                b.OpeningMeterReading as "KMR",
                b.OpeningWorkingHrs as "HMR",
                a.BreakDownDetail as "Complaint",
                a.ActionTaken as "Action",
                b.VehicleLogBookDate,
                d.EquipmentGroupCode
                From VehicleLogBookBreakDownDetail a,VehicleLogBook b, Equipment c , EquipmentGroup d
                Where a.tno = b.Tno (+)
                and  b.EquipmentTno = c.Tno(+)
                and c.EquipmentGroupCode = d.EquipmentGroupCode(+)
                and a.BreakDownInTime is not null
                and b.VehicleLogBookDate <= :P269_ONDATE
                and (:P268_LOCATION IS NULL OR instr(':'||:P268_LOCATION||':',':'||b.LocationCode||':') > 0)
                and (:P269_GROUPCODE IS NULL OR instr(':'||:P269_GROUPCODE||':',':'||d.EquipmentGroupCode||':') > 0)
                and :P269_EQUIPMENTCATEGORY = 'VEHICLELOGBOOK'
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 12738514799448211
        }

