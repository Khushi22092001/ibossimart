    title: MInes Wise Daily Summary Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        formAutoComplete: false
    }

    region mines-wise-daily-summary (
        name: Mines Wise Daily Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region mines-wise-daily-summary-report (
        name: Mines Wise Daily Summary Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   b.LocationName,
                   row_number() over(order by a.LocationCode) SerialNo,
                   'LR' as Module,
                   c.SourceLocationName,
                   a.LocationCode,
                   a.CompanyCode,
                   c.SourceLocationCode,
                   d.DestinationLocationCode,
                   d.DestinationLocationName,
                   Count(a.VehicleNo) as NoOfTruck,
                   Sum(a.Quantity1) as Qty,
                   round(nvl(Sum(a.Quantity1),1) / nvl(Count(a.VehicleNo),1),3) as AvgQty
                From LR a, Location b, SourceLocation c, DestinationLocation d
                Where a.LocationCode = b.LocationCode(+)
                  and a.SourceLocationTno = c.Tno(+)
                  and a.DestinationLocationTno = d.Tno(+)
                  and a.VehicleGroupCode = 'SELF'
                  and (:P464_COMPANY is Null Or Instr (':' || :P464_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                  and a.LRDATE Between :P464_FROMDATE and :P464_TODATE 
                  and (:P464_LOCATION is Null Or Instr (':' || :P464_LOCATION || ':' , ':' || b.LocationCode || ':') > 0)
                  And  (:P464_SOURCE is Null Or Instr (':' || :P464_SOURCE || ':' , ':' ||c.SourceLocationCode|| ':') > 0)
                  And  (:P464_DESTINATION is Null Or Instr (':' || :P464_DESTINATION || ':' , ':' ||a.DestinationLocationTno|| ':') > 0) 
                Group By b.LocationName,
                         c.SourceLocationName,
                         d.DestinationLocationName,
                         a.LocationCode,
                         a.CompanyCode,
                         c.SourceLocationCode,
                         d.DestinationLocationCode
                
                UNION ALL
                
                Select
                   b.LocationName,
                   row_number() over(order by a.LocationCode) SerialNo,
                   'Internal Transfer' as Module,
                   c.SourceLocationName,
                   a.LocationCode,
                   a.CompanyCode,
                   c.SourceLocationCode,
                   d.DestinationLocationCode,
                   d.DestinationLocationName,
                   Count(a.VehicleNo) as NoOfTruck,
                   Sum(a.LoadingQuantity1) as Qty,
                   round(nvl(Sum(a.LoadingQuantity1),1) / nvl(Count(a.VehicleNo),1),3) as AvgQty
                From InternalTransfer a, Location b, SourceLocation c, DestinationLocation d
                Where a.LocationCode = b.LocationCode(+)
                  and a.SourceLocationTno = c.Tno(+)
                  and a.DestinationLocationTno = d.Tno(+)
                  and a.VehicleGroupCode = 'SELF'
                  and (:P464_COMPANY is Null Or Instr (':' || :P464_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                  and a.InternalTransferDate Between :P464_FROMDATE and :P464_TODATE 
                  and (:P464_LOCATION is Null Or Instr (':' || :P464_LOCATION || ':' , ':' || b.LocationCode || ':') > 0)
                  And (:P464_SOURCE is Null Or Instr (':' || :P464_SOURCE || ':' , ':' ||c.SourceLocationCode|| ':') > 0)
                  And (:P464_DESTINATION is Null Or Instr (':' || :P464_DESTINATION || ':' , ':' ||a.DestinationLocationTno|| ':') > 0) 
                Group By b.LocationName,
                         c.SourceLocationName,
                         d.DestinationLocationName,
                         a.LocationCode,
                         a.CompanyCode,
                         c.SourceLocationCode,
                         d.DestinationLocationCode;
                
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
