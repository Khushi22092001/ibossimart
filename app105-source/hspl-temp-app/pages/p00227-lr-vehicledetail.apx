page 227 (
    name: LR Vehicle Detail
    alias: LR-VEHICLEDETAIL
    title: LR Vehicle Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
            overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lr-vehicle-detail (
        name: LR  Vehicle Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region lr-vehicle-detail-report (
        name: LR  Vehicle Detail Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      b.CompanyName as LRCompanyName,
                      a.LrNo,
                      a.LrDate,
                      a.VehicleNo,
                      d.VehicleTypeName,
                      e.VehicleGroupName,
                      f.CompanyName as VehicleCompanyName,
                      g.TransporterName as OwnerName,
                      i.TransporterName
                From Lr a, Company b, CompanyVehicle c, VehicleType d, VehicleGroup e, Company f, Transporter g,
                Transporter i
                Where a.CompanyCode = b.CompanyCode(+)
                 and  a.VehicleNo = c.CompanyVehicleNo(+)
                 and c.VehicleTypeCode = d.VehicleTypeCode(+)
                 and c.VehicleGroupCode = e.VehicleGroupCode(+)
                 and c.CompanyCode = f.CompanyCode(+)
                 and c.OwnerCode = g.TransporterCode(+)
                 and c.TransporterCode = i.TransporterCode(+)
                 and a.LrDate between :P227_FROMDATE and :P227_TODATE
                  and (b.CompanyName = :P227_LRCOMPANYNAME 
                     or :P227_LRCOMPANYNAME is null
                    )
                  and (a.VehicleNo = :P227_VEHICLENO
                    or :P227_VEHICLENO is null
                    )
                 ;
                ```
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            newColumn: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 15394097038583007
        }

        savedReport 156868 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @LRCOMPANYNAME
                layout {
                    width: 258
                    sequence: 1
                }
            )

            displayColumn (
                column: @LRNO
                layout {
                    width: 236
                    sequence: 2
                }
            )

            displayColumn (
                column: @LRDATE
                layout {
                    width: 125
                    sequence: 3
                }
            )

            displayColumn (
                column: @VEHICLENO
                layout {
                    width: 145
                    sequence: 4
                }
            )

            displayColumn (
                column: @VEHICLETYPENAME
                layout {
                    width: 222
                    sequence: 5
                }
            )

            displayColumn (
                column: @VEHICLEGROUPNAME
                layout {
                    width: 161
                    sequence: 6
                }
            )

            displayColumn (
                column: @VEHICLECOMPANYNAME
                layout {
                    width: 331
                    sequence: 9
                }
            )

            displayColumn (
                column: @OWNERNAME
                layout {
                    width: 161
                    sequence: 7
                }
            )

            displayColumn (
                column: @TRANSPORTERNAME
                layout {
                    width: 206
                    sequence: 8
                }
            )

        )

