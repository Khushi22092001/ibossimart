    region order-vs-dispatch-report (
        name: Order vs Dispatch Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                      row_number() over(order by a.SalesOrderDate) SerialNo,
                      l.LocationName,
                      p.PartyName,
                      a.PartyPONo,
                      a.PartyPODate,
                      a.ValidityuptoDate,
                      a.PartyPODate- a.ValidityuptoDate as OverdueDays,
                      (Select sum(nvl(x.Quantity2,x.Quantity1)) From SalesOrderDetail x Where x.TNo = a.TNo) as POQuantity,
                      (Select count(x.Sno) From SalesOrderDetail x Where x.TNo = a.TNo) as NoofSKU,
                      Decode((Select Count(x.TNO)From SalesOrder x where x.TNo = a.TNo),'YES','NO') POCorrection,
                      (Select to_char(daa.ProposedDate,'DD-MM-YYYY HH24:MI')
                        From deliveryappointment daa 
                        Where daa.TNo in (Select max(x.tno) from deliveryappointment x where x.SalesOrderTNo =a.TNo )) ProposedDateandTime,
                      (Select GetEmployeeName(bu.EmployeeCode)||' ( '||daa.Creator||' )' 
                        From deliveryappointment daa, BossUser bu 
                        Where daa.TNo in (Select max(x.tno) from deliveryappointment x where x.SalesOrderTNo =a.TNo ) 
                        and daa.Creator = bu.LoginName(+)) AppointmentTakenBy,
                      (Select to_char(daa.AppointmentDate,'DD-MM-YYYY HH24:MI')
                        From deliveryappointment daa 
                        Where daa.TNo in (Select max(x.tno) from deliveryappointment x where x.SalesOrderTNo =a.TNo )) ReceivedDateandTime,
                      (Select
                             Listagg(ci.CCInvoiceDate||', ')
                      From   CCInvoice ci
                      Where ci.SalesOrderTNo = a.TNo) as InvoiceDate,
                      (Select
                             Listagg(ci.CCInvoiceNo||', ')
                      From   CCInvoice ci
                      Where ci.SalesOrderTNo = a.TNo) as InvoiceNo,
                      (Select
                             Listagg(ci.VehicleNo||', ')
                      From   CCInvoice ci
                      Where ci.SalesOrderTNo = a.TNo) as VehicleNo,
                      (Select
                             Sum(nvl(cid.Quantity2,cid.Quantity1))
                      From   CCInvoice ci, CCInvoiceDetail cid
                      Where ci.SalesOrderTNo = a.TNo
                        and ci.TNo = cid.TNo) as InvoiceQty,
                      (Select
                             Sum(cid.TotalAmount)
                      From   CCInvoice ci, CCInvoiceDetail cid
                      Where ci.SalesOrderTNo = a.TNo
                        and ci.TNo = cid.TNo) as InvoiceAmount,
                        (Select
                             UPPER(Listagg(mo.DriverName||', '))
                      From   DespatchAdvice da, MaterialOut mo
                      Where da.ReferenceTNo = a.TNo
                        and da.TNo = mo.ReferenceTNo) as DriverName,
                        (Select
                             Listagg(mo.DriverMobileNo||', ')
                      From   DespatchAdvice da, MaterialOut mo
                      Where da.ReferenceTNo = a.TNo
                        and da.TNo = mo.ReferenceTNo) as DriverMobileNo,
                        (Select
                             Listagg(sg.SalesGRNDate||', ')
                      From   CCInvoice ci, SalesGRN sg
                      Where ci.SalesOrderTNo = a.TNo
                        and ci.TNo = sg.CCInvoiceTNo) as SalesGRNDate,
                        (Select
                             Listagg(sg.SalesGRNNo||', ')
                      From   CCInvoice ci, SalesGRN sg
                      Where ci.SalesOrderTNo = a.TNo
                        and ci.TNo = sg.CCInvoiceTNo) as SalesGRNNo,
                        (Select
                             Sum(nvl(sgd.Quantity2,sgd.Quantity1))
                      From   CCInvoice ci, SalesGRN sg, SalesGRNDetail sgd
                      Where ci.SalesOrderTNo = a.TNo
                        and ci.TNo = sg.CCInvoiceTno
                        and sg.Tno = sgd.TNo) as ReachedQty
                From  SalesOrder a, Party p, Party cg, Location l, City fc, City tc
                Where a.PartyCode = p.partyCode
                  and a.ConsigneeCode = cg.PartyCode
                  and a.LocationCode = l.LocationCode
                  and a.FromCityCode = fc.CityCode
                  and a.ToCityCode = tc.CityCode
                  and a.SalesOrderDate between :P61_FROMDATE and :P61_TODATE
                    -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and instr(':'||:P61_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P61_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P61_PARTY IS NULL OR instr(':'||:P61_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                  --and ( :P61_TRADETYPE IS NULL OR instr(':'||:P61_TRADETYPE||':',':'||a.TradeTypeCode||':') > 0 )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
