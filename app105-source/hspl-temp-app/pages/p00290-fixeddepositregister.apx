page 290 (
    name: FixedDepositRegister
    alias: FIXEDDEPOSITREGISTER
    title: FixedDepositRegister
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region fixeddeposit (
        name: FixedDeposit
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                row_number() over(order by fd.FixedDepositDate) SerialNo,
                c.companyname as company,
                d.doctypename as doctype,
                fd.fixeddepositdate,
                fd.fixeddepositno,
                fdt.fixeddeposittypename,
                fd.fixeddepositdirection,
                fdft.fixeddepositflowtypename as fixeddepositflowtype,
                p1.partyname as fixeddepositaccount,
                p2.partyname as creditaccount,
                fd.foliono,
                fd.fixeddepositcertificateno,
                fd.fixeddepositcertifcatedate,
                fd.openingprincipalamount,
                fd.openingtotalinterestreceived as openingtotalinterestrec,
                fd.openingtotaltdsdeducted,
                fd.fixedrenewalmode,
                fd.fixeddepositamount,
                fd.interestcompoundingmode,
                fd.maturitydate,
                fd.claimdate as withdrawldate,
                fd.maturityamount,
                fd.interestrate AS INTERESTRATE1,
                fd.interestamount AS INTERESTAMOUNT1,
                fd.benificiary,
                v.voucherno,
                fd.purpose as fixeddepositpurpose,
                fdi.fromdate AS INTERESTFROMDATE,
                fdi.todate AS INTERESTTODATE,
                fdi.interestrate AS INTERESTRATE2,
                fdi.interestamount AS INTERESTAMOUNT2,
                fdi.tdsamount,
                fdi.cessamount,
                fdi.surchargeamount,
                fdw.fixeddepositwithdrawldate,
                fdw.withdrawltype,
                fdw.withdrawlamount,
                fdw.charges,
                fdw.interestadjustmentamount as adjustmentamount,
                fdc.computationdate,
                fdc.fixeddepositeopeningamount,
                fdc.interestamount,
                fdc.balanceamount
                FROM FIXEDDEPOSIT fd,
                     fixeddepositinterest fdi,
                     fixeddeposittype fdt,
                     fixeddepositflowtype fdft,
                     fixeddepositwithdrawl fdw,
                      fixeddepositecomputation fdc,
                      voucher v,
                      party p1,
                      party p2,
                      company c,
                      doctype d
                 where
                 fd.tno = fdi.fixeddeposittno(+)
                 and fd.companycode = c.companycode(+)
                 and fd.doctypecode = d.doctypecode(+)
                 and fd.fixeddeposittypecode = fdt.fixeddeposittypecode(+)
                 and fd.fixeddepositflowtypecode = fdft.fixeddepositflowtypecode(+)
                 and fd.tno = fdw.fixeddeposittno(+)
                 and fd.tno = fdc.tno(+)
                 and fd.tno = v.moduletno(+)
                 and fd.fixeddepositaccountcode = p1.partycode(+)
                 and fd.creditaccountcode = p2.partycode(+)
                 and FD.FIXEDDEPOSITdate between :P290_FROMDATE and :P290_TODATE
                and (:P290_COMPANY IS NULL OR instr(':'||:P290_COMPANY||':',':'||C.COMPANYcode||':') > 0)
                and (:P290_FIXEDDEPOSITNO IS NULL OR instr(':'||:P290_FIXEDDEPOSITNO||':',':'||FD.FIXEDDEPOSITNo||':') > 0 ) 
                and (:P290_FIXEDDEPOSITTYPE IS NULL OR instr(':'||:P290_FIXEDDEPOSITTYPE||':',':'||FDT.FIXEDDEPOSITtypecode||':') > 0)
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 16575796728562922
        }

