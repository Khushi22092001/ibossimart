            sqlQuery:
                ```sql
                SELECT DISTINCT
                A.FIXEDDEPOSITTYPENAME D,
                A.FIXEDDEPOSITTYPECODE R
                FROM FIXEDDEPOSITTYPE A,FIXEDDEPOSIT B
                WHERE A.FIXEDDEPOSITTYPECODE = B.FIXEDDEPOSITTYPECODE(+)
                ```
        }
        layout {
            sequence: 60
            region: @fixeddeposit
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P290_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @fixeddeposit
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 25
        }
    )

    pageItem P290_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @fixeddeposit
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 25
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 80
            region: @fixeddeposit
            slot: regionBody
            startNewRow: false
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

