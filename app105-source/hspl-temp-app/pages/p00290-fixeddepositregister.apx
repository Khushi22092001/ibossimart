            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                FIXEDDEPOSITNO D,
                FIXEDDEPOSITNO R
                FROM FIXEDDEPOSIT
                ```
        }
        layout {
            sequence: 70
            region: @fixeddeposit
            slot: regionBody
            alignment: left
