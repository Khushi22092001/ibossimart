page 129 (
    name: Employee Hold Salary
    alias: EMPLOYEE-HOLD-SALARY
    title: Employee Hold Salary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region employee-hold-salary (
        name: Employee Hold Salary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.EmployeeName) SerialNo,
                a.EmployeeName,
                a.EmployeeID,
                a.FatherName,
                b.DepartmentName,
                c.DesignationName,
                e.SalaryMonth,
                e.NetEarning,
                round(nvl(e.NetEarning, 0) + nvl(x.NetAmount, 0),2) as NetPayableAmount,
                d.Reason,
                d.Remark
                From Employee a, Department b, Designation c, HoldSalary d, SalaryEngineDetail e,
                (
                Select
                a.EmployeeCode,
                a.FromDate,
                a.ToDate,
                sum(a.NetAmount) as NetAmount
                From OTEngineDetail a
                Group by 
                a.EmployeeCode,
                a.FromDate,
                a.ToDate
                ) x
                Where GetEmployeeDepartmentCode(a.EmployeeCode, sysdate) = b.DepartmentCode(+)
                and GetEmployeeDesignationCode(a.EmployeeCode, sysdate) = c.DesignationCode(+)
                and a.EmployeeCode = d.EmployeeCode
                and d.EmployeeCode = e.Employeecode(+)
                and d.SalaryFromDate = e.SalaryFromDate(+)
                and d.SalaryToDate = e.SalaryToDate(+)
                and d.EmployeeCode = x.Employeecode(+)
                and d.SalaryFromDate = x.FromDate(+)
                and d.SalaryToDate = x.ToDate(+)
                and instr(':'||:P129_COMPANY||':',':'||a.CompanyCode||':') > 0
                and instr(':'||:P129_LOCATION||':',':'||a.LocationCode||':') > 0
                and not exists(
                Select
                1
                From UnHoldSalary aa
                Where aa.SalaryFromDate = d.SalaryFromDate
                and aa.SalaryToDate = d.SalaryToDate
                and aa.EmployeeCode = d.EmployeeCode
                )
                ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 5048402841007025
        }

