page 124 (
    name: Sample Dynamic Action (Mouse Over)
    alias: SAMPLE-DYNAMIC-ACTION-MOUSE-OVER
    title: Sample Dynamic Action (Mouse Over)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region department (
        name: Department
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      d.DepartmentName,
                      d.TNo as DepartmentCode,
                      sum(StockAmount)as Amount
                From  BI_Issue a, FinancialYear fy, Department d
                Where a.FinancialYearCode = fy.FinancialYearCode
                  and a.DepartmentCode =d.DepartmentCode
                  and a.IssueDate Between fy.FinancialYearBegin and fy.FinancialYearEnd
                Group by d.DepartmentName,
                         d.TNo 
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        dataCursor {
            behavior: smooth
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: DEPARTMENTNAME
                value: DEPARTMENTCODE
            }
            link {
                type: redirectUrl
                targetUrl: javascript: $s('P124_DEPTCODE',&DEPARTMENTCODE.);
            }
            label {
                show: true
            }
        )

    )

    pageItem P124_DEPTCODE (
        type: textField
        label {
            label: Deptcode
            alignment: left
        }
        layout {
            sequence: 10
            region: @department
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

)

