        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 200000
        }
        messages {
            whenNoDataFound: No customer carries an open receivable or credit in this scope as at the As-of Date.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        advanced {
            savedReportMappingIdentifier: 69100000000000691
        }

