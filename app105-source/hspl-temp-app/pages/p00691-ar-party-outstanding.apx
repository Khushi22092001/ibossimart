    pageItem P691_AGEBASIS (
        type: hidden
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
        }
        default {
            type: static
            staticValue: DUE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_COMPANY (
        type: selectList
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.CompanyCode = c.CompanyCode
                                  And v.AccountCode In (Select PartyCode From Party
                                        Start With PartyCode = 'SUNDRYDEBTORS' Connect By Prior PartyCode = ParentCode)
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or v.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_FOCUS (
        type: hidden
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
        }
        default {
            type: static
            staticValue: ALL
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            alignment: left
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_LOCATION (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From VoucherDetail v
                                Where v.LocationCode = l.LocationCode
                                  And v.AccountCode In (Select PartyCode From Party
                                        Start With PartyCode = 'SUNDRYDEBTORS' Connect By Prior PartyCode = ParentCode)
                                  And (:P691_COMPANY Is Null Or v.CompanyCode = :P691_COMPANY)
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or v.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P691_COMPANY
            itemsToSubmit: P691_COMPANY
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            displayExtraValues: false
            nullDisplayValue: A + B
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P691_TODATE (
        type: datePicker
        label {
            label: To Date / As-of
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: Select to_char(trunc(sysdate),'DD-MM-RRRR') From dual
        }
        security {
            encryptSessionState: false
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
    )

    button back (
        buttonName: BACK
        label: Command Centre
        layout {
            sequence: 90
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 690
                items: {
                    P690_FROMDATE: &P691_FROMDATE.
                    P690_TODATE: &P691_TODATE.
                    P690_COMPANY: &P691_COMPANY.
                    P690_LOCATION: &P691_LOCATION.
                    P690_PANEL: &P691_PANEL.
                    P690_AGEBASIS: &P691_AGEBASIS.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

