page 132 (
    name: Workcentre
    alias: WORKCENTRE
    title: Workcentre
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region work-centre (
        name: "Work Centre "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       ROWNUM AS SerialNo,
                       A.WORKCENTRECODE,
                       A.WORKCENTRENAME,
                       A.LOCATIONCODE,
                       A.DEPARTMENTCODE,
                       B.LOCATIONNAME,
                       C.DEPARTMENTNAME
                  From Workcentre A, Location B, DEPARTMENT C
                 Where A.LOCATIONCODE = B.LOCATIONCODE(+)
                   And A.DEPARTMENTCODE = C.DEPARTMENTCODE(+)
                  and ( :P132_LOCATION IS Not NULL OR instr(':'||:P132_LOCATION||':',':'||a.LocationCode||':') > 0)
                  and ( :P132_DEPARTMENT IS NULL OR instr(':'||:P132_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0)
                  and a.Locationcode is not null
                  Order By 2;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                csv
                excel
                pdf
                html
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12181710129080121
        }

        column DEPARTMENTCODE (
            type: plainText
            heading {
                heading: DEPARTMENT CODE
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column DEPARTMENTNAME (
            type: plainText
            heading {
                heading: DEPARTMENT NAME
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: LOCATION CODE
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: LOCATION NAME
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column WORKCENTRECODE (
            type: plainText
            heading {
                heading: WORKCENTRE CODE
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column WORKCENTRENAME (
            type: plainText
            heading {
                heading: WORKCENTRE NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: "Work Centre "
        }

        savedReport 122826 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn LOCATIONNAME (
                sequence: 4
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn WORKCENTRECODE (
                sequence: 2
            )

            displayColumn WORKCENTRENAME (
                sequence: 3
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region work-centre-register (
        name: Work Centre Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P132_DEPARTMENT (
        type: hidden
        layout {
            sequence: 20
            region: @work-centre-register
            slot: regionBody
        }
    )

    pageItem P132_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery: select locationname d, locationcode r from location order by 1
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @work-centre-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 75
            valuePlaceholder: Location
        }
    )

    button refresh (
        buttonName: refresh
        label: Refresh
        layout {
            sequence: 30
            region: @work-centre-register
            slot: regionBody
            column: 11
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

