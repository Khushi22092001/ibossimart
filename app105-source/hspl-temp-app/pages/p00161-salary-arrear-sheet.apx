                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-download
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            plsqlExpression: 1 != 1
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @salarysheetpreview
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/SALARYSHEET.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP161_COMPANY":"&P161_COMPANY.","_paramsP161_LOCATION":"&P161_LOCATION.","_paramsP161_FROMDATE":"&P161_FROMDATE.","_paramsP161_TODATE":"&P161_TODATE.","_paramsP161_EMPLOYEE":"&P161_EMPLOYEE.","_paramsP161_DESIGNATION":"&P161_DESIGNATION.","_paramsP161_DEPARTMENT":"&P161_DEPARTMENT."}');
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

