page 161 (
    name: Salary Arrear Sheet
    alias: SALARY-ARREAR-SHEET
    title: Salary Arrear Sheet
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region salary-arrear-sheet (
        name: Salary  Arrear Sheet
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region salary-arrear-sheet-report (
        name: Salary Arrear Sheet Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                       A.Location,
                       A.EMPLOYEECODE,
                       A.Department,
                       A.SALARYMONTH,
                       A.EmployeeName as Employee,
                       a.EMPID  as EmployeeID,
                       A.SALARYSCHEME,
                       A.Designation,
                       A.PFACCOUNTNO,
                       A.BANKNAME,
                       A.BANKACCOUNTNO,
                
                       A.TD,
                       A.PR,
                       A.CL,
                       A.EL,
                       A.ML,
                       A.AB,
                       A.WD,
                       A.OH,
                       A.NH,
                       A.OD,
                       A.LWP,
                       A.COFF,
                       A.PL,
                       A.PD,
                       A.WOFF,
                
                       A.PAY_BASIC ,
                       A.PAY_HRA ,
                       A.PAY_MEDICAL,
                       A.PAY_CONV ,
                       A.PAY_SPL,
                       A.PAY_LTA ,
                       A.PAY_CARREIMBURSEMENT,
                       A.PAY_CEA,
                       A.PAY_HOSTEL,
                       A.PAY_MISCALL,
                       a.SOED,
                       A.PAY_CTC,
                       A.PAY_PFEMPLOYER,
                       A.PAY_PFEMPLOYEE,
                       A.PAY_ACEMPLOYER,
                       A.PAY_BONUS,
                       A.PAY_LEAVEINCASH,
                       A.PAY_ESICEMPLOYER,
                       A.PAY_ESICEMPLOYEE,
                       A.PAY_GROSSSALARY,
                       A.PAY_GROSSDEDUCTION,
                       A.PAY_NET,
                
                       A.EARNEDCTC,
                       A.EarnedBasic,
                       A.EarnedHRA,
                       A.EarnedMedical,
                       A.EarnedConv,
                       A.EarnedSpl,
                       A.EarnedLTA,
                       A.EARNEDCARREIMB,
                       A.EARNEDCEA,
                       A.EARNEDHOSTEL,
                       A.EARNEDEARNEDBONUS,
                       A.EARNEDEARNEDLEAVEINCASH,
                       A.MISCALL AS "EARNEDNISC",
                       A.GROSSEAR AS "GROSSEARNING",
                
                       A.EARNEDPFCOMPCONTRIBUTION,
                       A.EARNEDPFEMPLOYEECONTRIBUTION,
                       A.EARNEDADMINCHARGECOMPCONTRIBUTION,
                       A.EARNEDESICCOMPCONTRIBUTION,
                       A.EARNEDESICEMPLOYEECONTRIBUTION,
                       a.TEMPESICCOMP,
                       a.TEMPESICEMP,
                       A.SalAdv,
                       A.LOANDED,
                       A.CANTEENDED,
                       A.MOBILEBILLDED,
                       A.OTHERDED,
                       A.ITAX,
                       A.GROSSDED,
                
                       A.NetEarning,
                       
                       emp.UAN,
                       a.EARNEDOTHERINCOME,
                       a.PTAX,
                       emp.DateofJoining,
                       emp.ESICAccountNo ,
                       a.IFSCCODE,
                       a.BANKBRANCHNAME,
                
                       a.OTHours,
                       a.OTRate,
                       a.OTAmount,
                       a.EarnedGrossOT,
                       emp.StaffTypeCode,
                       15000 as FixSalarySlab
                
                  FROM SALARYARREARENGINEDETAIL A, DEPARTMENT DP, DESIGNATION DG, Employee emp
                where A.DEPARTMENTCODE = DP.DEPARTMENTCODE(+)
                  AND A.DESIGNATIONCODE = DG.DESIGNATIONCODE(+)
                  and a.EmployeeCode = emp.EmployeeCode(+)
                  and emp.StaffTypeCode != 'HAMAL'
                  and (:P161_FROMDATE IS NULL OR a.ArrearFromDate between :P161_FROMDATE and :P161_TODATE)
                  and instr(':'||:P161_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P161_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P161_EMPLOYEE IS NULL OR instr(':'||:P161_EMPLOYEE||':',':'||a.EmployeeCode||':') > 0 ) 
                  and ( :P161_DEPARTMENT IS NULL OR instr(':'||:P161_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0 ) 
                  and ( :P161_DESIGNATION IS NULL OR instr(':'||:P161_DESIGNATION||':',':'||a.DesignationCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 100000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 23123537485231942
        }

