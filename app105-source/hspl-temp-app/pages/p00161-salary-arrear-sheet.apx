    button salarysheetpreview (
        buttonName: SALARYSHEETPREVIEW
        label: Salary Arrear Sheet
        layout {
            sequence: 20
            region: @salary-arrear-sheet-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-download
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: expression
            plsqlExpression: 1 != 1
        }
    )

    button salaryslippreview (
        buttonName: SALARYSLIPPREVIEW
        label: Salary Slip
        layout {
            sequence: 30
            region: @salary-arrear-sheet-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
