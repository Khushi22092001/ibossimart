page 611 (
    name: Stock Status Item Wise
    alias: STOCK-STATUS-ITEM-WISE
    title: Stock Status Item Wise
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region stock-status-item-wise (
        name: "Stock Status Item Wise "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
    )

    region stock-status-item-wise-2 (
        name: Stock Status Item Wise
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.ItemCode,
                	-- b.ItemSpecificationCode,
                	a.ItemName as Item,
                    -- b.ItemSpecificationName,
                  --  a.ItemNatureCode,
                	x.Panel,
                	sum(x1.OpeningStockQty1) as OpeningStockQty1,
                	sum(x2.PurchaseInStockQty1) as PurchaseInStockQty1,
                	sum(x3.ProductionInStockQty1) as ProductionInStockQty1,
                	sum(x4.TransferInStockQty1) as TransferInStockQty1,
                	sum(x5.SalesReturnInStockQty1) as SalesReturnInStockQty1,
                /*	x6.PBPassInStockQty1,
                	x7.FreightAdviceInStockQty1,
                	x8.UnloadingInStockQty1,*/
                	sum(x9.JoinInspectionInStockQty1) as JoinInspectionInStockQty1,
                	sum(x10.SaleOutStockQty1) as SaleOutStockQty1,
                	sum(x11.ConsumptionOutStockQty1) as ConsumptionOutStockQty1,
                	sum(x12.TransferOutStockQty1) as TransferOutStockQty1,
                /*	x13.PBPassOutStockQty1,
                	x14.FreightAdviceOutStockQty1,*/
                	sum(x15.PurchaseReturnOutStockQty1) as PurchaseReturnOutStockQty1,
                	sum(x16.ProductionOutStockQty1) as ProductionOutStockQty1,
                	--x17.ClosingQuantity1,
                    sum(
                    nvl(x1.OpeningStockQty1,0) 
                    + nvl(x2.PurchaseInStockQty1,0)
                    + nvl(x3.ProductionInStockQty1,0)  
                    + nvl(x4.TransferInStockQty1,0) 
                    + nvl(x5.SalesReturnInStockQty1,0) 
                    + nvl(x9.JoinInspectionInStockQty1,0) 
                    -(
                    nvl(x10.SaleOutStockQty1,0)
                    + nvl(x12.TransferOutStockQty1,0)
                    + nvl(x11.ConsumptionOutStockQty1,0)
                    + nvl(x15.PurchaseReturnOutStockQty1,0)
                    + nvl(x16.ProductionOutStockQty1,0)
                    )) as ClosingQuantity1
                  --  x17.ItemNatureName
                From Item a, ItemSpecification b,
                	(
                    Select
                        y.ItemCode,
                		y.ItemSpecificationCode,
                		y.Panel
                    From
                        (
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From GRN a, GRNDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P611_COMPANY
                            and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.GRNDate <= :P611_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From CCInvoice a, CCInvoiceDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.CCInvoiceDate <= :P611_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From StockJournal a, StockJournalDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P611_COMPANY
                                and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.StockJournalDate <= :P611_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From CashPurchase a, CashPurchaseDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.CashPurchaseDate <= :P611_TODATE
                        UNION ALL
                        Select
                    		a.ItemCode,
                    		a.ItemSpecificationCode,
                    		a.Panel
                    	From ItemOpening a
                    	Where a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.ItemOpeningDate <= :P611_TODATE
                        UNION ALL
                        Select
                    		b.ItemCode,
                    		b.ItemSpecificationCode,
                    		b.Panel
                    	From Issue a, IssueDetail b
                    	Where a.Tno = b.Tno
                            and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    		and a.IssueDate <= :P611_TODATE
                        ) y
                	Group by 
                		y.ItemCode,
                		y.ItemSpecificationCode,
                		y.Panel
                	) x,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.StockQuantity1) as OpeningStockQty1
                	From
                		(
                        Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			b.Panel,
                			a.AcceptedQuantity1 as StockQuantity1
                		From InspectionDetail a, Inspection b, GRN c
                		Where a.Tno = b.Tno
                			and  b.GRNTno = c.Tno
                			and c.DocTypeCode != 'SALERETURN'
                			and b.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||b.LocationCode||':') > 0 ) 
                			and b.InspectionDate < :P611_FROMDATE
                        UNION ALL  
                        Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as StockQuantity1
                		From CashPurchase a, CashPurchaseDetail b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.CashPurchaseDate < :P611_FROMDATE
                        UNION ALL
                        Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as StockQuantity1
                		From Production a, ProductionFinished b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.ProductionDate < :P611_FROMDATE
                        UNION ALL
                        Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			a.Panel,
                			a.AcceptedQuantity1 as StockQuantity1
                		From InspectionDetail a, Inspection b, GRN c
                		Where a.Tno = b.Tno
                			and  b.GRNTno = c.Tno
                			and c.InterUnitTransferCCInvoiceTno is not null
                			and b.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||b.LocationCode||':') > 0 ) 
                			and b.InspectionDate < :P611_FROMDATE 
                		UNION ALL
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as StockQuantity1
                		From StockJournal a, StockJournalFinished b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.StockJournalDate < :P611_FROMDATE
                        UNION ALL
                        Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			b.Panel,
                			a.AcceptedQuantity1 as StockQuantity1
                		From InspectionDetail a, Inspection b, GRN c
                		Where a.Tno = b.Tno
                			and  b.GRNTno = c.Tno
                			and c.DocTypeCode = 'SALERETURN'
                			and b.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||b.LocationCode||':') > 0 ) 
                			and b.InspectionDate < :P611_FROMDATE
                        UNION ALL
                        Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			b.Panel,
                			a.AcceptedQuantity1 as StockQuantity1
                		From JoinInspectionDetail a, JoinInspection b
                		Where a.Tno = b.Tno
                			and b.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||b.LocationCode||':') > 0 ) 
                			and b.JoinInspectionDate < :P611_FROMDATE
                        UNION ALL
                        Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			-1 * b.Quantity1 as StockQuantity1
                		From CCInvoice a, CCInvoiceDetail b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                            and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                            and a.DocTypeCode not in ('PURCHASERETURN')
                			and a.CCInvoiceDate < :P611_FROMDATE 
                        UNION ALL
                        Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			-1 * b.Quantity1 as StockQuantity1
                		From Issue a, IssueDetail b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                            and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.IssueDate < :P611_FROMDATE
                        UNION ALL
                        Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			-1 * b.Quantity1 as StockQuantity1
                		From StockJournal a, StockJournalRaw b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.StockJournalDate < :P611_FROMDATE
                        UNION ALL
                        Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			-1 * b.Quantity1 as StockQuantity1
                		From CCInvoice a, CCInvoiceDetail b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                            and a.DocTypeCode in ('PURCHASERETURN')
                			and a.CCInvoiceDate < :P611_FROMDATE
                        UNION ALL
                        Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			-1 * b.Quantity1 as StockQuantity1
                		From Production a, ProductionRaw b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.ProductionDate < :P611_FROMDATE
                        UNION ALL
                        Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			a.Panel,
                			a.OpeningQuantity1 as StockQuantity1
                		From ItemOpening a
                		Where a.CompanyCode = :P611_COMPANY
                            and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.ItemOpeningDate < :P611_FROMDATE
                        UNION ALL
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			a.Panel,
                			a.OpeningQuantity1 as StockQuantity1
                		From ItemOpening a
                		Where a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.ItemOpeningDate = :P611_FROMDATE
                            and :P611_FROMDATE = '01-04-2026'
                		)xx
                	Group By
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x1,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.StockQuantity1) as PurchaseInStockQty1
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			b.Panel,
                			a.AcceptedQuantity1 as StockQuantity1
                		From InspectionDetail a, Inspection b, GRN c
                		Where a.Tno = b.Tno
                			and  b.GRNTno = c.Tno
                			and c.DocTypeCode NOT IN  ('SALERETURN','INTERUNITTRANSFER')
                			and b.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||b.LocationCode||':') > 0 ) 
                			and b.InspectionDate between :P611_FROMDATE and :P611_TODATE
                		UNION ALL
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as StockQuantity1
                		From CashPurchase a, CashPurchaseDetail b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.CashPurchaseDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x2,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.StockQuantity1) as ProductionInStockQty1
                	From
                		(
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as StockQuantity1
                		From Production a, ProductionFinished b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.ProductionDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x3,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.StockQuantity1) as TransferInStockQty1
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			a.Panel,
                			a.AcceptedQuantity1 as StockQuantity1
                		From InspectionDetail a, Inspection b, GRN c
                		Where a.Tno = b.Tno
                			and  b.GRNTno = c.Tno
                			and c.InterUnitTransferCCInvoiceTno is not null
                			and b.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||b.LocationCode||':') > 0 ) 
                			and b.InspectionDate between :P611_FROMDATE and :P611_TODATE
                		UNION ALL
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as StockQuantity1
                		From StockJournal a, StockJournalFinished b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.StockJournalDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x4,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.StockQuantity1) as SalesReturnInStockQty1
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			b.Panel,
                			a.AcceptedQuantity1 as StockQuantity1
                		From InspectionDetail a, Inspection b, GRN c
                		Where a.Tno = b.Tno
                			and  b.GRNTno = c.Tno
                			and c.DocTypeCode = 'SALERETURN'
                			and b.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||b.LocationCode||':') > 0 ) 
                			and b.InspectionDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x5,
                	/*(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.StockQuantity1) as PBPassInStockQty1
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			a.Panel,
                			a.StockQuantity1
                		From Stock a
                		Where a.StockModuleCode = 'PBPASS'
                			and a.CompanyCode = :P611_COMPANY
                			and a.StockDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x6,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.StockQuantity1) as FreightAdviceInStockQty1
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			a.Panel,
                			a.StockQuantity1
                		From Stock a
                		Where a.StockModuleCode = 'FREIGHTADVICE'
                			and a.CompanyCode = :P611_COMPANY
                			and a.StockDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x7,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.StockQuantity1) as UnloadingInStockQty1
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			a.Panel,
                			a.StockQuantity1
                		From Stock a
                		Where a.StockModuleCode = 'UNLOADING'
                			and a.CompanyCode = :P611_COMPANY
                			and a.StockDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x8,*/
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.StockQuantity1) as JoinInspectionInStockQty1
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			b.Panel,
                			a.AcceptedQuantity1 as StockQuantity1
                		From JoinInspectionDetail a, JoinInspection b
                		Where a.Tno = b.Tno
                			and b.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||b.LocationCode||':') > 0 ) 
                			and b.JoinInspectionDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x9,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.UsedStockQuantity1) as SaleOutStockQty1
                	From
                		(
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as UsedStockQuantity1
                		From CCInvoice a, CCInvoiceDetail b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                            and a.DocTypeCode not in ('PURCHASERETURN')
                			and a.CCInvoiceDate between :P611_FROMDATE and :P611_TODATE
                
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x10,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.UsedStockQuantity1) as ConsumptionOutStockQty1
                	From
                		(
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as UsedStockQuantity1
                		From Issue a, IssueDetail b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                            and ( :P611_LOCATION IS NULL OR INSTR(':'||:P611_LOCATION||':', ':'||a.LocationCode||':') > 0)
                			and a.IssueDate between :P611_FROMDATE and :P611_TODATE
                
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x11,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.UsedStockQuantity1) as TransferOutStockQty1
                	From
                		(
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as UsedStockQuantity1
                		From StockJournal a, StockJournalRaw b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                            and ( :P611_LOCATION IS NULL OR INSTR(':'||:P611_LOCATION||':', ':'||a.LocationCode||':') > 0)
                			and a.StockJournalDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x12,
                	/*(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.UsedStockQuantity1) as PBPassOutStockQty1
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			a.Panel,
                			b.UsedStockQuantity1
                		From Stock a, UsedStock b
                		Where a.Tno = b.StockTno
                			and b.ModuleCode = 'PBPASS'
                			and b.CompanyCode = :P611_COMPANY
                			and b.UsedStockDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x13,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.UsedStockQuantity1) as FreightAdviceOutStockQty1
                	From
                		(
                		Select
                			a.ItemCode,
                			a.ItemSpecificationCode,
                			a.Panel,
                			b.UsedStockQuantity1
                		From Stock a, UsedStock b
                		Where a.Tno = b.StockTno
                			and b.ModuleCode = 'FREIGHTADVICE'
                			and b.CompanyCode = :P611_COMPANY
                			and b.UsedStockDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x14,*/
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.UsedStockQuantity1) as PurchaseReturnOutStockQty1
                	From
                		(
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as UsedStockQuantity1
                		From CCInvoice a, CCInvoiceDetail b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                            and a.DocTypeCode in ('PURCHASERETURN')
                			and a.CCInvoiceDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x15,
                	(
                	Select
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel,
                		sum(xx.UsedStockQuantity1) as ProductionOutStockQty1
                	From
                		(
                		Select
                			b.ItemCode,
                			b.ItemSpecificationCode,
                			a.Panel,
                			b.Quantity1 as UsedStockQuantity1
                		From Production a, ProductionRaw b
                		Where a.Tno = b.Tno
                			and a.CompanyCode = :P611_COMPANY
                          and ( :P611_LOCATION IS NULL OR instr(':'||:P611_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                			and a.ProductionDate between :P611_FROMDATE and :P611_TODATE
                		) xx
                	Group by
                		xx.ItemCode,
                		xx.ItemSpecificationCode,
                		xx.Panel
                	) x16,
                    ItemNature x17
                    /*,
                	(
                	Select
                		a.ItemCode,
                		a.ItemSpecificationCode,
                		a.Panel,
                		sum(nvl(a.StockQuantity1, 0)) - sum(nvl(a.UsedStockQuantity1, 0)) as ClosingQuantity1
                	From Stock a
                	Where a.CompanyCode = :P611_COMPANY
                		and a.StockDate between :P611_FROMDATE and :P611_TODATE
                	Group by 
                		a.ItemCode,
                		a.ItemSpecificationCode,
                		a.Panel
                	) x17*/
                Where a.Tno = b.Tno
                	and a.ItemCode = x.ItemCode
                	and b.ItemSpecificationCode = x.ItemSpecificationCode
                	
                	and x.ItemCode = x1.ItemCode(+)
                	and x.ItemSpecificationCode = x1.ItemSpecificationCode(+)
                	and x.Panel = x1.Panel(+)
                	
                	and x.ItemCode = x2.ItemCode(+)
                	and x.ItemSpecificationCode = x2.ItemSpecificationCode(+)
                	and x.Panel = x2.Panel(+)
                	
                	and x.ItemCode = x3.ItemCode(+)
                	and x.ItemSpecificationCode = x3.ItemSpecificationCode(+)
                	and x.Panel = x3.Panel(+)
                	
                	and x.ItemCode = x4.ItemCode(+)
                	and x.ItemSpecificationCode = x4.ItemSpecificationCode(+)
                	and x.Panel = x4.Panel(+)
                	
                	and x.ItemCode = x5.ItemCode(+)
                	and x.ItemSpecificationCode = x5.ItemSpecificationCode(+)
                	and x.Panel = x5.Panel(+)
                	
                /*	and x.ItemCode = x6.ItemCode(+)
                	and x.ItemSpecificationCode = x6.ItemSpecificationCode(+)
                	and x.Panel = x6.Panel(+)
                	
                	and x.ItemCode = x7.ItemCode(+)
                	and x.ItemSpecificationCode = x7.ItemSpecificationCode(+)
                	and x.Panel = x7.Panel(+)
                	
                	and x.ItemCode = x8.ItemCode(+)
                	and x.ItemSpecificationCode = x8.ItemSpecificationCode(+)
                	and x.Panel = x8.Panel(+)*/
                	
                	and x.ItemCode = x9.ItemCode(+)
                	and x.ItemSpecificationCode = x9.ItemSpecificationCode(+)
                	and x.Panel = x9.Panel(+)
                	
                	and x.ItemCode = x10.ItemCode(+)
                	and x.ItemSpecificationCode = x10.ItemSpecificationCode(+)
                	and x.Panel = x10.Panel(+)
                	
                	and x.ItemCode = x11.ItemCode(+)
                	and x.ItemSpecificationCode = x11.ItemSpecificationCode(+)
                	and x.Panel = x11.Panel(+)
                	
                	and x.ItemCode = x12.ItemCode(+)
                	and x.ItemSpecificationCode = x12.ItemSpecificationCode(+)
                	and x.Panel = x12.Panel(+)
                	
                /*	and x.ItemCode = x13.ItemCode(+)
                	and x.ItemSpecificationCode = x13.ItemSpecificationCode(+)
                	and x.Panel = x13.Panel(+)
                	
                	and x.ItemCode = x14.ItemCode(+)
                	and x.ItemSpecificationCode = x14.ItemSpecificationCode(+)
                	and x.Panel = x14.Panel(+)*/
                	
                	and x.ItemCode = x15.ItemCode(+)
                	and x.ItemSpecificationCode = x15.ItemSpecificationCode(+)
                	and x.Panel = x15.Panel(+)
                	
                	and x.ItemCode = x16.ItemCode(+)
                	and x.ItemSpecificationCode = x16.ItemSpecificationCode(+)
                	and x.Panel = x16.Panel(+)
                    
                    and a.ItemNatureCode = x17.ItemNatureCode(+)
                    and ( :P611_ITEMNATURE IS NULL OR INSTR(':'||:P611_ITEMNATURE||':', ':'||a.ItemNatureCode||':') > 0)
                  and ( :P611_ITEM IS NULL OR INSTR(':'||:P611_ITEM||':', ':'||a.ItemCode||':') > 0)
                  and ( :P611_ITEMCATEGORY IS NULL OR INSTR(':'||:P611_ITEMCATEGORY||':', ':'||b.ItemCategoryCode||':') > 0)
                    and a.ItemNatureCode not in ('SERVICES','ASSET','SCRAP')  --'STOREITEM',         
                	     and ( GetUserPanelAB_apex() is null  or x.panel = GetUserPanelAB_apex())
                /*	and x.ItemCode = x17.ItemCode(+)
                	and x.ItemSpecificationCode = x17.ItemSpecificationCode(+)
                	and x.Panel = x17.Panel(+)*/
                 
                Group By 
                	a.ItemCode,
                	a.ItemName,
                   -- a.ItemNatureCode,
                	x.Panel
                 --   x17.ItemNatureName
                ;
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
