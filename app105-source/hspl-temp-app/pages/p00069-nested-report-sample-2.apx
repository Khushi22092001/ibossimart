page 69 (
    name: Nested Report Sample 2
    alias: NESTED-REPORT-SAMPLE-2
    title: Nested Report Sample 2
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            var gThis1;
            var gThis2;
            var gThis3;
            ```
    }
    security {
        formAutoComplete: false
    }

    region department (
        name: Department
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.SalaryFromDate,
                      a.DepartmentCode,
                      a.Department,
                      Sum(a.NetEarning) as TotalAmount
                From  SalaryEngineDetail a
                Where a.SalaryFromDate = :P69_SALARYFROMDATE
                Group by a.SalaryFromDate,
                      a.DepartmentCode,
                      a.Department
                Order by a.Department
                ```
            pageItemsToSubmit: P69_SALARYFROMDATE
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: siddept
            customAttributes: style="display:none"
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
                t-Report--inline
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DEPARTMENT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: DEPARTMENT
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column DEPARTMENTCODE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: link
            heading {
                heading: EMPLOYEES
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: javascript: void(0);
                }
                linkText: <span class="t-Icon fa fa-users"></span>
                linkAttributes: class="setDept" data-deptcode="#DEPARTMENTCODE#"
            }
            sorting {
                sortable: false
            }
        )

        column SALARYFROMDATE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column TOTALAMOUNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: TOTAL AMOUNT
                alignment: center
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

    )

    region employees (
        name: Employees
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.EmpId,
                      a.EmployeeName,
                      a.Designation,
                      sum(a.NetEarning)as TotalAmount
                From  SalaryEngineDetail a
                Where a.DepartmentCode = :P69_DEPTCODE
                Group by a.EmpId,
                      a.EmployeeName,
                      a.Designation
                Order by a.EmpId
                ```
            pageItemsToSubmit: P69_DEPTCODE
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent3
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: sidemp
            customAttributes: style="display:none"
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DESIGNATION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: DESIGNATION
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column EMPID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: EMP ID
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                sortable: false
            }
        )

        column EMPLOYEENAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: EMPLOYEE NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column TOTALAMOUNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: TOTAL AMOUNT
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

    )

    region month (
        name: Month
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     a.Company,
                     a.SalaryMonth,
                     a.SalaryFromDate,
                     sum(a.NetEarning) as TotalAmount
                From SalaryEngineDetail a
                Group by a.Company,
                     a.SalaryMonth,
                     a.SalaryFromDate
                Order by 3
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent2
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            lazyLoading: true
        }

        column COMPANY (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: COMPANY
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column DERIVED$01 (
            reportColumnQueryId: 5
            derivedColumn: Y
            type: link
            heading {
                heading: DEPARTMENTS
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            link {
                target: {
                    type: url
                    url: javascript: void(0);
                }
                linkText: <span class="t-Icon fa fa-angle-double-down"></span>
                linkAttributes: class="setMonth" data-month = "#SALARYFROMDATE#"
            }
            sorting {
                sortable: false
            }
        )

        column SALARYFROMDATE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 40
            }
        )

        column SALARYMONTH (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: SALARY MONTH
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column TOTALAMOUNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: TOTAL AMOUNT
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P69_DEPTCODE (
        type: hidden
        layout {
            sequence: 20
            region: @month
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P69_SALARYFROMDATE (
        type: hidden
        layout {
            sequence: 10
            region: @month
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction after-refresh-department (
        name: After Refresh Department
        execution {
            sequence: 20
            eventScope: dynamic
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @department
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var vThis = gThis1;
                    var vTRID = $v('P69_SALARYFROMDATE');
                    var vColSpan = $(vThis).closest("tr").find("td").length;
                    var vClass = $(vThis).closest("td").attr("class");
                    var vTR = $(vThis).closest("tr");
                    var vReportHTML = $('#siddept').clone();
                    vReportHTML = $(vReportHTML).removeAttr("id");
                    vReportHTML = $(vReportHTML).css("display", "block");
                    var vReportHTMLFinal = $('<div>').append($(vReportHTML)).html();
                    $(vTR).after('<tr id="siddept_'+vTRID+'" class="level1_row" style="display: none;"><td class="'+vClass+'" colspan="'+vColSpan+'" style="padding: 15px;">'+vReportHTMLFinal+'</td></tr>');
                    $('tr.level1_row').slideDown(1000);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction after-refresh-employee (
        name: After Refresh Employee
        execution {
            sequence: 40
            eventScope: dynamic
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @employees
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    console.log("After Refresh Employee");
                    var vThis = gThis2;
                    var vTRID = $v('P69_DEPTCODE');
                    var vColSpan = $(vThis).closest("tr").find("td").length;
                    console.log(vColSpan);
                    var vClass = $(vThis).closest("td").attr("class");
                    var vTR = $(vThis).closest("tr");
                    var vReportHTML = $('#sidemp').clone();
                    vReportHTML = $(vReportHTML).removeAttr("id");
                    vReportHTML = $(vReportHTML).css("display", "block");
                    var vReportHTMLFinal = $('<div>').append($(vReportHTML)).html();
                    $(vTR).after('<tr id="sidemp_'+vTRID+'" class="level2_row" style="display: none;"><td class="'+vClass+'" colspan="'+vColSpan+'" style="padding: 15px;">'+vReportHTMLFinal+'</td></tr>');
                    $('tr.level2_row').slideDown(1000);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction on-click-prepare-department-region (
        name: On Click - Prepare Department Region
        execution {
            sequence: 10
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .setMonth
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('tr.level1_row').slideUp(500, function(){$(this).remove();});
                    gThis1 = $(this.triggeringElement);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @department
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).attr("data-month")
            }
            affectedElements {
                selectionType: items
                items: P69_SALARYFROMDATE
            }
            execution {
                sequence: 20
            }
        )

    )

    dynamicAction on-click-prepare-employee-region (
        name: On Click - Prepare Employee Region
        execution {
            sequence: 30
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .setDept
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('tr.level2_row').slideUp(500, function(){$(this).remove();});
                    gThis2 = $(this.triggeringElement);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @employees
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: $(this.triggeringElement).attr("data-deptcode")
            }
            affectedElements {
                selectionType: items
                items: P69_DEPTCODE
            }
            execution {
                sequence: 20
            }
        )

    )

)

