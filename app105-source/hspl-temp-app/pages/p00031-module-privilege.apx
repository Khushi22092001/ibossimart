    region module-privilege-2 (
        name: Module Privilege
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by b.loginname) SerialNo,
                    a.BossUserCode,
                    a.ModuleCode,
                    lo.LocationName,
                    sl.StorageLocationName,
                    do.DoctypeName,
                    de.DepartmentName,
                    it.ItemName,
                    ac.AccountName,
                    ig.ItemGroupName,
                    itn.ItemNatureName,
                    br.BranchName,
                    b.LoginName,
                    c.ModuleName,
                    d.CompanyName,
                    a.ViewPrivilege,
                    a.InsertPrivilege,
                    a.UpdatePrivilege,
                    a.DeletePrivilege,
                    a.StatusPrivilege,
                    a.ControlPrivilege,
                    a.OtherPrivilege,
                    a.AllowedBackDays,
                    a.AllowedForwardDays,
                    a.VoucherPostingDate,
                    e.EmployeeName
                From ModulePrivilege a,
                (
                Select
                a.Tno,
                listagg(b.LocationName,',') within group (order by rownum) as LocationName
                From ModulePrivilegeLocation a, Location b
                Where a.LocationCode = b.LocationCode
                Group by a.Tno
                ) lo,
                (
                Select
                a.Tno,
                listagg(b.StorageLocationName,',') within group (order by rownum) as StorageLocationName
                From ModulePrivilegeSL a, StorageLocation b
                Where a.StorageLocationCode = b.StorageLocationCode
                Group by a.Tno
                ) sl,
                (
                Select
                a.Tno,
                listagg(b.DoctypeName,',') within group (order by rownum) as DoctypeName
                From ModulePrivilegeDoctype a, Doctype b
                Where a.DoctypeCode = b.DoctypeCode
                Group by a.Tno
                )do,
                (
                Select
                a.Tno,
                listagg(b.DoctypeName,',') within group (order by rownum) as DepartmentName
                From ModulePrivilegeDoctype a, Doctype b
                Where a.DoctypeCode = b.DoctypeCode
                Group by a.Tno
                )de,
                (
                Select
                a.Tno,
                listagg(b.ItemName,',') within group (order by rownum) as ItemName
                From ModulePrivilegeItem a, Item b
                Where a.ItemCode = b.ItemCode
                Group by a.Tno
                )it,
                (
                Select
                a.Tno,
                listagg(b.PartyName,',') within group (order by rownum) as AccountName
                From ModulePrivilegeAccount a, Party b
                Where a.AccountCode = b.PartyCode
                Group by a.Tno
                ) ac,
                (
                Select
                a.Tno,
                listagg(b.ItemGroupName,',') within group (order by rownum) as ItemGroupName
                From ModulePrivilegeItemGroup  a, ItemGroup b
                Where a.ItemGroupCode = b.ItemGroupCode
                Group by a.Tno
                ) ig,
                (
                Select
                a.Tno,
                listagg(b.ItemNatureName,',') within group (order by rownum) as ItemNatureName
                From ModulePrivilegeItemNature  a, ItemNature b
                Where a.ItemNatureCode = b.ItemNatureCode
                Group by a.Tno
                ) itn,
                (
                Select
                a.Tno,
                listagg(b.BranchName,',') within group (order by rownum) as BranchName
                From ModulePrivilegeBranch  a, Branch b
                Where a.BranchCode = b.BranchCode
                Group by a.Tno
                ) br, BossUser b, Module c, Company d, Employee e
                Where a.Tno = lo.Tno(+)
                and a.Tno = sl.Tno(+)
                and a.Tno = do.Tno(+)
                and a.Tno = de.Tno(+)
                and a.Tno = it.Tno(+)
                and a.Tno = ac.Tno(+)
                and a.Tno = ig.Tno(+)
                and a.Tno = itn.Tno(+)
                and a.Tno = br.Tno(+)
                and a.BossUserCode = b.BossUserCode
                and a.ModuleCode = c.ModuleCode
                and a.CompanyCode = d.CompanyCode
                and b.EmployeeCode = e.EmployeeCode
                and a.ViewPrivilege = 'YES'
                and instr(':'||:P31_COMPANY||':',':'||d.CompanyCode||':') > 0
                and ( :P31_BOSSUSER IS NULL OR instr(':'||:P31_BOSSUSER||':',':'||b.BossUserCode||':') > 0 ) 
                and ( :P31_MODULE IS NULL OR instr(':'||:P31_MODULE||':',':'||c.ModuleCode||':') > 0 ) 
                Order By b.LoginName, c.ModuleName
                --and B.BOSSUSERNAME = 'MOHIT' ;
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                /*Select
                      a.TNo,
                      c.CompanyName,
                      bu.LoginName,
                      m.ModuleName,
                      a.ViewPrivilege,
                      a.InsertPrivilege,
                      a.UpdatePrivilege,
                      a.DeletePrivilege,
                      a.StatusPrivilege,
                      a.PrintPrivilege,
                      a.OtherPrivilege,
                      a.ControlPrivilege,
                      a.AllowedBackDays,
                      a.AllowedForwardDays,
                      a.VoucherPostingDate
                From  ModulePrivilege a , Module m, Bossuser bu, Company c
                Where a.ModuleCode = m.ModuleCode
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and a.ViewPrivilege = 'YES'
                  and instr(':'||:P31_COMPANY||':',':'||c.CompanyCode||':') > 0
                  and ( :P31_BOSSUSER IS NULL OR instr(':'||:P31_BOSSUSER||':',':'||bu.BossUserCode||':') > 0 ) 
                  and ( :P31_MODULE IS NULL OR instr(':'||:P31_MODULE||':',':'||m.ModuleCode||':') > 0 ) 
                  order by bu.LoginName,m.ModuleName*/
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
