page 29 (
    name: Boss User Detail
    alias: BOSS-USER-DETAIL
    title: Boss User Detail
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region boss-user-details (
        name: Boss User Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                       row_number() over(order by a.bossusername) SerialNo,
                      a.BOSSUSERNAME,
                      a.LOGINNAME,
                     -- a.BOSSPASSWORD,
                      e.EMPLOYEENAME
                FROM  BOSSUSER a, EMPLOYEE e
                WHERE a.BOSSUSERCODE != '1'
                  AND a.EMPLOYEECODE = e.EMPLOYEECODE(+)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 3860347192281727
        }

        column BOSSUSERNAME (
            type: plainText
            heading {
                heading: BOSS USER NAME
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column EMPLOYEENAME (
            type: plainText
            heading {
                heading: EMPLOYEE NAME
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column LOGINNAME (
            type: plainText
            heading {
                heading: LOGIN NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Boss User Details
        }

        savedReport 40032 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BOSSUSERNAME (
                sequence: 2
            )

            displayColumn EMPLOYEENAME (
                sequence: 4
            )

            displayColumn LOGINNAME (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

