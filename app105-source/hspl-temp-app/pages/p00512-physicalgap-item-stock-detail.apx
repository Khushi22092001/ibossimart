page 512 (
    name: Physicalgap Item Stock Detail
    alias: PHYSICALGAP-ITEM-STOCK-DETAIL
    title: Physicalgap Item Stock Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region physical-gap-item-stock-card (
        name: Physical gap Item Stock Card
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH TxnData AS (
                    SELECT
                        t.physicalgapitemcode AS ITEMCODE,
                        t.TransactionNo,
                        t.TransactionDate,
                        t.stockquantity1     AS INQTY,
                        t.stockamount        AS INAMT,
                        t.usedstockquantity1 AS OUTQTY,
                        t.usedstockamount    AS OUTAMT
                    FROM Physicalgapitemtransaction t
                    WHERE t.TransactionDate BETWEEN :P512_FROMDATE AND :P512_TODATE
                      AND (:P512_ITEM IS NULL OR t.physicalgapitemcode = :P512_ITEM)
                ),
                PrevOpening AS (
                    -- Opening balance before the start date
                    SELECT
                        t.physicalgapitemcode AS ITEMCODE,
                        SUM(NVL(t.stockquantity1,0) - NVL(t.usedstockquantity1,0)) AS OpeningQty,
                        SUM(NVL(t.stockamount,0)    - NVL(t.usedstockamount,0))    AS OpeningAmt
                    FROM Physicalgapitemtransaction t
                    WHERE t.TransactionDate < :P512_FROMDATE
                      AND (:P512_ITEM IS NULL OR t.physicalgapitemcode = :P512_ITEM)
                    GROUP BY t.physicalgapitemcode
                ),
                TxnRunning AS (
                    SELECT
                        d.ITEMCODE,
                        d.TransactionDate,
                        d.TransactionNo,
                        d.INQTY,
                        d.INAMT,
                        d.OUTQTY,
                        d.OUTAMT,
                        SUM(NVL(d.INQTY,0) - NVL(d.OUTQTY,0)) 
                            OVER (PARTITION BY d.ITEMCODE ORDER BY d.TransactionDate, d.TransactionNo ROWS UNBOUNDED PRECEDING) AS RunningQty,
                        SUM(NVL(d.INAMT,0) - NVL(d.OUTAMT,0)) 
                            OVER (PARTITION BY d.ITEMCODE ORDER BY d.TransactionDate, d.TransactionNo ROWS UNBOUNDED PRECEDING) AS RunningAmt
                    FROM TxnData d
                ),
                FinalClosing AS (
                    SELECT
                        i.ITEMCODE,
                        i.ITEMNAME,
                        :P512_TODATE AS TransactionDate,
                        CAST('Closing Balance' AS VARCHAR2(50)) AS TransactionNo,
                        0 AS OpeningQty,
                        0 AS OpeningAmt,
                        0 AS InQty,
                        0 AS InAmt,
                        0 AS OutQty,
                        0 AS OutAmt,
                        NVL(p.OpeningQty,0) + NVL(sum(d.InQty),0) - NVL(sum(d.OutQty),0) AS ClosingQty,
                        NVL(p.OpeningAmt,0) + NVL(sum(d.InAmt),0) - NVL(sum(d.OutAmt),0) AS ClosingAmt
                    FROM item i
                    LEFT JOIN PrevOpening p ON i.ITEMCODE = p.ITEMCODE
                    LEFT JOIN TxnRunning d ON i.ITEMCODE = d.ITEMCODE
                    WHERE (:P512_ITEM IS NULL OR i.ITEMCODE = :P512_ITEM)
                    GROUP BY i.ITEMCODE, i.ITEMNAME, p.OpeningQty, p.OpeningAmt
                    
                )
                -- Opening Balance row
                SELECT 
                    i.ITEMCODE,
                    i.ITEMNAME,
                    TO_DATE(:P512_FROMDATE,'DD-MM-RRRR') AS TransactionDate,
                    CAST('Opening Balance' AS VARCHAR2(50)) AS TransactionNo,
                    NVL(p.OpeningQty,0) AS OpeningQty,
                    NVL(p.OpeningAmt,0) AS OpeningAmt,
                    0 AS InQty,
                    0 AS InAmt,
                    0 AS OutQty,
                    0 AS OutAmt,
                    NVL(p.OpeningQty,0) AS ClosingQty,
                    NVL(p.OpeningAmt,0) AS ClosingAmt
                FROM item i
                LEFT JOIN PrevOpening p ON i.ITEMCODE = p.ITEMCODE
                WHERE (:P512_ITEM IS NULL OR i.ITEMCODE = :P512_ITEM)
                
                UNION ALL
                -- Transaction-wise rows
                SELECT
                    i.ITEMCODE,
                    i.ITEMNAME,
                    d.TransactionDate,
                    CAST(d.TransactionNo AS VARCHAR2(50)) AS TransactionNo,
                    NVL(LAG(d.RunningQty,1,0) OVER (PARTITION BY d.ITEMCODE ORDER BY d.TransactionDate, d.TransactionNo)
                       + NVL(p.OpeningQty,0), NVL(p.OpeningQty,0)) AS OpeningQty,
                    NVL(LAG(d.RunningAmt,1,0) OVER (PARTITION BY d.ITEMCODE ORDER BY d.TransactionDate, d.TransactionNo)
                       + NVL(p.OpeningAmt,0), NVL(p.OpeningAmt,0)) AS OpeningAmt,
                    d.InQty,
                    d.InAmt,
                    d.OutQty,
                    d.OutAmt,
                    d.RunningQty + NVL(p.OpeningQty,0) AS ClosingQty,
                    d.RunningAmt + NVL(p.OpeningAmt,0) AS ClosingAmt
                FROM TxnRunning d
                JOIN item i ON i.ITEMCODE = d.ITEMCODE
                LEFT JOIN PrevOpening p ON d.ITEMCODE = p.ITEMCODE
                
                UNION ALL
                -- Final Closing Balance row
                SELECT
                    f.ITEMCODE,
                    f.ITEMNAME,
                    TO_DATE(:P512_TODATE,'DD-MM-RRRR') AS TransactionDate,
                    f.TransactionNo,
                    f.OpeningQty,
                    f.OpeningAmt,
                    f.InQty,
                    f.InAmt,
                    f.OutQty,
                    f.OutAmt,
                    f.ClosingQty,
                    f.ClosingAmt
                FROM FinalClosing f
                
                ORDER BY ITEMNAME, TransactionDate, TransactionNo;
                
                ```
            pageItemsToSubmit: [
                P512_FROMDATE
                P512_TODATE
                P512_ITEM
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 110757770557193621
        }

