page 509 (
    name: Payment Program
    alias: PAYMENT-PROGRAM
    title: Payment Program
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payment-program-register (
        name: Payment Program Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region payment-program-register-2 (
        name: Payment Program Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    row_number() over(order by a.PaymentAdviceDate) SerialNo,
                    a.partycode,
                    c.partyname,
                    a.amountcr,
                    'Rs. ' || getcurrencyinword(a.amountcr, 'Rs.') As amtinword,
                    GetPaymentAdviceReference(a.tno) Reference,
                    e.bankname,
                    d.ifsccode,
                    d.accountno,
                    a.Remark,
                    f.MoneyTransferModeName
                From paymentadvice a, party c, partybankdetail d, bank e, MoneyTransferMode f
                Where a.partycode = c.partycode
                    And a.partybanktno = d.tno(+)
                    And a.partybanksno = d.sno(+)
                    And d.bankcode = e.bankcode(+)
                    and a.MoneyTransferModeCode = f.MoneyTransferModeCode(+)
                    and a.PaymentAdviceDate between :P509_FROMDATE and :P509_TODATE
                    and ( :P509_COMPANY IS NULL OR instr(':'||:P509_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                    and ( :P509_LOCATION IS NULL OR instr(':'||:P509_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                    and ( :P509_PARTY IS NULL OR instr(':'||:P509_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P509_MODEOFTRANSACTION IS NULL OR instr(':'||:P509_MODEOFTRANSACTION||':',':'||a.MoneyTransferModeCode||':') > 0 ) 
                ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 94288887707702301
        }

        column ACCOUNTNO (
            type: plainText
            heading {
                heading: Account No
            }
            layout {
                sequence: 200
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AH
            }
        )

        column AMOUNTCR (
            type: plainText
            heading {
                heading: Amount CR
                alignment: end
            }
            layout {
                sequence: 150
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AC
            }
        )

        column AMTINWORD (
            type: plainText
            heading {
