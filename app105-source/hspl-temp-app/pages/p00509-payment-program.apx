        }

        savedReport 557839 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTNO (
                sequence: 7
            )

            displayColumn AMOUNTCR (
                sequence: 3
            )

            displayColumn AMTINWORD (
                sequence: 4
            )

            displayColumn BANKNAME (
                sequence: 9
            )

            displayColumn IFSCCODE (
                sequence: 8
            )

            displayColumn MONEYTRANSFERMODENAME (
                sequence: 10
            )

            displayColumn PARTYNAME (
                sequence: 2
            )

            displayColumn REFERENCE (
                sequence: 5
            )

            displayColumn REMARK (
                sequence: 6
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: DEBITAMOUNT
            )

            aggregate (
                column: LOADINGQUANTITY
            )

            aggregate (
                column: REACHEDQUANTITY1
            )

            aggregate (
                column: PASSQUANTITY
            )

            aggregate (
