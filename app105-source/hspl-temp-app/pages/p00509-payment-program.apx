        column PARTYNAME (
            type: plainText
            heading {
                heading: Party Name
            }
            layout {
                sequence: 140
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:180px">#PARTYNAME#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AB
            }
