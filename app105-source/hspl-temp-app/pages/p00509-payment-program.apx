            )

            aggregate (
                column: TDSDEDUCTABLEAMOUNT
            )

            aggregate (
                column: NETPAYABLEAMOUNT
            )

            aggregate (
                column: TDSAMOUNT
            )

            aggregate (
                column: AMOUNTCR
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P509_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                   a.CompanyName d,
                   a.CompanyCode r
                From Company a
                Where exists
                (Select
                   aa.Tno
                   From PaymentAdvice aa
                   Where aa.CompanyCode = a.CompanyCode) 
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @payment-program-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Select Company Name
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
    )

