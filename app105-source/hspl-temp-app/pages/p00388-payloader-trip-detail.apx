page 388 (
    name: Payloader Trip Detail
    alias: PAYLOADER-TRIP-DETAIL
    title: Payloader Trip Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-trip-detail (
        name: Payloader  Trip Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by a.freightAdvanceDate) SerialNo,
                   a.CompanyCode,
                   a.Amount,
                   a.FreightAdvanceNo as ModuleNo,
                   a.FreightAdvanceDate as ModuleDate,
                   b.Tno as EquipmentTno,
                   b.EquipmentID,
                   c.ModuleName,
                   lo.LocationName
                From FreightAdvance a, Equipment b, Module c,DocumentStatusDetail dsd, Location lo
                Where a.EquipmentTno = b.Tno
                   and a.LocationCode = lo.LocationCode
                   and c.Modulecode = 'FREIGHTADVANCE'
                   and a.Tno = dsd.ModuleTno
                   and dsd.DocumentStatusCode = 'ACTIVE'
                   and a.DrAccountCode = 'TRIPEXPENSES'
                   and b.EquipmentGroupCode = 'PL'
                   and nvl(a.Amount, 0) > 0
                   and a.EquipmentTno is not null
                   and a.VehicleGroupCode = 'SELF'
                   and (:P388_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                   and a.FreightAdvanceDate between :P388_FROMDATE and :P388_TODATE
                   and (:P388_COMPANYCODE is Null Or Instr (':' || :P388_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                   and (:P388_EQUIPMENTID is Null Or Instr (':' || :P388_EQUIPMENTID || ':' , ':' || b.Tno || ':') > 0)
                UNION ALL
                Select
                   row_number() over(order by a.FreightAdvanceDate) SerialNo,
                   a.CompanyCode,
                   a.Amount2 as Amount,
                   a.FreightAdvanceNo as ModuleNo,
                   a.FreightAdvanceDate as ModuleDate,
                   b.Tno as EquipmentTno,
                   b.EquipmentID,
                   c.ModuleName,
                   lo.LocationName
                From FreightAdvance a, Equipment b,Module c, DocumentStatusDetail dsd, Location lo
                Where a.EquipmentTno = b.Tno
                   and a.LocationCode = lo.LocationCode
                   and c.ModuleCode = 'FREIGHTADVANCE'
                   and a.Tno = dsd.ModuleTno
                   and dsd.DocumentStatusCode = 'ACTIVE'
                   and a.DrAccountCode2 = 'TRIPEXPENSES'
                   and b.EquipmentGroupCode = 'PL'
                   and nvl(a.Amount2, 0) > 0
                   and a.VehicleNo is not null
                   and a.VehicleGroupCode = 'SELF'
                   and (:P388_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                   and a.FreightAdvanceDate between :P388_FROMDATE and :P388_TODATE
                   and (:P388_COMPANYCODE is Null Or Instr (':' || :P388_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                   and (:P388_EQUIPMENTID is Null Or Instr (':' || :P388_EQUIPMENTID || ':' , ':' || b.Tno || ':') > 0)
                
                ```
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 890305368843418267
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column COMPANYCODE (
