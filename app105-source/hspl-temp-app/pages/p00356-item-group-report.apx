page 356 (
    name: Item Group Report
    alias: ITEM-GROUP-REPORT
    title: Item Group Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region item-group-master (
        name: Item Group Master
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region item-group-report (
        name: Item Group Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by e.ItemCode) SerialNo,
                GetItemName(e.ParentCode) As ParentGroupName,
                e.ItemCode,
                e.ItemName,
                e.ItemClassificationCode,
                e.ProcurementStrategy,
                e.OrderingPolicy,
                sa.PartyName as StockAccount,
                ca.PartyName as ConsumptionAccount,
                cw.PartyName as CWIPAccount,
                e.Remark
                From Item e, ItemSpecification ee, Party sa, Party ca, Party cw
                Where e.TNo = ee.TNo(+)
                  and e.StockAccountCode = sa.PartyCode(+)
                  and e.ConsumptionAccountCode = ca.PartyCode(+)
                  and e.CWIPAccountCode = cw.PartyCode(+)
                 -- and instr(':'||:P9_COMPANY||':',':'||e.CompanyCode||':') > 0
                 -- and e.CompanyCode = :P9_COMPANY
                  and e.ItemType = 'GROUP';
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 73873528754731531
        }

        savedReport 740959 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @SERIALNO
                layout {
                    width: 94
                    sequence: 1
                }
            )

            displayColumn (
                column: @PARENTGROUPNAME
                layout {
                    width: 145
                    sequence: 2
                }
            )

            displayColumn (
                column: @ITEMCODE
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @ITEMNAME
                layout {
                    width: 216
                    sequence: 4
                }
            )

            displayColumn (
                column: @ITEMCLASSIFICATIONCODE
                layout {
                    show: false
                    sequence: 5
                }
            )

            displayColumn (
                column: @PROCUREMENTSTRATEGY
                layout {
                    width: 169
                    sequence: 6
                }
            )

            displayColumn (
                column: @ORDERINGPOLICY
                layout {
                    width: 127
                    sequence: 7
                }
            )

            displayColumn (
                column: @STOCKACCOUNT
                layout {
                    width: 278
                    sequence: 8
                }
            )

            displayColumn (
                column: @CONSUMPTIONACCOUNT
                layout {
                    width: 228
                    sequence: 9
                }
            )

            displayColumn (
                column: @CWIPACCOUNT
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 11
                }
            )

            sort (
                column: @SERIALNO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            aggregate count (
                column: @ITEMCODE
                function: count
            )

            aggregate count-2 (
                column: @SERIALNO
                function: count
                showGrandTotal: true
            )

        )

