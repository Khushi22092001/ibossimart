        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.CompanyName d,
                a.CompanyCode r
                From Company a
                Where exists(
                   Select
                      aa.CompanyCode
                   From ACCESSORIESMANAGEMENT aa
                   Where aa.CompanyCode = a.CompanyCode
                )
                Order by 1;
                
                
                ```
            displayNullValue: false
        }
