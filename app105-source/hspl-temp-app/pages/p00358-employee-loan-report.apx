page 358 (
    name: Employee Loan Report
    alias: EMPLOYEE-LOAN-REPORT
    title: Employee Loan Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employee-loan-report (
        name: Employee Loan Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                c.EmployeeName || ' - ' || c.EmployeeID as EmployeeName,
                row_number() over(order by c.EmployeeName) SerialNo,
                c.EmployeeCode,
                d.LoanTypeName,
                d.LoanTypeCode,
                'EMP Details',
                abs(GetAccountOPENING(ela.EmployeeLoanAccountCode,TO_DATE(:P358_FROMDATE,'DD-MM-RRRR'),null, a.companycode)) AS Opening,
                sum(a.TotalAmount) as ReceivedAmount,
                abs(nvl(sum(e.SalaryHeadAmount),0)) AS Repayment,
                abs(GetAccountOPENING(ela.EmployeeLoanAccountCode,TO_DATE(:P358_FROMDATE,'DD-MM-RRRR'),null, a.companycode)) + sum(a.TotalAmount) 
                - abs(nvl(sum(e.SalaryHeadAmount),0)) as BalanceAmount
                From LoanSanction a, LoanRequest b, EmployeeLoanAccount ela,Employee c, LoanType d,
                (Select
                  a.EmployeeCode,
                  b.SalaryHeadCode,
                  sum(b.SalaryHeadAmount) as SalaryHeadAmount
                  From Salary a, SalaryDetail b
                  Where a.Tno = b.Tno(+)
                  and a.SalaryDate between :P358_FROMDATE and :P358_TODATE
                  Group by a.EmployeeCode,
                  b.SalaryHeadCode) e
                Where a.LoanRequestTno = b.Tno
                and b.EmployeeCode = ela.EmployeeCode
                and b.EmployeeCode = c.EmployeeCode
                and ela.LoanTypeCode = d.LoanTypeCode
                and a.LoanTypeCode = d.LoanTypeCode
                and b.EmployeeCode = e.EmployeeCode(+)
                and b.LoanTypeCode = e.SalaryHeadCode(+)
                and a.LoanSanctionDate between :P358_FROMDATE and :P358_TODATE
                and ( :P358_COMPANY IS NULL OR instr(':'||:P358_COMPANY||':',':'||a.CompanyCode||':') > 0)
                and ( :P358_LOCATION IS NULL OR instr(':'||:P358_LOCATION||':',':'||a.LocationCode||':') > 0)
                and ( :P358_LOANTYPE IS NULL OR instr(':'||:P358_LOANTYPE||':',':'||a.LoanTypeCode||':') > 0)
                and ( :P358_EMPLOYEE IS NULL OR instr(':'||:P358_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0)
                and :P358_FROMDATE is not null
                Group by
                c.EmployeeCode,
                ela.EmployeeLoanAccountCode,
                c.EmployeeName, 
                c.EmployeeID,
                d.LoanTypeName,
                d.LoanTypeCode,
                a.CompanyCode
                 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 78326679968369020
        }

        column 'EMPDETAILS' (
            type: link
            heading {
                heading: DETAIL
                alignment: center
            }
            layout {
                sequence: 70
            }
            link {
