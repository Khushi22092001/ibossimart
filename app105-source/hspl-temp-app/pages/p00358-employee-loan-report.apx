        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontSize: 14
            pageHeaderText:
                ```
                Employee Loan Report
                From : &P358_FROMDATE. TO &P358_TODATE.
                ```
        }

        savedReport 792468 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn 'EMPDETAILS' (
                sequence: 8
            )

            displayColumn BALANCEAMOUNT (
                sequence: 7
            )

            displayColumn EMPLOYEENAME (
                sequence: 2
            )

            displayColumn LOANTYPENAME (
                sequence: 3
            )

            displayColumn OPENING (
                sequence: 4
            )

            displayColumn RECEIVEDAMOUNT (
                sequence: 5
            )

            displayColumn REPAYMENT (
                sequence: 6
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: OPENING
            )

            aggregate (
                column: RECEIVEDAMOUNT
            )

            aggregate (
                column: REPAYMENT
            )

            aggregate (
                column: BALANCEAMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P358_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.CompanyName d,
                a.CompanyCode r
                From Company a
                Where exists(
                   Select
                      aa.CompanyCode
                   From LoanSanction aa
                   Where aa.CompanyCode = a.CompanyCode
                )
                Order by 1
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @employee-loan-report
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

