                    page: 359
                    items: {
                        P359_FROMDATE: &P358_FROMDATE.
                        P359_TODATE: &P358_TODATE.
                        P359_LOANTYPE: #LOANTYPECODE#
                        P359_EMPLOYEE: #EMPLOYEECODE##EMPLOYEELOANACCOUNTCODE#
                    }
                }
                linkText: Emp Detail
                linkAttributes: class="t-Button t-Button--simple t-Button--hot t-Button--stretch"
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column BALANCEAMOUNT (
            type: plainText
