                Select b.DespatchAdviceNo 
                From LoadingSlip a, DespatchAdvice B
                Where a.DespatchadviceTno = b.tno(+)
                  and instr(':'||:P142_LOCATION||':',':'||a.LocationCode||':') > 0
                  and a.LoadingSlipDate Between :P142_FROMDATE and :P142_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P142_LOCATION
            itemsToSubmit: P142_SONO
