                Select Distinct C.PARTYNAME D, C.PARTYCODE R
                  From DELIVERYAPPOINTMENT A, SALESORDER B, PARTY C
                 Where A.SALESORDERTNO = B.TNO
                   And B.CONSIGNEECODE = C.PARTYCODE
                 Order By 1
                
