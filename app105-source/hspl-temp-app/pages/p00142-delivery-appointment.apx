    region delivery-appointment-register-report (
        name: Delivery Appointment Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.deliveryappointmentno,
                       a.deliveryappointmentdate,
                       b.salesorderno,
                       b.salesorderdate,
                       d.partyname,
                       c.transportallocationno,
                       c.transportallocationdate,
                       e.cityname,
                       e.distance,
                       e.leadtime,
                       f.statename,
                       g.partyname As TransporterName
                  From deliveryappointment a,
                       salesorder          b,
                       transportallocation c,
                       Party               d,
                       city                e,
                       state               f,
                       party               g
                 Where a.salesordertno = b.tno(+)
                   And b.consigneecode = d.partycode(+)
                   And a.tno = c.moduletno(+)
                   And Nvl(d.workscitycode, d.officecitycode) = e.citycode(+)
                   And Nvl(d.worksstatecode, d.worksstatecode) = f.statecode(+)
                   And c.transportercode = g.partycode(+)
                  and a.DeliveryAppointmentDate between :P142_FROMDATE and :P142_TODATE
                  and instr(':'||:P142_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P142_COMPANY||':',':'||a.CompanyCode||':') > 0
                /*  and ( :P142_ITEM IS NULL OR instr(':'||:P142_ITEM||':',':'||aa.ItemCode||':') > 0 ) 
                  and ( :P142_SPECIFICATION IS NULL OR instr(':'||:P142_SPECIFICATION||':',':'||aa.ItemSpecificationCode||':') > 0 ) 
                */  and ( :P142_PARTYNAME IS NULL OR instr(':'||:P142_PARTYNAME||':',':'||d.PartyCode||':') > 0 ) 
                  and ( :P142_DOCTYPE IS NULL OR instr(':'||:P142_DOCTYPE||':',':'||b.DocTypeCode||':') > 0 )
                  and B.SalesOrderno like nvl(:P142_SONO,'%')
                  and DeliveryAppointmentno like nvl(:P142_DANO,'%')
                
                 Order By a.DeliveryAppointmentdate, a.DeliveryAppointmentno
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
