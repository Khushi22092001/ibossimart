        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select LoadingSlipNo 
                From LoadingSlip
                Where instr(':'||:P142_LOCATION||':',':'||LocationCode||':') > 0
                  and LoadingSlipDate Between :P142_FROMDATE and :P142_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P142_LOCATION
            itemsToSubmit: P142_SONO
        }
        layout {
