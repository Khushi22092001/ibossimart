page 393 (
    name: Challan Register
    alias: CHALLAN-REGISTER
    title: Challan Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/ChallanRegister.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P393_FROMDATE').val());
              var toDate = new Date($('#P393_TODATE').val());
            
            var reportParams = 
                  '&P393_COMPANY='+ $('#P393_COMPANY').val() +  
                  '&P393_FROMDATE=' +$('#P393_FROMDATE').val() + 
                  '&P393_TODATE=' +$('#P393_TODATE').val() + 
                  '&P393_LOCATION=' + $('#P393_LOCATION').val() +
                  '&P393_PARTY=' +$('#P393_PARTY').val() +
                  '&P393_CCINVOICE=' +$('#P393_CCINVOICE').val() +
                  '&P393_SALES=' +$('#P393_SALES').val() +
                  '&P393_STATUS=' +$('#P393_STATUS').val()  
                  
                  ;
             
                  
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              var reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            ```
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region challan-register (
        name: Challan Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    Rownum as Sno,
                    co.CompanyName,
                    lo.LocationName,
                    a.CCInvoiceNo,
                    a.CCInvoiceDate,
                    a.VehicleNo,
                    a.LorryNo,
                    a.LorryDate,
                    pa.PartyName,
                    tr.TransporterName,
                    e.ItemName,
                    f.ItemSpecificationName,
                    b.Quantity1 as Qty,
                    b.Rate,
                    b.Amount,
                	g.CGST,
                	h.SGST,
                	i.IGST,
                	j.TCS,
                	k.CESS,
                	a.CCInvoiceAmount,
                	m.Quantity1 as ReachedQty,
                	m.DeliveryDate as ReachedDate,
                    Case When c.ccinvoiceTno is not null then 'BILLED'
                    When c.ccinvoiceTno is null then 'UNBILLED'
                    Else NULL
                    End as BilledStatus,
                    d.InvoiceNo,
                    d.InvoiceDate,
                    so.SalesOrderNo
                  From CCInvoice a, CCInvoiceDetail b,InvoiceCCInvoice  c, Invoice d, Item e, ItemSpecification f,
                  Location lo, Company co, Party pa, Transporter tr, SalesOrder so,
                  (Select
                		b.Tno,
                		a.FooterHeadCode,
                		SUM(a.FooterPercent) as FooterPercent,
                		SUM(a.FooterValue) as CGST,
                		c.FooterHeadName
                	From CCInvoiceDetailFooter a,CCInvoice b, FooterHead c
                	where a.TNo = b.TNo
                		and a.FooterHeadCode = c.FooterHeadCode
                		and a.FooterHeadCode in
                	(
                	'.CGST.'
                	)
                	Group by a.FooterHeadCode,
                	b.Tno,
                	c.FooterHeadName
                	)g,
                  (Select
                		b.Tno,
                		a.FooterHeadCode,
                		SUM(a.FooterPercent) as FooterPercent,
                		SUM(a.FooterValue) as SGST,
                		c.FooterHeadName
                	From CCInvoiceDetailFooter a,CCInvoice b, FooterHead c
                	where a.TNo = b.TNo
                		and a.FooterHeadCode = c.FooterHeadCode
                		and a.FooterHeadCode in
                	(
                	'.SGST.'
                	)
                	Group by a.FooterHeadCode,
                	b.Tno,
                	c.FooterHeadName)h,
                  (Select
                		b.Tno,
                		a.FooterHeadCode,
                		SUM(a.FooterPercent) as FooterPercent,
                		SUM(a.FooterValue) as IGST,
                		c.FooterHeadName
                	From CCInvoiceDetailFooter a,CCInvoice b, FooterHead c
                	where a.TNo = b.TNo
                		and a.FooterHeadCode = c.FooterHeadCode
                		and a.FooterHeadCode in
                	(
                	'.IGST.'
                	)
                	Group by a.FooterHeadCode,
                	b.Tno,
                	c.FooterHeadName)i,
                  (Select
                		b.Tno,
                		a.FooterHeadCode,
                		SUM(a.FooterPercent) as FooterPercent,
                		SUM(a.FooterValue) as TCS,
                		c.FooterHeadName
                	From CCInvoiceDetailFooter a,CCInvoice b, FooterHead c
                	where a.TNo = b.TNo
                		and a.FooterHeadCode = c.FooterHeadCode
                		and a.FooterHeadCode in
                	(
                	'.TCS.'
                	)
                	Group by a.FooterHeadCode,
                	b.Tno,
                	c.FooterHeadName)j,
                  (Select
                		b.Tno,
                		a.FooterHeadCode,
                		SUM(a.FooterPercent) as FooterPercent,
                		SUM(a.FooterValue) as CESS,
                		c.FooterHeadName
                	From CCInvoiceDetailFooter a,CCInvoice b, FooterHead c
                	where a.TNo = b.TNo
                		and a.FooterHeadCode = c.FooterHeadCode
                		and a.FooterHeadCode in
                	(
                	'.CESS.'
                	)
                	Group by a.FooterHeadCode,
                	b.Tno,
                	c.FooterHeadName)k,
                	LR l, PODDetail m
                  Where a.Tno = b.Tno(+) 
                    and a.DoctypeCode = 'CHALAN'
                    and a.Tno = c.CCInvoiceTno(+)
                    and c.Tno = d.Tno(+)
                    and b.ItemCode = e.ItemCode(+)
                    and b.ItemSpecificationCode = f.ItemSpecificationCode(+)
                    and a.LocationCode = lo.LocationCode
                    and a.CompanyCode = co.CompanyCode
                    and a.PartyCode = pa.PartyCode(+)
                    and a.TransporterCode = tr.TransporterCode(+)
                    and a.SalesOrderTno = so.Tno(+)
                	and a.Tno = g.Tno(+)
                	and a.Tno = h.Tno(+)
                	and a.Tno = i.Tno(+)
                	and a.Tno = j.Tno(+)
                	and a.Tno = k.Tno(+)
                	and a.Tno = l.ModuleTno(+)
                	and l.Tno = m.LRTno(+)
                    and (:P393_COMPANY is Null Or Instr (':' || :P393_COMPANY || ':' , ':' || a.CompanyCode || ':') > 0)
                    and a.CCInvoiceDate between :P393_FROMDATE and :P393_TODATE
                    and (:P393_LOCATION is Null Or Instr (':' || :P393_LOCATION || ':' , ':' || a.LocationCode || ':') > 0)
                    and (:P393_PARTY is Null Or Instr (':' || :P393_PARTY || ':' , ':' || a.PartyCode || ':') > 0)
                   and (:P393_CCINVOICE is Null Or Instr (':' || :P393_CCINVOICE || ':' , ':' || a.Tno || ':') > 0)
                   and (:P393_SALES is Null Or Instr (':' || :P393_SALES || ':' , ':' || a.SalesOrderTno || ':') > 0)
                    and ( 
                      ( NVL(c.ccinvoiceTNO,0)   > 0 AND :P393_STATUS = 'BILLED' )
                      OR 
                      (  NVL(c.ccinvoiceTNO,0) <= 0 AND :P393_STATUS = 'UNBILLED' )
                      OR 
                      :P393_STATUS IS NULL
                  )
                    -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and :P393_FROMDATE is not null;
                    
                    
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
