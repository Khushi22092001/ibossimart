    pageItem P393_CCINVOICE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: CCInvoice No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.CCInvoiceNo d,
                a.Tno r
                From ccinvoice a
                where a.doctypeCode = 'CHALAN'
                Order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @challan-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

