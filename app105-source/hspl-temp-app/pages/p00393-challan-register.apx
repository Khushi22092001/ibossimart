                a.PartyCode r
                From ccinvoice aa,Party a
                where aa.Partycode = a.Partycode
                Order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @challan-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P393_SALES (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Sales Order No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                b.SalesOrderNo d,
                b.Tno r
                From CCInvoice a, SalesOrder b
                Where a.doctypecode = 'CHALAN'
                AND A.SalesOrderTno = b.Tno
                Order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @challan-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P393_STATUS (
        type: selectList
        label {
            label: Status
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:BILLED;BILLED,UNBILLED;UNBILLED
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 90
            region: @challan-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    pageItem P393_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @challan-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 110
            region: @challan-register
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

