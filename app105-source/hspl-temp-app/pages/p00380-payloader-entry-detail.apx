page 380 (
    name: Payloader Entry Detail
    alias: PAYLOADER-ENTRY-DETAIL
    title: Payloader Entry Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-entry-detail (
        name: PayLoader Entry Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  row_number() over(order by a.RakeLoadingDate) SerialNo,
                  a.CompanyCode,
                  a.RakeLoadingNo,
                  a.RakeLoadingDate,
                  b.EquipmentTno,
                  c.EquipmentID,
                  d.LocationName,
                  b.NoOfWagon as NoOfWagon,
                  b.NoOfTipper as NoOfTipper,
                  b.TotalHMR as TotalHMR,
                  b.Quantity1 as Quantity1,
                  b.Rate,
                  round(b.Amount, 2) as Amount
                From RakeLoading a, RakeLoadingDetail b, Equipment c, Location d
                Where a.Tno = b.Tno
                  and b.EquipmentTno = c.Tno
                  and a.LocationCode = d.LocationCode
                  and c.EquipmentGroupCode = 'PL'
                  and (:P380_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                  and a.RakeLoadingDate between :P380_FROMDATE and :P380_TODATE
                  and (:P380_COMPANYCODE is Null Or Instr (':' || :P380_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                  and (:P380_EQUIPMENTID is Null Or Instr (':' || :P380_EQUIPMENTID || ':' , ':' || b.EquipmentTno || ':') > 0)
                 
                ```
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 221588147104587370
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: PayLoader Amount
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
