        savedReport 135674 (
            visibility: primary
            view {
                default: grid
                settingsAreaExpanded: false
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @DAYSHIFTQTY
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @NIGHTSHIFTQTY
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @DAYQTY
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @MONTHQTY
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @YEARQTY
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @PROGRESSIVEQTY
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @SERIALNO
                layout {
                    sequence: 1
                }
            )

            sort (
                column: @SERIALNO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            aggregate count (
                column: @SERIALNO
                function: count
                showGrandTotal: true
            )

            aggregate sum (
                column: @NIGHTSHIFTQTY
                showGrandTotal: true
            )

            aggregate sum-2 (
                column: @DAYQTY
                showGrandTotal: true
            )

            aggregate sum-3 (
                column: @MONTHQTY
                showGrandTotal: true
            )

            aggregate sum-4 (
                column: @YEARQTY
                showGrandTotal: true
            )

            aggregate sum-5 (
                column: @PROGRESSIVEQTY
                showGrandTotal: true
            )

            aggregate sum-6 (
                column: @DAYSHIFTQTY
            )

        )

        columnGroup day (
