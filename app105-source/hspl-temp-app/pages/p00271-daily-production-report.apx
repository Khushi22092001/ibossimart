    region trip-and-quantity-summary (
        name: Trip and Quantity Summary
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    row_number() over(order by a.jobtypename) SerialNo,
                    a.JobTypeName as "Job Type",
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,'A',:P271_ASONDATE,:P271_ASONDATE) as "No of Trip Shift A",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,'A',:P271_ASONDATE,:P271_ASONDATE) as "Shift A Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,'B',:P271_ASONDATE,:P271_ASONDATE) as "No of Trip Shift B",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,'B',:P271_ASONDATE,:P271_ASONDATE) as "Shift B Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,'C',:P271_ASONDATE,:P271_ASONDATE) as "No of Trip Shift C",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,'C',:P271_ASONDATE,:P271_ASONDATE) as "Shift C Quantity",
                
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,'DS',:P271_ASONDATE,:P271_ASONDATE) as "No of Trip Shift D",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,'DS',:P271_ASONDATE,:P271_ASONDATE) as "Shift DS Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_ASONDATE,:P271_ASONDATE) as "No of Trip Day",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_ASONDATE,:P271_ASONDATE) as "Day Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_MONTHFROMDATE,:P271_ASONDATE) as "No of Trip Month",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,Null,:P271_MONTHFROMDATE,:P271_ASONDATE) as "Month Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_YEARFROMDATE,:P271_ASONDATE) as "No of Trip Year",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,Null,:P271_YEARFROMDATE,:P271_ASONDATE) as "Year Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_PROJECTFROMDATE,:P271_ASONDATE) as "No of Trip Progressive",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,Null,:P271_PROJECTFROMDATE,:P271_ASONDATE) as "Progressive Quantity"
                    
                    From
                (
                Select Distinct BB.jobtypecode, CC.JOBTYPENAME 
                From vehiclelogbook aa, Vehiclelogbookdetail bb, Jobtype cc
                Where aa.tno = bb.tno
                  And bb.jobtypecode = cc.Jobtypecode
                	And aa.vehiclelogbookdate <= :P271_ASONDATE
                  and instr(':'||:P271_LOCATION||':',':'||aa.LocationCode||':') > 0
                ) a
                Group by a.JobTypeName,a.JobTypeCode
                
                /*
                Select 
                    a.JobTypeName as "Job Type",
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,'A',:P271_ASONDATE,:P271_ASONDATE) as "No of Trip Shift A",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,'A',:P271_ASONDATE,:P271_ASONDATE) as "Shift A Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,'B',:P271_ASONDATE,:P271_ASONDATE) as "No of Trip Shift B",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,'B',:P271_ASONDATE,:P271_ASONDATE) as "Shift B Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,'DS',:P271_ASONDATE,:P271_ASONDATE) as "No of Trip Shift D",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,'DS',:P271_ASONDATE,:P271_ASONDATE) as "Shift DS Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_ASONDATE,:P271_ASONDATE) as "No of Trip Day",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_ASONDATE,:P271_ASONDATE) as "Day Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_MONTHFROMDATE,:P271_ASONDATE) as "No of Trip Month",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,Null,:P271_MONTHFROMDATE,:P271_ASONDATE) as "Month Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_YEARFROMDATE,:P271_ASONDATE) as "No of Trip Year",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,Null,:P271_YEARFROMDATE,:P271_ASONDATE) as "Year Quantity",
                
                    GetEquipmentTrips(:P271_LOCATION,null,a.JobtypeCode,NULL,:P271_PROJECTFROMDATE,:P271_ASONDATE) as "No of Trip Progressive",
                    GetEquipmentQuantity(:P271_LOCATION,null,a.JobtypeCode,Null,:P271_PROJECTFROMDATE,:P271_ASONDATE) as "Progressive Quantity"
                    
                    From
                (Select 
                    Sum(f.NoOfTrips) ,
                    g.JobtypeCode,
                    g.JobTypeName,
                    ab.ShiftCode,
                    ab.ShiftName
                from EquipmentLogBook a,(Select Tno,JobtypeCode From EquipmentLogBookDetail 
                Group by Tno,JobtypeCode) aa,shift ab ,Equipment b,ShiftChangeDetail c,
                    ShiftChange d, JobType g,
                    (Select b.sno as NoOfTrips, b.EquipmentTno , a.VehiclelogBookDate, a.ShiftCode
                    from    VehicleLogBook a, (Select  b.Tno,Count(b.Sno) as Sno, b.EquipmentTno From VehicleLogBookDetail b 
                    Group by   b.Tno, b.EquipmentTno) b
                    Where   a.Tno = b.tno(+) ) f
                Where a.EquipmentTno = b.Tno
                    and a.Tno = aa.Tno(+)
                    and a.ShiftCode = ab.ShiftCode(+)
                    and b.Tno = c.EquipmentTno(+)
                    and ab.Tno = d.ShiftTno
                    and c.tno = d.tno(+)
                    and a.ShiftCode = f.ShiftCode(+)
                    and a.EquipmentTno = f.EquipmentTno(+)
                    and a.EquipmentLogBookDate = f.VehiclelogBookDate(+)
                    and aa.JobTypeCode = g.JobTypeCode(+)
                    and a.EquipmentLogbookDate = d.ShiftChangeDate
                    and g.JobTypecode is not null
                    Group by g.JobtypeCode,
                    g.JobTypeName,
                    ab.ShiftCode,
                    ab.ShiftName) a
                    Group by a.JobTypeName,a.JobTypeCode
                    */
                ```
            pageItemsToSubmit: [
                P271_LOCATION
                P271_ASONDATE
                P271_MONTHFROMDATE
                P271_YEARFROMDATE
                P271_PROJECTFROMDATE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
