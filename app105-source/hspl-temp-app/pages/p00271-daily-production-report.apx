    pageItem P271_ASONDATE (
        type: datePicker
        label {
            label: As On Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @daily-production-report
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select As on Date
        }
    )

    pageItem P271_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
            autocompleteRowsToFetch: 200
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct a.LocationName D,
                a.LocationCode R
                From Location a , VehicleLogBook b
                where a.LocationCode= b.LocationCode;
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 20
            region: @daily-production-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Location Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P271_MONTHFROMDATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @daily-production-report
            slot: regionBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    pageItem P271_PROJECTFROMDATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @daily-production-report
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT MIN(VEHICLELOGBOOKDATE) FROM VEHICLELOGBOOK
        }
        sessionState {
            storage: request
        }
    )

    pageItem P271_YEARFROMDATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @daily-production-report
            slot: regionBody
        }
        source {
            used: always
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select A.FINANCIALYEARBEGIN
                  From FINANCIALYEAR A
                 Where Trunc(Sysdate) Between A.FINANCIALYEARBEGIN And A.FINANCIALYEAREND
                
                ```
        }
        sessionState {
            storage: request
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 50
            region: @trip-and-quantity-summary
            slot: top
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--iconRight
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 30
            region: @daily-production-report
            slot: regionBody
            startNewRow: false
            column: 10
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P271_ASONDATE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @trip-and-quantity-summary
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @diesel-summary
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                       SELECT TO_DATE('01-'||TO_CHAR(TO_DATE(:P271_ASONDATE,'DD-MM-RRRR'),'MM-RRRR')) FROM DUAL ;
                    
                    ```
                itemsToSubmit: P271_ASONDATE
            }
            affectedElements {
                selectionType: items
                items: P271_MONTHFROMDATE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                       Select A.FINANCIALYEARBEGIN From FINANCIALYEAR A
                    WHERE :P271_ASONDATE BETWEEN A.FINANCIALYEARBEGIN AND  A.FINANCIALYEAREND ;
                    ```
                itemsToSubmit: P271_ASONDATE
            }
            affectedElements {
                selectionType: items
                items: P271_YEARFROMDATE
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value-3 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select NVL(Min(B.PROJECTDATE) ,(SELECT MIN(VEHICLELOGBOOKDATE) FROM VEHICLELOGBOOK))
                      From Location A, Project B
                     Where A.LOCATIONCODE = B.LOCATIONCODE(+)
                       and instr(':'||:P271_LOCATION||':',':'||a.LocationCode||':') > 0
                    AND ROWNUM = 1
                     Group By A.LOCATIONCODE ;
                    ```
                itemsToSubmit: P271_LOCATION
            }
            affectedElements {
                selectionType: items
                items: P271_PROJECTFROMDATE
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
