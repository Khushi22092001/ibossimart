    region diesel-summary (
        name: Diesel Summary
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select ROWNUM AS SERIALNO,(Select Sum(c.quantity1)
                          From NecessitySlip b, NecessitySlipDetail c
                         Where b.tno = c.tno
                           And b.Locationcode = a.locationcode
                           And b.NecessitySlipDate = :P271_ASONDATE
                           And b.shiftcode = 'DS') As DayShiftQty,
                       (Select Sum(c.quantity1)
                          From NecessitySlip b, NecessitySlipDetail c
                         Where b.tno = c.tno
                           And b.Locationcode = a.locationcode
                           And b.NecessitySlipDate = :P271_ASONDATE
                           And b.shiftcode = 'NS') As NightShiftQty,
                       (Select Sum(c.quantity1)
                          From NecessitySlip b, NecessitySlipDetail c
                         Where b.tno = c.tno
                           And b.Locationcode = a.locationcode
                           And b.NecessitySlipDate = :P271_ASONDATE) As DayQty,
                       (Select Sum(c.quantity1)
                          From NecessitySlip b, NecessitySlipDetail c
                         Where b.tno = c.tno
                           And b.Locationcode = a.locationcode
                           And b.NecessitySlipDate Between :P271_MONTHFROMDATE And
                               :P271_ASONDATE) As MonthQty,
                       (Select Sum(c.quantity1)
                          From NecessitySlip b, NecessitySlipDetail c
                         Where b.tno = c.tno
                           And b.Locationcode = a.locationcode
                           And b.NecessitySlipDate Between :P271_YEARFROMDATE And
                               :P271_ASONDATE) As YearQty,
                       (Select Sum(c.quantity1)
                          From NecessitySlip b, NecessitySlipDetail c
                         Where b.tno = c.tno
                           And b.Locationcode = a.locationcode
                           And b.NecessitySlipDate Between :P271_PROJECTFROMDATE And
                               :P271_ASONDATE) As ProgressiveQty
                  From LOCATION A
                 Where A.LOCATIONCODE = :P271_LOCATION
                
                
                /*
                Select 
                az.EquipmentGroupName as "Equipment Group Name",
                 
                Sum(Nvl(a.DieselQuantityA,0)) as "Diesel QtyA",
                
                Sum(Nvl(a.DieselQuantityB,0)) as "Diesel QtyB",
                
                Sum(Nvl(a.DieselQuantityDS,0)) as "Diesel QtyDS",
                
                Sum(Nvl(a.DieselQuantity,0)) as "Day Diesel Qty",
                
                Sum(Nvl(dx.DieselQuantityMonth,0)) as "Month Diesel Qty",
                
                Sum(Nvl(cx.DieselQuantityYear,0)) as "Year Diesel Qty",
                
                Sum(Nvl(ax.DieselQuantityProgressive,0)) as "Progressive Diesel Qty"
                
                From
                
                          (Select  
                             a.VehiclelogBookDate,
                             a.ShiftCode,
                             b.EquipmentTno,
                             Sum(j.Quantity) as DieselQuantityProgressive
                         from  VehicleLogBook a, (Select  b.Tno,Count(b.Sno) as Sno, b.EquipmentTno From VehicleLogBookDetail b
                         Group by   b.Tno, b.EquipmentTno) b, NecessitySlip i,
                         (Select Sum(c.Quantity1)as Quantity , c.Tno  From NecessitySlipDetail c Group by c.Tno) j
                         Where   a.Tno = b.tno(+)
                         and a.VehiclelogbookDate = i.NecessitySlipDate(+)
                         and a.Vehicleno = i.Vehicleno(+)
                         --and a.ShiftCode = i.ShiftCode(+)
                         and i.Tno = j.Tno(+)
                         and b.sno is not null
                         and (:P271_LOCATION IS NULL OR instr(':'||:P271_LOCATION||':',':'||a.LocationCode||':') > 0)
                         and a.VehiclelogBookDate Between :P271_PROJECTFROMDATE and :P271_ASONDATE
                         Group by 
                         a.VehiclelogBookDate,
                         a.ShiftCode,
                         b.EquipmentTno) ax, Equipment ay,  EquipmentGroup az,
                         
                         
                         
                         (Select  
                             a.VehiclelogBookDate,
                             a.ShiftCode,
                             b.EquipmentTno,
                             Sum(j.Quantity) as DieselQuantityYear
                         from  VehicleLogBook a, (Select  b.Tno,Count(b.Sno) as Sno, b.EquipmentTno From VehicleLogBookDetail b
                         Group by   b.Tno, b.EquipmentTno) b, NecessitySlip i,
                         (Select Sum(c.Quantity1)as Quantity , c.Tno  From NecessitySlipDetail c Group by c.Tno) j
                         Where   a.Tno = b.tno(+)
                         and a.VehiclelogbookDate = i.NecessitySlipDate(+)
                         and a.Vehicleno = i.Vehicleno(+)
                        -- and a.ShiftCode = i.ShiftCode(+)
                         and i.Tno = j.Tno(+)
                         and b.sno is not null
                         and (:P271_LOCATION IS NULL OR instr(':'||:P271_LOCATION||':',':'||a.LocationCode||':') > 0)
                         and a.VehiclelogBookDate Between :P271_YEARFROMDATE and :P271_ASONDATE
                         Group by 
                         a.VehiclelogBookDate,
                         a.ShiftCode,
                         b.EquipmentTno) cx, Equipment cy,
                         
                         
                         
                         
                                  (Select  
                             a.VehiclelogBookDate,
                             a.ShiftCode,
                             b.EquipmentTno,
                             Sum(j.Quantity) as DieselQuantityMonth
                         from  VehicleLogBook a, (Select  b.Tno,Count(b.Sno) as Sno, b.EquipmentTno From VehicleLogBookDetail b
                         Group by   b.Tno, b.EquipmentTno) b, NecessitySlip i,
                         (Select Sum(c.Quantity1)as Quantity , c.Tno  From NecessitySlipDetail c Group by c.Tno) j
                         Where   a.Tno = b.tno(+)
                         and a.VehiclelogbookDate = i.NecessitySlipDate(+)
                         and a.Vehicleno = i.Vehicleno(+)
                         --and a.ShiftCode = i.ShiftCode(+)
                         and i.Tno = j.Tno(+)
                         and b.sno is not null
                         and (:P271_LOCATION IS NULL OR instr(':'||:P271_LOCATION||':',':'||a.LocationCode||':') > 0)
                         and a.VehiclelogBookDate Between :P271_MONTHFROMDATE and :P271_ASONDATE
                         Group by 
                         a.VehiclelogBookDate,
                         a.ShiftCode,
                         b.EquipmentTno) dx, Equipment dy,
                
                
                
                
                    (Select  
                
                        Case When a.ShiftCode = 'A' Then
                        Sum(j.Quantity) end as DieselQuantityA,
                        
                        Case When a.ShiftCode = 'B' Then
                        Sum(j.Quantity) end as DieselQuantityB,
                        
                        Case When a.ShiftCode = 'DS' Then
                        Sum(j.Quantity) end as DieselQuantityDS,
                
                        a.VehiclelogBookDate,
                        a.ShiftCode,
                        b.EquipmentTno,
                        Sum(j.Quantity) as DieselQuantity
                    from  VehicleLogBook a, (Select  b.Tno,Count(b.Sno) as Sno, b.EquipmentTno From VehicleLogBookDetail b
                    Group by   b.Tno, b.EquipmentTno) b, NecessitySlip i,
                    (Select Sum(c.Quantity1)as Quantity , c.Tno  From NecessitySlipDetail c Group by c.Tno) j
                    Where   a.Tno = b.tno(+)
                    and a.VehiclelogbookDate = i.NecessitySlipDate(+)
                    and a.equipmenttno = i.equipmenttno(+)
                    and a.Vehicleno = i.Vehicleno(+)
                    --and a.ShiftCode = i.ShiftCode(+)
                    and i.Tno = j.Tno(+)
                    and b.sno is not null
                    and (:P271_LOCATION IS NULL OR instr(':'||:P271_LOCATION||':',':'||a.LocationCode||':') > 0)
                    and a.VehiclelogBookDate = :P271_ASONDATE
                    Group by 
                    a.VehiclelogBookDate,
                    a.ShiftCode,
                    b.EquipmentTno) a,
                     Equipment b, Shift c 
                
                
                Where ax.EquipmentTno = ay.Tno(+)
                    and  Ax.EquipmentTno = cx.EquipmentTno (+)
                    and Ax.ShiftCode = cx.ShiftCode (+)
                    and Ax.VehicleLogBookDate = cx.VehicleLogBookDate(+)
                    
                    
                    and cx.EquipmentTno = cy.Tno
                    and  cx.EquipmentTno = dx.EquipmentTno (+)
                    and cx.ShiftCode = dx.ShiftCode (+)
                    and cx.VehicleLogBookDate = dx.VehicleLogBookDate(+)
                    
                    
                    and dx.EquipmentTno = dy.Tno
                    and  dx.EquipmentTno = a.EquipmentTno (+)
                    and dx.ShiftCode = a.ShiftCode (+)
                    and dx.VehicleLogBookDate = a.VehicleLogBookDate(+)
                    
                    
                    
                    and a.EquipmentTno = b.Tno(+)
                    and a.ShiftCode = c.ShiftCode(+)
                    and ay.EquipmentGroupCode = az.EquipmentGroupCode(+)
                    and az.EquipmentGroupCode = b.EquipmentGroupCode (+)
                    Group by 
                    az.EquipmentGroupName
                */
                ```
            pageItemsToSubmit: [
                P271_LOCATION
                P271_ASONDATE
                P271_MONTHFROMDATE
                P271_YEARFROMDATE
                P271_PROJECTFROMDATE
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
