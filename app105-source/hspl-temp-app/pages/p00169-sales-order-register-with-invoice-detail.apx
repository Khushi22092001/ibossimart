    region sales-order-register-with-invoice-detail (
        name: Sales Order Register With Invoice Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  
                       row_number() over(order by a.SalesOrderDate) SerialNo,
                       a.tno,
                       b.itemcode,
                       b.itemspecificationcode,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO Order By A.SALESORDERNO) = 1 Then
                          A.SALESORDERNO
                         Else
                          Null
                       End SALESORDERNO,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO Order By A.SALESORDERNO) = 1 Then
                          A.SALESORDERDATE
                         Else
                          Null
                       End SALESORDERDATE,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO Order By A.SALESORDERNO) = 1 Then
                          GETPARTYNAME(A.PARTYCODE)
                         Else
                          Null
                       End PARTY,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO Order By A.SALESORDERNO) = 1 Then
                          GETPARTYNAME(A.CONSIGNEECODE)
                         Else
                          Null
                       End CONSIGNEE,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO Order By A.SALESORDERNO) = 1 Then
                          CT.CITYNAME
                         Else
                          Null
                       End CITYNAME,
                       Case
                         When ROW_NUMBER() Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE) = 1 Then
                          GETITEMNAME(B.ITEMCODE)
                         Else
                          Null
                       End ITEMNAME,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          GETITEMSPECIFICATIONNAME(B.ITEMCODE, E.ITEMSPECIFICATIONCODE)
                         Else
                          Null
                       End ITEMSPECIFICATIONNAME,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          I.MEASURINGUNITCODE1
                         Else
                          Null
                       End PUNIT,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          I.MEASURINGUNITCODE2
                         Else
                          Null
                       End SUNIT,
                       
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          B.QUANTITY1
                         Else
                          Null
                       End QUANTITY1,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          B.QUANTITY2
                         Else
                          Null
                       End QUANTITY2,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          B.RATE
                         Else
                          Null
                       End RATE,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          Round(B.AMOUNT, 2)
                         Else
                          Null
                       End BASIC,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          Round(B.FOOTERAMOUNT, 2)
                         Else
                          Null
                       End TAXAMOUNT,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          Round(B.TOTALAMOUNT, 2)
                         Else
                          Null
                       End INCLUSIVETAX,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          Round(getsoitempendingquantity1(B.ITEMCODE,
                                                          E.ITEMSPECIFICATIONCODE,
                                                          a.tno),
                                3)
                         Else
                          Null
                       End BALANCEQUANTITY1,
                       Case
                         When ROW_NUMBER()
                          Over(Partition By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE Order By A.SALESORDERNO,
                                   B.ITEMCODE,
                                   E.ITEMSPECIFICATIONCODE) = 1 Then
                          Round(getsoitempendingquantity2(B.ITEMCODE,
                                                          E.ITEMSPECIFICATIONCODE,
                                                          a.tno),
                                3)
                         Else
                          Null
                       End BALANCEQUANTITY2,
                       F.VEHICLENO,
                       GETPARTYNAME(F.TRANSPORTERCODE) As TransporterName,
                       G.drivername,
                       G.DRIVERMOBILENO,
                       D.CCINVOICENO,
                       D.CCINVOICEDATE,
                       E.QUANTITY1     As InvoicedQuantity1,
                       E.QUANTITY2     As InvoicedQuantity2
                  From SALESORDER          A,
                       SALESORDERDETAIL    B,
                       SALESORDERDETAILSKU C,
                       CCINVOICE           D,
                       CCINVOICEDETAIL     E,
                       PARTY               P,
                       ITEM                I,
                       CITY                CT,
                       despatchadvice      F, 
                       materialout G
                 Where A.TNO = B.TNO
                   And B.TNO = C.TNO(+)
                   And B.SNO = C.SNO(+)
                   And A.TNO = D.SALESORDERTNO(+)
                   And D.TNO = E.TNO
                   And B.ITEMCODE = E.ITEMCODE
                   AND D.DESPATCHADVICETNO = F.TNO
                   And F.TNO = G.REFERENCETNO
                   And (B.ITEMSPECIFICATIONCODE = E.ITEMSPECIFICATIONCODE Or
                       C.ITEMSPECIFICATIONCODE = E.ITEMSPECIFICATIONCODE)
                   And B.ITEMCODE = I.ITEMCODE
                   And Nvl(A.PARTYCODE, A.CONSIGNEECODE) = P.PARTYCODE
                   And Nvl(P.WORKSCITYCODE, P.OFFICECITYCODE) = CT.CITYCODE
                   and a.SalesorderDate Between :P169_FROMDATE AND :P169_TODATE
                    and instr(':'||:P169_COMPANY||':',':'||a.CompanyCode||':') > 0
                    and instr(':'||:P169_LOCATION||':',':'||a.LocationCode||':') > 0
                    and instr(':'||:P169_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                    and ( :P169_PARTY IS NULL OR instr(':'||:P169_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                    and ( :P169_CONSIGNEE IS NULL OR instr(':'||:P169_CONSIGNEE||':',':'||a.ConsigneeCode||':') > 0 ) 
                
                    and ( :P169_TRANSPORTER IS NULL OR instr(':'||:P169_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 ) 
                    and ( :P169_ITEM IS NULL OR instr(':'||:P169_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                    and ( :P169_ITEMSPECIFICATION IS NULL OR instr(':'||:P169_ITEMSPECIFICATION||':',':'||e.ItemSpecificationCode||':') > 0 ) 
                    and a.SalesOrderNo like nvl(:P169_SONO,'%')
                      -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 160546162863784076
        }

