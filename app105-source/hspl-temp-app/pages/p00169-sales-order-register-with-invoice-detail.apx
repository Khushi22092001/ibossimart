            sequence: 50
            region: @sales-order-register-with-invoice-detail-2
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter DocType Name
        }
        validation {
            valueRequired: true
        }
    )

