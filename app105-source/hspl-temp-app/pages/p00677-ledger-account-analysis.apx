    pageItem P677_FROMDATE (
        type: hidden
        layout {
            sequence: 20
            region: @command-header
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR') From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
    )

