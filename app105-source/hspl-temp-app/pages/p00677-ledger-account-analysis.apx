    )

    region ledger (
        name: Statement of Account
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Fy As (
                       /* Always exactly one row. A From Date outside every defined
                          financial year would otherwise empty this CTE and, with it,
                          every aggregate downstream. Falling back to the From Date
                          itself makes the opening nil and leaves movement intact; the
                          header chip already says the date is outside any known year. */
                       Select nvl((Select f.FinancialYearBegin From FinancialYear f
                                    Where to_date(:P677_FROMDATE,'DD-MM-RRRR') Between f.FinancialYearBegin And f.FinancialYearEnd),
                                  to_date(:P677_FROMDATE,'DD-MM-RRRR')) Fb From dual),
                     Carry As (Select v.Tno From Voucher v Where v.VoucherNo = 'OPENING'),
                     /* The single opening figure the running balance starts from. */
                     Opn As (
                       Select nvl((Select Sum(nvl(o.OpeningAmount,0)) From Opening o, Fy
                                    Where o.OpeningDate = Fy.Fb And o.AccountCode = :P677_ACCOUNT
                                      And ((Select GetUserPanelAB_apex() From dual) Is Null Or 'A' = (Select GetUserPanelAB_apex() From dual))
                                      And (:P677_PANEL Is Null Or 'A' = :P677_PANEL)
                                      And (:P677_COMPANY Is Null Or o.CompanyCode = :P677_COMPANY)
                                      And (:P677_LOCATION Is Null Or o.LocationCode = :P677_LOCATION)),0)
                            + nvl((Select Sum(nvl(d.Amount,0)) From VoucherDetail d, Fy
                                    Where d.AccountCode = :P677_ACCOUNT
                                      And d.VoucherDate >= Fy.Fb And d.VoucherDate < to_date(:P677_FROMDATE,'DD-MM-RRRR')
                                      And d.Tno Not In (Select Tno From Carry)
                                      And ((Select GetUserPanelAB_apex() From dual) Is Null Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                                      And (:P677_PANEL Is Null Or d.Panel = :P677_PANEL)
                                      And (:P677_COMPANY Is Null Or d.CompanyCode = :P677_COMPANY)
                                      And (:P677_LOCATION Is Null Or d.LocationCode = :P677_LOCATION)),0) Amt
                         From dual),
                     L As (
                       Select d.Tno, d.Sno, d.VoucherDate, nvl(d.Amount,0) Amt, d.Narration Narration,
                              d.BillNo, d.CompanyCode, d.LocationCode
                         From VoucherDetail d
                        Where d.AccountCode = :P677_ACCOUNT
                          And d.VoucherDate >= to_date(:P677_FROMDATE,'DD-MM-RRRR')
                          And d.VoucherDate <  to_date(:P677_TODATE,'DD-MM-RRRR') + 1
                          And d.Tno Not In (Select Tno From Carry)
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (:P677_PANEL Is Null Or d.Panel = :P677_PANEL)
                          And (:P677_COMPANY Is Null Or d.CompanyCode = :P677_COMPANY)
                          And (:P677_LOCATION Is Null Or d.LocationCode = :P677_LOCATION))
                Select l.VoucherDate                        As VOUCHER_DATE,
                       '<a href="' || apex_page.get_url(p_page => 678, p_clear_cache => '678',
                                p_items => 'P678_TNO', p_values => to_char(l.Tno))
                       || '">' || apex_escape.html(v.VoucherNo) || '</a>' As VOUCHER_NO,
                       v.DocTypeCode                        As VOUCHER_TYPE,
                       nvl(v.ModuleCode,'Direct entry')     As SOURCE_MODULE,
                       v.ModuleTno                          As SOURCE_DOCUMENT_ID,
                       apex_escape.html(nvl(c.CompanyName, l.CompanyCode))   As COMPANY,
                       apex_escape.html(nvl(lo.LocationName, l.LocationCode)) As LOCATION,
                       /* The contra side of the entry: the other accounts on the same
                          voucher, listed. This is what makes a statement readable -
                          "paid to whom", not just "paid". Capped so one 1,200-line
                          journal cannot produce an unreadable cell. */
                       apex_escape.html(
                         (Select listagg(x.Nm,', ') Within Group (Order By x.Nm)
                            From (Select Distinct substr(nvl(op.PartyName, od.AccountCode),1,40) Nm
                                    From VoucherDetail od Left Join Party op On op.PartyCode = od.AccountCode
                                   Where od.Tno = l.Tno And od.AccountCode <> :P677_ACCOUNT
                                     And rownum <= 6) x))               As CONTRA_ACCOUNTS,
                       l.BillNo                             As BILL_REFERENCE,
                       substr(nvl(l.Narration, v.Narration),1,160) As NARRATION,
                       Round(Case When l.Amt < 0 Then -l.Amt Else 0 End,2) As DEBIT,
                       Round(Case When l.Amt > 0 Then  l.Amt Else 0 End,2) As CREDIT,
                       /* Running balance in ledger convention: positive = debit. The
                          window is ordered date, then Tno, then Sno so the sequence is
                          deterministic even for several vouchers on the same day. */
                       Round(-(o.Amt + Sum(l.Amt) Over (Order By l.VoucherDate, l.Tno, l.Sno
                                                        Rows Between Unbounded Preceding And Current Row)),2) As RUNNING_BALANCE_DEBIT,
                       Case When -(o.Amt + Sum(l.Amt) Over (Order By l.VoucherDate, l.Tno, l.Sno
                                                            Rows Between Unbounded Preceding And Current Row)) >= 0
                            Then '<span class="ds-finchip ds-finchip--dr">Dr</span>'
                            Else '<span class="ds-finchip ds-finchip--cr">Cr</span>' End As RUNNING_SIDE,
                       v.Creator                            As CREATED_BY,
                       l.Tno                                As TNO
                  From L l
                  Cross Join Opn o
                  Join Voucher v On v.Tno = l.Tno
                  Left Join Company c   On c.CompanyCode   = l.CompanyCode
                  Left Join Location lo On lo.LocationCode = l.LocationCode
                 Order By l.VoucherDate, l.Tno, l.Sno
                ```
            pageItemsToSubmit: [
                P677_ACCOUNT
                P677_FROMDATE
                P677_TODATE
                P677_COMPANY
                P677_LOCATION
                P677_PANEL
            ]
        }
        layout {
            sequence: 32
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: Nothing was posted to this account in the selected period. Its opening balance, if any, is shown above.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        advanced {
            savedReportMappingIdentifier: 43537370638737429
        }

