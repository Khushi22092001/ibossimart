page 677 (
    name: Ledger Account Analysis
    alias: LEDGER-ACCOUNT-ANALYSIS
    title: Ledger Account Analysis
    pageGroup: @financial-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Third level of the drill-down: one ledger account, its position and every voucher line behind it. The running balance is the opening plus a cumulative sum of movement ordered by voucher date then Tno then Sno, so the last row's running balance is the closing balance shown in the header - and both tie back to the trial balance row that was clicked.
    }

    region command-header (
        name: Ledger Account Analysis
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-fin-head">'
                    || '<div class="ds-fin-eyebrow">Finance &middot; General Ledger &middot; Account</div>'
                    || '<h1 class="ds-fin-title">'
                       || apex_escape.html(nvl((Select p.PartyName From Party p Where p.PartyCode = :P677_ACCOUNT),
                                               nvl(:P677_ACCOUNT,'Ledger Account'))) || '</h1>'
                    || '<div class="ds-fin-sub">Statement of account: opening, every posting in the period, and the closing position</div>'
                    || '<div class="ds-fin-context">'
                    || '<span class="ds-fin-chip"><span class="fa fa-hashtag"></span>Code <b>' || apex_escape.html(:P677_ACCOUNT) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-sitemap"></span>Group <b>'
                       || apex_escape.html(nvl((Select g.PartyName From Party p Join Party g On g.PartyCode = p.ParentCode
                                                 Where p.PartyCode = :P677_ACCOUNT),'not attached to the chart of accounts')) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-compass"></span>Expected side <b>'
                       || nvl((Select Case p.BasicNature When 'DR' Then 'Debit' When 'CR' Then 'Credit' End
                                 From Party p Where p.PartyCode = :P677_ACCOUNT),'not declared') || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-calendar"></span>Period <b>' || :P677_FROMDATE || ' &rarr; ' || :P677_TODATE || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P677_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P677_LOCATION),'All locations')) || '</b></span>'
                    || '<span class="ds-fin-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                               Then (Select GetUserPanelAB_apex() From dual) || ' (enforced)'
                               When :P677_PANEL Is Not Null Then :P677_PANEL Else 'A + B' End || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
            pageItemsToSubmit: [
                P677_ACCOUNT
                P677_FROMDATE
                P677_TODATE
                P677_COMPANY
                P677_LOCATION
                P677_PANEL
            ]
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-fin-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region doctype-donut (
        name: Movement by Voucher Type
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Absolute movement, so the slices really do sum to the whole this
                   account moved. Debit and credit are never drawn against each other
                   as a pie - they are two sides of one entry, not parts of one total. */
                Select v.DocTypeCode As LABEL,
                       Round(Sum(Abs(nvl(d.Amount,0))),2) As MOVEMENT
                  From VoucherDetail d
                  Join Voucher v On v.Tno = d.Tno
                 Where d.AccountCode = :P677_ACCOUNT
                   And d.VoucherDate >= to_date(:P677_FROMDATE,'DD-MM-RRRR')
                   And d.VoucherDate <  to_date(:P677_TODATE,'DD-MM-RRRR') + 1
                   And v.VoucherNo <> 'OPENING'
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P677_PANEL Is Null Or d.Panel = :P677_PANEL)
                   And (:P677_COMPANY Is Null Or d.CompanyCode = :P677_COMPANY)
                   And (:P677_LOCATION Is Null Or d.LocationCode = :P677_LOCATION)
                 Group By v.DocTypeCode
                Having Sum(Abs(nvl(d.Amount,0))) > 0
                 Order By 2 Desc
                ```
            pageItemsToSubmit: [
                P677_ACCOUNT
                P677_FROMDATE
                P677_TODATE
                P677_COMPANY
                P677_LOCATION
                P677_PANEL
            ]
        }
        layout {
            sequence: 24
            slot: body
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 320
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No voucher touched this account in the selected period.
        }

        series doctype (
            name: Movement (₹)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: MOVEMENT
            }
        )

    )

    region kpi-strip (
        name: Account KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Fy As (
                       /* Always exactly one row. A From Date outside every defined
                          financial year would otherwise empty this CTE and, with it,
                          every aggregate downstream. Falling back to the From Date
                          itself makes the opening nil and leaves movement intact; the
                          header chip already says the date is outside any known year. */
                       Select nvl((Select f.FinancialYearBegin From FinancialYear f
                                    Where to_date(:P677_FROMDATE,'DD-MM-RRRR') Between f.FinancialYearBegin And f.FinancialYearEnd),
                                  to_date(:P677_FROMDATE,'DD-MM-RRRR')) Fb From dual),
                     Carry As (Select v.Tno From Voucher v Where v.VoucherNo = 'OPENING'),
                     Op As (Select nvl(Sum(nvl(o.OpeningAmount,0)),0) Amt From Opening o, Fy
                             Where o.OpeningDate = Fy.Fb And o.AccountCode = :P677_ACCOUNT
                               And ((Select GetUserPanelAB_apex() From dual) Is Null Or 'A' = (Select GetUserPanelAB_apex() From dual))
                               And (:P677_PANEL Is Null Or 'A' = :P677_PANEL)
                               And (:P677_COMPANY Is Null Or o.CompanyCode = :P677_COMPANY)
                               And (:P677_LOCATION Is Null Or o.LocationCode = :P677_LOCATION)),
                     Mv As (Select nvl(Sum(Case When d.VoucherDate < to_date(:P677_FROMDATE,'DD-MM-RRRR') Then nvl(d.Amount,0) Else 0 End),0) Pre,
                                   nvl(Sum(Case When d.VoucherDate >= to_date(:P677_FROMDATE,'DD-MM-RRRR') And nvl(d.Amount,0) < 0 Then -d.Amount Else 0 End),0) Dr,
                                   nvl(Sum(Case When d.VoucherDate >= to_date(:P677_FROMDATE,'DD-MM-RRRR') And nvl(d.Amount,0) > 0 Then  d.Amount Else 0 End),0) Cr,
                                   Count(Case When d.VoucherDate >= to_date(:P677_FROMDATE,'DD-MM-RRRR') Then 1 End) Lines,
                                   Count(Distinct Case When d.VoucherDate >= to_date(:P677_FROMDATE,'DD-MM-RRRR') Then d.Tno End) Vch,
                                   Max(d.VoucherDate) LastMove
                              From VoucherDetail d, Fy
                             Where d.AccountCode = :P677_ACCOUNT
                               And d.VoucherDate >= Fy.Fb And d.VoucherDate < to_date(:P677_TODATE,'DD-MM-RRRR') + 1
                               And d.Tno Not In (Select Tno From Carry)
                               And ((Select GetUserPanelAB_apex() From dual) Is Null Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                               And (:P677_PANEL Is Null Or d.Panel = :P677_PANEL)
                               And (:P677_COMPANY Is Null Or d.CompanyCode = :P677_COMPANY)
                               And (:P677_LOCATION Is Null Or d.LocationCode = :P677_LOCATION)),
                     Nat As (Select Max(p.BasicNature) Bn From Party p Where p.PartyCode = :P677_ACCOUNT)
                Select '<div class="ds-kpi ds-kpi--value" title="Opening balance carried into From Date: the Opening table at the year begin plus movement up to the day before.">'
                    || '<span class="ds-kpi-ic fa fa-flag-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Opening Balance</div><div class="ds-kpi-n">&#8377;'
                    || to_char(Abs(o.Amt + m.Pre),'FM99G99G99G990D00') || '</div>'
                    || '<div class="ds-kpi-sub">'
                       || Case When Abs(o.Amt + m.Pre) < 0.005 Then 'nil at ' || :P677_FROMDATE
                               When (o.Amt + m.Pre) < 0 Then 'debit at ' || :P677_FROMDATE
                               Else 'credit at ' || :P677_FROMDATE End
                    || '</div></div></div>' As KPI1,
                
                       '<div class="ds-kpi ds-kpi--dr" title="Total debit posted to this account between From Date and To Date.">'
                    || '<span class="ds-kpi-ic fa fa-arrow-circle-o-left"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Period Debit</div><div class="ds-kpi-n">&#8377;'
                    || to_char(m.Dr,'FM99G99G99G990D00') || '</div>'
                    || '<div class="ds-kpi-sub">' || to_char(m.Lines,'FM999G990') || ' line(s) across '
                       || to_char(m.Vch,'FM999G990') || ' voucher(s)</div></div></div>' As KPI2,
                
                       '<div class="ds-kpi ds-kpi--cr" title="Total credit posted to this account between From Date and To Date.">'
                    || '<span class="ds-kpi-ic fa fa-arrow-circle-o-right"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Period Credit</div><div class="ds-kpi-n">&#8377;'
                    || to_char(m.Cr,'FM99G99G99G990D00') || '</div>'
                    || '<div class="ds-kpi-sub">Net movement &#8377;'
                       || to_char(Abs(m.Dr - m.Cr),'FM99G99G990D00') || ' '
                       || Case When m.Dr >= m.Cr Then 'debit' Else 'credit' End || '</div></div></div>' As KPI3,
                
                       '<div class="ds-kpi ds-kpi--value" title="Opening plus period movement. This is the figure the trial balance shows for this account.">'
                    || '<span class="ds-kpi-ic fa fa-balance-scale"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Closing Balance</div><div class="ds-kpi-n">&#8377;'
                    || to_char(Abs(o.Amt + m.Pre - m.Dr + m.Cr),'FM99G99G99G990D00') || '</div>'
                    || '<div class="ds-kpi-sub">'
                       || Case When Abs(o.Amt + m.Pre - m.Dr + m.Cr) < 0.005 Then 'nil at ' || :P677_TODATE
                               When (o.Amt + m.Pre - m.Dr + m.Cr) < 0 Then 'debit at ' || :P677_TODATE
                               Else 'credit at ' || :P677_TODATE End
                    || '</div></div></div>' As KPI4,
                
                       '<div class="ds-kpi ds-kpi--' ||
                       Case When n.Bn Is Null Then 'slate'
                            When (n.Bn = 'DR' And (o.Amt + m.Pre - m.Dr + m.Cr) >  0.5)
                              Or (n.Bn = 'CR' And (o.Amt + m.Pre - m.Dr + m.Cr) < -0.5) Then 'risk'
                            Else 'ok' End
                    || '" title="Whether the closing side agrees with Party.BasicNature, the side the ERP itself declares for this account.">'
                    || '<span class="ds-kpi-ic fa fa-compass"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Balance Check</div><div class="ds-kpi-n">'
                    || Case When n.Bn Is Null Then 'No rule'
                            When (n.Bn = 'DR' And (o.Amt + m.Pre - m.Dr + m.Cr) >  0.5)
                              Or (n.Bn = 'CR' And (o.Amt + m.Pre - m.Dr + m.Cr) < -0.5) Then 'Wrong side'
                            Else 'Normal' End || '</div>'
                    || '<div class="ds-kpi-sub">'
                       || Case When n.Bn Is Null Then 'This ERP declares no expected side for this account'
                               Else 'Expected ' || Case n.Bn When 'DR' Then 'debit' Else 'credit' End
                                    || ', closing ' || Case When (o.Amt + m.Pre - m.Dr + m.Cr) < 0 Then 'debit' Else 'credit' End End
                    || '</div></div></div>' As KPI5,
                
                       '<div class="ds-kpi ds-kpi--slate" title="Newest voucher date touching this account within the financial year and scope.">'
                    || '<span class="ds-kpi-ic fa fa-clock-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">Last Posting</div><div class="ds-kpi-n">'
                    || nvl(to_char(m.LastMove,'DD-MM-RRRR'),'&mdash;') || '</div>'
                    || '<div class="ds-kpi-sub">'
                       || Case When m.LastMove Is Null Then 'Nothing posted this financial year'
                               Else to_char(trunc(sysdate) - m.LastMove,'FM999G990') || ' day(s) ago' End
                    || '</div></div></div>' As KPI6
                  From Op o Cross Join Mv m Cross Join Nat n
                ```
            pageItemsToSubmit: [
                P677_ACCOUNT
                P677_FROMDATE
                P677_TODATE
                P677_COMPANY
                P677_LOCATION
                P677_PANEL
            ]
        }
        layout {
            sequence: 12
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column KPI1 (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: KPI1
            }
            layout {
                sequence: 10
            }
            security {
