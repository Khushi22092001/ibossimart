    region ledger-note (
        name: Statement Basis
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-finnote">
                  <span class="fa fa-info-circle"></span>
                  <b>Running balance convention.</b> The column is signed in ledger convention &mdash; positive is a
                  debit balance, negative a credit &mdash; and starts from the opening shown above, so the last row
                  equals the closing balance in the header. Rows are ordered by voucher date, then Tno, then Sno, so
                  the sequence is stable when several vouchers share a date. <b>Contra Account(s)</b> lists up to six
                  other accounts on the same voucher; a large journal will be truncated, and the full entry is one
                  click away on the voucher number.
                </div>
                ```
        }
        layout {
            sequence: 33
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-fin-sectionregion
        }
    )

    region monthly-chart (
        name: Monthly Debit and Credit
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select to_char(trunc(d.VoucherDate,'MM'),'Mon RRRR') As LABEL,
                       Round(Sum(Case When nvl(d.Amount,0) < 0 Then -d.Amount Else 0 End),2) As DEBIT,
                       Round(Sum(Case When nvl(d.Amount,0) > 0 Then  d.Amount Else 0 End),2) As CREDIT
                  From VoucherDetail d
                 Where d.AccountCode = :P677_ACCOUNT
                   And d.VoucherDate >= to_date(:P677_FROMDATE,'DD-MM-RRRR')
                   And d.VoucherDate <  to_date(:P677_TODATE,'DD-MM-RRRR') + 1
                   And d.Tno Not In (Select v.Tno From Voucher v Where v.VoucherNo = 'OPENING')
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or d.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P677_PANEL Is Null Or d.Panel = :P677_PANEL)
                   And (:P677_COMPANY Is Null Or d.CompanyCode = :P677_COMPANY)
                   And (:P677_LOCATION Is Null Or d.LocationCode = :P677_LOCATION)
                 Group By trunc(d.VoucherDate,'MM')
                 Order By trunc(d.VoucherDate,'MM')
                ```
            pageItemsToSubmit: [
                P677_ACCOUNT
                P677_FROMDATE
                P677_TODATE
                P677_COMPANY
                P677_LOCATION
                P677_PANEL
            ]
        }
        layout {
            sequence: 22
            slot: body
            columnSpan: 7
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartLayout {
            height: 320
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: Nothing was posted to this account in the selected period.
        }

        series credit (
            name: Credit (₹)
            execution {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: CREDIT
            }
        )

        series debit (
            name: Debit (₹)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: DEBIT
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Movement (₹)
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

