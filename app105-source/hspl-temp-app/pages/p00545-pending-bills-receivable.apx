page 545 (
    name: Pending Bills Receivable
    alias: PENDING-BILLS-RECEIVABLE
    title: Pending Bills Receivable
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region pending-bills-receivable (
        name: Pending Bills Receivable
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    PartyName,
                    LocationCode,
                    DocumentDate As CCInvoiceDate,
                    DocumentNo As CCInvoiceNo,
                    CreditDays,
                    DueOn,
                    OverDueDays,
                    BalanceAmount,
                    DocumentType
                From
                (
                    Select
                        'Invoice' As DocumentType,
                        b.PartyName,
                        a.LocationCode,
                        a.CCInvoiceDate As DocumentDate,
                        a.CCInvoiceNo As DocumentNo,
                        c.CreditDays,
                        To_Char(a.CCInvoiceDate + Nvl(c.CreditDays,0), 'DD-MON-YY') As DueOn,
                        Trunc(Sysdate) - Trunc(a.CCInvoiceDate + Nvl(c.CreditDays,0)) As OverDueDays,
                        Nvl((Nvl(c1.InvoiceAmount,0) - Nvl(c1.PaidAmount,0)) - Nvl(c1.DeductedAmount,0),0) As BalanceAmount
                    From
                        CCInvoice a,
                        Party b,
                        SalesOrder c,
                        Invoice c1
                    Where a.PartyCode = b.PartyCode(+)
                      And a.SalesOrderTno = c.Tno(+)
                      And a.Tno = c1.ModuleTno(+)
                      And a.CCInvoiceDate <= :P545_ASONDATE
                      And (GetUserPanelAB_apex() Is Null Or a.Panel = GetUserPanelAB_apex())
                
                    Union All
                
                    Select
                        'Debit Note',
                        b.PartyName,
                        a.LocationCode,
                        a.DebitNoteDate,
                        a.DebitNoteNo,
                        Cast(NULL As Number),
                        Cast(NULL As Varchar2(20)),
                        Cast(NULL As Number),
                        Nvl(c.TotalAmount,0)
                    From
                        DebitNote a,
                        Party b,
                        (
                            Select
                                TNo,
                                Sum(TotalAmount) As TotalAmount
                            From DebitNoteDetail
                            Group By TNo
                        ) c
                    Where a.PartyCode = b.PartyCode(+)
                      And a.TNo = c.TNo(+)
                      And a.PartyInvoiceNo Is Null
                      And a.DebitNoteDate <= :P545_ASONDATE
                      And (GetUserPanelAB_apex() Is Null Or a.Panel = GetUserPanelAB_apex())
                )
                Where BalanceAmount > 0
                Order By
                    PartyName,
                    DocumentDate
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 5556742910849863
        }

