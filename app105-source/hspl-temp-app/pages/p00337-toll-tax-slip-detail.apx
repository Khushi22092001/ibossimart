page 337 (
    name: Toll Tax Slip Detail
    alias: TOLL-TAX-SLIP-DETAIL
    title: Toll Tax Slip Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region toll-detail (
        name: Toll Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   'SITE EXPENSES' AS ModuleName,
                   row_number() over(order by a.FreightAdvanceDate) SerialNo,
                   a.CompanyCode,
                   --c.ModuleName,
                   c.TollPlazaName,
                   a.FreightAdvanceNo as ModuleNo,
                   a.FreightAdvanceDate as ModuleDate,
                   a.GPNo,
                   a.VehicleNo,
                   d.BookNo,
                   sl.SourceLocationName,
                   dl.DestinationLocationName,
                   b.SlipNo,
                   b.Amount,
                   p.TransporterName
                From FreightAdvance a, FATollTaxSlipIssue b,TollPlaza c,TollTaxSlipIssue d,
                -- Module c,
                DocumentStatusDetail dsd, SourceLocation sl, DestinationLocation dl, Transporter p
                Where a.Tno = b.Tno
                	--and c.ModuleCode = 'FREIGHTADVANCE'
                   and b.TollPlazaCode = c.TollPlazaCode
                   and b.TollTaxSlipIssueTno = d.Tno
                	and a.Tno = dsd.ModuleTno
                   and a.SourceLocationTno = sl.Tno
                   and a.DestinationLocationTno = dl.Tno
                   and a.TransporterCode = p.TransporterCode(+)
                	and dsd.DocumentStatusCode = 'ACTIVE'
                   and a.VehicleGroupCode = 'SELF'
                	and a.VehicleNo is not null
                	and a.FreightAdvanceDate between :P337_FROMDATE and :P337_TODATE
                	and (:P337_COMPANY is Null Or Instr (':' || :P337_COMPANY || ':' , ':' || A.CompanyCode || ':') > 0)
                   and (:P337_TOLLPLAZA is Null Or Instr (':' || :P337_TOLLPLAZA || ':' , ':' || b.TollPlazaCode || ':') > 0)
                   and (:P337_BOOKNO is Null Or Instr (':' || :P337_BOOKNO || ':' , ':' || d.BookNo || ':') > 0)
                   and (:P337_SOURCE is Null Or Instr (':' || :P337_SOURCE || ':' , ':' || a.SourceLocationTno || ':') > 0)
                   and (:P337_DESTINATION is Null Or Instr (':' || :P337_DESTINATION || ':' , ':' || a.DestinationLocationTno || ':') > 0)
                   and (:P337_TOLLTAXSLIP is Null Or Instr (':' || :P337_TOLLTAXSLIP || ':' , ':' || b.SlipNo || ':') > 0)
                   and (:P337_VEHICLENO is Null Or Instr (':' || :P337_VEHICLENO || ':' , ':' || a.VehicleNo || ':') > 0)
                   and (:P337_TRANSPORTER is Null Or Instr (':' || :P337_TRANSPORTER || ':' , ':' || a.TransporterCode || ':') > 0)
                   
                
                
                
                /*UNION ALL
                Select
                   'LR' AS ModuleName,
                	a.CompanyCode,
                	--c.ModuleName,
                	a.LRNo as ModuleNo,
                	a.LRDate as ModuleDate,
                	a.GPNo,
                	a.VehicleNo,
                   sl.SourceLocationName,
                   dl.DestinationLocationName,
                	b.SlipNo,
                	b.Amount
                From LR a, LRTollTaxSlipIssue b,
                -- Module c, 
                 DocumentStatusDetail dsd,SourceLocation sl, DestinationLocation dl
                Where a.Tno = b.Tno
                	--and c.ModuleCode = 'LR'
                	and a.Tno = dsd.ModuleTno
                   and a.SourceLocationTno = sl.Tno
                   and a.DestinationLocationTno = dl.Tno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and a.VehicleNo is not null
                  and a.VehicleGroupCode = 'SELF'
                	and nvl(a.GPDate, a.LRDate) between :P337_FROMDATE and :P337_TODATE
                	and (:P337_COMPANY is Null Or Instr (':' || :P337_COMPANY || ':' , ':' || A.CompanyCode || ':') > 0)
                      and (:P337_SOURCE is Null Or Instr (':' || :P337_SOURCE || ':' , ':' || a.SourceLocationTno || ':') > 0)
                   and (:P337_DESTINATION is Null Or Instr (':' || :P337_DESTINATION || ':' , ':' || a.DestinationLocationTno || ':') > 0)
                   and (:P337_VEHICLENO is Null Or Instr (':' || :P337_VEHICLENO || ':' , ':' || a.VehicleNo || ':') > 0)*/
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 355027507676223455
        }

