    )

    pageItem P337_BOOKNO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Book No.
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    d.BookNo d,
                    d.BookNo r
                From FreightAdvance a, FATollTaxSlipIssue b,TollPlaza c,TollTaxSlipIssue d
                Where a.Tno = b.Tno
                    and b.TollPlazaCode = c.TollPlazaCode
                    and b.TollTaxSlipIssueTno = d.Tno
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @tolltax-slip-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

