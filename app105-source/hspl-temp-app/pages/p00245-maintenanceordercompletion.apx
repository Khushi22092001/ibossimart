page 245 (
    name: MaintenanceOrderCompletion
    alias: MAINTENANCEORDERCOMPLETION
    title: MaintenanceOrderCompletion
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenance-order-completion-report (
        name: Maintenance Order Completion Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
            renderComponents: belowContent
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                row_number() over(order by a.MaintenanceOrderCompletionDate) SerialNo,
                A.TNO,
                a.maintenanceordercompletionno,
                a.MaintenanceOrderCompletionDate,
                mo.equipmentmaintenanceorderno,
                mo.equipmentmaintenanceorderDate,
                e.equipmentno,
                e.equipmentname,
                em.employeename as MaintenanceInspectorName,
                em1.employeename as AuthorisedSignatory,
                mp.equipmentmaintenanceplanno,
                ms.maintenancestrategyname,
                a.breakdowncompletiondate AS RepairingCompletionDate,
                i.itemname,
                isp.itemspecificationname,
                round(b.Labouramount,2) as LabourAmount,
                round(b.spareamount,2) as spareamount,
                ses.serviceentrysheetno,
                a.hrreading,
                a.kmreading,
                ac.activitydescription,
                moci.measuringunitcode,
                round(moci.quantity1,2) as quantity1,
                moci.rate,
                round(moci.amount,2) as amount,
                l.locationname,
                c.companyname,
                d.doctypename,
                a.remark as ActionTaken,
                GetDateDifference(mo.BasicStartDate,a.BreakDownCompletionDate) as MaintenanceTime
                from maintenanceordercompletion a,
                     maintenanceordercompletiondtl b,
                     location l,
                     company c,
                     doctype d,
                     employee em,
                     employee em1,
                     equipment e,
                     equipmentmaintenanceorder mo,
                     equipmentmaintenanceplan mp,
                     serviceentrysheet ses,
                     maintenancestrategy ms,
                     maintenanceordercompletionitem moci,
                     item i,
                     itemspecification isp,
                     activity ac,
                     maintenancerequest mr
                where a.equipmenttno = e.tno(+)
                and a.doctypecode = d.doctypecode(+)
                and a.locationcode = l.locationcode(+)
                and a.companycode = c.companycode(+)
                and b.activitycode = ac.activitycode(+)
                and a.EquipmentMaintenanceOrderTno = mo.Tno(+)
                and mo.MaintenanceRequestTno = mr.Tno(+)
                and mr.PlanTno = mp.Tno(+)
                and mp.maintenancestrategycode = ms.maintenancestrategycode(+)
                and moci.itemcode = i.itemcode(+)
                and moci.itemspecificationcode = isp.itemspecificationcode(+)
                and a.Tno = b.Tno(+)
                and b.Tno = moci.Tno(+)
                and b.Sno = moci.sno(+)
                and a.maintenanceinspectorcode = em.employeecode(+)
                and a.employeecode = em1.employeecode(+)
                and a.EquipmentMaintenanceOrderTno = SES.EquipmentMaintenanceOrderTno
                and a.Maintenanceordercompletiondate between :P245_FROMDATE and :P245_TODATE
                and ( :P245_DOCTYPE IS NULL OR instr(':'||:P245_DOCTYPE||':',':'||d.DocTypeCode||':') > 0 ) 
                and (:P245_LOCATION IS NULL OR instr(':'||:P245_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P245_planno IS NULL OR instr(':'||:P245_planno||':',':'||mp.equipmentmaintenanceplanno||':') > 0 ) 
                and (:P245_equipment IS NULL OR instr(':'||:P245_equipment||':',':'||E.EQUIPMENTNAME||':') > 0)
                and (:P245_ORDERNO IS NULL OR instr(':'||:P245_ORDERNO||':',':'||MO.EQUIPMENTMAINTENANCEORDERNO||':') > 0 ) 
                and (:P245_STRATEGYNAME IS NULL OR instr(':'||:P245_STRATEGYNAME||':',':'||ms.MAINTENANCEstrategycode||':') > 0)
                and ( instr(':'||:P245_COMPANY||':',':'||C.COMPANYCODE||':') > 0 )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 7389144848066232
        }

