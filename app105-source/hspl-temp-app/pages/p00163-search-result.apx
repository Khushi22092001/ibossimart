page 163 (
    name: Search Result
    alias: SEARCH-RESULT
    title: Search Result
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region result (
        name: Result
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    search_title,
                    --apex_util.prepare_url(search_link) search_link,
                    search_desc,
                    'Type' AS label_01,
                    TYPE AS value_01,
                    NULL search_date
                FROM (
                    SELECT  1 display_seq,
                        tno ID,
                        'Report' TYPE,
                        reportname search_title,
                        reportname||' '||reportpath search_desc
                        --'f?p='||:APP_ID||':7:'||:APP_SESSION||':::7:P7_CUSTOMER_ID,P7_BRANCH:'||apex_escape.html(customer_id)||',30' search_link
                    FROM apexsearchresult
                    WHERE ( instr(upper(ReportName),upper(:P163_SEARCH)) > 0 
                	   or :P163_SEARCH is null )
                        AND instr(:P163_OPTIONS,'REPORT') > 0
                ) order by display_seq, search_title
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
            showNullValuesAs: -
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column LABEL_01 (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Label 01
                alignment: center
            }
            layout {
                sequence: 3
            }
            sorting {
                sortable: false
            }
        )

        column SEARCH_DATE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Search Date
                alignment: center
            }
            layout {
                sequence: 5
            }
            sorting {
                sortable: false
            }
        )

        column SEARCH_DESC (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Search Desc
                alignment: center
            }
            layout {
                sequence: 2
            }
            sorting {
                sortable: false
            }
        )

        column SEARCH_TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Search Title
                alignment: center
            }
            layout {
                sequence: 1
            }
            sorting {
                sortable: false
            }
        )

        column VALUE_01 (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Value 01
                alignment: center
            }
            layout {
                sequence: 4
            }
            sorting {
                sortable: false
            }
        )

    )

    region search-filter (
        name: Search Filter
        type: staticContent
        layout {
            sequence: 20
            slot: leftColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P163_OPTIONS (
        type: checkboxGroup
        label {
            label: Options
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Reports;REPORT,Chart;CHART
        }
        layout {
            sequence: 20
            region: @search-filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: REPORT:CHART
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P163_SEARCH (
        type: textField
        label {
            label: Search
            alignment: left
        }
        layout {
            sequence: 10
            region: @search-filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-search
            width: 64
            valuePlaceholder: Search
        }
        validation {
            maxLength: 4000
        }
        advanced {
            cssClasses: t-Form-searchField
        }
        security {
            encryptSessionState: false
        }
    )

)

