page 319 (
    name: Tipper Driver Salary
    alias: TIPPER-DRIVER-SALARY
    title: Tipper Driver Salary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.EmployeeName) SerialNo,
                a.EmployeeName,
                a.EMPId,
                a.Department as DepartmentName,
                a.Designation as DesignationName,
                a.PFAccountNo,
                e.NoOfTrip,
                a.TD as TotalDays,
                a.PD as WorkingDays,
                a.Pay_Basic as SalaryPerDay,
                a.EarnedFOODALLOWANCE as BhattaPerDay,
                a.EarnedBasic as EarnedSalary,
                f.PaidBhatta as EarnedBhatta,
                a.EarnedGOVBASIC as SalaryRatePerDay,
                ROUND(a.CALCULATEPAIDDAYS,0) as CALCULATEDAYS,
                nvl(a.GrossEar,0)+ nvl(f.PaidBhatta,0) as GrossSalary,
                a.PAY_PFEMPLOYER,
                a.PAY_PFEMPLOYEE,
                a.RunningAdvance as Deduction,
                a.SALARYADVANCE as Salary,
                a.SalAdv,
                f.PaidBhatta,
                nvl(a.GrossDed,0) + nvl(f.PaidBhatta,0) as GROSSDEDUCTION,
                a.NetEarning as NetPayable
                From SalaryEngineDetail a, Employee d,
                (
                 Select
                    x.DriverCode,
                    sum(x.NoOfTrip) as NoOfTrip
                From
                (
                Select
                    c.DriverCode,
                    count(a.ModuleTno) as NoOfTrip
                From NecessitySlipTrip a, LR b, NecessitySlip c
                Where a.ModuleTno = b.Tno
                    and a.Tno = c.Tno
                    and c.VehicleGroupCode = 'SELF'
                    --and a.DistanceInKM is not null
                    --and a.DieselQuantity is not null
                    and c.NecessitySlipDate between :P319_FROMDATE and :P319_TODATE
                    --and c.EquipmentID = :P374_VEHICLE
                 --   AND C.DRIVERCODE = '10321'
                    Group by
                    c.DriverCode
                UNION ALL
                Select
                    c.DriverCode,
                    count(a.ModuleTno) as NoOfTrip
                From NecessitySlipTrip a, InternalTransfer b, NecessitySlip c
                Where a.ModuleTno = b.Tno
                    and a.Tno = c.Tno
                    and c.VehicleGroupCode = 'SELF'
                    --and a.DistanceInKM is not null
                    --and a.DieselQuantity is not null
                    and c.NecessitySlipDate between :P319_FROMDATE and :P319_TODATE
                    --and c.EquipmentID = :P374_VEHICLE
                   -- AND C.DRIVERCODE = '10321'
                    Group by
                    c.DriverCode
                    Order by 1
                ) x
                   -- WHERE X.DRIVERCODE = '10321'
                    Group by
                    x.DriverCode
                ) e,
                (
                 Select 
                    a.DriverCode,
                    sum(a.Amount) as PaidBhatta 
                 From FreightAdvance a
                 Where a.DrAccountCode = 'ALLOWANCETODRIVER'
                  and a.FreightAdvanceDate between :P319_FROMDATE AND :P319_TODATE
                  and nvl(a.Amount, 0) > 0
                  --and a.drivercode = '10321'
                  Group by a.DriverCode)f
                Where a.EmployeeCode = d.EmployeeCode(+)
                and a.EmployeeCode = e.DriverCode(+)
                and a.EmployeeCode = f.DriverCode(+) 
                and A.DESIGNATION = 'TIPPER DRIVER'
                and ( :P319_COMPANY IS NULL OR instr(':'||:P319_COMPANY||':',':'||a.CompanyCode||':') > 0)
                and a.SalaryDate between :P319_FROMDATE and :P319_TODATE
                and ( :P319_LOCATION IS NULL OR instr(':'||:P319_LOCATION||':',':'||a.LocationCode||':') > 0)
                and ( :P319_EMPLOYEE IS NULL OR instr(':'||:P319_EMPLOYEE||':',':'||a.EmployeeCode||':') > 0)
                and ( :P319_DEPARTMENT IS NULL OR instr(':'||:P319_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0);
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
