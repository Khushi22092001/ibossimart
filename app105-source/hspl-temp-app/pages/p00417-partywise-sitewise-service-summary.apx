page 417 (
    name: PartyWise Sitewise Service Summary
    alias: PARTYWISE-SITEWISE-SERVICE-SUMMARY
    title: PartyWise SiteWise Service Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region partywise-summary (
        name: PartyWise Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                   row_number() over(order by a.LocationCode) SerialNo,
                  a.LocationName,
                  a.LocationCode,
                  a.PartyName,
                  a.PartyCode,
                  sum(a.Quantity) as Quantity,
                  sum(a.Amount) as Amount
                 From 
                (Select 
                  c.LocationName,
                  a.LocationCode,
                  e.PartyName,
                  a.PartyCode,
                  nvl(b.Quantity,d.Quantity) as Quantity,
                  nvl(b.Amount,d.Amount) as Amount
                  From ExternalServicesEntry a, ExternalSpareEntryDetail b, ExternalServicesEntryDetail d,Location c, Party e
                  Where a.Tno = b.Tno(+)  
                  and a.Tno = d.Tno(+)
                  and a.LocationCode = c.LocationCode(+)
                  and a.PartyCode = e.PartyCode(+)
                  and a.ExternalServicesEntryDate between :P417_FROMDATE and :P417_TODATE
                --   Group By 
                --   c.LocationName,
                --   a.LocationCode,
                --   e.PartyName,
                --   a.PartyCode
                 -- and c.LocationName = 'CORPORATE(KSR)'
                UNION ALL
                Select
                   c.LocationName,
                   a.LocationCode,
                   e.PartyName,
                   d.PartyCode,
                   NVL(b.Quantity1,0) as Quantity,
                   NVL(b.Amount,0) as Amount
                From JBPass a, JBPassDetail b, Location c, JobBill d,Party e
                Where a.Tno = b.Tno(+)
                  and a.LocationCode = c.LocationCode(+)
                  and a.JobBillTno = d.Tno(+)
                  and d.PartyCode = e.PartyCode(+)
                  and a.JBPassDate between :P417_FROMDATE and :P417_TODATE
                -- Group by c.LocationName,
                --    a.LocationCode,
                --    e.PartyName,
                --    d.PartyCode
                   ) a
                  --  and c.LocationName = 'CORPORATE(KSR)'
                Where ( :P417_LOCATION IS NULL OR instr(':'||:P417_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                and ( :P417_PARTY IS NULL OR instr(':'||:P417_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                Group by a.LocationName,
                   a.LocationCode,
                   a.PartyName,
                   a.PartyCode
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 55388005969361537
        }

        column AMOUNT (
            type: link
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            link {
                target: {
                    page: 421
                    items: {
                        P421_FROMDATE: &P417_FROMDATE.
                        P421_TODATE: &P417_TODATE.
                        P421_LOCATION: #LOCATIONCODE#
                        P421_PARTY: #PARTYCODE#
                    }
                    clearCache: 421
                }
                linkText: #AMOUNT#
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: Locationcode
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location Name
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column PARTYCODE (
            type: plainText
            heading {
                heading: Partycode
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column PARTYNAME (
            type: plainText
            heading {
                heading: Party Name
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 276364 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 5
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn PARTYNAME (
                sequence: 3
            )

            displayColumn QUANTITY (
                sequence: 4
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: LOCATIONNAME
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P417_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @partywise-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P417_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                a.*
                 From 
                 (Select 
                  c.LocationName d,
                  c.LocationCode r
                  From ExternalServicesEntry a, Location c
                  Where a.LocationCode = c.LocationCode
                UNION ALL
                Select
                   c.LocationName d,
                   c.LocationCode r
                From JBPass a, Location c
                Where a.LocationCode = c.LocationCode) a
                ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @partywise-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Location Name
        }
    )

    pageItem P417_PARTY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Party
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                 a.*
                 From 
                (Select 
                  e.PartyName d,
                  a.PartyCode r
                  From ExternalServicesEntry a, Party e
                  Where a.PartyCode = e.PartyCode(+)
                UNION ALL
                Select
                   e.PartyName d,
                   d.PartyCode r
                From JBPass a, JobBill d,Party e
                Where a.JobBillTno = d.Tno(+)
                  and d.PartyCode = e.PartyCode(+))a
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @partywise-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Party Name
        }
    )

    pageItem P417_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @partywise-summary
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 60
            region: @partywise-summary
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

