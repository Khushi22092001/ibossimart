        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/purchasebillpassregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P75_FROMDATE=&P75_FROMDATE.&P75_TODATE=&P75_TODATE.&P75_PBPASSNO=&P75_PBPASSNO.&P75_VSTATUS=&P75_VSTATUS.&P75_ITEMSPECIFICATION=&P75_ITEMSPECIFICATION.&P75_ITEM=&P75_ITEM.&P75_LOCATION=&P75_LOCATION.&P75_PARTYNAME=&P75_PARTYNAME.
