        column UOM1 (
            type: plainText
            heading {
                heading: P UOM
                alignment: center
            }
            layout {
                sequence: 310
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:60px">#UOM1#</div>
