page 277 (
    name: RR Register
    alias: RR-REGISTER
    title: RR Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region rr-register-updation (
        name: RR Register Updation
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region rr-register-updation-report (
        name: RR Register Updation Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                row_number() over(order by CRU.CMPLRAKERRUPDATIONDate) SerialNo,
                l.locationname as location,
                d.doctypename as doctype,
                c.companyname as company,
                cru.cmplrakerrupdationdate,
                cru.cmplrakerrupdationno,
                cr.cmplrakeno as rakeentryno,
                cr.rakeno,
                cr.rrno,
                cr.rrdate,
                round(cr.rrweight,3) as rrweight,
                cr.totalwagen as noofwagen,
                cy.SourceLocationName as source,
                dy.DestinationLocationName as destination,
                cr.Creator
                from cmplrake cr,
                     cmplrakerrupdation cru,
                     SourceLocation cy,
                     DestinationLocation dy,
                     location l,
                     doctype d,
                     company c
                where  cr.tno = cru.cmplraketno
                and cr.locationcode = l.locationcode(+)
                and cr.doctypecode = d.doctypecode(+)
                and cr.companycode = c.companycode(+)
                and cr.SourceLocationTno = cy.Tno(+)
                and cr.DestinationLocationTno = dy.Tno(+)
                and cru.cmplrakerrupdationdate between :P277_FROMDATE and :P277_TODATE
                and ( :P277_COMPANY IS NULL OR instr(':'||:P277_COMPANY||':',':'||c.CompanyCode||':') > 0 ) 
                and (:P277_LOCATION IS NULL OR instr(':'||:P277_LOCATION||':',':'||L.locationcode||':') > 0)
                and ( :P277_RAKEENTRYNO IS NULL OR instr(':'||:P277_RAKEENTRYNO||':',':'||CR.CMPLRAKENO||':') > 0 ) 
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 14388483233383221
        }

