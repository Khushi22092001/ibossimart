    pageItem P277_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT Distinct
                COMPANYNAME D,
                COMPANYCODE R
                FROM COMPANY
                ```
        }
        layout {
            sequence: 40
            region: @rr-register-updation
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 35
        }
    )

