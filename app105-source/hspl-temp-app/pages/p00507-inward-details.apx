            sequence: 50
            slot: contentBody
        }
    )

    pageItem P507_ITEMCODE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P507_ITEMSPECIFICATIONCODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P507_LOCATION (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    button back (
        buttonName: BACK
        label: Back
        layout {
            sequence: 10
            slot: contentBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 506
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

