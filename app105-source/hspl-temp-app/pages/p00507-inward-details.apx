page 507 (
    name: Inward Details
    alias: INWARD-DETAILS
    title: Inward Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 800
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region inward-details (
        name: Inward Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.TNo,
                      a.SNo,
                      g.GRNNo as ModuleNo,
                      g.GRNDate as ModuleDate,
                      dt.DocTypeName,
                      a.Quantity1
                From  StockIn a , GRN g, DocType dt, purchaseorder p
                Where a.ModuleCode = 'GRN'
                  and a.TNo = g.TNo(+)
                  and g.DocTypeCode = dt.DocTypeCode(+)
                  and g.purchaseordertno = p.tno(+)
                  and a.ItemCode = :P507_ITEMCODE
                  and (:P507_ITEMSPECIFICATIONCODE is null or a.ItemSpecificatioNCode = :P507_ITEMSPECIFICATIONCODE)
                  and a.LocationCode like nvl(:P507_LOCATION,'%')
                  and a.InDate = :P507_DAYDATE 
                  and (getuserpanelab_apex() is null or g.panel = getuserpanelab_apex())
                Union All
                Select
                      a.TNo,
                      a.SNo,
                      g.StockJournalNo as ModuleNo,
                      g.StockJournalDate as ModuleDate,
                      dt.DocTypeName,
                      a.Quantity1
                From  StockIn a , StockJournal g, DocType dt
                Where a.ModuleCode = 'STOCKJOURNAL'
                  and a.TNo = g.TNo(+)
                  and g.DocTypeCode = dt.DocTypeCode(+)
                  and a.ItemCode = :P507_ITEMCODE
                  and (:P507_ITEMSPECIFICATIONCODE is null or a.ItemSpecificatioNCode = :P507_ITEMSPECIFICATIONCODE)
                  and g.LocationCode like nvl(:P507_LOCATION,'%')
                  and a.InDate = :P507_DAYDATE
                  and (getuserpanelab_apex() is null or g.panel = getuserpanelab_apex())
                  Union All
                Select
                      a.TNo,
                      a.SNo,
                      g.ProductionNo as ModuleNo,
                      g.ProductionDate as ModuleDate,
                      dt.DocTypeName,
                      a.Quantity1
                From  StockIn a , PRODUCTION g, DocType dt
                Where a.ModuleCode = 'PRODUCTION'
                  and a.TNo = g.TNo(+)
                  and g.DocTypeCode = dt.DocTypeCode(+)
                  and a.ItemCode = :P507_ITEMCODE
                  and (:P507_ITEMSPECIFICATIONCODE is null or a.ItemSpecificatioNCode = :P507_ITEMSPECIFICATIONCODE)
                  and g.LocationCode like nvl(:P507_LOCATION,'%')
                  and a.InDate = :P507_DAYDATE
                  and (getuserpanelab_apex() is null or g.panel = getuserpanelab_apex())
                 ----------
                
                ```
            pageItemsToSubmit: [
                P507_DAYDATE
                P507_LOCATION
                P507_ITEMCODE
                P507_ITEMSPECIFICATIONCODE
            ]
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 59422081008147839
        }

        column DOCTYPENAME (
            type: plainText
            heading {
                heading: Doctype Name
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BC
            }
        )

        column MODULEDATE (
            type: plainText
            heading {
                heading: Module Date
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: BB
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BA
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Quantity
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: BD
            }
        )

        column SNO (
            type: plainText
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AZ
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AY
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: NecessitySlip Detail Report
        }

        savedReport 232721 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn DOCTYPENAME (
                sequence: 3
            )

            displayColumn MODULEDATE (
                sequence: 2
            )

            displayColumn MODULENO (
                sequence: 1
            )

            displayColumn QUANTITY1 (
                sequence: 4
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: NECESSITYSLIPNO
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P507_DAYDATE (
