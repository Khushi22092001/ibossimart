    region manpower (
        name: Manpower
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent14
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-sm
                margin-left-sm
                margin-right-sm
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region month-wise-active-employee (
        name: Month Wise Active Employee
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct Replace(B.FIN_YEAR, '-', '') As FINYEAR,
                                To_Char(B.FIN_MONTH_END_DATE, 'MON-YYYY') As Month,
                                To_Char(B.FIN_MONTH_END_DATE, 'YYYYMM') As Monthyy,
                                Count(Distinct A.EMPLOYEECODE) As ACTIVE
                  From BI_DATETIME B, EMPLOYEE A
                 Where (Replace(B.FIN_YEAR, '-', '') =:P127_FINYEAR OR :P127_FINYEAR IS NULL )
                   And TO_DATE(B.FIN_MONTH_END_DATE, 'DD-MM-YYYY') >=
                       TO_DATE(A.DATEOFJOINING, 'DD-MM-YYYY')
                 Group By Replace(B.FIN_YEAR, '-', ''),
                          To_Char(B.FIN_MONTH_END_DATE, 'MON-YYYY'),
                          To_Char(B.FIN_MONTH_END_DATE, 'YYYYMM')
                
                UNION ALL
                Select Distinct Replace(B.FIN_YEAR, '-', '') As FINYEAR,
                                To_Char(B.FIN_MONTH_END_DATE, 'MON-YYYY') As Month,
                                To_Char(B.FIN_MONTH_END_DATE, 'YYYYMM') As Monthyy,
                                Count(Distinct A.EMPLOYEECODE) As NEWJOINING
                  From BI_DATETIME B, EMPLOYEE A
                 Where (Replace(B.FIN_YEAR, '-', '') = :P127_FINYEAR OR :P127_FINYEAR IS NULL )
                   And TO_DATE(A.DATEOFJOINING, 'DD-MM-YYYY') Between
                       TO_DATE(B.FIN_MONTH_START_DATE, 'DD-MM-YYYY') And
                       TO_DATE(B.FIN_MONTH_END_DATE, 'DD-MM-YYYY')
                
                 Group By Replace(B.FIN_YEAR, '-', ''),
                          To_Char(B.FIN_MONTH_END_DATE, 'MON-YYYY'),
                          To_Char(B.FIN_MONTH_END_DATE, 'YYYYMM')
                Order By 3
                
                ```
            pageItemsToSubmit: P127_MONTH
        }
        layout {
            sequence: 30
            parentRegion: @manpower
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent7
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: combination
        }
        chartAppearance {
            stack: true
        }
        chartLayout {
            height: 400
        }
        legend {
            show: false
        }

        series months-bar-chart (
            name: Months Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select B.FIN_YEAR,
                           To_Char(B.FIN_MONTH_END_DATE, 'MON-RRRR') As Month,
                           To_Char(B.FIN_MONTH_END_DATE, 'RRRRMM') As Monthyy,
                           
                           Replace(b.Fin_Year, '-', '') FYCODE,
                           Count(Distinct A.TNO) As ActiveMember
                    --       Count(A.TNO) As ActiveMember
                      From EMPLOYEE A, BI_DATETIME B, DocumentstatusDetail c
                     Where Trunc(C.STATUSTIME) <= B.FIN_DATE
                       And a.tno = c.moduletno(+)
                       And c.documentstatuscode = 'ACTIVE'
                       And Not Exists (Select aa.tno
                              From Resignation aa
                             Where aa.employeecode = a.employeecode
                               And aa.resignationdate > b.FIN_YEAR_END)
                       And Not Exists (Select aa.tno
                              From Termination aa
                             Where aa.employeecode = a.employeecode
                               And aa.Terminationdate > b.FIN_YEAR_END)
                       And a.employeecode Not In ('AS', 'VAS')
                       And (Replace(B.FIN_YEAR, '-', '') = :P127_FINYEAR Or
                            :P127_FINYEAR Is Null)
                       And TO_DATE(B.FIN_MONTH_END_DATE, 'DD-MM-RRRR') >=
                           TO_DATE(A.DATEOFJOINING, 'DD-MM-RRRR')
                     Group By b.fin_year,
                              To_Char(B.FIN_MONTH_END_DATE, 'MON-RRRR'),
                              To_Char(B.FIN_MONTH_END_DATE, 'RRRRMM')
                    
                    ```
                pageItemsToSubmit: P127_MONTH
            }
            columnMapping {
                label: MONTH
                value: ACTIVEMEMBER
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P127_MONTH',&MONTHYY.);
            }
            label {
                show: true
                position: outsideBarEdge
                fontSize: 10
            }
        )

        series new-hiring (
            name: New Hiring
            type: line
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select Distinct Replace(B.FIN_YEAR, '-', '') As FINYEAR,
                                    To_Char(B.FIN_MONTH_END_DATE, 'MON-RRRR') As Month,
                                    To_Char(B.FIN_MONTH_END_DATE, 'RRRRMM') As Monthyy,
                                    Count(Distinct A.EMPLOYEECODE) As NEWJOINING
                      From BI_DATETIME B, EMPLOYEE A
                     Where (Replace(B.FIN_YEAR, '-', '') = :P127_FINYEAR OR :P127_FINYEAR IS NULL )
                       And TO_DATE(A.DATEOFJOINING, 'DD-MM-RRRR') Between
                           TO_DATE(B.FIN_MONTH_START_DATE, 'DD-MM-RRRR') And
                           TO_DATE(B.FIN_MONTH_END_DATE, 'DD-MM-RRRR')
                    
                     Group By Replace(B.FIN_YEAR, '-', ''),
                              To_Char(B.FIN_MONTH_END_DATE, 'MON-RRRR'),
                              To_Char(B.FIN_MONTH_END_DATE, 'RRRRMM')
                    Order By TO_NUMBER(To_Char(B.FIN_MONTH_END_DATE, 'RRRRMM'))
                    
                    ```
                pageItemsToSubmit: P127_MONTH
            }
            columnMapping {
                seriesName: NEWJOINING
                label: MONTH
                value: NEWJOINING
            }
            marker {
                show: false
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region organisation-chart (
        name: Organisation Chart
        type: plugin/d3CollapsibleTreeChart
        source {
            sqlQuery:
                ```sql
                Select B.tno As Id,
                       C.tno As PARENT_ID,
                       (Select Count(AA.CHILDCODE)
                          From MYEMPLOYEEINCLUDE AA
                         Where AA.DEPARTMENTCODE = B.DEPARTMENTCODE) As NoOfEmp,
                       (Select Sum(bb.monthlyctc)
                          From MyEmployeeInclude aa, Employee Bb
                         Where aa.CHILDCODE = bb.employeecode
                           And AA.DEPARTMENTCODE = B.DEPARTMENTCODE) As Cost,
                       B.DepartmentName AS DisplayName,
                       Null As Link,
                       Null As Infostring
                  From DEPARTMENT B, Department c
                 Where B.PARENTCODE = C.DEPARTMENTCODE(+)
                 
                ```
            pageItemsToSubmit: P127_MONTH
        }
        layout {
            sequence: 20
            parentRegion: @manpower
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent1
                t-Region--noBorder
                t-Region--hiddenOverflow
                t-Form--standardPadding
                t-Form--stretchInputs
            ]
        }
        settings {
            labelColumn: DISPLAYNAME
            valueColumn: NOOFEMP
            primaryKeyColumn: ID
            parentKeyColumn: PARENT_ID
            colorGroupColumn: PARENT_ID
            showTooltips: true
            tootipColumn: COST
            treeConfigurationJson:
                ```
                {
                  "trdur":                       500,
                  "css_class_node":              "com_oracle_apex_d3_tree_node",
                  "css_class_leafnode":          "com_oracle_apex_d3_tree_leafnode",
                  "css_class_link":              "com_oracle_apex_d3_tree_link",
                  "circle_radius_min":           05,
                  "circle_radius_max":           05,
                  "legend_column_width":         500,
                  "root_label":                  "PBS",
                  "show_coll_child_cnt":         true,
                  "show_coll_child_template":    " (#CNT#)",
                  "offset_scrollbars":           20, 
                  "margin":                      {"top": 20, "right": 500, "bottom": 20, "left": 120}
                }
                ```
        }
    )

    region pf-contribution (
        name: PF Contribution
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select dp.DepartmentCode,
                       RPAD(' . ', (Level - 1) * 2) || getdepartmentname(z.DEPARTMENTCODE) As TREE,
                       z.EmployeePF,
                       z.EmployerPF
                  From (Select m.DepartmentCode,
                               Sum(a.EARNEDPFCOMPCONTRIBUTION) As EmployeePF,
                               Sum(a.EARNEDPFEMPLOYEECONTRIBUTION) As EmployerPF
                          From SalaryEngineDetail a, MyEmployeeInclude m
                         Where TO_CHAR(a.SalaryFromDate, 'YYYYMM') = :P127_MONTH
                           And a.StaffType != 'HAMAL'
                           And a.EmployeeCode = m.ChildCode
                         Group By m.DepartmentCode
                        
                        ) z,
                       Department dp
                 Where z.DepartmentCode = dp.DepartmentCode
                   And Level <= 2
                 Start With dp.ParentCode Is Null
                Connect By Prior dp.DepartmentCode = dp.ParentCode
                 Order By Level, TREE
                
                ```
            pageItemsToSubmit: P127_MONTH
        }
        layout {
            sequence: 90
            parentRegion: @manpower
            slot: subRegions
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DEPARTMENTCODE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column EMPLOYEEPF (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: EMPLOYEE CONTRIBUTION
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column EMPLOYERPF (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: EMPLOYER CONTRIBUTION
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column TREE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: DEPARTMENT NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

    region remuneration (
        name: Remuneration
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select dp.DepartmentCode,
                       RPAD(' . ', (Level - 1) * 2) || getdepartmentname(z.DEPARTMENTCODE) As TREE,
                       z.SalaryAmount,
                       z.OTAmount,
                       z.TotalSALOTAmount
                  From (Select m.DepartmentCode,
                               Sum(a.NetEarning) - Sum(a.otamount) As SalaryAmount,
                               Sum(a.otamount) As OTAmount,
                               Sum(a.NetEarning) As TotalSALOTAmount
                          From SalaryEngineDetail a, MyEmployeeInclude m
                         Where TO_CHAR(a.SalaryFromDate, 'YYYYMM') = :P127_MONTH    
                           And a.StaffType != 'HAMAL'
                           And a.EmployeeCode = m.ChildCode
                         Group By m.DepartmentCode
                        
                        ) z,
                       Department dp
                 Where z.DepartmentCode = dp.DepartmentCode
                   And Level <= 2
                 Start With dp.ParentCode Is Null
                Connect By Prior dp.DepartmentCode = dp.ParentCode
                 Order By Level, TREE
                
                ```
            pageItemsToSubmit: P127_MONTH
        }
        layout {
            sequence: 80
            parentRegion: @manpower
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column DEPARTMENTCODE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column OTAMOUNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: OVERTIME
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column SALARYAMOUNT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: SALERY
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column TOTALSALOTAMOUNT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: TOTAL SALARY + OT
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column TREE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: DEPARTMENT NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

