    dynamicAction finyearchange (
        name: FINYEARCHANGE
        execution {
            sequence: 30
            eventScope: dynamic
        }
        when {
            selectionType: items
            items: P127_FINYEAR
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @month-wise-active-employee
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

