    dynamicAction new (
        name: New_1
        execution {
            sequence: 60
        }
        when {
            selectionType: items
            items: P447_NEXTPROCESS
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @freight-advance-credit-voucher-2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P447_INDENTNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P447_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P447_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 60140982569874018
        }
        serverSideCondition {
            type: never
        }
    )

