    region freight-advance-credit-voucher-2 (
        name: Freight Advance Credit Voucher
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                   row_number() over(order by a.VoucherDate) SerialNo,
                   a.VoucherNo,
                   a.VoucherDate,
                   a.FreightAdviceNo,
                   round(a.Amount,2) as Amount,
                   c.LocationName,
                   b.CompanyName
                From FreightAdvanceCreditVoucher a, Company b, Location c
                Where a.CompanyCode = b.CompanyCode(+)
                  and a.LocationCode = c.LocationCode(+)
                  and a.VoucherDate Between :P447_FROMDATE and :P447_TODATE
                  and ( :P447_COMPANY IS NULL OR instr(':'||:P447_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                 and ( :P447_LOCATION IS NULL OR instr(':'||:P447_LOCATION||':',':'||a.LocationCode||':') > 0 )
                -- and ( :P441_VOUCHER IS NULL OR instr(':'||:P441_VOUCHER||':',':'||a.Tno||':') > 0 );
                -- and ( :P441_COMPANY IS NULL OR instr(':'||:P441_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                -- and ( :P441_LOCATION IS NULL OR instr(':'||:P441_LOCATION||':',':'||a.LocationCode||':') > 0 )
                -- and ( :P441_VOUCHER IS NULL OR instr(':'||:P441_VOUCHER||':',':'||a.Tno||':') > 0 );
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
