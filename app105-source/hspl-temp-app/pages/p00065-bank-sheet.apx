page 65 (
    name: Bank Sheet
    alias: BANK-SHEET
    title: Bank Sheet
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region bank-sheet (
        name: Bank Sheet
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region bank-sheet-report (
        name: Bank Sheet Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.BankAccountNo,
                      a.EmpID,
                      a.EmployeeName,
                      a.NetEarning,
                      a.IFSCCode,
                      a.BankName,
                      a.BankBranchName,
                      a.SalaryMonth,
                      ROUND(nvl(b.NetAmount,0),2) as NetAmount,
                      ROUND(nvl(a.NetEarning,0) + nvl(b.NetAmount,0),2) as TotalNetEarning
                From  SalaryEngineDetail a, OTEngineDetail b
                Where a.EmployeeCode = b.EmployeeCode(+)
                  and a.SalaryMonth = b.OvertimeMonth(+)
                  and a.CompanyCode = b.CompanyCode(+)
                  and a.LocationCode = b.LocationCode(+)
                  and not exists (Select 1 From HoldSalary x Where x.EmployeeCode = a.EmployeeCode and x.SalaryFromDate = a.SalaryFromDate)
                  and instr(':'||:P65_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P65_LOCATION||':',':'||a.LocationCode||':') > 0
                  and a.SalaryFromDate = :P65_FROMDATE
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                html
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 12057116927018506
        }

        column BANKACCOUNTNO (
            type: plainText
            heading {
                heading: BANK ACCOUNT NO
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AK
            }
        )

        column BANKBRANCHNAME (
            type: plainText
            heading {
                heading: BANK BRANCH
