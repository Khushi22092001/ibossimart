            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AQ
            }
        )

        column BANKNAME (
            type: plainText
            heading {
                heading: BANK NAME
                alignment: center
            }
            layout {
