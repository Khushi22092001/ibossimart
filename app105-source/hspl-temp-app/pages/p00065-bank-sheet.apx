            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AO
            }
        )

        column NETAMOUNT (
            type: plainText
            heading {
                heading: OT NET
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AS
            }
        )

        column NETEARNING (
            type: plainText
            heading {
                heading: "SALARY NET "
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AN
            }
        )

        column SALARYMONTH (
            type: plainText
            heading {
