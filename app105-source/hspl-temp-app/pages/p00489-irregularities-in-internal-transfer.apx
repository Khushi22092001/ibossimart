page 489 (
    name: Irregularities In Internal Transfer
    alias: IRREGULARITIES-IN-INTERNAL-TRANSFER
    title: irregularities In Internal Transfer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region irregularities-in-internal-transfer (
        name: Irregularities In Internal Transfer
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    sl.LocationName as SenderLocation,
                    rl.LocationName as ReceivingLocation,
                    a.CCInvoiceNo,
                    a.CCINvoiceDate,
                    TO_DATE(:P489_ASONDATE) - a.CCInvoiceDate as NosOfDays, 
                    a.GrossWeight,
                    a.TareWeight,
                    a.NetWeight,
                    c.EmployeeName,
                    d.PartyName,
                    e.VehicletypeName,
                    f.InterunitTransferNo,
                    g.FreighttypeName,
                    h.DespatchCategoryName,
                    i.CurrencyUnitName,
                    a.CurrencyValue,
                    j.NatureOfSupplyName,
                    a.Distance,
                    k.LocationName,
                    a.Vehicleno,
                    b.GRNNO,
                    m.ItemName ||'-'|| n.ItemSpecificationName as Item,
                    l.Quantity1,
                    b.GRNDate,
                    l.Amount,
                    l.Rate
                From CCInvoice a, grn b, Employee c, Party d, Vehicletype e, InterunitTransfer f, Freighttype g, DespatchCategory h, CurrencyUnit i, 
                NatureOfSupply j, Location k, CCInvoiceDetail l, Item m, ItemSpecification n, Location sl, Location rl
                Where a.TNO = b.InterUnitTransferCCInvoiceTNo(+) 
                and a.EmployeeCode = c.EmployeeCode
                and a.PartyCode  = d.PartyCode
                and a.VehicletypeCode = e.VehicletypeCode
                and a.InterUnitTransferTno = f.Tno
                and a.FreighttypeCode = g.FreighttypeCode
                and a.DespatchCategoryCode = h.DespatchCategoryCode
                and a.CurrencyUnitCode = i.CurrencyUnitCode
                and a.NatureOfSupplyCode = j.NatureOfSupplyCode
                and a.LocationCode = k.LocationCode
                and a.Tno = l.Tno
                and l.ItemCode = m.ItemCode
                and l.ItemSPecificationCode = n.ItemSPecificationCode
                and a.LocationCode = sl.LocationCode
                and f.LocationCode = rl.LocationCode
                and a.CCInvoiceDate <= TO_DATE(:P489_ASONDATE) - 4
                and not exists(
                    select 
                        aa.tno
                    from GRN aa 
                    where aa.InterUnitTransferCCInvoiceTNo = a.TNo 
                )
                and a.DoctypeCode = 'INTERUNITTRANSFER'
                and ( :P489_COMPANY IS NULL OR instr(':'||:P489_COMPANY||':',':'||a.CompanyCode||':') > 0)
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            regionDisplaySelector: true
