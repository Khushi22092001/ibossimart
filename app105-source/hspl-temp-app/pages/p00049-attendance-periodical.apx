page 49 (
    name: Attendance Periodical
    alias: ATTENDANCE-PERIODICAL
    title: Attendance Periodical
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region attendance-periodical (
        name: Attendance Periodical
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region attendance-periodical-report (
        name: Attendance Periodical Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select * From 
                (Select
                      row_number() over(order by a.AttendencePeriodicalDate) SerialNo,
                      a.CompanyCode,
                      c.CompanyName,
                      l.LocationCode,
                      l.LocationName,
                      a.AttendencePeriodicalDate,
                      a.AttendencePeriodicalNo,
                      e.EmployeeName,
                      e.EmployeeID,
                      To_Char(a.FromDate,'MON-YYYY') Month,
                      a.FromDate,
                      a.ToDate,
                      b.attendenceheadcode,
                      b.attendencevalue
                From  AttendencePeriodical a, Employee e, AttendencePeriodicalDetail b, Company c, Location l
                Where a.EmployeeCode = e.EmployeeCode
                  and a.TNo = b.TNo
                  and a.CompanyCode = c.CompanyCode
                  and a.LocationCode = l.LocationCode
                --  and a.EmployeeCode = '247'
                  and a.AttendencePeriodicalDate between :P49_FROMDATE and :P49_TODATE
                  and instr(':'||:P49_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P49_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and ( :P49_EMPLOYEE IS NULL OR instr(':'||:P49_EMPLOYEE||':',':'||e.EmployeeCode||':') > 0 )
                  and ( :P49_DEPARTMENT IS NULL OR instr(':'||:P49_DEPARTMENT||':',':'||GetEmployeeDepartmentCode(e.EmployeeCode,:P49_FROMDATE)||':') > 0 )
                
                  )
                Pivot (
                SUM(ATTENDENCEVALUE) AS VALUE FOR ATTENDENCEHEADCODE IN ( 'PR','WOFF','EL','PL','CL','OH','OD','NH','AB','ML','LWP','COFF','PERK')
                ) ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 1861982594276524
        }

