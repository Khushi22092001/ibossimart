                b.StorageLocationName d,
                b.StorageLocationCode r
                From CashPurchase a,CashPurchaseDetail aa, StorageLocation b
                Where a.Tno = aa.Tno(+)
                and aa.StorageLocationCode = b.StorageLocationCode(+)
                ```
            displayNullValue: false
        }
        layout {
            sequence: 130
            region: @cash-purchase-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
