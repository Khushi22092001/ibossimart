            width: 30
        }
    )

    pageItem P289_SERVICETYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Service Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                b.JobTypeName d,
                b.JobtypeCode r
                From CashPurchase a,CashPurchaseDetail aa, Jobtype b
                Where a.Tno = aa.Tno(+)
                and aa.JobtypeCode = b.JobtypeCode(+)
                ```
            displayNullValue: false
        }
        layout {
            sequence: 120
            region: @cash-purchase-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P289_STORAGELOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Storage Location
            alignment: left
        }
        settings {
            generalSettings: [
