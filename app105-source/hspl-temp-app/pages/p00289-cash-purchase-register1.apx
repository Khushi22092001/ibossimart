page 289 (
    name: Cash Purchase Register
    alias: CASH-PURCHASE-REGISTER1
    title: Cash Purchase Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region cash-purchase-register (
        name: Cash Purchase  Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region cash-purchase-report (
        name: Cash Purchase Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.CASHPURCHASEDATE) SerialNo,
                a.Tno,
                a.CashPurchaseNo,
                a.CashpurchaseDate,
                b.DoctypeName,
                a.SupplierName,
                a.ReferenceNo,
                a.ReferenceDate,
                e.FooterNatureName,
                d.PartyName as DebitAccountName,
                c.PartyName as CreditAccountName,
                f.MoneyTransferModeName,
                g.IndentNo,
                g.IndentDate,
                i.ItemName as Material,
                j.ItemSpecificationName as Specification,
                k.JobTypeName as ServiceType,
                mu.MeasuringUnitName as PrimaryUOM,
                aa.Quantity1 as PrimaryQuantity,
                mc.MeasuringUnitName as SecondaryUOM,
                aa.Quantity2 as SecondaryQuantity,
                aa.Rate,
                aa.Amount,
                aa.TotalAmount,
                a.CashPurChaseAmount,
                sl.StorageLocationName,
                a.Narration,
                rc.ReverseChargeNo,
                a.Creator,
                lo.LocationName,
                co.CompanyName
                From CashPurchase a, CashPurchaseDetail aa,Doctype b, Party c, Party d, FooterNature e, MoneyTransferMode f, Indent g,
                Item i, ItemSpecification j, Jobtype k, Location lo, Company co, ReverseCharge rc, StorageLocation sl, MeasuringUnit mu, MeasuringUnit mc 
                Where a.Tno = aa.Tno(+)
                and a.DoctypeCode = b.DoctypeCode(+)
                and a.CreditAccountCode = c.PartyCode(+)
                and a.DebitAccountCode = d.PartyCode(+)
                and a.footerNatureCode = e.FooterNatureCode(+)
                and a.MoneyTransferModeCode = f.MoneyTransferModeCode(+)
                and aa.IndentTno = g.Tno(+)
                and aa.ItemCode = i.ItemCode(+)
                and aa.itemSpecificationCode = j.ItemSpecificationCode(+)
                and aa.JObTYpeCode = k.JobTypeCode(+)
                and a.LocationCode = lo.LOcationCode(+)
                and a.CompanyCode = co.CompanyCode(+)
                and a.Tno = rc.ModuleTno(+)
                and aa.StorageLocationCode = sl.StorageLocationCode(+)
                and aa.RateMeasuringUnitCode = mu.MeasuringUnitCode(+)
                and aa.RateMeasuringUnitCode = mc.MeasuringUnitCode(+)
                
                -- 22-APR-2025
                and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                and a.CashPurchaseDate between :P289_FROMDATE and :P289_TODATE 
                and (:P289_COMPANY is Null Or Instr (':' || :P289_COMPANY || ':' , ':' ||co.CompanyCode|| ':') > 0)
                and (:P289_LOCATION is Null Or Instr (':' || :P289_LOCATION || ':' , ':' ||lo.LocationCode|| ':') > 0)
                and (:P289_DOCTYPE is Null Or Instr (':' || :P289_DOCTYPE || ':' , ':' ||b.DoctypeCode|| ':') > 0)
                and (:P289_DEBIT is Null Or Instr (':' || :P289_DEBIT || ':' , ':' ||d.PartyCode|| ':') > 0)
                and (:P289_CREDIT is Null Or Instr (':' || :P289_CREDIT || ':' , ':' ||c.PartyCode|| ':') > 0)
                and (:P289_INDENT is Null Or Instr (':' || :P289_INDENT || ':' , ':' ||g.Tno|| ':') > 0)
                and (:P289_MATERIAL is Null Or Instr (':' || :P289_MATERIAL || ':' , ':' ||i.ItemCode|| ':') > 0)
                and (:P289_SERVICETYPE is Null Or Instr (':' || :P289_SERVICETYPE || ':' , ':' ||k.JobTypeCode|| ':') > 0)
                and (:P289_STORAGELOCATION is Null Or Instr (':' || :P289_STORAGELOCATION || ':' , ':' ||sl.StorageLocationCode|| ':') > 0)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 16609118967757727
        }

