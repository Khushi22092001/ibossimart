            )

            aggregate (
                column: AMOUNT
            )

        )

    )

    pageItem P389_COMPANYCODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P389_EQUIPMENTID (
        type: hidden
        layout {
            sequence: 50
