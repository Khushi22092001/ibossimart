            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No
                alignment: center
            }
            layout {
                sequence: 210
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: X
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
