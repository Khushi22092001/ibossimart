            }
            advanced {
                endUserAlias: AB
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Open Billed Detail
        }

        savedReport 1102245 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn AMOUNT (
                sequence: 5
