page 389 (
    name: Payloader Toll Detail
    alias: PAYLOADER-TOLL-DETAIL
    title: Payloader Toll Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-toll-detail (
        name: Payloader Toll Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by a.freightAdvanceDate) SerialNo,
                   a.CompanyCode,
                   a.EquipmentTno,
                   a.FreightAdvanceNo as ModuleNo,
                   a.FreightAdvanceDate as ModuleDate,
                   b.Amount,
                   c.EquipmentID,
                   d.ModuleName,
                   lo.LocationName
                From FreightAdvance a, FATollTaxSlipIssue b, Equipment c, Module d,DocumentStatusDetail dsd, Location lo
                Where a.Tno = b.Tno
                   and a.EquipmentTno = c.Tno
                   and d.ModuleCode = 'FREIGHTADVANCE'
                   and a.Tno = dsd.ModuleTno
                   and a.LocationCode = lo.LocationCode
                   and dsd.DocumentStatusCode = 'ACTIVE'
                   and a.EquipmentTno is not null
                   and c.EquipmentGroupCode = 'PL'
                   and a.VehicleGroupCode = 'SELF'
                   and (:P389_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                   and a.FreightAdvanceDate between :P389_FROMDATE and :P389_TODATE
                   and (:P389_COMPANYCODE is Null Or Instr (':' || :P389_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                   and (:P389_EQUIPMENTID is Null Or Instr (':' || :P389_EQUIPMENTID || ':' , ':' || a.EquipmentTno || ':') > 0)
                
                ```
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 1001810478893672249
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EQUIPMENTID (
            type: plainText
            heading {
                heading: Equipment  ID
                alignment: center
            }
            layout {
                sequence: 200
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column EQUIPMENTTNO (
            type: plainText
            heading {
                heading: Equipmenttno
                alignment: center
            }
            layout {
                sequence: 190
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location Name
                alignment: center
