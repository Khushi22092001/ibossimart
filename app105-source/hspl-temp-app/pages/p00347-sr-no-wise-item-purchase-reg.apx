page 347 (
    name: Sr No wise Item Purchase Register
    alias: SR-NO-WISE-ITEM-PURCHASE-REG
    title: Sr. No. wise Item Purchase Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Rownum,
                      i.Tno,
                      a.GRNDate,
                      b.ItemCode,
                      a.CompanyCode,
                      a.RefDocNo,
                      a.RefDocDate,
                      e.PartyName,
                      f.ItemName,
                      g.ItemSpecificationName,
                      ROUND(b.Amount/aa.Qty,2) as Price,
                      c.CompanySerialNo,
                      j.IssueNo,
                      j.IssueDate,
                      j.CostCentreName,
                      k.InterUnitTransferNo,
                      k.InterUnitTransferDate,
                      k.LocationName,
                      lo.LocationName as GRNLocation,
                      c.WarrantyUptoDate
                From GRN a, GRNDetail b,GRNSerialNo c, Party e, Item f, ItemSpecification g, Location lo,
                Inspection h,Stock i,
                (
                Select
                a.Tno,
                count(a.Tno) as Qty
                From GRNSerialNo a
                group by a.tno
                )aa,
                (
                Select
                a.StockTno,
                c.IssueNo,
                c.IssueDate,
                e.CostCentreName,
                g.ComponentSerialNo
                From IssueStockStorageDetail a,IssueDetail b, Issue c, IssueCostCentreDetail d, CostCentre e, 
                ISSUEDETAILSERIALNO f, ComponentStock g
                Where a.Tno = b.Tno
                and a.Sno = b.Sno
                and b.Tno = c.Tno
                and b.Tno = d.Tno
                and b.Sno = d.Sno
                and d.CostCentreCode = e.CostCentreCode
                and b.Tno = f.Tno
                and b.Sno = f.Sno
                and f.ComponentStockTNo = g.TNo
                ) j,
                (
                Select
                a.StockTno,
                e.InterUnitTransferNo,
                e.InterUnitTransferDate,
                f.LocationName,
                h.ComponentSerialNo
                From CCInvoiceStockStorageDetail a,CCInvoiceDetail c, CCInvoice d, InterUnitTransfer e, Location f,
                CCINVOICEDETAILSERIALNO g,  ComponentStock h
                Where a.Tno = c.Tno
                and a.Sno = c.Sno
                and c.Tno = d.Tno
                and d.InterUnitTransferTno = e.Tno
                and e.LocationCode = f.LocationCode
                and c.Tno = g.Tno
                and c.Sno = g.Sno
                and g.ComponentStockTNo = h.TNo
                and d.DoctypeCode = 'INTERUNITTRANSFER'
                )k
                Where a.Tno = b.Tno
                and b.Tno = c.Tno
                and b.Sno = c.Sno
                and a.PartyCode = e.PartyCode
                and b.ItemCode = f.ItemCode
                and b.ItemSpecificationCode = g.ItemSpecificationCode
                and a.LOcationCode = lo.LocationCode
                and a.Tno = h.GRNTno
                and h.Tno = i.StockModuleTno
                and b.ItemCode = i.ItemCode
                and b.ItemSpecificationCode = i.ItemSpecificationCode
                and a.Tno = aa.Tno
                and i.Tno = j.StockTno(+)
                and c.CompanySerialNo = j.ComponentSerialNo(+)
                and i.Tno = k.StockTno(+)
                and c.CompanySerialNo = k.ComponentSerialNo(+)
                and f.SerialNoRequired = 'YES'
                --and i.tno = 1228853185;
                and a.GRNDate between :P347_FROMDATE and :P347_TODATE
                and ( :P347_COMPANY IS NULL OR instr(':'||:P347_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                and ( :P347_ITEM IS NULL OR instr(':'||:P347_ITEM||':',':'||b.ItemCode||':') > 0 ) 
                and :P347_FROMDATE is not null
                  -- 22-APR-2025
                and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                
                
                
                
                
                
                
                
                
                
                
                /*Select
                i.Tno,
                a.GRNDate,
                b.ItemCode,
                a.CompanyCode,
                a.RefDocNo,
                a.RefDocDate,
                e.PartyName,
                f.ItemName,
                g.ItemSpecificationName,
                b.Amount/aa.Qty as Price,
                c.CompanySerialNo,
                j.IssueNo,
                j.IssueDate,
                j.CostCentreName,
                k.InterUnitTransferNo,
                k.InterUnitTransferDate,
                k.LocationName
                From GRN a, GRNDetail b,GRNSerialNo c, Party e, Item f, ItemSpecification g,
                Inspection h,Stock i,
                (
                Select
                a.Tno,
                count(a.Tno) as Qty
                From GRNSerialNo a
                --Where a.tno = '1222684204'
                group by a.tno
                )aa,
                (
                Select
                a.StockTno,
                c.IssueNo,
                c.IssueDate,
                e.CostCentreName
                From IssueStockStorageDetail a,IssueDetail b, Issue c, IssueCostCentreDetail d, CostCentre e
                Where a.Tno = b.Tno(+)
                and a.Sno = b.Sno(+)
                and b.Tno = c.Tno(+)
                and b.Tno = d.Tno(+)
                and b.Sno = d.Sno(+)
                and d.CostCentreCode = e.CostCentreCode(+))j,
                (
                Select
                a.StockTno,
                e.InterUnitTransferNo,
                e.InterUnitTransferDate,
                f.LocationName
                From CCInvoiceStockStorageDetail a,CCInvoiceDetail c, CCInvoice d, InterUnitTransfer e, Location f
                Where a.Tno = c.Tno
                and a.Sno = c.Sno
                and c.Tno = d.Tno
                and d.InterUnitTransferTno = e.Tno
                and e.LocationCode = f.LocationCode
                and d.DoctypeCode = 'INTERUNITTRANSFER'
                --and d.ccinvoiceno = 'T/DOB/2023/00138';
                )k
                Where a.Tno = b.Tno
                and b.Tno = c.Tno
                and b.Sno = c.Sno
                and a.PartyCode = e.PartyCode
                and b.ItemCode = f.ItemCode
                and b.ItemSpecificationCode = g.ItemSpecificationCode
                and a.Tno = h.GRNTno
                and h.Tno = i.StockModuleTno
                and b.ItemCode = i.ItemCode
                and b.ItemSpecificationCode = i.ItemSpecificationCode
                and a.Tno = aa.Tno
                and i.Tno = j.StockTno
                and i.Tno = k.StockTno(+)
                and f.SerialNoRequired = 'YES'
                --and a.refdocno = '9643902565';
                and a.GRNDate between :P347_FROMDATE and :P347_TODATE
                and ( :P347_COMPANY IS NULL OR instr(':'||:P347_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                and ( :P347_ITEM IS NULL OR instr(':'||:P347_ITEM||':',':'||b.ItemCode||':') > 0 ) 
                and :P347_FROMDATE is not null
                
                
                
                  */
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                  /*Select
                a.Tno,
                a.RefDocNo,
                a.RefDocDate,
                e.PartyName,
                f.ItemName,
                g.ItemSpecificationName,
                d.Amount,
                b.SerialNo,
                j.IssueNo,
                j.IssueDate
                From GRN a, GRNDetail b,PurchaseOrder c, PurchaseOrderDetail d, Party e, Item f, ItemSpecification g,
                (
                Select
                h.GRNTno,
                c.IssueNo,
                c.IssueDate
                From Inspection h, Stock i,IssueStockStorageDetail a,IssueDetail b, Issue c
                Where h.Tno = i.StockModuleTno
                and i.Tno = a.Stocktno
                and a.Tno = b.Tno
                and b.Tno = c.Tno)j
                Where a.Tno = b.Tno
                and a.PurchaseOrderTno = c.Tno
                and c.Tno = d.Tno
                and b.ItemCode = d.ItemCode
                and b.ItemSpecificationCode = d.ItemSpecificationCode
                and a.PartyCode = e.PartyCode
                and d.ItemCode = f.ItemCode
                and d.ItemSpecificationCode = g.ItemSpecificationCode
                and a.Tno = j.GRNTno(+)
                and a.PurchaseOrderTno is not null
                and b.SerialNo is not Null
                and a.GRNDate between :P347_FROMDATE and :P347_TODATE
                and ( :P347_COMPANY IS NULL OR instr(':'||:P347_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                and ( :P347_ITEM IS NULL OR instr(':'||:P347_ITEM||':',':'||d.ItemCode||':') > 0 ) 
                and :P347_FROMDATE is not null;*/
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
