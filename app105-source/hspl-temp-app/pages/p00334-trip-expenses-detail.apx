page 334 (
    name: Trip Expenses Detail
    alias: TRIP-EXPENSES-DETAIL
    title: Trip Expenses Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #ted .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region trip-expenses-detail (
        name: Trip Expenses Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Select
                      Rownum as SerialNo,
                		a.CompanyCode,
                      a.FreightAdvanceNo as SiteExpenseNo,
                	   a.FreightAdvanceDate as SiteExpenseDate,
                		a.VehicleNo,
                		a.Amount
                	From FreightAdvance a, DocumentStatusDetail dsd
                	Where a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.DrAccountCode = 'TRIPEXPENSES'
                		and nvl(a.Amount, 0) > 0
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                		and exists(
                		Select
                			aa.Tno
                		From CompanyVehicle aa, Equipment bb
                		Where aa.ModuleTno = bb.Tno
                			and bb.EquipmentGroupCode = 'CT'
                			and aa.CompanyVehicleNo = a.VehicleNo
                		)
                      and a.FreightAdvanceDate between :P334_FROMDATE and :P334_TODATE
                	   and a.CompanyCode = :P334_COMPANYCODE
                       and a.VehicleNo like nvl(:P334_VEHICLENO, '%')
                	UNION ALL
                	Select
                      Rownum as SerialNo,
                		a.CompanyCode,
                      a.FreightAdvanceNo as SiteExpenseNo,
                	   a.FreightAdvanceDate as SiteExpenseDate,
                		a.VehicleNo,
                		a.Amount2 as Amount
                	From FreightAdvance a, DocumentStatusDetail dsd
                	Where a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.DrAccountCode2 = 'TRIPEXPENSES'
                		and nvl(a.Amount2, 0) > 0
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                		and exists(
                		Select
                			aa.Tno
                		From CompanyVehicle aa, Equipment bb
                		Where aa.ModuleTno = bb.Tno
                			and bb.EquipmentGroupCode = 'CT'
                			and aa.CompanyVehicleNo = a.VehicleNo
                		)
                      and a.FreightAdvanceDate between :P334_FROMDATE and :P334_TODATE
                	     and a.CompanyCode = :P334_COMPANYCODE
                         and a.VehicleNo like nvl(:P334_VEHICLENO, '%')
                  */
                
                  Select
                  row_number() over(order by a.ModuleDate) SerialNo,
                	a.ModuleName,
                	a.ModuleNo,
                	a.ModuleDate,
                	a.VehicleNo,
                  b.VehicleTypeName,
                  c.TransportAreaName,
                	a.Amount
                From VehicleExpenseTable a, VehicleType b, TransportArea c
                Where a.VehicleTypeCode = b.VehicleTypeCode(+)
                    and a.TransportAreaCode = c.TransportAreaCode(+)
                    and a.ModuleDate between :P334_FROMDATE and :P334_TODATE
                		and a.VehicleNo like nvl(:P334_VEHICLENO, '%')
                		and a.CompanyCode = :P334_COMPANYCODE
                    and a.Creator = :APP_USER
                    and a.Categories = 'TRIP'
                    and (:P334_VEHICLENO2 is null
                       or exists(
                         Select
                            aa.VehicleNo
                          From VPVehicleNo aa
                          Where aa.VehicleNo = a.VehicleNo
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P334_VEHICLETYPE is null
                       or exists(
                         Select
                            aa.VehicleTypeCode
                          From VPVehicleType aa
                          Where aa.VehicleTypeCode = a.VehicleTypeCode
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P334_TRANSPORTAREA is null
                       or exists(
                         Select
                            aa.TransportAreaCode
                          From VPTransportArea aa
                          Where aa.TransportAreaCode = a.TransportAreaCode
                              and aa.Creator = :APP_USER
                       )
                   )
                
                ```
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: ted
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 303161143197914306
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Trip Expense Amount
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column MODULEDATE (
            type: plainText
            heading {
                heading: Module Date
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Y
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: Module
                alignment: center
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: W
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No.
                alignment: center
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: X
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: V
            }
        )

        column TRANSPORTAREANAME (
            type: plainText
            heading {
                heading: Transport Area
                alignment: center
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AA
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: Vehicle No
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column VEHICLETYPENAME (
            type: plainText
            heading {
                heading: Vehicle Type
                alignment: center
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Trip Expenses Detail
        }

        savedReport 505176 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn AMOUNT (
                sequence: 8
            )

            displayColumn MODULEDATE (
                sequence: 4
            )

            displayColumn MODULENAME (
                sequence: 2
            )

            displayColumn MODULENO (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TRANSPORTAREANAME (
                sequence: 7
            )

            displayColumn VEHICLENO (
                sequence: 5
            )

            displayColumn VEHICLETYPENAME (
                sequence: 6
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                function: count
                column: NECESSITYSLIPDATE
            )

            aggregate (
                function: count
                column: ISSUEDATE
            )

            aggregate (
                function: count
                column: SITEEXPENSEDATE
            )

            controlBreak (
                column: TRANSPORTAREANAME
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P334_COMPANYCODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P334_FROMDATE (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P334_TODATE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P334_TRANSPORTAREA (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P334_VEHICLENO (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P334_VEHICLENO2 (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P334_VEHICLETYPE (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

