    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                :P317_ASONDATE as AsOnDate,
                x.SOURCELOCATIONNAME,
                x.DESTINATIONLOCATIONNAME,
                x.PARTYDONO,
                x.PARTYDODATE,
                x.DUEDATE,
                x.DOQUANTITY,
                x.NOOFTRIPTODAY,
                x.TODAYSLIFTED,
                x.LIFTEDTILLDATE,
                NVL(x.DOQUANTITY, 0) - NVL(x.LIFTEDTILLDATE, 0) - NVL(x.LAPSEDQTY, 0) as BALANCEQTY,
                ROUND(((NVL(x.DOQUANTITY, 0) - NVL(x.LIFTEDTILLDATE, 0) - NVL(x.LAPSEDQTY, 0)) / NVL(x.BALANCEDAYS, 1)),3) as ASKINGRATE,
                x.BALANCEDAYS,
                x.PARTYNAME,
                CASE WHEN x.DOQUANTITY = NVL(x.DOQUANTITY, 0) - NVL(x.LIFTEDTILLDATE, 0) - NVL(x.LAPSEDQTY, 0) THEN 'NO'
                ELSE 'YES'
                END AS DOSTARTED,
                'INTERNALTRANSFER' as DATAPROCESS,
                CASE WHEN x.DOQUANTITY = x.LIFTEDTILLDATE THEN 'GREEN'
                     WHEN x.DUEDATE < :P317_ASONDATE and x.DOQUANTITY > x.LIFTEDTILLDATE THEN 'RED'
                ELSE NULL
                END AS DOSTATUS
                FROM 
                (SELECT
                    DO.COMPANYCODE,
                    DO.TNO,
                    DO.DELIVERYORDERDATE,
                    DO.FROMDATE,
                    DO.TODATE,
                    DO.DOCTYPECODE,
                    DOD.SOURCELOCATIONTNO,
                    DOD.DESTINATIONLOCATIONTNO,
                    SL.SOURCELOCATIONNAME,
                    DL.DESTINATIONLOCATIONNAME,
                    DO.PARTYDONO,
                    DO.PARTYDODATE,
                    DO.TODATE     AS DUEDATE,
                    DOD.ITEMCODE,
                    DOD.QUANTITY1 AS DOQUANTITY,
                    (SELECT
                            COUNT(AA.INTERNALTRANSFERNO) 
                        FROM
                            INTERNALTRANSFER AA
                        WHERE 1 = 1
                            AND AA.DELIVERYORDERTNO = DOD.TNO
                            AND AA.SOURCELOCATIONTNO = DOD.SOURCELOCATIONTNO
                            AND AA.DESTINATIONLOCATIONTNO = DOD.DESTINATIONLOCATIONTNO
                            AND AA.INTERNALTRANSFERDATE = :P317_ASONDATE
                            )AS NOOFTRIPTODAY,
                    (SELECT
                            NVL(SUM(AA.LOADINGQUANTITY1),0)
                        FROM
                            INTERNALTRANSFER AA
                        WHERE 1 = 1
                            AND AA.DELIVERYORDERTNO = DOD.TNO
                            AND AA.SOURCELOCATIONTNO = DOD.SOURCELOCATIONTNO
                            AND AA.DESTINATIONLOCATIONTNO = DOD.DESTINATIONLOCATIONTNO
                            AND AA.INTERNALTRANSFERDATE = :P317_ASONDATE
                            )AS TODAYSLIFTED,
                    (SELECT
                            NVL(SUM(AA.LOADINGQUANTITY1),0)
                        FROM
                            INTERNALTRANSFER AA, DELIVERYORDER A
                        WHERE 1 = 1
                            AND AA.DELIVERYORDERTNO = DOD.TNO
                            AND AA.DELIVERYORDERTNO = A.TNO
                            AND A.TNO = DOD.TNO
                            AND AA.SOURCELOCATIONTNO = DOD.SOURCELOCATIONTNO
                            AND AA.DESTINATIONLOCATIONTNO = DOD.DESTINATIONLOCATIONTNO
                            AND AA.INTERNALTRANSFERDATE BETWEEN A.FROMDATE AND :P317_ASONDATE
                            )AS LIFTEDTILLDATE,
                    CASE
                        WHEN DO.TODATE < TO_DATE(:P317_ASONDATE, 'DD-MM-YYYY') THEN DOD.QUANTITY1 - 
                        (SELECT
                            NVL(SUM(AA.LOADINGQUANTITY1),0)
                        FROM
                            INTERNALTRANSFER AA, DELIVERYORDER A
                        WHERE 1 = 1
                            AND AA.DELIVERYORDERTNO = DOD.TNO
                            AND AA.DELIVERYORDERTNO = A.TNO
                            AND A.TNO = DOD.TNO
                            AND AA.SOURCELOCATIONTNO = DOD.SOURCELOCATIONTNO
                            AND AA.DESTINATIONLOCATIONTNO = DOD.DESTINATIONLOCATIONTNO
                            AND AA.INTERNALTRANSFERDATE BETWEEN A.FROMDATE AND :P317_ASONDATE
                            )
                        ELSE NULL
                    END AS LAPSEDQTY,
                    CASE
                        WHEN DO.TODATE > TO_DATE(:P317_ASONDATE, 'DD-MM-YYYY') THEN DO.TODATE - TO_DATE(:P317_ASONDATE, 'DD-MM-YYYY')
                        ELSE NULL
                    END AS BALANCEDAYS,
                    PA.PARTYNAME
                            
                FROM
                    DELIVERYORDER       DO,
                    DELIVERYORDERDETAIL DOD,
                    SOURCELOCATION      SL,
                    DESTINATIONLOCATION DL,
                    PARTY PA
                WHERE
                        1 = 1
                    AND DO.TNO = DOD.TNO
                    AND DOD.SOURCELOCATIONTNO = SL.TNO
                    AND DOD.DESTINATIONLOCATIONTNO = DL.TNO
                    AND DO.PARTYCODE = PA.PARTYCODE
                    AND DO.doctypecode = 'INTERNALTRANSFER'
                )X
                Where 1=1
                    AND instr(':'||:P317_COMPANY||':',':'||x.CompanyCode||':') > 0
                    AND ( :P317_DOCTYPE IS NULL OR instr(':'||:P317_DOCTYPE||':',':'||x.DocTypeCode||':') > 0 )
                    AND ( :P317_SOURCE IS NULL OR instr(':'||:P317_SOURCE||':',':'||x.SourceLocationTNo||':') > 0 )
                    AND ( :P317_DESTINATION IS NULL OR instr(':'||:P317_DESTINATION||':',':'||x.DestinationLocationTNo||':') > 0 )
                    AND ( :P317_PARTYDO IS NULL OR instr(':'||:P317_PARTYDO||':',':'||x.TNO||':') > 0 )
                    AND ( ( NVL(X.DOQUANTITY, 0) - NVL(X.LIFTEDTILLDATE, 0) - NVL(X.LAPSEDQTY, 0) > 0 AND :P317_BALANCEQTY = 'Only Balance Quantity' )
                              OR ( NVL(X.DOQUANTITY, 0) - NVL(X.LIFTEDTILLDATE, 0) - NVL(X.LAPSEDQTY, 0) = 0 AND :P317_BALANCEQTY = 'Zero Balance Quantity' )
                              OR :P317_BALANCEQTY IS NULL )
                    AND ( ( NVL(X.NOOFTRIPTODAY, 0) > 0 AND :P317_TRIP = 'Only Trip' )
                              OR ( NVL(X.NOOFTRIPTODAY, 0) = 0 AND :P317_TRIP = 'Zero Trip' )
                              OR :P317_TRIP IS NULL )
                    AND :P317_ASONDATE BETWEEN X.FROMDATE AND X.TODATE
                
                Union All
                
                SELECT
                :P317_ASONDATE as AsonDate,
                x.SOURCELOCATIONNAME,
                x.DESTINATIONLOCATIONNAME,
                x.PARTYDONO,
                x.PARTYDODATE,
                x.DUEDATE,
                x.DOQUANTITY,
                x.NOOFTRIPTODAY,
                x.TODAYSLIFTED,
                x.LIFTEDTILLDATE,
                NVL(x.DOQUANTITY, 0) - NVL(x.LIFTEDTILLDATE, 0) - NVL(x.LAPSEDQTY, 0) as BALANCEQTY,
                ROUND(((NVL(x.DOQUANTITY, 0) - NVL(x.LIFTEDTILLDATE, 0) - NVL(x.LAPSEDQTY, 0)) / NVL(x.BALANCEDAYS, 1)),3) as ASKINGRATE,
                x.BALANCEDAYS,
                x.PARTYNAME,
                CASE WHEN x.DOQUANTITY = NVL(x.DOQUANTITY, 0) - NVL(x.LIFTEDTILLDATE, 0) - NVL(x.LAPSEDQTY, 0) THEN 'NO'
                ELSE 'YES'
                END AS DOSTARTED,
                'LR' as DATAPROCESS,
                CASE WHEN x.DOQUANTITY = x.LIFTEDTILLDATE THEN 'GREEN'
                     WHEN x.DUEDATE < :P317_ASONDATE and x.DOQUANTITY > x.LIFTEDTILLDATE THEN 'RED'
                ELSE NULL
                END AS DOSTATUS
                FROM 
                (SELECT
                    DO.COMPANYCODE,
                    DO.TNO,
                    DO.DELIVERYORDERDATE,
                    DO.FROMDATE,
                    DO.TODATE,
                    DO.DOCTYPECODE,
                    DOD.SOURCELOCATIONTNO,
                    DOD.DESTINATIONLOCATIONTNO,
                    SL.SOURCELOCATIONNAME,
                    DL.DESTINATIONLOCATIONNAME,
                    DO.PARTYDONO,
                    DO.PARTYDODATE,
                    DO.TODATE     AS DUEDATE,
                    DOD.ITEMCODE,
                    DOD.QUANTITY1 AS DOQUANTITY,
                    (SELECT
                            COUNT(AA.LRNO) 
                        FROM
                            LR AA
                        WHERE 1 = 1
                            AND AA.DELIVERYORDERTNO = DOD.TNO
                            AND AA.SOURCELOCATIONTNO = DOD.SOURCELOCATIONTNO
                            AND AA.DESTINATIONLOCATIONTNO = DOD.DESTINATIONLOCATIONTNO
                            AND AA.LRDATE = :P317_ASONDATE
                            )AS NOOFTRIPTODAY,
                    (SELECT
                            NVL(SUM(AA.QUANTITY1),0)
                        FROM
                            LR AA
                        WHERE 1 = 1
                            AND AA.DELIVERYORDERTNO = DOD.TNO
                            AND AA.SOURCELOCATIONTNO = DOD.SOURCELOCATIONTNO
                            AND AA.DESTINATIONLOCATIONTNO = DOD.DESTINATIONLOCATIONTNO
                            AND AA.LRDATE = :P317_ASONDATE
                            )AS TODAYSLIFTED,
                    (SELECT
                            NVL(SUM(AA.QUANTITY1),0)
                        FROM
                            LR AA, DELIVERYORDER A
                        WHERE 1 = 1
                            AND AA.DELIVERYORDERTNO = DOD.TNO
                            AND AA.DELIVERYORDERTNO = A.TNO
                            AND A.TNO = DOD.TNO
                            AND AA.SOURCELOCATIONTNO = DOD.SOURCELOCATIONTNO
                            AND AA.DESTINATIONLOCATIONTNO = DOD.DESTINATIONLOCATIONTNO
                            AND AA.LRDATE BETWEEN A.FROMDATE AND :P317_ASONDATE
                            )AS LIFTEDTILLDATE,
                    CASE
                        WHEN DO.TODATE < TO_DATE(:P317_ASONDATE, 'DD-MM-YYYY') THEN DOD.QUANTITY1 - 
                        (SELECT
                            NVL(SUM(AA.QUANTITY1),0)
                        FROM
                            LR AA, DELIVERYORDER A
                        WHERE 1 = 1
                            AND AA.DELIVERYORDERTNO = DOD.TNO
                            AND AA.DELIVERYORDERTNO = A.TNO
                            AND A.TNO = DOD.TNO
                            AND AA.SOURCELOCATIONTNO = DOD.SOURCELOCATIONTNO
                            AND AA.DESTINATIONLOCATIONTNO = DOD.DESTINATIONLOCATIONTNO
                            AND AA.LRDATE BETWEEN A.FROMDATE AND :P317_ASONDATE
                            )
                        ELSE NULL
                    END AS LAPSEDQTY,
                    CASE
                        WHEN DO.TODATE > TO_DATE(:P317_ASONDATE, 'DD-MM-YYYY') THEN DO.TODATE - TO_DATE(:P317_ASONDATE, 'DD-MM-YYYY')
                        ELSE NULL
                    END AS BALANCEDAYS,
                    PA.PARTYNAME
                            
                FROM
                    DELIVERYORDER       DO,
                    DELIVERYORDERDETAIL DOD,
                    SOURCELOCATION      SL,
                    DESTINATIONLOCATION DL, 
                    PARTY PA
                WHERE
                        1 = 1
                    AND DO.TNO = DOD.TNO
                    AND DOD.SOURCELOCATIONTNO = SL.TNO
                    AND DOD.DESTINATIONLOCATIONTNO = DL.TNO
                    AND DO.PARTYCODE = PA.PARTYCODE
                    AND DO.doctypecode != 'INTERNALTRANSFER'
                )X
                Where 1=1
                    AND instr(':'||:P317_COMPANY||':',':'||x.CompanyCode||':') > 0
                    AND ( :P317_DOCTYPE IS NULL OR instr(':'||:P317_DOCTYPE||':',':'||x.DocTypeCode||':') > 0 )
                    AND ( :P317_SOURCE IS NULL OR instr(':'||:P317_SOURCE||':',':'||x.SourceLocationTNo||':') > 0 )
                    AND ( :P317_DESTINATION IS NULL OR instr(':'||:P317_DESTINATION||':',':'||x.DestinationLocationTNo||':') > 0 )
                    AND ( :P317_PARTYDO IS NULL OR instr(':'||:P317_PARTYDO||':',':'||x.TNO||':') > 0 )
                    AND ( ( NVL(X.DOQUANTITY, 0) - NVL(X.LIFTEDTILLDATE, 0) - NVL(X.LAPSEDQTY, 0) > 0 AND :P317_BALANCEQTY = 'Only Balance Quantity' )
                              OR ( NVL(X.DOQUANTITY, 0) - NVL(X.LIFTEDTILLDATE, 0) - NVL(X.LAPSEDQTY, 0) = 0 AND :P317_BALANCEQTY = 'Zero Balance Quantity' )
                              OR :P317_BALANCEQTY IS NULL )
                    AND ( ( NVL(X.NOOFTRIPTODAY, 0) > 0 AND :P317_TRIP = 'Only Trip' )
                              OR ( NVL(X.NOOFTRIPTODAY, 0) = 0 AND :P317_TRIP = 'Zero Trip' )
                              OR :P317_TRIP IS NULL )
                    AND :P317_ASONDATE BETWEEN X.FROMDATE AND X.TODATE
                ;
                ```
        }
