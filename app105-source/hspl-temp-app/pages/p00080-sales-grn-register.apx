    region sales-grn-register-report (
        name: Sales GRN Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     xxx.TNo,
                     xxx.CompanyCode,
                     xxx.LocationCode,
                     xxx.DocTypeCode,
                     xxx.SalesGRNDate,
                     xxx.SalesGRNNo,
                     xxx.PartyName,
                     xxx.CCInvoiceNo,
                     xxx.CCInvoiceDate,
                     xxx.MarineInsuranceNo,
                     xxx.MarineInsuranceAmount,
                     xxx.ItemCode,
                     xxx.ItemName,
                     xxx.ItemSpecificationName,
                     xxx.ItemDetail,
                     xxx.UOM1,
                     xxx.Quantity1,
                     xxx.UOM2,
                     xxx.Quantity2,
                     xxx.packingTypeCode,
                     xxx.PackingNos,
                     xxx.CCInvoiceQuantity1,
                     xxx.CCInvoiceQuantity2,
                     xxx.DiscrepancyTypeCode,
                     xxx.DiscrepancyQuantity1,
                     xxx.DiscrepancyQuantity2,
                     xxx.DiscrepancyAmount,
                     xxx.Rate,
                     xxx.ratemeasuringunitcode,
                     xxx.Amount,
                     xxx.CGST,
                     xxx.SGST,
                     xxx.IGST,
                     xxx.TCS,
                     (xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS)) as OtherAmount,
                     xxx.FooterAmount,
                     xxx.TotalAmount
                From (
                Select 
                     xx.TNo,
                     xx.CompanyCode,
                     xx.LocationCode,
                     xx.DocTypeCode,
                     xx.SalesGRNDate,
                     xx.SalesGRNNo,
                     xx.PartyName,
                     xx.CCInvoiceNo,
                     xx.CCInvoiceDate,
                     xx.MarineInsuranceNo,
                     xx.MarineInsuranceAmount,
                     xx.ItemCode,
                     xx.ItemName,
                     xx.ItemSpecificationName,
                     xx.ItemDetail,
                     xx.UOM1,
                     xx.Quantity1,
                     xx.UOM2,
                     xx.Quantity2,
                     xx.packingTypeCode,
                     xx.PackingNos,
                     xx.CCInvoiceQuantity1,
                     xx.CCInvoiceQuantity2,
                     xx.DiscrepancyTypeCode,
                     xx.DiscrepancyQuantity1,
                     xx.DiscrepancyQuantity2,
                     xx.DiscrepancyAmount,
                     xx.Rate,
                     xx.ratemeasuringunitcode,
                     xx.Amount,
                     sum(xx.CGST)CGST,
                     sum(xx.SGST)SGST,
                     sum(xx.IGST)IGST,
                     sum(xx.TCS)TCS,
                     xx.FooterAmount,
                     xx.TotalAmount
                From
                (Select
                     a.TNo,
                     a.CompanyCode,
                     a.LocationCode,
                     a.DocTypeCode,
                     a.SalesGRNDate,
                     a.SalesGRNNo,
                     p.PartyName,
                     ci.CCInvoiceNo,
                     ci.CCInvoiceDate,
                     mi.MarineInsuranceNo,
                     a.MarineInsuranceAmount,
                     e.ItemCode,
                     e.ItemName,
                     ee.ItemSpecificationName,
                     e.ItemName||' ~ '||ee.ItemSpecificationName as ItemDetail,
                     e.MeasuringUnitCode1 as UOM1,
                     b.Quantity1,
                     e.MeasuringUnitCode2 as UOM2,
                     b.Quantity2,
                     b.packingTypeCode,
                     b.PackingNos,
                     b.CCInvoiceQuantity1,
                     b.CCInvoiceQuantity2,
                     b.DiscrepancyTypeCode,
                     b.DiscrepancyQuantity1,
                     b.DiscrepancyQuantity2,
                     b.DiscrepancyAmount,
                     b.Rate,
                     b.ratemeasuringunitcode,
                     b.Amount,
                     nvl(Decode(c.FooterHeadCode,'.CGST.',c.FooterValue),0) as CGST,
                     nvl(Decode(c.FooterHeadCode,'.SGST.',c.FooterValue),0) as SGST,
                     nvl(Decode(c.FooterHeadCode,'.IGST.',c.FooterValue),0) as IGST,
                     nvl(Decode(c.FooterHeadCode,'.TCS.',c.FooterValue),0) as TCS,
                     b.FooterAmount,
                     b.TotalAmount
                From SalesGRN a, SalesGRNDetail b, SalesGRNDFooter c, Party p, CCInvoice ci, Item e, ItemSpecification ee, MarineInsurance mi
                Where a.TNo = b.TNo
                  and b.TNo = c.TNo
                  and b.SNo = c.SNo
                  and a.CCInvoiceTNo = ci.TNo
                  and ci.PartyCode = p.PartyCode
                  and b.ItemCode = e.ItemCode
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode
                  and a.MarineInsuranceTNo = mi.TNo(+)
                  and a.SalesGRNDate between :P80_FROMDATE and :P80_TODATE
                  and instr(':'||:P80_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P80_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P80_PARTYNAME IS NULL OR instr(':'||:P80_PARTYNAME||':',':'||p.PartyCode||':') > 0 ) 
                  and ( :P80_ITEM IS NULL OR instr(':'||:P80_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P80_ITEMSPECIFICATION IS NULL OR instr(':'||:P80_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                  )xx
                Group by xx.TNo,
                     xx.CompanyCode,
                     xx.LocationCode,
                     xx.DocTypeCode,
                     xx.SalesGRNDate,
                     xx.SalesGRNNo,
                     xx.PartyName,
                     xx.CCInvoiceNo,
                     xx.CCInvoiceDate,
                     xx.MarineInsuranceNo,
                     xx.MarineInsuranceAmount,
                     xx.ItemCode,
                     xx.ItemName,
                     xx.ItemSpecificationName,
                     xx.ItemDetail,
                     xx.UOM1,
                     xx.Quantity1,
                     xx.UOM2,
                     xx.Quantity2,
                     xx.packingTypeCode,
                     xx.PackingNos,
                     xx.CCInvoiceQuantity1,
                     xx.CCInvoiceQuantity2,
                     xx.DiscrepancyTypeCode,
                     xx.DiscrepancyQuantity1,
                     xx.DiscrepancyQuantity2,
                     xx.DiscrepancyAmount,
                     xx.Rate,
                     xx.ratemeasuringunitcode,
                     xx.Amount,
                     xx.FooterAmount,
                     xx.TotalAmount
                )xxx
                ```
        }
