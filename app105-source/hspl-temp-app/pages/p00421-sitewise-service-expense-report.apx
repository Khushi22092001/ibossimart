        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 276364 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 7
            )

            displayColumn ITEMNAME (
                sequence: 4
            )

            displayColumn JOBTYPENAME (
                sequence: 5
