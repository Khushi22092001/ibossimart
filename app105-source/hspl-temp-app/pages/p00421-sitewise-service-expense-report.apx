page 421 (
    name: Sitewise Service Expense Report
    alias: SITEWISE-SERVICE-EXPENSE-REPORT
    title: Sitewise Service Expense Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                 a.*,
                 row_number() over(order by a.LocationCode) SerialNo
                 From 
                (Select 
                  c.LocationName,
                  a.LocationCode,
                  e.PartyName,
                  a.PartyCode,
                  b.ItemCode,
                  b.JobtypeCode,
                  nvl(b.Quantity,d.Quantity) as Quantity,
                  nvl(b.Amount,d.Amount) as Amount,
                  nvl(f.ItemName,h.ItemName) as ItemName,
                  nvl(g.JobtypeName,i.JobtypeName) as JobtypeName
                  From ExternalServicesEntry a, ExternalSpareEntryDetail b, ExternalServicesEntryDetail d,Location c, Party e, Item f, Jobtype g, 
                  Item h, Jobtype i
                  Where a.Tno = b.Tno(+)  
                  and a.Tno = d.Tno(+)
                  and a.LocationCode = c.LocationCode(+)
                  and a.PartyCode = e.PartyCode(+)
                  and b.ItemCode = f.ItemCode(+)
                  and b.JobtypeCode = g.JobtypeCode(+)
                  and d.ItemCode = h.ItemCode(+)
                  and d.JobtypeCode = i.JobtypeCode(+)
                  and a.ExternalServicesEntryDate between :P421_FROMDATE and :P421_TODATE
                 -- and c.LocationName = 'CORPORATE(KSR)'
                UNION ALL
                Select
                   c.LocationName,
                   a.LocationCode,
                   e.PartyName,
                   d.PartyCode,
                   f.ItemCode,
                   g.JobtypeCode,
                   NVL(b.Quantity1,0) as Quantity,
                   NVL(b.Amount,0) as Amount,
                   f.ItemName,
                   g.JobtypeName
                From JBPass a, JBPassDetail b, Location c, JobBill d,Party e, Item f, Jobtype g
                Where a.Tno = b.Tno(+)
                  and a.LocationCode = c.LocationCode(+)
                  and a.JobBillTno = d.Tno(+)
                  and d.PartyCode = e.PartyCode(+)
                  and b.ItemCode = f.ItemCode(+)
                  and b.JobtypeCode = g.JobtypeCode(+)
                  and a.JBPassDate between :P421_FROMDATE and :P421_TODATE) a
                 --   and c.LocationName = 'CORPORATE(KSR)'
                Where ( :P421_LOCATION IS NULL OR instr(':'||:P421_LOCATION||':',':'||a.LocationCode||':') > 0 ) 
                and ( :P421_PARTY IS NULL OR instr(':'||:P421_PARTY||':',':'||a.PartyCode||':') > 0 ) 
                and ( :P421_JOBTYPE IS NULL OR instr(':'||:P421_JOBTYPE||':',':'||a.JobtypeCode||':') > 0 ) 
                and ( :P421_ITEM IS NULL OR instr(':'||:P421_ITEM||':',':'||a.ItemCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 83199779757124127
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column ITEMCODE (
