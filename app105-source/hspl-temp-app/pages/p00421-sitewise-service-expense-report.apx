            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column PARTYNAME (
            type: plainText
            heading {
                heading: Party Name
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
                alignment: center
