                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column ITEMNAME (
            type: plainText
            heading {
                heading: Item Name
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column JOBTYPECODE (
            type: plainText
            heading {
                heading: Jobtypecode
                alignment: center
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column JOBTYPENAME (
            type: plainText
            heading {
                heading: Jobtype Name
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: Locationcode
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location Name
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column PARTYCODE (
            type: plainText
            heading {
                heading: Partycode
                alignment: center
