                function: count
                column: SERIALNO
            )

        )

    )

    region sitewise-service-expense-report (
        name: Sitewise Service Expense Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P421_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @sitewise-service-expense-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P421_JOBTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Jobtype Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                 a.*
                 From 
                (Select 
                  e.PartyName d,
                  a.PartyCode r
                  From ExternalServicesEntry a, Party e
                  Where a.PartyCode = e.PartyCode(+)
                UNION ALL
                Select
                   e.PartyName d,
                   d.PartyCode r
                From JBPass a, JobBill d,Party e
                Where a.JobBillTno = d.Tno(+)
                  and d.PartyCode = e.PartyCode(+))a
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @sitewise-service-expense-report
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Jobtype Name
        }
    )

    pageItem P421_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                a.*
                 From 
                 (Select 
                  c.LocationName d,
                  c.LocationCode r
                  From ExternalServicesEntry a, Location c
                  Where a.LocationCode = c.LocationCode
                UNION ALL
                Select
                   c.LocationName d,
                   c.LocationCode r
                From JBPass a, Location c
                Where a.LocationCode = c.LocationCode) a
                ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @sitewise-service-expense-report
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Location Name
        }
    )

