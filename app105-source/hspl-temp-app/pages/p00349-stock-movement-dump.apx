page 349 (
    name: Stock Movement Dump
    alias: STOCK-MOVEMENT-DUMP
    title: Stock Movement Dump
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                Rownum,
                f.CompanyName,
                a.DocumentNo,
                a.VoucherNo,
                a.StockDate,
                b.LocationName,
                c.StorageLocationName,
                Round(sum(a.Quantity1),6) as Quantity,
                --a.Rate,
                a.DocumentNature,
                d.ItemName ||'-'|| e.ItemSpecificationName as ItemName,
                round(sum(a.Amount),2) as Amounts,
                A.MODULECODE,
                a.ChargeableDebitNoteNo,
                a.FreightAdviceNo,
                g.ItemMakeName--,
                -- remarked on 25-sep-2024 due to slow 
                --testing(1)
                from StockMovement a, Location b, StorageLocation c, Item d, ItemSpecification e, Company f, ItemMake g
                Where a.LocationCode = b.LocationCode
                and a.StorageLocationCode = c.StorageLocationCode
                and a.ItemCode = d.ItemCode 
                and a.ItemSpecificationCode = e.ItemSpecificationCode
                and a.CompanyCode = f.CompanyCode
                and e.ItemMakeCode = g.ItemMakeCode(+)
                and a.StockDate between :P349_FROMDATE and :P349_TODATE
                and ( :P349_ITEM IS NULL OR instr(':'||:P349_ITEM||':',':'||a.ItemCode||':') > 0 ) 
                and ( :P349_COMPANY IS NULL OR instr(':'||:P349_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                Group by 
                f.Companyname,
                a.DocumentNo,
                a.VoucherNo,
                a.StockDate,
                b.LocationName,
                c.StorageLocationName,
                a.Rate,
                a.DocumentNature,
                d.ItemName,
                e.ItemSpecificationName,
                a.ModuleCode,
                a.ChargeableDebitNoteNo,
                a.FreightAdviceNo,
                Rownum,
                g.ItemMakeName
                ;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(config) {
                    config.defaultGridViewOptions = {
                        //rowHeader: "sequence",
                        pagination: {                                            
                            showRange: true,
                            showPageSelector: true,
                            showPageLinks: false,
                // uncomment to hide the first and last buttons
                //            firstAndLastButtons: false
                        }
                    };
                
                    config.defaultIconViewOptions = {
                        collectionClasses: "t-Cards t-Cards--compact t-Cards--displayIcons u-colors t-Cards--desc-2ln"
                    };
                    return config; // don't forget to return this!
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 56328430643856850
        }

