page 229 (
    name: Transport List
    alias: TRANSPORTER-LIST
    title: Transport List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region transporter-list (
        name: "Transporter List "
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                rOWNUM AS SERIALNO,
                a.TransporterName,
                GetPartyAddress(a.TransporterCode) as Address,
                GetPartyAttributeValue(a.transportercode,'PANNO') as PANNO,
                GetPartyAttributeValue(a.transportercode,'GSTINNO') as GSTIN,
                GetPartyAttributeValue(a.transportercode,'BANKNAME') as BankName,
                GetPartyAttributeValue(a.transportercode,'BANKACCOUNTNO') as AccountNo,
                GetPartyAttributeValue(a.transportercode,'IFSCCODE') as IFSCCode,
                c.TDSMasterName as TDSSchemeName,
                a.Creator
                From Transporter a,  TDSMaster c
                Where GetTDSMasterCode(a.TransporterCode, trunc(sysdate)) = c.TDSMasterCode(+)
                ;
                ```
        }
        layout {
            sequence: 10
            slot: body
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 9849258916369542
        }

        column ACCOUNTNO (
            type: plainText
            heading {
                heading: Account   No
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ADDRESS (
            type: plainText
            heading {
                heading: Address
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column BANKNAME (
            type: plainText
            heading {
                heading: Bank Name
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column GSTIN (
            type: plainText
            heading {
                heading: GSTIN NO
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column IFSCCODE (
            type: plainText
            heading {
                heading: IFSC Code
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column PANNO (
            type: plainText
            heading {
                heading: PAN NO
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column TDSSCHEMENAME (
            type: plainText
            heading {
                heading: Tdsschemename
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column TRANSPORTERNAME (
            type: plainText
            heading {
                heading: Transporter Name
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: "Transporter List "
        }

        savedReport 102236 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTNO (
                sequence: 6
            )

            displayColumn BANKNAME (
                sequence: 5
            )

            displayColumn CREATOR (
                sequence: 8
            )

            displayColumn GSTIN (
                sequence: 4
            )

            displayColumn IFSCCODE (
                sequence: 7
            )

            displayColumn PANNO (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TRANSPORTERNAME (
                sequence: 2
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

