page 298 (
    name: ApexReportPrivilege
    alias: APEXREPORTPRIVILEGE1
    title: ApexReportPrivilege
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region apexreportprivilege (
        name: ApexReportPrivilege
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select   
                row_number() over(order by A.BOSSUSERCode) SerialNo,
                A.* 
                from apexreportprivilege A
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 297
                items: {
                    P297_TNO: #TNO#
                }
                clearCache: 297
            }
            linkIcon: <img src="#APEX_FILES#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 20563324544023728
        }

        column APEXREPORTPRIVILEGECODE (
            type: hidden
            heading {
                heading: Apexreportprivilegecode
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column APEXREPORTPRIVILEGENAME (
            type: hidden
            heading {
                heading: Apexreportprivilegename
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column BOSSUSERCODE (
            type: plainText
            heading {
                heading: Boss User Code
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column CREATIONTIME (
            type: hidden
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 70
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: N
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column REMARK (
            type: hidden
            heading {
                heading: Remark
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: TNO
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: ApexReportPrivilege
        }

        savedReport 208562 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BOSSUSERCODE (
                sequence: 2
            )

            displayColumn CREATOR (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: ADD NEW
        layout {
            sequence: 10
            region: @apexreportprivilege
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 297
                clearCache: 297
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

