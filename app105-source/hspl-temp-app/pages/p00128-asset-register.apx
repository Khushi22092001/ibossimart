page 128 (
    name: Asset Register
    alias: ASSET-REGISTER
    title: Asset Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region asset-register (
        name: Asset Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.AssetDate) SerialsNo,
                a.Tno,
                a.AssetNo,
                a.AssetDate,
                a.AssetValue,
                c.PartyName as AccountName,
                d.ItemName,
                e.ItemSpecificationName,
                a.Quantity1,
                f.AssetCategoryName,
                g.WorkCentreName,
                h.AssetCode,
                h.SerialNo,
                i.Amount as CWIPAmount,
                b.Amount as IssueAmount,
                --a.AssetValue,
                h.ITCAvailedAmount,
                a.PurchaseDate,
                a.TaxCode,
                j.EquipmentNo,
                a.PhysicalStatus,
                a.OriginalPurchaseDate,
                h.RemainingUseFullifeInMonths,
                a.ResidualValue,
                l.CostCentreName,
                do.DoctypeName,
                lo.LocationName,
                depr.DepriciationAmount,
                nvl(a.Assetvalue,0) - depr.DepriciationAmount as AssetWDV,
                --k.DepreciationAmount,
                --GetAccountGBDepreciation(a.accountcode, :P128_LOCATION, :P128_COMPANY, NVL(:P128_TODATE,TRUNC(SYSDATE))) as DepreciationAmount,
                --NVL(a.AssetValue,0) - GetAccountGBDepreciation(a.accountcode, :P128_LOCATION, :P128_COMPANY, NVL(:P128_TODATE,TRUNC(SYSDATE))) AS AssetWDV,
                --GetAccountGBCloseRevised(a.accountcode, :P128_LOCATION, :P128_COMPANY, NVL(:P128_TODATE,TRUNC(SYSDATE))) as AssetWDV,
                --k.AssetWDV,
                co.CompanyName
                From Asset a, AssetDetail b,Party c, Item d, Itemspecification e, AssetCategory f, WorkCentre g,AssetCodeDetail h,
                AssetCreditAccount i, Doctype do, Location lo, Company co, Equipment j, DepreciationDetailAssetCode k, CostCentre l,
                (Select aa.tno,
                        Sum(aa.depreciatedamount) + Sum(bb.depreciationamount) As DepriciationAmount
                  From  asset aa, DepreciationDetail bb
                 Where  aa.tno = bb.assettno
                 Group By aa.tno) depr
                
                Where a.Tno = b.Tno(+) 
                and a.AccountCode = c.PartyCode(+)
                and a.ItemCode = d.ItemCode(+)
                and a.ItemSpecificationCode = e.ItemSpecificationCode(+)
                and a.AssetCategoryCode = f.AssetCategoryCode(+)
                and a.WorkCentreCode = g.WorkCentreCode(+)
                and a.Tno = h.Tno(+)
                and a.Tno = i.Tno(+)
                and a.DoctypeCode = do.DoctypeCode(+)
                and a.LocationCode = lo.LocationCode(+)
                and a.CompanyCode = co.CompanyCode(+)
                and a.EquipmentTno = j.Tno(+)
                and a.Tno = k.AssetTno(+)
                and a.CostCentreCode = l.CostCentreCode(+)
                and a.tno = depr.tno(+)
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                and a.AssetDate between :P128_FROMDATE and :P128_TODATE 
                and (:P128_COMPANY is Null Or Instr (':' || :P128_COMPANY || ':' , ':' ||co.CompanyCode|| ':') > 0)
                and (:P128_LOCATION is Null Or Instr (':' || :P128_LOCATION || ':' , ':' ||lo.LocationCode|| ':') > 0)
                and (:P128_DOCTYPE is Null Or Instr (':' || :P128_DOCTYPE || ':' , ':' ||do.DoctypeCode|| ':') > 0)
                and (:P128_ASSETACCOUNT is Null Or Instr (':' || :P128_ASSETACCOUNT || ':' , ':' ||c.PartyCode|| ':') > 0)
                and (:P128_ITEM is Null Or Instr (':' || :P128_ITEM || ':' , ':' ||d.ItemCode|| ':') > 0)
                and (:P128_ASSETCATEGORY is Null Or Instr (':' || :P128_ASSETCATEGORY || ':' , ':' ||f.AssetCategoryCode|| ':') > 0)
                and (:P128_ASSET is Null Or Instr (':' || :P128_ASSET || ':' , ':' ||a.Tno|| ':') > 0)
                Order by a.AssetDate desc;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 5046171232007002
        }

