    region fulfilment-health (
        name: Fulfilment Health
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                  Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F,
                         to_date(:P730_TODATE,'DD-MM-RRRR') T From dual),
                K As (
                  Select
                    (Select Count(*) From SalesConfirm sc Cross Join Win w
                      Where sc.SalesConfirmDate Between w.F And w.T
                        And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                        And (:P730_COMPANY Is Null Or sc.CompanyCode=:P730_COMPANY)
                        And (:P730_LOCATION Is Null Or sc.LocationCode=:P730_LOCATION)
                        And (:P730_PANEL Is Null Or sc.Panel=:P730_PANEL)) ConfTotal,
                    (Select Count(*) From SalesConfirm sc Cross Join Win w
                      Where sc.SalesConfirmDate Between w.F And w.T
                        And Exists (Select 1 From SalesOrder so Where so.SalesConfirmTNo=sc.TNo)
                        And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                        And (:P730_COMPANY Is Null Or sc.CompanyCode=:P730_COMPANY)
                        And (:P730_LOCATION Is Null Or sc.LocationCode=:P730_LOCATION)
                        And (:P730_PANEL Is Null Or sc.Panel=:P730_PANEL)) ConfConverted,
                    (Select Median(so.SalesOrderDate-sc.SalesConfirmDate)
                       From SalesConfirm sc Join SalesOrder so On so.SalesConfirmTNo=sc.TNo Cross Join Win w
                      Where sc.SalesConfirmDate Between w.F And w.T
                        And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                        And (:P730_COMPANY Is Null Or sc.CompanyCode=:P730_COMPANY)
                        And (:P730_LOCATION Is Null Or sc.LocationCode=:P730_LOCATION)
                        And (:P730_PANEL Is Null Or sc.Panel=:P730_PANEL)) MedianConvDays,
                    (Select Sum(Greatest(Nvl(d.Quantity1,0)-Nvl(d.CCInvoiceQuantity1,0),0))
                       From SalesOrder so Join SalesOrderDetail d On d.TNo=so.TNo Cross Join Win w
                      Where so.SalesOrderDate Between w.F And w.T
                        And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                        And (:P730_COMPANY Is Null Or so.CompanyCode=:P730_COMPANY)
                        And (:P730_LOCATION Is Null Or so.LocationCode=:P730_LOCATION)
                        And (:P730_PANEL Is Null Or so.Panel=:P730_PANEL)) OpenQty,
                    (Select Sum(Case When Nvl(d.Quantity1,0)>0 Then d.Amount*Greatest(Nvl(d.Quantity1,0)-Nvl(d.CCInvoiceQuantity1,0),0)/d.Quantity1 Else 0 End)
                       From SalesOrder so Join SalesOrderDetail d On d.TNo=so.TNo Cross Join Win w
                      Where so.SalesOrderDate Between w.F And w.T
                        And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                        And (:P730_COMPANY Is Null Or so.CompanyCode=:P730_COMPANY)
                        And (:P730_LOCATION Is Null Or so.LocationCode=:P730_LOCATION)
                        And (:P730_PANEL Is Null Or so.Panel=:P730_PANEL)) OpenVal,
                    (Select Count(*) From SalesOrder so Cross Join Win w
                      Where so.SalesOrderDate Between w.F And w.T And trunc(sysdate-so.SalesOrderDate)>7
                        And Not Exists (Select 1 From DespatchAdvice da Where da.SalesOrderTNo=so.TNo)
                        And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                        And (:P730_COMPANY Is Null Or so.CompanyCode=:P730_COMPANY)
                        And (:P730_LOCATION Is Null Or so.LocationCode=:P730_LOCATION)
                        And (:P730_PANEL Is Null Or so.Panel=:P730_PANEL))
                    + (Select Count(*) From DespatchAdvice da Cross Join Win w
                      Where da.DespatchAdviceDate Between w.F And w.T And trunc(sysdate-da.DespatchAdviceDate)>2
                        And Not Exists (Select 1 From MaterialOut mo Where mo.ReferenceTNo=da.TNo)
                        And ((Select GetUserPanelAB_apex() From dual) Is Null Or da.Panel=(Select GetUserPanelAB_apex() From dual))
                        And (:P730_COMPANY Is Null Or da.CompanyCode=:P730_COMPANY)
                        And (:P730_LOCATION Is Null Or da.LocationCode=:P730_LOCATION)
                        And (:P730_PANEL Is Null Or da.Panel=:P730_PANEL)) CriticalBacklog,
                    (Select Count(*) From SCBALANCE b Join SalesConfirm sc On sc.TNo=b.TNo Cross Join Win w
                      Where b.BalanceQty>0 And sc.SalesConfirmDate Between w.F And w.T
                        And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                        And (:P730_COMPANY Is Null Or sc.CompanyCode=:P730_COMPANY)
                        And (:P730_LOCATION Is Null Or sc.LocationCode=:P730_LOCATION)
                        And (:P730_PANEL Is Null Or sc.Panel=:P730_PANEL)) ScBalanceCnt
                  From dual)
                Select Case x.Seq
                  When 1 Then q'~<a class="ds-kpi ds-kpi--ok ds-kpi--clickable" href="#p730ScRegister" data-kpi-goto="p730ScRegister"><span class="ds-kpi-ic"><span class="fa fa-exchange"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Confirmation Conversion</span><span class="ds-kpi-n">~'||to_char(Round(100*K.ConfConverted/Nullif(K.ConfTotal,0),1),'FM990D0')||q'~%</span><span class="ds-kpi-sub">Confirmations linked to an order</span></span></a>~'
                  When 2 Then q'~<a class="ds-kpi ds-kpi--bill ds-kpi--clickable" href="#p730ScRegister" data-kpi-goto="p730ScRegister"><span class="ds-kpi-ic"><span class="fa fa-clock-o"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Median Confirm &rarr; Order</span><span class="ds-kpi-n">~'||to_char(Nvl(K.MedianConvDays,0),'FM990D0')||q'~ d</span><span class="ds-kpi-sub">Speed from commitment to order</span></span></a>~'
                  When 3 Then q'~<a class="ds-kpi ds-kpi--value ds-kpi--clickable" href="#p730Exceptions" data-kpi-goto="p730Exceptions"><span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Open Order Quantity</span><span class="ds-kpi-n">~'||to_char(Nvl(K.OpenQty,0),'FM999G999G990')||q'~</span><span class="ds-kpi-sub">Estimated open value &#8377; ~'||to_char(Nvl(K.OpenVal,0)/1e7,'FM999G990D00')||q'~ Cr</span></span></a>~'
                  When 4 Then q'~<a class="ds-kpi ds-kpi--risk ds-kpi--clickable" href="#p730Exceptions" data-kpi-goto="p730Exceptions"><span class="ds-kpi-ic"><span class="fa fa-exclamation-triangle"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">Critical Stage Backlog</span><span class="ds-kpi-n">~'||to_char(Nvl(K.CriticalBacklog,0),'FM999G990')||q'~</span><span class="ds-kpi-sub">Order &gt;7d or dispatch &gt;2d without next step</span></span></a>~'
                  Else q'~<a class="ds-kpi ds-kpi--value ds-kpi--clickable" href="#p730ScBalanceRegister" data-kpi-goto="p730ScBalanceRegister"><span class="ds-kpi-ic"><span class="fa fa-balance-scale"></span></span><span class="ds-kpi-body"><span class="ds-kpi-t">SC Balance</span><span class="ds-kpi-n">~'||to_char(Nvl(K.ScBalanceCnt,0),'FM999G990')||q'~</span><span class="ds-kpi-sub">Open confirmations carrying balance</span></span></a>~'
                End As CARD
                From K, (Select Level Seq From dual Connect By Level<=5) x
                Order By x.Seq
                ```
            pageItemsToSubmit: [
