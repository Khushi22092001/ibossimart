    region sales-trend (
        name: Lifecycle Trend
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F, to_date(:P730_TODATE,'DD-MM-RRRR') + 1 T From dual)
                Select to_char(Trunc(x.dt,'MM'),'Mon-RR') MONTH_LABEL,
                       Round(Sum(x.conf)/1e7,2) CONFIRMED_CR,
                       Round(Sum(x.so)/1e7,2) ORDER_CR,
                       Round(Sum(x.inv)/1e7,2) INVOICED_CR,
                       Trunc(x.dt,'MM') SORT_KEY
                  From (
                    Select a.SalesConfirmDate dt, d.Amount conf, 0 so, 0 inv
                      From SalesConfirm a Join SalesConfirmDetail d On d.TNo=a.TNo Cross Join Win w
                     Where a.SalesConfirmDate >= w.F And a.SalesConfirmDate < w.T
                       And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                       And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY)
                       And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION)
                       And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL)
                    Union All
                    Select a.SalesOrderDate, 0, d.Amount, 0
                      From SalesOrder a Join SalesOrderDetail d On d.TNo=a.TNo Cross Join Win w
                     Where a.SalesOrderDate >= w.F And a.SalesOrderDate < w.T
                       And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                       And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY)
                       And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION)
                       And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL)
                    Union All
                    Select a.CCInvoiceDate, 0, 0, d.Amount
                      From CCInvoice a Join CCInvoiceDetail d On d.TNo=a.TNo Cross Join Win w
                     Where a.CCInvoiceDate >= w.F And a.CCInvoiceDate < w.T
                       And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                       And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY)
                       And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION)
                       And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL)
                  ) x
                 Group By Trunc(x.dt,'MM')
                 Order By SORT_KEY
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
            ]
        }
        layout {
            sequence: 35
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: line
        }
        chartLayout {
            height: 320
        }
        settings {
            timeAxisType: auto
        }
        messages {
            whenNoDataFound: No lifecycle activity to plot in the last 12 months.
        }

