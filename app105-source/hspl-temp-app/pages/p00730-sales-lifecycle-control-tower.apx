    region category-performance (
        name: Category 360 Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Case When isp.ItemCategoryCode Is Not Null Then
                         '<a href="'||apex_page.get_url(p_page=>733,p_clear_cache=>'733',p_items=>'P733_CATEGORY',p_values=>isp.ItemCategoryCode)||'">'
                         ||apex_escape.html(Nvl(cat.ItemCategoryName,isp.ItemCategoryCode))||'</a>'
                       Else 'Uncategorised' End CATEGORY,
                       Round(Sum(d.Amount)/1e7,2) VAL_CR,
                       Round(Sum(d.Quantity1)) QTY,
                       Count(Distinct ci.TNo) INVOICES,
                       Count(Distinct ci.PartyCode) CUSTOMERS,
                       Round(Sum(d.Amount)/Nullif(Sum(d.Quantity1),0)) AVG_RATE
                  From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                  Left Join ItemSpecification isp On isp.ItemSpecificationCode = d.ItemSpecificationCode
                  Left Join ItemCategory cat On cat.ItemCategoryCode = isp.ItemCategoryCode
                 Where ci.CCInvoiceDate Between to_date(:P730_FROMDATE,'DD-MM-RRRR') And to_date(:P730_TODATE,'DD-MM-RRRR')
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or ci.CompanyCode=:P730_COMPANY)
                   And (:P730_LOCATION Is Null Or ci.LocationCode=:P730_LOCATION)
                   And (:P730_PANEL Is Null Or ci.Panel=:P730_PANEL)
                 Group By isp.ItemCategoryCode, cat.ItemCategoryName
                 Order By Sum(d.Amount) Desc
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
            ]
        }
