    region sc-balance-register (
        name: Sales Confirmation Balance Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a href="'||apex_page.get_url(p_page=>731,p_clear_cache=>'731',p_items=>'P731_SCTNO,P731_FROMDATE,P731_TODATE,P731_COMPANY,P731_LOCATION,P731_PANEL',p_values=>b.TNo||','||:P730_FROMDATE||','||:P730_TODATE||','||:P730_COMPANY||','||:P730_LOCATION||','||:P730_PANEL)||'">'||apex_escape.html(b.SalesConfirmNo)||'</a>' Confirmation,
                       b.SalesConfirmDate Confirm_Date,b.PartyName Customer,
                       Round(b.ScQty,3) Confirmed_Qty,Round(b.SoQty,3) Ordered_Qty,
                       Round(b.DaQty,3) Dispatch_Qty,Round(b.CcQty,3) Invoice_Qty,
                       Round(b.BalanceQty,3) Balance_Qty,Trunc(sysdate-b.SalesConfirmDate) Age_Days,
                       Case When nvl(b.SoQty,0)=0 Then 'Awaiting order'
                            When nvl(b.DaQty,0)=0 Then 'Awaiting dispatch'
                            When nvl(b.CcQty,0)=0 Then 'Awaiting invoice' Else 'Part fulfilled' End Status
                  From SCBALANCE b Join SalesConfirm sc On sc.TNo=b.TNo
                 Where b.BalanceQty>0
                   And sc.SalesConfirmDate>=to_date(:P730_FROMDATE,'DD-MM-RRRR')
                   And sc.SalesConfirmDate<to_date(:P730_TODATE,'DD-MM-RRRR')+1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or sc.CompanyCode=:P730_COMPANY)
                   And (:P730_LOCATION Is Null Or sc.LocationCode=:P730_LOCATION)
                   And (:P730_PANEL Is Null Or sc.Panel=:P730_PANEL)
                 Order By b.SalesConfirmDate Desc,b.SalesConfirmNo Desc
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
            ]
        }
