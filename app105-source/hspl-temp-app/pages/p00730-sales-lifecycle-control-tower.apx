    region rule-catflow (
        name: Category Flow Note
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Confirmation &rarr; Order Category Flow</h2>
                  <p>Sales Confirmations are booked by <b>category</b>; the resulting Sales Order carries <b>specifications</b> that roll up to a category. This shows where the ordered category <b>differs</b> from what was confirmed &mdash; substitution or a booking mismatch. "Changed" rows are listed first.</p>
                </div>
                ```
        }
        layout {
            sequence: 69
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

