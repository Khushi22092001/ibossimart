            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No active customer credit limit exists in this scope as at the To Date.
        }
        advanced {
            savedReportMappingIdentifier: 51020275778668936
        }

