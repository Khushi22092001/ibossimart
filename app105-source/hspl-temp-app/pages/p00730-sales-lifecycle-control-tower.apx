    region category-flow-detail (
        name: Category Flow &mdash; Confirmation vs Order Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                  Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F, to_date(:P730_TODATE,'DD-MM-RRRR') T From dual)
                Select '<a href="'||apex_page.get_url(p_page=>731,p_items=>'P731_SCTNO',p_values=>sc.TNo)||'">'||sc.SalesConfirmNo||'</a>' CONFIRM_NO,
                       sc.SalesConfirmDate CONFIRM_DATE,
                       so.SalesOrderNo ORDER_NO,
                       so.SalesOrderDate ORDER_DATE,
                       trunc(so.SalesOrderDate-sc.SalesConfirmDate) GAP_DAYS,
                       GetPartyName(sc.PartyCode) CUSTOMER,
                       Nvl(cc.ItemCategoryName,:P730_CFLOW_C) CONFIRMED_CAT,
                       Nvl(oc.ItemCategoryName,:P730_CFLOW_O) ORDER_CAT
                  From SalesConfirm sc
                  Join SalesOrder so On so.SalesConfirmTNo=sc.TNo
                  Cross Join Win w
                  Left Join ItemCategory cc On cc.ItemCategoryCode=:P730_CFLOW_C
                  Left Join ItemCategory oc On oc.ItemCategoryCode=:P730_CFLOW_O
                 Where :P730_CFLOW_C Is Not Null
                   And sc.SalesConfirmDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or sc.CompanyCode=:P730_COMPANY)
                   And (:P730_LOCATION Is Null Or sc.LocationCode=:P730_LOCATION)
                   And (:P730_PANEL Is Null Or sc.Panel=:P730_PANEL)
                   And Exists (Select 1 From SalesConfirmDetail scd Where scd.TNo=sc.TNo And scd.ItemCategoryCode=:P730_CFLOW_C)
                   And Exists (Select 1 From SalesOrderDetail sod Join ItemSpecification isp On isp.ItemSpecificationCode=sod.ItemSpecificationCode Where sod.TNo=so.TNo And isp.ItemCategoryCode=:P730_CFLOW_O)
                 Order By sc.SalesConfirmDate Desc, so.SalesOrderDate Desc
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
                P730_CFLOW_C
                P730_CFLOW_O
            ]
        }
        layout {
            sequence: 70
            slot: body
            columnSpan: 12
        }
