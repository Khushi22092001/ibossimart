    region exceptions (
        name: Documents Behind the Selected Exception
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                  Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F, to_date(:P730_TODATE,'DD-MM-RRRR') T From dual),
                E As (
                  Select Case When trunc(sysdate-so.SalesOrderDate)>15 Then 1 When trunc(sysdate-so.SalesOrderDate)>7 Then 2 Else 3 End SEV_ORD,
                         'Order not dispatched' EXC_TYPE, 'Sales Order' STAGE, so.SalesOrderNo DOC_NO,
                         GetPartyName(so.PartyCode) CUSTOMER, so.VehicleNo VEHICLE,
                         (Select Nvl(Sum(d.Amount),0) From SalesOrderDetail d Where d.TNo=so.TNo) AMOUNT,
                         trunc(sysdate-so.SalesOrderDate) AGE_DAYS,
                         'Schedule dispatch and confirm vehicle readiness' NEXT_ACTION
                    From SalesOrder so Cross Join Win w
                   Where so.SalesOrderDate Between w.F And w.T And Not Exists (Select 1 From DespatchAdvice x Where x.SalesOrderTNo=so.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or so.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or so.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or so.Panel=:P730_PANEL)
                  Union All
                  Select Case When trunc(sysdate-da.DespatchAdviceDate)>10 Then 1 Else 2 End,
                         'Dispatch not gated', 'Dispatch Advice', da.DespatchAdviceNo,
                         GetPartyName(da.PartyCode), da.VehicleNo, Null, trunc(sysdate-da.DespatchAdviceDate),
                         'Create or reconcile the vehicle gate entry'
                    From DespatchAdvice da Cross Join Win w
                   Where da.DespatchAdviceDate Between w.F And w.T And Not Exists (Select 1 From MaterialOut x Where x.ReferenceTNo=da.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or da.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or da.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or da.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or da.Panel=:P730_PANEL)
                  Union All
                  Select 1, 'Gate-out not invoiced', 'Gate Out', da.DespatchAdviceNo,
                         GetPartyName(da.PartyCode), da.VehicleNo, Null, trunc(sysdate-da.DespatchAdviceDate),
                         'Create or reconcile the commercial invoice'
                    From DespatchAdvice da Cross Join Win w
                   Where da.DespatchAdviceDate Between w.F And w.T
                     And Exists (Select 1 From MaterialOut m Where m.ReferenceTNo=da.TNo And m.GateOutTime Is Not Null)
                     And Not Exists (Select 1 From CCInvoice c Where c.DespatchAdviceTNo=da.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or da.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or da.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or da.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or da.Panel=:P730_PANEL)
                  Union All
                  Select Case When trunc(sysdate-ci.CCInvoiceDate)>3 Then 2 Else 3 End,
                         'Invoice without IRN', 'Invoice', ci.CCInvoiceNo,
                         GetPartyName(ci.PartyCode), ci.VehicleNo, ci.CCInvoiceAmount, trunc(sysdate-ci.CCInvoiceDate),
                         'Generate or retry the e-invoice IRN'
                    From CCInvoice ci Cross Join Win w
                   Where ci.CCInvoiceDate Between w.F And w.T And Not Exists (Select 1 From EInvoice x Where x.CCInvoiceTNo=ci.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or ci.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or ci.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or ci.Panel=:P730_PANEL)
                  Union All
                  Select 1, 'Stale open gate movement', 'Gate Out', mo.MaterialOutNo,
                         GetPartyName(mo.PartyCode), mo.VehicleNo, Null, trunc(sysdate-mo.GateInTime),
                         'Complete gate-out or correct the open movement'
                    From MaterialOut mo
                   Where mo.GateInTime <= sysdate-2 And mo.GateInTime > sysdate-400 And mo.GateOutTime Is Null
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or mo.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or mo.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or mo.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or mo.Panel=:P730_PANEL)
                  Union All
                  Select Case When trunc(sysdate-w2.WeighmentDate)>1 Then 2 Else 4 End,
                         'Awaiting final weighment', 'Weighment', w2.WeighmentNo,
                         GetPartyName(w2.PartyCode), w2.VehicleNo, Null, trunc(sysdate-w2.WeighmentDate),
                         'Capture the second weight and close weighment'
                    From Weighment w2
                   Where w2.WeighmentDate > sysdate-30 And w2.SecondWeight Is Null
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or w2.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or w2.CompanyCode=:P730_COMPANY) And (:P730_PANEL Is Null Or w2.Panel=:P730_PANEL))
                Select
                  '<span class="ds-pill ds-pill--'||Decode(e.SEV_ORD,1,'bad',2,'warn',3,'info','muted')||'">'
                    ||Decode(e.SEV_ORD,1,'Critical',2,'High',3,'Medium','Low')||'</span>' SEVERITY,
                  e.EXC_TYPE, e.STAGE, e.DOC_NO, e.CUSTOMER, e.VEHICLE, e.NEXT_ACTION, e.AMOUNT, e.AGE_DAYS
                From E e
                Where :P730_EXCEPTION_FOCUS Is Not Null And e.EXC_TYPE=:P730_EXCEPTION_FOCUS
                Order By e.SEV_ORD, e.AGE_DAYS Desc
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
                P730_EXCEPTION_FOCUS
            ]
        }
        layout {
            sequence: 73
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
