    region exception-mix (
        name: Exception Mix
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                  Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F, to_date(:P730_TODATE,'DD-MM-RRRR') T From dual),
                E As (
                  Select 'Order not dispatched' LBL, Count(*) VAL
                    From SalesOrder so Cross Join Win w
                   Where so.SalesOrderDate Between w.F And w.T
                     And Not Exists (Select 1 From DespatchAdvice x Where x.SalesOrderTNo=so.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or so.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or so.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or so.Panel=:P730_PANEL)
                  Union All
                  Select 'Dispatch not gated', Count(*)
                    From DespatchAdvice da Cross Join Win w
                   Where da.DespatchAdviceDate Between w.F And w.T
                     And Not Exists (Select 1 From MaterialOut x Where x.ReferenceTNo=da.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or da.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or da.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or da.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or da.Panel=:P730_PANEL)
                  Union All
                  Select 'Gate-out not invoiced', Count(*)
                    From DespatchAdvice da Cross Join Win w
                   Where da.DespatchAdviceDate Between w.F And w.T
                     And Exists (Select 1 From MaterialOut m Where m.ReferenceTNo=da.TNo And m.GateOutTime Is Not Null)
                     And Not Exists (Select 1 From CCInvoice c Where c.DespatchAdviceTNo=da.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or da.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or da.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or da.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or da.Panel=:P730_PANEL)
                  Union All
                  Select 'Invoice without IRN', Count(*)
                    From CCInvoice ci Cross Join Win w
                   Where ci.CCInvoiceDate Between w.F And w.T
                     And Not Exists (Select 1 From EInvoice x Where x.CCInvoiceTNo=ci.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or ci.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or ci.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or ci.Panel=:P730_PANEL)
                  Union All
                  Select 'Stale open gate movement', Count(*)
                    From MaterialOut mo
                   Where mo.GateInTime <= sysdate-2 And mo.GateInTime > sysdate-400 And mo.GateOutTime Is Null
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or mo.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or mo.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or mo.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or mo.Panel=:P730_PANEL)
                  Union All
                  Select 'Awaiting final weighment', Count(*)
                    From Weighment w2
                   Where w2.WeighmentDate > sysdate-30 And w2.SecondWeight Is Null
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or w2.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or w2.CompanyCode=:P730_COMPANY) And (:P730_PANEL Is Null Or w2.Panel=:P730_PANEL))
                Select LBL, VAL From E Where VAL > 0 Order By VAL Desc
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
            ]
        }
        layout {
            sequence: 43
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 300
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No exceptions in this scope.
        }

        series exception-records (
            name: Exception records
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LBL
                value: VAL
            }
            link {
                type: redirectUrl
                targetUrl: javascript:window.hsplP730ExceptionDrill('&LBL.');
            }
            label {
                show: true
                position: center
                displayAs: percentage
            }
        )

    )

    region exception-summary (
        name: Exception Summary by Condition
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                  Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F,to_date(:P730_TODATE,'DD-MM-RRRR') T From dual),
                R As (
                  Select 1 Seq,'Critical' Severity,'Order not dispatched' RuleName,
                         Count(*) Items,Nvl(Sum((Select Nvl(Sum(d.Amount),0) From SalesOrderDetail d Where d.TNo=so.TNo)),0) ValueAtStake,
                         'Schedule dispatch and confirm vehicle readiness' NextAction
                    From SalesOrder so Cross Join Win w
                   Where so.SalesOrderDate Between w.F And w.T And Not Exists (Select 1 From DespatchAdvice x Where x.SalesOrderTNo=so.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or so.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or so.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or so.Panel=:P730_PANEL)
                  Union All
                  Select 2,'Critical','Dispatch not gated',Count(*),0,'Create or reconcile the vehicle gate entry'
                    From DespatchAdvice da Cross Join Win w
                   Where da.DespatchAdviceDate Between w.F And w.T And Not Exists (Select 1 From MaterialOut x Where x.ReferenceTNo=da.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or da.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or da.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or da.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or da.Panel=:P730_PANEL)
                  Union All
                  Select 3,'Critical','Gate-out not invoiced',Count(*),0,'Create or reconcile the commercial invoice'
                    From DespatchAdvice da Cross Join Win w
                   Where da.DespatchAdviceDate Between w.F And w.T
                     And Exists (Select 1 From MaterialOut m Where m.ReferenceTNo=da.TNo And m.GateOutTime Is Not Null)
                     And Not Exists (Select 1 From CCInvoice c Where c.DespatchAdviceTNo=da.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or da.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or da.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or da.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or da.Panel=:P730_PANEL)
                  Union All
                  Select 4,'High','Invoice without IRN',Count(*),Nvl(Sum(ci.CCInvoiceAmount),0),'Generate or retry the e-invoice IRN'
                    From CCInvoice ci Cross Join Win w
                   Where ci.CCInvoiceDate Between w.F And w.T And Not Exists (Select 1 From EInvoice x Where x.CCInvoiceTNo=ci.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or ci.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or ci.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or ci.Panel=:P730_PANEL)
                  Union All
                  Select 5,'Critical','Stale open gate movement',Count(*),0,'Complete gate-out or correct the open movement'
                    From MaterialOut mo
                   Where mo.GateInTime<=sysdate-2 And mo.GateInTime>sysdate-400 And mo.GateOutTime Is Null
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or mo.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or mo.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or mo.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or mo.Panel=:P730_PANEL)
                  Union All
                  Select 6,'High','Awaiting final weighment',Count(*),0,'Capture the second weight and close weighment'
                    From Weighment w2
                   Where w2.WeighmentDate>sysdate-30 And w2.SecondWeight Is Null
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or w2.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or w2.CompanyCode=:P730_COMPANY) And (:P730_PANEL Is Null Or w2.Panel=:P730_PANEL))
                Select '<span class="ds-pill ds-pill--'||Case Severity When 'Critical' Then 'bad' Else 'warn' End||'">'||Severity||'</span>' Severity,
                       RuleName Condition,
                       '<a href="javascript:void(0);" class="ds-exception-count" data-exc="'||apex_escape.html_attribute(RuleName)||'">'
                         ||to_char(Items,'FM999G999G990')||'</a>' Records,
                       ValueAtStake,NextAction
                  From R Where Items>0 Order By Seq
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
            ]
        }
