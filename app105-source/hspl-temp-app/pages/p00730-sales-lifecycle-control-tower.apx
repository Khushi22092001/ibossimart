    region stage-detail (
        name: Stage Documents
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                  Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F, to_date(:P730_TODATE,'DD-MM-RRRR') T From dual)
                Select 'Confirmation' STAGE, sc.SalesConfirmNo DOC_NO, sc.SalesConfirmDate DOC_DATE, GetPartyName(sc.PartyCode) PARTY, Cast(Null As Varchar2(30)) VEHICLE, sc.SalesConfirmAmount DOC_VALUE,
                       Trunc(sysdate-sc.SalesConfirmDate) AGE_DAYS,Cast(Null As Varchar2(120)) RELATED_DOCUMENT,
                       Case When :P730_STAGE_FOCUS='H1' Then 'Waiting for Sales Order' Else 'Confirmation recorded' End STATUS,
                       Case When :P730_STAGE_FOCUS='H1' Then 'Create or link Sales Order; verify customer, items, quantity, rate and validity' Else 'Review customer commitment and confirmation status' End NEXT_ACTION
                  From SalesConfirm sc Cross Join Win w
                 Where :P730_STAGE_FOCUS In ('10','H1') And sc.SalesConfirmDate Between w.F And w.T
                   And (:P730_STAGE_FOCUS<>'H1' Or Not Exists (Select 1 From SalesOrder x Where x.SalesConfirmTNo=sc.TNo))
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or sc.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or sc.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or sc.Panel=:P730_PANEL)
                Union All
                Select 'Sales Order', so.SalesOrderNo, so.SalesOrderDate, GetPartyName(so.PartyCode), so.VehicleNo, so.SalesOrderAmount,
                       Trunc(sysdate-so.SalesOrderDate),(Select Max(sc.SalesConfirmNo) From SalesConfirm sc Where sc.TNo=so.SalesConfirmTNo),
                       Case When :P730_STAGE_FOCUS='H2' Then 'Waiting for Dispatch Advice' Else 'Order booked' End,
                       Case When :P730_STAGE_FOCUS='H2' Then 'Schedule dispatch; verify balance quantity, validity, vehicle and customer readiness' Else 'Review fulfilment and order balance' End
                  From SalesOrder so Cross Join Win w
                 Where :P730_STAGE_FOCUS In ('20','H2') And so.SalesOrderDate Between w.F And w.T
                   And (:P730_STAGE_FOCUS<>'H2' Or Not Exists (Select 1 From DespatchAdvice x Where x.SalesOrderTNo=so.TNo))
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or so.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or so.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or so.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or so.Panel=:P730_PANEL)
                Union All
                Select 'Dispatch Advice', da.DespatchAdviceNo, da.DespatchAdviceDate, GetPartyName(da.PartyCode), da.VehicleNo,
                       Nvl((Select Max(Nvl(w2.NetWeight,Abs(w2.SecondWeight-w2.FirstWeight))) From Weighment w2 Where w2.ReferenceTNo=da.TNo),
                           (Select Sum(d.Quantity1) From DespatchAdviceDetail d Where d.TNo=da.TNo)),
                       Trunc(sysdate-da.DespatchAdviceDate),(Select Max(so.SalesOrderNo) From SalesOrder so Where so.TNo=da.SalesOrderTNo),
                       Case When :P730_STAGE_FOCUS='H3' Then 'Vehicle not gated in' When :P730_STAGE_FOCUS='H4' Then 'Gate-out completed; invoice missing' Else 'Vehicle planned' End,
                       Case When :P730_STAGE_FOCUS='H3' Then 'Contact transporter/driver and verify planned arrival' When :P730_STAGE_FOCUS='H4' Then 'Create CC invoice and reconcile weight, quantity and tax details' Else 'Track gate arrival and vehicle readiness' End
                  From DespatchAdvice da Cross Join Win w
                 Where (:P730_STAGE_FOCUS='30'
                        Or (:P730_STAGE_FOCUS='H3' And Not Exists (Select 1 From MaterialOut x Where x.ReferenceTNo=da.TNo))
                        Or (:P730_STAGE_FOCUS='H4' And Exists (Select 1 From MaterialOut x Where x.ReferenceTNo=da.TNo And x.GateOutTime Is Not Null)
                            And Not Exists (Select 1 From CCInvoice x Where x.DespatchAdviceTNo=da.TNo)))
                   And da.DespatchAdviceDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or da.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or da.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or da.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or da.Panel=:P730_PANEL)
                Union All
                Select 'Gate (Material Out)', mo.MaterialOutNo, mo.MaterialOutDate, GetPartyName(mo.PartyCode), mo.VehicleNo,
                       (Select Max(Nvl(w2.NetWeight,Abs(w2.SecondWeight-w2.FirstWeight))) From Weighment w2 Where w2.ReferenceTNo=mo.ReferenceTNo),
                       Trunc(sysdate-mo.MaterialOutDate),(Select Max(da.DespatchAdviceNo) From DespatchAdvice da Where da.TNo=mo.ReferenceTNo),
                       Case When mo.GateOutTime Is Null Then 'Vehicle inside' Else 'Gate completed' End,
                       Case When mo.GateOutTime Is Null Then 'Complete weighment and gate-out' Else 'Verify downstream invoice' End
                  From MaterialOut mo Cross Join Win w
                 Where :P730_STAGE_FOCUS='40' And mo.MaterialOutDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or mo.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or mo.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or mo.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or mo.Panel=:P730_PANEL)
                Union All
                Select 'Weighment', w2.WeighmentNo, w2.WeighmentDate, GetPartyName(w2.PartyCode), w2.VehicleNo, w2.NetWeight,
                       Trunc(sysdate-w2.WeighmentDate),(Select Max(da.DespatchAdviceNo) From DespatchAdvice da Where da.TNo=w2.ReferenceTNo),
                       Case When w2.SecondWeight Is Null Then 'Final weight pending' Else 'Weighment complete' End,
                       Case When w2.SecondWeight Is Null Then 'Record second weight' Else 'Proceed to gate-out / invoice' End
                  From Weighment w2 Cross Join Win w
                 Where :P730_STAGE_FOCUS='50' And w2.WeighmentDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or w2.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or w2.CompanyCode=:P730_COMPANY) And (:P730_PANEL Is Null Or w2.Panel=:P730_PANEL)
                Union All
                Select 'Invoice', ci.CCInvoiceNo, ci.CCInvoiceDate, GetPartyName(ci.PartyCode), ci.VehicleNo, ci.CCInvoiceAmount,
                       Trunc(sysdate-ci.CCInvoiceDate),(Select Max(so.SalesOrderNo) From SalesOrder so Where so.TNo=ci.SalesOrderTNo),
                       Case When :P730_STAGE_FOCUS='H5' Then 'Invoice posted; IRN missing' Else 'CC invoice posted' End,
                       Case When :P730_STAGE_FOCUS='H5' Then 'Generate or retry IRN; validate GSTIN, payload and portal error' Else 'Review invoice and e-invoice status' End
                  From CCInvoice ci Cross Join Win w
                 Where :P730_STAGE_FOCUS In ('60','H5') And ci.CCInvoiceDate Between w.F And w.T
                   And (:P730_STAGE_FOCUS<>'H5' Or Not Exists (Select 1 From EInvoice x Where x.CCInvoiceTNo=ci.TNo And x.IRN Is Not Null))
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or ci.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or ci.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or ci.Panel=:P730_PANEL)
                Union All
                Select 'E-Invoice', e.Irn, e.AckDate, GetPartyName(ci.PartyCode), ci.VehicleNo, ci.CCInvoiceAmount,
                       Trunc(sysdate-ci.CCInvoiceDate),ci.CCInvoiceNo,'IRN generated','Monitor e-way bill validity and exceptions'
                  From EInvoice e Join CCInvoice ci On ci.TNo=e.CCInvoiceTNo Cross Join Win w
                 Where :P730_STAGE_FOCUS='70' And ci.CCInvoiceDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or ci.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or ci.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or ci.Panel=:P730_PANEL)
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
                P730_STAGE_FOCUS
            ]
        }
        layout {
            sequence: 44
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        advanced {
            htmlDomId: p730StageDetail
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
