    region handoff-pressure (
        name: Handoff Pressure
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                  Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F, to_date(:P730_TODATE,'DD-MM-RRRR') T From dual),
                B As (
                  Select 1 Seq, 10 FromK, 'Confirmation to order' LBL, Count(*) CNT, Round(Max(sysdate-a.SalesConfirmDate)) MAX_AGE
                    From SalesConfirm a Cross Join Win w
                   Where a.SalesConfirmDate Between w.F And w.T And Not Exists (Select 1 From SalesOrder x Where x.SalesConfirmTNo=a.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL)
                  Union All
                  Select 2, 20, 'Order to dispatch', Count(*), Round(Max(sysdate-a.SalesOrderDate))
                    From SalesOrder a Cross Join Win w
                   Where a.SalesOrderDate Between w.F And w.T And Not Exists (Select 1 From DespatchAdvice x Where x.SalesOrderTNo=a.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL)
                  Union All
                  Select 3, 30, 'Dispatch to gate', Count(*), Round(Max(sysdate-a.DespatchAdviceDate))
                    From DespatchAdvice a Cross Join Win w
                   Where a.DespatchAdviceDate Between w.F And w.T And Not Exists (Select 1 From MaterialOut x Where x.ReferenceTNo=a.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL)
                  Union All
                  Select 4, 30, 'Gate-out to invoice', Count(*), Round(Max(sysdate-a.DespatchAdviceDate))
                    From DespatchAdvice a Cross Join Win w
                   Where a.DespatchAdviceDate Between w.F And w.T
                     And Exists (Select 1 From MaterialOut m Where m.ReferenceTNo=a.TNo And m.GateOutTime Is Not Null)
                     And Not Exists (Select 1 From CCInvoice c Where c.DespatchAdviceTNo=a.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL)
                  Union All
                  Select 5, 60, 'Invoice to IRN', Count(*), Round(Max(sysdate-a.CCInvoiceDate))
                    From CCInvoice a Cross Join Win w
                   Where a.CCInvoiceDate Between w.F And w.T And Not Exists (Select 1 From EInvoice x Where x.CCInvoiceTNo=a.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL)),
                M As (Select Max(CNT) MX From B)
                Select '<a href="javascript:void(0);" class="ds-lolli ds-slc-drill ds-lolli--'
                    ||Case When Nvl(B.MAX_AGE,0)>30 Then 'hi' When Nvl(B.MAX_AGE,0)>7 Then 'mid' Else 'lo' End||'" data-k="H'||B.Seq||'">'
                    ||'<span class="ds-lolli-label" title="'||apex_escape.html_attribute(B.LBL)||'">'||apex_escape.html(B.LBL)||'</span>'
                    ||'<span class="ds-lolli-track"><span class="ds-lolli-line" style="width:'
                    ||Case When B.CNT=0 Then '0' Else to_char(greatest(round(B.CNT/nullif(M.MX,0)*100),3)) End||'%"></span><span class="ds-lolli-dot"></span></span>'
                    ||'<span class="ds-lolli-val">'||to_char(B.CNT,'FM999G990')||' docs &middot; max '||to_char(Nvl(B.MAX_AGE,0),'FM990')||'d</span></a>' ROW_HTML
                  From B Cross Join M Order By B.Seq
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
            ]
        }
        layout {
            sequence: 43
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-lollipop
                ds-slc-lollipop
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No handoff backlog in this scope.
        }

