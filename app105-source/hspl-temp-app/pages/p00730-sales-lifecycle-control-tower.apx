            sequence: 21
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                ds-kpiwrap--6up
            ]
