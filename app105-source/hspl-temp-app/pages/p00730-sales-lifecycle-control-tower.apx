    region bottlenecks (
        name: Bottlenecks
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                  Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F, to_date(:P730_TODATE,'DD-MM-RRRR') T From dual),
                B As (
                  Select 1 Seq, 10 FromK, 'Confirmation &rarr; Order' Nm,
                         Count(*) Cnt, Round(Nvl(Sum(v),0)/1e7,2) ValCr, Round(Avg(age)) AvgAge, Round(Max(age)) MaxAge
                    From (Select (Select Nvl(Sum(d.Amount),0) From SalesConfirmDetail d Where d.TNo=a.TNo) v, sysdate-a.SalesConfirmDate age
                            From SalesConfirm a Cross Join Win w Where a.SalesConfirmDate Between w.F And w.T
                             And Not Exists (Select 1 From SalesOrder x Where x.SalesConfirmTNo=a.TNo)
                             And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                             And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL))
                  Union All
                  Select 2, 20, 'Order &rarr; Dispatch',
                         Count(*), Round(Nvl(Sum(v),0)/1e7,2), Round(Avg(age)), Round(Max(age))
                    From (Select (Select Nvl(Sum(d.Amount),0) From SalesOrderDetail d Where d.TNo=a.TNo) v, sysdate-a.SalesOrderDate age
                            From SalesOrder a Cross Join Win w Where a.SalesOrderDate Between w.F And w.T
                             And Not Exists (Select 1 From DespatchAdvice x Where x.SalesOrderTNo=a.TNo)
                             And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                             And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL))
                  Union All
                  Select 3, 30, 'Dispatch &rarr; Gate',
                         Count(*), Null, Round(Avg(age)), Round(Max(age))
                    From (Select sysdate-a.DespatchAdviceDate age
                            From DespatchAdvice a Cross Join Win w Where a.DespatchAdviceDate Between w.F And w.T
                             And Not Exists (Select 1 From MaterialOut x Where x.ReferenceTNo=a.TNo)
                             And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                             And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL))
                  Union All
                  Select 4, 30, 'Gate-out &rarr; Invoice',
                         Count(*), Null, Round(Avg(age)), Round(Max(age))
                    From (Select sysdate-a.DespatchAdviceDate age
                            From DespatchAdvice a Cross Join Win w Where a.DespatchAdviceDate Between w.F And w.T
                             And Exists (Select 1 From MaterialOut m Where m.ReferenceTNo=a.TNo And m.GateOutTime Is Not Null)
                             And Not Exists (Select 1 From CCInvoice c Where c.DespatchAdviceTNo=a.TNo)
                             And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                             And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL))
                  Union All
                  Select 5, 60, 'Invoice &rarr; E-Invoice',
                         Count(*), Round(Nvl(Sum(v),0)/1e7,2), Round(Avg(age)), Round(Max(age))
                    From (Select (Select Nvl(Sum(d.Amount),0) From CCInvoiceDetail d Where d.TNo=a.TNo) v, sysdate-a.CCInvoiceDate age
                            From CCInvoice a Cross Join Win w Where a.CCInvoiceDate Between w.F And w.T
                             And Not Exists (Select 1 From EInvoice x Where x.CCInvoiceTNo=a.TNo)
                             And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel=(Select GetUserPanelAB_apex() From dual))
                             And (:P730_COMPANY Is Null Or a.CompanyCode=:P730_COMPANY) And (:P730_LOCATION Is Null Or a.LocationCode=:P730_LOCATION) And (:P730_PANEL Is Null Or a.Panel=:P730_PANEL)))
                Select
                  '<a class="ds-kpi ds-slc-drill '||Case When b.Cnt=0 Then 'ds-kpi--ok' When Nvl(b.MaxAge,0) > 30 Then 'ds-kpi--risk' Else 'ds-kpi--value' End||'" data-k="'||b.FromK||'" href="javascript:void(0);">'
                  ||'<span class="ds-kpi-ic"><span class="fa fa-hourglass-half"></span></span>'
                  ||'<span class="ds-kpi-body"><span class="ds-kpi-t">'||b.Nm||'</span>'
                  ||'<span class="ds-kpi-n">'||to_char(b.Cnt,'FM999G999G990')||'</span>'
                  ||'<span class="ds-kpi-sub">'
                     ||Case When b.ValCr Is Not Null Then '&#8377; '||to_char(b.ValCr,'FM999G990D00')||' Cr &#183; ' Else '' End
                     ||'avg '||to_char(Nvl(b.AvgAge,0),'FM990')||'d &#183; max '||to_char(Nvl(b.MaxAge,0),'FM990')||'d</span>'
                  ||'</span></a>' As CARD
                From B b Order By b.Seq
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
            ]
        }
        layout {
            sequence: 41
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                ds-kpiwrap--5up
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No bottlenecks in this scope.
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region category-chart (
        name: Category Mix
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Nvl(cat.ItemCategoryName, Nvl(isp.ItemCategoryCode,'Uncategorised')) CATEGORY,
                       Round(Sum(d.Amount)/1e7,2) VAL_CR
                  From CCInvoice ci Join CCInvoiceDetail d On d.TNo=ci.TNo
                  Left Join ItemSpecification isp On isp.ItemSpecificationCode = d.ItemSpecificationCode
                  Left Join ItemCategory cat On cat.ItemCategoryCode = isp.ItemCategoryCode
                 Where ci.CCInvoiceDate Between to_date(:P730_FROMDATE,'DD-MM-RRRR') And to_date(:P730_TODATE,'DD-MM-RRRR')
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or ci.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (:P730_COMPANY Is Null Or ci.CompanyCode=:P730_COMPANY)
                   And (:P730_LOCATION Is Null Or ci.LocationCode=:P730_LOCATION)
                   And (:P730_PANEL Is Null Or ci.Panel=:P730_PANEL)
                 Group By Nvl(cat.ItemCategoryName, Nvl(isp.ItemCategoryCode,'Uncategorised'))
                 Order By Sum(d.Amount) Desc
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
            ]
        }
        layout {
            sequence: 60
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 320
        }
        messages {
            whenNoDataFound: No category sales to plot.
        }

        series cat (
            name: Invoiced Value (Rs Cr)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: CATEGORY
                value: VAL_CR
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Cr
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region category-flow (
        name: Category Flow
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                  Select to_date(:P730_FROMDATE,'DD-MM-RRRR') F, to_date(:P730_TODATE,'DD-MM-RRRR') T From dual),
                ConfCat As (
                  Select Distinct sc.TNo t, scd.ItemCategoryCode ccat
                    From SalesConfirm sc Join SalesConfirmDetail scd On scd.TNo=sc.TNo Cross Join Win w
                   Where sc.SalesConfirmDate Between w.F And w.T And scd.ItemCategoryCode Is Not Null
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or sc.Panel=(Select GetUserPanelAB_apex() From dual))
                     And (:P730_COMPANY Is Null Or sc.CompanyCode=:P730_COMPANY)
                     And (:P730_LOCATION Is Null Or sc.LocationCode=:P730_LOCATION)
                     And (:P730_PANEL Is Null Or sc.Panel=:P730_PANEL)),
                OrdCat As (
                  Select Distinct so.SalesConfirmTNo t, isp.ItemCategoryCode ocat
                    From SalesOrder so Join SalesOrderDetail sod On sod.TNo=so.TNo
                    Join ItemSpecification isp On isp.ItemSpecificationCode=sod.ItemSpecificationCode
                   Where so.SalesConfirmTNo Is Not Null And isp.ItemCategoryCode Is Not Null)
                Select Nvl(cc.ItemCategoryName,x.ccat) CONFIRMED_CAT,
                       Nvl(oc.ItemCategoryName,x.ocat) ORDER_CAT,
                       '<span class="ds-pill ds-pill--'||Case When x.ccat=x.ocat Then 'good">Same' Else 'warn">Changed' End||'</span>' MATCH,
                       Count(*) LINKS,
                       '<a href="#" class="ds-cflow-drill" data-c="'||x.ccat||'" data-o="'||x.ocat||'" data-cl="'||Nvl(cc.ItemCategoryName,x.ccat)||'" data-ol="'||Nvl(oc.ItemCategoryName,x.ocat)||'">View lines &rsaquo;</a>' DETAIL,
                       Case When x.ccat=x.ocat Then 1 Else 0 End SAME_ORD
                  From (Select c.ccat, o.ocat From ConfCat c Join OrdCat o On o.t=c.t) x
                  Left Join ItemCategory cc On cc.ItemCategoryCode=x.ccat
                  Left Join ItemCategory oc On oc.ItemCategoryCode=x.ocat
                 Group By x.ccat, x.ocat, cc.ItemCategoryName, oc.ItemCategoryName
                 Order By Case When x.ccat=x.ocat Then 1 Else 0 End, Count(*) Desc
                ```
            pageItemsToSubmit: [
                P730_FROMDATE
                P730_TODATE
                P730_COMPANY
                P730_LOCATION
                P730_PANEL
            ]
        }
        layout {
            sequence: 70
            slot: body
            columnSpan: 12
        }
