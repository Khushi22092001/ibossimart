        type: popupLov
        label {
            label: Vehicle No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select VehicleNo d, VehicleNo r
                  From (
                        Select Distinct Upper(Trim(VehicleNo)) VehicleNo
                          From MaterialIn
                         Where VehicleNo Is Not Null
                        Union
                        Select Distinct Upper(Trim(VehicleNo)) VehicleNo
                          From MaterialOut
                         Where VehicleNo Is Not Null
                       )
                 Where VehicleNo Is Not Null
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All vehicles
        }
