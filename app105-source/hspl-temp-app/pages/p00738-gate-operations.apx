    region vehicles-inside (
        name: Vehicles Currently Inside
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<a href="'||apex_page.get_url(p_page=>732,p_clear_cache=>'732',p_items=>'P732_VEHICLE',p_values=>X.VehicleNo)||'">'||apex_escape.html(X.VehicleNo)||'</a>' Vehicle,
                       X.Direction,X.GateDocument,X.SourceDocument,GetPartyName(X.PartyCode) Party,
                       X.LocationCode Location,X.GateInTime Gate_In,Round((sysdate-X.GateInTime)*24,1) Dwell_Hours,
                       Case When (sysdate-X.GateInTime)*24>12 Then '<span class="go-pill go-pill--bad">Escalate</span>'
                            When (sysdate-X.GateInTime)*24>8 Then '<span class="go-pill go-pill--warn">Delayed</span>'
                            Else '<span class="go-pill go-pill--info">Inside</span>' End Status
                  From (
                    Select 'OUTBOUND' Direction,mo.VehicleNo,mo.MaterialOutNo GateDocument,da.DespatchAdviceNo SourceDocument,mo.PartyCode,mo.LocationCode,mo.GateInTime,mo.CompanyCode,mo.Panel
                      From MaterialOut mo Left Join DespatchAdvice da On da.TNo=mo.ReferenceTNo
                     Where mo.GateInTime>sysdate-2 And mo.GateOutTime Is Null And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','OUTBOUND'))
                    Union All
                    Select 'INBOUND',mi.VehicleNo,mi.MaterialInNo,Nvl(mi.RefDocNo,po.PurchaseOrderNo),mi.PartyCode,mi.LocationCode,mi.GateInTime,mi.CompanyCode,mi.Panel
                      From MaterialIn mi Left Join PurchaseOrder po On po.TNo=mi.PurchaseOrderTNo
                     Where mi.GateInTime>sysdate-2 And mi.GateOutTime Is Null And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','INBOUND'))) X
                 Where (:P738_COMPANY Is Null Or X.CompanyCode=:P738_COMPANY)
                   And (:P738_LOCATION Is Null Or X.LocationCode=:P738_LOCATION)
                   And (:P738_VEHICLE Is Null Or Upper(X.VehicleNo) Like '%'||Upper(:P738_VEHICLE)||'%')
                   And (:P738_PANEL Is Null Or X.Panel=:P738_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or X.Panel=(Select GetUserPanelAB_apex() From dual))
                 Order By X.GateInTime
                ```
