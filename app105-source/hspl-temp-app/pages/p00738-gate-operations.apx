    region operational-kpis (
        name: Gate Operations KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (Select to_date(:P738_FROMDATE,'DD-MM-RRRR') F,to_date(:P738_TODATE,'DD-MM-RRRR')+1 T From dual),
                M As (
                  Select 'OUTBOUND' Direction,mo.TNo,mo.MaterialOutDate DocDate,mo.GateInTime,mo.GateOutTime,mo.CompanyCode,mo.LocationCode,mo.Panel
                    From MaterialOut mo Cross Join Win w
                   Where mo.MaterialOutDate>=w.F And mo.MaterialOutDate<w.T And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','OUTBOUND'))
                     And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION) And (:P738_PANEL Is Null Or mo.Panel=:P738_PANEL)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or mo.Panel=(Select GetUserPanelAB_apex() From dual))
                  Union All
                  Select 'INBOUND',mi.TNo,mi.MaterialInDate,mi.GateInTime,mi.GateOutTime,mi.CompanyCode,mi.LocationCode,mi.Panel
                    From MaterialIn mi Cross Join Win w
                   Where mi.MaterialInDate>=w.F And mi.MaterialInDate<w.T And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','INBOUND'))
                     And (:P738_COMPANY Is Null Or mi.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mi.LocationCode=:P738_LOCATION) And (:P738_PANEL Is Null Or mi.Panel=:P738_PANEL)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or mi.Panel=(Select GetUserPanelAB_apex() From dual))),
                K As (
                  Select Count(*) Movements,
                         Sum(Case When GateOutTime Is Not Null Then 1 Else 0 End) Released,
                         Round(Median(Case When GateOutTime>GateInTime And (GateOutTime-GateInTime)*24 Between 0 And 72 Then (GateOutTime-GateInTime)*24 End),1) MedianDwell,
                         Sum(Case When GateInTime Is Null And GateOutTime Is Not Null Then 1 Else 0 End) MissingGateIn
                    From M),
                LiveK As (
                  Select Sum(Inside) Inside,Sum(Over8) Over8,Sum(Stale) Stale From (
                    Select Count(*) Inside,Sum(Case When (sysdate-mo.GateInTime)*24>8 Then 1 Else 0 End) Over8,0 Stale From MaterialOut mo Where mo.GateInTime>sysdate-2 And mo.GateOutTime Is Null And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','OUTBOUND')) And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION)
                    Union All Select Count(*),Sum(Case When (sysdate-mi.GateInTime)*24>8 Then 1 Else 0 End),0 From MaterialIn mi Where mi.GateInTime>sysdate-2 And mi.GateOutTime Is Null And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','INBOUND')) And (:P738_COMPANY Is Null Or mi.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mi.LocationCode=:P738_LOCATION)
                    Union All Select 0,0,Count(*) From MaterialOut mo Where mo.GateInTime<=sysdate-2 And mo.GateInTime>sysdate-400 And mo.GateOutTime Is Null And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','OUTBOUND')) And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION)
                    Union All Select 0,0,Count(*) From MaterialIn mi Where mi.GateInTime<=sysdate-2 And mi.GateInTime>sysdate-400 And mi.GateOutTime Is Null And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','INBOUND')) And (:P738_COMPANY Is Null Or mi.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mi.LocationCode=:P738_LOCATION)))
                Select Case X.Seq
                  When 1 Then '<a class="go-kpi" href="#p738VisitRegister" onclick="return gateDrill(''INSIDE'')" style="--accent:#0F9F79;--wash:#EAF8F4"><span class="go-kpi__ic"><span class="fa fa-truck"></span></span><span class="go-kpi__t">Vehicles inside</span><span class="go-kpi__n">'||to_char(Nvl(L.Inside,0),'FM999G990')||'</span><span class="go-kpi__badge">Now</span><span class="go-kpi__s">Live 48-hour operational window</span></a>'
                  When 2 Then '<a class="go-kpi" href="#p738VisitRegister" onclick="return gateDrill(''MOVEMENTS'')" style="--accent:#3B82F6;--wash:#EDF4FF"><span class="go-kpi__ic"><span class="fa fa-exchange"></span></span><span class="go-kpi__t">Period movements</span><span class="go-kpi__n">'||to_char(K.Movements,'FM999G990')||'</span><span class="go-kpi__badge">Period</span><span class="go-kpi__s">Inbound + outbound gate records</span></a>'
                  When 3 Then '<a class="go-kpi" href="#p738VisitRegister" onclick="return gateDrill(''RELEASED'')" style="--accent:#10A37F;--wash:#ECF9F5"><span class="go-kpi__ic"><span class="fa fa-sign-out"></span></span><span class="go-kpi__t">Released</span><span class="go-kpi__n">'||to_char(K.Released,'FM999G990')||'</span><span class="go-kpi__badge">Period</span><span class="go-kpi__s">Gate Out recorded in period</span></a>'
                  When 4 Then '<a class="go-kpi" href="#p738VisitRegister" onclick="return gateDrill(''MEDIAN_TAT'')" style="--accent:#0891B2;--wash:#EAF8FB"><span class="go-kpi__ic"><span class="fa fa-clock-o"></span></span><span class="go-kpi__t">Median turnaround</span><span class="go-kpi__n">'||Nvl(to_char(K.MedianDwell,'FM990D0'),'&ndash;')||' h</span><span class="go-kpi__badge">Clean</span><span class="go-kpi__s">Gate In to Gate Out within 72 h</span></a>'
                  When 5 Then '<a class="go-kpi" href="#p738VisitRegister" onclick="return gateDrill(''OVER8'')" style="--accent:#F59E0B;--wash:#FFF6E8"><span class="go-kpi__ic"><span class="fa fa-hourglass-half"></span></span><span class="go-kpi__t">Inside over 8 h</span><span class="go-kpi__n">'||to_char(Nvl(L.Over8,0),'FM999G990')||'</span><span class="go-kpi__badge">Now</span><span class="go-kpi__s">Live vehicles needing attention</span></a>'
                  Else '<a class="go-kpi" href="#p738VisitRegister" onclick="return gateDrill(''HISTORICAL_GAPS'')" style="--accent:#EF4444;--wash:#FEF0F1"><span class="go-kpi__ic"><span class="fa fa-exclamation-triangle"></span></span><span class="go-kpi__t">Historical data gaps</span><span class="go-kpi__n">'||to_char(Nvl(L.Stale,0)+Nvl(K.MissingGateIn,0),'FM999G990')||'</span><span class="go-kpi__badge">Audit</span><span class="go-kpi__s">Stale open or Gate In missing</span></a>' End Card
                  From K Cross Join LiveK L Cross Join (Select Level Seq From dual Connect By Level<=6) X
                 Order By X.Seq
                ```
            pageItemsToSubmit: [
                P738_FROMDATE
                P738_TODATE
                P738_COMPANY
                P738_LOCATION
                P738_DIRECTION
                P738_PANEL
            ]
        }
        layout {
            sequence: 8
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: go-kpis
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

