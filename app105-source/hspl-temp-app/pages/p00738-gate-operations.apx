page 738 (
    name: Gate Operations Command Centre
    alias: GATE-OPERATIONS
    title: Gate Operations Command Centre
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            GATE OPERATIONS COMMAND CENTRE (HSPL). Read-only operational view built from live ERP
            MaterialIn, MaterialOut, DespatchAdvice, Weighment, GRN, DInspection and CCInvoice data.
            A live vehicle is a movement gated in during the last 48 hours without Gate Out. Older
            open rows are shown as historical data-gap exceptions and are never counted as live yard
            occupancy. Clean turnaround uses Gate Out after Gate In with elapsed time up to 72 hours.
            ```
    }

    region action-note (
        name: Yard Action Note
        type: staticContent
        source {
            htmlCode: <div class="go-section"><h2>Yard Action Centre</h2><p>Open visits are separated from legacy gaps so the gate team can act on the right vehicles first.</p></div>
        }
        layout {
            sequence: 9
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region command-header (
        name: Gate Operations Command Centre
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="go-command"><div class="go-command__main">'
                  ||'<span class="go-command__icon"><span class="fa fa-random"></span></span><div>'
                  ||'<span class="go-command__eye">Yard &middot; Gate &middot; Weighbridge</span><h1>Gate Operations Command Centre</h1>'
                  ||'<p>One operational view of inbound and outbound vehicle visits &mdash; gate entry, weighment, downstream documents, release and actionable data gaps.</p></div></div>'
                  ||'<div class="go-command__proof"><span class="go-chip"><span class="fa fa-database"></span><b>Live ERP</b> source</span>'
                  ||'<span class="go-chip"><span class="fa fa-clock-o"></span>As at <b>'||to_char(sysdate,'DD Mon YYYY HH24:MI')||'</b></span>'
                  ||'<span class="go-chip"><span class="fa fa-shield"></span><b>Read only</b></span></div></div>' AS HEAD
                  From dual
                ```
        }
        layout {
            sequence: 2
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: go-command-region
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region data-proof (
        name: Data Scope
        type: staticContent
        source {
            htmlCode: <div class="go-proof"><b>Operational rule:</b> “Inside” means Gate In recorded in the last 48 hours with no Gate Out. Older open rows are isolated as historical data gaps. Turnaround uses only clean 0&ndash;72 hour Gate In to Gate Out records. This prevents legacy incomplete rows from inflating the live yard count.</div>
        }
        layout {
            sequence: 4
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region exceptions (
        name: Gate Exception Centre
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With E As (
                  Select 1 Seq,'Critical' Severity,'Historical open Gate Out' Exception_Type,Count(*) Records,'Open over 48 hours; excluded from live occupancy' Meaning,'EXC_HISTORICAL_OPEN' Focus
                    From MaterialOut mo Where mo.GateInTime<=sysdate-2 And mo.GateInTime>sysdate-400 And mo.GateOutTime Is Null And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION)
                  Union All Select 2,'Critical','Gate Out without Gate In',Count(*),'Timestamp sequence is incomplete','EXC_GATEOUT_NO_GATEIN'
                    From MaterialOut mo Where mo.GateInTime Is Null And mo.GateOutTime Is Not Null And mo.MaterialOutDate Between to_date(:P738_FROMDATE,'DD-MM-RRRR') And to_date(:P738_TODATE,'DD-MM-RRRR') And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION)
                  Union All Select 3,'High','Final weighment pending',Count(*),'First weight exists but second weight is missing','EXC_FINAL_PENDING'
                    From Weighment w Where w.WeighmentDate>sysdate-30 And w.FirstWeight Is Not Null And w.SecondWeight Is Null And (:P738_COMPANY Is Null Or w.CompanyCode=:P738_COMPANY)
                  Union All Select 4,'High','Outbound Gate Out not invoiced',Count(*),'Released vehicle has no downstream CC Invoice','EXC_OUT_NO_INVOICE'
                    From MaterialOut mo Join DespatchAdvice da On da.TNo=mo.ReferenceTNo
                   Where mo.GateOutTime Is Not Null And mo.MaterialOutDate Between to_date(:P738_FROMDATE,'DD-MM-RRRR') And to_date(:P738_TODATE,'DD-MM-RRRR')
                     And Not Exists (Select 1 From CCInvoice ci Where ci.DespatchAdviceTNo=da.TNo) And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION)
                  Union All Select 5,'Medium','Inbound Gate Out without GRN',Count(*),'Material In released without a linked GRN','EXC_IN_NO_GRN'
                    From MaterialIn mi Where mi.GateOutTime Is Not Null And mi.MaterialInDate Between to_date(:P738_FROMDATE,'DD-MM-RRRR') And to_date(:P738_TODATE,'DD-MM-RRRR')
                     And Not Exists (Select 1 From GRN g Where g.MaterialInTNo=mi.TNo) And (:P738_COMPANY Is Null Or mi.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mi.LocationCode=:P738_LOCATION))
                Select '<span class="go-pill go-pill--'||Case Severity When 'Critical' Then 'bad' When 'High' Then 'warn' Else 'info' End||'">'||Severity||'</span>' Severity,
                       Exception_Type,
                       '<a class="go-count-link" href="#p738VisitRegister" onclick="return gateDrill('''||Focus||''')">'||to_char(Records,'FM999G990')||'</a>' Records,
                       Meaning,
                       '<a href="#p738VisitRegister" onclick="return gateDrill('''||Focus||''')">View filtered register &rarr;</a>' Action
                  From E Where Records>0 Order By Seq
                ```
            pageItemsToSubmit: [
                P738_FROMDATE
                P738_TODATE
                P738_COMPANY
                P738_LOCATION
            ]
        }
        layout {
            sequence: 23
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                go-panel
                go-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No gate exceptions in this scope.
        }

        column ACTION (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Drilldown
            }
            layout {
                sequence: 50
            }
            security {
                escapeSpecialChars: false
            }
        )

        column EXCEPTION_TYPE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Exception
            }
            layout {
                sequence: 20
            }
        )

        column MEANING (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Why it matters
            }
            layout {
                sequence: 40
            }
        )

        column RECORDS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Records
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            security {
                escapeSpecialChars: false
            }
        )

        column SEVERITY (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Severity
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region filter-panel (
        name: Filters
        type: staticContent
        layout {
            sequence: 3
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
            cssClasses: go-filter
        }
    )

    region gate-theme (
        name: Gate Operations Theme
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                body:has(.go-command){--go-navy:#173B57;--go-blue:#216A8A;--go-teal:#0F766E;--go-cyan:#0891B2;--go-green:#15803D;--go-amber:#B45309;--go-red:#C2413B;--go-ink:#102A43;--go-muted:#62748A;--go-line:#DCE6EE;--go-bg:#F4F8FB}
                body:has(.go-command) .t-Body-title{display:none!important}
                body:has(.go-command) .t-Body-main{background:linear-gradient(180deg,#F7FAFC 0,#F3F7FA 100%)}
                .go-command{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px 24px;border:1px solid #CFE0E9;border-radius:18px;background:radial-gradient(85% 150% at 96% 5%,rgba(8,145,178,.20),transparent 58%),linear-gradient(120deg,#E9F4F8,#F5FAFC 58%,#E8F5F2);box-shadow:0 12px 30px rgba(23,59,87,.10)}
                .go-command__main{display:flex;align-items:center;gap:16px}.go-command__icon{display:grid;place-items:center;width:58px;height:58px;border-radius:16px;color:#fff;font-size:23px;background:linear-gradient(135deg,var(--go-blue),var(--go-teal));box-shadow:0 10px 22px rgba(15,118,110,.25)}
                .go-command__eye{font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--go-teal)}.go-command h1{margin:2px 0 3px;font-size:26px;line-height:1.12;color:var(--go-ink)}.go-command p{margin:0;color:#49667A;font-size:13px;line-height:1.45;max-width:72ch}
                .go-command__proof{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}.go-chip{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid #C9DFE5;border-radius:999px;background:rgba(255,255,255,.78);font-size:11px;color:#31566A;white-space:nowrap}.go-chip b{color:var(--go-ink)}
                .go-filter.t-Region{border:1px solid var(--go-line);border-radius:16px;box-shadow:0 5px 15px rgba(16,42,67,.05);overflow:hidden}.go-filter .t-Region-body{padding:16px 18px 12px}.go-filter .t-Form-label{font-size:12px;font-weight:700;color:#405B6E}.go-filter .apex-item-text,.go-filter .apex-item-select,.go-filter .apex-item-group{min-height:42px}
                .go-section{margin:12px 0 6px;padding-left:13px;border-left:4px solid var(--go-teal)}.go-section h2{margin:0 0 3px;font-size:18px;color:#133F3B}.go-section p{margin:0;color:#6B7F91;font-size:12.5px;line-height:1.45}
                .go-stage-grid .t-Report-report,.go-kpis .t-Report-report{display:block;width:100%;border:0;overflow:visible}.go-stage-grid .t-Report-report>tbody{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:34px;width:100%;padding:4px 6px 8px}.go-stage-grid .t-Report-report>tbody>tr,.go-kpis .t-Report-report>tbody>tr{display:block;min-width:0;overflow:visible}.go-stage-grid .t-Report-colHead,.go-stage-grid .t-Report-pagination{display:none}.go-stage-grid .t-Report-cell,.go-kpis .t-Report-cell{display:block;height:100%;padding:0;border:0;overflow:visible}.go-stage{--accent:#0F9F79;--wash:#E8F8F2;position:relative;display:flex;height:100%;min-height:190px;padding:16px 13px 15px;border:1px solid #E1E8EF;border-radius:14px;background:linear-gradient(180deg,#fff 0%,#fff 70%,var(--wash) 165%);overflow:visible;box-shadow:0 8px 22px rgba(30,55,85,.07);color:inherit;text-decoration:none;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}.go-stage:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--accent) 35%,#DCE5EC);box-shadow:0 12px 28px rgba(30,55,85,.12)}
                .go-stage:after{content:"";position:absolute;z-index:1;top:50%;right:-35px;width:35px;border-top:2px dashed color-mix(in srgb,var(--accent) 55%,#DCE8EB);pointer-events:none}.go-stage:before{content:"\203A";position:absolute;z-index:2;top:calc(50% - 12px);right:-28px;display:grid;place-items:center;width:24px;height:24px;border-radius:50%;color:#fff;background:var(--accent);font-size:23px;line-height:1;box-shadow:0 4px 10px color-mix(in srgb,var(--accent) 24%,transparent);pointer-events:none}.go-stage-grid .t-Report-report>tbody>tr:last-child .go-stage:after,.go-stage-grid .t-Report-report>tbody>tr:last-child .go-stage:before{display:none}.go-stage__top{display:flex;align-items:center;justify-content:center}.go-stage__ic{display:grid;place-items:center;width:46px;height:46px;border-radius:50%;color:var(--accent);background:var(--wash);font-size:20px}.go-stage__pulse{display:none}.go-stage__label{display:block;margin-top:17px;font-size:10.5px;font-weight:800;line-height:1.25;letter-spacing:.045em;text-align:center;text-transform:uppercase;color:#294661}.go-stage__value{display:block;margin-top:9px;font-size:28px;font-weight:800;line-height:1.05;text-align:center;color:#102A43}.go-stage__sub{display:block;margin-top:9px;font-size:11px;line-height:1.35;text-align:center;color:#637A90}.go-stage:focus-visible,.go-kpi:focus-visible{outline:3px solid color-mix(in srgb,var(--accent) 30%,transparent);outline-offset:2px}
                @keyframes goPulse{70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}
                .go-kpis{padding:12px;border:1px solid #E4EAF0;border-radius:15px;background:#fff;box-shadow:0 8px 22px rgba(16,42,67,.055)}.go-kpis .t-Report-report>tbody{display:grid;grid-template-columns:repeat(6,minmax(150px,1fr));gap:10px;width:100%}.go-kpis .t-Report-colHead,.go-kpis .t-Report-pagination{display:none}.go-kpi{height:100%;min-height:102px;padding:13px 12px;border:1px solid #E3EAF0;border-radius:12px;background:linear-gradient(145deg,var(--wash,#F1FAF8),#fff 72%);box-shadow:0 4px 12px rgba(16,42,67,.045);display:grid;grid-template-columns:38px minmax(0,1fr) auto;grid-template-rows:auto auto auto;column-gap:10px;align-items:center;color:inherit;text-decoration:none;transition:transform .16s ease,box-shadow .16s ease}.go-kpi:hover{transform:translateY(-2px);box-shadow:0 9px 20px rgba(16,42,67,.10)}.go-kpi__ic{grid-row:1/4;display:grid;place-items:center;width:38px;height:38px;border-radius:11px;color:var(--accent,var(--go-teal));background:color-mix(in srgb,var(--accent,var(--go-teal)) 11%,#fff);font-size:17px}.go-kpi__t{grid-column:2/4;display:block;margin:0 0 4px;font-size:10px;font-weight:800;line-height:1.25;letter-spacing:.025em;color:#294661}.go-kpi__n{grid-column:2;display:block;margin-top:1px;font-size:24px;font-weight:800;line-height:1.05;color:#102A43}.go-kpi__badge{grid-column:3;display:inline-flex;padding:3px 7px;border-radius:999px;background:color-mix(in srgb,var(--accent,var(--go-teal)) 12%,#fff);color:var(--accent,var(--go-teal));font-size:9.5px;font-weight:800}.go-kpi__s{grid-column:2/4;display:block;margin-top:5px;font-size:10.5px;line-height:1.3;color:#73869A}
                .go-panel.t-Region{border:1px solid var(--go-line);border-radius:16px;box-shadow:0 8px 22px rgba(16,42,67,.06);overflow:hidden}.go-panel .t-Region-header{background:#fff}.go-panel .t-Region-title{font-size:16px;color:var(--go-ink)}.go-register .a-IRR-tableContainer{overflow:auto!important}.go-register .t-Report-report,.go-register .a-IRR-table{width:100%;border-collapse:separate;border-spacing:0;table-layout:auto}.go-register .t-Report-colHead,.go-register .a-IRR-header{position:static!important;background:#E9F1F6;color:#214E68;font-size:10.5px;letter-spacing:.055em;text-transform:uppercase;vertical-align:middle}.go-register .t-Report-cell,.go-register .a-IRR-table td{border-color:#DCE6EE;vertical-align:middle}.go-register a{font-weight:700;color:#0B7480}.go-count-link{display:inline-flex;align-items:center;gap:6px;color:#0B7480!important;text-decoration:none}.go-count-link:after{content:"\203A";font-size:18px}.go-pill{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border-radius:999px;font-size:10.5px;font-weight:800}.go-pill:before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}.go-pill--good{color:#15803D;background:#E8F6EC}.go-pill--warn{color:#B45309;background:#FFF3DE}.go-pill--bad{color:#C2413B;background:#FDEBEC}.go-pill--info{color:#036B84;background:#E6F5F8}.go-pill--muted{color:#64748B;background:#EEF2F6}
                .go-proof{padding:11px 14px;border:1px solid #D7E5EC;border-radius:12px;background:#F8FBFC;color:#556D7E;font-size:11.5px;line-height:1.45}.go-proof b{color:#193E55}.go-shortcuts{display:flex;flex-wrap:wrap;gap:8px}.go-shortcuts a{display:inline-flex;align-items:center;gap:7px;padding:9px 12px;border:1px solid #CFE0E8;border-radius:11px;background:#fff;color:#214E68;font-size:11.5px;font-weight:700;text-decoration:none;transition:.15s ease}.go-shortcuts a:hover{transform:translateY(-1px);border-color:#62B8BA;box-shadow:0 5px 12px rgba(15,118,110,.12)}
                @media(max-width:1200px){.go-kpis .t-Report-report>tbody{grid-template-columns:repeat(3,1fr)}.go-stage-grid .t-Report-report>tbody{grid-template-columns:repeat(5,minmax(145px,1fr));overflow-x:auto}.go-stage:after,.go-stage:before{display:none}}
                @media(max-width:760px){.go-command{align-items:flex-start;flex-direction:column}.go-command__proof{justify-content:flex-start}.go-stage-grid .t-Report-report>tbody,.go-kpis .t-Report-report>tbody{grid-template-columns:1fr 1fr}}
                @media(max-width:480px){.go-stage-grid .t-Report-report>tbody,.go-kpis .t-Report-report>tbody{grid-template-columns:1fr}}
                @media(prefers-reduced-motion:reduce){.go-stage__pulse{animation:none}.go-shortcuts a{transition:none}}
                </style>
                <script>
                window.gateDrill=function(focus){
                  apex.item('P738_STAGE_FOCUS').setValue(focus||'ALL');
                  var labels={GATEOUT_TODAY:'Gate-outs Today',INSIDE:'Vehicles Currently Inside',FIRST_PENDING:'First Weighment Pending',READY_RELEASE:'Ready for Release',FINAL_PENDING:'Final Weighment Pending',MEDIAN_TAT:'Clean Turnaround Visits',RELEASED:'Released Vehicles',MOVEMENTS:'Period Movements',OVER8:'Vehicles Inside Over 8 Hours',HISTORICAL_GAPS:'Historical Data Gaps',EXC_HISTORICAL_OPEN:'Historical Open Gate Out',EXC_GATEOUT_NO_GATEIN:'Gate Out Without Gate In',EXC_FINAL_PENDING:'Final Weighment Pending',EXC_OUT_NO_INVOICE:'Outbound Gate Out Not Invoiced',EXC_IN_NO_GRN:'Inbound Gate Out Without GRN'};
                  var $r=$('#p738VisitRegister');
                  $('#p738VisitRegister_heading').text((labels[focus]||'Vehicle Visit')+' — Detail Register');
                  $r.one('apexafterrefresh',function(){this.scrollIntoView({behavior:'smooth',block:'start'});});
                  apex.region('p738VisitRegister').refresh();
                  return false;
                };
                $(document).on('click','#APPLY,#RESETFILTERS',function(){apex.item('P738_STAGE_FOCUS').setValue('ALL');});
                </script>
                ```
        }
        layout {
            sequence: 1
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region live-note (
        name: Live Yard Note
        type: staticContent
        source {
            htmlCode: <div class="go-section"><h2>Live Gate Position</h2><p>Current operational handoffs. Counts are driven by gate and weighbridge timestamps, independent of the historical date window.</p></div>
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region live-stage-strip (
        name: Live Gate Stage Strip
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Scope As (
                  Select 'OUTBOUND' Direction,mo.TNo,mo.CompanyCode,mo.LocationCode,mo.Panel,mo.GateInTime,mo.GateOutTime,mo.ReferenceTNo,mo.VehicleNo
                    From MaterialOut mo
                   Where mo.GateInTime>sysdate-2 And mo.GateOutTime Is Null
                     And (:P738_DIRECTION Is Null Or :P738_DIRECTION='ALL' Or :P738_DIRECTION='OUTBOUND')
                     And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY)
                     And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION)
                     And (:P738_PANEL Is Null Or mo.Panel=:P738_PANEL)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or mo.Panel=(Select GetUserPanelAB_apex() From dual))
                  Union All
                  Select 'INBOUND',mi.TNo,mi.CompanyCode,mi.LocationCode,mi.Panel,mi.GateInTime,mi.GateOutTime,mi.TNo,mi.VehicleNo
                    From MaterialIn mi
                   Where mi.GateInTime>sysdate-2 And mi.GateOutTime Is Null
                     And (:P738_DIRECTION Is Null Or :P738_DIRECTION='ALL' Or :P738_DIRECTION='INBOUND')
                     And (:P738_COMPANY Is Null Or mi.CompanyCode=:P738_COMPANY)
                     And (:P738_LOCATION Is Null Or mi.LocationCode=:P738_LOCATION)
                     And (:P738_PANEL Is Null Or mi.Panel=:P738_PANEL)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or mi.Panel=(Select GetUserPanelAB_apex() From dual))),
                Stages As (
                  Select 1 Seq,'fa-sign-out' Icon,'Gate-outs today' Lbl,
                         (Select Count(*) From MaterialOut mo Where mo.GateOutTime>=trunc(sysdate) And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION) And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','OUTBOUND')))
                       + (Select Count(*) From MaterialIn mi Where mi.GateOutTime>=trunc(sysdate) And (:P738_COMPANY Is Null Or mi.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mi.LocationCode=:P738_LOCATION) And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','INBOUND'))) Val,
                         'Inbound and outbound releases' Sub,'GATEOUT_TODAY' Focus,'#0F9F79' Accent,'#E8F8F2' Wash From dual
                  Union All
                  Select 2,'fa-sign-in','Vehicles inside',Count(*),'Gate In recorded; Gate Out pending','INSIDE','#3B82F6','#EAF2FF' From Scope
                  Union All
                  Select 3,'fa-balance-scale','First weigh pending',Count(*),'Inside without a first weighment','FIRST_PENDING','#F59E0B','#FFF3E2'
                    From Scope s Where (s.Direction='OUTBOUND' And Not Exists (Select 1 From Weighment w Where (w.ReferenceTNo=s.ReferenceTNo Or w.DespatchAdviceTNo=s.ReferenceTNo) And w.FirstWeight Is Not Null))
                                      Or (s.Direction='INBOUND' And Not Exists (Select 1 From Weighment w Where (w.MaterialInTNo=s.TNo Or w.ReferenceTNo=s.TNo) And w.FirstWeight Is Not Null))
                  Union All
                  Select 4,'fa-check-circle','Ready for release',Count(*),'Final weight recorded; Gate Out pending','READY_RELEASE','#10A37F','#E8F8F2'
                    From Scope s Where (s.Direction='OUTBOUND' And Exists (Select 1 From Weighment w Where (w.ReferenceTNo=s.ReferenceTNo Or w.DespatchAdviceTNo=s.ReferenceTNo) And w.SecondWeight Is Not Null))
                                      Or (s.Direction='INBOUND' And Exists (Select 1 From Weighment w Where (w.MaterialInTNo=s.TNo Or w.ReferenceTNo=s.TNo) And w.SecondWeight Is Not Null))
                  Union All
                  Select 5,'fa-hourglass-half','Final weigh pending',Count(*),'First weight done; second pending','FINAL_PENDING','#8B5CF6','#F1EBFF'
                    From Weighment w Where w.WeighmentDate>sysdate-2 And w.FirstWeight Is Not Null And w.SecondWeight Is Null
                     And (:P738_COMPANY Is Null Or w.CompanyCode=:P738_COMPANY) And (:P738_PANEL Is Null Or w.Panel=:P738_PANEL)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or w.Panel=(Select GetUserPanelAB_apex() From dual)))
                Select '<a class="go-stage" style="--accent:'||Accent||';--wash:'||Wash||'" href="#p738VisitRegister" onclick="return gateDrill('''||Focus||''')">'
                  ||'<div class="go-stage__top"><span class="go-stage__ic"><span class="fa '||Icon||'"></span></span><span class="go-stage__pulse"></span></div>'
                  ||'<span class="go-stage__label">'||Lbl||'</span><span class="go-stage__value">'||to_char(Val,'FM999G990')||'</span><span class="go-stage__sub">'||Sub||'</span></a>' Card
                  From Stages
                ```
            pageItemsToSubmit: [
                P738_COMPANY
                P738_LOCATION
                P738_DIRECTION
                P738_PANEL
            ]
        }
