    region visit-register (
        name: Vehicle Visit Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (Select to_date(:P738_FROMDATE,'DD-MM-RRRR') F,to_date(:P738_TODATE,'DD-MM-RRRR')+1 T From dual),
                Visits As (
                  Select 'OUTBOUND' Direction,mo.MaterialOutNo Gate_Document,mo.MaterialOutDate Visit_Date,mo.VehicleNo,GetPartyName(Nvl(mo.PartyCode,da.PartyCode)) Party,
                         da.DespatchAdviceNo Source_Document,mo.GateInTime,mo.GateOutTime,
                         (Select Max(w.WeighmentNo) Keep (Dense_Rank Last Order By w.WeighmentDate,w.TNo) From Weighment w Where w.ReferenceTNo=mo.ReferenceTNo) Weighment_No,
                         (Select Max(ci.CCInvoiceNo) From CCInvoice ci Where ci.DespatchAdviceTNo=da.TNo) Downstream_Document,
                         mo.LocationCode,mo.CompanyCode,mo.Panel,mo.TNo Gate_TNo,mo.ReferenceTNo Reference_TNo
                    From MaterialOut mo Cross Join Win x Left Join DespatchAdvice da On da.TNo=mo.ReferenceTNo
                   Where mo.MaterialOutDate>=x.F And mo.MaterialOutDate<x.T And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','OUTBOUND'))
                  Union All
                  Select 'INBOUND',mi.MaterialInNo,mi.MaterialInDate,mi.VehicleNo,GetPartyName(mi.PartyCode),Nvl(mi.RefDocNo,po.PurchaseOrderNo),mi.GateInTime,mi.GateOutTime,
                         (Select Max(w.WeighmentNo) Keep (Dense_Rank Last Order By w.WeighmentDate,w.TNo) From Weighment w Where w.MaterialInTNo=mi.TNo Or w.ReferenceTNo=mi.TNo),
                         (Select Max(g.GRNNo) Keep (Dense_Rank Last Order By g.GRNDate,g.TNo) From GRN g Where g.MaterialInTNo=mi.TNo),mi.LocationCode,mi.CompanyCode,mi.Panel,mi.TNo,mi.TNo
                    From MaterialIn mi Cross Join Win x Left Join PurchaseOrder po On po.TNo=mi.PurchaseOrderTNo
                   Where mi.MaterialInDate>=x.F And mi.MaterialInDate<x.T And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','INBOUND')))
                Select Direction,Gate_Document,Visit_Date,
                       Case When VehicleNo Is Not Null Then '<a href="'||apex_page.get_url(p_page=>732,p_clear_cache=>'732',p_items=>'P732_VEHICLE',p_values=>VehicleNo)||'">'||apex_escape.html(VehicleNo)||'</a>' End Vehicle,
                       Party,Source_Document,GateInTime Gate_In,GateOutTime Gate_Out,
                       Case When GateInTime Is Not Null Then Round((Nvl(GateOutTime,sysdate)-GateInTime)*24,1) End Dwell_Hours,
                       Weighment_No,Downstream_Document,
                       Case When GateInTime Is Null And GateOutTime Is Not Null Then '<span class="go-pill go-pill--bad">Gate In missing</span>'
                            When GateInTime Is Null Then '<span class="go-pill go-pill--muted">Not gated</span>'
                            When GateOutTime Is Null And GateInTime<=sysdate-2 Then '<span class="go-pill go-pill--bad">Historical open</span>'
                            When GateOutTime Is Null Then '<span class="go-pill go-pill--warn">Inside</span>'
                            Else '<span class="go-pill go-pill--good">Completed</span>' End Status
                  From Visits V
                 Where (:P738_COMPANY Is Null Or V.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or V.LocationCode=:P738_LOCATION)
                   And (:P738_VEHICLE Is Null Or Upper(V.VehicleNo) Like '%'||Upper(:P738_VEHICLE)||'%') And (:P738_PANEL Is Null Or V.Panel=:P738_PANEL)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or V.Panel=(Select GetUserPanelAB_apex() From dual))
                   And (
                        Nvl(:P738_STAGE_FOCUS,'ALL') In ('ALL','MOVEMENTS')
                        Or (:P738_STAGE_FOCUS='GATEOUT_TODAY' And V.GateOutTime>=trunc(sysdate))
                        Or (:P738_STAGE_FOCUS='INSIDE' And V.GateInTime>sysdate-2 And V.GateOutTime Is Null)
                        Or (:P738_STAGE_FOCUS='FIRST_PENDING' And V.GateInTime>sysdate-2 And V.GateOutTime Is Null And Not Exists (
                              Select 1 From Weighment w Where w.FirstWeight Is Not Null And
                                ((V.Direction='OUTBOUND' And (w.ReferenceTNo=V.Reference_TNo Or w.DespatchAdviceTNo=V.Reference_TNo))
                                  Or (V.Direction='INBOUND' And (w.MaterialInTNo=V.Gate_TNo Or w.ReferenceTNo=V.Gate_TNo)))))
                        Or (:P738_STAGE_FOCUS='READY_RELEASE' And V.GateInTime>sysdate-2 And V.GateOutTime Is Null And Exists (
                              Select 1 From Weighment w Where w.SecondWeight Is Not Null And
                                ((V.Direction='OUTBOUND' And (w.ReferenceTNo=V.Reference_TNo Or w.DespatchAdviceTNo=V.Reference_TNo))
                                  Or (V.Direction='INBOUND' And (w.MaterialInTNo=V.Gate_TNo Or w.ReferenceTNo=V.Gate_TNo)))))
                        Or (:P738_STAGE_FOCUS In ('FINAL_PENDING','EXC_FINAL_PENDING') And Exists (
                              Select 1 From Weighment w Where w.FirstWeight Is Not Null And w.SecondWeight Is Null And
                                ((V.Direction='OUTBOUND' And (w.ReferenceTNo=V.Reference_TNo Or w.DespatchAdviceTNo=V.Reference_TNo))
                                  Or (V.Direction='INBOUND' And (w.MaterialInTNo=V.Gate_TNo Or w.ReferenceTNo=V.Gate_TNo)))))
                        Or (:P738_STAGE_FOCUS='MEDIAN_TAT' And V.GateOutTime>V.GateInTime And (V.GateOutTime-V.GateInTime)*24 Between 0 And 72)
                        Or (:P738_STAGE_FOCUS='RELEASED' And V.GateOutTime Is Not Null)
                        Or (:P738_STAGE_FOCUS='OVER8' And V.GateInTime>sysdate-2 And V.GateOutTime Is Null And (sysdate-V.GateInTime)*24>8)
                        Or (:P738_STAGE_FOCUS='HISTORICAL_GAPS' And ((V.GateInTime<=sysdate-2 And V.GateOutTime Is Null) Or (V.GateInTime Is Null And V.GateOutTime Is Not Null)))
                        Or (:P738_STAGE_FOCUS='EXC_HISTORICAL_OPEN' And V.Direction='OUTBOUND' And V.GateInTime<=sysdate-2 And V.GateOutTime Is Null)
                        Or (:P738_STAGE_FOCUS='EXC_GATEOUT_NO_GATEIN' And V.Direction='OUTBOUND' And V.GateInTime Is Null And V.GateOutTime Is Not Null)
                        Or (:P738_STAGE_FOCUS='EXC_OUT_NO_INVOICE' And V.Direction='OUTBOUND' And V.GateOutTime Is Not Null And V.Downstream_Document Is Null)
                        Or (:P738_STAGE_FOCUS='EXC_IN_NO_GRN' And V.Direction='INBOUND' And V.GateOutTime Is Not Null And V.Downstream_Document Is Null)
                       )
                 Order By Visit_Date Desc,Gate_Document Desc
                ```
            pageItemsToSubmit: [
                P738_FROMDATE
                P738_TODATE
                P738_COMPANY
                P738_LOCATION
                P738_DIRECTION
                P738_VEHICLE
                P738_PANEL
                P738_STAGE_FOCUS
            ]
        }
