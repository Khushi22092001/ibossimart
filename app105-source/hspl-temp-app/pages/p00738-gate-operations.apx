    region weighment-control (
        name: Weighment Control
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (Select to_date(:P738_FROMDATE,'DD-MM-RRRR') F,to_date(:P738_TODATE,'DD-MM-RRRR')+1 T From dual),
                K As (Select Count(*) Total,Sum(Case When FirstWeight Is Not Null Then 1 Else 0 End) FirstDone,
                             Sum(Case When SecondWeight Is Not Null Then 1 Else 0 End) FinalDone,
                             Sum(Case When FirstWeight Is Not Null And SecondWeight Is Null Then 1 Else 0 End) FinalPending
                        From Weighment w Cross Join Win x Where w.WeighmentDate>=x.F And w.WeighmentDate<x.T
                         And (:P738_COMPANY Is Null Or w.CompanyCode=:P738_COMPANY) And (:P738_PANEL Is Null Or w.Panel=:P738_PANEL)
                         And ((Select GetUserPanelAB_apex() From dual) Is Null Or w.Panel=(Select GetUserPanelAB_apex() From dual)))
                Select '<div class="go-proof"><b>Weighments:</b> '||to_char(Total,'FM999G990')
                  ||' &nbsp; &middot; &nbsp; <b>First weight:</b> '||to_char(FirstDone,'FM999G990')
                  ||' &nbsp; &middot; &nbsp; <b>Final weight:</b> '||to_char(FinalDone,'FM999G990')
                  ||' &nbsp; &middot; &nbsp; <b>Awaiting final:</b> '||to_char(FinalPending,'FM999G990')
                  ||' &nbsp; <a href="'||apex_page.get_url(p_page=>314,p_clear_cache=>'314')||'">Open Weighment Register &rarr;</a></div>' Card From K
                ```
            pageItemsToSubmit: [
                P738_FROMDATE
                P738_TODATE
                P738_COMPANY
                P738_PANEL
            ]
        }
        layout {
            sequence: 22
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: go-panel
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        performance {
            lazyLoading: true
        }

        column CARD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

