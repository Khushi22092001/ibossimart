    region throughput-trend (
        name: Weekly Gate Throughput Trend
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (Select to_date(:P738_FROMDATE,'DD-MM-RRRR') F,to_date(:P738_TODATE,'DD-MM-RRRR')+1 T From dual),
                X As (
                  Select Trunc(mo.GateOutTime,'IW') D,1 Outbound,0 Inbound From MaterialOut mo Cross Join Win w
                   Where mo.GateOutTime>=w.F And mo.GateOutTime<w.T And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','OUTBOUND'))
                     And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION) And (:P738_PANEL Is Null Or mo.Panel=:P738_PANEL)
                  Union All
                  Select Trunc(mi.GateOutTime,'IW'),0,1 From MaterialIn mi Cross Join Win w
                   Where mi.GateOutTime>=w.F And mi.GateOutTime<w.T And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','INBOUND'))
                     And (:P738_COMPANY Is Null Or mi.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mi.LocationCode=:P738_LOCATION) And (:P738_PANEL Is Null Or mi.Panel=:P738_PANEL))
                Select to_char(D,'DD Mon')||' - '||to_char(D+6,'DD Mon') Week_Label,
                       Sum(Outbound) Outbound,Sum(Inbound) Inbound,D Sort_Date
                  From X Group By D Order By D
