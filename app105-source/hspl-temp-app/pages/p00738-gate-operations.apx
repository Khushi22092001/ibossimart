    region tat-by-direction (
        name: Turnaround by Direction
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (Select to_date(:P738_FROMDATE,'DD-MM-RRRR') F,to_date(:P738_TODATE,'DD-MM-RRRR')+1 T From dual),
                X As (
                  Select 'Outbound' Direction,(mo.GateOutTime-mo.GateInTime)*24 Hrs From MaterialOut mo Cross Join Win w
                   Where mo.GateOutTime>=w.F And mo.GateOutTime<w.T And mo.GateOutTime>mo.GateInTime And (mo.GateOutTime-mo.GateInTime)*24 Between 0 And 72
                     And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','OUTBOUND')) And (:P738_COMPANY Is Null Or mo.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mo.LocationCode=:P738_LOCATION)
                  Union All
                  Select 'Inbound',(mi.GateOutTime-mi.GateInTime)*24 From MaterialIn mi Cross Join Win w
                   Where mi.GateOutTime>=w.F And mi.GateOutTime<w.T And mi.GateOutTime>mi.GateInTime And (mi.GateOutTime-mi.GateInTime)*24 Between 0 And 72
                     And (:P738_DIRECTION Is Null Or :P738_DIRECTION in ('ALL','INBOUND')) And (:P738_COMPANY Is Null Or mi.CompanyCode=:P738_COMPANY) And (:P738_LOCATION Is Null Or mi.LocationCode=:P738_LOCATION))
                Select Direction,Round(Median(Hrs),1) Median_Hours From X Group By Direction Order By Direction
                ```
            pageItemsToSubmit: [
