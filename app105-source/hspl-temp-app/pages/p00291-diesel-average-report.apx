page 291 (
    name: Diesel Average Report
    alias: DIESEL-AVERAGE-REPORT
    title: Diesel Average Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'CMPL/REPORT/NecessitySlip.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P291_FROMDATE').val());
              var toDate = new Date($('#P291_TODATE').val());
            
              var reportParams = 
                '&P291_FROMDATE='  +  $('#P291_FROMDATE').val() +
                '&P291_TODATE='  +  $('#P291_TODATE').val() +
                '&P291_LOCATION=' +  $('#P291_LOCATION').val() +
                '&P291_SHIFT='+ $('#P291_SHIFT').val() +
                '&P291_VEHICLETYPE='+ $('#P291_VEHICLETYPE').val() +
                '&P291_STORAGELOCATION=' + $('#P291_STORAGELOCATION').val() +
                '&P291_DRIVER=' + $('#P291_DRIVER').val() 
                ;
              
              //var reportURL = 'http://192.168.1.202:7001/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/' + reportName +
              //var reportURL = 'http://192.168.1.202:7001/xmlpserver/CMPL/REPORT/PCReport.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              reportURL = 'http://115.242.138.210:7001/xmlpserver/'+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region diesel-average (
        name: "Diesel Average "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region diesel-average-report (
        name: Diesel Average Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT ROWNUM AS SERIALNO , XX.* FROM
                (
                Select
                	trunc(a.NecessitySlipDate) as NecessitySlipDate,
                	a.VehicleNo,
                	f.EquipmentGroupName as VehicleTypeName,
                	e.EquipmentID as DoorNo,
                  a.ShiftCode,
                  d.ShiftName,
                  a.LocationCode,
                  g.LocationName,
                	round(sum(aa.Quantity1), 3) as HSDQty,
                	round(sum(a.PreviousVehicleMeterReading), 2) as OpeningKm,
                	round(sum(a.MeterReading), 2) as ClosingKm,
                	round(sum(nvl(a.MeterReading,0) - nvl(a.PreviousVehicleMeterReading,0)), 2) as TotalKm,
                	round(sum(a.PreviousReading), 2) as OpeningHr,
                	round(sum(a.HourMeterReading)) as ClosingHr,
                	round(sum(nvl(a.HourMeterReading,0) - nvl(a.PreviousReading,0)), 2) as TotalHr,
                	round(sum(Decode(a.RunningHmr,0,0,(aa.Quantity1/a.RunningHmr))), 2) as HSDHr,
                	round(sum(Decode(aa.Quantity1,0,0,(a.RunningKm/aa.Quantity1))), 2) as Kml
                From NecessitySlip a, NecessitySlipDetail aa, Shift d, Equipment e, EquipmentGroup f,
                Location g, StorageLocation h
                	Where a.Tno = aa.Tno
                	and a.ShiftCode = d.ShiftCode(+)
                	and a.EquipmentTno = e.Tno(+)
                	and e.EquipmentGroupCode = f.EquipmentGroupCode(+)
                	and a.LocationCode = g.LocationCode(+)
                	and a.StorageLocationCode = h.StorageLocationCode(+)
                	and trunc(a.NecessitySlipdate) between :P291_FROMDATE and :P291_TODATE
                	and ( :P291_DRIVER IS NULL OR instr(':'||:P291_DRIVER||':',':'||a.DriverName||':') > 0 ) 
                	and (:P291_SHIFT IS NULL OR instr(':'||:P291_SHIFT||':',':'||d.ShiftCode||':') > 0)
                	and (:P291_VEHICLETYPE IS NULL OR instr(':'||:P291_VEHICLETYPE||':',':'||f.EquipmentGroupCode||':') > 0 ) 
                	and (:P291_LOCATION IS NULL OR instr(':'||:P291_LOCATION||':',':'||g.LocationCode||':') > 0 ) 
                	and (:P291_STORAGELOCATION IS NULL OR instr(':'||:P291_STORAGELOCATION||':',':'||a.StorageLocationCode||':') > 0 ) 
                Group by
                	trunc(a.NecessitySlipDate),
                	a.VehicleNo,
                	f.EquipmentGroupName,
                	e.EquipmentID,
                  a.ShiftCode,
                  d.ShiftName,
                  a.LocationCode,
                  g.LocationName
                ) XX
                ;
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
