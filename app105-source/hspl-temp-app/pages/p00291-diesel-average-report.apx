    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction print-report (
        name: Print Report
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action print-report (
            name: Print Report
            action: executeJsCode
            settings {
                jsCode: generatePDF();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

