    region accessories-summary-2 (
        name: Accessories Summary
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P342_ACCESSORIESTYPE (
        type: popupLov
        label {
            label: Accessories Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT DISTINCT ITEMCATEGORYCODE FROM ACCESSORIESMANAGEMENT
            nullDisplayValue: -Select List-
        }
        layout {
            sequence: 20
            region: @accessories-summary-2
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P342_EQUIPMENT (
        type: popupLov
        label {
            label: Equipment
            alignment: left
        }
        settings {
            displayAs: modalDialog
            fetchOnSearch: true
            title: List of Equipment
            popupWidth: 450
            popupHeight: 350
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                  distinct  
                       b.EquipmentName||' ( '||b.EquipmentId||' )' as Name,
                     b.TNo as Code
                from equipment b
                WHERE getdocumentstatuscode('EQUIPMENT',B.TNO)='ACTIVE'
                AND B.EQUIPMENTCATEGORYCODE IN ('VEHICLE','MACHINE')
                AND B.EQUIPMENTTYPECODE='ASSET'
                ```
            nullDisplayValue: -Select List-
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 30
            region: @accessories-summary-2
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 75
            valuePlaceholder: Equipment
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P342_LOCATION (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                   b.LocationName d,
                   b.LOcationCode r
                From AccessoriesManagement a, Location b
                Where a.LocationCode = b.LocationCode
                ```
            nullDisplayValue: --Select Location--
        }
        layout {
            sequence: 10
            region: @accessories-summary-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

