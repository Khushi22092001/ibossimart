            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: CS
            }
        )

        column OLDACCESSORIESFITTED (
            type: plainText
            heading {
                heading: OLD ACCESSORIES FITTED
                alignment: center
            }
            layout {
                sequence: 990
