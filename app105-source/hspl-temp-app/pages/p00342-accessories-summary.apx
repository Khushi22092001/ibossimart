            advanced {
                endUserAlias: B
            }
        )

        column NEWACCESSORIESFITTED (
            type: plainText
            heading {
                heading: NEW ACCESSORIES FITTED
                alignment: center
            }
            layout {
                sequence: 980
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: CT
            }
        )

        column NOOFTYRES (
            type: plainText
