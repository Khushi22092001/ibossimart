page 342 (
    name: Accessories  Summary
    alias: ACCESSORIES-SUMMARY
    title: Accessories  Summary
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region accessories-summary (
        name: Accessories Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                row_number() over(order by B.TNO) SerialNo,
                getequipmentlocationcode(B.TNO,TRUNC(SYSDATE)) AS LOCATIONCODE,
                B.EQUIPMENTNAME,
                B.EQUIPMENTID,
                B.EQUIPMENTCATEGORYCODE,
                B.NOOFTYRES,
                (
                 SELECT COUNT(*) FROM ACCESSORIESMANAGEMENT X
                 WHERE X.SOURCEEQUIPMENTTNO = B.TNO
                   AND UPPER(X.ACTIVITY) = 'FITTING'
                   AND X.ITEMCATEGORYCODE= :P342_ACCESSORIESTYPE
                   AND CONDITION = 'NEW'   
                ) AS NEWACCESSORIESFITTED,
                (
                  ( SELECT COUNT(*) FROM ACCESSORIESMANAGEMENT X
                   WHERE X.SOURCEEQUIPMENTTNO = B.TNO
                      AND X.ITEMCATEGORYCODE= :P342_ACCESSORIESTYPE
                     AND UPPER(X.ACTIVITY) = 'FITTING'
                     AND CONDITION = 'OLD' 
                   )  
                   +
                  ( SELECT COUNT(*) FROM ACCESSORIESMANAGEMENT X
                   WHERE X.TARGETEQUIPMENTTNO = B.TNO
                      AND X.ITEMCATEGORYCODE = :P342_ACCESSORIESTYPE
                     AND UPPER(X.ACTIVITY) = 'REPLACE'
                     AND CONDITION = 'OLD' 
                   )    
                ) AS OLDACCESSORIESFITTED,
                (
                  SELECT COUNT(*) FROM ACCESSORIESMANAGEMENT X
                 WHERE X.SOURCEEQUIPMENTTNO = B.TNO
                    AND X.ITEMCATEGORYCODE= :P342_ACCESSORIESTYPE
                   AND UPPER(X.ACTIVITY) != 'FITTING' 
                      
                ) AS ACCESSORIESDISPOSEDOFF
                
                FROM EQUIPMENT B 
                WHERE getdocumentstatuscode('EQUIPMENT',B.TNO)='ACTIVE'
                AND B.EQUIPMENTCATEGORYCODE IN ('VEHICLE','MACHINE')
                AND B.EQUIPMENTTYPECODE='ASSET'
                AND B.TNO LIKE NVL(:P342_EQUIPMENT,'%')
                AND getequipmentlocationcode(B.TNO,TRUNC(SYSDATE)) LIKE NVL(:P342_LOCATION,'%') 
                and :P342_LOCATION is not null
                ORDER BY 1,2
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 144487960960022801
        }

        column ACCESSORIESDISPOSEDOFF (
            type: plainText
            heading {
                heading: ACCESSORIES DISPOSED OFF
                alignment: center
            }
            layout {
                sequence: 1000
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: CV
            }
        )

        column EQUIPMENTCATEGORYCODE (
