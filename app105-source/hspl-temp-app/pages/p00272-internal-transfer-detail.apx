page 272 (
    name: Internal Transfer Detail
    alias: INTERNAL-TRANSFER-DETAIL
    title: Internal Transfer Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region internal-transfer-detail-report (
        name: Internal Transfer Detail Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                b.LocationName "Location Name",
                a.InternalTransferNo as InternalTransferNo,
                a.InternalTRansferDate,
                d.DeliveryOrderNo "Delivery Order No",
                d.DeliveryOrderDate "Delivery Order Date",
                d.PartyDONo "Party DO No",
                d.PartyDODate "Party DO Date",
                a.GPNo "GP NO",
                p.PartyName "Party Name",
                q.SourcelocationName "Source location Name",
                r.DestinationLocationName "Destination Location Name",
                a.VehicleNo "Vehicle No",
                t.TransporterName "Transporter Name",
                a.DriverName ||'  -  '|| em.EmployeeId as  "Driver Name",
                s.ShiftName "Shift Name ",
                a.LoadingDate "Loading Date",
                GetTime(a.LoadingTime) as "Loading Time",
                round(a.LoadingQuantity1,3) as "Loading Qty",
                a.UnloadingDate " Unloading Date",
                GetTime(a.UnloadingTime) "Unloading Time",
                round(a.UnloadingQuantity1,3) as "Unloading Qty",
                ro.RouteName as "Route Name",
                a.Creator,
                CASE WHEN ds.documentstatusCode = 'ACTIVE' then ds.DocumentStatusName
                when ds.documentstatusCode is null then 'Non-Active'
                Else 'Non-Active'
                End as DocumentStatus,
                Case When f.InternalTransferTno is not null then 'BILLED'
                When f.InternalTransferTno is null then 'UNBILLED'
                End AS Billed
                from InternalTransfer a, Location b, DeliveryOrderDetail c, Deliveryorder d, LoadingOrder e, ServiceBillInternalTransfer f,
                    Party p, Sourcelocation q , DestinationLocation r  , Transporter t , Shift s, Route ro, Employee em, DocumentStatusDetail dsd, DocumentStatus ds
                Where a.LocationCode = b.LocationCode(+)
                and a.DeliveryOrderTno = c.Tno(+)
                and a.DeliveryorderSno = c.Sno(+)
                and c.Tno = e.DeliveryOrderTno(+)
                and c.Sno = e.DeliveryorderSno(+)
                and c.Tno = d.Tno(+)
                and a.Tno = f.InternalTransferTno(+)
                and a.PartyCode = p.PartyCode(+)
                and a.SourceLocationTno = q.Tno(+)
                and a.DestinationLocationTno = r.Tno(+)
                and a.TransporterCode = t.TransporterCode(+)
                and a.ShiftCode = s.ShiftCode(+)
                and a.RouteCode = ro.RouteCode(+)
                and a.DriverCode = em.EmployeeCode(+)
                and a.Tno = dsd.ModuleTno(+)
                and dsd.DocumentStatusCode = ds.DocumentStatusCode(+)
                and ( :P272_COMPANYNAME IS NULL OR instr(':'||:P272_COMPANYNAME||':',':'||a.CompanyCode||':') > 0 )
                 and a.LoadingDate BETWEEN  :P272_FROMDATE AND :P272_TODATE
                --and (:P272_COMPANYNAME is null or instr(':'||:P272_COMPANYNAME||':',':'||a.Companycode||':') > 0)
                --and a.loadingDate between :P272_FROMDATE and :P272_TODATE
                /*and (:P272_LOCATIONNAME is null or instr(':'||:P272_LOCATIONNAME||':',':'||a.Locationcode||':') > 0)
                and (:P272_SOURCE is null or instr(':'||:P272_SOURCE||':',':'||a.SourceLocationTno||':') > 0)
                and (:P272_DESTINATION is null or instr(':'||:P272_DESTINATION||':',':'||a.DestinationLocationTno||':') > 0)
                and (:P272_INTERNALTRANSFERNO is null or instr(':'||:P272_INTERNALTRANSFERNO||':',':'||a.Tno||':') > 0)
                and (:P272_PARTY is null or instr(':'||:P272_PARTY||':',':'||a.Partycode||':') > 0)
                and (:P272_SHIFT is null or instr(':'||:P272_SHIFT||':',':'||a.ShiftCode||':') > 0)
                and (:P272_ROUTE is null or instr(':'||:P272_ROUTE||':',':'||a.RouteCode||':') > 0)
                and (:P272_PARTYDONO is null or instr(':'||:P272_PARTYDONO||':',':'||d.Tno||':') > 0)
                and (:P272_DELIVERYORDER is null or instr(':'||:P272_DELIVERYORDER||':',':'||a.DeliveryOrderTNo||':') > 0)*/
                
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 13565646516829040
        }

