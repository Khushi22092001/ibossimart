page 60 (
    name: "Transport Plan "
    alias: TRANSPORTPLAN
    title: "Transport Plan "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region transport-plan (
        name: "Transport Plan "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region transport-plan-report (
        name: Transport Plan Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      GetCompanyName(a.CompanyCode)Company,
                      a.SalesOrderNo as OrderNO,
                      a.SalesOrderDate as OrderDate,
                      c.PartyName as Consignee,
                      ct.CityName,
                      st.StateName,
                      a.PartyPONo,
                      a.PartyPODate,
                      a.ValidityUptoDate,
                      'SALES ORDER' as Module
                From  SalesOrder a, Party c, City ct, State st
                Where a.ConsigneeCode = c.PartyCode
                  and c.OfficeCityCode = ct.CityCode
                  and c.OfficeStateCode = st.StateCode
                  and a.FreightTypeCode = 'TOPAYOUTWARD'
                  and a.SalesOrderDate between :P60_FROMDATE and :P60_TODATE
                  and instr(':'||:P60_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P60_LOCATION||':',':'||a.LocationCode||':') > 0
                Union All
                Select
                      GetCompanyName(a.CompanyCode)Company,
                      a.PurchaseOrderNo,
                      a.PurchaseOrderDate,
                      p.PartyName,
                      c.CityName,
                      s.StateName,
                      null as PartyPONo,
                      null as PartyPODate,
                      a.DeliveryDate as ValidityUpto,
                      'PURCHASE ORDER' as Module
                From  PurchaseOrder a, Party p, City c, State s
                Where a.PartyCode = p.PartyCode
                  and p.OfficeCityCode = c.CityCode
                  and p.OfficeStateCode = s.StateCode
                  and a.FreightTypeCode = 'TOPAY' 
                  and a.PurchaseOrderDate between :P60_FROMDATE and :P60_TODATE
                  and instr(':'||:P60_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P60_LOCATION||':',':'||a.LocationCode||':') > 0
                  --and ( :P60_ITEM IS NULL OR instr(':'||:P60_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  --and ( :P60_ITEMSPECIFICATION IS NULL OR instr(':'||:P60_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                html
                excel
                pdf
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
