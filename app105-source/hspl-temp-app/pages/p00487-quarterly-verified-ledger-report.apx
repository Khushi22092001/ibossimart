page 487 (
    name: Quarterly Verified Ledger Report
    alias: QUARTERLY-VERIFIED-LEDGER-REPORT
    title: Quarterly Verified Ledger Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region quarterly-verified-ledger-report (
        name: Quarterly Verified Ledger Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region quarterly-verified-ledger-report-2 (
        name: Quarterly Verified Ledger Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by X.ParentGroup,x.QuarterlyPeriodSerialNo) as SerialNo,
                   x.LedgerName,
                   x.ParentGroup,
                   x.HODName,
                   x.HODBossUserName,
                   x.BossUserName,
                   x.LedgerClosingAmount,
                   abs(x.DR) as DR,
                   x.CR,
                   x.Status as IsCheckedVerifiedStatus,
                   x.Accounttype,
                   x.Remark,
                   x.EmployeeName
                From
                (Select
                   a.QuarterlyPeriodSerialNo,
                   a.AccountName as LedgerName,
                   a.TopParentName as ParentGroup,
                   a.HODName,
                   a.HODBossUserName,
                   a.LedgerClosingAmount,
                   Case When a.LedgerClosingAmount < 0 then  a.LedgerClosingAmount
                   Else null end as DR,
                   Case When a.LedgerClosingAmount > 0 then  a.LedgerClosingAmount
                   Else null end as CR,
                   a.CheckedAndVerifiedStatus,
                   Case When a.CheckedAndVerifiedStatus = 'YES' then 'VERIFIED'
                   When a.CheckedAndVerifiedStatus is null then 'NOTVERIFIED'
                   End as Status,
                   Case When a.LedgerClosingAmount = 0 then 'ZERO'
                   When a.LedgerClosingAmount != 0 then 'NOTZERO'
                   End as Accounttype,
                   a.Remark,
                   a.BossUserName,
                   d.EmployeeName ||' - '|| d.EmployeeID as EmployeeName
                From QuarterlyACVerificationView a, Employee d, party p
                Where a.EmployeeCode = d.EmployeeCode
                and ( :P487_HODNAME IS NULL OR instr(':'||:P487_HODNAME||':',':'||a.HODBossUserCode||':') > 0 )
                and ( :P487_COMPANY IS NULL OR instr(':'||:P487_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                and :P487_ASONDATE  = Trim(To_Char(a.FromDate,'MON'))||'-'||Trim(To_Char(a.ToDate,'MON'))||'     '||a.FinancialYearCode
                and a.accountcode = p.partycode
                and p.creationtime <= a.todate
                ) x
                Where ( :P487_STATUS IS NULL OR instr(':'||:P487_STATUS||':',':'||x.Status||':') > 0 )
                and ( :P487_ACCOUNTYPE IS NULL OR instr(':'||:P487_ACCOUNTYPE||':',':'||x.Accounttype||':') > 0 )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 132168497321655512
        }

