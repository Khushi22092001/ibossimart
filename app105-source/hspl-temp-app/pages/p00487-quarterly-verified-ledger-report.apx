                     e.BossUserCode R
                From Party a, PartyCompany b, BossUser c, Employee d, BossUser e
                Where a.Tno = b.Tno
                and a.QuarterlyVerificationUserCode = c.BossUserCode
                and c.EmployeeCode = d.EmployeeCode(+)
                and d.ReportToEmployeeCode = e.EmployeeCode(+)
                ```
            displayNullValue: false
