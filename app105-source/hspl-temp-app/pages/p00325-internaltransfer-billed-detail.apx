page 325 (
    name: InternalTransfer Billed Detail
    alias: INTERNALTRANSFER-BILLED-DETAIL
    title: InternalTransfer Billed Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #itb .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region internal-tranfer-billed-detail (
        name: Internal Tranfer Billed Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                   row_number() over(order by a.InternalTransferDate) SerialNo,
                	a.Tno,
                	a.CompanyCode,
                	a.InternalTransferNo,
                	a.InternalTransferDate,
                	f.PartyName,
                	g.TransporterName,
                	a.VehicleNo,
                  l.TransportAreaName,
                	h.SourceLocationName,
                	i.DestinationLocationName,
                	a.LoadingQuantity1 as ITBilledQuantity,
                	x.NetFreightRate as ITBilledRate,
                	round(nvl(a.LoadingQuantity1,0)* nvl(x.NetFreightRate,0), 2) as ITBilledAmount
                From InternalTransfer a, DeliveryOrderDetail c, DeliveryOrder d, Party f, Transporter g, Sourcelocation h,
                DestinationLocation i, CompanyVehicle j, Equipment k, TransportArea l, DocumentStatusDetail dsd,
                	(
                	Select
                		a.Tno,
                		c.DOExpensesNo,
                		c.DOExpensesDate,
                		b.NetFreightRate
                	From InternalTransfer a, DOExpensesDetail b, DOExpenses c
                	Where a.DeliveryOrderTno = b.DeliveryOrderTno
                		and a.DeliveryOrderSno = b.DeliveryOrderSno
                    and GetDOExpensesTno(a.DeliveryOrderTno, a.DeliveryOrderSno, a.InternalTransferDate) = b.Tno
                		and a.RouteCode = b.RouteCode
                		and b.Tno = c.Tno
                		and a.RouteCode is not null
                	UNION ALL
                	Select
                		a.Tno,
                		c.DOExpensesNo,
                		c.DOExpensesDate,
                		b.NetFreightRate
                	From InternalTransfer a, DOExpensesDetail b, DOExpenses c
                	Where a.DeliveryOrderTno = b.DeliveryOrderTno
                		and a.DeliveryOrderSno = b.DeliveryOrderSno
                    and GetDOExpensesTno(a.DeliveryOrderTno, a.DeliveryOrderSno, a.InternalTransferDate) = b.Tno
                		and b.Tno = c.Tno
                		and b.RouteCode is null
                		and a.RouteCode is null
                	) x
                Where a.DeliveryOrderTno = c.Tno
                	and a.DeliveryOrderSno = c.Sno
                	and c.Tno = d.Tno
                	and a.PartyCode = f.PartyCode(+)
                	and a.TransporterCode = g.TransporterCode(+)
                	and a.SourceLocationTno = h.Tno(+)
                	and a.DestinationLocationTno = i.Tno(+)
                	and a.VehicleNo = j.CompanyVehicleNo
                	and j.ModuleTno = k.Tno
                  and j.TransportAreaCode = l.TransportAreaCode(+)
                	and k.EquipmentGroupCode = 'CT'
                	and a.Tno = dsd.ModuleTno
                	and dsd.DocumentStatusCode = 'ACTIVE'
                	and a.Tno = x.Tno(+)
                	and d.DocTypeCode = 'INTERNALTRANSFER'
                	and a.VehicleGroupCode = 'SELF'
                	and  exists(
                		Select
                			aa.Tno
                		From ServiceBillInternalTransfer aa
                		Where aa.InternalTransferTno = a.Tno
                		)
                	and exists(
                		Select
                			aa.Tno
                		From CompanyVehicle aa, Equipment bb
                		Where aa.ModuleTno = bb.Tno
                			and bb.EquipmentGroupCode = 'CT'
                			and aa.CompanyVehicleNo = a.VehicleNo
                		)
                	and a.InternalTransferDate between :P325_FROMDATE and :P325_TODATE
                	and a.CompanyCode = :P325_COMPANYCODE
                  and (:P325_VEHICLENO is Null Or Instr (':' || :P325_VEHICLENO || ':' , ':' || a.VehicleNo || ':') > 0)
                	and (:P325_VEHICLENO2 is null
                       or exists(
                         Select
                            aa.VehicleNo
                          From VPVehicleNo aa
                          Where aa.VehicleNo = a.VehicleNo
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P325_VEHICLETYPE is null
                       or exists(
                         Select
                            aa.VehicleTypeCode
                          From VPVehicleType aa
                          Where aa.VehicleTypeCode = j.VehicleTypeCode
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P325_TRANSPORTAREA is null
                       or exists(
                         Select
                            aa.TransportAreaCode
                          From VPTransportArea aa
                          Where aa.TransportAreaCode = j.TransportAreaCode
                              and aa.Creator = :APP_USER
                       )
                   )
                		
                ```
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
