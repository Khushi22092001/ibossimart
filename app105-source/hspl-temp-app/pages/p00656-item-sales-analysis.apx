    region kpi-strip (
        name: Item Snapshot
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Cur As (
                       Select a.TNo, b.Amount, b.Quantity1, b.Quantity2
                         From CCInvoice a
                         Join CCInvoiceDetail b On b.TNo = a.TNo
                        Where a.CCInvoiceDate >= to_date(:P656_FROMDATE,'DD-MM-RRRR')
                          And a.CCInvoiceDate <  to_date(:P656_TODATE,'DD-MM-RRRR') + 1
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (
                              :P656_PANEL   Is Null Or a.Panel        = :P656_PANEL
                          )
                          And (
                              :P656_COMPANY Is Null Or a.CompanyCode  = :P656_COMPANY
                          )
                          And (
                              :P656_LOCATION Is Null Or a.LocationCode = :P656_LOCATION
                          )
                          And (
                              :P656_PARTY_CODE Is Null Or a.PartyCode = :P656_PARTY_CODE
                          )
                          And b.ItemCode = :P656_ITEM_CODE),
                Agg As (
                       Select Sum(Amount) Val, Count(Distinct TNo) Invoices,
                              Sum(Quantity1) Q1, Sum(Quantity2) Q2
                         From Cur)
                Select
                  '<div class="ds-kpi ds-kpi--value"><span class="ds-kpi-ic"><span class="fa fa-inr"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Sales Value</span><span class="ds-kpi-n">'
                  || Case When nvl(Val,0) >= 10000000 Then 'Rs ' || to_char(Round(Val/10000000,2),'FM99G990D00') || ' Cr'
                          When nvl(Val,0) >= 100000 Then 'Rs ' || to_char(Round(Val/100000,2),'FM99G990D00') || ' L'
                          Else 'Rs ' || to_char(nvl(Val,0),'FM99G99G990D00') End
                  || '</span><span class="ds-kpi-sub">taxable line value</span></span></div>' As KPI1,
                  '<div class="ds-kpi ds-kpi--input"><span class="ds-kpi-ic"><span class="fa fa-list-alt"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Invoices</span><span class="ds-kpi-n">'
                  || to_char(nvl(Invoices,0),'FM999G999') || '</span><span class="ds-kpi-sub">carrying this item</span></span></div>' As KPI2,
                  '<div class="ds-kpi ds-kpi--bill"><span class="ds-kpi-ic"><span class="fa fa-balance-scale"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Quantity 1</span><span class="ds-kpi-n">'
                  || to_char(nvl(Q1,0),'FM99G99G990D000') || '</span><span class="ds-kpi-sub">primary UOM</span></span></div>' As KPI3,
                  '<div class="ds-kpi ds-kpi--suppl"><span class="ds-kpi-ic"><span class="fa fa-balance-scale"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Quantity 2</span><span class="ds-kpi-n">'
                  || to_char(nvl(Q2,0),'FM99G99G990D000') || '</span><span class="ds-kpi-sub">secondary UOM</span></span></div>' As KPI4,
                  '<div class="ds-kpi ds-kpi--struct"><span class="ds-kpi-ic"><span class="fa fa-tag"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Avg Realised Rate</span><span class="ds-kpi-n">'
                  || Case When nvl(Q1,0) = 0 Then '&mdash;'
                          Else 'Rs ' || to_char(Round(Val/Q1,2),'FM99G99G990D00') End
                  || '</span><span class="ds-kpi-sub">money &divide; quantity (primary UOM)</span></span></div>' As KPI5
                From Agg
                ```
            pageItemsToSubmit: [
                P656_FROMDATE
                P656_TODATE
                P656_ITEM_CODE
