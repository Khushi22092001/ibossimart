page 656 (
    name: Item Sales Analysis
    alias: ITEM-SALES-ANALYSIS
    title: Item Sales Analysis
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            ITEM SALES ANALYSIS (HSPL) — one item for the period.
            All data queries INNER JOIN the detail; the item predicate is on
            d.ItemCode. Average realised rate = SUM(Amount)/SUM(Quantity1)
            (total money / total quantity), rendered "—" not "0" when quantity
            is zero. LOCATION arrives inherited and live; COMPANY and PARTY_CODE
            arrive hidden — the header "Customer" chip discloses the inherited
            party scope.
            
            The monthly chart plots the realised RATE only (a single line), the
            same proven pattern as the sibling Item 360 (page 679). Volume is
            carried in the Quantity 1 / Quantity 2 KPI cards and the invoice-line
            report, so a quantity series and a rupee-rate series are never forced
            onto one shared axis (which would flatten one of them).
            
            The invoice-line drill passes ONLY P657_TNO to page 657, which
            re-derives every attribute and re-checks authorisation from the key.
            Read-only. Back returns to 653.
            ```
    }

    region command-header (
        name: Item Sales Analysis
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-sales-head">'
                  || '<div class="ds-sales-head-eyebrow">Item &middot; Sales Intelligence</div>'
                  || '<h1 class="ds-sales-head-title">'
                     || apex_escape.html(nvl((Select Max(i.ItemName) From Item i Where i.ItemCode = :P656_ITEM_CODE),
                          nvl(:P656_ITEM_CODE,'Select an item'))) || '</h1>'
                  || '<div class="ds-sales-head-sub">Volume, realised rate and the invoice-level '
                     || 'evidence behind this product over the selected period.</div>'
                  || '<div class="ds-sales-head-context">'
                  || '<span class="ds-chip"><span class="fa fa-calendar ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Period</span><b>'
                     || apex_escape.html(:P656_FROMDATE) || ' &ndash; ' || apex_escape.html(:P656_TODATE) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-map-marker ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Location</span><b>'
                     || apex_escape.html(nvl(GetLocationName(:P656_LOCATION),'All locations')) || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-sitemap ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Category</span><b>'
                     || apex_escape.html(nvl((Select Max(ic.ItemCategoryName)
                          From ItemSpecification ee2
                          Join ItemCategory ic On ic.ItemCategoryCode = ee2.ItemCategoryCode
                         Where ee2.ItemSpecificationCode In
                               (Select b2.ItemSpecificationCode From CCInvoiceDetail b2
                                 Where b2.ItemCode = :P656_ITEM_CODE)),'Not categorised')) || '</b></span>'
                  || Case When :P656_PARTY_CODE Is Not Null
                          Then '<span class="ds-chip"><span class="fa fa-user-o ds-chip-ic"></span>'
                               || '<span class="ds-chip-k">Customer</span><b>'
                               || apex_escape.html(GetPartyName(:P656_PARTY_CODE)) || '</b></span>'
                          Else '' End
                  || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                          Then '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                               || '<span class="ds-chip-k">Panel</span><b>'
                               || apex_escape.html((Select GetUserPanelAB_apex() From dual)) || ' (enforced)</b></span>'
                          Else '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                               || '<span class="ds-chip-k">Panel</span><b>'
                               || apex_escape.html(nvl(:P656_PANEL,'A + B')) || '</b></span>' End
                  || '</div></div>' As HEAD
                From dual
                ```
            pageItemsToSubmit: [
                P656_FROMDATE
                P656_TODATE
                P656_ITEM_CODE
                P656_LOCATION
                P656_PANEL
                P656_PARTY_CODE
            ]
        }
