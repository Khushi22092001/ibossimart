    region page-style (
        name: Sales Theme
        type: staticContent
        source {
            htmlCode:
                ```html
                <style>
                body:has(.ds-sales-headregion){
                  --ds-dash-gold:#4F46E5; --ds-dash-gold-bg:#EEF0FE;
                  --ds-dash-ink:#1E1B4B; --ds-dash-ink2:#4C4A6E;
                  --ds-dash-canvas:#F7F7FB; --ds-dash-tinted:#F2F2F9; --ds-dash-line:#E4E4F0;
                }
                body:has(.ds-sales-headregion) .ds-kpi--value{--ds-kpi-accent:#4F46E5;--ds-kpi-accent-bg:#EEF0FE;}
                body:has(.ds-sales-headregion) .ds-kpi--bill {--ds-kpi-accent:#6D5CE7;--ds-kpi-accent-bg:#EEF0FE;}
                body:has(.ds-sales-headregion) .ds-kpi--input{--ds-kpi-accent:#0E7C86;--ds-kpi-accent-bg:#E4F4F5;}
                body:has(.ds-sales-headregion) .ds-purchase-section::before{background:linear-gradient(180deg,#6D5CE7,#3730A3);}
                body:has(.ds-sales-headregion) .ds-dash-filters::after{display:none;}
                .ds-sales-head{position:relative;overflow:hidden;padding:24px 26px 20px;border:1px solid #C7C5EE;border-radius:16px;background:radial-gradient(130% 130% at 92% 8%, rgba(109,92,231,.30) 0%, rgba(109,92,231,0) 48%),radial-gradient(120% 120% at 0% 100%, rgba(55,48,163,.20) 0%, rgba(55,48,163,0) 44%),linear-gradient(120deg,#D9D8F4 0%,#D2CFF0 34%,#DED9F6 66%,#EAE7FC 100%);box-shadow:0 1px 2px rgba(16,24,40,.05),0 12px 34px rgba(79,70,229,.12);}.ds-sales-head-eyebrow,.ds-sales-head-title,.ds-sales-head-sub,.ds-sales-head-context{position:relative;z-index:1;}.ds-sales-head-context{max-width:64%;}
                .ds-sales-head-eyebrow{font-size:11px;font-weight:700;letter-spacing:.10em;
                  text-transform:uppercase;color:#4F46E5;margin-bottom:4px;}
                .ds-sales-head-title{margin:0;font-size:25px;font-weight:600;letter-spacing:-.01em;
                  line-height:1.2;color:#1E1B4B;}
                .ds-sales-head-sub{margin:5px 0 0;font-size:13px;line-height:1.5;color:#4C4A6E;max-width:74ch;}
                .ds-sales-head-context{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px;}
                html.page-656 .t-Body-title.hspl-hero-card,html.page-656 .t-Body-title{display:none !important;}
                </style>
                ```
        }
        layout {
            sequence: 1
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: "[ #DEFAULT# ]"
        }
    )

    region rate-trend (
        name: Monthly Realised Rate
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select to_char(Trunc(a.CCInvoiceDate,'MM'),'Mon-RR') MONTH_LABEL,
                       Round(Sum(b.Amount) / Nullif(Sum(b.Quantity1),0), 2) RATE,
                       Trunc(a.CCInvoiceDate,'MM') SORT_KEY
                  From CCInvoice a Join CCInvoiceDetail b On b.TNo = a.TNo
                 Where a.CCInvoiceDate >= to_date(:P656_FROMDATE,'DD-MM-RRRR')
                   And a.CCInvoiceDate <  to_date(:P656_TODATE,'DD-MM-RRRR') + 1
                   And nvl(b.Quantity1,0) > 0
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P656_PANEL   Is Null Or a.Panel        = :P656_PANEL
                   )
                   And (
                       :P656_COMPANY Is Null Or a.CompanyCode  = :P656_COMPANY
                   )
                   And (
                       :P656_LOCATION Is Null Or a.LocationCode = :P656_LOCATION
                   )
                   And (
                       :P656_PARTY_CODE Is Null Or a.PartyCode = :P656_PARTY_CODE
                   )
                   And b.ItemCode = :P656_ITEM_CODE
                 Group By Trunc(a.CCInvoiceDate,'MM')
                 Order By SORT_KEY
                ```
            pageItemsToSubmit: [
                P656_FROMDATE
                P656_TODATE
                P656_ITEM_CODE
                P656_LOCATION
                P656_PANEL
                P656_COMPANY
                P656_PARTY_CODE
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: line
        }
        chartLayout {
            height: 280
        }
        messages {
            whenNoDataFound: This item was not sold in the selected period, so no rate can be plotted.
        }

        series rate (
            name: Realised Rate (Rs)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: MONTH_LABEL
                value: RATE
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Realised Rate (Rs)
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    pageItem P656_COMPANY (
        type: hidden
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P656_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate,'MM'),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P656_ITEM_CODE (
        type: popupLov
        label {
            label: Item
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nvl(Max(i.ItemName), cd.ItemCode) d, cd.ItemCode r
                  From CCInvoiceDetail cd
                  Left Join Item i On i.ItemCode = cd.ItemCode
                 Group By cd.ItemCode
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: Select an item
        }
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 5
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: The item in focus. Switchable so you can move item to item without returning to the hub.
        }
    )

    pageItem P656_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r From Location l
                 Where Exists (Select 1 From CCInvoice a Where a.LocationCode = l.LocationCode
                                And ((Select GetUserPanelAB_apex() From dual) Is Null
                                     Or a.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P656_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            nullDisplayValue: A + B
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 9
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P656_PARTY_CODE (
        type: hidden
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P656_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back-to-dash (
        buttonName: BACKTODASH
        label: Sales Command Centre
        layout {
            sequence: 90
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 653
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

