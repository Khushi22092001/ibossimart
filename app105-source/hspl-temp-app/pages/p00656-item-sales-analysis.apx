    region invoice-lines (
        name: Contributing Invoice Lines
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Tax As (
                       Select TNo, SNo,
                              Sum(Decode(FooterHeadCode,'.CGST.',FooterValue,0)) Cgst,
                              Sum(Decode(FooterHeadCode,'.SGST.',FooterValue,0)) Sgst,
                              Sum(Decode(FooterHeadCode,'.IGST.',FooterValue,0)) Igst,
                              Sum(Decode(FooterHeadCode,'.TCS.', FooterValue,0)) Tcs
                         From CCInvoiceDetailFooter Group By TNo, SNo)
                Select a.TNo As TNO,
                       a.CCInvoiceNo As INVOICE_NO,
                       a.CCInvoiceDate As INV_DATE,
                       GetPartyName(a.PartyCode) As CUSTOMER,
                       nvl(ee.ItemSpecificationName, b.ItemSpecificationCode) As SPECIFICATION,
                       nvl(ic.ItemCategoryName,'Not categorised') As CATEGORY,
                       b.Quantity1 As QTY1,
                       b.Rate As RATE,
                       b.Amount As AMOUNT,
                       nvl(tx.Cgst,0) As CGST,
                       nvl(tx.Sgst,0) As SGST,
                       nvl(tx.Igst,0) As IGST,
                       nvl(tx.Tcs,0) As TCS,
                       (nvl(b.FooterAmount,0) - (nvl(tx.Cgst,0)+nvl(tx.Sgst,0)+nvl(tx.Igst,0)+nvl(tx.Tcs,0))) As OTHER_AMOUNT,
                       b.TotalAmount As TOTAL_AMOUNT,
                       Case When (Select Max(v.VoucherNo) From Voucher v Where v.ModuleTNo = a.TNo) Is Not Null
                            Then '<span class="ds-pill ds-pill--good">Posted</span>'
                            Else '<span class="ds-pill ds-pill--muted">Not posted</span>' End As VOUCHER_PILL
                  From CCInvoice a
                  Join CCInvoiceDetail b On b.TNo = a.TNo
                  Left Join ItemSpecification ee On ee.ItemSpecificationCode = b.ItemSpecificationCode
                  Left Join ItemCategory ic On ic.ItemCategoryCode = ee.ItemCategoryCode
                  Left Join Tax tx On tx.TNo = b.TNo And tx.SNo = b.SNo
                 Where a.CCInvoiceDate >= to_date(:P656_FROMDATE,'DD-MM-RRRR')
                   And a.CCInvoiceDate <  to_date(:P656_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P656_PANEL   Is Null Or a.Panel        = :P656_PANEL
                   )
                   And (
                       :P656_COMPANY Is Null Or a.CompanyCode  = :P656_COMPANY
                   )
                   And (
                       :P656_LOCATION Is Null Or a.LocationCode = :P656_LOCATION
                   )
                   And (
                       :P656_PARTY_CODE Is Null Or a.PartyCode = :P656_PARTY_CODE
                   )
                   And b.ItemCode = :P656_ITEM_CODE
                 Order By a.CCInvoiceDate Desc, a.TNo Desc
                ```
            pageItemsToSubmit: [
                P656_FROMDATE
                P656_TODATE
                P656_ITEM_CODE
                P656_LOCATION
                P656_PANEL
                P656_COMPANY
                P656_PARTY_CODE
            ]
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No invoice lines for this item in this period and scope.
        }
        advanced {
            savedReportMappingIdentifier: 28090408471250133
        }

