            action: executeServerSideCode
            settings {
                plsqlCode: PrepareVehicleExpense(:P404_COMPANY,:P404_VEHICLENO,:P404_VEHICLETYPE, :P404_TRANSPORTAREA, :P404_FROMDATE,:P404_TODATE, :APP_USER);
                itemsToSubmit: [
                    P404_COMPANY
                    P404_FROMDATE
                    P404_TODATE
                    P404_VEHICLENO
                    P404_VEHICLETYPE
