    pageItem P404_TRANSPORTAREA (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Transport Area
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.TransportAreaName as d,
                a.TransportAreaCode as r
                From TransportArea a
                Order by 1
                
                
                
                
                
                
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @vehicle-performance-report
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P404_VEHICLENO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vehicle No
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    b.CompanyVehicleNo d,
                    b.CompanyVehicleNo r
                From CompanyVehicle b
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @vehicle-performance-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P404_VEHICLETYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Vehicle Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                    c.VehicleTypeName d,
                    c.VehicleTypeCode r
                From VehicleType c
                Where exists
                (Select
                			aa.VehicleTypeCode
                		From CompanyVehicle aa, Equipment bb
                		Where aa.ModuleTno = bb.Tno
                			and bb.EquipmentGroupCode = 'CT'
                			and aa.VehicleTypeCode = c.VehicleTypeCode)
                
                
                
                
                
                
                
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @vehicle-performance-report
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 90
            region: @vehicle-performance-report
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction createtransportarea (
        name: CreateTransportArea
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: CreateVPTransportArea(:P404_TRANSPORTAREA, :APP_USER);
                itemsToSubmit: P404_TRANSPORTAREA
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

