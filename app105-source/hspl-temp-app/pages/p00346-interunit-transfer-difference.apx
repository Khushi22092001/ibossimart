page 346 (
    name: InterUnit Transfer Difference
    alias: INTERUNIT-TRANSFER-DIFFERENCE
    title: InterUnit Transfer Difference
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region interunit-transfer-difference-report (
        name: InterUnit Transfer Difference Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.CCInvoiceNo,
                a.CCInvoiceDate,
                a.GRNNo,
                a.GRNDate,
                a.InQuantity1,
                a.OutQuantity1,
                nvl(a.InQuantity1,0)- nvl(a.OutQuantity1,0) as DifferenceInQty
                From InterUnitTransferDifference a
                Where a.CCInvoiceDate between :P346_FROMDATE and :P346_TODATE
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 53616778144479750
        }

        savedReport 563298 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @CCINVOICENO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @CCINVOICEDATE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @GRNNO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @GRNDATE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @INQUANTITY1
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @OUTQUANTITY1
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @DIFFERENCEINQTY
                layout {
                    sequence: 7
                }
            )

        )

        column CCINVOICEDATE (
            type: datePicker
            heading {
                heading: CCInvoice Date
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                databaseColumn: CCINVOICEDATE
                dataType: date
            }
        )

        column CCINVOICENO (
            type: textarea
            heading {
                heading: CCInvoice No
            }
            layout {
                sequence: 10
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: CCINVOICENO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column DIFFERENCEINQTY (
            type: numberField
            heading {
                heading: Difference In Qty
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: DIFFERENCEINQTY
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column GRNDATE (
            type: datePicker
            heading {
                heading: GRN Date
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            source {
                databaseColumn: GRNDATE
                dataType: date
            }
        )

        column GRNNO (
            type: textarea
            heading {
                heading: GRN No
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: GRNNO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column INQUANTITY1 (
            type: numberField
            heading {
                heading: In Quantity
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: INQUANTITY1
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column OUTQUANTITY1 (
            type: numberField
            heading {
                heading: Out Quantity
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: OUTQUANTITY1
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }
    )

    pageItem P346_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @interunit-transfer-difference-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P346_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @interunit-transfer-difference-report
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
        }
    )

)

