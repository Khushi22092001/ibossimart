page 485 (
    name: Salary Sheet (HPC)
    alias: SALARY-SHEET-HPC
    title: Salary Sheet (HPC)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region salary-sheet-hpc (
        name: Salary Sheet (HPC)
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region salary-sheet-hpc-2 (
        name: Salary Sheet (HPC)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName,
                       SUM(decode(c.salaryheadcode, 'LPC', c.SALARYHEADAMOUNT))    AS No_Of_Days_LPC,
                       SUM(decode(c.salaryheadcode, 'BASIC', c.SALARYHEADAMOUNT)) AS Wage_Rate,
                       SUM(decode(c.salaryheadcode, 'LPCBASIC', c.SALARYHEADAMOUNT))    AS Basic_Salary,
                       SUM(decode(c.salaryheadcode, 'PI', c.SALARYHEADAMOUNT))    AS Perfomance_Incentive,
                       SUM(decode(c.salaryheadcode, 'GROSSSALARY', c.SALARYHEADAMOUNT))    AS Gross_Salary,
                       SUM(decode(c.salaryheadcode, 'PFEMPLOYEE', c.SALARYHEADAMOUNT))    AS EPF,
                       SUM(decode(c.salaryheadcode, 'ESICEMPLOYEECONTRIBUTION', c.SALARYHEADAMOUNT)) AS ESIC,
                       SUM(decode(c.salaryheadcode, 'CANTEENDED', c.SALARYHEADAMOUNT)) AS Mess,
                       SUM(decode(c.salaryheadcode, 'PTAX', c.SALARYHEADAMOUNT)) AS P_T,
                       SUM(decode(c.salaryheadcode, 'TDS', c.SALARYHEADAMOUNT)) AS TDS,
                       SUM(decode(c.salaryheadcode, 'RUNNINGADVANCEDED', c.SALARYHEADAMOUNT)) +
                       SUM(decode(c.salaryheadcode, 'SALARYADVANCEDED', c.SALARYHEADAMOUNT)) AS Advance_Dec,
                       SUM(decode(c.salaryheadcode, 'GROSSDEDUCTION', c.SALARYHEADAMOUNT)) AS Total_Deduction,
                       SUM(decode(c.salaryheadcode, 'NETEARNING', c.SALARYHEADAMOUNT)) AS Net_Salary,
                       SUM(decode(c.salaryheadcode, 'OTHER INCOME', c.SALARYHEADAMOUNT)) AS Other_Income,
                       SUM(decode(c.salaryheadcode, 'OTHERDEDUCTION', c.SALARYHEADAMOUNT)) AS Other_Deduction,
                       GetLocationName(a.LocationCode) Location,
                       a.SalaryNo Entry_No
                From   Salary a,Employee b,SalaryDetail c,Designation d,EmployeeSalary e,SalaryScheme f
                Where  a.EmployeeCode = b.EmployeeCode(+)
                  and  a.TNo = c.TNo(+)
                  and  b.DesignationCode = d.DesignationCode(+)
                  and  a.EmployeeSalaryTno = e.Tno(+)
                  and  e.Salaryschemecode = f.SalarySchemeCode(+)
                  and  f.SalarySchemeCode = '99999999'
                  and  to_char(a.SalaryFromDate,'MON-RRRR') = :P485_MONTH
                  and  (:P485_COMPANY IS NULL OR instr(':'||:P485_COMPANY||':',':'||b.CompanyCode||':') > 0)
                  and  (:P485_LOCATION IS NULL OR instr(':'||:P485_LOCATION||':',':'||a.LocationCode||':') > 0)
                  and  (:P485_EMPLOYEE IS NULL OR instr(':'||:P485_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0)
                Group By b.EmployeeID,
                       b.UAN,
                       b.EmployeeName,
                       d.DesignationName,
                       GetLocationName(a.LocationCode) ,
                       a.SalaryNo
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 43129817272583319
        }

