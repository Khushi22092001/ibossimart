    region pending-purchase-order-register (
        name: Pending Purchase Order Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
