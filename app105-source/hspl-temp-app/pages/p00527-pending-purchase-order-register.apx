        page {
            size: a3
            units: millimeters
            width: 420
            height: 297
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText:
                ```
                Purchase Order Report
                From Date &P27_FROMDATE., To Date &P27_TODATE.
                Doctype &P27_DOCTYPE.
                Location &P27_LOCATION.
                COMPANY &P27_COMPANY.
                
                ```
        }

        savedReport 38221 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 9
            )

            displayColumn BALANCEQTY (
                sequence: 13
            )

            displayColumn DELIVERYDATE (
                sequence: 5
            )

            displayColumn FREIGHTRATE (
                sequence: 11
            )

            displayColumn FREIGHTTYPECODE (
                sequence: 10
            )

            displayColumn LOCATIONNAME (
                sequence: 1
            )

            displayColumn MATERIALDETAIL (
                sequence: 6
            )

            displayColumn MIRECEIVEDQTY (
                sequence: 12
            )

            displayColumn PARTYNAME (
                sequence: 3
            )

            displayColumn PURCHASEORDERDATE (
                sequence: 2
            )

            displayColumn PURCHASEORDERNO (
                sequence: 4
            )

            displayColumn QUANTITY1 (
                sequence: 7
            )

            displayColumn RATE (
                sequence: 8
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: PURCHASEORDERDATE
                sort {
                    sequence: 2
                }
            )

            sort (
                column: PARTYNAME
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: CGST
            )

            aggregate (
                column: SGST
            )

            aggregate (
                column: IGST
            )

            aggregate (
                column: TCS
            )

            aggregate (
                column: OTHERAMOUNT
            )

            aggregate (
                column: TOTALAMOUNT
            )

            aggregate (
                column: GRNRECEIVEDQTY
            )

            aggregate (
                column: BALANCEQTY
            )

            aggregate (
                function: count
                column: SERIALNO
            )

            highlight ir-condition (
                name: DELIVERY DAYS
                condition {
                    column: DELIVERYREMAININGDAYS
                    operator: <=
                    value: 7
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #fcfbf8
                    text: #f81313
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    pageItem P527_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'PURCHASEORDER'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @pending-purchase-order-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
        validation {
            valueRequired: true
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
        sessionState {
            storage: request
        }
    )

    pageItem P527_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      dt.DocTypeName d,
                      dt.DocTypeCode r
                From  ModulePrivilege a, ModulePrivilegeDocType b, DocType dt, BossUser bu, ModuleDocType md, ModuleDocTypeDetail mdd
                Where a.TNo = b.TNo(+)
                  and (b.DocTypeCode = dt.DocTypeCode or b.DocTypeCode is null)
                  and a.ModuleCode = md.ModuleCode
                  and md.TNo = mdd.TNo
                  and mdd.DocTypeCode = dt.DocTypeCode
                  and a.ModuleCode = 'PURCHASEORDER'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                  and instr(':'||:P527_COMPANY||':',':'||a.CompanyCode||':') > 0
                Order by 1
                ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P527_COMPANY
            itemsToSubmit: P527_DOCTYPE
        }
        layout {
            sequence: 100
            region: @pending-purchase-order-register
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Doc Type Name
        }
        sessionState {
            storage: request
        }
    )

