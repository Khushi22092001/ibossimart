            regionDisplaySelector: true
        }
    )

    region pending-purchase-order-report (
        name: Pending Purchase Order Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by xxx.PurchaseOrderDate) SerialNo,
                      xxx.TNo,
                      xxx.SNo,
                      xxx.LocationName,
                      xxx.DocTypeName,
                      xxx.PurchaseOrderNo,
                      xxx.PurchaseOrderDate,
                      xxx.PartyName,
                      xxx.DeliveryDate as DeliveryDate,
                       XXX.DELIVERYDATE - TRUNC(SYSDATE)  AS DeliveryRemainingDays,
                      xxx.ItemCode,
                      xxx.MaterialDetail,
                      xxx.UOM,
                      round(xxx.Quantity1,3) as Quantity1,
                      xxx.UOM2,
                      round(xxx.Quantity2,3) as Quantity2,
                      xxx.AgentName,
                      XXX.WITHOUTDISCOUNTRATE,
                      XXX.DISCOUNTRATE,
                      xxx.Rate,
                      round(xxx.Amount,2) as Amount,
                      xxx.CGST,
                      xxx.SGST,
                      xxx.IGST,
                      xxx.TCS,
                      round(xxx.FooterAmount,2) as FooterAmount,
                      round((xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS)),2) as OtherAmount,
                      round(xxx.TotalAmount,2) as TotalAmount,
                      round(xxx.MIReceivedQty,3) as MIReceivedQty,
                      round(xxx.balanceQty,3) as BalanceQty,
                      xxx.DocumentStatusCode,
                      xxx.DocStatus,
                      xxx.FreightTypeCode,
                      xxx.GRNStatus,
                      xxx.POStatus,
                      xxx.Creator,
                      xxx.CreationTime,
                      'Attachment' as Attachment,
                      xxx.Description,
                      xxx.WarrantyDescription,
                      xxx.FreightRate
                From (
                Select
                      xx.TNo,
                      xx.SNo,
                      xx.LocationName,
                      xx.DocTypeName,
                      xx.PurchaseOrderNo,
                      xx.PurchaseOrderDate,
                      xx.PartyName,
                      xx.DeliveryDate,
                      xx.ItemCode,
                      xx.MaterialDetail,
                      xx.UOM,
                      xx.Quantity1,
                      xx.UOM2,
                      xx.Quantity2,
                      xx.AgentName,
                      XX.WITHOUTDISCOUNTRATE,
                      XX.DISCOUNTRATE,
                      xx.Rate,
                      xx.Amount,
                      sum(xx.CGST)CGST,
                      sum(xx.SGST)SGST,
                      sum(xx.IGST)IGST,
                      sum(xx.TCS)TCS,
                      xx.FooterAmount,
                      xx.TotalAmount,
                      xx.MIReceivedQty,
                      xx.balanceQty,
                      xx.DocumentStatusCode,
                      xx.DocStatus,
                      xx.FreightTypeCode,
                      xx.GRNStatus,
                      xx.POStatus,
                      xx.Creator,
                      xx.CreationTime,
                      xx.Description,
                      xx.WarrantyDescription,
                      xx.FreightRate
                From (
                Select
                      a.TNo,
                      b.SNo,
                      l.LocationName,
                      d.DocTypeName,
                      a.PurchaseOrderNo,
                      a.PurchaseOrderDate,
                      p.PartyCode,
                      p.PartyName,
                      a.DeliveryDate,
                      e.ItemCode,
                      e.ItemName,
                      ee.ItemSpecificationName,
                      e.ItemName||' ( '||ee.ItemSpecificationName||' )' as MaterialDetail,
                      mu.MeasuringUnitName as UOM,
                      b.Quantity1,
                      e.MeasuringUnitCode2 as UOM2,
                      b.Quantity2,
                      GetPartyName(a.AgentCode) AgentName,
                      B.WITHOUTDISCOUNTRATE,
                      B.DISCOUNTRATE,
                      B.Rate,
                      b.Amount,
                      Nvl(Decode(c.FooterHeadCode,'.CGST.',c.FooterValue),0) as CGST,
                      Nvl(Decode(c.FooterHeadCode,'.SGST.',c.FooterValue),0) as SGST,
                      Nvl(Decode(c.FooterHeadCode,'.IGST.',c.FooterValue),0) as IGST,
                      Nvl(Decode(c.FooterHeadCode,'.TCS.',c.FooterValue),0) as TCS,
                      b.FooterAmount,
                      b.TotalAmount,
                      g.MIReceivedQuantity1 as MIReceivedQty,
                      b.Quantity1 - NVL(g.MIReceivedQuantity1,0) as balanceQty,
                      dsd.DocumentStatusCode,
                      case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                           When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When dsd.DocumentStatusCode = 'APPROVAL' Then 'APPROVAL'
                           When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                           When dsd.DocumentStatusCode = 'AUDITED' Then 'AUDITED'
                           When dsd.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End as DocStatus,
                      ft.FreightTypeName as FreightTypeCode,
                      Case When g.MIReceivedQuantity1 >= b.quantity1 - (b.quantity1 * b.lowertolerancepercent) / 100 Then 'DONE'--  g.MIReceivedQuantity1 Then 'DONE'
                           --When b.Quantity1 > g.MIReceivedQuantity1 Then 'PARTIAL'
                	       When g.MIReceivedQuantity1 is null or  b.Quantity1 > g.MIReceivedQuantity1 Then 'PENDING'
                      End as GRNStatus,
                      nvl(decode(poc.PurchaseOrderTno,a.TNo,'SHORT-CLOSE'),'OPEN') as POStatus,
                      'Attachment' as Attachment,
                      'Details' as Property,
                      'PURCHASEORDER' as Module,
                      bue.EmployeeName||'( '||a.Creator||' )' as Creator,
                      a.CreationTime,
                      b.Description,
                      b.WarrantyDescription,
                      a.FreightRate
                From  PurchaseOrder a, PurchaseOrderDetail b, PurchaseOrderDetailFooter c, Location l, DocType d, Party p,  Item e, ItemSpecification ee, MeasuringUnit mu, BossUser bu, Employee bue,
                      (Select
                            b.ItemCode,
                            b.ItemSpecificationCode,
                            a.PurchaseOrderTNo,
                            sum(b.Quantity1) as MIReceivedQuantity1
                      From  MaterialIn a, MaterialInDetail b
                      Where a.TNo = b.TNo
                        and a.PurchaseOrderTNo is not null
                      Group By b.ItemCode,
                            b.ItemSpecificationCode,
                            a.PurchaseOrderTNo
                      ) g, DocumentStatusDetail dsd, PurchaseOrderClose poc, FreightType ft
                Where a.TNo = b.TNo(+)
                  and b.TNo = c.TNo(+)
                  and b.SNo = c.SNo(+)
                  and a.LocationCode = l.LocationCode(+)
                  and a.DocTypeCode = d.DocTypeCode(+)
                  and a.PartyCode = p.PartyCode(+)
                  and e.TNo = ee.TNo
                  and b.ItemCode = e.ItemCode(+)
                  and b.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and e.MeasuringUnitCode1 = mu.MeasuringUnitCode(+)
                  and e.ItemClassificationCode = 'MATERIAL'
                  and b.TNo = g.PurchaseOrderTNo(+)
                  and b.ItemCode = g.ItemCode(+)
                  and b.ItemSpecificationCode = g.ItemSpecificationCode(+)
                  and a.TNo = dsd.ModuleTno(+)
                  and a.TNo = poc.PurchaseOrderTNo(+)
                  and a.Creator = bu.LoginName(+)
                  and bu.EmployeeCode = bue.EmployeeCode(+)	
                  and a.FreightTypeCode = ft.FreightTypeCode(+)
                  and a.DoctypeCode = 'RAWMATERIALPURCHASE'
                  and a.PurchaseOrderDate Between :P527_FROMDATE And :P527_TODATE
                  and (:P527_COMPANY IS NULL OR instr(':'||:P527_COMPANY||':',':'||a.CompanyCode||':') > 0)
                  and (:P527_LOCATION IS NULL OR instr(':'||:P527_LOCATION||':',':'||a.LocationCode||':') > 0)
                  and (:P527_DOCTYPE IS NULL OR instr(':'||:P527_DOCTYPE||':',':'||a.DocTypeCode||':') > 0)
                  and ( :P527_PARTYNAME IS NULL OR instr(':'||:P527_PARTYNAME||':',':'||a.PartyCode||':') > 0 ) 
                  and ( :P527_ITEM IS NULL OR instr(':'||:P527_ITEM||':',':'||e.ItemCode||':') > 0 ) 
                  and ( :P527_ITEMSPECIFICATION IS NULL OR instr(':'||:P527_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                  and nvl(decode(poc.PurchaseOrderTno,a.TNo,'SHORT-CLOSE'),'OPEN') like nvl(:P527_POSTATUS,'%')
                 /*Case When g.MIReceivedQuantity1 >= b.quantity1 - (b.quantity1 * b.lowertolerancepercent) / 100 Then 'DONE'--  g.MIReceivedQuantity1 Then 'DONE'
                           --When b.Quantity1 > g.MIReceivedQuantity1 Then 'PARTIAL'
                	       When g.MIReceivedQuantity1 is null or  b.Quantity1 > g.MIReceivedQuantity1 Then 'PENDING'
                      End like nvl(:P527_GRNSTATUS,'%')
                */
                /*  and Case When b.Quantity1 <= g.MIReceivedQuantity1 Then 'DONE'
                           When b.Quantity1 > g.MIReceivedQuantity1 Then 'PARTIAL'
                	       When g.MIReceivedQuantity1 is null Then 'PENDING'
                      End like nvl(:P527_GRNSTATUS,'%')
                */
                  -- 22-APR-2025
                --   and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                    AND A.PANEL='A'
                  and case When dsd.DocumentStatusCode = 'ACTIVE' Then 'ACTIVE'
                           When dsd.DocumentStatusCode is null Then 'NONACTIVE'
                           When dsd.DocumentStatusCode = 'PREPARING' Then 'PREPARING'
                           When dsd.DocumentStatusCode = 'PREPARED' Then 'PREPARED'
                           When dsd.DocumentStatusCode = 'AUTHORISED' Then 'AUTHORISED'
                           When dsd.DocumentStatusCode = 'CANCELED' Then 'CANCELED'
                           When dsd.DocumentStatusCode = 'ONHOLD' Then 'ONHOLD'
                           When dsd.DocumentStatusCode = 'APPROVAL' Then 'APPROVAL'
                           When dsd.DocumentStatusCode = 'CLOSED' Then 'CLOSED'
                           When dsd.DocumentStatusCode = 'DEPTAPPROVED' Then 'DEPTAPPROVED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                           When dsd.DocumentStatusCode = 'AUDITED' Then 'AUDITED'
                           When dsd.DocumentStatusCode = 'SHORTCLOSED' Then 'SHORTCLOSED'
                           When dsd.DocumentStatusCode = 'STOREAPPROVED' Then 'STOREAPPROVED'
                      End  like nvl(:P527_STATUS,'%')
                  and a.PurchaseOrderNo like nvl(:P527_PONO,'%')
                  )xx
                  where xx.GRNSTATUS like nvl(:P527_GRNSTATUS,'%')
                Group By 
                        xx.TNo,
                      xx.SNo,
                      xx.LocationName,
                      xx.DocTypeName,
                      xx.PurchaseOrderNo,
                      xx.PurchaseOrderDate,
                      xx.PartyName,
                      xx.DeliveryDate,
                      xx.ItemCode,
                      xx.MaterialDetail,
                      xx.UOM,
                      xx.Quantity1,
                      xx.UOM2,
                      xx.Quantity2,
                      xx.AgentName,
                      XX.WITHOUTDISCOUNTRATE,
                      XX.DISCOUNTRATE,
                      xx.Rate,
                      xx.Amount,
                      xx.FooterAmount,
                      xx.TotalAmount,
                      xx.MIReceivedQty,
                      xx.balanceQty,
                      xx.DocumentStatusCode,
                      xx.DocStatus,
                      xx.FreightTypeCode,
                      xx.GRNStatus,
                      xx.POStatus,
                      xx.Creator,
                      xx.CreationTime,
                      xx.Description,
                      xx.WarrantyDescription,
                      xx.FreightRate
                )xxx
                where (:P527_TODOLIST='NO' OR  (:P527_TODOLIST='YES' AND EXISTS ( SELECT 1 FROM ONTHETABLE_APEX YY WHERE YY.TNO=XXX.TNO) ))
                AND ( :P527_NEXTPROCESS='NO' OR (:P527_NEXTPROCESS = 'YES' AND (  getdocumentstatuscode('PURCHASEORDER',XXX.TNO)='ACTIVE'
                                                    AND  NOT EXISTS (Select 1 From MaterialIn AA Where AA.Purchaseordertno = XXX.TNO)
                                                ))
                                                
                 )
                 and ( nvl(:P527_REMAININGDELIVERYDAYS,0) = 0 or XXX.DELIVERYDATE - TRUNC(SYSDATE) <= nvl(:P527_REMAININGDELIVERYDAYS,0) )
                ```
            pageItemsToSubmit: [
                P527_COMPANY
                P527_STATUS
                P527_FROMDATE
                P527_TODATE
                P527_LOCATION
                P527_PARTYNAME
                P527_DOCTYPE
                P527_ITEM
                P527_GRNSTATUS
                P527_ITEMSPECIFICATION
                P527_PONO
                P527_REMAININGDELIVERYDAYS
                P527_TODOLIST
                P527_NEXTPROCESS
                P527_MATERIALSTATUS
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
