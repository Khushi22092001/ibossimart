    region item-specification-revenue (
        name: Item Specification Revenue
        type: chart
        layout {
            sequence: 140
            parentRegion: @trade-analysis
            slot: subRegions
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent9
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
            fontSize: 8
        }

        series item-revenue-bar-chart (
            name: Item Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select A.ITEMSPECIFICATIONCODE As ITEMSPECIFICATIONCODE,
                           getitemSPECIFICATIONNAME(A.ITEMCODE, A.ITEMSPECIFICATIONCODE) As ItemSpecificationName,
                           Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           bi_datetime c,
                           item d,
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       and a.itemcode = d.itemcode
                       and d.itemnaturecode = 'FINISHEDITEM'
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P190_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P190_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P190_FINYEAR,'%')
                    
                       AND (:P190_TRADETYPE IS NULL OR A.TRADETYPECODE = ( select tradetypecode from tradetype where tno = :P190_TRADETYPE))
                       And (:P190_ITEM Is Null
                        Or NVL(X.PARENTCODE,X.ITEMCODE) = :P190_ITEM)
                    --   And (&P190_ITEMGROUP Is Null Or
                    --instr(':' || &P190_ITEMGROUP || ':', ':' || X.PATH || ':') > 0)
                     Group By a.itemcode, a.itemspecificationcode
                    
                    ```
                pageItemsToSubmit: [
                    P190_ITEMSPECIFICATION
                    P190_TRADETYPE
                    P190_ITEM
                ]
            }
            columnMapping {
                seriesName: ITEMSPECIFICATIONNAME
                label: ITEMSPECIFICATIONNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P190_ITEMSPECIFICATION',&ITEMSPECIFICATIONCODE.);
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

    region monthly-f-g-sales (
        name: "Monthly F.G. Sales "
        type: chart
        source {
            pageItemsToSubmit: [
                P190_MONTH
                P190_FIN_HALFYEAR
                P190_FINYEAR
                P190_ITEM
            ]
        }
        layout {
            sequence: 50
            parentRegion: @trade-analysis
            slot: subRegions
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent1
                t-Region--hiddenOverflow
            ]
        }
        chartLayout {
            height: 400
        }
        settings {
            timeAxisType: auto
        }
        legend {
            hideAndShowBehavior: noRescaling
        }

        series finished-goods (
            name: Finished Goods
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select --APEX_UTIL.PREPARE_URL
                    --('f?p=&APP_ID.:56:&APP_SESSION.::::P56_COMPANY,P56_FROMDATE,P56_TODATE:1,' || to_date(xx.month,'MON-YYYY')|| ',' ||LAST_DAY(to_date(xx.month,'MON-YYYY'))) AS LINK ,
                    TO_CHAR(to_date(xx.month,'MON-YYYY'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(xx.month,'MON-YYYY')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE,
                    xx.*
                      From (Select b.Fin_Qtr,
                                   b.Fin_Month,
                                   x.root_id,
                                   getitemname(x.root_id) As item,
                                   To_Char(a.CCInvoiceDate, 'MON-YYYY') As Month,
                                   To_Char(a.CCInvoiceDate, 'YYYYMM') As Monthyy,
                                   Sum(a.TotalAmount) Amount
                              From BI_SRevenue a,
                                   BI_DateTime b,
                                   (Select ITEMCODE,
                                           parentcode,
                                           RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                           Level,
                                           CONNECT_BY_ROOT itemcode As root_id,
                                           '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                           CONNECT_BY_ISLEAF As leaf
                                      From item a
                                     Start With parentcode Is Null
                                    Connect By parentcode = Prior itemcode
                                     Order Siblings By itemcode) x
                             Where A.ITEMCODE = X.ITEMCODE
                               And a.CCInvoiceDate = b.Fin_date
                            --and b.Fin_Qtr like nvl(:P190_FIN_QTR,'%')
                            --and b.Fin_year like nvl(:P190_FINYEAR,'%')
                               and (b.Fin_Qtr = :P190_FIN_QTR or :P190_FIN_QTR is null)
                              and (replace(b.Fin_year,'-','') = :P190_FINYEAR or :P190_FINYEAR is null)
                            
                             Group By b.Fin_Qtr,
                                      b.Fin_Month,
                                      To_Char(a.CCInvoiceDate, 'MON-YYYY'),
                                      To_Char(a.CCInvoiceDate, 'YYYYMM'),
                                      getitemname(x.root_id),
                                      x.root_id
                    
                             Order By To_Char(a.CCInvoiceDate, 'YYYYMM')) xx
                    where root_id='223'
                     Order By to_date(xx.month,'MON-YYYY'),root_id
                    
                    ```
                pageItemsToSubmit: P190_FIN_HALFYEAR
            }
            columnMapping {
                seriesName: ITEM
                label: MONTH
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P190_MONTH',&MONTHYY.);
            }
            label {
                show: true
                position: outsideBarEdge
                fontSize: 10
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            showAxis: false
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region quarterly-f-g-sales (
        name: "Quarterly F.G.Sales "
        type: chart
        layout {
            sequence: 40
            parentRegion: @trade-analysis
            slot: subRegions
            startNewRow: false
            column: 9
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent5
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 250
        }
        dataCursor {
            cursor: true
            behavior: smooth
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
        }

        series quater-pie-chart (
            name: Quater Pie Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                          a.Fin_Qtr_Name,
                          a.Fin_Qtr,
                          sum(c.TotalAmount)Amount
                    From  BI_DateTime a, BI_Srevenue c, Item b
                    Where a.Fin_Date = c.CCInvoiceDate
                      and c.itemcode = b.itemcode
                      and b.itemnaturecode = 'FINISHEDITEM'
                      and replace(a.Fin_Year,'-','') like nvl(:P190_FINYEAR,'%')
                      and (:P190_FIN_HALFYEAR IS NULL OR A.FIN_HALF_YEAR = :P190_FIN_HALFYEAR)
                    Group by a.Fin_Qtr_Name,
                             a.Fin_Qtr
                    Order by 2
                    ```
                pageItemsToSubmit: P190_FINYEAR
            }
            columnMapping {
                label: FIN_QTR_NAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P190_FIN_QTR',&FIN_QTR.);
            }
            label {
                show: true
                position: outsideSlice
                displayAs: percentageValue
                fontSize: 10
            }
        )

    )

    region trade-analysis (
        name: Trade Analysis
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent14
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-sm
                margin-left-sm
                margin-right-sm
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region yearly-sales-of-f-g (
        name: Yearly Sales of F.G.
        type: chart
        layout {
            sequence: 10
            parentRegion: @trade-analysis
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent1
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 250
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
        }

        series yearly-revenue (
            name: Yearly Revenue
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select a.Fin_Year FYNAME,
                           Replace(a.Fin_Year, '-', '') FYCODE,
                           Sum(TotalAmount) Amount
                      From BI_DateTime a, BI_SRevenue b, Item c
                     Where a.Fin_Date = b.CCInvoiceDate
                       And B.itemcode = c.itemcode
                       And c.itemnaturecode = 'FINISHEDITEM'
                     Group By a.Fin_Year
                    ```
            }
            columnMapping {
                label: FYNAME
                value: AMOUNT
                customTooltip: FYNAME
            }
            link {
                type: redirectUrl
                targetUrl: JavaScript:$s('P190_FINYEAR' ,&FYCODE. );
            }
            label {
                show: true
                position: outsideSlice
                displayAs: percentageValue
            }
        )

    )

