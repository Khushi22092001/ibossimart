                       And (:P190_TRADETYPE Is Null    Or A.TRADETYPECODE = ( select tradetypecode from tradetype where tno = :P190_TRADETYPE))
                       And (:P190_ITEM Is Null Or NVL(X.PARENTCODE,X.ITEMCODE) = :P190_ITEM)
                       and (:P190_ITEMSPECIFICATION IS NULL OR A.ITEMSPECIFICATIONCODE = :P190_ITEMSPECIFICATION)
                     Group By B.PARTYCODE, B.PARTYNAME
                     order by 6 desc
                    ```
