                    Select TO_CHAR(to_date(:P190_MONTH,'YYYYMM'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(:P190_MONTH,'YYYYMM')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE,B.PARTYCODE, B.PARTYNAME, Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           PARTY B,
                           BI_DateTime c,
                           (Select ITEMCODE,
                                   parentcode,
