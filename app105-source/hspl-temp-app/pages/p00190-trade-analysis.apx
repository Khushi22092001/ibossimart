    dynamicAction set-tradetype-code (
        name: SET TRADETYPE CODE
        execution {
            sequence: 170
        }
        when {
            selectionType: items
            items: P190_TRADETYPE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT TRADETYPECODE FROM TRADETYPE WHERE TNO = :P190_TRADETYPE
                itemsToSubmit: [
                    P190_TRADETYPE
                    P190_TRADETYPECODE
                ]
            }
            affectedElements {
                selectionType: items
                items: P190_TRADETYPECODE
            }
            execution {
                sequence: 10
            }
        )

    )

