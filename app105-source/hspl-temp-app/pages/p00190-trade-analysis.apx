    dynamicAction change-month (
        name: Change Month
        execution {
            sequence: 50
            eventScope: dynamic
        }
        when {
            selectionType: items
            items: P190_MONTH
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: [
                    P190_ITEM
                    P190_TRADETYPE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @f-g-sales
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-spec-cutomer-revenue
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-revenue
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-specification-revenue
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

