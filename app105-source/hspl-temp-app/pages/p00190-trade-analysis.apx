page 190 (
    name: Trade Analysis
    alias: TRADE-ANALYSIS
    title: Trade Analysis
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region agent-wise-sales (
        name: Agent  Wise Sales
        type: chart
        layout {
            sequence: 90
            parentRegion: @trade-analysis
            slot: subRegions
            startNewRow: false
            column: 5
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent10
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            stack: true
        }
        chartLayout {
            height: 400
        }
        multiSeriesChartData {
            sortOrder: valueAsc
        }
        tooltip {
            showSeriesName: false
        }
        legend {
            show: false
        }

        series item-revenue-bar-chart (
            name: Item Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select TO_CHAR(to_date(:P190_MONTH,'YYYYMM'),'DD-MON-RRRR') AS FromDate,
                    TO_CHAR(last_day(to_date(:P190_MONTH,'YYYYMM')),'DD-MON-RRRR') as ToDate,
                    'CO' AS LOCATIONCODE,
                    B.PARTYCODE, B.PARTYNAME, Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           PARTY B,
                           BI_DateTime c,
                           ITEM D
                     Where A.AGENTCODE = B.PARTYCODE
                       AND A.ITEMCODE= D.ITEMCODE
                       AND D.ITEMNATURECODE = 'FINISHEDITEM'
                       and a.CCInvoiceDate = c.Fin_Date  
                       and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P190_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P190_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P190_FINYEAR,'%')
                       and (:P190_TRADETYPE is null or a.tradetypecode in (select tradetypecode from tradetype where tno = :P190_TRADETYPE))
                      Group By B.PARTYCODE, B.PARTYNAME
                    order by 6 desc
                    
                    ```
                pageItemsToSubmit: [
                    P190_ITEM
                    P190_MONTH
                    P190_QUARTER
                ]
            }
            columnMapping {
                label: PARTYNAME
                value: AMOUNT
            }
            link {
                type: redirectThisApp
                target: {
                    page: 56
                    items: {
                        P56_COMPANY: 1
                        P56_LOCATION: &LOCATIONCODE.
                        P56_FROMDATE: &FROMDATE.
                        P56_TODATE: &TODATE.
                        P56_DOCTYPE: CHALANCUMINVOICE
                        P56_STATUS: ACTIVE
                        P56_AGENTCODE: &PARTYCODE.
                        P56_TRADETYPE: &P190_TRADETYPECODE.
                    }
                    clearCache: 56
                    action: resetPagination
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region f-g-sales (
        name: F.G. Sales
        type: chart
        layout {
            sequence: 60
            parentRegion: @trade-analysis
            slot: subRegions
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--accent9
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
            fontSize: 8
        }

        series item-group-revenue-bar-chart (
            name: Item Group Revenue Bar Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select e.tno as ROOT_ID,
                           e.tradetypecode ,
                           e.TradeTypeName As RootName,
                           Sum(a.totalamount) Amount
                      From bi_srevenue a,
                           bi_datetime c,
                           item        d,
                           TradeType   e,
                           
                           (Select ITEMCODE,
                                   parentcode,
                                   RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                                   Level,
                                   CONNECT_BY_ROOT itemcode As root_id,
                                   '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                                   CONNECT_BY_ISLEAF As leaf
                              From item a
                             Start With parentcode Is Null
                            Connect By parentcode = Prior itemcode
                             Order Siblings By itemcode) x
                     Where A.ITEMCODE = X.ITEMCODE
                       And a.CCInvoiceDate = c.Fin_Date
                       And a.itemcode = d.itemcode
                       And a.TradeTypeCode = e.TradeTypeCode
                       And d.itemnaturecode = 'FINISHEDITEM'
                    --	 And :P190_tradetype Is Null Or A.TradeTypeCode = :P190_TradeType
                      and To_Char(a.CCInvoiceDate,'YYYYMM') like nvl(:P190_MONTH,'%')
                       and c.Fin_Qtr like nvl(:P190_FIN_QTR,'%')
                       and replace(c.Fin_year,'-','') like nvl(:P190_FINYEAR,'%')
                    
                     Group By e.tradetypecode, e.TradeTypeName, e.tno
                    
                    ```
                pageItemsToSubmit: [
                    P190_TRADETYPE
                    P190_ITEM
                ]
            }
            columnMapping {
                seriesName: ROOTNAME
                label: ROOTNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P190_TRADETYPE',&ROOT_ID.);
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

    region halfyearly-f-g-sales (
        name: "HalfYearly F.G. Sales "
        type: chart
        layout {
            sequence: 30
            parentRegion: @trade-analysis
            slot: subRegions
            startNewRow: false
            column: 5
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--accent3
                t-Region--hiddenOverflow
            ]
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 250
        }
        dataCursor {
            cursor: true
            behavior: smooth
        }
        settings {
            pieSelectionEffect: highlightAndExplode
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }
        legend {
            position: top
        }

        series halfyear-pie-chart (
            name: HalfYear Pie Chart
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select a.FIN_HALF_YEAR_NAME, 
                           a.FIN_HALF_YEAR, 
                    	   Sum(c.TotalAmount) Amount
                      From BI_DateTime a, BI_Srevenue c, Item b
                     Where a.Fin_Date = c.CCInvoiceDate
                       and c.itemcode = b.itemcode
                       and b.itemnaturecode = 'FINISHEDITEM'
                       And Replace(a.Fin_Year, '-', '') Like nvl(:P190_FINYEAR, '%')
                     Group By a.FIN_HALF_YEAR_NAME, a.FIN_HALF_YEAR
                     Order By 2
                    ```
                pageItemsToSubmit: P190_FINYEAR
            }
            columnMapping {
                label: FIN_HALF_YEAR_NAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P190_FIN_HALFYEAR',&FIN_HALF_YEAR.);
            }
            label {
                show: true
                position: outsideSlice
                displayAs: percentageValue
                fontSize: 10
            }
        )

    )

