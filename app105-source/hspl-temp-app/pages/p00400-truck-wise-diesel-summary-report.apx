    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction preparerecord (
        name: PrepareRecord
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    PrepareTruckDieselReport(:P400_COMPANY, :P400_LOCATION, :P400_VEHICLE, :P400_VEHICLETYPE, :P400_TRANSPORTER, :P400_DRIVER, :P400_TRANSPORTAREA, :P400_FROMDATE, :P400_TODATE, :APP_USER, 400);
                    
                    
                    ```
                itemsToSubmit: [
                    P400_FROMDATE
                    P400_TODATE
                    P400_COMPANY
                    P400_VEHICLE
                    P400_TRANSPORTER
                    P400_LOCATION
                    P400_VEHICLETYPE
                    P400_TRANSPORTAREA
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @truck-wise-diesel-summary-report
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

