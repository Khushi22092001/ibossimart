page 400 (
    name: Truck Wise Diesel Summary Report
    alias: TRUCK-WISE-DIESEL-SUMMARY-REPORT
    title: Truck Wise Diesel Summary Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region truck-wise-diesel-summary-filter (
        name: Truck Wise Diesel Summary Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region truck-wise-diesel-summary-report (
        name: Truck Wise Diesel Summary Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Select
                   vt.VehicleTypeCode,
                   a.CompanyCode,
                   a.EquipmentId as VehicleNo,
                   sum(b.Quantity1),
                   sum(nvl(a.NoOfTrip, 0)) as NoOfTrip,
                   ts.TransporterName,
                   ts.TransporterCode,
                   Case 
                      When sum(a.NoOfTrip) = 0 Then
                        sum(a.NoOfTrip)
                      Else
                    Round((sum(b.Quantity1)/sum(a.NoOfTrip)),2)
                    End as AverageTrip
                From NecessitySlip a , NecessitySlipDetail b,Transporter ts, CompanyVehicle co,VehicleType vt
                where a.tno = b.tno
                   and a.TransporterCode = ts.TransporterCode
                   and a.EquipmentId = co.CompanyVehicleNo(+)
                   and co.VehicleTYpeCode = vt.VehicleTypeCode(+)
                   and a.necessitySlipNo is not null
                   and b.VehicleNecessityCode = 'DIESEL'
                   and a.NecessitySlipDate Between :P400_FROMDATE and :P400_TODATE
                   and ( :P400_COMPANY IS NULL OR instr(':'||:P400_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                   and ( :P400_VEHICLE IS NULL OR instr(':'||:P400_VEHICLE||':',':'||a.VehicleNo||':') > 0 )
                   and ( :P400_DRIVER IS NULL OR instr(':'||:P400_DRIVER||':',':'||a.DriverCode||':') > 0 ) 
                   and ( :P400_LOCATION IS NULL OR instr(':'||:P400_LOCATION||':',':'||a.LocationCode||':') > 0 )
                   and ( :P400_TRANSPORTER IS NULL OR instr(':'||:P400_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 )
                   and ( :P400_VEHICLETYPE IS NULL OR instr(':'||:P400_VEHICLETYPE||':',':'||vt.VehicleTypeCode||':') > 0 ) 
                Group by
                   a.EquipmentId,
                   ts.TransporterName,
                   ts.TransporterCode,
                   a.CompanyCode,
                   vt.VehicletypeCode
                ; 
                */
                Select 
                  a.*, 
                  Rownum as SerialNo
                 From 
                (Select
                    a.VehicleTypeCode,
                    a.CompanyCode,
                    a.VehicleNo,
                    a.TransporterName,
                    a.TransporterCode,
                    a.TransportAreaCode,
                    a.TransportAreaName,
                    Case 
                    When sum(a.NoOfTrip) = 0 Then
                    sum(a.NoOfTrip)
                    Else
                    Round((sum(a.Quantity1)/sum(a.NoOfTrip)),2)
                    End as AverageTrip,
                    sum(a.Quantity1) as DieselQuantity,
                    sum(a.NoOfTrip) as NoOfTrip
                From TruckDieselReportTable a
                Where a.Creator = :APP_USER
                    and a.PageNo = 400
                    and :P400_FROMDATE is not null
                Group by
                    a.VehicleTypeCode,
                    a.CompanyCode,
                    a.VehicleNo,
                    a.TransporterName,
                    a.TransporterCode,
                    a.TransportAreaCode,
                    a.TransportAreaName) a
                ;
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 2798045420387986
        }

