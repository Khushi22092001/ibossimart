page 251 (
    name: MaintenanceStrategyReport
    alias: MAINTENANCESTRATEGY1
    title: MaintenanceStrategy
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenancestrategy (
        name: MaintenanceStrategy
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                row_number() over(order by a.TNO) SerialNo,
                a.maintenancestrategycode,
                b.BOSSUSERcode,
                a.maintenancestrategyname,
                a.scheduleindicator,
                a.strategyunit,
                a.callhorizon,
                a.isjobcardrequired,
                to_char(A.creationTIME,'DD-MM-YYYY HH24:MI:SS') AS "Creation Time",
                b.Bossusername as Creator
                from maintenancestrategy a, documentstatusdetail c,bossuser b
                WHERE A.CREATOR=b.LOGINNAME
                AND A.TNO=C.MODULETNO
                and (:P251_STRATEGYNAME IS NULL OR instr(':'||:P251_STRATEGYNAME||':',':'||a.maintenancestrategycode||':') > 0)
                and (:P251_SCHEDULEINDICATOR IS NULL OR instr(':'||:P251_SCHEDULEINDICATOR||':',':'||a.SCHEDULEINDICATOR||':') > 0)
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 6954160311058906
        }

        column BOSSUSERCODE (
            type: hidden
            heading {
                heading: Bossusercode
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CALLHORIZON (
            type: plainText
            heading {
                heading: Call Horizon
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column "Creation Time" (
            type: plainText
            heading {
                heading: Creation Time
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ISJOBCARDREQUIRED (
            type: plainText
            heading {
                heading: Is Job Card Required
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column MAINTENANCESTRATEGYCODE (
            type: hidden
            heading {
                heading: Strategy Name
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column MAINTENANCESTRATEGYNAME (
            type: plainText
            heading {
                heading: Strategy Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column SCHEDULEINDICATOR (
            type: plainText
            heading {
                heading: Schedule Indicator
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column STRATEGYUNIT (
            type: plainText
            heading {
                heading: Strategy Unit
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: MaintenanceStrategy
        }

        savedReport 71134 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CALLHORIZON (
                sequence: 5
            )

            displayColumn CREATOR (
                sequence: 8
            )

            displayColumn "Creation Time" (
                sequence: 7
            )

            displayColumn ISJOBCARDREQUIRED (
                sequence: 6
            )

            displayColumn MAINTENANCESTRATEGYNAME (
                sequence: 2
            )

            displayColumn SCHEDULEINDICATOR (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn STRATEGYUNIT (
                sequence: 4
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region maintenancestrategy-2 (
        name: MAINTENANCESTRATEGY
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P251_SCHEDULEINDICATOR (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Schedule Indicator
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                SCHEDULEINDICATOR D,
                SCHEDULEINDICATOR R 
                FROM MAINTENANCESTRATEGY
                ```
        }
        layout {
            sequence: 40
            region: @maintenancestrategy-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P251_STRATEGYNAME (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Strategy Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                MAINTENANCESTRATEGYNAME D,
                MAINTENANCESTRATEGYCODE R
                FROM MAINTENANCESTRATEGY
                ```
        }
        layout {
            sequence: 30
            region: @maintenancestrategy-2
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 50
            region: @maintenancestrategy-2
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

