page 232 (
    name: Daily Dispatch Timing Report
    alias: DAILY-DISPATCH-TIMING-REPORT
    title: Daily Dispatch Timing Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region daily-dispatch-timing (
        name: "Daily Dispatch Timing "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                a.*,
                RowNum as MySNo
                 From(Select
                    com.CompanyName,
                    com.OfficeAddress,
                    sysdate as printdate,
                	a.TNO,
                	a.LRNo, 
                	a.GPNo,
                	a.VehicleNo,
                	Sum(a.Quantity1),
                	Sum(a.Nos),
                	dl.DestinationLocationName,
                	To_CHAR(pl.CreationTime,'DD-MON-YYYY HH:MM') as InTime,
                	To_CHAR(a.CreationTime,'DD-MON-YYYY HH:MM') as OutTime,
                	GetTimeHH24MI((a.CreationTime - pl.CreationTime )* 86400) as DifferenceDays,
                	a.ConsigneeName,
                	t.TransporterName,
                	e.ItemName,
                	a.PartyRefNo,
                	a.PartyRefDate,
                	lo.LoadingOrderNo,
                    sl.SourceLocationName,
                    a.InvoiceNo,
                    a.LRDate
                from LR a, Party c ,Item e, ItemSpecification ee, MeasuringUnit mu1, 
                     DestinationLocation dl, SourceLocation sl, Placement pl, Transporter t,
                     LoadingOrder lo, Company Com
                where a.PartyCode = c.PartyCode
                	and a.ItemCode = e.ItemCode
                	and a.ItemSpecificationCode = ee.ItemSpecificationCode
                	and e.MeasuringUnitCode1 = mu1.MeasuringUnitCode
                	and a.DestinationLocationTNO = dl.TNo(+)
                	and a.SourceLocationTNO = sl.TNo(+)
                	and a.PlacementTNO = pl.TNo(+)
                	and a.TransporterCode  = t.TransporterCode(+)
                	and a.LoadingOrderTNo = lo.TNo(+)
                    and a.companyCode = Com.CompanyCode(+)
                    and a.LRDate Between :P232_FROMDATE and :P232_TODATE
                    Group by
                    com.CompanyName,
                    com.OfficeAddress,
                	a.TNO,
                	a.LRNo, 
                    a.LRDate,
                	a.GPNo,
                	a.VehicleNo,
                	dl.DestinationLocationName,
                	pl.CreationTime,
                	a.CreationTime,
                	a.CreationTime ,
                    pl.CreationTime,
                	a.ConsigneeName,
                	t.TransporterName,
                	e.ItemName,
                	a.PartyRefNo,
                	a.PartyRefDate,
                	lo.LoadingOrderNo,
                    sl.SourceLocationName,
                    a.InvoiceNo) a
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 21816597979257208
        }

