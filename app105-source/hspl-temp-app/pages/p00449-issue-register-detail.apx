    pageItem P449_ISSUENO (
        type: textFieldWithAutocomplete
        label {
            label: IssueNo
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select IssueNo 
                From Issue 
                Where instr(':'||:P449_LOCATION||':',':'||LocationCode||':') > 0
                  and IssueDate Between :P449_FROMDATE and :P449_TODATE
                Order by 1
                ```
