        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                        Distinct
                        d.DepartmentName d,
                        d.DepartmentCode r
                From Requisition a,Department d
                Where a.DepartmentCode = d.DepartmentCode
                ```
            displayExtraValues: false
            displayNullValue: false
