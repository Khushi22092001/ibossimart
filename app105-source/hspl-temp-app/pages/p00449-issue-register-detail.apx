    region issue-register-detail-2 (
        name: issue Register Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                   a.LocationName as Location,
                   a.DoctypeName as Doctype,
                   a.IssueNo,
                   a.IssueDate,
                   a.RequisitionNo,
                   a.PartyName,
                   a.IssueToEmployee as IssuedTo,
                   a.CostCentreName as CostCentre,
                   a.SerialNo,
                   a.ItemName as MaterialDescription,
                   a.Quantity1 as Qty,
                   ROUND(a.Rate,2) as Rate,
                   ROUND(a.Amount,2) as Amount,
                   a.DepartmentName,
                   a.IssueReturnNo,
                   a.IssueReturnDate,
                   ROUND(a.IssueReturnAmount,2) as IssueReturnAmt,
                   a.IssueReturnQuantity1 as IssueReturnQty,
                   Round(a.NetAmount,2) as NetItemAmount,
                   a.HourMeterReading,
                   a.KmMeterReading,
                   a.UserRaisedBy,
                   a.GRNNo,
                   a.CreationTime as TimeStamp,
                   a.Description,
                   a.PBPassNo,
                   a.PrimaryUnit/*,
                   a.DealsInName,
                   a.FitmentLocation,
                   a.ItemGroupName,
                   a.ItemCategoryName
                   */
                From IssueRegister a
                WHERE A.ISSUEDATE BETWEEN :P449_FROMDATE AND :P449_TODATE
                  AND INSTR(':'||:P449_COMPANY||':',':'||A.COMPANYCODE||':') > 0
                  AND ( :P449_LOCATION IS NULL OR INSTR(':'||:P449_LOCATION||':',':'||A.LOCATIONCODE||':') > 0 ) 
                  AND INSTR(':'||:P449_DOCTYPE||':',':'||A.DOCTYPECODE||':') > 0
                  AND ( :P449_ITEM IS NULL OR INSTR(':'||:P449_ITEM||':',':'||a.ITEMCODE||':') > 0 ) 
                 AND ( :P449_ITEMSPECIFICATION IS NULL OR INSTR(':'||:P449_ITEMSPECIFICATION||':',':'||a.ITEMSPECIFICATIONCODE||':') > 0 ) 
                 AND ( :P449_DEPARTMENT IS NULL OR INSTR(':'||:P449_DEPARTMENT||':',':'||a.DEPARTMENTCODE||':') > 0 ) 
                  AND ( :P449_COSTCENTRE IS NULL OR INSTR(':'||:P449_COSTCENTRE||':',':'||a.COSTCENTRECODE||':') > 0 ) 
                  AND  A.ISSUENO LIKE NVL(:P449_ISSUENO,'%')
                --  AND ( :P449_EQUIPMENT IS NULL OR INSTR(':'||:P449_EQUIPMENT||':',':'||EG.EQUIPMENTGROUPCODE||':') > 0 )
                --  AND ( :P449_GROUP IS NULL
                --      OR
                --      EXISTS (SELECT 1 FROM (SELECT ITEMCODE,
                --               PARENTCODE,
                --               RPAD('.', (LEVEL - 1) * 2, '.') || ITEMCODE AS TREE,
                --               LEVEL,
                --               CONNECT_BY_ROOT ITEMCODE AS ROOT_ID,
                --               '-' || LTRIM(SYS_CONNECT_BY_PATH(ITEMCODE, '-'), '-') || '-' AS PATH,
                --               CONNECT_BY_ISLEAF AS LEAF
                --          FROM ITEM A
                --         START WITH PARENTCODE IN ( SELECT ITEMCODE FROM ITEM XX WHERE
                --                                    INSTR(':'||:P449_GROUP||':',':'||XX.ITEMCODE||':') > 0)
                --                                    
                --        CONNECT BY PARENTCODE = PRIOR ITEMCODE
                --         ORDER SIBLINGS BY ITEMCODE) X WHERE X.ITEMCODE = E.ITEMCODE
                --        )
                --    );
                ;
                ```
            pageItemsToSubmit: P449_COMPANY
        }
        layout {
            sequence: 20
            slot: body
        }
