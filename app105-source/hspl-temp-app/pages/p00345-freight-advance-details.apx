page 345 (
    name: Freight Advance Details
    alias: FREIGHT-ADVANCE-DETAILS
    title: Freight Advance Details
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region freight-advance-detail (
        name: Freight Advance Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select   
                     row_number() over(order by a.VoucherDate) SerialNo,
                     a.VoucherDate,
                     a.VoucherNo,
                     f.LRNo,
                     fa.FreightAdviceNo,
                     f.GPNo,
                     f.GPDate,
                     f.VehicleNo,
                     ee.Quantity1,
                     g.TransporterName,
                     h.PartyName as AccountName,
                     abs(b.Amount) as DebitAmount
                from voucher a, VoucherDetail b, Issue c,Requisition d, NecessitySlip e, NecessitySlipDetail ee, LR f, FreightAdviceDetail fad, FReightAdvice fa, Transporter g, Party h,
                Module i
                where a.Tno = b.Tno
                  and a.ModuleTno = c.Tno(+)
                  and c.REQUISITIONTNO = d.Tno(+)
                  and d.MODULETNO = e.Tno(+)
                  and e.Tno = ee.Tno(+)
                  and e.LrTno = f.Tno(+)
                  and f.Tno = fad.ModuleTno(+)
                  and fad.Tno = fa.Tno(+)
                  and e.TransporterCode = g.TransporterCode(+)
                  and b.AccountCode = h.PartyCode(+)
                  and a.ModuleCode = i.ModuleCode(+)
                  and a.ModuleCode = 'ISSUE'
                  and b.AccountCode = 'FREIGHTADVANCEACCOUNT'
                  and nvl(b.Amount,0)< 0
                  and a.VoucherDate between :P345_FROMDATE and :P345_TODATE
                  and ( :P345_MODULE IS NULL OR instr(':'||:P345_MODULE||':',':'||i.ModuleCode||':') > 0 ) 
                  and ( :P345_TRANSPORTER IS NULL OR instr(':'||:P345_TRANSPORTER||':',':'||g.TransporterCode||':') > 0 ) 
                UNION ALL
                select 
                    row_number() over(order by a.VoucherDate) SerialNo, 
                    a.VoucherDate,
                    a.VoucherNo,
                    f.LRNo,
                    fa.FreightAdviceNo,
                    f.GPNo,
                    f.GPDate,
                    f.VehicleNo,
                    ee.Quantity1,
                    g.TransporterName,
                    h.PartyName as AccountName,
                    abs(b.Amount) as DebitAmount
                from voucher a, VoucherDetail b, NecessitySlip e,NecessitySlipDetail ee, LR f, FreightAdviceDetail fad, FreightAdvice fa, Transporter g, Party h, Module i
                where a.Tno = b.Tno
                  and a.MODULETNO = e.Tno(+)
                  and e.Tno = ee.Tno(+)
                  and e.LrTno = f.Tno(+)
                  and f.Tno = fad.ModuleTno(+)
                  and fad.Tno = fa.Tno(+)
                  and e.TransporterCode = g.TransporterCode(+)
                  and b.AccountCode = h.PartyCode(+)
                  and a.ModuleCode = i.ModuleCode(+)
                  and a.ModuleCode = 'NECESSITYSLIP'
                  and b.AccountCode = 'FREIGHTADVANCEACCOUNT'
                  and nvl(b.Amount,0) < 0
                  and a.VoucherDate between :P345_FROMDATE and :P345_TODATE
                  and ( :P345_MODULE IS NULL OR instr(':'||:P345_MODULE||':',':'||i.ModuleCode||':') > 0 ) 
                  and ( :P345_TRANSPORTER IS NULL OR instr(':'||:P345_TRANSPORTER||':',':'||g.TransporterCode||':') > 0 ) 
                UNION ALL
                select
                    row_number() over(order by a.VoucherDate) SerialNo, 
                    a.VoucherDate,
                    a.VoucherNo,
                    f.LRNo,
                    fa.FreightAdviceNo,
                    NVL(e.GPNo,f.GPNo) as GPNo,
                    f.GPDate,
                    e.VehicleNo,
                    cc.Quantity1,
                    g.TransporterName,
                    h.PartyName as AccountName,
                    abs(b.Amount) as DebitAmount
                from voucher a, VoucherDetail b, FreightAdvance e, LR f, NecessitySlip c, NecessitySlipDetail cc,FreightAdviceDetail fad, FreightAdvice fa,Transporter g, Party h,Module i
                where a.Tno = b.Tno
                  and a.MODULETNO = e.Tno(+)
                  and e.LrTno = f.Tno(+)
                  and f.Tno = c.LRTno
                  and c.Tno = cc.Tno
                  and f.Tno = fad.ModuleTno(+)
                  and fad.Tno = fa.Tno(+)
                  and e.TransporterCode = g.TransporterCode(+)
                  and b.AccountCode = h.PartyCode(+)
                  and a.ModuleCode = i.ModuleCode(+)
                  and a.ModuleCode = 'FREIGHTADVANCE'
                  and b.AccountCode = 'FREIGHTADVANCEACCOUNT'
                  and nvl(b.Amount,0)< 0
                  and a.VoucherDate between :P345_FROMDATE and :P345_TODATE
                  and ( :P345_MODULE IS NULL OR instr(':'||:P345_MODULE||':',':'||i.ModuleCode||':') > 0 ) 
                  and ( :P345_TRANSPORTER IS NULL OR instr(':'||:P345_TRANSPORTER||':',':'||g.TransporterCode||':') > 0 ) 
                ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 53615201487479735
        }

        column ACCOUNTNAME (
            type: plainText
            heading {
                heading: Account Name
                alignment: center
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column DEBITAMOUNT (
            type: plainText
            heading {
                heading: Debit Amount
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column FREIGHTADVICENO (
            type: plainText
            heading {
                heading: Freight Advice No
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column GPDATE (
            type: plainText
            heading {
                heading: GP Date
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column GPNO (
            type: plainText
            heading {
                heading: GP No.
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column LRNO (
            type: plainText
            heading {
                heading: LR No
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Quantity
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column TRANSPORTERNAME (
            type: plainText
            heading {
                heading: Transporter Name
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: Vehicle No
                alignment: center
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column VOUCHERDATE (
            type: plainText
            heading {
                heading: Voucher Date
                alignment: center
            }
            layout {
                sequence: 10
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column VOUCHERNO (
            type: plainText
            heading {
                heading: Voucher No
                alignment: center
