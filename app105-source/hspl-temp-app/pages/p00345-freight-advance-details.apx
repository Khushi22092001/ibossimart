            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            fontWeight: bold
            fontSize: 16
            pageHeaderText: "   Freight Advance Report"
        }

        savedReport 557839 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTNAME (
                sequence: 11
            )

            displayColumn DEBITAMOUNT (
                sequence: 12
            )

            displayColumn FREIGHTADVICENO (
                sequence: 5
            )

            displayColumn GPDATE (
                sequence: 7
            )

            displayColumn GPNO (
                sequence: 6
            )

            displayColumn LRNO (
                sequence: 4
            )

            displayColumn QUANTITY1 (
                sequence: 9
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TRANSPORTERNAME (
                sequence: 10
            )

            displayColumn VEHICLENO (
                sequence: 8
            )

            displayColumn VOUCHERDATE (
                sequence: 2
            )

            displayColumn VOUCHERNO (
                sequence: 3
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: DEBITAMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P345_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @freight-advance-detail
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P345_MODULE (
        type: popupLov
        label {
            label: Module
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                distinct
                c.ModuleName,
                c.ModuleCode
                From Voucher a, VoucherDetail b, Module c
                Where a.Tno = b.Tno
                and a.ModuleCode = c.ModuleCode
                and b.AccountCode = 'FREIGHTADVANCEACCOUNT'
                and nvl(b.Amount,0)< 0;
                ```
            nullDisplayValue: - Select List-
        }
        layout {
            sequence: 30
            region: @freight-advance-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P345_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @freight-advance-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P345_TRANSPORTER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Transporter Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                a.TransporterName d,
                a.TransporterCode r
                From Transporter a;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @freight-advance-detail
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Transporter Name
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 50
            region: @freight-advance-detail
            slot: regionBody
            startNewRow: false
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

