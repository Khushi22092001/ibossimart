            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column TRANSPORTAREANAME (
            type: plainText
            heading {
                heading: Transport Area
                alignment: center
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: Vehicle No
                alignment: center
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column VEHICLETYPENAME (
            type: plainText
            heading {
                heading: Vehicle Type
                alignment: center
            }
            layout {
                sequence: 160
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Diesel Detail
        }

        savedReport 505176 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn AMOUNT (
                sequence: 8
            )

            displayColumn MODULEDATE (
                sequence: 4
            )

            displayColumn MODULENAME (
                sequence: 2
            )

            displayColumn MODULENO (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TRANSPORTAREANAME (
                sequence: 7
            )

            displayColumn VEHICLENO (
                sequence: 5
            )

            displayColumn VEHICLETYPENAME (
                sequence: 6
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                function: count
                column: ISSUEDATE
            )

            aggregate (
                function: count
                column: NECESSITYSLIPDATE
            )

            controlBreak (
                column: TRANSPORTAREANAME
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P330_COMPANYCODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P330_FROMDATE (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P330_TODATE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P330_TRANSPORTAREA (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P330_VEHICLENO (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P330_VEHICLENO2 (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P330_VEHICLETYPE (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

