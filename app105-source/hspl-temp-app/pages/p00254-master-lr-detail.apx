            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P254_VEHICLE (
        type: popupLov
        label {
            label: Vehicle No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.VehicleNo d,
                a.VehicleNo r
                From LR a
                ```
            displayNullValue: false
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 60
            region: @master-lr-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P254_VEHICLEGROUP (
        type: popupLov
        label {
            label: Vehicle Group
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                a.vehiclegroupName d,
                a.VehicleGroupCode r
                from CompanyVehicle b,vehiclegroup a
                where b.VehicleGroupCode = a.VehicleGroupCode
                ```
        }
        layout {
            sequence: 210
            region: @master-lr-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P254_WORKORDER (
        type: popupLov
        label {
            label: Work Order No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.workOrderno d,
                a.workorderno r
                From  LR b, loadingorder a
                where b.LoadingOrderTno = a.Tno
                
                ```
            displayNullValue: false
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 100
            region: @master-lr-detail
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 220
            region: @master-lr-detail
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

