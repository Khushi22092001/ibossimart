page 254 (
    name: Master LR Detail Report
    alias: MASTER-LR-DETAIL
    title: Master LR Detail Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region master-lr-detail (
        name: Master LR Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region master-lr-detail-report (
        name: Master LR Detail Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    ROWNUM AS SERIALNO,
                    cc.DeliveryOrderNo "Delivery Order No",
                    cc.DeliveryOrderDate "Delivery Order Date",
                    m.PartyName as "Party Name",
                    c.PartyRefNo as "Party Do No",
                    cc.PartyPoNo as "Party Po No",
                    ad.DoctypeName as "Party DO Doctype",
                    n.ItemName ||'-'|| o.ItemSpecificationName as "Item Name",
                    round(ccd.Quantity1,2) as "Delivery Order Qty",
                    cc.FromDate ||' To '||cc.ToDate as "Delivery Order Valid Date",
                    c.WorkOrderNo "Work Order No",
                    c.WorkOrderDate "Work Order Date",
                    c.loadingorderNo "loading Order No",
                    c.loadingorderDate "loading Order Date",
                    round(c.Quantity1,2) as "loading Order Qty",
                    c.FromDate ||' To '||c.ToDate as "Loading Order Valid Date",
                    p.SourceLocationName,
                    q.DestinationLocationName,
                    b.PlacementNo "Placement No",
                    b.PlacementDate "Placement Date",
                    b.VehicleNo "Vehicle No",
                    b.DriverName "Driver Name",
                    b.DriverMobileNo as "Driver Mobile No",
                    b.DriverLicenceNo as "Driver Licence No",   
                    a.LRNo "LR No",
                    a.LRDate "LR Date",
                    a.GpNo as "GP No",
                    a.GPDate as "GP Date",
                    round(a.Quantity1,2) as "LR Qty",
                    r.TransporterName as "Transporter Name",
                    u.FreightRateListNo as "Contract No",
                    g.PODNo as "POD No",
                    g.PODDate as "POD Date",
                    round(h.Quantity1,2) as "POD Quantity",
                    h.DeliveryDate as "Delivery Date",
                    w.Routename as "Route Name",
                    d.NecessitySlipNo as "Necessity Slip No",
                    d.NecessitySlipDate as "Necessity Slip Date",
                    round(d.DieselAmount,2) as "Diesel Amount",
                    e.PartyName as Pump,
                    f.StoragelocationName as "Own Stock",
                    l.ServiceBillNo as "Service Bill No",
                    l.ServiceBillDate as "Service Bill Date",
                    k.FreightRate as "Service Bill Rate",
                    round(l.SumofAmount,2) as "Service Bill Amt",
                    i.FreightAdviceNo "Freight Advice No",
                    i.FreightAdviceDate "Freight Advice Date",
                    j.Rate as "Freight Advice Rate",
                    round(j.Amount,2) as "Freight Advice Amount",
                    round(j.ShortageQuantity1,2) as "Freight Advice Shortage Qty",
                    c.ToleranceValue as "ToleranceValue",
                    j.DeductionRate as "Deduction Rate",
                    doe.NetFreightRate as "NetFreightRate",
                    round(j.DeductionAmount,2) as "Deduction Amount",
                    round(j.TDSAmount,2) as "TDS Amount",
                    s.LocationName as "Location Name",
                    t.Companyname as "Company Name",
                    x.FreightAdviceStatus,
                    y.PODStatus,
                    z.ServiceBillStatus,
                    a.Creator,
                    a.EwayBillNo,
                    a.EwayBillDate,
                    cc.PartyPONO,
                    cc.LineItem
                from LR a, Placement b, LoadingOrder c, DeliveryOrder cc, DeliveryOrderDetail ccd, DOExpensesDetail doe, 
                   (Select 
                   d.NecessitySlipDate as NecessitySlipDate,
                    d.NecessitySlipNo
                    as NecessitySlipNo, 
                    Sum(dd.DieselRate * dd.Quantity1) as DieselAmount ,
                    d.LrTno,
                    d.StoragelocationCode, 
                    d.PartyCode 
                    From NecessitySlip d, NecessitySlipDetail dd
                    Where d.Tno = dd.Tno 
                    Group by d.LrTno, 
                    d.StoragelocationCode,
                    d.PartyCode,
                    d.NecessitySlipDate, 
                    d.NecessitySlipNo)d,
                    Party e, StorageLocation f, POD g, PODDetail h , FreightAdvice i, FreightAdviceDetail j,
                    ServiceBillLr k, ServiceBill l, servicebillDetail lm ,Party m , Item n, ItemSpecification o, 
                    Sourcelocation p,DestinationLocation q, Transporter r , Location s, Company t , CompanyVehicle cov,VehicleGroup vg,
                    FreightRatelist u,Route w,Doctype ad,
                    (Select
                     c.Tno,
                     case when aa.tno is null then 'PENDING'
                     when aa.Tno is not null and dsd1.ModuleTno is null 
                     or (aa.Tno is not null and dsd1.moduletno is not null and dsd1.documentstatuscode <> 'ACTIVE') 
                     then 'PREPAIRED'
                     when aa.Tno is not null and aa.Tno is not null and dsd1.ModuleTno is Not null and dsd1.DocumentStatusCode = 'ACTIVE' 
                     then 'ACTIVE' End as FreightAdviceStatus
                     From Lr c, FreightAdvicedetail aa, DocumentStatusDetail dsd1
                     Where c.Tno = aa.ModuleTno(+)
                     and aa.Tno = dsd1.ModuleTno(+)) x,
                  (Select
                     c.Tno,
                     dsd1.moduletno,
                     case when aa.tno is null then 'PENDING'
                     when aa.Tno is not null and dsd1.ModuleTno is null 
                     or (aa.Tno is not null and dsd1.moduletno is not null and dsd1.documentstatuscode <> 'ACTIVE') 
                     then 'PREPAIRED'
                     when aa.Tno is not null and aa.Tno is not null and dsd1.ModuleTno is Not null and dsd1.DocumentStatusCode = 'ACTIVE' 
                     then 'ACTIVE' End as PODStatus
                  From Lr c, PODDetail aa, DocumentStatusDetail dsd1
                  where c.Tno = aa.LRTno(+)
                     and aa.Tno = dsd1.ModuleTno(+)) y,
                (Select
                   c.Tno,
                     case when aa.tno is null then 'PENDING'
                     when aa.Tno is not null and dsd1.ModuleTno is null 
                     or (aa.Tno is not null and dsd1.moduletno is not null and dsd1.documentstatuscode <> 'ACTIVE') 
                     then 'PREPAIRED'
                     when aa.Tno is not null and aa.Tno is not null and dsd1.ModuleTno is Not null and dsd1.DocumentStatusCode = 'ACTIVE' 
                     then 'ACTIVE' End as ServiceBillStatus
                From Lr c, ServiceBilllr aa, DocumentStatusDetail dsd1
                where c.Tno = aa.LRTno(+)
                     and aa.Tno = dsd1.ModuleTno(+)) z
                Where a.placementtno = b.Tno(+)
                    and a.loadingordertno = c.Tno(+) 
                    and c.DeliveryOrderTno = cc.Tno(+)
                    and cc.Tno = ccd.Tno(+)
                    and GetDOExpensesTno(c.DeliveryOrderTno,c.DeliveryOrderSno,a.LRDate) = doe.Tno(+)
                    and c.DeliveryOrderTno = doe.DeliveryOrderTno(+)
                    and c.DeliveryOrderSno = doe.DeliveryOrderSno(+)
                    and a.Tno = d.LRTno(+)
                    and d.PartyCode = e.PartyCode(+)
                    and d.StoragelocationCode = f.StorageLocationCode(+)
                    and a.Tno = h.LrTno(+)
                    and h.Tno = g.Tno(+)
                    and a.Tno = j.ModuleTno(+)
                    and j.Tno = i.Tno(+)
                    and a.Tno = k.LrTno(+)
                    and k.tno = l.Tno(+)
                    and l.Tno = lm.tno(+)
                    and c.PartyCode = m.PartyCode(+)
                    and ccd.ItemCode = n.ItemCode(+)
                    and ccd.ItemSpecificationCode = o.ItemSpecificationCode(+)
                    and c.SourceLocationTno = p.Tno(+)
                    and c.DestinationLocationTno = q.Tno(+)
                    and a.transporterCode = r.transporterCode(+)
                    and a.LocationCode = s.LocationCode(+)
                    and a.CompanyCode = t.CompanyCode(+)
                    and a.VehicleNo = cov.VehicleNo(+)
                    and cov.VehicleGroupCode = vg.VehicleGroupCode(+)
                    and c.WorkOrderNo = u.WorkOrderNo(+)
                    and h.RouteCode = w.RouteCode(+)
                    and cc.DoctypeCode = ad.DoctypeCode(+)
                    and a.Tno = x.Tno(+)
                    and a.Tno = y.Tno(+)
                    and a.Tno = z.Tno(+)
                    and a.GPDate BETWEEN  :P254_FROMGPDATE AND :P254_TOGPDATE
                 and ( :P254_COMPANY IS NULL OR instr(':'||:P254_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                 and ( :P254_LOCATION IS NULL OR instr(':'||:P254_LOCATION||':',':'||a.LocationCode||':') > 0 )
                 and ( :P254_LR IS NULL OR instr(':'||:P254_LR||':',':'||a.LRNo||':') > 0 ) 
                 and ( :P254_SERVICEBILL IS NULL OR instr(':'||:P254_SERVICEBILL||':',':'||l.Tno||':') > 0 )
                 and ( :P254_SERVICEBILLSTATUS  IS NULL OR instr(':'||:P254_SERVICEBILLSTATUS||':',':'||z.ServiceBillStatus||':') > 0 )
                 and ( :P254_FREIGHTADVICE IS NULL OR instr(':'||:P254_FREIGHTADVICE||':',':'||i.Tno||':') > 0 )
                 and ( :P254_FREIGHTADVICESTATUS  IS NULL OR instr(':'||:P254_FREIGHTADVICESTATUS||':',':'||X.FreightAdviceStatus||':') > 0 )
                 and ( :P254_POD IS NULL OR instr(':'||:P254_POD||':',':'||g.Tno||':') > 0 )
                 and ( :P254_PODSTATUS  IS NULL OR instr(':'||:P254_PODSTATUS||':',':'||y.PODStatus||':') > 0 )
                 and ( :P254_TRANSPORTER IS NULL OR instr(':'||:P254_TRANSPORTER||':',':'||a.TransporterCode||':') > 0 )
                 and ( :P254_VEHICLE IS NULL OR instr(':'||:P254_VEHICLE||':',':'||a.VehicleNo||':') > 0 )
                 and ( :P254_PARTYDO IS NULL OR instr(':'||:P254_PARTYDO||':',':'||c.PartyRefNo||':') > 0 )
                 and ( :P254_LOADINGORDER IS NULL OR instr(':'||:P254_LOADINGORDER||':',':'||c.LoadingOrderNo||':') > 0 )
                 and ( :P254_SOURCE IS NULL OR instr(':'||:P254_SOURCE||':',':'||p.Tno||':') > 0 )
                 and ( :P254_DESTINATION IS NULL OR instr(':'||:P254_DESTINATION||':',':'||q.DestinationLocationCode||':') > 0 )          
                 and ( :P254_WORKORDER IS NULL OR instr(':'||:P254_WORKORDER||':',':'||a.WorkOrderNo||':') > 0 )
                 and ( :P254_GP IS NULL OR instr(':'||:P254_GP||':',':'||a.GPNo||':') > 0 )
                  and ( :P254_VEHICLEGROUP IS NULL OR instr(':'||:P254_VEHICLEGROUP||':',':'||vg.VehicleGroupCode||':') > 0 )
                --and ( :P254_FROMGPDATE IS NULL OR instr(':'||:P254_FROMGPDATE||':',':'||a.GPDate||':') > 0 )
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 12489584024472201
        }

