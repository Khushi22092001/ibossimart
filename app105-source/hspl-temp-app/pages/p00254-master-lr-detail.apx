    pageItem P254_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                distinct
                a.CompanyName d,
                a.CompanyCode r
                From Company a
                Where exists(
                   Select
                      aa.CompanyCode
                   From LR aa
                   Where aa.companyCode = a.companyCode
                )
                Order by 1
                ```
            displayNullValue: false
        }
        multipleValues {
            type: delimitedList
        }
        layout {
            sequence: 30
            region: @master-lr-detail
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
            columnCssClasses: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

