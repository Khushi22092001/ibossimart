    dynamicAction check-location-name (
        name: Check Location Name
        execution {
            sequence: 180
        }
        when {
            event: focusout
            selectionType: items
            items: P548_LOCATIONNAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P548_LOCATIONNAME")).length===0 ) {
                        showError("Location Name Should Not Empty", 'P548_LOCATIONNAME');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 140
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P548_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    ```
            }
        )

    )

