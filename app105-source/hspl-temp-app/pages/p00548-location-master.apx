    process getdocno (
        name: getdocno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'LOCATION';
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                     
                     if nvl(tmp,0) > 0 and :P548_LOCATIONCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P548_LOCATIONCODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 2788165037581595
        }
    )

