    region location-master (
        name: Location Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.LOCATIONCODE,
                       a.LOCATIONNAME,
                       a.LOCATIONSHORTNAME,
                       a.TNO,
                       a.REMARK,
                       a.DATECREATED,
                       a.DATEMODIFY,
                       a.PARENTCODE,
                       a.CREATOR,
                       a.ISDIVISION,
                       a.CREATIONTIME,
                       a.PARTYCODE,
                       a.DESTINATIONCODE,
                     --  a.TRACKINGREQUIRED,
                       a.LATITUDE,
                       a.LONGITUDE,
                       a.PETTYCASHACCOUNTCODE,
                     --  a.ZONECODE,
                     --  a.TRANSACTIONALCYCLECOUNT,
                     --  a.STORAGERESERVATIONREQUIRED,
                     --  a.LRENTRYITEMWISE,
                     --  a.FSABILLWITHCODE,
                     --  a.PREMISESCODE,
                    --   a.ISPREMISESOFMULTIPLEWAREHOUSE,
                    --   a.VEHICLEPLANNING,
                     --  a.PODPERCENTFORTRANSPORTERBILL,
                    --   a.OPERATIONBOSSUSERCODE,
                    --   a.TRANSPORTATIONBOSSUSERCODE,
                     --  a.LRENTRYSLIPPRINTGROUPWISE,
                    --   a.WAREHOUSEBOSSUSERCODE,
                    --   a.PRINTGATEPASSWITHDISPATCHSLIP,
                     --  a.OVERTIMEFORSANCTIONEDDAY,
                   --    a.GATEENTRYREQUIRED,
                     --  a.AVERAGEWEIGHTPERNOS,
                       a.STATECODE,
                     --  a.SHIPMENTDOCNOINDISPATCHSLIP,
                     --  a.PAIDBILTYCLAIMIMMEDIATE,
                       a.CITYCODE,
                       a.ASSETACCOUNTCODE,
                       a.BRANCHACCOUNTCODE,
                      -- a.COMPANYCODE,
                     --  a.ISITBranch,
                     --  a.FRANCHISEID,
                     --  a.FRANCHISENAME,
                     --  a.ACCOUNTCODE,
                    --   a.STATUS,
                       a.ADDRESS1,
                       a.ADDRESS2,
                       a.pincode,
                       a.gstinno,
                       a.mobileno,
                       a.emailid,
                
                     --  a.ADDRESS3,
                      -- a.BRANCHTYPECODE,
                       NVL(getdocumentstatuscode('LOCATION',TNO),'STATUS') AS Status
                       
                  from LOCATION a  
                  Order By a.LocationName;
                ```
        }
        layout {
            sequence: 10
            parentRegion: @location
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
                margin-top-sm
                margin-bottom-sm
                margin-left-sm
                margin-right-sm
            ]
        }
        advanced {
            htmlDomId: General
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

