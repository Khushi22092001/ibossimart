    pageItem P548_BRANCHACCOUNTCODE (
        type: popupLov
        label {
            label: Branch Account
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                A.PartyName d,
                A.PartyCode r
                from Party a, DocumentStatusDetail dsd 
                Where a.tno = dsd.ModuleTNo
                    and dsd.DocumentStatusCode = 'ACTIVE'
                    and a.PartyTypeCode not in ('ACCOUNT', 'ACCOUNTGROUP')
                order by 1
                ```
        }
        layout {
            sequence: 230
            region: @location-master
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 5
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @location-master
            column: BRANCHACCOUNTCODE
            dataType: varchar2
        }
    )

