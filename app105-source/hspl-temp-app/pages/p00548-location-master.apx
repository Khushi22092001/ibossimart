    dynamicAction branchtype (
        name: BranchType
        execution {
            sequence: 30
        }
        when {
            selectionType: items
            items: P548_BRANCHTYPECODE
        }
        clientSideCondition {
            type: item=value
            item: P548_BRANCHTYPECODE
            value: COMPANYOWNED
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: items
                items: [
                    P548_FRANCHISENAME
                    P548_FRANCHISEID
                ]
            }
            execution {
                sequence: 10
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: items
                items: [
                    P548_FRANCHISEID
                    P548_FRANCHISENAME
                ]
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

    )

