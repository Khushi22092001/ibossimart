page 548 (
    name: Location Master
    alias: LOCATION-MASTER
    title: Location Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
        executeWhenPageLoads:
            ```javascript-browser
            $('input').on('focus', function() {
            $("#"+this.id+"_LABEL").css("background-color", "yellow");
            }).on('blur', function() {
            $("#"+this.id+"_LABEL").css("background-color", "white");
            });
            
            
            
            $(document).ready(function() {
            $('input').keydown( function(e) {
                    var key = e.charCode ? e.charCode : e.keyCode ? e.keyCode : 0;
                    if(key == 13) {
                        e.preventDefault();
                        var inputs = $(this).closest('form').find(':input:visible');
                        inputs.eq( inputs.index(this)+ 1 ).focus();
                    }
                });
            });
            ```
    }
    css {
        inline:
            ```css
            
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            
            .cc-object-style {
                width: 100%;
                height: 800px;
            }
            
            .cc-actions-column {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 10px;
            }
            
            .t-Button--noUI:hover {
                --a-button-type-shadow: none;
                --a-button-type-background-color: transparent;
                --a-button-type-border-color: transparent;
                --a-button-type-text-color: inherit;
                color: inherit;
                background-color: transparent;
                text-shadow: none;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region address-contact (
        name: Address & Contact
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @location-master
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
    )

    region attachment (
        name: Attachment
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       --A.SNO,
                       --DESCRIPTION,
                       B.PARTYATTRIBUTENAME,
                       A.ATTRIBUTEVALUE,
                       A.ATTACHMENTBLOB,
                       A.FILENAME,
                       A.ATTRIBUTECODE,
                       A.moduletno,
                       A.modulesno
                  from MODULEATTACHMENT A, PARTYATTRIBUTE B
                  Where A.ATTRIBUTECODE = PARTYATTRIBUTECODE
                    AND A.moduletno = :P548_TNO;
                ```
            pageItemsToSubmit: P548_TNO
        }
        layout {
            sequence: 50
            parentRegion: @location
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 63
                items: {
                    P63_MODULESNO: #MODULESNO#
                    P63_MODULETNO: #MODULETNO##SNO#
                }
                clearCache: 63
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 1074868197347811923
        }

        column ATTACHMENTBLOB (
            type: downloadBlob
            heading {
                heading: Attachmentblob
            }
            layout {
                sequence: 150
            }
            blobAttributes {
                tableName: MODULEATTACHMENT
                blobColumn: ATTACHMENTBLOB
                primaryKeyColumn1: ROWID
                mimeTypeColumn: MIMETYPE
                filenameColumn: FILENAME
            }
            source {
                primaryKey: true
                dataType: OTHER
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: R
            }
            enableUsersTo {
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column ATTRIBUTECODE (
            type: plainText
            heading {
                heading: Attributecode
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column ATTRIBUTEVALUE (
            type: plainText
            heading {
                heading: Attribute Value
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column FILENAME (
            type: link
            heading {
                heading: File Name
            }
            layout {
                sequence: 60
            }
            link {
                target: {
                    type: url
                    url: javascript:window.open('f?p=&APP_ID.:9995:&APP_SESSION.:::9995:P9995_TNO,P9995_SNO:#MODULETNO#,#MODULESNO#')
                }
                linkText: #FILENAME#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column MODULESNO (
            type: plainText
            heading {
                heading: Modulesno
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column MODULETNO (
            type: plainText
            heading {
                heading: Moduletno
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
        )

        column PARTYATTRIBUTENAME (
            type: plainText
            heading {
                heading: Partyattributename
            }
            layout {
                sequence: 160
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Attachment
        }

        savedReport 371612 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATTRIBUTEVALUE (
                sequence: 2
            )

            displayColumn FILENAME (
                sequence: 3
            )

            displayColumn PARTYATTRIBUTENAME (
                sequence: 1
            )

        )

    )

