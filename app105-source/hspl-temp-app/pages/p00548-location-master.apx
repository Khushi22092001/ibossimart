    region location-detail (
        name: Location Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.TNO,
                a.SNO,
                b.PartyAttributeName as ATTRIBUTECODE
                ,a.ATTRIBUTEVALUE
                ,a.REMARK
                ,sys.dbms_lob.getlength(a.ATTACHMENTBLOB) as ATTACHMENTBLOB
                ,a.FILENAME
                from LOCATIONDETAIL a, PartyAttribute b
                Where 
                a.AttributeCode = b.PartyAttributeCode
                and a.TNO = :P548_TNO;
                ```
            pageItemsToSubmit: P548_TNO
        }
        layout {
            sequence: 30
            parentRegion: @location
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 26
