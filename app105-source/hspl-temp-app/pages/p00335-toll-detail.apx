page 335 (
    name: Toll Detail
    alias: TOLL-DETAIL
    title: Toll Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #tod .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region toll-detail (
        name: Toll Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*
                Select
                      Rownum as SerialNo,
                		a.CompanyCode,
                      c.ModuleName,
                	   a.FreightAdvanceNo as SiteExpenseNo,
                	   a.FreightAdvanceDate as SiteExpenseDate,
                	   null as LRNo,
                	   null as LRDate,
                	   null as GPDate,
                		a.VehicleNo,
                		b.Amount
                	From FreightAdvance a, FATollTaxSlipIssue b, Module c, DocumentStatusDetail dsd
                	Where a.Tno = b.Tno
                      and c.ModuleCode = 'FREIGHTADVANCE'
                		and a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                		and exists(
                		Select
                			aa.Tno
                		From CompanyVehicle aa, Equipment bb
                		Where aa.ModuleTno = bb.Tno
                			and bb.EquipmentGroupCode = 'CT'
                			and aa.CompanyVehicleNo = a.VehicleNo
                		)
                      and a.FreightAdvanceDate between :P335_FROMDATE and :P335_TODATE
                	   and a.CompanyCode = :P335_COMPANYCODE
                       and a.VehicleNo like nvl(:P335_VEHICLENO, '%')
                	UNION ALL
                	Select
                      Rownum as SerialNo,
                		a.CompanyCode,
                      c.ModuleName,
                	   null as SiteExpenseNo,
                	   null as SiteExpenseDate,
                	   a.LRNo,
                	   a.LRDate,
                      a.GPDate,
                		a.VehicleNo,
                		b.Amount
                	From LR a, LRTollTaxSlipIssue b, Module c, DocumentStatusDetail dsd
                	Where a.Tno = b.Tno
                      and c.ModuleCode = 'LR'
                		and a.Tno = dsd.ModuleTno
                		and dsd.DocumentStatusCode = 'ACTIVE'
                		and a.VehicleNo is not null
                		and a.VehicleGroupCode = 'SELF'
                      and nvl(a.GPDate, a.LRDate) between :P335_FROMDATE and :P335_TODATE
                	   and a.CompanyCode = :P335_COMPANYCODE
                       and a.VehicleNo like nvl(:P335_VEHICLENO, '%')
                */
                
                Select
                  row_number() over(order by a.ModuleDate) SerialNo,
                	a.ModuleName,
                	a.ModuleNo,
                	a.ModuleDate,
                	a.VehicleNo,
                  b.VehicleTypeName,
                  c.TransportAreaName,
                	a.Amount
                From VehicleExpenseTable a, VehicleType b, TransportArea c
                Where a.VehicleTypeCode = b.VehicleTypeCode(+)
                    and a.TransportAreaCode = c.TransportAreaCode(+)
                    and a.ModuleDate between :P335_FROMDATE and :P335_TODATE
                		and a.VehicleNo like nvl(:P335_VEHICLENO, '%')
                		and a.CompanyCode = :P335_COMPANYCODE
                    and a.Creator = :APP_USER
                    and a.Categories = 'TOLLTAX'
                    and (:P335_VEHICLENO2 is null
                       or exists(
                         Select
                            aa.VehicleNo
                          From VPVehicleNo aa
                          Where aa.VehicleNo = a.VehicleNo
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P335_VEHICLETYPE is null
                       or exists(
                         Select
                            aa.VehicleTypeCode
                          From VPVehicleType aa
                          Where aa.VehicleTypeCode = a.VehicleTypeCode
                              and aa.Creator = :APP_USER
                       )
                   )
                  and (:P335_TRANSPORTAREA is null
                       or exists(
                         Select
                            aa.TransportAreaCode
                          From VPTransportArea aa
                          Where aa.TransportAreaCode = a.TransportAreaCode
                              and aa.Creator = :APP_USER
                       )
                   )
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                ```
        }
        layout {
            sequence: 80
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: tod
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 303172176806960999
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Toll Amount
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column MODULEDATE (
            type: plainText
            heading {
                heading: Module Date
                alignment: center
            }
            layout {
                sequence: 160
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AB
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: Module Name
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No.
                alignment: center
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AA
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 140
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Z
            }
        )

        column TRANSPORTAREANAME (
            type: plainText
            heading {
                heading: Transport Area
                alignment: center
            }
            layout {
                sequence: 180
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AD
            }
        )

        column VEHICLENO (
            type: plainText
            heading {
                heading: Vehicle No
                alignment: center
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Y
            }
        )

        column VEHICLETYPENAME (
            type: plainText
            heading {
                heading: Vehicle Type
                alignment: center
            }
            layout {
                sequence: 170
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AC
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Toll Detail
        }

        savedReport 505176 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn AMOUNT (
                sequence: 8
            )

            displayColumn MODULEDATE (
                sequence: 4
            )

            displayColumn MODULENAME (
                sequence: 2
            )

            displayColumn MODULENO (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn TRANSPORTAREANAME (
                sequence: 7
            )

            displayColumn VEHICLENO (
                sequence: 5
            )

            displayColumn VEHICLETYPENAME (
                sequence: 6
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                function: count
                column: NECESSITYSLIPDATE
            )

            aggregate (
                function: count
                column: ISSUEDATE
            )

            aggregate (
                function: count
                column: SITEEXPENSEDATE
            )

            controlBreak (
                column: TRANSPORTAREANAME
                layout {
                    sequence: 1
                }
            )

        )

    )

    pageItem P335_COMPANYCODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P335_FROMDATE (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P335_TODATE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P335_TRANSPORTAREA (
        type: hidden
        layout {
            sequence: 70
            slot: contentBody
        }
    )

    pageItem P335_VEHICLENO (
        type: hidden
        layout {
            sequence: 40
            slot: contentBody
        }
    )

    pageItem P335_VEHICLENO2 (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P335_VEHICLETYPE (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

