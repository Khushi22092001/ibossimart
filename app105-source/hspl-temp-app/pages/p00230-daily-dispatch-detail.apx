page 230 (
    name: Daily Dispatch Detail
    alias: DAILY-DISPATCH-DETAIL
    title: Daily Dispatch Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region daily-dispatch-detail (
        name: Daily Dispatch Detail
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.* From(Select
                	1 as MySNo,
                    com.CompanyName,
                    com.OfficeAddress,
                    sysdate as printdate,
                	a.TNO,
                	a.LRNo,
                    a.LRDate,
                	a.GPNo,
                	a.VehicleNo,
                	Sum(a.Quantity1),
                	Sum(a.Nos),	
                    dl.DestinationLocationName,
                    pl.PlacementNo,
                    pl.PlacementDate,
                	pl.CreationTime as InTime,
                	a.CreationTime as OutTime,
                	GetTimeHH24MI((a.CreationTime - pl.CreationTime )* 86400) as DifferenceDays,
                	a.ConsigneeName,
                	t.TransporterName,
                	e.ItemName,
                	a.PartyRefNo,
                	a.PartyRefDate,
                	lo.LoadingOrderNo,
                    sl.SourceLocationName,
                    Sum(a.BiltyCommission),
                    Sum(rf.Amount),
                    a.InvoiceNo
                from LR a, Party c ,Item e, ItemSpecification ee, MeasuringUnit mu1, 
                     DestinationLocation dl, SourceLocation sl, Placement pl, Transporter t,
                     LoadingOrder lo, Company Com, 
                     (Select a.Amount , Referencemoduletno from
                     PaymentAdviceReference a
                     Where a.referencemodulecode = 'LR') rf
                where a.PartyCode = c.PartyCode
                	and a.ItemCode = e.ItemCode
                	and a.ItemSpecificationCode = ee.ItemSpecificationCode
                	and e.MeasuringUnitCode1 = mu1.MeasuringUnitCode
                	and a.DestinationLocationTNO = dl.TNo(+)
                	and a.SourceLocationTNO = sl.TNo(+)
                	and a.PlacementTNO = pl.TNo(+)
                	and a.TransporterCode  = t.TransporterCode(+)
                	and a.LoadingOrderTNo = lo.TNo(+)
                    and a.companyCode = Com.CompanyCode(+)
                    and a.tno = rf.referencemoduleTno(+)
                    and a.LRDate Between :P230_FROMDATE and :P230_TODATE
                    Group by
                    com.CompanyName,
                    com.OfficeAddress,
                	a.TNO,
                	a.LRNo, 
                    a.LRDate,
                	a.GPNo,
                	a.VehicleNo,
                	dl.DestinationLocationName,
                	pl.CreationTime,
                	a.CreationTime,
                	a.CreationTime ,
                    pl.CreationTime,
                	a.ConsigneeName,
                	t.TransporterName,
                	e.ItemName,
                	a.PartyRefNo,
                	a.PartyRefDate,
                	lo.LoadingOrderNo,
                    sl.SourceLocationName,
                    pl.PlacementNo,
                    pl.PlacementDate,
                    a.InvoiceNo) a
                    -- Order By
                    -- a.LRDate
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: my_grid
        }
        advanced {
            regionDisplaySelector: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 21185428030854419
        }

