page 481 (
    name: Audit Trail Caliber
    alias: REPORT-FORMAT-DOWNLOAD
    title: Audit Trail Caliber
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region audit-trail-caliber (
        name: Audit Trail Caliber
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    a.TNO,
                    a.FINANCIALYEARCODE,
                    a.COMPANYCODE,
                    b.companyname,
                    a.LOCATIONCODE,
                    c.LOCATIONname,
                    a.DOCTYPECODE,
                    a.REPORTFORMATUPLOADNO,
                    a.REPORTFORMATUPLOADDATE,
                    a.ITEMCATEGORY,
                    d.ITEMCATEGORYname,
                    a.DESCRIPTION,
                    sys.dbms_lob.getlength(a.ATTACHEMENT) ATTACHEMENT,
                    a.FILENAME,
                    a.MIMETYPE,
                    a.CREATOR,
                    a.CREATIONTIME
                FROM
                    CMPL.REPORTFORMATUPLOAD a , cmpl.company b , cmpl.location c , cmpl.itemcategory d
                    where a.companycode = b.companycode(+)
                    and a.LOCATIONCODE = c.LOCATIONCODE(+)
                    and a.ITEMCATEGORY = d.ITEMCATEGORYcode(+)
                    and ( :P481_FINANCIALYEAR = a.FINANCIALYEARCODE)
                    and ( :P481_COMPANY IS NULL OR instr(':'||:P481_COMPANY||':',':'||a.companyCODE||':') > 0 )
                    -- and ( :P481_LOCATION IS NULL OR instr(':'||:P481_LOCATION||':',':'||a.locationCODE||':') > 0 )
                    and ( :P481_ITEMCATEGORY IS NULL OR instr(':'||:P481_ITEMCATEGORY||':',':'||a.ITEMCATEGORY||':') > 0 )
                    and ( :P481_DESCRIPTION IS NULL OR instr(':'||:P481_DESCRIPTION||':',':'||a.DESCRIPTION||':') > 0 )
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 36213701266135479
        }

        column ATTACHEMENT (
            type: downloadBlob
            heading {
                heading: View Report
            }
            layout {
                sequence: 10
            }
            blobAttributes {
                tableName: REPORTFORMATUPLOAD
                blobColumn: ATTACHEMENT
                primaryKeyColumn1: TNO
                mimeTypeColumn: MIMETYPE
                filenameColumn: FILENAME
            }
            source {
                dataType: NUMBER
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: J
            }
            enableUsersTo {
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column COMPANYNAME (
            type: plainText
            heading {
                heading: Company
                alignment: center
            }
            layout {
                sequence: 24
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
