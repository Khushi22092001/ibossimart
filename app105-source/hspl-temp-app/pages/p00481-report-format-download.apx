        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Audit Trail Caliber
        }

        savedReport 362197 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATTACHEMENT (
                sequence: 4
            )

            displayColumn COMPANYNAME (
                sequence: 2
            )

            displayColumn DESCRIPTION (
                sequence: 3
