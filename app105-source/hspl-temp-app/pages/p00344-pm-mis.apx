page 344 (
    name: PM - MIS
    alias: PM-MIS
    title: PM - MIS
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: Report
        type: list
        source {
            list: @pm-mis
        }
        layout {
            sequence: 30
            slot: body
            columnCssClasses: hspl-module-tiles
        }
        componentAppearance {
            listTemplate: @/media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                u-colors
                t-MediaList--cols t-MediaList--4cols
            ]
        }
    )

)

