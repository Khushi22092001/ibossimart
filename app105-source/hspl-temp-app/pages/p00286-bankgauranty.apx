    pageItem P286_BANK (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Bank Name
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                b.BankName D,
                b.BankCode R
                FROM BANKGAURANTY bg, Bank b   
                WHERE bg.issueingbankcode= b.bankcode(+)
                ```
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @bankgauranty
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

