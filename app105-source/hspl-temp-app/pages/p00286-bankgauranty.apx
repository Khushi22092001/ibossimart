page 286 (
    name: BankGaurantyReport
    alias: BANKGAURANTY
    title: BankGauranty
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bankgauranty (
        name: BankGauranty
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                ROW_NUMBER() over(order by BG.BANKGAURANTYDATE) SerialNo,
                l.locationname as location,
                d.doctypename as doctype,
                c.companyname as company,
                bg.bankgaurantyno,
                bg.bankgaurantydate,
                bg.bankgaurantydirection,
                bg.bgno,
                bg.revisionno as revno,
                bg.bgbalance as bgbal,
                bgn.bankgaurantynaturename as bankgaurantynature,
                bgt.bankgaurantytypename as bankgaurantytype,
                b.bankname,
                bg.issuedate,
                bg.expirydate,
                claimvaliditydate as claimto,
                bg.beneficiaryname,
                bg.beneficiarydepartment,
                bg.beneficiaryaddress,
                bg.bankgaurantyrefno as BGRefNo,
                j.joborderno,
                bg.bginfavourof,
                p.projectname,
                bg.totalcontractvalueofproject,
                bg.shareofcompanyinproject,
                bg.bgpercentofcontractvalue,
                bg.marginmoneypercent,
                bg.marginamount,
                bg.ccamount,
                bg.fdamount,
                bg.bgcommissionpercent,
                fd.fixeddepositno,
                bgfd.balanceamount,
                bgfd.remark,
                bgfd.usedamount,
                fdi.fixeddepositno as fixeddepno,
                bgfdi.interestamount,
                bgc.bankgaurantycommissionno,
                bgc.fromdate as fromdate,
                bgc.todate as todate,
                bgc.bgcommissionpercent as bgcommpercent,
                bgc.bgcommissionamount,
                bg.Loano,
                wo.PartyRefNo as WorkContractRefNo,
                fd.FixedDepositCertificateNo as FixedCertificateNo,
                bg.BankGaurantyAmount,
                bg.BGBalance,
                bg.COUNTERBGNO as Counter_Bank_Gauranty_no,
                cb.BankName as Counter_Bank_Name
                From bankgauranty bg, bankgaurantycommission bgc, location l, doctype d, company c, bankgaurantynature bgn, bankgaurantytype bgt,
                joborder j, bank b, project p, bankgaurantyfixeddeposit bgfd, fixeddeposit fd, fixeddeposit fdi, bankgaurantyfdinterest bgfdi, WorkOrder wo,
                Bank cb
                where bg.locationcode = l.locationcode(+)
                and bg.doctypecode = d.doctypecode(+)
                and bg.companycode = c.companycode(+)
                and bg.tno = bgc.bankgaurantytno(+)
                and bg.bankgaurantynaturecode = bgn.bankgaurantynaturecode(+)
                and bg.bankgaurantytypecode = bgt.bankgaurantytypecode(+)
                and bg.jobordertno = j.tno(+)
                and bg.projecttno = p.tno(+)
                and bg.issueingbankcode= b.bankcode(+)
                and bg.tno = bgfd.tno(+)
                and bgfd.fixeddeposittno = fd.tno(+)
                and bgfd.fixeddeposittno = fdi.tno(+)
                and bgfd.tno = bgfdi.tno(+)
                and bg.WorkOrderTno = wo.Tno(+)
                and bg.counterbankcode = cb.bankcode(+)
                and bg.bankgaurantydate between :P286_FROMDATE and :P286_TODATE
                and ( :P286_DOCTYPE IS NULL OR instr(':'||:P286_DOCTYPE||':',':'||D.DocTypeCode||':') > 0 ) 
                and (:P286_LOCATION IS NULL OR instr(':'||:P286_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P286_COMPANY IS NULL OR instr(':'||:P286_COMPANY||':',':'||C.COMPANYCODE||':') > 0 ) 
                and (:P286_BANKGAUR IS NULL OR instr(':'||:P286_BANKGAUR||':',':'||bg.BANKGAURANTYNO||':') > 0)
                and (:P286_BANK IS NULL OR instr(':'||:P286_BANK||':',':'||b.BankCode||':') > 0)
                
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 16421614170136102
        }

