page 357 (
    name: Warranty Claim  Report
    alias: WARRANTY-CLAIM-REPORT
    title: Warranty Claim  Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .my_grid .a-GV-w-hdr{
                overflow-x: auto !important;
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region service-detail (
        name: Service Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                row_number() over(order by a.ExternalServicesEntryDate) SerialNo,
                co.CompanyName,
                a.ExternalServicesEntryDate,
                a.ExternalServicesEntryNo,
                d.EquipmentName,
                c.PartyName,
                a.BillNo,
                a.BillDate,
                b.Description,
                a.SpareAmount,
                a.ServicesAmount,
                a.ExternalServicesEntryAmount,
                b.WarrantyUpTo,
                b.Discount
                From ExternalServicesEntry a, ExternalSpareEntryDetail b, Party c, Equipment d, Company co
                Where a.Tno = b.Tno(+)
                and a.PartyCode = c.PartyCode(+)
                and a.EquipmentTno = d.Tno(+)
                and a.CompanyCode = co.CompanyCode(+)
                and b.Discount is not null
                and b.WarrantyUpTo is not null
                and a.ExternalServicesEntryDate between :P357_FROMDATE and :P357_TODATE
                and ( :P357_COMPANY IS NULL OR instr(':'||:P357_COMPANY||':',':'||a.CompanyCode||':') > 0)
                and ( :P357_EQUIPMENT IS NULL OR instr(':'||:P357_EQUIPMENT||':',':'||d.EquipmentCode||':') > 0)
                and ( :P357_PARTY IS NULL OR instr(':'||:P357_PARTY||':',':'||a.PartyCode||':') > 0);
                
                ```
            pageItemsToSubmit: [
                P357_COMPANY
                P357_FROMDATE
                P357_TODATE
                P357_PARTY
                P357_EQUIPMENT
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 35669307735201842
        }

