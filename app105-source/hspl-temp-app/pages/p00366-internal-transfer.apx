page 366 (
    name: Internal Transfer
    alias: INTERNAL-TRANSFER
    title: Internal Transfer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region internal-transfer (
        name: "Internal Transfer "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                row_number() over(order by a.InternalTransferDate) SerialNo,
                b.LocationName "Location Name",
                a.InternalTransferNo as InternalTransferNo,
                a.InternalTRansferDate,
                d.DeliveryOrderNo "Delivery Order No",
                d.DeliveryOrderDate "Delivery Order Date",
                d.PartyDONo "Party DO No",
                d.PartyDODate "Party DO Date",
                a.GPNo "GP NO",
                p.PartyName "Party Name",
                q.SourcelocationName "Source location Name",
                r.DestinationLocationName "Destination Location Name",
                a.VehicleNo "Vehicle No",
                t.TransporterName "Transporter Name",
                a.DriverName ||'  -  '|| em.EmployeeId as  "Driver Name",
                s.ShiftName "Shift Name ",
                a.LoadingDate "Loading Date",
                GetTime(a.LoadingTime) as "Loading Time",
                round(a.LoadingQuantity1,3) as "Loading Qty",
                a.UnloadingDate " Unloading Date",
                GetTime(a.UnloadingTime) "Unloading Time",
                round(a.UnloadingQuantity1,3) as "Unloading Qty",
                ro.RouteName as "Route Name",
                a.Creator,
                CASE WHEN ds.documentstatusCode = 'ACTIVE' then ds.DocumentStatusName
                when ds.documentstatusCode is null then 'Non-Active'
                Else 'Non-Active'
                End as DocumentStatus
                from InternalTransfer a, Location b, DeliveryOrderDetail c, Deliveryorder d, LoadingOrder e,
                    Party p, Sourcelocation q , DestinationLocation r  , Transporter t , Shift s, Route ro, Employee em, DocumentStatusDetail dsd, DocumentStatus ds
                Where a.LocationCode = b.LocationCode(+)
                and a.DeliveryOrderTno = c.Tno(+)
                and a.DeliveryorderSno = c.Sno(+)
                and c.Tno = d.Tno(+)
                and c.Tno = e.DeliveryOrderTno(+)
                and c.Sno = e.DeliveryorderSno(+)
                and c.Tno = d.Tno(+)
                and a.PartyCode = p.PartyCode(+)
                and a.SourceLocationTno = q.Tno(+)
                and a.DestinationLocationTno = r.Tno(+)
                and a.TransporterCode = t.TransporterCode(+)
                and a.ShiftCode = s.ShiftCode
                and a.RouteCode = ro.RouteCode(+)
                and a.DriverCode = em.EmployeeCode(+)
                and a.Tno = dsd.ModuleTno(+)
                and dsd.DocumentStatusCode = ds.DocumentStatusCode(+)
                and ( :P366_COMPANY IS NULL OR instr(':'||:P366_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                and a.LoadingDate BETWEEN  :P366_FROMDATE AND :P366_TODATE
                and (:P366_LOCATION is null or instr(':'||:P366_LOCATION||':',':'||a.Locationcode||':') > 0)
                and (:P366_SOURCE is null or instr(':'||:P366_SOURCE||':',':'||a.SourceLocationTno||':') > 0)
                and (:P366_DESTINATION is null or instr(':'||:P366_DESTINATION||':',':'||a.DestinationLocationTno||':') > 0)
                and (:P366_PARTY is null or instr(':'||:P366_PARTY||':',':'||a.Partycode||':') > 0)
                and (:P366_SHIFT is null or instr(':'||:P366_SHIFT||':',':'||a.ShiftCode||':') > 0)
                and (:P366_DELIVERYORDER is null or instr(':'||:P366_DELIVERYORDER||':',':'||a.DeliveryOrderTNo||':') > 0)
                and (:P366_INTERNALTRANFERNO is null or instr(':'||:P366_INTERNALTRANFERNO||':',':'||a.Tno||':') > 0)
                and (:P366_ROUTE is null or instr(':'||:P366_ROUTE||':',':'||a.RouteCode||':') > 0)
                and (:P366_PARTYDONO is null or instr(':'||:P366_PARTYDONO||':',':'||d.Tno||':') > 0)
                
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 99607475930404704
        }

