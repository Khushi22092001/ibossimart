    pageItem P287_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                a.companyname d,
                a.companycode r 
                from company a,bankgaurantycloser b  
                where a.companycode = b.companycode(+)
                
                ```
        }
        layout {
            sequence: 10
            region: @bankgaurantycloser
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
