page 287 (
    name: BankGaurantyCloser
    alias: BANKGAURANTYCLOSER
    title: BankGaurantyCloser
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bankgaurantycloser (
        name: BankGaurantyCloser
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                row_number() over(order by BG.BANKGAURANTYDATE) SerialNo,
                l.locationname as location,
                d.doctypename as doctype,
                c.companyname as company,
                bg.bankgaurantyno,
                bg.bankgaurantydate,
                bgcl.bankgaurantycloserno,
                bg.bankgaurantydirection,
                bg.bgno,
                bg.revisionno as revno,
                bgn.bankgaurantynaturename as bankgaurantynature,
                bgt.bankgaurantytypename as bankgaurantytype,
                b.bankname,
                bg.issuedate,
                bg.expirydate,
                claimvaliditydate as claimto,
                bg.beneficiaryname,
                bg.beneficiarydepartment,
                bg.beneficiaryaddress,
                bg.bankgaurantyrefno as BGRefNo,
                j.joborderno,
                bg.bginfavourof,
                p.projectname,
                bg.totalcontractvalueofproject,
                bg.shareofcompanyinproject,
                bg.bgpercentofcontractvalue,
                bg.marginmoneypercent,
                bg.marginamount,
                bg.ccamount,
                bg.fdamount,
                bg.bgcommissionpercent,
                fd.fixeddepositno,
                bgfd.balanceamount,
                bgfd.remark,
                bgfd.usedamount,
                fdi.fixeddepositno as fixeddepno,
                bgfdi.interestamount,
                bgc.bankgaurantycommissionno,
                bgc.fromdate as fromdate,
                bgc.todate as todate,
                bgc.bgcommissionpercent as bgcommpercent,
                bgc.bgcommissionamount
                from
                bankgauranty bg,
                bankgaurantycommission bgc,
                bankgaurantycloser bgcl,
                location l,
                doctype d,
                company c,
                bankgaurantynature bgn,
                bankgaurantytype bgt,
                joborder j,
                bank b,
                project p,
                bankgaurantyfixeddeposit bgfd,
                fixeddeposit fd,
                fixeddeposit fdi,
                bankgaurantyfdinterest bgfdi
                where bg.locationcode = l.locationcode(+)
                and bg.doctypecode = d.doctypecode(+)
                and bg.companycode = c.companycode(+)
                and bg.tno = bgc.bankgaurantytno(+)
                AND bgcl.bankgaurantytno = BG.TNO(+)
                and bg.bankgaurantynaturecode = bgn.bankgaurantynaturecode(+)
                and bg.bankgaurantytypecode = bgt.bankgaurantytypecode(+)
                and bg.jobordertno = j.tno(+)
                and bg.projecttno = p.tno(+)
                and bg.issueingbankcode= b.bankcode(+)
                and bg.tno = bgfd.tno(+)
                and bgfd.fixeddeposittno = fd.tno(+)
                and bgfd.fixeddeposittno = fdi.tno(+)
                and bgfd.tno = bgfdi.tno(+)
                and ( :P287_DOCTYPE IS NULL OR instr(':'||:P287_DOCTYPE||':',':'||D.DocTypeCode||':') > 0 ) 
                and (:P287_LOCATION IS NULL OR instr(':'||:P287_LOCATION||':',':'||L.locationcode||':') > 0)
                and (:P287_COMPANY IS NULL OR instr(':'||:P287_COMPANY||':',':'||C.COMPANYCODE||':') > 0 ) 
                and (:P287_GAURANTYCLOSERNO IS NULL OR instr(':'||:P287_GAURANTYCLOSERNO||':',':'||BGCL.BANKGAURANTYCLOSERNO||':') > 0 ) 
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 16491841486246310
        }

