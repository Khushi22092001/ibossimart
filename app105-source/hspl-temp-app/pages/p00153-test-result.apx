page 153 (
    name: TEST RESULT
    alias: TEST-RESULT
    title: TEST RESULT
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region new (
        name: New
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.qualitycode, 
                       c.qualityname,
                			 a.testvalue,
                			 a.billedtestvalue,
                			 a.remark
                  From qualitytestdetail a, quality c
                 Where a.qualitycode = c.qualitycode(+)
                   AND A.TNO = :P153_TNO
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-showMaximizeButton
                t-Region--showIcon
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column BILLEDTESTVALUE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: BILLED TEST VALUE
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column QUALITYCODE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: QUALITY CODE
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column QUALITYNAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: QUALITY NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column REMARK (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: REMARK
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

        column TESTVALUE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: TEST VALUE
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
        )

    )

    pageItem P153_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

