                label: LABEL
                value: APPLIED_CR
            }
        )

        series unapplied (
            name: Still on account (₹ Cr)
            execution {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LABEL
                value: UNAPPLIED_CR
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Payments (₹ Cr)
            value {
                format: decimal
