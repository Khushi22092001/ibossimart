    region command-header (
        name: AP Trend Analysis
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-ap-head">'
                    || '<div class="ds-ap-eyebrow">Payables &middot; Trend</div>'
                    || '<h1 class="ds-ap-title">AP Trend Analysis</h1>'
                    || '<div class="ds-ap-sub">Outstanding, ageing mix, billing against payment and payment application, each re-derived at every month end in the window</div>'
                    || '<div class="ds-ap-context">'
                    || '<span class="ds-ap-chip"><span class="fa fa-calendar"></span>Window <b>'
                       || :P719_FROMDATE || ' &rarr; ' || :P719_TODATE || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-crosshairs"></span>Each point is a <b>position at that month end</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P719_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P719_LOCATION),'All locations')) || '</b></span>'
                    || '<span class="ds-ap-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                               Then (Select GetUserPanelAB_apex() From dual) || ' (enforced)'
                               When :P719_PANEL Is Not Null Then :P719_PANEL Else 'A + B' End || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
