page 387 (
    name: Payloader Expenses Detail
    alias: PAYLOADER-EXPENSES-DETAIL
    title: Payloader Expenses Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var lSpinner$;
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-expenses-detail (
        name: Payloader Expenses Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select row_number() over(order by a.ModuleDate) SerialNo,
                a.Categories,
                a.ModuleName,
                a.ModuleNo,
                a.ModuleDate,
                a.EquipmentID,
                b.LocationName,
                sum(a.Quantity) as Quantity,
                sum(a.Amount) as Amount
                From PayloaderExpenseTable a,Location b
                Where a.Creator = :APP_USER
                and a.LocationCode = b.LocationCode
                and (:P387_LOCATION is null
                				   or exists(
                					 Select
                						aa.LocationCode
                					  From PayloaderPerformanceLocation aa
                					  Where aa.LocationCode = a.LocationCode
                						  and aa.Creator = :APP_USER
                				   )
                			   )
                and a.ModuleDate between :P387_FROMDATE and :P387_TODATE
                and (:P387_COMPANYCODE is Null Or Instr (':' || :P387_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                and (:P387_EQUIPMENTID is Null Or Instr (':' || :P387_EQUIPMENTID || ':' , ':' || a.EquipmentTno || ':') > 0)
                and (:P387_CATEGORY is Null Or Instr (':' || :P387_CATEGORY || ':' , ':' || a.Categories || ':') > 0)
                Group by
                a.Categories,
                a.ModuleName,
                a.ModuleNo,
                a.ModuleDate,
                a.EquipmentID,
                b.LocationName
                ```
        }
        layout {
            sequence: 100
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: expensesdetail
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 220279283094927215
        }

