            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                    'TYRE' as d,
                    'TYRE' as r
                From Dual
                UNION ALL
                Select
                    'DIESEL' as d,
                    'DIESEL' as r
                From Dual
                UNION ALL
                Select
                   'SPARE' as d,
                   'SPARE' as r
                From Dual
                UNION ALL
                Select
