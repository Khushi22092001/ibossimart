page 472 (
    name: OverTime Attendance
    alias: OVERTIME-ATTENDANCE
    title: OverTime Attendance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region overtime-attendance (
        name: OverTime Attendance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.OverTimeAttendanceDate Datee,
                       c.EmployeeName,
                       c.EmployeeID,
                       d.ShiftName,
                       b.Remark
                From   OverTimeAttendance a,OverTimeAttendanceDetail b,Employee c,Shift d
                Where  a.Tno = b.Tno(+)
                  and  b.employeecode = c.employeecode(+)
                  and  a.ShiftCode = d.ShiftCode(+)
                  and  a.OverTimeAttendanceDate Between :P472_FROMDATE And :P472_TODATE
                  and  (:P472_COMPANY IS NULL OR instr(':'||:P472_COMPANY||':',':'||a.CompanyCode||':') > 0)
                  and  (:P472_LOCATION IS NULL OR instr(':'||:P472_LOCATION||':',':'||a.LocationCode||':') > 0)
                  and  (:P472_EMPLOYEE IS NULL OR instr(':'||:P472_EMPLOYEE||':',':'||b.EmployeeCode||':') > 0)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 42947098182332643
        }

        column DATEE (
            type: plainText
            heading {
                heading: Date
                alignment: center
            }
            layout {
                sequence: 1
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column EMPLOYEEID (
            type: plainText
            heading {
                heading: Employeeid
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column EMPLOYEENAME (
            type: plainText
            heading {
                heading: Employeename
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column SHIFTNAME (
            type: plainText
            heading {
                heading: Shiftname
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: OverTime Attendance
        }

        savedReport 429673 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DATEE (
                sequence: 1
            )

            displayColumn EMPLOYEEID (
                sequence: 3
            )

            displayColumn EMPLOYEENAME (
                sequence: 2
            )

            displayColumn REMARK (
                sequence: 5
            )

            displayColumn SHIFTNAME (
                sequence: 4
            )

        )

    )

    region overtime-attendance-2 (
        name: OverTime Attendance
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P472_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  Distinct
                        b.CompanyName d,
                        b.CompanyCode r
                From    OvertimeAttendance a,Company b
                Where   a.CompanyCode  = b.CompanyCode(+)
                Order By 1
                ```
        }
        layout {
            sequence: 30
            region: @overtime-attendance-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P472_EMPLOYEE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Employee
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  Distinct 
                        c.EmployeeName d,
                        c.EmployeeCode r
                From    OverTimeAttendance a,OverTimeAttendanceDetail b,Employee c
                Where   a.Tno = b.Tno(+)
                  and   b.EmployeeCode  = c.EmployeeCode(+)
                Order By 1
                ```
        }
        layout {
            sequence: 50
            region: @overtime-attendance-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P472_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @overtime-attendance-2
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P472_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select   Distinct
                         b.LocationName d,
                         b.LocationCode r
                From     OverTimeAttendance a,Location b
                Where    a.LocationCode = b.LocationCode(+)
                Order By 1
                ```
        }
        layout {
            sequence: 40
            region: @overtime-attendance-2
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P472_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @overtime-attendance-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 60
            region: @overtime-attendance-2
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

