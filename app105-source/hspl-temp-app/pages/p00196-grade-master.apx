page 196 (
    name: Grade Master
    alias: GRADE-MASTER
    title: Grade Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region grade-master (
        name: Grade Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                row_number() over(order by a.EmployeeGradeName) SerialNo,
                a.employeegradecode,
                a.employeegradename,
                b.categoryName
                From employeegrade a , Category b
                where a.CategoryCode = b.CategoryCode(+)
                order by 2
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 27755298907248523
        }

        column CATEGORYNAME (
            type: plainText
            heading {
                heading: CATEGORY
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column EMPLOYEEGRADECODE (
            type: plainText
            heading {
                heading: Employeegradecode
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column EMPLOYEEGRADENAME (
            type: plainText
            heading {
                heading: EMPLOYEE GRADE
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Designation Master
        }

        savedReport 240488 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CATEGORYNAME (
                sequence: 3
            )

            displayColumn EMPLOYEEGRADECODE (
                sequence: 4
            )

            displayColumn EMPLOYEEGRADENAME (
                sequence: 2
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

