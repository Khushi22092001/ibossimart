page 112 (
    name: Product Pending Purchase Order
    alias: PRODUCT-PENDING-PURCHASE-ORDER
    title: Product Pending Purchase Order
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region product-pending-purchase-order (
        name: Product Pending Purchase Order
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       COMPANYNAME,
                       LOCATIONCODE,
                       LOCATIONNAME,
                       DOCTYPECODE,
                       DOCTYPENAME,
                       PURCHASEORDERNO,
                       PURCHASEORDERDATE,
                       PARTYCODE,
                       PARTYNAME,
                       AGENTCODE,
                       AGENTNAME,
                       DELIVERYDATE,
                       ITEMCODE,
                       ITEMNAME,
                       MATERIALDESCRIPTION,
                       UOM1,
                       QUANTITY1,
                       UOM2,
                       QUANTITY2,
                       RATE,
                       AMOUNT,
                       CGST,
                       SGST,
                       IGST,
                       TCS,
                       FOOTERAMOUNT,
                       OTHERAMOUNT,
                       TOTALAMOUNT,
                       FREIGHTTYPECODE,
                       FREIGHTTYPENAME,
                       GRNSTATUS,
                       GRNRECEIVEDQUANTITY1,
                       GRNRECEIVEDQUANTITY2,
                       BALANCEQUANTITY1,
                       CREATOR,
                       CREATIONTIME,
                       STATECODE,
                       STATENAME,
                       CITYCODE,
                       CITYNAME,
                       REGIONCODE,
                       REGIONNAME,
                       BALANCEQUANTITY2,
                       ITEMSPECIFICATIONCODE
                  from D_SUPPLIER_360VIEW_PURCHASEORDERSPENDINGFORGRN
                  Where PartyCode LIKE NVL(:P112_CUSTOMERCODE,'%')
                    AND ITEMCODE LIKE NVL(:P112_ITEMCODE,'%')
                    AND ITEMSPECIFICATIONCODE LIKE NVL(:P112_ITEMSPECIFICATIONCODE,'%')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            compute: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 19486299010346776
        }

