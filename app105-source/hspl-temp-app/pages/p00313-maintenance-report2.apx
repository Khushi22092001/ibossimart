            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      a.EquipmentName as d,
                      a.EquipmentName as r
                From  Equipment a, MaintenanceRequest mr
                Where a.TNo = mr.EquipmentTNo
                  and a.EquipmentCategoryCode = 'VEHICLE';
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @select-criteria
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Vehicle No
        }
    )

