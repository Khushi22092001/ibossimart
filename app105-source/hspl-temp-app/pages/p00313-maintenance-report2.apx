page 313 (
    name: Maintenance Report
    alias: MAINTENANCE-REPORT2
    title: Maintenance Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            
            #MYID.a-GV-row.is-hover, .a-IRR-table tr:hover td{
                background-color: #FFFACD;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region maintenance-report (
        name: Maintenance Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT *
                FROM (
                  SELECT e.EquipmentName,
                         e.equipmentstartupdate,
                         a.maintenancerequestdate,
                         emo.OrderFinishDate,
                         GetLocationName(GetEquipmentLocationCode(e.TNo,Sysdate)) as CurrentLocation,
                         (SELECT aa.InitialValue FROM serviceentrysheetcounterdetail aa WHERE aa.TNo = ses.TNo AND (aa.PropertyCode = '57')) as KMReading,
                         CASE WHEN act.ActivityName IS NOT NULL THEN 'Yes' ELSE 'No' END AS ActivityPerformed,
                         act.ActivityName
                  FROM MaintenanceRequest a, Equipment e, Location l, EquipmentMaintenanceOrder emo, ServiceEntrySheet ses, ServiceEntrySheetDetail sesd, Activity act
                  WHERE a.EquipmentTNo = e.TNo
                    AND a.LocationCode = l.LocationCode
                    AND a.TNo = emo.MaintenanceRequestTNo
                    AND emo.TNo = ses.equipmentmaintenanceordertno
                    AND ses.TNo = sesd.TNo
                    AND sesd.JobTypeCode = 'MAINTENANCE:' || act.ActivityCode
                    AND e.EquipmentCategoryCode = 'VEHICLE'
                    AND a.MaintenanceRequestDate Between :P313_FROMDATE and :P313_TODATE
                    AND instr(':'||:P313_COMPANY||':',':'||a.CompanyCode||':') > 0
                    AND instr(':'||:P313_LOCATION||':',':'||GetEquipmentLocationCode(e.TNo,Sysdate)||':') > 0
                    AND (:P313_EQUIPMENT is null or e.EquipmentName = :P313_EQUIPMENT)
                )
                PIVOT (
                  max(ActivityPerformed)
                  FOR ActivityName IN ('WELDING','BRAKE SETTING','CLUTCH SETTING','HEADLIGHT WORK','DOOR HANDLE WORK','TYRE','ENG OIL','GREASING')
                )
                ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        actionsMenu {
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                csv
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 35087941268123104
        }

