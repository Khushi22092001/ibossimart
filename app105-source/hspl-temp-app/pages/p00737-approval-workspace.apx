page 737 (
    name: Approval Workspace
    alias: APPROVAL-WORKSPACE
    title: Approval Workspace
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            body:has(.approval-workspace){background:#f7f8fc}body:has(.approval-workspace) #t_Body_title{display:none!important}body:has(.approval-workspace) .t-Body-contentInner{padding:16px 18px 30px!important}
            .approval-hero{position:relative;display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:150px;padding:28px 30px;overflow:hidden;border:1px solid #efe3d3;border-radius:18px;background:linear-gradient(120deg,#fffaf3 0%,#fff 55%,#eef7ff 100%);box-shadow:0 8px 25px rgba(34,46,80,.06)}.approval-hero:after{content:'';position:absolute;right:-60px;top:-100px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,.12),rgba(77,124,255,.04) 55%,transparent 70%)}.approval-hero-copy{position:relative;z-index:1}.approval-eyebrow{display:flex;align-items:center;gap:8px;color:#ad5b0a;font-size:10.5px;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.approval-eyebrow .fa{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:#fff0df;color:#d66a08}.approval-hero h1{margin:9px 0 5px;color:#151f3b;font-size:28px;line-height:1.1;letter-spacing:-.025em}.approval-hero p{max-width:690px;margin:0;color:#68728a;font-size:12.5px;line-height:1.55}.approval-hero-badge{position:relative;z-index:1;display:grid;place-items:center;width:84px;height:84px;flex:0 0 auto;border:1px solid #f3d7b6;border-radius:24px;background:rgba(255,255,255,.8);color:#d66a08;font-size:31px;box-shadow:0 8px 20px rgba(125,72,16,.09)}
            .approval-summary{margin-top:14px!important}.approval-summary .t-Report-report{width:100%}.approval-summary thead{display:none}.approval-summary tr,.approval-summary td{display:block!important;padding:0!important;border:0!important;background:transparent!important}.approval-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.approval-kpi{display:flex;align-items:center;gap:12px;min-height:94px;padding:15px 16px;border:1px solid #e5e8f1;border-radius:14px;background:#fff;box-shadow:0 5px 16px rgba(38,52,85,.05)}.approval-kpi .fa{display:grid;place-items:center;width:42px;height:42px;flex:0 0 auto;border-radius:12px;background:#fff0df;color:#d66a08;font-size:17px}.approval-kpi:nth-child(2) .fa{background:#ffedef;color:#d7344e}.approval-kpi:nth-child(3) .fa{background:#eaf5ff;color:#2878bf}.approval-kpi:nth-child(4) .fa{background:#eaf8f2;color:#16865b}.approval-kpi small{display:block;color:#7b8499;font-size:9.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.approval-kpi b{display:block;margin-top:3px;color:#19233e;font-size:20px;line-height:1.1}
            .approval-filter{margin-top:14px!important;border:1px solid #e3e7f0!important;border-radius:16px!important;background:#fff!important;box-shadow:0 7px 22px rgba(38,52,85,.045)!important}.approval-filter .t-Region-header{min-height:54px;border-bottom:1px solid #edf0f5!important;background:#fff!important}.approval-filter .t-Region-title{display:flex;align-items:center;gap:9px;color:#18213d!important;font-size:14px!important;font-weight:850!important}.approval-filter .t-Region-title:before{content:'\f0b0';display:grid;place-items:center;width:29px;height:29px;border-radius:9px;background:#eaf5ff;color:#2878bf;font-family:"Font APEX Small";font-size:12px;font-weight:400}.approval-filter .t-Region-body{padding:15px 16px 12px!important}.approval-filter .t-Form-label{color:#667189!important;font-size:10px!important;font-weight:800!important}.approval-filter .apex-item-text,.approval-filter .apex-item-select,.approval-filter .apex-item-popup-lov{min-height:40px!important;border-radius:9px!important}.approval-bulk{margin-top:10px!important;border:1px solid #e4e7f0!important;border-radius:13px!important;background:linear-gradient(90deg,#fafaff,#fff)!important}.approval-bulk .t-Region-body{display:flex;align-items:center;gap:9px;padding:10px 13px!important}.approval-bulk .t-Button{border-radius:8px!important}.approval-bulk .t-Button[data-otel-label='PASS_SELECTED']{border-color:#75c99a!important;background:#f2fff7!important;color:#177b46!important}.approval-bulk .t-Button[data-otel-label='FAIL_SELECTED']{border-color:#ef9da9!important;background:#fff6f7!important;color:#bf2f45!important}.approval-select{width:17px;height:17px;margin:0;accent-color:#6554e8;cursor:pointer}.approval-selection-cell{text-align:center}.approval-register .a-IRR-table td[headers='SELECTION'],.approval-register .a-IRR-table th[id*='SELECTION']{width:54px!important;text-align:center!important}
            .approval-register{margin-top:14px!important;border:1px solid #e3e7f0!important;border-radius:16px!important;background:#fff!important;box-shadow:0 7px 22px rgba(38,52,85,.055)!important;overflow:hidden}.approval-register .t-Region-header{min-height:58px;border-bottom:1px solid #edf0f5!important;background:#fff!important}.approval-register .t-Region-title{display:flex;align-items:center;gap:9px;color:#18213d!important;font-size:15px!important;font-weight:850!important}.approval-register .t-Region-title:before{content:'\f0e3';display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:#fff0df;color:#d66a08;font-family:"Font APEX Small";font-size:13px;font-weight:400}.approval-register .a-IRR-toolbar{border-color:#eceef5!important;background:#f8f8fc!important}.approval-register .a-IRR-table th{height:48px;background:#f2f3ff!important;color:#5552d8!important;font-size:10px!important;font-weight:900!important;letter-spacing:.06em;text-transform:uppercase}.approval-register .a-IRR-table td{height:54px;color:#465067;font-size:11px}.approval-doc{color:#5455d8;font-weight:800;text-decoration:none}.approval-doc:hover{text-decoration:underline}.approval-wait{display:inline-flex;padding:4px 7px;border-radius:999px;background:#fff4e4;color:#a45c07;font-size:9.5px;font-weight:850}.approval-actions{display:flex;align-items:center;gap:7px}.approval-action-btn{display:inline-flex;align-items:center;justify-content:center;gap:5px;min-height:30px;padding:5px 9px;border-radius:8px;font-size:9.5px;font-weight:850;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease}.approval-action-btn:hover{transform:translateY(-1px)}.approval-action-btn.is-approve{border:1px solid #75c99a;background:#f2fff7;color:#177b46}.approval-action-btn.is-reject{border:1px solid #ef9da9;background:#fff6f7;color:#bf2f45}.approval-empty{overflow:hidden;margin:18px;border:1px solid #e2e6ef;border-radius:13px;background:#fff}.approval-empty-head{display:grid;grid-template-columns:1.2fr 1fr 1fr 100px 145px;gap:12px;padding:12px 15px;background:#f2f3ff;color:#5552d8;font-size:9px;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.approval-empty-body{display:flex;align-items:center;justify-content:center;gap:14px;min-height:150px;padding:22px;color:#7c859a}.approval-empty-art{position:relative;display:grid;place-items:center;width:74px;height:74px;border-radius:23px;background:linear-gradient(145deg,#fff0df,#f1efff);color:#d66a08;font-size:28px}.approval-empty-art:after{content:'\f00c';position:absolute;right:-3px;bottom:-3px;display:grid;place-items:center;width:27px;height:27px;border:3px solid #fff;border-radius:50%;background:#e7f8ee;color:#16865b;font-family:"Font APEX Small";font-size:11px}.approval-empty-copy b{display:block;color:#202a45;font-size:14px}.approval-empty-copy small{display:block;max-width:380px;margin-top:5px;font-size:10.5px;line-height:1.5}
            body.approval-compose-open{overflow:hidden}.approval-compose-open:before{content:'';position:fixed;inset:0;z-index:9997;background:rgba(18,27,53,.42);backdrop-filter:blur(2px)}#approvalActionEditor{display:none!important;position:fixed!important;z-index:9998!important;top:50%!important;left:50%!important;width:min(560px,calc(100vw - 28px))!important;max-height:calc(100vh - 36px)!important;margin:0!important;overflow:auto!important;transform:translate(-50%,-50%)!important;border:1px solid #dfdcfa!important;border-radius:18px!important;background:linear-gradient(135deg,#faf9ff,#fff)!important;box-shadow:0 24px 70px rgba(25,30,72,.24)!important}.approval-compose-open #approvalActionEditor{display:block!important}.approval-editor-head{padding:4px 0 13px}.approval-editor-head small{display:block;color:#6554e8;font-size:9.5px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.approval-editor-head h2{margin:6px 0 0;color:#1d2745;font-size:17px;line-height:1.3}.approval-editor-head p{margin:6px 0 0;color:#748097;font-size:11px;line-height:1.5}.approval-editor .t-Form-fieldContainer{margin:0!important}.approval-editor textarea{min-height:108px!important;border:1px solid #dfe3ec!important;border-radius:11px!important;background:#fff!important;resize:vertical}.approval-editor textarea:focus{border-color:#7162e8!important;box-shadow:0 0 0 3px rgba(101,84,232,.10)!important}.approval-editor button[data-otel-label='CONFIRM_APPROVAL_ACTION']{border-radius:9px!important}.approval-editor button[data-otel-label='CANCEL_APPROVAL_ACTION']{border-radius:9px!important}
            /* Approval workspace presentation layer: scoped so report behaviour and the global theme stay unchanged. */
            body:has(.approval-workspace) .approval-summary{margin-top:18px!important}
            body:has(.approval-workspace) .approval-kpis{gap:16px}
            body:has(.approval-workspace) .approval-kpi{min-height:116px;gap:18px;padding:20px 24px;border-color:#e3e7f0;border-radius:16px;box-shadow:0 9px 25px rgba(36,50,84,.07)}
            body:has(.approval-workspace) .approval-kpi:nth-child(1){background:linear-gradient(120deg,#fff9ef,#fff)}
            body:has(.approval-workspace) .approval-kpi:nth-child(2){background:linear-gradient(120deg,#fff5f6,#fff)}
            body:has(.approval-workspace) .approval-kpi:nth-child(3){background:linear-gradient(120deg,#f3f8ff,#fff)}
            body:has(.approval-workspace) .approval-kpi:nth-child(4){background:linear-gradient(120deg,#f2fbf6,#fff)}
            body:has(.approval-workspace) .approval-kpi .fa{width:54px;height:54px;border-radius:15px;font-size:22px;box-shadow:0 7px 16px rgba(34,47,80,.06)}
            body:has(.approval-workspace) .approval-kpi small{font-size:11px;letter-spacing:.07em}
            body:has(.approval-workspace) .approval-kpi b{margin-top:7px;font-size:25px}
            body:has(.approval-workspace) .approval-filter{margin-top:20px!important;border-radius:17px!important;box-shadow:0 8px 26px rgba(38,52,85,.055)!important}
            body:has(.approval-workspace) .approval-filter .t-Region-header{min-height:70px;padding-inline:20px!important}
            body:has(.approval-workspace) .approval-filter .t-Region-title{font-size:16px!important}
            body:has(.approval-workspace) .approval-filter .t-Region-title:before{width:38px;height:38px;border-radius:11px;font-size:15px}
            body:has(.approval-workspace) .approval-filter .t-Region-body{padding:22px 24px 18px!important}
            body:has(.approval-workspace) .approval-filter .t-Form-fieldContainer{margin-bottom:8px!important}
            body:has(.approval-workspace) .approval-filter .t-Form-label{padding-bottom:7px!important;font-size:11.5px!important}
            body:has(.approval-workspace) .approval-filter .apex-item-text,body:has(.approval-workspace) .approval-filter .apex-item-select,body:has(.approval-workspace) .approval-filter .apex-item-popup-lov{min-height:46px!important;border-color:#d9deea!important;border-radius:10px!important;background:#fff!important}
            body:has(.approval-workspace) .approval-filter .t-Button{min-height:46px;margin-top:23px!important;padding-inline:18px!important;border-radius:10px!important;font-weight:750!important}
            body:has(.approval-workspace) .approval-filter .t-Button--hot{box-shadow:0 7px 15px rgba(81,73,214,.22)!important}
            body:has(.approval-workspace) .approval-filter-note{margin-top:10px;color:#657087;font-size:11.5px;line-height:1.55}
            body:has(.approval-workspace) .approval-filter .t-Button-icon:last-child,body:has(.approval-workspace) .approval-bulk .t-Button-icon:last-child{display:none!important}
            body:has(.approval-workspace) .approval-bulk{margin-top:16px!important;border-radius:14px!important;box-shadow:0 5px 17px rgba(38,52,85,.045)!important}
            body:has(.approval-workspace) .approval-bulk .t-Region-body{min-height:66px;gap:11px;padding:12px 18px!important}
            body:has(.approval-workspace) .approval-bulk-copy{flex:1;color:#39445f;font-size:13px;line-height:1.4}
            body:has(.approval-workspace) .approval-bulk-copy b{color:#574be0;font-weight:850}
            body:has(.approval-workspace) .approval-bulk .t-Button{min-height:40px;padding-inline:15px!important;border:1px solid #dce1eb!important;border-radius:9px!important;background:#fff!important;box-shadow:0 3px 9px rgba(38,52,85,.035)!important}
            body:has(.approval-workspace) .approval-bulk .t-Button[data-otel-label='PASS_SELECTED']{border-color:#75c99a!important;background:#f2fff7!important}
            body:has(.approval-workspace) .approval-bulk .t-Button[data-otel-label='FAIL_SELECTED']{border-color:#ef9da9!important;background:#fff6f7!important}
            body:has(.approval-workspace) .approval-register{margin-top:18px!important;border-radius:17px!important;box-shadow:0 8px 26px rgba(38,52,85,.06)!important}
            body:has(.approval-workspace) .approval-register .t-Region-header{min-height:68px;padding-inline:20px!important}
            body:has(.approval-workspace) .approval-register .t-Region-title{font-size:16px!important}
            body:has(.approval-workspace) .approval-register .t-Region-title:before{width:38px;height:38px;border-radius:11px;font-size:15px;background:#f1edff;color:#6554e8}
            body:has(.approval-workspace) .approval-register .a-IRR-toolbar{padding:10px!important;background:linear-gradient(90deg,#fafaff,#f6f4ff)!important}
            body:has(.approval-workspace) .approval-register .a-IRR-table th{height:52px}
            body:has(.approval-workspace) .approval-register .a-IRR-table td{height:58px}
            @media(max-width:1050px){body:has(.approval-workspace) .approval-filter .t-Button{margin-top:4px!important}body:has(.approval-workspace) .approval-bulk .t-Region-body{flex-wrap:wrap}body:has(.approval-workspace) .approval-bulk-copy{flex-basis:100%}}
            @media(max-width:900px){.approval-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.approval-hero{padding:24px}.approval-hero-badge{display:none}}
            @media(max-width:640px){body:has(.approval-workspace) .t-Body-contentInner{padding:10px!important}.approval-kpis{grid-template-columns:1fr}.approval-actions{flex-direction:column;align-items:stretch}.approval-action-btn{width:100%}}
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region approval-action-editor (
        name: Approval Decision
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="approval-editor-head">
                  <small>Decision editor</small>
                  <h2 id="approvalActionTitle">Select an approval action</h2>
                  <p id="approvalActionHelp">Choose Approve or Reject from the queue above.</p>
                </div>
                ```
        }
        layout {
            sequence: 60
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: approval-editor
        }
        advanced {
            htmlDomId: approvalActionEditor
        }
    )

    region approval-bulk-actions (
        name: Bulk Decisions
        type: staticContent
        source {
            htmlCode: <span class="approval-bulk-copy"><b>Select approvals</b> and apply one mandatory remark to the complete selection.</span>
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: approval-bulk
        }
        advanced {
            htmlDomId: approvalBulkActions
        }
    )

    region approval-filters (
        name: Approval Filters
        type: staticContent
        source {
            htmlCode: <div class="approval-filter-note">Search the same decision queue by company, location or party. Filters never broaden your assigned approvals.</div>
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: approval-filter
        }
        advanced {
            htmlDomId: approvalFilters
        }
    )

    region approval-hero (
        name: Approval Workspace Header
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="approval-workspace">
                  <section class="approval-hero">
                    <div class="approval-hero-copy">
                      <div class="approval-eyebrow"><span class="fa fa-gavel"></span>Workflow · Decision queue</div>
                      <h1>Approval Workspace</h1>
                      <p>Review documents assigned to you, open the source transaction for context, and approve or reject it with a clear audit remark.</p>
                    </div>
                    <div class="approval-hero-badge"><span class="fa fa-check-square-o"></span></div>
                  </section>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region approval-queue (
        name: Pending Approvals
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<span class="approval-selection-cell"><input type="checkbox" class="approval-select" value="'||q.TNo||'" aria-label="Select '||apex_escape.html_attribute(Nvl(q.MenuLabel,'approval '||q.TNo))||'"></span>' Selection,
                       q.TNo,
                       Nvl(o.ModuleDate,sc.SalesConfirmDate) ModuleDate,
                       Nvl(c.CompanyName,q.CompanyCode) Company,
                       Nvl(l.LocationName,Nvl(o.LocationCode,sc.LocationCode)) Location,
                       Nvl(o.PartyName,p.PartyName) PartyName,
                       Nvl(o.PartyCode,sc.PartyCode) PartyCode,
                       Nvl(o.ModuleAmount,sc.SalesConfirmAmount) Amount,
                       Nvl(o.NetAmount,sc.SalesConfirmAmount) NetAmount,
                       q.ModuleName Module,
                       Case When m.EntryPageNo Is Not Null Then
                         '<a class="approval-doc" href="'||apex_escape.html_attribute(
                           apex_page.get_url(
                             p_page=>m.EntryPageNo,
                             p_clear_cache=>to_char(m.EntryPageNo),
                             p_items=>'P'||m.EntryPageNo||'_TNO,P'||m.EntryPageNo||'_CALLEDFROMPAGE,P'||m.EntryPageNo||'_FORMSTATUS',
                             p_values=>q.ModuleTNo||',737,CALLED'))||'">'||apex_escape.html(Nvl(q.MenuLabel,'Work item #'||q.ModuleTNo))||'</a>'
                       Else apex_escape.html(Nvl(q.MenuLabel,'Work item #'||q.ModuleTNo)) End Module_No,
                       q.TokenNo,
                       o.Particulars Particulars,
                       Cast(Null As Varchar2(100)) Ledger_Balance,
                       q.QueueDate,
                       '<span class="approval-wait">'||Case When q.QueueDate Is Null Then 'Waiting'
                            When trunc(sysdate-q.QueueDate)=0 Then 'Today'
                            Else trunc(sysdate-q.QueueDate)||' day(s)' End||'</span>' Waiting_Age,
                       (Select Max(p.Remark) Keep (Dense_Rank Last Order By p.TokenNo,p.TNo)
                          From PassFail p
                         Where p.ModuleTNo=q.ModuleTNo
                           And p.TokenNo<q.TokenNo
                           And p.Remark Is Not Null) Previous_Remark,
                       '<div class="approval-actions">'
                       ||'<button type="button" class="approval-action-btn is-approve" data-action="APPROVE" data-tno="'||q.TNo||'" data-label="'||apex_escape.html_attribute(Nvl(q.MenuLabel,'Work item #'||q.ModuleTNo))||'"><span class="fa fa-check"></span>Approve</button>'
                       ||'<button type="button" class="approval-action-btn is-reject" data-action="REJECT" data-tno="'||q.TNo||'" data-label="'||apex_escape.html_attribute(Nvl(q.MenuLabel,'Work item #'||q.ModuleTNo))||'"><span class="fa fa-times"></span>Reject</button>'
                       ||'</div>' Actions
                  From ONTHETABLE_APEX q
                  Left Join HSPL.ONTHETABLEALL o On o.TNo=q.TNo
                  Left Join SalesConfirm sc
                    On q.ModuleCode='SALESCONFIRM'
                   And sc.TNo=q.ModuleTNo
                  Left Join Party p On p.PartyCode=Nvl(o.PartyCode,sc.PartyCode)
                  Left Join Module m On m.ModuleCode=q.ModuleCode
                  Left Join Company c On c.CompanyCode=q.CompanyCode
                  Left Join Location l On l.LocationCode=Nvl(o.LocationCode,sc.LocationCode)
                 Where (:P737_COMPANY Is Null Or q.CompanyCode=:P737_COMPANY)
                   And (:P737_LOCATION Is Null Or Nvl(o.LocationCode,sc.LocationCode)=:P737_LOCATION)
                   And (:P737_PARTY Is Null Or Nvl(o.PartyCode,sc.PartyCode)=:P737_PARTY)
                 Order By q.QueueDate Nulls Last,q.TNo
                ```
        }
        layout {
            sequence: 50
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: approval-register
        }
        advanced {
            htmlDomId: approvalQueue
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: <div class="approval-empty"><div class="approval-empty-head"><span>Work item</span><span>Module</span><span>Company</span><span>Waiting</span><span>Decision</span></div><div class="approval-empty-body"><span class="approval-empty-art"><span class="fa fa-clipboard"></span></span><span class="approval-empty-copy"><b>No approval is waiting for you</b><small>Your approval queue is clear. New documents assigned to you will appear here with Approve and Reject actions.</small></span></div></div>
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows. Please refine the report filters.
        }
        advanced {
            savedReportMappingIdentifier: 55748194510506211
        }

        column ACTIONS (
            type: plainText
            heading {
                heading: Decision
            }
            layout {
                sequence: 160
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
            security {
                escapeSpecialChars: false
            }
        )

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column COMPANY (
            type: plainText
            heading {
                heading: Company
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
