    pageItem P737_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct Nvl(c.CompanyName,q.CompanyCode) d,q.CompanyCode r
                  From ONTHETABLE_APEX q
                  Left Join Company c On c.CompanyCode=q.CompanyCode
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 10
            region: @approval-filters
            slot: regionBody
            column: 1
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            valuePlaceholder: All companies
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P737_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct Nvl(l.LocationName,x.LocationCode) d,x.LocationCode r
                  From (
                        Select q.TNo,q.CompanyCode,
                               Nvl(o.LocationCode,sc.LocationCode) LocationCode
                          From ONTHETABLE_APEX q
                          Left Join HSPL.ONTHETABLEALL o On o.TNo=q.TNo
                          Left Join SalesConfirm sc
                            On q.ModuleCode='SALESCONFIRM'
                           And sc.TNo=q.ModuleTNo
                       ) x
                  Left Join Location l On l.LocationCode=x.LocationCode
                 Where x.LocationCode Is Not Null
                   And (:P737_COMPANY Is Null Or x.CompanyCode=:P737_COMPANY)
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P737_COMPANY
            itemsToSubmit: P737_COMPANY
            parentRequired: false
        }
        layout {
            sequence: 20
            region: @approval-filters
            slot: regionBody
            startNewRow: false
            column: 4
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            valuePlaceholder: All locations
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P737_PARTY (
        type: popupLov
        label {
            label: Party
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct Nvl(p.PartyName,GetPartyName(x.PartyCode))||' ('||x.PartyCode||')' d,x.PartyCode r
                  From (
                        Select q.CompanyCode,
                               Nvl(o.LocationCode,sc.LocationCode) LocationCode,
                               Nvl(o.PartyCode,sc.PartyCode) PartyCode
                          From ONTHETABLE_APEX q
                          Left Join HSPL.ONTHETABLEALL o On o.TNo=q.TNo
                          Left Join SalesConfirm sc
                            On q.ModuleCode='SALESCONFIRM'
                           And sc.TNo=q.ModuleTNo
                       ) x
                  Left Join Party p On p.PartyCode=x.PartyCode
                 Where x.PartyCode Is Not Null
                   And (:P737_COMPANY Is Null Or x.CompanyCode=:P737_COMPANY)
                   And (:P737_LOCATION Is Null Or x.LocationCode=:P737_LOCATION)
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All parties
        }
        cascadingLov {
            parentItems: [
                P737_COMPANY
                P737_LOCATION
            ]
            itemsToSubmit: [
                P737_COMPANY
                P737_LOCATION
            ]
            parentRequired: false
        }
        layout {
            sequence: 30
            region: @approval-filters
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            valuePlaceholder: Search party name or code
        }
        security {
            encryptSessionState: false
        }
    )

