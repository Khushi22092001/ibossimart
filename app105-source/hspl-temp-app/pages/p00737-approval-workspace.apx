    region approval-summary (
        name: Approval Summary
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="approval-kpis">'
                       ||'<div class="approval-kpi"><span class="fa fa-inbox"></span><span><small>Waiting for you</small><b>'||to_char(Count(*),'FM999G999G990')||'</b></span></div>'
                       ||'<div class="approval-kpi"><span class="fa fa-exclamation-triangle"></span><span><small>Waiting over 2 days</small><b>'||to_char(Nvl(Sum(Case When sysdate-QueueDate>2 Then 1 Else 0 End),0),'FM999G999G990')||'</b></span></div>'
                       ||'<div class="approval-kpi"><span class="fa fa-cubes"></span><span><small>Modules involved</small><b>'||to_char(Count(Distinct ModuleCode),'FM999G999G990')||'</b></span></div>'
                       ||'<div class="approval-kpi"><span class="fa fa-clock-o"></span><span><small>Oldest waiting</small><b>'||Nvl(to_char(Trunc(Max(sysdate-QueueDate))),'0')||' d</b></span></div>'
                       ||'</div>' Summary
                  From ONTHETABLE_APEX
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: approval-summary
        }
        advanced {
            htmlDomId: approvalSummary
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }

        column SUMMARY (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

