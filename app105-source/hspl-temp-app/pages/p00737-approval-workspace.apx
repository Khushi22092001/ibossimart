    dynamicAction cancel-decision (
        name: Cancel approval decision
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel-approval-action
        }

        action close-editor (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.jQuery('body').removeClass('approval-compose-open');
                    apex.item('P737_ACTION_TNO').setValue('');
                    apex.item('P737_ACTION').setValue('');
                    apex.item('P737_ACTION_LABEL').setValue('');
                    apex.item('P737_SELECTED_TNOS').setValue('');
                    apex.item('P737_REMARK').setValue('');
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction clear-visible-approvals (
        name: Unselect all approvals
        execution {
            sequence: 2
        }
        when {
            event: click
            selectionType: button
            button: @clear-all-approvals
        }

        action clear-visible-rows (
            action: executeJsCode
            settings {
                jsCode: apex.jQuery('#approvalQueue .approval-select').prop('checked',false).trigger('change');
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction fail-selected-approvals (
        name: Fail selected approvals
        execution {
            sequence: 4
        }
        when {
            event: click
            selectionType: button
            button: @fail-selected
        }

        action open-bulk-fail-editor (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var ids=apex.jQuery('#approvalQueue .approval-select:checked').map(function(){return this.value;}).get();
                    if(!ids.length){apex.message.alert('Select at least one approval first.');return;}
                    if(ids.length>100){apex.message.alert('A maximum of 100 approvals can be processed together.');return;}
                    apex.item('P737_ACTION_TNO').setValue('');
                    apex.item('P737_SELECTED_TNOS').setValue(ids.join(':'));
                    apex.item('P737_ACTION').setValue('REJECT');
                    apex.item('P737_ACTION_LABEL').setValue(ids.length+' selected approvals');
                    apex.jQuery('#approvalActionTitle').text('Fail '+ids.length+' selected approvals');
                    apex.jQuery('#approvalActionHelp').text('Enter the mandatory rejection reason. It will be recorded against every selected document before return routing.');
                    apex.jQuery('#approvalConfirm').addClass('t-Button--danger').find('.t-Button-label').text('Confirm bulk fail');
                    apex.jQuery('body').addClass('approval-compose-open');
                    window.setTimeout(function(){apex.jQuery('#P737_REMARK').trigger('focus');},60);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction open-row-decision (
        name: Open row approval decision
        execution {
            sequence: 1
            eventScope: dynamic
            staticContainer: '#approvalQueue'
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .approval-action-btn
        }

        action open-row-decision-editor (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var el=this.triggeringElement,
                        action=el.dataset.action,
                        label=el.dataset.label||'selected work item';
                    apex.item('P737_SELECTED_TNOS').setValue('');
                    apex.item('P737_ACTION_TNO').setValue(el.dataset.tno);
                    apex.item('P737_ACTION').setValue(action);
                    apex.item('P737_ACTION_LABEL').setValue(label);
                    apex.jQuery('#approvalActionTitle').text((action==='APPROVE'?'Approve ':'Reject ')+label);
                    apex.jQuery('#approvalActionHelp').text(action==='APPROVE'
                      ?'Enter an approval remark, then confirm this decision.'
                      :'Enter a rejection remark so the document owner knows what to correct.');
                    apex.jQuery('#approvalConfirm').toggleClass('t-Button--danger',action==='REJECT')
                      .find('.t-Button-label').text(action==='APPROVE'?'Confirm approval':'Confirm rejection');
                    apex.jQuery('body').addClass('approval-compose-open');
                    window.setTimeout(function(){apex.jQuery('#P737_REMARK').trigger('focus');},60);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pass-selected-approvals (
        name: Pass selected approvals
        execution {
            sequence: 3
        }
        when {
            event: click
            selectionType: button
            button: @pass-selected
        }

        action open-bulk-pass-editor (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var ids=apex.jQuery('#approvalQueue .approval-select:checked').map(function(){return this.value;}).get();
                    if(!ids.length){apex.message.alert('Select at least one approval first.');return;}
                    if(ids.length>100){apex.message.alert('A maximum of 100 approvals can be processed together.');return;}
                    apex.item('P737_ACTION_TNO').setValue('');
                    apex.item('P737_SELECTED_TNOS').setValue(ids.join(':'));
                    apex.item('P737_ACTION').setValue('APPROVE');
                    apex.item('P737_ACTION_LABEL').setValue(ids.length+' selected approvals');
                    apex.jQuery('#approvalActionTitle').text('Pass '+ids.length+' selected approvals');
                    apex.jQuery('#approvalActionHelp').text('One mandatory remark will be recorded against every selected approval. The complete selection is revalidated before processing.');
                    apex.jQuery('#approvalConfirm').removeClass('t-Button--danger').find('.t-Button-label').text('Confirm bulk pass');
                    apex.jQuery('body').addClass('approval-compose-open');
                    window.setTimeout(function(){apex.jQuery('#P737_REMARK').trigger('focus');},60);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

