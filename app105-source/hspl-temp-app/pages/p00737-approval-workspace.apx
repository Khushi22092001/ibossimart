    dynamicAction submit-decision (
        name: Submit approval decision
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @confirm-approval-action
        }

        action complete-decision-ui (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var action=apex.item('P737_ACTION').getValue(),
                        selected=apex.item('P737_SELECTED_TNOS').getValue(),
                        count=selected?selected.split(':').filter(Boolean).length:1;
                    apex.jQuery('body').removeClass('approval-compose-open');
                    apex.item('P737_ACTION_TNO').setValue('');
                    apex.item('P737_ACTION').setValue('');
                    apex.item('P737_ACTION_LABEL').setValue('');
                    apex.item('P737_SELECTED_TNOS').setValue('');
                    apex.item('P737_REMARK').setValue('');
                    apex.message.showPageSuccess(count+' approval'+(count===1?'':'s')+(action==='APPROVE'?' passed and forwarded.':' failed and returned with your remark.'));
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action process-decision (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    Declare
                      lAction       Varchar2(10):=Upper(Trim(:P737_ACTION));
                      lRemark       Varchar2(500):=Trim(:P737_REMARK);
                      lSelected     Varchar2(32767):=Trim(:P737_SELECTED_TNOS);
                      lTNos         apex_t_varchar2;
                      lTNo          Number;
                      lProcessed    Pls_Integer:=0;
                      Type tSeen Is Table Of Boolean Index By Varchar2(100);
                      lSeen         tSeen;
                    
                      Procedure ProcessOne(pTNo In Number) Is
                        lModuleTNo    PassFail.ModuleTNo%Type;
                        lTokenNo      PassFail.TokenNo%Type;
                        lModuleCode   ModuleFlow.ModuleCode%Type;
                        lCompanyCode  ModuleFlow.CompanyCode%Type;
                        lLabel        PassFail.MenuLabel%Type;
                      Begin
                        Select a.ModuleTNo,a.TokenNo,mf.ModuleCode,mf.CompanyCode,a.MenuLabel
                          Into lModuleTNo,lTokenNo,lModuleCode,lCompanyCode,lLabel
                          From PassFail a
                          Join ModuleFlow mf On mf.TNo=a.ModuleFlowTNo
                          Join BossUser bu On bu.BossUserCode=a.BossUserCode
                         Where a.TNo=pTNo
                           And (Upper(bu.BossUserName)=Upper(:APP_USER)
                                Or Upper(bu.LoginName)=Upper(:APP_USER))
                           And a.IsPass Is Null
                           And a.IsFail Is Null
                           And a.IsForwarded Is Null
                           And a.IsRebounded Is Null
                         For Update Of a.IsPass,a.IsFail,a.Remark;
                    
                        If lAction='APPROVE' Then
                          Update PassFail
                             Set IsPass='YES',Remark=lRemark
                           Where TNo=pTNo;
                          SendPassFailForward(lModuleCode,lModuleTNo,Nvl(lLabel,'Approval #'||lModuleTNo),lCompanyCode);
                        Else
                          Update PassFail
                             Set IsFail='YES',Remark=lRemark
                           Where TNo=pTNo;
                          SendBackPassFail(lTokenNo,Nvl(lLabel,'Approval #'||lModuleTNo));
                        End If;
                        lProcessed:=lProcessed+1;
                      Exception
                        When No_Data_Found Then
                          raise_application_error(-20003,'Approval #'||pTNo||' is no longer pending or is not assigned to you. Refresh the queue. No selected approval was changed.');
                      End ProcessOne;
                    Begin
                      If lAction Not In ('APPROVE','REJECT') Then
                        raise_application_error(-20001,'Choose Approve or Reject again.');
                      End If;
                      If lRemark Is Null Then
                        raise_application_error(-20002,'A decision remark is required.');
                      End If;
                    
                      If lSelected Is Not Null Then
                        lTNos:=apex_string.split(lSelected,':');
                        If lTNos.Count=0 Or lTNos.Count>100 Then
                          raise_application_error(-20004,'Select between 1 and 100 approvals.');
                        End If;
                        For i In 1..lTNos.Count Loop
                          lTNo:=to_number(Trim(lTNos(i)) Default Null On Conversion Error);
                          If lTNo Is Null Then
                            raise_application_error(-20005,'The selected approval list is invalid. Refresh the queue and select again.');
                          End If;
                          If Not lSeen.Exists(To_Char(lTNo)) Then
                            lSeen(To_Char(lTNo)):=True;
                            ProcessOne(lTNo);
                          End If;
                        End Loop;
                      Else
                        lTNo:=to_number(:P737_ACTION_TNO Default Null On Conversion Error);
                        If lTNo Is Null Then
                          raise_application_error(-20006,'Choose an approval from the current queue.');
                        End If;
                        ProcessOne(lTNo);
                      End If;
                    End;
                    ```
                itemsToSubmit: [
                    P737_ACTION_TNO
                    P737_SELECTED_TNOS
                    P737_ACTION
                    P737_REMARK
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-queue (
            action: refresh
            affectedElements {
                selectionType: region
                region: @approval-queue
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action refresh-summary (
            action: refresh
            affectedElements {
                selectionType: region
                region: @approval-summary
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

