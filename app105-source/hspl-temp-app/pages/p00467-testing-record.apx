page 467 (
    name: TESTING RECORD
    alias: TESTING-RECORD
    title: TESTING RECORD
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: REPORT
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                row_number() over(order by a.AccessoriesManagementDate) SerialsNo,
                b.LocationName,
                a.AccessoriesManagementDate,
                a.Activity,
                a.ItemCategoryCode as AccessoriesCategory,
                d.ItemName,
                e.ItemSpecificationName,
                a.Condition,
                h.EquipmentName as Equipment,
                a.SerialNo,
                f.ItemMakeName  as Making,
                g.ItemSizeName as Sizea,
                i.EquipmentCategoryName,
                j.EquipmentName,
                j.EquipmentID,
                a.SourceEquipmentTotalKMReading,
                a.SourceEquipmentTotalHRReading,
                GETPREVIOUSKMREADING(A.ITEMCODE,A.SERIALNO,A.AccessoriesManagementDate) as PreviousKM,
                GETPREVIOUSHRREADING(A.ITEMCODE,A.SERIALNO,A.AccessoriesManagementDate) as PreviousHR,
                
                a.SourceEquipmentTotalKMReading - GETPREVIOUSKMREADING(A.ITEMCODE,A.SERIALNO,A.AccessoriesManagementDate) AS RunningKM,
                a.SourceEquipmentTotalHRReading - GETPREVIOUSHRREADING(A.ITEMCODE,A.SERIALNO,A.AccessoriesManagementDate) AS RunningHR,
                --a.SourceEquipmentTotalKMReading as RunningKM,
                --a.SourceEquipmentTotalHRReading as RunningHR,
                Case When a.RepairRequired = 'YES' then 'Repaired'
                When a.IsScrapped = 'YES' then 'IsScrapped'
                Else null
                End as Conditions,
                k.RepairingRequisitionNo,
                l.BillDetails,
                ecg.EquipmentGroupName,
                (A.AccessoriesManagementDate - GETPREVIOUSENTRYDATE(A.ITEMCODE,A.SERIALNO,A.AccessoriesManagementDate) ) AS RunningDays
                From AccessoriesManagement a, Location b, Item d,ItemSpecification e, ItemMake f,ItemSize g, Company co,
                Equipment h,EquipmentCategory i, Equipment j, EquipmentGroup ecg,
                (Select
                a.Tno,
                c.RepairingRequisitionNo
                FROM AccessoriesManagement a, RepairingRequisitionDetail b, RepairingRequisition c
                Where a.EquipmentTno = b.EquipmentTno
                and b.Tno = c.Tno
                and a.Activity = 'Remove'
                )k,
                (Select 
                  a.Tno,
                 nvl(b.ExternalServicesEntryNo,e.JobBillNo) as BillDetails 
                 From AccessoriesManagement a, EXTERNALSERVICESENTRY b,STOREINREPAIRINGITEMdetail c, GatePass d, JobBill e
                Where a.EquipmentTno = b.EquipmentTno(+)
                and a.EquipmentTno = c.EquipmentTno(+)
                and c.Tno = d.STOREINREPAIRINGITEMTno(+)
                and d.Tno = e.GatePassTno(+))l
                Where a.LocationCode = b.LocationCode
                and a.ItemCode = d.ItemCode(+)
                and a.ItemSpecificationCode = e.ItemSpecificationCode(+)
                and a.ManufactureMakeCode = f.ItemMakeCode(+)
                and a.ManufactureModelCode = g.ItemSizeCode(+)
                and a.CompanyCode = co.CompanyCode(+)
                and a.sourceEquipmentTno = h.Tno(+)
                and h.EquipmentCategoryCode = i.EquipmentCategoryCode(+)
                and a.SourceEquipmentTno = j.Tno(+)
                and h.EquipmentGroupCode = ecg.EquipmentGroupCode(+)
                and a.Tno = k.Tno(+)
                and a.Tno = l.Tno(+)
                and a.AccessoriesManagementDate between :P467_FROMDATE and :P467_TODATE
                -- and ( :P341_COMPANY IS NULL OR instr(':'||:P341_COMPANY||':',':'||co.CompanyCode||':') > 0)
                -- --and ( :P341_SERIALNO IS NULL OR instr(':'||:P341_SERIALNO||':',':'||a.SerialNo||':') > 0)
                -- and ( :P341_CATEGORY IS NULL OR instr(':'||:P341_CATEGORY||':',':'||a.ItemCategoryCode||':') > 0)
                -- and ( :P341_EQUIPMENT IS NULL OR instr(':'||:P341_EQUIPMENT||':',':'||a.EquipmentTno||':') > 0)
                -- and ( :P341_ACTIVITY IS NULL OR instr(':'||:P341_ACTIVITY||':',':'||a.Activity||':') > 0)
                -- and ( :P341_EQUIPMENTCATEGORY IS NULL OR instr(':'||:P341_EQUIPMENTCATEGORY||':',':'||i.EquipmentCategoryCode||':') > 0)
                -- and ( :P341_EQUIPMENTGROUP IS NULL OR instr(':'||:P341_EQUIPMENTGROUP||':',':'||ecg.EquipmentGroupCode||':') > 0)
                -- and ( :P341_SERIALNO IS NULL OR instr(':'||:P341_SERIALNO||':',':'||a.SerialNo||':') > 0)
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                
                ```
        }
