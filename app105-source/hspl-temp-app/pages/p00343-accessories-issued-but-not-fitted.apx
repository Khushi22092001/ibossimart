    pageItem P343_LOCATION (
        type: selectList
        label {
            label: LOCATION
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        l.LocationName,
                        l.LocationCode
                From AccessoriesManagement a, Location l
                Where a.LocationCode = l.LocationCode
                ```
            nullDisplayValue: --Select Location--
        }
        layout {
            sequence: 10
            region: @accessories-issued-but-not-fitted-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P343_SERIALNO (
        type: selectList
        label {
            label: Serial No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                Distinct
                 e.COMPONENTSERIALNO d,
                 e.TNO r
                  FROM ISSUE                 A,
                       ISSUEDETAIL           B,
                       ISSUECOSTCENTREDETAIL C,
                       COMPONENTUSEDSTOCK    D,
                       COMPONENTSTOCK        E
                 WHERE A.TNO = B.TNO
                   AND B.TNO = C.TNO
                   AND B.SNO = C.SNO
                   AND C.TNO = D.MODULETNO
                   AND C.SNO = D.MODULESNO
                   AND C.SN = D.MODULESERIALNO
                   AND D.COMPONENTSTOCKTNO = E.TNO
                ```
            nullDisplayValue: --Select List--
        }
        layout {
            sequence: 40
            region: @accessories-issued-but-not-fitted-2
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
