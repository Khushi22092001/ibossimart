        lov {
            type: sqlQuery
            sqlQuery: SELECT DISTINCT ITEMCATEGORYCODE FROM ACCESSORIESMANAGEMENT
            nullDisplayValue: -Select Type-
        }
        layout {
            sequence: 30
            region: @accessories-issued-but-not-fitted-2
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
