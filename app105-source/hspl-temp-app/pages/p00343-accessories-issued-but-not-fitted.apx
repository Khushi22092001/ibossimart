page 343 (
    name: Accessories Issued But Not Fitted
    alias: ACCESSORIES-ISSUED-BUT-NOT-FITTED
    title: Accessories Issued But Not Fitted
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region accessories-issued-but-not-fitted (
        name: Accessories Issued But Not Fitted
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                      row_number() over(order by a.LOCATIONCODE) SerialNo, 
                     -- M.LOCATIONNAME,
                       A.LOCATIONCODE,
                       GETLOCATIONNAME(A.LOCATIONCODE) AS "LOCATION NAME",
                       a.issueno,
                       a.issuedate,
                       GETITEMNAME(B.ITEMCODE) ITEMNAME,
                       getitemspecificationname(B.ITEMCODE, B.ITEMSPECIFICATIONCODE) SPECIFICATION,
                       L.ITEMMAKENAME AS MAKE,
                       K.ITEMSIZENAME AS MODEL,
                       f.Costcentrename,
                       E.COMPONENTSERIALNO,
                       GETPARTYNAME(H.PARTYCODE) AS VENDOR,
                       H.GRNNO,
                       H.GRNDATE
                  FROM ISSUE                 A,
                       ISSUEDETAIL           B,
                       ISSUECOSTCENTREDETAIL C,
                       COMPONENTUSEDSTOCK    D,
                       COMPONENTSTOCK        E,
                       COSTCENTRE            F,
                       STOCK                 G,
                       GRN                   H,
                       GRNDETAIL             I,
                       GRNSERIALNO           J,
                       ITEMSIZE              K,
                       ITEMMAKE              L--,
                   --    LOCATION              M
                
                 WHERE A.TNO = B.TNO
                   AND B.TNO = C.TNO
                   AND B.SNO = C.SNO
                   AND C.TNO = D.MODULETNO
                   AND C.SNO = D.MODULESNO
                   AND C.SN = D.MODULESERIALNO
                   AND D.COMPONENTSTOCKTNO = E.TNO
                   AND C.COSTCENTRECODE = F.COSTCENTRECODE
                   and e.stocktno = g.tno
                   AND G.GRNTNO = H.TNO
                   AND H.TNO = I.TNO(+)
                   AND B.ITEMCODE = I.ITEMCODE(+)
                   AND B.ITEMSPECIFICATIONCODE = I.ITEMSPECIFICATIONCODE
                   AND I.TNO = J.TNO(+)
                   AND I.SNO = J.SNO(+)
                   AND J.COMPANYSERIALNO = E.COMPONENTSERIALNO
                   AND J.MANUFACTUREMAKECODE = L.ITEMMAKECODE(+)
                  -- AND A.LOCATIONCODE = M.LOCATIONCODE
                   AND J.MANUFACTUREMODELCODE = K.ITEMSIZECODE(+)
                   AND NOT EXISTS (SELECT 1
                          FROM ACCESSORIESMANAGEMENT X
                         WHERE X.SERIALNO = E.COMPONENTSERIALNO)
                
                AND B.ITEMCODE LIKE NVL(:P343_ACCESSORIESTYPE,'%')
                AND A.LOCATIONCODE LIKE NVL(:P343_LOCATION,'%')
                and (E.Tno = :P343_SERIALNO or :P343_SERIALNO is null)
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                --AND E.TNO LIKE NVL(:P343_SERIALNO,'%') or :P343_SERIALNO IS NULL
                and a.locationcode is not null
                ORDER BY 1,2,3
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 193301811840282901
        }

