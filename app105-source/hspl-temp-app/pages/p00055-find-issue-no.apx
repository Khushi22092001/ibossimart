page 55 (
    name: Find Issue No
    alias: FIND-ISSUE-NO
    title: Find Issue No
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region find-issue-no (
        name: Find Issue No
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--noBorder
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
                margin-top-none
                margin-left-none
                margin-right-none
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region find-issue-no-2 (
        name: Find Issue No
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     a.ItemCode,
                     a.ItemName,
                     a.ItemSpecificationname,
                     a.Reference,
                     a.ReferenceTNo,
                     a.ReferenceNo,
                     a.UsedInModule,
                     a.ModuleNo,
                     a.Qty,
                     a.RequisitionNo
                From USEDSTOCKDETAIL_VIEW a
                Where a.ReferenceTNo = :P55_REFERENCETNO
                  and ( :P55_MATERIAL IS NULL OR instr(':'||:P55_MATERIAL||':',':'||a.ItemCode||'~'||a.ItemSpecificationCode||':') > 0 ) 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                html
                excel
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 12046940865304622
        }

