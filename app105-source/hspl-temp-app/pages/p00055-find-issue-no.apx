    pageItem P55_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'GRN'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @find-issue-no
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Company Name
        }
    )

    pageItem P55_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'GRN'
                  and a.ViewPrivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                ;
                  
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @find-issue-no
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Location Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P55_MATERIAL (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Material
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      e.ItemName||'~'||ee.ItemSpecificationName as d,
                      e.ItemCode||'~'||ee.ItemSpecificationCode as r
                From  GRNDetail g , item e, ItemSpecification ee
                Where g.ItemCode = e.ItemCode 
                  and g.ItemSpecificationcode = ee.ItemSpecificationCode 
                  and g.TNo like nvl(:P55_REFERENCETNO,0)
                Union all
                Select
                      e.ItemName||'~'||ee.ItemSpecificationName as d,
                      e.ItemCode||'~'||ee.ItemSpecificationCode as r
                From  Itemopening g , item e, ItemSpecification ee
                Where g.ItemCode = e.ItemCode 
                  and g.ItemSpecificationcode = ee.ItemSpecificationCode 
                  and g.TNo like nvl(:P55_REFERENCETNO,0)
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P55_REFERENCETNO
            itemsToSubmit: P55_MATERIAL
        }
        layout {
            sequence: 50
            region: @find-issue-no
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 72
            valuePlaceholder: Material Details
        }
    )

    pageItem P55_MODULE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Module
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: staticValues
            staticValues: STATIC2:GRN;GRN,Item Opening ;ITEMOPENING
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @find-issue-no
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Select Module
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P55_REFERENCETNO (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: ReferenceNo
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                     a.GRNNo as d,
                     a.TNo as r
                From GRN a
                Where :P55_MODULE = 'GRN'
                  and a.LocationCode = :P55_LOCATION
                
                Union all
                Select Distinct
                     io.ItemopeningNo as d,
                     io.TNo as r
                From ItemOpening io
                Where :P55_MODULE = 'ITEMOPENING'
                  and io.LocationCode = :P55_LOCATION
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P55_LOCATION
                P55_MODULE
            ]
            itemsToSubmit: P55_REFERENCETNO
        }
        layout {
            sequence: 40
            region: @find-issue-no
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Reference No
        }
        validation {
            valueRequired: true
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 60
            region: @find-issue-no
            slot: regionBody
            startNewRow: false
            column: 10
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

