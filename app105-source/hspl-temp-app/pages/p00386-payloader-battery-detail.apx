page 386 (
    name: Payloader Battery Detail
    alias: PAYLOADER-BATTERY-DETAIL
    title: Payloader Battery Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            #DEFAULT#
            t-Dialog--noPadding
        ]
    }
    dialog {
        width: 1400
        height: 800
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region payloader-battery-detail (
        name: PayLoader  Battery Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*Select
                   a.CompanyCode,
                   b.ModuleName,
                   a.IssueNo as ModuleNo,
                   a.IssueDate as ModuleDate,
                   x.EquipmentTno,
                   x.EquipmentID,
                   x.Amount as Amount,
                   lo.LocationName
                From Issue a, DocumentStatusDetail dsd,Module b,Location lo,
                (
                  Select
                         a.ModuleTno,
                         c.Tno as EquipmentTno,
                         c.EquipmentID,
                         sum(b.Amount) as Amount
                   From Voucher a, VoucherCostCentreDetail b, Equipment c
                   Where a.Tno = b.Tno
                      and b.CostCentreCode = c.CostCentreCode
                      and c.EquipmentGroupCode = 'PL'
                   Group by
                       a.ModuleTno,
                       c.Tno,
                       c.EquipmentID
                   ) x
                Where 1=1
                   and a.LocationCode = lo.LOcationCode
                   and a.Tno = x.ModuleTno
                   and a.Tno = dsd.ModuleTno
                   and b.ModuleCode = 'ISSUE'
                   and dsd.DocumentStatusCode = 'ACTIVE'
                   and exists(
                            Select
                                 aa.Tno
                            From IssueDetail aa
                            Where aa.ItemCode = 'BATTERY'
                               and aa.Tno = a.Tno
                              )
                   and exists(
                            Select
                               aa.Tno
                               From IssueStockStorageDetail aa
                               Where aa.StorageLocationCode != '291'
                               and aa.Tno = a.Tno
                              )
                   and not exists(
                                  Select
                                     aa.Tno
                                  From AccessoriesManagement aa
                                  Where aa.IssueTno = a.Tno
                  )
                  and (:P386_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                   and a.IssueDate between :P386_FROMDATE and :P386_TODATE
                   and (:P386_COMPANYCODE is Null Or Instr (':' || :P386_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                   and (:P386_EQUIPMENTID is Null Or Instr (':' || :P386_EQUIPMENTID || ':' , ':' || x.EquipmentTno || ':') > 0)
                UNION ALL
                Select 
                   a.CompanyCode,
                   c.ModuleName,
                   a.AccessoriesManagementNo as ModuleNo,
                   a.AccessoriesManagementDate as ModuleDate,
                   b.Tno as EquipmentTno,
                   b.EquipmentID,
                   a.Amount as Amount,
                   lo.LocationName
                From AccessoriesManagement a, Equipment b, Module c, Location lo
                Where a.SourceEquipmentTno = b.Tno
                and a.LocationCode = lo.LocationCode
                   and c.ModuleCode = 'ACCESSORIESMANAGEMENT'
                   and b.EquipmentGroupCode = 'PL'
                   and a.Activity = 'Fitting' 
                   and a.ItemCategoryCode = 'BATTERY'
                   and (:P386_LOCATION is null
                       or exists(
                         Select
                            aa.LocationCode
                          From PayloaderPerformanceLocation aa
                          Where aa.LocationCode = a.LocationCode
                              and aa.Creator = :APP_USER
                       )
                   )
                   and a.AccessoriesManagementDate between :P386_FROMDATE and :P386_TODATE
                   and (:P386_COMPANYCODE is Null Or Instr (':' || :P386_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                   and (:P386_EQUIPMENTID is Null Or Instr (':' || :P386_EQUIPMENTID || ':' , ':' || b.Tno || ':') > 0)
                
                */
                
                Select 
                  row_number() over(order by a.ModuleDate) SerialNo,
                  a.CompanyCode,
                  a.EquipmentTno,
                  a.EquipmentID,
                  a.ModuleName,
                  a.ModuleNo,
                  a.ModuleDate,
                  a.Amount,
                  b.LocationName
                From PayloaderExpenseTable a, Location b
                Where a.Creator = :APP_USER
                	and a.LocationCode = b.LocationCode
                	and (:P386_LOCATION is null
                		or exists(
                			 Select
                				aa.LocationCode
                			  From PayloaderPerformanceLocation aa
                			  Where aa.LocationCode = a.LocationCode
                				  and aa.Creator = :APP_USER
                			)
                		)
                	and a.Categories = 'BATTERY'
                	and a.ModuleDate between :P386_FROMDATE and :P386_TODATE
                	and (:P386_COMPANYCODE is Null Or Instr (':' || :P386_COMPANYCODE || ':' , ':' || a.CompanyCode || ':') > 0)
                	and (:P386_EQUIPMENTID is Null Or Instr (':' || :P386_EQUIPMENTID || ':' , ':' || a.EquipmentTno || ':') > 0)
                
                ```
        }
        layout {
            sequence: 70
            slot: contentBody
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: abc
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 778809721024244178
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Companycode
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EQUIPMENTID (
            type: plainText
            heading {
                heading: Equipment  ID
                alignment: center
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column EQUIPMENTTNO (
            type: plainText
            heading {
                heading: Equipmenttno
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: S
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Location Name
                alignment: center
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AA
            }
        )

        column MODULEDATE (
            type: plainText
            heading {
                heading: Module Date
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: Y
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: Module Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Module No
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: X
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AB
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Open Billed Detail
        }

        savedReport 1102245 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 7
            )

            displayColumn EQUIPMENTID (
                sequence: 6
            )

            displayColumn LOCATIONNAME (
                sequence: 2
            )

            displayColumn MODULEDATE (
                sequence: 5
            )

            displayColumn MODULENAME (
                sequence: 3
            )

            displayColumn MODULENO (
                sequence: 4
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: QUANTITY1
            )

        )

    )

    pageItem P386_COMPANYCODE (
        type: hidden
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P386_EQUIPMENTID (
        type: hidden
        layout {
            sequence: 50
            slot: contentBody
        }
    )

    pageItem P386_FROMDATE (
        type: hidden
        layout {
            sequence: 10
            slot: contentBody
        }
    )

    pageItem P386_LOCATION (
        type: hidden
        layout {
            sequence: 60
            slot: contentBody
        }
    )

    pageItem P386_TODATE (
        type: hidden
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

