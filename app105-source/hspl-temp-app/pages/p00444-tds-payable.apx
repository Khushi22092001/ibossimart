    }

    region tds-payable (
        name: "TDS Payable "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region tds-payble (
        name: TDS PAYBLE
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 SELECT 
                    row_number() over(order by B.VOUCHERDATE) SerialNo,
                    CO.COMPANYNAME,
                    B.LOCATIONCODE,
                    B.DOCTYPECODE,
                    B.MODULECODE,
                    A.PARTYCODE,
                    B.VOUCHERNO,
                    B.VOUCHERDATE,
                    NULL AS ITEMNATUREONWHICHTDSDEDECTABLE,
                    A.TDSPAYEECATEGORYCODE,
                    NULL AS TDSDEDUCTABLERATE,
                    F.TAXSECTIONCODE,
                    GETPARTYNAME(A.PARTYCODE) AS PARTY,
                    A.PANNO,
                    DECODE(H.ISCOMPANY, 'YES', 'COMPANY', NULL) ISCOMPANY,
                    F.TDSNATURENAME,
                    ROUND(A.TDSDEDUCTEDON,2) AS BASICAMOUNT,
                    A.TDSPERCENT,
                    A.TDSAMOUNT,
                    A.CESSPERCENT,
                    A.CESSAMOUNT,
                    A.SURCHARGEPERCENT,
                    A.SURCHARGEAMOUNT,
                    CHLN.CHALLANNO AS CHALLANNO,
                    CHLN.CHALLANDATE AS CHALLANDATE,
                    CHLN.BSRCODE AS CHALLANBSRCODE,
                    CHLN.CHALLANAMOUNT AS CHALLANAMOUNT,
                    CASE
                      WHEN C.JBPASSNO IS NOT NULL THEN
                       'JBPASS'
                      WHEN D.EXTERNALSERVICESENTRYNO IS NOT NULL THEN
                       'EXTERNAL SERVICE ENTRY '
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       'PAYMENT ADVICE'
                    END TRANSACTIONMODULE,
                    CASE
                      WHEN C.JBPASSNO IS NOT NULL THEN
                       C.JBPASSNO
                      WHEN D.EXTERNALSERVICESENTRYNO IS NOT NULL THEN
                       D.EXTERNALSERVICESENTRYNO
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       E.PAYMENTADVICENO
                    END TRANSACTIONNO,
                    CASE
                      WHEN C.JBPASSNO IS NOT NULL THEN
                       C.JBPASSDATE
                      WHEN D.EXTERNALSERVICESENTRYNO IS NOT NULL THEN
                       D.EXTERNALSERVICESENTRYDATE
                      WHEN E.PAYMENTADVICENO IS NOT NULL THEN
                       E.PAYMENTADVICEDATE
                    END TRANSACTIONDATE,
                    C.JBPASSNO,
                    D.EXTERNALSERVICESENTRYNO,
                    E.PAYMENTADVICENO
                  FROM VOUCHERTDSDEDUCTED    A,
                       VOUCHER               B,
                       JBPASS                C,
                       EXTERNALSERVICESENTRY D,
                       PAYMENTADVICE         E,
                       TDSNATURE             F,
                       TDSTAXCATEGORY        G,
                       PARTY                 H,
                       COMPANY               CO,
                       (SELECT A.CHALLANNO,
                               A.CHALLANDATE,
                               E.BSRCODE,
                               D.MODULETNO,
                               A.CHALLANAMOUNT
                          FROM CHALLAN                  A,
                               TDSCHALLAN               C,
                               TDSCHALLANDEDUCTEEDETAIL D,
                               BANK                     E
                         WHERE  A.DOCTYPECODE = 'TDSCHALLAN'
                           AND A.MODULETNO = C.TNO
                           AND C.TNO = D.TNO
                           AND A.TAXSECTIONCODE = D.TAXSECTIONCODE
                           AND A.DEPOSITEDINBANKCODE = E.BANKCODE
                       ) CHLN,
                       (
                          Select
                                a.Tno
                         From Voucher a
                         Where exists(
                                     Select
                                        aa.Tno
                                     From VoucherDetail aa, TDSNature bb
                                     Where aa.AccountCode = bb.TDSAccountCode
                                       and aa.Tno = a.Tno
                                     )) x
                 WHERE A.TNO = B.TNO(+)
                   AND B.MODULETNO = C.TNO(+)
                   AND B.MODULETNO = D.TNO(+)
                   AND B.MODULETNO = E.TNO(+)
                   AND A.TDSNATURECODE = F.TDSNATURECODE(+)
                   AND A.TDSTAXCATEGORYCODE = G.TDSTAXCATEGORYCODE(+)
                   AND A.PARTYCODE = H.PARTYCODE(+)
                   AND B.COMPANYCODE = CO.COMPANYCODE(+)
                   AND B.MODULETNO = CHLN.MODULETNO(+)
                   AND A.TNO = X.TNO
                   and ( :P444_COMPANY IS NULL OR instr(':'||:P444_COMPANY||':',':'||CO.CompanyCode||':') > 0 )
                    --  and TO_CHAR(TO_DATE(b.VoucherDate),('MON-RRRR')) = :P443_MONTH
                 --  And TO_DATE(TO_CHAR(b.VoucherDate,'DD-MM-RRRR')) between LAST_DAY(TO_DATE('01-' || NVL(:P444_FROMDATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))) and TO_DATE('01-' || NVL(:P444_TODATE, TO_CHAR(TRUNC(SYSDATE), 'DD-MM-RRRR')))
                 --  and B.ModuleCode like nvl(:P444_MODULECODE,'%')
                 --  and TO_CHAR(b.VoucherDate,'MON-RR') = TO_CHAR(:P444_MONTH,'MON-RR')
                 --  and To_Char(b.VoucherDate, 'MON-RR')   = :P444_MONTH
                   and b.voucherdate between nvl(:P444_FROMDATE,sysdate) AND nvl(:P444_TODATE, sysdate)
                   and ( :P444_SECTION IS NULL OR instr(':'||:P444_SECTION||':',':'||F.TAXSECTIONCODE||':') > 0 )
                   and ( :P444_TDSNATURE IS NULL OR instr(':'||:P444_TDSNATURE||':',':'||F.TDSNATURECODE||':') > 0 )
                   and ( :P444_PARTY IS NULL OR instr(':'||:P444_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                   and :P444_MONTH is not null
                ```
            pageItemsToSubmit: [
                P444_COMPANY
                P444_FROMDATE
                P444_TODATE
                P444_PARTY
                P444_SECTION
                P444_TDSNATURE
            ]
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
