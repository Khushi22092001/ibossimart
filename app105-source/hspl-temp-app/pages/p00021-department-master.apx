page 21 (
    name: Department Master
    alias: DEPARTMENT-MASTER
    title: Department Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script type="text/javascript">
                    function Export() {
                        html2canvas(document.getElementById("PDF"), {
                            onrendered: function (canvas) {
                                var data = canvas.toDataURL();
                                var docDefinition = {
                                    content: [{
                                        image: data,
                                        width: 500
                                    }]
                                };
                                pdfMake.createPdf(docDefinition).download("Table.pdf");
                            }
                        });
                    }
                </script>
            ```
    }
    security {
        formAutoComplete: false
    }

    region department-report (
        name: DEPARTMENT REPORT
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                     ROWNUM AS SERIALNO,
                     a.DepartmentCode,
                     a.DepartmentName,
                     a.DepartmentShortName,
                     dd.DepartmentName as subDepartment
                From Department a, Department dd
                Where a.departmentCode = dd.ParentCode(+)
                Order by 2
                ```
        }
        layout {
            sequence: 30
            parentRegion: @region-display-selector
            slot: subRegions
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            saveReport: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 50246857034312976
        }

        column DEPARTMENTCODE (
            type: plainText
            heading {
                heading: DEPARTMENT CODE
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column DEPARTMENTNAME (
            type: plainText
            heading {
                heading: DEPARTMENT NAME
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column DEPARTMENTSHORTNAME (
            type: plainText
            heading {
                heading: DEPARTMENT SHORT NAME
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: SERIAL NO
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column SUBDEPARTMENT (
            type: plainText
            heading {
                heading: SUB DEPARTMENT
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: DEPARTMENT REPORT
        }

        savedReport 37408 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEPARTMENTCODE (
                sequence: 2
            )

            displayColumn DEPARTMENTNAME (
                sequence: 3
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SUBDEPARTMENT (
                sequence: 4
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: DEPARTMENTNAME
                sort {
                    sequence: 2
                }
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region department-tree (
        name: DEPARTMENT TREE
        type: tree
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                     DEPARTMENTNAME,
                     DEPARTMENTCODE,
                     PARENTCODE
                FROM DEPARTMENT
                ```
        }
        layout {
            sequence: 20
            parentRegion: @region-display-selector
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: PDF
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText:
                ```html
                <input type="button" id="btnExport" value="ExportPDF" onclick="Export()" />
                    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
                    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>
                ```
        }
        settings {
            nodeLabelColumn: DEPARTMENTNAME
            nodeIdColumn: DEPARTMENTCODE
            parentKeyColumn: PARENTCODE
            defaultIconCssClass: icon-tree-folder
            iconTypeCssClass: a-Icon
        }
        performance {
            lazyLoading: true
        }
    )

    region region-display-selector (
        name: Region Display Selector
        type: regionDisplaySelector
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--scrollBody
            ]
        }
        settings {
            includeShowAll: false
            rememberSelection: bySession
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

