    region kpi-strip (
        name: Sales Pulse KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P653_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P653_TODATE,'DD-MM-RRRR')   T
                         From dual),
                Prv As (
                       Select F - (T - F + 1) PF, F - 1 PT From Win),
                -- Footer pre-aggregated to (Tno,Sno): the four taxes per line.
                Tax As (
                       Select TNo, SNo,
                              Sum(Decode(FooterHeadCode,'.CGST.',FooterValue,
                                         '.SGST.',FooterValue,'.IGST.',FooterValue,
                                         '.TCS.', FooterValue,0)) LineTax
                         From CCInvoiceDetailFooter
                        Group By TNo, SNo),
                -- CURRENT-PERIOD LINES — the value grain. LEFT JOIN keeps header-only
                -- invoices (so the invoice count matches the register); SUM ignores nulls.
                Cur As (
                       Select a.TNo, a.PartyCode, a.LocationCode, a.CCInvoiceDate,
                              b.SNo, b.ItemCode, b.Quantity1,
                              b.Amount, b.TotalAmount, nvl(tx.LineTax,0) LineTax
                         From CCInvoice a
                         Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                         Left Join CCInvoiceDetail b On b.TNo = a.TNo
                         Left Join Tax tx On tx.TNo = b.TNo And tx.SNo = b.SNo
                        Where a.CCInvoiceDate >= (Select F From Win)
                          And a.CCInvoiceDate <  (Select T From Win) + 1
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (
                              :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                          )
                          And (
                              :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                          )
                          And (
                              :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                          )
                          And (
                              :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                          )
                          And (
                              :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                          )
                          And (
                              :P653_TRANSPORTER Is Null Or a.TransporterCode = :P653_TRANSPORTER
                          )
                          And (
                              :P653_VEHICLENO   Is Null Or a.VehicleNo = :P653_VEHICLENO
                          )
                          And (
                              :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                          )
                          And (
                              :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                          )
                          And (
                              :P653_ITEM     Is Null Or b.ItemCode = :P653_ITEM
                          )
                          And (
                              :P653_ITEMSPEC Is Null Or b.ItemSpecificationCode = :P653_ITEMSPEC
                          )
                          And (:P653_ITEMGROUP Is Null Or b.ItemCode In
                                 (Select ItemCode From Item
                                   Start With ItemCode = :P653_ITEMGROUP
                                 Connect By Prior ItemCode = ParentCode))
                           And (:P653_CATEGORY Is Null Or b.ItemCode In (Select ic.ItemCode From Item ic Where ic.ItemCategoryCode = :P653_CATEGORY))
                          And (:P653_STATUS Is Null Or Exists
                                 (Select 1 From DocumentStatusDetail dsd
                                   Where dsd.ModuleTNo = a.TNo
                                     And dsd.DocumentStatusCode = :P653_STATUS))),
                -- PRIOR-PERIOD LINES — same scope, immediately preceding window.
                Prev As (
                       Select a.TNo, a.PartyCode, b.Amount, b.TotalAmount
                         From CCInvoice a
                         Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                         Left Join CCInvoiceDetail b On b.TNo = a.TNo
                        Where a.CCInvoiceDate >= (Select PF From Prv)
                          And a.CCInvoiceDate <  (Select PT From Prv) + 1
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (
                              :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                          )
                          And (
                              :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                          )
                          And (
                              :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                          )
                          And (
                              :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                          )
                          And (
                              :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                          )
                          And (
                              :P653_TRANSPORTER Is Null Or a.TransporterCode = :P653_TRANSPORTER
                          )
                          And (
                              :P653_VEHICLENO   Is Null Or a.VehicleNo = :P653_VEHICLENO
                          )
                          And (
                              :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                          )
                          And (
                              :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                          )
                          And (
                              :P653_ITEM     Is Null Or b.ItemCode = :P653_ITEM
                          )
                          And (
                              :P653_ITEMSPEC Is Null Or b.ItemSpecificationCode = :P653_ITEMSPEC
                          )
                          And (:P653_ITEMGROUP Is Null Or b.ItemCode In
                                 (Select ItemCode From Item
                                   Start With ItemCode = :P653_ITEMGROUP
                                 Connect By Prior ItemCode = ParentCode))
                           And (:P653_CATEGORY Is Null Or b.ItemCode In (Select ic.ItemCode From Item ic Where ic.ItemCategoryCode = :P653_CATEGORY))),
                Agg As (
                       Select Sum(Amount) Val, Sum(TotalAmount) Inv, Sum(LineTax) Tax,
                              Count(SNo) Lines, Count(Distinct TNo) Invoices,
                              Count(Distinct ItemCode) Items,
                              Count(Distinct PartyCode) Parties,
                              Count(Distinct LocationCode) Locs,
                              Sum(Quantity1) Qty
                         From Cur),
                PrvAgg As (
                       Select Sum(Amount) Val, Sum(TotalAmount) Inv,
                              Count(Distinct TNo) Invoices,
                              Count(Distinct PartyCode) Parties
                         From Prev),
                -- DAILY roll-up for the sparklines (cards 1-3). Daily (not monthly)
                -- so even a short period draws a real up-and-down line instead of a
                -- single flat point.
                SparkM As (
                       Select Trunc(CCInvoiceDate,'DD') mn,
                              Sum(Amount) val, Sum(TotalAmount) inv,
                              Count(Distinct TNo) invs
                         From Cur Group By Trunc(CCInvoiceDate,'DD')),
                SparkSV As (
                       Select Case When Pts Is Null Then ''
                            Else '<svg class="ds-spark ds-spark--gold" viewBox="0 0 100 36" '
                              || 'preserveAspectRatio="none" aria-hidden="true">'
                              || '<polygon class="ds-spark-fill" points="0,36 ' || Pts || ' 100,36"/>'
                              || '<polyline class="ds-spark-line" points="' || Pts || '"/>'
                              || '</svg>' End Svg
                         From (Select Listagg(px||','||py, ' ') Within Group (Order By rn) Pts
                                 From (Select Round((rn-1)*100/Greatest(cnt-1,1)) px,
                                              Round(33 - (v-lo)*30/Greatest(hi-lo,1)) py, rn
                                         From (Select val v, Row_Number() Over(Order By mn) rn,
                                                      Count(*) Over() cnt,
                                                      Min(val) Over() lo, Max(val) Over() hi
                                                 From SparkM)))),
                SparkIV As (
                       Select Case When Pts Is Null Then ''
                            Else '<svg class="ds-spark ds-spark--blue" viewBox="0 0 100 36" '
                              || 'preserveAspectRatio="none" aria-hidden="true">'
                              || '<polygon class="ds-spark-fill" points="0,36 ' || Pts || ' 100,36"/>'
                              || '<polyline class="ds-spark-line" points="' || Pts || '"/>'
                              || '</svg>' End Svg
                         From (Select Listagg(px||','||py, ' ') Within Group (Order By rn) Pts
                                 From (Select Round((rn-1)*100/Greatest(cnt-1,1)) px,
                                              Round(33 - (v-lo)*30/Greatest(hi-lo,1)) py, rn
                                         From (Select inv v, Row_Number() Over(Order By mn) rn,
                                                      Count(*) Over() cnt,
                                                      Min(inv) Over() lo, Max(inv) Over() hi
                                                 From SparkM)))),
                SparkNI As (
                       Select Case When Pts Is Null Then ''
                            Else '<svg class="ds-spark ds-spark--blue" viewBox="0 0 100 36" '
                              || 'preserveAspectRatio="none" aria-hidden="true">'
                              || '<polygon class="ds-spark-fill" points="0,36 ' || Pts || ' 100,36"/>'
                              || '<polyline class="ds-spark-line" points="' || Pts || '"/>'
                              || '</svg>' End Svg
                         From (Select Listagg(px||','||py, ' ') Within Group (Order By rn) Pts
                                 From (Select Round((rn-1)*100/Greatest(cnt-1,1)) px,
                                              Round(33 - (v-lo)*30/Greatest(hi-lo,1)) py, rn
                                         From (Select invs v, Row_Number() Over(Order By mn) rn,
                                                      Count(*) Over() cnt,
                                                      Min(invs) Over() lo, Max(invs) Over() hi
                                                 From SparkM))))
                Select
                  -- 1. TOTAL SALES VALUE --------------------------------------------
                  '<div class="ds-kpi ds-kpi--value" title="SUM(CCInvoiceDetail.Amount) — '
                  || 'taxable line value; reconciles to the CC Invoice Register.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-inr"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Total Sales Value</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(a.Val,0) >= 10000000
                             Then 'Rs ' || to_char(Round(a.Val/10000000,2),'FM99G990D00') || ' Cr'
                             When nvl(a.Val,0) >= 100000
                             Then 'Rs ' || to_char(Round(a.Val/100000,2),'FM99G990D00') || ' L'
                             Else 'Rs ' || to_char(nvl(a.Val,0),'FM99G99G990D00') End
                     || '</span><span class="ds-kpi-sub">'
                     || Case When nvl(pa.Val,0) = 0
                             Then '<span class="ds-delta ds-delta--flat">No prior period</span>'
                             When a.Val > pa.Val
                             Then '<span class="ds-delta ds-delta--up">&uarr; '
                                  || to_char(Round(100*(a.Val-pa.Val)/pa.Val,1),'FM99999990D0') || '%</span>'
                             When a.Val < pa.Val
                             Then '<span class="ds-delta ds-delta--down">&darr; '
                                  || to_char(Round(100*(pa.Val-a.Val)/pa.Val,1),'FM99999990D0') || '%</span>'
                             Else '<span class="ds-delta ds-delta--flat">no change</span>' End
                     || ' &middot; ' || to_char(nvl(a.Lines,0),'FM999G999') || ' lines'
                  || '</span></span>' || sv.Svg || '</div>' As KPI1,
                  -- 2. TOTAL INVOICE VALUE ------------------------------------------
                  '<div class="ds-kpi ds-kpi--bill" title="SUM(CCInvoiceDetail.TotalAmount) — '
                  || 'sales value plus all footer taxes/charges.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-file-text-o"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Total Invoice Value</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(a.Inv,0) >= 10000000
                             Then 'Rs ' || to_char(Round(a.Inv/10000000,2),'FM99G990D00') || ' Cr'
                             When nvl(a.Inv,0) >= 100000
                             Then 'Rs ' || to_char(Round(a.Inv/100000,2),'FM99G990D00') || ' L'
                             Else 'Rs ' || to_char(nvl(a.Inv,0),'FM99G99G990D00') End
                     || '</span><span class="ds-kpi-sub">'
                     || Case When nvl(pa.Inv,0) = 0
                             Then '<span class="ds-delta ds-delta--flat">No prior period</span>'
                             When a.Inv > pa.Inv
                             Then '<span class="ds-delta ds-delta--up">&uarr; '
                                  || to_char(Round(100*(a.Inv-pa.Inv)/pa.Inv,1),'FM99999990D0') || '%</span>'
                             When a.Inv < pa.Inv
                             Then '<span class="ds-delta ds-delta--down">&darr; '
                                  || to_char(Round(100*(pa.Inv-a.Inv)/pa.Inv,1),'FM99999990D0') || '%</span>'
                             Else '<span class="ds-delta ds-delta--flat">no change</span>' End
                     || ' &middot; value plus tax</span></span>' || iv.Svg || '</div>' As KPI2,
                  -- 3. TOTAL INVOICES (drills to the register) ----------------------
                  '<a class="ds-kpi ds-kpi--input ds-kpi--link" href="'
                  || apex_page.get_url(p_page => 56, p_clear_cache => '56',
                       p_items  => 'P56_FROMDATE,P56_TODATE,P56_COMPANY,P56_LOCATION',
                       p_values => :P653_FROMDATE ||','|| :P653_TODATE ||','|| :P653_COMPANY ||','|| :P653_LOCATION)
                  || '" title="COUNT(DISTINCT CCInvoice.TNo) in the period.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-list-alt"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Total Invoices</span>'
                  || '<span class="ds-kpi-n">' || to_char(nvl(a.Invoices,0),'FM999G999G999') || '</span>'
                  || '<span class="ds-kpi-sub">'
                     || Case When nvl(pa.Invoices,0) = 0
                             Then '<span class="ds-delta ds-delta--flat">No prior period</span>'
                             When a.Invoices > pa.Invoices
                             Then '<span class="ds-delta ds-delta--up">&uarr; '
                                  || to_char(Round(100*(a.Invoices-pa.Invoices)/pa.Invoices,1),'FM99999990D0') || '%</span>'
                             When a.Invoices < pa.Invoices
                             Then '<span class="ds-delta ds-delta--down">&darr; '
                                  || to_char(Round(100*(pa.Invoices-a.Invoices)/pa.Invoices,1),'FM99999990D0') || '%</span>'
                             Else '<span class="ds-delta ds-delta--flat">no change</span>' End
                     || ' &middot; open the register</span></span>' || ni.Svg || '</a>' As KPI3,
                  -- 4. AVERAGE INVOICE VALUE ----------------------------------------
                  '<div class="ds-kpi ds-kpi--struct" title="Total invoice value divided by '
                  || 'distinct invoices.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-calculator"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Average Invoice Value</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(a.Invoices,0) = 0 Then 'Rs 0'
                             Else Case When a.Inv/a.Invoices >= 10000000
                                       Then 'Rs ' || to_char(Round(a.Inv/a.Invoices/10000000,2),'FM99G990D00') || ' Cr'
                                       When a.Inv/a.Invoices >= 100000
                                       Then 'Rs ' || to_char(Round(a.Inv/a.Invoices/100000,2),'FM99G990D00') || ' L'
                                       Else 'Rs ' || to_char(Round(a.Inv/a.Invoices),'FM99G99G990') End
                        End
                     || '</span><span class="ds-kpi-sub">across '
                     || to_char(nvl(a.Invoices,0),'FM999G999') || ' invoices</span></span></div>' As KPI4,
                  -- 5. BILLED CUSTOMERS ---------------------------------------------
                  '<a class="ds-kpi ds-kpi--users ds-kpi--link" href="'
                  || apex_page.get_url(p_page => 655, p_clear_cache => '655',
                       p_items  => 'P655_FROMDATE,P655_TODATE,P655_COMPANY,P655_LOCATION,P655_PANEL',
                       p_values => :P653_FROMDATE ||','|| :P653_TODATE ||','|| :P653_COMPANY ||','|| :P653_LOCATION ||','|| :P653_PANEL)
                  || '" title="COUNT(DISTINCT CCInvoice.PartyCode) in the period.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-users"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Billed Customers</span>'
                  || '<span class="ds-kpi-n">' || to_char(nvl(a.Parties,0),'FM999G999') || '</span>'
                  || '<span class="ds-kpi-sub">'
                     || Case When nvl(pa.Parties,0) = 0
                             Then '<span class="ds-delta ds-delta--flat">No prior period</span>'
                             When a.Parties > pa.Parties
                             Then '<span class="ds-delta ds-delta--up">&uarr; '
                                  || to_char(Round(100*(a.Parties-pa.Parties)/pa.Parties,1),'FM99999990D0') || '%</span>'
                             When a.Parties < pa.Parties
                             Then '<span class="ds-delta ds-delta--down">&darr; '
                                  || to_char(Round(100*(pa.Parties-a.Parties)/pa.Parties,1),'FM99999990D0') || '%</span>'
                             Else '<span class="ds-delta ds-delta--flat">no change</span>' End
                     || ' &middot; distinct parties invoiced</span></span></a>' As KPI5,
                  -- 6. SELLING LOCATIONS --------------------------------------------
                  '<div class="ds-kpi ds-kpi--move" title="COUNT(DISTINCT CCInvoice.LocationCode).">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-map-marker"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Selling Locations</span>'
                  || '<span class="ds-kpi-n">' || to_char(nvl(a.Locs,0),'FM999G999') || '</span>'
                  || '<span class="ds-kpi-sub">locations that raised an invoice</span></span></div>' As KPI6,
                  -- 7. ITEMS SOLD / INVOICE LINES -----------------------------------
                  '<a class="ds-kpi ds-kpi--suppl ds-kpi--link" href="'
                  || apex_page.get_url(p_page => 656, p_clear_cache => '656',
                       p_items  => 'P656_FROMDATE,P656_TODATE,P656_COMPANY,P656_LOCATION,P656_PANEL',
                       p_values => :P653_FROMDATE ||','|| :P653_TODATE ||','|| :P653_COMPANY ||','|| :P653_LOCATION ||','|| :P653_PANEL)
                  || '" title="Invoice lines (headline), distinct items and primary-unit '
                  || 'quantity — the three legitimate readings of &quot;items sold&quot;.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-cubes"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Items Sold &middot; Invoice Lines</span>'
                  || '<span class="ds-kpi-n">' || to_char(nvl(a.Lines,0),'FM999G999G999') || '</span>'
                  || '<span class="ds-kpi-sub">' || to_char(nvl(a.Items,0),'FM999G999')
                     || ' distinct items &middot; ' || to_char(nvl(a.Qty,0),'FM999G999G990')
                     || ' qty (primary UOM)</span></span></a>' As KPI7,
                  -- 8. TOTAL TAX ----------------------------------------------------
                  '<div class="ds-kpi ds-kpi--freight" title="SUM(CGST+SGST+IGST+TCS) from the '
                  || 'footer pre-aggregate.">'
                  || '<span class="ds-kpi-ic"><span class="fa fa-percent"></span></span>'
                  || '<span class="ds-kpi-body"><span class="ds-kpi-t">Total Tax</span>'
                  || '<span class="ds-kpi-n">'
                     || Case When nvl(a.Tax,0) >= 10000000
                             Then 'Rs ' || to_char(Round(a.Tax/10000000,2),'FM99G990D00') || ' Cr'
                             When nvl(a.Tax,0) >= 100000
                             Then 'Rs ' || to_char(Round(a.Tax/100000,2),'FM99G990D00') || ' L'
                             Else 'Rs ' || to_char(nvl(a.Tax,0),'FM99G99G990D00') End
                     || '</span><span class="ds-kpi-sub">'
                     || Case When nvl(a.Val,0) > 0
                             Then to_char(Round(100*nvl(a.Tax,0)/a.Val,1),'FM99999990D0') || '% of sales value'
                             Else 'no sales value in period' End
                     || '</span></span></div>' As KPI8
                From Agg a
                Cross Join PrvAgg pa
                Cross Join SparkSV sv
                Cross Join SparkIV iv
                Cross Join SparkNI ni
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
                P653_PARTY
                P653_AGENT
