    region agent-chart (
        name: Sales by Agent
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select AGENT_NAME, VALUE_LAC From (
                  Select nvl(GetPartyName(so.AgentCode),'Agent not recorded') AGENT_NAME,
                         Round(Sum(b.Amount)/100000,2) VALUE_LAC
                    From CCInvoice a
                    Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                    Join CCInvoiceDetail b On b.TNo = a.TNo
                   Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                     And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (
                         :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                     )
                     And (
                         :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                     )
                     And (
                         :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                     )
                     And (
                         :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                     )
                     And (
                         :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                     )
                     And (
                         :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                     )
                     And (
                         :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                     )
                     And (
                         :P653_ITEM     Is Null Or b.ItemCode = :P653_ITEM
                     )
                     And (:P653_ITEMGROUP Is Null Or b.ItemCode In
                            (Select ItemCode From Item Start With ItemCode = :P653_ITEMGROUP
                           Connect By Prior ItemCode = ParentCode))
                           And (:P653_CATEGORY Is Null Or b.ItemCode In (Select ic.ItemCode From Item ic Where ic.ItemCategoryCode = :P653_CATEGORY))
                   Group By so.AgentCode
                  Having Sum(b.Amount) > 0
                   Order By Sum(b.Amount) Desc)
                 Where Rownum <= 12
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
                P653_PARTY
                P653_AGENT
                P653_TRADETYPE
                P653_ITEMGROUP
                P653_ITEM
            ]
        }
        layout {
            sequence: 90
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 300
        }
        messages {
            whenNoDataFound: No agent-attributed sales in this period and scope.
        }

        series agt (
            name: Sales Value (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: AGENT_NAME
                value: VALUE_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region category-mix (
        name: Sales by Item Category
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Item Category is an HSPL master dimension. Sales value by category for the
                   selected period/scope; a slice drills the dashboard to that category. */
                Select CATEGORY, CATCODE, VALUE_LAC
                  From (Select Case When i.ItemCategoryCode Is Null Then 'Uncategorised'
                                    Else nvl(GetItemCategoryName(i.ItemCategoryCode), i.ItemCategoryCode) End CATEGORY,
                               nvl(i.ItemCategoryCode,'') CATCODE,
                               Round(Sum(b.Amount)/100000,2) VALUE_LAC
                          From CCInvoice a
                          Join CCInvoiceDetail b On b.TNo = a.TNo
                          Left Join Item i On i.ItemCode = b.ItemCode
                         Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                           And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                           And ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                           And (:P653_PANEL    Is Null Or a.Panel        = :P653_PANEL)
                           And (:P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY)
                           And (:P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION)
                           And (:P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE)
                         Group By i.ItemCategoryCode
                        Having Sum(b.Amount) > 0)
                 Order By VALUE_LAC Desc
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
            ]
        }
        layout {
            sequence: 84
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 320
        }
        value {
            format: decimal
            decimalPlaces: 2
            formatScaling: none
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No sales value by category in this scope.
        }

        series cat (
            name: Sales (₹ Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: CATEGORY
                value: VALUE_LAC
            }
            link {
                type: redirectThisApp
                target: {
                    page: 653
                    items: {
                        P653_CATEGORY: &CATCODE.
                        P653_FROMDATE: &P653_FROMDATE.
                        P653_TODATE: &P653_TODATE.
                        P653_COMPANY: &P653_COMPANY.
                        P653_LOCATION: &P653_LOCATION.
                        P653_PANEL: &P653_PANEL.
                    }
                }
            }
        )

    )

    region command-header (
        name: Sales Command Centre
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-sales-hero">'
                  || '<div class="ds-sales-hero-row">'
                  || '<span class="ds-sales-hero-icon"><span class="fa fa-line-chart"></span></span>'
                  || '<span class="ds-sales-hero-text">'
                  || '<span class="ds-sales-hero-eyebrow">Commercial &middot; Sales Intelligence</span>'
                  || '<span class="ds-sales-hero-title">Sales Command Centre</span>'
                  || '<span class="ds-sales-hero-sub">The period position across the commercial '
                  || 'book — revenue, invoices, customers, product and channel mix, tax and '
                  || 'commercial exceptions. Every figure reconciles to the CC Invoice '
                  || '(Sales) Register.</span>'
                  || '</span></div>'
                  || '<a class="ds-sales-hero-cta" href="' || apex_page.get_url(
                       p_page        => 56,
                       p_clear_cache => '56',
                       p_items       => 'P56_FROMDATE,P56_TODATE,P56_COMPANY,P56_LOCATION',
                       p_values      =>    :P653_FROMDATE ||','|| :P653_TODATE
                                    ||','|| :P653_COMPANY  ||','|| :P653_LOCATION)
                     || '">CC Invoice Register <span class="fa fa-arrow-right"></span></a>'
                  || '<div class="ds-sales-hero-art"></div>'
                  || '<div class="ds-sales-hero-chips">'
                  || '<span class="ds-chip"><span class="fa fa-calendar ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Period</span><b>'
                     || apex_escape.html(:P653_FROMDATE) || ' &ndash; '
                     || apex_escape.html(:P653_TODATE) || '</b>'
                     || '<i class="ds-chip-sub">'
                     || to_char(to_date(:P653_TODATE,'DD-MM-RRRR')
                             - to_date(:P653_FROMDATE,'DD-MM-RRRR') + 1) || ' days</i></span>'
                  || '<span class="ds-chip"><span class="fa fa-building-o ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Company</span><b>'
                     || apex_escape.html(nvl(GetCompanyName(:P653_COMPANY),'All companies'))
                     || '</b></span>'
                  || '<span class="ds-chip"><span class="fa fa-map-marker ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Location</span><b>'
                     || apex_escape.html(nvl(GetLocationName(:P653_LOCATION),'All locations'))
                     || '</b></span>'
                  || Case
                       When (Select GetUserPanelAB_apex() From dual) Is Not Null
                       Then '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                            || '<span class="ds-chip-k">Panel</span><b>'
                            || apex_escape.html((Select GetUserPanelAB_apex() From dual))
                            || ' (enforced)</b></span>'
                       Else '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                            || '<span class="ds-chip-k">Panel</span><b>'
                            || apex_escape.html(nvl(:P653_PANEL,'A + B')) || '</b></span>'
                     End
                  || Case When :P653_PARTY Is Not Null
                          Then '<span class="ds-chip"><span class="fa fa-user-o ds-chip-ic"></span>'
                               || '<span class="ds-chip-k">Customer</span><b>'
                               || apex_escape.html(GetPartyName(:P653_PARTY)) || '</b></span>'
                          Else '' End
                  || Case When :P653_ITEM Is Not Null
                          Then '<span class="ds-chip"><span class="fa fa-cube ds-chip-ic"></span>'
                               || '<span class="ds-chip-k">Item</span><b>'
                               || apex_escape.html(:P653_ITEM) || '</b></span>'
                          Else '' End
                  || '<span class="ds-chip ds-chip--live"><span class="fa fa-calendar-check-o ds-chip-ic"></span>'
                     || '<span class="ds-chip-k">Invoices as of</span><b>'
                     || apex_escape.html(nvl(to_char(
                          (Select Max(a.CCInvoiceDate) From CCInvoice a
                            Where ((Select GetUserPanelAB_apex() From dual) Is Null
                                   Or a.Panel = (Select GetUserPanelAB_apex() From dual))),
                          'DD-Mon-RRRR'),'no invoices visible'))
                     || '</b></span>'
                  || '</div></div>' As HEAD
                From dual
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_PARTY
                P653_ITEM
            ]
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-sales-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Header unavailable.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region customer-chart (
        name: Top 10 Customers by Sales
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select CUST_NAME, PARTY_CODE, VALUE_LAC
                  From (Select GetPartyName(a.PartyCode) CUST_NAME, a.PartyCode PARTY_CODE,
                               Round(Sum(b.Amount)/100000,2) VALUE_LAC
                          From CCInvoice a
                          Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                          Join CCInvoiceDetail b On b.TNo = a.TNo
                         Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                           And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                           And ((Select GetUserPanelAB_apex() From dual) Is Null
                                Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                           And (
                               :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                           )
                           And (
                               :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                           )
                           And (
                               :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                           )
                           And (
                               :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                           )
                           And (
                               :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                           )
                           And (
                               :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                           )
                           And (
                               :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                           )
                           And (
                               :P653_ITEM     Is Null Or b.ItemCode = :P653_ITEM
                           )
                           And (:P653_ITEMGROUP Is Null Or b.ItemCode In
                                  (Select ItemCode From Item Start With ItemCode = :P653_ITEMGROUP
                                 Connect By Prior ItemCode = ParentCode))
                           And (:P653_CATEGORY Is Null Or b.ItemCode In (Select ic.ItemCode From Item ic Where ic.ItemCategoryCode = :P653_CATEGORY))
                         Group By a.PartyCode
                        Having Sum(b.Amount) > 0
                         Order By Sum(b.Amount) Desc)
                 Where Rownum <= 10
                 Order By VALUE_LAC
                ```
            pageItemsToSubmit: [
