            type: donut
        }
        chartLayout {
            height: 300
        }
        messages {
            whenNoDataFound: No invoices in this period and scope.
        }

        series stat (
            name: Invoices
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: STATUS_CODE
                value: INVOICES
            }
        )

    )

    region tax-composition (
        name: Tax and Charge Composition
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Sc As (
                       Select b.FooterAmount,
                              nvl(tx.Cgst,0) Cgst, nvl(tx.Sgst,0) Sgst,
                              nvl(tx.Igst,0) Igst, nvl(tx.Tcs,0) Tcs
                         From CCInvoice a
                         Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                         Join CCInvoiceDetail b On b.TNo = a.TNo
                         Left Join (Select TNo, SNo,
                                      Sum(Decode(FooterHeadCode,'.CGST.',FooterValue,0)) Cgst,
                                      Sum(Decode(FooterHeadCode,'.SGST.',FooterValue,0)) Sgst,
                                      Sum(Decode(FooterHeadCode,'.IGST.',FooterValue,0)) Igst,
                                      Sum(Decode(FooterHeadCode,'.TCS.', FooterValue,0)) Tcs
                                    From CCInvoiceDetailFooter Group By TNo, SNo) tx
                                On tx.TNo = b.TNo And tx.SNo = b.SNo
                        Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                          And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (
                              :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                          )
                          And (
                              :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                          )
                          And (
                              :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                          )
                          And (
                              :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                          )
                          And (
                              :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                          )
                          And (
                              :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                          )
                          And (
                              :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                          )
                          And (
                              :P653_ITEM     Is Null Or b.ItemCode = :P653_ITEM
                          )
                          And (:P653_ITEMGROUP Is Null Or b.ItemCode In
                                 (Select ItemCode From Item Start With ItemCode = :P653_ITEMGROUP
                                Connect By Prior ItemCode = ParentCode))
                           And (:P653_CATEGORY Is Null Or b.ItemCode In (Select ic.ItemCode From Item ic Where ic.ItemCategoryCode = :P653_CATEGORY)))
                Select HEAD, VAL From (
                       Select 'CGST' HEAD, Round(Sum(Cgst)/100000,2) VAL, 1 o From Sc
                       Union All Select 'SGST', Round(Sum(Sgst)/100000,2), 2 From Sc
                       Union All Select 'IGST', Round(Sum(Igst)/100000,2), 3 From Sc
                       Union All Select 'TCS',  Round(Sum(Tcs)/100000,2),  4 From Sc
                       Union All Select 'Other charges',
                              Round((Sum(FooterAmount) - Sum(Cgst+Sgst+Igst+Tcs))/100000,2), 5 From Sc)
                 Where nvl(VAL,0) <> 0
                 Order By o
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
                P653_PARTY
                P653_AGENT
                P653_TRADETYPE
                P653_ITEMGROUP
                P653_ITEM
            ]
        }
        layout {
            sequence: 35
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 300
        }
        messages {
            whenNoDataFound: No tax or charges were booked in this period and scope.
        }

        series tax-heads (
            name: Rs Lac
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: HEAD
                value: VAL
            }
        )

    )

    region trend-chart (
        name: Monthly Sales Trend
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select to_char(Trunc(a.CCInvoiceDate,'MM'),'Mon-RR') MONTH_LABEL,
                       Round(Sum(b.Amount)/100000,2)      SALES_LAC,
                       Round(Sum(b.TotalAmount)/100000,2) INVOICE_LAC,
                       Trunc(a.CCInvoiceDate,'MM') SORT_KEY
                  From CCInvoice a
                  Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                  Join CCInvoiceDetail b On b.TNo = a.TNo
                 Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                   And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                   )
                   And (
                       :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                   )
                   And (
                       :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                   )
                   And (
                       :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                   )
                   And (
                       :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                   )
                   And (
                       :P653_TRANSPORTER Is Null Or a.TransporterCode = :P653_TRANSPORTER
                   )
                   And (
                       :P653_VEHICLENO   Is Null Or a.VehicleNo = :P653_VEHICLENO
                   )
                   And (
                       :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                   )
                   And (
                       :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                   )
                   And (
                       :P653_ITEM     Is Null Or b.ItemCode = :P653_ITEM
                   )
                   And (
                       :P653_ITEMSPEC Is Null Or b.ItemSpecificationCode = :P653_ITEMSPEC
                   )
                   And (:P653_ITEMGROUP Is Null Or b.ItemCode In
                          (Select ItemCode From Item Start With ItemCode = :P653_ITEMGROUP
                         Connect By Prior ItemCode = ParentCode))
                           And (:P653_CATEGORY Is Null Or b.ItemCode In (Select ic.ItemCode From Item ic Where ic.ItemCategoryCode = :P653_CATEGORY))
                   And (:P653_STATUS Is Null Or Exists
                          (Select 1 From DocumentStatusDetail dsd
                            Where dsd.ModuleTNo = a.TNo And dsd.DocumentStatusCode = :P653_STATUS))
                 Group By Trunc(a.CCInvoiceDate,'MM')
                 Order By SORT_KEY
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
                P653_PARTY
                P653_AGENT
                P653_TRADETYPE
                P653_TRANSPORTER
                P653_VEHICLENO
                P653_ITEMGROUP
                P653_ITEM
                P653_ITEMSPEC
                P653_STATUS
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: line
        }
        chartLayout {
            height: 300
        }
        messages {
            whenNoDataFound: No invoices were booked in this period and scope, so there is nothing to plot.
        }

        series invoice-value (
            name: Invoice Value (Rs Lac)
            execution {
                sequence: 20
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: MONTH_LABEL
                value: INVOICE_LAC
            }
        )

        series sales-value (
            name: Sales Value (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: MONTH_LABEL
                value: SALES_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    pageItem P653_AGENT (
        type: popupLov
        label {
            label: Sales Agent
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select GetPartyName(so.AgentCode) d, so.AgentCode r
                  From SalesOrder so
                 Where so.AgentCode Is Not Null
                   And Exists (
                       Select 1 From CCInvoice a Where a.SalesOrderTNo = so.TNo
                         And ((Select GetUserPanelAB_apex() From dual) Is Null
                              Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   )
                 Group By so.AgentCode
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All agents
        }
        layout {
            sequence: 30
            region: @filter-drawer
