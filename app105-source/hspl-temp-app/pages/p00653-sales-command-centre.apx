    region rule-exceptions (
        name: Commercial Exceptions
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Commercial Exceptions</h2>
                  <p>Control failures worth acting on, each with a severity, the value at stake
                     where it can be quantified, and a direct drill to the invoice behind it.
                     Every rule was counted against the schema before it was written; two
                     blueprint rules that would fire on everyone (voucher missing) or never
                     (missing specification) are excluded and shown as information on the
                     activity table instead.</p>
                </div>
                ```
        }
        layout {
            sequence: 105
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-market (
        name: Location and Market
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Location &amp; Market</h2>
                  <p>Where the revenue is raised and where the customers sit. Location is
                     uncapped and drills to Location Analysis; state is the customer's office
                     state (Party.OfficeStateCode), top 12 — there is no geo-coding, so no map
                     is drawn.</p>
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-product (
        name: Product and Channel
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Product &amp; Channel</h2>
                  <p>What sells and how it reaches the customer. Top items and the item &times;
                     specification table drill to Item Analysis; the product mix ignores the
                     item filter; un-agented invoices are named "Agent not recorded" rather than
                     dropped; and the document-status donut shows whether the book is clean.</p>
                </div>
                ```
        }
        layout {
            sequence: 75
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-pulse (
        name: Sales Pulse
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Sales Pulse</h2>
                  <p>Where the period stands. Value is the taxable invoice line
                     (CCInvoiceDetail.Amount) and reconciles to the CC Invoice Register;
                     invoice value adds all footer taxes. Each comparable card measures against
                     the immediately preceding period of equal length, and says so plainly
                     where there is no prior period.</p>
                </div>
                ```
        }
        layout {
            sequence: 15
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-trend (
        name: Revenue Performance
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Revenue Performance</h2>
                  <p>Sales over time at monthly grain — taxable value and invoice value as two
                     series, grouped and ordered on the truncated month — and what the invoice
                     value is made of. TCS is legitimately nil in this book, so its slice never
                     appears; empty charge heads are omitted rather than shown as blank wedges.</p>
                </div>
                ```
        }
        layout {
            sequence: 25
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region state-chart (
        name: Sales by State
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select STATE_NAME, VALUE_LAC From (
                  Select nvl(GetStateName(p.OfficeStateCode),'Not recorded') STATE_NAME,
                         Round(Sum(b.Amount)/100000,2) VALUE_LAC
                    From CCInvoice a
                    Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                    Join CCInvoiceDetail b On b.TNo = a.TNo
                    Left Join Party p On p.PartyCode = a.PartyCode
                   Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                     And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (
                         :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                     )
                     And (
                         :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                     )
                     And (
                         :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                     )
                     And (
                         :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                     )
                     And (
                         :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                     )
                     And (
                         :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                     )
                     And (
                         :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                     )
                     And (
                         :P653_ITEM     Is Null Or b.ItemCode = :P653_ITEM
                     )
                     And (:P653_ITEMGROUP Is Null Or b.ItemCode In
                            (Select ItemCode From Item Start With ItemCode = :P653_ITEMGROUP
                           Connect By Prior ItemCode = ParentCode))
                           And (:P653_CATEGORY Is Null Or b.ItemCode In (Select ic.ItemCode From Item ic Where ic.ItemCategoryCode = :P653_CATEGORY))
                   Group By nvl(GetStateName(p.OfficeStateCode),'Not recorded')
                  Having Sum(b.Amount) > 0
                   Order By Sum(b.Amount) Desc)
                 Where Rownum <= 12
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
                P653_PARTY
                P653_AGENT
                P653_TRADETYPE
                P653_ITEMGROUP
                P653_ITEM
            ]
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 300
        }
        messages {
            whenNoDataFound: No customer state has any sales value in this period and scope.
        }

        series st (
            name: Sales Value (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: STATE_NAME
                value: VALUE_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region status-mix (
        name: Invoices by Document Status
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nvl(dsd.DocumentStatusCode,'NO STATUS ROW') STATUS_CODE,
                       Count(Distinct a.TNo) INVOICES
                  From CCInvoice a
                  Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                  Left Join DocumentStatusDetail dsd On dsd.ModuleTNo = a.TNo
                 Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                   And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                   )
                   And (
                       :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                   )
                   And (
                       :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                   )
                   And (
                       :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                   )
                   And (
                       :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                   )
                   And (
                       :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                   )
                   And (
                       :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                   )
                 Group By nvl(dsd.DocumentStatusCode,'NO STATUS ROW')
                 Order By 2 Desc
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
                P653_PARTY
