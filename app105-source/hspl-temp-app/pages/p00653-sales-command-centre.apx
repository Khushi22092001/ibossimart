page 653 (
    name: Sales Command Centre
    alias: SALES-COMMAND-CENTRE
    title: Sales Command Centre
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            SALES COMMAND CENTRE — data contract (HSPL).
            
            VALUE GRAIN. Every value figure on this page is SUM(CCInvoiceDetail.Amount)
            — the invoice LINE, not the header. CCInvoice carries footer tax on its lines
            (FooterAmount / TotalAmount); the line Amount is the taxable sales value and is
            what reconciles to the CC Invoice (Sales) Register (page 56). Invoice value is
            SUM(CCInvoiceDetail.TotalAmount) = value + footer charges. Never use the header
            CCInvoiceAmount for a total.
            
            TAX. Pre-aggregated to (Tno, Sno) before it is joined. CCInvoiceDetailFooter holds
            one row per charge head; a raw join multiplies each line by its head count. HSPL's
            confirmed tax heads are .CGST. .SGST. .IGST. .TCS. (plus the charge heads
            .INSURANCE. .LOADINGCHARGES. .LOADINGUNLOADING. .CUTTINGCHARGES. .EXPENSES.).
            "Other charges" is FooterAmount minus the four taxes, so no head is double counted
            and none is dropped.
            
            PANEL SECURITY. Every region repeats the panel predicate in the scalar-subquery
            form:
                ((Select GetUserPanelAB_apex() From dual) Is Null Or a.Panel = (Select ...))
            matching the sibling Purchase suite (pages 668 ff). GetUserPanelAB_apex() is not
            DETERMINISTIC and runs two SQL statements plus a session lookup per call; the
            scalar-subquery form lets Oracle cache it for the statement instead of per row.
            Two predicates are used, not one: the first is ENFORCEMENT (what this login may
            see), the second (:P653_PANEL) is USER CHOICE — a panel-bound login cannot widen
            its own scope.
            
            AGENT is on the SalesOrder, not the CCInvoice — joined via a.SalesOrderTNo.
            Un-agented invoices resolve to "Agent not recorded", never dropped.
            
            READ-ONLY. Every region is a SELECT. No INSERT/UPDATE/DELETE/MERGE anywhere.
            
            SCHEMA VERIFICATION (20-08-2026, no DB connection available). Columns were
            corroborated against this repository's OWN SQL — the CC Invoice Register
            (p00056) lines 119-361 anchor the whole chain; SalesOrder agent/trade-type from
            p00056:290-291; footer heads from p00056:261-269; traceability from p00056/p00347.
            NOT corroborated and therefore NOT used: Invoice.DueDate (no AR ageing on the
            sales side), Voucher/DocumentStatusDetail module-qualified by 'CCINVOICE' (HSPL
            links them by ModuleTNo alone), footer heads .ROUNDPLUSMINUS./.TRANSPORTATION.,
            DocTypeCode 'CONVERSION', and the 'GSTNO' attribute code (only 'GSTINNO' is
            proven). See docs/sales-dashboard-hspl-build-notes.md before adding them.
            ```
    }

    region activity (
        name: Sales Activity
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  q.TNO,
                  q.CCInvoiceNo As INVOICE_NO,
                  q.INV_DATE,
                  q.LOCATION,
                  q.CUSTOMER,
                  q.AGENT,
                  q.LINES,
                  q.SALES_VALUE,
                  q.TAX,
                  q.TOTAL_VALUE,
                  Case q.ST
                    When 'ACTIVE'        Then '<span class="ds-pill ds-pill--good">Active</span>'
                    When 'CANCELED'      Then '<span class="ds-pill ds-pill--bad">Cancelled</span>'
                    When 'NO STATUS ROW' Then '<span class="ds-pill ds-pill--muted">No status</span>'
                    Else '<span class="ds-pill ds-pill--warn">' || apex_escape.html(q.ST) || '</span>'
                  End As STATUS_PILL,
                  Case When q.VNO Is Not Null
                       Then '<span class="ds-pill ds-pill--good">Posted</span>'
                       Else '<span class="ds-pill ds-pill--muted">Not posted</span>' End As VOUCHER_PILL
                From (
                  Select a.TNo, a.CCInvoiceNo, a.CCInvoiceDate As INV_DATE,
                         nvl(GetLocationName(a.LocationCode), a.LocationCode) As LOCATION,
                         GetPartyName(a.PartyCode) As CUSTOMER,
                         nvl(GetPartyName(so.AgentCode),'Agent not recorded') As AGENT,
                         (Select Count(*) From CCInvoiceDetail b Where b.TNo = a.TNo) As LINES,
                         (Select Sum(b.Amount) From CCInvoiceDetail b Where b.TNo = a.TNo) As SALES_VALUE,
                         (Select Sum(Decode(f.FooterHeadCode,'.CGST.',f.FooterValue,
                                            '.SGST.',f.FooterValue,'.IGST.',f.FooterValue,
                                            '.TCS.', f.FooterValue,0))
                            From CCInvoiceDetailFooter f Where f.TNo = a.TNo) As TAX,
                         (Select Sum(b.TotalAmount) From CCInvoiceDetail b Where b.TNo = a.TNo) As TOTAL_VALUE,
                         nvl((Select Max(dsd.DocumentStatusCode) From DocumentStatusDetail dsd
                               Where dsd.ModuleTNo = a.TNo),'NO STATUS ROW') As ST,
                         (Select Max(v.VoucherNo) From Voucher v Where v.ModuleTNo = a.TNo) As VNO
                    From CCInvoice a
                    Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                   Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                     And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (
                         :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                     )
                     And (
                         :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                     )
                     And (
                         :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                     )
                     And (
                         :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                     )
                     And (
                         :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                     )
                     And (
                         :P653_TRANSPORTER Is Null Or a.TransporterCode = :P653_TRANSPORTER
                     )
                     And (
                         :P653_VEHICLENO   Is Null Or a.VehicleNo = :P653_VEHICLENO
                     )
                     And (
                         :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                     )
                     And (
                         :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                     )
                     And (:P653_STATUS Is Null Or Exists
                            (Select 1 From DocumentStatusDetail dsd
                              Where dsd.ModuleTNo = a.TNo
                                And dsd.DocumentStatusCode = :P653_STATUS))
                ) q
                Order By q.INV_DATE Desc, q.TNO Desc
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
                P653_PARTY
                P653_AGENT
                P653_TRADETYPE
                P653_TRANSPORTER
                P653_VEHICLENO
                P653_STATUS
            ]
        }
        layout {
            sequence: 120
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
