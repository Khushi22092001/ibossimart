    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button open-filters (
        buttonName: OPENFILTERS
        label: More Filters
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 6
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-sliders
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.theme.openRegion('p653Drawer');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button open-register (
        buttonName: OPENREGISTER
        label: Sales Register
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-table
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 56
                items: {
                    P56_FROMDATE: &P653_FROMDATE.
                    P56_TODATE: &P653_TODATE.
                    P56_COMPANY: &P653_COMPANY.
                    P56_LOCATION: &P653_LOCATION.
                }
                clearCache: 56
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-filters (
        buttonName: RESETFILTERS
        label: Reset All Filters
        layout {
            sequence: 10
            region: @filter-drawer
            slot: regionBody
            column: 1
            columnSpan: 12
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 653
                clearCache: 653
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction install-quickperiods (
        name: Quick Period Chips
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action bind (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    apex.jQuery(document).off('click.p653period')
                      .on('click.p653period', '.ds-period', function () {
                        var r = this.getAttribute('data-range');
                        var now = new Date(), f, t = now;
                        var pad = function (n) { return ('0' + n).slice(-2); };
                        var fmt = function (d) {
                          return pad(d.getDate()) + '-' + pad(d.getMonth() + 1) + '-' + d.getFullYear();
                        };
                        if (r === 'month') { f = new Date(now.getFullYear(), now.getMonth(), 1); }
                        else if (r === 'quarter') { f = new Date(now.getFullYear(), Math.floor(now.getMonth() / 3) * 3, 1); }
                        else if (r === 'fy') { var y = now.getMonth() >= 3 ? now.getFullYear() : now.getFullYear() - 1; f = new Date(y, 3, 1); }
                        else if (r === 'd30') { f = new Date(now); f.setDate(f.getDate() - 29); }
                        else {
                            f = new Date(now); f.setDate(f.getDate() - 89);
                        }
                        apex.item('P653_FROMDATE').setValue(fmt(f));
                        apex.item('P653_TODATE').setValue(fmt(t));
                        apex.page.submit();
                      });
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

