        }
        help {
            helpText: Data partition. This control disappears when your login is bound to a panel — the restriction is then enforced in SQL and printed on the header.
        }
    )

    pageItem P653_PARTY (
        type: popupLov
        label {
            label: Customer
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select GetPartyName(a.PartyCode) d, a.PartyCode r
                  From CCInvoice a
                 Where ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P653_COMPANY Is Null Or a.CompanyCode = :P653_COMPANY
                   )
                 Group By a.PartyCode
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All customers
        }
        layout {
            sequence: 20
            region: @filter-drawer
            slot: regionBody
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Narrows to one customer. The concentration donut deliberately ignores this filter.
        }
    )

    pageItem P653_STATUS (
        type: popupLov
        label {
            label: Document Status
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select dsd.DocumentStatusCode d, dsd.DocumentStatusCode r
                  From DocumentStatusDetail dsd
                 Where dsd.DocumentStatusCode Is Not Null
                   And Exists (
                       Select 1 From CCInvoice a Where a.TNo = dsd.ModuleTNo
                         And ((Select GetUserPanelAB_apex() From dual) Is Null
                              Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   )
                 Group By dsd.DocumentStatusCode
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All statuses
        }
        layout {
            sequence: 100
            region: @filter-drawer
            slot: regionBody
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P653_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: End of the reporting period. Defaults to today. The window is half-open, so the To-Date day is fully included.
        }
    )

