    region exceptions (
        name: Commercial Exceptions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Scope As (
                       Select a.TNo, a.CCInvoiceNo, a.CCInvoiceDate, a.CCInvoiceAmount,
                              a.PartyCode, a.SalesOrderTno, a.DespatchAdviceTno
                         From CCInvoice a
                        Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                          And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                          And ((Select GetUserPanelAB_apex() From dual) Is Null
                               Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (
                              :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                          )
                          And (
                              :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                          )
                          And (
                              :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                          )
                          And (
                              :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                          )
                          And (:P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY)),
                Det As (
                       Select b.TNo, Sum(b.TotalAmount) DetTotal, Count(*) Lines
                         From CCInvoiceDetail b Group By b.TNo),
                Tx As (
                       Select f.TNo,
                              Sum(Decode(f.FooterHeadCode,'.CGST.',f.FooterValue,
                                         '.SGST.',f.FooterValue,'.IGST.',f.FooterValue,
                                         '.TCS.', f.FooterValue,0)) Tax
                         From CCInvoiceDetailFooter f Group By f.TNo),
                Med As (
                       Select ItemCode, Median(Rate) Med
                         From CCInvoiceDetail Where Rate > 0 Group By ItemCode),
                Exc As (
                       Select 1 SEV, 'Header value does not match its lines' REASON,
                              s.TNo, s.CCInvoiceNo, s.CCInvoiceDate,
                              Abs(s.CCInvoiceAmount - nvl(d.DetTotal,0)) AMT
                         From Scope s Join Det d On d.TNo = s.TNo
                        Where Abs(s.CCInvoiceAmount - nvl(d.DetTotal,0)) > 0.01
                       Union All
                       Select 1, 'GST charged but customer has no GSTIN',
                              s.TNo, s.CCInvoiceNo, s.CCInvoiceDate, t.Tax
                         From Scope s Join Tx t On t.TNo = s.TNo
                        Where t.Tax > 0
                          And GetPartyAttributeValue(s.PartyCode,'GSTINNO') Is Null
                       Union All
                       Select 1, 'Line amount is not Quantity x Rate',
                              s.TNo, s.CCInvoiceNo, s.CCInvoiceDate,
                              Abs(b.Amount - b.Quantity1 * b.Rate)
                         From Scope s Join CCInvoiceDetail b On b.TNo = s.TNo
                        Where b.Quantity1 > 0 And b.Rate > 0
                          And Abs(b.Amount - b.Quantity1 * b.Rate) > 1
                       Union All
                       Select 1, 'Cancelled invoice still carrying value',
                              s.TNo, s.CCInvoiceNo, s.CCInvoiceDate, nvl(d.DetTotal,0)
                         From Scope s Join Det d On d.TNo = s.TNo
                        Where d.DetTotal > 0
                          And Exists (Select 1 From DocumentStatusDetail dsd
                                       Where dsd.ModuleTNo = s.TNo
                                         And dsd.DocumentStatusCode = 'CANCELED')
                       Union All
                       Select 2, 'Invoice has no item lines',
                              s.TNo, s.CCInvoiceNo, s.CCInvoiceDate, s.CCInvoiceAmount
                         From Scope s
                        Where Not Exists (Select 1 From CCInvoiceDetail b Where b.TNo = s.TNo)
                       Union All
                       Select 2, 'Zero-value invoice line',
                              s.TNo, s.CCInvoiceNo, s.CCInvoiceDate, To_Number(Null)
                         From Scope s Join CCInvoiceDetail b On b.TNo = s.TNo
                        Where b.Amount = 0
                       Union All
                       Select 2, 'Rate deviates over 40% from item lifetime median',
                              s.TNo, s.CCInvoiceNo, s.CCInvoiceDate, b.Amount
                         From Scope s Join CCInvoiceDetail b On b.TNo = s.TNo
                         Join Med m On m.ItemCode = b.ItemCode
                        Where b.Rate > 0 And m.Med > 0
                          And Abs(b.Rate - m.Med) / m.Med > 0.4
                       Union All
                       Select 3, 'Invoice raised without a Sales Order',
                              s.TNo, s.CCInvoiceNo, s.CCInvoiceDate, nvl(d.DetTotal,0)
                         From Scope s Left Join Det d On d.TNo = s.TNo
                        Where s.SalesOrderTno Is Null
                       Union All
                       Select 3, 'Invoice raised without a Dispatch Advice',
                              s.TNo, s.CCInvoiceNo, s.CCInvoiceDate, nvl(d.DetTotal,0)
                         From Scope s Left Join Det d On d.TNo = s.TNo
                        Where s.DespatchAdviceTno Is Null)
                Select
                  Case SEV When 1 Then '<span class="ds-sev ds-sev--high">High</span>'
                           When 2 Then '<span class="ds-sev ds-sev--medium">Medium</span>'
                           Else '<span class="ds-sev ds-sev--low">Low</span>' End As SEVERITY,
                  REASON As RULE_TEXT,
                  '<a class="ds-exc-drill" href="'
                    || apex_page.get_url(p_page => 657, p_clear_cache => '657',
                         p_items => 'P657_TNO', p_values => TNo)
                    || '">' || apex_escape.html(CCInvoiceNo) || '</a>' As INVOICE_NO,
                  Case When AMT Is Null
                       Then '<span class="ds-muted">not quantifiable</span>'
                       Else 'Rs ' || to_char(Round(AMT),'FM99G99G99G990') End As VALUE_CELL,
                  Trunc(sysdate) - Trunc(CCInvoiceDate) As AGE,
                  SEV As SEV,
                  AMT As AMT
                From Exc
                Order By SEV, AMT Desc Nulls Last, CCInvoiceDate Desc
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
                P653_PARTY
            ]
        }
