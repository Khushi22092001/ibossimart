            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region item-table (
        name: Item and Specification Performance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  b.ItemCode As ITEMCODE,
                  nvl(Max(i.ItemName), b.ItemCode) As ITEM_NAME,
                  b.ItemSpecificationCode As SPEC,
                  Max(i.MeasuringUnitCode1) As UOM,
                  Count(Distinct a.TNo) As INVOICES,
                  Sum(b.Quantity1) As QTY1,
                  Sum(b.Amount) As SALES_VALUE,
                  Case When Sum(b.Quantity1) > 0
                       Then Round(Sum(b.Amount)/Sum(b.Quantity1),2) End As AVG_RATE,
                  '<div class="ds-sharecell"><div class="ds-bar ds-bar--teal"><i style="width:'
                    || to_char(Round(100 * Sum(b.Amount)
                                     / Nullif(Max(Sum(b.Amount)) Over(),0)),'FM990') || '%"></i></div>'
                    || '<span>' || to_char(Round(100 * Sum(b.Amount)
                                     / Nullif(Sum(Sum(b.Amount)) Over(),0),1),'FM990D0')
                    || '%</span></div>' As SHARE_CELL
                  From CCInvoice a
                  Left Join SalesOrder so On so.TNo = a.SalesOrderTNo
                  Join CCInvoiceDetail b On b.TNo = a.TNo
                  Left Join Item i On i.ItemCode = b.ItemCode
                 Where a.CCInvoiceDate >= to_date(:P653_FROMDATE,'DD-MM-RRRR')
                   And a.CCInvoiceDate <  to_date(:P653_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or a.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (
                       :P653_PANEL    Is Null Or a.Panel        = :P653_PANEL
                   )
                   And (
                       :P653_COMPANY  Is Null Or a.CompanyCode  = :P653_COMPANY
                   )
                   And (
                       :P653_LOCATION Is Null Or a.LocationCode = :P653_LOCATION
                   )
                   And (
                       :P653_DOCTYPE  Is Null Or a.DocTypeCode  = :P653_DOCTYPE
                   )
                   And (
                       :P653_PARTY    Is Null Or a.PartyCode    = :P653_PARTY
                   )
                   And (
                       :P653_AGENT     Is Null Or so.AgentCode     = :P653_AGENT
                   )
                   And (
                       :P653_TRADETYPE Is Null Or so.TradeTypeCode = :P653_TRADETYPE
                   )
                   And (
                       :P653_ITEM     Is Null Or b.ItemCode = :P653_ITEM
                   )
                   And (
                       :P653_ITEMSPEC Is Null Or b.ItemSpecificationCode = :P653_ITEMSPEC
                   )
                   And (:P653_ITEMGROUP Is Null Or b.ItemCode In
                          (Select ItemCode From Item Start With ItemCode = :P653_ITEMGROUP
                         Connect By Prior ItemCode = ParentCode))
                           And (:P653_CATEGORY Is Null Or b.ItemCode In (Select ic.ItemCode From Item ic Where ic.ItemCategoryCode = :P653_CATEGORY))
                 Group By b.ItemCode, b.ItemSpecificationCode
                 Order By Sum(b.Amount) Desc
                ```
            pageItemsToSubmit: [
                P653_FROMDATE
                P653_TODATE
                P653_COMPANY
                P653_LOCATION
                P653_PANEL
                P653_DOCTYPE
                P653_PARTY
                P653_AGENT
                P653_TRADETYPE
                P653_ITEMGROUP
                P653_ITEM
                P653_ITEMSPEC
            ]
        }
        layout {
            sequence: 100
            slot: body
            columnSpan: 12
        }
        appearance {
