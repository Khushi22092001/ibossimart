page 685 (
    name: Stock Ageing And Dead Stock
    alias: STOCK-AGEING-ANALYSIS
    title: Stock Ageing And Dead Stock
    pageGroup: @store-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Drill-down target for the Store Command Centre (page 684). MODE selects the lens - AGE lists every stock layer still carrying a balance with its age, DEAD lists items that hold stock but have had no consumption inside the idle window. Both use the same validated balance model as page 684: Stock layer quantity minus UsedStock consumed against that layer, cut off at the as-on date. Ageing is measured from Stock.StockDate, which for brought-forward stock is the financial year begin, so ages cannot exceed days elapsed in the current financial year.
    }

    region ageing-detail (
        name: Stock Ageing Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Layer level ageing. One row per surviving stock layer so the ageing
                   bucket, the receiving document and the storage location are all
                   traceable back to the transaction that created the stock. */
                With Bnd As (Select to_date(:P685_ASONDATE,'DD-MM-RRRR') + 1 D2 From dual),
                     Bal As (
                       Select s.Tno, s.ItemCode, s.ItemSpecificationCode, s.LocationCode,
                              s.StorageLocationCode, s.StockDate, s.Rate, s.LotNo,
                              s.StockModuleCode, s.StockModuleTno,
                              s.StockQuantity1 - nvl(u.Used,0) Qty
                         From Stock s Cross Join Bnd b
                         Left Join (Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                                      From UsedStock us Cross Join Bnd b2
                                     Where us.UsedStockDate < b2.D2 Group By us.StockTno) u On u.StockTno = s.Tno
                        Where s.StockDate < b.D2
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (:P685_PANEL     Is Null Or s.Panel        = :P685_PANEL)
                          And (:P685_COMPANY   Is Null Or s.CompanyCode  = :P685_COMPANY)
                          And (:P685_LOCATION  Is Null Or s.LocationCode = :P685_LOCATION)
                          And (:P685_ITEM      Is Null Or s.ItemCode     = :P685_ITEM)
                          And (:P685_ITEMGROUP Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P685_ITEMGROUP)))
                Select x.ITEMCODE, x.ITEMNAME, x.ITEMGROUP, x.SPECIFICATION, x.LOCATION,
                       x.STORAGE_LOCATION, x.LOTNO, x.RECEIVED_VIA, x.STOCKDATE,
                       x.AGE_DAYS, x.AGE_BUCKET, x.BALANCE_QTY, x.RATE, x.VALUE_LAC
                  From (
                    Select b.ItemCode                              As ITEMCODE,
                           nvl(i.ItemName, b.ItemCode)             As ITEMNAME,
                           nvl(g.ItemName,'-')                     As ITEMGROUP,
                           nvl(sp.ItemSpecificationName,'-')       As SPECIFICATION,
                           nvl(l.LocationName, b.LocationCode)     As LOCATION,
                           nvl(sl.StorageLocationName, nvl(b.StorageLocationCode,'-')) As STORAGE_LOCATION,
                           nvl(b.LotNo,'-')                        As LOTNO,
                           nvl(b.StockModuleCode,'-')              As RECEIVED_VIA,
                           to_char(b.StockDate,'DD-MM-RRRR')       As STOCKDATE,
                           Round((Select D2 From Bnd) - 1 - b.StockDate,0) As AGE_DAYS,
                           Case When (Select D2 From Bnd) - 1 - b.StockDate <= 30  Then '0-30 days'
                                When (Select D2 From Bnd) - 1 - b.StockDate <= 60  Then '31-60 days'
                                When (Select D2 From Bnd) - 1 - b.StockDate <= 90  Then '61-90 days'
                                When (Select D2 From Bnd) - 1 - b.StockDate <= 180 Then '91-180 days'
                                When (Select D2 From Bnd) - 1 - b.StockDate <= 365 Then '181-365 days'
                                When (Select D2 From Bnd) - 1 - b.StockDate <= 730 Then '1-2 years'
                                Else 'Over 2 years' End            As AGE_BUCKET,
                           Round(b.Qty,3)                          As BALANCE_QTY,
                           Round(b.Rate,2)                         As RATE,
                           Round(b.Qty*b.Rate/100000,4)            As VALUE_LAC
                      From Bal b
                      Left Join Item i            On i.ItemCode = b.ItemCode
                      Left Join Item g            On g.ItemCode = i.ParentCode
                      Left Join ItemSpecification sp On sp.ItemSpecificationCode = b.ItemSpecificationCode
                      Left Join Location l        On l.LocationCode = b.LocationCode
                      Left Join StorageLocation sl On sl.StorageLocationCode = b.StorageLocationCode
                     Where b.Qty <> 0) x
                 Where (:P685_BUCKET Is Null Or x.AGE_BUCKET = :P685_BUCKET)
                 Order By x.AGE_DAYS Desc, x.VALUE_LAC Desc
                ```
            pageItemsToSubmit: [
                P685_ASONDATE
                P685_COMPANY
                P685_LOCATION
                P685_PANEL
                P685_ITEMGROUP
                P685_ITEM
                P685_BUCKET
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            plsqlExpression: nvl(:P685_MODE,'AGE') != 'DEAD'
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 200000
        }
        advanced {
            savedReportMappingIdentifier: 31352208740505255
        }

