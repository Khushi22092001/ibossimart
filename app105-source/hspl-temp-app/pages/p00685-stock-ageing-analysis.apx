    region dead-stock (
        name: Dead And Idle Stock
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* An item is dead when it holds a positive balance and nothing was drawn
                   from any of its layers inside the idle window. IDLE_DAYS is measured
                   from the last consumption of any kind; when the item has never been
                   consumed it falls back to the age of its oldest surviving layer.
                
                   PERFORMANCE. Same rule as page 684: aggregate the layer set to
                   item-and-location level BEFORE joining the movement CTE. Joining the
                   raw 24k-row layer set to a per-item aggregate and grouping afterwards
                   took 33 seconds; this shape takes about one. It also lets the idle
                   test live in WHERE against the small set rather than in HAVING. */
                With Bnd As (Select to_date(:P685_ASONDATE,'DD-MM-RRRR') + 1 D2 From dual),
                     Used As (
                       Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                         From UsedStock us Cross Join Bnd b2
                        Where us.UsedStockDate < b2.D2
                        Group By us.StockTno),
                     Bal As (
                       Select s.ItemCode, s.LocationCode, s.StockDate, s.Rate,
                              s.StockQuantity1 - nvl(u.Used,0) Qty
                         From Stock s Cross Join Bnd b
                         Left Join Used u On u.StockTno = s.Tno
                        Where s.StockDate < b.D2
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (:P685_PANEL     Is Null Or s.Panel        = :P685_PANEL)
                          And (:P685_COMPANY   Is Null Or s.CompanyCode  = :P685_COMPANY)
                          And (:P685_LOCATION  Is Null Or s.LocationCode = :P685_LOCATION)
                          And (:P685_ITEM      Is Null Or s.ItemCode     = :P685_ITEM)
                          And (:P685_ITEMGROUP Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P685_ITEMGROUP))),
                     ItemLoc As (
                       Select ItemCode, LocationCode, Sum(Qty) Qty, Sum(Qty*Rate) Val,
                              Min(StockDate) OldestLayer
                         From Bal Group By ItemCode, LocationCode Having Sum(Qty) > 0),
                     LastOut As (
                       Select s.ItemCode, Max(u.UsedStockDate) LastDate
                         From UsedStock u Join Stock s On s.Tno = u.StockTno Cross Join Bnd b
                        Where u.UsedStockDate < b.D2
                        Group By s.ItemCode)
                Select il.ItemCode                                  As ITEMCODE,
                       nvl(i.ItemName, il.ItemCode)                 As ITEMNAME,
                       nvl(g.ItemName,'-')                          As ITEMGROUP,
                       nvl(i.MeasuringUnitCode1,'-')                As UOM,
                       nvl(l.LocationName, il.LocationCode)         As LOCATION,
                       Round(il.Qty,3)                              As BALANCE_QTY,
                       /* nvl so unrated layers read 0.00 and sort last rather than
                          sorting to the top as nulls do in a DESC order. */
                       Round(nvl(il.Val,0)/100000,2)                As VALUE_LAC,
                       to_char(lo.LastDate,'DD-MM-RRRR')            As LAST_ISSUED,
                       nvl(Round((Select D2 From Bnd) - 1 - lo.LastDate,0),
                           Round((Select D2 From Bnd) - 1 - il.OldestLayer,0)) As IDLE_DAYS,
                       Round((Select D2 From Bnd) - 1 - il.OldestLayer,0)      As OLDEST_LAYER_DAYS,
                       Case When lo.LastDate Is Null Then 'Never issued'
                            Else 'Idle since last issue' End        As REASON
                  From ItemLoc il
                  Left Join Item i     On i.ItemCode = il.ItemCode
                  Left Join Item g     On g.ItemCode = i.ParentCode
                  Left Join Location l On l.LocationCode = il.LocationCode
                  Left Join LastOut lo On lo.ItemCode = il.ItemCode
                 Where lo.LastDate Is Null
                    Or lo.LastDate < (Select D2 From Bnd) - nvl(:P685_IDLEDAYS,90)
                 Order By 7 Desc
                ```
            pageItemsToSubmit: [
                P685_ASONDATE
                P685_COMPANY
                P685_LOCATION
                P685_PANEL
                P685_ITEMGROUP
                P685_ITEM
                P685_IDLEDAYS
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
