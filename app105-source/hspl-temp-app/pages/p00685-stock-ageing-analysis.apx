    region command-header (
        name: Stock Ageing And Dead Stock
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-store-head">'
                    || '<div class="ds-store-eyebrow">Store &middot; Inventory Health</div>'
                    || '<h1 class="ds-store-title">'
                    || Case When :P685_MODE = 'DEAD' Then 'Dead &amp; Idle Stock' Else 'Stock Ageing Analysis' End
                    || '</h1>'
                    || '<div class="ds-store-sub">'
                    || Case When :P685_MODE = 'DEAD'
                            Then 'Items holding stock with no consumption inside the idle window, ranked by the capital they lock up'
                            Else 'Every stock layer still carrying a balance, aged from the date it was received' End
                    || '</div>'
                    || '<div class="ds-store-context">'
                    || '<span class="ds-store-chip"><span class="fa fa-calendar-check-o"></span>As on <b>'
                       || :P685_ASONDATE || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P685_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P685_LOCATION),'All locations')) || '</b></span>'
                    || Case When :P685_MODE = 'DEAD' Then
                            '<span class="ds-store-chip"><span class="fa fa-hourglass-end"></span>Idle over <b>'
                            || to_char(nvl(:P685_IDLEDAYS,90)) || ' days</b></span>' End
                    || Case When :P685_BUCKET Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-filter"></span>Bucket <b>'
                            || apex_escape.html(:P685_BUCKET) || '</b></span>' End
                    || Case When :P685_ITEM Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-cube"></span>Item <b>'
                            || apex_escape.html(nvl((Select i.ItemName From Item i Where i.ItemCode = :P685_ITEM),:P685_ITEM))
                            || '</b></span>' End
                    || '</div></div>' As HEAD
                  From dual
                ```
