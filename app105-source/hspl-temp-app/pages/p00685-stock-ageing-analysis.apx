    pageItem P685_LOCATION (
        type: popupLov
        label {
            label: Location
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select nvl(l.LocationName, s.LocationCode) d, s.LocationCode r
                  From Stock s Left Join Location l On l.LocationCode = s.LocationCode
                 Where ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P685_COMPANY Is Null Or s.CompanyCode = :P685_COMPANY)
                 Group By nvl(l.LocationName, s.LocationCode), s.LocationCode
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P685_MODE (
        type: selectList
        label {
            label: View
        }
        lov {
            type: staticValues
            staticValues: STATIC:Ageing detail;AGE,Dead and idle stock;DEAD
            displayExtraValues: false
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        default {
            type: static
            staticValue: AGE
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P685_PANEL (
        type: hidden
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 100
            region: @filter-bar
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back-to-cc (
        buttonName: BACKTOCC
        label: Command Centre
        layout {
            sequence: 110
            region: @filter-bar
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 684
                items: {
                    P684_TODATE: &P685_ASONDATE.
                    P684_COMPANY: &P685_COMPANY.
                    P684_LOCATION: &P685_LOCATION.
                    P684_PANEL: &P685_PANEL.
                    P684_ITEMGROUP: &P685_ITEMGROUP.
                    P684_ITEM: &P685_ITEM.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

