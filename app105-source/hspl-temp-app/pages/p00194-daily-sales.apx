        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select 
                    c.TradeTypeName as TradeType,
                    Sum(bb.Quantity1) as PQuantity,
                    Sum(bb.Quantity2) as SQuantity,
                    Sum(bb.Quantity1) ||' '||e.MeasuringUnitName||' '|| Sum(bb.Quantity2)||' '|| f.MeasuringUnitName
                    from SalesOrder a, TradeType c, Item d ,MeasuringUnit e, MeasuringUnit f
                    ,CCInvoice aa , CCinvoiceDetail bb
                    Where aa.Tno = bb.Tno
                    and   aa.SalesOrderTno = a.Tno
                    and   a.TradeTypeCode = c.TradeTypeCode
                    and   bb.ItemCode = d.ItemCode
                    and   d.MeasuringUnitCode1 = e.MeasuringUnitCode(+)
                    and   d.MeasuringUnitCode2 = f.MeasuringUnitCode(+)
                    --and a.SalesOrderDate Between :P194_FROMDATE and :P194_TODATE
                    and aa.CCinvoiceDate Between :P194_FROMDATE and :P194_TODATE
                      and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||d.ItemnatureCode||':') > 0 )
                    
                    Group by 
                    c.TradeTypeName ,
                    e.MeasuringUnitName ,
                    f.MeasuringUnitName;
                    ```
            }
            columnMapping {
                label: TRADETYPE
                value: PQUANTITY
            }
            label {
                show: true
            }
        )

    )

    region sales-order-detail-summary (
        name: Sales Order Detail Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                Rownum,
                c.PartyName as ConsigneeName ,
                a.SalesOrderNo ,
                a.SalesOrderDate,
                d.PartyName,
                Sum(b.Quantity1) as PQuantity,
                Sum(b.Quantity2) as SQuantity,
                f.MeasuringUnitName as PUOM,
                g.MeasuringUnitName as SUOM,
                getfreighttypename(a.freighttypecode) as FreightType,
                sum(b.totalamount) as Amount
                from SalesOrder a, SalesOrderDetail b, Party c, Party d,
                Item e , MeasuringUnit f, MeasuringUnit g
                Where a.Tno = b.Tno
                and a.ConsigneeCode = c.PartyCode
                and a.PartyCode = d.PartyCode
                and b.ItemCode = e.ItemCode
                and e.MeasuringUnitCode1 = f.MeasuringUnitCode(+)
                and e.MeasuringUnitCode2 = g.MeasuringUnitCode(+)
                --and aa.CCinvoiceDate Between :P194_FROMDATE and :P194_TODATE
                and a.SalesOrderDate Between :P194_FROMDATE and :P194_TODATE
                and a.revisionsalesordertno Is Null
                and getdocumentstatuscode('SALESORDER',A.TNO) = 'ACTIVE'
                 and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||e.ItemnatureCode||':') > 0 )
                
                Group By
                c.PartyName,
                a.SalesOrderNo ,
                a.SalesOrderDate,
                d.PartyName,
                f.MeasuringUnitName,
                g.MeasuringUnitName,
                getfreighttypename(a.freighttypecode),
                Rownum;
                ```
        }
        layout {
            sequence: 100
            slot: body
            columnSpan: 7
