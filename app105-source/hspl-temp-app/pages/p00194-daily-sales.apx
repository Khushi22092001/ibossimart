    pageItem P194_ITEMNATURE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Itemnature
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct b.Itemnaturename d, a.itemnaturecode r
                from item a, itemnature b
                where a.itemnaturecode = b.itemnaturecode(+) 
                ```
        }
        layout {
            sequence: 30
            region: @sales-summary
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
