    region trade-type-wise-sales-summary (
        name: Trade Type Wise Sales Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       row_number() over(order by c.TradeTypeName) SerialNo,
                       c.TradeTypeName As TradeType,
                       Sum(bb.Quantity1) As PQuantity,
                       Sum(bb.Quantity2) As SQuantity,
                       e.MeasuringUnitName As PUOM,
                       f.MeasuringUnitName As SUOM,
                (
                  Select sum(bb.quantity1) as Quantity --Sum(bb.totalamount) As amount 
                  From ccinvoice aa, CCinvoiceDetail bb, Item cc, Financialyear fy, SalesOrder so
                Where aa.tno = bb.tno 
                  And bb.itemcode = cc.itemcode
                  and aa.salesordertno = so.tno
                  And aa.ccinvoicedate between fy.Financialyearbegin and fy.FinancialyearEnd
                  And aa.CCInvoiceDate Between fy.Financialyearbegin and :P194_TODATE --:P194_FROMDATE and :P194_TODATE
                  and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||cc.ItemnatureCode||':') > 0 )
                  and c.TradeTypeCode = so.tradetypecode
                ) as Tradeyearlyqty,
                Sum(bb.quantity1),
                (
                  Select sum(bb.quantity1) as Quantity -- Sum(bb.totalamount) As amount 
                  From ccinvoice aa, CCinvoiceDetail bb, Item cc, Financialyear fy
                Where aa.tno = bb.tno 
                  And bb.itemcode = cc.itemcode
                  And aa.ccinvoicedate between fy.Financialyearbegin and fy.FinancialyearEnd
                  And aa.CCInvoiceDate Between fy.Financialyearbegin and :P194_TODATE --:P194_FROMDATE and :P194_TODATE
                  and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||cc.ItemnatureCode||':') > 0 )
                ) as yearlyqty,
                
                round((Sum(bb.quantity1) /  (
                  Select Sum(bbb.quantity1) As quantity 
                  From ccinvoice aaa, CCinvoiceDetail bbb, Item ccc, Financialyear fy
                Where aaa.tno = bbb.tno 
                  And bbb.itemcode = ccc.itemcode
                  And aaa.ccinvoicedate between fy.Financialyearbegin and fy.FinancialyearEnd
                  And aaa.CCInvoiceDate Between :P194_FROMDATE and :P194_TODATE --:P194_FROMDATE and :P194_TODATE
                  and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||ccc.ItemnatureCode||':') > 0 )
                ))*100, 3) as percentile,
                (
                  Select Sum(bbb.quantity1) As quantity 
                  From ccinvoice aaa, CCinvoiceDetail bbb, Item ccc, Financialyear fy
                Where aaa.tno = bbb.tno 
                  And bbb.itemcode = ccc.itemcode
                  And aaa.ccinvoicedate between fy.Financialyearbegin and fy.FinancialyearEnd
                  And aaa.CCInvoiceDate Between :P194_FROMDATE and :P194_TODATE --:P194_FROMDATE and :P194_TODATE
                  and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||ccc.ItemnatureCode||':') > 0 )
                ) qty
                
                
                  From SalesOrder      a,
                       TradeType       c,
                       Item            d,
                       MeasuringUnit   e,
                       MeasuringUnit   f,
                       CCInvoice       aa,
                       CCinvoiceDetail bb
                 Where aa.Tno = bb.Tno
                   And aa.SalesOrderTno = a.Tno
                   And a.TradeTypeCode = c.TradeTypeCode
                   And bb.ItemCode = d.ItemCode
                   And d.MeasuringUnitCode1 = e.MeasuringUnitCode(+)
                   And d.MeasuringUnitCode2 = f.MeasuringUnitCode(+)
                   and aa.CCInvoiceDate Between :P194_FROMDATE and :P194_TODATE
                   and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||d.ItemnatureCode||':') > 0 )
                
                 Group By c.TradeTypeCode,c.TradeTypeName, e.MeasuringUnitName, f.MeasuringUnitName;
                ```
        }
        layout {
            sequence: 40
            slot: body
            columnSpan: 7
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: Trade Type Wise Daily Sales
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
