    region item-wise-sales-summary (
        name: Item Wise Sales Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                c.ItemName as Item,
                row_number() over(order by f.ItemSpecificationName) SerialNo,
                f.ItemSpecificationName as ItemSpecification,
                Sum(b.Quantity1) as PQuantity,
                Sum(b.Quantity2) as SQuantity,
                d.MeasuringUnitName as PUOM,
                e.MeasuringUnitName as SUOM,
                sum(b.totalamount) as Amount
                from 
                ccinvoice a,  CCinvoiceDetail b, Item c, MeasuringUnit d, MeasuringUnit e, ItemSpecification f
                Where a.Tno = b.Tno
                and b.ItemCode = c.ItemCode(+)
                and b.ItemspecificationCode = f.ItemSpecificationCode (+)
                and c.MeasuringUnitCode1 = d.MeasuringUnitCode(+)
                and c.MeasuringUnitCode2 = e.MeasuringUnitCode(+)
                --and c.ItemNatureCode = 'FINISHEDITEM'
                and a.CCInvoiceDate Between :P194_FROMDATE and :P194_TODATE
                and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||c.ItemnatureCode||':') > 0 )
                
                
                Group by
                c.ItemName ,
                f.ItemSpecificationName,
                d.MeasuringUnitName ,
                e.MeasuringUnitName ;
                ```
        }
        layout {
            sequence: 60
            slot: body
            columnSpan: 7
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: Item Wise Sales Summary
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 19858940422946307
        }

