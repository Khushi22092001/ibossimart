    region pie-chart-brand-wise-sales-summary (
        name: Pie Chart Brand Wise Sales Summary
        type: chart
        layout {
            sequence: 90
            slot: body
            startNewRow: false
            column: 8
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                i-h480
                t-Region--removeHeader js-removeLandmark
                t-Region--accent1
                t-Region--noBorder
                t-Region--scrollBody
                margin-top-md
            ]
        }
        chart {
            type: pie
        }
        chartLayout {
            height: 400
        }
        value {
            format: decimal
            decimalPlaces: 0
            formatScaling: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select 
                    c.ItemName as Item,
                    Sum(b.Quantity1) as PQuantity,
                    Sum(b.Quantity2) as SQuantity,
                    Sum(b.Quantity1)||' '||d.MeasuringUnitName ||' '||Sum(b.Quantity2)||' '||e.MeasuringUnitName
                    from 
                    ccinvoice a,  CCinvoiceDetail b, Item c, MeasuringUnit d, MeasuringUnit e
                    Where a.Tno = b.Tno
                    and b.ItemCode = c.ItemCode
                    and c.MeasuringUnitCode1 = d.MeasuringUnitCode(+)
                    and c.MeasuringUnitCode2 = e.MeasuringUnitCode(+)
                    and a.CCInvoiceDate Between :P194_FROMDATE and :P194_TODATE
                    and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||c.ItemnatureCode||':') > 0 )
                    
                    Group By 
                    c.ItemName ,
                    d.MeasuringUnitName,
                    e.MeasuringUnitName;
                    ```
            }
            columnMapping {
                label: ITEM
                value: PQUANTITY
                customTooltip: SUM(B.QUANTITY1)||''||D.MEASURINGUNITNAME||''||SUM(B.QUANTITY2)||''||E.MEASURINGUNITNAME
            }
            label {
                show: true
            }
        )

    )

    region pie-chart-consignee-wise-sales-summary (
