    region brand-wise-sales-summary (
        name: Brand Wise Sales Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                Rownum,
                c.ItemName as Item,
                Sum(b.Quantity1) as PQuantity,
                Sum(b.Quantity2) as SQuantity,
                d.MeasuringUnitName as PUOM,
                e.MeasuringUnitName as SUOM
                from 
                ccinvoice a,  CCinvoiceDetail b, Item c, MeasuringUnit d, MeasuringUnit e
                Where a.Tno = b.Tno
                and b.ItemCode = c.ItemCode
                and c.MeasuringUnitCode1 = d.MeasuringUnitCode(+)
                and c.MeasuringUnitCode2 = e.MeasuringUnitCode(+)
                and a.CCInvoiceDate Between :P194_FROMDATE and :P194_TODATE
                and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||c.ItemnatureCode||':') > 0 )
                
                Group By 
                c.ItemName ,
                d.MeasuringUnitName,
                e.MeasuringUnitName,
                Rownum;
                ```
        }
        layout {
            sequence: 80
            slot: body
            columnSpan: 7
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: Brand Wise Sales Summary
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
