        series pie (
            name: Pie
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select 
                    c.PartyName,
                    Sum(b.Quantity1) as PQuantity,
                    Sum(b.Quantity1) as SQuantity,
                    Sum(b.Quantity1) ||' ' ||e.MeasuringUnitName ||' '||Sum(b.Quantity1)||' ' ||f.MeasuringUnitName 
                    from 
                    ccinvoice a,  CCinvoiceDetail b, Party c, Item d ,
                    MeasuringUnit e, MeasuringUnit f
                    Where a.Tno = b.Tno
                    and a.ConsigneeCode = c.PartyCode
                    and b.ItemCode = d.ItemCode
                    and d.MeasuringUnitCode1 = e.MeasuringUnitCode(+)
                    and d.MeasuringUnitCode2 = f.MeasuringUnitCode(+)
                    and a.CCInvoiceDate Between :P194_FROMDATE and :P194_TODATE
                    and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||d.ItemnatureCode||':') > 0 )
                    
                    Group By
                    c.PartyName,
                    f.MeasuringUnitName,
                     e.MeasuringUnitName;
                    ```
            }
            columnMapping {
                label: PARTYNAME
                value: PQUANTITY
                customTooltip: SUM(B.QUANTITY1)||''||E.MEASURINGUNITNAME||''||SUM(B.QUANTITY1)||''||F.MEASURINGUNITNAME
