    region party-wise-sales-summary (
        name: Party Wise Sales Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                Rownum,
                c.partycode,
                c.PartyName,
                Sum(b.Quantity1) as PQuantity,
                Sum(b.Quantity2) as SQuantity,
                e.MeasuringUnitName as PUOM,
                f.MeasuringUnitName as SUOM,
                (
                  Select sum(bb.quantity1) as quantity --Sum(bb.totalamount) As amount 
                  From ccinvoice aa, CCinvoiceDetail bb, Item cc, Financialyear fy
                Where aa.tno = bb.tno 
                  And bb.itemcode = cc.itemcode
                  And aa.ccinvoicedate between fy.Financialyearbegin and fy.FinancialyearEnd
                  And aa.CCInvoiceDate Between fy.Financialyearbegin and :P194_TODATE --:P194_FROMDATE and :P194_TODATE
                  and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||cc.ItemnatureCode||':') > 0 )
                  and aa.ConsigneeCode = c.partycode
                ) as partyyearlyqty,
                Sum(b.quantity1),
                (
                  Select sum(bb.quantity1) as quantity--Sum(bb.totalamount) As amount 
                  From ccinvoice aa, CCinvoiceDetail bb, Item cc, Financialyear fy
                Where aa.tno = bb.tno 
                  And bb.itemcode = cc.itemcode
                  And aa.ccinvoicedate between fy.Financialyearbegin and fy.FinancialyearEnd
                  And aa.CCInvoiceDate Between fy.Financialyearbegin and :P194_TODATE --:P194_FROMDATE and :P194_TODATE
                  and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||cc.ItemnatureCode||':') > 0 )
                ) as yearlyqty,
                
                round((Sum(b.quantity1) /  (
                  Select Sum(quantity1) As quantity 
                  From ccinvoice aa, CCinvoiceDetail bb, Item cc, Financialyear fy
                Where aa.tno = bb.tno 
                  And bb.itemcode = cc.itemcode
                  And aa.ccinvoicedate between fy.Financialyearbegin and fy.FinancialyearEnd
                  And aa.CCInvoiceDate Between :P194_FROMDATE and :P194_TODATE --:P194_FROMDATE and :P194_TODATE
                  and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||cc.ItemnatureCode||':') > 0 )
                ))*100, 3) as percentile
                
                from 
                ccinvoice a,  CCinvoiceDetail b, Party c, Item d ,
                MeasuringUnit e, MeasuringUnit f
                Where a.Tno = b.Tno
                and a.ConsigneeCode = c.PartyCode
                and b.ItemCode = d.ItemCode
                and d.MeasuringUnitCode1 = e.MeasuringUnitCode(+)
                and d.MeasuringUnitCode2 = f.MeasuringUnitCode(+)
                and a.CCInvoiceDate Between :P194_FROMDATE and :P194_TODATE
                and ( :P194_ITEMNATURE IS NULL OR instr(':'||:P194_ITEMNATURE||':',':'||d.ItemnatureCode||':') > 0 )
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                Group By
                c.PartyName,
                c.partycode,
                e.MeasuringUnitName,
                f.MeasuringUnitName,
                Rownum;
                ```
            pageItemsToSubmit: [
                P194_FROMDATE
                P194_TODATE
                P194_ITEMNATURE
            ]
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 7
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        headerAndFooter {
            headerText: Party Wise Sales Summary
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 12480495806148539
        }

