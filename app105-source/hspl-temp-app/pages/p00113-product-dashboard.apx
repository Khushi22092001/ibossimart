    region stock-storage-location-wise (
        name: Stock Storage Location Wise
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      ItemSpecificationCode,
                      round(sum(BALANCEQUANTITY1),3)||' '||e.MeasuringUnitcode1 as QUANTITY,
                      round(sum(STOCKVALUE),3) STOCKVALUE
                From  D_PRODUCT360VIEW_STOCKSTORAGELOCATIONWISE a, Item e
                Where ItemSpecificationCode like nvl(:P113_ITEMSPECIFICATIONCODEP,'%')
                  and a.ItemCode = e.itemCode
                Group BY ItemSpecificationCode,e.MeasuringUnitcode1
                ```
        }
        layout {
            sequence: 90
            parentRegion: @product-dashboard
            slot: subRegions
            column: 1
            columnSpan: 3
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            cssClasses: hiddenscroll
        }
        card {
            cssClasses: color10
        }
        title {
            column: QUANTITY
            cssClasses: cardtitle
        }
        subtitle {
            column: STOCKVALUE
            cssClasses: cardsubtitle
        }
        body {
            advancedFormatting: true
            htmlExpression: <H4 style="font-size:20px; text-align:center"> Stock Detail</H4>
        }
        performance {
            lazyLoading: true
        }
    )

