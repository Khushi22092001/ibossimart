        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    process fetch-product-detail (
        name: Fetch Product Detail
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                Select
                      e.ItemCode,
                      e.ItemName,
                      i.ItemName,
                      inn.ItemNatureName,
                      ee.ItemSpecificationName,
                      ee.HSNCode,
                      mu1.MeasuringUnitName UOM1,
                      mu2.MeasuringUnitName UOM2,
                      e.IsEquipment,
                      e.SerialNoRequired,
                      i.ProcurementStrategy,
                      i.OrderingPolicy,
                      GetPartyName(e.StockAccountCode),
                      GetPartyName(e.ConsumptionAccountCode),
                      GetPartyName(e.CWIPAccountCode)
                      into
                      :P113_ITEMCODE,
                      :P113_ITEMNAME,
                      :P113_GROUP,
                      :P113_NATURE,
                      :P113_ITEMSPECIFICATION,
                      :P113_HSNCODE,
                      :P113_PUOM,
                      :P113_SUOM,
                      :P113_ISEQUIPMENT,
                      :P113_SERIALNOREQUIRED,
                      :P113_PURCHASEPOLICY,
                      :P113_ORDERINGPOLICY,
                      :P113_STOCKACC,
                      :P113_CONSACC,
                      :P113_CWIPACC
                
                From  Item e, ItemSpecification ee, ItemNature inn, MeasuringUnit mu1, MeasuringUnit mu2, Item i
                Where e.TNo = ee.TNo
                  and e.ItemNatureCode = inn.ItemNatureCode(+)
                  and e.MeasuringUnitCode1 = mu1.MeasuringUnitCode(+)
                  and e.MeasuringUnitCode2 = mu2.MeasuringUnitCode(+)
                  and e.ParentCode = i.ItemCode(+)
                  and ee.ItemSpecificationCode like nvl(:P113_ITEMSPECIFICATIONCODEP,'%')
                  ;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 8585839881239088
        }
    )

)

