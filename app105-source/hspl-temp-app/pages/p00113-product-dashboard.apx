    region stock-storage-location (
        name: Stock Storage Location
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       STORAGELOCATIONCODE,
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':99:'||:APP_SESSION||'::'||':99:P99_ITEMSPECIFICATIONCODE,P99_STORAGELOCATION:'||ITEMSPECIFICATIONCODE||','||STORAGELOCATIONCODE,NULL,'SESSION' )||'">'||STORAGELOCATIONNAME||'</a>' as StorageLink,
                       NVL(SUM(BALANCEQUANTITY1),0)BALANCEQUANTITY1,
                       NVL(SUM(BALANCEQUANTITY2),0)BALANCEQUANTITY2,
                       NVL(SUM(STOCKVALUE),0)STOCKVALUE
                  from D_PRODUCT360VIEW_STOCKSTORAGELOCATIONWISE
                  where  ITEMSPECIFICATIONCODE like nvl(:P104_ITEMSPECIFICATIONCODE,'%')
                  GROUP BY ITEMCODE,
                           ITEMSPECIFICATIONCODE,
                           STORAGELOCATIONCODE,
                           STORAGELOCATIONNAME
                ```
        }
        layout {
            sequence: 100
            parentRegion: @product-dashboard
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
            cssClasses: reportheight3
        }
        headerAndFooter {
            headerText: <h3 style="font-family:Calibri;text-align:center;background-color: gainsboro;margin-top: .7em;">Stock Storage Location wise</h3>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound:
                ```
                <H2 style="height:170px; text-align:centre"><br>STOCK DATA 
                <br>NOT FOUND
                ```
        }
        searchBar {
            includeSearchBar: false
        }
        advanced {
            savedReportMappingIdentifier: 7373244174484641
        }

