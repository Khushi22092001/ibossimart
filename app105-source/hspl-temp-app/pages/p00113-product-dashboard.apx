    region 12-months-details-2 (
        name: 12 Months Details
        type: chart
        layout {
            sequence: 30
            parentRegion: @product-dashboard
            slot: subRegions
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                i-h320
                t-Region--textContent
                t-Region--hiddenOverflow
            ]
            cssClasses: monthsale
        }
        chartAppearance {
            stack: true
            stackLabel: true
        }
        chartLayout {
            maxWidth: 786
            height: 270
        }
        multiSeriesChartData {
            fillGapsInChartData: false
        }
        animation {
            onDisplay: none
            onDataChange: none
        }
        legend {
            hideAndShowBehavior: none
        }

        series 12-months-detail (
            name: 12 Months Detail
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                          x.Module,
                          x.Months,
                          x.Monthsyy,
                          x.Amount,
                          x.ItemSpecificationCode
                    From 
                    (select 
                       'PURCHASE' as Module,
                       ItemSpecificationCode,
                       TO_CHAR(PBPASSDATE,'MON-YYYY')AS MONTHS,
                       TO_CHAR(PBPASSDATE,'YYYYMM')AS MONTHSYY,
                       SUM(TOTALAMOUNT) AMOUNT
                    from D_SUPPLIER_360VIEW_ACTIVEPBPASS
                    WHERE ItemSpecificationCode like nvl(:P113_ITEMSPECIFICATIONCODEP,'%')
                    GROUP BY TO_CHAR(PBPASSDATE,'MON-YYYY'),TO_CHAR(PBPASSDATE,'YYYYMM'),ItemSpecificationCode
                    Union All
                    select 
                       'SALE' as Module,
                       ItemSpecificationCode,
                       TO_CHAR(CCINVOICEDATE,'MON-YYYY')AS MONTHS,
                       TO_CHAR(CCINVOICEDATE,'YYYYMM')AS MONTHSYY,
                       SUM(TOTALAMOUNT) AMOUNT
                    from D_CUSTOMER_360VIEW_ACTIVEINVOICE
                    WHERE ItemSpecificationCode like nvl(:P113_ITEMSPECIFICATIONCODEP,'%')
                    GROUP BY TO_CHAR(CCINVOICEDATE,'MON-YYYY'),TO_CHAR(CCINVOICEDATE,'YYYYMM'),ItemSpecificationCode
                    Union All
                    select 
                       'PRODUCTION' as Module,
                       ItemSpecificationCode,
                       TO_CHAR(PRODUCTIONDATE,'MON-YYYY')AS MONTHS,
                       TO_CHAR(PRODUCTIONDATE,'YYYYMM')AS MONTHSYY,
                       SUM(AMOUNT) AMOUNT
                    from D_PRODUCT360VIEW_PRODUCTION
                    WHERE ItemSpecificationCode like nvl(:P113_ITEMSPECIFICATIONCODEP,'%')
                    GROUP BY TO_CHAR(PRODUCTIONDATE,'MON-YYYY'),TO_CHAR(PRODUCTIONDATE,'YYYYMM'),ItemSpecificationCode
                    )x
                    Where rownum <= 12
                    order by 3 
                    ```
            }
            columnMapping {
                seriesName: MODULE
                label: MONTHS
                value: AMOUNT
            }
            link {
                type: redirectThisApp
                target: {
                    page: 97
                    items: {
                        P97_MONTH: &MONTHS.
                        P97_MODULE: &MODULE.
                        P97_ITEMSPECIFICATIONCODE: &ITEMSPECIFICATIONCODE.
                    }
                    clearCache: 97
                }
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

        axis y-2 (
            name: y2
            showAxis: false
            minorTicks {
                show: false
            }
        )

    )

