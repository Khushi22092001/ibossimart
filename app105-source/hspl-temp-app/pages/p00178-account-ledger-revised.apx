    process loading-event (
        name: loading event
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                pappuser varchar2(100);
                PPARTYCODE VARCHAR2(30);
                BEGIN
                if :P303_PARTY IS NOT NULL THEN
                          DELETE FROM TrialbalancerevisedLOCATION;
                          INSERT INTO TrialbalancerevisedLOCATION
                            (TNO, LOCATIONCODE )
                            SELECT GLOBALTNO.NEXTVAL, LOCATIONCODE
                              FROM LOCATION
                           WHERE instr(':'||:P178_LOCATION||':',':'||LocationCode||':') > 0
                            ;
                
                            UPDATE TrialbalancerevisedLOCATION SET CREATOR = '&APP_USER.'
                            WHERE CREATOR = 'APEX_PUBLIC_USER';
                        /* select loginname into pappuser from bossuser where bossusername = '&APP_USER.' ;*/
                        IF :P178_PARTY IS NOT NULL THEN
                         SELECT PARTYCODE INTO PPARTYCODE
                         FROM PARTY
                         WHERE instr(':'||:P178_PARTY||':',':'||PartyCode||':') > 0
                         ;
                        END IF;
                        -- FOR C IN (SELECT * FROM TRIALBALANCEREVISEDLOCATION) LOOP
                            GenerateAccountLedgerRevised(PPARTYCODE,
                                                         :P178_FROMDATE,
                                                         :P178_TODATE,
                                                         '1',
                                                         null,
                                                         'YES',
                                                         '&APP_USER.');
                
                        -- END LOOP;
                
                        COMMIT;
                 END IF;
                END;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 14836819101830201
        }
    )

