        helpText: No help is available for this page.
    }

    region account-ledger-revised (
        name: Account Ledger  Revised
        type: staticContent
        layout {
            sequence: 10
            slot: fullWidthContent
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
    )

    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT X.TNO,
                       X.VOUCHERDATE,
                       X.LOCATIONCODE,
                       X.ACCOUNTNAME,
                       X.VOUCHERNO,
                       ( SELECT DOCTYPECODE FROM VOUCHER WHERE TNO = X.TNO) AS VOUCHERTYPE,
                       'DETAIL' AS VRDETAIL,
                       'NARRATION' AS NARRATION,
                       X.AMOUNT,
                       CASE WHEN X.VOUCHERNO = 'CLOSING' THEN 
                               0
                            ELSE           
                               X.DRAMOUNT
                       END DRAMOUNT,
                      CASE WHEN X.VOUCHERNO = 'CLOSING' THEN 
                               0
                            ELSE            
                               X.CRAMOUNT
                       END CRAMOUNT,
                       CASE
                         WHEN (SUM(X.Amount) OVER(ORDER BY VOUCHERDATE, TNO)) < 0 AND
                              X.VOUCHERNO != 'CLOSING' THEN
                          ROUND((SUM(X.Amount) OVER(ORDER BY VOUCHERDATE, TNO)), 0) * -1
                         WHEN (SUM(X.Amount) OVER(ORDER BY VOUCHERDATE, TNO)) < 0 AND
                              X.VOUCHERNO = 'CLOSING' THEN
                          DECODE(X.AMOUNT + ABS(X.AMOUNT), 0, ROUND(X.AMOUNT * -1, 0))
                         ELSE
                          0
                       END DRCLOSING,
                       CASE
                         WHEN (SUM(X.Amount) OVER(ORDER BY VOUCHERDATE, TNO)) > 0 AND
                              X.VOUCHERNO != 'CLOSING' THEN
                          ROUND((SUM(X.Amount) OVER(ORDER BY VOUCHERDATE, TNO)), 0)
                         WHEN (SUM(X.Amount) OVER(ORDER BY VOUCHERDATE, TNO)) > 0 AND
                              X.VOUCHERNO = 'CLOSING' THEN
                          DECODE(X.AMOUNT + ABS(X.AMOUNT), 2 * X.AMOUNT, ROUND(X.AMOUNT, 0))
                         ELSE
                          0
                       END CRCLOSING,
                       'VOUCHER' AS VOUCHER,
                	   CASE WHEN NVL(X.BILLATTACHED,'NO')='YES' THEN
                				X.MODULECODE
                		    ELSE
                			    NULL
                		END MODULEODE,
                       X.MODULETNO
                      
                  FROM (SELECT 1 AS TNO,
                               TO_DATE(:P178_FROMDATE,'DD-MON-RRRR') AS VOUCHERDATE,
                               NULL AS LOCATIONCODE,
                               'OPENING' AS ACCOUNTNAME,
                               'OPENING' AS VOUCHERNO,
                               NULL AS NARRATION,
                               (SELECT SUM(AMOUNT)
                                  FROM VOUCHERDETAIL X
                                 WHERE X.VOUCHERDATE < :P178_FROMDATE
                                   AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                   AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                               ) AS AMOUNT,
                               CASE
                                 WHEN (SELECT SUM(AMOUNT)
                                         FROM VOUCHERDETAIL X
                                        WHERE X.VOUCHERDATE < :P178_FROMDATE
                                          AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                          AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                                      ) < 0 THEN
                                  (SELECT SUM(AMOUNT)
                                     FROM VOUCHERDETAIL X
                                    WHERE X.VOUCHERDATE < :P178_FROMDATE
                                      AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                      AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                                  ) * -1
                                 ELSE
                                  0
                               END DRAMOUNT,
                               CASE
                                 WHEN (SELECT SUM(AMOUNT)
                                         FROM VOUCHERDETAIL X
                                        WHERE X.VOUCHERDATE < :P178_FROMDATE
                                          AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                          AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                                      ) > 0 THEN
                                  (SELECT SUM(AMOUNT)
                                     FROM VOUCHERDETAIL X
                                    WHERE X.VOUCHERDATE < :P178_FROMDATE
                                      AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                      AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                                  )
                                 ELSE
                                  0
                               END CRAMOUNT,
                               (SELECT SUM(AMOUNT)
                                  FROM VOUCHERDETAIL X
                                 WHERE X.VOUCHERDATE < :P178_FROMDATE
                                   AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                   AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                               ) AS CLOSING,
                                NULL AS MODULECODE,
                                NULL AS MODULETNO,
                				NULL AS BILLATTACHED
                          FROM DUAL
                        UNION ALL
                        
                        SELECT X.TNO,
                               
                               X.VOUCHERDATE,
                               X.LOCATIONCODE,
                               X.ACCOUNTNAME,
                               X.VOUCHERNO,
                               X.NARRATION,
                               X.AMOUNT,
                               DECODE(X.AMOUNT + ABS(X.AMOUNT), 0, ROUND(X.AMOUNT * -1, 0)) AS DRAMOUNT,
                               DECODE(X.AMOUNT + ABS(X.AMOUNT), 2 * X.AMOUNT, ROUND(X.AMOUNT, 0)) AS CRAMOUNT,
                               (SUM(X.Amount) OVER(ORDER BY X.VOUCHERDATE, X.TNO)) CLOSING,
                               nvl(Y.MODULECODE,y.referencemodulecode) as modulecode,
                               case when nvl(Y.MODULECODE,y.referencemodulecode)='PBPASS' then
                                      ( 
                                         select A.tno from purchasebill a, pbpass b
                                          where a.tno = b.purchasebilltno
                                            and b.tno = nvl(Y.MODULETNO,y.referencetno)
                                      )
                                    when nvl(Y.MODULECODE,y.referencemodulecode)='JBPASS' then
                                     ( 
                                         select A.tno from jobbill a, jbpass b
                                          where a.tno = b.jobbilltno
                                            and b.tno = nvl(Y.MODULETNO,y.referencetno)
                                      )
                                    else
                                        nvl(Y.MODULETNO,y.referencetno) 
                               end moduletno ,
                			   X.BILLATTACHED
                            FROM Accountledgerreport X, Voucher y
                         WHERE X.TNO = y.tno
                           AND X.VOUCHERDATE BETWEEN :P178_FROMDATE AND :P178_TODATE
                           AND X.CREATOR = '&APP_USER.'
                           AND instr(':'||:P178_PARTY||':',':'||X.LEDGERACCOUNTCODE||':') > 0
                           AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                        ------- CLOSING
                        UNION ALL
                        SELECT 99999999999 AS TNO,
                               TO_DATE(:P178_TODATE,'DD-MON-RRRR') AS VOUCHERDATE,
                               NULL AS LOCATIONCODE,
                               'CLOSING' AS ACCOUNTNAME,
                               'CLOSING' AS VOUCHERNO,
                               NULL AS NARRATION,
                               (SELECT ROUND(SUM(AMOUNT), 0)
                                  FROM VOUCHERDETAIL X
                                 WHERE X.VOUCHERDATE <= :P178_TODATE
                                   AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                   AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                               ) AS AMOUNT,
                               CASE
                                 WHEN (SELECT ROUND(SUM(AMOUNT), 0)
                                         FROM VOUCHERDETAIL X
                                        WHERE X.VOUCHERDATE <= :P178_TODATE
                                          AND X.ACCOUNTCODE = '4897'
                                          AND X.LOCATIONCODE = 'RMT') < 0 THEN
                                  (SELECT ROUND(SUM(AMOUNT), 0)
                                     FROM VOUCHERDETAIL X
                                    WHERE X.VOUCHERDATE <= :P178_TODATE
                                      AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                      AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                                  ) * -1
                                 ELSE
                                  0
                               END DRAMOUNT,
                               CASE
                                 WHEN (SELECT ROUND(SUM(AMOUNT), 0)
                                         FROM VOUCHERDETAIL X
                                        WHERE X.VOUCHERDATE <= :P178_TODATE
                                          AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                          AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                                      ) > 0 THEN
                                  (SELECT ROUND(SUM(AMOUNT), 0)
                                     FROM VOUCHERDETAIL X
                                    WHERE X.VOUCHERDATE <= :P178_TODATE
                                      AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                      AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                                  )
                                 ELSE
                                  0
                               END CRAMOUNT,
                               (SELECT ROUND(SUM(AMOUNT), 0)
                                  FROM VOUCHERDETAIL X
                                 WHERE X.VOUCHERDATE <= :P178_TODATE
                                   AND instr(':'||:P178_PARTY||':',':'||X.ACCOUNTCODE||':') > 0
                                   AND (:P178_LOCATION IS NULL OR instr(':'||:P178_LOCATION||':',':'||X.LocationCode||':') > 0)
                               ) AS CLOSING,
                               NULL AS MODULECODE,
                               NULL AS MODULETNO,
                			   NULL AS BILLATTACHED
                        
                          FROM DUAL
                        
                
                         ORDER BY VOUCHERDATE
                        
                 
                        
                        ) X
                
                ```
        }
