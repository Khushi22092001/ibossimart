            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Location
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT 1 FROM PARTY WHERE 1 != 1
        }
    )

