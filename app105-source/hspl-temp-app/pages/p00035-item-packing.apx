page 35 (
    name: "Item Packing "
    alias: ITEM-PACKING
    title: "Item Packing "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region item-packing (
        name: Item Packing
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
                t-Region--scrollBody
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region item-packing-2 (
        name: Item Packing
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                       row_number() over(order by a.ItemCode) SerialNo,
                       e.ItemName,
                       ee.ItemSpecificationName,
                       p.PackingTypeName,
                       a.NoofPiece,
                       a.QuantityinonePiece,
                       a.PerunitWeight,
                       a.CurrentMRP,
                       a.PremiumRate,
                       round(a.PackingCost,2) as PackingCost,
                       round(a.OtherCost,2) as OtherCost,
                       a.Formula,
                       a.Creator,
                       a.Remark
                  From ItemPacking a, Item e, ItemSpecification ee, packingtype p
                 Where a.ItemCode = e.ItemCode(+)
                   And a.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                   And a.packingtypecode = p.packingtypecode(+)
                   And (:P35_ITEM Is Null Or
                       instr(':' || :P35_ITEM || ':', ':' || e.ItemCode || ':') > 0)
                 Order By 1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
            reset: false
            help: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: [
                csv
                html
            ]
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 1000
        }
        advanced {
            savedReportMappingIdentifier: 4515726707684304
        }

