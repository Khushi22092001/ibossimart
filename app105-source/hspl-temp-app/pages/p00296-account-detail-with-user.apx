page 296 (
    name: Account Detail with User
    alias: ACCOUNT-DETAIL-WITH-USER
    title: Account Detail with User
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region account-detail-with-user (
        name: Account Detail With User
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                   row_number() over(order by a.PartyCode) SerialNo,
                   a.PartyCode as AccountCode,
                   a.PartyName as AccountName,
                   b.PartyName as ParentName,
                   c.PartyTypeName,
                   d.BossuserName,
                   trunc(a.CreationTime) as CreationTime
                from party a, Party b, PartyType c, BossUser d
                Where a.ParentCode = b.PartyCode(+)
                   and a.PartyTypeCode = c.PartyTypeCode(+)
                   and a.Creator = d.LoginName(+)
                   and Trunc(a.CreationTime) between  :P296_FROMDATE AND :P296_TODATE
                   and ( :P296_ACCOUNTTYPE IS NULL OR instr(':'||:P296_ACCOUNTTYPE||':',':'||c.PartyTypeCode||':') > 0 )
                   and ( :P296_USER IS NULL OR instr(':'||:P296_USER||':',':'||d.LoginName||':') > 0 )  ;
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 20579422430980411
        }

        column ACCOUNTCODE (
            type: plainText
            heading {
                heading: Account Code
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column ACCOUNTNAME (
            type: plainText
            heading {
                heading: Account Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column BOSSUSERNAME (
            type: plainText
            heading {
                heading: Boss User
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column PARENTNAME (
            type: plainText
            heading {
                heading: Parent Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column PARTYTYPENAME (
            type: plainText
            heading {
                heading: Partytype Name
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }

        savedReport 207505 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTCODE (
                sequence: 1
            )

            displayColumn ACCOUNTNAME (
                sequence: 2
            )

            displayColumn BOSSUSERNAME (
                sequence: 5
            )

            displayColumn CREATIONTIME (
                sequence: 6
            )

            displayColumn PARENTNAME (
                sequence: 3
            )

            displayColumn PARTYTYPENAME (
                sequence: 4
            )

        )

    )

    pageItem P296_ACCOUNTTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Account Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select Distinct
                b.PartyTypeName d,
                b.PartyTypeCode r
                From Party a, PartyType b
                Where a.PartyTypeCode = b.PartyTypeCode 
                ```
        }
        layout {
            sequence: 30
            region: @account-detail-with-user
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P296_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @account-detail-with-user
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
            labelColumnSpan: 2
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P296_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @account-detail-with-user
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            columnCssClasses: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P296_USER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: User
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                b.BossuserName d,
                b.LoginName r
                From Party a, BossUser b
                Where a.Creator = b.LoginName(+)
                ```
        }
        layout {
            sequence: 40
            region: @account-detail-with-user
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 7
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 50
            region: @account-detail-with-user
            slot: regionBody
            column: 11
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

