page 369 (
    name: Sr. No Wise Accessories Management Report
    alias: SR-NO-WISE-ACCESSORIES-MANAGEMENT-REPORT
    title: Sr. No Wise Accessories Management Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
                overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                 Select
                     row_number() over(order by a.ItemOpeningDate) SerialNo,
                     a.ItemOpeningDate,
                     a.ItemOpeningNo,
                     c.ItemName,
                     d.ItemSpecificationName,
                     b.CompanySerialNo,
                     f.IssueNo,
                     f.IssueDate,
                     f.CostCentreName,
                     g.AccessoriesManagementNo,
                     g.AccessoriesManagementDate,
                     h.EquipmentName
                From ItemOpening a, ItemOpeningSerialNo b, Item c, ItemSpecification d, Stock e,
                (
                 Select
                 f.StockTno,
                 g.IssueNo,
                 g.IssueDate,
                 g3.CostCentreName
                 From IssueStockDetail f,Issue g, Issuedetail g1, IssueCostCentreDetail g2, CostCentre g3
                 Where f.Tno = g.Tno
                 and g.Tno = g1.Tno
                 and g1.Tno = g2.Tno
                 and g1.Sno = g2.Sno
                 and g2.CostCentreCode = g3.CostCentreCode) f, AccessoriesManagement g, Equipment h
                Where a.Tno = b.Tno
                and a.ItemCode = c.ItemCode
                and a.ItemSpecificationCode = d.ItemSpecificationCode
                and a.Tno = e.StockModuleTno
                and e.Tno = f.StockTno
                and b.CompanySerialNo = g.SerialNo
                and g.SourceEquipmentTno = h.Tno
                and b.CompanySerialNo IS NOT NULL
                and ( :P369_COMPANY IS NULL OR instr(':'||:P369_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                and a.ItemOpeningDate BETWEEN  :P369_FROMDATE AND :P369_TODATE
                and ( :P369_LOCATION IS NULL OR instr(':'||:P369_LOCATION||':',':'||a.LocationCode||':') > 0 )
                and ( :P369_SERIALNO IS NULL OR instr(':'||:P369_SERIALNO||':',':'||b.CompanySerialNo||':') > 0 )
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                UNION ALL
                Select
                     row_number() over(order by a.GRNDate) SerialNo,
                     a.GRNDate,
                     a.GRNNo,
                     d.ItemName,
                     e.ItemSpecificationName,
                     c.CompanySerialNo,
                     h.IssueNo,
                     h.IssueDate,
                     h.CostCentreName,
                     i.AccessoriesManagementNo,
                     i.AccessoriesManagementDate,
                     j.EquipmentName
                From GRN a, GRNDetail b, GRNSerialNo c, Item d, ItemSpecification e,Inspection f, Stock g,
                (
                Select
                a.StockTno,
                c.IssueNo,
                c.IssueDate,
                e.CostCentreName,
                g.ComponentSerialNo
                From IssueStockStorageDetail a,IssueDetail b, Issue c, IssueCostCentreDetail d, CostCentre e, 
                ISSUEDETAILSERIALNO f, ComponentStock g
                Where a.Tno = b.Tno
                and a.Sno = b.Sno
                and b.Tno = c.Tno
                and b.Tno = d.Tno
                and b.Sno = d.Sno
                and d.CostCentreCode = e.CostCentreCode
                and b.Tno = f.Tno
                and b.Sno = f.Sno
                and f.ComponentStockTNo = g.TNo
                ) h, AccessoriesManagement i, Equipment j
                Where a.Tno = b.Tno 
                and b.Tno = c.Tno 
                and b.Sno = c.Sno
                and b.ItemCode = d.ItemCode
                and b.ItemSpecificationCode = e.ItemSpecificationCode
                and a.Tno = f.GRNTno
                and f.Tno = g.StockModuleTno
                and g.Tno = h.StockTno(+)
                and c.CompanySerialNo = h.ComponentSerialNo(+)
                and c.CompanySerialNo = i.SerialNo(+)
                and i.SourceEquipmentTno = j.Tno(+)
                and c.CompanySerialNo IS NOT NULL
                and ( :P369_COMPANY IS NULL OR instr(':'||:P369_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                and a.GRNDate BETWEEN  :P369_FROMDATE AND :P369_TODATE
                and ( :P369_LOCATION IS NULL OR instr(':'||:P369_LOCATION||':',':'||a.LocationCode||':') > 0 )
                and ( :P369_SERIALNO IS NULL OR instr(':'||:P369_SERIALNO||':',':'||c.CompanySerialNo||':') > 0 )
                  -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex());
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
