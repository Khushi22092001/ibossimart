page 108 (
    name: Product Pipeline Stock
    alias: PRODUCT-PIPELINE-STOCK
    title: Product Pipeline Stock
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region product-pipeline-stock (
        name: Product Pipeline Stock
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select MODULECODE,
                       MODULENO,
                       MODULETNO,
                       TRANSACTIONDATE,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       ITEMNAME,
                       QUANTITY1
                  from D_PRODUCT360VIEW_PIPELINESTOCK
                 where ItemCode like nvl(:P108_ITEMCODE,'%')
                   and ItemSpecificationCode like nvl(:P108_ITEMSPECIFICATIONCODE,'%')
                   and ModuleCode like nvl(:P108_MODULECODE,'%')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            compute: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            authorization: @candownload
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 50741469245963816
        }

        column ITEMCODE (
            type: plainText
            heading {
                heading: Item Code
                alignment: center
            }
            layout {
                sequence: 190
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:80px">#ITEMCODE#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column ITEMNAME (
            type: plainText
            heading {
                heading: Item Name
                alignment: center
            }
            layout {
                sequence: 200
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:350px">#ITEMNAME#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: plainText
            heading {
                heading: Item Specification Code
                alignment: center
            }
            layout {
                sequence: 280
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: CP
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: Module
                alignment: center
            }
            layout {
                sequence: 240
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: CL
            }
        )

        column MODULENO (
            type: plainText
            heading {
                heading: Transaction No
                alignment: center
            }
            layout {
                sequence: 250
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: CM
            }
        )

        column MODULETNO (
            type: plainText
            heading {
                heading: Module TNo
                alignment: center
            }
            layout {
                sequence: 260
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: CN
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Base Qty
                alignment: center
            }
            layout {
                sequence: 230
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:60px">#QUANTITY1#</div>
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: W
            }
        )

        column TRANSACTIONDATE (
            type: plainText
            heading {
                heading: Transaction Date
                alignment: center
            }
            layout {
                sequence: 270
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: CO
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Customer Overdue Invoices
        }

        savedReport 68883 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ITEMCODE (
                sequence: 1
            )

            displayColumn ITEMNAME (
                sequence: 2
            )

            displayColumn MODULECODE (
                sequence: 4
            )

            displayColumn MODULENO (
                sequence: 5
            )

            displayColumn QUANTITY1 (
                sequence: 3
            )

            displayColumn TRANSACTIONDATE (
                sequence: 6
            )

            sort (
                column: PBPASSNO
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: QUANTITY2
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: CGST
            )

            aggregate (
                column: SGST
            )

            aggregate (
                column: IGST
            )

            aggregate (
                column: TCS
            )

            aggregate (
                column: OTHERAMOUNT
            )

            aggregate (
                column: TOTALAMOUNT
            )

            aggregate (
                column: DESPATCHQUANTITY
            )

            aggregate (
                column: INVOICEQUANTITY
            )

            aggregate (
                column: BALANCEQUANTITY
            )

        )

    )

    pageItem P108_FROMAGE (
        type: hidden
        layout {
            sequence: 30
            region: @product-pipeline-stock
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P108_ITEMCODE (
        type: hidden
        layout {
            sequence: 50
            region: @product-pipeline-stock
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P108_ITEMSPECIFICATIONCODE (
        type: hidden
        layout {
            sequence: 60
            region: @product-pipeline-stock
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P108_MODULECODE (
        type: hidden
        layout {
            sequence: 70
            region: @product-pipeline-stock
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P108_MONTH (
        type: hidden
        layout {
            sequence: 20
            region: @product-pipeline-stock
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P108_PARTYCODE (
        type: hidden
        layout {
            sequence: 10
            region: @product-pipeline-stock
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P108_TOAGE (
        type: hidden
        layout {
            sequence: 40
            region: @product-pipeline-stock
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

