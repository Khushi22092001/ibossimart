page 500 (
    name: Monthly Salary Report (Location Wise)
    alias: MONTHLY-SALARY-REPORT-LOCATION-WISE
    title: Monthly Salary Report (Location Wise)
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region monthly-salary-report-location-wise (
        name: Monthly Salary Report (Location Wise)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select GetLocationName(x.Location) Location,
                       x.Location LocationCode,
                       x.Monthh,
                       Count(x.Employee) No_Of_Employee,
                       SUM(x.PR)Present_Days,
                       SUM(x.AB)Absent_Days,
                       SUM(x.WH) W_H,
                       0 Leave_Days,
                       SUM(x.PD)Paid_Days,
                       SUM(x.GS)GRoss_Salary,
                       SUM(x.PT)PT,
                       SUM(x.PF)PF,
                       SUM(x.ESIC)ESIC,
                       SUM(x.ADVANCE)ADVANCE,
                       SUM(x.MESS)MESS,
                       SUM(x.TDS)TDS,
                       SUM(x.OD)Other_Deduction,
                       SUM(x.TD)Total_Deduction,
                       SUM(x.NS)Net_Payment,
                       'DETAIL' Detail
                From
                (Select a.LocationCode Location,
                       to_char(a.SalaryFromDate,'MON-YYYY') Monthh,
                       a.EmployeeCode Employee,
                       sum(NVL((decode(b.SalaryHeadCode, 'PR', b.SalaryHeadAmount)),0)) PR,
                       sum(NVL((decode(b.SalaryHeadCode, 'AB', b.SalaryHeadAmount)),0)) AB,
                       sum(NVL((decode(b.SalaryHeadCode, 'WD', b.SalaryHeadAmount)),0))  +
                       sum(NVL((decode(b.SalaryHeadCode, 'NH', b.SalaryHeadAmount)),0))  +
                       sum(NVL((decode(b.SalaryHeadCode, 'OH', b.SalaryHeadAmount)),0)) WH,
                       sum(NVL((decode(b.SalaryHeadCode, 'PD', b.SalaryHeadAmount)),0)) PD,
                       sum(NVL((decode(b.SalaryHeadCode, 'GROSSSALARY', b.SalaryHeadAmount)),0)) GS,
                       sum(NVL((decode(b.SalaryHeadCode, 'PTAX', b.SalaryHeadAmount)),0)) PT,
                       sum(NVL((decode(b.SalaryHeadCode, 'PFEMPLOYEE', b.SalaryHeadAmount)),0)) PF,
                       sum(NVL((decode(b.SalaryHeadCode, 'ESICEMPLOYEECONTRIBUTION', b.SalaryHeadAmount)),0)) ESIC,
                       SUM(NVL((decode(b.salaryheadcode, 'RUNNINGADVANCEDED', b.SalaryHeadAmount)),0)) +
                       sum(NVL((decode(b.SalaryHeadCode, 'SALARYADVANCEDED', b.SalaryHeadAmount)),0)) ADVANCE,
                       sum(NVL((decode(b.SalaryHeadCode, 'CANTEENDED', b.SalaryHeadAmount)),0)) MESS,
                       SUM(NVL((decode(b.salaryheadcode, 'TDS', b.SalaryHeadAmount)),0))  TDS,
                       SUM(NVL((decode(b.salaryheadcode, 'OTHERDEDUCTION', b.SalaryHeadAmount)),0)) OD,
                       SUM(NVL((decode(b.salaryheadcode, 'GROSSDEDUCTION', b.SalaryHeadAmount)),0)) TD,
                       SUM(NVL((decode(b.salaryheadcode, 'NETEARNING', b.SalaryHeadAmount)),0)) NS
                From   Salary a,SalaryDetail b
                Where  a.TNo = b.TNo(+)
                  --and  a.LOcationCode = 'JAYANT OB'
                  and  to_char(a.SalaryFromDate,'MON-YYYY') = :P500_MONTH
                  and ( :P500_LOCATION IS NULL OR instr(':'||:P500_LOCATION||':',':'||a.LocationCode||':') > 0 )
                Group By a.LocationCode,
                       to_char(a.SalaryFromDate,'MON-YYYY'),
                       a.EmployeeCode
                       )x
                Group By x.Location,
                         x.Monthh
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        download {
            authorization: @candownload
        }
        advanced {
            savedReportMappingIdentifier: 24559579821105000
        }

        column ABSENT_DAYS (
            type: plainText
            heading {
                heading: Absent Days
                alignment: end
            }
            layout {
                sequence: 5
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ADVANCE (
            type: plainText
            heading {
                heading: Advance
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: L
            }
        )

        column DETAIL (
            type: link
            heading {
                heading: Detail
                alignment: center
            }
            layout {
                sequence: 47
            }
            link {
                target: {
                    page: 503
                    items: {
                        P503_LOCATION: #LOCATIONCODE#
                        P503_MONTH: &P500_MONTH.
                    }
                    clearCache: 503
                }
                linkText: #DETAIL#
                linkAttributes: class="t-Button t-Button--simple t-Button--hot t-Button--stretch"
