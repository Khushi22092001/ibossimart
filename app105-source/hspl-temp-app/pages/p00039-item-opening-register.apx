    region item-opening-report (
        name: Item Opening Report
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent1
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region item-opening-report-2 (
        name: Item Opening Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      row_number() over(order by a.ItemOpeningDate) SerialNo,
                      a.TNO,
                      l.LocationName,
                      dt.DocTypeName,
                      a.ItemOpeningNo,
                      a.ItemOpeningDate,
                      e.itemCOde,
                      e.ItemName||' ~ '||ee.ItemSpecificationName AS Material,
                      ee.ItemSpecificationCode,
                      ee.ItemSpecificationName,
                      e.MeasuringUnitCode1,
                      e.MeasuringUnitCode2,
                      sl.StorageLocationName,
                      dsd.DocumentStatusCode,
                      a.OpeningQuantity1,
                      a.OpeningQuantity2,
                      a.OpeningValue,
                      a.OpeningValue /  a.OpeningQuantity1 as Rate,
                      GetEmployeeName(bu.EmployeeCode)||' ( '||a.Creator||' )' Creator,
                      a.CreationTime,
                      ios.CompanySerialNo
                From  ItemOpening a, Location l, DocType dt, StorageLocation sl, item e, ItemSpecification ee, DocumentStatusDetail dsd, BossUser bu, ItemOpeningSerialNo ios
                Where a.LocationCode = l.LocationCode(+)
                  and a.DocTypeCode = dt.DocTypeCode(+)
                  and a.StorageLocationCode = sl.StorageLocationCode(+)
                  and a.ItemCOde = e.ItemCode(+)
                  and a.ItemSpecificationCode = ee.ItemSpecificationCode(+)
                  and a.TNo = dsd.ModuleTNo(+)
                  and a.Creator = bu.LoginName(+)
                  and a.Tno = ios.Tno(+)
                  and a.ItemOpeningDate >= '30-JUN-2021'
                  and instr(':'||:P39_COMPANY||':',':'||a.CompanyCode||':') > 0
                  and instr(':'||:P39_LOCATION||':',':'||a.LocationCode||':') > 0
                  and instr(':'||:P39_DOCTYPE||':',':'||a.DocTypeCode||':') > 0
                  and ( :P39_ITEM IS NULL OR instr(':'||:P39_ITEM||':',':'||a.ItemCode||':') > 0 )
                  and ( :P39_SPECIFICATION IS NULL OR instr(':'||:P39_SPECIFICATION||':',':'||a.ItemSpecificationCode||':') > 0 ) 
                  /* Changed on 28-may-2022
                  and ( :P39_GROUP IS NULL OR instr(':'||:P39_GROUP||':',':'||e.ParentCode||':') > 0 ) 
                  */
                    -- 22-APR-2025
                  and ( GetUserPanelAB_apex() is null  or a.panel = GetUserPanelAB_apex())
                  and ( :P39_GROUP IS NULL
                      or
                      exists (select 1 from (Select ITEMCODE,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                               Level,
                               CONNECT_BY_ROOT itemcode As root_id,
                               --'-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From item a
                         Start With parentcode in ( select itemcode from item xx where
                                                    instr(':'||:P39_GROUP||':',':'||xx.ItemCode||':') > 0)
                                                    
                        Connect By parentcode = Prior itemcode
                         Order Siblings By itemcode) x where x.itemcode = e.itemcode
                        )
                  )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: t-Form--search
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            flashback: false
