page 203 (
    name: Transportation
    alias: TRANSPORTATION
    title: Transportation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: REPORT
        type: list
        source {
            list: @transportation
        }
        layout {
            sequence: 20
            slot: body
            columnCssClasses: hspl-module-tiles
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            listTemplate: @/media-list
            templateOptions: [
                #DEFAULT#
                t-MediaList--showBadges
                u-colors
                t-MediaList--cols t-MediaList--4cols
            ]
        }
    )

)

