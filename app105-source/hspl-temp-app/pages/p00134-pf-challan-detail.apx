    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: No help is available for this page.
    }

    region pf-challan (
        name: "PF Challan "
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: hspl-drawer
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pf-challan-detail (
        name: PF Challan Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.EMPLOYEECODE,
                       GETEMPLOYEEEMPLOYEEID(A.EMPLOYEECODE,C.FORMONTH) AS EMPID,
                       GETEMPLOYEENAME(A.EMPLOYEECODE) As EmployeeName,
                       a.age,
                       a.pfdeductedonamount,
                       a.pfamount,
                       a.employerpfaccount01amount,
                       a.employerpfaccount10amount,
                       --  a.employerpfaccount21amount,
                       a.employeepfaccount01amount,
                       a.adminpfaccount02amount,
                       -- a.adminpfaccount22amount,
                       a.adminpfaccount21amount
                  From PFCHALLANDETAIL A, Employee b, PFCHALLAN C
                 Where a.employeecode = b.employeecode
                  and a.tno = c.tno 
                  and ( A.TNO = :P134_TNO
                        OR
                        (
                            c.formonth between :P134_FROMDATE and :P134_TODATE     
                            and instr(':'||:P134_COMPANY||':',':'||c.CompanyCode||':') > 0
                            and instr(':'||:P134_LOCATION||':',':'||c.LocationCode||':') > 0
                            and ( :P134_EMPLOYEE IS NULL OR instr(':'||:P134_EMPLOYEE||':',':'||a.EmployeeCode||':') > 0 ) 
                            and ( :P134_DEPARTMENT IS NULL OR instr(':'||:P134_DEPARTMENT||':',':'||getemployeedepartmentcode(a.EmployeeCode,c.formonth)||':') > 0 ) 
                            and ( :P134_DESIGNATION IS NULL OR instr(':'||:P134_DESIGNATION||':',':'||getemployeedesignationcode(a.EmployeeCode,c.formonth)||':') > 0 ) 
                        )
                  )
                 Order By 2
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 100000
        }
        actionsMenu {
            chart: false
            groupBy: false
            pivot: false
            flashback: false
            reset: false
            subscription: false
        }
        download {
