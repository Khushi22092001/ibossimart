            templateOptions: [
                #DEFAULT#
                t-Button--iconRight
            ]
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-clear (
            action: clear
            affectedElements {
                selectionType: items
                items: P134_TNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
