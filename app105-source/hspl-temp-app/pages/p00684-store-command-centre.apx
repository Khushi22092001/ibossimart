    region capital-register (
        name: Capital Issue Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Issues where Issue.DocTypeCode = CAPITAL. This is a REGISTER rather
                   than an analytics dashboard on purpose: capital volume in this
                   database is 9 documents and 15 lines, and only one of those lines
                   carries a value at all, so project trends, month-over-month growth
                   and year-on-year comparison would be charts of a single point.
                   COSTED flags the lines that were valued, so the gap is visible
                   rather than silently averaged away.
                
                   Work centre comes via CostCentre.WorkCentreCode because no issue
                   table carries one directly, and only one distinct work centre is
                   populated database-wide - it is here for traceability, not analysis. */
                Select a.Tno                                    As ISSUETNO,
                       nvl(a.IssueNo,'(unnumbered)')            As ISSUE_NO,
                       to_char(a.IssueDate,'DD-MM-RRRR')        As ISSUE_DATE,
                       nvl(a.LocationName, a.LocationCode)      As LOCATION,
                       nvl(a.DepartmentName, a.DepartmentCode)  As DEPARTMENT,
                       nvl(a.CostCentreName, a.CostCentreCode)  As COST_CENTRE,
                       nvl(wc.WorkCentreName, nvl(cc.WorkCentreCode,'-')) As WORK_CENTRE,
                       a.ItemCode                               As ITEMCODE,
                       nvl(a.ItemName, a.ItemCode)              As ITEM,
                       nvl(sp.ItemSpecificationName,'-')        As SPECIFICATION,
                       Round(nvl(a.Quantity1,0),3)              As QUANTITY,
                       nvl(it.MeasuringUnitCode1,'-')           As UNIT,
                       Round(nvl(a.Amount,0),2)                 As CAPITAL_VALUE,
                       Case When nvl(a.Amount,0) > 0 Then 'Costed' Else 'Not costed' End As COSTED,
                       nvl(a.IssueToEmployee,'-')               As ISSUED_TO,
                       nvl(a.UserRaisedBy,'-')                  As ISSUED_BY,
                       nvl(a.RequisitionNo,'-')                 As REQUISITION_NO
                  From IssueRegister a
                  Left Join CostCentre cc        On cc.CostCentreCode = a.CostCentreCode
                  Left Join WorkCentre wc        On wc.WorkCentreCode = cc.WorkCentreCode
                  Left Join Item it              On it.ItemCode = a.ItemCode
                  Left Join ItemSpecification sp On sp.ItemSpecificationCode = a.ItemSpecificationCode
                 Where a.DocTypeCode = 'CAPITAL'
                   And a.IssueDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                   And a.IssueDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                   And (:P684_PANEL    Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P684_PANEL)
                   And (:P684_COMPANY  Is Null Or a.CompanyCode  = :P684_COMPANY)
                   And (:P684_LOCATION Is Null Or a.LocationCode = :P684_LOCATION)
                   And (:P684_ITEM     Is Null Or a.ItemCode     = :P684_ITEM)
                 Order By a.IssueDate Desc, a.Tno
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
            ]
        }
        layout {
            sequence: 77
            slot: body
        }
