            title: Value (₹ Lac)
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region mom-table (
        name: Month on Month Movement
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Month-on-month, not year-on-year: this database holds a single
                   financial year (26-27, April onward), so there is no prior year to
                   compare against, but there ARE several months and the movement
                   between them is real. LAG walks the previous month within the
                   selection, so the comparison always follows the filters rather than
                   being computed against a fixed baseline.
                
                   The first month in range legitimately has no predecessor, so its
                   change columns are null rather than a misleading 100% growth, and
                   TREND says "First month in range" instead of inventing a direction. */
                With M As (
                  Select trunc(a.IssueDate,'MM')                 Mth,
                         Count(Distinct a.Tno)                   Docs,
                         Count(*)                                Lines_,
                         Count(Distinct a.ItemCode)              Items_,
                         Count(Distinct a.DepartmentCode)        Depts_,
                         nvl(Sum(a.Quantity1),0)                 Qty,
                         nvl(Sum(a.Amount),0)                    Val,
                         nvl(Sum(Case When a.DocTypeCode =  'CAPITAL' Then nvl(a.Amount,0) End),0) CapVal,
                         nvl(Sum(Case When a.DocTypeCode <> 'CAPITAL' Then nvl(a.Amount,0) End),0) RevVal
                    From IssueRegister a
                   Where a.IssueDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                     And a.IssueDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_PANEL    Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P684_PANEL)
                     And (:P684_COMPANY  Is Null Or a.CompanyCode  = :P684_COMPANY)
                     And (:P684_LOCATION Is Null Or a.LocationCode = :P684_LOCATION)
                     And (:P684_ITEM     Is Null Or a.ItemCode     = :P684_ITEM)
                   Group By trunc(a.IssueDate,'MM'))
                Select to_char(m.Mth,'MON-RRRR')                       As MONTH_,
                       to_char(m.Mth,'YYYYMM')                         As SORTKEY,
                       to_char(m.Mth,'DD-MM-RRRR')                      As MONTH_FROM,
                       to_char(last_day(m.Mth),'DD-MM-RRRR')            As MONTH_TO,
                       m.Docs                                          As ISSUE_DOCS,
                       m.Lines_                                        As ISSUE_LINES,
                       m.Items_                                        As ITEMS,
                       m.Depts_                                        As DEPARTMENTS,
                       Round(m.Qty,3)                                  As QUANTITY,
                       Round(m.Val,2)                                  As ISSUE_VALUE,
                       Round(m.CapVal,2)                               As CAPITAL_VALUE,
                       Round(m.RevVal,2)                               As REVENUE_VALUE,
                       Round(Lag(m.Val) Over (Order By m.Mth),2)       As PREV_MONTH_VALUE,
                       Round(m.Val - Lag(m.Val) Over (Order By m.Mth),2) As CHANGE_VALUE,
                       Round(Case When Lag(m.Val) Over (Order By m.Mth) > 0
                                  Then (m.Val - Lag(m.Val) Over (Order By m.Mth))
                                       / Lag(m.Val) Over (Order By m.Mth) * 100 End,1) As CHANGE_PCT,
                       Case When Lag(m.Val) Over (Order By m.Mth) Is Null Then 'First month in range'
                            When m.Val > Lag(m.Val) Over (Order By m.Mth) Then 'Up'
                            When m.Val < Lag(m.Val) Over (Order By m.Mth) Then 'Down'
                            Else 'Flat' End                             As TREND
                  From M m
                 Order By m.Mth
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
            ]
        }
