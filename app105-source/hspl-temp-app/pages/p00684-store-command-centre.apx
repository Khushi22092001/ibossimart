            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: ds-filter-trigger
            icon: fa-sliders
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.theme.openRegion('p684Drawer');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-filters (
        buttonName: RESETFILTERS
        label: Reset All Filters
        layout {
            sequence: 100
            region: @filter-drawer
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-times
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 684
                clearCache: 684
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction issue-card-drill (
        name: Issue Card Drilldown
        execution {
            sequence: 30
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .ds-idrill
        }

        action idrill-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @issue-class-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action idrill-scroll (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var r = document.getElementById("p684IssueDetail");
                    if (r) { r.scrollIntoView({behavior:"smooth", block:"start"}); }
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action idrill-set (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /* The card is an anchor so it looks and hovers like the others;
                       preventDefault stops the href="#" from jumping to the top. */
                    var el = this.triggeringElement;
                    if (this.browserEvent) { this.browserEvent.preventDefault(); }
                    if (el && el.dataset && el.dataset.k) {
                      apex.item("P684_ISSUE_FOCUS").setValue(el.dataset.k);
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction req-card-drill (
        name: Requisition Card Drilldown
        execution {
            sequence: 40
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .ds-rdrill
        }

        action rdrill-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @req-fulfil-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action rdrill-scroll (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var r = document.getElementById("p684ReqDetail");
                    if (r) { r.scrollIntoView({behavior:"smooth", block:"start"}); }
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action rdrill-set (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var el = this.triggeringElement;
                    if (this.browserEvent) { this.browserEvent.preventDefault(); }
                    if (el && el.dataset && el.dataset.k) {
                      apex.item("P684_REQ_FOCUS").setValue(el.dataset.k);
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

