    region pending-requisitions (
        name: Open Requisitions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Open = requested quantity not yet fully issued. RequisitionDetail
                   carries IssuedQuantity1 against the requested Quantity1, and
                   DocumentStatusCode is not populated in this database, so the
                   quantity comparison is the only reliable open/closed signal. */
                Select r.Tno                                        As REQTNO,
                       r.RequisitionNo                              As REQNO,
                       to_char(r.RequisitionDate,'DD-MM-RRRR')      As REQDATE,
                       trunc(sysdate) - trunc(r.RequisitionDate)    As AGE_DAYS,
                       nvl(l.LocationName, r.LocationCode)          As LOCATION,
                       nvl(dp.DepartmentName, r.DepartmentCode)     As DEPARTMENT,
                       r.DocTypeCode                                As DOCTYPE,
                       nvl(i.ItemName, d.ItemCode)                  As ITEMNAME,
                       d.ItemCode                                   As ITEMCODE,
                       Round(nvl(d.Quantity1,0),3)                  As REQ_QTY,
                       Round(nvl(d.IssuedQuantity1,0),3)            As ISSUED_QTY,
                       Round(nvl(d.Quantity1,0)-nvl(d.IssuedQuantity1,0),3) As PENDING_QTY,
                       Case When trunc(sysdate) - trunc(r.RequisitionDate) > 60 Then 'Critical'
                            When trunc(sysdate) - trunc(r.RequisitionDate) > 30 Then 'Overdue'
                            Else 'Within 30 days' End              As AGEING_FLAG,
                       nvl(nvl(er.EmployeeName, r.EmployeeCode),'-') As RAISED_BY
                  From Requisition r
                  Join RequisitionDetail d On d.Tno = r.Tno
                  Left Join Location l   On l.LocationCode   = r.LocationCode
                  Left Join Department dp On dp.DepartmentCode = r.DepartmentCode
                  Left Join Item i       On i.ItemCode       = d.ItemCode
                  Left Join Employee er  On er.EmployeeCode  = r.EmployeeCode
                 Where nvl(d.Quantity1,0) - nvl(d.IssuedQuantity1,0) > 0.001
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or r.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P684_PANEL     Is Null Or r.Panel        = :P684_PANEL)
                   And (:P684_COMPANY   Is Null Or r.CompanyCode  = :P684_COMPANY)
                   And (:P684_LOCATION  Is Null Or r.LocationCode = :P684_LOCATION)
                   And (:P684_ITEM      Is Null Or d.ItemCode     = :P684_ITEM)
                   And (:P684_ITEMGROUP Is Null Or d.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP))
                 Order By 4 Desc
                ```
            pageItemsToSubmit: [
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_ITEM
            ]
        }
