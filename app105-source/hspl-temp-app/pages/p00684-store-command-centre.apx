                type: redirectThisApp
                target: {
                    page: 684
                    items: {
                        P684_TODATE: &P684_TODATE.
                        P684_COMPANY: &P684_COMPANY.
                        P684_LOCATION: &LOC.
                        P684_PANEL: &P684_PANEL.
                        P684_ITEMGROUP: &P684_ITEMGROUP.
                        P684_ITEM: &P684_ITEM.
                    }
                }
            }
        )

