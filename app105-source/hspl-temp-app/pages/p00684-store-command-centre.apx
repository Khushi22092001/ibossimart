    region req-fulfil-detail (
        name: Requisitions Behind the Card
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Driven by P684_REQ_FOCUS, which the cards above set: NONE, PART, FULL
                   or ALL. The bucket arithmetic is identical to the cards so the row
                   count always reconciles to the number on the card that was clicked. */
                With R As (
                  Select r.Tno,
                         Sum(nvl(d.Quantity1,0))       ReqQty,
                         Sum(nvl(d.IssuedQuantity1,0)) IssQty,
                         Count(*)                      Lines_,
                         Count(Distinct d.ItemCode)    Items_
                    From Requisition r Join RequisitionDetail d On d.Tno = r.Tno
                   Where r.RequisitionDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                     And r.RequisitionDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or r.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_PANEL    Is Null Or r.Panel        = :P684_PANEL)
                     And (:P684_COMPANY  Is Null Or r.CompanyCode  = :P684_COMPANY)
                     And (:P684_LOCATION Is Null Or r.LocationCode = :P684_LOCATION)
                     And (:P684_ITEM     Is Null Or d.ItemCode     = :P684_ITEM)
                   Group By r.Tno)
                Select r.Tno                                        As REQTNO,
                       nvl(r.RequisitionNo,'(unnumbered)')          As REQNO,
                       to_char(r.RequisitionDate,'DD-MM-RRRR')      As REQDATE,
                       trunc(sysdate) - trunc(r.RequisitionDate)    As AGE_DAYS,
                       Case When x.IssQty <= 0.001 Then 'Not issued'
                            When x.IssQty < x.ReqQty - 0.001 Then 'Short issued'
                            Else 'Fully issued' End                 As FULFILMENT,
                       nvl(r.DocTypeCode,'-')                       As DOCTYPE,
                       nvl(l.LocationName, r.LocationCode)          As LOCATION,
                       nvl(dp.DepartmentName, r.DepartmentCode)     As DEPARTMENT,
                       nvl(nvl(er.EmployeeName, r.EmployeeCode),'-')        As RAISED_BY,
                       nvl(nvl(ei.EmployeeName, r.IssueToEmployeeCode),'-') As ISSUE_TO,
                       x.Items_                                     As ITEMS,
                       x.Lines_                                     As LINES,
                       Round(x.ReqQty,3)                            As REQUESTED_QTY,
                       Round(x.IssQty,3)                            As ISSUED_QTY,
                       Round(x.ReqQty - x.IssQty,3)                 As SHORT_QTY,
                       (Select Count(*) From Issue i2 Where i2.RequisitionTno = r.Tno) As ISSUE_DOCS
                  From R x
                  Join Requisition r      On r.Tno = x.Tno
                  Left Join Location l    On l.LocationCode = r.LocationCode
                  Left Join Department dp On dp.DepartmentCode = r.DepartmentCode
                  Left Join Employee er   On er.EmployeeCode = r.EmployeeCode
                  Left Join Employee ei   On ei.EmployeeCode = r.IssueToEmployeeCode
                 Where nvl(:P684_REQ_FOCUS,'ALL') = 'ALL'
                    Or (:P684_REQ_FOCUS = 'NONE' And x.IssQty <= 0.001)
                    Or (:P684_REQ_FOCUS = 'PART' And x.IssQty > 0.001 And x.IssQty < x.ReqQty - 0.001)
                    Or (:P684_REQ_FOCUS = 'FULL' And x.IssQty >= x.ReqQty - 0.001)
                 Order By 4 Desc
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
                P684_REQ_FOCUS
            ]
        }
