    region inout-trend (
        name: Stock In vs Stock Out
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Receipts are layers created in the month; issues are consumption
                   booked in the month valued at the rate of the layer drawn from. */
                Select LBL, SRT,
                       Round(Sum(InV)/100000,2)  As IN_LAC,
                       Round(Sum(OutV)/100000,2) As OUT_LAC
                  From (
                    Select to_char(s.StockDate,'MON-YY') LBL, to_char(s.StockDate,'YYYYMM') SRT,
                           s.StockQuantity1 * s.Rate InV, 0 OutV
                      From Stock s
                     Where s.StockDate < to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                       And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                       And (:P684_PANEL     Is Null Or s.Panel        = :P684_PANEL)
                       And (:P684_COMPANY   Is Null Or s.CompanyCode  = :P684_COMPANY)
                       And (:P684_LOCATION  Is Null Or s.LocationCode = :P684_LOCATION)
                       And (:P684_ITEM      Is Null Or s.ItemCode     = :P684_ITEM)
                       And (:P684_ITEMGROUP Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP))
                    Union All
                    Select to_char(u.UsedStockDate,'MON-YY'), to_char(u.UsedStockDate,'YYYYMM'),
                           0, u.UsedStockQuantity1 * s.Rate
                      From UsedStock u Join Stock s On s.Tno = u.StockTno
                     Where u.UsedStockDate < to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                       And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                       And (:P684_PANEL     Is Null Or s.Panel        = :P684_PANEL)
                       And (:P684_COMPANY   Is Null Or s.CompanyCode  = :P684_COMPANY)
                       And (:P684_LOCATION  Is Null Or s.LocationCode = :P684_LOCATION)
                       And (:P684_ITEM      Is Null Or s.ItemCode     = :P684_ITEM)
                       And (:P684_ITEMGROUP Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP)))
                 Group By LBL, SRT
                 Order By SRT
                ```
            pageItemsToSubmit: [
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_ITEM
            ]
        }
