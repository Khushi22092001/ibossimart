    region storageloc-chart (
        name: Inventory by Storage Location
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Stock value by physical storage location (21 stores). A slice drills the
                   whole dashboard to that store. Same stock-layer balance model. */
                With Bnd As (Select to_date(:P684_TODATE,'DD-MM-RRRR') + 1 D2 From dual),
                     Bal As (
                       Select s.StorageLocationCode Sl, s.Rate, s.StockQuantity1 - nvl(u.Used,0) Qty
                         From Stock s Cross Join Bnd b
                         Left Join (Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                                      From UsedStock us Cross Join Bnd b2
                                     Where us.UsedStockDate < b2.D2 Group By us.StockTno) u On u.StockTno = s.Tno
                        Where s.StockDate < b.D2
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                          And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                          And (:P684_PANEL           Is Null Or s.Panel               = :P684_PANEL)
                          And (:P684_COMPANY         Is Null Or s.CompanyCode         = :P684_COMPANY)
                          And (:P684_LOCATION        Is Null Or s.LocationCode        = :P684_LOCATION)
                          And (:P684_ITEMGROUP       Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP)))
                Select nvl(nvl((Select sl.StorageLocationName From StorageLocation sl Where sl.StorageLocationCode = b.Sl), b.Sl), 'Unassigned') As LBL,
                       b.Sl As SLCODE,
                       Round(Sum(b.Qty*b.Rate)/100000,2) As VAL_LAC
                  From Bal b
                 Group By b.Sl
                Having Sum(b.Qty*b.Rate) <> 0
                 Order By 3 Desc
                ```
            pageItemsToSubmit: [
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_ITEMCATEGORY
            ]
        }
        layout {
            sequence: 54
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 290
        }
        value {
            format: decimal
            decimalPlaces: 2
            formatScaling: none
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No stock value in the selected scope.
        }

        series storageloc (
            name: Value (₹ Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: LBL
                value: VAL_LAC
            }
            link {
                type: redirectThisApp
                target: {
                    page: 684
                    items: {
                        P684_STORAGELOCATION: &SLCODE.
                        P684_TODATE: &P684_TODATE.
                        P684_COMPANY: &P684_COMPANY.
                        P684_LOCATION: &P684_LOCATION.
                        P684_PANEL: &P684_PANEL.
                        P684_ITEMGROUP: &P684_ITEMGROUP.
                        P684_ITEMCATEGORY: &P684_ITEMCATEGORY.
                    }
                }
            }
        )

    )

    region top-items (
        name: Top Inventory Holdings
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* One row per item: what we hold, how old the holding is, when it last
                   moved and what it consumed in the window.
                
                   PERFORMANCE. The obvious shape - join the layer-level Bal set to two
                   aggregate CTEs and group the result - ran for TWO MINUTES here, because
                   24k layer rows fan out against per-item aggregates that get re-evaluated.
                   Aggregating Bal to item level FIRST (24k rows -> 840) and folding the two
                   movement CTEs into a single pass over UsedStock brings it to under a
                   second. Keep that order: pre-aggregate, then join. */
                With Bnd As (Select to_date(:P684_TODATE,'DD-MM-RRRR') + 1 D2 From dual),
                     Used As (
                       Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                         From UsedStock us Cross Join Bnd b2
                        Where us.UsedStockDate < b2.D2
                        Group By us.StockTno),
                     Bal As (
                       Select s.ItemCode, s.Rate, s.StockQuantity1 - nvl(u.Used,0) Qty,
                              b.D2 - 1 - s.StockDate Age
                         From Stock s Cross Join Bnd b
                         Left Join Used u On u.StockTno = s.Tno
                        Where s.StockDate < b.D2
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                          And (:P684_PANEL           Is Null Or s.Panel               = :P684_PANEL)
                          And (:P684_COMPANY         Is Null Or s.CompanyCode         = :P684_COMPANY)
                          And (:P684_LOCATION        Is Null Or s.LocationCode        = :P684_LOCATION)
                          And (:P684_STORAGELOCATION Is Null Or s.StorageLocationCode = :P684_STORAGELOCATION)
                          And (:P684_ITEM            Is Null Or s.ItemCode            = :P684_ITEM)
                          And (:P684_ITEMGROUP       Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP))),
                     ItemBal As (
                       Select ItemCode, Sum(Qty) Qty, Sum(Qty*Rate) Val, Sum(Qty*Age) QtyDays
                         From Bal Group By ItemCode Having Sum(Qty) <> 0),
                     /* One pass over UsedStock yields both the last movement of any age and
                        the movement inside the idle window, so the window never needs a
                        second scan. */
                     Mv As (
                       Select s.ItemCode,
                              Max(u.UsedStockDate) LastOut,
                              Max(Case When u.UsedStockDate >= b.D2 - nvl(:P684_IDLEDAYS,90) Then u.UsedStockDate End) LastOutWin,
                              Sum(Case When u.UsedStockDate >= b.D2 - nvl(:P684_IDLEDAYS,90) Then u.UsedStockQuantity1 * s.Rate End) OutVal
                         From UsedStock u Join Stock s On s.Tno = u.StockTno Cross Join Bnd b
                        Where u.UsedStockDate < b.D2
                        Group By s.ItemCode)
                Select ib.ItemCode                                  As ITEMCODE,
                       nvl(i.ItemName, ib.ItemCode)                 As ITEMNAME,
                       nvl(g.ItemName, '-')                         As ITEMGROUP,
                       nvl(i.MeasuringUnitCode1,'-')                As UOM,
                       Round(ib.Qty,3)                              As QTY,
                       /* nvl so items whose layers carry no rate read 0.00 and sort last,
                          rather than sorting to the TOP as nulls do in a DESC order. */
                       Round(nvl(ib.Val,0)/100000,2)                As VALUE_LAC,
                       Round(ib.Val/nullif(ib.Qty,0),2)             As AVG_RATE,
                       Round(ib.QtyDays/nullif(ib.Qty,0),0)         As AGE_DAYS,
                       to_char(mv.LastOut,'DD-MM-RRRR')             As LASTISSUE,
                       Round(nvl(mv.OutVal,0)/100000,2)             As CONSUMED_LAC,
                       Case When mv.LastOutWin Is Null Then 'Non moving' Else 'Moving' End As MOVEMENT
                  From ItemBal ib
                  Left Join Item i On i.ItemCode = ib.ItemCode
                  Left Join Item g On g.ItemCode = i.ParentCode
                  Left Join Mv mv  On mv.ItemCode = ib.ItemCode
                 Order By 6 Desc
                ```
            pageItemsToSubmit: [
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_ITEM
                P684_STORAGELOCATION
                P684_IDLEDAYS
            ]
        }
        layout {
            sequence: 65
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 200000
        }
        advanced {
            savedReportMappingIdentifier: 31348437693505229
        }

