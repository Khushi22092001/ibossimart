                value: VAL_LAC
            }
        )

    )

    region ageing-chart (
        name: Stock Ageing Distribution
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Ageing is measured on the balance that REMAINS in each layer, from
                   the date that layer was received. Buckets beyond the current
                   financial year cannot appear because Stock is scoped to it. */
                With Bnd As (Select to_date(:P684_TODATE,'DD-MM-RRRR') + 1 D2 From dual),
                     Bal As (
                       Select s.StockDate, s.Rate, s.StockQuantity1 - nvl(u.Used,0) Qty
                         From Stock s Cross Join Bnd b
                         Left Join (Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                                      From UsedStock us Cross Join Bnd b2
                                     Where us.UsedStockDate < b2.D2 Group By us.StockTno) u On u.StockTno = s.Tno
                        Where s.StockDate < b.D2
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                          And (:P684_PANEL           Is Null Or s.Panel               = :P684_PANEL)
                          And (:P684_COMPANY         Is Null Or s.CompanyCode         = :P684_COMPANY)
                          And (:P684_LOCATION        Is Null Or s.LocationCode        = :P684_LOCATION)
                          And (:P684_STORAGELOCATION Is Null Or s.StorageLocationCode = :P684_STORAGELOCATION)
                          And (:P684_ITEM            Is Null Or s.ItemCode            = :P684_ITEM)
                          And (:P684_ITEMGROUP       Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP)))
                Select Bucket As LBL, Srt, Round(Sum(Qty*Rate)/100000,2) As VAL_LAC
                  From (Select Case When (Select D2 From Bnd) - 1 - StockDate <= 30  Then '0-30 days'
                                    When (Select D2 From Bnd) - 1 - StockDate <= 60  Then '31-60 days'
                                    When (Select D2 From Bnd) - 1 - StockDate <= 90  Then '61-90 days'
                                    When (Select D2 From Bnd) - 1 - StockDate <= 180 Then '91-180 days'
                                    When (Select D2 From Bnd) - 1 - StockDate <= 365 Then '181-365 days'
                                    When (Select D2 From Bnd) - 1 - StockDate <= 730 Then '1-2 years'
                                    Else 'Over 2 years' End Bucket,
                               Case When (Select D2 From Bnd) - 1 - StockDate <= 30  Then 1
                                    When (Select D2 From Bnd) - 1 - StockDate <= 60  Then 2
                                    When (Select D2 From Bnd) - 1 - StockDate <= 90  Then 3
                                    When (Select D2 From Bnd) - 1 - StockDate <= 180 Then 4
                                    When (Select D2 From Bnd) - 1 - StockDate <= 365 Then 5
                                    When (Select D2 From Bnd) - 1 - StockDate <= 730 Then 6
                                    Else 7 End Srt,
                               Qty, Rate
                          From Bal Where Qty <> 0)
                 Group By Bucket, Srt Order By Srt
                ```
            pageItemsToSubmit: [
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_ITEM
                P684_STORAGELOCATION
            ]
        }
