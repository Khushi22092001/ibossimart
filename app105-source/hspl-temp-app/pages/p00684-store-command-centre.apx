    region issue-class-detail (
        name: Issue Documents by Type
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Driven by P684_ISSUE_FOCUS, which the cards above set: CAPITAL,
                   CONSUMPTION, or ALL. Defaults to ALL so the region is never empty
                   on first render. */
                Select a.Tno                                   As ISSUETNO,
                       Max(a.IssueNo)                          As ISSUENO,
                       to_char(Max(a.IssueDate),'DD-MM-RRRR')  As ISSUEDATE,
                       Max(a.DocTypeCode)                      As DOCTYPE,
                       Case When Max(a.DocTypeCode) = 'CAPITAL' Then 'Capital' Else 'Revenue' End As CLASSIFICATION,
                       Max(a.LocationName)                     As LOCATION,
                       Max(a.DepartmentName)                   As DEPARTMENT,
                       Max(a.CostCentreName)                   As COST_CENTRE,
                       Max(a.IssueToEmployee)                  As ISSUED_TO,
                       Count(*)                                As LINES,
                       Count(Distinct a.ItemCode)              As ITEMS,
                       Round(Sum(nvl(a.Quantity1,0)),3)        As QUANTITY,
                       Round(Sum(nvl(a.Amount,0)),2)           As AMOUNT,
                       Round(Sum(nvl(a.NetAmount,0)),2)        As NET_AMOUNT
                  From IssueRegister a
                 Where a.IssueDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                   And a.IssueDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                   And (nvl(:P684_ISSUE_FOCUS,'ALL') = 'ALL' Or a.DocTypeCode = :P684_ISSUE_FOCUS)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                   And (:P684_PANEL    Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P684_PANEL)
                   And (:P684_COMPANY  Is Null Or a.CompanyCode  = :P684_COMPANY)
                   And (:P684_LOCATION Is Null Or a.LocationCode = :P684_LOCATION)
                   And (:P684_ITEM     Is Null Or a.ItemCode     = :P684_ITEM)
                 Group By a.Tno
                 Order By Max(a.IssueDate) Desc
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
                P684_ISSUE_FOCUS
            ]
        }
