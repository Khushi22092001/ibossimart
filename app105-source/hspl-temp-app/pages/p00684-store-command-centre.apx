    region dept-table (
        name: Department Consumption Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* PCT_OF_VALUE is the department's share of issue value in the current
                   selection, computed with a windowed total so it always sums to 100
                   across the rows shown. AVG_PER_DOC divides by documents, not lines,
                   so it reads as "what an average issue slip to this department costs". */
                Select nvl(a.DepartmentName, a.DepartmentCode)      As DEPARTMENT,
                       a.DepartmentCode                             As DEPTCODE,
                       Count(Distinct a.Tno)                        As ISSUE_DOCS,
                       Count(*)                                     As ISSUE_LINES,
                       Count(Distinct a.ItemCode)                   As ITEMS_ISSUED,
                       Round(Sum(nvl(a.Quantity1,0)),3)             As QUANTITY,
                       Round(Sum(nvl(a.Amount,0)),2)                As ISSUE_VALUE,
                       Round(Sum(nvl(a.NetAmount,0)),2)             As NET_VALUE,
                       Round(Sum(nvl(a.Amount,0))/nullif(Count(Distinct a.Tno),0),2) As AVG_PER_DOC,
                       Round(Sum(nvl(a.Amount,0))
                             / nullif(Sum(Sum(nvl(a.Amount,0))) Over (),0) * 100,1)  As PCT_OF_VALUE,
                       Round(nvl(Sum(Case When a.DocTypeCode = 'CAPITAL' Then nvl(a.Amount,0) End),0),2) As CAPITAL_VALUE,
                       Count(Distinct a.CostCentreCode)             As COST_CENTRES,
                       to_char(Max(a.IssueDate),'DD-MM-RRRR')       As LAST_ISSUE
                  From IssueRegister a
                 Where a.IssueDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                   And a.IssueDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                   And a.DepartmentCode Is Not Null
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                   And (:P684_PANEL    Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P684_PANEL)
                   And (:P684_COMPANY  Is Null Or a.CompanyCode  = :P684_COMPANY)
                   And (:P684_LOCATION Is Null Or a.LocationCode = :P684_LOCATION)
                   And (:P684_ITEM     Is Null Or a.ItemCode     = :P684_ITEM)
                 Group By nvl(a.DepartmentName, a.DepartmentCode), a.DepartmentCode
                 Order By 7 Desc
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
            ]
