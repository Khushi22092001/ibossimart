    region issue-register (
        name: Recent Issue Documents
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Document level roll-up of the issue register so the executive view can
                   reach an individual issue slip. Values follow the IssueRegister view,
                   which nets IssueReturnAmount out of Amount as NetAmount. */
                Select a.Tno                                    As ISSUETNO,
                       Max(a.IssueNo)                           As ISSUENO,
                       to_char(Max(a.IssueDate),'DD-MM-RRRR')   As ISSUEDATE,
                       Max(a.LocationName)                      As LOCATION,
                       Max(a.DepartmentName)                    As DEPARTMENT,
                       Max(a.DocTypeCode)                       As DOCTYPE,
                       Max(a.IssueToEmployee)                   As ISSUED_TO,
                       Max(a.RequisitionNo)                     As REQNO,
                       Count(*)                                 As LINES,
                       Round(Sum(nvl(a.Amount,0))/100000,2)     As AMOUNT_LAC,
                       Round(Sum(nvl(a.NetAmount,0))/100000,2)  As NET_LAC
                  From IssueRegister a
                 Where a.IssueDate < to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                   And (:P684_PANEL     Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P684_PANEL)
                   And (:P684_COMPANY   Is Null Or a.CompanyCode  = :P684_COMPANY)
                   And (:P684_LOCATION  Is Null Or a.LocationCode = :P684_LOCATION)
                   And (:P684_ITEM      Is Null Or a.ItemCode     = :P684_ITEM)
                   And (:P684_ITEMGROUP Is Null Or a.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP))
                 Group By a.Tno
                 Order By Max(a.IssueDate) Desc
                ```
            pageItemsToSubmit: [
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_ITEM
            ]
        }
