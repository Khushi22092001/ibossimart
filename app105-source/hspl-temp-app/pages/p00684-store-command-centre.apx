            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Issue Value (Rs Lac)
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

