    region short-by-item (
        name: Short Issue by Item
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Which items the store could not fully serve, and how often. REQS is
                   the count of DISTINCT requisitions that went short on the item - an
                   item short on many requisitions is a chronic stockout worth a reorder
                   decision, which matters here because ItemSpecification carries no
                   reorder level (every Minimum/Maximum/ReorderLevel in this database
                   is zero), so behaviour is the only replenishment signal available.
                
                   STOCK_NOW is today's balance on the same validated layer model the
                   rest of this page uses, so a buyer can see at a glance whether the
                   shortage has since been covered. */
                With Bal As (
                  /* Scoped to the SAME company and location as the filter bar. Stock
                     sitting at another plant is not available to a requester here, so
                     counting it would make a real shortage look covered. */
                  Select s.ItemCode, s.StockQuantity1 - nvl(u.Used,0) Qty
                    From Stock s
                    Left Join (Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                                 From UsedStock us Group By us.StockTno) u On u.StockTno = s.Tno
                   Where ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                     And (:P684_PANEL    Is Null Or s.Panel        = :P684_PANEL)
                     And (:P684_COMPANY  Is Null Or s.CompanyCode  = :P684_COMPANY)
                     And (:P684_LOCATION Is Null Or s.LocationCode = :P684_LOCATION)),
                StockNow As (Select ItemCode, Sum(Qty) Qty From Bal Group By ItemCode),
                Short As (
                  Select d.ItemCode,
                         Count(Distinct d.Tno)                                        Reqs,
                         Count(*)                                                     Lines_,
                         Sum(nvl(d.Quantity1,0))                                      ReqQty,
                         Sum(nvl(d.IssuedQuantity1,0))                                IssQty,
                         Sum(nvl(d.Quantity1,0) - nvl(d.IssuedQuantity1,0))           ShortQty,
                         Max(r.RequisitionDate)                                       LastShort
                    From RequisitionDetail d
                    Join Requisition r On r.Tno = d.Tno
                   Where nvl(d.Quantity1,0) - nvl(d.IssuedQuantity1,0) > 0.001
                     And r.RequisitionDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                     And r.RequisitionDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or r.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_PANEL    Is Null Or r.Panel        = :P684_PANEL)
                     And (:P684_COMPANY  Is Null Or r.CompanyCode  = :P684_COMPANY)
                     And (:P684_LOCATION Is Null Or r.LocationCode = :P684_LOCATION)
                     And (:P684_ITEM     Is Null Or d.ItemCode     = :P684_ITEM)
                   Group By d.ItemCode)
                Select sh.ItemCode                                    As ITEMCODE,
                       nvl(i.ItemName, sh.ItemCode)                   As ITEMNAME,
                       nvl(g.ItemName,'-')                            As ITEMGROUP,
                       nvl(i.MeasuringUnitCode1,'-')                  As UOM,
                       sh.Reqs                                        As REQUISITIONS_SHORT,
                       sh.Lines_                                      As LINES_SHORT,
                       Round(sh.ReqQty,3)                             As REQUESTED_QTY,
                       Round(sh.IssQty,3)                             As ISSUED_QTY,
                       Round(sh.ShortQty,3)                           As SHORT_QTY,
                       Round(Case When sh.ReqQty > 0 Then sh.ShortQty / sh.ReqQty * 100 End,1) As SHORT_PCT,
                       Round(nvl(sn.Qty,0),3)                         As STOCK_NOW,
                       Case When nvl(sn.Qty,0) >= sh.ShortQty Then 'Covered now'
                            When nvl(sn.Qty,0) > 0            Then 'Partly covered'
                            Else 'Still no stock' End                 As COVER_STATUS,
                       to_char(sh.LastShort,'DD-MM-RRRR')             As LAST_SHORT_ON
                  From Short sh
                  Left Join Item i      On i.ItemCode = sh.ItemCode
                  Left Join Item g      On g.ItemCode = i.ParentCode
                  Left Join StockNow sn On sn.ItemCode = sh.ItemCode
                 Order By sh.Reqs Desc, sh.ShortQty Desc
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
            ]
        }
        layout {
            sequence: 69
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: ds-register
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 200000
        }
        advanced {
            savedReportMappingIdentifier: 31346830208505228
        }

