    region command-header (
        name: Store Command Centre
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select '<div class="ds-store-head">'
                    || '<div class="ds-store-eyebrow">Store &middot; Executive Inventory Intelligence</div>'
                    || '<h1 class="ds-store-title">Store Command Centre</h1>'
                    || '<div class="ds-store-sub">Inventory position, ageing, classification and exceptions valued from the stock ledger, reconciled to the ERP stock function</div>'
                    || '<div class="ds-store-context">'
                    || '<span class="ds-store-chip"><span class="fa fa-calendar-check-o"></span>As on <b>'
                       || :P684_TODATE || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-building-o"></span>Company <b>'
                       || apex_escape.html(nvl((Select c.CompanyName From Company c Where c.CompanyCode = :P684_COMPANY),'All companies')) || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-map-marker"></span>Location <b>'
                       || apex_escape.html(nvl((Select l.LocationName From Location l Where l.LocationCode = :P684_LOCATION),'All locations')) || '</b></span>'
                    || '<span class="ds-store-chip"><span class="fa fa-shield"></span>Panel <b>'
                       || Case When (Select GetUserPanelAB_apex() From dual) Is Not Null
                               Then (Select GetUserPanelAB_apex() From dual) || ' (enforced)'
                               When :P684_PANEL Is Not Null Then :P684_PANEL
                               Else 'A + B' End || '</b></span>'
                    || Case When :P684_ITEMGROUP Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-sitemap"></span>Group <b>'
                            || apex_escape.html(nvl((Select g.ItemName From Item g Where g.ItemCode = :P684_ITEMGROUP),:P684_ITEMGROUP))
                            || '</b></span>' End
                    || Case When :P684_ITEM Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-cube"></span>Item <b>'
                            || apex_escape.html(nvl((Select i.ItemName From Item i Where i.ItemCode = :P684_ITEM),:P684_ITEM))
                            || '</b></span>' End
                    || Case When :P684_STORAGELOCATION Is Not Null Then
                            '<span class="ds-store-chip"><span class="fa fa-archive"></span>Storage <b>'
                            || apex_escape.html(nvl((Select sl.StorageLocationName From StorageLocation sl Where sl.StorageLocationCode = :P684_STORAGELOCATION),:P684_STORAGELOCATION))
                            || '</b></span>' End
                    /* Freshness is the newest stock movement THIS LOGIN may see, so the
                       chip can never disclose a row outside the user's panel. */
                    || '<span class="ds-store-chip ds-store-chip--live"><span class="fa fa-clock-o"></span>Ledger as of <b>'
                       || nvl((Select to_char(Max(s.StockDate),'DD-MM-RRRR')
                                 From Stock s
                                Where ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                                  And (:P684_COMPANY  Is Null Or s.CompanyCode  = :P684_COMPANY)
                                  And (:P684_LOCATION Is Null Or s.LocationCode = :P684_LOCATION)),'-') || '</b></span>'
                    || '</div></div>' As HEAD
                  From dual
                ```
            pageItemsToSubmit: [
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_ITEM
                P684_STORAGELOCATION
            ]
        }
        layout {
            sequence: 5
            slot: body
        }
