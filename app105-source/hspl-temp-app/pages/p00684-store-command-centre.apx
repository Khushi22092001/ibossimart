    region kpi-strip (
        name: Inventory KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* One pass over the stock layers feeds every card on this strip.
                   Bal is the validated balance model: a receipt layer minus the
                   consumption booked against it, both cut off at the as-on date.
                   Reconciled to GetItemOpeningQuantity1 with zero difference. */
                With Bnd As (Select to_date(:P684_TODATE,'DD-MM-RRRR') + 1 D2 From dual),
                     Bal As (
                       Select s.ItemCode, s.LocationCode, s.StorageLocationCode,
                              s.StockDate, s.Rate, s.Panel,
                              s.StockQuantity1 - nvl(u.Used,0) Qty
                         From Stock s Cross Join Bnd b
                         Left Join (Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                                      From UsedStock us Cross Join Bnd b2
                                     Where us.UsedStockDate < b2.D2
                                     Group By us.StockTno) u On u.StockTno = s.Tno
                        Where s.StockDate < b.D2
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                          And (:P684_PANEL           Is Null Or s.Panel               = :P684_PANEL)
                          And (:P684_COMPANY         Is Null Or s.CompanyCode         = :P684_COMPANY)
                          And (:P684_LOCATION        Is Null Or s.LocationCode        = :P684_LOCATION)
                          And (:P684_STORAGELOCATION Is Null Or s.StorageLocationCode = :P684_STORAGELOCATION)
                          And (:P684_ITEM            Is Null Or s.ItemCode            = :P684_ITEM)
                          And (:P684_ITEMGROUP       Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP))),
                     /* UnvalQty is the balance sitting on layers that carry no rate.
                        Every UNLOADING receipt is unrated - material at the unloading
                        stage has not been costed yet - so a material share of the
                        quantity legitimately contributes nothing to the value. The
                        cards disclose it rather than let the value look complete. */
                     Agg As (
                       Select nvl(Sum(Qty*Rate),0) Val, nvl(Sum(Qty),0) Qty,
                              nvl(Sum(Case When nvl(Rate,0) = 0 Then Qty End),0) UnvalQty,
                              Count(Distinct ItemCode) Items,
                              Count(Distinct LocationCode) Locs,
                              Count(Distinct StorageLocationCode) SLocs
                         From Bal Where Qty <> 0),
                     /* Consumption over the 30 days ending on the as-on date, valued at
                        the rate of the layer it was drawn from - the same basis the
                        IssueRegister view uses (UsedStockQuantity1 * Stock.Rate). */
                     C30 As (
                       Select nvl(Sum(u.UsedStockQuantity1 * s.Rate),0) Cv
                         From UsedStock u Join Stock s On s.Tno = u.StockTno Cross Join Bnd b
                        Where u.UsedStockDate < b.D2 And u.UsedStockDate >= b.D2 - 31
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                          And (:P684_PANEL     Is Null Or s.Panel        = :P684_PANEL)
                          And (:P684_COMPANY   Is Null Or s.CompanyCode  = :P684_COMPANY)
                          And (:P684_LOCATION  Is Null Or s.LocationCode = :P684_LOCATION)
                          And (:P684_ITEM      Is Null Or s.ItemCode     = :P684_ITEM)
                          And (:P684_ITEMGROUP Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP))),
                     /* Dead = holds a positive balance but nothing was drawn from it in
                        the ageing window. Idle days come from the newest layer still
                        carrying stock, which is the best available proxy while Stock is
                        scoped to the current financial year. */
                     Dead As (
                       Select Count(*) Items, nvl(Sum(Val),0) Val From (
                         Select b.ItemCode, Sum(b.Qty*b.Rate) Val
                           From Bal b Group By b.ItemCode
                          Having Sum(b.Qty) > 0
                             And Not Exists (Select 1 From UsedStock u2 Join Stock s2 On s2.Tno = u2.StockTno
                                              Cross Join Bnd b3
                                             Where s2.ItemCode = b.ItemCode
                                               And u2.UsedStockDate < b3.D2
                                               And u2.UsedStockDate >= b3.D2 - nvl(:P684_IDLEDAYS,90)))),
                     Neg As (Select Count(*) Items From (Select ItemCode From Bal Group By ItemCode Having Sum(Qty) < 0)),
                     Old As (Select nvl(Sum(Qty*Rate),0) Val From Bal b Cross Join Bnd bb
                              Where Qty <> 0 And b.StockDate <= bb.D2 - 91)
                Select '<div class="ds-kpi ds-kpi--value" title="Sum of remaining layer quantity times layer rate, as on the selected date">'
                    || '<span class="ds-kpi-ic fa fa-inr"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">TOTAL INVENTORY VALUE</div><div class="ds-kpi-n">&#8377;'
                    || Case When a.Val >= 10000000 Then to_char(a.Val/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When a.Val >= 100000   Then to_char(a.Val/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(a.Val,'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When a.UnvalQty > 0
                              Then 'Excludes '||to_char(a.UnvalQty,'FM999G999G990')||' unrated units'
                              Else 'Closing stock value from the stock ledger' End||'</div>'
                    || '</div></div>' As KPI1,
                
                       '<div class="ds-kpi ds-kpi--input" title="Sum of remaining layer quantity in primary unit of measure">'
                    || '<span class="ds-kpi-ic fa fa-balance-scale"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">TOTAL QUANTITY</div><div class="ds-kpi-n">'
                    || Case When a.Qty >= 10000000 Then to_char(a.Qty/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When a.Qty >= 100000   Then to_char(a.Qty/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(a.Qty,'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">Primary unit of measure</div>'
                    || '</div></div>' As KPI2,
                
                       '<div class="ds-kpi ds-kpi--bill" title="Distinct item codes carrying a non-zero balance">'
                    || '<span class="ds-kpi-ic fa fa-cubes"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">ITEMS IN STOCK</div><div class="ds-kpi-n">'
                    || to_char(a.Items,'FM999G99G990') || '</div>'
                    || '<div class="ds-kpi-sub">Distinct material codes held</div>'
                    || '</div></div>' As KPI3,
                
                       '<div class="ds-kpi ds-kpi--ok" title="Distinct locations and storage locations holding stock">'
                    || '<span class="ds-kpi-ic fa fa-map-marker"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">STOCKING POINTS</div><div class="ds-kpi-n">'
                    || to_char(a.Locs,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.SLocs,'FM999G990')||' storage locations in use</div>'
                    || '</div></div>' As KPI4,
                
                       '<div class="ds-kpi ds-kpi--cap" title="Consumption drawn from stock in the 30 days ending on the as-on date, valued at layer rate">'
                    || '<span class="ds-kpi-ic fa fa-exchange"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">CONSUMPTION 30D</div><div class="ds-kpi-n">&#8377;'
                    || Case When c.Cv >= 10000000 Then to_char(c.Cv/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When c.Cv >= 100000   Then to_char(c.Cv/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(c.Cv,'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When c.Cv > 0 Then 'Implied cover '||to_char(a.Val/(c.Cv/30),'FM999G990')||' days'
                              Else 'No consumption in window' End||'</div>'
                    || '</div></div>' As KPI5,
                
                       '<a class="ds-kpi ds-kpi--risk" href="f?p=&APP_ID.:685:&APP_SESSION.::NO::P685_ASONDATE,P685_MODE,P685_COMPANY,P685_LOCATION,P685_PANEL,P685_ITEMGROUP,P685_ITEM,P685_IDLEDAYS:'
                       ||:P684_TODATE||',DEAD,'||:P684_COMPANY||','||:P684_LOCATION||','||:P684_PANEL||','||:P684_ITEMGROUP||','||:P684_ITEM||','||nvl(:P684_IDLEDAYS,90)
                       ||'" title="Items holding stock with no issue in the idle window - click for the item level list">'
                    || '<span class="ds-kpi-ic fa fa-ban"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">DEAD STOCK VALUE</div><div class="ds-kpi-n">&#8377;'
                    || Case When d.Val >= 10000000 Then to_char(d.Val/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When d.Val >= 100000   Then to_char(d.Val/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(d.Val,'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(d.Items,'FM999G990')||' items idle over '||to_char(nvl(:P684_IDLEDAYS,90))||' days</div>'
                    || '</div></a>' As KPI6,
                
                       '<a class="ds-kpi ds-kpi--pend" href="f?p=&APP_ID.:685:&APP_SESSION.::NO::P685_ASONDATE,P685_MODE,P685_COMPANY,P685_LOCATION,P685_PANEL,P685_ITEMGROUP,P685_ITEM,P685_IDLEDAYS:'
                       ||:P684_TODATE||',AGE,'||:P684_COMPANY||','||:P684_LOCATION||','||:P684_PANEL||','||:P684_ITEMGROUP||','||:P684_ITEM||','||nvl(:P684_IDLEDAYS,90)
                       ||'" title="Value of stock lying more than 90 days measured from the receipt date of the layer still carrying it">'
                    || '<span class="ds-kpi-ic fa fa-hourglass-half"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">AGEING OVER 90D</div><div class="ds-kpi-n">&#8377;'
                    || Case When o.Val >= 10000000 Then to_char(o.Val/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When o.Val >= 100000   Then to_char(o.Val/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(o.Val,'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When a.Val > 0 Then to_char(o.Val/a.Val*100,'FM990D0')||'% of inventory value'
                              Else 'No stock held' End||'</div>'
                    || '</div></a>' As KPI7,
                
                       '<div class="ds-kpi ds-kpi--'||Case When n.Items > 0 Then 'risk' Else 'ok' End
                       ||'" title="Items whose ledger balance is negative - a data integrity exception">'
                    || '<span class="ds-kpi-ic fa fa-exclamation-triangle"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">NEGATIVE STOCK</div><div class="ds-kpi-n">'
                    || to_char(n.Items,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When n.Items > 0 Then 'Items below zero - investigate' Else 'Ledger is clean' End||'</div>'
                    || '</div></div>' As KPI8
                From Agg a Cross Join C30 c Cross Join Dead d Cross Join Neg n Cross Join Old o
                ```
            pageItemsToSubmit: [
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_ITEM
                P684_STORAGELOCATION
                P684_IDLEDAYS
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

