    region fsn-chart (
        name: FSN Movement Analysis
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* FSN on movement frequency in the idle window: an item drawn in two or
                   more distinct months is Fast, one month is Slow, none is Non-moving. */
                With Bnd As (Select to_date(:P684_TODATE,'DD-MM-RRRR') + 1 D2 From dual),
                     Bal As (
                       Select s.ItemCode, s.Rate, s.StockQuantity1 - nvl(u.Used,0) Qty
                         From Stock s Cross Join Bnd b
                         Left Join (Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                                      From UsedStock us Cross Join Bnd b2
                                     Where us.UsedStockDate < b2.D2 Group By us.StockTno) u On u.StockTno = s.Tno
                        Where s.StockDate < b.D2
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                          And (:P684_PANEL           Is Null Or s.Panel               = :P684_PANEL)
                          And (:P684_COMPANY         Is Null Or s.CompanyCode         = :P684_COMPANY)
                          And (:P684_LOCATION        Is Null Or s.LocationCode        = :P684_LOCATION)
                          And (:P684_STORAGELOCATION Is Null Or s.StorageLocationCode = :P684_STORAGELOCATION)
                          And (:P684_ITEMGROUP       Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP))),
                     B As (Select ItemCode, Sum(Qty*Rate) Val From Bal Group By ItemCode Having Sum(Qty) > 0),
                     M As (Select s.ItemCode, Count(Distinct trunc(u.UsedStockDate,'MM')) Mths
                             From UsedStock u Join Stock s On s.Tno = u.StockTno Cross Join Bnd b
                            Where u.UsedStockDate < b.D2
                              And u.UsedStockDate >= b.D2 - nvl(:P684_IDLEDAYS,90)
                            Group By s.ItemCode)
                Select Cls As LBL, Srt, Round(Sum(Val)/100000,2) As VAL_LAC, Count(*) As ITEMS
                  From (Select Case When nvl(m.Mths,0) >= 2 Then 'Fast moving'
                                    When nvl(m.Mths,0) = 1 Then 'Slow moving'
                                    Else 'Non moving' End Cls,
                               Case When nvl(m.Mths,0) >= 2 Then 1
                                    When nvl(m.Mths,0) = 1 Then 2 Else 3 End Srt,
                               b.Val
                          From B b Left Join M m On m.ItemCode = b.ItemCode)
                 Group By Cls, Srt Order By Srt
                ```
            pageItemsToSubmit: [
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_STORAGELOCATION
