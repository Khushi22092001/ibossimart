    region req-fulfil-kpis (
        name: Requisition Fulfilment KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Fulfilment is DERIVED, not stored. RequisitionDetail.DocumentStatusCode
                   is null on every row in this database, so there is no recorded approval
                   or rejection state. What the ERP does maintain is IssuedQuantity1
                   against Quantity1, so the only defensible buckets are: nothing issued,
                   partly issued, fully issued. A "rejected" requisition is
                   indistinguishable from one that was simply never issued - both show
                   zero issued quantity - so the card is labelled for what the data can
                   actually prove. */
                With R As (
                  Select r.Tno,
                         Sum(nvl(d.Quantity1,0))       ReqQty,
                         Sum(nvl(d.IssuedQuantity1,0)) IssQty,
                         Max(trunc(sysdate) - trunc(r.RequisitionDate)) AgeDays
                    From Requisition r Join RequisitionDetail d On d.Tno = r.Tno
                   Where r.RequisitionDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                     And r.RequisitionDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null Or r.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_PANEL    Is Null Or r.Panel        = :P684_PANEL)
                     And (:P684_COMPANY  Is Null Or r.CompanyCode  = :P684_COMPANY)
                     And (:P684_LOCATION Is Null Or r.LocationCode = :P684_LOCATION)
                     And (:P684_ITEM     Is Null Or d.ItemCode     = :P684_ITEM)
                   Group By r.Tno),
                A As (
                  Select Count(Case When IssQty <= 0.001 Then 1 End)                            Nothing_,
                         Count(Case When IssQty > 0.001 And IssQty < ReqQty - 0.001 Then 1 End) Partly_,
                         Count(Case When IssQty >= ReqQty - 0.001 Then 1 End)                   Fully_,
                         Count(*)                                                               Total_,
                         Count(Case When IssQty <= 0.001 And AgeDays > 30 Then 1 End)           NothingOld,
                         /* Shortfall counted only where an issue was actually raised.
                            A requisition nobody actioned is a queue problem, not a
                            stock shortage, so it belongs on the Not Issued card and
                            must not inflate the short quantity. */
                         nvl(Sum(Case When IssQty > 0.001 And IssQty < ReqQty - 0.001
                                      Then ReqQty - IssQty End),0)                              ShortQty
                    From R)
                Select '<a href="#" class="ds-kpi ds-kpi--risk ds-rdrill" data-k="NONE" title="Requisitions with no issue raised against them at all - click to list them">'
                    || '<span class="ds-kpi-ic fa fa-times-circle-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">NOT ISSUED</div><div class="ds-kpi-n">'
                    || to_char(a.Nothing_,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.NothingOld,'FM999G990')||' of them open over 30 days</div>'
                    || '</div></a>' As KPI1,
                
                       '<a href="#" class="ds-kpi ds-kpi--pend ds-rdrill" data-k="PART" title="Requisitions served short - the requester asked for more than the store issued - click to list them">'
                    || '<span class="ds-kpi-ic fa fa-adjust"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">SHORT ISSUED</div><div class="ds-kpi-n">'
                    || to_char(a.Partly_,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.ShortQty,'FM999G999G990D00')||' units short of what was asked</div>'
                    || '</div></a>' As KPI2,
                
                       '<a href="#" class="ds-kpi ds-kpi--ok ds-rdrill" data-k="FULL" title="Requisitions fully issued - click to list them">'
                    || '<span class="ds-kpi-ic fa fa-check-circle-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">FULLY ISSUED</div><div class="ds-kpi-n">'
                    || to_char(a.Fully_,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When a.Total_ > 0 Then to_char(a.Fully_/a.Total_*100,'FM990D0')||'% of requisitions raised'
                              Else 'None raised in period' End||'</div>'
                    || '</div></a>' As KPI3,
                
                       '<a href="#" class="ds-kpi ds-kpi--bill ds-rdrill" data-k="ALL" title="Every requisition raised in the period - click to list them">'
                    || '<span class="ds-kpi-ic fa fa-list-alt"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">REQUISITIONS RAISED</div><div class="ds-kpi-n">'
                    || to_char(a.Total_,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">In the selected period</div>'
                    || '</div></a>' As KPI4
                From A a
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
            ]
        }
        layout {
            sequence: 67
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

