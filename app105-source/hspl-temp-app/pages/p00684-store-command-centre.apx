    region dept-trend (
        name: Department Issue Trend by Month
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Monthly trend stacked by department. Only the five departments that
                   consumed most in the period get their own band; everything else is
                   folded into one "Other departments" series rather than dropped, so
                   each month's stack still totals that month's issue value. */
                With D As (
                  Select a.DepartmentCode,
                         Row_Number() Over (Order By Sum(nvl(a.Amount,0)) Desc) rn
                    From IssueRegister a
                   Where a.IssueDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                     And a.IssueDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                     And a.DepartmentCode Is Not Null
                   Group By a.DepartmentCode)
                Select to_char(a.IssueDate,'MON-YY')        As LBL,
                       to_char(a.IssueDate,'YYYYMM')        As SRT,
                       Case When d.rn <= 5 Then nvl(a.DepartmentName, a.DepartmentCode)
                            Else 'Other departments' End    As DEPTSERIES,
                       Round(Sum(nvl(a.Amount,0))/100000,2) As VAL_LAC
                  From IssueRegister a
                  Join D d On d.DepartmentCode = a.DepartmentCode
                 Where a.IssueDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                   And a.IssueDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                   And (:P684_PANEL    Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P684_PANEL)
                   And (:P684_COMPANY  Is Null Or a.CompanyCode  = :P684_COMPANY)
                   And (:P684_LOCATION Is Null Or a.LocationCode = :P684_LOCATION)
                   And (:P684_ITEM     Is Null Or a.ItemCode     = :P684_ITEM)
                 Group By to_char(a.IssueDate,'MON-YY'), to_char(a.IssueDate,'YYYYMM'),
                          Case When d.rn <= 5 Then nvl(a.DepartmentName, a.DepartmentCode)
                               Else 'Other departments' End
                 Order By 2, 3
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
            ]
        }
        layout {
            sequence: 74
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            stack: true
        }
        chartLayout {
            height: 320
        }
