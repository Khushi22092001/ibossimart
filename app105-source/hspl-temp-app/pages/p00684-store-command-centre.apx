                        P688_DEPARTMENT: &DEPTCODE.
                        P688_FROMDATE: &P684_FROMDATE.
                        P688_TODATE: &P684_TODATE.
                        P688_COMPANY: &P684_COMPANY.
                        P688_LOCATION: &P684_LOCATION.
                        P688_PANEL: &P684_PANEL.
