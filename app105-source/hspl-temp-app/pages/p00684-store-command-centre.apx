page 684 (
    name: Store Command Centre
    alias: STORE-COMMAND-CENTRE
    title: Store Command Centre
    pageGroup: @store-intelligence
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText: Executive store and inventory command centre. This page is an ADDITION to the existing Material Issue Command Centre (page 680), which is unchanged. The valuation spine is the stock-layer model: Stock holds one row per receipt layer (StockQuantity1, Rate, StockDate) and UsedStock holds dated consumption against a layer (StockTno, UsedStockQuantity1, UsedStockDate). Balance as on a date = sum over layers received on or before that date of StockQuantity1 minus UsedStock consumed on or before that date. This was reconciled exactly (zero difference) against the ERP function GetItemOpeningQuantity1 on 03-08-2026. Ageing is measured from Stock.StockDate on the REMAINING balance. Three caveats are built into the cards rather than hidden. First, Stock is scoped to the current financial year, so brought-forward stock enters as ITEMOPENING layers dated on the financial year begin and ageing therefore cannot exceed days elapsed in the current financial year. Second, about a quarter of stock layers carry no rate - every UNLOADING receipt is unrated because material at the unloading stage has not been costed yet - so the inventory value covers only the rated balance and the value card states how many units it excludes. Third, one item code present in Stock has no row in the Item master, so item names fall back to the raw code rather than showing blank.
    }

    region abc-chart (
        name: ABC Classification
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Standard Pareto on inventory value: A is the items covering the
                   first 80% of value, B the next 15%, C the remainder. */
                With Bnd As (Select to_date(:P684_TODATE,'DD-MM-RRRR') + 1 D2 From dual),
                     Bal As (
                       Select s.ItemCode, s.Rate, s.StockQuantity1 - nvl(u.Used,0) Qty
                         From Stock s Cross Join Bnd b
                         Left Join (Select us.StockTno, Sum(us.UsedStockQuantity1) Used
                                      From UsedStock us Cross Join Bnd b2
                                     Where us.UsedStockDate < b2.D2 Group By us.StockTno) u On u.StockTno = s.Tno
                        Where s.StockDate < b.D2
                          And ((Select GetUserPanelAB_apex() From dual) Is Null Or s.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_ITEMCATEGORY Is Null Or s.ItemCode In (Select i9.ItemCode From Item i9 Where i9.ItemCategoryCode = :P684_ITEMCATEGORY))
                          And (:P684_PANEL           Is Null Or s.Panel               = :P684_PANEL)
                          And (:P684_COMPANY         Is Null Or s.CompanyCode         = :P684_COMPANY)
                          And (:P684_LOCATION        Is Null Or s.LocationCode        = :P684_LOCATION)
                          And (:P684_STORAGELOCATION Is Null Or s.StorageLocationCode = :P684_STORAGELOCATION)
                          And (:P684_ITEMGROUP       Is Null Or s.ItemCode In (Select i2.ItemCode From Item i2 Where i2.ParentCode = :P684_ITEMGROUP))),
                     V As (Select ItemCode, Sum(Qty*Rate) Val From Bal Group By ItemCode Having Sum(Qty*Rate) > 0),
                     R As (Select ItemCode, Val, Sum(Val) Over (Order By Val Desc, ItemCode) / Sum(Val) Over () CumPct From V)
                Select Cls As LBL, Round(Sum(Val)/100000,2) As VAL_LAC, Count(*) As ITEMS
                  From (Select Case When CumPct <= 0.80 Then 'A - top 80% of value'
                                    When CumPct <= 0.95 Then 'B - next 15%'
                                    Else 'C - last 5%' End Cls, Val From R)
                 Group By Cls Order By Cls
                ```
            pageItemsToSubmit: [
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEMGROUP
                P684_STORAGELOCATION
            ]
        }
        layout {
            sequence: 45
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
