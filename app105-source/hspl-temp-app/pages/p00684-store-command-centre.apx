                heading: HEAD
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region costcentre-lolli (
        name: Issue Value by Cost Centre
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Lollipop (top 12 cost-centre owners by value + the rest grouped),
                   rendered as an HTML classic report rather than a JET chart: a pie of
                   158 owners is unreadable, and an HTML row list loads instantly with no
                   Oracle-JET module dependency. Each named row drills to the Issue
                   Register on page 688; the grouped "all other" row does not. */
                With D As (
                Select Case When rn <= 12 Then LBL Else 'All other cost centres' End As LBL,
                       Case When rn <= 12 Then CCCODE End                            As CCCODE,
                       Round(Sum(Amt)/100000,2)                                      As VAL_LAC
                  From (
                    Select nvl(a.CostCentreName, a.CostCentreCode) LBL,
                           a.CostCentreCode CCCODE,
                           Sum(nvl(a.Amount,0)) Amt,
                           Row_Number() Over (Order By Sum(nvl(a.Amount,0)) Desc) rn
                      From IssueRegister a
                     Where a.IssueDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                       And a.IssueDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                       And a.CostCentreCode Is Not Null
                       And ((Select GetUserPanelAB_apex() From dual) Is Null
                            Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                       And (:P684_PANEL    Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P684_PANEL)
                       And (:P684_COMPANY  Is Null Or a.CompanyCode  = :P684_COMPANY)
                       And (:P684_LOCATION Is Null Or a.LocationCode = :P684_LOCATION)
                       And (:P684_ITEM     Is Null Or a.ItemCode     = :P684_ITEM)
                     Group By nvl(a.CostCentreName, a.CostCentreCode), a.CostCentreCode
                    Having Sum(nvl(a.Amount,0)) > 0)
                 Group By Case When rn <= 12 Then LBL Else 'All other cost centres' End,
                          Case When rn <= 12 Then CCCODE End),
                     M As (Select Max(VAL_LAC) MX From D)
                Select '<' || Case When D.CCCODE Is Null Then 'div' Else 'a' End
                    || ' class="ds-lolli ds-lolli--'
                    || Case When D.VAL_LAC >= 100 Then 'hi' When D.VAL_LAC >= 50 Then 'mid' Else 'lo' End || '"'
                    || Case When D.CCCODE Is Not Null Then ' href="'
                         || apex_page.get_url(
                              p_page   => 688,
                              p_items  => 'P688_COSTCENTRE,P688_FROMDATE,P688_TODATE,P688_COMPANY,P688_LOCATION,P688_PANEL,P688_ITEM',
                              p_values => D.CCCODE||','||:P684_FROMDATE||','||:P684_TODATE||','||:P684_COMPANY||','||:P684_LOCATION||','||:P684_PANEL||','||:P684_ITEM,
                              p_clear_cache => '688') || '"' Else '' End
                    || '>'
                    || '<span class="ds-lolli-label" title="'||apex_escape.html_attribute(D.LBL)||'">'||apex_escape.html(D.LBL)||'</span>'
                    || '<span class="ds-lolli-track"><span class="ds-lolli-line" style="width:'
                         || to_char(greatest(round(D.VAL_LAC/nullif(M.MX,0)*100), 3)) || '%"></span>'
                       || '<span class="ds-lolli-dot"></span></span>'
                    || '<span class="ds-lolli-val">'
                       || Case When D.VAL_LAC >= 100 Then '&#8377;'||to_char(D.VAL_LAC/100,'FM99G990D00')||' Cr'
                               Else '&#8377;'||to_char(D.VAL_LAC,'FM990D00')||' L' End
                       || '</span>'
                    || '</' || Case When D.CCCODE Is Null Then 'div' Else 'a' End || '>' As ROW_HTML
                  From D Cross Join M
                 Order By D.VAL_LAC Desc
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
            ]
        }
        layout {
            sequence: 72
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-lollipop
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column ROW_HTML (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: " "
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region dept-chart (
        name: Issue Value by Department
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* DepartmentCode reaches the issue through the linked requisition and is
                   populated on every issue line in this database, so this is a complete
                   picture rather than a sample. DEPTCODE is projected so the bar can
                   carry the filter into the Issue Register. */
                Select nvl(a.DepartmentName, a.DepartmentCode) As LBL,
                       a.DepartmentCode                        As DEPTCODE,
                       Round(Sum(nvl(a.Amount,0))/100000,2)    As VAL_LAC
                  From IssueRegister a
                 Where a.IssueDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                   And a.IssueDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                   And a.DepartmentCode Is Not Null
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                   And (:P684_PANEL    Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P684_PANEL)
                   And (:P684_COMPANY  Is Null Or a.CompanyCode  = :P684_COMPANY)
                   And (:P684_LOCATION Is Null Or a.LocationCode = :P684_LOCATION)
                   And (:P684_ITEM     Is Null Or a.ItemCode     = :P684_ITEM)
                 Group By nvl(a.DepartmentName, a.DepartmentCode), a.DepartmentCode
                Having Sum(nvl(a.Amount,0)) > 0
                 Order By 3 Desc
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
