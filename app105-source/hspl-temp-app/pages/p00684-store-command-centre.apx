    region issue-class-kpis (
        name: Issue Classification KPIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Issue.DocTypeCode - which IssueRegister passes straight through - has
                   exactly two values in this database: CAPITAL and CONSUMPTION. Capital
                   is chargeable capex, CONSUMPTION is revenue expenditure. Anything not
                   CAPITAL is counted as revenue so a new code can never vanish silently.
                
                   NOTE: page 680 asks this same question as DocTypeCode = 'CHARGEABLE',
                   a value that never occurs, so its Capital card always reads zero. This
                   page uses the real domain. */
                With A As (
                  Select nvl(Sum(Case When a.DocTypeCode =  'CAPITAL' Then nvl(a.Amount,0) End),0) CapVal,
                         Count(Distinct Case When a.DocTypeCode =  'CAPITAL' Then a.Tno End)       CapDocs,
                         Count(Case When a.DocTypeCode =  'CAPITAL' Then 1 End)                    CapLines,
                         Count(Distinct Case When a.DocTypeCode =  'CAPITAL' Then a.ItemCode End)  CapItems,
                         nvl(Sum(Case When a.DocTypeCode <> 'CAPITAL' Then nvl(a.Amount,0) End),0) RevVal,
                         Count(Distinct Case When a.DocTypeCode <> 'CAPITAL' Then a.Tno End)       RevDocs,
                         Count(Case When a.DocTypeCode <> 'CAPITAL' Then 1 End)                    RevLines,
                         Count(Distinct Case When a.DocTypeCode <> 'CAPITAL' Then a.ItemCode End)  RevItems
                    From IssueRegister a
                   Where a.IssueDate >= to_date(:P684_FROMDATE,'DD-MM-RRRR')
                     And a.IssueDate <  to_date(:P684_TODATE,'DD-MM-RRRR') + 1
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = (Select GetUserPanelAB_apex() From dual))
                     And (:P684_PANEL    Is Null Or (Select i9.Panel From Issue i9 Where i9.Tno = a.Tno) = :P684_PANEL)
                     And (:P684_COMPANY  Is Null Or a.CompanyCode  = :P684_COMPANY)
                     And (:P684_LOCATION Is Null Or a.LocationCode = :P684_LOCATION)
                     And (:P684_ITEM     Is Null Or a.ItemCode     = :P684_ITEM))
                Select '<a href="#" class="ds-kpi ds-kpi--cap ds-idrill" data-k="CAPITAL" title="Issues with DocTypeCode = CAPITAL - click to list them">'
                    || '<span class="ds-kpi-ic fa fa-building"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">CAPITAL ISSUES</div><div class="ds-kpi-n">&#8377;'
                    || Case When a.CapVal >= 10000000 Then to_char(a.CapVal/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When a.CapVal >= 100000   Then to_char(a.CapVal/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(a.CapVal,'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.CapDocs,'FM999G990')||' documents &middot; '
                       ||to_char(a.CapLines,'FM999G990')||' lines &middot; '||to_char(a.CapItems,'FM999G990')||' items</div>'
                    || '</div></a>' As KPI1,
                
                       '<a href="#" class="ds-kpi ds-kpi--rev ds-idrill" data-k="CONSUMPTION" title="Issues with DocTypeCode = CONSUMPTION - click to list them">'
                    || '<span class="ds-kpi-ic fa fa-cog"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">REVENUE ISSUES</div><div class="ds-kpi-n">&#8377;'
                    || Case When a.RevVal >= 10000000 Then to_char(a.RevVal/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When a.RevVal >= 100000   Then to_char(a.RevVal/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(a.RevVal,'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.RevDocs,'FM999G990')||' documents &middot; '
                       ||to_char(a.RevLines,'FM999G990')||' lines &middot; '||to_char(a.RevItems,'FM999G990')||' items</div>'
                    || '</div></a>' As KPI2,
                
                       '<div class="ds-kpi ds-kpi--value" title="Capital plus revenue issue value in the selected period">'
                    || '<span class="ds-kpi-ic fa fa-inr"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">TOTAL ISSUED</div><div class="ds-kpi-n">&#8377;'
                    || Case When a.CapVal+a.RevVal >= 10000000 Then to_char((a.CapVal+a.RevVal)/10000000,'FM9G99G990D00')||'<i>Cr</i>'
                            When a.CapVal+a.RevVal >= 100000   Then to_char((a.CapVal+a.RevVal)/100000,'FM99G990D00')||'<i>L</i>'
                            Else to_char(a.CapVal+a.RevVal,'FM99G99G990') End || '</div>'
                    || '<div class="ds-kpi-sub">'
                       ||Case When a.CapVal+a.RevVal > 0
                              Then to_char(a.CapVal/(a.CapVal+a.RevVal)*100,'FM990D0')||'% capital'
                              Else 'No issues in period' End||'</div>'
                    || '</div></div>' As KPI3,
                
                       '<a href="#" class="ds-kpi ds-kpi--bill ds-idrill" data-k="ALL" title="Every issue document in the period - click to list them">'
                    || '<span class="ds-kpi-ic fa fa-file-text-o"></span><div class="ds-kpi-body">'
                    || '<div class="ds-kpi-t">ISSUE DOCUMENTS</div><div class="ds-kpi-n">'
                    || to_char(a.CapDocs + a.RevDocs,'FM999G990') || '</div>'
                    || '<div class="ds-kpi-sub">'||to_char(a.CapLines + a.RevLines,'FM999G990')||' lines in total</div>'
                    || '</div></a>' As KPI4
                From A a
                ```
            pageItemsToSubmit: [
                P684_FROMDATE
                P684_TODATE
                P684_COMPANY
                P684_LOCATION
                P684_PANEL
                P684_ITEM
            ]
        }
