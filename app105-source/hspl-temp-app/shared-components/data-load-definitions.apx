dataLoadDefinition CATEGORYWISEYEARLYINVENTORY (
    name: CATEGORYWISEYEARLYINVENTORY
    target {
        tableOwner: CMPL
        tableName: CATEGORYWISEYEARLYINVENTORY
    }
    dataProfile {
        name: CATEGORYWISEYEARLYINVENTORY
        format: xlsx
    }
    advanced {
        encoding: utf-8
        defaultXlsxSheetName: sheet1.xml
    }

    dataProfileColumn amount (
        columnName: AMOUNT
        source {
            sequence: 10
            dataType: number
        }
        parsing {
            selector: AMOUNT
            decimalChar: .
        }
    )

    dataProfileColumn documentnature (
        columnName: DOCUMENTNATURE
        source {
            sequence: 7
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: DOCUMENT_NATURE
        }
    )

    dataProfileColumn documentno (
        columnName: DOCUMENTNO
        source {
            sequence: 2
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: DOCUMENT_NO
        }
    )

    dataProfileColumn item (
        columnName: ITEM
        source {
            sequence: 8
            dataType: varchar2
            maxLength: 500
        }
        parsing {
            selector: ITEM
        }
    )

    dataProfileColumn location (
        columnName: LOCATION
        source {
            sequence: 5
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: LOCATION
        }
    )

    dataProfileColumn module (
        columnName: MODULE
        source {
            sequence: 4
            dataType: varchar2
            maxLength: 30
        }
        parsing {
            selector: MODULE
        }
    )

    dataProfileColumn quantity (
        columnName: QUANTITY
        source {
            sequence: 9
            dataType: number
        }
        parsing {
            selector: QUANTITY
        }
    )

    dataProfileColumn stockdate (
        columnName: STOCKDATE
        source {
            sequence: 1
            dataType: date
        }
        parsing {
            selector: STOCK_DATE
            formatMask: YYYY"-"MM"-"DD
            hasTimeZone: false
        }
    )

    dataProfileColumn storagelocation (
        columnName: STORAGELOCATION
        source {
            sequence: 6
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: STORAGE_LOCATION
        }
    )

    dataProfileColumn voucherno (
        columnName: VOUCHERNO
        source {
            sequence: 3
            dataType: varchar2
            maxLength: 50
        }
        parsing {
            selector: VOUCHER_NO
        }
    )

)

