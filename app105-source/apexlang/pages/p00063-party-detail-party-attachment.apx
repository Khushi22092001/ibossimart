page 63 (
    name: Attachment
    alias: PARTY-DETAIL-PARTY-ATTACHMENT
    title: Attachment
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            $('input').on('focus', function() {
            $("#"+this.id+"_LABEL").css("background-color", "yellow");
            }).on('blur', function() {
            $("#"+this.id+"_LABEL").css("background-color", "white");
            });
            
            
            
            $(document).ready(function() {
            $('input').keydown( function(e) {
                    var key = e.charCode ? e.charCode : e.keyCode ? e.keyCode : 0;
                    if(key == 13) {
                        e.preventDefault();
                        var inputs = $(this).closest('form').find(':input:visible');
                        inputs.eq( inputs.index(this)+ 1 ).focus();
                    }
                });
            });
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: BUTTONS
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region party-attachment (
        name: Party Attachment
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                      -- a.SNO,
                       --a.DESCRIPTION,
                       A.MODULETNO,
                       A.MODULESNO,
                       A.ATTRIBUTECODE,
                       A.ATTRIBUTEVALUE,
                       a.ATTACHMENTBLOB,
                       a.FILENAME,
                       trunc(sysdate) as Creationdate,
                       a.mimetype
                       /*CASE
                              WHEN upper(A.FILENAME) LIKE '%DOCX%' then
                               'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                              WHEN upper(A.FILENAME) LIKE '%DOC' then
                               'application/msword'
                              when UPPER(a.filename) like '%JPG' then
                               'image/jpeg'
                              when UPPER(a.filename) like '%JPEG' then
                               'image/jpeg'
                              when UPPER(a.filename) like '%PDF' then
                                'application/pdf'
                              when UPPER(a.filename) like '%TXT' then
                                'text/plain'
                              when UPPER(a.filename) like '%XLS' then
                                'application/vnd.ms-excel'
                              when UPPER(a.filename) like '%XLSX' then
                                'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                              when UPPER(a.filename) like '%PPT' then
                                'application/vnd.ms-powerpoint'
                              when UPPER(a.filename) like '%PPTX' then
                                'application/vnd.openxmlformats-officedocument.presentationml.presentation'
                              when UPPER(a.filename) like '%PNG' then
                               'image/png'
                              when UPPER(a.filename) like '%TIF%' then
                               'image/tiff'
                            end mimetype
                          */
                  from MODULEATTACHMENT a
                  WHERE  A.MODULESNO = :P63_MODULESNO
                  /*
                  union all
                  select a.TNO,
                      -- a.SNO,
                       --a.DESCRIPTION,
                       A.TNO as ModuleTno,
                       A.SNO as ModuleSno,
                       A.ATTRIBUTECODE,
                       A.ATTRIBUTEVALUE,
                       a.ATTACHMENTBLOB,
                       a.FILENAME,
                       trunc(sysdate) as Creationdate,
                       a.mimetype
                       CASE
                              WHEN upper(A.FILENAME) LIKE '%DOCX%' then
                               'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                              WHEN upper(A.FILENAME) LIKE '%DOC' then
                               'application/msword'
                              when UPPER(a.filename) like '%JPG' then
                               'image/jpeg'
                              when UPPER(a.filename) like '%JPEG' then
                               'image/jpeg'
                              when UPPER(a.filename) like '%PDF' then
                                'application/pdf'
                              when UPPER(a.filename) like '%TXT' then
                                'text/plain'
                              when UPPER(a.filename) like '%XLS' then
                                'application/vnd.ms-excel'
                              when UPPER(a.filename) like '%XLSX' then
                                'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                              when UPPER(a.filename) like '%PPT' then
                                'application/vnd.ms-powerpoint'
                              when UPPER(a.filename) like '%PPTX' then
                                'application/vnd.openxmlformats-officedocument.presentationml.presentation'
                              when UPPER(a.filename) like '%PNG' then
                               'image/png'
                              when UPPER(a.filename) like '%TIF%' then
                               'image/tiff'
                            end mimetype
                          
                  from locationdetail a
                  WHERE A.TNO = :P63_MODULETNO
                  AND A.SNO = :P63_MODULESNO
                  */
                  
                ```
            pageItemsToSubmit: P63_MODULESNO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-none
                margin-left-none
                margin-right-none
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P63_ATTACHMENTBLOB (
        type: fileUpload
        label {
            label: <b>Attachment</b>
            alignment: left
        }
        display {
            downloadLinkText: Download
        }
        storage {
            mimeTypeColumn: MIMETYPE
            filenameColumn: FILENAME
            bobLastUpdatedColumn: CREATIONDATE
        }
        layout {
            sequence: 50
            region: @party-attachment
            slot: regionBody
            alignment: left
            column: 1
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
        source {
            formRegion: @party-attachment
            column: ATTACHMENTBLOB
            dataType: blob
        }
    )

    pageItem P63_ATTRIBUTECODE (
        type: popupLov
        label {
            label: Attribute
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PARTYATTRIBUTENAME, PARTYATTRIBUTECODE FROM PARTYATTRIBUTE
                ORDER BY 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @party-attachment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @party-attachment
            column: ATTRIBUTECODE
            dataType: varchar2
        }
    )

    pageItem P63_ATTRIBUTEVALUE (
        type: textField
        label {
            label: Attribute Value
            alignment: left
        }
        layout {
            sequence: 40
            region: @party-attachment
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @party-attachment
            column: ATTRIBUTEVALUE
            dataType: varchar2
        }
    )

    pageItem P63_CREATIONDATE (
        type: hidden
        layout {
            sequence: 70
            region: @party-attachment
            slot: regionBody
        }
        source {
            formRegion: @party-attachment
            column: CREATIONDATE
            dataType: date
            queryOnly: true
        }
    )

    pageItem P63_FILENAME (
        type: hidden
        layout {
            sequence: 60
            region: @party-attachment
            slot: regionBody
        }
        source {
            formRegion: @party-attachment
            column: FILENAME
            dataType: varchar2
        }
    )

    pageItem P63_MIMETYPE (
        type: hidden
        layout {
            sequence: 80
            region: @party-attachment
            slot: regionBody
        }
        source {
            formRegion: @party-attachment
            column: MIMETYPE
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P63_MODULESNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @party-attachment
            slot: regionBody
        }
        source {
            formRegion: @party-attachment
            column: MODULESNO
            dataType: number
            primaryKey: true
        }
    )

    pageItem P63_MODULETNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @party-attachment
            slot: regionBody
        }
        source {
            formRegion: @party-attachment
            column: MODULETNO
            dataType: number
        }
    )

    pageItem P63_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @party-attachment
            slot: regionBody
        }
        source {
            formRegion: @party-attachment
            column: TNO
            dataType: number
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Save
        layout {
            sequence: 20
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P63_ATTRIBUTECODE
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 40
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P63_ATTRIBUTECODE
        }
    )

    button save (
        buttonName: SAVE
        label: Update
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P63_ATTRIBUTECODE
        }
    )

    dynamicAction cancle-dialog (
        name: Cancle Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 140269186617724221
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
    )

    process get-tno (
        name: GET TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P63_TNO IS NULL THEN
                    :P63_TNO := GLOBALTNO.NEXTVAL;
                END IF;
                IF :P63_MODULESNO IS NULL THEN
                    :P63_MODULESNO := GLOBALTNO.NEXTVAL;
                END IF;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 151877968019981449
        }
    )

    process initialize-form-party-detail-party-attachment (
        name: Initialize form Party Detail Party Attachment
        type: formInitialization
        formRegion: @party-attachment
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 140266242893724217
        }
    )

    process process-form-account-master (
        name: Process Form Account Master
        type: formAutoRowProcessing
        formRegion: @party-attachment
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 140266669611724218
        }
    )

)
