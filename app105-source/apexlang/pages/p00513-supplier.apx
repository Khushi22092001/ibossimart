                target: {
                    page: 530
                    items: {
                        P530_SUPPLIERCODE: #SUPPLIERCODE#
                    }
                    clearCache: 530
                }
                linkText: #ACTIVEPOVALUE#
            }
            source {
                dataType: NUMBER
            }
            advanced {
