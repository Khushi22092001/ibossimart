page 513 (
    name: Supplier
    alias: SUPPLIER
    title: Supplier
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            /*    
                function codeAddress()
                {
                document.getElementById("X").style.color="red";}
                /*var tb = document.getElementById("C5361576669511002");
                var tds = tb.getElementsByTagName("tr");
                    tds[0].style.color="red";
                }
                window.onload = codeAddress;
            */
            ```
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region supplier-360-view-report (
        name: Supplier 360 View Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select COMPANYCODE,
                       COMPANYNAME,
                       LOCATIONCODE,
                       LOCATIONNAME,
                       SUPPLIERCODE,
                       SUPPLIERNAME,
                       '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':515:'||:APP_SESSION||'::'||':515:P515_SUPPLIERCODE:'|| SUPPLIERCODE,NULL,'SESSION' )||'">'||SUPPLIERNAME||'</a>' as SupplierLink,
                       YEAROFASSOCIATION,
                       CREDITLIMIT,
                       OUTSTANDINGAMOUNT,
                       OVERDUEAMOUNT,
                       LEDGERBALANCE,
                       TOTALRETURNVALUE,
                       TOTALDISCOUNTVALUE,
                       AVGDISCOUNTPERCENT,
                       ACTIVEPOVALUE,
                       PENDINGFORGRN,
                       ORDERSCOMPLETED,
                       ORDERSDELIVEREDONTIME,
                       REGIONCODE,
                       REGIONNAME,
                       CITYCODE,
                       CITYNAME,
                       STATECODE,
                       STATENAME,
                       COUNTRYCODE,
                       COUNTRYNAME,
                       LOCALIMPORT,
                       LASTRUNDATE
                  from D_SUPPLIER_360VIEW 
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            reportsSelectList: false
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            compute: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            formats: excel
            sendAsEmail: false
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 100
        }
        advanced {
            savedReportMappingIdentifier: 15487297508874630
        }

