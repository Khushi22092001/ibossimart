page 133 (
    name: Weighment
    alias: WEIGHMENT
    title: Weighment
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var reportName = 'IRONMART/REPORT/WeighMent.xdo';
              var outputFormat = 'pdf';
              var bireporturl = $('#P133_BIREPORTURL').val()
              var reportParams = 
                '&P_TNO=' + $('#P133_TNO').val() 
                  ;
            
             
                    var reportURL = bireporturl+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P133_BIREPORTURL').val()
              var reportName =  'WeighMent.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '"_paramsP_TNO":"' + $('#P133_TNO').val() 
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            
            ```
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 30
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region weighment (
        name: Weighment
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       WEIGHMENTNO,
                       WEIGHMENTDATE,
                       COMPANYVEHICLECODE,
                       MATERIALINTNO,
                       DESPATCHADVICETNO,
                       PURCHASERETURNTNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       CHALLANGROSSWEIGHT,
                       CHALLANNETWEIGHT,
                       CHALLANTAREWEIGHT,
                       FIRSTWEIGHT,
                       FIRSTWEIGHTTIME,
                       SECONDWEIGHT,
                       SECONDWEIGHTTIME,
                       NETWEIGHT,
                       ACCEPTEDWEIGHT,
                       REMARK,
                       VEHICLENO,
                       VEHICLETYPECODE,
                       WEIGHBRIDGECODE,
                       TRANSPORTERCODE,
                       CREATOR,
                       SECONDWEIGHBRIEDGECODE,
                       FROMLOCATIONCODE,
                       TOLOCATIONCODE,
                       CREATORFORSECONDWEIGHT,
                       ISCANCELED,
                       CANCELREMARK,
                       CREATIONTIME,
                       CREATIONTIMEFORSECONDWEIGHT
                  from WEIGHMENT
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

