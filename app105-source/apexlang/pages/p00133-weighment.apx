    pageItem P133_ITEMCODE (
        type: popupLov
        label {
            label: Item
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    ITEMNAME , 
                    ITEMCODE 
                FROM ITEM
                WHERE ITEMCODE IN (
                                    SELECT 
                                        DISTINCT ITEMCODE 
                                    FROM MATERIALINDETAIL 
                                    WHERE TNO = :P133_MATERIALINTNO
                                  )
                union all
                SELECT 
                    ITEMNAME , 
                    ITEMCODE 
                FROM ITEM
                WHERE ITEMCODE IN (
                                    SELECT 
                                        DISTINCT ITEMCODE 
                                    FROM despatchadvicedetail
                                    WHERE TNO = :P133_DESPATCHADVICETNO
                                  )
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P133_TNO
                P133_MATERIALINTNO
                P133_DESPATCHADVICETNO
            ]
            itemsToSubmit: [
                P133_MATERIALINTNO
                P133_DESPATCHADVICETNO
            ]
            parentRequired: false
        }
        layout {
            sequence: 160
            region: @weighment
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @weighment
            column: ITEMCODE
            dataType: varchar2
        }
    )

    pageItem P133_ITEMSPECIFICATIONCODE (
        type: popupLov
        label {
            label: Item Specification
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select ITEMSPECIFICATIONNAME , ITEMSPECIFICATIONCODE from itemspecification
                where ITEMSPECIFICATIONCODE in (SELECT 
                                                    DISTINCT ITEMSPECIFICATIONCODE 
                                                FROM MATERIALINDETAIL 
                                                WHERE TNO = :P133_MATERIALINTNO
                                                and itemcode  = :P133_ITEMCODE
                                                )
                union all
                select ITEMSPECIFICATIONNAME , ITEMSPECIFICATIONCODE from itemspecification
                where ITEMSPECIFICATIONCODE in (SELECT 
                                                    DISTINCT ITEMSPECIFICATIONCODE 
                                                FROM despatchadvicedetail 
                                                WHERE TNO = :P133_DESPATCHADVICETNO
                                                and itemcode  = :P133_ITEMCODE
                                                )
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P133_MATERIALINTNO
                P133_DESPATCHADVICETNO
            ]
            itemsToSubmit: [
                P133_ITEMCODE
                P133_MATERIALINTNO
                P133_DESPATCHADVICETNO
            ]
            parentRequired: false
        }
        layout {
            sequence: 170
            region: @weighment
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @weighment
            column: ITEMSPECIFICATIONCODE
            dataType: varchar2
        }
    )

    pageItem P133_LOCATIONCODE (
