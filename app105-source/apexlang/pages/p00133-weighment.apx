    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P133_Tno is null then
                        Select GlobalTno.NextVal into :P133_Tno From Dual;
                     end if;
                    ----
                    if :P133_WEIGHMENTNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P133_LocationCode,
                					:P133_DocTypeCode,
                					NULL,
                					TO_DATE(:P133_WEIGHMENTDATE, 'DD-MM-RRRR')
                				);
                        :P133_WEIGHMENTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P133_LocationCode,
                                    :P133_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P133_WEIGHMENTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 154869640638966443
        }
    )

