page 29 (
    name: TDS Nature
    alias: TDS-NATURE
    title: TDS Nature
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region tds-nature (
        name: TDS Nature
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       TDSNATURECODE,
                       TDSNATURENAME,
                       TAXSECTIONCODE,
                       REMARK,
                       CREATOR,
                       to_char(CREATIONTIME,'DD-MM-YYYY HH24:MI:SS') CREATIONTIME,
                       TDSACCOUNTCODE,
                       CESSACCOUNTCODE,
                       SURCHARGEACCOUNTCODE
                  from TDSNATURE
                  order by CREATIONTIME desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 30
                items: {
                    P30_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 138261499849282243
        }

        column CESSACCOUNTCODE (
            type: plainText
            heading {
                heading: Cess Account Code
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column SURCHARGEACCOUNTCODE (
            type: plainText
            heading {
                heading: Surcharge Account Code
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column TAXSECTIONCODE (
            type: plainText
            heading {
                heading: Tax Section Code
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TDSACCOUNTCODE (
            type: plainText
            heading {
                heading: TDS Account Code
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column TDSNATURECODE (
            type: plainText
            heading {
                heading: TDS Nature Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TDSNATURENAME (
            type: plainText
            heading {
                heading: TDS Nature Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: TDS Nature
        }

        savedReport 1382686 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CESSACCOUNTCODE (
                sequence: 8
            )

            displayColumn CREATIONTIME (
                sequence: 10
            )

            displayColumn CREATOR (
                sequence: 6
            )

            displayColumn REMARK (
                sequence: 5
            )

            displayColumn SURCHARGEACCOUNTCODE (
                sequence: 9
            )

            displayColumn TAXSECTIONCODE (
                sequence: 4
            )

            displayColumn TDSACCOUNTCODE (
                sequence: 7
            )

            displayColumn TDSNATURECODE (
                sequence: 2
            )

            displayColumn TDSNATURENAME (
                sequence: 3
            )

            displayColumn TNO (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @tds-nature
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 30
                clearCache: 30
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @tds-nature
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tds-nature
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @tds-nature
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tds-nature
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

