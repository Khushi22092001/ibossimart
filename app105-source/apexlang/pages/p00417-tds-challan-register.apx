    region report-material-in (
        name: Report(Material In)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.TNO,
                	a.TDSChallanNo,
                	a.TDSChallanDate,
                	to_char(a.FromDate, 'MON-RRRR') as ForMonth,
                	a.Remark
                from TDSChallan a, Location c
                where a.LocationCode = c.LocationCode
                	and a.CompanyCode = :global_CompanyCode
                	and a.FinancialYearCode = :global_FinancialYearCode
                --	and getDocNo('MYFLAG', :global_CompanyCode, :global_FinancialYearCode, a.LocationCode, :global.MyFlag, :global.UserFlag, sysdate) = 'YES'
                	and GetLocationPrivilege(a.LocationCode, getmodulecodeforpageno(:APP_PAGE_ID), a.companycode) ='YES'
                	and GetDoctypePrivilege(a.doctypecode,getmodulecodeforpageno(:APP_PAGE_ID), a.companycode) = 'YES'	
                order by a.TDSChallanDate desc, a.TDSChallanNo desc
                ```
            pageItemsToSubmit: [
                P417_COMPANY
                P417_LOCATION
                P417_FROMDATE
                P417_TODATE
                P417_DOCTYPE
                P417_PARTY
                P417_GRNSTATUS
                P417_TRANSPORTER
                P417_VEHICLENO
                P417_ITEM
                P417_MINO
                P417_ITEMSPECIFICATION
                P417_CREATOR
                P417_BIREPORTURL
                P417_TNO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
            cssClasses: t-Form--search
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 418
                items: {
                    P418_TNO: #TNO#
                    P418_FORMSTATUS: EDITRECORD
                }
                clearCache: 418
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
