    dynamicAction generatepdf (
        name: GeneratePDF
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /*javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/materialinregister.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P417_COMPANY.","_paramsP_LOCATION":"&P417_LOCATION.","_paramsP_FROMDATE":"&P417_FROMDATE.","_paramsP_TODATE":"&P417_TODATE.","_paramsP_GRNSTATUS":"&P417_GRNSTATUS.","_paramsP_DOCTYPE":"&P417_DOCTYPE.","_paramsP_VEHICLENO":"&P417_VEHICLENO.","_paramsP_PARTY":"&P417_PARTY.","_paramsP_TRANSPORTER":"&P417_TRANSPORTER.","_paramsP_ITEM":"&P417_ITEM.","_paramsP_MINO":"&P417_MINO.","_paramsP_ITEMSPECIFICATION":"&P417_ITEMSPECIFICATION."}');
                    */
                    generatePDF_new();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-report (
        name: Refresh Report
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#filter.a-Collapsible.is-expanded').removeClass('is-expanded').addClass('is-collapsed');
                        $('#filter.a-Collapsible .a-Collapsible-content').hide();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @report-material-in
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P417_MINO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P417_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P417_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 20595300531147321
        }
    )

)

