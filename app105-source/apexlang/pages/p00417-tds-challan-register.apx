        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        e.ItemName||' ( '||e.ItemCode as d,
                        e.ItemCode r
                From MaterialInDetail a, Item e
                Where a.ItemCode = e.itemCode
                
                Union
                
                Select
                        Distinct
                        e.ItemName||' ( '||e.ItemCode as ItemName,
                        e.ItemCode
                From MaterialOutDetail a, Item e
                Where a.ItemCode = e.itemCode
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
