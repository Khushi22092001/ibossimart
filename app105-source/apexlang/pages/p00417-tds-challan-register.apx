    pageItem P417_MINO (
        type: textFieldWithAutocomplete
        label {
            label: Mi No
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select MaterialInNo 
                From MaterialIn 
                Where instr(':'||:P417_LOCATION||':',':'||LocationCode||':') > 0
                --  and instr(':'||:P114_DOCTYPE||':',':'||DocTypeCode||':') > 0
                  and MaterialInDate Between :P417_FROMDATE and :P417_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P417_LOCATION
            itemsToSubmit: P417_MINO
        }
        layout {
            sequence: 120
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Material In No
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P417_PARTY (
