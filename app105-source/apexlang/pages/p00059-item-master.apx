    process delete-item-specification (
        name: Delete Item Specification
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                delete from itemspecification where tno = :P59_TNO;
                delete from ITEMDETAIL where tno = :P59_TNO;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 140806401230370820
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
