page 59 (
    name: Item Master
    alias: ITEM-MASTER
    title: Item Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-Header-branding {
               height: 30px !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region account (
        name: Account
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @item-master
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
    )

    region characteristics (
        name: Characteristics
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       ITEMCHARACTERISTICSCODE,
                       REMARK
                  from ITEMDETAIL
                  where tno = :P59_TNO
                ```
            pageItemsToSubmit: P59_TNO
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 150218856320441547
        }

        savedReport 1518951 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @ITEMCHARACTERISTICSCODE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ITEMCHARACTERISTICSCODE (
            type: popupLov
            heading {
                heading: Item Characteristics
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ITEMCHARACTERISTICSNAME , ITEMCHARACTERISTICSCODE
                    from itemcharacteristics
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMCHARACTERISTICSCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column REMARK (
            type: textField
            heading {
                heading: Remark
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ROWID (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SNO (
            type: textField
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        column TNO (
            type: textField
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P59_TNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Characteristics
        }
    )

    region classification (
        name: Classification
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @item-master
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
    )

    region detail (
        name: DETAIL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.SNO,
                       A.ITEMSPECIFICATIONCODE,
                       A.ITEMSPECIFICATIONNAME,
                       A.MULTIPLYINGFACTOR,
                       A.MINIMUMLEVEL,
                       A.MAXIMUMLEVEL,
                       A.REORDERLEVEL,
                       A.REORDERQUANTITY,
                       A.LEADTIME,
                       A.INDENTINGPATTERN,
                       A.LASTPARTYCODE,
                       A.LASTRATE,
                       A.LASTDATE,
                       A.ECONOMICPARTYCODE,
                       A.ECONOMICRATE,
                       A.REMARK,
                       A.ISWEIGHMENTREQUIRED,
                       A.LASTRATEMEASURINGUNITCODE,
                       A.CESSRATE,
                       A.CRACCOUNTCODE,
                       A.DRACCOUNTCODE,
                       A.FORM4,
                       A.FORMD,
                       A.FORME,
                       A.CETSH,
                       A.STOCKACCOUNTCODE,
                       A.CONSUMPTIONACCOUNTCODE,
                       A.DOCUMENTSTATUSCODE,
                       A.OLDITEMCODE,
                       A.OLDITEMNAME,
                       A.BEFOREINSPECTIONSLCODE,
                       A.AFTERINSPECTIONSLCODE,
                       A.ISEQUIPMENT,
                       A.RG23,
                       A.CETSHCODE,
                       A.RG1,
                       A.ISCAPTIVEITEM,
                       A.CHARGEABLEISSUERATE,
                       A.ISSELECTED,
                       A.QUALITYREQUIRED,
                       A.CREATOR,
                       A.CREATEDON,
                       A.HSNCODE,
                       A.IMPORTTNO,
                       A.ITEMGRADECODE,
                       A.ITEMSIZECODE,
                       A.EMPLOYEEDEDUCTIONAMOUNT,
                       A.LIFEINMONTHS,
                       A.ISRETURNABLE,
                       A.ISVEHICLE,
                       A.ISREPLACEABLEITEM,
                       A.REPLACEABLEITEMCODE,
                       A.REPLACEABLEITEMSPECCODE,
                       A.WEIGHMENTUNITCODE,
                       A.ISAUTOINSPECTION,
                       A.LOTNOREQUIRED,
                       A.SKU,
                       A.ITEMLENGTHCODE,
                       A.ITEMWIDTHCODE,
                       A.ITEMTHICKNESSCODE,
                       A.ITEMMAKECODE
                      -- A.ATTCHMENT
                  from ITEMSPECIFICATION A
                  WHERE A.TNO = :P59_TNO
                ```
            pageItemsToSubmit: P59_TNO
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 140733045482367744
        }

