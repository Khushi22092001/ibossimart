    pageItem P59_CONSUMPTIONACCOUNTCODE (
        type: popupLov
        label {
            label: Cons./Variation Acc.
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                        A.PartyName ,
                        A.PartyCode 
                        from Party A 
                        Where A.Partytypecode = 'ACCOUNT'
                        Order By A.PartyCode Desc
                ```
            displayNullValue: false
        }
        layout {
            sequence: 180
            region: @account
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @item-master
            column: CONSUMPTIONACCOUNTCODE
            dataType: varchar2
        }
    )

    pageItem P59_CREATIONTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 550
            region: @other-informations
            slot: regionBody
        }
        appearance {
            formatMask: DD-MON-YYYY HH:MIPM
        }
        source {
            formRegion: @item-master
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MM-YYYY HH24:MI:SS') from dual
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P59_ITEMCODE
        }
    )

