page 263 (
    name: Module Flow List
    alias: MODULE-FLOW-LIST
    title: Module Flow List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region module-flow (
        name: Module Flow
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.TNo,
                       a.ModuleFlowNo,
                       f.ModuleFlowNo as "On Module Flow No",
                       b.ModuleName,
                       c.DocumentStatusName,
                       e.BossUserName,
                       d.updateprivilege,
                       d.onlyifcreator,
                       substr(getDocumentStatusCode('MODULEFLOW', a.TNO), 1, 100) As ModuleFlowStatus,
                       getmoduleflowcondition(a.tno) as Condition 
                  From ModuleFlow     a,
                       Module         b,
                       DocumentStatus c,
                       ModuleFlowUser d,
                       BossUser       e,
                       ModuleFlow     f
                 Where a.ModuleCode = b.ModuleCode
                   And a.DocumentStatusCode = c.DocumentStatusCode(+)
                   And a.TNo = d.TNo(+)
                   and a.ONPASSINGOFMODULEFLOWTNO= f.tno(+)
                   And d.BossUserCode = e.BossUserCode(+)
                 Order By b.ModuleName, a.ModuleFlowNo
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 264
                items: {
                    P264_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            conditionType: rowsReturned
            sqlQuery:
                ```sql
                Select 1
                  From module a, moduleprivilege b, bossuser c
                 Where a.modulecode = b.modulecode
                   And b.bossusercode = c.bossusercode
                   And c.loginname = :GLOBAL_LOGINNAME
                   And A.PAGENO = :APP_PAGE_ID
                   --and a.modulecode='CITY'
                   AND B.COMPANYCODE = :GLOBAL_COMPANYCODE
                   And B.UPDATEPRIVILEGE = 'YES'
                ```
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        actionsMenu {
            subscription: false
        }
        advanced {
            savedReportMappingIdentifier: 231370433397335795
        }

        column BOSSUSERNAME (
            type: plainText
            heading {
                heading: Boss User Name
                alignment: center
            }
            layout {
                sequence: 34
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column CONDITION (
