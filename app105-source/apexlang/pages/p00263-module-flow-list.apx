    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @module-flow
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 264
                clearCache: 264
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                  tModuleFlow number;
                  tmp         number;
                  tmp1        number;
                BEGIN
                   select count(*) into tmp1 from ModuleFlow a where a.modulecode = getmodulecodeforpageno(:APP_PAGE_ID);
                   if nvl(tmp1,0) > 0 then
                        select 
                            count(*) into tModuleFlow
                        from ModuleFlow a, ModuleFlowUser b, Bossuser c
                        where a.tno = b.tno
                          and b.bossusercode = c.bossusercode
                          and a.Modulecode = getmodulecodeforpageno(:APP_PAGE_ID)
                          and c.bossusername = :APP_USER
                          ;
                
                          if nvl(tModuleFlow,0) > 0 then
                             return(TRUE) ;
                          else
                             return(FALSE);
                          end if;
                     else
                            Select
                            	COUNT(*) into tmp 
                            From Module a, ModulePrivilege b, BossUser c
                            Where a.ModuleCode = b.ModuleCode
                            	and b.BossUsercode = c.BossUserCode
                            	and c.LoginName = :GLOBAL_LOGINNAME
                                and a.ModuleCode= getmodulecodeforpageno(:APP_PAGE_ID)
                            	and b.CompanyCode = :GLOBAL_COMPANYCODE
                            	and b.InsertPrivilege = 'YES' ;
                            if nvl(tmp,0) > 0 then
                               return(TRUE);
                            else
                               return(FALSE);
                            end if;
                      end if;
                              
                END;
                ```
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @module-flow
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @module-flow
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ig-pagination (
        name: IG Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

