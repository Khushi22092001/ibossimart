page 192 (
    name: " Item Opening List"
    alias: ITEM-OPENING-LIST
    title: " Item Opening List"
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
    )

    region item-opening-list (
        name: Item Opening List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                a.tno,
                a.LocationCode,
                getlocationname(a.locationCode) As "Location",
                a.DocTypeCode,
                GetStorageLocationName(a.storagelocationcode) as "StorageLoation",
                getdoctypename(a.DocTypecode) As "Doc Type",
                a.ItemOpeningNo as "Opening No",
                a.ItemOpeningDate as "Opening Date",
                a.ItemCode As "Item Code",
                getitemname(a.ItemCode) As "Item Name",
                getitemSpecificationname(a.ItemCode,a.ItemSpecificationCode) As "Item Specification Name",
                a.openingquantity1 As "Opening Quantity1",
                a.openingquantity2 As "Opening Quantity2",
                a.openingvalue As "Opening Value",
                a.creator,
                to_char(a.creationtime, 'dd-mm-rrrr hh24:mi') As "Creation Time",
                a.remark
                From ItemOpening a
                where  ( :P192_LOCATION IS NULL OR instr(':'||:P192_LOCATION||':',':'||A.LOCATIONCODE||':') > 0 )
                and ( :P192_ITEMCODE IS NULL OR instr(':'||:P192_ITEMCODE||':',':'||a.ItemCode||':') > 0 )
                and ( :P192_STORAGELOCATION IS NULL OR instr(':'||:P192_STORAGELOCATION||':',':'||a.storagelocationcode||':') > 0 )
                and ( :P192_COMPANY IS NULL OR instr(':'||:P192_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 193
                items: {
                    P193_TNO: #TNO#
                }
                clearCache: 193
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 398552520438229406
        }

