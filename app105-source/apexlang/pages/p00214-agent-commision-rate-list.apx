page 214 (
    name: Agent Commision Rate List
    alias: AGENT-COMMISION-RATE-LIST
    title: Agent Commision Rate List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region agent-commision-rate-list (
        name: Agent Commision Rate List
        type: interactiveReport
        source {
            location: localDatabase
            tableName: AGENTCOMMISSIONRATE
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 215
                items: {
                    P215_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 11009309499712715
        }

        column AGENTCODE (
            type: plainText
            heading {
                heading: Agent
                alignment: center
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column AGENTCOMMISSIONRATEDATE (
            type: plainText
            heading {
                heading: Agent Commission Rate Date
                alignment: center
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column AGENTCOMMISSIONRATENO (
            type: plainText
            heading {
                heading: Agent Commission Rate No
                alignment: center
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Company
                alignment: center
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
                alignment: center
            }
            layout {
                sequence: 12
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
                alignment: center
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DOCTYPECODE (
            type: plainText
            heading {
                heading: Doc Type
                alignment: center
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column EFFECTIVEDATE (
            type: plainText
            heading {
                heading: Effective Date
                alignment: center
            }
            layout {
                sequence: 9
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        column FINANCIALYEARCODE (
            type: plainText
            heading {
                heading: Financial Year
                alignment: center
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: Location
                alignment: center
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
                alignment: center
            }
            layout {
                sequence: 22
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Agent Commision Rate List
        }

        savedReport 110150 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AGENTCODE (
                sequence: 7
            )

            displayColumn AGENTCOMMISSIONRATEDATE (
                sequence: 6
            )

            displayColumn AGENTCOMMISSIONRATENO (
                sequence: 5
            )

            displayColumn COMPANYCODE (
                sequence: 1
