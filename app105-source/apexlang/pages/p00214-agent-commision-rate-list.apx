            displayColumn CREATIONTIME (
                sequence: 10
            )

            displayColumn CREATOR (
                sequence: 9
            )

            displayColumn DOCTYPECODE (
                sequence: 4
            )

            displayColumn EFFECTIVEDATE (
                sequence: 8
            )

            displayColumn FINANCIALYEARCODE (
                sequence: 2
            )

            displayColumn LOCATIONCODE (
