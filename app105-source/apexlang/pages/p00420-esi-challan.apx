    pageItem P420_FORMONTH (
        type: popupLov
        label {
            label: For Month
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                to_char(a.Fromdate, 'Mon-rrrr') as D,
                TO_CHAR(a.FromDate, 'DD-MM-RRRR') AS R
                from PeriodList a
                where a.PeriodType = 'MONTH'
                order by a.FromDate
                ```
        }
        layout {
            sequence: 120
            region: @esi-challan
