    pageItem P420_BANKACCOUNTCODE (
        type: popupLov
        label {
            label: Bank Account
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.PartyCode as BankAccountCode,
                a.PartyName as BankAccountName
                From Party a
                Where a.PartyTypeCode = 'BANK'
                Order by a.PartyName
                ```
        }
        layout {
            sequence: 310
            region: @esi-challan
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @esi-challan
            column: BANKACCOUNTCODE
            dataType: varchar2
        }
    )

