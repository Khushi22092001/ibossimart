                Select Distinct a.ESICEstablishmentCodeNo d,
                a.ESICEstablishmentCodeNo r
                  From Employee a
                 Where GetEmployeeCompanyCode(a.EmployeeCode, Trunc(Sysdate)) = :GLOBAL_COMPANYCODE
                 Order By 1
