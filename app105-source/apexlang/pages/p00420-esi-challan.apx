    pageItem P420_LOCATIONCODE (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.LocationName as d,
                	a.LocationCode as r
                from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                	and c.CompanyCode = :global_CompanyCode
                    and d.EntryPageNo = :APP_PAGE_ID
                    and getdocumentstatuscode('LOCATION',a.TNO) = 'ACTIVE'
                ```
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @esi-challan
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @esi-challan
            column: LOCATIONCODE
            dataType: varchar2
        }
    )

