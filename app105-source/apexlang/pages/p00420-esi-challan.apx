    process set-allowed-date (
        name: Set Allowed Date
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P420_FORMSTATUS = 'NEWRECORD' THEN 
                for vloop in (
                select
                		trunc(sysdate) - nvl(b.AllowedBackDays, 0) as AllowedBack,
                		trunc(sysdate) + nvl(b.AllowedForwardDays, 0) AllowedForward	
                		--a.FreezeDate
                        INTO :P420_ALLOWEDBACK,:P420_ALLOWEDFORWARD
                from Module a, ModulePrivilege b, BossUser c
                where a.ModuleCode = GetModuleCodeForpageNo(:APP_PAGE_ID)
                		and a.ModuleCode = b.ModuleCode
                		and b.BossUsercode = c.BossUserCode
                		and c.LoginName = :GLOBAL_LOGINNAME
                		and b.CompanyCode = :GLOBAL_CompanyCode
                ) loop
                     :P420_ALLOWEDBACK       := vloop.AllowedBack ; 
                    :P420_ALLOWEDFORWARD    := vloop.AllowedForward ;
                end loop;
                else
                    :P420_ALLOWEDBACK       := :P420_TDSCHALLANDATE ; 
                    :P420_ALLOWEDFORWARD    := :P420_TDSCHALLANDATE ;
                
                 end if;
                ```
        }
        execution {
            sequence: 140
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 21341913652187978
        }
    )

