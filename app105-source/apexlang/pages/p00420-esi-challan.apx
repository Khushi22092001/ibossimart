    dynamicAction check-codescheme (
        name: check codescheme
        execution {
            sequence: 400
        }
        when {
            event: focusout
            selectionType: items
            items: P420_MATERIALINDATE
        }

        action native-set-focus (
            action: setFocus
            affectedElements {
                selectionType: items
                items: P420_PARTYCODE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P420_CODESCHEME
                value: AUTO
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select CODESCHEME  from codescheme
                        where companycode = :global_companycode
                        and modulecode = GetModuleCodeForPageNo(:APP_PAGE_ID)
                        and FINANCIALYEARCODE = :global_FINANCIALYEARCODE;
                    ```
            }
            affectedElements {
                selectionType: items
                items: P420_CODESCHEME
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-lr (
        name: Check LR
        execution {
            sequence: 380
        }
        when {
            event: focusout
            selectionType: items
            items: P420_LRNO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        tmp number;
                        tmp1 number;
                    begin
                    
                    
                        select count(*) into tmp from materialin
                        where FINANCIALYEARCODE = :P420_FINANCIALYEARCODE
                        and TRANSPORTERCODE = :P420_TRANSPORTERCODE
                        and LRNO = :P420_LRNO;
                    
                       
                    
                        if nvl(tmp , 0)> 0   then 
                            raise_application_error(-20000,'LR NO is already used in Matrial In.');
                        end if;
                       
                    end;
                    ```
                itemsToSubmit: [
                    P420_FINANCIALYEARCODE
                    P420_PARTYCODE
                    P420_REFDOCTYPECODE
                    P420_REFDOCNO
                    P420_LRNO
                    P420_TRANSPORTERCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-ref-no (
        name: Check ref no
        execution {
            sequence: 370
        }
        when {
            event: focusout
            selectionType: items
            items: P420_REFDOCNO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare 
                        tmp number;
                        tmp1 number;
                    begin
                    
                    
                        select count(*) into tmp from materialin
                        where FINANCIALYEARCODE = :P420_FINANCIALYEARCODE
                        and PARTYCODE = :P420_PARTYCODE
                        and REFDOCTYPECODE = :P420_REFDOCTYPECODE
                        and REFDOCNO = :P420_REFDOCNO;
                    
                        select count(*) into tmp1 from grn    
                        where FINANCIALYEARCODE = :P420_FINANCIALYEARCODE
                        and PARTYCODE = :P420_PARTYCODE
                        and REFDOCTYPECODE = :P420_REFDOCTYPECODE
                        and REFDOCNO = :P420_REFDOCNO;
                    
                        if nvl(tmp , 0)> 0   then 
                            raise_application_error(-20000,'REF DOC NO is already used in Matrial In.');
                        end if;
                        if nvl(tmp1 , 0)> 0   then 
                            raise_application_error(-20000,'REF DOC NO is already used in GRN.');
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P420_FINANCIALYEARCODE
                    P420_PARTYCODE
                    P420_REFDOCTYPECODE
                    P420_REFDOCNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: delete unsaved data
        execution {
            sequence: 390
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from MATERIALINDETAIL a
                        where not exists (
                            select 1 from MATERIALIN  aa  
                            where aa.tno = a.tno
                        ) and a.tno = :P420_TNO;
                    ```
                itemsToSubmit: P420_TNO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P420_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 70
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from grn a
                    where a.materialintno = :P420_TNO;
                    ```
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    ```
            }
        )

    )

