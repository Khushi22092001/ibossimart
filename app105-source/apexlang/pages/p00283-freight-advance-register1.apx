    pageItem P283_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = getModuleCodeForPageNo(:APP_PAGE_ID)
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and upper(bu.BossUserName) =  upper('&APP_USER.')
                  and getcompanyprivilege(C.COMPANYCODE,GETMODULECODEFORPAGENO(:APP_PAGE_ID),:GLOBAL_LOGINNAME)='YES'
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
    )

    pageItem P283_DESTINATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Destination
            alignment: left
        }
        settings {
