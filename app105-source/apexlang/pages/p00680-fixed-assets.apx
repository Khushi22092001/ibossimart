    pageItem P680_ASONDATE (
        type: datePicker
        label {
            label: As On Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @dummy
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P680_FINANCIALYEARBEGIN (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @dummy
            slot: regionBody
        }
        default {
            type: item
            item: GLOBAL_FINANCIALYEARBEGIN
        }
    )

    pageItem P680_FINANCIALYEARCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @dummy
            slot: regionBody
        }
        default {
            type: item
            item: GLOBAL_FINANCIALYEARCODE
        }
    )

    pageItem P680_LOCATIONCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @dummy
            slot: regionBody
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 20
            region: @dummy
            slot: regionBody
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh (
        name: Refresh
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @fixed-assets
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-value (
        name: set value
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P680_ASONDATE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select a.financialyearbegin, a.financialyearcode
                    from financialyear a
                    where :P680_ASONDATE between a.FINANCIALYEARBEGIN and a.financialyearend
                    ;
                    ```
                itemsToSubmit: P680_ASONDATE
            }
            affectedElements {
                selectionType: items
                items: [
                    P680_FINANCIALYEARBEGIN
                    P680_FINANCIALYEARCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

