    region new (
        name: New
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT a.tno,
                       a.sno,
                       a.particular,
                       a.openingdr,
                       a.openingcr,
                       a.debit,
                       a.credit,
                       a.closingdr,
                       a.closingcr,
                       a.creator,
                       a.fromdate,
                       a.todate,
                       :P249_PARTY as party
                FROM summary_temp a
                WHERE TNO = :p249_TNO 
                
                ```
            pageItemsToSubmit: [
                P249_TNO
                P249_PARTY
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
