page 240 (
    name: User Privilege Extra
    alias: USER-PRIVILEGE-EXTRA
    title: User Privilege Extra
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            t-Dialog--noPadding
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        height: 400
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region user-privilege-extra (
        name: User Privilege Extra
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.EXTRAPRIVILEGECODE,
                       a.SNO,
                       a.remark,
                       b.EXTRAPRIVILEGEName
                  from ModulePrivilegeExtra a, ExtraPrivilege b
                 where a.EXTRAPRIVILEGECode = b.EXTRAPRIVILEGECode(+)
                   and a.TNO = :P240_TNO
                ```
            pageItemsToSubmit: P240_TNO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 47
                items: {
                    P47_TNO: &P46_TNO.
                    P47_SNO: \#SNO#\
                }
                clearCache: 47
                action: resetPagination
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            includeSearchBar: false
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 133495747637597381
        }

        column EXTRAPRIVILEGECODE (
            type: plainText
            heading {
                heading: Extraprivilegecode
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column EXTRAPRIVILEGENAME (
            type: plainText
            heading {
                heading: Extra Privilege Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column SNO (
            type: hidden
            heading {
                heading: Sno
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        savedReport 54920 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EXTRAPRIVILEGENAME (
                sequence: 1
            )

            displayColumn REMARK (
                sequence: 2
            )

        )

    )

    pageItem P240_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @user-privilege-extra
            slot: regionBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 10
            region: @user-privilege-extra
            slot: regionBody
            column: 10
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 47
                items: {
                    P47_TNO: &P240_TNO.
                }
                clearCache: 47
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @user-privilege-extra
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-privilege-extra
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

