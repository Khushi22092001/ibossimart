            )

            displayColumn IGST (
                sequence: 25
            )

            displayColumn INVOICEAMOUNT (
                sequence: 30
            )

            displayColumn INVOICEDATE (
                sequence: 17
            )

            displayColumn INVOICENO (
                sequence: 16
            )

            displayColumn ITCAVAILABILITY (
                sequence: 10
            )

            displayColumn MODULE (
                sequence: 5
            )

            displayColumn NAMEOFSITE (
                sequence: 2
            )

            displayColumn NAMEOFSUPPLIER (
                sequence: 11
            )

            displayColumn OTHERINCIDENTALAMOUNT (
                sequence: 29
            )

            displayColumn PARTICULAROFITEMJOB (
                sequence: 18
            )

            displayColumn QUANTITY (
                sequence: 20
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SGST (
                sequence: 27
            )

            displayColumn SUPPLIERGSTIN (
                sequence: 14
            )

            displayColumn SUPPLIERPANNO (
                sequence: 15
            )

            displayColumn SUPPLIERSTATE (
                sequence: 12
            )

            displayColumn TAXABLEVALUEBEFORETAX (
                sequence: 24
            )

            displayColumn TOTALTAX (
                sequence: 28
            )

            displayColumn TRANSACTIONTYPECODE (
                sequence: 22
            )

            displayColumn TYPEOFREGISTRATION (
                sequence: 8
            )

            displayColumn UNIT (
                sequence: 21
            )

            displayColumn VOUCHERDATE (
                sequence: 4
            )

            displayColumn VOUCHERNO (
                sequence: 3
            )

            sort (
                column: SERIALNO
                sort {
                    sequence: 1
                }
            )

            sort (
                column: VOUCHERDATE
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: IGST
            )

            aggregate (
                column: CGST
            )

            aggregate (
                column: SGST
            )

            aggregate (
                column: TOTALTAX
            )

            aggregate (
                column: OTHERINCIDENTALAMOUNT
            )

            aggregate (
                column: TAXABLEVALUEBEFORETAX
            )

            aggregate (
                column: INVOICEAMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region gst-input-report-as-per-voucher (
        name: GST Input Report As Per Voucher
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P231_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                  Select 
                     b.CompanyName d,
                     b.CompanyCode r
                  From Company b
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @gst-input-report-as-per-voucher
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Company
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P231_COMPANYGSTIN (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company GSTIN
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select getcompanyattributevalue(A.COMPANYCODE, 'GSTINNO') d,
                getcompanyattributevalue(A.COMPANYCODE, 'GSTINNO') r
                 From COMPANY a
                /*Select
                       Distinct
                       p.GSTINNO d,
                       p.GSTINNO r
                From LOCATIONGSTINDETAIL p
                Order By 1
                */
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @gst-input-report-as-per-voucher
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P231_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @gst-input-report-as-per-voucher
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
