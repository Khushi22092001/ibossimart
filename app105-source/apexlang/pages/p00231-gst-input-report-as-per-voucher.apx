        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: GST Input Report
        }

        savedReport 129683 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100
            }

            displayColumn CGST (
                sequence: 26
            )

            displayColumn DEALERTYPE (
                sequence: 7
            )

            displayColumn ENTRYNO (
                sequence: 6
            )

            displayColumn GSTRATEAPPLICABILITY (
