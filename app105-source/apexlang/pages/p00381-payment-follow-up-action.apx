        }
    )

    branch (
        name: Land on Same Page after Revision
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 381
                items: {
                    P381_TNO: &P381_TNO.
                    P381_FORMSTATUS: EDITRECORD
                    P381_PAYMENTFOLLOWUPNO: &P381_PAYMENTFOLLOWUPNO.
                }
                clearCache: 381
            }
        }
        serverSideCondition {
            whenButtonPressed: @revise
        }
    )

)

