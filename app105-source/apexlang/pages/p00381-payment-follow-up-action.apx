    pageItem P381_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 230
            region: @payment-follow-up-action
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                	begin
                	If :P381_TNO is null then
                		return('NEWRECORD');
                	else
                		return('EDITRECORD');
                	End if;
                	end ;
                ```
        }
    )

