                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P381_STATUS'));
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P381_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

