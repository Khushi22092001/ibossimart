page 381 (
    name: Payment Follow-up Action
    alias: PAYMENT-FOLLOW-UP-ACTION
    title: Payment Follow-up Action
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            /* #P381_CALLINGDATE .apex-item-datepicker{
                width: 400px;
            }
            #P381_NEXTFOLLOWUPDATE .apex-item-datepicker{
                width: 400px;
            } */
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region audit-info (
        name: Audit Info
        type: staticContent
        layout {
            sequence: 20
            slot: footer
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noUI
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region call-execution-next-action (
        name: Call Execution & Next Action
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @payment-follow-up-action
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region general (
        name: General
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @payment-follow-up-action
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region invoice-financial-details (
        name: Invoice & Financial Details
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @payment-follow-up-action
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region payment-follow-up-action (
        name: Payment Follow-up Action
        type: form
        source {
            location: localDatabase
            tableName: PAYMENTFOLLOWUPACTION
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        readOnly {
            type: item=value
            item: P381_IS_READONLY
            value: 1
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P381_ALLOWEDBACK (
