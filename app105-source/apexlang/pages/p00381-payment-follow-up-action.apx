    button add-new (
        buttonName: ADD_NEW
        label: Add New
        layout {
            sequence: 50
            region: @buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pillEnd
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                items: {
                    "P&APP_PAGE_ID._FORMSTATUS": NEWRECORD
                }
                clearCache: &APP_PAGE_ID.
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P381_FORMSTATUS = 'EDITRECORD' 
                AND CHECK_USER_PRIVILEGE(:GLOBAL_BOSSUSERCODE,:GLOBAL_COMPANYCODE,383,'INSERT') = 1 
                AND :P381_TNO IS NOT NULL
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 30
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 377
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 70
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
                :P381_FORMSTATUS = 'NEWRECORD' 
                -- AND CHECK_USER_PRIVILEGE(:GLOBAL_BOSSUSERCODE,:GLOBAL_COMPANYCODE,383,'INSERT') = 1 
                AND :P381_TNO IS NULL
                ```
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 50
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression:
                ```plsql
