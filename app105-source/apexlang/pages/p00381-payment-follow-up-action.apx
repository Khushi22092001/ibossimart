                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action set-document-status (
            name: Set Document Status
            action: executeServerSideCode
            settings {
                plsqlCode: SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P381_TNO,:P381_STATUS);
                itemsToSubmit: [
                    P381_TNO
                    P381_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction get-the-invoice-balance (
        name: Get the Invoice Balance
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P381_INVOICETNO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT NVL(SUM(InvoiceAmount), 0)
                    FROM Invoice
                    WHERE TNo IN (
                        SELECT REGEXP_SUBSTR(:P381_INVOICETNO, '[^:]+', 1, LEVEL)
                        FROM DUAL
                        CONNECT BY REGEXP_SUBSTR(:P381_INVOICETNO, '[^:]+', 1, LEVEL) IS NOT NULL
                    )
                    
                    ```
                itemsToSubmit: P381_INVOICETNO
            }
            affectedElements {
                selectionType: items
                items: P381_INVOICEBALANCE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process generate-document-no (
        name: Generate Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    V_MODULE_CODE VARCHAR2(30);
                BEGIN
                    V_MODULE_CODE := GETMODULECODEFORPAGENO(:APP_PAGE_ID);
                
                    IF :P381_PAYMENTFOLLOWUPNO IS NULL THEN
                        
                        SETDOCNONEXT(
                            pModuleCode        => V_MODULE_CODE,
                            pCompanyCode       => :GLOBAL_COMPANYCODE,
                            pFinancialYearCode => :GLOBAL_FINANCIALYEARCODE,
                            pLocationCode      => :P381_LOCATIONCODE,
                            pDocTypeCode       => :P381_DOCTYPECODE,
                            pOtherCode         => NULL,
                            pTransactionDate   => :P381_PAYMENTFOLLOWUPDATE
                        );
                
                        :P381_PAYMENTFOLLOWUPNO := GETDOCNO(
                            pModuleCode        => V_MODULE_CODE,
                            pCompanyCode       => :GLOBAL_COMPANYCODE,
                            pFinancialYearCode => :GLOBAL_FINANCIALYEARCODE,
                            pLocationCode      => :P381_LOCATIONCODE,
                            pDocTypeCode       => :P381_DOCTYPECODE,
                            pOtherCode         => NULL,
                            pTransactionDate   => :P381_PAYMENTFOLLOWUPDATE
                        );
                        
                    END IF;
                END;
                
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 5591473894959805
        }
    )

