    pageItem P381_PARTYCODE (
        type: selectOne
        label {
            label: Party
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                     P.PARTYNAME||', '||GETCITYNAME(P.OFFICECITYCODE)||', '||GETSTATENAME(P.OFFICESTATECODE) AS D,
                     P.PARTYCODE AS R
                FROM CCINVOICE CI
                LEFT JOIN PARTY P ON P.PARTYCODE = CI.PARTYCODE
                ```
        }
        layout {
            sequence: 10
            region: @invoice-financial-details
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
