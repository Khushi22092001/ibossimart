    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.SNO,
                       A.SERIALNO,
                       A.STOCKTNO,
                       A.STORAGELOCATIONCODE,
                       A.RATE,
                       A.AMOUNT,
                       A.QUANTITY1,
                       A.QUANTITY2,
                       A.REMARK,
                       getmeasuringunitname(c.measuringunitcode1) as UOM1,
                       getmeasuringunitname(c.measuringunitcode2) as UOM2
                  from STOCKREVALUATIONDETAIL a, stock b, item c
                  where a.stocktno = b.tno
                    and b.itemcode = c.itemcode
                    AND A.TNO = :P244_TNO
                ```
            pageItemsToSubmit: P244_TNO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
