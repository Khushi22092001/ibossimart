                ```sql
                select TNO,
                       FINANCIALYEARCODE,
                       COMPANYCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       STOCKREVALUATIONNO,
                       STOCKREVALUATIONDATE,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       EMPLOYEECODE,
                       ASONDATE,
                       SUMOFQUANTITY1,
                       SUMOFQUANTITY2,
                       AMOUNT,
                       VALUATIONRATE,
                       REMARK,
                       CREATOR,
                       CREATIONTIME,
                       STORAGELOCATIONCODE,
                       NEWQUANTITY1,
                       NEWQUANTITY2,
                       NVL(getdocumentstatuscode(getmodulecodeforpageno(:APP_PAGE_ID),TNO),'STATUS') AS STATUS
                  from STOCKREVALUATION
                ```
