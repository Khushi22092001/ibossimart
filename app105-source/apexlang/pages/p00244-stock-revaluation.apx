    process update-master (
        name: "Update Master "
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                 tquantity1  number;
                 tquantity2 number;
                begin
                    select sum(quantity1), sum(quantity2) into tquantity1, tquantity2 from stockrevaluationdetail a
                    where a.tno = :P244_tno;
                
                    update stockrevaluation
                    set sumofquantity1 = tquantity1,
                        sumofquantity2 = tquantity2
                    where tno = :P244_TNO;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 75195771895386446
        }
    )

