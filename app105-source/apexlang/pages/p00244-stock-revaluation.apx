    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            if :SNO is null then
                                select globaltno.nextval into :sno from dual;
                            end if;
                            Insert Into STOCKREVALUATIONDETAIL  (                 
                                   TNO,
                                   SNO,
                                   SERIALNO,
                                   STOCKTNO,
                                   STORAGELOCATIONCODE,
                                   RATE,
                                   AMOUNT,
                                   QUANTITY1,
                                   QUANTITY2,
                                   REMARK
                
                            )
                            Values (
                                   :TNO,
                                   :SNO,
                                   :SERIALNO,
                                   :STOCKTNO,
                                   :STORAGELOCATIONCODE,
                                   :RATE,
                                   :AMOUNT,
                                   :QUANTITY1,
                                   :QUANTITY2,
                                   :REMARK
                
                            );
                        
                        when 'U' then
                            update STOCKREVALUATIONDETAIL 
                               SET TNO      = :TNO      ,
                                   SNO      = :SNO      ,
                                   SERIALNO = :SERIALNO ,
                                   STOCKTNO = :STOCKTNO ,
                                   STORAGELOCATIONCODE = :STORAGELOCATIONCODE,
                                   RATE     = :RATE         ,
                                   AMOUNT   = :AMOUNT       ,
                                   QUANTITY1= :QUANTITY1    ,
                                   QUANTITY2= :QUANTITY2    ,
                                   REMARK   = :REMARK
                
                            WHERE TNO = :P244_TNO
                            ;
                
                        when 'D' then
                            Delete From STOCKREVALUATIONDETAIL 
                            Where TNo = :P244_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 75195386689386442
        }
    )

    process get-document-no (
