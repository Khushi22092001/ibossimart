    pageItem P135_MODULE (
        type: popupLov
        label {
            label: Module
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select modulename,modulecode from module a 
                where  (nvl(a.pageno, '1') != 1 Or a.MODULECODE = 'ACTION')
                order by 1
                ```
            nullDisplayValue: -Select -
        }
        layout {
            sequence: 20
            region: @parameters
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    pageItem P135_MODULEGROUP (
        type: popupLov
        label {
            label: Module Group
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct a.modulegroupname d, a.modulegroupcode r
                  From ModuleGroup a, Module b
                 Where a.ModuleGroupCode = b.ModuleGroupCode
                   And (nvl(b.pageno, '1') != 1 Or b.MODULECODE = 'ACTION')
                 Order By 1
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 40
            region: @parameters
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

