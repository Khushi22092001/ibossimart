            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @new
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-privilege
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

