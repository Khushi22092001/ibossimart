page 333 (
    name: PF Challan
    alias: PF-CHALLAN
    title: PF Challan
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent15
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region pf-challan-list (
        name: PF Challan List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,a.LocationCode,b.Locationname,c.DocTypeName,x.salaryheadname As PFSALARYHEADNAME,
                z.salaryheadname As PFDEDUCTIONONSALARYHEADNAME,
                TO_CHAR(A.formonth, 'Month, rrrr') As forMonth,a.PFDEDUCTEDONAMOUNT,a.PFAMOUNT
                  From PFCHALLAN  A,
                       LOCATION   B,
                       DOCTYPE    C,
                       SALARYHEAD X,
                       SALARYHEAD Z,
                       bank       d,
                       Voucher    v
                 Where a.LocationCode = b.LocationCode
                   And a.DocTypeCode = c.DocTypeCode
                   And A.PFDEDUCTEDONSALARYHEADCODE = Z.SALARYHEADCODE(+)
                   And A.PFSALARYHEADCODE = X.SALARYHEADCODE(+)
                   And a.bankcode = d.bankcode(+)
                   And a.Tno = v.ModuleTno(+)
                      -- filter
                  and ( :P333_FROMDATE is null OR (a.PFChallanDate between :P333_FROMDATE and :P333_TODATE))
                  and (:P333_COMPANY is null  OR (instr(':'||:P333_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  and (:P333_LOCATION is null OR (instr(':'||:P333_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and (:P333_DOCTYPE is null  OR (instr(':'||:P333_DOCTYPE||':',':'||a.DocTypeCode||':') > 0))
                 
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 334
                items: {
                    P334_TNO: \#TNO#\
                }
                clearCache: 334
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 116205526293110629
        }

        column DOCTYPENAME (
            type: plainText
            heading {
                heading: Doctypename
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column FORMONTH (
            type: plainText
            heading {
                heading: Formonth
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: W
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: Locationcode
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column LOCATIONNAME (
            type: plainText
            heading {
                heading: Locationname
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column PFAMOUNT (
            type: plainText
            heading {
                heading: Pfamount
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Y
            }
        )

        column PFDEDUCTEDONAMOUNT (
            type: plainText
            heading {
                heading: Pfdeductedonamount
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: X
            }
        )

        column PFDEDUCTIONONSALARYHEADNAME (
            type: plainText
            heading {
                heading: Pfdeductiononsalaryheadname
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: V
            }
        )

        column PFSALARYHEADNAME (
            type: plainText
            heading {
                heading: Pfsalaryheadname
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cheque Receipt List
        }

        savedReport 321406 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DOCTYPENAME (
                sequence: 1
            )

            displayColumn FORMONTH (
                sequence: 2
            )

            displayColumn LOCATIONCODE (
                sequence: 3
            )

            displayColumn LOCATIONNAME (
                sequence: 4
            )

            displayColumn PFAMOUNT (
                sequence: 5
            )

            displayColumn PFDEDUCTEDONAMOUNT (
                sequence: 6
            )

            displayColumn PFDEDUCTIONONSALARYHEADNAME (
                sequence: 7
            )

            displayColumn PFSALARYHEADNAME (
                sequence: 8
            )

        )

    )

    pageItem P333_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @filter
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P333_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'PFCHALLAN'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
    )

    pageItem P333_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      dt.DocTypeName d,
                      dt.DocTypeCode r
                From  ModulePrivilege a, ModulePrivilegeDocType b, DocType dt, BossUser bu, ModuleDocType md, ModuleDocTypeDetail mdd
                Where a.TNo = b.TNo(+)
                  and (b.DocTypeCode = dt.DocTypeCode or b.DocTypeCode is null)
                  and a.ModuleCode = md.ModuleCode
                  and md.TNo = mdd.TNo
                  and mdd.DocTypeCode = dt.DocTypeCode
                  and a.ModuleCode = GetModuleCodeForPageNo(:APP_PAGE_ID)
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                  and instr(':'||:P333_COMPANY||':',':'||a.CompanyCode||':') > 0
                Order by 1
                ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P333_COMPANY
            itemsToSubmit: P333_COMPANY
        }
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Doc Type Name
        }
    )

    pageItem P333_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)-7
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P333_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode =GetModuleCodeForPageNo(:APP_PAGE_ID)
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                
                Order By 1
                ;
                
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Location Name
        }
    )

    pageItem P333_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @/title
            slot: regionBody
        }
    )

    pageItem P333_TNO_1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @filter
            slot: regionBody
        }
    )

    pageItem P333_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 50
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: To Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @pf-challan-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 334
                clearCache: 334
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @pf-challan-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            startNewRow: false
            column: 12
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

