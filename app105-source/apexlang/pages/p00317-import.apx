    dynamicAction import-file (
        name: import file
        execution {
            sequence: 270
        }
        when {
            event: click
            selectionType: button
            button: @import
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //------
                    var i = $v('P317_IMPORTFOR');
                    var x = apex.item('P317_TNO').getValue();
                    
                    
                    if (i == 'PARTY') 
                        {
                            var url = "f?p=#APP_ID#:315:#SESSION#::NO:RP,315:P315_TNO:#P_TNO#";
                        }
                    
                    if (i == 'ACCOUNTOPENING') 
                        {
                            var url = "f?p=#APP_ID#:318:#SESSION#::NO:RP,318:P318_TNO:#P_TNO#";
                        }
                    
                    if (i == 'ITEM') 
                        {
                            var url = "f?p=#APP_ID#:358:#SESSION#::NO:RP,358:P358_TNO:#P_TNO#";
                        }
                    
                    if (i == 'ITEMOPENING') 
                        {
                            var url = "f?p=#APP_ID#:359:#SESSION#::NO:RP,359:P359_TNO:#P_TNO#";
                        }
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#P_TNO#", x);
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

