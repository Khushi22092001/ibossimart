    process import-in-main-table (
        name: import in main table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                        if :P317_IMPORTFOR = 'PARTY' then
                            ProcessImportAccount(:P317_TNO);
                        elsif :P317_IMPORTFOR = 'ACCOUNTOPENING' then
                            ProcessImportAccountOpening(:P317_TNO);
                        elsif :P317_IMPORTFOR = 'ITEM' then
                            ProcessImportItem(:P317_TNO);
                        elsif :P317_IMPORTFOR = 'ITEMOPENING' then
                            
                            ProcessImportItemOpening(:P317_TNO);
                        end if;
                
                end;
                ```
        }
        execution {
            sequence: 90
        }
        advanced {
            executionMappingIdentifier: 24436029237720549
        }
    )

