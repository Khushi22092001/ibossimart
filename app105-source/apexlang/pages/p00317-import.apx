    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P317_Tno is null then
                        Select GlobalTno.NextVal into :P317_Tno From Dual;
                     end if;
                    ----
                    if :P317_IMPORTNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P317_LocationCode,
                					:P317_DocTypeCode,
                					NULL,
                					TO_DATE(:P317_IMPORTDATE, 'DD-MM-RRRR')
                				);
                        :P317_IMPORTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P317_LocationCode,
                                    :P317_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P317_IMPORTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 27429489944598679
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P317_TNO is null then
                    :P317_TNO := GlobalTNo.nextval;
                    :P317_FORMSTATUS := 'NEWRECORD';
                else
                    :P317_FORMSTATUS := 'EDITRECORD';
                End if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
