    dynamicAction check-freight-type-code (
        name: Check Freight Type Code
        execution {
            sequence: 110
        }
        when {
            event: focusout
            selectionType: items
            items: P79_FREIGHTTYPECODE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P79_FREIGHTTYPECODE")).length===0 ) {
                        showError("Freight Type Code Should Not be Empty", 'P79_FREIGHTTYPECODE');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-freight-type-name (
        name: Check Freight Type Name
        execution {
            sequence: 100
        }
        when {
            event: focusout
            selectionType: items
            items: P79_FREIGHTTYPENAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
