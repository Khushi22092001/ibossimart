page 79 (
    name: Freight Type Master
    alias: FREIGHT-TYPE-MASTER
    title: Freight Type Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region freight-type-master (
        name: Freight Type Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       FREIGHTTYPECODE,
                       FREIGHTTYPENAME,
                       ISFREIGHTREQUIRED,
                       ISBILLREQUIRED,
                       REMARK,
                       DEBITPARTYACCOUNT,
                       MODULECODE
                  from FREIGHTTYPE
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P79_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P79_DEBITPARTYACCOUNT (
        type: checkbox
        label {
            label: Debit Party Account
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: YES
            uncheckedValue: NO
        }
        layout {
            sequence: 110
            region: @freight-type-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @freight-type-master
            column: DEBITPARTYACCOUNT
            dataType: varchar2
        }
    )

    pageItem P79_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 210
            region: @fields
            slot: regionBody
        }
    )

    pageItem P79_FREIGHTTYPECODE (
        type: textField
        label {
            label: Freight Type Code
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 70
            region: @freight-type-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @freight-type-master
            column: FREIGHTTYPECODE
            dataType: varchar2
        }
    )

