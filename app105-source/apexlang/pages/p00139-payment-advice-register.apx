    pageItem P139_STATUSS (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Status
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                DISTINCT
                C.DOCUMENTSTATUSNAME d,
                C.DOCUMENTSTATUSCODE r
                FROM DOCUMENTSTATUSDETAIL B, DOCUMENTSTATUS C,PAYMENTADVICE A
                WHERE B.DOCUMENTSTATUSCODE = C.DOCUMENTSTATUSCODE(+)
                AND B.MODULETNO = A.TNO(+)
                AND B.MODULECODE = 'PAYMENTADVICE'
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 100
            region: @filter
