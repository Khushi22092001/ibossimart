                  '&P_LOCATION=' + $('#P139_LOCATION').val() + 
                  '&P_FROMDATE=' +$('#P139_FROMDATE').val() + 
                  '&P_TODATE=' +$('#P139_TODATE').val() + 
                   '&P_DOCTYPE=' +$('#P139_DOCTYPE').val() +
