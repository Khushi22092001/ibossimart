    process get-company-vehicle-code (
        name: Get Company Vehicle Code
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'COMPANYVEHICLE';
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P91_COMPANYVEHICLECODE is null then
                            setCodeNext(tModuleCode);
                	  		:P91_COMPANYVEHICLECODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 145789485874188414
        }
    )

    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P91_TNO is null then
                            :P91_FORMSTATUS := 'NEWRECORD';
                        else
                            :P91_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P91_TNO is null then
                
                        select globaltno.nextval into :P91_TNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 145126719745593620
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P91_MODULEFLOW := 'YES';
                   else
                       :P91_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P91_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P91_ONTHETABLE := 'YES' ;
                   else
                       :P91_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 145127072084594122
        }
    )

