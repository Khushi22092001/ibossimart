    dynamicAction check-company-vehicle-name (
        name: Check Company Vehicle Name
        execution {
            sequence: 110
        }
        when {
            event: focusout
            selectionType: items
            items: P91_COMPANYVEHICLENAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P91_COMPANYVEHICLENAME")).length===0 ) {
                        showError("Company Vehicle Name Should Not be Empty", 'P91_COMPANYVEHICLENAME');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

