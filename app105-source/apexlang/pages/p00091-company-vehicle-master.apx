page 91 (
    name: Company Vehicle Master
    alias: COMPANY-VEHICLE-MASTER
    title: Company Vehicle Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 800
        height: 400
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region company-vehicle-master (
        name: Company Vehicle Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYVEHICLECODE,
                       COMPANYVEHICLENAME,
                       COMPANYVEHICLESHORTNAME,
                       COMPANYVEHICLENO,
                       VEHICLETYPECODE,
                       PARTYCODE,
                       TAREWEIGHT,
                       CREATOR,
                       CREATIONTIME,
                       REMARK,
                       VEHICLEOWNERCODE,
                        TRANSPORTERCODE,
                        ENGINENO,
                        CHASISNO,
                        MANUFACTURINGYEAR,
                        MODELNO,
                        TANKSIZE,
                        VEHICLEGROUPCODE
                  from COMPANYVEHICLE
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    pageItem P91_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P91_CHASISNO (
        type: textField
        label {
            label: Chasis No
            alignment: left
        }
        layout {
            sequence: 130
            region: @company-vehicle-master
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 37
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @company-vehicle-master
            column: CHASISNO
            dataType: varchar2
        }
    )

    pageItem P91_COMPANYVEHICLECODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @company-vehicle-master
            slot: regionBody
        }
        source {
            formRegion: @company-vehicle-master
            column: COMPANYVEHICLECODE
            dataType: varchar2
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'COMPANYVEHICLE';
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO';
                
                     if nvl(tmp,0) > 0 and :P91_COMPANYVEHICLECODE is null then
                            setCodeNext(tModuleCode);
                	  		tmp := getCode(tModuleCode) ;
                     end if;
                     return nvl(tmp , 0);
                end;
                ```
        }
    )

