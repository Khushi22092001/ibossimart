    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    pageItem P280_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @filter
            slot: regionBody
            alignment: left
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: sysdate-7
        }
    )

    pageItem P280_INVOICE (
        type: popupLov
        label {
            label: Invoice
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                a.InvoiceNo,
                a.tno 
                from InvoiceForEWayBill a, Party b
                where a.PartyCode = b.PartyCode
                and a.InvoiceDate between :P280_FROMDATE and :P280_TODATE
                and a.InvoiceNo like nvl(:P280_INVOICE, '%')
                and a.LocationCode like nvl(:P280_LOCATION, '%')
                and a.ModuleCode = :P280_MODULE
                order by 1
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P280_FROMDATE
                P280_TODATE
                P280_MODULE
                P280_LOCATION
            ]
            itemsToSubmit: [
                P280_MODULE
                P280_LOCATION
                P280_FROMDATE
                P280_TODATE
                P280_INVOICE
            ]
        }
        layout {
            sequence: 50
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P280_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.LocationName as d,
                	a.LocationCode as r
                from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                	and c.CompanyCode = :global_CompanyCode
                    and d.EntryPageNo = :APP_PAGE_ID
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P280_MODULE (
        type: popupLov
        label {
            label: Module
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.ModuleName,
                a.ModuleCode
                from Module a
                where a.ModuleCode in ('CCINVOICE')
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P280_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: expression
            plsqlExpression: sysdate
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
            column: 9
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button uploadewbno (
        buttonName: UploadEWBNo
        label: Upload EWB No
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            startNewRow: false
            column: 11
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-upload
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction upload (
        name: upload
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @uploadewbno
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    for i in (
                        select 
                           MODULETNO,
                           MODULECODE,
                           SUPPLYTYPE,       
                           DOCNO,
                           DOCDATE,      
                           FROMGSTIN,    
                           EWBNO,
                           EWBDATE,
                           VALIDTILLDATE
                      from INVOICEFOREWAYBILL
                      where INVOICEDATE between :P280_FROMDATE and :P280_TODATE
                    and ( :P280_LOCATION IS NULL OR instr(':'||:P280_LOCATION||':',':'||LOCATIONCODE||':') > 0 )
                    and ( :P280_MODULE IS NULL OR instr(':'||:P280_MODULE||':',':'||MODULECODE||':') > 0 )
                    and ( :P280_INVOICE IS NULL OR instr(':'||:P280_INVOICE||':',':'||TNO||':') > 0 )
                    )
                    
                    loop
                        UpdateEWBNo(i.ModuleCode, i.ModuleTNo, i.SupplyType, i.DocNo, i.DocDate, i.FROMGSTIN, i.EWBNo, i.EWBDate, i.ValidTillDate);
                    end loop;
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: alert('Uploaded!');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

