page 655 (
    name: EXPENSETYPE
    alias: EXPENSETYPE
    title: Expensive Type
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region expensetype (
        name: EXPENSETYPE
        type: interactiveReport
        source {
            location: localDatabase
            tableName: EXPENSETYPE
            includeRowidColumn: true
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 656
                items: {
                    P656_TNO: #TNO#
                }
                clearCache: 656
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 43710524833486550
        }

        column CREATIONTIME (
            type: hidden
            heading {
                heading: Creationtime
            }
            layout {
                sequence: 51
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: P
            }
        )

        column CREATOR (
            type: hidden
            heading {
                heading: Creator
            }
            layout {
                sequence: 41
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column EXPENSETYPECODE (
            type: plainText
            heading {
                heading: Expensetype Code
                alignment: center
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column EXPENSETYPENAME (
            type: plainText
            heading {
                heading: Expensetyp Name
                alignment: center
            }
            layout {
                sequence: 21
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
                alignment: center
            }
            layout {
                sequence: 31
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column ROWID (
            type: plainText
            heading {
                heading: Rowid
            }
            layout {
                sequence: 61
            }
            source {
                dataType: OTHER
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: S
            }
            enableUsersTo {
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 1
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: EXPENSETYPE
        }

        savedReport 174790 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EXPENSETYPECODE (
                sequence: 1
            )

            displayColumn EXPENSETYPENAME (
                sequence: 2
            )

            displayColumn REMARK (
                sequence: 3
            )

        )

    )

    pageItem P655_TNO (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @expensetype
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 656
                clearCache: 656
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @expensetype
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

