page 9995 (
    name: Attachment Preview
    alias: ATTACHMENT-PREVIEW
    title: Attachment Preview
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region attachement-preview (
        name: Attachement Preview
        type: staticContent
        source {
            htmlCode:
                ```html
                <p align="center">
                <iframe src="f?p=&APP_ID.:0:&SESSION.:APPLICATION_PROCESS=attachment_preview:NO" width="99%" height="2000">
                </iframe>
                </p>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P9995_SNO (
        type: hidden
        layout {
            sequence: 20
            region: @attachement-preview
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P9995_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @attachement-preview
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

)

