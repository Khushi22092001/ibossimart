    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P682_Tno is null then
                        Select GlobalTno.NextVal into :P682_Tno From Dual;
                     end if;
                    ----
                    if :P682_SALARYVOUCHERNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P682_LocationCode,
                					:P682_DocTypeCode,
                					NULL,
                					TO_DATE(:P682_SALARYVOUCHERDATE, 'DD-MM-RRRR')
                				);
                        :P682_SALARYVOUCHERNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P682_LocationCode,
                                    :P682_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P682_SALARYVOUCHERDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 41420176270872816
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P682_TNO is null then
                    :P682_TNO := GlobalTNo.nextval;
                    :P682_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P682_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P682_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P682_TNO), 'Status');
                
                begin
                select TNO into :P682_VOUCHERTNO from voucher 
                        where moduletno = :P682_TNO
                          AND MODULECODE='SALARYVOUCHER';
                exception when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 41069005063893287
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P682_MODULEFLOW := 'YES';
                   else
                       :P682_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P682_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P682_ONTHETABLE := 'YES' ;
                   else
                       :P682_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 41069371725894424
        }
    )

