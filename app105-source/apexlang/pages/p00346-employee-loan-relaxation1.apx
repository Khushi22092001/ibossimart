    dynamicAction set-value (
        name: "set value "
        execution {
            sequence: 150
        }
        when {
            selectionType: items
            items: P346_SALARYFROMDATE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                    --to_char(a.Fromdate, 'Month, rrrr') as ForMonth,
                    --a.FromDate,
                    a.ToDate
                    from PeriodList a
                    where a.PeriodType = 'MONTH'
                    and a.Fromdate = :P346_SALARYFROMDATE
                    order by a.FromDate
                    ```
                itemsToSubmit: P346_SALARYFROMDATE
            }
            affectedElements {
                selectionType: items
                items: P346_SALARYTODATE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P346_Tno is null then
                        Select GlobalTno.NextVal into :P346_Tno From Dual;
                     end if;
                    ----
                    if :P346_LOANRELAXATIONNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P346_LocationCode,
                					:P346_DocTypeCode,
                					NULL,
                					TO_DATE(:P346_LOANRELAXATIONDATE, 'DD-MM-RRRR')
                				);
                        :P346_LOANRELAXATIONNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P346_LocationCode,
                                    :P346_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P346_LOANRELAXATIONDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 45703491765095765
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P346_MODULEFLOW := 'YES';
                   else
                       :P346_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P346_ONTHETABLE := 'YES' ;
                   else
                       :P346_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 45702681812095765
        }
    )

    process gettno (
        name: gettno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P346_TNO IS NULL then
                    :P346_FORMSTATUS := 'NEWRECORD';
                    select globaltno.nextval into :P346_TNO from dual;
                  else 
                    :P346_FORMSTATUS := 'EDITRECORD';
                end if;
                
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 45702204126095764
        }
    )

