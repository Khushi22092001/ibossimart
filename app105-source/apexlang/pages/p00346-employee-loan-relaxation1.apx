    dynamicAction set-serialno (
        name: set SerialNo
        execution {
            sequence: 160
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @relaxation-detail
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var index;
                    
                    var model = this.data.model;
                    
                    var meta = model.getRecordMetadata(this.data.recordId);
                    
                    if ( meta.inserted && !meta.updated ) {
                    
                    
                        index =  $v("P346_NEXT_SERIALNO");
                    
                        index +++ 1;
                    
                        $s("P346_NEXT_SERIALNO", index);
                    
                        $s("SERIALNO",index );
                    
                    
                    }
                    
                    
                    ```
            }
            execution {
                sequence: 10
