    pageItem P346_SALARYFROMDATE (
        type: popupLov
        label {
            label: For Month
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                to_char(a.Fromdate, 'Month, rrrr') as ForMonth,
                a.FromDate--,
                --a.ToDate
                from PeriodList a
                where a.PeriodType = 'MONTH'
                order by a.FromDate
                ```
        }
        cascadingLov {
            parentItems: P346_TNO
            itemsToSubmit: P346_TNO
        }
        layout {
            sequence: 80
            region: @employee-loan-relaxation
            slot: regionBody
