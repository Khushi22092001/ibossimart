page 346 (
    name: Employee Loan Relaxation
    alias: EMPLOYEE-LOAN-RELAXATION1
    title: Employee Loan Relaxation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region commonfields (
        name: CommonFields
        type: staticContent
        layout {
            sequence: 20
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region employee-loan-relaxation (
        name: Employee Loan Relaxation
        type: form
        source {
            location: localDatabase
            tableName: LOANRELAXATION
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region flow-buttons (
        name: Flow Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region relaxation-detail (
        name: Relaxation Detail
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: LOANRELAXATIONDETAIL
            whereClause: tno = :P346_TNO
            pageItemsToSubmit: P346_TNO
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 45648302258890823
        }

        savedReport 457383 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @SERIALNO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @EMPLOYEECODE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @LOANTYPECODE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @VOUCHERTNO
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @NEWINSTALLMENTAMOUNT
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @LOANSANCTIONTNO
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column EMPLOYEECODE (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: EMPLOYEECODE
                dataType: varchar2
            }
            default {
                type: item
                item: P346_EMPLOYEECODE
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LOANSANCTIONTNO (
            type: selectList
            heading {
                heading: Loan Sanction No
            }
            lov {
                type: sqlQuery
                sqlQuery: SELECT LOANSANCTIONNO, TNO AS LOANSANCTIONTNO FROM LOANSANCTION
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: LOANSANCTIONTNO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
            advanced {
                htmlDomId: LOANSANCTIONTNO
            }
        )

        column LOANTYPECODE (
            type: popupLov
            heading {
                heading: Loan Type
            }
            settings {
                popupWidth: 800
                additionalOutputs: VOUCHERTNO:VOUCHERTNO,INSTALLMENTAMOUNT:NEWINSTALLMENTAMOUNT,LOANSANCTIONTNO:LOANSANCTIONTNO
            }
            lov {
                type: sharedComponent
                lov: @p346-loantype
            }
            cascadingLov {
                parentColumns: EMPLOYEECODE
                itemsToSubmit: [
                    EMPLOYEECODE
                    P346_EMPLOYEECODE
                ]
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: LOANTYPECODE
                dataType: varchar2
            }
        )

        column NEWINSTALLMENTAMOUNT (
            type: numberField
            heading {
                heading: New Installment Amount
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                databaseColumn: NEWINSTALLMENTAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            advanced {
                htmlDomId: NEWINSTALLMENTAMOUNT
            }
        )

        column REMARK (
            type: textarea
            heading {
                heading: Remark
            }
            layout {
                sequence: 110
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column SERIALNO (
            type: textField
            heading {
                heading: Serialno
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SERIALNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
            advanced {
                htmlDomId: SERIALNO
            }
        )

        column SNO (
            type: textField
            heading {
                heading: Sno
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SNO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            columnFilter {
                lovType: none
            }
        )

        column TNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P346_TNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column VOUCHERTNO (
            type: selectList
            heading {
                heading: Voucher No
            }
            lov {
                type: sqlQuery
                sqlQuery: SELECT VOUCHERNO, TNO AS VOUCHERTNO FROM VOUCHER
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: VOUCHERTNO
                dataType: number
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            advanced {
                htmlDomId: VOUCHERTNO
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Relaxation Detail
        }
    )

