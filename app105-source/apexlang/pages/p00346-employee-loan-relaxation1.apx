    pageItem P346_EMPLOYEECODE (
        type: popupLov
        label {
            label: Employee
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select employeename , employeecode 
                from employee a
                where not exists ( select 1 from resignation aa where aa.employeecode = a.employeecode) 
                order by 1
                ```
        }
        layout {
            sequence: 90
            region: @employee-loan-relaxation
            slot: regionBody
            alignment: left
