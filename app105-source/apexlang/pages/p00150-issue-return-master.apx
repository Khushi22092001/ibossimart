            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid,A.TNO,
                       A.SNO,
                       A.SN,
                       A.STORAGELOCATIONCODE,
                       A.STOCKTNO,
                       A.QUANTITY1,
                       A.QUANTITY2
                  from ISSUERETURNSTOCKDETAIL A
                  where A.Tno = :P150_TNO
                  AND A.Sno= :P150_SNO
                ```
            pageItemsToSubmit: [
                P150_TNO
                P150_SNO
            ]
        }
