    dynamicAction balance-cost-centre (
        name: Balance Cost Centre
        execution {
            sequence: 200
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @issue-return-cost-centre
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var totalsum1 = parseInt($v("P150_TOTALQTY1"));
                    var totalsum2 = parseInt($v("P150_TOTALQTY2"));
                    var model = apex.region("IssueReturnCostCentre").widget().interactiveGrid("getViews", "grid").model;
                    function Sumofvalues(model){
                        var sum1 = 0;
                        var sum2 = 0;
                        model.forEach(function(r){
                            //console.log(r);
                            sum1 = sum1 +  parseInt(r[3]);// index of QTY 1 if value in nan then check by console.log
                            sum2 = sum2 +  parseInt(r[4]); // index of QTY 2 
                        })
                        return {sum1, sum2};
                    }
                    var selectedRecords = model.getSelectedRecords();
                    selectedRecords.forEach(function(r) {
                        var ze = 0;
                        if ($v("P150_TOTALQTY1") != ""){
                            model.setValue(r,"QUANTITY1",ze.toString());
                        }
                        if ($v("P150_TOTALQTY2") != ""){
                            model.setValue(r,"QUANTITY2",ze.toString());
                        }
                        var{sum1, sum2} = Sumofvalues(model);
                        if (sum1>totalsum1){
                            sum1 = totalsum1;
                        }
                        if (sum2>totalsum2){
                            sum2 = totalsum2;
                        }
                        var ans1 = totalsum1 - sum1;
                        var ans2 = totalsum2 - sum2;
                        if (sum1=totalsum1){
                            model.setValue(r,"QUANTITY1",ans1.toString());
                        }
                        if (sum2=totalsum2){
                            model.setValue(r,"QUANTITY2",ans2.toString());
                        }
                    });
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction balance-storage-qty (
        name: Balance Storage qty
        execution {
            sequence: 190
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @issue-return-stock-detail
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var totalsum1 = parseInt($v("P150_TOTALQTY11"));
                    var totalsum2 = parseInt($v("P150_TOTALQTY12"));
                    var model = apex.region("IssueReturnStockDetail").widget().interactiveGrid("getViews", "grid").model;
                    function Sumofvalues(model){
                        var sum1 = 0;
                        var sum2 = 0;
                        model.forEach(function(r){
                            //console.log(r);
                            sum1 = sum1 +  parseInt(r[5]);
                            sum2 = sum2 +  parseInt(r[6]);
                        })
                        return {sum1, sum2};
                    }
                    var selectedRecords = model.getSelectedRecords();
                    selectedRecords.forEach(function(r) {
                        var ze = 0;
                        if ($v("P150_TOTALQTY11") != ""){
                            model.setValue(r,"QUANTITY1",ze.toString());
                        }
                        if ($v("P150_TOTALQTY12") != ""){
                            model.setValue(r,"QUANTITY2",ze.toString());
                        }
                        var{sum1, sum2} = Sumofvalues(model);
                        if (sum1>totalsum1){
                            sum1 = totalsum1;
                        }
                        if (sum2>totalsum2){
                            sum2 = totalsum2;
                        }
                        var ans1 = totalsum1 - sum1;
                        var ans2 = totalsum2 - sum2;
                        if (sum1=totalsum1){
                            model.setValue(r,"QUANTITY1",ans1.toString());
                        }
                        if (sum2=totalsum2){
                            model.setValue(r,"QUANTITY2",ans2.toString());
                        }
                    });
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calc-amount (
        name: Calc Amount
        execution {
            sequence: 180
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @issue-return-detail
            columns: RATE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select nvl(:QUANTITY1,0)*nvl(:RATE,0) as a   from dual
                itemsToSubmit: [
                    QUANTITY1
                    RATE
                ]
            }
            affectedElements {
                selectionType: columns
                columns: AMOUNT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

