    process set-allowed-date (
        name: Set Allowed Date
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                IF :P150_FORMSTATUS = 'NEWRECORD' THEN 
                
                select
                		trunc(sysdate) - nvl(b.AllowedBackDays, 0) as AllowedBack,
                		trunc(sysdate) + nvl(b.AllowedForwardDays, 0) AllowedForward	
                		--a.FreezeDate
                        INTO :P150_ALLOWEDBACK,:P150_ALLOWEDFORWARD
                from Module a, ModulePrivilege b, BossUser c
                where a.ModuleCode = GetModuleCodeForpageNo(:APP_PAGE_ID)
                		and a.ModuleCode = b.ModuleCode
                		and b.BossUsercode = c.BossUserCode
                		and c.LoginName = :GLOBAL_LOGINNAME
                		and b.CompanyCode = :GLOBAL_CompanyCode
                        ;
                
                else
                     :P150_ALLOWEDBACK       := :P150_ISSUERETURNDATE ; 
                    :P150_ALLOWEDFORWARD    := :P150_ISSUERETURNDATE ;
                 end if;
                ```
        }
        execution {
            sequence: 90
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13852079863323991
        }
    )

    process set-issue-return-no (
        name: Set Issue Return No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    --tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tModuleCode varchar2(30) := 'ISSUERETURN';
                    tmp         number ;
                begin
                     if :P150_TNO is null then
                        Select GlobalTno.NextVal into :P150_TNO From Dual;
                     end if;
                    ----
                    if :P150_ISSUERETURNNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P150_LOCATIONCODE,
                					:P150_DOCTYPECODE,
                					NULL,
                					TO_DATE(:P150_ISSUERETURNDATE, 'DD-MM-RRRR')
                				);
                        :P150_ISSUERETURNNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P150_LOCATIONCODE,
                                    :P150_DOCTYPECODE,
                                    NULL,
                                    TO_DATE(:P150_ISSUERETURNDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 164451357456089077
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

