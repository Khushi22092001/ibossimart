    dynamicAction get-item-from-issue (
        name: Get item from Issue
        execution {
            sequence: 150
        }
        when {
            event: click
            selectionType: button
            button: @getitem
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --raise_application_error(-20003,:P118_DOCTYPECODE);
                    begin
                    --Inserting data in issue Return detail
                    for vloop in (
                    select 
                    			:P150_TNO as tno,
                    			b.itemcode,
                    			b.itemspecificationcode,
                                --b.description,
                                b.quantity1,
                                b.quantity2,
                                b.sno,
                    			--globaltno.nextval as sno,
                                A.TNO AS ITNO
                    from 
                    			Issue a, 
                    			Issuedetail b,
                    			item e,
                    			itemspecification ee
                    where
                    			a.tno = b.tno
                    			and b.itemcode = e.itemcode
                    			and b.itemspecificationcode = ee.itemspecificationcode
                    			and a.tno = :P150_ISSUETNO
                    			--and :P69_DELIVERYANDPAYMENTSCHEDULETNO is null 
                    		
                    ) loop
                        insert into IssueReturnDETAIL
                            (
                                TNO,
                                ITEMCODE,
                                ITEMSPECIFICATIONCODE,
                                Quantity1,
                                Quantity2,
                                SNO,
                                --Quantity1,
                                ISSUETNO
                            ) values
                            (
                                vloop.tno,
                                 vloop.itemcode,
                                 vloop.itemspecificationcode,
                                 vloop.quantity1,
                                 vloop.quantity2,
                                 vloop.sno,
                                 --vloop.quantity1,
                                 vloop.ITNO
                            );
                    end loop;
                    ------------||||||||||||||||||||||------------------
                    --Inserting Issue Return Cost Centre Detail 
                    ------------||||||||||||||||||||||-------------------
                    for vloop in (
                    select 
                    		    :P150_TNO as tno,
                    			c.costcentrecode,
                    			c.quantity1,
                                c.quantity2,
                                c.remark,
                                c.sno
                    from 
                    			Issue a, 
                    			Issuedetail b,
                    			Issuecostcentredetail c,
                                item e,
                    			itemspecification ee
                    where
                    			a.tno = b.tno 
                                and c.tno=b.tno
                                and c.sno=b.sno
                    			and b.itemcode = e.itemcode
                    			and b.itemspecificationcode = ee.itemspecificationcode
                    			and a.tno = :P150_ISSUETNO
                    ) loop
                        insert into ISSUERETURNCOSTCENTREDETAIL
                            (
                                TNO,
                                Costcentrecode,
                                quantity1,
                                quantity2,
                                remark,
                                SNO
                                --Quantity1,
                                --IssueTNO
                            ) values
                            (
                                vloop.tno,
                                 vloop.costcentrecode,
                                 vloop.quantity1,
                                 vloop.quantity2,
                                 vloop.remark,
                                 vloop.sno
                            );
                    end loop;
                    ------------||||||||||||||||||||||------------------
                    -----Inserting Issue Return Storage Detail 
                    ------------||||||||||||||||||||||-------------------
                    for vloop in (
                    select 
                    		    :P150_TNO as tno,
                    			c.StockTno,
                                c.Storagelocationcode,
                    			c.quantity1,
                                c.quantity2,
                                c.sno
                    from 
                    			Issue a, 
                    			Issuedetail b,
                    			ISSUESTOCKSTORAGEDETAIL c,
                                item e,
                    			itemspecification ee
                    where
                    			a.tno = b.tno 
                                and c.tno=b.tno
                                and c.sno=b.sno
                    			and b.itemcode = e.itemcode
                    			and b.itemspecificationcode = ee.itemspecificationcode
                    			and a.tno = :P150_ISSUETNO
                    ) loop
                        insert into ISSUERETURNSTOCKDETAIL
                            (
                                TNO,
                                StockTno,
                                Storagelocationcode,
                                quantity1,
                                quantity2,
                                SNO
                                --Quantity1,
                                --IssueTNO
                            ) values
                            (
                                vloop.tno,
                                 vloop.StockTno,
                                 vloop.Storagelocationcode,
                                 vloop.quantity1,
                                 vloop.quantity2,
                                 vloop.sno
                            );
                    end loop;
                    end;
                    ```
                itemsToSubmit: [
                    P150_TNO
                    P150_ISSUETNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

