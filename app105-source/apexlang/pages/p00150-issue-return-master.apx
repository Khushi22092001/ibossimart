    process issue-return-detail-save-interactive-grid-data (
        name: Issue Return Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @issue-return-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        When 'C' THEN
                            Insert Into IssueReturnDETAIL(
                                TNO,
                                SNO,
                                SERIALNO,
                                DOCUMENTSTATUSCODE,
                                ISSUETNO,
                                ITEMCODE,
                                ITEMSPECIFICATIONCODE,
                                QUANTITY1,
                                QUANTITY2,
                                REMARK,
                                RATE,
                                AMOUNT
                            )
                            VALUES(
                                :TNO,
                                :SNO,
                                :SERIALNO,
                                :DOCUMENTSTATUSCODE,
                                :ISSUETNO,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :QUANTITY1,
                                :QUANTITY2,
                                :REMARK,
                                :RATE,
                                :AMOUNT
                            );
                        
                        WHEN 'U' THEN
                            UPDATE IssueReturnDETAIL SET
                                TNO=:TNO,
                                SNO=:SNO,
                                SERIALNO=:SERIALNO,
                                DOCUMENTSTATUSCODE=:DOCUMENTSTATUSCODE,
                                ISSUETNO=:ISSUETNO,
                                ITEMCODE=:ITEMCODE,
                                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                QUANTITY1=:QUANTITY1,
                                QUANTITY2=:QUANTITY2,
                                REMARK=:REMARK,
                                RATE=:RATE,
                                AMOUNT=:AMOUNT
                            WHERE TNO = :P150_TNO
                                --AND ROWID = :ROWID;
                                And SNO = :SNO;
                        WHEN 'D' THEN
                            DELETE FROM IssueReturnDETAIL
                            WHERE TNO = :P150_TNO
                                AND SNO = :SNO
                                ;
                    end case;
                exception when others THEN
                    raise_application_error(-200010,sqlerrm);
                End;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 161104627773355114
        }
    )

