    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P666_Tno is null then
                        Select GlobalTno.NextVal into :P666_Tno From Dual;
                     end if;
                    ----
                    if :P666_ASSETNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P666_LocationCode,
                					:P666_DocTypeCode,
                					NULL,
                					TO_DATE(:P666_ASSETDATE, 'DD-MM-RRRR')
                				);
                        :P666_ASSETNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P666_LocationCode,
                                    :P666_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P666_ASSETDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 29195278882718344
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P666_TNO is null then
                    :P666_TNO := GlobalTNo.nextval;
                    :P666_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P666_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P666_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P666_TNO), 'Status');
                
                begin
                select TNO into :P666_VOUCHERTNO from voucher 
                        where moduletno = :P666_TNO;
                exception when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 29194451170718343
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P666_MODULEFLOW := 'YES';
                   else
                       :P666_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P666_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P666_ONTHETABLE := 'YES' ;
                   else
                       :P666_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 29194888422718344
        }
    )

