                    ```plsql
                    SELECT TNO, MEASURINGUNITCODE1
                    INTO :P666_ITEMTNO, :P666_UNIT
                    FROM ITEM
                    WHERE ITEMCODE  =   :P666_ITEMCODE;
                    
                    EXCEPTION 
                        WHEN NO_DATA_FOUND THEN
                            :P666_ITEMTNO := NULL;
