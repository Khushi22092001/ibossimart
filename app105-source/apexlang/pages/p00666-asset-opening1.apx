    dynamicAction set-qty-2 (
        name: Set Qty1
        execution {
            sequence: 170
        }
        when {
            event: focusout
            selectionType: items
            items: P666_QUANTITY2
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                        rtvalue number;
                        mfactor number;
                    begin
                        select MULTIPLYINGFACTOR into mfactor from ITEMSPECIFICATION 
                        where ITEMSPECIFICATIONCODE = :P666_ITEMSPECIFICATIONCODE;
                        if nvl(mfactor,0) > 0 then
                            return :P666_QUANTITY2/mfactor;
                        else
                            return (:P666_QUANTITY1);
                        end if;
                        exception when others then
                            null;
                    end;
                    ```
                itemsToSubmit: [
                    P666_ITEMSPECIFICATIONCODE
                    P666_QUANTITY2
                    P666_QUANTITY1
                ]
            }
            affectedElements {
                selectionType: items
                items: P666_QUANTITY1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

