page 666 (
    name: Asset Opening
    alias: ASSET-OPENING1
    title: Asset Opening
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
               var bireporturl = $('#P666_BIREPORTURL').val()
              var reportName = 'IRONMART/REPORT/AssetOpening.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '&P_TNO=' + $('#P666_TNO').val() 
                  ;
            
             
                    var reportURL = bireporturl+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P666_BIREPORTURL').val()
              var reportName =  'AssetOpening.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '"_paramsP_TNO":"' + $('#P666_TNO').val() 
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            ```
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asset-opening (
        name: Asset Opening
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       ASSETDATE,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       ASSETVALUE,
                       CADEPRICIATEDVALUE,
                       ITDEPRICIATEDVALUE,
                       ASSETCOMPONENTSNO,
                       REMARK,
                       WORKCENTRECODE,
                       ASSETCODEPREFIX,
                       ASSETCODESTARTNO,
                       ASSETNO,
                       ACCOUNTCODE,
                       DEPRECIATEDAMOUNT,
                       CREATOR,
                       CREDITACCOUNTCODE,
                       MODULECODE,
                       MODULETNO,
                       OPENINGREVISED,
                       REMAININGUSEFULLIFEINMONTHS,
                       RESIDUALVALUE,
                       CREATIONTIME,
                       EQUIPMENTTNO,
                       ORIGINALPURCHASEDATE,
                       COSTCENTRECODE,
                       PHYSICALSTATUS,
                       TAXCODE,
                       DEACTIVATEDATE,
                       DEACTIVATEMODULECODE,
                       DEACTIVATEMODULETNO,
                       READYTOUSE,
                       ITCAVAILEDAMOUNT,
                       ITCAVAILED,
                       PURCHASEDATE,
                       ASSETCATEGORYCODE,
                       OLDCOSTCENTRECODE,
                       NARRATION
                  from ASSET
                ```
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: S_ATTENDENCE
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 20
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region depreciation (
        name: Depreciation
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @asset-opening
            slot: subRegions
            startNewRow: false
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region general (
