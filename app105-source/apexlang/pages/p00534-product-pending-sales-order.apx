page 534 (
    name: Product Pending Sales Order
    alias: PRODUCT-PENDING-SALES-ORDER
    title: Product Pending Sales Order
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region product-pending-sales-order (
        name: Product Pending Sales Order
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.COMPANYCODE,
                       A.COMPANYNAME,
                       A.LOCATIONCODE,
                       A.LOCATIONNAME,
                       A.DOCTYPECODE,
                       A.DOCTYPENAME,
                       A.SALESORDERNO,
                       A.SALESORDERDATE,
                       A.VENDORCODE,
                       A.VENDORNAME,
                       A.CONSIGNEECODE,
                       A.CONSIGNEENAME,
                       A.AGENTCODE,
                       A.AGENTNAME,
                       A.PARTYPONO,
                       A.PARTYPODATE,
                       A.VALIDITYUPTODATE,
                       A.ITEMCODE,
                       A.ITEMNAME,
                       A.MATERIALDESCRIPTION,
                       A.UOM1,
                       A.QUANTITY1,
                       A.UOM2,
                       A.QUANTITY2,
                       A.RATE,
                       A.AMOUNT,
                       A.CGST,
                       A.SGST,
                       A.IGST,
                       A.TCS,
                       A.FOOTERAMOUNT,
                       A.OTHERAMOUNT,
                       A.TOTALAMOUNT,
                       A.CREATOR,
                       A.CREATIONTIME,
                       A.DESPATCHQUANTITY,
                       A.INVOICEQUANTITY,
                       A.BALANCEQUANTITY,
                       A.STATECODE,
                       A.STATENAME,
                       A.CITYCODE,
                       A.CITYNAME,
                       A.REGIONCODE,
                       A.REGIONNAME,
                       A.SALESPERSONCODE,
                       A.SALESPERSONNAME,
                       A.ITEMSPECIFICATIONCODE,
                       ------------------------ --
                       -- 29-OCT-2022 
                       A.DESPATCHQUANTITY * B.MULTIPLYINGFACTOR AS DESPATCHQUANTITY2,
                       A.INVOICEQUANTITY * B.MULTIPLYINGFACTOR AS INVOICEQUANTITY2,
                       A.BALANCEQUANTITY * B.MULTIPLYINGFACTOR AS BALANCEQUANTITY2
                       ------------------------ --
                  from D_CUSTOMER_360VIEW_PENDINGORDERS A, ITEMSPECIFICATION B
                  Where A.VENDORCODE LIKE NVL(:P534_CUSTOMERCODE,'%')
                    AND A.ITEMCODE LIKE NVL(:P534_ITEMCODE,'%')
                    AND A.ITEMSPECIFICATIONCODE LIKE NVL(:P534_ITEMSPECIFICATIONCODE,'%')
                    AND A.ITEMSPECIFICATIONCODE = B.ITEMSPECIFICATIONCODE(+)
                
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            compute: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 58796029676970063
        }

