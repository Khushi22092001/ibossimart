page 277 (
    name: Bonus
    alias: BONUS
    title: Bonus
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bonus (
        name: Bonus
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       BONUSNO,
                       BONUSDATE,
                       FROMDATE,
                       TODATE,
                       STAFFTYPECODE,
                       CATEGORYCODE,
                       REMARK,
                       CREATIONTIME,
                       CREATOR,
                       DEBITACCOUNTCODE,
                       CREDITACCOUNTCODE,
                       BONUSAMOUNT
                  from BONUS
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 30
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       EMPLOYEECODE,
                       BONUSONAMOUNT,
                       BONUSPERCENT,
                       BONUSAMOUNTAUTO,
                       BONUSAMOUNT,
                       REMARK
                  from BONUSDETAIL
                  where tno = :P277_TNO
                ```
            pageItemsToSubmit: P277_TNO
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 8784488603475305
        }

        savedReport 88416 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 4
                }
            )

            displayColumn (
                column: @EMPLOYEECODE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @BONUSONAMOUNT
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @BONUSPERCENT
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @BONUSAMOUNTAUTO
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @BONUSAMOUNT
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column BONUSAMOUNT (
            type: numberField
            heading {
                heading: Bonus Amount
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            source {
                databaseColumn: BONUSAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column BONUSAMOUNTAUTO (
            type: numberField
            heading {
                heading: Bonus Amount Auto
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                databaseColumn: BONUSAMOUNTAUTO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column BONUSONAMOUNT (
            type: numberField
            heading {
                heading: Bonus On Amount
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: BONUSONAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column BONUSPERCENT (
            type: numberField
            heading {
                heading: Bonus Percent
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: BONUSPERCENT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column EMPLOYEECODE (
            type: popupLov
            heading {
                heading: Employee
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select employeename , employeecode from employee
                    order by 1
                    ```
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: EMPLOYEECODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column REMARK (
            type: textField
            heading {
                heading: Remark
            }
            layout {
                sequence: 110
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SNO (
            type: numberField
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TNO (
            type: numberField
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P277_TNO
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
    )

