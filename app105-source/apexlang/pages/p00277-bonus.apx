    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P277_Tno is null then
                        Select GlobalTno.NextVal into :P277_Tno From Dual;
                     end if;
                    ----
                    if :P277_PURCHASEORDERNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P277_LocationCode,
                					:P277_DocTypeCode,
                					NULL,
                					TO_DATE(:P277_PURCHASEORDERDATE, 'DD-MM-RRRR')
                				);
                        :P277_PURCHASEORDERNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P277_LocationCode,
                                    :P277_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P277_PURCHASEORDERDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 8833485821678044
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P277_TNO is null then
                    :P277_TNO := GlobalTNo.nextval;
                    :P277_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P277_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P277_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P277_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8802087543634060
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P277_MODULEFLOW := 'YES';
                   else
                       :P277_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P277_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P277_ONTHETABLE := 'YES' ;
                   else
                       :P277_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8802311928635076
        }
    )

