    pageItem P277_LOCATIONCODE (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.LocationName as d,
                	a.LocationCode as r
                from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode 
                	and c.CompanyCode = :global_CompanyCode
                    and d.EntryPageNo = :APP_PAGE_ID
                ```
        }
        layout {
            sequence: 40
            region: @bonus
            slot: regionBody
            alignment: left
        }
        appearance {
