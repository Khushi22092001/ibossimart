    dynamicAction insert-into-detail (
        name: insert into detail
        execution {
            sequence: 140
        }
        when {
            event: click
            selectionType: button
            button: @getemployee
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P277_FormStatus in ('NEWRECORD', 'EDITRECORD') then
                    		
                    	
                    	
                    		for vEmployee
                    				in (
                    						select
                    								a.EmployeeName,
                    								a.EmployeeCode,
                    								a.CompanyCode										
                    						from Employee a
                    						where a.DateOfJoining < :P277_ToDate
                    								and a.CompanyCode = :global_CompanyCode
                    								and exists(
                    										select
                    												aa.tno
                    										from attendenceperiodical aa 
                    										where 1=1
                    												and aa.AttendencePeriodicalDate between :P277_FromDate and last_day( :P277_todate)
                    												and aa.EmployeeCode = a.EmployeeCode
                    								)
                    								and not exists(
                    										select
                    												aa.tno
                    										from Bonus aa, BonusDetail bb
                    										where aa.TNo = bb.TNO
                    												and (
                    														:P277_FromDate between aa.FromDate and aa.ToDate
                    														or
                    														:P277_ToDate between aa.FromDate and aa.ToDate
                    												)
                    												and bb.EmployeeCode = a.EmployeeCode
                    								)
                    								and not exists(
                    										select
                    												aa.tno
                    										from Resignation aa
                    										where aa.EmployeeCode = a.EmployeeCode
                    												and aa.ResignationDate <= :P277_ToDate
                    								)
                    								/*and not exists(
                    										select
                    												aa.tno
                    										from Termination aa
                    										where aa.EmployeeCode = a.EmployeeCode
                    												and aa.TerminationDate <= :P277_ToDate
                    								) */
                    							
                    								and getEmployeeLocationCode(a.EmployeeCode, :P277_BonusDate) = :P277_LocationCode
                    
                    						order by a.EmployeeName
                    				)
                    		loop												
                    				if getEmployeeBonusSchemeCode(vEmployee.EmployeeCode, ( :P277_todate) ) is not null then 
                    
                                        insert into bonusdetail
                                        (
                                            tno,
                                            sno,
                                            employeecode
                                        )
                                        values
                                        (
                                            :P277_TNO,
                                            globaltno.nextval,
                                            vEmployee.EmployeeCode
                                        );
                    
                    
                    						
                    						--CalculateBonus;
                    										
                    				end if;
                    		end loop;				
                    	
                    
                    end if;
                    ```
                itemsToSubmit: [
                    P277_FORMSTATUS
                    P277_TODATE
                    P277_FROMDATE
                    P277_BONUSDATE
                    P277_LOCATIONCODE
                    P277_TNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    		tBonusSchemeCode Varchar2(30);
                    		tEmployeeSalaryTNo Number;
                    		tBonusOnAmount Number;
                    		tArrearAmount Number;
                    		tBonusPercent Number;
                    		tLocationCode Varchar2(30);		
                    		tAttendenceValueMinimum Number;
                    		tAttendenceValue Number;
                    		tBonusAmountMaximum Number;
                    		tServiceDaysMinimum Number;
                    		tServiceDays NUmber;
                    		tStaffTypeCode Varchar2(30);
                            TmpBonusAmount number;
                    BEGIN
                      	if :P277_FormStatus in ('NEWRECORD', 'EDITRECORD') then
                    
                        for DetailBlock in (select sno , 
                                                    EmployeeCode , 
                                                    bonusAmount , 
                                                    BonusAmountAuto from bonusdetail where tno = :P277_TNO)
                    
                        loop
                      			
                    		tBonusSchemeCode := getEmployeeBonusSchemeCode(DetailBlock.EmployeeCode, (:P277_ToDate) );
                    		tBonusPercent := getEmployeeBonusPercent(DetailBlock.EmployeeCode, (:P277_ToDate) );
                    		tLocationCode := getEmployeeLocationCode(DetailBlock.EmployeeCode, last_day(:P277_ToDate) );
                    		tStaffTypeCode := getEmployeeStaffTypeCode(DetailBlock.EmployeeCode, last_day(:P277_ToDate) );
                    		
                    		if  tBonusSchemeCode  is not null then
                    					
                    			select
                    					sum(a.AttendenceValueMinimum),
                    					sum(a.ServiceDaysMinimum),
                    					sum(a.BonusAmountMaximum)
                    							into tAttendenceValueMinimum, tServiceDaysMinimum, tBonusAmountMaximum
                    			from BonusScheme a
                    			where a.BonusSchemeCode = tBonusSchemeCode;
                    			select
                    					sum(b.AttendenceValue) into tAttendenceValue
                    			from Attendence a, AttendenceDetail b, BonusScheme c, BonusSchemeAttendenceHead d
                    			where a.tno = b.tno
                    					and a.AttendenceDate between :P277_FromDate and last_day(:P277_ToDate)
                    					and b.EmployeeCode = DetailBlock.EmployeeCode
                    					and c.BonusSchemeCode = tBonusSchemeCode
                    					and c.TNO = d.TNo
                    					and b.AttendenceHeadCode = d.AttendenceHeadCode;
                    			select
                    					sum(to_date(:P277_ToDate) - a.DateOfJoining ) into tServiceDays
                    			from Employee a
                    			where a.EmployeeCode = DetailBlock.Employeecode;					
                    
                    			if ( tAttendenceValue >= tAttendenceValueMinimum or nvl(tAttendenceValueMinimum, 0) = 0  )and ( tServiceDays >= tServiceDaysMinimum or nvl(tServiceDaysMinimum, 0) = 0  )then
                    
                    					tEmployeeSalaryTNo := getEmployeeSalaryTNo(DetailBlock.EmployeeCode, last_day(:P277_ToDate) );
                    					select
                    							sum( 
                    									nvl(a.RevisedValue, a.SalaryHeadAmount)
                    							) into tBonusOnAmount
                    					from Salary a1, SalaryDetail a, BonusScheme b, BonusSchemeDetail c
                    					where a1.SalaryFromDate between :P277_FromDate and :P277_ToDate
                    							and a1.tno = a.tno
                    							and b.BonusSchemeCode = tBonusSchemeCode
                    							and b.tno = c.tno
                    							and a.SalaryHeadCode = c.SalaryHeadCode
                    							and a1.EmployeeCode  = DetailBlock.Employeecode
                    					;
                    					--
                    					select
                    							sum( 
                    									a.ArrearAmount - nvl(a.RevisedValue, a.SalaryHeadAmount)
                    							) into tArrearAmount
                    					from Salary a1, SalaryDetail a, BonusScheme b, BonusSchemeDetail c
                    					where a1.SalaryFromDate between :P277_FromDate and :P277_ToDate
                    							and a1.tno = a.tno
                    							and b.BonusSchemeCode = tBonusSchemeCode
                    							and b.tno = c.tno
                    							and a.SalaryHeadCode = c.SalaryHeadCode
                    							and a1.EmployeeCode  = DetailBlock.Employeecode
                    							and a1.ArrearDate is not null
                    					;	  						
                    			end if;	
                    
                                IF DetailBlock.bonusAmount is null  then 
                    				if DetailBlock.BonusAmountAuto > tBonusAmountMaximum then
                    						TmpBonusAmount := tBonusAmountMaximum;  								
                    				else
                    						TmpBonusAmount := DetailBlock.BonusAmountAuto;
                    				end if;
                    			end if;
                    
                                update bonusdetail
                                set BonusPercent = round( tBonusPercent, 2),
                                    BonusOnAmount = tBonusOnAmount + nvl(tArrearAmount, 0),
                                    BonusAmountAuto = round( tBonusOnAmount * tBonusPercent / 100, 0),
                                    bonusAmount = TmpBonusAmount
                                where tno = :P277_TNO
                                and sno = DetailBlock.SNO;
                    		
                    		end if;
                            end loop;
                      	end if;
                    END;
                    ```
                itemsToSubmit: [
                    P277_FORMSTATUS
                    P277_TNO
                    P277_TODATE
                    P277_FROMDATE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

