    pageItem P277_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @common-fields
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                	begin
                	If :P277_TNO is null then
                		return('NEWRECORD');
                	else
                		return('EDITRECORD');
                	End if;
                	end ;
                ```
        }
    )

