page 239 (
    name: User Privilege Storage Location
    alias: USER-PRIVILEGE-STORAGE-LOCATION
    title: User Privilege Storage Location
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            t-Dialog--noPadding
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        height: 400
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region user-privilege-storage-location (
        name: User Privilege Storage Location
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.StorageLocationCODE,
                       a.SNO
                  from Moduleprivilegesl a
                 where  a.TNO = :P239_TNO
                ```
            pageItemsToSubmit: P239_TNO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 126853311316846696
        }

        savedReport 399399 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @STORAGELOCATIONCODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column SNO (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SNO
                dataType: number
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column STORAGELOCATIONCODE (
            type: popupLov
            heading {
                heading: Storagelocationcode
            }
            lov {
                type: sqlQuery
                sqlQuery: select storagelocationname d, storagelocationcode r from storagelocation order by 1
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: STORAGELOCATIONCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TNO (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: User Privilege Storage Location
        }
    )

    pageItem P239_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @user-privilege-storage-location
            slot: regionBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 20
            region: @user-privilege-storage-location
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @user-privilege-storage-location
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-privilege-storage-location
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process closedialog (
        name: CloseDialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 68964567285268851
        }
        serverSideCondition {
            whenButtonPressed: @back
        }
    )

    process user-privilege-storage-location-save-interactive-grid-data (
        name: User Privilege Storage Location - Save Interactive Grid Data
        type: executeCode
        editableRegion: @user-privilege-storage-location
        source {
            plsqlCode:
                ```plsql
                if :APEX$ROW_STATUS IN ( 'I','C') then
                   :TNO := :P239_TNO ;
                   SELECT GLOBALTNO.NEXTVAL INTO :SNO FROM DUAL;
                  INSERT INTO Moduleprivilegesl  ( TNO,SNO,STORAGELOCATIONCODE)
                  VALUES ( :TNO,:SNO,:STORAGELOCATIONCODE) ;
                ELSIF  :APEX$ROW_STATUS IN ( 'U') then
                     UPDATE Moduleprivilegesl 
                     SET STORAGELOCATIONCODE = :STORAGELOCATIONCODE
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                ELSIF :APEX$ROW_STATUS = 'D' then
                     DELETE FROM  Moduleprivilegesl 
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                END IF;   
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 68964083310268850
        }
    )

)

