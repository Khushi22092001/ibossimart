page 330 (
    name: Trial Grid Testing
    alias: TRIAL-GRID-TESTING
    title: Trial Grid Testing
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region trial (
        name: Trial
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.partycode,
                       a.partyname,
                       a.parentcode,
                        Prior partyname,
                       b.openingamount,
                       b.debitamount,
                       b.creditamount,
                       b.closingamount,
                        Level,
                       Case
                         When a.parentcode Is Null Then
                          'fa-robot'
                         When a.parentcode = '7839' Then
                          'fa-users'
                         Else
                          'fa-user'
                       End As icon
                  From PARTY A, trialbalancerevised B
                 Where A.PARTYCODE = B.ACCOUNTCODE(+)
                Start With a.parentcode IS NULL 
                Connect By NOCYCLE a.parentcode = Prior a.partycode
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: TREEGRID_IG
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 154252366142810277
        }

        savedReport 759211 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @PARTYCODE
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @PARTYNAME
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @PARENTCODE
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @OPENINGAMOUNT
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @DEBITAMOUNT
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @CREDITAMOUNT
                layout {
                    sequence: 14
                }
            )

            displayColumn (
                column: @CLOSINGAMOUNT
                layout {
                    sequence: 15
                }
            )

            displayColumn (
                column: @PRIORPARTYNAME
                layout {
                    sequence: 17
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            displayColumn (
                column: @LEVEL
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @ICON
                layout {
                    sequence: 3
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CLOSINGAMOUNT (
            type: numberField
            heading {
                heading: Closingamount
                alignment: end
            }
            layout {
                sequence: 270
                columnAlignment: end
            }
            source {
                databaseColumn: CLOSINGAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column CREDITAMOUNT (
            type: numberField
            heading {
                heading: Creditamount
                alignment: end
            }
            layout {
                sequence: 260
                columnAlignment: end
            }
            source {
                databaseColumn: CREDITAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column DEBITAMOUNT (
            type: numberField
            heading {
                heading: Debitamount
                alignment: end
            }
            layout {
                sequence: 250
                columnAlignment: end
            }
            source {
                databaseColumn: DEBITAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column ICON (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 190
            }
            source {
                databaseColumn: ICON
                dataType: varchar2
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column LEVEL (
            type: numberField
            heading {
                heading: Level
                alignment: end
            }
            layout {
                sequence: 180
                columnAlignment: end
            }
            source {
                databaseColumn: LEVEL
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column OPENINGAMOUNT (
            type: numberField
            heading {
                heading: Openingamount
                alignment: end
            }
            layout {
                sequence: 240
                columnAlignment: end
            }
            source {
                databaseColumn: OPENINGAMOUNT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column PARENTCODE (
            type: textField
            heading {
                heading: Parentcode
            }
            layout {
                sequence: 220
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: PARENTCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column PARTYCODE (
            type: textField
            heading {
                heading: Partycode
            }
            layout {
                sequence: 200
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: PARTYCODE
                dataType: varchar2
                primaryKey: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column PARTYNAME (
            type: htmlExpression
            heading {
                heading: Partyname
            }
            settings {
                htmlExpression: <span class="fa &ICON."> &PARTYNAME.</span>
            }
            layout {
                sequence: 210
            }
            source {
                databaseColumn: PARTYNAME
                dataType: varchar2
            }
        )

        column PRIORPARTYNAME (
            type: textField
            heading {
                heading: Priorpartyname
            }
            layout {
                sequence: 280
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: PRIORPARTYNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

    )

    dynamicAction initialize-treegrid-on-ig (
        name: Initialize treegrid on IG
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-com-enhanceigwithtreegrid-plugin (
            action: plugin/enhanceInteractiveGridWithTreegrid
            settings {
                idColumn: partycode
                parentIdColumn: parentcode
                expandCollapse: expand
                displayOnColumn: partyname
                levelColumn: LEVEL
            }
            affectedElements {
                selectionType: region
                region: @trial
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction page-load (
        name: PAGE LOAD_1
        execution {
            sequence: 20
        }
        when {
            event: region/interactiveGrid/interactivegridreportchange
            selectionType: region
            region: @trial
        }

        action plugin-com-enhanceigwithtreegrid-plugin (
            action: plugin/enhanceInteractiveGridWithTreegrid
            settings {
                idColumn: partycode
                parentIdColumn: parentcode
                expandCollapse: expand
                displayOnColumn: partyname
                levelColumn: LEVEL
            }
            affectedElements {
                selectionType: region
                region: @trial
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process active-module-save-interactive-grid-data (
        name: Active Module - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @trial
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 78336229115072353
        }
    )

)

