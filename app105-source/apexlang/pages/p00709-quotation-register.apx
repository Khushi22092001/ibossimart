            )

            displayColumn DISCOUNTRATE (
                sequence: 19
            )

            displayColumn ENQUIRYNO (
                sequence: 4
            )

            displayColumn IGST (
                sequence: 25
            )

            displayColumn ITEMCODE (
                sequence: 11
            )

            displayColumn MATERIALDETAIL (
                sequence: 12
            )

            displayColumn OTHERAMOUNT (
                sequence: 27
            )

            displayColumn PARTYNAME (
                sequence: 7
            )

            displayColumn PARTYQUOTATIONDATE (
                sequence: 6
            )

            displayColumn PARTYQUOTATIONNO (
                sequence: 5
            )

            displayColumn QUANTITY1 (
                sequence: 14
            )

            displayColumn QUANTITY2 (
                sequence: 16
            )

            displayColumn QUOTATIONDATE (
                sequence: 3
            )

            displayColumn QUOTATIONNO (
                sequence: 2
            )

            displayColumn RATE (
                sequence: 20
            )

            displayColumn RATEUOM (
                sequence: 21
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SGST (
                sequence: 24
            )

            displayColumn TCS (
                sequence: 26
            )

            displayColumn TOTALAMOUNT (
                sequence: 28
            )

            displayColumn UOM (
                sequence: 13
            )

            displayColumn UOM2 (
                sequence: 15
            )

            displayColumn VALIDDAYS (
                sequence: 9
            )

            displayColumn VALIDITYDATE (
                sequence: 10
            )

            displayColumn WITHOUTDISCOUNTRATE (
                sequence: 17
            )

            sort (
                column: VENDORNAME
                sort {
                    sequence: 1
                }
            )

            sort (
                column: SERIALNO
                sort {
                    direction: desc
                    sequence: 2
                }
            )

            sort (
                column: QUOTATIONDATE
                sort {
                    sequence: 3
                }
            )

            aggregate (
                column: TCS
            )

            aggregate (
                column: OTHERAMOUNT
            )

            aggregate (
                column: FOOTERAMOUNT
            )

            aggregate (
                column: TOTALAMOUNT
            )

            aggregate (
                column: QUANTITY1
            )

            aggregate (
                column: QUANTITY2
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: CGST
            )

            aggregate (
                column: SGST
            )

            aggregate (
                column: IGST
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    pageItem P709_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                    a.CompanyName d,
                    a.CompanyCode r
                From Company a
                Where exists
                (Select 
                  b.Tno
                  From Quotation b
                  Where b.CompanyCode = a.CompanyCode)
                Order by 1
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @quotation-register
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Select Company Name
        }
    )

