    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 20
            region: @quotation-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 710
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @quotation-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: never
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 160
            region: @quotation-register
            slot: regionBody
            column: 10
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
