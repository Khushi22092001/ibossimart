            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Quotation Report
        }

        savedReport 41905 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 22
            )

            displayColumn CGST (
                sequence: 23
            )

            displayColumn CREATIONTIME (
