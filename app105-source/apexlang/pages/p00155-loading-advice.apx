        column DESCRIPTION (
            type: textarea
            heading {
                heading: Description
            }
            layout {
                sequence: 80
                group: @item-specification
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ITEMCODE (
            type: popupLov
            heading {
                heading: Item
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select a.itemname , a.itemcode 
                    from item a
                    /*, purchaseorderdetail b
                    where a.itemcode = b.itemcode
                    and b.tno = :P155_PURCHASEORDERTNO/*
                    union all
                    select A.itemname,A.itemcode
                    from ITEM A, grndetail B
                    where B.tno = :P155_TNO*/
                    
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: P155_PURCHASEORDERTNO
                itemsToSubmit: P155_PURCHASEORDERTNO
                parentRequired: false
            }
            layout {
                sequence: 60
                group: @item-specification
            }
            source {
                databaseColumn: ITEMCODE
                dataType: varchar2
            }
            default {
                duplicateCopiesExistingValue: false
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: popupLov
            heading {
                heading: Specification
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ITEMSPECIFICATIONNAME , ITEMSPECIFICATIONCODE
                    from itemspecification
                    where tno in (select tno from item where itemcode = :ITEMCODE )
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ITEMCODE
                itemsToSubmit: ITEMCODE
                parentRequired: false
            }
            layout {
                sequence: 70
                group: @item-specification
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMSPECIFICATIONCODE
                dataType: varchar2
            }
        )

