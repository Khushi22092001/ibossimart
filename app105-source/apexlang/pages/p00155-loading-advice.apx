    pageItem P155_DESTINATIONPLACECODE (
        type: popupLov
        label {
            label: Destination Place
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT CITYNAME, CITYCODE FROM CITY 
                WHERE getdocumentstatuscode('CITY',TNO) = 'ACTIVE'
                ORDER BY 1
                /*select LOCATIONNAME , LOCATIONCODE from LOCATION   
                where getdocumentstatuscode('LOCATION',TNO) = 'ACTIVE'
                */
                ```
            displayNullValue: false
        }
        layout {
            sequence: 130
            region: @unloading-location
            slot: regionBody
            alignment: left
            labelColumnSpan: 4
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @loading-advice
            column: DESTINATIONPLACECODE
            dataType: varchar2
        }
    )

    pageItem P155_DOCTYPECODE (
        type: popupLov
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.DocTypeName as d,
                	a.DocTypeCode as r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c, Module d
                where a.DocTypeCode = b.DocTypeCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode
                	and c.CompanyCode = :global_CompanyCode
                    and d.EntryPageNo = :APP_PAGE_ID
                ```
            displayNullValue: false
