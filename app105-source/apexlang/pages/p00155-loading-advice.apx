    region detail-2 (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       REMARK,
                       GetMeasuringUnitNameFromItem(ITEMCODE)AS UNIT1 ,
                       GetMeasuringUnit2NameFromItem(ITEMCODE) AS UNIT2
                  from LOADINGADVICEDETAIL
                  where tno = :P155_TNO
                ```
            pageItemsToSubmit: P155_TNO
        }
        layout {
            sequence: 10
            parentRegion: @detail
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 400
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                    //Tab and Shift-Tab will skip over cells that are read-only
                    options.defaultGridViewOptions = {  
                        skipReadonlyCells: true  
                    };
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 163271604040966526
        }

