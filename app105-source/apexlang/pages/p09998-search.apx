page 9998 (
    name: Search
    alias: SEARCH
    title: Search
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            $('input').on('focus', function() {
            $("#"+this.id+"_LABEL").css("background-color", "yellow");
            }).on('blur', function() {
            $("#"+this.id+"_LABEL").css("background-color", "white");
            });
            
            $(
            'body').on('keydown', 'input, select, textarea', function(e) {
                var self = $(this)
                  , form = self.parents('form:eq(0)')
                  , focusable
                  , next
                  ;
                if (e.keyCode == 13) {
                    focusable = form.find('input,select,textarea,tabindex').filter(':visible');
                    next = focusable.eq(focusable.index(this)+1);
                    if (next.length) {
                        next.focus();
                    } else {
                        form.submit();
                    }
                    return false;
                }
            });
            ```
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Level,
                       aa.MYBOXLABEL,
                       'f?p=&APP_ID.:' || TO_CHAR(aA.PAGENO) || ':&SESSION.:::::' target,
                       aa.MYBOXKEY,
                       'YES' As is_current,
                       decode(nvl(ICONNAME, 'A'), 'A', '', ICONNAME) image
                From (Select *
                          From myboxtree_apex a
                         Where A.BossUserCode = :GLOBAL_BOSSUSERCODE
                           And A.COMPANYCODE = :GLOBAL_COMPANYCODE) AA
                Start With aA.ParentKey = 'ROOT'
                Connect By Prior aA.MyBoxKey = aA.ParentKey
                Order Siblings By aA.MyBoxLabel
                
                /*Select MyBoxlabel, pageno, iconname ,
                'f?p=&APP_ID.:'
                       || TO_CHAR(a.PAGENO) 
                       || ':&SESSION.:::::' 
                        target
                  From MYBOXTREE_APEX a
                 Where username = 'LOGICBOX' --:global_loginname
                 */
                ```
            pageItemsToSubmit: P9998_TNO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            finderDropDown: false
            reportsSelectList: false
        }
        actionsMenu {
            includeActionsMenu: false
        }
        advanced {
            savedReportMappingIdentifier: 397960367054545989
        }

        column IMAGE (
            type: hidden
            heading {
                heading: Image
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column IS_CURRENT (
            type: hidden
            heading {
                heading: Is Current
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column LEVEL (
            type: hidden
            heading {
                heading: Level
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column MYBOXKEY (
            type: hidden
            heading {
                heading: Myboxkey
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column MYBOXLABEL (
            type: link
            heading {
                heading: Module
                alignment: center
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    type: url
                    url: #TARGET#
                }
                linkText: #MYBOXLABEL#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TARGET (
            type: hidden
            heading {
                heading: Target
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        savedReport 51674 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn IMAGE (
                sequence: 6
            )

            displayColumn IS_CURRENT (
                sequence: 5
            )

            displayColumn LEVEL (
                sequence: 1
            )

            displayColumn MYBOXKEY (
                sequence: 4
            )

            displayColumn MYBOXLABEL (
                sequence: 2
            )

            displayColumn TARGET (
                sequence: 3
            )

        )

    )

    pageItem P9998_TNO (
        type: hidden
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
        default {
            type: item
            item: GLOBAL_LOGINNAME
        }
    )

)

