                       QUANTITY1PHYSICAL,
                       QUANTITY2PHYSICAL,
                       QUANTITY1VARIATION,
                       QUANTITY2VARIATION,
                       EXCESSSTOCKVALUE,
                       REMARK,
                       ENTRYDATE,
                       0 as stockrate,
                       0 as multiplyingfactor
                  from STOCKTAKINGDETAIL
                ```
            pageItemsToSubmit: P246_TNO
        }
        layout {
            sequence: 20
