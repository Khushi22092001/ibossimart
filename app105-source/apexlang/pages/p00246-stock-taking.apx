    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            if :SNO is null then
                                select globaltno.nextval into :sno from dual;
                            end if;
                            Insert Into STOCKTAKINGDETAIL  (                 
                                      tno                   ,
                                      sno                   ,
                                      serialno              ,
                                      itemcode              ,
                                      itemspecificationcode ,
                                      description           ,
                                      storagelocationcode   ,
                                      workordertno          ,
                                      quantity1onbook       ,
                                      quantity2onbook       ,
                                      quantity1physical     ,
                                      quantity2physical     ,
                                      quantity1variation    ,
                                      quantity2variation    ,
                                      excessstockvalue      ,
                                      remark                ,
                                      entrydate             
                                    )  
                            values
                                (
                                :tno                   ,
                                :sno                   ,
                                :serialno              ,
                                :itemcode              ,
                                :itemspecificationcode ,
                                :description           ,
                                :storagelocationcode   ,
                                :workordertno          ,
                                :quantity1onbook       ,
                                :quantity2onbook       ,
                                :quantity1physical     ,
                                :quantity2physical     ,
                                :quantity1variation    ,
                                :quantity2variation    ,
                                :excessstockvalue      ,
                                :remark                ,
                                :entrydate             
                
                            );
                        
                        when 'U' then
                            update STOCKTAKINGDETAIL 
                               SET   tno                    =   :tno                   ,
                                      sno                   =   :sno                   ,
                                      serialno              =   :serialno              ,
                                      itemcode              =   :itemcode              ,
                                      itemspecificationcode =   :itemspecificationcode ,
                                      description           =   :description           ,
                                      storagelocationcode   =   :storagelocationcode   ,
                                      workordertno          =   :workordertno          ,
                                      quantity1onbook       =   :quantity1onbook       ,
                                      quantity2onbook       =   :quantity2onbook       ,
                                      quantity1physical     =   :quantity1physical     ,
                                      quantity2physical     =   :quantity2physical     ,
                                      quantity1variation    =   :quantity1variation    ,
                                      quantity2variation    =   :quantity2variation    ,
                                      excessstockvalue      =   :excessstockvalue      ,
                                      remark                =   :remark                
                
                            WHERE TNO = :P246_TNO
                            ;
                
                        when 'D' then
                            Delete From STOCKTAKINGDETAIL 
                            Where TNo = :P246_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 76029713158406734
        }
    )

