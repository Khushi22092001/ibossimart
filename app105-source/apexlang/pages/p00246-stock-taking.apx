    dynamicAction insert-detail-record (
        name: insert detail record
        execution {
            sequence: 230
        }
        when {
            event: focusout
            selectionType: items
            items: P246_ASONDATE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                     tserialno number;
                    begin
                      delete from stockrevaluationdetail A where tno = :P246_TNO
                      AND NOT EXISTS ( SELECT 1 FROM stockrevaluation AA where aa.tno = a.tno);
                    
                     
                    
                    for vloop in (
                    Select 
                    					a.tno,
                    					a.stockmodulecode,
                    					a.stockmoduletno,
                    					getmoduleno(a.stockmodulecode,a.stockmoduletno) as referenceno,
                    					Nvl(b.stockquantity1,0) - Nvl(b.usedstockquantity1,0) As Quantity1,
                    					Nvl(b.stockquantity2,0) - Nvl(b.usedstockquantity2,0) As Quantity2,
                    					b.storagelocationcode,
                    					getstoragelocationname(b.storagelocationcode) as storagelocationname,
                    					a.rate
                    					From stock a, stockstoragedetail b
                    					Where a.tno = b.tno
                    						--And Nvl(b.stockquantity1,0) - Nvl(b.usedstockquantity1,0) > 0
                    					  And a.stockdate <= :P246_AsonDate
                    					  And a.itemcode = :P246_ItemCode
                    						And a.Itemspecificationcode = :P246_ItemSpecificationCode
                    						and ( :P246_StorageLocationCode is null or b.StorageLocationCode = :P246_StorageLocationCode)	  
                                            and a.companycode = :Global_companycode
                    					order by a.stockdate, a.tno
                    
                    ) loop
                        tserialno := nvl(tserialno,0) + 1;
                            insert into stockrevaluationdetail (
                                        TNO,
                                        SNO,
                                        SERIALNO,
                                        STOCKTNO,
                                        STORAGELOCATIONCODE,
                                        RATE,
                                        AMOUNT,
                                        QUANTITY1,
                                        QUANTITY2
                            ) values
                            (
                                :P246_TNO,
                                globaltno.nextval,
                                tserialno,
                                vloop.tno,
                                vloop.storagelocationcode,
                                vloop.rate,
                                nvl(vloop.rate,0) * nvl(vloop.Quantity1,0),
                                vloop.Quantity1,
                                vloop.Quantity2
                            )
                            ;
                    end loop;
                    end;
                    ```
                itemsToSubmit: [
                    P246_TNO
                    P246_ITEMCODE
                    P246_STORAGELOCATIONCODE
                    P246_ITEMSPECIFICATIONCODE
                    P246_ASONDATE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

