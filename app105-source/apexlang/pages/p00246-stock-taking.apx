    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P246_TNO is null then
                    :P246_TNO := GlobalTNo.nextval;
                    :P246_FORMSTATUS := 'NEWRECORD';
                else
                    :P246_FORMSTATUS := 'EDITRECORD';
                End if;
                
                FOR VLOOP IN (
                SELECT TNO,VOUCHERNO FROM VOUCHER WHERE MODULETNO = :P246_TNO
                
                ) LOOP
                   :P246_VOUCHERTNO := vloop.tno ;
                   :P246_VOUCHERNO  := vloop.VOUCHERNO;
                END LOOP;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 76031338928406738
        }
    )

