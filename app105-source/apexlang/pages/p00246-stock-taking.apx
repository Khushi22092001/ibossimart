    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 270
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail
            columns: QUANTITY1PHYSICAL
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      :quantity2physical  := nvl(:quantity1physical,0) * nvl(:multiplyingfactor,0);
                      :quantity2onbook    := nvl(:QUANTITY1ONBOOK,0) * nvl(:multiplyingfactor,0);
                      :quantity1variation := nvl(:QUANTITY1ONBOOK,0) - nvl(:quantity1physical,0);
                      :quantity2variation := nvl(:quantity1variation,0) - nvl(:multiplyingfactor,0);
                      :excessstockvalue   := nvl(:quantity1variation,0) * nvl(:stockrate,0);
                    
                    
                    end;
                    ```
                itemsToSubmit: [
                    QUANTITY1ONBOOK
                    MULTIPLYINGFACTOR
                    STOCKRATE
                ]
                itemsToReturn: [
                    QUANTITY2ONBOOK
                    QUANTITY1VARIATION
                    QUANTITY2VARIATION
                    EXCESSSTOCKVALUE
                    QUANTITY2PHYSICAL
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: nvl(:QUANTITY1ONBOOK,0) - nvl(:quantity1physical,0)
                itemsToSubmit: [
                    QUANTITY1ONBOOK
                    QUANTITY1PHYSICAL
                ]
            }
            affectedElements {
                selectionType: columns
                columns: QUANTITY1VARIATION
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction open-voucher (
        name: Open Voucher
        execution {
            sequence: 260
        }
        when {
            event: dblclick
            selectionType: items
            items: P246_VOUCHERNO
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P246_VOUCHERTNO').getValue();
                    var y = '244';
                    var z = 'CALLED';
                    
                    var url = "f?p=#APP_ID#:156:#SESSION#::NO:RP,156:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#P156_TNO#", x);
                    url = url.replace("#P156_CALLEDFROMPAGE#", y);
                    url = url.replace("#P156_FORMSTATUS#", z);
                    
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                                 if :P246_STATUS = 'ACTIVE' then
                            
                                    CREATEPAYMENTADVICEFORPO(:P246_TNO);
                    
                                  end if;
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P246_TNO
                    P246_COMPANYCODE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P246_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

