    region stock-taking (
        name: Stock Taking
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       STOCKTAKINGNO,
                       STOCKTAKINGDATE,
                       EMPLOYEECODE,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       REMARK,
                       CREATOR,
                       CREATIONTIME,
                       NVL(getdocumentstatuscode(getmodulecodeforpageno(:APP_PAGE_ID),TNO),'STATUS') AS STATUS
                  from STOCKTAKING
                ```
            pageItemsToSubmit: P246_TNO
        }
        layout {
            sequence: 10
            slot: body
