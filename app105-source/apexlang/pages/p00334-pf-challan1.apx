    dynamicAction calculate-detail (
        name: Calculate detail
        execution {
            sequence: 170
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @pf-detail
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("PFDEDUCTEDONAMOUNT");
                    model.forEach(function(igrow) {
                        n_amt = parseFloat(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P334_PFDEDUCTEDONAMOUNT").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail").widget().interactiveGrid("getViews", "grid").model;
                    var n_amt, n_totamt = 0;
                    col_amt = model.getFieldKey("PFAMOUNT");
                    model.forEach(function(igrow) {
                        n_amt = parseFloat(igrow[col_amt], 10);
                        if (!isNaN(n_amt)) {
                            n_totamt += n_amt;
                        }
                    });
                    apex.item("P334_PFAMOUNT").setValue(n_totamt);
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction call-detail-region (
        name: call detail region
        execution {
            sequence: 150
        }
        when {
            event: click
            selectionType: button
            button: @detail
        }

        action native-open-region (
            action: openRegion
            affectedElements {
                selectionType: region
                region: @pf-detail
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pf-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-records-deom-detail-which-not-in-master (
        name: delete records deom detail which not in master
        execution {
            sequence: 120
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DELETE FROM pfchallanDETAIL A WHERE NOT EXISTS 
                            ( SELECT 1 FROM pfchallan AA WHERE AA.TNO = A.TNO);
                    ```
            }
            execution {
                sequence: 10
                stopExecutionOnError: false
                waitForResult: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P334_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            execution {
                sequence: 70
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from grn a
                    where a.materialintno = :P334_TNO;
                    ```
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    ```
            }
        )

    )

