    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P334_Tno is null then
                        Select GlobalTno.NextVal into :P334_Tno From Dual;
                     end if;
                    ----
                    if :P334_PFCHALLANNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P334_LocationCode,
                					:P334_DocTypeCode,
                					NULL,
                					TO_DATE(:P334_PFCHALLANDATE, 'DD-MM-RRRR')
                				);
                        :P334_PFCHALLANNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P334_LocationCode,
                                    :P334_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P334_PFCHALLANDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
