    pageItem P334_FORMONTH (
        type: popupLov
        label {
            label: For Month
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                to_char(a.Fromdate, 'Month, rrrr') d,
                a.FromDate r
                from PeriodList a, FinancialYear b
                where a.PeriodType = 'MONTH'
                and b.FinancialYearCode = :global_FinancialYearCode
                and a.FromDate <= sysdate
                and a.FromDate between b.FinancialYearBegin and b.FinancialYearEnd
                order by a.FromDate
                ```
        }
        layout {
            sequence: 90
            region: @pf-challan
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @pf-challan
            column: FORMONTH
            dataType: date
        }
    )

    pageItem P334_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @commonfields
            slot: regionBody
        }
        default {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                	begin
                	If :P334_TNO is null then
                		return('NEWRECORD');
                	else
                		return('EDITRECORD');
                	End if;
                	end ;
                ```
        }
        sessionState {
            storage: request
        }
    )

