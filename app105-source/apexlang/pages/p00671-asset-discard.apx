        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select locationname , locationcode from location   
                where locationcode in (select distinct locationcode from TOURREQUESTONSPECIALAPPROVAL)
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P671_TNO (
