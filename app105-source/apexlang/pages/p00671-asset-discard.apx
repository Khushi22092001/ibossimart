page 671 (
    name: Asset Discard
    alias: ASSET-DISCARD
    title: Asset Discard
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region asset-discard (
        name: Asset Discard
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       getlocationname(LOCATIONCODE) locationname,
                       getdoctypename(DOCTYPECODE) doctypename,
                       ASSETDISCARDNO,
                       ASSETDISCARDDATE,
                       getitemname(ITEMCODE) item,
                       getITEMSPECIFICATIONname(ITEMCODE,ITEMSPECIFICATIONCODE) as ITEMSPECIFICATION,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       FROMWORKCENTRECODE,
                       getitemname(TOITEMCODECODE) toitem,
                       getITEMSPECIFICATIONname(TOITEMCODECODE,TOITEMSPECIFICATIONCODE) toITEMSPECIFICATION,
                       TODESCRIPTION,
                       REMARK,
                       TOITEMCODE,
                       TOQUANTITY1,
                       TOQUANTITY2,
                       TOSTORAGELOCATIONCODE,
                       ASSETVALUE,
                       CREATOR,
                       STOCKACCOUNTCODE,
                       getpartyname(ASSETACCOUNTCODE) assetaccount,
                       DEPRECIATEDAMOUNT,
                       NETVALUE,
                       CREATIONTIME
                  from ASSETDISCARD A
                  WHERE a.ASSETDISCARDDATE  between :P671_FROMDATE and :P671_TODATE
                  --and   ( :P674_COMPANY IS NULL OR instr(':'||:P674_COMPANY||':',':'||a.companycode||':') > 0 )
                  and   instr(':'||:P671_COMPANY||':',':'||a.companycode||':') > 0
                  and   ( :P671_LOCATION IS NULL OR instr(':'||:P671_LOCATION||':',':'||a.LOCATIONCODE||':') > 0 )
                  and   ( :P671_DOCTYPE IS NULL OR instr(':'||:P671_DOCTYPE||':',':'||a.DOCTYPECODE||':') > 0 )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 672
                items: {
                    P672_TNO: #TNO#
                }
                clearCache: 672
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 109606415307903640
        }

