            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select sysdate-7 from dual
        }
    )

    pageItem P671_LOCATION (
        type: popupLov
