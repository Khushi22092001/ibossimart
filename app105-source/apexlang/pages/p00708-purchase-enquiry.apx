    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /* Registers do not all expose a P<page>_TNO item. The
                       previous generic URL built P707_TNO for the Enquiry
                       Register, but that item was intentionally removed;
                       APEX therefore raised ERR-1002 before navigation. A
                       normal return does not need a document TNO and, with
                       no clear-cache directive, retains the register state. */
                    var returnPage = apex.item('P708_CALLEDFROMPAGE').getValue() || '707';
                    var url = 'f?p=' + $v('pFlowId') + ':' + returnPage + ':' +
                      $v('pInstance') + '::NO::';

                    apex.server.process('PREPARE_URL', { x01: url }, {
                      success: function (pData) {
                        if (pData.success === true) apex.navigation.redirect(pData.url);
                      },
                      error: function (request, status, error) {
                        console.log('Purchase Enquiry return failed:', status, error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 130
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) := :P708_PORECEIPTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = :P708_TNO --':P'||:APP_PAGE_ID||'_TNo'
                    				--and d.LoginName = User
                                    AND D.BOSSUSERNAME = :APP_USER
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        /*select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                        */
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = :P708_PASSFAILREMARK
                    			where a.TNo = vPassFail.TNo;
                    			COMMIT;
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(getModuleCodeForPageNo(:APP_PAGE_ID), :P708_TNO , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P708_TNO
                    P708_COMPANYCODE
                    P708_PASSFAILREMARK
                    P708_PORECEIPTNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P708_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

