        name: Terms and Condition - Save Interactive Grid Data
        type: executeCode
        editableRegion: @terms-and-condition
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into ENQUIRYTAC                
                 (
                  tno                       ,
                  sno                       ,
                  termsandconditionheadcode ,
                  termsandcondition        
                )
                            
                            Values (
                                :P708_TNO,
                                NVL(:SNO,GLOBALTNO.NEXTVAL),
                                :termsandconditionheadcode,
                                :termsandcondition
                            );
                        
                        when 'U' then
                            update ENQUIRYTAC Set
                                  TNO=:TNO,
                                SNO=:SNO,
                                termsandconditionheadcode = :termsandconditionheadcode,
                                termsandcondition = :termsandcondition
                
                            WHERE TNO = :P708_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From ENQUIRYTAC
                            Where TNo = :P708_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
