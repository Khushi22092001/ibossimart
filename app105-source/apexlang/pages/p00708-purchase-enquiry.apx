                sequence: 10
            }
        )

        column ITEMPARAMETER (
            type: popupLov
            heading {
                heading: Item Parameter
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select ITEMSPECIFICATIONNAME , ITEMSPECIFICATIONCODE from ITEMSPECIFICATION
                    where ITEMSPECIFICATIONCODE in (
                                                    select ITEMSPECIFICATIONCODE from ENQUIRYITEMDETAIL
                                                    where tno = :P708_TNO
                                                    )
                    union all
                    select 'ALL ITEM' , 'ALL'  from dual
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: PARTYCODE
                itemsToSubmit: P708_TNO
                parentRequired: false
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: ITEMPARAMETER
                dataType: varchar2
            }
            default {
                type: static
                staticValue: All Item
            }
        )

        column PARTYCODE (
            type: popupLov
            heading {
                heading: Party Name
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select VENDORNAME , VENDORCODE from vendor A, DOCUMENTSTATUSDETAIL B
                    WHERE NVL(GETMYPARAMETERVALUE('VENDORAPPLICABLEINPURCHASE'),'NO')= 'YES'
                    AND A.TNO = B.MODULETNO(+)
                    AND B.DOCUMENTSTATUSCODE='ACTIVE'
                    UNION ALL
                    select PARTYNAME , PARTYCODE from PARTY WHERE NVL(GETMYPARAMETERVALUE('VENDORAPPLICABLEINPURCHASE'),'NO')= 'NO'
                    AND getdocumentstatuscode('PARTY',TNO)='ACTIVE'
                    and partytypecode='SUPPLIER'
                    ORDER BY 1
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                databaseColumn: PARTYCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

