            whenButtonPressed: @delete
        }
    )

    process det-doc-no (
        name: Det Doc No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P708_TNO is null then
                        Select GlobalTno.NextVal into :P708_TNO From Dual;
                     end if;
                    ----
                    if :P708_ENQUIRYNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
