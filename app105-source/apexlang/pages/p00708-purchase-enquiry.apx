    dynamicAction fail (
        name: Fail
        execution {
            sequence: 140
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @fail
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    		cursor cPassFail is
                    				select
                    						a.TNo,
                    						a.TokenNo										
                    				from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    				where a.ModuleFlowTNo = b.TNo
                    						and b.TNo = c.TNo
                    						and a.BossUserCode = c.BossUserCode
                    						and c.BossUserCode = d.BossUserCode
                    						--and a.ModuleTNo = ':P'||to_char(:APP_PAGE_ID)||'_TNo'
                                            AND A.ModuleTno = :P708_TNO
                    						--and d.LoginName = User
                    						AND d.BossuserName = :APP_USER
                                            and a.isPass is null
                    						and a.IsFail is null
                    						and a.IsForwarded is null
                    						and a.IsRebounded is null																				
                    		;
                    		vPassFail cPassFail%rowtype;
                        
                        tTokenNo NUMBER;
                        TMP VARCHAR2(100) := :P708_TNO;
                    begin
                    		open cPassFail;
                    		fetch cPassFail into vPassFail;
                    		if cPassFail%FOUND then
                    				tTokenNo := vPassFail.TokenNo;
                    				close cPassFail;
                    
                               	
                    				update PassFail a
                    				set a.IsFail = 'YES',
                    						a.remark = :P708_PASSFAILREMARK
                    				where a.TNo = vPassFail.TNo;
                    				COMMIT;
                    				SendBackPassFail(tTokenNo , TMP );
                    		    		
                    				
                    				commit;
                    		else
                    				close cPassFail;
                    		end if;
                    
                    	
                    end;
                    ```
                itemsToSubmit: [
                    P708_TNO
                    P708_COMPANYCODE
                    P708_PORECEIPTNO
                    P708_PASSFAILREMARK
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P708_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction get-deals-in-supplier (
        name: Get Deals in Supplier
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: button
            button: @getdealsinsupplier
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    	
                    BEGIN
                     
                      
                      for vloop in (select itemcode , ITEMSPECIFICATIONCODE from ENQUIRYITEMDETAIL where tno = :P708_TNO)
                      loop
                    			
                    			
                    			insert into ENQUIRYPARTYDETAIL
                    			( tno , 
                                sno , 
                                partycode 
                                )
                                select tno , globaltno.nextval , party from (
                    			(select 
                                :P708_TNO tno , 
                                c.vendorcode  as party
                                
                    				from VendorDealsIn a, Item b,Vendor c
                    				where a.DealsInCode = b.DealsInCode
                    				and a.tno=c.tno
                    				and b.ItemCode = vloop.ItemCode
                    				and c.VENDORCATEGORY='MATERIAL'
                                    and nvl(getmyparametervalue('VENDORAPPLICABLEINPURCHASE'),'NO')='YES'
                                    UNION ALL
                    			    select 
                                        :P708_TNO tno,
                                        c.partycode  as party
                                
                    				from PartyDealsIn a, Item b,party c
                    				where a.DealsInCode = b.DealsInCode
                    				and a.tno=c.tno
                    				and b.ItemCode = vloop.ItemCode
                                    and nvl(getmyparametervalue('VENDORAPPLICABLEINPURCHASE'),'NO')='NO'
                                )
                                )
                                ;
                    			
                    			
                    	end loop;
                    	
                    END;
                    ```
                itemsToSubmit: P708_TNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @party
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

