    region party (
        name: Party
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid , TNO,
                       SNO,
                       PARTYCODE,
                       ITEMPARAMETER
                  from ENQUIRYPARTYDETAIL
                  where tno = :P708_TNO
                ```
            pageItemsToSubmit: P708_TNO
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
