    process item-detail-save-interactive-grid-data (
        name: Item Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @item-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into ENQUIRYITEMDETAIL (                 
                                    TNO,
                                    SNO,
                                    SERIALNO,
                                    ITEMCODE,
                                    ITEMSPECIFICATIONCODE,
                                    DESCRIPTION,
                                    QUANTITY1,
                                    QUANTITY2,
                                    REMARK,
                                    LASTPARTYCODE,
                                    ECONOMICPARTYCODE
                            )
                            Values (
                                :TNO,
                :SNO,
                :SERIALNO,
                :ITEMCODE,
                :ITEMSPECIFICATIONCODE,
                :DESCRIPTION,
                :QUANTITY1,
                :QUANTITY2,
                :REMARK,
                :LASTPARTYCODE,
                :ECONOMICPARTYCODE
                            );
                        
                        when 'U' then
                            update ENQUIRYITEMDETAIL Set
                                  TNO=:TNO,
                SNO=:SNO,
                SERIALNO=:SERIALNO,
                ITEMCODE=:ITEMCODE,
                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                DESCRIPTION=:DESCRIPTION,
                QUANTITY1=:QUANTITY1,
                QUANTITY2=:QUANTITY2,
                REMARK=:REMARK,
                LASTPARTYCODE=:LASTPARTYCODE,
                ECONOMICPARTYCODE=:ECONOMICPARTYCODE
                
                            WHERE TNO = :P708_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From ENQUIRYITEMDETAIL
                            Where TNo = :P708_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 8488604917497322
        }
    )

