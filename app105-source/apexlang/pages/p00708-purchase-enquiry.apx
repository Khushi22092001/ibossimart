page 708 (
    name: "Purchase Enquiry "
    alias: PURCHASE-ENQUIRY
    title: "Purchase Enquiry "
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P708_BIREPORTURL').val()
              var reportName = 'IRONMART/REPORT/PurchaseEnquiry.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '&P_TNO=' + $('#P708_TNO').val() 
                  ;
            
             
                    var reportURL = bireporturl + reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P708_BIREPORTURL').val()
              var reportName =  'PurchaseEnquiry.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '"_paramsP_TNO":"' + $('#P708_TNO').val() 
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            function generatePDF_new1() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P708_BIREPORTURL').val()
              var reportName =  'PurchaseEnquiry.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '"_paramsP_TNO":"' + $('#P708_TNO').val() 
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            
            ```
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
                t-Form--slimPadding
            ]
        }
    )

    region enquiry (
        name: Enquiry
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.COMPANYCODE,
                       a.FINANCIALYEARCODE,
                       a.LOCATIONCODE,
                       a.DOCTYPECODE,
                       a.ENQUIRYNO,
                       a.ENQUIRYDATE,
                       a.GENERATEDFOR,
                       a.REMARK,
                       a.SUBJECT,
                       a.LETTERTEXT,
                       a.HEADLINEMESSAGE,
                       a.EMPLOYEECODE,
                       a.CREATOR,
                       a.PURCHASEPRIFRENCELOCATIONCODE,
                       a.CREATIONTIME,
                       NVL(getdocumentstatuscode('ENQUIRY', a.TNO),'STATUS') AS Status
                  from ENQUIRY a--, ENQUIRYPARTYDETAIL b, VENDOR c
                  --WHERE a.TNO = b.TNO (+)
                 -- AND b.PARTYCODE = c.VENDORCODE (+);
                ```
        }
        layout {
            sequence: 5
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region enquiry-indent-detail (
        name: Enquiry Indent Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.INDENTTNO,
                       a.STATUS,
                       b.indentno ,
                       b.tno itno
                  from ENQUIRYINDENTDETAIL a , indent b
                  where a.tno = :P708_TNO
                  and a.INDENTTNO = b.tno  
                ```
            pageItemsToSubmit: P708_TNO
        }
        layout {
            sequence: 20
            parentRegion: @enquiry
            slot: subRegions
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ENQUIRYINDENTDETAIL
        }
        edit {
            enabled: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 148273139735939920
        }

