    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    APEX_UTIL.SET_SESSION_STATE ('P258_PARTY',:P258_PARTY);
                    APEX_UTIL.SET_SESSION_STATE ('P258_FROMDATE',:P258_FROMDATE);
                    APEX_UTIL.SET_SESSION_STATE ('P258_TODATE',:P258_TODATE);
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    pappuser varchar2(100);
                    PPARTYCODE VARCHAR2(30);
                    BEGIN
                      DELETE FROM TrialbalancerevisedLOCATION;
                      INSERT INTO TrialbalancerevisedLOCATION
                        (TNO, LOCATIONCODE, CREATOR )
                        (select globaltno.nextval,
                               X.locationcode,
                               v('APP_USER')
                         FROM LOCATION X
                         WHERE (:P258_LOCATION Is Null Or
                                            instr(':' || :P258_LOCATION || ':',
                                                   ':' || X.LocationCode || ':') > 0))
                                        
                        --values ( globaltno.nextval,:P258_LOCATION,V('APP_USER'))
                        
                        ;
                    commit;
                    
                       if :P258_LOCATION is not null then
                                FOR vLocation IN (SELECT * FROM TRIALBALANCEREVISEDLOCATION) LOOP
                              /* raise_application_error(
                                      -20000,
                                      :P258_PARTY||'-'||:P258_FROMDATE||'-'||:P258_TODATE||'-'||:GLOBAL_COMPANYCODE||'-'||:P258_LOCATION||'-'||V('APP_USER')
                                    );   
                               */ 
                               GenerateAccountLedgerRevised(:P258_PARTYCODE,
                                                             TO_DATE(:P258_FROMDATE,'DD-MM-RRRR'),
                                                             TO_DATE(:P258_TODATE,'DD-MM-RRRR'),
                                                             :GLOBAL_COMPANYCODE,
                                                             vLocation.LocationCode,
                                                             'NO',
                                                             vLocation.Creator);
                                
                    
                             END LOOP;
                        else
                            GenerateAccountLedgerRevised(:P258_PARTYCODE,
                                                             TO_DATE(:P258_FROMDATE,'DD-MM-RRRR'),
                                                             TO_DATE(:P258_TODATE,'DD-MM-RRRR'),
                                                             :GLOBAL_COMPANYCODE,
                                                             :P258_LOCATION,
                                                             'NO',
                                                             V('APP_USER'));
                        end if;
                    
                    COMMIT;
                    END;
                    ```
                itemsToSubmit: [
                    P258_FROMDATE
                    P258_TODATE
                    P258_LOCATION
                    P258_PARTY
                    P258_PARTYCODE
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT :P258_FROMDATE,:P258_TODATE,:P258_LOCATION, :P258_PARTY FROM DUAL
                itemsToSubmit: [
                    P258_FROMDATE
                    P258_TODATE
                    P258_LOCATION
                    P258_PARTY
                ]
            }
            affectedElements {
                selectionType: items
                items: [
                    P258_FROMDATE
                    P258_TODATE
                    P258_LOCATION
                    P258_PARTY
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

