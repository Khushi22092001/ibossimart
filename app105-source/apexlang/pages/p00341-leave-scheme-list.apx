page 341 (
    name: Leave Scheme List
    alias: LEAVE-SCHEME-LIST
    title: Leave Scheme List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent15
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            plsqlExpression: 1=2
        }
    )

    region leave-scheme (
        name: Leave Scheme
        type: interactiveReport
        source {
            location: localDatabase
            tableName: LEAVESCHEME
            pageItemsToSubmit: [
                P341_COMPANY
                P341_LOCATION
                P341_FROMDATE
                P341_TODATE
                P341_DOCTYPE
                P341_EMPLOYEE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 342
                items: {
                    P342_TNO: \#TNO#\
                }
                clearCache: 342
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 292701201512003801
        }

        column APPLIEDONWARD (
            type: plainText
            heading {
                heading: Appliedonward
            }
            layout {
                sequence: 50
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AV
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creationtime
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AY
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AZ
            }
        )

        column INCASHMENTSALARYHEADCODE (
            type: plainText
            heading {
                heading: Incashmentsalaryheadcode
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AX
            }
        )

        column LEAVESCHEMECODE (
            type: plainText
            heading {
                heading: Leaveschemecode
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AR
            }
        )

        column LEAVESCHEMENAME (
            type: plainText
            heading {
                heading: Leaveschemename
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AS
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AU
            }
        )

        column SHORTNAME (
            type: plainText
            heading {
                heading: Shortname
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AT
            }
        )

        column STAFFTYPECODE (
            type: plainText
            heading {
                heading: Stafftypecode
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AW
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cheque Receipt List
        }

        savedReport 321406 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APPLIEDONWARD (
                sequence: 1
            )

            displayColumn CREATIONTIME (
                sequence: 2
            )

            displayColumn CREATOR (
                sequence: 3
            )

            displayColumn INCASHMENTSALARYHEADCODE (
                sequence: 4
            )

            displayColumn LEAVESCHEMECODE (
                sequence: 5
            )

            displayColumn LEAVESCHEMENAME (
                sequence: 6
            )

            displayColumn REMARK (
                sequence: 7
            )

            displayColumn SHORTNAME (
                sequence: 8
            )

            displayColumn STAFFTYPECODE (
                sequence: 9
            )

        )

    )

    pageItem P341_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @filter
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P341_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'PFCHALLAN'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P341_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.DocTypeName d,
                a.DocTypeCode r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c
                where a.DocTypeCode = b.DocTypeCode
                and b.tno = c.tno
                and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                and (
                     not exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and aa.CompanyCode = :global_CompanyCode
                     )
                     or
                     exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and bb.DocTypeCode = a.DocTypeCode
                             and aa.CompanyCode = :global_CompanyCode
                     )
                )
                order by a.DocTypeName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P341_COMPANY
            itemsToSubmit: P341_DOCTYPE
        }
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Doc Type Name
        }
    )

    pageItem P341_EMPLOYEE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.EmployeeName d,
                a.EmployeeCode r
                from Employee a
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P341_COMPANY
            itemsToSubmit: P341_DOCTYPE
        }
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Employee Name
        }
    )

    pageItem P341_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)-7
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P341_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.LocationName d,
                	a.LocationCode r
                From Location a, ModuleLocationDetail b , ModuleLocation c
                Where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                	and c.CompanyCode = :GLOBAL_COMPANYCODE
                	and (
                		not exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                		or
                		exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and bb.LocationCode = a.LocationCode
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                	)
                Order by a.LocationName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Location Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P341_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @/title
            slot: regionBody
        }
    )

    pageItem P341_TNO_1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @filter
            slot: regionBody
        }
    )

    pageItem P341_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 50
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: To Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @leave-scheme
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 342
                clearCache: 342
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @leave-scheme
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 80
            region: @filter
            slot: regionBody
            column: 7
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

