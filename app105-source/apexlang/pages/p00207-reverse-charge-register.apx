page 207 (
    name: Reverse Charge Register
    alias: REVERSE-CHARGE-REGISTER
    title: Reverse Charge Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region reverse-charge-list (
        name: Reverse Charge List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       getcompanyname(COMPANYCODE) companyname,
                       FINANCIALYEARCODE,
                       getlocationname(LOCATIONCODE) locationname,
                       getdoctypename(DOCTYPECODE) doctypename,
                       getpartyname(PARTYCODE) partyname,
                       SUMOFAMOUNT,
                       SUMOFFOOTERAMOUNT,
                       REVERSECHARGEAMOUNT,
                       REMARK,
                       ITEMWISEFOOTER,
                       REVERSECHARGEDATE,
                       REVERSECHARGENO,
                       TRANSACTIONTYPECODE,
                       CREATIONTIME,
                       CREATOR,
                       MODULECODE,
                       MODULETNO,
                       NATUREOFSUPPLYCODE,
                       FOOTERNATURECODE,
                       SUPPLIERCODE,
                       SUPPLIERNAME,
                       REVERSECHARGEFOOTERNATURECODE
                  from REVERSECHARGE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 208
                items: {
                    P208_TNO: \#TNO#\
                }
                clearCache: 208
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 115163695032361126
        }

