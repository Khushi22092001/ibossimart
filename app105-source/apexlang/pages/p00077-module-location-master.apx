    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P77_TNO is null then
                            :P77_FORMSTATUS := 'NEWRECORD';
                        else
                            :P77_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P77_TNO is null then
                
                        select globaltno.nextval into :P77_TNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 143332394170513355
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P77_MODULEFLOW := 'YES';
                   else
                       :P77_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P77_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P77_ONTHETABLE := 'YES' ;
                   else
                       :P77_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 80
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 143332649933514090
        }
    )

