page 77 (
    name: Module Location Master
    alias: MODULE-LOCATION-MASTER
    title: Module Location Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        height: 600
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       LOCATIONCODE,
                       REMARK,
                       SNO
                  from MODULELOCATIONDETAIL
                  where tno = :P77_TNO
                ```
            pageItemsToSubmit: P77_TNO
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 150217599333441534
        }

        savedReport 1507942 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @LOCATIONCODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column LOCATIONCODE (
            type: popupLov
            heading {
                heading: Location
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery: select locationname , locationcode from location
                displayNullValue: false
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: LOCATIONCODE
                dataType: varchar2
                primaryKey: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        column REMARK (
            type: textField
            heading {
                heading: Remark
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P77_TNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Detail
        }
    )

