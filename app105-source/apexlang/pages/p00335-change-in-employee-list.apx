page 335 (
    name: Change In Employee List
    alias: CHANGE-IN-EMPLOYEE-LIST
    title: Change In Employee List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region change-in-employee (
        name: Change In Employee
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       a.TNO,
                       a.ChangeinEmployeeno,
                       a.ChangeinEmployeedate,
                       b.EmployeeName,
                       a.effectivedate,
                       b.EmployeeID,
                       b.employeecode 
                 from 
                       ChangeinEmployee a, Employee b
                where a.EmployeeCode =b.EmployeeCode(+)
                --and GetLocationPrivilege( a.LocationCode, GETMODULECODEFORPAGENO(:APP_PAGE_ID), a.CompanyCode, :GLOBAL_LOGINNAME) = 'YES'	
                
                  
                      -- filter
                   and ( :P335_FROMDATE is null OR (a.effectivedate between :P335_FROMDATE and :P335_TODATE))
                  and (:P335_COMPANY is null  OR (instr(':'||:P335_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  and (:P335_LOCATION is null OR (instr(':'||:P335_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and (:P335_DOCTYPE is null  OR (instr(':'||:P335_DOCTYPE||':',':'||a.DocTypeCode||':') > 0))
                  and (:P335_EMPLOYEE is null  OR (instr(':'||:P335_EMPLOYEE||':',':'||a.EMPLOYEECODE||':') > 0))
                 
                Order  by
                        a.Changeinemployeedate desc, a.effectivedate desc, 
                 b.EmployeeName
                ```
            pageItemsToSubmit: [
                P335_COMPANY
                P335_LOCATION
                P335_FROMDATE
                P335_TODATE
                P335_DOCTYPE
                P335_EMPLOYEE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 336
                items: {
                    P336_TNO: \#TNO#\
                }
                clearCache: 336
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 159930698619892655
        }

        column CHANGEINEMPLOYEEDATE (
            type: plainText
            heading {
                heading: Change In Employee Date
            }
            layout {
                sequence: 20
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AA
            }
        )

        column CHANGEINEMPLOYEENO (
            type: plainText
            heading {
                heading: Change In Employee No
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Z
            }
        )

        column EFFECTIVEDATE (
            type: plainText
            heading {
                heading: Effective Date
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AC
            }
        )

        column EMPLOYEECODE (
            type: plainText
            heading {
                heading: Employee Code
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AE
            }
        )

        column EMPLOYEEID (
            type: plainText
            heading {
                heading: Employee ID
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AD
            }
        )

        column EMPLOYEENAME (
            type: plainText
            heading {
                heading: Employee Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AB
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cheque Receipt List
        }

        savedReport 321406 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CHANGEINEMPLOYEEDATE (
                sequence: 3
            )

            displayColumn CHANGEINEMPLOYEENO (
                sequence: 4
            )

            displayColumn EFFECTIVEDATE (
                sequence: 5
            )

            displayColumn EMPLOYEEID (
                sequence: 2
            )

            displayColumn EMPLOYEENAME (
                sequence: 1
            )

        )

    )

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent15
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P335_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @filter
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P335_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'PFCHALLAN'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P335_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.DocTypeName d,
                a.DocTypeCode r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c
                where a.DocTypeCode = b.DocTypeCode
                and b.tno = c.tno
                and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                and (
                     not exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and aa.CompanyCode = :global_CompanyCode
                     )
                     or
                     exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and bb.DocTypeCode = a.DocTypeCode
                             and aa.CompanyCode = :global_CompanyCode
                     )
                )
                order by a.DocTypeName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P335_COMPANY
            itemsToSubmit: P335_DOCTYPE
        }
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Doc Type Name
        }
    )

    pageItem P335_EMPLOYEE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.EmployeeName d,
                a.EmployeeCode r
                from Employee a
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P335_COMPANY
            itemsToSubmit: P335_DOCTYPE
        }
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Employee Name
        }
    )

    pageItem P335_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)-7
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P335_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.LocationName d,
                	a.LocationCode r
                From Location a, ModuleLocationDetail b , ModuleLocation c
                Where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                	and c.CompanyCode = :GLOBAL_COMPANYCODE
                	and (
                		not exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                		or
                		exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and bb.LocationCode = a.LocationCode
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                	)
                Order by a.LocationName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Location Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P335_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @/title
            slot: regionBody
        }
    )

    pageItem P335_TNO_1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @filter
            slot: regionBody
        }
    )

    pageItem P335_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
