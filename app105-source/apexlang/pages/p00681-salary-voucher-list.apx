    region salary-voucher-list (
        name: Salary Voucher List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       getlocationname(LOCATIONCODE) locationname,
                       getdoctypename(DOCTYPECODE) doctypename,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       SALARYVOUCHERNO,
                       SALARYVOUCHERDATE,
                       REMARK,
                       SALARYFROMDATE,
                       SALARYTODATE,
                       ACCOUNTCODEPAYABLE,
                       NARRATION,
                       STAFFTYPECODE,
                       ARREARDATE,
                       CREATIONTIME,
                       CREATOR,
                                   '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||9993||':'||:APP_SESSION||'::::'||'P9993_TNO,P9993_REPNAME'||':'||Tno||','||'SalaryVoucher'||':NO')||'"><span aria-label="Action"><span class="fa fa-print"  aria-hidden="true" title="Action"></span</span></a>' AS Print
                
                  from SALARYVOUCHER
                  where SALARYVOUCHERDATE  between :P681_FROMDATE and :P681_TODATE
                and   instr(':'||:P681_COMPANY||':',':'||companycode||':') > 0
                and   ( :P681_LOCATION IS NULL OR instr(':'||:P681_LOCATION||':',':'||LOCATIONCODE||':') > 0 )
                and   ( :P681_DOCTYPE IS NULL OR instr(':'||:P681_DOCTYPE||':',':'||DOCTYPECODE||':') > 0 )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 682
                items: {
                    P682_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 41049837579728139
        }

