            valuePlaceholder: Enter Location Name
        }
    )

    pageItem P180_SJNO (
        type: textFieldWithAutocomplete
        label {
            label: Entry No
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                StockJournalNo
                From StockJournal
                Where instr(':'||:P180_LOCATION||':',':'||LocationCode||':') > 0
                  and StockJournalDate Between :P180_FROMDATE and :P180_TODATE
                Order by 1
                ```
            displayExtraValues: false
        }
        cascadingLov {
            parentItems: P180_LOCATION
            itemsToSubmit: P180_SJNO
        }
        layout {
            sequence: 30
            region: @kitting-unkitting-register
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 9
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Stock Journal No
        }
        security {
            encryptSessionState: false
        }
    )

