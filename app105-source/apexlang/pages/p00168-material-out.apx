    region material-out (
        name: Material Out
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       MATERIALOUTNO,
                       MATERIALOUTDATE,
                       PARTYCODE,
                       TRANSPORTERCODE,
                       DRIVERNAME,
                       VEHICLETYPECODE,
                       VEHICLENO,
                       UNIONNAME,
                       REFDOCTYPECODE,
                       REFDOCNO,
                       REFDOCDATE,
                       REFDOCAMOUNT,
                       SALETAXFORMTYPECODE,
                       REMARK,
                       REFERENCETNO,
                       MATERIALGATEOUTDATE,
                       OUTPASSBYCODE,
                       CREATOR,
                       GATEINTIME,
                       GATEOUTTIME,
                       NOOFTYRE,
                       DLNO,
                       DLVALIDITY,
                       PUCVALIDITY,
                       TRUCKCONDITION,
                       TOOLS,
                       MODULETNO,
                       MODULECODE,
                       REFERENCEMODULECODE,
                       CREATIONTIME,
                       DRIVERMOBILENO,
                       nvl(getdocumentstatuscode(getmodulecodeforpageno(:APP_PAGE_ID),TNO),'STATUS') AS Status
                  from MATERIALOUT
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
        advanced {
            htmlDomId: tabcontainer
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

