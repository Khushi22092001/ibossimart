                    ```plsql
                    delete from MaterialOutDetail where tno = :P168_TNO;
                    insert into MaterialOutDetail 
                    (
                      tno,
                      sno,
                      itemcode,
                      itemspecificationcode,
                      packingtypecode,
                      description,
                      quantity1,
                      quantity2,
