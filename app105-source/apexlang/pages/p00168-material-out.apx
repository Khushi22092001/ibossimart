        column ITEMCODE (
            type: popupLov
            heading {
                heading: Item
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                    B.ITEMNAME D, B.ITEMCODE R
                    FROM materialoutdetail  A, ITEM B
                    WHERE A.ITEMCODE = B.ITEMCODE
                    AND A.TNO = :P168_TNO
                    ```
                displayExtraValues: false
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    P168_REFERENCETNO
                    P168_TNO
                ]
            }
            layout {
