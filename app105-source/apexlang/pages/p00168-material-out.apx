            source {
                databaseColumn: ITEMCODE
                dataType: varchar2
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: popupLov
            heading {
                heading: Item Specification
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select itemspecificationname,itemspecificationcode from itemspecification a, item b
                    where a.tno = b.tno
                      and b.itemcode = :ITEMCODE
                      and exists ( select 1 from despatchadvicedetail aa
                    where aa.tno = :P168_REFERENCETNO 
                      and aa.itemspecificationcode = a.itemspecificationcode
                      )
                    order by 1
                    ```
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    P168_REFERENCETNO
                    ITEMCODE
                ]
            }
            layout {
