    dynamicAction after-selection-of-pending-da (
        name: after selection of pending da
        execution {
            sequence: 120
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pendingda
        }

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P169_REFERENCETNO
            }
            affectedElements {
                selectionType: items
                items: P168_REFERENCETNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-mobile-number (
        name: check mobile number
        execution {
            sequence: 240
        }
        when {
            event: focusout
            selectionType: items
            items: P168_DRIVERMOBILENO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        IF LENGTH(:P168_DRIVERMOBILENO) = 10 AND TRANSLATE(:P168_DRIVERMOBILENO, '0123456789', 'XXXXXXXXXX') IS NULL THEN
                            null;
                        ELSE
                             
                    
                            raise_application_error(-20000,'Incorrect Number');
                        END IF;
                    END;
                    ```
                itemsToSubmit: P168_DRIVERMOBILENO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        v_item_value VARCHAR2(100); -- Change the size according to your item's data type and size
                    BEGIN
                        -- Get the value of the page item
                        SELECT :P168_DRIVERMOBILENO -- Replace P1_ITEM with the actual name of your page item
                        INTO v_item_value
                        FROM DUAL;
                    
                        -- Check if the value contains any alphabet characters
                        IF REGEXP_LIKE(v_item_value, '[[:alpha:]]')  OR LENGTH(v_item_value) != 10 THEN
                            -- Raise an error
                            :P168_DRIVERMOBILENO := 0;
                            --RAISE_APPLICATION_ERROR(-20000, 'The value should not contain any alphabet characters or length should be 10.');
                        END IF;
                    END;
                    
                    ```
                itemsToSubmit: P168_DRIVERMOBILENO
                itemsToReturn: P168_DRIVERMOBILENO
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-3 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    
                            RAISE_APPLICATION_ERROR(-20000, 'The value should not contain any alphabet characters or length should be 10.');
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P168_DRIVERMOBILENO
                value: 0
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 200
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action check-detail (
            name: check detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    checkdetail(getmodulecodeforpageno(:APP_PAGE_ID),:P168_TNO);
                    
                    ```
                itemsToSubmit: P168_TNO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from materialoutDETAIL a
                        where not exists (
                            select 1 from materialout  aa  
                            where aa.tno = a.tno
                        )and a.tno = :P168_TNO;
                    ```
                itemsToSubmit: P168_TNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P168_CALLEDFROMPAGE').getValue();
                    var y = apex.item('P168_CALLEDFROMTNO').getValue();
                    
                    //var url = "f?p=#APP_ID#:80:#SESSION#::NO:RP,80:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#:P#2002#_TNO:#P2002_TNO#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    
                    url = url.replace("#P2002_TNO#", y);
                    //window.alert(x);
                    //window.alert(y);
                    //window.alert(url);
                    
                    
                    //call
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

