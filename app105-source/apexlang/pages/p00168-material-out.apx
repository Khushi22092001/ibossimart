    dynamicAction set-quantity (
        name: "set quantity2 "
        execution {
            sequence: 140
        }
        when {
            selectionType: columns
            interactiveGrid: @item-detail
            columns: QUANTITY1
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                      NVL(A.MULTIPLYINGFACTOR,0) * NVL(:QUANTITY1,0)
                    from itemspecification a
                    where a.itemspecificationcode = :ITEMSPECIFICATIONCODE
                     and NVL(:QUANTITY1 ,0) > 0
                      and :UNIT1 IS NOT NULL 
                    ```
                itemsToSubmit: [
                    ITEMSPECIFICATIONCODE
                    QUANTITY1
                    UNIT1
                ]
            }
            affectedElements {
                selectionType: columns
                columns: QUANTITY2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-quantity-2 (
        name: SET QUANTITY1
        execution {
            sequence: 150
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @item-detail
            columns: QUANTITY2
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    tmp number;
                    begin
                        tmp := :QUANTITY1;
                        if :UNIT2 is not null then
                            select
                              NVL(:QUANTITY2,0) / NVL(A.MULTIPLYINGFACTOR,0) into tmp
                            from itemspecification a
                            where a.itemspecificationcode = :ITEMSPECIFICATIONCODE
                              and NVL(:QUANTITY2 ,0) > 0
                              and :UNIT2 IS NOT NULL ;
                              
                         end if;
                         RETURN TMP;
                     end ; 
                    ```
                itemsToSubmit: [
                    ITEMSPECIFICATIONCODE
                    QUANTITY2
                    UNIT2
                    QUANTITY1
                ]
            }
            affectedElements {
                selectionType: columns
                columns: QUANTITY1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

