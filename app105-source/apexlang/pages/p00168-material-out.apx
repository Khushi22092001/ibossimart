        }
    )

    region item-detail (
        name: Item Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*SELECT TO_NUMBER(:P168_TNO) as tno,
                        NULL as sno,
                        A.ITEMCODE,
                        A.ITEMSPECIFICATIONCODE,
                        A.PACKINGTYPECODE,
                        A.DESCRIPTION,
                        A.QUANTITY1,
                       b.measuringunitcode1,
                       a.QUANTITY2,
                       b.measuringunitcode2,
                       a.REMARK,
                       NULL AS  ISWEIGHTTAKEN
                FROM DESPATCHADVICEDETAIL A, ITEM B
                WHERE A.ITEMCODE = B.ITEMCODE
                  AND A.TNO = :P168_REFERENCETNO
                  AND :P168_FORMSTATUS='NEWRECORD'
                UNION ALL */   
                select a.rowid , a.TNO,
                       a.SNO,
                       a.ITEMCODE,
                       a.ITEMSPECIFICATIONCODE,
                       a.PACKINGTYPECODE,
                       a.DESCRIPTION,
                       a.QUANTITY1,
                       GetMeasuringUnitNameFromItem(a.ITEMCODE) as Unit1,
                       a.QUANTITY2,
                       GetMeasuringUnit2NameFromItem(a.ITEMCODE) as Unit2,
                       a.REMARK,
                
                       a.ISWEIGHTTAKEN
                  from MATERIALOUTDETAIL a
                  where a.tno = :P168_TNO
                   -- and :P168_FORMSTATUS='EDITRECORD'
                ```
            pageItemsToSubmit: [
                P168_REFERENCETNO
                P168_FORMSTATUS
                P168_TNO
            ]
        }
        layout {
            sequence: 390
            parentRegion: @material-out
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                    //Tab and Shift-Tab will skip over cells that are read-only
                    options.defaultGridViewOptions = {  
                        skipReadonlyCells: true  
                    };
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 169344943420078934
        }

