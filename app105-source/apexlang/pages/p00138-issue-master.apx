    dynamicAction balance-cost-centre (
        name: Balance Cost Centre
        execution {
            sequence: 210
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @issue-cost-centre
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var totalsum1 = parseInt($v("P138_TOTALQTY1"));
                    var totalsum2 = parseInt($v("P138_TOTALQTY2"));
                    var model = apex.region("IssueCostCentre").widget().interactiveGrid("getViews", "grid").model;
                    function Sumofvalues(model){
                        var sum1 = 0;
                        var sum2 = 0;
                        model.forEach(function(r){
                            //console.log(r);
                            sum1 = sum1 +  parseInt(r[4]);
                            sum2 = sum2 +  parseInt(r[5]);
                        })
                        return {sum1, sum2};
                    }
                    var selectedRecords = model.getSelectedRecords();
                    selectedRecords.forEach(function(r) {
                        var ze = 0;
                        if ($v("P138_TOTALQTY1") != ""){
                            model.setValue(r,"QUANTITY1",ze.toString());
                        }
                        if ($v("P138_TOTALQTY2") != ""){
                            model.setValue(r,"QUANTITY2",ze.toString());
                        }
                        var{sum1, sum2} = Sumofvalues(model);
                        if (sum1>totalsum1){
                            sum1 = totalsum1;
                        }
                        if (sum2>totalsum2){
                            sum2 = totalsum2;
                        }
                        var ans1 = totalsum1 - sum1;
                        var ans2 = totalsum2 - sum2;
                        if (sum1=totalsum1){
                            model.setValue(r,"QUANTITY1",ans1.toString());
                        }
                        if (sum2=totalsum2){
                            model.setValue(r,"QUANTITY2",ans2.toString());
                        }
                    });
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction balance-storage-qty (
        name: Balance Storage qty
        execution {
            sequence: 251
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @issue-stock-detail
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var totalsum1 = parseInt($v("P138_TOTALQTY11"));
                    var totalsum2 = parseInt($v("P138_TOTALQTY12"));
                    var model = apex.region("IssueStockDetail").widget().interactiveGrid("getViews", "grid").model;
                    function Sumofvalues(model){
                        var sum1 = 0;
                        var sum2 = 0;
                        model.forEach(function(r){
                            //console.log(r);
                            sum1 = sum1 +  parseInt(r[5]);
                            sum2 = sum2 +  parseInt(r[6]);
                        })
                        return {sum1, sum2};
                    }
                    var selectedRecords = model.getSelectedRecords();
                    selectedRecords.forEach(function(r) {
                        var ze = 0;
                        if ($v("P138_TOTALQTY11") != ""){
                            model.setValue(r,"QUANTITY1",ze.toString());
                        }
                        if ($v("P138_TOTALQTY12") != ""){
                            model.setValue(r,"QUANTITY2",ze.toString());
                        }
                        var{sum1, sum2} = Sumofvalues(model);
                        if (sum1>totalsum1){
                            sum1 = totalsum1;
                        }
                        if (sum2>totalsum2){
                            sum2 = totalsum2;
                        }
                        var ans1 = totalsum1 - sum1;
                        var ans2 = totalsum2 - sum2;
                        if (sum1=totalsum1){
                            model.setValue(r,"QUANTITY1",ans1.toString());
                        }
                        if (sum2=totalsum2){
                            model.setValue(r,"QUANTITY2",ans2.toString());
                        }
                    });
                    
                    
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-qty (
        name: Check qty
        execution {
            sequence: 331
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @issue-stock-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P138_DETAILQUANTITY <> :P138_STOCKQTY1 then
                        raise_application_error(-20000,'Entered Stock Qty is Not Matching With Detail Quantity.');
                    end if;
                    ```
                itemsToSubmit: [
                    P138_DETAILQUANTITY
                    P138_STOCKQTY1
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 120
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       and A.COMPANYCODE = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P138_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 70
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from voucher where moduletno = :P138_TNO;
            }
        )

        action native-disable-4 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 80
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from issuereturn where issuetno = :P138_TNO;
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       and A.COMPANYCODE = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    ```
            }
        )

    )

