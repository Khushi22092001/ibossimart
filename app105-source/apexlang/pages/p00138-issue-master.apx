    process issue-detail-save-interactive-grid-data (
        name: Issue Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @issue-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        When 'C' THEN
                            Insert Into IssueDETAIL(
                                TNO,
                                SNO,
                                SERIALNO,
                                DOCUMENTSTATUSCODE,
                                REQUISITIONTNO,
                                ITEMCODE,
                                ITEMSPECIFICATIONCODE,
                                DESCRIPTION,
                                QUANTITY1,
                                QUANTITY2,
                                CHARGEABLE,
                                RATE,
                                RATEMEASURINGUNITCODE,
                                REMARK,
                                GATEPASSQUANTITY1,
                                GATEPASSQUANTITY2,
                                ASSETQUANTITY1,
                                ASSETQUANTITY2,
                                STOCKVALUE
                            )
                            VALUES(
                                :TNO,
                                :SNO,
                                globaltno.nextval,
                                :DOCUMENTSTATUSCODE,
                                :REQUISITIONTNO,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :DESCRIPTION,
                                :QUANTITY1,
                                :QUANTITY2,
                                :CHARGEABLE,
                                :RATE,
                                :RATEMEASURINGUNITCODE,
                                :REMARK,
                                :GATEPASSQUANTITY1,
                                :GATEPASSQUANTITY2,
                                :ASSETQUANTITY1,
                                :ASSETQUANTITY2,
                                :STOCKVALUE
                            );
                            
                        
                        WHEN 'U' THEN
                            UPDATE IssueDETAIL SET
                                TNO=:TNO,
                                SNO=:SNO,
                                SERIALNO=:SERIALNO,
                                DOCUMENTSTATUSCODE=:DOCUMENTSTATUSCODE,
                                REQUISITIONTNO=:REQUISITIONTNO,
                                ITEMCODE=:ITEMCODE,
                                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                DESCRIPTION=:DESCRIPTION,
                                QUANTITY1=:QUANTITY1,
                                QUANTITY2=:QUANTITY2,
                                CHARGEABLE=:CHARGEABLE,
                                RATE=:RATE,
                                RATEMEASURINGUNITCODE=:RATEMEASURINGUNITCODE,
                                REMARK=:REMARK,
                                GATEPASSQUANTITY1=:GATEPASSQUANTITY1,
                                GATEPASSQUANTITY2=:GATEPASSQUANTITY2,
                                ASSETQUANTITY1=:ASSETQUANTITY1,
                                ASSETQUANTITY2=:ASSETQUANTITY2,
                                STOCKVALUE=:STOCKVALUE
                            WHERE TNO = :P138_TNO
                                --AND ROWID = :ROWID;
                                And SNO = :SNO;
                        WHEN 'D' THEN
                            DELETE FROM IssueDETAIL
                            WHERE TNO = :P138_TNO
                                AND SNO = :SNO
                                ;
                    end case;
                exception when others THEN
                    raise_application_error(-200010,sqlerrm);
                End;
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 156310282209525342
        }
    )

