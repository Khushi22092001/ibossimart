    region issue-detail (
        name: Issue Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.rowid,
                       A.TNO,
                       A.SNO,
                       A.SERIALNO,
                       A.DOCUMENTSTATUSCODE,
                       A.REQUISITIONTNO,
                       A.ITEMCODE,
                       A.ITEMSPECIFICATIONCODE,
                       A.DESCRIPTION,
                       '' as requestedquantity1,
                       A.QUANTITY1,
                       '' as requestedquantity2,
                       A.QUANTITY2,
                       A.CHARGEABLE,
                       A.RATE,
                       A.RATEMEASURINGUNITCODE,
                       A.REMARK,
                       A.GATEPASSQUANTITY1,
                       A.GATEPASSQUANTITY2,
                       A.ASSETQUANTITY1,
                       A.ASSETQUANTITY2,
                       A.STOCKVALUE,
                       'ICD' as ICD,
                       'ISD' as ISD,
                       GetMeasuringUnitNameFromItem(a.itemcode) as unit1,
                       GetMeasuringUnit2NameFromItem(a.itemcode) as unit2
                       
                  from ISSUEDETAIL A--,
                       --Requisition d, 
                	   --Requisitiondetail b,
                       --issuedetail c,
                       --item e,
                	   --itemspecification ee
                  where A.tno = :P138_TNO 
                        --and d.tno = b.tno 
                        --and c.tno = A.TNO
                        --and c.sno = A.SNO
                        --and a.itemcode = b.itemcode
                		--and b.itemcode = e.itemcode
                		--and b.itemspecificationcode = ee.itemspecificationcode
                		--and d.tno = A.REQUISITIONTNO
                ```
            pageItemsToSubmit: P138_TNO
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: IssueDetail
        }
