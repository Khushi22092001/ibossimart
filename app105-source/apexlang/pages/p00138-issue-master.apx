    region issue-master (
        name: Issue Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       ISSUENO,
                       ISSUEDATE,
                       REQUISITIONTNO,
                       REMARK,
                       MODULECODE,
                       MODULETNO,
                       CREATOR,
                       CREATIONTIME
                  from ISSUE
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: General
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region issue-stock-detail (
        name: Issue Stock Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,A.TNO,
                       A.SNO,
                       A.SN,
                       A.STOCKTNO,
                       A.STORAGELOCATIONCODE,
                       A.QUANTITY1,
                       A.QUANTITY2
                  from ISSUESTOCKSTORAGEDETAIL A
                  where A.Tno = :P138_TNO
                  AND A.Sno= :P138_SNO
                ```
            pageItemsToSubmit: [
                P138_TNO
                P138_SNO
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-nosize
            ]
            cssClasses: js-dialog-size900x300
        }
        masterDetail {
            masterRegion: @issue-detail
        }
        advanced {
            htmlDomId: IssueStockDetail
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 161599495657274641
        }

