    dynamicAction set-sum-of-qty-2 (
        name: Set sum of qty1
        execution {
            sequence: 391
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @issue-stock-detail
            columns: QUANTITY1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      stockqty  number;
                      allocateqty number;
                    begin
                        allocateqty := nvl(:quantity1,0);
                         select sum(stockquantity1) - sum(nvl(usedstockquantity1,0)) into stockqty 
                         from stock where tno = :STOCKTNO;
                    
                         if nvl(stockqty,0) > allocateqty then
                              :QUANTITY1 := allocateqty ;
                         else
                              :quantity1 := stockqty ;
                              --raise_application_error ( -20000,' Stock Quantity is Less Than Allocated Quantity');
                         end if;
                    end;
                    ```
                itemsToSubmit: [
                    QUANTITY1
                    STOCKTNO
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

