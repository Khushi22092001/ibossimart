                					:P138_LOCATIONCODE,
                					:P138_DOCTYPECODE,
                					NULL,
                					TO_DATE(:P138_ISSUEDATE, 'DD-MM-RRRR')
                				);
                        :P138_ISSUENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P138_LOCATIONCODE,
                                    :P138_DOCTYPECODE,
                                    NULL,
                                    TO_DATE(:P138_ISSUEDATE, 'DD-MM-RRRR')
                                    );
