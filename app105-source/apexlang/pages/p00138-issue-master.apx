    dynamicAction get-item-from-requisition (
        name: Get item from Requisition
        execution {
            sequence: 160
        }
        when {
            event: click
            selectionType: button
            button: @getitem
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --raise_application_error(-20003,:P118_DOCTYPECODE);
                    begin
                    --Inserting data in issue detail
                    for vloop in (
                    select 
                    			:P138_TNO as tno,
                    			b.itemcode,
                    			b.itemspecificationcode,
                                b.description,
                                b.sno,
                    			--globaltno.nextval as sno,
                                A.TNO AS PTNO
                    from 
                    			Requisition a, 
                    			Requisitiondetail b,
                    			item e,
                    			itemspecification ee
                    where
                    			a.tno = b.tno
                    			and b.itemcode = e.itemcode
                    			and b.itemspecificationcode = ee.itemspecificationcode
                    			and a.tno = :P138_REQUISITIONTNO
                    			--and :P69_DELIVERYANDPAYMENTSCHEDULETNO is null 
                    		
                    ) loop
                        insert into IssueDETAIL
                            (
                                TNO,
                                ITEMCODE,
                                ITEMSPECIFICATIONCODE,
                                DESCRIPTION,
                                SNO,
                                --Quantity1,
                                REQUISITIONTNO
                            ) values
                            (
                                vloop.tno,
                                 vloop.itemcode,
                                 vloop.itemspecificationcode,
                                 vloop.description,
                                 vloop.sno,
                                 --vloop.quantity1,
                                 vloop.PTNO
                            );
                    end loop;
                    ------------||||||||||||||||||||||------------------
                    -----inserting data in issue costcentredetail-------
                    ------------||||||||||||||||||||||------------------
                    
                    for vloop in (
                    select 
                    		    :P138_TNO as tno,
                    			c.costcentrecode,
                    			c.quantity1,
                                c.quantity2,
                                c.remark,
                                c.sno
                    from 
                    			Requisition a, 
                    			Requisitiondetail b,
                    			requisitioncostcentredetail c,
                                item e,
                    			itemspecification ee
                    where
                    			a.tno = b.tno 
                                and c.tno=b.tno
                                and c.sno=b.sno
                    			and b.itemcode = e.itemcode
                    			and b.itemspecificationcode = ee.itemspecificationcode
                    			and a.tno = :P138_REQUISITIONTNO
                    ) loop
                        insert into IssueCostcentreDETAIL
                            (
                                TNO,
                                Costcentrecode,
                                quantity1,
                                quantity2,
                                remark,
                                SNO
                                --Quantity1,
                                --REQUISITIONTNO
                            ) values
                            (
                                vloop.tno,
                                 vloop.costcentrecode,
                                 vloop.quantity1,
                                 vloop.quantity2,
                                 vloop.remark,
                                 vloop.sno
                            );
                    end loop;
                    
                    
                    end;
                    ```
                itemsToSubmit: [
                    P138_TNO
                    P138_REQUISITIONTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @issue-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @issue-cost-centre
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

