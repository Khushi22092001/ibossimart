    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P138_MODULEFLOW := 'YES';
                   else
                       :P138_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P138_ONTHETABLE := 'YES' ;
                   else
                       :P138_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 90
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 157000293945094675
        }
    )

    process gettno (
        name: GetTno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P138_TNO IS NULL then
                    :P138_FORMSTATUS := 'NEWRECORD';
                    select globaltno.nextval into :P138_TNO from dual;
                  else 
                    :P138_FORMSTATUS := 'EDITRECORD';
                end if;
                
                :P138_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P138_TNO), 'Status');
                
                begin
                    select tno , voucherno into :P138_VOUNCHERNO , :P138_VOUNCHERNO_1 from voucher where moduletno = :P138_TNO;
                exception when others then
                null;
                end;
                ```
        }
        execution {
            sequence: 80
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 156999962600093780
