                ```sql
                select rowid,TNO,
                       SNO,
                       SN,
                       COSTCENTRECODE,
                       QUANTITY1,
                       QUANTITY2,
                       REMARK
                  from ISSUECOSTCENTREDETAIL
                  Where TNO = :P138_TNO
                  And SNO = :P138_SNO
