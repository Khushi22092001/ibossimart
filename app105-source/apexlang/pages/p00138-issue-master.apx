                jsCode:
                    ```javascript-browser
                    var model = apex.region("IssueStockDetail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("QUANTITY1");
                    
                    var totalAmt = 0;
                    
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                    
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
