    dynamicAction new-2 (
        name: New
        execution {
            sequence: 70
        }
        when {
            selectionType: items
            items: P400_WITHINDENT
        }
        serverSideCondition {
            type: never
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new
