    pageItem P400_ACCOUNTCODE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Account
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 3
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      p.PartyName d,
                      p.PartyCode r
                From  Party p
                where exists ( select 1 from partycompany aa where aa.tno= p.tno and aa.companycode = :global_companycode)
                Order By 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @trial-balance
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Account List
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: SELECT 1 FROM PARTY WHERE 1 != 1
        }
        sessionState {
            storage: request
        }
