    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                                 if :P626_STATUS = 'ACTIVE' then
                            
                                    CREATEPAYMENTADVICEFORPO(:P626_TNO);
                    
                                  end if;
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: P626_STATUS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P626_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process attendenceperiodicaldetail-save-interactive-grid-data (
        name: ATTENDENCEPERIODICALDETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @employee-deduction-earning-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                           IF :SNO IS NULL then
                                select globaltno.nextval into :SNO from dual;
                           end if;
                            Insert Into EMPLOYEEDEDUCTIONEARNINGDETAIL ( 
                                        TNO,
                                        SNO,
                                        DEDUCTIONEARNINGTYPECODE,
                                        UNIT,
                                        RATE,
                                        AMOUNT,
                                        REMARK, 
                                        MEASURINGUNITCODE,
                                        SERIALNO,
                                        EMPLOYEECODE
                    
                            )
                            Values (
                                        :TNO,
                                        :SNO,
                                        :P626_DEDUCTIONEARNINGTYPECODE,
                                        :UNIT,
                                        :RATE,
                                        :AMOUNT,
                                        :REMARK,
                                        :MEASURINGUNITCODE,
                                        :SERIALNO,
                                        :EMPLOYEECODE
                             );
                        
                        when 'U' then
                            update EMPLOYEEDEDUCTIONEARNINGDETAIL Set
                                        TNO = :TNO,
                                        SNO = :SNO,
                                        DEDUCTIONEARNINGTYPECODE = :P626_DEDUCTIONEARNINGTYPECODE,
                                        UNIT = :UNIT,
                                        RATE = :RATE,
                                        AMOUNT = :AMOUNT,
                                        REMARK = :REMARK,
                                        MEASURINGUNITCODE = :MEASURINGUNITCODE,
                                        SERIALNO = :SERIALNO,
                                        EMPLOYEECODE = :EMPLOYEECODE
                            WHERE TNO = :P626_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From EMPLOYEEDEDUCTIONEARNINGDETAIL
                            Where TNo = :P626_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 11755373483293640
        }
    )

