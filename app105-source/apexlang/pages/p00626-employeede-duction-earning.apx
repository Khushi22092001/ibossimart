    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P626_TNO is null then
                    :P626_TNO := GlobalTNo.nextval;
                    :P626_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P626_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P626_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P626_TNO), 'Status');
