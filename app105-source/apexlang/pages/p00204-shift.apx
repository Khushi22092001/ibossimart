page 204 (
    name: Shift
    alias: SHIFT
    title: Shift
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 800
        height: 300
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    region shift (
        name: Shift
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       SHIFTCODE,
                       SHIFTNAME,
                       REMARK,
                       SHIFTHOUR,
                       SHIFTTIMEFROM,
                       SHIFTTIMETO,
                       LUNCHTIMEFROM,
                       LUNCHTIMETO,
                       CREATOR,
                       CREATIONTIME,
                       GRACEPERIOD
                  from SHIFT
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P204_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P204_CREATIONTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 130
            region: @shift
            slot: regionBody
        }
        source {
            formRegion: @shift
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: item
            item: GLOBAL_SYSDATE
        }
    )

    pageItem P204_CREATOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 120
            region: @shift
            slot: regionBody
        }
        source {
            formRegion: @shift
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: item
            item: GLOBAL_LOGINNAME
        }
    )

    pageItem P204_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 210
            region: @fields
            slot: regionBody
        }
    )

    pageItem P204_GRACEPERIOD (
        type: textField
        label {
            label: Grace Period(HH:MI)
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 50
            region: @shift
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @shift
            column: GRACEPERIOD
            dataType: varchar2
        }
    )

    pageItem P204_LUNCHTIMEFROM (
        type: textField
        label {
            label: Lunch From Time
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 80
            region: @shift
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @shift
            column: LUNCHTIMEFROM
            dataType: varchar2
        }
    )

    pageItem P204_LUNCHTIMETO (
        type: textField
        label {
            label: To Time
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 90
            region: @shift
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @shift
            column: LUNCHTIMETO
            dataType: varchar2
        }
    )

    pageItem P204_MODULEFLOW (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 200
            region: @fields
            slot: regionBody
        }
    )

    pageItem P204_ONTHETABLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 190
            region: @fields
            slot: regionBody
        }
    )

    pageItem P204_PASSFAILREMARK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @fields
            slot: regionBody
        }
    )

    pageItem P204_REMARK (
        type: textField
        label {
            label: Remark
            alignment: left
        }
        layout {
            sequence: 100
            region: @shift
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @shift
            column: REMARK
            dataType: varchar2
        }
    )

    pageItem P204_SHIFTCODE (
        type: textField
        label {
            label: Shift Code
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @shift
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @shift
            column: SHIFTCODE
            dataType: varchar2
        }
    )

    pageItem P204_SHIFTHOUR (
        type: numberField
        label {
            label: ShiftHour
            alignment: left
        }
        layout {
            sequence: 40
            region: @shift
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @shift
            column: SHIFTHOUR
            dataType: number
        }
    )

    pageItem P204_SHIFTNAME (
        type: textField
        label {
            label: Shift Name
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 30
            region: @shift
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @shift
