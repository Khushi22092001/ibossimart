    region service-bill (
        name: Service Bill
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       DEPARTMENTCODE,
                       EMPLOYEECODE,
                       CURRENCYUNITCODE,
                       CURRENCYVALUE,
                       PARTYCODE,
                       SUMOFAMOUNT,
                       SUMOFFOOTERAMOUNT,
                       SERVICEBILLAMOUNT,
                       SUBJECTTEXT,
                       REFERENCETEXT,
                       LETTERTEXT,
                       TITLETEXT,
                       REMARK,
                       ITEMWISEFOOTER,
                       SERVICEBILLDATE,
                       SERVICEBILLNO,
                       FROMDATE,
                       TODATE,
                       RETAINTIONPERCENT,
                       RETAINTIONAMOUNT,
                       TRANSACTIONTYPECODE,
                       MODULECODE,
                       MODULETNO,
                       MOANO,
                       MSIZE,
                       GRADE,
                       LOTNO,
                       CERTIFICATENUMBER,
                       SAPGRNO,
                       SAPGRDATE,
                       TAXPAIDBYBUYER,
                       NATUREOFSUPPLYCODE,
                       DEDUCTEDAMOUNT,
                       PAIDAMOUNT,
                       DFREIGHTBILLTNO,
                       DUEDATE,
                       AGENTCODE,
                       REVERSECHARGE,
                       CREATOR,
                       CREATIONTIME,
                       ADJUSTEDADVANCEAMOUNT,
                       taxinroundoff,
                       billinroundoff,
                       sbamountbeforeround,
                       roundoff,
                       NVL(GETDOCUMENTSTATUSCODE(getmodulecodeforpageno(:APP_PAGE_ID),TNO),'STATUS') AS STATUS
                  from SERVICEBILL 
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: General
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

