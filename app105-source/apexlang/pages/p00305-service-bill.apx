    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P305_Tno is null then
                        Select GlobalTno.NextVal into :P305_Tno From Dual;
                     end if;
                    ----
                    if :P305_SERVICEBILLNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P305_LocationCode,
                					:P305_DocTypeCode,
                					NULL,
                					TO_DATE(:P305_SERVICEBILLDATE, 'DD-MM-YYYY')
                				);
                        :P305_SERVICEBILLNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P305_LocationCode,
                                    :P305_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P305_SERVICEBILLDATE, 'DD-MM-YYYY')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 15471149731641708
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P305_TNO is null then
                    :P305_TNO := GlobalTNo.nextval;
                    :P305_FORMSTATUS := 'NEWRECORD';
                
                    :P305_TAXINROUNDOFF := 'YES';
                    :P305_BILLINROUNDOFF := 'YES';
                  
                else
                    :P305_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P305_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P305_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15470352400641708
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P305_MODULEFLOW := 'YES';
                   else
                       :P305_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P305_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P305_ONTHETABLE := 'YES' ;
                   else
                       :P305_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15470732178641708
        }
    )

