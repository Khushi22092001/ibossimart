    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into SERVICEBILLDETAIL (                 
                                    TNO,
                                    SNO,
                                    JOBTYPECODE,
                                    DESCRIPTION,
                                    QUANTITY1,
                                    QUANTITY2,
                                    RATE,
                                    RATEMEASURINGUNITCODE,
                                    AMOUNT,
                                    FOOTERAMOUNT,
                                    TOTALAMOUNT,
                                    TAXRULECODE,
                                    REMARK
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :JOBTYPECODE,
                                :DESCRIPTION,
                                :QUANTITY1,
                                :QUANTITY2,
                                :RATE,
                                :RATEMEASURINGUNITCODE,
                                :AMOUNT,
                                :FOOTERAMOUNT,
                                :TOTALAMOUNT,
                                :TAXRULECODE,
                                :REMARK
                
                            );
                        
                        when 'U' then
                            update JOBBILLDETAIL Set
                                  TNO=:TNO,
                                SNO=:SNO,
                                JOBTYPECODE=:JOBTYPECODE,
                                DESCRIPTION=:DESCRIPTION,
                                QUANTITY1=:QUANTITY1,
                                QUANTITY2=:QUANTITY2,
                                RATE=:RATE,
                                RATEMEASURINGUNITCODE=:RATEMEASURINGUNITCODE,
                                AMOUNT=:AMOUNT,
                                FOOTERAMOUNT=:FOOTERAMOUNT,
                                TOTALAMOUNT=:TOTALAMOUNT,
                                TAXRULECODE=:TAXRULECODE,
                                REMARK=:REMARK
                
                
                            WHERE TNO = :P305_TNO
                              and SNO = :SNO
                              ;
                
                        when 'D' then
                            Delete From SERVICEBILLDETAIL
                            Where TNo = :P305_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 15404881992641670
        }
    )

