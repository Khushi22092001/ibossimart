    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       SERIALNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       REMARK,
                       PACKINGTYPECODE,
                       RATE,
                       AMOUNT,
                       FOOTERAMOUNT,
                       TOTALAMOUNT,
                       TAXRULECODE,
                       'SD' SD,
                       GetMeasuringUnitNameFromItem(ITEMCODE) as Unit1,
                       GetMeasuringUnit2NameFromItem(ITEMCODE) as Unit2
                  from GATEPASSDETAIL
                where tno = :P195_TNO
                ```
            pageItemsToSubmit: P195_TNO
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 16792184358291104
        }

