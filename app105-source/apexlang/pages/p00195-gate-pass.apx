    dynamicAction disable-save-button-for-updateprivillege (
        name: DISABLE SAVE BUTTON FOR UPDATEPRIVILLEGE
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1 FROM MODULEFLOW A , MODULEFLOWUSER B , bossuser C
                    WHERE A.TNO = B.TNO
                    AND A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                    AND B.BOSSUSERCODE = C.BOSSUSERCODE
                    AND C.BOSSUSERNAME = :APP_USER
                    AND B.UPDATEPRIVILEGE = 'NO'
                    UNION ALL
                    Select 1
                      From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.UPDATEPRIVILEGE = 'NO'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            execution {
                sequence: 40
            }
            serverSideCondition {
                type: item=value
                item: P195_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            execution {
                sequence: 50
            }
            serverSideCondition {
