                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P195_TNO,:P195_STATUS);
                    
                    declare
                        tpaymentadvice number;
                    
                    begin
                        SELECT COUNT(A.TNO) INTO tpaymentadvice
                    	FROM PAYMENTADVICE A
                    	WHERE A.MODULETNO = :P195_TNO ;
                    
