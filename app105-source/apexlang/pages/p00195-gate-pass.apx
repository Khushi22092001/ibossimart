    dynamicAction validate-stock-2 (
        name: validate stock
        execution {
            sequence: 260
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @stock-detail
            columns: QUANTITY1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      stockqty  number;
                      allocateqty number;
                    begin
                        allocateqty := nvl(:quantity1,0);
                         select sum(stockquantity1) - sum(nvl(usedstockquantity1,0)) into stockqty 
                         from stock where tno = :STOCKTNO;
                    
                         if nvl(stockqty,0) > allocateqty then
                              :QUANTITY1 := allocateqty ;
                         else
                              :quantity1 := stockqty ;
                              --raise_application_error ( -20000,' Stock Quantity is Less Than Allocated Quantity');
                         end if;
                    end;
                    ```
                itemsToSubmit: [
                    QUANTITY1
                    STOCKTNO
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Stock_Detail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("QUANTITY1");
                    
                    var totalAmt = 0;
                    
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                    
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                      
                    });
                    
                    $s("P195_STOCKQTY1", totalAmt);
                    
                    	
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: columns
                columns: QUANTITY1
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    CASE :APEX$ROW_STATUS
                        WHEN 'C' THEN
                            INSERT INTO GATEPASSDETAIL (                 
                                    TNO,
                					SNO,
                					SERIALNO,
                					ITEMCODE,
                					ITEMSPECIFICATIONCODE,
                					DESCRIPTION,
                					QUANTITY1,
                					QUANTITY2,
                					REMARK,
                					PACKINGTYPECODE,
                					RATE,
                					AMOUNT,
                					FOOTERAMOUNT,
                					TOTALAMOUNT,
                					TAXRULECODE)
                            VALUES (
                					:TNO,
                					:SNO,
                					:SERIALNO,
                					:ITEMCODE,
                					:ITEMSPECIFICATIONCODE,
                					:DESCRIPTION,
                					:QUANTITY1,
                					:QUANTITY2,
                					:REMARK,
                					:PACKINGTYPECODE,
                					:RATE,
                					:AMOUNT,
                					:FOOTERAMOUNT,
                					:TOTALAMOUNT,
                					:TAXRULECODE);
                        
                        WHEN 'U' THEN
                            UPDATE GATEPASSDETAIL SET
                					ITEMCODE				=:ITEMCODE,
                					ITEMSPECIFICATIONCODE	=:ITEMSPECIFICATIONCODE,
                					DESCRIPTION				=:DESCRIPTION,
                					QUANTITY1				=:QUANTITY1,
                					QUANTITY2				=:QUANTITY2,
                					RATE					=:RATE,
                					AMOUNT					=:AMOUNT,
                					FOOTERAMOUNT			=:FOOTERAMOUNT,
                					TOTALAMOUNT				=:TOTALAMOUNT,
                					REMARK					=:REMARK,
                					TAXRULECODE				=:TAXRULECODE
                            WHERE TNO = :P195_TNO
                              AND ROWID = :ROWID;
                
                        WHEN 'D' THEN
                            DELETE FROM GATEPASSDETAIL
                            WHERE TNO = :P195_TNO
                              AND SNO = :SNO
                              ;
                    END CASE;
                EXCEPTION WHEN OTHERS THEN
                    RAISE_APPLICATION_ERROR(-20010, SQLERRM);
                END;
                
                
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 16794024985291123
        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P195_Tno is null then
                        Select GlobalTno.NextVal into :P195_Tno From Dual;
                     end if;
                    ----
                    if :P195_GATEPASSNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P195_LocationCode,
                					:P195_DocTypeCode,
                					NULL,
                					TO_DATE(:P195_GATEPASSDATE, 'DD-MM-RRRR')
                				);
                        :P195_GATEPASSNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P195_LocationCode,
                                    :P195_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P195_GATEPASSDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 16723825605735852
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P195_TNO is null then
                    :P195_TNO := GlobalTNo.nextval;
                    :P195_FORMSTATUS := 'NEWRECORD';
                   
                  
                else
                    :P195_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P195_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P195_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16692209431698715
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P195_MODULEFLOW := 'YES';
                   else
                       :P195_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P195_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P195_ONTHETABLE := 'YES' ;
                   else
                       :P195_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16692502257699919
        }
    )

