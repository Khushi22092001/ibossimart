            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       GATEPASSNO,
                       GATEPASSDATE,
                       PARTYCODE,
                       REFERENCETNO,
                       REMARK,
                       DUEDATE,
                       JOBORDERTNO,
                       VEHICLETYPECODE,
                       VEHICLENO,
                       TRANSPORTERCODE,
                       DRIVERNAME,
                       UNIONNAME,
                       LORRYNO,
                       LORRYDATE,
                       FREIGHTTYPECODE,
                       CREATOR,
                       EMPLOYEECODE,
                       STOREINREPAIRINGITEMTNO,
                       MRNTNO,
                       TAXVEHICLENO,
                       THROUGH,
                       DEPARTMENTCODE,
                       CCINVOICETNO,
                       FREIGHTUNITCODE,
                       FREIGHTRATE,
                       SUMOFAMOUNT,
                       SUMOFFOOTERAMOUNT,
                       GATEPASSBILLAMOUNT,
                       ITEMWISEFOOTER,
                       TRANSACTIONTYPECODE,
                       TAXRULECODE,
                       PREPARINGDATE,
                       REMOVALDATE,
                       CREATIONTIME,
                       OLDVEHICLENO
                  from GATEPASS
                ```
        }
