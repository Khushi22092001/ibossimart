    dynamicAction check-qty-and-close (
        name: Check qty and close
        execution {
            sequence: 270
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @stock-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P195_INPUTQUANTITY <> :P195_STOCKQTY1 then
                        raise_application_error(-20000,'Entered Stock Qty is Not Matching With Detail Quantity.');
                    end if;
                    ```
                itemsToSubmit: [
                    P195_INPUTQUANTITY
                    P195_STOCKQTY1
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action check-detail (
            name: check detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    checkdetail(getmodulecodeforpageno(:APP_PAGE_ID),:P195_TNO);
                    
                    ```
                itemsToSubmit: P195_TNO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from GATEPASSDETAIL a
                        where not exists (
                            select 1 from GATEPASS  aa  
                            where aa.tno = a.tno
                        )and tno = :P195_TNO;
                    
                    -- delete from GATEPASSDETAILFOOTER a
                    --     where not exists (
                    --         select 1 from GATEPASS  aa  
                    --         where aa.tno = a.tno
                    --     )and tno = :P195_TNO; 
                    -- delete from GATEPASSTAC a
                    --     where not exists (
                    --         select 1 from GATEPASS  aa  
                    --         where aa.tno = a.tno
                    --     )and tno = :P195_TNO; 
                    ```
                itemsToSubmit: P195_TNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P195_CALLEDFROMPAGE').getValue();
                    var y = apex.item('P195_CALLEDFROMTNO').getValue();
                    
                    //var url = "f?p=#APP_ID#:80:#SESSION#::NO:RP,80:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#:P#2002#_TNO:#P2002_TNO#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    
                    url = url.replace("#P2002_TNO#", y);
                    //window.alert(x);
                    //window.alert(y);
                    //window.alert(url);
                    
                    
                    //call
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-record-from-detail-table (
        name: delete unsaved record from detail table
        execution {
            sequence: 110
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from PURCHASEORDERDETAILFOOTER a
                        where not exists (
                            select 1 from PURCHASEORDER  aa  
                            where aa.tno = a.tno
                        ); 
                    
                     delete from PURCHASEORDERDETAIL a
                        where not exists (
                            select 1 from PURCHASEORDER  aa  
                            where aa.tno = a.tno
                        ); 
                    delete from PURCHASEORDERTAC a
                        where not exists (
                            select 1 from PURCHASEORDER  aa  
                            where aa.tno = a.tno
                        ); 
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P195_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            execution {
                sequence: 70
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from loadingadvice aa where aa.purchaseordertno = :P195_TNO;
            }
        )

        action native-disable-4 (
            action: disable
            execution {
                sequence: 80
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from paymentadvice aa where aa.moduletno = :P195_TNO;
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                       and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

    )

