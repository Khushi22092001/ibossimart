            selectionType: button
            button: @getitem
        }

        action for-mrn-no (
            name: for MRN No
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P195_MRNTNO is not null then
                        delete from gatepassdetail where tno = :P195_TNO;
                        insert into gatepassdetail
                        (
                            tno,
                            sno,
                            itemcode,
                            itemspecificationcode,
                            description,
                            quantity1,
                            quantity2
                        )
                        (
                            select
                                :P195_TNO,
                                globaltno.nextval,
                                itemcode,
                                itemspecificationcode,
                                description,
                                quantity1,
                                quantity2
                            from mrndetail
                            where tno = :P195_MRNTNO
                        );
                    end if;
                    ```
                itemsToSubmit: [
                    P195_TNO
                    P195_REFERENCETNO
                    P195_MRNTNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P195_MRNTNO
            }
        )

        action for-reference-no (
            name: for Reference No
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P195_REFERENCETNO IS NOT NULL THEN
                        --Delete old data
                        DELETE FROM GATEPASSDETAIL WHERE TNO = :P195_TNO;
                    
                        INSERT INTO GATEPASSDETAIL
                        (
                            TNO,
                            SNO,
                            ITEMCODE,
                            ITEMSPECIFICATIONCODE,
                            DESCRIPTION,
                            QUANTITY1,
                            QUANTITY2,
                            RATE
                        )
                        (
                            SELECT
                                :P195_TNO,
                                GLOBALTNO.NEXTVAL,
                                da.ITEMCODE,
                                da.ITEMSPECIFICATIONCODE,
                                da.DESCRIPTION,
                                da.QUANTITY1,
                                da.QUANTITY2,
                                (Select 
                                    jod.WITHOUTDISCOUNTRATE 
                                FROM JOBORDERDETAIL jod 
                                WHERE jod.TNO = :P195_JOBORDERTNO 
                                AND jod.ITEMCODE = da.ITEMCODE 
                                AND jod.ITEMSPECIFICATIONCODE = da.ITEMSPECIFICATIONCODE) as RATE
                            FROM DESPATCHADVICEDETAIL da
                            WHERE TNO = :P195_REFERENCETNO
                        );
                    END IF;
                    ```
                itemsToSubmit: [
                    P195_TNO
                    P195_REFERENCETNO
                    P195_JOBORDERTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemIsNotNull
                item: P195_REFERENCETNO
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

