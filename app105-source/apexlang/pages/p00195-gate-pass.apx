                heading: Sno
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            default {
                type: item
                item: P195_SNO
            }
            columnFilter {
                lovType: none
            }
        )

        column STOCKTNO (
            type: popupLov
            heading {
                heading: Stocktno
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sharedComponent
                lov: @p195-stock
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: STORAGELOCATIONCODE
                itemsToSubmit: [
                    P195_TNO
                    P195_STORAGELOCATIONCODE
                    P195_GATEPASSDATE
                    P195_LOCATIONCODE
                    P195_DETAILITEMCODE
                    P195_DETAILSPECIFICATIONCODE
                ]
                parentRequired: false
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: STOCKTNO
                dataType: number
            }
        )

        column STORAGELOCATIONCODE (
            type: popupLov
            heading {
                heading: Storagelocationcode
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery: Select StorageLocationName , StorageLocationCode from StorageLocation order by 1
                displayNullValue: false
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: STORAGELOCATIONCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column TNO (
            type: numberField
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P195_TNO
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

