            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                da.despatchadviceno , 
                da.tno 
                from despatchadvice da
                where da.doctypecode = :P195_DOCTYPECODE
                and getdocumentstatuscode('DESPATCHADVICE',da.TNO) = 'ACTIVE'
                  and da.PartyCode = :P195_PARTYCODE
                ```
        }
        cascadingLov {
            parentItems: [
                P195_GATEPASSDATE
                P195_PARTYCODE
                P195_DOCTYPECODE
                P195_STOREINREPAIRINGITEMTNO
                P195_LOCATIONCODE
            ]
            itemsToSubmit: [
