page 361 (
    name: prototypes
    alias: PROTOTYPES
    title: prototypes
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    pageItem P361_SEARCH (
        type: textField
        label {
            label: Search
            alignment: left
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P361_SEARCH_1 (
        type: textFieldWithAutocomplete
        label {
            label: Search
            alignment: left
        }
        settings {
            infiniteScroll: false
            maxValuesInList: 7
        }
        search {
            minChars: 1
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select aa.MYBOXLABEL
                From (Select *
                          From myboxtree_apex a
                         Where A.BossUserCode = :GLOBAL_BOSSUSERCODE
                           And A.COMPANYCODE = :GLOBAL_COMPANYCODE
                           AND A.MYBOXTYPE='MODULE') AA
                
                ```
        }
        layout {
            sequence: 20
            region: @new
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            width: 30
        }
    )

)

