page 14 (
    name: General
    alias: STEP-1
    title: General
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region general (
        name: General
        type: list
        source {
            list: @company
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/wizard-container
            templateOptions: [
                #DEFAULT#
                t-Wizard--hideStepsXSmall
            ]
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region general-2 (
        name: General
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select COMPANYCODE,
                       COMPANYNAME,
                       COMPANYTYPECODE,
                       PARENTCODE,
                       OWNERNAME,     
                       COMPANYSHORTNAME,
                       TNO,      
                       CREATOR,      
                       CREATIONTIME     
                  from COMPANY
                ```
        }
        layout {
            sequence: 10
            parentRegion: @general
            slot: wizardSubRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P14_COMPANYCODE (
        type: textField
        label {
            label: Company Code
            alignment: left
        }
        layout {
            sequence: 10
            region: @general-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @general-2
            column: COMPANYCODE
            dataType: varchar2
            primaryKey: true
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'COMPANY'
                       and a.CodeScheme = 'AUTO'
                ```
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P14_COMPANYNAME (
        type: textField
        label {
            label: Company Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @general-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @general-2
            column: COMPANYNAME
            dataType: varchar2
        }
    )

    pageItem P14_COMPANYSHORTNAME (
        type: textField
        label {
            label: Company Short Name
            alignment: left
        }
        layout {
            sequence: 290
            region: @general-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @general-2
            column: COMPANYSHORTNAME
            dataType: varchar2
        }
    )

    pageItem P14_COMPANYTYPECODE (
        type: popupLov
        label {
            label: Company Type
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       a.Companytypename d,
                       a.CompanyTypecode r
                from 
                       Companytype a
                Order by
                       a.CompanytypeName
                ```
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @general-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @general-2
            column: COMPANYTYPECODE
            dataType: varchar2
        }
    )

    pageItem P14_CREATIONTIME (
        type: datePicker
        label {
            label: Creation Time
            alignment: left
        }
        layout {
            sequence: 420
            region: @general-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @general-2
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: item
            item: GLOBAL_SYSDATE
        }
    )

    pageItem P14_CREATOR (
        type: textField
        label {
            label: Creator
            alignment: left
        }
        layout {
            sequence: 400
            region: @general-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @general-2
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: item
            item: GLOBAL_LOGINNAME
        }
    )

    pageItem P14_OWNERNAME (
        type: textField
        label {
            label: Owner
            alignment: left
        }
        layout {
            sequence: 50
            region: @general-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @general-2
            column: OWNERNAME
            dataType: varchar2
        }
    )

    pageItem P14_PARENTCODE (
        type: popupLov
        label {
            label: Parent Company
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.Companyname d, a.Companycode r
                  From Company a
                 Order By a.CompanyName
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @general-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @general-2
            column: PARENTCODE
            dataType: varchar2
        }
    )

    pageItem P14_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 300
            region: @general-2
            slot: regionBody
        }
        source {
            formRegion: @general-2
            column: TNO
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @general
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @general
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: t-Button--iconRight
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process initialize-form-step (
        name: Initialize form Step 1
        type: formInitialization
        formRegion: @general-2
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 134394442057478541
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 15
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

