        }
        settings {
            outputAs: text
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       SNO,
                       ITEMCHARACTERISTICSCODE,
                       VALUE,
                       CREATOR,
                       CREATIONTIME,
                       SHORTNAME
                  from MCVALUE
                  where tno = :P53_TNO
                ```
            pageItemsToSubmit: P53_TNO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: DETAIL
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            fixedRowHeight: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 250
        }
        componentAdvanced {
            oracleTextIndexColumn: SNO
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                    //Tab and Shift-Tab will skip over cells that are read-only
                    options.defaultGridViewOptions = {  
                        skipReadonlyCells: true  
                    };
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 139512147503925415
        }

        savedReport 1397049 (
