    dynamicAction check-item-characteristics-code (
        name: Check Item Characteristics Code
        execution {
            sequence: 100
        }
        when {
            event: focusout
            selectionType: items
            items: P53_ITEMCHARACTERISTICSCODE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P53_ITEMCHARACTERISTICSCODE")).length===0 ) {
                        showError("Item Characteristics Code Should Not be Empty", 'P53_ITEMCHARACTERISTICSCODE');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction check-item-characteristics-name (
        name: Check Item Characteristics Name
        execution {
            sequence: 110
        }
        when {
            event: focusout
