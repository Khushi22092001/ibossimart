    pageItem P377_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filters
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: -- Select From Date --
        }
        default {
            type: expression
            plsqlExpression: TRUNC(SYSDATE) -7
        }
    )

    pageItem P377_LOCATION (
        type: selectOne
        label {
            label: Location
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'PINVOICE'
                  and a.ViewPrivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order By 1
                ;
                
                ```
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: -- Select Location --
        }
    )

    pageItem P377_PARTY (
        type: selectOne
        label {
            label: Party
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       Distinct
                       p.PartyName d,
                       p.PartyCode r
                From pinvoice a, Party p
                Where a.PartyCode = p.PartyCode
                Order by 1
                ```
        }
        layout {
            sequence: 40
            region: @filters
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: -- Select Customer Name  --
        }
    )

