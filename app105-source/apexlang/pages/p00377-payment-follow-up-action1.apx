        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 381
                items: {
                    P381_FORMSTATUS: NEWRECORD
                }
                clearCache: 381
            }
            warnOnUnsavedChanges: doNotCheck
