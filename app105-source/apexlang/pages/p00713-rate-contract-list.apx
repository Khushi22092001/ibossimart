            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       Distinct
                       p.PartyName d,
                       p.PartyCode r
                From PurchaseOrder a, Party p
                Where a.PartyCode = p.PartyCode
                Order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @filter
            slot: regionBody
            alignment: left
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 74
            valuePlaceholder: Vendor Name
        }
    )

    pageItem P713_RATECONTRACTNO (
        type: textFieldWithAutocomplete
        label {
            label: PoNo
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select PurchaseOrderNo From PurchaseOrder 
                Where instr(':'||:P713_LOCATION||':',':'||LocationCode||':') > 0
                  and PurchaseOrderDate Between :P713_FROMDATE and :P713_TODATE
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P713_LOCATION
            itemsToSubmit: P713_RATECONTRACTNO
        }
        layout {
            sequence: 120
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Rate Contract No
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P713_STATUS (
        type: selectList
        label {
            label: Status
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Active;ACTIVE,Non-Active;NONACTIVE,Canceled;CANCELED,Closed;CLOSED,Preparing;PREPARING,Prepared;PREPARED,Authorised;AUTHORISED,On Hold;ONHOLD,Short Closed;SHORTCLOSED,Dept Approved;DEPTAPPROVED,Store Approval;STOREAPPROVED
            nullDisplayValue: --Select Status--
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P713_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    pageItem P713_TNO_1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 200
            region: @filter
            slot: regionBody
        }
    )

    pageItem P713_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: To Date
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P713_TODOLIST (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @filter
            slot: regionBody
        }
        default {
            type: static
            staticValue: NO
        }
    )

    button addnew (
        buttonName: AddNew
        label: Add New
        layout {
            sequence: 20
            region: @rate-contrat-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 714
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
