    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P684_Tno is null then
                        Select GlobalTno.NextVal into :P684_Tno From Dual;
                     end if;
                    ----
                    if :P684_SALARYPAYMENTADVICENO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P684_LocationCode,
                					:P684_DocTypeCode,
                					NULL,
                					TO_DATE(:P684_SALARYPAYMENTADVICEDATE, 'DD-MM-RRRR')
                				);
                        :P684_SALARYPAYMENTADVICENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P684_LocationCode,
                                    :P684_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P684_SALARYPAYMENTADVICEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 41699740972677902
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                If :P684_TNO is null then
                    :P684_TNO := GlobalTNo.nextval;
                    :P684_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P684_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P684_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P684_TNO), 'Status');
                
                 begin
                select TNO into :P684_VOUCHERTNO from voucher 
                        where moduletno = :P684_TNO
                          AND MODULECODE='SALARYPAYMENTADVICE';
                exception when others then 
                    null;
                end; 
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 41657513449622688
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P684_MODULEFLOW := 'YES';
                   else
                       :P684_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P684_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P684_ONTHETABLE := 'YES' ;
                   else
                       :P684_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 41657860457623662
        }
    )

