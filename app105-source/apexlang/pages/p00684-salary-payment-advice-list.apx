    pageItem P684_ACCOUNTCODE (
        type: popupLov
        label {
            label: Cash/Bank
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                  A.PARTYNAME,
                  A.PARTYCODE
                FROM PARTY A
                WHERE  A.PARTYTYPECODE != 'ACCOUNTGROUP'
                AND getDocumentStatusCode('PARTY', A.TNO) = 'ACTIVE'
                AND GetAccountPrivilege(a.PartyCode, 'SALARYPAYMENTADVICE', :GLOBAL_CompanyCode, USER) = 'YES'
                and :P684_MoneyTransferModeCode = 'CASH'
                and a.partytypecode = 'CASH'
                /* new concept */
                and ( exists (
                    select * from party x, partylocation y, location z
                    where x.partycode = y.partycode    
                    and y.locationcode = z.locationcode 
                    and x.partycode = a.partycode
                    and z.locationcode = :P684_PAYMENTADVICELOCATIONCODE
                     )
                
                   or
                    NOT exists
                   (
                    select * from party x, partylocation y, location z
                    where x.partycode = y.partycode    
                    and y.locationcode = z.locationcode
                    and x.partycode = a.partycode
                   )
                )
                
                UNION ALL
                SELECT
                  A.PARTYNAME,
                  A.PARTYCODE
                FROM PARTY A
                WHERE  A.PARTYTYPECODE != 'ACCOUNTGROUP'
                AND A.PARTYTYPECODE = 'BANK'
                AND getDocumentStatusCode('PARTY', A.TNO) = 'ACTIVE'
                AND GetAccountPrivilege(a.PartyCode, 'SALARYPAYMENTADVICE', :GLOBAL_CompanyCode, USER) = 'YES'
                and :P684_MoneyTransferModeCode IN ('CH', 'CHEQUE', 'RTGS', 'EPAYMENT','BANK','DD','TT')
                /* new concept */
                and ( exists (
                    select * from party x, partylocation y, location z
                    where x.partycode = y.partycode    
                    and y.locationcode = z.locationcode 
                    and x.partycode = a.partycode
                    and z.locationcode = :P684_PAYMENTADVICELOCATIONCODE
                     )
                
                   or
                    NOT exists
                   (
                    select * from party x, partylocation y, location z
                    where x.partycode = y.partycode    
                    and y.locationcode = z.locationcode
                    and x.partycode = a.partycode
                   )
                )
                
                UNION
                SELECT
                  A.PARTYNAME,
                  A.PARTYCODE
                FROM PARTY A
                WHERE  A.PARTYTYPECODE != 'ACCOUNTGROUP'
                AND getDocumentStatusCode('PARTY', A.TNO) = 'ACTIVE'
                AND GetAccountPrivilege(a.PartyCode, 'SALARYPAYMENTADVICE', :GLOBAL_CompanyCode, USER) = 'YES'
                and :P684_MoneyTransferModeCode not in ('CASH', 'CH', 'CHEQUE', 'RTGS', 'EPAYMENT','BANK','DD','TT')
                /* new concept */
                and ( exists (
                    select * from party x, partylocation y, location z
                    where x.partycode = y.partycode    
                    and y.locationcode = z.locationcode 
                    and x.partycode = a.partycode
                    and z.locationcode = :P684_PAYMENTADVICELOCATIONCODE
                     )
                
                   or
                    NOT exists
                   (
                    select * from party x, partylocation y, location z
                    where x.partycode = y.partycode    
                    and y.locationcode = z.locationcode
                    and x.partycode = a.partycode
                   )
                )
                
                ORDER BY 1
                
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P684_MONEYTRANSFERMODECODE
                P684_PAYMENTADVICELOCATIONCODE
            ]
            itemsToSubmit: [
                P684_MONEYTRANSFERMODECODE
                P684_PAYMENTADVICELOCATIONCODE
            ]
            parentRequired: false
        }
        layout {
