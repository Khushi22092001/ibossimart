    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       COSTCENTERCODE,
                       EMPLOYEECODE,
                       PAYBLE,
                       AMOUNT,
                       REMARK,
                       VOUCHERTNO,
                       VOUCHERSNO,
                       VOUCHERSERIALNO,
                       MODULECODE,
                       MODULETNO,
                       MODULESNO
                  from SALARYPAYMENTADVICEDETAIL
                  where tno = :P684_TNO
                ```
            pageItemsToSubmit: P684_TNO
        }
        layout {
            sequence: 30
            parentRegion: @new
