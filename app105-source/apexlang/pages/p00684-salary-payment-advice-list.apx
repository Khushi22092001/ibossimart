        column COSTCENTERCODE (
            type: popupLov
            heading {
                heading: Cost Center
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select Distinct
                        d.CostCentreName, 
                        c.CostCentreCode
                       
                    from Voucher a,VoucherDetail b,VouchercostCentredetail c,CostCentre d,Employee e,SalaryVoucher sv
                    where a.tno=b.tno
                    and b.tno=c.tno
                    and b.sno=c.sno
                    and c.CostCentreCode=d.CostCentreCode(+)
                    and a.ModuleTno=sv.Tno
                    and d.ModuleTno=e.Tno
                    and sv.LocationCode=:P684_locationCode
                    and (e.BankCode =:P684_EmployeeBankCode
                    or :P684_EmployeeBankCode is null)
                    and Sv.SALARYFROMDATE=:P684_SalaryFromdate
                    and sv.SalarytoDate=:P684_SalaryToDate
                    and sv.StaffTypeCode=:P684_StaffTypeCode
                    AND DECODE(SV.DOCTYPECODE,'GENERAL','PAYMENT',SV.DOCTYPECODE)=:P684_DOCTYPECODE
                    and abs(GETEMPLOYEECOSTCENTREAMOUNT(e.employeeCode,c.tno,c.sno,c.serialNo,sv.DoctypeCode)- GETEMPLOYEESALARYPAYMENT(e.EmployeeCode,:P684_SalaryFromDate,:P684_SalaryToDate,:P684_StaffTypeCode,:P684_LocationCode,:P684_AccountCodePayable,:P684_EmployeeBankCode,:P684_DoctypeCode))>0
                    and Not Exists (Select 
                                        aa.Tno 
                                    from SalaryPaymentAdvice aa ,salarypaymentadvicedetaiL AB
                                    Where aa.SALARYFROMDATE=:P684_SalaryFromdate
                                    and aa.SalarytoDate=:P684_SalaryToDate
                                    and aa.StaffTypeCode=:P684_StaffTypeCode
                                    AND DECODE(SV.DOCTYPECODE,'GENERAL','PAYMENT',SV.DOCTYPECODE)=:P684_DOCTYPECODE
                                    AND AA.TNO=AB.TNO
                                    AND AB.PAYBLE='NO'
                                    )
                    AND NOT EXISTS (
                    SELECT 
                    AA.TNO
                    FROM HOLDSALARY AA
                    WHERE AA.SALARYFROMDATE =:P684_SalaryFromdate
                    AND AA.SALARYTODATE = :P684_SalaryToDate
                    AND AA.EMPLOYEECODE=e.employeeCode
                    AND NOT EXISTS (SELECT 
                                AB.TNO
                        FROM UNHOLDSALARY AB
                        WHERE AB.EMPLOYEECODE=AA.EMPLOYEECODE
                        AND AB.SALARYFROMDATE=AA.SALARYFROMDATE
                        AND AB.SALARYTODATE=AA.SALARYFROMDATE
                    )
                    )
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    P684_LOCATIONCODE
                    P684_EMPLOYEEBANKCODE
                    P684_SALARYFROMDATE
                    P684_SALARYTODATE
                    P684_STAFFTYPECODE
                    P684_DOCTYPECODE
                    P684_ACCOUNTCODEPAYABLE
                ]
                parentRequired: false
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: COSTCENTERCODE
                dataType: varchar2
            }
        )

