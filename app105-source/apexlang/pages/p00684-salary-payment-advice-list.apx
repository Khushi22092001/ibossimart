    dynamicAction delete-detail-data (
        name: Delete detail data
        execution {
            sequence: 120
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from SALARYPAYMENTADVICEDETAIL a
                        where not exists (
                            select 1 from SALARYPAYMENTADVICE  aa  
                            where aa.tno = a.tno
                        );
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from salaryvoucherdetail a
                        where not exists (
                            select 1 from salaryvoucher  aa  
                            where aa.tno = a.tno
                        );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P684_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
        execution {
            sequence: 100
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.PRINTPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.PRINTPRIVILEGE= 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-save-button-for-updateprivillege (
        name: DISABLE SAVE BUTTON FOR UPDATEPRIVILLEGE
        execution {
            sequence: 80
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1 FROM MODULEFLOW A , MODULEFLOWUSER B , bossuser C
                    WHERE A.TNO = B.TNO
                    AND A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                    AND B.BOSSUSERCODE = C.BOSSUSERCODE
                    AND C.BOSSUSERNAME = :APP_USER
                    AND B.UPDATEPRIVILEGE = 'NO'
                    UNION ALL
                    Select 1
                      From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
