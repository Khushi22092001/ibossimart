    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P670_Tno is null then
                        Select GlobalTno.NextVal into :P670_Tno From Dual;
                     end if;
                    ----
                    if :P670_ASSETSALENO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P670_LocationCode,
                					:P670_DocTypeCode,
                					NULL,
                					TO_DATE(:P670_ASSETSALEDATE, 'DD-MM-RRRR')
                				);
                        :P670_ASSETSALENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P670_LocationCode,
                                    :P670_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P670_ASSETSALEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 32615423396902105
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P670_TNO is null then
                    :P670_TNO := GlobalTNo.nextval;
                    :P670_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P670_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P670_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P670_TNO), 'Status');
                
                begin
                select TNO into :P670_VOUCHERTNO from voucher 
                        where moduletno = :P670_TNO
                          AND MODULECODE='ASSETSALE';
                exception when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32606873068887513
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P670_MODULEFLOW := 'YES';
                   else
                       :P670_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P670_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P670_ONTHETABLE := 'YES' ;
                   else
                       :P670_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32607177985888697
        }
    )

