    dynamicAction insert-into-detail (
        name: Insert Into detail
        execution {
            sequence: 140
        }
        when {
            event: click
            selectionType: button
            button: @getrecord
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from AssetSaleDetail a where a.TNo = :P670_TNo;
                    		insert into AssetSaleDetail(
                    				TNo,
                    				SNo,
                    				SerialNo,
                    				AssetTNo,
                    				AssetCode,
                    				AssetValue,
                    				ItcAvailedAmount,
                    				remainingusefullife
                    		) (select
                    				:P670_TNo,
                    				globaltno.nextval,
                    				globaltno.nextval,
                    				b.TNO,
                    				b.AssetCode,
                    				a.AssetValue / a.Quantity1 as AssetValue,
                    				b.itcavailedAmount,
                    				Round(Nvl(A.REMAININGUSEFULLIFEINMONTHS, 0) -
                                 Nvl(months_between(:P670_AssetSaleDate, a.originalpurchasedate), 0),
                                 0)
                    
                    		from  Asset a, AssetCodeDetail b
                    		where a.TNo = :P670_AssetTNo
                    				and b.TNo = :P670_AssetTNo
                    				and a.LocationCode = :P670_LocationCode
                    				and a.TNo = b.TNo
                    				and not exists(
                    						select
                    								aa.TNo
                    						from AssetSaleDetail aa
                    						where aa.AssetTNo = b.TNo
                    								and aa.AssetCode = b.AssetCode
                    				)
                    				and not exists(
                    						select
                    								aa.TNo
                    						from AssetDiscardDetail aa
                    						where aa.AssetTNo = b.TNo
                    								and aa.AssetCode = b.AssetCode
                    				)				
                    			/*	and not exists(
                    						select
                    								aa.TNo
                    						from AssetTransferFromAsset aa
                    						where aa.AssetTNo = b.TNo
                    								and aa.AssetCode = b.AssetCode
                    				)	*/							
                            );
                    ```
                itemsToSubmit: [
                    P670_TNO
                    P670_ASSETSALEDATE
                    P670_ASSETTNO
                    P670_LOCATIONCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    for vDetail
                    		in (
                    			select
                    					a.TNo,
                    					a.AssetTNo,
                    					a.AssetCode,
                    					a.assetvalue,
                    					a.remainingusefullife,
                    					a.itcavailedamount
                    			from AssetSaleDetail a						
                    			where a.TNo = :P670_TNo
                    		)
                    loop
                    		
                    			
                    			declare
                    			  titcrate 					   number;
                    			  titcavailedamount 	 number;
                    			  tremainingusefullife number;
                    			  ttoalusefullife 		 number;
                    			  
                    			  titcasperwdv				 number;
                    			  titcasperremaininglife number;
                    			  ttaxableamount				number;
                    			  
                    			  twdv									number;
                    			  tmp1									number;
                    			  tmp2									number;
                                  tmp                                   number;
                    			begin
                    				
                    					select
                    							sum(a.DepreciationAmount) into tmp1	
                    					from DepreciationDetail a
                    					where a.AssetTNo = vDetail.AssetTNo				
                    							and a.AssetCode = vDetail.AssetCode
                    					;
                    					
                    					select
                    							sum( a.DepreciatedAmount ) into tmp2
                    					from AssetCodeDetail a
                    					where a.TNo = vDetail.AssetTNo
                    							and a.AssetCode = vDetail.AssetCode
                    					;
                    
                    					Select nvl(A.REMAININGUSEFULLIFEINMONTHS,
                    		   B.REMAININGUSEFULLIFEINMONTHS) into ttoalusefullife
                    					  from AssetCodeDetail a, asset b
                    						where a.tno = b.tno 
                    						  and a.AssetCode = vDetail.AssetCode
                    						;
                    
                    						twdv := vdetail.assetvalue - nvl(tmp1,0) - nvl(tmp2,0);
                    						
                    					for vloop in (
                    				  Select Sum(f.taxrate) as taxrate
                    					From asset             a,
                    						 assetcodedetail   b,
                    						 item              c,
                    						 itemspecification d,
                    						 taxrule           e,
                    						 taxruledetail     f,
                    						 taxrulehsn        g,
                    						 PARTY             P
                    				   Where a.tno = b.tno
                    					 And a.itemcode = c.itemcode
                    					 And a.itemspecificationcode = d.itemspecificationcode
                    					 And d.hsncode = g.hsncode
                    					 And e.tno = f.tno
                    					 And g.tno = e.tno
                    					 And P.PARTYCODE = :P670_PartyCode
                    					 And b.assetcode = vDetail.AssetCode
                    					 And p.taxregistrationtypecode = e.taxregistrationtypecode
                    					 And gettransactiontypecodefor(p.partycode,
                    												   :P670_LOCATIONCODE,
                    												   Null,
                    												   '1',
                    												   :P670_ASSETSALEDATE) =
                    						 E.TRANSACTIONTYPECODE
                    				   Order By e.effectivefrom Desc                 
                    				) loop
                    			
                    			titcrate := vloop.taxrate;
                    			exit;
                    		 
                    		 end loop;
                    				 
                    			  if nvl(titcrate,0) = 0 then
                    
                    				raise_application_error(-20000,'HSN Code is Not Defined In Tax Rule, Pl. Define then Retry');
                    			  end if;
                    					 
                    					  titcasperwdv 				 := round((twdv * titcrate ) / 100 , 2 );
                    
                    					tITCASPERREMAININGLIFE :=	ROUND((vDetail.ItcAvailedAmount * vDetail.RemainingUsefulLife / ttoalusefullife ) , 2 );
                    					
                    					if nvl(titcasperwdv ,0) > nvl(tITCASPERREMAININGLIFE, 0) then
                    						tTaxableAmount 	:=	round( (nvl(titcasperwdv ,0) / titcrate) * 100 , 2) ;
                    					else
                    						tTaxableAmount 	:=	round( (nvl(tITCASPERREMAININGLIFE, 0) / titcrate) * 100 , 2) ;						 			
                    					end if;
                    	
                    				tmp := nvl(tmp1, 0) + nvl(tmp2, 0);
                    				
                    				Update AssetSaleDetail a
                    						set a.DepreciatedAmount = nvl(tmp1, 0) + nvl(tmp2,0) ,
                    								a.NetValue = a.AssetValue - ( nvl(tmp1, 0) + nvl(tmp2,0)) ,
                    								a.itcasperwdv = nvl(titcasperwdv,0),
                    								a.itcasperremaininglife = nvl(tITCASPERREMAININGLIFE,0),
                    								a.taxableamount = nvl(ttaxableamount,0)	
                    				where a.TNo = :P670_TNO
                    				  and a.assetcode = vDetail.AssetCode 
                    				;
                    		end ;
                    
                    end loop;		
                    ```
                itemsToSubmit: [
                    P670_TNO
                    P670_ASSETSALEDATE
                    P670_ASSETTNO
                    P670_LOCATIONCODE
                    P670_PARTYCODE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @asset-sale-detail
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                                 if :P670_STATUS = 'ACTIVE' then
                            
                                    CREATEPAYMENTADVICEFORPO(:P670_TNO);
                    
                                  end if;
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: P670_STATUS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P670_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

