    pageItem P670_PARTYCODE (
        type: popupLov
        label {
            label: Party A/c.
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.Partyname,
                           a.Partycode
                From Party A, Documentstatusdetail Dsd
                Where a.Tno = dsd.ModuleTno
                and dsd.DocumentStatusCode = 'ACTIVE'
                and a.PartyTypeCode='CUSTOMER'
                Order by 1
                ```
        }
        layout {
            sequence: 100
            region: @asset-sale
            slot: regionBody
            alignment: left
            startNewRow: false
