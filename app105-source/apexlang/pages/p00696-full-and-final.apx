    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P696_Tno is null then
                        Select GlobalTno.NextVal into :P696_Tno From Dual;
                     end if;
                    ----
                    if :P696_FULLANDFINALNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P696_LocationCode,
                					:P696_DocTypeCode,
                					NULL,
                					TO_DATE(:P696_FULLANDFINALDATE, 'DD-MM-RRRR')
                				);
                        :P696_FULLANDFINALNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P696_LocationCode,
                                    :P696_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P696_FULLANDFINALDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 49390696100854327
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P696_TNO is null then
                    :P696_TNO := GlobalTNo.nextval;
                    :P696_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P696_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P696_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P696_TNO), 'Status');
                
                begin
                select TNO into :P696_VOUCHERTNO from voucher 
                        where moduletno = :P696_TNO
                          AND MODULECODE='SALARYVOUCHER';
                exception when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 49333187587753933
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P696_MODULEFLOW := 'YES';
                   else
                       :P696_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P696_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P696_ONTHETABLE := 'YES' ;
                   else
                       :P696_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 49333424995755066
        }
    )

