    dynamicAction delete-detail-data (
        name: Delete detail data
        execution {
            sequence: 120
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from FULLANDFINALGUARANTOR a
                        where not exists (
                            select 1 from FULLANDFINAL  aa  
                            where aa.tno = a.tno
                        );
                        delete from FULLANDFINALOTHERDEDUCTION a
                        where not exists (
                            select 1 from FULLANDFINAL  aa  
                            where aa.tno = a.tno
                        );
                        delete from FULLANDFINALPENDINGLOAN a
                        where not exists (
                            select 1 from FULLANDFINAL  aa  
                            where aa.tno = a.tno
                        );
                        delete from FULLANDFINALPENDINGLEAVE a
                        where not exists (
                            select 1 from FULLANDFINAL  aa  
                            where aa.tno = a.tno
                        );
                        delete from FULLANDFINALUNPAIDSALARY a
                        where not exists (
                            select 1 from FULLANDFINAL  aa  
                            where aa.tno = a.tno
                        );
                        delete from FULLANDFINALDEDUCTION a
                        where not exists (
                            select 1 from FULLANDFINAL  aa  
                            where aa.tno = a.tno
                        );
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

