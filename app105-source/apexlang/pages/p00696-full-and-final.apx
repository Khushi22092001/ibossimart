    region full-and-final (
        name: Full and Final
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       DOCTYPECODE,
                       LOCATIONCODE,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       FULLANDFINALNO,
                       FULLANDFINALDATE,
                       RESIGNATIONACCEPTENCEDATE,
                       EMPLOYEECODE,
                       STATUTORYRATE,
                       EMPLOYEECONTRIBUTION,
                       MONEYTRANSFERMODECODE,
                       BANKCODE,
                       REASONOFRESIGNATION,
                       SALARYFROMDATE,
                       SALARYTODATE,
                       LEAVESALARYAMOUNT,
                       VISA,
                       GRATUITYAMOUNT,
                       BONUSAMOUNT,
                       LTAAMOUNT,
                       MEDICALAMOUNT,
                       SECURITYDEPOSITEAMOUNT,
                       GRATUITYDAYS,
                       NARRATION,
                       OTHERAMOUNT,
                       NOCDATE,
                       NOCNO,
                       ATTACHMENTFILENAME,
                       REMARK,
                       CREATOR,
                       CREATIONTIME,
                       DATEOFLEAVING,
                       NOTICEPERIODREMAININGDAYS,
                       BASICSALARY,
                       DEDUCTIONRATE,
                       DEDUCTIONAMOUNT,
                       ISGRATUITYALLOWED,
                       ISDEDUCTIONALLOWED,
                       NOTICEPERIODFROMTERMINATION,
                       EARNINGAMOUNT,
                       REFERENCEMODULE,
                       ISALLOWEDPAYMENT,
                       NETPAYABLE,
                       ISALLOWSALARY,
                       NETBASICSALARY,
                       NETGRATUITYAMOUNT,
                       LEAVEINCASH,
                       OTHER,
                       LOAN,
                       TOOL,
                       UNIFORMPERIOD,
                       OTHERDEDUCTION
                  from FULLANDFINAL
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

