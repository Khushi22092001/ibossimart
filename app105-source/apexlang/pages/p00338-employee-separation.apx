    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P338_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction populate-detail (
        name: Populate detail
        execution {
            sequence: 110
        }
        when {
            event: focusout
            selectionType: items
            items: P338_TOTALCHEQUE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        tStartNo     Number;
                        tTotalNo     NUmber;
                        i            Number;
                        J            Number;
                        tCHEQUEno Varchar2(100);
                    begin
                        if NVL(:P338_CHEQUENOSTART,0) = 0 then
                            raise_application_error(
                                        -20000,
                                        'Please Enter CHEQUE Start No'
                                    );
                         else
                             tStartNo := :P338_CHEQUENOSTART ;
                        end if;
                    
                        if NVL(:P338_TOTALCHEQUE,0) = 0 then
                            raise_application_error(
                                        -20000,
                                        'Please Enter Total CHEQUE No'
                                    );
                        else
                            tTotalNo := :P338_TOTALCHEQUE ;
                        end if;
                      /*
                      If Not
                          apex_collection.collection_exists(p_collection_name => 'CHEQUERECEIPT') Then
                        apex_collection.create_collection(p_collection_name => 'CHEQUERECEIPT');
                      Else
                        apex_collection.truncate_collection(p_collection_name => 'CHEQUERECEIPT');
                      End If;
                      ----
                      */
                      DELETE FROM CHEQUERECEIPTDETAIL
                      WHERE TNO = :P338_TNO;
                    
                      i := to_char(tStartNo, :P338_formatstring);
                      J := 0;
                      loop
                            tCHEQUENo := :P338_CHEQUENOPREFIX||TO_CHAR(I)||:P338_CHEQUENOSUFFIX ;
                    
                           /*apex_collection.add_member(p_collection_name => 'CHEQUERECEIPT',
                                                   p_N001            => :P338_TNO,
                                                   P_N002            => GLOBALTNO.NEXTVAL,
                                                   p_C001            => tCHEQUENo
                                                   ) ;
                            */ 
                            J := J+1;
                             insert into CHEQUEreceiptdetail
                             ( tno,SERIALNO,CHEQUEno)
                             values ( :P338_TNO,J,tCHEQUENo)       
                             ;
                    
                    	  i := to_char(i + 1, :P338_FORMATSTRING);
                          exit  when i > tStartNo + tTotalNo - 1;                        
                    
                    
                      end loop;
                    end ;
                    ```
                itemsToSubmit: [
                    P338_CHEQUENOPREFIX
                    P338_CHEQUENOSTART
                    P338_TOTALCHEQUE
                    P338_CHEQUENOSUFFIX
                    P338_FORMATSTRING
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P338_Tno is null then
                        Select GlobalTno.NextVal into :P338_Tno From Dual;
                     end if;
                    ----
                    if :P338_RESIGNATIONNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P338_LocationCode,
                					:P338_DocTypeCode,
                					NULL,
                					TO_DATE(:P338_RESIGNATIONDATE, 'DD-MM-RRRR')
                				);
                        :P338_RESIGNATIONNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P338_LocationCode,
                                    :P338_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P338_RESIGNATIONDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 44220206700752922
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P338_MODULEFLOW := 'YES';
                   else
                       :P338_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P338_ONTHETABLE := 'YES' ;
                   else
                       :P338_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44120927867551753
        }
    )

    process gettno (
        name: gettno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P338_TNO IS NULL then
                    :P338_FORMSTATUS := 'NEWRECORD';
                    select globaltno.nextval into :P338_TNO from dual;
                  else 
                    :P338_FORMSTATUS := 'EDITRECORD';
                end if;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44120506024551753
        }
    )

