    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P320_TNO is null then
                            :P320_FORMSTATUS := 'NEWRECORD';
                        else
                            :P320_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P320_TNO is null then
                
                        select globaltno.nextval into :P320_TNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 28202985546302215
        }
    )

    process initialize-form-footer-formula-master (
        name: Initialize form Footer Formula Master
        type: formInitialization
        formRegion: @footer-formula-master
        execution {
