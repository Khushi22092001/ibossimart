page 508 (
    name: Month x Item wise Issue (Department)
    alias: MONTH-X-ITEM-WISE-ISSUE-DEPARTMENT
    title: Month x Item wise Issue (Department)
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region report (
        name: Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.IssueNo,
                      a.IssueDate,
                      a.ItemCode,
                      e.ItemName,
                      a.Quantity1,
                      a.StockAmount
                From  BI_ISSUE a, Item e
                Where a.ItemCode = e.itemCode
                  and e.ParentCode like nvl(:P508_PARENTCODE,'%')
                  and a.DocTypeCode like nvl((Select DocTypeCode From DocType Where Tno = :P508_DOCTYPECODE),'%')
                  and a.LocationCode like nvl((Select LocationCode From Location Where Tno = :P508_LOCATIONCODE),'%')
                  and a.DepartmentCode like nvl((Select DepartmentCode From Department Where Tno = :P508_DEPARTMENT),'%')
                  and to_Char(a.IssueDate,'YYYYMM') like nvl(:P508_MONTH,'%')
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 12013033412438544
        }

        column ISSUEDATE (
            type: plainText
            heading {
                heading: Issuedate
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column ISSUENO (
            type: plainText
            heading {
                heading: Issueno
                alignment: center
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column ITEMCODE (
            type: plainText
            heading {
                heading: Itemcode
                alignment: center
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ITEMNAME (
            type: plainText
            heading {
                heading: Itemname
                alignment: center
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column QUANTITY1 (
            type: plainText
            heading {
                heading: Quantity1
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column STOCKAMOUNT (
            type: plainText
            heading {
                heading: Stockamount
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Report
        }
    )

    pageItem P508_DEPARTMENT (
        type: textField
        label {
            label: Department
            alignment: left
        }
        layout {
            sequence: 20
            region: @report
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P508_DOCTYPE (
        type: textField
        label {
            label: DocType
            alignment: left
        }
        layout {
            sequence: 50
            region: @report
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P508_LOCATION (
        type: textField
        label {
            label: Location
            alignment: left
        }
        layout {
            sequence: 40
            region: @report
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P508_MONTH (
        type: textField
        label {
            label: Month
            alignment: left
        }
        layout {
            sequence: 30
            region: @report
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P508_PARENTCODE (
        type: textField
        label {
            label: Parentcode
            alignment: left
        }
        layout {
            sequence: 10
            region: @report
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction hide-menu (
        name: Hide Menu
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
                    //$("#t_Body_nav").hide();
                    //$(this).treeView("collapse", n$)
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

