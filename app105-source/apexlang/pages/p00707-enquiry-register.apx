    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 20
            region: @enquiry-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 708
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @enquiry-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: never
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 120
            region: @enquiry-register
            slot: regionBody
            column: 10
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  if :P707_ENQUIRYNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P707_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P707_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 60363755303932054
        }
    )

)
