page 234 (
    name: User Privilege Department
    alias: USER-PRIVILEGE-DEPARTMENT
    title: User Privilege Department
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            t-Dialog--noPadding
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        height: 400
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region user-privilege-department (
        name: User Privilege Department
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.DEPARTMENTCODE,
                       a.SNO
                  from MODULEPRIVILEGEDEPARTMENT a
                 where a.TNO = :P234_TNO
                ```
            pageItemsToSubmit: P234_TNO
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                actionsMenu
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 126791934648823012
        }

        savedReport 396603 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @DEPARTMENTCODE
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column DEPARTMENTCODE (
            type: popupLov
            heading {
                heading: Department
            }
            settings {
                title: Select Department
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select departmentname d, departmentcode r
                    from department order by 1
                    ```
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: DEPARTMENTCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column SNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SNO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column TNO (
            type: hidden
            settings {
                valueProtected: false
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P234_ITNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: User Privilege Department
        }
    )

    pageItem P234_TNO (
        type: textField
        label {
            label: New
            alignment: left
        }
        layout {
            sequence: 10
            region: @user-privilege-department
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 20
            region: @user-privilege-department
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @user-privilege-department
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-privilege-department
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process closedialog (
        name: CloseDialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 68936351785256749
        }
    )

    process user-privilege-department-save-interactive-grid-data (
        name: User Privilege Department - Save Interactive Grid Data
        type: executeCode
        editableRegion: @user-privilege-department
        source {
            plsqlCode:
                ```plsql
                if :APEX$ROW_STATUS IN ( 'I','C') then
                   :TNO := :P234_TNO ;
                
                  INSERT INTO MODULEPRIVILEGEDEPARTMENT ( TNO,SNO,DEPARTMENTCODE)
                  VALUES ( :TNO,:SNO,:DEPARTMENTCODE) ;
                ELSIF  :APEX$ROW_STATUS IN ( 'U') then
                     UPDATE MODULEPRIVILEGEDEPARTMENT 
                     SET DEPARTMENTCODE = :DEPARTMENTCODE
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                ELSIF :APEX$ROW_STATUS = 'D' then
                     DELETE FROM  MODULEPRIVILEGEDEPARTMENT
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                END IF;   
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 68935855444256746
        }
    )

)

