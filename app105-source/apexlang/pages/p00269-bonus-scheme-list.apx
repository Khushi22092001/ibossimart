page 269 (
    name: Bonus Scheme List
    alias: BONUS-SCHEME-LIST
    title: Bonus Scheme List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bonus-scheme-list (
        name: Bonus Scheme List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       BONUSSCHEMECODE,
                       BONUSSCHEMENAME,
                       APPLIEDONWARD,
                       CATEGORYCODE,
                       STAFFTYPECODE,
                       ATTENDENCEVALUEMINIMUM,
                       SERVICEDAYSMINIMUM,
                       BONUSAMOUNTMAXIMUM,
                       REMARK,
                       BONUSPERCENT,
                       CREATIONTIME,
                       CREATOR
                  from BONUSSCHEME
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 270
                items: {
                    P270_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 108795278211506328
        }

        column APPLIEDONWARD (
            type: plainText
            heading {
                heading: Appliedonward
            }
            layout {
                sequence: 4
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: D
            }
        )

        column ATTENDENCEVALUEMINIMUM (
            type: plainText
            heading {
                heading: Attendencevalueminimum
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column BONUSAMOUNTMAXIMUM (
            type: plainText
            heading {
                heading: Bonusamountmaximum
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column BONUSPERCENT (
            type: plainText
            heading {
                heading: Bonuspercent
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        column BONUSSCHEMECODE (
            type: plainText
            heading {
                heading: Bonusschemecode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column BONUSSCHEMENAME (
            type: plainText
            heading {
                heading: Bonusschemename
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CATEGORYCODE (
            type: plainText
            heading {
                heading: Categorycode
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creationtime
            }
            layout {
                sequence: 12
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: L
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column SERVICEDAYSMINIMUM (
            type: plainText
            heading {
                heading: Servicedaysminimum
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column STAFFTYPECODE (
            type: plainText
            heading {
                heading: Stafftypecode
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Bonus Scheme List
        }

        savedReport 903487 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APPLIEDONWARD (
                sequence: 4
            )

            displayColumn ATTENDENCEVALUEMINIMUM (
                sequence: 7
            )

            displayColumn BONUSAMOUNTMAXIMUM (
                sequence: 9
            )

            displayColumn BONUSPERCENT (
                sequence: 11
            )

            displayColumn BONUSSCHEMECODE (
                sequence: 2
            )

            displayColumn BONUSSCHEMENAME (
                sequence: 3
            )

            displayColumn CATEGORYCODE (
                sequence: 5
            )

            displayColumn CREATIONTIME (
                sequence: 12
            )

            displayColumn CREATOR (
                sequence: 13
            )

            displayColumn REMARK (
                sequence: 10
            )

            displayColumn SERVICEDAYSMINIMUM (
                sequence: 8
            )

            displayColumn STAFFTYPECODE (
                sequence: 6
            )

            displayColumn TNO (
                sequence: 1
            )

        )

    )

    pageItem P269_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 40
            region: @bonus-scheme-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 270
                clearCache: 270
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 20
            region: @bonus-scheme-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button pdf (
        buttonName: Pdf
        label: PDF
        layout {
            sequence: 10
            region: @bonus-scheme-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

)

