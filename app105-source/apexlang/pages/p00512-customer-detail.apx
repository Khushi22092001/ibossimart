page 512 (
    name: Customer  Detail
    alias: CUSTOMER-DETAIL
    title: Customer  Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .background1{background-color: gainsboro;}
            #MYID .t-Form-label {font-weight: bold;}
            #MYID .apex-item-display-only {font-weight: normal;}
            ```
    }
    security {
        formAutoComplete: false
    }

    region customer-details (
        name: Customer Details
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--stacked
                t-Region--hiddenOverflow
                t-Form--standardPadding
                t-Form--stretchInputs
                t-Form--leftLabels
            ]
            cssClasses: background1
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
    )

    pageItem P512_CONTACTNO (
        type: displayOnly
        label {
            label: Contact No
            alignment: left
        }
        layout {
            sequence: 120
            region: @customer-details
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        security {
            encryptSessionState: false
        }
    )

