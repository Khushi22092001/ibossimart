        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    Declare
                    mysno varchar2(30);
                    Begin
                    If :SNO is null then
                        Select to_char(GlobalTNo.nextval) into mysno from dual;
                    else MYSNO := :SNO;
                    end if;
                    return mysno;
                    end;
                    ```
