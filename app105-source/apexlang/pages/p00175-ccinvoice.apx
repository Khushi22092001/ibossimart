        action update-freight-advance (
            name: "update freight advance "
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      tfrtadvancepercent number := to_number(getmyparametervalue('FREIGHTADVANCEPERCENT'));
                      tfreightadvance number;
                    
                    begin
                        tfreightadvance := ((nvl(:P175_FREIGHTRATE,0) * NVL(:P175_TOTALQUANTITY,0)) * tfrtadvancepercent) / 100 ;
                        tfreightadvance := floor(tfreightadvance/100) * 100;
                        return (tfreightadvance);
                    end;
                    ```
                itemsToSubmit: [
                    P175_FREIGHTRATE
                    P175_TOTALQUANTITY
                ]
            }
            affectedElements {
                selectionType: items
                items: P175_FREIGHTADVANCE
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

