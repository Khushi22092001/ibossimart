    region detail-footer (
        name: Detail Footer
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.SNO,
                       a.SN,
                       a.SERIALNO,
                       a.FOOTERHEADCODE,
                       a.FOOTERPERCENT,
                       a.FOOTERVALUE,
                       a.LEGENDSCODE,
                       b.includewithtaxableamount
                  from CCINVOICEDETAILFOOTER a , footerhead b
                  Where a.TNo = :P175_TNO
                    and a.sno = :P175_SNO
                    and a.footerheadcode = b.footerheadcode
                ```
            pageItemsToSubmit: [
                P175_TNO
                P175_SNO
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-nosize
            ]
            cssClasses: js-dialog-size900x400
        }
        masterDetail {
            masterRegion: @item-detail
        }
        advanced {
            htmlDomId: Detail_Footer
        }
