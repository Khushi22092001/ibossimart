    dynamicAction set-quantity (
        name: Set Quantity2
        execution {
            sequence: 670
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @item-detail
            columns: QUANTITY1
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                        mfactor number;
                    begin
                        select MULTIPLYINGFACTOR into mfactor from ITEMSPECIFICATION where ITEMSPECIFICATIONCODE = :ITEMSPECIFICATIONCODE;
                        return :QUANTITY1*mfactor;
                    exception when others then
                        null;
                    end;
                    ```
                itemsToSubmit: [
                    ITEMSPECIFICATIONCODE
                    QUANTITY1
                ]
            }
            affectedElements {
                selectionType: columns
                columns: QUANTITY2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-quantity-2 (
        name: Set Quantity1
        execution {
            sequence: 800
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @item-detail
            columns: QUANTITY2
        }
        clientSideCondition {
            type: itemColumn>value
            column: QUANTITY2
            value: 0
        }
        serverSideCondition {
            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                      NVL(:QUANTITY2,0) / NVL(A.MULTIPLYINGFACTOR,0) 
                    from itemspecification a
                    where a.itemspecificationcode = :ITEMSPECIFICATIONCODE
                      and NVL(:QUANTITY2 ,0) > 0
                      and :MEASURINGUNITNAME2 IS NOT NULL 
                    ```
                itemsToSubmit: [
                    QUANTITY2
                    ITEMSPECIFICATIONCODE
                    MEASURINGUNITNAME2
                ]
            }
            affectedElements {
                selectionType: columns
                columns: QUANTITY1
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

