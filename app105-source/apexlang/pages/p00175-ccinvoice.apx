    dynamicAction validate-stock-2 (
        name: validate stock
        execution {
            sequence: 930
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @stock-detail
            columns: QUANTITY1
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                      stockqty  number;
                      allocateqty number;
                    begin
                        allocateqty := nvl(:quantity1,0);
                         select sum(stockquantity1) - sum(nvl(usedstockquantity1,0)) into stockqty 
                         from stock where tno = :STOCKTNO;
                    
                         if nvl(stockqty,0) > allocateqty then
                              :QUANTITY1 := allocateqty ;
                         else
                              :quantity1 := stockqty ;
                              --raise_application_error ( -20000,' Stock Quantity is Less Than Allocated Quantity');
                         end if;
                    end;
                    ```
                itemsToSubmit: [
                    QUANTITY1
                    STOCKTNO
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P175_STOCKQTY1>:P175_INPUTQUANTITY then  
                        raise_application_error(-20000,'Detail Quantity not matching with entered quantity.');
                        :QUANTITY1 := 0;
                    end if;
                    ```
                itemsToSubmit: [
                    P175_STOCKQTY1
                    P175_INPUTQUANTITY
                    QUANTITY1
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Stock_Detail").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("QUANTITY1");
                    
                    var totalAmt = 0;
                    
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                    
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                      
                    });
                    
                    $s("P175_STOCKQTY1", totalAmt.toFixed(3));
                    
                    	
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: columns
                columns: QUANTITY1
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    validation check-validation-on-ccinvoicestockstoragedetail (
        name: Check Validation on CCInvoiceStockStorageDetail
        execution {
            sequence: 10
        }
        validation {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                DECLARE
                    v_detail_qty NUMBER := 0;
                    v_stock_qty  NUMBER := 0;
                BEGIN
                    IF :P175_TNO IS NOT NULL THEN
                        
                        SELECT NVL(SUM(Quantity1), 0)
                          INTO v_detail_qty
                          FROM CCInvoiceDetail
                         WHERE TNo = :P175_TNO;
                
                        SELECT NVL(SUM(Quantity1), 0)
                          INTO v_stock_qty
                          FROM CCInvoiceStockStorageDetail
                         WHERE TNo = :P175_TNO;
                
                        IF v_detail_qty <> v_stock_qty THEN
                            RETURN 'Validation Failed: Total Detail Quantity (' || v_detail_qty || 
                                   ') does not match with Total Allocated Stock Quantity (' || v_stock_qty || '). ' ||
                                   'Please make sure they are equal before saving.';
                        END IF;
                
                    END IF;
                
                    RETURN NULL; 
                EXCEPTION
                    WHEN OTHERS THEN
                        RETURN 'Error during quantity validation check: ' || SQLERRM;
                END;
                ```
        }
        serverSideCondition {
            type: never
        }
    )

