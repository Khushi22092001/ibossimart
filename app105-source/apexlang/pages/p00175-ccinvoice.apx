                    //view.setSelection(rowId, false);
                    //console.log(apex.region('Detail').getSelectedRowIds())
                    //console.log(apex.region('Detail').getViewId())
                    //grid.refresh();
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

