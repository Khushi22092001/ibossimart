    dynamicAction set-value-for-stock-required (
        name: set value for stock required
        execution {
            sequence: 1110
        }
        when {
            selectionType: items
            items: P175_LOADINGADVICETNO
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                    rtvalue varchar2(30);
                    begin
                    if :P175_LOADINGADVICETNO is not null then
                        for vloop in (
                        Select  *
                         From loadingadvice a 
                        Where A.TNO = :P175_LOADINGADVICETNO
                          and (a.ispartylocation='YES'              -- Change it to 'YES' from 'No' to enable to stock allocation for Out to Out Cases  -- Changed by Vibhor
                          OR getmyparametervalue('STOCKREQUIREDFOROUTWARD')='YES')
                        ) loop
                            rtvalue := 'YES';
                        end loop;
                    else
                        rtvalue := 'YES';
                    end if;
                    return(nvl(rtvalue,'NO'));
                    end;
                    
                    ```
                itemsToSubmit: P175_LOADINGADVICETNO
            }
            affectedElements {
                selectionType: items
                items: P175_STOCKREQUIRED
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

