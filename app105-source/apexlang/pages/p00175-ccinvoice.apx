    region terms-and-conditions (
        name: Terms And Conditions
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       TERMSANDCONDITIONHEADCODE,
                       TERMSANDCONDITION
                  from CCINVOICETAC
                  where tno = :P175_TNO
                ```
            pageItemsToSubmit: P175_TNO
        }
        layout {
            sequence: 70
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: S_TAC
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function(options) {
                    
                    var v_status = $v('P175_STATUS');
                    var v_record = $v('P175_FORMSTATUS');
                    var v_access = $v('P175_HAS_SPECIAL_ACCESS');
                    
                    var v_toolbar = apex.util.getNestedObject(options, 'toolbar');
                    if (v_toolbar) {
                        v_toolbar.actionMenu      = false;
                        v_toolbar.columnSelection = false;
                        v_toolbar.searchField     = false;
                        v_toolbar.editing         = false;
                        v_toolbar.reset           = false;
                
                        if(v_status === 'ACTIVE' && v_access === 'Y' || v_record === 'NEWRECORD'){
                            v_toolbar.save            = true;
                        }else{
                            v_toolbar.save            = false;
                        }
                    }
                
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 497154775313626352
        }

