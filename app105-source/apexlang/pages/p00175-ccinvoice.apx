    pageItem P175_MODULETNO (
        type: popupLov
        label {
            label: Module No
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.InvoiceNo,
                a.tno    
                from InvoiceForEWayBill a, Party b
                where a.PartyCode = b.PartyCode
                and a.LocationCode like nvl(:P175_LOCATIONCODE, '%')
                and a.ModuleCode = :P175_MODULECODE
                order by 1
                ```
            nullDisplayValue: -Select-
        }
        cascadingLov {
            parentItems: [
                P175_LOCATIONCODE
                P175_MODULECODE
            ]
            itemsToSubmit: [
                P175_LOCATIONCODE
                P175_MODULECODE
            ]
            parentRequired: false
