    dynamicAction set-sno-item-specification-qty (
        name: set SNO, item & specification, QTY
        execution {
            sequence: 750
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @item-detail
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SELECT :ITEMCODE, :ITEMSPECIFICATIONCODE, :QUANTITY1
                     INTO  :P175_DETAILITEMCODE, :P175_DETAILITEMSPECIFICATIONCODE, :P175_DETAILQTY1
                    FROM DUAL;
                    ```
                itemsToSubmit: [
                    ITEMCODE
                    ITEMSPECIFICATIONCODE
                    QUANTITY1
                ]
                itemsToReturn: [
                    P175_DETAILITEMCODE
                    P175_DETAILITEMSPECIFICATIONCODE
                    P175_DETAILQTY1
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
