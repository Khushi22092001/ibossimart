    dynamicAction set-advance-amount (
        name: set advance amount
        execution {
            sequence: 1000
        }
        when {
            selectionType: items
            items: P175_SALESORDERTNO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        tmp number := 0;
                    begin
                        select count(*) into tmp from CCINVOICEADJUSTEDADVANCE where tno = :P175_TNO;
                        if tmp = 0 then
                            delete from CCINVOICEADJUSTEDADVANCE where tno = :P175_TNO;
                            insert into CCINVOICEADJUSTEDADVANCE
                            (
                                TNO,
                                SNO,
                                VOUCHERTNO,
                                VOUCHERSNO,
                                ADVANCERECEIPTTNO,
                                ADVANCERECEIPTSNO,
                                GSTRATE,
                                ADJUSTEDADVANCEAMOUNT,
                                CGSTRATE,
                                SGSTRATE,
                                IGSTRATE,
                                CGSTAMOUNT,
                                SGSTAMOUNT,
                                IGSTAMOUNT
                            )
                            (select :P175_TNO , globaltno.nextval , c.vouchertno , c.vouchersno ,
                                 a.tno , a.sno , a.GSTRATE , a.AMOUNT , a.CGSTRATE , a.SGSTRATE, a.IGSTRATE, 
                                 a.CGSTAMOUNT , a.SGSTAMOUNT , a.IGSTAMOUNT 
                            from ADVANCERECEIPTDETAIL a , ADVANCERECEIPT b , ADVANCERECEIPTFORADJUSTMENT c
                            where a.tno = b.tno
                            and a.tno  = c.tno
                            and a.sno = c.sno
                            and c.BalanceAmount > 0 
                            and getdocumentstatuscode('ADVANCERECEIPT',b.tno) = 'ACTIVE'
                            and a.REFERENCEMODULETNO = :P175_SALESORDERTNO);
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    P175_TNO
                    P175_SALESORDERTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(nvl(adjustedadvanceamount,0)) from CCINVOICEADJUSTEDADVANCE 
                    where tno = :P175_TNO;
                    ```
                itemsToSubmit: P175_TNO
            }
            affectedElements {
                selectionType: items
                items: P175_ADJUSTEDADVANCEAMOUNT
            }
            execution {
                sequence: 20
