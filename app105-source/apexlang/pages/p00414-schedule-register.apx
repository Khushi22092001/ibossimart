    region schedule-register (
        name: Schedule Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.TNO,
                	a.ScheduleCODE,
                	a.ScheduleNAME,
                	b.PartyName as AccountGroupName,
                	a.Remark
                from Schedule a, Party b
                where a.AccountGroupCode = b.PartyCode(+)
                and ( :P414_COMPANY IS NULL OR instr(':'||:P414_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                
                  order by a.ScheduleName
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
