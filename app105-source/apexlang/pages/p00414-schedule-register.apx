                    ```javascript-browser
                    /*javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/materialoutregister.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P414_COMPANY.","_paramsP_LOCATION":"&P414_LOCATION.","_paramsP_FROMDATE":"&P414_FROMDATE.","_paramsP_TODATE":"&P414_TODATE.","_paramsP_DOCTYPE":"&P414_DOCTYPE.","_paramsP_LOCATION":"&P414_LOCATION.","_paramsP_ITEM":"&P414_ITEM.","_paramsP_ITEMSPECIFICATION":"&P414_ITEMSPECIFICATION.","_paramsP_TRANSPORTER":"&P414_TRANSPORTER.","_paramsP_PARTY":"&P414_PARTY.","_paramsP_VEHICLENO":"&P414_VEHICLENO."}');
