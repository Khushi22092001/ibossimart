regionTemplate iboss-standard-sub-region-with-icon-above (
    name: iBOSS Standard Sub Region with Icon Above
    templateClass: formRegion
    templateOptions {
        preset: [
            t-region--leftborder
            t-Region--scrollBody
        ]
    }
    region {
        template:
            ```html
            <div class="t-Region #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_LANDMARK_ATTRIBUTES# #REGION_ATTRIBUTES# style="background:#f8f8f8">
             <div class="t-Region-headerIcon"  style="display:flex; align-items: center; justify-content: center;background: #f8f8f8;"><span class="t-Icon #ICON_CSS_CLASSES#"></span></div>
             <div class="t-Region-header" style="background:#f8f8f8; border-bottom:none;">
                <div class="t-Region-headerItems t-Region-headerItems--title" style="padding: 0.8rem 1.2rem; justify-content: center;">
                <div style="font-weight: lighter; font-size: large;">#TITLE#</div>
              </div>
              <div class="t-Region-headerItems t-Region-headerItems--buttons">#COPY##EDIT#<span class="js-maximizeButtonContainer"></span></div>
             </div>
             <div class="t-Region-bodyWrap">
               <div class="t-Region-buttons t-Region-buttons--top">
                <div class="t-Region-buttons-left">#PREVIOUS#</div>
                <div class="t-Region-buttons-right">#NEXT#</div>
               </div>
               <div class="t-Region-body" style="background:#f8f8f8">
                 <div class="t-Region-orderBy">#ORDER_BY_ITEM#</div>
                 #BODY#
                 #SUB_REGIONS#
               </div>
               <div class="t-Region-buttons t-Region-buttons--bottom">
                <div class="t-Region-buttons-left">#CLOSE##HELP#</div>
                <div class="t-Region-buttons-right">#DELETE##CHANGE##CREATE#</div>
               </div>
             </div>
            </div>
            
            ```
    }
    accessibility {
        landmarkType: region
    }
    advanced {
        identifier: IBOSS_SUB_REGION_WITH_ICON_ABOVE
    }

    slot change (
        name: Change
        staticId: CHANGE
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot close (
        name: Close
        staticId: CLOSE
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot copy (
        name: Copy
        staticId: COPY
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot create (
        name: Create
        staticId: CREATE
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot delete (
        name: Delete
        staticId: DELETE
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot edit (
        name: Edit
        staticId: EDIT
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot help (
        name: Help
        staticId: HELP
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot next (
        name: Next
        staticId: NEXT
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot previous (
        name: Previous
        staticId: PREVIOUS
        supports {
            regions: false
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot regionBody (
        name: Region Body
        staticId: BODY
        supports {
            items: true
            buttons: true
        }
        gridLayout {
            maxFixedColumns: 12
        }
    )

    slot sortOrder (
        name: Sort Order
        staticId: ORDER_BY_ITEM
        supports {
            regions: false
            items: true
            buttons: true
        }
        gridLayout {
            gridSupport: false
        }
    )

    slot subRegions (
        name: Sub Regions
        staticId: SUB_REGIONS
        gridLayout {
            maxFixedColumns: 12
        }
    )

)

