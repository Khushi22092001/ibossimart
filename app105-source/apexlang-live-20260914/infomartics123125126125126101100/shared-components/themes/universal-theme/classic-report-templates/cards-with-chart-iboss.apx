classicReportTemplate cards-with-chart-iboss (
    name: Cards with Chart iBoss
    templateClass: custom1
    type: namedColumn
    reportTemplate {
        top: <ul class="t-Cards #COMPONENT_CSS_CLASSES#" #REPORT_ATTRIBUTES# id="#REGION_STATIC_ID#_cards" data-region-id="#REGION_STATIC_ID#">
        bottom:
            ```html
            </ul>
            <table class="t-Report-pagination" role="presentation">#PAGINATION#</table>
            ```
    }
    rowTemplate1 {
        template:
            ```html
            <li class="i-Cards-item #CARD_MODIFIERS#">
              <div class="i-Card" style="background-color: #BACKGROUND_COLOR#; border: 2px solid #BORDER_COLOR#;">
                <a href="#CARD_LINK#" class="i-Card-wrap">
                  <div class="i-Card-titleWrap">
                    <h3 class="i-Card-title" style="color: #TEXT_COLOR#;">#CARD_TITLE#</h3>
                    <span class="i-Icon fa #CARD_ICON#" style="color: #TEXT_COLOR#;"></span>
                  </div>
                  <div class="i-Card-body">
                    <div class="i-Card-desc" style="color: #TEXT_COLOR#;"><span id="iboss-card-pre-text">#CARD_PRE_TEXT#</span>#CARD_TEXT#<span id="iboss-card-post-text">#CARD_POST_TEXT#</span></div>
                    
                    <div class="i-Card-chartContainer">
                      <canvas class="kpi-sparkline" 
                              data-chart-type="#CHART_TYPE#" 
                              data-chart-values="#CHART_DATA#" 
                              data-chart-labels="#CHART_LABELS#"
                              data-chart-color="#TEXT_COLOR#">
                      </canvas>
                    </div>
            
                    <div class="i-Card-info" style="color: #TREND_COLOR#; background-color: #BORDER_COLOR#; font-weight: bold; display: flex; align-items: center; gap: 5px;">
                      <span class="fa #TREND_ICON#"></span>
                      <span>#CARD_SUBTEXT#</span>
                    </div>
                  </div>
                </a>
              </div>
            </li>
            ```
        conditionType: plsqlExpression
        plsqlExpression: :CARD_LINK is not null
    }
    rowTemplate2 {
        template:
            ```html
            <li class="i-Cards-item #CARD_MODIFIERS#">
              <div class="i-Card" style="background-color: #BACKGROUND_COLOR#; border: 2px solid #BORDER_COLOR#;">
                <a href="#CARD_LINK#" class="i-Card-wrap">
                  <div class="i-Card-titleWrap">
                    <h3 class="i-Card-title" style="color: #TEXT_COLOR#;">#CARD_TITLE#</h3>
                    <span class="i-Icon fa #CARD_ICON#" style="color: #TEXT_COLOR#;"></span>
                  </div>
                  <div class="i-Card-body">
                    <div class="i-Card-desc" style="color: #TEXT_COLOR#;"><span id="iboss-card-pre-text">#CARD_PRE_TEXT#</span>#CARD_TEXT#<span id="iboss-card-post-text">#CARD_POST_TEXT#</span></div>
                    
                    <div class="i-Card-chartContainer">
                      <canvas class="kpi-sparkline" 
                              data-chart-type="#CHART_TYPE#" 
                              data-chart-values="#CHART_DATA#" 
                              data-chart-labels="#CHART_LABELS#"
                              data-chart-color="#TEXT_COLOR#">
                      </canvas>
                    </div>
            
                    <div class="i-Card-info" style="color: #TREND_COLOR#; background-color: #BORDER_COLOR#; font-weight: bold; display: flex; align-items: center; gap: 5px;">
                      <span class="fa #TREND_ICON#"></span>
                      <span>#CARD_SUBTEXT#</span>
                    </div>
                  </div>
                </a>
              </div>
            </li>
            ```
    }
    pagination {
        template: <span class="t-Report-paginationText">#TEXT#</span>
        nextPage:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">
              #PAGINATION_NEXT#<span class="a-Icon icon-right-arrow" aria-hidden="true"></span>
            </a>
            ```
        previousPage:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">
              <span class="a-Icon icon-left-arrow" aria-hidden="true"></span>#PAGINATION_PREVIOUS#
            </a>
            ```
        nextSet:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">
              #PAGINATION_NEXT_SET#<span class="a-Icon icon-right-arrow" aria-hidden="true"></span>
            </a>
            ```
        previousSet:
            ```html
            <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">
              <span class="a-Icon icon-left-arrow" aria-hidden="true"></span>#PAGINATION_PREVIOUS_SET#
            </a>
            ```
    }
    advanced {
        identifier: CARDS_WITH_CHART_IBOSS
    }

    templateOption disable-chart-view (
        name: Disable Chart View
        sequence: 2
        appearance {
            cssClasses: iboss-disable-chart
        }
        help {
            helpText: Disable the Chart view within the card
        }
        advanced {
            identifier: DISABLE_CHART_VIEW
        }
    )

    templateOption disable-icon (
        name: Disable Icon
        sequence: 3
        appearance {
            cssClasses: iboss-disable-icon
        }
        advanced {
            identifier: DISABLE_ICON
        }
    )

    templateOption disable-post-text (
        name: Disable Post Text
        sequence: 4
        appearance {
            cssClasses: iboss-disable-post-text
        }
        advanced {
            identifier: DISABLE_POST_TEXT
        }
    )

    templateOption disable-trends-style (
        name: Disable Trends Style
        sequence: 1
        appearance {
            cssClasses: iboss-disable-trends
        }
        advanced {
            identifier: DISABLE_TRENDS_STYLE
        }
    )

)

