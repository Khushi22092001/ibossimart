componentSetting (
    type: dynamicAction
    name: showAiAssistant
)

componentSetting (
    type: dynamicAction
    name: plugin/ucNotifications
    settings {
        options: [
            escapeHtml
            newestOnTop
            performClientSideSubstitutions
            dismissOnNotificationClickTap
            dismissOnCloseButtonClick
            autodismissInfoNotifications
            preventDuplicates
            autodismissSuccessNotifications
        ]
        autodismissAfter: 10
    }
)

componentSetting (
    type: item
    name: colorPicker
)

componentSetting (
    type: item
    name: datePicker
    settings {
        appearanceBehavior: [
            monthPicker
            yearPicker
            showTodayButton
        ]
    }
)

componentSetting (
    type: item
    name: geocodedAddress
    settings {
        mapPreview: [
            resultsPopup
            item
        ]
    }
)

componentSetting (
    type: item
    name: selectMany
)

componentSetting (
    type: item
    name: checkbox
    settings {
        uncheckedValue: N
    }
)

componentSetting (
    type: item
    name: starRating
    settings {
        tooltip: #VALUE#
    }
)

componentSetting (
    type: item
    name: switch
    settings {
        onValue: Y
    }
)

componentSetting (
    type: item
    name: plugin/unitedCodesDateRangePicker
    settings {
        firstDay: 2
        buttonClasses: t-Button t-Button--small
        applyClass: t-Button--hot
        cancelClass: t-Cancel
    }
)

componentSetting (
    type: process
    name: serverSideGeocoding
)

componentSetting (
    type: region
    name: regionDisplaySelector
)

componentSetting (
    type: region
    name: interactiveReport
)

componentSetting (
    type: region
    name: map
)

componentSetting (
    type: region
    name: plugin/d3CollapsibleTreeChart
)

componentSetting (
    type: region
    name: plugin/dropzone2
)

componentSetting (
    type: restDataSource
    name: oracleCloudAppsSaas
)

componentSetting (
    type: restDataSource
    name: oracleCloudAppsBoss
)

