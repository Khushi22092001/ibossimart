customAttribute attribute_06 (
    apexlangName: cancelClass
    attribute: 6
    name: Cancel class
    scope: app
    appearance {
        sequence: 60
    }
    default {
        value: t-Cancel
    }
    help {
        helpText: Use this attribute to determine what classes will be applied to <code>"Cancel"</code> button.
    }
)

customAttribute attribute_06 (
    apexlangName: settings
    attribute: 6
    name: Settings
    type: checkboxes
    appearance {
        sequence: 125
    }
    help {
        helpText: This attribute allows you to configure the plugin behavior.
    }

    entry autoApply (
        sequence: 0
        display: Auto apply
        return: autoApply
        help {
            helpText:
                ```
                If checked, buttons <b>Apply</b> and <b>Cancel</b> are not displayed. 
                Selecting ending date automatically close the date range picker and insert values to proper APEX item(s).
                ```
        }
    )

    entry limitDateRange (
        sequence: 7
        display: Limit date range
        return: dateLimit
        help {
            helpText: If checked, range of dates can be limited to the given number of days. The value must be specified as the <b>Limit date range</b> attribute.
        }
    )

    entry maximumDate (
        sequence: 5
        display: Maximum date
        return: setMaxDate
        help {
            helpText: If checked, maximum date must be specified as the <b>Maximum date</b> attribute.
        }
    )

    entry minimumDate (
        sequence: 1
        display: Minimum date
        return: setMinDate
        help {
            helpText: If checked, minimum date must be specified as the <b>Minimum date</b> attribute.
        }
    )

    entry quickPickS (
        sequence: 10
        display: Quick pick(s)
        return: ranges
        help {
            helpText: If checked, the plugin will use predefined ranges of dates. Ranges can be defined in <b>Quick pick(s)</b> attribute.
        }
    )

)

customAttribute attribute_07 (
    apexlangName: displayOptions
    attribute: 7
    name: Display options
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 109
    }
    default {
        value: DR
    }
    help {
        helpText:
            ```
            Picked option defines preferred position of the calendar(s) in relation to the APEX item. <br/><br/>
            <b>Preferred</b> means that if there is no space for calendar(s) (above / below or left / right to the APEX item), the plugin will try to fit calendar(s) to the current position and available space. If the plugin can't find the position (allowing all elements to be in-line), the plugin displays elements in one column one by one.
            ```
    }

    entry downCenter (
        sequence: 50
        display: Down center
        return: DC
    )

    entry downLeft (
        sequence: 40
        display: Down left
        return: DL
    )

    entry downRight (
        sequence: 60
        display: Down right
        return: DR
    )

    entry upCenter (
        sequence: 20
        display: Up center
        return: UC
    )

    entry upLeft (
        sequence: 10
        display: Up left
        return: UL
    )

    entry upRight (
        sequence: 30
        display: Up right
        return: UR
    )

)

customAttribute attribute_08 (
    apexlangName: limitDateRange
    attribute: 8
    name: Limit date range
    type: number
    validation {
        required: true
    }
    appearance {
        sequence: 130
    }
    default {
        value: 7
    }
    dependingOn {
        attribute: @attribute_06/component
        conditionType: inList
        list: dateLimit
    }
    help {
        helpText: If checked, maximum number of days in range is limited to given number. Narrowing range starts after picking first date.
    }
)

customAttribute attribute_09 (
    apexlangName: quickPickS
    attribute: 9
    name: Quick pick(s)
    type: textarea
    appearance {
        sequence: 290
    }
    default {
        value:
            ```
            {
             'Custom': true,
             'Today': [moment(), moment()],
             'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
             'Last 7 Days': [moment().subtract(6, 'days'), moment()],
             'Last 30 Days': [moment().subtract(29, 'days'), moment()],
             'This Month': [moment().startOf('month'), moment().endOf('month')],
             'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
            }
            ```
    }
    dependingOn {
        attribute: @attribute_06/component
        conditionType: inList
        list: ranges
    }
    help {
        helpText:
            ```
            <p>
            Quick pick(s) are defined as JSON object. 
            JSON object keys represent available quick pick labels displayed to the user. 
            Each key is defined as <code>Array</code> with two elements - <code>"start"</code> and <code>"end"</code> of a predefined range. 
            <code>"Start"</code> and <code>"end"</code> date are instances of Moment.js JavaScript library. 
            </p>
            <p>
            To learn more about Moment.js visit its home page - http://momentjs.com/ .
            </p>
            
            <h4>About "Custom range"</h4>
            <p>
            "Custom range" allows user to pick his own range of dates when quick picks are displayed without calendar(s). Showing "Custom range" label is possible when JSON object key <code>"Custom"</code> has value set to <code>"true"</code>. 
            </p>
            
            <h4>"Custom range" with custom text</h4>
            <p>
            To change "Custom range" label text it is needed to add new text message <code>PRETIUS_DATERANGEPICKER_CUSTOM_RANGE</code> to APEX translations ("Shared components > Globalization > Text Messages")
            </p>
            ```
    }
    examples {
        examples:
            ```
            <h4>Default value</h4>
            <pre>{ 
              'Custom': true,
              'Today': [
                moment(), 
                moment()
              ],
              'Yesterday': [
                moment().subtract(1, 'days'), 
                moment().subtract(1, 'days')
              ],
              'Last 7 Days': [
                moment().subtract(6, 'days'), 
                moment()
              ],
              'Last 30 Days': [
                moment().subtract(29, 'days'), 
                moment()
              ],
              'This Month': [
                moment().startOf('month'), 
                moment().endOf('month')
              ],
              'Last Month': [
                moment().subtract(1, 'month').startOf('month'), 
                moment().subtract(1, 'month').endOf('month')
              ]
            }</pre>
            <h4>Tommorow</h4>
            <pre>{  
              'Tommorow': [
                 moment().add(1, 'day').startOf('day'), 
                 moment().add(1, 'day').endOf('day')
              ]
            }</pre>
            
            <h4>Next month</h4>
            <pre>{  
              'Next Month': [
                 moment().add(1, 'month').startOf('month'), 
                 moment().add(1, 'month').endOf('month')
              ]
            }</pre>
            <p>
              Read <code>Moment.js</code> docs to learn more about manipulating dates - http://momentjs.com/docs/#/manipulating/ .
            </p>
            ```
    }
)

customAttribute attribute_10 (
    apexlangName: appearance
    attribute: 10
    name: Appearance
    type: checkboxes
    appearance {
        sequence: 127
    }
    help {
        helpText: This attribute allows you to configure the plugin appearance.
    }

    entry isoWeekNumbers (
        sequence: 80
        display: ISO week numbers
        return: showISOWeekNumbers
        help {
            helpText:
                ```
                If checked, ISO week numbers rendered as first column in calendar(s).<br/><br/>
                Requires <b>Show week numbers</b> to be unchecked.
                ```
        }
    )

    entry linkCalendars (
        sequence: 30
        display: Link calendars
        return: linkedCalendars
        help {
            helpText: If checked, months are rendered one after the other. Using navigation arrows results in presenting consecutive months.
        }
    )

    entry quickPickSWithoutCalendar (
        sequence: 10
        display: Quick pick(s) without calendar
        return: alwaysShowCalendars
        help {
            helpText:
                ```
                If checked, only quick pick(s) will be displayed after focusing the plugin item. <br/><br/>
                
                Exceptions:
                <ul>
                <li>Clicking on <b>Custom</b> quick pick results in showing calendars.</li>
                </ul>
                ```
        }
    )

    entry showCalendarInputs (
        sequence: 50
        display: Show calendar inputs
        return: hideCalendarDateInputs
        help {
            helpText:
                ```
                If checked, inputs for date and timpepicker* are displayed.<br/><br/>
                
                *Timepicker is rendered when "HH12" or "HH24" is used in date format. "MI", "SS" and "PM/AM" formats are supported also
                ```
        }
    )

    entry showDaysOfOtherMonths (
        sequence: 40
        display: Show days of other months
        return: hideOtherMonthDays
        help {
            helpText: If checked, starting/ending days of next/previous month are rendered in calendar(s).
        }
    )

    entry showMonthAsDropdown (
        sequence: 60
        display: Show month as dropdown
        return: showDropdowns
        help {
            helpText: If checked, month and year names are rendered as select lists. Selecting month or year results in jumping to the selected month / year.
        }
    )

    entry showWeekNumbers (
        sequence: 70
        display: Show week numbers
        return: showWeekNumbers
        help {
            helpText: If checked, week numbers are rendered as first column in calendar(s).
        }
    )

    entry singleCalendar (
        sequence: 20
        display: Single calendar
        return: onlyOneCalendar
        help {
            helpText: If checked, only one month (calendar) is displayed.
        }
    )

)

customAttribute attribute_14 (
    apexlangName: dateToItem
    attribute: 14
    name: Date to item
    type: pageItem
    validation {
        required: true
    }
    appearance {
        sequence: 14
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: inList
        list: [
            PDP
            PDPA
        ]
    }
    help {
        helpText:
            ```
            <p>
            Pick or enter name of the APEX item that will store ending date of the selected range.
            </p> 
            <p>
            Provided APEX item must be declared with <code>"Type"</code> set to <code>"Text field"</code>.
            </p>
            ```
    }
)

customAttribute attribute_15 (
    apexlangName: show
    attribute: 15
    name: Show
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 103
    }
    default {
        value: onIconClick
    }
    help {
        helpText: Select when the date picker pop-up calendar displays.
    }

    entry both (
        sequence: 30
        display: Both
        return: both
        help {
            helpText: The calendar pop-up displays as soon as the item receives focus and subsequently when the icon is clicked.
        }
        advanced {
            quickPick: true
        }
    )

    entry onFocus (
        sequence: 10
        display: On focus
        return: onFocus
        help {
            helpText: The calendar pop-up displays as soon as the item receives focus.
        }
        advanced {
            quickPick: true
        }
    )

    entry onIconClick (
        sequence: 20
        display: On icon click
        return: onIconClick
        help {
            helpText: The calendar pop-up displays when the icon is clicked.
        }
        advanced {
            quickPick: true
        }
    )

)

