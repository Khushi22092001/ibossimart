dataLoadDefinition accountopening (
    name: ACCOUNTOPENING
    target {
        tableName: ACCOUNTOPENING_DUMP
    }
    dataProfile {
        name: ACCOUNTOPENING
        format: xlsx
    }
    advanced {
        encoding: utf-8
        defaultXlsxSheetName: sheet1.xml
    }

    dataProfileColumn accountcode (
        columnName: ACCOUNTCODE
        source {
            sequence: 4
            dataType: varchar2
            maxLength: 30
        }
        parsing {
            selector: ACCOUNTCODE
        }
    )

    dataProfileColumn billamount (
        columnName: BILLAMOUNT
        source {
            sequence: 8
            dataType: number
        }
        parsing {
            selector: BILLAMOUNT
        }
    )

    dataProfileColumn billdate (
        columnName: BILLDATE
        source {
            sequence: 7
            dataType: date
        }
        parsing {
            selector: BILLDATE
            hasTimeZone: false
        }
    )

    dataProfileColumn billduedate (
        columnName: BILLDUEDATE
        source {
            sequence: 10
            dataType: date
        }
        parsing {
            selector: BILLDUEDATE
            hasTimeZone: false
        }
    )

    dataProfileColumn billno (
        columnName: BILLNO
        source {
            sequence: 6
            dataType: varchar2
            maxLength: 30
        }
        parsing {
            selector: BILLNO
        }
    )

    dataProfileColumn companycode (
        columnName: COMPANYCODE
        source {
            sequence: 1
            dataType: varchar2
            maxLength: 30
        }
        parsing {
            selector: COMPANYCODE
        }
    )

    dataProfileColumn financialyearcode (
        columnName: FINANCIALYEARCODE
        source {
            sequence: 2
            dataType: varchar2
            maxLength: 30
        }
        parsing {
            selector: FINANCIALYEARCODE
        }
    )

    dataProfileColumn locationcode (
        columnName: LOCATIONCODE
        source {
            sequence: 3
            dataType: varchar2
            maxLength: 30
        }
        parsing {
            selector: LOCATIONCODE
        }
    )

    dataProfileColumn openingamount (
        columnName: OPENINGAMOUNT
        source {
            sequence: 5
            dataType: number
        }
        parsing {
            selector: OPENINGAMOUNT
        }
    )

    dataProfileColumn remark (
        columnName: REMARK
        source {
            sequence: 9
            dataType: varchar2
            maxLength: 100
        }
        parsing {
            selector: REMARK
        }
    )

)

