    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @employee-separation
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
