page 337 (
    name: Employee Separation List
    alias: EMPLOYEE-SEPARATION-LIST
    title: Employee Separation List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employee-separation (
        name: Employee Separation
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                            a.TNO,
                            a.RESIGNATIONDATE,
                            a.RESIGNATIONACCEPTENCEDATE,
                            GETLOCATIONNAME(A.LOCATIONCODE) AS Location,
                            getdoctypename(a.DocTypecode) as DocType,
                            a.REASONOFRESIGNATION,
                            a.RESIGNATIONNO,
                            b.employeename,
                            b.EmployeeId
                 from 
                             Resignation a, employee b
                where    a.employeecode = b.employeecode
                and a.FinancialYearcode = :global_FinancialYearCode
                  
                  
                      -- filter
                  and ( :P337_FROMDATE is null OR (a.resignationdate between :P337_FROMDATE and :P337_TODATE))
                  and (:P337_COMPANY is null  OR (instr(':'||:P337_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  and (:P337_LOCATION is null OR (instr(':'||:P337_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and (:P337_DOCTYPE is null  OR (instr(':'||:P337_DOCTYPE||':',':'||a.DocTypeCode||':') > 0))
                  and (:P337_EMPLOYEE is null  OR (instr(':'||:P337_EMPLOYEE||':',':'||a.EMPLOYEECODE||':') > 0))
                 
                Order by 
                         b.employeename, a.Resignationdate
                ```
            pageItemsToSubmit: [
                P337_COMPANY
                P337_LOCATION
                P337_FROMDATE
                P337_TODATE
                P337_DOCTYPE
                P337_EMPLOYEE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 338
                items: {
                    P338_TNO: \#TNO#\
                }
                clearCache: 336
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 204007130474441951
        }

        column DOCTYPE (
            type: plainText
            heading {
                heading: Doctype
            }
            layout {
                sequence: 130
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AM
            }
        )

        column EMPLOYEEID (
            type: plainText
            heading {
                heading: Employee ID
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AD
            }
        )

        column EMPLOYEENAME (
            type: plainText
            heading {
                heading: Employee Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AB
            }
        )

        column LOCATION (
            type: plainText
            heading {
                heading: Location
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AL
            }
        )

        column REASONOFRESIGNATION (
            type: plainText
            heading {
                heading: Reasonofresignation
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AJ
            }
        )

        column RESIGNATIONACCEPTENCEDATE (
            type: plainText
            heading {
                heading: Separation Acceptence Date
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AG
            }
        )

        column RESIGNATIONDATE (
            type: plainText
            heading {
                heading: Separation Date
            }
            layout {
                sequence: 70
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: AF
            }
        )

        column RESIGNATIONNO (
            type: plainText
            heading {
                heading: Separation No
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AK
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cheque Receipt List
        }

        savedReport 321406 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn EMPLOYEEID (
                sequence: 2
            )

            displayColumn EMPLOYEENAME (
                sequence: 1
            )

        )

    )

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent15
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P337_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @filter
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P337_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'PFCHALLAN'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P337_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.DocTypeName d,
                a.DocTypeCode r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c
                where a.DocTypeCode = b.DocTypeCode
                and b.tno = c.tno
                and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                and (
                     not exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and aa.CompanyCode = :global_CompanyCode
                     )
                     or
                     exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and bb.DocTypeCode = a.DocTypeCode
                             and aa.CompanyCode = :global_CompanyCode
                     )
                )
                order by a.DocTypeName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P337_COMPANY
            itemsToSubmit: P337_DOCTYPE
        }
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Doc Type Name
        }
    )

    pageItem P337_EMPLOYEE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Employee
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.EmployeeName d,
                a.EmployeeCode r
                from Employee a
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P337_COMPANY
            itemsToSubmit: P337_DOCTYPE
        }
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Employee Name
        }
    )

    pageItem P337_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)-7
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P337_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.LocationName d,
                	a.LocationCode r
                From Location a, ModuleLocationDetail b , ModuleLocation c
                Where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                	and c.CompanyCode = :GLOBAL_COMPANYCODE
                	and (
                		not exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                		or
                		exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and bb.LocationCode = a.LocationCode
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                	)
                Order by a.LocationName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Location Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P337_TNO (
        type: hidden
        settings {
