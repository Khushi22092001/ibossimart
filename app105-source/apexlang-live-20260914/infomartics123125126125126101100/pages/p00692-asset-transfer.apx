    dynamicAction insert-into-detail (
        name: insert into detail
        execution {
            sequence: 140
        }
        when {
            event: click
            selectionType: button
            button: @setcode
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    		startno number := :P692_Assetcodestartno;
                    		i number := 1;
                    		pAssetCode varchar2(30);
                    begin
                    		--go_block('CODEBLOCK');
                    		--first_record;
                            --raise_application_error(-20000 , :P692_ASSETCODESTARTNO);
                    
                            if :P692_ASSETCODESTARTNO is not null then
                    
                                delete from assettransferdetail where tno = :P692_TNO;
                        		loop						
                        				if :P692_AssetCodePrefix is null then
                        						pAssetCode := to_char(startno);
                        				else
                        						pAssetCode := :P692_AssetCodePrefix || '/' || to_char(startno);
                        				end if;
                    
                                        --raise_application_error(-20000 , pAssetCode);
                        				
                        				insert into assettransferdetail 
                        				(
                        					tno,
                        					sno,
                        					AssetCode,
                        					AssetValue,
                        					DepreciatedAmount,
                                            netvalue,
                        					SerialNO
                        				)
                        				values
                        				(
                        					:P692_TNO,
                        					globaltno.nextval,
                        					pAssetCode,
                        					round(:P692_AssetValue / :P692_Quantity1, 2),
                        					round( :P692_DepreciatedAmount / :P692_Quantity1, 2 ),
                                            round(:P692_AssetValue / :P692_Quantity1, 2) - 
                                            round( :P692_DepreciatedAmount / :P692_Quantity1, 2 ),
                        					i
                        				);
                                        
                        				if (i = :P692_Quantity1) then 
                        					exit;
                        				end if;
                        				startno := startno + 1;
                        				i := i + 1;
                        				
                        				
                        				
                        				
                        		end loop;
                            end if;
                    		
                    end;
                    ```
                itemsToSubmit: [
                    P692_ASSETCODESTARTNO
                    P692_TNO
                    P692_ASSETCODEPREFIX
                    P692_ASSETVALUE
                    P692_QUANTITY1
                    P692_DEPRECIATEDAMOUNT
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

