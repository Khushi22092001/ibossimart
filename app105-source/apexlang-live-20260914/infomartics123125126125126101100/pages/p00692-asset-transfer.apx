        column ASSETCODE (
            type: popupLov
            heading {
                heading: Assetcode
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                    
                    	b.AssetCode d,
                    	b.sno r 
                    from Asset a, AssetCodeDetail b, Party c, WorkCentre d
                    where a.TNo = b.TNo
                    	and a.AccountCode = c.PartyCode
                        and a.itemcode = :P692_ITEMCODE
                    	and a.WorkCentreCode = d.WorkCentreCode(+)
                    	and a.AssetDate <= :P692_AssetTransferDate
                    	and not exists(
                    		select
                    			aa.tno
                    		from AssetSaleDetail aa
                    		where aa.AssetCode = b.AssetCode
                    			and aa.AssetTNo = b.TNo
                    	)
                    	and not exists(
                    		select
                    			aa.tno
                    		from AssetDiscardDetail aa
                    		where aa.AssetCode = b.AssetCode
                    			and aa.AssetTNo = b.TNo
                    	)	
                    	and not exists(
                    		select
                    			aa.tno
                    		from AssetTransferFromAsset aa
                    		where aa.AssetCode = b.AssetCode
                    			and aa.AssetTNo = b.TNo
                    	)	
                    order by b.AssetCode
                    
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    P692_ASSETTRANSFERDATE
                    P692_ITEMCODE
                ]
                parentRequired: false
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ASSETCODE
                dataType: varchar2
            }
        )

        column ASSETSNO (
            type: popupLov
            heading {
                heading: Asset Code
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                    
                    	b.AssetCode d,
                    	b.sno r 
                    from Asset a, AssetCodeDetail b, Party c, WorkCentre d
                    where a.TNo = b.TNo
                    	and a.AccountCode = c.PartyCode
                        and a.itemcode = :P692_ITEMCODE
                    	and a.WorkCentreCode = d.WorkCentreCode(+)
                    	and a.AssetDate <= :P692_AssetTransferDate
                    	and not exists(
                    		select
                    			aa.tno
                    		from AssetSaleDetail aa
                    		where aa.AssetCode = b.AssetCode
                    			and aa.AssetTNo = b.TNo
                    	)
                    	and not exists(
                    		select
                    			aa.tno
                    		from AssetDiscardDetail aa
                    		where aa.AssetCode = b.AssetCode
                    			and aa.AssetTNo = b.TNo
                    	)	
                    	/*and not exists(
                    		select
                    			aa.tno
                    		from AssetTransferFromAsset aa
                    		where aa.AssetCode = b.AssetCode
                    			and aa.AssetTNo = b.TNo
                    	)	*/
                    order by b.AssetCode
                    
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    P692_ASSETTRANSFERDATE
                    P692_ITEMCODE
                ]
                parentRequired: false
            }
            layout {
                sequence: 80
            }
            source {
                type: none
            }
        )

