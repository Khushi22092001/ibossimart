    region asset-transfer (
        name: Asset Transfer
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       ASSETTRANSFERNO,
                       ASSETTRANSFERDATE,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       REMARK,
                       CREATOR,
                       WORKCENTRECODE,
                       ACCOUNTCODE,
                       ASSETCODEPREFIX,
                       ASSETCODESTARTNO,
                       ASSETVALUE,
                       DEPRECIATEDAMOUNT,
                       NETVALUE,
                       CREATIONTIME
                  from ASSETTRANSFER
                ```
        }
        layout {
