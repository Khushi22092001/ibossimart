                jsCode:
                    ```javascript-browser
                    var model = apex.region("FROMASSET").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey1 = model.getFieldKey("ASSETVALUE");
                    var totalAmt1 = 0;
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey1], 10);
                    
                      if (!isNaN(total)) {
                        totalAmt1 += total;
                      }
                    });
                    
                    $s("P692_ASSETVALUE", totalAmt1);
                    ```
