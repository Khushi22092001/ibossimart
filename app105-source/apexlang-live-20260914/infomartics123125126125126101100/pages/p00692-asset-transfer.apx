    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P692_Tno is null then
                        Select GlobalTno.NextVal into :P692_Tno From Dual;
                     end if;
                    ----
                    if :P692_ASSETTRANSFERNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P692_LocationCode,
                					:P692_DocTypeCode,
                					NULL,
                					TO_DATE(:P692_ASSETTRANSFERDATE, 'DD-MM-RRRR')
                				);
                        :P692_ASSETTRANSFERNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P692_LocationCode,
                                    :P692_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P692_ASSETTRANSFERDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 48723053214621992
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P692_TNO is null then
                    :P692_TNO := GlobalTNo.nextval;
                    :P692_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P692_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P692_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P692_TNO), 'Status');
                
                begin
                select TNO into :P692_VOUCHERTNO from voucher 
                        where moduletno = :P692_TNO
                          AND MODULECODE='SALARYVOUCHER';
                exception when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48697651199594821
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P692_MODULEFLOW := 'YES';
                   else
                       :P692_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P692_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P692_ONTHETABLE := 'YES' ;
                   else
                       :P692_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48697972068596399
        }
    )

