page 339 (
    name: Employee Category
    alias: EMPLOYEE-CATEGORY
    title: Employee Category
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region employee-category (
        name: Employee Category
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                            a.TNO,
                            a.CategoryName,
                            a.CategoryCode,
                            a.GroupCode,
                            b.CategoryName as GroupName
                 from 
                             Category a, Category b
                where    a.GroupCode = b.CategoryCode(+)
                /*  
                  
                      -- filter
                  and ( :P339_FROMDATE is null OR (a.resignationdate between :P339_FROMDATE and :P339_TODATE))
                  and (:P339_COMPANY is null  OR (instr(':'||:P339_COMPANY||':',':'||a.CompanyCode||':') > 0))
                  and (:P339_LOCATION is null OR (instr(':'||:P339_LOCATION||':',':'||a.LocationCode||':') > 0))
                  and (:P339_DOCTYPE is null  OR (instr(':'||:P339_DOCTYPE||':',':'||a.DocTypeCode||':') > 0))
                  and (:P339_EMPLOYEE is null  OR (instr(':'||:P339_EMPLOYEE||':',':'||a.EMPLOYEECODE||':') > 0))
                 */
                Order by a.CategoryName
                ```
            pageItemsToSubmit: [
                P339_COMPANY
                P339_LOCATION
                P339_FROMDATE
                P339_TODATE
                P339_DOCTYPE
                P339_EMPLOYEE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 340
                items: {
                    P340_TNO: \#TNO#\
                }
                clearCache: 340
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 248238393966270053
        }

        column CATEGORYCODE (
            type: plainText
            heading {
                heading: Category code
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AO
            }
        )

        column CATEGORYNAME (
            type: plainText
            heading {
                heading: Category name
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AN
            }
        )

        column GROUPCODE (
            type: plainText
            heading {
                heading: Group code
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AP
            }
        )

        column GROUPNAME (
            type: plainText
            heading {
                heading: Group name
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: AQ
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Cheque Receipt List
        }

        savedReport 321406 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CATEGORYCODE (
                sequence: 1
            )

            displayColumn CATEGORYNAME (
                sequence: 2
            )

            displayColumn GROUPCODE (
                sequence: 3
            )

            displayColumn GROUPNAME (
                sequence: 4
            )

        )

    )

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent15
                t-Region--hiddenOverflow
                t-Form--slimPadding
                t-Form--stretchInputs
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: expression
            plsqlExpression: 1=2
        }
    )

    pageItem P339_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @filter
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P339_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'PFCHALLAN'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Company Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P339_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.DocTypeName d,
                a.DocTypeCode r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c
                where a.DocTypeCode = b.DocTypeCode
                and b.tno = c.tno
                and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                and (
                     not exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and aa.CompanyCode = :global_CompanyCode
                     )
                     or
                     exists(
                         select 
                             aa.TNo
                         from ModulePrivilege aa, ModulePrivilegeDocType bb, BossUser cc
                         where aa.tno = bb.tno
                             and aa.BossUserCode = cc.BossUserCode
                             and cc.LoginName = :GLOBAL_LOGINNAME
                             and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                             and bb.DocTypeCode = a.DocTypeCode
                             and aa.CompanyCode = :global_CompanyCode
                     )
                )
                order by a.DocTypeName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P339_COMPANY
            itemsToSubmit: P339_DOCTYPE
        }
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Doc Type Name
        }
    )

    pageItem P339_EMPLOYEE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.EmployeeName d,
                a.EmployeeCode r
                from Employee a
                order by 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P339_COMPANY
            itemsToSubmit: P339_DOCTYPE
        }
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Enter Employee Name
        }
    )

    pageItem P339_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)-7
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P339_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                	a.LocationName d,
                	a.LocationCode r
                From Location a, ModuleLocationDetail b , ModuleLocation c
                Where a.LocationCode = b.LocationCode
                	and b.tno = c.tno
                	and c.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                	and c.CompanyCode = :GLOBAL_COMPANYCODE
                	and (
                		not exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                		or
                		exists(
                		Select 
                			aa.TNo
                		From ModulePrivilege aa, ModulePrivilegeLocation bb, BossUser cc
                		Where aa.tno = bb.tno
                			and aa.BossUserCode = cc.BossUserCode
                			and cc.LoginName = :GLOBAL_LOGINNAME
                			and aa.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                			and bb.LocationCode = a.LocationCode
                			and aa.CompanyCode = :GLOBAL_COMPANYCODE
                		)
                	)
                Order by a.LocationName
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: Location Name
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P339_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @/title
            slot: regionBody
        }
    )

    pageItem P339_TNO_1 (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 100
            region: @filter
            slot: regionBody
        }
    )

    pageItem P339_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 50
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 15
            valuePlaceholder: To Date
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: Trunc(Sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @employee-category
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 340
                clearCache: 340
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @employee-category
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 80
            region: @filter
            slot: regionBody
            column: 7
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

