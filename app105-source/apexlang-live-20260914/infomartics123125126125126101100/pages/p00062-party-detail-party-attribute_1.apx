page 62 (
    name: Party Detail Party Attribute
    alias: PARTY-DETAIL-PARTY-ATTRIBUTE
    title: Party Detail Party Attribute
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            $('input').on('focus', function() {
            $("#"+this.id+"_LABEL").css("background-color", "yellow");
            }).on('blur', function() {
            $("#"+this.id+"_LABEL").css("background-color", "white");
            });
            
            
            
            $(document).ready(function() {
            $('input').keydown( function(e) {
                    var key = e.charCode ? e.charCode : e.keyCode ? e.keyCode : 0;
                    if(key == 13) {
                        e.preventDefault();
                        var inputs = $(this).closest('form').find(':input:visible');
                        inputs.eq( inputs.index(this)+ 1 ).focus();
                    }
                });
            });
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region attribute (
        name: "Attribute "
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ATTRIBUTECODE,
                       ATTRIBUTEVALUE,
                       REMARK,
                       TNO,
                       ATTACHMENTBLOB,
                       FILENAME,
                       SNO,
                       trunc(sysdate) as Creationdate,
                       /*CASE
                              WHEN upper(A.FILENAME) LIKE '%DOCX%' then
                               'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                              WHEN upper(A.FILENAME) LIKE '%DOC' then
                               'application/msword'
                              when UPPER(a.filename) like '%JPG' then
                               'image/jpeg'
                              when UPPER(a.filename) like '%JPEG' then
                               'image/jpeg'
                              when UPPER(a.filename) like '%PDF' then
                                'application/pdf'
                              when UPPER(a.filename) like '%TXT' then
                                'text/plain'
                              when UPPER(a.filename) like '%XLS' then
                                'application/vnd.ms-excel'
                              when UPPER(a.filename) like '%XLSX' then
                                'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                              when UPPER(a.filename) like '%PPT' then
                                'application/vnd.ms-powerpoint'
                              when UPPER(a.filename) like '%PPTX' then
                                'application/vnd.openxmlformats-officedocument.presentationml.presentation'
                              when UPPER(a.filename) like '%PNG' then
                               'image/png'
                              when UPPER(a.filename) like '%TIF%' then
                               'image/tiff'
                            end mimetype
                            */
                            mimetype
                  from PARTYATTRIBUTEDETAIL A
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
                t-Form--stretchInputs
                margin-top-none
                margin-bottom-none
                margin-left-none
                margin-right-none
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region buttons (
        name: BUTTONS
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P62_ATTACHMENTBLOB (
        type: fileUpload
        label {
            label: <b>Attachment</b>
            alignment: left
        }
        storage {
            mimeTypeColumn: MIMETYPE
            filenameColumn: FILENAME
            bobLastUpdatedColumn: CREATIONDATE
        }
        layout {
            sequence: 80
            region: @attribute
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        source {
            formRegion: @attribute
            column: ATTACHMENTBLOB
            dataType: blob
        }
    )

    pageItem P62_ATTRIBUTECODE (
        type: popupLov
        label {
            label: <b>Attribute Name</b>
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select PARTYATTRIBUTENAME D, PARTYATTRIBUTECODE From PARTYATTRIBUTE
                where getdocumentstatuscode('PARTYATTRIBUTE',TNO) = 'ACTIVE'
                ```
        }
        layout {
            sequence: 60
            region: @attribute
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @attribute
            column: ATTRIBUTECODE
            dataType: varchar2
        }
    )

    pageItem P62_ATTRIBUTEVALUE (
        type: textField
        label {
            label: <b>Attribute Value</b>
            alignment: left
        }
        layout {
            sequence: 70
            region: @attribute
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 5
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @attribute
            column: ATTRIBUTEVALUE
            dataType: varchar2
        }
    )

    pageItem P62_CREATIONDATE (
        type: hidden
        layout {
            sequence: 110
            region: @attribute
            slot: regionBody
        }
        source {
            formRegion: @attribute
            column: CREATIONDATE
            dataType: date
            queryOnly: true
        }
        sessionState {
            storage: session
        }
    )

    pageItem P62_FILENAME (
        type: hidden
        layout {
            sequence: 90
            region: @attribute
            slot: regionBody
        }
        source {
            formRegion: @attribute
            column: FILENAME
            dataType: varchar2
        }
    )

    pageItem P62_MIMETYPE (
        type: hidden
        layout {
            sequence: 100
            region: @attribute
            slot: regionBody
        }
        source {
            formRegion: @attribute
            column: MIMETYPE
            dataType: varchar2
            queryOnly: true
        }
        sessionState {
            storage: session
        }
    )

    pageItem P62_REMARK (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @attribute
            slot: regionBody
        }
        source {
            formRegion: @attribute
            column: REMARK
            dataType: varchar2
        }
    )

    pageItem P62_SNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @attribute
            slot: regionBody
        }
        source {
            formRegion: @attribute
            column: SNO
            dataType: number
            primaryKey: true
        }
        default {
            type: sequence
            sequence: GLOBALTNO
        }
    )

    pageItem P62_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @attribute
            slot: regionBody
        }
        source {
            formRegion: @attribute
            column: TNO
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 40
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Save
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P62_SNO
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P62_SNO
        }
    )

    button save (
        buttonName: SAVE
        label: Update
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P62_SNO
        }
    )

    dynamicAction cancledialog (
        name: Cancledialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 140256895280720031
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-party-detail-party-attribute (
        name: Initialize form Party Detail Party Attribute
        type: formInitialization
        formRegion: @attribute
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 140253997883720029
        }
    )

    process process-form-account-master (
        name: Process form Account Master
        type: formAutoRowProcessing
        formRegion: @attribute
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 140254333161720030
        }
    )

)

