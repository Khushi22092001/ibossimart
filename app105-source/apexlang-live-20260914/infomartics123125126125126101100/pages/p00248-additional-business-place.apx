            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: item=value
            item: P248_FORMSTATUS
            value: NEWRECORD
        }
