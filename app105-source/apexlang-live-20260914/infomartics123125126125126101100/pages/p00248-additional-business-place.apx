    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                                 if :P248_STATUS = 'ACTIVE' then
                            
                                    CREATEPAYMENTADVICEFORPO(:P248_TNO);
                    
                                  end if;
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P248_TNO
                    P248_COMPANYCODE
                    P248_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P248_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P248_SNO is null then
                    :P248_SNO := GlobalTNO.nextval;
                    :P248_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P248_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P248_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P248_SNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 77310563000788090
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P248_MODULEFLOW := 'YES';
                   else
                       :P248_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P248_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P248_ONTHETABLE := 'YES' ;
                   else
                       :P248_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 77311136555792093
        }
    )

