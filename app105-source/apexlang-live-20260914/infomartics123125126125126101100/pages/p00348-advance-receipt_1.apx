                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: ADVANCERECEIPTDETAIL
            whereClause: tno = :P348_TNO
            pageItemsToSubmit: P348_TNO
        }
        layout {
            sequence: 30
            parentRegion: @tab
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                    //Tab and Shift-Tab will skip over cells that are read-only
                    options.defaultGridViewOptions = {  
                        skipReadonlyCells: true  
                    };
                    return options;
                }
                ```
        }
