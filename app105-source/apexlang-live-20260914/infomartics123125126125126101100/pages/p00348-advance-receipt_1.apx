    pageItem P348_ACCOUNTCODE (
        type: popupLov
        label {
            label: Account  Name
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select partyname d,partycode r
                from party A
                where partytypecode IN ('BANK','CASH')
                and getdocumentstatuscode('PARTY',a.tno)='ACTIVE'
                ```
        }
        layout {
