    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action check-detail (
            name: check detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    checkdetail(getmodulecodeforpageno(:APP_PAGE_ID),:P348_TNO);
                    
                    ```
                itemsToSubmit: P348_TNO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from GRNDETAIL a
                       where not exists (
                            select 1 from GRN  aa  
                            where aa.tno = a.tno
                        );
                    
                     
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P348_CALLEDFROMPAGE').getValue();
                    var y = apex.item('P348_CALLEDFROMTNO').getValue();
                    
                    //var url = "f?p=#APP_ID#:80:#SESSION#::NO:RP,80:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#:P#2002#_TNO:#P2002_TNO#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    
                    url = url.replace("#P2002_TNO#", y);
                    //window.alert(x);
                    //window.alert(y);
                    //window.alert(url);
                    
                    
                    //call
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data-2 (
        name: Delete unsaved data_1
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from ADVANCERECEIPTDETAIL a
                       where not exists (
                            select 1 from ADVANCERECEIPT  aa  
                            where aa.tno = a.tno
                        );
                    
                     
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction disable-delete-button-for-updateprivillege (
        name: DISABLE DELETE BUTTON FOR UPDATEPRIVILLEGE
        execution {
            sequence: 110
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      tmp number;
                    begin
                         for vloop in (
                            
                            Select 1
                              From MODULEPRIVILEGE A
                             Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                               And a.bossusercode = :GLOBAL_BOSSUSERCODE
                               And a.companycode = :GLOBAL_COMPANYCODE
                               AND A.DELETEPRIVILEGE = 'NO'
                         ) loop
                               tmp := 1;
                               exit;
                         end loop;
                    
                         select count(*) into tmp from purchaseorder a where a.indenttno = :P348_TNO ;
                         if nvl(tmp,0) = 0 then
                            return false;
                         else
                            return true;
                         end if;
                    end;
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 40
            }
            serverSideCondition {
                type: item=value
                item: P348_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            execution {
                sequence: 50
            }
            serverSideCondition {
                type: never
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 30
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      tmp number;
                      tmp1 number;
                    begin
                         for vloop in (
                                   Select 1
                              From MODULEPRIVILEGE A
                             Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                               And a.bossusercode = :GLOBAL_BOSSUSERCODE
                               And a.companycode = :GLOBAL_COMPANYCODE
                               AND A.DELETEPRIVILEGE = 'YES'
                         ) loop
                               tmp1 := 1;
                               exit;
                         end loop;
                    
                         select count(*) into tmp from purchaseorder a where a.indenttno = :P348_TNO ;
