    process set-allowed-date (
        name: Set Allowed Date
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                   TSQL VARCHAR2(4000);
                   TDATE VARCHAR2(100) ;
                   date1 varchar2(30);
                BEGIN
                
                if :P348_FORMSTATUS='NEWRECORD' then
                        select
                        		trunc(sysdate) - nvl(b.AllowedBackDays, 0) as AllowedBack,
                        		trunc(sysdate) + nvl(b.AllowedForwardDays, 0) AllowedForward	
                        		--a.FreezeDate
                                INTO :P348_ALLOWEDBACK,:P348_ALLOWEDFORWARD
                        from Module a, ModulePrivilege b, BossUser c
                        where a.ModuleCode = GetModuleCodeForpageNo(:APP_PAGE_ID)
                        		and a.ModuleCode = b.ModuleCode
                        		and b.BossUsercode = c.BossUserCode
                        		and c.LoginName = :GLOBAL_LOGINNAME
                        		and b.CompanyCode = :GLOBAL_CompanyCode
                        
                        ;
                else
                    :P348_ALLOWEDBACK       := :P348_INDENTDATE ; 
                    :P348_ALLOWEDFORWARD    := :P348_INDENTDATE ;
                 end if;
                END;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 73296441035106967
        }
    )

    process update-master-table (
        name: Update Master table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tamount number;
                    ttotalamount number;
                    ttaxableamount number;
                    ttdsamount number;
                    tcgstamount number;
                    tsgstamount number;
                    tigstamount number;
                
                begin
                Select Sum(a.amount)  ,
                       Sum(a.totalamount) , 
                			 Sum(a.taxableamount) , 
                			 Sum(tdsamount) , 
                             sum(cgstamount) ,
                             sum(sgstamount) , 
                             sum(igstamount)  
                       into tamount,ttotalamount,ttaxableamount,ttdsamount,tcgstamount,tsgstamount,tigstamount
                 From advancereceiptdetail a
                Where a.tno = :P348_TNO
                ;
                
                update advancereceipt aa
                    set aa.advancereceiptamount = ttotalamount,
                        aa.cgstamount = tcgstamount,
                        aa.sgstamount = tsgstamount,
                        aa.igstamount = tigstamount,
                        aa.taxableamount=ttaxableamount,
                        aa.sumofamount = tamount,
                        aa.tdsamount = ttdsamount
                where tno = :P348_TNO;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 73303401373219429
        }
    )

