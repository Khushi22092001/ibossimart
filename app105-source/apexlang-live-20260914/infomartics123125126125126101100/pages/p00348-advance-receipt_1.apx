    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 150
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P348_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P348_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P348_TNO,:P348_STATUS);
                    
                    declare
                        tvoucher number;
                    
                    begin
                        SELECT COUNT(A.TNO) INTO tvoucher
                    	FROM voucher A
                    	WHERE A.MODULETNO = :P348_TNO ;
                    
                        if nvl(tvoucher, 0) = 0 then
                            if :P348_STATUS = 'ACTIVE' then
                            
                                PostAdvanceReceipt(:P348_TNO,TO_DATE(:P348_ADVANCERECEIPTDATE,'DD-MM-YYYY'));
                    
                            end if;
                    
                        end if;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P348_TNO
                    P348_STATUS
                    P348_ADVANCERECEIPTDATE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P348_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P348_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

