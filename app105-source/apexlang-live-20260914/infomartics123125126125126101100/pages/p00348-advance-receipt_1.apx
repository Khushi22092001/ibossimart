    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @detail
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 67508253403212113
        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P348_Tno is null then
                        Select GlobalTno.NextVal into :P348_Tno From Dual;
                     end if;
                    ----
                    if :P348_ADVANCERECEIPTNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P348_LocationCode,
                					:P348_DocTypeCode,
                					NULL,
                					TO_DATE(:P348_ADVANCERECEIPTDATE, 'DD-MM-RRRR')
                				);
                        :P348_ADVANCERECEIPTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P348_LocationCode,
                                    :P348_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P348_ADVANCERECEIPTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 67938748816815962
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P348_TNO is null then
                    :P348_TNO := GlobalTNo.nextval;
                    :P348_FORMSTATUS := 'NEWRECORD';
                else
                    :P348_FORMSTATUS := 'EDITRECORD';
                End if;
                
                :P348_STATUS := NVL(getdocumentstatuscode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P348_TNO),'STATUS');
                
                for vloop in (
                   select tno,voucherno 
                   from voucher 
                   where moduletno = :P348_TNO
                ) loop
                   :P348_VOUCHERTNO := VLOOP.TNO;
                   :P348_VOUCHERNO   := VLOOP.VOUCHERNO;
                end loop;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 73295861580105023
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P348_MODULEFLOW := 'YES';
                   else
                       :P348_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P348_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P348_ONTHETABLE := 'YES' ;
                   else
                       :P348_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 73296152190106002
        }
    )

