page 344 (
    name: Employee Loan Receipt
    alias: EMPLOYEE-LOAN-RECEIPT1
    title: Employee Loan Receipt
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region commonfields (
        name: CommonFields
        type: staticContent
        layout {
            sequence: 20
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region employee-loan-receipt (
        name: Employee Loan Receipt
        type: form
        source {
            location: localDatabase
            tableName: LOANRECEIPT
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region flow-buttons (
        name: Flow Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

