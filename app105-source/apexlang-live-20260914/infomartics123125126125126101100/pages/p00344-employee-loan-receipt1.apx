    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P344_Tno is null then
                        Select GlobalTno.NextVal into :P344_Tno From Dual;
                     end if;
                    ----
                    if :P344_LOANRECEIPTNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P344_LocationCode,
                					:P344_DocTypeCode,
                					NULL,
                					TO_DATE(:P344_LOANRECEIPTDATE, 'DD-MM-RRRR')
                				);
                        :P344_LOANRECEIPTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P344_LocationCode,
                                    :P344_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P344_LOANRECEIPTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 45622712955886139
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P344_MODULEFLOW := 'YES';
                   else
                       :P344_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P344_ONTHETABLE := 'YES' ;
                   else
                       :P344_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 45621918276886139
        }
    )

    process gettno (
        name: gettno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P344_TNO IS NULL then
                    :P344_FORMSTATUS := 'NEWRECORD';
                    select globaltno.nextval into :P344_TNO from dual;
                  else 
                    :P344_FORMSTATUS := 'EDITRECORD';
                end if;
                
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 45621508539886138
        }
    )

