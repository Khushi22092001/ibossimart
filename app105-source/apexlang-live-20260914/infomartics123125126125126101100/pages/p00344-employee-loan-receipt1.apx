    pageItem P344_DRACCOUNTCODE (
        type: popupLov
        label {
            label: DR Account
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName,
                a.PartyCode
                from Party a
                where a.PartyTypeCode != 'ACCOUNTGROUP'
                and getDocumentStatusCode('PARTY', A.TNO) = 'ACTIVE'
                order by a.PartyName
                ```
        }
        layout {
            sequence: 110
            region: @employee-loan-receipt
            slot: regionBody
            alignment: left
            startNewRow: false
