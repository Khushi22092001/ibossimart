    process get-doc-no (
        name: Get Doc No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'QUALIFICATIONTYPE';
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P614_QUALIFICATIONTYPECODE is null then
                            setCodeNext(tModuleCode);
                	  		:P614_QUALIFICATIONTYPECODE := getCode(tModuleCode) ;
                     end if;
                
                     if :P614_QUALIFICATIONTYPECODE is null then
                           RAISE_APPLICATION_ERROR(-20000,'Qualification type code cannot be left blank.');
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 15520994565385625
        }
    )

    process get-form-status-and-tno (
        name: Get Form Status And TNO
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                     if :P614_TNO is null then
                            :P614_FORMSTATUS := 'NEWRECORD';
                        else
                            :P614_FORMSTATUS := 'EDITRECORD';
                        end if;
                
                    if :P614_TNO is null then
                
                        select globaltno.nextval into :P614_TNO from dual;
                
                    end if; 
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15466389844307669
        }
    )

    process get-on-the-table (
        name: Get On The Table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P614_MODULEFLOW := 'YES';
                   else
                       :P614_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P614_TNO1 and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P614_ONTHETABLE := 'YES' ;
                   else
                       :P614_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 70
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 15466887962308481
        }
    )

