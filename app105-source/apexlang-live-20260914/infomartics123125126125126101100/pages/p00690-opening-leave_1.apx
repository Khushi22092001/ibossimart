                type: sqlQuery
                sqlQuery: select leavename , leavecode from leave
                displayNullValue: false
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: LEAVECODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column NUMBEROFLEAVE (
            type: numberField
