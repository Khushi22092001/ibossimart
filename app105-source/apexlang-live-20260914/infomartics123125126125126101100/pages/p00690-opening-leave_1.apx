    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P690_Tno is null then
                        Select GlobalTno.NextVal into :P690_Tno From Dual;
                     end if;
                    ----
                    if :P690_OPENINGLEAVENO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P690_LocationCode,
                					:P690_DocTypeCode,
                					NULL,
                					TO_DATE(:P690_OPENINGLEAVEDATE, 'DD-MM-RRRR')
                				);
                        :P690_OPENINGLEAVENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P690_LocationCode,
                                    :P690_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P690_OPENINGLEAVEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 46175185046151658
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P690_TNO is null then
                    :P690_TNO := GlobalTNo.nextval;
                    :P690_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P690_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P690_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P690_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 46148635316098929
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P690_MODULEFLOW := 'YES';
                   else
                       :P690_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P690_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P690_ONTHETABLE := 'YES' ;
                   else
                       :P690_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 46148963925100395
        }
    )

