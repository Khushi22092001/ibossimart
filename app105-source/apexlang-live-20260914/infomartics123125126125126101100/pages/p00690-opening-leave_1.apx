                heading: Number Of Leave
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: NUMBEROFLEAVE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column REMARK (
            type: textField
