            $('#P118_REMARK').on('keydown', function(e) {
                
                if(e.shiftKey && e.which == 9) { 
                    //shift was down when tab was pressed
                    e.preventDefault(); 
                    $(".apex-rds [href='#General']").trigger("click");
                    apex.item('P118_COMMISSIONRATE').setFocus();
                }
               else if(e.which == 9) { 
                  e.preventDefault(); 
                 // $(".apex-rds [href='#Detail']").trigger("click");
