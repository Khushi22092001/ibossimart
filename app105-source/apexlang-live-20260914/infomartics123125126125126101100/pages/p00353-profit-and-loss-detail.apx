    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P353_TNO is null then
                    :P353_TNO := GlobalTNo.nextval;
                    :P353_FORMSTATUS := 'NEWRECORD';
                
                  
                else
                    :P353_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P353_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P353_TNO), 'Status');
                
                --:P353_PREVIOUSDATE := ADD_MONTHS(:P353_ASATDATE, -12);
                ```
        }
        execution {
            sequence: 80
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 75184888733025842
        }
    )

    process income-save-interactive-grid-data (
        name: Income - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @income
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 75165663458025826
        }
    )

    process intialize-ma-acceptance (
        name: intialize ma_acceptance
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  TMP NUMBER;
                BEGIN
                SELECT COUNT(*) into tmp FROM ma_acceptance A WHERE A.TNO = :p353_tno;
                if nvl(tmp,0) > 0 then
                        select 
                        TNO                 ,
                        MODULECODE,
                        MODULETNO,
                        MODULESNO,
                        ACCEPTANCE,
                        ACCEPTANCEDATE,
                        PERSONACCOUNTABLE,
                        DELIVERYDATE,
                        DESIGNATION,
                        MOBILENO,
                        EXPIRYTIME
                        into 
                        :P353_TNO_1,
                        :P353_MODULECODE,
                        :P353_MODULETNO,
                        :P353_MODULESNO,
                        :P353_ACCEPTANCE,
                        :P353_ACCEPTANCEDATE,
                        :P353_PERSONACCOUNTABLE,
                        :P353_DELIVERYDATE_1,
                        :P353_DESIGNATION,
                        :P353_MOBILENO,
                        :P353_EXPIRYTIME
                        from ma_acceptance
                        WHERE MODULETNO = :P353_TNO
                        ;
                
                    END IF;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 75184470798025840
        }
        serverSideCondition {
            type: never
        }
    )

    process prepare-url (
        name: PREPARE_URL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   result varchar2(2000);
                begin
                   result:=apex_util.prepare_url(apex_application.g_x01);
                   apex_json.open_object;
                   apex_json.write('success', true);
                   apex_json.write('url', result);
                   apex_json.close_object;
                exception
                 when others then
                   apex_json.open_object;
                   apex_json.write('success', false);
                   apex_json.write('message', sqlerrm);
                   apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 70
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 75185243278025842
        }
    )

)

