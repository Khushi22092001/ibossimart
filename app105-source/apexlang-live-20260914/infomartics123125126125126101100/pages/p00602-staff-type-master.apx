page 602 (
    name: Staff Type Master
    alias: STAFF-TYPE-MASTER
    title: Staff Type Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region flow-buttons (
        name: Flow Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: BEFORE_NAVIGATION_BAR
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region staff-type-master (
        name: Staff Type  Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       STAFFTYPECODE,
                       STAFFTYPENAME,
                       CREATOR,
                       CREATIONTIME,
                       REMARK
                  from STAFFTYPE
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P602_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 601
        }
    )

    pageItem P602_CREATIONTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @staff-type-master
            slot: regionBody
        }
        appearance {
            formatMask: DD-MON-YYYY HH:MIPM
        }
        source {
            formRegion: @staff-type-master
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MM-YYYY HH24:MI:SS') from dual
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P602_STAFFTYPENAME
        }
    )

    pageItem P602_CREATOR (
        type: hidden
        layout {
            sequence: 50
            region: @staff-type-master
            slot: regionBody
        }
        source {
            formRegion: @staff-type-master
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: item
            item: GLOBAL_LOGINNAME
        }
    )

    pageItem P602_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 210
            region: @fields
            slot: regionBody
        }
    )

    pageItem P602_MODULEFLOW (
        type: hidden
