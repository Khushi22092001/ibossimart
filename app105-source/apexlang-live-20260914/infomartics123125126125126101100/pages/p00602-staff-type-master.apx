                    if (Object.keys($v("P602_DESIGNATIONSHORTNAME")).length===0 ) {
                        showError("Designation Short Name Should Not be Empty", 'P602_DESIGNATIONSHORTNAME');
                    } else {
                        apex.message.clearErrors();
