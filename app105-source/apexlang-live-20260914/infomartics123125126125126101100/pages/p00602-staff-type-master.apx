    dynamicAction check-designation-name (
        name: Check Designation Name
        execution {
            sequence: 100
        }
        when {
            event: focusout
            selectionType: items
            items: P602_DESIGNATIONNAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P602_DESIGNATIONNAME")).length===0 ) {
                        showError("Designation Name Should Not Empty", 'P602_DESIGNATIONNAME');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

