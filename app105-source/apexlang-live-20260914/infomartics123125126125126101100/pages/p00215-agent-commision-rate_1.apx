    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P215_MODULEFLOW := 'YES';
                   else
                       :P215_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P215_ONTHETABLE := 'YES' ;
                   else
                       :P215_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 11130369250796159
        }
    )

    process gettno (
        name: gettno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P215_TNO IS NULL then
                    :P215_FORMSTATUS := 'NEWRECORD';
                    select globaltno.nextval into :P215_TNO from dual;
                  else 
                    :P215_FORMSTATUS := 'EDITRECORD';
                end if;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
