page 209 (
    name: Item Account List
    alias: ITEMACCOUNT-REPORT
    title: Item Account List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region item-account-list (
        name: Item Account List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       MODULECODE,
                       ITEMCODE,
                       ACCOUNTCODE,
                       REMARK,
                       ITEMACCOUNTCODE,
                       ITEMSPECIFICATIONCODE,
                       COMPANYCODE,
                       PARTYCODE,
                       CREATOR,
                       DESPATCHCATEGORYCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       PANDLACCOUNTCODE,
                       INCOMEACCOUNTCODE,
                       TRANSACTIONTYPECODE,
                       NATUREOFSUPPLYCODE,
                       CREATIONTIME
                  from ITEMACCOUNT
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 211
                items: {
                    P211_TNO: #TNO#
                }
                clearCache: 211
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 10136229111469805
        }

        column ACCOUNTCODE (
            type: plainText
            heading {
                heading: Account
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Company
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creationtime
            }
            layout {
                sequence: 55
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: R
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column DESPATCHCATEGORYCODE (
            type: plainText
            heading {
                heading: Dispatch Category
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DOCTYPECODE (
            type: plainText
            heading {
                heading: Doc Type
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column INCOMEACCOUNTCODE (
            type: plainText
            heading {
                heading: Income Account
            }
            layout {
                sequence: 15
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column ITEMACCOUNTCODE (
            type: plainText
            heading {
                heading: Item Account
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ITEMCODE (
            type: plainText
            heading {
                heading: Item
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ITEMSPECIFICATIONCODE (
            type: plainText
            heading {
                heading: Item Specification
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column LOCATIONCODE (
            type: plainText
            heading {
                heading: Location
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: Module
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column NATUREOFSUPPLYCODE (
            type: plainText
            heading {
                heading: Nature of Supply
            }
            layout {
                sequence: 45
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column PANDLACCOUNTCODE (
            type: plainText
            heading {
                heading: Pandl Account
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column PARTYCODE (
            type: plainText
            heading {
                heading: Party
            }
            layout {
                sequence: 9
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 65
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column TRANSACTIONTYPECODE (
            type: plainText
            heading {
                heading: Transaction Type
            }
            layout {
                sequence: 35
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Itemaccount_report
        }

        savedReport 101444 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCOUNTCODE (
                sequence: 4
            )

            displayColumn COMPANYCODE (
                sequence: 8
            )

            displayColumn CREATIONTIME (
                sequence: 18
            )

            displayColumn CREATOR (
                sequence: 10
            )

            displayColumn DESPATCHCATEGORYCODE (
                sequence: 11
            )

            displayColumn DOCTYPECODE (
                sequence: 13
            )

            displayColumn INCOMEACCOUNTCODE (
                sequence: 15
            )

            displayColumn ITEMACCOUNTCODE (
                sequence: 6
            )

            displayColumn ITEMCODE (
                sequence: 3
            )

            displayColumn ITEMSPECIFICATIONCODE (
                sequence: 7
            )

            displayColumn LOCATIONCODE (
                sequence: 12
            )

            displayColumn MODULECODE (
                sequence: 2
            )

            displayColumn NATUREOFSUPPLYCODE (
                sequence: 17
            )

            displayColumn PANDLACCOUNTCODE (
                sequence: 14
            )

            displayColumn PARTYCODE (
                sequence: 9
            )

            displayColumn REMARK (
                sequence: 5
            )

            displayColumn TNO (
                sequence: 1
            )

            displayColumn TRANSACTIONTYPECODE (
                sequence: 16
            )

        )

    )

    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 20
            region: @item-account-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 211
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @item-account-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

