page 163 (
    name: PassFailRemark
    alias: PASSFAILREMARK
    title: PassFailRemark
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 400
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region remarks (
        name: Remarks
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--hiddenOverflow
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P163_REMARK (
        type: textarea
        label {
            label: Pass Fail Note
            alignment: left
        }
        settings {
            resizable: false
            charCounter: true
        }
        layout {
            sequence: 20
            region: @remarks
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 40
            height: 3
        }
    )

    button cancel (
        buttonName: Cancel
        label: Cancel
        layout {
            sequence: 30
            region: @remarks
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button ok (
        buttonName: OK
        label: OK
        layout {
            sequence: 20
            region: @remarks
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--success
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction cancel (
        name: Cancel
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction ok (
        name: ok
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @ok
        }

        action native-dialog-close (
            action: closeDialog
            settings {
                itemsToReturn: P163_REMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

