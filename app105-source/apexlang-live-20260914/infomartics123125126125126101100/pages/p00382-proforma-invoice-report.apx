    pageItem P382_COMPANY (
        type: selectOne
        label {
            label: Company
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'PINVOICE'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                 and getcompanyprivilege(C.COMPANYCODE,GETMODULECODEFORPAGENO(:APP_PAGE_ID),:GLOBAL_LOGINNAME)='YES'
                Order by 1
                  ;
                
                ```
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: -- Select Company --
        }
    )

    pageItem P382_CONSIGNEE (
        type: selectOne
        label {
            label: Consignee
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       Distinct
                       p.PartyName d,
                       p.PartyCode r
                From pinvoice a, Party p
                Where a.ConsigneeCode = p.PartyCode
                Order by 1
                ```
        }
        layout {
            sequence: 80
            region: @filters
            slot: regionBody
            alignment: left
            labelColumnSpan: 1
        }
        appearance {
