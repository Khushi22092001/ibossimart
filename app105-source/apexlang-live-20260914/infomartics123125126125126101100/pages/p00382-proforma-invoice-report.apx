    pageItem P382_ITEM (
        type: selectMany
        label {
            label: Item
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      e.ItemName||' ( '||e.ItemCode||' )' as d,
                      e.ItemCode r
                From pinvoiceDetail a, Item e
                Where a.ItemCode = e.ItemCode
                Order by 1
                ```
        }
        layout {
            sequence: 90
            region: @filters
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: -- Select Item Name  --
        }
    )

    pageItem P382_ITEMSPECIFICATION (
        type: selectMany
        label {
            label: Itemspecification
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                     ee.ItemSpecificationName as d,
                     ee.ItemSpecificationCode as r
                From Item e, ItemSpecification ee, PInvoiceDetail p
                Where e.ItemCode = :P382_ITEM
                  and e.TNo = ee.TNo
                  and ee.ItemSpecificationCode = p.ItemSpecificationCode
                Order by 1
                ```
        }
        cascadingLov {
            parentItems: P382_ITEM
            itemsToSubmit: P382_ITEM
        }
        layout {
            sequence: 100
            region: @filters
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: -- Select Item Specification Name  --
        }
    )

    pageItem P382_LOCATION (
        type: selectOne
        label {
            label: Location
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'PINVOICE'
                  and a.ViewPrivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order By 1
                ;
                
                ```
        }
        layout {
            sequence: 20
            region: @filters
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: -- Select Location --
        }
    )

