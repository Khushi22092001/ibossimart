page 78 (
    name: Freight Type List
    alias: FREIGHT-TYPE-LIST
    title: Freight Type List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region freight-type-list (
        name: Freight Type List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.FREIGHTTYPECODE,
                       A.FREIGHTTYPENAME,
                       A.ISFREIGHTREQUIRED,
                       A.ISBILLREQUIRED,
                       A.REMARK,
                       A.DEBITPARTYACCOUNT,
                       A.MODULECODE
                  from FREIGHTTYPE A
                  Order By A.TNO Desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 79
                items: {
                    P79_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 143860326462195136
        }

        column DEBITPARTYACCOUNT (
            type: plainText
            heading {
                heading: Debit Party Account
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column FREIGHTTYPECODE (
            type: plainText
            heading {
                heading: Freight Type Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column FREIGHTTYPENAME (
            type: plainText
            heading {
                heading: Freight Type Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ISBILLREQUIRED (
            type: plainText
            heading {
                heading: Is Bill Required
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ISFREIGHTREQUIRED (
            type: plainText
            heading {
                heading: Is Freight Required
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: Module Name
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Freight Type List
        }

        savedReport 1438697 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEBITPARTYACCOUNT (
                sequence: 5
            )

            displayColumn FREIGHTTYPECODE (
                sequence: 1
            )

            displayColumn FREIGHTTYPENAME (
                sequence: 2
            )

            displayColumn ISBILLREQUIRED (
                sequence: 4
            )

            displayColumn ISFREIGHTREQUIRED (
                sequence: 3
            )

            displayColumn MODULECODE (
                sequence: 6
            )

            displayColumn REMARK (
                sequence: 7
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @freight-type-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 79
                clearCache: 79
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @freight-type-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @freight-type-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @freight-type-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @freight-type-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

