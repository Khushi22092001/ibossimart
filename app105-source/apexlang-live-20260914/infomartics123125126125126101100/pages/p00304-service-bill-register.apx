    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh (
        name: "Refresh "
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @service-bill-register-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                begin
                  if :P304_PBNO IS NOT NULL THEN
                      SELECT X.FINANCIALYEARBEGIN INTO :P304_FROMDATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                      SELECT X.FINANCIALYEAREND INTO :P304_TODATE FROM FINANCIALYEAR X WHERE TRUNC(SYSDATE) BETWEEN X.FINANCIALYEARBEGIN AND X.FINANCIALYEAREND ;
                  END IF;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeRegions
        }
        advanced {
            executionMappingIdentifier: 11622642604514303
        }
    )

)

