    region service-bill-register-report (
        name: Service Bill Register Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select xxx.TNo,
                       xxx.SNo,
                       xxx.LocationName,
                       xxx.SERVICEBILLNo,
                       xxx.SERVICEBILLDate,
                       xxx.Vendor,
                       xxx.JobTypeCode,
                       xxx.JobTypeName,
                       --xxx.UOM1,
                       xxx.Quantity1,
                       --xxx.UOM2,
                       xxx.Quantity2,
                       xxx.Rate,
                       xxx.UOM,
                       xxx.Amount,
                       xxx.CGST,
                       xxx.SGST,
                       xxx.IGST,
                       xxx.TCS,
                       xxx.FooterAmount,
                       (xxx.FooterAmount - (xxx.CGST + xxx.SGST + xxx.IGST + xxx.TCS)) As OtherAmount,
                       xxx.TotalAmount,
                       xxx.locationcode,
                       xxx.vendoraddress,
                        '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||9993||':'||:APP_SESSION||'::::'||'P9993_TNO,P9993_REPNAME'||':'||XXX.TNO||','||'ServiceBill'||':NO')||'"><span aria-label="Action"><span class="fa fa-print"  aria-hidden="true" title="Action"></span</span></a>' AS Print,
                
                       (Select Sum(footerpercent)
                          From SERVICEBILLdetailfooter
                         Where tno = xxx.tno
                           And sno = xxx.sno
                           And footerheadcode In ('.CGST.', '.SGST.', '.IGST.')) As footerpercent,
                       xxx.saccode
                
                  From (Select xx.TNo,
                               xx.SNo,
                               xx.LocationName,
                               xx.SERVICEBILLNo,
                               xx.SERVICEBILLDate,
                               xx.Vendor,
                               xx.JobTypeCode,
                               xx.JobTypeName,
                               --xx.UOM1,
                               xx.Quantity1,
                               --xx.UOM2,
                               xx.Quantity2,
                               xx.Rate,
                               xx.RateMeasuringUnitCode UOM,
                               xx.Amount,
                               Sum(xx.CGST) CGST,
                               Sum(xx.SGST) SGST,
                               Sum(xx.IGST) IGST,
                               Sum(xx.TCS) TCS,
                               xx.FooterAmount,
                               xx.TotalAmount,
                               xx.locationcode,
                               xx.vendoraddress,
                               Max(xx.footerpercent) As footerpercent,
                               xx.saccode
                          From (Select a.TNo,
                                       b.SNo,
                                       a.locationcode,
                                       l.LocationName,
                                       a.SERVICEBILLNo,
                                       a.SERVICEBILLDate,
                                       p.PartyName As Vendor,
                                       (p.officeaddress ||
                                       decode(p.officeaddress2,
                                               Null,
                                               Null,
                                               ',' || p.officeaddress2) ||
                                       decode(p.officeaddress3,
                                               Null,
                                               Null,
                                               ',' || p.officeaddress3) ||
                                       decode(p.officeaddress4,
                                               Null,
                                               Null,
                                               ',' || p.officeaddress4) ||
                                       decode(p.officecitycode,
                                               Null,
                                               Null,
                                               ',' || getcityname(p.officecitycode)) ||
                                       decode(p.officestatecode,
                                               Null,
                                               Null,
                                               ',' || getstatename(p.officestatecode)) ||
                                       decode(p.officepincode,
                                               Null,
                                               Null,
                                               ', PIN CODE -' || p.officepincode)
                                       
                                       ) As vendoraddress,
                                       e.JobTypeCode,
                                       e.JobTypeName,
                                       e.saccode,
                                       --e.MeasuringUnitCode1 As UOM1,
                                       b.Quantity1,
                                       --e.MeasuringUnitCode2 As UOM2,
                                       b.Quantity2,
                                       b.Rate,
                                       b.RateMeasuringUnitCode,
                                       b.Amount,
                                       c.footerpercent,
                                       nvl(Decode(c.FooterHeadCode, '.CGST.', c.FooterValue),
                                           0) As CGST,
                                       nvl(Decode(c.FooterHeadCode, '.SGST.', c.FooterValue),
                                           0) As SGST,
                                       nvl(Decode(c.FooterHeadCode, '.IGST.', c.FooterValue),
                                           0) As IGST,
                                       nvl(Decode(c.FooterHeadCode, '.TCS.', c.FooterValue),
                                           0) As TCS,
                                       b.FooterAmount,
                                       b.TotalAmount
                                  From SERVICEBILL             a,
                                       SERVICEBILLDetail       b,
                                       SERVICEBILLDetailFooter c,
                                       Location                l,
                                       JobType                 e,
                                       Party                   p
                                 Where a.TNo = b.TNo
                                   And b.TNo = c.TNO(+)
                                   And b.SNo = c.SNo(+)
                                   And a.LocationCode = l.LocationCode
                                   And b.JobTypeCode = e.JobTypeCode(+)
                                   And a.PartyCode = p.PartyCode(+)
                                    and a.SERVICEBILLDate between :P304_FROMDATE and :P304_TODATE
                                    and ( :P304_COMPANY IS NULL OR instr(':'||:P304_COMPANY||':',':'||a.CompanyCode||':') > 0)
                                    and ( :P304_LOCATION IS NULL OR instr(':'||:P304_LOCATION||':',':'||a.LocationCode||':') > 0)
                                    and ( :P304_PARTY IS NULL OR instr(':'||:P304_PARTY||':',':'||a.PartyCode||':') > 0 )
                                    and ( :P304_JOBTYPE IS NULL OR instr(':'||:P304_JOBTYPE||':',':'||e.JobTypeCode||':') > 0 )
                                    and a.SERVICEBILLNo like nvl(:P304_PBNO,'%')
                                    -- and ( :P304_ITEMGROUP IS NULL OR instr(':'||:P304_ITEMGROUP||':',':'||e.ParentCode||':') > 0 )                     
                                
                                ) xx
                         Group By xx.TNo,
                                  xx.SNo,
                                  xx.LocationName,
                                  xx.SERVICEBILLNo,
                                  xx.SERVICEBILLDate,
                                  xx.Vendor,
                                  xx.JobTypeCode,
                                  xx.JobTypeName,
                                  --xx.UOM1,
                                  xx.Quantity1,
                                  -- xx.UOM2,
                                  xx.Quantity2,
                                  xx.Rate,
                                  xx.RateMeasuringUnitCode,
                                  xx.FooterAmount,
                                  xx.Amount,
                                  xx.TotalAmount,
                                  xx.locationcode,
                                  xx.vendoraddress,
                                  xx.saccode) xxx
                
                ```
            pageItemsToSubmit: [
                P304_COMPANY
                P304_LOCATION
                P304_FROMDATE
                P304_TODATE
                P304_JBPSTATUS
                P304_PARTY
                P304_ITEMGROUP
                P304_JOBTYPE
                P304_ITEMSPECIFICATION
                P304_TNO
            ]
        }
