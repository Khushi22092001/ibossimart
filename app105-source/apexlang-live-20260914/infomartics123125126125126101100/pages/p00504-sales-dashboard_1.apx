                               to_Char(Add_Months(to_date(:P504_DATE, 'DD-MON-YYYY'),
                                                  -1 *
                                                  (Decode(:P504_COMPARE, 'MONTH', 1, 12)) *
                                                  nvl(i-1, 1)),
                                       'YYYYMM');
                      Elsif I-1 = 2 Then
                        Select Sum(aa.CCInvoiceAmount)
                          Into vp2
                          From CCInvoice aa
                         Where AA.PARTYCODE = C.PARTYCODE
                           And to_Char(aa.CCInvoiceDate, 'YYYYMM') =
                               to_Char(Add_Months(to_date(:P504_DATE, 'DD-MON-YYYY'),
                                                  -1 *
                                                  (Decode(:P504_COMPARE, 'MONTH', 1, 12)) *
                                                  nvl(i-1, 1)),
                                       'YYYYMM');
                      Elsif I-1 = 3 Then
                        Select Sum(aa.CCInvoiceAmount)
                          Into vp3
                          From CCInvoice aa
