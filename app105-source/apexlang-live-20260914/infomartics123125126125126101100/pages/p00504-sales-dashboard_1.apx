                        P380_PARTY: &P504_PARTY.
                        P380_ITEM: &P504_ITEM_NAME.
                        P380_ITEMSPECIFICATION: &P504_ITEM_SPECIFICATION.
                        P380_SALES_EXECUTIVE: &SALES_EXECUTIVE_CODE.
                        P380_REGION_TO_DISPLAY: SALES_PERSON_WISE
                    }
                    clearCache: 380
