    process get-default-values (
        name: Get Default Values
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P504_FY_BEGIN      := :GLOBAL_FINANCIALYEARBEGIN;
                    :P504_FY_END        := :GLOBAL_FINANCIALYEAREND;
                    IF :P504_DATE_RANGE IS NULL THEN
                        :P504_DATE_RANGE    :=  :P504_FY_BEGIN||' - '||:P504_FY_END;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 38455823339101541
        }
    )

