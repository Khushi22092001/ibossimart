    region orders-by-month (
        name: Orders by Month
        type: chart
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                i-h480
                t-Region--removeHeader js-removeLandmark
                t-Region--noUI
                t-Region--scrollBody
            ]
        }
        chart {
            type: combination
        }
        title {
            title: Orders by Month
        }
        chartLayout {
            height: 400
        }
        legend {
            position: top
        }

        series by-amount (
            name: by Amount
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH RAW_DATES AS (
                        SELECT 
                            TO_DATE(TRIM(SUBSTR(:P504_DATE_RANGE, 1, INSTR(:P504_DATE_RANGE, ' - ') - 1)), 'DD-MM-YYYY')    AS V_START,
                            TO_DATE(TRIM(SUBSTR(:P504_DATE_RANGE, INSTR(:P504_DATE_RANGE, ' - ') + 3)), 'DD-MM-YYYY')       AS V_END
                        FROM DUAL
                    )
                    SELECT 
                        TO_CHAR(so.salesorderdate, 'Mon YYYY', 'NLS_DATE_LANGUAGE = ENGLISH') AS order_month,
                        SUM(sod.amount)                                                      AS total_amount,
                        -- SUM(sod.quantity1)                                                   AS total_quantity,
                        
                        'Month: '    || TO_CHAR(so.salesorderdate, 'Mon YYYY', 'NLS_DATE_LANGUAGE = ENGLISH') || 
                        ' | Amount: ' || TO_CHAR(SUM(sod.amount), '99,99,99,990.00')                          || 
                        ' | Qty: '    || TO_CHAR(SUM(sod.quantity1), '99,99,99,990.00')                       AS tooltip_amount_qty
                    FROM salesorder so
                    JOIN salesorderdetail sod ON so.tno = sod.tno
                    LEFT JOIN item it         ON it.itemcode = sod.itemcode
                    CROSS JOIN RAW_DATES rd
                    WHERE so.salesorderdate BETWEEN rd.V_START AND rd.V_END
                      AND (:P504_PARTY             IS NULL OR so.partycode = :P504_PARTY)
                      AND (:P504_ITEM_CATEGORY      IS NULL OR IT.itemcategorycode = :P504_ITEM_CATEGORY)
                      AND (:P504_ITEM_NAME          IS NULL OR sod.itemcode = :P504_ITEM_NAME)
                      AND (:P504_ITEM_SPECIFICATION IS NULL OR sod.itemspecificationcode = :P504_ITEM_SPECIFICATION)
                      AND (:P504_SALES_EXECUTIVE    IS NULL OR so.salesexecutivecode = :P504_SALES_EXECUTIVE)
                    GROUP BY 
                        TO_CHAR(so.salesorderdate, 'Mon YYYY', 'NLS_DATE_LANGUAGE = ENGLISH'),
                        TO_CHAR(so.salesorderdate, 'YYYYMM') 
                    ORDER BY 
                        TO_CHAR(so.salesorderdate, 'YYYYMM') ASC;
                    ```
                pageItemsToSubmit: [
                    P504_DATE_RANGE
                    P504_PARTY
                    P504_ITEM_CATEGORY
                    P504_ITEM_NAME
                    P504_ITEM_SPECIFICATION
                    P504_SALES_EXECUTIVE
                ]
            }
            columnMapping {
                label: ORDER_MONTH
                value: TOTAL_AMOUNT
                customTooltip: TOOLTIP_AMOUNT_QTY
            }
            appearance {
                color: #a9d08e
            }
            link {
                type: redirectThisApp
                target: {
                    page: 380
                    items: {
                        P380_FROMDATE: &P504_FROMDATE.
                        P380_TODATE: &P504_TODATE.
                        P380_ITEM: &P504_ITEM_NAME.
                        P380_PARTY: &P504_PARTY.
                        P380_SALES_EXECUTIVE: &P504_SALES_EXECUTIVE.
                        P380_ITEMSPECIFICATION: &P504_ITEM_SPECIFICATION.
                        P380_REGION_TO_DISPLAY: MONTH_WISE_ORDERS
                        P380_SELECTED_MONTH: &ORDER_MONTH.
                    }
                    clearCache: 380
                }
            }
            label {
                show: true
                position: outsideBarEdge
            }
        )

        series by-qty (
            name: by Qty
            type: line
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    WITH RAW_DATES AS (
                        SELECT 
                            TO_DATE(TRIM(SUBSTR(:P504_DATE_RANGE, 1, INSTR(:P504_DATE_RANGE, ' - ') - 1)), 'DD-MM-YYYY')    AS V_START,
                            TO_DATE(TRIM(SUBSTR(:P504_DATE_RANGE, INSTR(:P504_DATE_RANGE, ' - ') + 3)), 'DD-MM-YYYY')       AS V_END
                        FROM DUAL
                    )
                    SELECT 
                        TO_CHAR(so.salesorderdate, 'Mon YYYY', 'NLS_DATE_LANGUAGE = ENGLISH') AS order_month,
                        -- SUM(sod.amount)                                                      AS total_amount,
                        SUM(sod.quantity1)                                                   AS total_quantity,
                        
                        'Month: '    || TO_CHAR(so.salesorderdate, 'Mon YYYY', 'NLS_DATE_LANGUAGE = ENGLISH') || 
                        ' | Amount: ' || TO_CHAR(SUM(sod.amount), '99,99,99,990.00')                          || 
                        ' | Qty: '    || TO_CHAR(SUM(sod.quantity1), '99,99,99,990.00')                       AS tooltip_amount_qty
                    FROM salesorder so
                    JOIN salesorderdetail sod ON so.tno = sod.tno
                    LEFT JOIN item it         ON it.itemcode = sod.itemcode
                    CROSS JOIN RAW_DATES rd
                    WHERE so.salesorderdate BETWEEN rd.V_START AND rd.V_END
                      AND (:P504_PARTY             IS NULL OR so.partycode = :P504_PARTY)
                      AND (:P504_ITEM_CATEGORY      IS NULL OR IT.itemcategorycode = :P504_ITEM_CATEGORY)
                      AND (:P504_ITEM_NAME          IS NULL OR sod.itemcode = :P504_ITEM_NAME)
                      AND (:P504_ITEM_SPECIFICATION IS NULL OR sod.itemspecificationcode = :P504_ITEM_SPECIFICATION)
                      AND (:P504_SALES_EXECUTIVE    IS NULL OR so.salesexecutivecode = :P504_SALES_EXECUTIVE)
                    GROUP BY 
                        TO_CHAR(so.salesorderdate, 'Mon YYYY', 'NLS_DATE_LANGUAGE = ENGLISH'),
                        TO_CHAR(so.salesorderdate, 'YYYYMM') 
                    ORDER BY 
                        TO_CHAR(so.salesorderdate, 'YYYYMM') ASC;
                    ```
                pageItemsToSubmit: [
                    P504_DATE_RANGE
                    P504_PARTY
                    P504_ITEM_CATEGORY
                    P504_ITEM_NAME
                    P504_ITEM_SPECIFICATION
                    P504_SALES_EXECUTIVE
                ]
            }
            columnMapping {
                label: ORDER_MONTH
                value: TOTAL_QUANTITY
                customTooltip: TOOLTIP_AMOUNT_QTY
            }
            appearance {
                color: #588637
            }
            link {
                type: redirectThisApp
                target: {
                    page: 380
                    items: {
                        P380_FROMDATE: &P504_TODATE.
                        P380_PARTY: &P504_PARTY.
                        P380_TODATE: &P504_TODATE.
                        P380_SALES_EXECUTIVE: &P504_SALES_EXECUTIVE.
                        P380_ITEM: &P504_ITEM_NAME.
                        P380_REGION_TO_DISPLAY: MONTH_WISE_ORDERS
                        P380_SELECTED_MONTH: &ORDER_MONTH.
                    }
                    clearCache: 380
                }
            }
            label {
                show: true
                position: aboveMarker
            }
        )

