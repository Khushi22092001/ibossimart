                heading: Total Order Qty
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

    )

    region posted (
        name: Posted
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                '₹ '||to_number(Round(sum(a.InvoiceAmount)/100000,2),'99999999999.99') ||' Lac' Value,
                'Posted' as Text,
                'u-color-18' as card_color
                From  Invoice a, Financialyear b
                Where to_Char(a.InvoiceDate,'YYYY') = to_Char(To_Date(:P504_DATE,'DD-MM-YYYY'),'YYYY')
                  and exists (Select 1 from Voucher v where v.ModuleTNo = a.TNo)
                  and a.FinancialYearCode = b.FinancialyearCode
                  and :P504_DATE between b.FinancialYearBegin and b.FinancialyearEnd
                  and a.InvoiceDate <= :P504_DATE
                  And :P504_DATE Between B.FinancialYearBegin And B.FinancialYearend
                
                ```
        }
        layout {
            sequence: 60
            parentRegion: @top-kpi-trends
            slot: subRegions
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        card {
            cssClasses: &CARD_COLOR!ATTR.
        }
        title {
            column: TEXT
        }
        subtitle {
            column: VALUE
            cssClasses: [
                u-color-13-text
                mycardtext
                mycardsize
            ]
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 174
                    items: {
                        P174_COMPANY: &GLOBAL_COMPANYCODE.
                        P174_FROMDATE: &P504_FROMDATE.
                        P174_TODATE: &P504_DATE.
                        P174_STATUS: ACTIVE
                    }
                }
            }
        )

    )

    region qty-over-time (
        name: Qty Over Time
        type: chart
        layout {
            sequence: 50
