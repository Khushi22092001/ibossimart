    dynamicAction force-scroll-top-on-after-refresh (
        name: Force Scroll Top On After Refresh
        execution {
            sequence: 90
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @reports
        }
        config {
            buildOption: @commented-out
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    document.activeElement.blur();
                    window.scrollTo(0, 0);
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

