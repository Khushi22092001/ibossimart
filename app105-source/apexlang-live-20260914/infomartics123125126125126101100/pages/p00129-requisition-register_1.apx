    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 30
            region: @material-requisition-register
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 130
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button custom (
        buttonName: CUSTOM
        label: Custom
        layout {
            sequence: 40
            region: @material-requisition-register
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--iconRight
            ]
            icon: fa-file-excel-o
        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/mrregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P129_FROMDATE=&P129_FROMDATE.&P129_TODATE=&P129_TODATE.&P129_LOCATION=&P129_LOCATION.&P129_STATUS=&P129_STATUS.&P129_BREAKUPAS=&P129_BREAKUPAS.&P129_BREAKUP=&P129_BREAKUP.&P129_DEPARTMENT=&P129_DEPARTMENT.&P129_GROUPLEVEL=&P129_GROUPLEVEL.&P129_GROUP=&P129_GROUP.&P129_ITEM=&P129_ITEM.&P129_ITEMSPECIFICATION=&P129_ITEMSPECIFICATION.&P129_COSTCENTRE=&P129_COSTCENTRE.&P129_PARTY=&P129_PARTY.
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 2
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 20
            region: @material-requisition-register
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @material-requisition-register
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
