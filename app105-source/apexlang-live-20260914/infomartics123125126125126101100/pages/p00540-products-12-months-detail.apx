    region products-12-months-sale-detail (
        name: Products 12 Months Sale Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       COMPANYNAME,
                       LOCATIONCODE,
                       LOCATIONNAME,
                       DOCTYPECODE,
                       DOCTYPENAME,
                       CCINVOICENO,
                       CCINVOICEDATE,
                       DESPATCHADVICETNO,
                       DESPATCHADVICENO,
                       DESPATCHADVICEDATE,
                       SALESORDERTNO,
                       SALESORDERNO,
                       SALESORDERDATE,
                       PARTYCODE,
                       PARTYNAME,
                       CONSIGNEECODE,
                       CONSIGNEENAME,
                       TRANSPORTERCODE,
                       TRANSPORTERNAME,
                       VEHICLENO,
                       LORRYNO,
                       LORRYDATE,
                       FREIGHTTYPECODE,
                       FREIGHTTYPENAME,
                       FREIGHTRATE,
                       FREIGHTUNITCODE,
                       ITEMCODE,
                       ITEMNAME,
                       MATERIALDESCRIPTION,
                       UOM1,
                       QUANTITY1,
                       RATE,
                       AMOUNT,
                       CGST,
                       SGST,
                       IGST,
                       TCS,
                       FOOTERAMOUNT,
                       OTHERAMOUNT,
                       TOTALAMOUNT,
                       CREATOR,
                       CREATIONTIME,
                       AGENTCODE,
                       AGENTNAME,
                       CITYCODE,
                       CITYNAME,
                       STATECODE,
                       STATENAME,
                       REGIONCODE,
                       REGIONNAME,
                       AGEOFINVOICE,
                       SALESPERSONCODE,
                       SALESPERSONNAME,
                       ITEMSPECIFICATIONCODE
                  from D_CUSTOMER_360VIEW_ACTIVEINVOICE
                 Where PartyCode like nvl(:P540_CUSTOMERCODE,'%')
                   and ItemSpecificationCode like nvl(:P540_ITEMSPECIFICATIONCODE,'%')
                   and To_Char(CCINVOICEDATE,'MON-YYYY') like nvl(:P540_MONTH,'%')
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P540_MODULE
            value: SALE
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            compute: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 66163870184497514
        }

