    region products-12-months-purchase-detail (
        name: Products 12 Months Purchase Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       COMPANYNAME,
                       LOCATIONCODE,
                       LOCATIONNAME,
                       DOCTYPECODE,
                       DOCTYPENAME,
                       PBPASSNO,
                       PBPASSDATE,
                       PARTYCODE,
                       PARTYNAME,
                       PARTYBILLNO,
                       PARTYBILLDATE,
                       PURCHASEORDERNO,
                       PURCHASEORDERTNO,
                       PARTYBILLAMOUNT,
                       ITEMCODE,
                       ITEMNAME,
                       UOM1,
                       QUANTITY1,
                       UOM2,
                       QUANTITY2,
                       RATE,
                       UOM,
                       AMOUNT,
                       CGST,
                       SGST,
                       IGST,
                       TCS,
                       TDS,
                       FOOTERAMOUNT,
                       OTHERAMOUNT,
                       TOTALAMOUNT,
                       PAIDAMOUNT,
                       BALANCEAMOUNT,
                       VOUCHERTNO,
                       VOUCHERNO,
                       VOUCHERDATE,
                       DEBITNOTETNO,
                       DEBITNOTENO,
                       DEBITNOTEVOUCHERTNO,
                       DEVITNOTEVOUCHERNO,
                       AGEOFBILL,
                       DUEDATE,
                       CREDITDAYS,
                       CITYCODE,
                       CITYNAME,
                       STATECODE,
                       STATENAME,
                       ITEMSPECIFICATIONCODE
                  from D_SUPPLIER_360VIEW_ACTIVEPBPASS
                  Where PartyCode like nvl(:P540_CUSTOMERCODE,'%')
                   and ItemSpecificationCode like nvl(:P540_ITEMSPECIFICATIONCODE,'%')
                   and To_Char(PBPASSDATE,'MON-YYYY') like nvl(:P540_MONTH,'%')
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P540_MODULE
            value: PURCHASE
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
