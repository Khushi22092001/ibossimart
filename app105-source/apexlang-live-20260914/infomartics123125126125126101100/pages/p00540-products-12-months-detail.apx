page 540 (
    name: Products 12 Months Detail
    alias: PRODUCTS-12-MONTHS-DETAIL
    title: Products 12 Months Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            ```
    }
    security {
        formAutoComplete: false
    }

    region conditions (
        name: Conditions
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        serverSideCondition {
            type: item=value
            item: 1
            value: 2
        }
    )

    region products-12-months-production-detail (
        name: Products 12 Months Production Detail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       COMPANYNAME,
                       BATCHNO,
                       PRODUCTIONNO,
                       PRODUCTIONDATE,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       ITEMNAME,
                       QUANTITY1,
                       QUANTITY2,
                       AMOUNT
                  from D_PRODUCT360VIEW_PRODUCTION
                  Where ItemSpecificationCode like nvl(:P540_ITEMSPECIFICATIONCODE,'%')
                   and To_Char(PRODUCTIONDATE,'MON-YYYY') like nvl(:P540_MONTH,'%')
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: item=value
            item: P540_MODULE
            value: PRODUCTION
        }
        pagination {
            type: rowRangesXToYOfZ
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 1000000
        }
        searchBar {
            searchField: false
            reportsSelectList: false
        }
        actionsMenu {
            compute: false
            flashback: false
            saveReport: false
            reset: false
            subscription: false
        }
        download {
            formats: excel
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 53796262276267060
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:80px">#AMOUNT#</div>
            }
            source {
