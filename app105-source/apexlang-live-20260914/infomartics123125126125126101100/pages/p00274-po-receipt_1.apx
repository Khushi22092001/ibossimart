    pageItem P274_AGENTCODE (
        type: popupLov
        label {
            label: Agent
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName || ', ' || b.CityName as AgentName,
                a.PartyCode
                from Party a, City b
                where a.OfficeCityCode = b.CityCode(+)
                AND A.PARTYTYPECODE ='AGENT' 
                order by a.PartyName
                ```
            displayNullValue: false
        }
        layout {
            sequence: 140
            region: @general
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @po-receipt
            column: AGENTCODE
            dataType: varchar2
        }
    )

