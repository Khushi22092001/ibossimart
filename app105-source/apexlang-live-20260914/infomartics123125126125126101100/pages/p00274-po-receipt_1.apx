    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into poreceiptdetail (                 
                                    TNO,
                SNO,
                ITEMCODE,
                ITEMSPECIFICATIONCODE,
                DESCRIPTION,
                QUANTITY1,
                QUANTITY2,
                TOLERANCE,
                RECEIVEDQUANTITY1,
                RECEIVEDQUANTITY2,
                PURCHASEBILLQUANTITY1,
                PURCHASEBILLQUANTITY2,
                MATERIALINQUANTITY1,
                MATERIALINQUANTITY2,
                GATEPASSQUANTITY1,
                GATEPASSQUANTITY2,
                ACCEPTEDQUANTITY1,
                ACCEPTEDQUANTITY2,
                INSPECTEDQUANTITY1,
                INSPECTEDQUANTITY2,
                JOINACCEPTEDQUANTITY1,
                JOINACCEPTEDQUANTITY2,
                JOININSPECTEDQUANTITY1,
                JOININSPECTEDQUANTITY2,
                RATEMEASURINGUNITCODE,
                RATE,
                AMOUNT,
                FOOTERAMOUNT,
                TOTALAMOUNT,
                REMARK,
                LOWERTOLERANCEPERCENT,
                HIGHERTOLERANCEPERCENT,
                DOCUMENTSTATUSCODE,
                TAXRULECODE,
                PACKINGTYPECODE,
                PACKINGNOS
                            )
                            Values (
                                :TNO,
                :SNO,
                :ITEMCODE,
                :ITEMSPECIFICATIONCODE,
                :DESCRIPTION,
                :QUANTITY1,
                :QUANTITY2,
                :TOLERANCE,
                :RECEIVEDQUANTITY1,
                :RECEIVEDQUANTITY2,
                :PURCHASEBILLQUANTITY1,
                :PURCHASEBILLQUANTITY2,
                :MATERIALINQUANTITY1,
                :MATERIALINQUANTITY2,
                :GATEPASSQUANTITY1,
                :GATEPASSQUANTITY2,
                :ACCEPTEDQUANTITY1,
                :ACCEPTEDQUANTITY2,
                :INSPECTEDQUANTITY1,
                :INSPECTEDQUANTITY2,
                :JOINACCEPTEDQUANTITY1,
                :JOINACCEPTEDQUANTITY2,
                :JOININSPECTEDQUANTITY1,
                :JOININSPECTEDQUANTITY2,
                :RATEMEASURINGUNITCODE,
                :RATE,
                :AMOUNT,
                :FOOTERAMOUNT,
                :TOTALAMOUNT,
                :REMARK,
                :LOWERTOLERANCEPERCENT,
                :HIGHERTOLERANCEPERCENT,
                :DOCUMENTSTATUSCODE,
                :TAXRULECODE,
                :PACKINGTYPECODE,
                :PACKINGNOS
                            );
                        
                        when 'U' then
                            update poreceiptdetail Set
                                  TNO=:TNO,
                SNO=:SNO,
                ITEMCODE=:ITEMCODE,
                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                DESCRIPTION=:DESCRIPTION,
                QUANTITY1=:QUANTITY1,
                QUANTITY2=:QUANTITY2,
                TOLERANCE=:TOLERANCE,
                RECEIVEDQUANTITY1=:RECEIVEDQUANTITY1,
                RECEIVEDQUANTITY2=:RECEIVEDQUANTITY2,
                PURCHASEBILLQUANTITY1=:PURCHASEBILLQUANTITY1,
                PURCHASEBILLQUANTITY2=:PURCHASEBILLQUANTITY2,
                MATERIALINQUANTITY1=:MATERIALINQUANTITY1,
                MATERIALINQUANTITY2=:MATERIALINQUANTITY2,
                GATEPASSQUANTITY1=:GATEPASSQUANTITY1,
                GATEPASSQUANTITY2=:GATEPASSQUANTITY2,
                ACCEPTEDQUANTITY1=:ACCEPTEDQUANTITY1,
                ACCEPTEDQUANTITY2=:ACCEPTEDQUANTITY2,
                INSPECTEDQUANTITY1=:INSPECTEDQUANTITY1,
                INSPECTEDQUANTITY2=:INSPECTEDQUANTITY2,
                JOINACCEPTEDQUANTITY1=:JOINACCEPTEDQUANTITY1,
                JOINACCEPTEDQUANTITY2=:JOINACCEPTEDQUANTITY2,
                JOININSPECTEDQUANTITY1=:JOININSPECTEDQUANTITY1,
                JOININSPECTEDQUANTITY2=:JOININSPECTEDQUANTITY2,
                RATEMEASURINGUNITCODE=:RATEMEASURINGUNITCODE,
                RATE=:RATE,
                AMOUNT=:AMOUNT,
                FOOTERAMOUNT=:FOOTERAMOUNT,
                TOTALAMOUNT=:TOTALAMOUNT,
                REMARK=:REMARK,
                LOWERTOLERANCEPERCENT=:LOWERTOLERANCEPERCENT,
                HIGHERTOLERANCEPERCENT=:HIGHERTOLERANCEPERCENT,
                DOCUMENTSTATUSCODE=:DOCUMENTSTATUSCODE,
                TAXRULECODE=:TAXRULECODE,
                PACKINGTYPECODE=:PACKINGTYPECODE,
                PACKINGNOS=:PACKINGNOS
                            WHERE TNO = :P274_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From poreceiptdetail
                            Where TNo = :P274_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 65403370971005860
        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P274_Tno is null then
                        Select GlobalTno.NextVal into :P274_Tno From Dual;
                     end if;
                    ----
                    if :P274_PORECEIPTNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P274_LocationCode,
                					:P274_DocTypeCode,
                					NULL,
                					TO_DATE(:P274_PORECEIPTDATE, 'DD-MM-RRRR')
                				);
                        :P274_PORECEIPTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P274_LocationCode,
                                    :P274_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P274_PORECEIPTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 65453852295005895
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P274_TNO is null then
                    :P274_TNO := GlobalTNo.nextval;
                    :P274_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P274_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P274_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P274_TNO), 'Status');
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 65452690590005895
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P274_MODULEFLOW := 'YES';
                   else
                       :P274_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P274_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P274_ONTHETABLE := 'YES' ;
                   else
                       :P274_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 65453087326005895
        }
    )

