                       SUMOFAMOUNT,
                       SUMOFFOOTERAMOUNT,
                       PORECEIPTAMOUNT,
                       SUBJECTTEXT,
                       REFERENCETEXT,
                       LETTERTEXT,
                       TITLETEXT,
                       REMARK,
                       ITEMWISEFOOTER,
                       SALESQUOTATIONTNO,
                       AGENTCODE,
                       CONSIGNEECODE,
                       PARTYPORECEIPTNO,
                       PARTYPORECEIPTDATE,
                       VALIDITYUPTODATE,
                       NATUREOFSUPPLYCODE,
                       TRANSACTIONTYPECODE,
                       CREATIONTIME,
                       CREATOR
                  from PORECEIPT
