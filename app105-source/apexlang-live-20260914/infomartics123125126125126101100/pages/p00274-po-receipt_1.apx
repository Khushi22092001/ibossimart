page 274 (
    name: PO Receipt
    alias: PO-RECEIPT
    title: PO Receipt
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 60
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 70
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region currency (
        name: Currency
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @po-receipt
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       GetMeasuringUnitNameFromItem(ITEMCODE) as Unit1,
                       QUANTITY1,
                       GetMeasuringUnit2NameFromItem(ITEMCODE) as Unit2,
                       QUANTITY2,
                       TOLERANCE,
                       RECEIVEDQUANTITY1,
                       RECEIVEDQUANTITY2,
                       PURCHASEBILLQUANTITY1,
                       PURCHASEBILLQUANTITY2,
                       MATERIALINQUANTITY1,
                       MATERIALINQUANTITY2,
                       GATEPASSQUANTITY1,
                       GATEPASSQUANTITY2,
                       ACCEPTEDQUANTITY1,
                       ACCEPTEDQUANTITY2,
                       INSPECTEDQUANTITY1,
                       INSPECTEDQUANTITY2,
                       JOINACCEPTEDQUANTITY1,
                       JOINACCEPTEDQUANTITY2,
                       JOININSPECTEDQUANTITY1,
                       JOININSPECTEDQUANTITY2,
                       RATEMEASURINGUNITCODE,
                       RATE,
                       AMOUNT,
                       FOOTERAMOUNT,
                       TOTALAMOUNT,
                       REMARK,
                       LOWERTOLERANCEPERCENT,
                       HIGHERTOLERANCEPERCENT,
                       DOCUMENTSTATUSCODE,
                       TAXRULECODE,
                       PACKINGTYPECODE,
                       PACKINGNOS,
                       'FD' as FD
                  from PORECEIPTDETAIL
                  where tno = :P274_TNO
                ```
            pageItemsToSubmit: P274_TNO
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 169067967562307576
        }

