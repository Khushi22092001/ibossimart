    process save-footer (
        name: save footer
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    delete from poreceiptfooter where tno = :P274_TNO;
                    insert into poreceiptfooter
                        (tno ,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   select 
                                :P274_TNO , 
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from poreceiptdetailfooter
                            where tno = :P274_TNO
                            group by FOOTERHEADCODE
                        );
                end;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 65452268614005895
        }
    )

