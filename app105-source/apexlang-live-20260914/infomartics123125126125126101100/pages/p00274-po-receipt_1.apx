    dynamicAction insert-into-detail (
        name: insert into detail
        execution {
            sequence: 360
        }
        when {
            event: click
            selectionType: button
            button: @getitem
        }

        action detail (
            name: detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P274_SALESQUOTATIONTNO is not null then
                        delete from poreceiptdetail where tno = :P274_TNO;
                    
                        for vQ in (
                           select SNO,
                                itemcode,
                                itemspecificationcode,
                                Description,
                                quantity1,
                                quantity2,
                                rate,
                                amount,
                                footeramount,
                                totalamount
                            from salesquotationdetail
                            where tno = :P274_SALESQUOTATIONTNO
                            ORDER BY SNO
                    
                        ) loop
                            insert into poreceiptdetail
                            (    tno,
                                sno,
                                itemcode,
                                itemspecificationcode,
                                Description,
                                quantity1,
                                quantity2,
                                rate,
                                amount,
                                footeramount,
                                totalamount
                            )
                            values 
                            (
                                :P274_TNO,
                                globaltno.nextval,
                                vQ.itemcode,
                                vQ.itemspecificationcode,
                                vQ.Description,
                                vQ.quantity1,
                                vQ.quantity2,
                                vQ.rate,
                                vQ.amount,
                                vQ.footeramount,
                                vQ.totalamount
                    
                            ) ;
                        end loop;
                    
                    end if;
                    ```
                itemsToSubmit: [
                    P274_TNO
                    P274_SALESQUOTATIONTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

