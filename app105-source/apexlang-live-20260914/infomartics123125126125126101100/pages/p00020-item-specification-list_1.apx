page 20 (
    name: Item Specification List
    alias: ITEM-SPECIFICATION-LIST
    title: Item Specification List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region item-specification-list (
        name: Item Specification List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /*select a.TNO,
                        b.itemname,
                       a.SNO,
                       a.ITEMCHARACTERISTICSCODE,
                       c.ITEMCHARACTERISTICSNAME,
                       a.MCVALUESNO,
                       d.value
                       --a.VALUE
                  from ITEMSPECIFICATIONDETAIL a , item b , ITEMCHARACTERISTICS c , mcvalue d
                  where a.tno = b.tno
                  and a.ITEMCHARACTERISTICSCODE = c.ITEMCHARACTERISTICSCODE
                  and a.MCVALUESNO = d.sno */
                
                  select 
                   Case
                         When ROW_NUMBER()
                          Over(Partition By a.itemname Order By a.itemname) = 1 Then
                          a.itemname
                         Else
                          Null
                       End itemname,
                    Case
                         When ROW_NUMBER()
                          Over(Partition By a.itemname , b.itemspecificationname Order By a.itemname , b.itemspecificationname) = 1 Then
                          b.itemspecificationname
                         Else
                          Null
                       End itemspecificationname,
                      a.tno , 
                     -- a.itemname , 
                     -- b.itemspecificationname , 
                      b.sno , 
                      b.multiplyingfactor 
                  from item a , itemspecification b
                where a.tno = b.tno
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 13
                items: {
                    P13_ITEMTNO: #TNO#
                    P13_SNO: #SNO#
                }
                clearCache: 13
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 145008772616705325
        }

        column ITEMNAME (
            type: plainText
            heading {
                heading: Item Name
            }
            layout {
                sequence: 15
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column ITEMSPECIFICATIONNAME (
            type: plainText
            heading {
                heading: Item Specification
            }
            layout {
                sequence: 25
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column MULTIPLYINGFACTOR (
            type: plainText
            heading {
                heading: Multiplying Factor
                alignment: end
            }
            layout {
                sequence: 35
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column SNO (
            type: plainText
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 2
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Item Specification List
        }

        savedReport 1450115 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ITEMNAME (
                sequence: 1
            )

            displayColumn ITEMSPECIFICATIONNAME (
                sequence: 2
            )

            displayColumn MULTIPLYINGFACTOR (
                sequence: 3
            )

        )

    )

    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 20
            region: @item-specification-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                clearCache: 13
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @item-specification-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

