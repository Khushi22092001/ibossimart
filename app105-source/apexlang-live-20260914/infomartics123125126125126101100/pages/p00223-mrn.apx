    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid,
                       TNO,
                       SNO,
                       SERIALNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       REMARK,
                       GATEPASSQUANTITY1,
                       GATEPASSQUANTITY2
                  from MRNDETAIL
                  where tno = :P223_TNO
                  
                ```
            pageItemsToSubmit: [
                P223_TNO
                P223_GRNTNO
                P223_FORMSTATUS
            ]
        }
