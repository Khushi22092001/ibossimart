    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P223_TNO is null then
                    :P223_TNO := GlobalTNo.nextval;
                    :P223_FORMSTATUS := 'NEWRECORD';
                else
                    :P223_FORMSTATUS := 'EDITRECORD';
                End if;
                
                :P223_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P223_TNO), 'Status');
