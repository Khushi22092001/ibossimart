    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into mrndetail (                 
                                    TNO,
                SNO,
                SERIALNO,
                ITEMCODE,
                ITEMSPECIFICATIONCODE,
                DESCRIPTION,
                QUANTITY1,
                QUANTITY2,
                REMARK,
                GATEPASSQUANTITY1,
                GATEPASSQUANTITY2
                            )
                            Values (
                                :TNO,
                :SNO,
                :SERIALNO,
                :ITEMCODE,
                :ITEMSPECIFICATIONCODE,
                :DESCRIPTION,
                :QUANTITY1,
                :QUANTITY2,
                :REMARK,
                :GATEPASSQUANTITY1,
                :GATEPASSQUANTITY2
                
                            );
                        
                        when 'U' then
                            update mrndetail Set
                                  TNO=:TNO,
                SNO=:SNO,
                SERIALNO=:SERIALNO,
                ITEMCODE=:ITEMCODE,
                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                DESCRIPTION=:DESCRIPTION,
                QUANTITY1=:QUANTITY1,
                QUANTITY2=:QUANTITY2,
                REMARK=:REMARK,
                GATEPASSQUANTITY1=:GATEPASSQUANTITY1,
                GATEPASSQUANTITY2=:GATEPASSQUANTITY2
                            WHERE TNO = :P223_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From mrndetail
                            Where TNo = :P223_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 17412101434306649
        }
    )

