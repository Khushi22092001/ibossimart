page 26 (
    name: Location Detail
    alias: LOCATION-DETAIL
    title: Location Detail
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1000
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            $('input').on('focus', function() {
            $("#"+this.id+"_LABEL").css("background-color", "yellow");
            }).on('blur', function() {
            $("#"+this.id+"_LABEL").css("background-color", "white");
            });
            
            $(
            'body').on('keydown', 'input, select, textarea', function(e) {
                var self = $(this)
                  , form = self.parents('form:eq(0)')
                  , focusable
                  , next
                  ;
                if (e.keyCode == 13) {
                    focusable = form.find('input,select,textarea,tabindex').filter(':visible');
                    next = focusable.eq(focusable.index(this)+1);
                    if (next.length) {
                        next.focus();
                    } else {
                        form.submit();
                    }
                    return false;
                }
            });
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region location-detail (
        name: Location Detail
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       SNO,
                       ATTRIBUTECODE,
                       ATTRIBUTEVALUE,
                       REMARK,
                       ATTACHMENTBLOB,
                       FILENAME,
                       MIMETYPE
                  from LOCATIONDETAIL
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P26_ATTACHMENTBLOB (
        type: fileUpload
        label {
            label: Attachment
            alignment: left
        }
        display {
            displayAs: nativeFileBrowse
        }
        storage {
            mimeTypeColumn: MIMETYPE
            filenameColumn: FILENAME
        }
        layout {
            sequence: 60
            region: @location-detail
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @location-detail
            column: ATTACHMENTBLOB
            dataType: blob
        }
    )

    pageItem P26_ATTRIBUTECODE (
        type: popupLov
        label {
            label: "Attribute "
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.PartyAttributeName d,
                b.PartyAttributeCode r 
                from PartyAttribute b;
                ```
            nullDisplayValue: --Select--
        }
        layout {
            sequence: 30
            region: @location-detail
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @location-detail
            column: ATTRIBUTECODE
            dataType: varchar2
        }
    )

