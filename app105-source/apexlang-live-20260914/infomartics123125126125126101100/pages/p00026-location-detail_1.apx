    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }
        serverSideCondition {
            type: never
        }

        action native-disable (
            action: disable
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P26_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode: SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P26_TNO1,:P26_STATUS);
                itemsToSubmit: [
                    P26_TNO1
                    P26_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $('#STATUS span').text($v('P26_STATUS'));
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P26_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

