    region attendence-periodical (
        name: ATTENDENCE PERIODICAL
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       GETCOMPANYNAME(COMPANYCODE) COMPANY,
                       getlocationname(LOCATIONCODE) locationname,
                       getdoctypename(DOCTYPECODE) doctypename,
                       FINANCIALYEARCODE,
                       ATTENDENCEPERIODICALNO,
                       ATTENDENCEPERIODICALDATE,
                       FROMDATE,
                       TODATE,
                       getemployeename(EMPLOYEECODE) employeename,
                       REMARK,
                       CREATOR,
                       to_char(CREATIONTIME,'DD-MM-YYYY HH24:MI') CreationTime
                  from ATTENDENCEPERIODICAL A
                  -- FILTER
                  WHERE ( :P619_COMPANY IS NULL OR instr(':'||:P619_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                  and ( :P619_LOCATION IS NULL OR instr(':'||:P619_LOCATION||':',':'||GETEMPLOYEELOCATIONCODE(a.EmployeeCode,trunc(sysdate))||':') > 0 ) 
                  and ( :P619_DEPARTMENT IS NULL OR instr(':'||:P619_DEPARTMENT||':',':'||GETEMPLOYEEDEPARTMENTCODE(a.EmployeeCode,trunc(sysdate))||':') > 0 ) 
                  and getcompanyprivilege(A.COMPANYCODE,GETMODULECODEFORPAGENO(:APP_PAGE_ID),:GLOBAL_LOGINNAME)='YES'
                
                  
                ```
            pageItemsToSubmit: [
                P619_COMPANY
                P619_LOCATION
                P619_DEPARTMENT
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 620
                items: {
                    P620_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 285191340405271579
        }

