page 7 (
    name: City List
    alias: CITY-LIST
    title: City List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region city-list (
        name: City List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       CITYCODE,
                       CITYNAME,
                       GETSTATENAME(STATECODE) AS State,
                       STDCODE,
                       PINCODE,
                       REMARK,
                       CREATOR,
                       DISTANCE,
                       CLASSOFCITYCODE,
                       REGIONCODE,
                       to_char(CREATIONTIME,'DD-MM-YYYY HH24:MI:SS') CREATIONTIME,
                       LEADTIME,
                       MODULECODE,
                       MODULETNO
                  from CITY
                  order by tno desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 8
                items: {
                    P8_TNO: #TNO#
                }
                clearCache: 8
            }
            linkIcon:
                ```
                 <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
                
                ```
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 134404503923822432
        }

        column CITYCODE (
            type: plainText
            heading {
                heading: City Code
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CITYNAME (
            type: plainText
            heading {
                heading: City Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column CLASSOFCITYCODE (
            type: plainText
            heading {
                heading: Class Of City Code
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 25
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column DISTANCE (
            type: plainText
            heading {
                heading: Distance
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column LEADTIME (
            type: plainText
            heading {
                heading: Lead Time
                alignment: end
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: Module Code
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column MODULETNO (
            type: plainText
            heading {
                heading: Module Tno
                alignment: end
            }
            layout {
                sequence: 15
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column PINCODE (
            type: plainText
            heading {
                heading: Pin Code
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column REGIONCODE (
            type: plainText
            heading {
                heading: Region Code
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column STATE (
            type: plainText
            heading {
                heading: State Name
            }
            layout {
                sequence: 35
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column STDCODE (
            type: plainText
            heading {
                heading: STD Code
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 1
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: City List
        }

        savedReport 1344109 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CITYCODE (
                sequence: 1
            )

            displayColumn CITYNAME (
                sequence: 2
            )

            displayColumn CREATIONTIME (
                sequence: 8
            )

            displayColumn CREATOR (
                sequence: 7
            )

            displayColumn PINCODE (
                sequence: 5
            )

            displayColumn REMARK (
                sequence: 6
            )

            displayColumn STATE (
                sequence: 3
            )

            displayColumn STDCODE (
                sequence: 4
            )

        )

    )

    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 20
            region: @city-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 8
                clearCache: 8
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @city-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide-nav (
        name: Hide Nav
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction hide-nav-2 (
        name: hide nav
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @city-list
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: jsExpression
            javaScriptExpression: window
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @city-list
            }
            execution {
                sequence: 10
            }
        )

    )

)

