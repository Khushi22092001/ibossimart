    region on-duty-request-list (
        name: On Duty Request List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.COMPANYCODE,
                       a.FINANCIALYEARCODE,
                       getlocationname(a.LOCATIONCODE) as locationname,
                       getdoctypename(a.DOCTYPECODE) as doctypename,
                       a.TOURREQUESTNO,
                       a.TOURREQUESTDATE,
                       getemployeename(a.EMPLOYEECODE) as employeename,
                       a.TRAVELLINGFROMDATE,
                       a.TRAVELLINGTODATE,
                       getcityname(a.FROMPLACECODE) as Fromplace,
                       getcityname(a.VIAPLACECODE) as viaplace,
                       getcityname(a.TOPLACECODE) as toplace,
                       a.PURPOSE,
                       b.TRAVELINGMODENAME,
                       a.HOTELTYPECODE,
                       a.ESTIMATEDTOURCOST,
                       a.TOURADVANCE,
                       a.REMARK,
                       a.CREATOR,
                       a.CREATIONTIME,
                       c.CONVEYANCESCHEMENO,
                       a.DISTANCE,
                       a.TRAVELINGMODECODE,
                       a.IMPRESTACCOUNTCODE,
                       getpartyname(a.ACCOUNTCODE) as accountname,
                       a.MONEYTRANSFERMODECODE,
                       a.MONEYTRANSFERREFERENCENO,
                       a.TRANSACTIONTYPECODE,
                       a.NATUREOFSUPPLYCODE,
                       a.CONVEYANCETYPECODE,
                       a.MODULECODE,
                       a.MODULETNO,
                      '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||9993||':'||:APP_SESSION||'::::'||'P9993_TNO,P9993_REPNAME'||':'||A.Tno||','||'OnDutyRequest'||':NO')||'"><span aria-label="Action"><span class="fa fa-print"  aria-hidden="true" title="Action"></span</span></a>' AS Print
                
                  from TOURREQUEST a , TRAVELINGMODE b , CONVEYANCESCHEME c
                  where a.TRAVELLINGMODECODE = b.TRAVELINGMODECODE(+)
                  and a.CONVEYANCESCHEMETNO = c.tno(+)
                  and a.TOURREQUESTDATE  between :P651_FROMDATE and :P651_TODATE
                  and ( :P651_COMPANY IS NULL OR instr(':'||:P651_COMPANY||':',':'||a.companyCODE||':') > 0 )
                   and ( :P651_LOCATION IS NULL OR instr(':'||:P651_LOCATION||':',':'||a.LOCATIONCODE||':') > 0 )
                and ( :P651_DOCTYPE IS NULL OR instr(':'||:P651_DOCTYPE||':',':'||a.DOCTYPECODE||':') > 0 )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 652
                items: {
                    P652_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 26034014169157310
        }

