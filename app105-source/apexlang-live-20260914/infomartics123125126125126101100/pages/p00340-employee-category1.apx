    pageItem P340_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 220
            region: @fields
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P340_TNO), 'Status')
        }
        sessionState {
            storage: request
        }
    )

    pageItem P340_STATUSRIGHT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 170
            region: @fields
            slot: regionBody
        }
    )

    pageItem P340_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @employee-category
            slot: regionBody
        }
        source {
            formRegion: @employee-category
            column: TNO
            dataType: number
            primaryKey: true
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 60
            region: @employee-category
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 90
            region: @employee-category
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P340_CATEGORYCODE
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 70
            region: @employee-category
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P340_FORMSTATUS
            value: EDITRECORD
        }
    )

    button fail (
        buttonName: Fail
        label: Fail
        layout {
            sequence: 20
            region: @employee-category
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-thumbs-o-down
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 163
                clearCache: 163
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P340_FORMSTATUS
            value: EDITRECORD
        }
    )

    button flow (
        buttonName: Flow
        label: Flow
        layout {
            sequence: 30
            region: @employee-category
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pill
            ]
            icon: fa-workflow
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                items: {
                    P162_TNO: &P2_TNO1.
                }
                clearCache: 162
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P340_FORMSTATUS
            value: EDITRECORD
        }
    )

    button pass (
        buttonName: Pass
        label: Pass
        layout {
            sequence: 10
            region: @employee-category
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-thumbs-o-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 163
                clearCache: 163
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P340_FORMSTATUS
            value: EDITRECORD
        }
    )

    button print (
        buttonName: Print
        label: Print
        layout {
            sequence: 50
            region: @employee-category
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pill
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P340_FORMSTATUS
            value: EDITRECORD
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 80
            region: @employee-category
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P340_CATEGORYCODE
        }
    )

    button status (
        buttonName: Status
        label: Status
        layout {
            sequence: 40
            region: @employee-category
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-comments-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 164
                clearCache: 164
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P340_FORMSTATUS
            value: EDITRECORD
        }
    )

    dynamicAction check-city-name (
        name: Check City Name
        execution {
            sequence: 120
        }
        when {
            event: focusout
            selectionType: items
            items: P340_CITYNAME
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P340_CITYNAME")).length===0 ) {
                        showError("City Name Should Not Empty", 'P340_CITYNAME');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P340_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @print
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.PRINTPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @print
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.PRINTPRIVILEGE= 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-save-button-for-updateprivillege (
        name: DISABLE SAVE BUTTON FOR UPDATEPRIVILLEGE
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @save
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1 FROM MODULEFLOW A , MODULEFLOWUSER B , bossuser C
                    WHERE A.TNO = B.TNO
                    AND A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                    AND B.BOSSUSERCODE = C.BOSSUSERCODE
                    AND C.BOSSUSERNAME = :APP_USER
                    AND B.UPDATEPRIVILEGE = 'NO'
                    UNION ALL
                    Select 1
                      From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.UPDATEPRIVILEGE = 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @save
            }
            execution {
                sequence: 50
            }
            serverSideCondition {
                type: item=value
                item: P340_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @save
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    SELECT 1 FROM MODULEFLOW A , MODULEFLOWUSER B , bossuser C
                    WHERE A.TNO = B.TNO
                    AND A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                    AND B.BOSSUSERCODE = C.BOSSUSERCODE
                    AND C.BOSSUSERNAME = :APP_USER
                    AND B.UPDATEPRIVILEGE = 'YES'
                    UNION ALL
                    Select 1
                      From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.UPDATEPRIVILEGE = 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-status-button (
        name: Disable Status Button
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
