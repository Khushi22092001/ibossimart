page 340 (
    name: Employee Category
    alias: EMPLOYEE-CATEGORY1
    title: Employee Category
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            
            .t-Alert--page.t-Alert--success  {
            
            
                position: relative;
            
            
               // top: 300px;
                top:0px;
            
                left: 0px;
            
            
            }
            
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region employee-category (
        name: Employee Category
        type: form
        source {
            location: localDatabase
            tableName: CATEGORY
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
    )

    pageItem P340_ALLOWEDLATECOMINGTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 80
            region: @employee-category
            slot: regionBody
        }
        source {
            formRegion: @employee-category
            column: ALLOWEDLATECOMINGTIME
            dataType: number
        }
    )

    pageItem P340_ALLOWEDLATEGOINGTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 90
            region: @employee-category
            slot: regionBody
        }
        source {
            formRegion: @employee-category
            column: ALLOWEDLATEGOINGTIME
            dataType: number
        }
    )

    pageItem P340_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P340_CATEGORYCODE (
        type: textField
        label {
            label: Category Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @employee-category
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @employee-category
            column: CATEGORYCODE
            dataType: varchar2
        }
    )

    pageItem P340_CATEGORYNAME (
        type: textField
        label {
            label: Category Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @employee-category
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @employee-category
            column: CATEGORYNAME
            dataType: varchar2
        }
    )

    pageItem P340_CREATOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @employee-category
            slot: regionBody
        }
        source {
            formRegion: @employee-category
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select :GLOBAL_LOGINNAME from Dual
        }
    )

    pageItem P340_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 210
            region: @fields
            slot: regionBody
        }
    )

    pageItem P340_GROUPCODE (
        type: popupLov
        label {
            label: Group Name
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery: SELECT CATEGORYNAME, CATEGORYCODE FROM CATEGORY WHERE ISGROUP='YES' ORDER BY 1
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 50
            region: @employee-category
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @employee-category
            column: GROUPCODE
            dataType: varchar2
        }
    )

    pageItem P340_ISGROUP (
        type: checkbox
        label {
            label: Is Group
            alignment: left
        }
        settings {
            useDefaults: false
            checkedValue: YES
            uncheckedValue: NO
        }
        layout {
            sequence: 40
            region: @employee-category
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
        }
        source {
            formRegion: @employee-category
            column: ISGROUP
            dataType: varchar2
        }
    )

