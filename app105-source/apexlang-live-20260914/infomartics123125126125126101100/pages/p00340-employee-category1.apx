            valueProtected: false
        }
        layout {
            sequence: 180
            region: @fields
            slot: regionBody
        }
    )

    pageItem P340_REMARK (
        type: textField
        label {
            label: Remark
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 60
            region: @employee-category
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
