    dynamicAction get-dfa-amt (
        name: Get DFA_AMT
        execution {
            sequence: 230
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @footerdetail
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var widget      = apex.region('Detail').widget();
                    var grid        = widget.interactiveGrid('getViews','grid');  
                    var model = grid.getSelectedRecords(); 
                    var jsonData     = [];
                    
                    model.forEach(function(r) {
                        var record = r;   
                        jsonData.push(record);
                    })
                    
                    let value = null;
                    value = jsonData[0][14];
                    
                    $s('P171_DFAMOUNT',value);
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

