            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pillEnd
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
            }
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
