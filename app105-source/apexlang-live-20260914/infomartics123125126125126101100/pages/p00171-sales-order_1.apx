    dynamicAction insert-detail (
        name: Insert detail
        execution {
            sequence: 870
        }
        when {
            event: click
            selectionType: button
            button: @getporeceiptdata
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P171_PORECEIPTTNO is not null and :P171_STATUS <> 'ACTIVE' then
                        delete from salesorderdetail where tno = :P171_TNO;
                        for vpo in (
                                select
                    
                                b.itemcode,
                                b.itemspecificationcode,
                                b.description,
                                b.quantity1 - nvl(c.quantity1,0) quantity1,
                                b.quantity2,
                                b.ratemeasuringunitcode,
                                b.rate,
                                b.amount,
                                b.footeramount,
                                b.totalamount,
                                b.sno
                            From poreceipt a,
                           poreceiptdetail b,
                           (Select dd.tno,
                                   dd.itemcode,
                                   dd.itemspecificationcode,
                                   Sum(cc.quantity1) As Quantity1
                              From salesorder       bb,
                                   salesorderdetail cc,
                                   poreceiptdetail dd
                             Where bb.tno = cc.tno
                               And bb.poreceipttno = dd.tno(+)
                               And cc.itemcode = dd.itemcode
                               And cc.itemspecificationcode = dd.itemspecificationcode
                             Group By dd.tno, dd.itemcode, dd.itemspecificationcode) c
                     Where getdocumentstatuscode('PORECEIPT', a.TNO) = 'ACTIVE'
                      -- and a.partycode = :P171_PARTYCODE
                       and a.tno = :P171_PORECEIPTTNO
                       And a.tno = b.tno(+)
                       And a.tno = c.tno(+)
                       And b.itemcode = c.itemcode(+)
                       And b.itemspecificationcode = c.itemspecificationcode(+)
                       and b.quantity1 - nvl(c.quantity1,0) > 0
                       order by b.sno
                        
                        ) loop
                            insert into salesorderdetail
                                (
                                    tno,
                                    sno,
                                    itemcode,
                                    itemspecificationcode,
                                    description,
                                    quantity1,
                                    quantity2,
                                    ratemeasuringunitcode,
                                    rate,
                                    amount,
                                    footeramount,
                                    totalamount
                                )
                                VALUES (
                                    :P171_TNO,
                                    GLOBALTNO.NEXTVAL,
                                    VPO.ITEMCODE,
                                    vpo.itemspecificationcode,
                                    vpo.description,
                                    vpo.quantity1,
                                    vpo.quantity2,
                                    vpo.ratemeasuringunitcode,
                                    vpo.rate,
                                    vpo.amount,
                                    vpo.footeramount,
                                    vpo.totalamount
                                );
                        
                        end loop;
                    
                        
                    end if;
                    ```
                itemsToSubmit: [
                    P171_PORECEIPTTNO
                    P171_STATUS
                    P171_TNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :P171_PORECEIPTTNO is not null and :P171_STATUS <> 'ACTIVE' then
                        delete from salesorderdetailfooter where tno = :P171_TNO;
                        insert into salesorderdetailfooter
                        (
                            TNO, 
                            SNO, 
                            SN, 
                            SERIALNO, 
                            FOOTERHEADCODE, 
                            LEGENDSCODE, 
                            FOOTERPERCENT, 
                            FOOTERVALUE
                        )
                        (
                            select
                            :P171_TNO, 
                            c.SNO, 
                            globaltno.nextval, 
                            1, 
                            a.FOOTERHEADCODE, 
                            a.LEGENDSCODE, 
                            a.FOOTERPERCENT, 
                            a.FOOTERVALUE
                            from poreceiptdetailfooter a, poreceiptdetail b, salesorderdetail c
                            where a.tno = :P171_PORECEIPTTNO 
                            and a.tno = b.tno   
                            and c.tno = :P171_TNO
                            and c.itemcode = b.itemcode
                            and c.itemspecificationcode = b.itemspecificationcode
                            and a.sno=b.sno
                        );
                        
                    end if;
                    ```
                itemsToSubmit: [
                    P171_PORECEIPTTNO
                    P171_STATUS
                    P171_TNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

