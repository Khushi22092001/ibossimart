        column RATEMEASURINGUNITCODE (
            type: selectList
            heading {
                heading: Rate Unit
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select measuringunitname , measuringunitcode
                    from measuringunit
                    where measuringunitcode in (select measuringunitcode1 from item where itemcode = :ITEMCODE)
                    union all
                    select measuringunitname , measuringunitcode
                    from measuringunit
                    where measuringunitcode in (select measuringunitcode2 from item where itemcode = :ITEMCODE)
                    
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ITEMCODE
                itemsToSubmit: [
                    ITEMCODE
                    UNIT2
                ]
            }
            layout {
                sequence: 140
                group: @rate
            }
            source {
