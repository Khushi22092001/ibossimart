    process validate-detail-qty-and-master-qty-create (
        name: validate detail qty and master qty CREATE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    sumq1 number:=0;
                begin
                    if :P171_ISOPENSPEC = 'YES' then
                        select round(sum(nvl(quantity1,0)),3) into sumq1 from salesorderdetail 
                        where tno=:P171_TNO;
                        if sumq1<>round(to_number(:P171_QUANTITY),3) then
                            raise_application_error(-20000,'Sum Of Detail Qty Not Matching with Master Qty. Detail - '||sumq1|| ' Master - '||:P171_QUANTITY);
                        end if;
                    end if;
                   
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 12568215190489935
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

