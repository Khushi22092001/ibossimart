    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.ROWID,
                       A.TNO,
                       A.SNO,
                       A.ITEMCODE,
                       A.ITEMSPECIFICATIONCODE,
                       A.DESCRIPTION,
                       A.QUANTITY1,
                       A.QUANTITY2,
                       A.RATEMEASURINGUNITCODE,
                       A.INCLUSIVETAX,
                       A.RATEINCLUSIVETAX,
                       A.RATE,
                       A.AMOUNT,
                       A.FOOTERAMOUNT,
                       A.TOTALAMOUNT,
                       A.REMARK,
                       A.LOWERTOLERANCEPERCENT,
                       A.HIGHERTOLERANCEPERCENT,
                       A.DESPATCHADVICEQUANTITY1,
                       A.DESPATCHADVICEQUANTITY2,
                       A.CCINVOICEQUANTITY1,
                       A.CCINVOICEQUANTITY2,
                       A.TAXRULECODE,
                       --B.MEASURINGUNITCODE1 AS UNIT1,
                       --B.MEASURINGUNITCODE2 AS UNIT2,
                       GetMeasuringUnitNameFromItem(itemcode) as unit1,
                       GetMeasuringUnit2NameFromItem(itemcode) as unit2,
                       'FD' as FD
                  from SALESORDERDETAIL A
                  where A.tno = :P171_TNO
                    --AND A.ITEMCODE = B.ITEMCODE
                ```
            pageItemsToSubmit: P171_TNO
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 350
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                    //Tab and Shift-Tab will skip over cells that are read-only
                    options.defaultGridViewOptions = {  
                        skipReadonlyCells: true  
                        
                    }
                    return options;
                }
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 168443915065207019
        }

