    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P171_Tno is null then
                        Select GlobalTno.NextVal into :P171_Tno From Dual;
                     end if;
                    ----
                    if :P171_SALESORDERNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P171_LocationCode,
                					:P171_DocTypeCode,
                					NULL,
                					TO_DATE(:P171_SALESORDERDATE, 'DD-MM-RRRR')
                				);
                        :P171_SALESORDERNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P171_LocationCode,
                                    :P171_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P171_SALESORDERDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 168693682968548553
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P171_TNO is null then
                    :P171_TNO := GlobalTNo.nextval;
                    :P171_FORMSTATUS := 'NEWRECORD';
                else
                    
                    :P171_FORMSTATUS := 'EDITRECORD';
                End if;
                
                :P171_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P171_TNO), 'Status');
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 168692804614548553
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P171_MODULEFLOW := 'YES';
                   else
                       :P171_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P171_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P171_ONTHETABLE := 'YES' ;
                   else
                       :P171_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 168693296922548553
        }
    )

    process initialize-form-e-mail (
