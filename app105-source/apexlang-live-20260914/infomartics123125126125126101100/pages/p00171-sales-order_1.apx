    process savepurchaseorderfooter (
        name: SavePurchaseOrderFooter
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    delete from salesorderfooter where tno = :P171_TNO;
                    insert into salesorderfooter
                        (tno ,
                        SNO,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   SELECT X.TNO,
                                   GLOBALTNO.NEXTVAL,
                                   X.FOOTERHEADCODE,
                                   X.SUMOFVALUE
                             FROM 
                            (select 
                                :P171_TNO AS TNO ,               
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from salesorderdetailfooter
                            where tno = :P171_TNO
                            group by FOOTERHEADCODE
                            ) X
                        );
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 168695282540548554
        }
    )

