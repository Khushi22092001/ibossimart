    dynamicAction new (
        name: New
        execution {
            sequence: 130
        }
        when {
            selectionType: items
            items: P342_EFFECTIVEDATE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                      	:P342_OLDDEPARTMENTCODE  := getEmployeeDepartmentCode(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1);
                      	:P342_OLDDESIGNATIONCODE := getEmployeeDesignationCode(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1);
                      	:P342_OLDSHIFTCODE       := getEmployeeSHIFTCode(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1);
                      	:P342_OLDLOCATIONCODE    := getEmployeeLocationCode(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1);
                      	:P342_OLDSTAFFTYPECODE   := getEmployeeStaffTypeCode(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1);
                      	:P342_OLDWeeklyOffDay    := getEmployeeWeeklyOffDay(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1 );
                      	:P342_OLDEmployeeid      := getemployeeemployeeid(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1 );
                      	--:P342_OLDIncentiveSchemeCode:= getEmployeeIncentiveSchemeCode(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1);
                      	--:P342_OLDBranchCode      := getEmployeeBranchCode(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1);
                      	--:P342_OLDBonusSchemeCode := getEmployeeBonusSchemeCode(:P342_EmployeeCode, TO_DATE(:P342_EffectiveDate,'DD-MM-YYYY') - 1);
                    END;
                    ```
                itemsToSubmit: P342_EFFECTIVEDATE
                itemsToReturn: [
                    P342_OLDCATEGORYCODE
                    P342_OLDDEPARTMENTCODE
                    P342_OLDDESIGNATIONCODE
                    P342_OLDSTAFFTYPECODE
                    P342_OLDSHIFTCODE
                    P342_OLDWEEKLYOFFDAY
                    P342_OLDCOMPANYCODE
                    P342_OLDLOCATIONCODE
                    P342_OLDEMPLOYEEID
                ]
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P342_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction populate-detail (
        name: Populate detail
        execution {
            sequence: 110
        }
        when {
            event: focusout
            selectionType: items
            items: P342_TOTALCHEQUE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        tStartNo     Number;
                        tTotalNo     NUmber;
                        i            Number;
                        J            Number;
                        tCHEQUEno Varchar2(100);
                    begin
                        if NVL(:P342_CHEQUENOSTART,0) = 0 then
                            raise_application_error(
                                        -20000,
                                        'Please Enter CHEQUE Start No'
                                    );
                         else
                             tStartNo := :P342_CHEQUENOSTART ;
                        end if;
                    
                        if NVL(:P342_TOTALCHEQUE,0) = 0 then
                            raise_application_error(
                                        -20000,
                                        'Please Enter Total CHEQUE No'
                                    );
                        else
                            tTotalNo := :P342_TOTALCHEQUE ;
                        end if;
                      /*
                      If Not
                          apex_collection.collection_exists(p_collection_name => 'CHEQUERECEIPT') Then
                        apex_collection.create_collection(p_collection_name => 'CHEQUERECEIPT');
                      Else
                        apex_collection.truncate_collection(p_collection_name => 'CHEQUERECEIPT');
                      End If;
                      ----
                      */
                      DELETE FROM CHEQUERECEIPTDETAIL
                      WHERE TNO = :P342_TNO;
                    
                      i := to_char(tStartNo, :P342_formatstring);
                      J := 0;
                      loop
                            tCHEQUENo := :P342_CHEQUENOPREFIX||TO_CHAR(I)||:P342_CHEQUENOSUFFIX ;
                    
                           /*apex_collection.add_member(p_collection_name => 'CHEQUERECEIPT',
                                                   p_N001            => :P342_TNO,
                                                   P_N002            => GLOBALTNO.NEXTVAL,
                                                   p_C001            => tCHEQUENo
                                                   ) ;
                            */ 
                            J := J+1;
                             insert into CHEQUEreceiptdetail
                             ( tno,SERIALNO,CHEQUEno)
                             values ( :P342_TNO,J,tCHEQUENo)       
                             ;
                    
                    	  i := to_char(i + 1, :P342_FORMATSTRING);
                          exit  when i > tStartNo + tTotalNo - 1;                        
                    
                    
                      end loop;
                    end ;
                    ```
                itemsToSubmit: [
                    P342_CHEQUENOPREFIX
                    P342_CHEQUENOSTART
                    P342_TOTALCHEQUE
                    P342_CHEQUENOSUFFIX
                    P342_FORMATSTRING
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

