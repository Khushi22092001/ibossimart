page 164 (
    name: Status
    alias: STATUS
    title: Status
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        width: 300
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select DOCUMENTSTATUSCODE,
                       DOCUMENTSTATUSNAME,
                       DOCUMENTDELETION,
                       DOCUMENTUPDATION,
                       DOCUMENTSTATUSCHANGE
                  from DOCUMENTSTATUS
                  where (:P164_TNO IS NULL OR DOCUMENTSTATUSCODE = 'LOOSE' )
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        advanced {
            htmlDomId: DETAIL
            regionDisplaySelector: true
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 10443942211090034
        }

        savedReport 270673 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @DOCUMENTSTATUSNAME
                layout {
                    show: false
                    sequence: 5
                }
            )

            displayColumn (
                column: @DOCUMENTSTATUSCODE
                layout {
                    width: 142.25
                    sequence: 1
                }
            )

            displayColumn (
                column: @DOCUMENTDELETION
                layout {
                    show: false
                    width: 164.25
                    sequence: 2
                }
            )

            displayColumn (
                column: @DOCUMENTUPDATION
                layout {
                    show: false
                    width: 88.25
                    sequence: 3
                }
            )

            displayColumn (
                column: @DOCUMENTSTATUSCHANGE
                layout {
                    show: false
                    sequence: 4
                }
            )

        )

        column DOCUMENTDELETION (
            type: textField
            heading {
                heading: Documentdeletion
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: DOCUMENTDELETION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DOCUMENTSTATUSCHANGE (
            type: textField
            heading {
                heading: Documentstatuschange
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: DOCUMENTSTATUSCHANGE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DOCUMENTSTATUSCODE (
            type: textField
            heading {
                heading: Document Status
            }
            layout {
                sequence: 10
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: DOCUMENTSTATUSCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column DOCUMENTSTATUSNAME (
            type: textarea
            heading {
                heading: Document Status
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: DOCUMENTSTATUSNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column DOCUMENTUPDATION (
            type: textField
            heading {
                heading: Documentupdation
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: DOCUMENTUPDATION
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    pageItem P164_DOCUMENTSTATUSCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
        }
    )

    pageItem P164_TNO (
        type: hidden
        layout {
            sequence: 20
            region: @new
            slot: regionBody
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction back (
        name: Back
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @new
        }

        action native-dialog-close (
            action: closeDialog
            settings {
                itemsToReturn: [
                    P164_DOCUMENTSTATUSCODE
                    P164_TNO
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var documentstatuscode,
                    model = this.data.model;
                    
                    documentstatuscode = model.getValue( this.data.selectedRecords[0], "DOCUMENTSTATUSCODE");
                    
                    apex.item( "P164_DOCUMENTSTATUSCODE" ).setValue (documentstatuscode);
                    
                    ```
            }
            affectedElements {
                selectionType: items
                items: P164_DOCUMENTSTATUSCODE
            }
            execution {
                sequence: 10
            }
        )

    )

)

