page 172 (
    name: Terms & Condistion HeadList
    alias: TERMS-CONDISTION-HEADLIST
    title: Terms & Condistion HeadList
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region terms-condistion-headlist (
        name: Terms & Condistion HeadList
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       TERMSANDCONDITIONHEADCODE,
                       TERMSANDCONDITIONHEADNAME,
                       REMARK,
                       CREATOR,
                       SERIALNO,
                       CREATIONTIME
                  from TERMSANDCONDITIONHEAD
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 173
                items: {
                    P173_TNO: \#TNO#\
                    P173_FORMSTATUS: EDITRECORD
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 168788417134618487
        }

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 54
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 24
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column SERIALNO (
            type: plainText
            heading {
                heading: Serial No
                alignment: end
            }
            layout {
                sequence: 34
                columnAlignment: end
            }
            appearance {
                formatMask: 990
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column TERMSANDCONDITIONHEADCODE (
            type: plainText
            heading {
                heading: Terms and Condition Head
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TERMSANDCONDITIONHEADNAME (
            type: plainText
            heading {
                heading: Terms and Condition Name
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Terms & Condistion HeadList
        }

        savedReport 1688741 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATIONTIME (
                sequence: 5
            )

            displayColumn CREATOR (
                sequence: 4
            )

            displayColumn REMARK (
                sequence: 6
            )

            displayColumn SERIALNO (
                sequence: 3
            )

            displayColumn TERMSANDCONDITIONHEADCODE (
                sequence: 1
            )

            displayColumn TERMSANDCONDITIONHEADNAME (
                sequence: 2
            )

            sort (
                column: TERMSANDCONDITIONHEADCODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: Create
        label: Add New
        layout {
            sequence: 20
            region: @terms-condistion-headlist
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            cssClasses: button-15
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 173
                items: {
                    P173_FORMSTATUS: NEWRECORD
                }
                clearCache: 173
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @terms-condistion-headlist
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

