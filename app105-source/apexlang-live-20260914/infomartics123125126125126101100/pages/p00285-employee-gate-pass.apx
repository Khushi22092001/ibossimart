    pageItem P285_DOCTYPECODE (
        type: popupLov
        label {
            label: Doctype
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.DocTypeName as d,
                	a.DocTypeCode as r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c, Module d
                where a.DocTypeCode = b.DocTypeCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode
                    and c.CompanyCode = :global_CompanyCode
                    and d.EntryPageNo = :APP_PAGE_ID
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @employee-gate-pass
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
