    pageItem P364_MODULE (
        type: selectOne
        label {
            label: Module
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT Distinct
                     m.MODULENAME as d,
                     a.MODULE_NAME as r
                FROM IMART_TRANSACTIONS_VW a
                LEFT JOIN MODULE m ON m.MODULECODE = a.MODULE_NAME
                LEFT JOIN MODULEGROUP mg ON mg.MODULEGROUPCODE = m.MODULEGROUPCODE
                WHERE  (:P364_MODULEGROUP IS NULL OR instr(':'||:P364_MODULEGROUP||':',':'||m.ModuleGroupCode||':') > 0 )
                
                
                
                ```
        }
        cascadingLov {
            parentItems: P364_MODULEGROUP
            itemsToSubmit: P364_MODULE
            parentRequired: false
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 3
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
            valuePlaceholder: -- Select Module Name --
        }
    )

    pageItem P364_MODULEGROUP (
        type: selectOne
