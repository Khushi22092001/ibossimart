page 364 (
    name: Transactional Summary Report
    alias: TRANSACTIONAL-SUMMARY-REPORT
    title: Transactional Summary Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #TSUMMARY tr .a-IRR-aggregate{
                background-color: #505f6d !important;
                color: white;
            }
            
            #TSUMMARY tr .a-IRR-header{
                background-color: #505f6d !important;
                color: white;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                js-useLocalStorage
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    region transactional-summary (
        name: Transactional Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    MODULENAME,
                    PAGENO,
                    SEQ,
                
                    ACTIVE,
                    CANCELED,
                    PREPARING,
                    SHORTCLOSED,
                    CLOSED,
                    "NON-ACTIVE",
                
                    apex_util.prepare_url(
                        'f?p=' || :APP_ID || ':' || PAGENO || ':' || :APP_SESSION ||
                        '::NO::P' || PAGENO || '_FROMDATE,P' || PAGENO || '_TODATE,P'||PAGENO||'_LOCATION:' ||
                        :P364_FROMDATE || ',' || :P364_TODATE || ',' || :P364_LOCATION
                    ) AS REDIRECT_URL
                
                FROM (
                    SELECT 
                        m.MODULENAME,
                        m.PAGENO,
                        a.STATUS,
                        a.TNO,
                        a.SEQ
                    FROM IMART_TRANSACTIONS_VW a
                    LEFT JOIN MODULE m 
                        ON a.MODULE_NAME = m.MODULECODE
                    WHERE a.TRANSACTION_DATE BETWEEN :P364_FROMDATE AND :P364_TODATE
                
                      AND (:P364_LOCATION IS NULL OR 
                           INSTR(':'||:P364_LOCATION||':', ':'||a.LocationCode||':') > 0)
                
                      AND (:P364_COMPANY IS NULL OR 
                           INSTR(':'||:P364_COMPANY||':', ':'||a.CompanyCode||':') > 0)
                
                      AND (:P364_MODULE IS NULL OR 
                           INSTR(':'||:P364_MODULE||':', ':'||a.Module_Name||':') > 0)
                
                      AND (:P364_MODULEGROUP IS NULL OR 
                           INSTR(':'||:P364_MODULEGROUP||':', ':'||m.ModuleGroupCode||':') > 0)
                )
                PIVOT (
                    COUNT(TNO)
                    FOR STATUS IN (
                        'ACTIVE'        AS ACTIVE,
                        'CANCELED'      AS CANCELED,
                        'PREPARING'     AS PREPARING,
                        'SHORTCLOSED'   AS SHORTCLOSED,
                        'CLOSED'        AS CLOSED,
                        NULL            AS "NON-ACTIVE"
                    )
                )
                ORDER BY SEQ;
                ```
            pageItemsToSubmit: [
                P364_COMPANY
                P364_LOCATION
                P364_FROMDATE
                P364_TODATE
                P364_MODULEGROUP
                P364_MODULE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: TSUMMARY
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
