    dynamicAction refresh-the-report-on-change (
        name: Refresh the Report on Change
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P364_COMPANY
                P364_LOCATION
                P364_FROMDATE
                P364_TODATE
                P364_MODULEGROUP
                P364_MODULE
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @transactional-summary
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process fetch-global-fin-year-begin-and-end-date (
        name: Fetch Global Fin Year Begin and End date
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P364_GLOBAL_FINANCIALYEARBEGIN  := :GLOBAL_FINANCIALYEARBEGIN;
                    :P364_GLOBAL_FINANCIALYEAREND  := :GLOBAL_FINANCIALYEAREND;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 33764580216181722
        }
    )

)

