    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                                 if :P654_STATUS = 'ACTIVE' then
                            
                                    CREATEPAYMENTADVICEFORPO(:P654_TNO);
                    
                                  end if;
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: P654_STATUS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P654_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P654_TNO is null then
                    :P654_TNO := GlobalTNo.nextval;
                    :P654_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P654_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P654_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P654_TNO), 'Status');
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 26145176225404684
        }
    )

    process get-traveling-mode (
        name: Get Traveling Mode
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getmodulecodeforpageno(:APP_PAGE_ID);
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                
                     if nvl(tmp,0) > 0 and :P654_TRAVELINGMODECODE is null then
                            setCodeNext(tModuleCode);
                	  		:P654_TRAVELINGMODECODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 26429486142241327
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P654_MODULEFLOW := 'YES';
                   else
                       :P654_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P654_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P654_ONTHETABLE := 'YES' ;
                   else
                       :P654_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 26145410710405990
        }
    )

