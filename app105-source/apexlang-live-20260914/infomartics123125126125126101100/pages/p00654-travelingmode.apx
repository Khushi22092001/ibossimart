    process travelingmodedetail-save-interactive-grid-data (
        name: TRAVELINGMODEDETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @travelingmodedetail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                           IF :SNO IS NULL then
                                select globaltno.nextval into :SNO from dual;
                           end if;
                            Insert Into TRAVELINGMODEDETAIL ( 
                                        TNO,
                                        SNO,
                                        ATTRIBUTECODE, 
                                        REMARK 
                            )
                            Values (
                                        :TNO,
                                        :SNO,
                                        :ATTRIBUTECODE, 
                                        :REMARK 
                             );
                  
                        when 'U' then
                            update TRAVELINGMODEDETAIL Set
                                        TNO = :TNO,
                                        SNO = :SNO,
                                        ATTRIBUTECODE = :ATTRIBUTECODE, 
                                        REMARK = :REMARK
                            WHERE TNO = :P654_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From TRAVELINGMODEDETAIL
                            Where TNo = :P654_TNO
                              and SNO = :SNO
                              ;
                    
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 26072303530214516
        }
    )

