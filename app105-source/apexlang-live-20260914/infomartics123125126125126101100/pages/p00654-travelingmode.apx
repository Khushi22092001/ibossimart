    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P654_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P654_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P654_TNO,:P654_STATUS);
                    
                    declare
                        tpaymentadvice number;
                    
                    begin
                        SELECT COUNT(A.TNO) INTO tpaymentadvice
                    	FROM PAYMENTADVICE A
                    	WHERE A.MODULETNO = :P654_TNO ;
                    
                        if nvl(tpaymentadvice, 0) = 0 then
                            if :P654_STATUS = 'ACTIVE' then
                            
                                CREATEPAYMENTADVICEFORPO(:P654_TNO);
                    
                            end if;
                    
                        end if;
                    
                    end;
                    ```
                itemsToSubmit: P654_STATUS
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P654_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
