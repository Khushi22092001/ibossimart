    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P242_TNO is null then
                    :P242_TNO := GlobalTNo.nextval;
                    :P242_FORMSTATUS := 'NEWRECORD';
                else
                    :P242_FORMSTATUS := 'EDITRECORD';
                End if;
                
                :P242_STATUS := nvl(GetDocumentStatusCode('RTGSLETTER', :P242_TNO), 'Status');
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 35795877629021174
        }
    )

