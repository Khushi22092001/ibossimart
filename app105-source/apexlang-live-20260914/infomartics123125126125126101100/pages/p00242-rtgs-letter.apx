    region detail (
        name: DETAIL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno, a.sno, a.paymentadvicetno, a.amount, a.remark, c.partyname,c.printname, a.partybankcode
                  From RTGSLETTERdetail A, paymentadvice b, party c, bank d
                  where a.paymentadvicetno = b.tno(+)
                    and b.partycode = c.partycode(+)
                    and a.partybankcode = d.bankcode(+)
                    and a.tno = :P242_TNO
                ```
            pageItemsToSubmit: P242_TNO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                    //Tab and Shift-Tab will skip over cells that are read-only
                    options.defaultGridViewOptions = {  
                        skipReadonlyCells: true  
                        
                    }
                    return options;
                }
                
                
                ```
        }
        advanced {
            savedReportMappingIdentifier: 590024662370998790
        }

