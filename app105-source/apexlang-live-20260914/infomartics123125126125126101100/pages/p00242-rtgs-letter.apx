    region rtgs-letter (
        name: RTGS Letter
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.TNO,
                       A.COMPANYCODE,
                       A.FINANCIALYEARCODE,
                       A.LOCATIONCODE,
                       A.DOCTYPECODE,
                       A.RTGSLETTERNO,
                       A.RTGSLETTERDATE,
                       A.ACCOUNTCODE,
                       A.CHEQUENO,
                       A.REMARK,
                       A.CREATOR,
                       A.CREATIONTIME,
                       A.MONEYTRANSFERMODECODE,
                	   NVL(getdocumentstatuscode(getmodulecodeforpageno(:APP_PAGE_ID),TNO),'STATUS') AS STATUS
                  From RTGSLETTER A
                
                ```
            pageItemsToSubmit: P242_TNO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P242_ACCOUNTCODE (
        type: popupLov
        label {
            label: Bank
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                a.PartyName as AccountName,
                a.PartyCode as AccountCode
                
                From Party a
                where a.PartyTypeCode='BANK'
                Order by a.PartyName
                /*Select Distinct
                a.PartyName as AccountName,
                b.AccountCode as AccountCode
                
                From Party a, PaymentAdvice b, Location c
                Where a.PartyCode=b.AccountCode
                and b.LocationCode=c.LocationCode
                and a.PartyTypeCode='BANK'
                and b.MoneyTransferModeCode IN ('NEFT','RTGS')
                and b.LocationCode=:P242_LocationCode
                Order by a.PartyName
                */
                ```
        }
        cascadingLov {
            parentItems: P242_LOCATIONCODE
            itemsToSubmit: P242_LOCATIONCODE
        }
        layout {
            sequence: 110
            region: @rtgs-letter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @rtgs-letter
            column: ACCOUNTCODE
            dataType: varchar2
        }
    )

