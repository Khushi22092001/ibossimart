    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 100
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 130
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: item=value
            item: P242_FORMSTATUS
            value: NEWRECORD
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 110
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P242_FORMSTATUS
            value: EDITRECORD
        }
    )

    button fail (
        buttonName: Fail
        label: Fail
        layout {
            sequence: 60
            region: @buttons
