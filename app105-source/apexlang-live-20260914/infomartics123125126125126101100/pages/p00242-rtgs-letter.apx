    process detail-save-interactive-grid-data (
        name: DETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            if :SNO is null then
                                select globaltno.nextval into :sno from dual;
                            end if;
                            Insert Into RTGSLETTERDETAIL  (                 
                                    TNO,
                                    SNO,
                                    PAYMENTADVICETNO,
                                    AMOUNT,
                                    PARTYBANKCODE,
                                    REMARK
                            )
                            Values (
                                :TNO,
                                to_number(:SNO),
                                :PAYMENTADVICETNO,
                                :AMOUNT,
                                :PARTYBANKCODE,
                                :REMARK
                            );
                        
                        when 'U' then
                --RAISE_APPLICATION_ERROR(-20002,:PARTYBANKCODE);
                         update RTGSLETTERDETAIL  Set
                                TNO=:TNO,
                                SNO=to_number(:SNO),
                                PAYMENTADVICETNO=:PAYMENTADVICETNO,
                                AMOUNT=:AMOUNT,
                                PARTYBANKCODE=:PARTYBANKCODE,
                                REMARK=:REMARK
                
                            WHERE TNO = :P242_TNO
                              and SNO = :SNO
                              ;
                        when 'D' then
                            Delete From RTGSLETTERDETAIL 
                            Where TNo = :P242_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 35778659504021159
        }
    )

