        column PARTYBANKCODE (
            type: popupLov
            heading {
                heading: Party Bank
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                      Select d.bankname, b.bankcode
                              From party a, partybank b, paymentadvice c, bank d
                             Where a.tno = b.tno
                               And b.bankcode = d.bankcode
                               And a.partycode = c.partycode
                               And c.tno = :PAYMENTADVICETNO
                    ```
            }
            cascadingLov {
                parentColumns: PAYMENTADVICETNO
                itemsToSubmit: PAYMENTADVICETNO
