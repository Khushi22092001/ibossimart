    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P658_Tno is null then
                        Select GlobalTno.NextVal into :P658_Tno From Dual;
                     end if;
                    ----
                    if :P658_TOURREQONSPECIALAPPROVALNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P658_LocationCode,
                					:P658_DocTypeCode,
                					NULL,
                					TO_DATE(:P658_TOURREQONSPECIALAPPROVALDATE, 'DD-MM-RRRR')
                				);
                        :P658_TOURREQONSPECIALAPPROVALNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P658_LocationCode,
                                    :P658_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P658_TOURREQONSPECIALAPPROVALDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 26384803582162819
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P658_TNO is null then
                    :P658_TNO := GlobalTNo.nextval;
                    :P658_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P658_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P658_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P658_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 26384016319162819
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P658_MODULEFLOW := 'YES';
                   else
                       :P658_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P658_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P658_ONTHETABLE := 'YES' ;
                   else
                       :P658_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 26384492770162819
        }
    )

