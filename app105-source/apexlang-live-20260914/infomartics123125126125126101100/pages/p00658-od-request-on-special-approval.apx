    dynamicAction insert-into-detail (
        name: Insert into detail
        execution {
            sequence: 120
        }
        when {
            event: click
            selectionType: button
            button: @getrecord
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from TOURREQONSPECIALAPPROVALDETAIL where tno = :P658_TNO;
                    insert into TOURREQONSPECIALAPPROVALDETAIL
                    (
                        TNO,
                        SNO,
                        --EXPENSETYPECODE,
                        ACCOUNTCODE,
                        MODEOFTRAVELCODE,
                        CATEGORYCODE,
                        CLASSOFCITYCODE,
                        MEASURINGUNITCODE,
                        --RATE,
                        REMARK,
                        ISBILLREQUIRED
                    )
                    (
                        select 
                            :P658_TNO,
                            globaltno.nextval,
                           --EXPENSETYPECODE,
                            ACCOUNTCODE,
                            MODEOFTRAVELCODE,
                            CATEGORYCODE,
                            CLASSOFCITYCODE,
                            MEASURINGUNITCODE,
                           -- RATE,
                            REMARK,
                            ISBILLREQUIRED
                        from tourrequestdetail
                        where tno = :P658_TOURREQUESTTNO
                    );
                    ```
                itemsToSubmit: [
                    P658_TNO
                    P658_TOURREQUESTTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
