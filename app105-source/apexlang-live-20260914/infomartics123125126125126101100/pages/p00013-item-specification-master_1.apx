    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P13_MODULEFLOW := 'YES';
                   else
                       :P13_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P13_ONTHETABLE := 'YES' ;
                   else
                       :P13_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 145002520506558776
        }
    )

    process gettno (
        name: gettno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P13_ITEMTNO IS NULL then
                    :P13_FORMSTATUS := 'NEWRECORD';
                    select globaltno.nextval into :P13_SPECIFICATIONCODE from dual;
                  else 
                    :P13_FORMSTATUS := 'EDITRECORD';
                end if;
                
                if :P13_SNO is null then
                    :P13_SNO := globaltno.nextval;
                end if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 145002282283557868
        }
    )

    process item-specification-detail-save-interactive-grid-data (
        name: Item Specification Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @item-specification-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into itemSpecificationdetail (                 
                                    TNO,
                                    SNO,
                                    sn,
                                    ITEMCHARACTERISTICSCODE,
                                    MCVALUESNO,
                                    ISCHARACTERISTICSINCLUDE,
                                    VALUE
                            )
                            Values (
                                :P13_ITEMTNO,
                                :P13_SNO,
                                globaltno.nextval,
                                :ITEMCHARACTERISTICSCODE,
                                :MCVALUESNO,
                                :P13_ISCHARACTERISTICSINCLUDE,
                                :VALUE
                
                            );
                        
                        when 'U' then
                            update itemSpecificationdetail Set
                                 TNO=:TNO,
                                    SNO=:SNO,
                                    ITEMCHARACTERISTICSCODE=:ITEMCHARACTERISTICSCODE,
                                    MCVALUESNO=:MCVALUESNO,
                                    ISCHARACTERISTICSINCLUDE=:P13_ISCHARACTERISTICSINCLUDE,
                                    VALUE=:VALUE
                            WHERE TNO = :P13_ITEMTNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From itemSpecificationdetail
                            Where TNo = :P13_ITEMTNO
                              and SNO = :SNO
                              and ITEMCHARACTERISTICSCODE = :ITEMCHARACTERISTICSCODE
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 144956352086384712
        }
    )

