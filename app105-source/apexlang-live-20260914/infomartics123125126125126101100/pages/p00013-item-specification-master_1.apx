    dynamicAction set-specs (
        name: Set Specs_1
        execution {
            sequence: 200
        }
        when {
            event: focusout
            selectionType: region
            region: @item-specification-detail
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var widget      = apex.region('ITEMDETAIL').widget();
                    var grid        = widget.interactiveGrid('getViews','grid');  
                    var model       = grid.model; 
                    var jsonData     = [];
                    
                    model.forEach(function(r) {
                        var record = r;
                        var value1 = model.getValue(record,'TNO');
                        var value2 = model.getValue(record,'SNO');
                       
                        jsonData.push(record);
                    
                    
                    })
                    //console.log(jsonData);
                    
                    var extractedData = [];
                    
                    jsonData.forEach(function(record) {
                      var ansValue = "";
                      
                      record.forEach(function(cell, columnIndex) {
                    
                        if (columnIndex == 4 ) {
                          extractedData.push(cell);
                        }
                      });
                    });
                    
                    
                    var output = extractedData.join("-");
                    
                    $s('P13_SPECIFICATIONCODE',output);
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-specs-on-lose-focus (
        name: Set Specs on lose focus
        execution {
            sequence: 190
        }
        when {
            event: focusout
            selectionType: region
            region: @item-specification-detail
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var widget      = apex.region('ITEMDETAIL').widget();
                    var grid        = widget.interactiveGrid('getViews','grid');  
                    var model       = grid.model; 
                    var jsonData     = [];
                    var sp = apex.item('P13_SEPARATER').getValue();
                    
                    model.forEach(function(r) {
                        var record = r;
                        var value1 = model.getValue(record,'TNO');
                        var value2 = model.getValue(record,'SNO');
                       
                        jsonData.push(record);
                    
                    
                    })
                    
                    
                    var extractedData = [];
                    
                    jsonData.forEach(function(record) {
                      var ansValue = "";
                      
                      record.forEach(function(cell, columnIndex) {
                          if (apex.item('P13_ISCHARACTERISTICSINCLUDE').getValue()=='YES')
                                {
                                        if (columnIndex == 2) {
                                        ansValue = cell.d + sp;
                                        }
                                }
                           
                        if (columnIndex == 3 ) {
                          extractedData.push(ansValue +  cell.d);
                        }
                      });
                    });
                    
                    var output = extractedData.join(sp);
                    
                    $s('P13_SPECIFICATION',output);
                    
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

