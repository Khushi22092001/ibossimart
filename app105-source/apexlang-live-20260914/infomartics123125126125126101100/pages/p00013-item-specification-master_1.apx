    dynamicAction set-specification (
        name: Set Specification
        execution {
            sequence: 130
        }
        when {
            selectionType: columns
            interactiveGrid: @item-specification-detail
            columns: MCVALUESNO
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("ITEMDETAIL").widget().interactiveGrid("getViews", "grid").model;
                    var result;
                    var amtKey = model.getFieldKey("ITEMCHARACTERISTICSCODE");
                    model.forEach(function(r) 
