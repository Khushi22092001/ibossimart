        column ISCHARACTERISTICSINCLUDE (
            type: textField
            heading {
                heading: Ischaracteristicsinclude
            }
            layout {
                sequence: 110
            }
            validation {
                maxLength: 3
            }
            source {
                databaseColumn: ISCHARACTERISTICSINCLUDE
                dataType: varchar2
            }
            default {
                type: item
                item: P13_ISCHARACTERISTICSINCLUDE
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ITEMCHARACTERISTICSCODE (
            type: popupLov
            heading {
                heading: Item Characteristics
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                     Select
                         ITEMCHARACTERISTICSNAME,
                         ITEMCHARACTERISTICSCODE
                    From ITEMCHARACTERISTICS 
                    where ITEMCHARACTERISTICSCODE in 
                        (
                            select distinct ITEMCHARACTERISTICSCODE from itemdetail
                            where tno = :P13_ITEMTNO
                        )
                    
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: P13_ITEMTNO
                parentRequired: false
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ITEMCHARACTERISTICSCODE
                dataType: varchar2
                primaryKey: true
            }
            advanced {
                htmlDomId: ITEMCHARACTERISTICSCODE
            }
        )

        column MCVALUESNO (
            type: popupLov
            heading {
                heading: Value
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select
                         VALUE,
                         SNO
                    From MCValue a, ITEMCHARACTERISTICS b
                    Where a.Tno = b.TNo
                     and b.ITEMCHARACTERISTICSCode = :ITEMCHARACTERISTICSCODE
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ITEMCHARACTERISTICSCODE
                itemsToSubmit: [
                    MCVALUESNO
                    ITEMCHARACTERISTICSCODE
                ]
                parentRequired: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: MCVALUESNO
                dataType: number
            }
            advanced {
                htmlDomId: MCVALUESNO
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SHORTNAME (
            type: textField
            layout {
                sequence: 90
            }
