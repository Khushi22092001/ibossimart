                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @ITEMCHARACTERISTICSCODE
                layout {
                    width: 347
                    sequence: 4
                }
            )

            displayColumn (
                column: @MCVALUESNO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @VALUE
                layout {
                    show: false
                    sequence: 6
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 7
                }
            )

            displayColumn (
