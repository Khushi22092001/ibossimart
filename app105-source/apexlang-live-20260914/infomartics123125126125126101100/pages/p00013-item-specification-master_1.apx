    dynamicAction pass (
        name: Pass
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P13_TNO
                    P13_COMPANYCODE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P13_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-itemspecificationdetail (
        name: Set ITEMSPECIFICATIONDETAIL
        execution {
            sequence: 210
        }
        when {
            event: focusout
            selectionType: items
            items: P13_ITEMTNO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        tmp number:=0;
                        tmp1 number:=0;
                    begin
                    
                        /*delete from ITEMSPECIFICATIONDETAIL a
                        where not exists (select 1 from ITEMSPECIFICATION aa where aa.tno = a.tno); */
                    
                        select count(*) into tmp from ITEMSPECIFICATIONDETAIL 
                        where tno = :P13_ITEMTNO 
                        and sno = :P13_SNO 
                        and MCVALUESNO is null
                        and VALUE is null;
                    
                        select count(*) into tmp1 from ITEMSPECIFICATIONDETAIL 
                        where tno = :P13_ITEMTNO 
                        and sno = :P13_SNO 
                        and MCVALUESNO is not null
                        and VALUE is not null;
                    
                        if tmp =0 and tmp1=0 then
                    
                            insert into ITEMSPECIFICATIONDETAIL
                            (
                                tno,
                                sno,
                                sn,
                                ITEMCHARACTERISTICSCODE   
                            )
                            (
                                select 
                                    tno,
                                    :P13_SNO,
                                    globaltno.nextval,
                                    ITEMCHARACTERISTICSCODE
                                from ItemDetail
                                where 
                                    tno = :P13_ITEMTNO
                            );
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P13_SNO
                    P13_ITEMTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-specification-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

