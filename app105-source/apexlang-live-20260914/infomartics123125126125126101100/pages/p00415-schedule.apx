    region schedule (
        name: Schedule
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       SCHEDULECODE,
                       SCHEDULENAME,
                       SCHEDULEREMARK,
                       ACCOUNTGROUPCODE,
                       SCHEDULETYPE,
                       AUTHORISEDCAPITALAMOUNT,
                       SHAREVALUE,
                       AUTHORISEDREMARK,
                       ITEMGROUPCODE,
                       BREAKUPMONTHS,
                       SPECIALFORMAT,
                       REMARK,
                       CREATOR,
                       CREATIONTIME,
                       SCHEDULENO,
                       SERIALNO
                  from SCHEDULE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
