        action insert-data-into-detail-from-d-a (
            name: Insert Data into Detail From D.A.
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from MaterialOutDetail where tno = :P415_TNO;
                    insert into MaterialOutDetail 
                    (
                      tno,
                      sno,
                      itemcode,
                      itemspecificationcode,
                      packingtypecode,
                      description,
                      quantity1,
                      quantity2,
                      remark
                    ) 
                    (SELECT TO_NUMBER(:P415_TNO) as tno,
                            NULL as sno,
                            A.ITEMCODE,
                            A.ITEMSPECIFICATIONCODE,
                            A.PACKINGTYPECODE,
                            A.DESCRIPTION,
                            A.QUANTITY1,
                            a.QUANTITY2,
                            a.REMARK
                    FROM DESPATCHADVICEDETAIL A
                    WHERE A.TNO = :P415_REFERENCETNO
                     -- AND :P415_FORMSTATUS='NEWRECORD'
                    ) ;
                    ```
                itemsToSubmit: [
                    P415_TNO
                    P415_FORMSTATUS
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @schedule-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

