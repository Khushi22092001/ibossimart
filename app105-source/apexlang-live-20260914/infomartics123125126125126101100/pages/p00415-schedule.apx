    process item-detail-save-interactive-grid-data (
        name: Item Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @schedule-detail
        source {
            plsqlCode:
                ```plsql
                declare
                tsno number;
                Begin
                    IF :ACCOUNTGROUPCODE IS NOT NULL THEN
                    case :APEX$ROW_STATUS
                        when 'C' then
                      
                            select globaltno.nextval into tsno from dual;
                       
                
                            Insert Into scheduledetail (                 
                                    tno                  ,
                                    sno                  ,
                                    accountgroupcode             ,
                                    annexurename,
                                    remark               
                 
                            )
                            Values (
                                    :tno                  ,
                                    tsno                  ,
                                    :accountgroupcode             ,
                                    :annexurename,
                                    :remark      
                             );
                        
                        when 'U' then
                            update scheduledetail Set
                                      tno                    = :tno                   ,
                                      sno                    = :sno                   ,
                                      accountgroupcode       = :accountgroupcode              ,
                                      annexurename           = :annexurename ,
                                      remark                 = :remark
                            WHERE TNO = :P415_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From scheduledetail
                            Where TNo = :P415_TNO
                              and SNO = :SNO
                              ;
                    end case;
                    END IF;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 19971780749295499
        }
    )

