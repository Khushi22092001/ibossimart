    dynamicAction set-sno (
        name: Set SNO
        execution {
            sequence: 230
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @schedule-detail
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    Declare
                    mysno number;
                    Begin
                    If :SNO is null then
                        Select GlobalTNo.nextval into mysno from dual;
                    else MYSNO := :SNO;
                    end if;
                    return mysno;
                    end;
                    ```
                itemsToSubmit: SNO
            }
            affectedElements {
                selectionType: columns
                columns: SNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

