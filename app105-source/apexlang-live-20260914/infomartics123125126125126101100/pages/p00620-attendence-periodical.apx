        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ATTENDENCEHEADCODE (
            type: popupLov
            heading {
                heading: Attendence Head
                alignment: center
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery: SELECT ATTENDENCEHEADNAME,ATTENDENCEHEADCODE FROM ATTENDENCEHEAD
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ATTENDENCEHEADCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column ATTENDENCEVALUE (
            type: numberField
            heading {
                heading: Attendence Value
                alignment: center
            }
            settings {
                numberAlignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: ATTENDENCEVALUE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column REMARK (
            type: textField
