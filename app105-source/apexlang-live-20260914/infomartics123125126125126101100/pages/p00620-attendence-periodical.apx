    process validations (
        name: Validations
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    diff number;
                    sumvalue number;
                begin
                    --select to_number(:P620_TODATE - :P620_FROMDATE) into diff from dual;
                    select to_number(to_date(:P620_TODATE, 'dd-mm-yyyy') - to_date(:P620_FROMDATE, 'dd-mm-yyyy')) into diff from dual;
                
                    --select extract(day from to_date(:P620_TODATE, 'yyyy-mm-dd') - to_date(:P620_FROMDATE, 'yyyy-mm-dd'))
                    --into diff from dual;
                
                    select sum(attendencevalue) into sumvalue from ATTENDENCEPERIODICALDETAIL where tno = :P620_TNO;
                    
                    if diff+1<>sumvalue then
                        raise_application_error(-20000,'Sum of attendence value not matching with from date and todate.');
                    end if;
                end;
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 9420545191288554
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process validations-2 (
        name: Validations_1
        type: executeCode
        source {
            plsqlCode:
                ```plsql
