                    sequence: 5
                }
            )

            displayColumn (
                column: @ATTENDENCEVALUE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

            aggregate sum (
                column: @ATTENDENCEVALUE
            )

