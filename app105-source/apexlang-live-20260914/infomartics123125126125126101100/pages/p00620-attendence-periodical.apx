    dynamicAction delete-detail-data (
        name: Delete detail data
        execution {
            sequence: 150
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from ATTENDENCEPERIODICALDETAIL a
                        where not exists (
                            select 1 from ATTENDENCEPERIODICAL  aa  
                            where aa.tno = a.tno
                        );
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
