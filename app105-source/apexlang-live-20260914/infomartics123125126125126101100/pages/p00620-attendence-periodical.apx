            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region attendenceperiodical-detail (
        name: ATTENDENCEPERIODICAL DETAIL
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: ATTENDENCEPERIODICALDETAIL
            whereClause: TNO = :P620_TNO
            pageItemsToSubmit: P620_TNO
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
