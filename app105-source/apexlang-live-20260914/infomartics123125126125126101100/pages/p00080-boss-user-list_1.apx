            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column MAXISSUEDCHEQUEBOOK (
            type: plainText
            heading {
                heading: Max Issued Cheque Book
                alignment: end
            }
            layout {
                sequence: 14
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: N
            }
        )

        column MOBILENO (
            type: plainText
