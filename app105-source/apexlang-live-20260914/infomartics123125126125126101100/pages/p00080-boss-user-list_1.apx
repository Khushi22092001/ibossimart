page 80 (
    name: BOSS User List
    alias: BOSS-USER-LIST
    title: BOSS User List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region boss-user-list (
        name: BOSS User List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.BOSSUSERCODE,
                       A.BOSSUSERNAME,
                       A.BOSSUSERTYPE,
                       A.LOGINNAME,
                       A.ICONNAME,
                       A.CREATOR,
                       A.REMARK,
                       A.LOGINPASSWORD,
                       A.EMPLOYEECODE,
                       A.EMAILADDRESS,
                       A.BOSSPASSWORD,
                       A.BOSSGROUPCODE,
                       A.MAXISSUEDCHEQUEBOOK,
                       A.IMPRESTACCOUNTCODE,
                       A.MOBILENO,
                       A.EMAILPASSWORD,
                       A.CITYCODE,
                       A.DEVICEID,
                       to_char(A.CREATIONTIME,'DD-MM-YYYY HH24:MI:SS') CREATIONTIME
                  from BOSSUSER A
                  WHERE (A.BOSSUSERCODE != '1' or :APP_USER='BOSS')
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 81
                items: {
                    P81_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 144052748655447442
        }

        column BOSSGROUPCODE (
            type: plainText
            heading {
                heading: Boss Group Code
            }
            layout {
                sequence: 13
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column BOSSPASSWORD (
            type: plainText
            heading {
                heading: Boss Password
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column BOSSUSERCODE (
            type: plainText
            heading {
                heading: Boss User Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column BOSSUSERNAME (
            type: plainText
            heading {
                heading: Boss User Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column BOSSUSERTYPE (
            type: plainText
            heading {
                heading: Boss User Type
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column CITYCODE (
            type: plainText
            heading {
                heading: City Code
            }
            layout {
                sequence: 18
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 29
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column DEVICEID (
            type: plainText
            heading {
                heading: Device Id
            }
            layout {
                sequence: 19
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column EMAILADDRESS (
            type: plainText
            heading {
                heading: Email Address
            }
            layout {
                sequence: 11
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

