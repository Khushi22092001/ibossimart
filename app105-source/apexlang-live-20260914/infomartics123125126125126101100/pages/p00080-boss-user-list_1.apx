            advanced {
                endUserAlias: H
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: BOSS User List
        }

        savedReport 1441055 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BOSSPASSWORD (
                sequence: 5
            )

            displayColumn BOSSUSERCODE (
                sequence: 1
            )

            displayColumn BOSSUSERNAME (
                sequence: 2
            )

            displayColumn CREATIONTIME (
                sequence: 11
            )

            displayColumn CREATOR (
                sequence: 10
            )

            displayColumn EMAILADDRESS (
                sequence: 7
            )

            displayColumn EMAILPASSWORD (
                sequence: 8
            )

            displayColumn LOGINNAME (
                sequence: 3
            )

            displayColumn LOGINPASSWORD (
                sequence: 4
            )

            displayColumn MOBILENO (
                sequence: 6
            )

            displayColumn REMARK (
                sequence: 9
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @boss-user-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 81
                clearCache: 81
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @boss-user-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @boss-user-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
                    //$("#t_Body_nav").hide();
                    //$(this).treeView("collapse", n$)
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

