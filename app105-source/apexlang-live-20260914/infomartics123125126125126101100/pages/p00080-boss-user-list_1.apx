                heading: Icon Name
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column IMPRESTACCOUNTCODE (
            type: plainText
            heading {
                heading: Imprest Account Code
            }
            layout {
                sequence: 15
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column LOGINNAME (
            type: plainText
            heading {
                heading: Login Name
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column LOGINPASSWORD (
            type: plainText
            heading {
                heading: Login Password
