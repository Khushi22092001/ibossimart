page 517 (
    name: Product Detail
    alias: PRODUCT-DETAIL
    title: Product Detail
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .background1{background-color: gainsboro;}
            #MYID .t-Form-label {font-weight: bold;}
            #MYID .apex-item-display-only {font-weight: normal;}
            ```
    }
    security {
        formAutoComplete: false
    }

    region product-details (
        name: Product Details
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent14
                t-Region--stacked
                t-Region--hiddenOverflow
                t-Form--standardPadding
                t-Form--stretchInputs
                t-Form--leftLabels
            ]
            cssClasses: background1
        }
        advanced {
            htmlDomId: MYID
            regionDisplaySelector: true
        }
    )

    pageItem P517_BULKDENSITY (
        type: displayOnly
        label {
            label: Bulk Density :
            alignment: left
        }
        layout {
