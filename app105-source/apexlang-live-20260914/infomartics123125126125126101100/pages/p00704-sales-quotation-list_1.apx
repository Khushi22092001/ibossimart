    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 20
            region: @reason
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @sales-quotation-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 705
                clearCache: 705
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @sales-quotation-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 160
            region: @filter
            slot: regionBody
            startNewRow: false
            column: 10
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction hide (
        name: Hide
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @reason
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sales-quotation-list
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action set-document-status (
            name: SET DOCUMENT STATUS
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                    UPDATE SALESQUOTATION A SET A.REASONOFLOSS = :P704_REASONOFLOOSE
                    WHERE TNO = :P704_TNO;
                    commit;
                    SetDocumentStatusCode('SALESQUOTATION',:P704_TNO,:P704_DOCSTSTUS);
                    
                    
                    END;
                    ```
                itemsToSubmit: [
                    P704_TNO
                    P704_DOCSTSTUS
                    P704_REASONOFLOOSE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-report (
        name: refresh report
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sales-quotation-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @reason
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-value-and-open-reason (
        name: set value and open reason
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @sales-quotation-list
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: javascript:openModal('reason')
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P704_DOCSTSTUS
                value: LOOSE
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P704_DOCSTSTUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_TNO
            }
            affectedElements {
                selectionType: items
                items: P704_TNO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

