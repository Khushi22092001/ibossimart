            var reportParams = 
                  '"_paramsP_COMPANY":"'+ companycode + '",' +
            	  '"_paramsP_STATUS":"' +$('#P194_STATUS').val() + '",' + 
                  '"_paramsP_FROMDATE":"' +$('#P194_FROMDATE').val() + '",' + 
                  '"_paramsP_TODATE":"' +$('#P194_TODATE').val() + '",' + 
