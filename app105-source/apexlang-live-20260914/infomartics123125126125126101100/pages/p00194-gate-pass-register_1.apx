        }
        advanced {
            savedReportMappingIdentifier: 177346526854421810
        }

        column AMOUNT (
            type: plainText
            heading {
                heading: AMOUNT
                alignment: center
            }
            layout {
                sequence: 400
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: AV
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: TIMESTAMP
                alignment: center
            }
            layout {
                sequence: 550
                columnAlignment: center
            }
            appearance {
                formatMask: DD-MON-YYYY HH:MIPM
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:80px">#CREATIONTIME#</div>
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: BK
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: USER (RAISED BY)
                alignment: center
            }
            layout {
                sequence: 540
            }
            source {
