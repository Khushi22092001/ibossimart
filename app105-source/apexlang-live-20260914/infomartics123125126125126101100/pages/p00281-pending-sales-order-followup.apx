    region pending-sales-order-followup (
        name: Pending Sales Order followup
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.tno,b.sno,
                          row_number() over(order by a.Locationcode) SerialNo,
                       getlocationname(a.locationcode) location,
                       getpartyname(a.partycode) party,
                       --a.salesorderno,
                       
                       getpartyname(a.CONSIGNEECODE) CustomerName,
                       b.Itemcode,
                       
                       getitemname(b.itemcode) As ItemName,
                       b.itemspecificationcode,
                       getitemspecificationname(b.itemcode, b.itemspecificationcode) As Specification,
                       b.rate,
                       Sum(b.quantity1) OrderQty,
                       Sum(c.InvQty) Deliveredqty,
                       Sum(b.quantity1) - nvl(Sum(c.InvQty),0) As BalanceQty,
                       Sum(d.gst) || '%' As GSTExtra,
                       getcityname(p.OFFICECITYCODE) Destinationcity,
                       a.partypono CustomerRefNo,
                       a.partypodate customerRefDate,
                       a.salesorderno,
                       a.CREDITDAYS paymentterms,
                       a.TRANSACTIONTYPECODE ,
                       B.DOCUMENTSTATUSCODE
                  From SalesOrder a,
                       SalesOrderDetail b,
                       (Select 
                               bb.itemcode,
                               bb.itemspecificationcode,
                               sum(bb.quantity1) As InvQty,
                               aa.salesordertno
                          From ccinvoice aa, ccinvoicedetail bb
                         Where aa.tno = bb.tno
                         group by bb.itemcode,
                               bb.itemspecificationcode,
                               aa.salesordertno) c,
                       (Select tno, sno, sum(footerpercent) As gst
                          From salesorderdetailfooter
                        Group By tno, sno
                        ) d , 
                        party p
                 Where a.tno = b.tno
                   and a.CONSIGNEECODE = p.partycode
                   And b.itemcode = c.itemcode(+)
                   And b.itemspecificationcode = c.itemspecificationcode(+)
                   And a.tno = c.salesordertno(+)
                   And b.tno = d.tno(+)
                   And b.sno = d.sno(+)
                   and  A.salesorderDATE <= :P281_FROMDATE 
                and ( :P281_LOCATION IS NULL OR instr(':'||:P281_LOCATION||':',':'||A.LOCATIONCODE||':') > 0 )
                and ( :P281_PARTY IS NULL OR instr(':'||:P281_PARTY||':',':'||A.PARTYCODE||':') > 0 )
                and ( :P281_COMPANY IS NULL OR instr(':'||:P281_COMPANY||':',':'||A.companyCODE||':') > 0 )
                and ( :P281_DOCUMENTSTATUSCODE IS NULL OR instr(':'||:P281_DOCUMENTSTATUSCODE||':',':'||B.DOCUMENTSTATUSCODE||':') > 0 )
                -- Group By Rollup(a.locationcode, a.partycode, b.itemcode), b.rate
                 Group By a.locationcode,
                          a.partycode,
                          a.CONSIGNEECODE,
                          b.itemcode,
                          b.rate,
                          b.itemspecificationcode,
                          p.OFFICECITYCODE,
                          a.partypono,
                          a.partypodate,
                          a.salesorderno,
                          a.CREDITDAYS ,
                          a.TRANSACTIONTYPECODE ,
                          B.DOCUMENTSTATUSCODE,
                          b.tno,
                          b.sno
                having Sum(b.quantity1) - nvl(Sum(c.InvQty),0) > 0
                 /*Order By a.locationcode,
                          a.partycode,          
                          b.itemcode,
                          b.itemspecificationcode,
                          b.rate,
                          p.OFFICECITYCODE,
                          a.partypono,
                          a.partypodate,
                          a.salesorderno*/
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
