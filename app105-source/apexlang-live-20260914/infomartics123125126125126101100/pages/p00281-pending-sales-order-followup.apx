    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 10
            region: @pending-sales-order-followup
            slot: aboveBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 80
            region: @filter
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF_new();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

    process pending-sales-order-followup-save-interactive-grid-data (
        name: Pending Sales Order followup - Save Interactive Grid Data
        type: executeCode
        editableRegion: @pending-sales-order-followup
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                   
                        when 'U' then
                            update SalesOrderDetail a set a.DocumentstatusCode = :Documentstatuscode
                            where tno = :TNO
                              and sno = :SNO
                              ;
                    end case ;
                end ;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 36454440868504024
        }
    )

)

