    region invoice (
        name: Invoice
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                   row_number() over(order by X.Tno) SerialNo,
                   
                getlocationname(x.LOCATIONCODE) location , x.tno , b.ccinvoiceno from (
                select LOCATIONCODE , max(tno)as  tno  from ccinvoice group by LOCATIONCODE ) x ,
                ccinvoice b
                where x.tno = b.tno
                ```
        }
        layout {
            sequence: 20
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
