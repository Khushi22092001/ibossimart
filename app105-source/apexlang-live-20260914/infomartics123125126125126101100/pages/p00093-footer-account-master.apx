        source {
            formRegion: @footer-account-master
            column: FOOTERACCOUNTCODE
            dataType: varchar2
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'FOOTERACCOUNT'
                       and a.CodeScheme = 'AUTO'
                ```
        }
    )

