    dynamicAction check-footer-account-code (
        name: CHECK FOOTER ACCOUNT CODE
        execution {
            sequence: 100
        }
        when {
            event: focusout
            selectionType: items
            items: P93_FOOTERACCOUNTCODE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    if (Object.keys($v("P93_FOOTERACCOUNTCODE")).length===0 ) {
                        showError("Footer Account Code Should Not be Empty", 'P93_FOOTERACCOUNTCODE');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
