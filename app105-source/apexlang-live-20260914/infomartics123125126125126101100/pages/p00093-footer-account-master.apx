    pageItem P93_CREATIONTIME (
        type: textField
        label {
            label: Creation Time
            alignment: left
        }
        layout {
            sequence: 240
            region: @footer-account-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH:MIPM
            width: 32
        }
        validation {
            maxLength: 255
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @footer-account-master
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MM-YYYY HH24:MI:SS') from dual
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P93_FOOTERACCOUNTCODE
        }
    )

    pageItem P93_CREATOR (
        type: textField
        label {
            label: Creator
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 230
            region: @footer-account-master
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        advanced {
            customAttributes: readonly=true
        }
        source {
            formRegion: @footer-account-master
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select :GLOBAL_LOGINNAME from Dual
        }
    )

