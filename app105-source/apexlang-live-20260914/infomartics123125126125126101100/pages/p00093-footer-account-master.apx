page 93 (
    name: Footer Account Master
    alias: FOOTER-ACCOUNT-MASTER
    title: Footer Account Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region footer-account-master (
        name: Footer Account Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       MODULECODE,
                       FOOTERHEADCODE,
                       ACCOUNTCODE,
                       REMARK,
                       FOOTERACCOUNTCODE,
                       COMPANYCODE,
                       PARTYCODE,
                       ITEMCODE,
                       DOCTYPECODE,
                       LOCATIONCODE,
                       FOOTERNATURECODE,
                       AMOUNTPERCENT,
                       ACCOUNTCODESECOND,
                       FOOTERPERCENT,
                       DESPATCHCATEGORYCODE,
                       OTHERCODE,
                       ACCOUNTCODETHIRD,
                       TDSMASTERCODE,
                       NATUREOFSUPPLYCODE,
                       TRANSACTIONTYPECODE,
                       CREATOR,
                       CREATIONTIME
                  from FOOTERACCOUNT
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P93_ACCOUNTCODE (
        type: popupLov
        label {
            label: Account Code
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                        A.PARTYNAME,
                        A.PARTYCODE 
                        FROM PARTY A 
                        ORDER BY A.TNO DESC
                ```
        }
        layout {
            sequence: 60
            region: @footer-account-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @footer-account-master
            column: ACCOUNTCODE
            dataType: varchar2
        }
    )

    pageItem P93_ACCOUNTCODESECOND (
        type: popupLov
        label {
            label: Account Code Second
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                        A.PARTYNAME,
                        A.PARTYCODE 
                        FROM PARTY A 
                        ORDER BY A.TNO DESC
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 130
            region: @footer-account-master
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @footer-account-master
            column: ACCOUNTCODESECOND
            dataType: varchar2
        }
    )

    pageItem P93_ACCOUNTCODETHIRD (
        type: hidden
