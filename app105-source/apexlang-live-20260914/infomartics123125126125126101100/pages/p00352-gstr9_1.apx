                ```sql
                Select a.tno,
                       a.sno,
                       a.CAPTION,
                       b.GSTHEADNAME,
                       a.TOTALPAYABLE,
                       a.TotalPaid,
                       a.cgst,
                       a.sgst,
                       a.igst,
                       A.cess
                  From GSTR9_9TAXPAID a,GSTHEAD b
