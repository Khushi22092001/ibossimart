        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P352_Tno is null then
                        Select GlobalTno.NextVal into :P352_Tno From Dual;
                     end if;
                    ----
                    if :P352_GSTR9NO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P352_LocationCode,
                					:P352_DocTypeCode,
                					NULL,
                					TO_DATE(:P352_GSTR9DATE, 'DD-MM-RRRR')
                				);
                        :P352_GSTR9NO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P352_LocationCode,
                                    :P352_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P352_GSTR9DATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 75864320026121164
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P352_TNO is null then
                    :P352_TNO := GlobalTNo.nextval;
                    :P352_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P352_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P352_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P352_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 75863113778121162
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P352_MODULEFLOW := 'YES';
                   else
                       :P352_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P352_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P352_ONTHETABLE := 'YES' ;
                   else
                       :P352_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 75863554636121162
        }
    )

