    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 360
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P352_CALLEDFROMPAGE').getValue();
                    var y = apex.item('P352_CALLEDFROMTNO').getValue();
                    
                    //var url = "f?p=#APP_ID#:80:#SESSION#::NO:RP,80:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#:P#2002#_TNO:#P2002_TNO#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    
                    url = url.replace("#P2002_TNO#", y);
                    //window.alert(x);
                    //window.alert(y);
                    //window.alert(url);
                    
                    
                    //call
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 340
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item=value
                item: P352_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P352_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P352_TNO,:P352_STATUS);
                    
                    declare
                        tpaymentadvice number;
                    
                    begin
                        SELECT COUNT(A.TNO) INTO tpaymentadvice
                    	FROM PAYMENTADVICE A
                    	WHERE A.MODULETNO = :P352_TNO ;
                    
                        if nvl(tpaymentadvice, 0) = 0 then
                            if :P352_STATUS = 'ACTIVE' then
                            
                                CREATEPAYMENTADVICEFORPO(:P352_TNO);
                    
                            end if;
                    
                        end if;
                    
                    end;
                    ```
                itemsToSubmit: [
                    P352_TNO
                    P352_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P352_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P352_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction fail (
        name: Fail
        execution {
            sequence: 330
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @fail
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    		cursor cPassFail is
                    				select
                    						a.TNo,
                    						a.TokenNo										
                    				from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    				where a.ModuleFlowTNo = b.TNo
                    						and b.TNo = c.TNo
                    						and a.BossUserCode = c.BossUserCode
                    						and c.BossUserCode = d.BossUserCode
                    						and a.ModuleTNo = ':P'||to_char(:APP_PAGE_ID)||'_TNo'
                    						and d.LoginName = User
                    						and a.isPass is null
                    						and a.IsFail is null
                    						and a.IsForwarded is null
                    						and a.IsRebounded is null																				
                    		;
                    		vPassFail cPassFail%rowtype;
                        
                        tTokenNo NUMBER;
                        TMP VARCHAR2(100) := :P60_TNO;
                    begin
                    		open cPassFail;
                    		fetch cPassFail into vPassFail;
                    		if cPassFail%FOUND then
                    				tTokenNo := vPassFail.TokenNo;
                    				close cPassFail;
                    
                               	
                    				update PassFail a
                    				set a.IsFail = 'YES',
                    						a.remark = ':P'||to_char(:APP_PAGE_ID)||'_PASSFAILREMARK'
                    				where a.TNo = vPassFail.TNo;
                    				
                    				SendBackPassFail(tTokenNo , TMP );
                    		    		
                    				
                    				commit;
                    		else
                    				close cPassFail;
                    		end if;
                    
                    	
                    end;
                    ```
                itemsToSubmit: [
                    P352_TNO
                    P352_COMPANYCODE
                    P352_PURCHASEORDERNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P352_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

