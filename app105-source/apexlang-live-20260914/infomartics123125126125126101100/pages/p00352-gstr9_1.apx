    region transaction (
        name: Transaction
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,
                       a.sno,
                       B.TRANSACTIONNO,
                       d.ModuleName,
                       B.TRANSACTIONDATE,
                       C.PARTYNAME,
                       B.TRANSACTIONAMOUNT,
                       A.MODULETNO,
                       A.MODULECODE,
                       A.REMARK
                  From GSTR9TRANSACTION A, TRANSACTIONFORGSTR9 B, PARTY C, Module d
                 Where A.MODULETNO=B.MODULETNO(+)
                   AND B.PARTYCODE=C.PARTYCODE(+)
                   and b.ModuleCode = d.ModuleCode
                   and a.tno = :P352_TNO
                 Order By B.TRANSACTIONDATE, B.TRANSACTIONNO
                
                ```
            pageItemsToSubmit: P352_TNO
        }
        layout {
            sequence: 10
            parentRegion: @gstr1-detail
            slot: tabs
        }
