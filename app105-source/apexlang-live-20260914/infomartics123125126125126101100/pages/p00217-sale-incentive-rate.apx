    process rate-detail-save-interactive-grid-data (
        name: Rate Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @rate-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                           IF :SNO IS NULL then
                                select globaltno.nextval into :SNO from dual;
                           end if;
                            Insert Into SaleIncentiveRateDetail (                 
                                    TNO,
                                    SNO,
                                    ITEMCODE,
                                    ITEMSPECIFICATIONCODE,
                                    INCENTIVERATE,
                                    INCENTIVERATEPERCENT,
                                    REMARK
                                    
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :INCENTIVERATE,
                                :INCENTIVERATEPERCENT,
                                :REMARK
                             );
                        
                        when 'U' then
                            update SALEINCENTIVERATEDETAIL Set
                                  TNO=:TNO,
                                    SNO=:SNO,
                                    ITEMCODE=:ITEMCODE,
                                    ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                    INCENTIVERATE = :INCENTIVERATE,
                                    INCENTIVERATEPERCENT = :INCENTIVERATEPERCENT
                            WHERE TNO = :P217_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From SALEINCENTIVERATEDETAIL
                            Where TNo = :P217_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 11428640970820630
        }
    )

