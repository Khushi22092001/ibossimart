                    ```sql
                    select ITEMSPECIFICATIONNAME, ITEMSPECIFICATIONCODE
                    from itemspecification a, item b
                    where a.tno = b.tno
                    and b.itemcode = :ITEMCODE
                    ```
            }
            cascadingLov {
                parentColumns: ITEMCODE
                itemsToSubmit: ITEMCODE
            }
            layout {
