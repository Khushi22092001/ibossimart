page 24 (
    name: Location List
    alias: LOCATION-MASTER
    title: Location List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
            overflow: auto !important;
            }
            
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region location-master (
        name: Location Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.LOCATIONCODE,
                       A.LOCATIONNAME,
                       A.LOCATIONSHORTNAME,
                       A.TNO,
                       A.REMARK,
                       A.DATECREATED,
                       A.DATEMODIFY,
                       A.PARENTCODE,
                       A.CREATOR,
                       A.ISDIVISION,
                       A.CREATIONTIME,
                       A.PARTYCODE,
                       A.DESTINATIONCODE,
                       A.TRACKINGREQUIRED,
                       A.LATITUDE,
                       A.LONGITUDE,
                       A.PETTYCASHACCOUNTCODE,
                       A.ZONECODE,
                       A.TRANSACTIONALCYCLECOUNT,
                       A.STORAGERESERVATIONREQUIRED,
                       A.LRENTRYITEMWISE,
                       A.FSABILLWITHCODE,
                       A.PREMISESCODE,
                       A.ISPREMISESOFMULTIPLEWAREHOUSE,
                       A.VEHICLEPLANNING,
                       A.PODPERCENTFORTRANSPORTERBILL,
                       A.OPERATIONBOSSUSERCODE,
                       A.TRANSPORTATIONBOSSUSERCODE,
                       A.LRENTRYSLIPPRINTGROUPWISE,
                       A.WAREHOUSEBOSSUSERCODE,
                       A.PRINTGATEPASSWITHDISPATCHSLIP,
                       A.OVERTIMEFORSANCTIONEDDAY,
                       A.GATEENTRYREQUIRED,
                       A.AVERAGEWEIGHTPERNOS,
                       A.STATECODE,
                       A.SHIPMENTDOCNOINDISPATCHSLIP,
                       A.PAIDBILTYCLAIMIMMEDIATE,
                       A.CITYCODE,
                       A.ASSETACCOUNTCODE,
                       A.BRANCHACCOUNTCODE,
                       A.COMPANYCODE,
                       A.ISITBRANCH,
                       A.FRANCHISEID,
                       A.FRANCHISENAME,
                       A.ACCOUNTCODE,
                       A.STATUS,
                       A.ADDRESS1,
                       A.ADDRESS2,
                       A.ADDRESS3,
                       A.BRANCHTYPECODE,
                       B.LOCATIONNAME AS PARENTLOCATION
                  from LOCATION A, LOCATION B
                  WHERE A.LOCATIONCODE = B.LOCATIONCODE(+)
                
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 25
                items: {
                    P25_TNO: #TNO#
                }
                clearCache: 25
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 302933369212669787
        }

