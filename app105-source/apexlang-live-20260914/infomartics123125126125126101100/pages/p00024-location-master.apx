        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Location Master
        }

        savedReport 153825 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn ISDIVISION (
                sequence: 7
            )

            displayColumn LATITUDE (
                sequence: 5
            )

            displayColumn LOCATIONNAME (
                sequence: 1
            )

            displayColumn LOCATIONSHORTNAME (
                sequence: 2
            )

            displayColumn LONGITUDE (
                sequence: 6
            )

            displayColumn PARENTLOCATION (
                sequence: 3
            )

            displayColumn STATECODE (
                sequence: 4
            )

        )

