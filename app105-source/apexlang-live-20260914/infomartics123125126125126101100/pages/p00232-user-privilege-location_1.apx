page 232 (
    name: User Privilege Location
    alias: USER-PRIVILEGE-LOCATION
    title: User Privilege Location
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: [
            t-Dialog--noPadding
            t-PageBody--noContentPadding
        ]
    }
    dialog {
        height: 400
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/standard
            templateOptions: [
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region user-privilege-location (
        name: User Privilege Location
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.LOCATIONCODE,
                       a.SNO
                  from MODULEPRIVILEGELOCATION a
                 where a.TNO = :P232_TNO
                ```
            pageItemsToSubmit: P232_TNO
        }
        layout {
            sequence: 20
            slot: contentBody
            startNewRow: false
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: actionsMenu
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 191524000981409636
        }

        savedReport 396603 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @LOCATIONCODE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column LOCATIONCODE (
            type: popupLov
            heading {
                heading: Location
            }
            lov {
                type: sqlQuery
                sqlQuery: sELECT lOCATIONNAME D, LOCATIONCODE R FROM LOCATION
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: LOCATIONCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column SNO (
            type: textField
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SNO
                dataType: number
                primaryKey: true
            }
            default {
                type: sequence
                sequence: GLOBALTNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        column TNO (
            type: textField
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            default {
                type: item
                item: P232_ITNO
            }
            exportPrinting {
                includeInExportPrint: false
            }
            enableUsersTo {
                sort: false
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: User Privilege Department
        }
    )

    pageItem P232_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @user-privilege-location
            slot: regionBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 20
            region: @buttons
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save (
        buttonName: Save
        label: Save
        layout {
            sequence: 10
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @user-privilege-location
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @user-privilege-location
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction setsno (
        name: SETSNO
        execution {
            sequence: 20
        }
        when {
            selectionType: columns
            interactiveGrid: @user-privilege-location
            columns: LOCATIONCODE
        }
        clientSideCondition {
            type: itemColumnIsNotNull
            column: LOCATIONCODE
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT GLOBALTNO.NEXTVAL FROM DUAL;
                itemsToSubmit: [
                    SNO
                    LOCATIONCODE
                ]
            }
            affectedElements {
                selectionType: columns
                columns: SNO
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: itemColumnIsNull
                column: SNO
            }
        )

    )

    process closedialog (
        name: CloseDialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 68927263197247491
        }
    )

    process user-privilege-department-save-interactive-grid-data (
        name: User Privilege Department - Save Interactive Grid Data
        type: executeCode
        editableRegion: @user-privilege-location
        source {
            plsqlCode:
                ```plsql
                /*
                raise_application_error(
                    -20000,
                    ' row _status ' || :APEX$ROW_STATUS
                    || ' tno ' || :TNO   
                    || ' tno ' || :SNO   
                );
                */
                if :APEX$ROW_STATUS IN ( 'I','C') then
                   :TNO := :P232_TNO ;
                
                  INSERT INTO MODULEPRIVILEGELOCATION ( TNO,SNO,LOCATIONCODE)
                  VALUES ( :TNO,:SNO,:LOCATIONCODE) ;
                ELSIF  :APEX$ROW_STATUS IN ( 'U') then
                     UPDATE MODULEPRIVILEGELOCATION 
                     SET LOCATIONCODE = :LOCATIONCODE
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                ELSIF :APEX$ROW_STATUS = 'D' then
                     DELETE FROM  MODULEPRIVILEGELOCATION
                     WHERE TNO = :TNO
                       AND SNO = :SNO
                       ;
                END IF;   
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 68926781644247480
        }
    )

)

