    region asset-transfer-list (
        name: Asset Transfer List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       ASSETTRANSFERNO,
                       ASSETTRANSFERDATE,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       REMARK,
                       CREATOR,
                       WORKCENTRECODE,
                       ACCOUNTCODE,
                       ASSETCODEPREFIX,
                       ASSETCODESTARTNO,
                       ASSETVALUE,
                       DEPRECIATEDAMOUNT,
                       NETVALUE,
                       CREATIONTIME,
                                '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||9993||':'||:APP_SESSION||'::::'||'P9993_TNO,P9993_REPNAME'||':'||TNO||','||'AssetTransfer'||':NO')||'"><span aria-label="Action"><span class="fa fa-print"  aria-hidden="true" title="Action"></span</span></a>' AS Print
                
                  from ASSETTRANSFER
                    where ASSETTRANSFERDATE  between :P691_FROMDATE and :P691_TODATE
                    and   ( :P691_COMPANY IS NULL OR instr(':'||:P691_COMPANY||':',':'||companycode||':') > 0 )
                --and   instr(':'||:P691_COMPANY||':',':'||companycode||':') > 0
                and   ( :P691_LOCATION IS NULL OR instr(':'||:P691_LOCATION||':',':'||LOCATIONCODE||':') > 0 )
                and   ( :P691_DOCTYPE IS NULL OR instr(':'||:P691_DOCTYPE||':',':'||DOCTYPECODE||':') > 0 )
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 692
                items: {
                    P692_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 48640975577143633
        }

