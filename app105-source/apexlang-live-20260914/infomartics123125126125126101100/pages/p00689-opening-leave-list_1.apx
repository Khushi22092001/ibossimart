page 689 (
    name: Opening Leave List
    alias: OPENING-LEAVE-LIST
    title: Opening Leave List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region opening-leave-list (
        name: Opening Leave List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       getcompanyname(companycode) Company,
                       FINANCIALYEARCODE,
                       DOCTYPECODE,
                       getdoctypename(doctypecode) DocType,
                       LOCATIONCODE,
                       getlocationname(LocationCode) Location,
                       OPENINGLEAVENO,
                       OPENINGLEAVEDATE,
                       EMPLOYEECODE,
                       getEmployeeName(EmployeeCode) EmployeeName,
                       REMARK,
                       CREATOR,
                       DATECREATED,
                       CREATIONTIME
                  from OPENINGLEAVE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 690
                items: {
                    P690_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 46137629945924108
        }

        column COMPANY (
            type: plainText
            heading {
                heading: Company
            }
            layout {
                sequence: 22
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column COMPANYCODE (
            type: plainText
            heading {
                heading: Company Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column CREATIONTIME (
