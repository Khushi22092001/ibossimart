page 319 (
    name: Footer Formula List
    alias: FOOTER-FORMULA-LIST
    title: Footer Formula List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region footer-formula-list (
        name: Footer Formula List
        type: interactiveReport
        source {
            location: localDatabase
            tableName: FOOTERSCHEMEDETAIL
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 320
                items: {
                    P320_FOOTERHEADCODE: #FOOTERHEADCODE#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 25777451361637647
        }

        column FOOTERHEADCODE (
            type: plainText
            heading {
                heading: Footerheadcode
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column FORMULA (
            type: plainText
            heading {
                heading: Formula
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column POSTFIX (
            type: plainText
            heading {
                heading: Postfix
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column SNO (
            type: plainText
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: B
            }
        )

        column TNO (
            type: plainText
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 281856 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn FOOTERHEADCODE (
                sequence: 1
            )

            displayColumn FORMULA (
                sequence: 3
            )

            displayColumn POSTFIX (
                sequence: 2
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 10
            region: @footer-formula-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 320
                clearCache: 320
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: never
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @footer-formula-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @footer-formula-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

