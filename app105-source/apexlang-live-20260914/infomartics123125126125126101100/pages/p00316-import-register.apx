                  '&P_LOCATION=' + $('#P167_LOCATION').val() +    
                  '&P_FROMDATE=' +$('#P167_FROMDATE').val() + 
                  '&P_TODATE=' +$('#P167_TODATE').val() + 
                  '&P_DOCTYPE=' +$('#P167_DOCTYPE').val() +
