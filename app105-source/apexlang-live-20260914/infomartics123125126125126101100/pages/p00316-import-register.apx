        }
        behavior {
            action: redirectUrl
            targetUrl: http://15.207.2.208:9704/xmlpserver/PRA/materialoutregister.xdo?id=weblogic&passwd=webboss123&_xpt=0&_xmode=1&P316_FROMDATE=&P316_FROMDATE.&P316_TODATE=&P316_TODATE.&P316_LOCATION=&P316_LOCATION.&P316_DOCTYPE=&P316_DOCTYPE.&P316_ITEM=&P316_ITEM.&P316_ITEMSPECIFICATION=&P316_ITEMSPECIFICATION.&P316_TRANSPORTER=&P316_TRANSPORTER.&P316_PARTY=&P316_PARTY.&P316_VEHICLENO=&P316_VEHICLENO.&P316_MONO=&P316_MONO.
