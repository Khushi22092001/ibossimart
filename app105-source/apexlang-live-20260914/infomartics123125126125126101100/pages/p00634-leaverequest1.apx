    dynamicAction get-leavedays (
        name: GET_LEAVEDAYS
        execution {
            sequence: 70
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @leave-detail
            columns: LEAVETODATE
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    if :LeaveToDate is not null then
                    declare
                    		cursor cLeaveScheme is
                    				select
                    						b.TNo,
                    						b.SNo,
                    						b.CONTIGUOUSMAX,
                    						b.MaxInYear,
                    						b.PeriodicalLimitation,
                    						b.NegativeAllowed
                    				from LeaveScheme a, LeaveSchemeDetail b
                    				where a.TNO = b.TNo
                    						and a.LeaveSchemeCode = GetEmployeeLeaveSchemeCode(:P634_EmployeeCode, :P634_LeaveRequestDate)			
                    						and b.LeaveCode = :LeaveCode
                    		;
                    		vLeaveScheme cLeaveScheme%ROWTYPE;
                    		tBalanceDays Number;
                    		tStockDays Number;
                    		tUsedLeaveDays Number;
                    		tSanctionedLeaveDays Number;
                    		tRequestedLeaveDays Number;
                    		tLeaveDays Number;
                    		tTotalDays		Number;
                    		tDate Date := getFinancialYearBegin(:P634_FINANCIALYEARCODE);
                    		tPeriod Number;
                    		
                    begin
                    		open cLeaveScheme;
                    		fetch cLeaveScheme into vLeaveScheme;
                    		if cLeaveScheme%FOUND then
                    			
                    				
                    				tPeriod := to_date(:P634_LeaveRequestDate) - tDate;
                    				
                    				if :LeaveDays > nvl(vLeaveScheme.CONTIGUOUSMAX, 0) then
                    						raise_application_error(-20000,'Max contigous leave'||vLeaveScheme.CONTIGUOUSMAX);														
                    				end if;
                    				tStockDays := GetLeaveRequestLeaveDays(:P634_EmployeeCode, :LeaveCode, :P634_LeaveRequestDate);
                    				tUsedLeaveDays := GetLeaveRequestUsedLeaveDays(:P634_EmployeeCode, :LeaveCode, :P634_LeaveRequestDate);
                    				tSanctionedLeaveDays := GetLeaveRequestSanctionedDays(:P634_EmployeeCode, :LeaveCode, :P634_LeaveRequestDate);
                    				tRequestedLeaveDays := GetLeaveRequestRequestedDays(:P634_EmployeeCode, :LeaveCode, :P634_LeaveRequestDate);
                    				
                    				select
                    						sum(a.LeaveDays) into tLeaveDays
                    				from LeaveRequestDetail a
                    				where a.TNo = :TNo
                    						and a.SNo = :SNo
                    				;
                    				
                    				tTotalDays := nvl(tUsedLeaveDays, 0) + nvl(tSanctionedLeaveDays, 0) + nvl(tRequestedLeaveDays, 0) - nvl(tLeaveDays, 0) + nvl(:LeaveDays, 0);
                    				tBalanceDays := nvl(tStockDays, 0) - nvl(tTotalDays, 0);
                    				
                    				if tBalanceDays < 0 and nvl(vLeaveScheme.NegativeAllowed, 'NO') ='NO' then
                    	
                                            raise_application_error(-20000,'Leave not available ');									
                    				end if;
                    				
                    		
                    				if vLeaveScheme.PeriodicalLimitation = 'YES' then						
                    						for vLeaveSchemeDetail
                    								in (
                    										select
                    												a.TNo,
                    												a.SNo,
                    												a.SerialNo,
                    												a.Period,
                    												a.Days
                    										from LeaveSchemePeriodical a
                    										where a.TNo = vLeaveScheme.TNo
                    												and a.SNo = vLeaveScheme.SNo
                    												and a.Period >= tPeriod
                    										order by a.SerialNo
                    								)
                    						loop
                    								if nvl(tTotalDays, 0) > nvl(vLeaveSchemeDetail.Days, 0) then
                    								
                                                            raise_application_error(-20000,'Max allowed leave in period '|| to_char( vLeaveSchemeDetail.Period )  || ' days is ' || to_char(vLeaveSchemeDetail.Days));					
                    								end if;								
                    						end loop;
                    				end if;
                    				
                    		end if;
                    		close cLeaveScheme;		
                    end;
                    end if;
                    ```
                itemsToSubmit: [
                    LEAVETODATE
                    P634_EMPLOYEECODE
                    P634_LEAVEREQUESTDATE
                    P634_FINANCIALYEARCODE
                    LEAVECODE
                    LEAVEDAYS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    BEGIN
                        IF TO_DATE(:LEAVEFROMDATE,'DD-MM-RRRR')<=TO_DATE(:LEAVETODATE,'DD-MM-RRRR') THEN
                            :LEAVEDAYS := TO_DATE(:LEAVETODATE,'DD-MM-RRRR') - TO_DATE(:LEAVEFROMDATE,'DD-MM-RRRR');
                        END IF;
                      
                        RETURN :LEAVEDAYS+1;
                    END;
                    ```
                itemsToSubmit: [
                    LEAVEFROMDATE
                    LEAVETODATE
                ]
            }
            affectedElements {
                selectionType: columns
                columns: LEAVEDAYS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction go-back-to-called-form (
        name: Go Back To Called Form
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P634_CALLEDFROMPAGE').getValue();
                    var y = apex.item('P634_CALLEDFROMTNO').getValue();
                    
                    //var url = "f?p=#APP_ID#:80:#SESSION#::NO:RP,80:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#:P#2002#_TNO:#P2002_TNO#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    
                    url = url.replace("#P2002_TNO#", y);
                    //window.alert(x);
                    //window.alert(y);
                    //window.alert(url);
                    
                    
                    //call
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

