    region leave-balance (
        name: Leave Balance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                b.leavename as Leave,
                GetLeaveRequestLeaveDays(:P634_EMPLOYEECODE, b.LeaveCode, TO_DATE(:P634_LeaveRequestDate)) AS LeaveDays,
                GetLeaveRequestUsedLeaveDays(:P634_EmployeeCode, b.LeaveCode, TO_DATE(:P634_LeaveRequestDate)) AS UsedDays,
                GetLeaveRequestSanctionedDays(:P634_EmployeeCode, b.LeaveCode, TO_DATE(:P634_LeaveRequestDate)) As Sanctioned,
                GetLeaveRequestRequestedDays(:P634_EmployeeCode, b.LeaveCode, TO_DATE(:P634_LeaveRequestDate)) As Request,
                GetLeaveRequestLeaveDays(:P634_EMPLOYEECODE, b.LeaveCode, TO_DATE(:P634_LeaveRequestDate))-
                GetLeaveRequestUsedLeaveDays(:P634_EmployeeCode, b.LeaveCode, TO_DATE(:P634_LeaveRequestDate))-
                GetLeaveRequestSanctionedDays(:P634_EmployeeCode, b.LeaveCode, TO_DATE(:P634_LeaveRequestDate)) -
                GetLeaveRequestRequestedDays(:P634_EmployeeCode, b.LeaveCode, TO_DATE(:P634_LeaveRequestDate)) AS Balance
                
                From Employee a, Leave b
                where a.EmployeeCode = :P634_EmployeeCode
                ```
            pageItemsToSubmit: [
                P634_EMPLOYEECODE
                P634_LEAVEREQUESTDATE
            ]
        }
        layout {
            sequence: 10
            parentRegion: @tab-page
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 18801500179258817
        }

        column BALANCE (
            type: plainText
            heading {
                heading: Balance
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
