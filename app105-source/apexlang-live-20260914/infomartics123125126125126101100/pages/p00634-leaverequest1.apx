    region leave-taken (
        name: Leave Taken
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT X.MONTH,X.LEAVECODE,SUM(X.LEAVEDAYS) LEAVEDAYS,X.NUM_MM
                FROM
                (
                SELECT  
                       CASE 
                            WHEN to_char(B.LEAVEFROMDATE, 'Mon-YYYY') = to_char(B.LEAVETODATE, 'Mon-YYYY')  THEN
                                to_char(B.LEAVEFROMDATE, 'Mon-YYYY')
                            END AS MONTH,
                        to_char(B.LEAVEFROMDATE, 'MM') AS NUM_MM,
                        B.LEAVECODE,B.LEAVEDAYS
                FROM LEAVEREQUEST A,LEAVEREQUESTDETAIL B
                WHERE A.TNO=B.TNO
                AND   A.LOCATIONCODE        =   :P634_LOCATIONCODE
                AND   A.DOCTYPECODE    =   :P634_DOCTYPECODE
                AND   A.DEPARTMENTCODE =    :P634_DEPARTMENTCODE
                AND   A.STAFFTYPECODE = :P634_STAFFTYPECODE
                AND   A.EMPLOYEECODE          =   :P634_EMPLOYEECODE
                ) X
                GROUP BY X.MONTH,X.LEAVECODE,X.NUM_MM
                ORDER BY X.NUM_MM
                ```
            pageItemsToSubmit: [
                P634_LOCATIONCODE
                P634_DOCTYPECODE
                P634_DEPARTMENTCODE
                P634_STAFFTYPECODE
                P634_EMPLOYEECODE
            ]
        }
        layout {
            sequence: 40
            parentRegion: @tab-page
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        link {
            linkColumn: customTarget
            target: {
                page: 635
                items: {
                    P635_LOCATIONCODE: &P634_LOCATIONCODE.
                    P635_DOCTYPECODE: &P634_DOCTYPECODE.
                    P635_MONTH: #MONTH#
                    P635_DEPARTMENTCODE: &P634_DEPARTMENTCODE.
                    P635_STAFFTYPECODE: &P634_STAFFTYPECODE.
                    P635_EMPLOYEECODE: &P634_EMPLOYEECODE.
                    P635_LEAVECODE: #LEAVECODE#
                }
                clearCache: 635
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
