    process leaverequestdetail-save-interactive-grid-data (
        name: LEAVEREQUESTDETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @leave-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                           IF :SNO IS NULL then
                                select globaltno.nextval into :SNO from dual;
                           end if;
                            Insert Into LEAVEREQUESTDETAIL ( 
                                        TNO,              
                                        SNO,                    
                                        SERIALNO,          
                                        LEAVEFROMDATE ,    
                                        LEAVETODATE,    
                                        LEAVECODE,         
                                        LEAVEDAYS,    
                                        REMARK    
                            )
                            Values (
                                        :TNO,              
                                        :SNO,                    
                                        :SERIALNO,          
                                        :LEAVEFROMDATE ,    
                                        :LEAVETODATE,    
                                        :LEAVECODE,         
                                        :LEAVEDAYS,    
                                        :REMARK   
                             );
                  
                        when 'U' then
                            update LEAVEREQUESTDETAIL Set
                                        TNO         = :TNO,              
                                        SNO         = :SNO,                    
                                        SERIALNO    = :SERIALNO,          
                                        LEAVEFROMDATE   =  :LEAVEFROMDATE,    
                                        LEAVETODATE     =  :LEAVETODATE,    
                                        LEAVECODE       =  :LEAVECODE,         
                                        LEAVEDAYS       =  :LEAVEDAYS,    
                                        REMARK          =  :REMARK
                            WHERE TNO = :P634_TNO
                              and SNO = :SNO;
                
                        when 'D' then
                            Delete From LEAVEREQUESTDETAIL
                            Where TNo = :P634_TNO
                              and SNO = :SNO
                              ;
                    
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 19119273182274041
        }
    )

