    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P634_Tno is null then
                        Select GlobalTno.NextVal into :P634_Tno From Dual;
                     end if;
                    ----
                    if :P634_LEAVEREQUESTNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P634_LocationCode,
                					:P634_DocTypeCode,
                					NULL,
                					TO_DATE(:P634_LEAVEREQUESTDATE, 'DD-MM-RRRR')
                				);
                        :P634_LEAVEREQUESTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P634_LocationCode,
                                    :P634_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P634_LEAVEREQUESTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 19268871394593627
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P634_TNO is null then
                    :P634_TNO := GlobalTNo.nextval;
                    :P634_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P634_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P634_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P634_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 19202514967427870
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P634_MODULEFLOW := 'YES';
                   else
                       :P634_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P634_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P634_ONTHETABLE := 'YES' ;
                   else
                       :P634_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 19202885503428893
        }
    )

