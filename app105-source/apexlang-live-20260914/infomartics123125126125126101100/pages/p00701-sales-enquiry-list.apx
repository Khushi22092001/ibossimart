    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 50
            region: @sales-enquiry-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 702
                clearCache: 702
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 40
            region: @sales-enquiry-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button pdf (
        buttonName: PDF
        label: Pdf
        layout {
            sequence: 30
            region: @sales-enquiry-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
        serverSideCondition {
            type: never
        }
    )

    button refresh (
        buttonName: REFRESH
        label: Refresh
        layout {
            sequence: 150
            region: @filter
            slot: regionBody
            startNewRow: false
            column: 10
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction pagination (
        name: Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

