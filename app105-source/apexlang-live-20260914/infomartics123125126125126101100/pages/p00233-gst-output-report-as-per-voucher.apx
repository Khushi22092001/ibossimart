                sequence: 10
            )

            displayColumn IRN (
                sequence: 27
            )

            displayColumn MODULECODE (
                sequence: 5
            )

            displayColumn NAMEOFCUSTOMER (
                sequence: 6
            )

            displayColumn NAMEOFSITE (
                sequence: 2
            )

            displayColumn OTHERINCIDENTALAMOUNT (
                sequence: 23
            )

            displayColumn PARTICULAROFITEMJOB (
                sequence: 12
            )

            displayColumn QUANTITY (
                sequence: 14
            )

            displayColumn SERIALNO (
                sequence: 1
            )

            displayColumn SGST (
                sequence: 21
            )

            displayColumn SUPPLIERSTATE (
                sequence: 7
            )

            displayColumn TAXABLEVALUEBEFORETAX (
                sequence: 16
            )

            displayColumn TOTALTAX (
                sequence: 22
            )

            displayColumn TRANSACTIONTYPECODE (
                sequence: 17
            )

            displayColumn UNIT (
                sequence: 15
            )

            displayColumn VALIDTILLDATE (
                sequence: 30
            )

            displayColumn VOUCHERDATE (
                sequence: 4
            )

            displayColumn VOUCHERNO (
                sequence: 3
            )

            sort (
                column: VOUCHERDATE
                sort {
                    sequence: 1
                }
            )

            aggregate (
                column: QUANTITY
            )

            aggregate (
                column: TAXABLEVALUEBEFORETAX
            )

            aggregate (
                column: IGST
            )

            aggregate (
                column: CGST
            )

            aggregate (
                column: SGST
            )

            aggregate (
                column: TOTALTAX
            )

            aggregate (
                column: OTHERINCIDENTALAMOUNT
            )

            aggregate (
                column: INVOICEAMOUNT
            )

            aggregate (
                function: count
                column: SERIALNO
            )

        )

    )

    region gst-output-report-as-per-voucher (
        name: GST Output Report As Per Voucher
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    pageItem P233_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       Distinct
                       p.CompanyName d,
                       p.CompanyCode r
                From  Company p
                Order by 1
                  
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @gst-output-report-as-per-voucher
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Company
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P233_COMPANYGSTIN (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company GSTIN
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       Distinct
                       p.SELLERDTLS_GSTIN d,
                       p.SELLERDTLS_GSTIN r
                From InvoiceForEI0101Revised p
                Order By 1
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 110
            region: @gst-output-report-as-per-voucher
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P233_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @gst-output-report-as-per-voucher
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
