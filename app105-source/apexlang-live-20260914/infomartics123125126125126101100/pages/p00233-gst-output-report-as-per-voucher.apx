                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 52
            valuePlaceholder: From Date
        }
        validation {
            valueRequired: true
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P233_LOCATION (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Location
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                  Select distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = 'PAYMENTADVICE'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order by 1
                ;
                  
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @gst-output-report-as-per-voucher
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Location
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P233_MODULECODE (
        type: popupLov
        label {
            label: Module
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        A.modulecode as modulename,
                        A.modulecode r
                From gsttaxinoutdetail a
                Where a.Type ='OUTWARD'
                and A.modulecode <> 'PAYMENTADVICE'
                ```
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @gst-output-report-as-per-voucher
            slot: regionBody
            alignment: left
            startNewRow: false
            column: 5
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter Module
        }
    )

