    }
    security {
        formAutoComplete: false
    }

    pageItem P272_BANKCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 55
            slot: contentBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    pageItem P272_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 75
            slot: contentBody
        }
        source {
            used: always
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
        sessionState {
            storage: request
        }
    )

    pageItem P272_FROMDATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 35
            slot: contentBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    pageItem P272_RADIOGROUP (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 65
            slot: contentBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P272_TODATE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 45
            slot: contentBody
        }
        source {
            used: always
        }
        sessionState {
            storage: request
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 25
            slot: contentBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button reconsilation (
        buttonName: Reconsilation
        label: Reconsilation
        layout {
            sequence: 10
            slot: contentBody
            column: 5
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--pillStart
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button statement (
        buttonName: Statement
        label: Statement
        layout {
            sequence: 15
            slot: contentBody
            column: 5
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--pillEnd
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close (
        name: close
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @reconsilation
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF_new();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @statement
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: PDF_new();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

