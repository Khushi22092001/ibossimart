page 16 (
    name: Step 3
    alias: STEP-3
    title: Step 3
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region step (
        name: Step 3
        type: list
        source {
            list: @company
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/wizard-container
            templateOptions: [
                #DEFAULT#
                t-Wizard--hideStepsXSmall
            ]
        }
        componentAppearance {
            listTemplate: @/wizard-progress
            templateOptions: [
                #DEFAULT#
                t-WizardSteps--displayLabels
            ]
        }
    )

    region step-2 (
        name: Step 3
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                       WORKSADDRESS,
                       WORKSCITYCODE,
                       WORKSSTATECODE,
                       WORKSPINCODE,
                       WORKSPHONENO,
                       WORKSFAXNO,
                       WORKSEMAIL
                  from COMPANY
                ```
        }
        layout {
            sequence: 10
            parentRegion: @step
            slot: wizardSubRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P16_WORKSADDRESS (
        type: textField
        label {
            label: Worksaddress
            alignment: left
        }
        layout {
            sequence: 210
            region: @step-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @step-2
            column: WORKSADDRESS
            dataType: varchar2
        }
    )

    pageItem P16_WORKSCITYCODE (
        type: textField
        label {
            label: Workscitycode
            alignment: left
        }
        layout {
            sequence: 220
            region: @step-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @step-2
            column: WORKSCITYCODE
            dataType: varchar2
        }
    )

    pageItem P16_WORKSEMAIL (
        type: textField
        label {
            label: Worksemail
            alignment: left
        }
        layout {
            sequence: 270
            region: @step-2
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @step-2
            column: WORKSEMAIL
            dataType: varchar2
        }
    )

    pageItem P16_WORKSFAXNO (
        type: textField
        label {
            label: Worksfaxno
            alignment: left
        }
        layout {
            sequence: 260
            region: @step-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @step-2
            column: WORKSFAXNO
            dataType: varchar2
        }
    )

    pageItem P16_WORKSPHONENO (
        type: textField
        label {
            label: Worksphoneno
            alignment: left
        }
        layout {
            sequence: 250
            region: @step-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @step-2
            column: WORKSPHONENO
            dataType: varchar2
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P16_WORKSPINCODE (
        type: textField
        label {
            label: Workspincode
            alignment: left
        }
        layout {
            sequence: 240
            region: @step-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @step-2
            column: WORKSPINCODE
            dataType: varchar2
        }
    )

    pageItem P16_WORKSSTATECODE (
        type: textField
        label {
            label: Worksstatecode
            alignment: left
        }
        layout {
            sequence: 230
            region: @step-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @step-2
            column: WORKSSTATECODE
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @step
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button next (
        buttonName: NEXT
        label: Next
        layout {
            sequence: 30
            region: @step
            slot: next
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: t-Button--iconRight
            icon: fa-chevron-right
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button previous (
        buttonName: PREVIOUS
        label: Previous
        layout {
            sequence: 20
            region: @step
            slot: previous
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-chevron-left
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process initialize-form-step (
        name: Initialize form Step 3
        type: formInitialization
        formRegion: @step-2
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 135499100927106405
        }
    )

    branch (
        execution {
            sequence: 10
            point: validating
        }
        behavior {
            target: {
                page: 15
            }
        }
        serverSideCondition {
            whenButtonPressed: @previous
        }
    )

    branch (
        execution {
            sequence: 20
        }
        behavior {
            target: {
                page: 17
            }
        }
        serverSideCondition {
            whenButtonPressed: @next
        }
    )

)

