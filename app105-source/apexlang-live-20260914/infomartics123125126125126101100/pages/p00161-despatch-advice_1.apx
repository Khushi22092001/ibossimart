    dynamicAction check-pending-son-qty (
        name: Check Pending Son Qty
        execution {
            sequence: 180
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @item-detail
            columns: QUANTITY1
        }

        action against-jo (
            name: Against JO
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        tmp float;
                        tmp1 float;
                    begin
                        if :P161_FORMSTATUS in  ('NEWRECORD','EDITRECORD') then
                            tmp := GETPENDINGJOQUANTITY1(:ITEMCODE,:ITEMSPECIFICATIONCODE,:P161_REFERENCETNO);
                            
                            if :QUANTITY1 > tmp then
                                :QUANTITY1 := 0;
                                --raise_application_error(-20000,'Entered Quantity cannot be greater than JOB ORDER Quantity1.');
                            end if;
                        else
                             tmp := GETPENDINGJOQUANTITY1(:ITEMCODE,:ITEMSPECIFICATIONCODE,:P161_REFERENCETNO);
                    
                             select sum(b.quantity1) into tmp1 from despatchadvice a , despatchadvicedetail b
                            where a.tno = b.tno
                            and a.REFERENCETNO = :P161_REFERENCETNO
                            and b.itemcode = :ITEMCODE
                            and b.ITEMSPECIFICATIONCODE = :ITEMSPECIFICATIONCODE;
                            
                            if :QUANTITY1 > tmp+tmp1 then
                                :QUANTITY1 := 0;
                                --raise_application_error(-20000,'Entered Quantity cannot be greater than JOB ORDER Quantity1.');
                            end if;
                    
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    QUANTITY1
                    ITEMCODE
                    ITEMSPECIFICATIONCODE
                    P161_SALESORDERTNO
                    P161_REFERENCETNO
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P161_DOCTYPECODE
                value: CONVERSIONJOBOUTOFPREMISES
            }
        )

        action against-so (
            name: Against SO
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        tmp float;
                        tmp1 float;
                    begin
                        if :P161_FORMSTATUS in  ('NEWRECORD','EDITRECORD') then
                            tmp := GETPENDINGSOQUANTITY1(:ITEMCODE,:ITEMSPECIFICATIONCODE,:P161_REFERENCETNO);
                            
                            if :QUANTITY1 > tmp then
                                :QUANTITY1 := 0.000;
                                --raise_application_error(-20000,'Entered Quantity cannot be greater than SALES ORDER Quantity1.');
                            end if;
                        else
                             tmp := GETPENDINGSOQUANTITY1(:ITEMCODE,:ITEMSPECIFICATIONCODE,:P161_REFERENCETNO);
                    
                             select sum(b.quantity1) into tmp1 from despatchadvice a , despatchadvicedetail b
                            where a.tno = b.tno
                            and a.REFERENCETNO = :P161_REFERENCETNO
                            and b.itemcode = :ITEMCODE
                            and b.ITEMSPECIFICATIONCODE = :ITEMSPECIFICATIONCODE;
                            
                            if :QUANTITY1 > tmp+tmp1 then
                                :QUANTITY1 := 0.000;
                                --raise_application_error(-20000,'Entered Quantity cannot be greater than SALES ORDER Quantity1.');
                            end if;
                    
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    QUANTITY1
                    ITEMCODE
                    ITEMSPECIFICATIONCODE
                    P161_SALESORDERTNO
                    P161_REFERENCETNO
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P161_DOCTYPECODE
                value: SALE
            }
            serverSideCondition {
                type: never
            }
        )

        action against-so-2 (
            name: Against SO
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        tmp float;
                        tmp1 float;
                    begin
                    --RAISE_APPLICATION_ERROR(-20000,'Q '||:QUANTITY1||' B '||:BALANCE);
                        if :P161_FORMSTATUS in  ('NEWRECORD','EDITRECORD') then
                     
                            if TO_NUMBER(:QUANTITY1) > TO_NUMBER(:balance) then
                                :QUANTITY1 := 0.000;
                                --raise_application_error(-20000,'Entered Quantity cannot be greater than SALES ORDER Quantity1.');
                            end if;
                    
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    QUANTITY1
                    BALANCE
                ]
                itemsToReturn: QUANTITY1
                showProcessing: true
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                componentType: item
                item: P161_DOCTYPECODE
                value: SALE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    
                    
                    raise_application_error(-20000,'Quantity mismatch.');
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: QUANTITY1
                value: .000
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                      round(:QUANTITY1 ,getuomdecimal(GetMeasuringUnitCodeFromItem(:ITEMCODE)) ) 
                    from dual 
                    ```
                itemsToSubmit: [
                    QUANTITY1
                    ITEMCODE
                ]
            }
            affectedElements {
                selectionType: columns
                columns: QUANTITY1
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

