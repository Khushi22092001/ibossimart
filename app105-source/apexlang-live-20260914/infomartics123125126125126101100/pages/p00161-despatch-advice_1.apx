    dynamicAction set-value-from-sales-order (
        name: set value from Sales Order
        execution {
            sequence: 120
        }
        when {
            event: focusout
            selectionType: items
            items: P161_REFERENCETNO
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT 
                        tno,
                        agentcode,
                        consigneecode,
                        partycode,
                        partytypecode
                    FROM (
                        -- Sales Order
                        SELECT 
                            a.tno,
                            a.agentcode,
                            a.consigneecode,
                            a.partycode,
                            b.partytypecode
                        FROM SalesOrder a
                        LEFT JOIN Party b 
                            ON a.partycode = b.partycode
                        WHERE a.tno = :P161_REFERENCETNO
                    
                        UNION ALL
                    
                        -- Job Order
                        SELECT
                            jo.tno,
                            NULL AS agentcode,
                            NULL AS consigneecode,
                            jo.partycode,
                            p.partytypecode
                        FROM JobOrder jo
                        LEFT JOIN Party p 
                            ON jo.partycode = p.partycode
                        WHERE jo.tno = :P161_REFERENCETNO
                    );
                    ```
                itemsToSubmit: P161_REFERENCETNO
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: [
                    P161_SALESORDERTNO
                    P161_AGENTCODE
                    P161_CONSIGNEECODE
                    P161_PARTYCODE
                    P161_PARTYTYPECODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    -- Sales Order
                    SELECT
                        a.tno,
                        a.agentcode,
                        a.consigneecode,
                        a.partycode,
                        b.partytypecode
                    FROM SalesOrder a
                    LEFT JOIN Party b ON a.partycode = b.partycode
                    WHERE a.tno = :P161_REFERENCETNO
                    
                    UNION ALL
                    
                    -- Job Order
                    SELECT
                        jo.tno,
                        CAST(NULL AS VARCHAR2(30)) AS agentcode,
                        jo.partycode AS consigneecode,
                        jo.partycode,
                        p.partytypecode
                    FROM JobOrder jo
                    LEFT JOIN Party p ON jo.partycode = p.partycode
                    WHERE jo.tno = :P161_REFERENCETNO;
                    ```
                itemsToSubmit: P161_REFERENCETNO
                suppressChangeEvent: true
            }
            affectedElements {
                selectionType: items
                items: [
                    P161_SALESORDERTNO
                    P161_AGENTCODE
                    P161_CONSIGNEECODE
                    P161_PARTYCODE
                    P161_PARTYTYPECODE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            comments {
                comments:
                    ```
                    --TO check the column data length
                    ----------------------------------
                    SELECT column_name, data_type, data_length
                    FROM all_tab_columns
                    WHERE table_name = 'SALESORDER'
                    AND column_name IN ('AGENTCODE', 'CONSIGNEECODE');
                    ```
            }
        )

    )

