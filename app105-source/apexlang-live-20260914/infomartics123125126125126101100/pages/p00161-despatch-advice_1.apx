    pageItem P161_AGENTCODE (
        type: popupLov
        label {
            label: Agent
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select partyname,partycode 
                from party a
                where getdocumentstatuscode('PARTY',a.tno)='ACTIVE'
                AND A.PARTYTYPECODE='AGENT' 
                ORDER BY 1
                ```
            nullDisplayValue: - Select -
        }
        layout {
            sequence: 110
            region: @general
            slot: regionBody
            alignment: left
