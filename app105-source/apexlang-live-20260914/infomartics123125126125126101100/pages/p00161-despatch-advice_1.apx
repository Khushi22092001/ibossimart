    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P161_Tno is null then
                        Select GlobalTno.NextVal into :P161_Tno From Dual;
                     end if;
                    ----
                    if :P161_DESPATCHADVICENO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P161_LocationCode,
                					:P161_DocTypeCode,
                					NULL,
                					TO_DATE(:P161_DESPATCHADVICEDATE, 'DD-MM-RRRR')
                				);
                        :P161_DESPATCHADVICENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P161_LocationCode,
                                    :P161_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P161_DESPATCHADVICEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
