                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region despatch-advice (
        name: Despatch Advice
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.LOCATIONCODE,
                       a.DOCTYPECODE,
                       a.COMPANYCODE,
                       a.FINANCIALYEARCODE,
                       a.DESPATCHADVICENO,
                       a.DESPATCHADVICEDATE,
                       a.PARTYCODE,
                       a.TRANSPORTERCODE,
                       a.DRIVERNAME,
                       a.VEHICLETYPECODE,
                       a.VEHICLENO,
                       a.REFDOCTYPECODE,
                       a.REFDOCUMENTNO,
                       a.REFDOCUMENTDATE,
                       a.REFDOCUMENTAMOUNT,
                       a.REMARK,
                       a.SALESORDERTNO,
                       a.AGENTCODE,
                       a.CONSIGNEECODE,
                       a.REFERENCETNO,
                       a.EMPLOYEECODE,
                       a.WEIGHMENTTNO,
                       a.CREATOR,
                       a.MODULETNO,
                       a.MODULECODE,
                       a.CREATIONTIME,
                       a.TRANSPORTALLOCATIONTNO,
                       a.OLDVEHICLENO,
                       NVL(getdocumentstatuscode(getmodulecodeforpageno(:APP_PAGE_ID), A.TNO),'STATUS') AS Status
                  from DESPATCHADVICE a
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
        advanced {
            htmlDomId: tabcontainer
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region general (
        name: General
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @despatch-advice
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: General
        }
    )

    region item-detail (
        name: Item Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.rowid , A.TNO,
                       A.SNO,
                       A.ITEMCODE,
                       A.ITEMSPECIFICATIONCODE,
                       A.PACKINGTYPECODE,
                       A.DESCRIPTION,
                       A.RATE,
                       A.QUANTITY1,
                       --c.MEASURINGUNITCODE UOM1,
                       A.QUANTITY2,
                       --D.MEASURINGUNITCODE UOM2,
                       A.REASONFORRETURN,
                       A.REMARK,
                       A.SERIALNO,
                       A.ISWEIGHTTAKEN,
                       A.WEIGHMENTTNO,
                       A.PACKINGNOS,
                       A.CANCELEDQUANTITY1,
                       A.CANCELEDBY,
                       GetMeasuringUnitNameFromItem(A.ITEMCODE) as UNIT1,
                       GetMeasuringUnit2NameFromItem(A.ITEMCODE) as UNIT2,
                       NULL AS Balance
                  from DESPATCHADVICEDETAIL A
                  where  A.TNO = :P161_TNO
                
                
                ```
            pageItemsToSubmit: [
                P161_TNO
                P161_DOCTYPECODE
                P161_REFERENCETNO
            ]
        }
        layout {
            sequence: 30
            parentRegion: @despatch-advice
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail
        }
        edit {
            enabled: true
            allowedOperations: [
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                    //Tab and Shift-Tab will skip over cells that are read-only
                    options.defaultGridViewOptions = {  
                        skipReadonlyCells: true  
                    };
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 166513246751806545
        }

