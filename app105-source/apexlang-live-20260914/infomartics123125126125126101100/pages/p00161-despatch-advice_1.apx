            settings {
                jsCode:
                    ```javascript-browser
                    var index;
                    
                    var model = this.data.model;
                    
                    var meta = model.getRecordMetadata(this.data.recordId);
                    
                    if ( meta.inserted && !meta.updated ) {
                    
                    
                        index =  $v("P161_NEXT_SERIALNO");
                    
                        index +++ 1;
                    
                        $s("P161_NEXT_SERIALNO", index);
                    
                        $s("SERIALNO",index );
                    
                    
                    }
                    
                    
