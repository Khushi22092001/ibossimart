    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P652_Tno is null then
                        Select GlobalTno.NextVal into :P652_Tno From Dual;
                     end if;
                    ----
                    if :P652_TOURREQUESTNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P652_LocationCode,
                					:P652_DocTypeCode,
                					NULL,
                					TO_DATE(:P652_TOURREQUESTDATE, 'DD-MM-RRRR')
                				);
                        :P652_TOURREQUESTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P652_LocationCode,
                                    :P652_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P652_TOURREQUESTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 26144036754383985
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P652_TNO is null then
                    :P652_TNO := GlobalTNo.nextval;
                    :P652_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P652_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P652_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P652_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 26096447466312243
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P652_MODULEFLOW := 'YES';
                   else
                       :P652_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P652_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P652_ONTHETABLE := 'YES' ;
                   else
                       :P652_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 26096795192314576
        }
    )

