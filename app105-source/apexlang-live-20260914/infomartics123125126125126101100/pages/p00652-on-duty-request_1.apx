    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       EXPENSETYPECODE,
                       ACCOUNTCODE,
                       MODEOFTRAVELCODE,
                       CATEGORYCODE,
                       CLASSOFCITYCODE,
                       MEASURINGUNITCODE,
                       RATE,
                       REMARK,
                       ISBILLREQUIRED
                  from TOURREQUESTDETAIL
                  where tno = :P652_TNO
                ```
            pageItemsToSubmit: P652_TNO
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
