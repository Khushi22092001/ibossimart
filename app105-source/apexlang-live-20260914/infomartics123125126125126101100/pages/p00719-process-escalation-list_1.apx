page 719 (
    name: Process Escalation List
    alias: PROCESS-ESCALATION-LIST
    title: Process Escalation List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region process-escalation-list (
        name: Process Escalation List
        type: interactiveReport
        source {
            location: localDatabase
            tableName: PROCESSESCALATION
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 720
                items: {
                    P720_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 131267109349786510
        }

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column PROCESSESCALATIONCODE (
            type: plainText
            heading {
                heading: Process Escalation Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column PROCESSESCALATIONNAME (
            type: plainText
            heading {
                heading: Process Escalation Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column PROCESSROUTINGTNO (
            type: plainText
            heading {
                heading: Process Routing Tno
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Process Escalation List
        }

        savedReport 102256 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATIONTIME (
                sequence: 7
            )

            displayColumn CREATOR (
                sequence: 6
            )

            displayColumn PROCESSESCALATIONCODE (
                sequence: 2
            )

            displayColumn PROCESSESCALATIONNAME (
                sequence: 3
            )

            displayColumn PROCESSROUTINGTNO (
                sequence: 4
            )

            displayColumn REMARK (
                sequence: 5
            )

            displayColumn TNO (
                sequence: 1
            )

        )

    )

    pageItem P719_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 50
            region: @process-escalation-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 720
                clearCache: 720
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 40
            region: @process-escalation-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button pdf (
        buttonName: Pdf
        label: Pdf
        layout {
            sequence: 30
            region: @process-escalation-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-file-pdf-o
        }
        behavior {
            action: definedByDynamicAction
        }
    )

)

