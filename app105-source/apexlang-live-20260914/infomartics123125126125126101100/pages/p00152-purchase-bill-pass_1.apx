                                    TAXRULECODE=:TAXRULECODE,
                                    QUALITYCODE=:QUALITYCODE,
                                    PRORATA=:PRORATA
                
                            WHERE TNO = :P152_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From PBPASSDETAIL
                            Where TNo = :P152_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
