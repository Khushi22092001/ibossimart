        name: Select Purchase Bill No And Pass On
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @purchase-bill-pass
            slot: subRegions
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region tds (
        name: TDS
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       SERIALNO,
                       FOOTERHEADCODE,
                       FOOTERVALUE,
                       FOOTERPERCENT
                  from PBPASSTDSDETAIL
                  where tno = :P152_TNO
                ```
            pageItemsToSubmit: P152_TNO
        }
        layout {
            sequence: 50
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 166701093330857007
        }

        savedReport 1672615 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 4
                }
            )

            displayColumn (
                column: @SERIALNO
                layout {
                    show: false
                    sequence: 5
                }
            )

            displayColumn (
                column: @FOOTERHEADCODE
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @FOOTERVALUE
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @FOOTERPERCENT
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column FOOTERHEADCODE (
            type: textField
            heading {
                heading: Footer Head
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: FOOTERHEADCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column FOOTERPERCENT (
            type: numberField
            heading {
                heading: Footer %
                alignment: end
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            source {
                databaseColumn: FOOTERPERCENT
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column FOOTERVALUE (
            type: numberField
            heading {
                heading: Footer Value
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                databaseColumn: FOOTERVALUE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column ROWID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROWID
                dataType: rowid
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column SERIALNO (
            type: numberField
            heading {
                heading: Serialno
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: SERIALNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column SNO (
            type: numberField
            heading {
                heading: Sno
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            source {
                databaseColumn: SNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TNO (
            type: numberField
            heading {
                heading: Tno
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            source {
                databaseColumn: TNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: TDS
        }
    )

