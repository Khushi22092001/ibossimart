    dynamicAction set-footer (
        name: set footer
        execution {
            sequence: 425
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @detail
            columns: FD
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(sum(footervalue),0) from pbpassdetailfooter
                    where tno = :tno
                    and sno = :sno
                    ```
                itemsToSubmit: [
                    TNO
                    SNO
                ]
