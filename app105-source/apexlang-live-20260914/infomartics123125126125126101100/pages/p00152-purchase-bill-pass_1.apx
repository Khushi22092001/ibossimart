        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P152_Tno is null then
                        Select GlobalTno.NextVal into :P152_Tno From Dual;
                     end if;
                    ----
                    if :P152_PBPASSNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P152_LocationCode,
                					:P152_DocTypeCode,
                					NULL,
                					TO_DATE(:P152_PBPASSDATE, 'DD-MM-RRRR')
                				);
                        :P152_PBPASSNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P152_LocationCode,
                                    :P152_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P152_PBPASSDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                
                    --raise_application_error(-20000,:P152_PBPASSAMOUNT);
                    
                end;
