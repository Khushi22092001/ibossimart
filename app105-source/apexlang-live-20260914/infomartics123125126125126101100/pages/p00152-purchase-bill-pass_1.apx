    region detailfooter (
        name: DetailFooter
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       SERIALNO,
                       FOOTERHEADCODE,
                       FOOTERPERCENT,
                       FOOTERVALUE,
                       TAXFORMCODE,
                       INCLUDEDINRATE,
                       LEGENDSCODE,
                       FOOTERNATURECODE,
                       FOOTERNATUREUSER,
                       COSTAMOUNT,
                       SN
                  from PBPASSDETAILFOOTER
                  where tno = :P152_TNO
                  and sno = :P152_SNO
                ```
            pageItemsToSubmit: [
                P152_TNO
                P152_SNO
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-size720x480
            ]
