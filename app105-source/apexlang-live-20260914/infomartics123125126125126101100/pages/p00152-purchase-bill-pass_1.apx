    dynamicAction set-tds-deductable-amount (
        name: set tds deductable amount
        execution {
            sequence: 610
        }
        when {
            selectionType: items
            items: [
                P152_PBPASSAMOUNT
                P152_PAIDINADVANCE
            ]
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: nvl(:P152_PBPASSAMOUNT,0)-nvl(:P152_PAIDINADVANCE,0)
                itemsToSubmit: [
                    P152_PBPASSAMOUNT
                    P152_PAIDINADVANCE
                ]
            }
            affectedElements {
                selectionType: items
                items: P152_TDSDEDUCTABLEAMOUNT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

