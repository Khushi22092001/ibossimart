    process detail-save-interactive-grid-data (
        name: DETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            if :SNO is null then
                                select globaltno.nextval into :sno from dual;
                            end if;
                            Insert Into RTGSLETTERDETAIL  (                 
                                    TNO,
                                    SNO,
                                    PAYMENTADVICETNO,
                                    AMOUNT,
                                    REMARK
                
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :PAYMENTADVICETNO,
                                :AMOUNT,
                                :REMARK
                
                            );
                        
                        when 'U' then
                            update RTGSLETTERDETAIL  Set
                                 TNO=:TNO,
                                SNO=:SNO,
                                PAYMENTADVICETNO=:PAYMENTADVICETNO,
                                AMOUNT=:AMOUNT,
                                REMARK=:REMARK
                
                            WHERE TNO = :P271_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From RTGSLETTERDETAIL 
                            Where TNo = :P271_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
