    dynamicAction new (
        name: New
        execution {
            sequence: 230
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    
                    begin
                    		
                    		if :P271_ExpandLevel is not null then
                    	
                    				delete
                    					from TrialBalance a
                    					where a.CompanyCode = 'ACCOUNTLIST' ||  v('APP_USER')
                    		;
                    				
                    				for vAccount
                    						in (
                    								select
                    										distinct
                    										a.AccountCode
                    								from AccountList a
                    								where a.ChildLevel > :P271_ExpandLevel 
                    										and a.AccountTypeCode = 'ACCOUNTGROUP'
                    						)
                    				loop
                    						insert into TrialBalance(
                    								CompanyCode,
                    								LocationCode,
                    								AccountCode
                    						) select
                    								'ACCOUNTLIST' ||  v('APP_USER'),
                    								vAccount.AccountCode,
                    								a.PartyCode
                    						from Party a
                    						where a.PartyCode != vAccount.AccountCode
                    						start with a.PartyCode = vAccount.AccountCode
                    						connect by prior a.PartyCode = a.ParentCode
                    						;
                    				end loop;
                    				--
                    				commit;
                    				--
                    		end if;
                    
                    end;
                    ```
                itemsToSubmit: P271_EXPANDLEVEL
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 250
        }
        when {
            event: click
            selectionType: button
            button: @preparepaymentadvice
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    	ttno varchar2(4000);
                    	tfinancialyearcode varchar2(30);
                    	tdate date := trunc(sysdate);
                    	tpaymentadvice varchar2(100);
                    	ttobepaid number;
                    	ATNO		NUMBER;
                    	TSUMAMMOUNT NUMBER;
                    	tsql varchar2(2000);
                    begin
                    
                    	
                    	select financialyearcode into tfinancialyearcode from 
                    	financialyear a
                    	where trunc(sysdate) between a.financialyearbegin and a.financialyearend ;
                    	
                       for cpay in (
                    		select 
                    		  a.locationcode,		  
                    		  a.partycode,
                    		  a.companycode,
                    		  --b.tdsnaturecode,
                    		  --b.tdspayeecategorycode,		  
                    		  sum(a.balanceamount) amount
                    		from pendingbills a , PARTY B 
                    		where instr(:P271_SELECTEDTNO ,':' || a.REFERENCEMODULETNO || ':') > 0
                       		 AND A.PARTYCODE = B.PARTYCODE
                    		 and not exists
                    		 ( select 1 from paymentadvicereference x
                    		   where x.referencemoduletno = a.referencemoduletno
                    		  )
                    		 group by a.partycode,locationcode, a.companycode --, b.tdsnaturecode,b.tdspayeecategorycode
                        ) loop
                    
                    		     tToBePaid := cpay.AMOUNT;
                    		     --
                    		      select GLOBALTNO.NEXTVAL INTO ATNO FROM DUAL;
                    		      --
                    		      setdocnonext(
                    		        'PAYMENTADVICE',
                    		        cpay.COMPANYCODE,
                    		        tfinancialyearcode,
                    		        cpay.LOCATIONCODE,
                    		        'PAYMENT',
                    		        NULL,
                    		        tDate
                    		      );
                    		      --
                    		      tpaymentadvice := getdocno(
                    		        'PAYMENTADVICE',
                    	          cpay.COMPANYCODE,
                    		        tfinancialyearcode,
                    		        cpay.LOCATIONCODE,
                    		        'PAYMENT',
                    		        NULL,
                    		        tDate
                    		      );
                    		      --
                        	
                        	
                        	
                             INSERT INTO PAYMENTADVICE(
                    			        TNO,
                    			        COMPANYCODE,
                    			        FINANCIALYEARCODE,
                    			        LOCATIONCODE,
                    			        DOCTYPECODE,
                    			        PAYMENTADVICEDATE,
                    			        PAYMENTADVICENO,
                    			        TRANSACTIONTYPECODE,
                    			        NATUREOFSUPPLYCODE,
                    			        partycode,
                    			        ISINDIANRESIDENT,
                    			        PAYMENTAGAINST,
                    			        --TDSNATURECODE,
                    			        --TDSPAYEECATEGORYCODE,
                    			        AMOUNT,
                    			        AMOUNTDR,
                    			        AMOUNTCR,
                    			        modulecode,
                    			        moduletno,
                    			        infavourof,
                    			        Narration
                    			      )values(
                    			        ATNO,
                    			        cPay.companycode,
                    			        tfinancialyearcode,
                    			        cPay.locationcode,
                    			        'PAYMENT',
                    			        tDate,
                    			        tpaymentadvice,
                    			        null , --vPAYMENTADVICE.TRANSACTIONTYPECODE,
                    			        null, --vPAYMENTADVICE.NATUREOFSUPPLYCODE,
                    			        cPay.partycode,
                    			        'YES',
                    			        'GOODS',
                    			        --cpay.tdsnaturecode , -- vPAYMENTADVICE.TDSNATURECODE,
                    			        --cpay.tdspayeecategorycode , -- 
                    			        tToBePaid,
                    			        tToBePaid,
                    			        tToBePaid,
                    			        'PAYBLEBILLS',--null , --cpay.referencemodulecode,
                    			        NULL , --cpay.REFERENCEMODULETNO,
                    			        getpartyname(cPay.partycode),
                    			        NULL --tNarration
                    			      );
                    
                        
                        		for cref in (
                        		  select * from pendingbills A
                        		  where a.locationcode = cpay.locationcode
                        		    and a.partycode = cpay.partycode
                        		    and a.companycode = cpay.companycode
                        		     and instr(:P271_SELECTEDTNO ,':' || a.REFERENCEMODULETNO || ':') > 0
                    				    and not exists
                    						 ( select 1 from paymentadvicereference x
                    						   where x.referencemoduletno = a.referencemoduletno
                    						  )
                    		    
                        		)loop
                        		
                        		    ---PaymentAdviceReference------------------------------------
                    			      Insert into PaymentAdviceReference (
                    			        tno,
                    			        sno,
                    			        REFERENCEMODULETNO,
                    			        REFERENCEMODULECODE,
                                        amountentered,
                    			        amount
                    			      ) values (
                    			        ATNO,
                    			        GLOBALTNO.NEXTVAL,
                    			        cref.REFERENCEMODULETNO,
                    			        cref.REFERENCEMODULECODE ,
                                        cref.balanceamount,
                    			        cref.balanceamount
                    			      );
                    
                                       SendPassFailForward('PAYMENTADVICE', ATNO, tpaymentadvice, cpay.companycode);
                    
                        		
                        		end loop;
                        
                        
                        end loop;
                     commit;
                     end;
                    ```
                itemsToSubmit: P271_SELECTEDTNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: alert('Payment Advice Has Been Created');
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) ;--:= :P80_PICKUPREQUESTNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = ':P'||:APP_PAGE_ID||'_TNo'
                    				and d.LoginName = User
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                    
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = ':P'||:APP_PAGE_ID||'_PASSFAILREMARK'
                    			where a.TNo = vPassFail.TNo;
                    			
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(tModuleCode, ':P'||:APP_PAGE_ID||'_TNo' , TMP, :global_CompanyCode );
                    
                                 if :P271_STATUS = 'ACTIVE' then
                            
                                    CREATEPAYMENTADVICEFORPO(:P271_TNO);
                    
                                  end if;
                    
                        end if;
                    END;
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P271_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

