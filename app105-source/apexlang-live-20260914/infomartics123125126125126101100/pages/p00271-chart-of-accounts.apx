    dynamicAction click-refresh (
        name: click refresh
        execution {
            sequence: 270
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    APEX_UTIL.SET_SESSION_STATE ('P271_FROMDATE',:P271_FROMDATE);
                    APEX_UTIL.SET_SESSION_STATE ('P271_TODATE',:P271_TODATE);
                    APEX_UTIL.SET_SESSION_STATE ('P271_PARTY',:P271_PARTY);
                    APEX_UTIL.SET_SESSION_STATE ('P271_LOCATION',:P271_LOCATION);
                    
                    delete from summary_temp;
                    createMonthlySummary(:P271_FROMDATE,:P271_TODATE,:P271_PARTY,:P271_LOCATION,:GLOBAL_COMPANYCODE);
                    
                    ```
                itemsToSubmit: [
                    P271_FROMDATE
                    P271_TODATE
                    P271_LOCATION
                    P271_PARTY
                    P271_TNO
                ]
                itemsToReturn: [
                    P271_FROMDATE
                    P271_TODATE
                    P271_LOCATION
                    P271_PARTY
                    P271_TNO
                ]
                showProcessing: true
            }
            execution {
                sequence: 20
                stopExecutionOnError: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    //alert('fired');  
                    var button = document.getElementById('REFRESH');
                        setTimeout(button.click(),50);
                    ```
            }
            execution {
                sequence: 40
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT GLOBALTNO.NEXTVAL, :P271_FROMDATE,:P271_TODATE,:P271_PARTY FROM DUAL;
                itemsToSubmit: [
                    P271_FROMDATE
                    P271_TODATE
                    P271_PARTY
                ]
            }
            affectedElements {
                selectionType: items
                items: P271_TNO
            }
            execution {
                sequence: 10
            }
        )

    )

