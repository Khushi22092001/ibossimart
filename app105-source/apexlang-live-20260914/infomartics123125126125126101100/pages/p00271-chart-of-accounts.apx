    region detail (
        name: DETAIL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                a.AccountCode,
                substr(LPAD(' ' , 1000, ' ') ,1, ( a.ChildLevel - 1 ) * 10   ) || decode(nvl(b.NoOfChildHidden, 0), 0, '-', '+'   ) || a.AccountName As AccountNameDisplay,
                a.AccountName,
                b.NoOfChildHidden,
                a.ACCOUNTTYPECODE,
                a.PARENTCODE,
                a.ChildLevel ,
                a.TNO,
                a.SERIALNO
                From AccountList a, AccountListChildHidden b
                Where
                a.AccountCode = b.AccountCode(+)
                and not exists(
                   select
                        aa.Accountcode
                   from TrialBalance aa
                   where aa.CompanyCode = 'ACCOUNTLIST' || V('APP_USER')
                        and aa.AccountCode = a.AccountCode
                )
                And Exists (Select 1
                          From party aa, partycompany bb
                         Where aa.tno = bb.tno(+)
                           And aa.partycode = a.AccountCode
                           And bb.companycode = :global_companycode)
                
                ```
            pageItemsToSubmit: P271_TNO
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
