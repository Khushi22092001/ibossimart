    process prepare-data (
        name: prepare data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                begin
                		
                		if :P271_ExpandLevel is not null then
                	
                				delete
                					from TrialBalance a
                					where a.CompanyCode = 'ACCOUNTLIST' ||  v('APP_USER')
                		;
                				
                				for vAccount
                						in (
                								select
                										distinct
                										a.AccountCode
                								from AccountList a
                								where a.ChildLevel > :P271_ExpandLevel 
                										and a.AccountTypeCode = 'ACCOUNTGROUP'
                						)
                				loop
                						insert into TrialBalance(
                								CompanyCode,
                								LocationCode,
                								AccountCode
                						) select
                								'ACCOUNTLIST' ||  v('APP_USER'),
                								vAccount.AccountCode,
                								a.PartyCode
                						from Party a
                						where a.PartyCode != vAccount.AccountCode
                						start with a.PartyCode = vAccount.AccountCode
                						connect by prior a.PartyCode = a.ParentCode
                						;
                				end loop;
                				--
                				commit;
                				--
                		end if;
                
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 10192902750748609
        }
    )

