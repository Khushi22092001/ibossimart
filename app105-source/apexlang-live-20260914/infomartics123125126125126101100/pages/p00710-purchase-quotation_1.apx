    region quotation (
        name: Quotation
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       QUOTATIONNO,
                       QUOTATIONDATE,
                       PARTYCODE,
                       VALIDITYDATE,
                       CURRENCYUNITCODE,
                       CURRENCYVALUE,
                       ENQUIRYTNO,
                       SUMOFAMOUNT,
                       QUOTATIONAMOUNT,
                       SUBJECTTEXT,
                       REFERENCETEXT,
                       LETTERTEXT,
                       TITLETEXT,
                       ITEMWISEFOOTER,
                       REMARK,
                       EMPLOYEECODE,
                       SUMOFFOOTERAMOUNT,
                       PARTYQUOTATIONNO,
                       PARTYQUOTATIONDATE,
                       CREATOR,
                       FREIGHTTYPECODE,
                       REVISIONQUOTATIONTNO,
                       CONTACTPERSON,
                       CONTACTNO,
                       DESIGNATION,
                       CREATIONTIME,
                       MODULETNO,
                       MODULECODE,
                       TRANSACTIONTYPECODE,
                       NATUREOFSUPPLYCODE,
                       CREDITDAYS,
                       VALIDITYDAYS,
                       NVL(getdocumentstatuscode('QUOTATION',TNO),'STATUS') AS Status
                  from QUOTATION
                ```
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: General
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region quotation-detail (
        name: Quotation Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid , TNO,
                       SNO,
                       SERIALNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       RATEMEASURINGUNITCODE,
                       RATE,
                       AMOUNT,
                       FOOTERAMOUNT,
                       TOTALAMOUNT,
                       REMARK,
                       WITHOUTDISCOUNTRATE,
                       DISCOUNTPERCENTAGE,
                       DISCOUNTRATE,
                       HSNCODE,
                       ISRATEINCLUSIVETAX,
                       RATEAFTERDISCOUNT,
                       'Q' as Q,
                       'FD' as FD,
                       GetMeasuringUnitNameFromItem(ITEMCODE) as Unit1,
                       GetMeasuringUnit2NameFromItem(ITEMCODE) as Unit2
                  from QUOTATIONDETAIL
                  where tno = :P710_TNO
                ```
            pageItemsToSubmit: P710_TNO
        }
        layout {
            sequence: 40
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
