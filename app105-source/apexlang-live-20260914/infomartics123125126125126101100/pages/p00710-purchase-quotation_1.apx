    dynamicAction detail (
        name: Detail
        execution {
            sequence: 460
        }
        when {
            event: click
            selectionType: button
            button: @getitem
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                    if :P710_ENQUIRYTNO is not null then
                        delete from quotationdetail where tno = :P710_TNO;
                    
                    end if;
                        for vloop in (select 
                                        itemcode , 
                                        ITEMSPECIFICATIONCODE , 
                                        DESCRIPTION , 
                                        QUANTITY1 , 
                                        QUANTITY2 
                                    from ENQUIRYITEMDETAIL 
                                    where tno = :P710_ENQUIRYTNO)
                        loop
                            insert into QUOTATIONDETAIL 
                            (tno,
                            sno,
                            itemcode,
                            ITEMSPECIFICATIONCODE,
                            DESCRIPTION,
                            QUANTITY1,
                            QUANTITY2
                            )
                            values (
                                :P710_TNO,
                                globaltno.nextval,
                                vloop.itemcode,
                                vloop.ITEMSPECIFICATIONCODE,
                                vloop.DESCRIPTION,
                                vloop.QUANTITY1,
                                vloop.QUANTITY2
                            );
                        end loop;
                    end;
                    ```
                itemsToSubmit: [
                    P710_TNO
                    P710_ENQUIRYTNO
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @quotation-detail
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 280
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
