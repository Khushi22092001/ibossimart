            settings {
                plsqlCode:
                    ```plsql
                    begin
                    
                        for vloop in (select 
                                        itemcode , 
                                        ITEMSPECIFICATIONCODE , 
                                        DESCRIPTION , 
                                        QUANTITY1 , 
                                        QUANTITY2 
                                    from ENQUIRYITEMDETAIL 
                                    where tno = :P710_ENQUIRYTNO)
                        loop
                            insert into QUOTATIONDETAIL 
                            (tno,
                            sno,
                            itemcode,
                            ITEMSPECIFICATIONCODE,
                            DESCRIPTION,
                            QUANTITY1,
                            QUANTITY2
                            )
                            values (
                                :P710_TNO,
                                globaltno.nextval,
                                vloop.itemcode,
                                vloop.ITEMSPECIFICATIONCODE,
                                vloop.DESCRIPTION,
                                vloop.QUANTITY1,
                                vloop.QUANTITY2
                            );
                        end loop;
                    end;
                    ```
