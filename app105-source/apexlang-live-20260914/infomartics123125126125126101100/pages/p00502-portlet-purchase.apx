        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                     vi.ITEMSPECIFICATIONNAME D,
                     vi.ITEMSPECIFICATIONCODE R
                FROM V_ITEM_DETAILS vi
                WHERE (:P504_ITEM_NAME is null or  vi.ITEMCODE = :P502_ITEM_NAME )
                ```
        }
        cascadingLov {
            parentItems: P502_ITEM_NAME
            itemsToSubmit: P502_ITEM_SPECIFICATION
        }
        layout {
            sequence: 70
            region: @filters
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
