    process get-default-values (
        name: Get Default Values
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P502_FY_BEGIN      := :GLOBAL_FINANCIALYEARBEGIN;
                    :P502_FY_END        := :GLOBAL_FINANCIALYEAREND;
                    IF :P502_DATE_RANGE IS NULL THEN
                        :P502_DATE_RANGE    :=  :P502_FY_BEGIN||' - '||:P502_FY_END;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 42738744179460610
        }
    )

)

