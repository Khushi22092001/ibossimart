                seriesName: ROOTNAME
                label: ROOTNAME
                value: AMOUNT
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s('P502_ITEM','&PARENTCODE.');
            }
            label {
                show: true
                displayAs: percentageValue
            }
        )

    )

