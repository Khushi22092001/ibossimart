    pageItem P502_ITEM_CATEGORY (
        type: selectOne
        label {
            label: Item Category
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT 
                    IC.ITEMCATEGORYNAME D, 
                    IC.ITEMCATEGORYCODE R 
                FROM ITEMCATEGORY IC
                JOIN ITEM I ON I.ITEMCATEGORYCODE = IC.ITEMCATEGORYCODE
                ```
        }
        layout {
            sequence: 50
            region: @filters
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    pageItem P502_ITEM_NAME (
        type: selectOne
        label {
            label: Item
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT DISTINCT
                     VI.ITEMNAME D,
                     VI.ITEMCODE R
                FROM INDENTDETAIL Id
                JOIN V_ITEM_DETAILS VI ON VI.ITEMCODE = ID.ITEMCODE
                WHERE (:P504_ITEM_CATEGORY is null or  VI.ITEMCATEGORYCODE = :P502_ITEM_CATEGORY )
                ```
        }
        cascadingLov {
            parentItems: P502_ITEM_CATEGORY
            itemsToSubmit: P502_ITEM_NAME
            parentRequired: false
        }
        layout {
            sequence: 60
            region: @filters
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

