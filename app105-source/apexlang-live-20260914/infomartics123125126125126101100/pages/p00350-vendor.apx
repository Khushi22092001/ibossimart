    process pre-rendering-tno (
        name: Pre Rendering Tno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE 
                    tTNo Number;
                BEGIN
                    IF :P350_TNO IS NULL THEN 
                        SELECT GLOBALTNO.NEXTVAL INTO tTNo FROM DUAL;
                        :P350_TNO := tTNo;
                        :P350_FORMSTATUS := 'NEWRECORD';
                    else 
                         :P350_FORMSTATUS := 'EDITRECORD';
                    END IF;
                     --- Get Voucher No
                    for vloop in ( select * from voucher where moduletno = :P350_TNO) loop
                        :P350_VOUCHERNO := VLOOP.VOUCHERNO;
                        :P350_VOUCHERTNO := VLOOP.TNO;
                    end loop;
                    
                END;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 73128045448749254
        }
    )

    process prepare-url (
        name: PREPARE_URL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   result varchar2(2000);
                begin
                   result:=apex_util.prepare_url(apex_application.g_x01);
                   apex_json.open_object;
                   apex_json.write('success', true);
                   apex_json.write('url', result);
                   apex_json.close_object;
                exception
                 when others then
                   apex_json.open_object;
                   apex_json.write('success', false);
                   apex_json.write('message', sqlerrm);
                   apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 60
            point: ajaxCallback
        }
