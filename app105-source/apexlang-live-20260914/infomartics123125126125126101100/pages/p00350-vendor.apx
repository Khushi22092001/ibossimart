                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P350_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P350_TNO,:P350_STATUS);
                    if :P350_STATUS = 'ACTIVE' then
                       PostReverseCharge(:P350_TNO,:P350_REVERSECHARGEDATE);
                    end if;
                    ```
                itemsToSubmit: [
                    P350_TNO
                    P350_STATUS
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text('');
                    $('#STATUS').text($v('P350_STATUS'));
                    
                    
                    ```
