    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                     
                     if nvl(tmp,0) > 0 and :P350_VENDORCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P350_VENDORCODE  := getCode(tModuleCode) ;
                     end if;
                end;
                
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 73129619244749256
        }
    )

