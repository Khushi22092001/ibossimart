    region attributes (
        name: Attributes
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.PartyAttributeName as ATTRIBUTECODE,
                       a.ATTRIBUTEVALUE,
                       a.REMARK,
                       a.TNO,
                       a.ATTACHMENTBLOB,
                       a.FILENAME,
                       a.SNO
                  from PARTYATTRIBUTEDETAIL a, PARTYATTRIBUTE b 
                  Where a.AttributeCode = b.PartyAttributeCode(+)
                  and a.Tno = :P49_TNO;
                 
                ```
            pageItemsToSubmit: P49_TNO
        }
        layout {
            sequence: 70
            parentRegion: @account-master
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
