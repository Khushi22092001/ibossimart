    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }
        serverSideCondition {
            type: never
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction check-number (
        name: check number
        execution {
            sequence: 260
        }
        when {
            event: focusout
            selectionType: items
            items: P49_OFFICEPHONENO
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                        v_item_value VARCHAR2(100); -- Change the size according to your item's data type and size
                    BEGIN
                        -- Get the value of the page item
                        SELECT :P49_OFFICEPHONENO -- Replace P1_ITEM with the actual name of your page item
                        INTO v_item_value
                        FROM DUAL;
                    
                        -- Check if the value contains any alphabet characters
                        IF REGEXP_LIKE(v_item_value, '[[:alpha:]]')  OR LENGTH(v_item_value) != 10 THEN
                            -- Raise an error
                            :P49_OFFICEPHONENO := 0;
                            --RAISE_APPLICATION_ERROR(-20000, 'The value should not contain any alphabet characters or length should be 10.');
                        END IF;
                    END;
                    
                    ```
                itemsToSubmit: P49_OFFICEPHONENO
                itemsToReturn: P49_OFFICEPHONENO
                showProcessing: true
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-execute-plsql-code-2 (
