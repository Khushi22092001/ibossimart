    dynamicAction disable-deleter-button-if-used-in-transaction (
        name: Disable Deleter Button if used in transaction
        execution {
            sequence: 300
        }
        when {
            event: ready
        }
        serverSideCondition {
            type: never
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    declare
                      tSalesOrder    number;
                      tPurchaseOrder Number;
                      tVoucher       number;
                    begin
                       select count(*) into tSalesOrder from salesorder where partycode = :P49_PARTYCODE;
                    
                       select count(*) into tPurchaseOrder from PurchaseOrder where partycode = :P49_PARTYCODE;
                    
                       select count(*) into tVoucher from VoucherDetail where accountcode = :P49_PARTYCODE;
                    
                       if nvl(tsalesorder,0) > 0 then
                            return TRUE;
                       elsif nvl(tpurchaseorder,0) > 0 then
                            return true;
                       elsif nvl(tvoucher,0) >0 then
                            return TRUE;
                       else 
                            return false;
                        end if;
                    end;
                    ```
            }
        )

    )

