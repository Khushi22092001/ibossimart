    process additional-business-address-save-interactive-grid-data (
        name: Additional Business Address - Save Interactive Grid Data
        type: executeCode
        editableRegion: @ship-to-address
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                        if :NAME is not null then
                            Insert Into CUSTOMERADDRESS (                 
                                    TNO,
                                    SNO,
                                    CUSTOMERADDRESSCODE,
                                    NAME,
                                    ADDRESS1,
                                    ADDRESS2,
                                    ADDRESS3,
                                    CITYCODE,
                                    STATECODE,
                                    PINCODE,
                                    CONTACTNO,
                                    EMAILID,
                                    ADDRESSTYPECODE,
                                    GSTINNO,
                                    PANNO
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :CUSTOMERADDRESSCODE,
                                :NAME,
                                :ADDRESS1,
                                :ADDRESS2,
                                :ADDRESS3,
                                :CITYCODE,
                                :STATECODE,
                                :PINCODE,
                                :CONTACTNO,
                                :EMAILID,
                                :ADDRESSTYPECODE,
                                :GSTINNO,
                                :PANNO
                            );
                        end if;
                
                        when 'U' then
                            update CUSTOMERADDRESS Set
                                  TNO=:TNO,
                                    SNO=:SNO,
                                    CUSTOMERADDRESSCODE=:CUSTOMERADDRESSCODE,
                                    NAME=:NAME,
                                    ADDRESS1=:ADDRESS1,
                                    ADDRESS2=:ADDRESS2,
                                    ADDRESS3=:ADDRESS3,
                                    CITYCODE=:CITYCODE,
                                    STATECODE=:STATECODE,
                                    PINCODE=:PINCODE,
                                    CONTACTNO=:CONTACTNO,
                                    EMAILID=:EMAILID,
                                    ADDRESSTYPECODE=:ADDRESSTYPECODE,
                                    GSTINNO=:GSTINNO,
                                    PANNO=:PANNO                    
                            WHERE TNO = :P49_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From CUSTOMERADDRESS
                            Where TNo = :P49_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 100
        }
        advanced {
            executionMappingIdentifier: 76783295818548619
        }
    )

    process checkcompany (
        name: CheckCompany
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare 
                    tmp number;
                begin    
                    select
                        COUNT(A.TNO)
                            into tmp
                    from PartyCompany a    
                    where a.TNo = :P49_TNO     
                        AND A.COMPANYCODE IS NOT NULL  
                    ;
                    if nvl(tmp, 0) <= 0 then
                        insert into PartyCompany(TNO,SNO,COMPANYCODE) values
                     (:P49_TNO,GLOBALTNO.Nextval,:GLOBAL_COMPANYCODE); 
                        /*raise_application_error(
                            -20000,
                            'Please enter Company'
                        );*/
                    end if;
                end;
                
                
