                       a.COMPANYCODE,
                       a.REMARK,
                       a.LOCKDATE,
                       a.TOTALVOUCHER,
                       a.CALLREPLYCODE
                  from PARTYCOMPANY a
                  Where a.TNo = :P49_TNO;
