    process getdocno (
        name: GetDocNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := 'PARTY';
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                     
                     if nvl(tmp,0) > 0 and :P49_PARTYCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P49_PARTYCODE  := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 139370314849405812
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P49_MODULEFLOW := 'YES';
                   else
                       :P49_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P71_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P49_ONTHETABLE := 'YES' ;
                   else
                       :P49_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 130
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 139371948770405812
        }
    )

