page 49 (
    name: Account Master
    alias: ACCOUNT-MASTER1
    title: Account Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region account (
        name: "Account "
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @account-master
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
                t-Form--stretchInputs
            ]
        }
    )

    region account-master (
        name: Account Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.PARTYCODE,
                       a.PARTYNAME,
                       a.PARTYTYPECODE,
                       a.PARTYGRADECODE,
                       a.PARTYSTATUS,
                       a.PARENTCODE,
                       a.OWNERNAME,
                       a.CONTACTPERSON,
                       a.DESIGNATIONCODE,
                       a.TINNO,
                       a.OFFICEADDRESS,
                       a.OFFICECITYCODE,
                       a.OFFICESTATECODE,
                       a.OFFICEPINCODE,
                       a.OFFICEPHONENO,
                       a.OFFICEFAXNO,
                       a.OFFICEEMAIL,
                       a.WORKSADDRESS,
                       a.WORKSCITYCODE,
                       a.WORKSSTATECODE,
                       a.WORKSPINCODE,
                       a.WORKSPHONENO,
                       a.WORKSFAXNO,
                       a.WORKSEMAIL,
                       a.REMARK,
                       a.PARTYSHORTNAME,
                       a.PARTYRANK,
                       a.OFFICEADDRESS1,
                       a.OFFICEADDRESS2,
                       a.OFFICEADDRESS3,
                       a.WORKSADDRESS1,
                       a.WORKSADDRESS2,
                       a.WORKSADDRESS3,
                       a.DATECREATED,
                       a.DATEMODIFY,
                       a.SCHEDULENO,
                       a.ACCOUNTTYPE,
                       a.TDSMASTERCODE,
                       a.BANKCODE,
                       a.PRINTNAME,
                       a.TRIALBALANCEPOSITION,
                       a.COSTCENTREREQUIRED,
                       a.DEPRECIATIONACCOUNTCODE,
                       a.NATUREOFACCOUNTCODE,
                       a.AGENTCOMMISIONACCOUNTCODE,
                       a.OFFICECOUNTRYCODE,
                       a.WORKSCOUNTRYCODE,
                       a.OFFICEADDRESS4,
                       a.WORKSADDRESS4,
                       a.ISCOMPANY,
                      -- a.isoem,
                       a.SCHEDULEREMARK,
                       a.OPENINGFUNCTION,
                       a.CLOSINGFUNCTION,
                       a.CLOSINGFUNCTIONLOC,
                       a.CREATOR,
                       a.PARTYREQUESTTNO,
                       a.EXCISEPARTYTYPECODE,
                       a.PARTYBANKCODE,
                       a.PARTYBANKACCOUNTNO,
                       a.RTGSCODE,
                       a.EMPLOYEECODE,
                       a.CLOSINGFUNCTIONPANDL,
                       a.BASICNATURE,
                       a.PARENTCODEOTHERWISE,
                       a.COSTSHEET,
                       a.COSTAMOUNT,
                       a.BILLEDTILLDATE,
                     --  a.WEIGHT,
                      -- a.KOT,
                      -- a.PACKINGTYPE,
                      --a.DEPOCODE,
                       a.DISTANCE,
                      -- a.LRNOAUTO,
                      -- a.INHOUSE,
                      -- a.TRANSPORTER,
                     --  a.HIRED,
                       a.CREATIONTIME,
                      -- a.OTHER,
                      -- a.SEPARATEHIREDVEHICLEFREIGHT,
                     --  a.HAMALI,
                     --  a.PLANTIME,
                      -- a.DIRECT,
                       --a.LOCALPLANTIME,
                       a.FREIGHTTYPECODE,
                     --  a.PAIDBILTYRATE,
                      -- a.CITYCODE,
                      -- a.COMPANYCODE,
                       a.BILLTOBILL,
                      -- a.DESPATCHBYMODERNTRADE,
                      -- a.OFFICEAREACODE,
                      -- a.WORKSAREACODE,
                      -- a.ISOWNTRANSPORTER,
                       a.WEEKLYOFFDAY,
                      -- a.BALANCETYPE,
                       a.CREDITDAYS,
                       --a.CAMPUSCODE,
                       --a.TRANSPORTGROUPCODE,
                       --a.DEALERTRADECODE,
                      -- a.PARTYID,
                      -- a.LATITUDE,
                      -- a.LONGITUDE,
                       a.TAXREGISTRATIONTYPECODE,
                      -- a.PICKINGMETHODCODE,
                       --a.REMAININGLIFEFORPICKING,
                      -- a.BANKNAME,
                       a.TDSPAYEECATEGORYCODE,
                       a.TDSNATURECODE,
                
                       a.TDSApplicable,
                       a.IncomeTaxReturnTillDate,
                       a.ELIGIBLEFORTDSUNDER194Q,  
                
                      -- a.MODULECODE,
                       --a.MODULETNO,
                       NVL(getdocumentstatuscode('PARTY',A.TNO),'STATUS') AS Status,
                       a.INDUSTRYTYPECODE,
                       a.TRADETYPECODE,
                       a.Assetcategorycode,
                       a.zonetype,
                       A.ISPORTALACCESS,
                       A.PORTALACCESSMOBILENO,
                       A.PORTALPASSWORD,
                       A.VENDORCODE, 
                       A.VENDORTNO
                  from PARTY a
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
                t-Form--slimPadding
            ]
        }
        advanced {
            htmlDomId: MYID
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region attachment (
        name: Attachment
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       --A.SNO,
                       --DESCRIPTION,
                       B.PARTYATTRIBUTENAME,
                       A.ATTRIBUTEVALUE,
                       A.ATTACHMENTBLOB,
                       A.FILENAME,
                       A.ATTRIBUTECODE,
                       A.moduletno,
                       A.modulesno
                  from MODULEATTACHMENT A, PARTYATTRIBUTE B
                  Where A.ATTRIBUTECODE = PARTYATTRIBUTECODE
                    AND A.moduletno = :P49_TNO;
                ```
            pageItemsToSubmit: P49_TNO
        }
        layout {
            sequence: 120
            parentRegion: @account-master
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: ATTACH
        }
        link {
            linkColumn: customTarget
            target: {
                page: 63
                items: {
                    P63_MODULESNO: #MODULESNO##SNO#
                }
                clearCache: 63
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 432260394960111120
        }

