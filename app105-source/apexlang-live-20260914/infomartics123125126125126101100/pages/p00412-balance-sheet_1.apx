    dynamicAction check-advance-amount (
        name: check advance amount
        execution {
            sequence: 440
        }
        when {
            event: focusout
            selectionType: items
            items: P412_POADVANCEAMOUNT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    
                    
                    if to_number(NVL(:P412_POADVANCEAMOUNT,0)) > to_number(NVL(:P412_PURCHASEORDERAMOUNT,0)) then
                        raise_application_error(-20000,'Advance Amount Cannot Be greater than PO Amount');
                    end if;
                    ```
                itemsToSubmit: [
                    P412_POADVANCEAMOUNT
                    P412_PURCHASEORDERAMOUNT
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action check-detail (
            name: check detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    checkdetail(getmodulecodeforpageno(:APP_PAGE_ID),:P412_TNO);
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    /*delete from BalanceSheetRevised a
                        where not exists (
                            select 1 from PURCHASEORDER  aa  
                            where aa.tno = a.tno
                        );
                    
                    delete from PURCHASEORDERDETAILFOOTER a
                        where not exists (
                            select 1 from PURCHASEORDER  aa  
                            where aa.tno = a.tno
                        ); 
                    delete from PURCHASEORDERTAC a
                        where not exists (
                            select 1 from PURCHASEORDER  aa  
                            where aa.tno = a.tno
                        ); 
                     */
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P412_CALLEDFROMPAGE').getValue();
                    var y = apex.item('P412_CALLEDFROMTNO').getValue();
                    
                    //var url = "f?p=#APP_ID#:80:#SESSION#::NO:RP,80:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#:P#2002#_TNO:#P2002_TNO#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    
                    url = url.replace("#P2002_TNO#", y);
                    //window.alert(x);
                    //window.alert(y);
                    //window.alert(url);
                    
                    
                    //call
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-record-from-detail-table (
        name: delete unsaved record from detail table
        execution {
            sequence: 400
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from PURCHASEORDERDETAILFOOTER a
                        where not exists (
                            select 1 from PURCHASEORDER  aa  
                            where aa.tno = a.tno
                        ); 
                    
                     delete from PURCHASEORDERDETAIL a
                        where not exists (
                            select 1 from PURCHASEORDER  aa  
                            where aa.tno = a.tno
                        ); 
                    delete from PURCHASEORDERTAC a
                        where not exists (
                            select 1 from PURCHASEORDER  aa  
                            where aa.tno = a.tno
                        ); 
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P412_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 70
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from loadingadvice aa where aa.purchaseordertno = :P412_TNO;
            }
        )

        action native-disable-4 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 80
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from paymentadvice aa where aa.moduletno = :P412_TNO;
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                       and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

    )

