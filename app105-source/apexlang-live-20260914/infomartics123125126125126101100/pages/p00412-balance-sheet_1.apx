    region assets (
        name: ASSETS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT C001 AS ACCOUNTNAMEDISPLAY,
                       C002 AS PARTYCODE,
                       C003 AS PARENTCODE,
                       C005 AS SCHEDULENO,
                       N003 AS AMOUNT1,
                       N004 AS AMOUNT2,
                       N005 AS POSITION
                FROM apex_collectionS
                WHERE collection_name = 'BALANCESHEET'
                  AND N001 = :P412_TNO
                  and C004 = 'ASSETS'
                ORDER BY N005
                ;
                
                ```
            pageItemsToSubmit: [
                P412_ASATDATE
                P412_LOCATIONCODE
            ]
        }
        layout {
            sequence: 40
            parentRegion: @new
            slot: regionBody
        }
