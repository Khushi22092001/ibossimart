    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P412_TNO is null then
                    :P412_TNO := GlobalTNo.nextval;
                    :P412_FORMSTATUS := 'NEWRECORD';
                
                  
                else
                    :P412_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P412_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P412_TNO), 'Status');
                ```
        }
        execution {
            sequence: 80
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 75276383260029717
        }
    )

    process intialize-ma-acceptance (
        name: intialize ma_acceptance
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  TMP NUMBER;
                BEGIN
                SELECT COUNT(*) into tmp FROM ma_acceptance A WHERE A.TNO = :p412_tno;
                if nvl(tmp,0) > 0 then
                        select 
                        TNO                 ,
                        MODULECODE,
                        MODULETNO,
                        MODULESNO,
                        ACCEPTANCE,
                        ACCEPTANCEDATE,
                        PERSONACCOUNTABLE,
                        DELIVERYDATE,
                        DESIGNATION,
                        MOBILENO,
                        EXPIRYTIME
                        into 
                        :P412_TNO_1,
                        :P412_MODULECODE,
                        :P412_MODULETNO,
                        :P412_MODULESNO,
                        :P412_ACCEPTANCE,
                        :P412_ACCEPTANCEDATE,
                        :P412_PERSONACCOUNTABLE,
                        :P412_DELIVERYDATE_1,
                        :P412_DESIGNATION,
                        :P412_MOBILENO,
                        :P412_EXPIRYTIME
                        from ma_acceptance
                        WHERE MODULETNO = :P412_TNO
                        ;
                
                    END IF;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 75275909490029717
        }
        serverSideCondition {
            type: never
        }
    )

    process prepare-url (
        name: PREPARE_URL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                   result varchar2(2000);
                begin
                   result:=apex_util.prepare_url(apex_application.g_x01);
                   apex_json.open_object;
                   apex_json.write('success', true);
                   apex_json.write('url', result);
                   apex_json.close_object;
                exception
                 when others then
                   apex_json.open_object;
                   apex_json.write('success', false);
                   apex_json.write('message', sqlerrm);
                   apex_json.close_object;
                end;
                ```
        }
        execution {
            sequence: 70
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 75276734689029717
        }
    )

