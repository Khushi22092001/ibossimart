page 507 (
    name: Purchase Detail (with Filter)
    alias: PURCHASE-DETAIL-WITH-FILTER
    title: Purchase Detail (with Filter)
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region filter (
        name: Filter
        type: facetedSearch
        source {
            filteredRegion: @sample
        }
        layout {
            sequence: 30
            slot: rightColumn
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--showIcon
                t-Region--accent9
                t-Region--hiddenOverflow
            ]
            icon: fa-filter
        }
        advanced {
            regionDisplaySelector: true
        }
        settings {
            compactNosThreshold: 10000
            showCurrentFacets: true
            showTotalRowCount: true
            totalRowCountLabel: Record:
            displayChartForTopNValues: 10
        }

        facet P507_AMOUNT (
            type: range
            label {
                label: Amount
            }
            settings {
                selectMultiple: true
                manualEntry: true
            }
            lov {
                type: staticValues
                staticValues: STATIC2:<100 K;|100000,100 K - 500 K;100000|500000,500 K - 1 M;50000|1000000,1 M - 5 M;1000000|5000000,>5 M;5000000|
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 100
            }
            actionsMenu {
                filter: false
                chart: false
            }
            advanced {
                collapsible: true
                initiallyCollapsed: true
            }
            source {
                databaseColumn: AMOUNT
                dataType: number
            }
            security {
                encryptSessionState: false
            }
        )

        facet P507_CUSTOMER (
            type: checkboxGroup
            label {
                label: Customer
            }
            lov {
                type: sharedComponent
                lov: @party-list-2
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 5
            }
            actionsMenu {
                filter: false
            }
            advanced {
                collapsible: true
                initiallyCollapsed: true
            }
            source {
                databaseColumn: PARTYCODE
            }
            security {
                encryptSessionState: false
            }
        )

        facet P507_ITEM (
            type: checkboxGroup
            label {
                label: Item
            }
            lov {
                type: sharedComponent
                lov: @item-list-2
            }
            layout {
                sequence: 60
            }
            listEntries {
                maxDisplayedEntries: 5
            }
            actionsMenu {
                filter: false
            }
            advanced {
                collapsible: true
                initiallyCollapsed: true
            }
            source {
                databaseColumn: ITEMCODE
            }
            security {
                encryptSessionState: false
            }
        )

        facet P507_MONTH (
            type: checkboxGroup
            label {
                label: Month
            }
            lov {
                type: sharedComponent
                lov: @month-2
            }
            layout {
                sequence: 40
            }
            listEntries {
                computeCounts: false
                maxDisplayedEntries: 5
            }
            actionsMenu {
                filter: false
            }
            advanced {
                collapsible: true
                initiallyCollapsed: true
            }
            source {
                databaseColumn: YYYYMM
            }
            security {
                encryptSessionState: false
            }
        )

        facet P507_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: YYYYMM,YYYY,ITEMCODE,PARTYCODE,ITEMNAME,PARTYNAME,MONYYYY,AMOUNT
            }
            security {
                encryptSessionState: false
            }
        )

        facet P507_YEAR (
            type: checkboxGroup
            label {
                label: Year
            }
            lov {
                type: sharedComponent
                lov: @year-2
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 5
            }
            actionsMenu {
                filter: false
            }
            advanced {
                collapsible: true
                initiallyCollapsed: true
            }
            source {
                databaseColumn: YYYY
            }
            security {
                encryptSessionState: false
            }
        )

    )

    region sample (
        name: Sample
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      a.PBPassDate,
                      to_Char(a.PBPassDate,'YYYYMM') as YYYYMM,
                      to_Char(a.PBPassDate,'YYYY') as YYYY,
                      a.PartyCode,
                      p.PartyName,
                      a.ItemCode,
                      e.ItemName,
                      e.MeasuringUnitCode1,
                      sum(a.Quantity1) PQTY,
                      sum(a.Quantity2) SQTY,
                      sum(a.TotalAmount) Amount
                From  BI_PRevenue a, Party p, Item e, FinancialYear fy
                Where a.PartyCode = p.PartyCode
                  and a.ItemCode = e.ItemCode
                  and a.FinancialYearCode = fy.FinancialYearCode
                  and a.PBPassDate between fy.FinancialYearBegin and  :P507_DATE
                Group by a.PBPassDate,
                      to_Char(a.PBPassDate,'YYYYMM'),
                      to_Char(a.PBPassDate,'YYYY'),
                      a.PartyCode,
                      p.PartyName,
                      a.ItemCode,
                      e.ItemName,
                      e.MeasuringUnitCode1
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--noBorders
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        performance {
            lazyLoading: true
        }
        download {
            csvExportEnabled: true
        }

        column AMOUNT (
            reportColumnQueryId: 11
            derivedColumn: N
            heading {
                heading: Amount
                alignment: center
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column ITEMCODE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Item Code
                alignment: center
            }
            layout {
                sequence: 70
            }
        )

        column ITEMNAME (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Item Name
                alignment: center
            }
            layout {
                sequence: 80
            }
        )

        column MEASURINGUNITCODE1 (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: UOM
                alignment: center
            }
            layout {
                sequence: 90
            }
        )

        column PARTYCODE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Party Code
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

        column PARTYNAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Party Name
                alignment: center
            }
            layout {
                sequence: 60
            }
        )

        column PBPASSDATE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Date
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column PQTY (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: P Qty
                alignment: center
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column SQTY (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: S Qty
                alignment: center
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            advanced {
                computeSum: true
            }
        )

        column YYYY (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 30
            }
        )

        column YYYYMM (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 20
            }
        )

    )

    pageItem P507_DATE (
        type: hidden
        layout {
            sequence: 10
            region: @sample
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction hide-menu (
        name: Hide Menu
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
                    //$("#t_Body_nav").hide();
                    //$(this).treeView("collapse", n$)
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

