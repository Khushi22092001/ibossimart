    region stock-revaluation (
        name: Stock Revaluation
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.Tno,            
                a.StockRevaluationDate,         
                a.StockRevaluationNo,
                getdocumentstatusCode(getmodulecodeforpageno(:APP_PAGE_ID),a.tno) as Satatus,
                a.Remark                           
                From StockRevaluation a 
                where getLocationPrivilege(a.LocationCode, getmodulecodeforpageno(:APP_PAGE_ID),a.companycode,user)='YES'
                and getDocTypePrivilege(a.DocTypeCode, getmodulecodeforpageno(:APP_PAGE_ID),a.companycode,user)='YES'
                Order by a.StockRevaluationDate Desc, a.StockRevaluationNo Desc 
                ```
        }
