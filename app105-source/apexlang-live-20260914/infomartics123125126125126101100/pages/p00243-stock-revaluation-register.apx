    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @pdf
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    /*javascript:window.open('http://117.217.121.130:9502/analytics/saw.dll?bipublisherEntry&Action=open&itemType=.xdo&bipPath=/PBS/REPORTS/Stock Transfer Register.xdo&nQUser=consumer&nQPassword=Info123$&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1","_paramsP_COMPANY":"&P243_COMPANY.","_paramsP_LOCATION":"&P243_LOCATION.","_paramsP_STNO":"&P243_STNO.","_paramsP_FROMDATE":"&P243_FROMDATE.","_paramsP_TODATE":"&P154_TODATE.","_paramsP_ITEM":"&P243_ITEM.","_paramsP_SPECIFICATION":"&P243_SPECIFICATION."}');
                    */
                    generatePDF();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction hide-nav (
