page 293 (
    name: Fixed Asset Register
    alias: FIXED-ASSET-REGISTER
    title: Fixed Asset Register
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region fixed-asset-register (
        name: Fixed Asset Register
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--accent4
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region fixed-asset-register-2 (
        name: Fixed Asset Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.TNo,
                 row_number() over(order by a.Tno) SerialNo,
                f.CompanyName,
                d.LocationName,
                e.DocTypeName,
                c.PartyName as AccountName,
                a.AssetNo,
                a.AssetDate,
                g.VoucherNo,
                g.VoucherDate,
                h.ItemName,
                i.ItemSpecificationName,
                b.AssetCode,
                b.AssetValue,
                b.DepreciatedAmount
                from Asset a, AssetCodeDetail b, Party c, Location d, DocType e, Company f, Voucher g, Item h, ItemSpecification i
                where a.tno = b.tno 
                and a.AccountCode = c.PartyCode
                and a.LocationCode = d.LocationCode
                and a.DocTypeCode = e.DocTypeCode
                and a.CompanyCode = f.CompanyCode
                and a.TNO = g.ModuleTNo(+)
                and a.ItemCode = h.ItemCode
                and a.ItemSpecificationCode = i.ItemSpecificationCode
                and a.AssetDate Between :P293_FROMDATE and :P293_TODATE
                and ( :P293_COMPANY IS NULL OR INSTR(':'||:P293_COMPANY||':',':'||a.CompanyCode||':') > 0 ) 
                
                ```
            pageItemsToSubmit: [
                P293_COMPANY
                P293_FROMDATE
                P293_TODATE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 57232081072742351
        }

        column ACCOUNTNAME (
            type: plainText
            heading {
                heading: Account Name
                alignment: center
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                htmlExpression: <div style="display:block; width:180px">#ACCOUNTNAME#</div>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column ASSETCODE (
