            	  '"_paramsP_PARTY":"' +$('#P410_PARTY').val() + '",' + 
            	  '"_paramsP_ITEM":"' +$('#P410_ITEM').val() + '",' + 
                  '"_paramsP_INDENT":"' +$('#P410_INDENT').val() + '",' + 	
            	  '"_paramsP_INSPECTIONSTATUS":"' +$('#P410_INSPECTIONSTATUS').val() + '",' +
                  '"_paramsGLOBAL_COMPANYCODE":"' +global_companycode;
                 
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            
            
            
