    region pr-to-db (
        name: PR to DB
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct 
                       row_number() over(order by a.IndentDate) SerialNo,
                       a.IndentDate,
                       a.IndentNo,
                       dp.DepartmentName,
                       GetItemName(e.ParentCode) || ' ~ ' || e.ParentCode As MaterialGroup,
                       e.itemCode,
                       e.ItemName || ' ~ ' || ee.ItemSpecificationName As MaterialDetail,
                       e.MeasuringUnitCode1,
                       b.Quantity1 As IndentQty1,
                       b.Quantity2 As IndentQty2,
                       po.PurchaseOrderDate,
                       po.PurchaseOrderNo,
                       po.PartyName,
                       po.Quantity1 As POQty1,
                       g.RefDocDate As InvoiceDate,
                       g.RefDocNo As InvoiceNo,
                       g.chalanquantity1 As InvoiceQty,
                       g.GRNDate,
                       g.GRNNo,
                       g.receivedquantity1 As GRNQty1,
                       i.InspectionDate,
                       i.InspectionNo,
                       i.inspectedquantity1,
                       i.acceptedquantity1,
                       i.rejectedquantity1,
                       pb.PurchaseBillNo,
                       pb.PurchaseBillDate,
                       pbp.PBpassNo,
                       pbp.PBpassDate,
                       pbp.Quantity1 As PBPassQty1,
                       la.loadingadviceDate,
                       la.loadingadviceNo,
                       la.transporter,
                       la.VEHICLENO,
                       la.quantity1 As LoadingQty1,
                       la.quantity1 As LoadingQty2,
                       db.DebitNoteNo,
                       db.DebitNoteDate,
                       db.quantity1,
                       db.TotalAmount,
                       db.reasonforissuingnoteName,
                       db.Remark,
                       --------13-03-2025-----------
                        eq.EnquiryNo,
                       eq.EnquiryDate,
                       eqd.Quantity1 EnqQty,
                       epd.Party ENqParty,
                       qt.QuotationNo,
                       qt.QuotationDate,
                       GetPartyName(qt.PartyCode) QTParty,
                       qtd.Quantity1 QuotQty
                       ----
                  From Indent a,
                       IndentDetail b,
                       Location l,
                      -- Project p,
                       Department dp,
                       Item e,
                       ItemSpecification ee,
                       (Select p.TNo,
                               p.PurchaseOrderNo,
                               p.PurchaseOrderDate,
                               pp.PartyCode,
                               pp.PartyName,
                               pd.ItemCode,
                               pd.ItemSpecificationCode,
                               pd.Quantity1,
                               pd.IndentTNo
                          From PurchaseOrder p, PurchaseOrderDetailIndent pd, Party pp
                         Where p.TNo = pd.TNo
                           And p.PartyCode = pp.PartyCode) po,
                       (Select g.TNo,
                               g.GRNDate,
                               g.GRNNo,
                               g.RefDocNo,
                               g.RefDocDate,
                               gg.chalanquantity1,
                               gg.receivedquantity1,
                               gg.ItemCode,
                               gg.ItemSpecificationCode,
                               gg.PurchaseOrderTNo,
                               gg.sno,
                               g.LOADINGADVICETNO
                          From GRN g, GRNDetail gg
                         Where g.TNo = gg.TNo
                           And getnaturedoctypecode('GRN', G.DOCTYPECODE) = 'PURCHASE') g,
                           (Select g.TNo,
                               g.loadingadvicedate,
                               g.loadingadviceno,
                               g.Purchaseordertno,
                               getpartyname(g.ISSUEDTOPARTYCODE) as transporter,
                               g.VEHICLENO,
                               gg.quantity1,
                               gg.ItemCode,
                               gg.ItemSpecificationCode
                          From loadingadvice g, loadingadvicedetail gg
                         Where g.TNo = gg.TNo
                           And G.DOCTYPECODE = 'PURCHASE') la,
                       (Select i.TNo,
                               i.InspectionNo,
                               i.InspectionDate,
                               ii.GRNTNo,
                               ii.ItemCode,
                               ii.ItemSpecificationCode,
                               ii.inspectedquantity1,
                               ii.acceptedquantity1,
                               ii.RejectedQuantity1
                          From Inspection i, InspectionDetail ii
                         Where i.TNo = ii.TNo) i,
                       (Select pb.TNo,
                               pb.purchaseBillNo,
                               pb.PurchaseBillDate,
                               pbd.quantity1,
                               pbd.PurchaseOrderTNo,
                               pbd.itemCode,
                               pbd.itemSpecificationCode,
                               PBG.GRNTNO,
                               PBG.GRNSNO
                          From PurchaseBill          pb,
                               PurchaseBillDetail    pbd,
                               PURCHASEBILLGRNDETAIL PBG
                         Where pb.Tno = pbd.Tno
                           And PB.TNO = PBG.TNO
                           And pbd.sno = pbg.sno) pb,
                       (Select aa.TNo,
                               aa.PurchaseBillTno,
                               aa.PBPassNo,
                               aa.PBPassDate,
                               bb.PurchaseOrderTNo,
                               bb.ItemCode,
                               bb.ItemSpecificationCode,
                               bb.Quantity1
                          From PBPass aa, PBPassDetail bb
                         Where aa.Tno = bb.TNo) pbp,
                       (Select d.TNo,
                               d.DebitNoteNo,
                               d.DebitNoteDate,
                               d.referencemoduletno,
                               dd.ItemCode,
                               dd.itemSpecificationCode,
                               dd.Quantity1,
                               dd.TotalAmount,
                               r.reasonforissuingnoteName,
                               d.Remark
                          From DebitNote d, DebitNoteDetail dd, reasonforissuingnote r
                         Where d.TNo = dd.TNo
                           And d.ReferenceModuleCode = 'PBPASS'
                           And d.reasonforissuingnotecode = r.reasonforissuingnotecode(+)) db,
                           -----------add 13-03-2025---------
                            EnquiryIndentDetail eqi,
                           Enquiry eq,
                           EnquiryItemDetail eqd,
                           (Select BB.TNO,
                                   Max(GetPartyName(BB.PartyCode)) Party
                            From   EnquiryPartyDetail bb
                            Group By bb.TNo
                           ) epd,
                           Quotation qt,
                           QuotationDetail qtd
                           ----------------------------
                 Where a.TNo = b.TNo
                   And a.LocationCode = l.LocationCode(+)
                   And a.DepartmentCode = dp.DepartmentCode(+)
                 --  And a.projecttno = p.tno(+)
                   And b.ItemCode = e.itemCode(+)
                   And b.ItemSpecificationcode = ee.ItemSpecificationCode(+)
                   And b.TNo = po.IndentTno(+)
                   And b.ItemCode = po.itemCode(+)
                   And b.ItemSpecificationcode = po.ItemSpecificationCode(+)
                   And po.TNo = g.PurchaseOrderTNo(+)
                   And po.ItemCode = g.itemCode(+)
                   And po.ItemSpecificationcode = g.ItemSpecificationCode(+)
                    And po.TNo = la.PurchaseOrderTNo(+)
                   And po.ItemCode = la.itemCode(+)
                   And po.ItemSpecificationcode = la.ItemSpecificationCode(+)
                  -- and g.LOADINGADVICETNO = la.tno(+)
                   And g.TNo = i.GRNTNo(+)
                   And g.ItemCode = i.itemCode(+)
                   And g.ItemSpecificationcode = i.ItemSpecificationCode(+)
                   And G.TNO = PB.GRNTNO(+)
                   And G.SNO = PB.GRNSNO(+)
                   And po.TNo = pb.PurchaseOrderTno(+)
                   And po.ItemCode = pb.itemCode(+)
                   And po.ItemSpecificationcode = pb.ItemSpecificationCode(+)
                   And pb.TNo = pbp.PurchaseBillTNo(+)
                   And pb.ItemCode = pbp.itemCode(+)
                   And pb.ItemSpecificationcode = pbp.ItemSpecificationCode(+)
                   And pbp.TNo = db.ReferenceModuleTNo(+)
                   And pbp.ItemCode = db.itemCode(+)
                   And pbp.ItemSpecificationCode = db.ItemSpecificationCode(+)
                   --------------13-03-2025-------------
                   And a.TNo = eqi.IndentTNo(+)
                   And eqi.TNo = eq.TNo(+)
                   And eq.TNo = eqd.TNo(+)
                   And b.ItemCode = eqd.ItemCode(+)
                   And b.ItemSpecificationCode = eqd.ItemSpecificationCode(+)
                   And eqd.TNo = epd.TNo(+)
                   And eq.TNo = qt.EnquiryTNo(+)
                   And qt.TNo = qtd.TNo(+)
                   And b.ItemCode = qtd.ItemCode(+)
                   And b.ItemSpecificationCode = qtd.ItemSpecificationCode(+)
                   ------------------------------------
                   and a.IndentDate between :P410_FROMDATE and :P410_TODATE
                   and ( :P410_INDENT IS NULL OR instr(':'||:P410_INDENT||':',':'||a.TNO||':') > 0 )
                   and ( :P410_COMPANY IS NULL OR instr(':'||:P410_COMPANY||':',':'||a.CompanyCode||':') > 0 )
                      and ( :P410_LOCATION IS NULL OR instr(':'||:P410_LOCATION||':',':'||a.LocationCode||':') > 0 )
                  --and instr(':'||:P410_LOCATION||':',':'||a.LocationCode||':') > 0
                  and ( :P410_ITEM IS NULL OR instr(':'||:P410_ITEM||':',':'||e.ItemCode||':') > 0 )
                  and ( :P410_ITEMSPECIFICATION IS NULL OR instr(':'||:P410_ITEMSPECIFICATION||':',':'||ee.ItemSpecificationCode||':') > 0 )
                  and ( :P410_PARTY IS NULL OR instr(':'||:P410_PARTY||':',':'||po.PartyCode||':') > 0 )
                  and ( :P410_DEPARTMENT IS NULL OR instr(':'||:P410_DEPARTMENT||':',':'||a.DepartmentCode||':') > 0 )
                  and ( :P410_GROUP IS NULL OR instr(':'||:P410_GROUP||':',':'||e.ParentCode||':') > 0 )
                   /*and ( :P410_GROUP IS NULL
                      or
                      exists (select 1 from (Select ITEMCODE,
                               parentcode,
                               RPAD('.', (Level - 1) * 2, '.') || itemcode As tree,
                               Level,
                               CONNECT_BY_ROOT itemcode As root_id,
                               '-' || LTRIM(SYS_CONNECT_BY_PATH(itemcode, '-'), '-') || '-' As path,
                               CONNECT_BY_ISLEAF As leaf
                          From item a
                         Start With parentcode in ( select itemcode from item xx where
                                                    instr(':'||:P410_GROUP||':',':'||xx.ItemCode||':') > 0)
                                                    
                        Connect By parentcode = Prior itemcode
                         Order Siblings By itemcode) x where x.itemcode = e.itemcode
                        )
                  ) */
                  
                Order By 1,2,3,4
                ```
        }
