    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
                
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P410_BIREPORTURL').val()
              var reportName = 'IRONMART/REPORT/PRToDB1.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P410_FROMDATE').val());
              var toDate = new Date($('#P410_TODATE').val());
              var companycode ;
             
              if($('#P410_COMPANY').val() ==="" || $('#P410_COMPANY').val() ===null)
              {
                 companycode='&GLOBAL_COMPANYCODE.';
              } else{
                  companycode = $('#P410_COMPANY').val();
              }  
            
                 var reportParams = 
                   '&P_COMPANY='+ companycode +  
                   '&P_LOCATION=' + $('#P410_LOCATION').val() + 
                   '&P_FROMDATE=' +$('#P410_FROMDATE').val() + 
                   '&P_TODATE=' +$('#P410_TODATE').val() + 
                   '&P_DEPARTMENT=' +$('#P410_DEPARTMENT').val() +
                   '&P_GROUP=' +$('#P410_GROUP').val() +
                   '&P_PARTY=' +$('#P410_PARTY').val() +
                   '&P_ITEM=' +$('#P410_ITEM').val() +
                   '&P_INDENT=' +$('#P410_INDENT').val() +
                   '&P_ITEMSPECIFICATION=' +$('#P410_ITEMSPECIFICATION').val() +
                   '&GLOBAL_COMPANYCODE=' +'&GLOBAL_COMPANYCODE.';
                
                     var reportURL = bireporturl+ reportName +
                           '?id='+ username +
                           '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
               window.open(reportURL, '_blank');
             
            }
            
            
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P410_BIREPORTURL').val()
              var reportName =  'PRToDB1.xdo';
              var outputFormat = 'pdf';
            var companycode ,global_companycode;
              var arraCom = [];
              try
              {
              arraCom = $('#P410_COMPANY').val().split(":");
              }catch(ex){
            
              }
             
              if($('#P410_COMPANY').val() ==="" || $('#P410_COMPANY').val() ===null)
              {
                 companycode='&GLOBAL_COMPANYCODE.';
                 global_companycode='&GLOBAL_COMPANYCODE.';
              } else if(arraCom.length>1)
              {
                  companycode = $('#P410_COMPANY').val(); 
                  global_companycode='&GLOBAL_COMPANYCODE.';
                  
              }
              else{
                  companycode = $('#P410_COMPANY').val();
                   global_companycode= $('#P410_COMPANY').val();
              }  
            
            
            //   var reportParams = 
            //     '"_paramsP_TNO":"' + $('#P410_TNO').val() 
            //       ;
            
            var reportParams = 
                  '"_paramsP_COMPANY":"'+ companycode + '",' + 
            	  '"_paramsP_LOCATION":"' + $('#P410_LOCATION').val() + '",' +
                  '"_paramsP_FROMDATE":"' +$('#P410_FROMDATE').val() + '",' + 
                  '"_paramsP_TODATE":"' +$('#P410_TODATE').val() + '",' + 
            	  '"_paramsP_DEPARTMENT":"' + $('#P410_DEPARTMENT').val() + '",' +
