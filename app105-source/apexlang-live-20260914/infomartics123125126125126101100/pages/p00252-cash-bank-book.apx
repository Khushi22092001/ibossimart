    region cash-bank-book (
        name: Cash Bank Book
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.TNO,
                       A.COMPANYCODE,
                       A.FINANCIALYEARCODE,
                       A.LOCATIONCODE,
                       A.DOCTYPECODE,
                       A.RTGSLETTERNO,
                       A.RTGSLETTERDATE,
                       A.ACCOUNTCODE,
                       A.CHEQUENO,
                       A.REMARK,
                       A.CREATOR,
                       A.CREATIONTIME,
                       A.MONEYTRANSFERMODECODE,
                	   NVL(getdocumentstatuscode(getmodulecodeforpageno(:APP_PAGE_ID),TNO),'STATUS') AS STATUS
                  From RTGSLETTER A
                
                ```
            pageItemsToSubmit: P252_TNO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

