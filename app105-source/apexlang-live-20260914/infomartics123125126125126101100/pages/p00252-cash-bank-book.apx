    region detail (
        name: DETAIL
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select A.PARTYTYPECODE,
                       A.PARTYCODE,
                       A.PARTYNAME,
                       getaccountopening(A.PARTYCODE, TO_DATE(:P252_ASONDATE,'DD-MM-YYYY') + 1, :P252_LOCATIONCODE, :Global_CompanyCode) As Closing,
                       :GLOBAL_FINANCIALYEARBEGIN as fromdate,
                       LAST_DAY(:P252_ASONDATE) as todate,
                       Case
                         When getaccountopening(A.PARTYCODE, TO_DATE(:P252_ASONDATE,'DD-MM-YYYY') + 1, :P252_LOCATIONCODE, :Global_CompanyCode) < 0 Then
                          'Dr'
                         Else
                          'Cr'
                       End DRCR
                  From party a
                 Where a.partytypecode In ('BANK', 'CASH')
                ```
            pageItemsToSubmit: [
                P252_TNO
                P252_LOCATIONCODE
                P252_ASONDATE
                P252_FROMDATE
                P252_TODATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: DETAIL
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
