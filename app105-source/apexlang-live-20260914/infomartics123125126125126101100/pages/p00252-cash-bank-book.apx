            initJavaScriptFunction:
                ```javascript-browser
                function( options ){ 
                        
                    // Setup a callback function which gets called when data is retrieved, it allows to manipulate the series 
                    options.dataFilter = function( data ) { 
                            data.series[ 0 ].items[0].color = "red"; 
                            data.series[ 0 ].items[1].color = "green"; 
                            data.series[ 0 ].items[2].color = "magenta"; 
                            data.series[ 0 ].items[3].color = "yellow"; 
                            data.series[ 0 ].items[4].color = "blue"; 
                            data.series[ 0 ].items[5].color = "orange"; 
                            data.series[ 0 ].items[6].color = "gray"; 
                            data.series[ 0 ].items[7].color = "brown"; 
                            data.series[ 0 ].items[8].color = "cyan"; 
                            data.series[ 0 ].items[9].color = "indigo"; 
                            data.series[ 0 ].items[10].color = "violet"; 
                             data.series[ 0 ].items[11].color = "olive"; 
                
                
                        return data; 
                    };
                        
                    // Set chart initialization options 
                    return options; 
                }
                
                ```
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select A.FROMDATE,
                           A.TODATE,
                           C.PARTYNAME,
                          TO_CHAR(A.FROMDATE, 'Month') Label,
                           getaccountopening(C.PARTYCODE, A.TODATE + 1, :P252_LOCATIONCODE, :GLOBAL_COMPANYCODE) As Closing
                      From periodlist a, financialyear b, PARTY C
                     Where a.fromdate Between b.financialyearbegin And b.financialyearend
                       And Trunc(Sysdate) Between b.financialyearbegin And b.financialyearend
                       And a.periodtype = 'MONTH'
                       And C.PARTYTYPECODE In ('BANK', 'CASH')
                       And a.todate <= last_day('24-jun-2024')
                       and C.PARTYCODE = :P252_PARTYCODE
                    union all
                    Select A.FROMDATE,
                           A.TODATE,
                           C.PARTYNAME,
                          TO_CHAR(A.FROMDATE, 'Month') Label,
                           0 As Closing
                      From periodlist a, financialyear b, PARTY C
                     Where a.fromdate Between b.financialyearbegin And b.financialyearend
                       And Trunc(Sysdate) Between b.financialyearbegin And b.financialyearend
                       And a.periodtype = 'MONTH'
                       And C.PARTYTYPECODE In ('BANK', 'CASH')
                       And a.fromdate > last_day('24-jun-2024')
                       and C.PARTYCODE = :P252_PARTYCODE
                    ORDER BY 1
                    
                    ```
                pageItemsToSubmit: [
                    P252_LOCATIONCODE
                    P252_PARTYCODE
                    P252_ASONDATE
                ]
            }
            columnMapping {
                label: LABEL
                value: CLOSING
                legendTooltip: LABEL
            }
        )

