    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P252_Tno is null then
                        Select GlobalTno.NextVal into :P252_Tno From Dual;
                     end if;
                    ----
                    if :P252_RTGSLETTERNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P252_LocationCode,
                					:P252_DocTypeCode,
                					NULL,
                					TO_DATE(:P252_RTGSLETTERDATE, 'DD-MM-RRRR')
                				);
                        :P252_RTGSLETTERNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P252_LocationCode,
                                    :P252_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P252_RTGSLETTERDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 78791689037381065
        }
    )

