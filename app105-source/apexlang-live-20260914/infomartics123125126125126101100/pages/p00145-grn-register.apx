        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: GRN Report
        }

        savedReport 42873 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACCEPTEDWEIGHT (
                sequence: 32
            )

            displayColumn AMOUNT (
                sequence: 28
            )

            displayColumn CHALANQUANTITY1 (
                sequence: 23
            )

            displayColumn CHALANQUANTITY2 (
                sequence: 34
            )

            displayColumn CREATIONTIME (
                sequence: 39
            )

            displayColumn CREATOR (
                sequence: 38
            )

            displayColumn DESCRIPTION (
                sequence: 21
            )

            displayColumn DIFFERENCE (
                sequence: 25
            )

            displayColumn DIFFERENCE2 (
                sequence: 36
            )

            displayColumn DOCSTATUS (
                sequence: 1
            )

            displayColumn DOCTYPENAME (
                sequence: 4
            )

            displayColumn FREIGHTAMOUNT (
                sequence: 29
            )

            displayColumn FREIGHTTYPENAME (
                sequence: 15
            )

            displayColumn GRNDATE (
                sequence: 6
            )

            displayColumn GRNNO (
                sequence: 7
            )

            displayColumn ITEMCODE (
                sequence: 19
            )

            displayColumn LOADINGADVICENO (
                sequence: 9
            )

            displayColumn LOCATIONNAME (
                sequence: 3
            )

            displayColumn LRDATE (
                sequence: 18
            )

            displayColumn LRNO (
                sequence: 17
            )

            displayColumn MATERIAL (
                sequence: 20
            )

            displayColumn MATERIALINNO (
                sequence: 8
            )

            displayColumn NETWEIGHT (
                sequence: 31
            )

            displayColumn PACCEPTEDQTY (
                sequence: 37
            )

            displayColumn PARTYINVOICEDATE (
                sequence: 14
            )

            displayColumn PARTYINVOICENO (
                sequence: 13
            )

            displayColumn PARTYNAME (
                sequence: 5
            )

            displayColumn PRINT (
                sequence: 2
            )

            displayColumn RATE (
                sequence: 27
            )

            displayColumn RECEIVEDQUANTITY1 (
                sequence: 24
            )

            displayColumn RECEIVEDQUANTITY2 (
                sequence: 35
            )

            displayColumn REFERENCE (
                sequence: 10
            )

            displayColumn REFERENCEDATE (
                sequence: 12
            )

            displayColumn REFERENCENO (
                sequence: 11
            )

            displayColumn SHORTAGEEXCESS (
                sequence: 26
            )

            displayColumn UOM (
                sequence: 22
            )

            displayColumn UOM2 (
                sequence: 33
            )

            displayColumn VEHICLENO (
                sequence: 16
            )

            displayColumn WARRANTYUPTO (
                sequence: 30
            )

            sort (
                column: GRNDATE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: DEPARTMENT
                sort {
                    sequence: 2
                }
            )

            sort (
                column: DOCTYPENAME
                sort {
                    sequence: 3
                }
            )

            sort (
                column: PARTYNAME
                sort {
                    sequence: 4
                }
            )

            aggregate (
                column: RECEIVEDQUANTITY1
            )

            aggregate (
                column: DIFFERENCE
            )

            aggregate (
                column: CHALANQUANTITY1
            )

            aggregate (
                column: AMOUNT
            )

            aggregate (
                column: NETWEIGHT
            )

            aggregate (
                column: ACCEPTEDWEIGHT
            )

            aggregate (
                column: CHALANQUANTITY2
            )

            aggregate (
                column: RECEIVEDQUANTITY2
            )

            aggregate (
                column: DIFFERENCE2
            )

            aggregate (
                column: PACCEPTEDQTY
            )

            highlight ir-condition (
                name: Green
                condition {
                    column: SHORTAGEEXCESS
                    value: Equal
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #47FF53
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-2 (
                name: Yellow
                condition {
                    column: SHORTAGEEXCESS
                    value: Excess
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FFFF00
                }
                execution {
                    sequence: 10
                }
            )

            highlight ir-condition-3 (
                name: Red
                condition {
                    column: SHORTAGEEXCESS
                    value: Shortage
                }
                highlight {
                    type: cell
                }
                colors {
                    background: #FF0000
                    text: #FFFFFF
                }
                execution {
                    sequence: 10
                }
            )

        )

    )

    pageItem P145_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @filter
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P145_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = 'GRN'
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                  ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Select Company Name
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
    )

    pageItem P145_CREATOR (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Creator
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        GetEmployeeName(bu.EmployeeCode)||'('||a.Creator||')' d,
                        GetEmployeeName(bu.EmployeeCode)||'('||a.Creator||')' r
                From GRN a,BossUser bu
                Where a.Creator = bu.LoginName(+)
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 140
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 40
            valuePlaceholder: Creator Name
        }
    )

    pageItem P145_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                rapidSelection
            ]
            numberOfTags: 1
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      dt.DocTypeName d,
                      dt.DocTypeCode r
                From  ModulePrivilege a, ModulePrivilegeDocType b, DocType dt, BossUser bu, ModuleDocType md, ModuleDocTypeDetail mdd
                Where a.TNo = b.TNo(+)
                  and (b.DocTypeCode = dt.DocTypeCode or b.DocTypeCode is null)
                  and a.ModuleCode = md.ModuleCode
                  and md.TNo = mdd.TNo
                  and mdd.DocTypeCode = dt.DocTypeCode
                  and a.ModuleCode = 'GRN'
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                Order By 1
                ;
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P145_COMPANY
            itemsToSubmit: P145_DOCTYPE
        }
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
            valuePlaceholder: Enter DocType Name
        }
    )

