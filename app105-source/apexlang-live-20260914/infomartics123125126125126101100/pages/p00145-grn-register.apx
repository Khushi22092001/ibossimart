    pageItem P145_GRNNO (
        type: textFieldWithAutocomplete
        label {
            label: GRN No
            alignment: left
        }
        settings {
            infiniteScroll: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select GRNNo 
                From GRN 
                Where instr(':'||:P145_LOCATION||':',':'||LocationCode||':') > 0
                  and GRNDate Between :P145_FROMDATE and :P145_TODATE
                Order by 1
                ```
