    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 80
            region: @filter
            slot: regionBody
            column: 12
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
        advanced {
            htmlDomId: REFRESH
        }
    )

    dynamicAction click-refresh-button (
        name: click refresh button
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     var button = document.getElementById('REFRESH');
                        button.click();
                    ```
            }
            execution {
                sequence: 20
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select globaltno.nextval from dual;
            }
            affectedElements {
                selectionType: items
                items: P153_TNO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction dialogclose (
        name: DialogClose
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @voucher-detail-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @voucher-detail-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 50
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New_1
        execution {
            sequence: 30
        }
        when {
            event: focusin
            selectionType: items
            items: P153_URL
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: getModuleNoURL('x', 'x')
            }
            affectedElements {
                selectionType: items
                items: P153_URL
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new-2 (
        name: New
        execution {
            sequence: 40
        }
        when {
            event: dblclick
            selectionType: items
            items: P153_URL
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: " apex.navigation.dialog($v(P153_URL));"
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-3 (
        name: New_2
        execution {
            sequence: 70
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @voucher-detail-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

