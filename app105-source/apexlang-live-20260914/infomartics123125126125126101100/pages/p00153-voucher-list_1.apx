    pageItem P153_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and upper(bu.BossUserName) =  upper('&APP_USER.')
                  and getcompanyprivilege(C.COMPANYCODE,GETMODULECODEFORPAGENO(:APP_PAGE_ID),:GLOBAL_LOGINNAME)='YES'
                ```
            nullDisplayValue: -Select-
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
    )

    pageItem P153_DOCTYPE (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Doctype
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      dt.DocTypeName d,
                      dt.DocTypeCode r
                From  ModulePrivilege a, ModulePrivilegeDocType b, DocType dt, BossUser bu, ModuleDocType md, ModuleDocTypeDetail mdd
                Where a.TNo = b.TNo(+)
                  and (b.DocTypeCode = dt.DocTypeCode or b.DocTypeCode is null)
                  and a.ModuleCode = md.ModuleCode
                  and md.TNo = mdd.TNo
                  and mdd.DocTypeCode = dt.DocTypeCode
                  and a.ModuleCode = GETMODULECODEFORPAGENO(:APP_PAGE_ID)
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                  and instr(':'||:P153_COMPANY||':',':'||a.CompanyCode||':') > 0
                Order by 1
                ;
                ```
            nullDisplayValue: -Select-
        }
        cascadingLov {
            parentItems: P153_COMPANY
            parentRequired: false
        }
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            alignment: left
            columnSpan: 6
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P153_FROMDATE (
        type: datePicker
        label {
            label: From date
            alignment: left
