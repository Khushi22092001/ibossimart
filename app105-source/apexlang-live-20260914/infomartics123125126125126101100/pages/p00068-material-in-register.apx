                Select
                      Distinct
                      a.Creator d,
                      a.Creator r
                From GATEINREGISTER_VIEW a
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 140
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
