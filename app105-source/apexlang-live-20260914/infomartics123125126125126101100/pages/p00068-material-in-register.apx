                Select MaterialInNo 
                From MaterialIn 
                Where instr(':'||:P68_LOCATION||':',':'||LocationCode||':') > 0
                --  and instr(':'||:P114_DOCTYPE||':',':'||DocTypeCode||':') > 0
                  and MaterialInDate Between :P68_FROMDATE and :P68_TODATE
                Order by 1
