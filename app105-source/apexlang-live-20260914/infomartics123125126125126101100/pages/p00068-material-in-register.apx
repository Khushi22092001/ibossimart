        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 180
            region: @filter
            slot: regionBody
        }
    )

    pageItem P68_TODATE (
        type: datePickerJquery
        label {
            label: To Date
            alignment: left
        }
        settings {
            showOtherMonths: true
            navigationListFor: monthAndYear
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 15
            valuePlaceholder: To Date
        }
        validation {
            valueRequired: true
        }
        source {
            used: always
        }
        default {
            type: expression
            plsqlExpression: Trunc(sysdate)
        }
        security {
            encryptSessionState: false
        }
    )

    pageItem P68_TRANSPORTER (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Transporter
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: [
                limitDisplayedTags
                minimalInputLength
                rapidSelection
            ]
            minimalInputLength: 1
            numberOfTags: 3
            defaultAutocompleteSearch: displayColumn3
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: displayDisplayColumn
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                      Distinct
                      p.PartyName d,
                      p.PartyCode r
                From MaterialIn a, Party p
                Where a.TransporterCode = p.PartyCode
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @filter
            slot: regionBody
            alignment: left
            column: 1
            columnSpan: 8
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 74
            valuePlaceholder: Transporter Name
        }
        source {
            used: always
        }
    )

    pageItem P68_VEHICLENO (
        type: textFieldWithAutocomplete
        label {
            label: Vehicle No
            alignment: left
        }
        settings {
            infiniteScroll: false
            fetchOnType: false
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                        Distinct
                        a.VehicleNo
                From MaterialIn a
                
                Union
                
                Select
                        Distinct
                        a.VehicleNo
                From MaterialOut a
                ```
        }
        layout {
            sequence: 100
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 15
            valuePlaceholder: Vehicle No
        }
        source {
            used: always
        }
        security {
            encryptSessionState: false
        }
    )

