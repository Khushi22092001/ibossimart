                ```sql
                SELECT B.ITEMSPECIFICATIONNAME D, B.ITEMSPECIFICATIONCODE R
                FROM ITEM A, ITEMSPECIFICATION B
                WHERE A.TNO = B.TNO
                AND A.ITEMCODE=:P798_ITEMCODE
