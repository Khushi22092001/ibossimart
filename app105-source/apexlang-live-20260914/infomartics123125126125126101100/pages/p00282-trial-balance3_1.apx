    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: custom
            customEvent: contextmenu
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action plugin-com-pretius-apex-contextmenu (
            action: plugin/pretiusApexContextMenu
            settings {
                listName: trial_context
                settings: [
                    displayAtMousePosition
                    stopEventPropagation
                ]
            }
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P282_WITHINDENT
                P282_LEDGERONLY
                P282_LOCATIONCODE
                P282_ACCOUNTCODE
                P282_INCLUDECHILD
                P282_INCLUDEZEROTRANSACTION
                P282_ACCOUNTLEVEL
                P282_EXCLUDE0CLOSING
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-3 (
        name: New_2
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action plugin-com-enhanceigwithtreegrid-plugin (
            action: plugin/enhanceInteractiveGridWithTreegrid
            settings {
                idColumn: PARTYCODE
                parentIdColumn: PARENTCODE
                expandCollapse: collapse
                displayOnColumn: PARTYNAME
                levelColumn: LEVEL
            }
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new-4 (
        name: New_3
        execution {
            sequence: 40
        }
        when {
            event: region/interactiveGrid/gridpagechange
            selectionType: region
            region: @new
        }

        action plugin-com-enhanceigwithtreegrid-plugin (
            action: plugin/enhanceInteractiveGridWithTreegrid
            settings {
                idColumn: PARTYCODE
                parentIdColumn: PARTYNAME
                expandCollapse: collapse
                displayOnColumn: PARTYNAME
                levelColumn: LEVEL
            }
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                 if :p282_accountcode is not null then
                   :P282_ACCOUNTLEVEL := to_number(:P282_ACCOUNTLEVEL)  + 1;
                 end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 12467264274669279
        }
    )

    process new-save-interactive-grid-data (
        name: New - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @new
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 12474119504671246
        }
    )

)

