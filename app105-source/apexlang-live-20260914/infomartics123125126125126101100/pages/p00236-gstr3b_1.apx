    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 50
            region: @gstr3b
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                            delete from gstr3binward where creator = v('APP_USER');
                     		delete from gstr3boutward where creator = v('APP_USER');
                     		commit;
                     		
                     	  getoutwardtaxablesupply(:P236_fromdate , :P236_todate, :P236_companycode , :p236_STATECODE) ;
                     	  getinwardtaxablesupply(:P236_fromdate , :P236_todate, :P236_companycode , :p236_STATECODE) ;
                      	COMMIT;
                    ```
                itemsToSubmit: [
                    P236_COMPANYCODE
                    P236_STATECODE
                    P236_FROMDATE
                    P236_TODATE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-submit-page (
            action: submitPage
            settings {
                showProcessing: false
            }
            execution {
                sequence: 510
                fireOnInit: false
            }
        )

        action set-value (
            name: set value 5_1
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select SUM(A.TAXABLEAMOUNT) 
                      		from 
                      				Gstr3Binward a , footernature c 
                      		where
                      		
                      				 a.creator = user 
                      				and a.footernaturecode = c.footernaturecode(+)
                      				and a.natureofsupplycode in ('6','2','3','4') 
                      			--	and c.ITCELIGIBILITYCODE = 'INPUTS'
                      				AND A.TRANSACTIONTYPECODE ='INTERSTATE'
                      			--	and a.taxregistrationtypecode ='RD' 
                      				AND A.COMPANYCODE = :P236_COMPANYCODE 
                      		;
                    ```
                itemsToSubmit: [
                    P236_COMPANYCODE
                    P236_FROMDATE
                    P236_TODATE
                    P236_STATECODE
                ]
            }
            affectedElements {
                selectionType: items
                items: P236_5_1
            }
            execution {
                sequence: 490
                fireOnInit: false
            }
        )

        action set-value-2 (
            name: set value 5_2
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select SUM(A.TAXABLEAMOUNT)
                      		from 
                      				Gstr3Binward a , footernature c 
                      		where
                      		
                      				 a.creator = user 
                      				and a.footernaturecode = c.footernaturecode(+)
                      				and a.natureofsupplycode in ('6','2','3','4') 
                      		--		and c.ITCELIGIBILITYCODE = 'INPUTS'
                      				AND A.TRANSACTIONTYPECODE ='INTRASTATE'
                      				AND NVL(A.CGST,0) + NVL(A.SGST,0)  = 0 
                      					--and a.taxregistrationtypecode ='RD' 
                      					AND A.COMPANYCODE = :P236_COMPANYCODE 
                      		;
                    ```
                itemsToSubmit: [
                    P236_COMPANYCODE
                    P236_FROMDATE
                    P236_TODATE
                    P236_STATECODE
                ]
            }
            affectedElements {
                selectionType: items
                items: P236_5_2
            }
            execution {
                sequence: 500
                fireOnInit: false
            }
        )

        action set-value-2a (
            name: set value 2A
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(a.taxableamount) 
                    	from 
                    			Gstr3boutward a 
                    	where
                    	a.natureofsupplycode = '1'
                    	and a.taxregistrationtypecode ='RD' 
                    	and a.creator = V('APP_USER')
                    	AND A.COMPANYCODE = :P236_COMPANYCODE
                    ```
                itemsToSubmit: [
