page 40 (
    name: Code Scheme
    alias: CODE-SCHEME
    title: Code Scheme
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            #MYID .t-fht-thead{
              overflow: auto !important;
            }
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region code-scheme (
        name: Code Scheme
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.COMPANYCODE,
                       a.FINANCIALYEARCODE,
                       a.MODULECODE,
                       a.INCLUDECOMPANYSHORTNAME,
                       a.INCLUDEMODULESHORTNAME,
                       a.INCLUDELOCATIONSHORTNAME,
                       a.INCLUDETRANSACTIONYEAR,
                       a.INCLUDETRANSACTIONMONTH,
                       a.INCLUDETRANSACTIONDAY,
                       a.COMPANYSHORTNAMEPOSITION,
                       a.MODULESHORTNAMEPOSITION,
                       a.LOCATIONSHORTNAMEPOSITION,
                       a.TRANSACTIONYEARPOSITION,
                       a.TRANSACTIONMONTHPOSITION,
                       a.TRANSACTIONDAYPOSITION,
                       a.SEPARATORCHARACTER,
                       a.INITIALIZATIONPERIOD,
                       a.STARTNO,
                       a.CODESCHEME,
                       a.MONTHLYINITIALIZATIONDAY,
                       a.DAILYINITIALIZATIONDAY,
                       a.INCLUDEDOCTYPESHORTNAME,
                       a.INCLUDEOTHERSHORTNAME,
                       a.DOCTYPESHORTNAMEPOSITION,
                       a.OTHERSHORTNAMEPOSITION,
                       a.OTHERTABLENAME,
                       a.OTHERCOLUMNNAME,
                       a.OTHERCOLUMNNAMEINTHEMODULE,
                       a.OTHERCODECOLUMNNAME,
                       a.CREATOR,
                       a.NOFORMAT,
                       a.CREATIONTIME,
                       a.TNO,
                       b.ModuleName,
                       'Reset' AS Reset,
                       'Set' AS S
                  from CODESCHEME a, Module b
                 where a.ModuleCode = b.ModuleCode
                   and a.companycode = :GLOBAL_COMPANYCODE
                   AND a.FinancialYearCode = :GLOBAL_FINANCIALYEARCODE
                ```
            pageItemsToSubmit: P40_TNO
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        performance {
            lazyLoading: true
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 500
        }
        advanced {
            savedReportMappingIdentifier: 461842345333893083
        }

