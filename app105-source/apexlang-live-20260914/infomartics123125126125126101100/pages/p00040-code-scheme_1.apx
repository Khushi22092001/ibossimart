    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid ,COMPANYCODE,
                        FINANCIALYEARCODE,
                        MODULECODE,
                        LOCATIONCODE,
                        LASTNO,
                        DOCTYPECODE,
                        OTHERCODE,
                        TRANSACTIONDATE,
                        FORMONTH,
                        TNO,
                        SNO
                   from CODESCHEMEDETAIL
                  where tno = :P40_TNO
                    and COMPANYCODE = :global_companycode
                    and financialyearcode = :global_financialyearcode
                ```
            pageItemsToSubmit: P40_TNO
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/inline-dialog
