    dynamicAction close (
        name: close
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-close-region (
            action: closeRegion
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction reset (
        name: Reset
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: columns
            interactiveGrid: @code-scheme
            columns: RESET
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    IF :P40_RESET = 'YES' then
                      delete from codeschemedetail where tno = :p40_tno ;
                    end if;
                    ```
                itemsToSubmit: [
                    P40_RESET
                    P40_TNO
                ]
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT 'YES' FROM DUAL
                itemsToSubmit: RESET
            }
            affectedElements {
                selectionType: items
                items: P40_RESET
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :TNO
                itemsToSubmit: TNO
            }
            affectedElements {
                selectionType: items
                items: P40_TNO
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction set-tno (
        name: set tno
        execution {
            sequence: 30
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @code-scheme
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var pSno,
                    model = this.data.model;
                    
                    pSNO = model.getValue( this.data.selectedRecords[0], "TNO");
                    
                    apex.item( "P40_TNO" ).setValue (pSNO);
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

