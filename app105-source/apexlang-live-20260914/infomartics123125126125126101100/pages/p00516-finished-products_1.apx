    pageItem P516_RUNDATE (
        type: hidden
        layout {
            sequence: 10
            region: @products-360-view-report
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                SELECT
                     TO_CHAR(LASTRUNDATE,'DD-MM-YYYY HH:MI AM') LASTRUNDATE
                FROM D_SUPPLIER_360VIEW
                ```
        }
        security {
            encryptSessionState: false
        }
    )

    button lastrun (
        buttonName: LASTRUN
        label: <p style="text-size:12px; color:#da1b1b;font-weight:bold">Last Run Date : &P516_RUNDATE.</p>
        layout {
            sequence: 10
            region: @products-360-view-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction hide-menu (
        name: Hide Menu
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
                    //$("#t_Body_nav").hide();
                    //$(this).treeView("collapse", n$)
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

