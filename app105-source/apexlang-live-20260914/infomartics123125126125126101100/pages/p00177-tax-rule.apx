                       LEGENDSCODE,
                       'FD' AS FD,
                       MINIMUMLIMIT,
                       MINIMUMLEGENDSCODE,
                       MAXIMUMLIMIT,
                       MAXIMUMLEGENDSCODE,
                       REMARK
                  from TAXRULEDETAIL 
                  where tno = :P177_TNO
