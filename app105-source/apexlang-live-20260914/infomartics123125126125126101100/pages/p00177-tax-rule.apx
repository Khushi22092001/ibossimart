    process tax-rule-detail-save-interactive-grid-data (
        name: Tax Rule Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @tax-rule-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into TAXRULEDETAIL (                 
                                        tno                ,
                                        sno                ,
                                        taxcategorycode    ,
                                        taxrate            ,
                                        legendscode        ,
                                        minimumlimit       ,
                                        minimumlegendscode ,
                                        maximumlimit       ,
                                        maximumlegendscode ,
                                        remark             
                                      )
                            Values (
                                        :tno,
                                        :sno,
                                        :taxcategorycode,
                                        :taxrate,
                                        :legendscode,
                                        :minimumlimit,
                                        :minimummlegendscode,
                                        :maximumlimit,
                                        :maximummlegendscode,
                                        :remark
                              );
                        
                        when 'U' then
                            update TAXRULEDETAIL Set
                                       tno                = :tno,
                                        sno                = :sno,
                                        taxcategorycode    = :taxcategorycode,
                                        taxrate            = :taxrate,
                                        legendscode        = :legendscode,
                                        minimumlimit       = :minimumlimit,
                                        minimumlegendscode = :minimummlegendscode,
                                        maximumlimit       = :maximumlimit,
                                        maximumlegendscode = :maximummlegendscode,
                                        remark             = :remark
                            WHERE TNO = :P177_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From TAXRULEDETAIL
                            Where TNo = :P177_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 170819627374961613
        }
    )

