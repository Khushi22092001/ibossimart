    region tax-rule (
        name: Tax Rule
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.TAXRULECODE,
                       A.TAXRULENAME,
                       A.HSNCODE,
                       A.SACCODE,
                       A.TAXREGISTRATIONTYPECODE,
                       A.TRANSACTIONTYPECODE,
                       A.EFFECTIVEFROM,
                       A.REMARK,
                       A.CREATOR,
                       A.CREATIONTIME,
                       NVL(getdocumentstatuscode(getmodulecodeforpageno(:APP_PAGE_ID),TNO),'STATUS') AS STATUS
                  from TAXRULE A
                ```
            pageItemsToSubmit: P177_TNO
        }
        layout {
            sequence: 20
            parentRegion: @tab
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

