    dynamicAction calculate-sum-of-amount-value-on-get-focus (
        name: Calculate Sum of Amount Value on get focus
        execution {
            sequence: 540
        }
        when {
            event: focusin
            selectionType: columns
            interactiveGrid: @detail-2
            columns: [
                FOOTERAMOUNT
                TOTALAMOUNT
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail_Region").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("AMOUNT");
                    var footerKey = model.getFieldKey("FOOTERAMOUNT");
                    var grandtotalKey = model.getFieldKey("TOTALAMOUNT");
                    var totalAmt = 0;
                    var footerAmt = 0;
                    var grandtotalAmt = 0;
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                      var footer = parseFloat(r[footerKey], 10);
                      var grandtotal = parseFloat(r[grandtotalKey], 10);
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                      if (!isNaN(footer)) {
                        footerAmt += footer;
                      }
                    
                      if (!isNaN(grandtotal)) {
                        grandtotalAmt += grandtotal;
                      }
                    });
                    
                    $s("P159_SUMOFAMOUNT", totalAmt);
                    $s("P159_SUMOFFOOTERAMOUNT", footerAmt);
                    $s("P159_DEBITNOTEAMOUNT", grandtotalAmt);
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :FOOTERAMOUNT
                itemsToSubmit: FOOTERAMOUNT
            }
            affectedElements {
                selectionType: items
                items: P159_SUMOFFOOTERAMOUNT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction calculate-sum-of-amount-value-on-loose-focus (
        name: Calculate Sum of Amount Value on Loose focus
        execution {
            sequence: 530
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail-2
            columns: [
                FOOTERAMOUNT
                TOTALAMOUNT
            ]
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var model = apex.region("Detail_Region").widget().interactiveGrid("getViews", "grid").model;
                    var totalKey = model.getFieldKey("AMOUNT");
                    var footerKey = model.getFieldKey("FOOTERAMOUNT");
                    var grandtotalKey = model.getFieldKey("TOTALAMOUNT");
                    var totalAmt = 0;
                    var footerAmt = 0;
                    var grandtotalAmt = 0;
                    
                    model.forEach(function(r) {
                      var total = parseFloat(r[totalKey], 10);
                      var footer = parseFloat(r[footerKey], 10);
                      var grandtotal = parseFloat(r[grandtotalKey], 10);
                    
                      if (!isNaN(total)) {
                        totalAmt += total;
                      }
                    
                      if (!isNaN(footer)) {
                        footerAmt += footer;
                      }
                    
                      if (!isNaN(grandtotal)) {
                        grandtotalAmt += grandtotal;
                      }
                    });
                    
                    $s("P159_SUMOFAMOUNT", totalAmt);
                    $s("P159_SUMOFFOOTERAMOUNT", footerAmt);
                    $s("P159_DEBITNOTEAMOUNT", grandtotalAmt);
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: :FOOTERAMOUNT
                itemsToSubmit: FOOTERAMOUNT
            }
            affectedElements {
                selectionType: items
                items: P159_SUMOFFOOTERAMOUNT
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

