    region detail-footer (
        name: Detail Footer
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.TNO,
                       a.SNO,
                       a.SN,
                       a.SERIALNO,
                       a.FOOTERHEADCODE,
                       a.FOOTERPERCENT,
                       a.FOOTERVALUE,
                       a.LEGENDSCODE ,
                       b.includewithtaxableamount
                  from debitnotedetailfooter a , footerhead b 
                  Where a.footerheadcode = b.footerheadcode
                  and a.TNo = :P159_TNO
                    and a.sno = :P159_SNO
                ```
            pageItemsToSubmit: [
                P159_TNO
                P159_SNO
            ]
        }
        layout {
            sequence: 40
