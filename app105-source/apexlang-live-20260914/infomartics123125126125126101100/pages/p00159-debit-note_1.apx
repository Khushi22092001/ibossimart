    dynamicAction documentstatus (
        name: DocumentStatus
        execution {
            sequence: 370
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @status
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 70
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P159_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @status
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    --SetDocumentStatusCode('PURCHASEORDER',13604,:P159_STATUS);
                    SetDocumentStatusCode(GetModuleCodeForPageNo(:APP_PAGE_ID),:P159_TNO,:P159_STATUS);
                    if :P159_STATUS = 'ACTIVE' and :P159_VOUCHERTNO  is null  then
                        -- POSTDEBITNOTE(:P159_TNO,TO_DATE(:P159_DEBITNOTEDATE));
                        PostDebitNote_temp(:P159_TNO,TO_DATE(:P159_DEBITNOTEDATE));  --Created by Vibhor
                    
                        IF :P159_STOCKREQUIRED = 'YES' THEN
                    
                            PostDebitNoteStock_Temp(:P159_TNO);
                    
                            apex_debug.message(
                                p_message => 'PostDebitNoteStock_Temp completed for TNO: %s', 
                                p0        => :P159_TNO
                            );
                        ELSE
                           apex_debug.message(
                                p_message => 'PostDebitNoteStock_Temp Not completed for TNO: %s', 
                                p0        => :P159_TNO
                            );
                        END IF;
                    
                    end if;
                    ```
                itemsToSubmit: [
                    P159_TNO
                    P159_STATUS
                    P159_DEBITNOTEDATE
                    P159_VOUCHERTNO
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $('#STATUS span').text($v('P159_STATUS'));
                    
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P164_DOCUMENTSTATUSCODE
            }
            affectedElements {
                selectionType: items
                items: P159_STATUS
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

