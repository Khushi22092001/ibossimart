    process saveratecontractfooter (
        name: SaveratecontractFooter
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    delete from ratecontractfooter where tno = :P714_TNO;
                    insert into ratecontractfooter
                        (tno ,
                        SNO,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   SELECT X.TNO,
                                   GLOBALTNO.NEXTVAL,
                                   X.FOOTERHEADCODE,
                                   X.SUMOFVALUE
                             FROM 
                            (select 
                                :P714_TNO AS TNO ,               
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from ratecontractdetailfooter
                            where tno = :P714_TNO
                            group by FOOTERHEADCODE
                            ) X
                        );
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 60853064232523179
        }
    )

