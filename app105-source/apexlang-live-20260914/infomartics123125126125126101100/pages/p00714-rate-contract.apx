            plsqlCode:
                ```plsql
                If :P714_TNO is null then
                    :P714_TNO := GlobalTNo.nextval;
                    :P714_FORMSTATUS := 'NEWRECORD';
                else
                    
                    :P714_FORMSTATUS := 'EDITRECORD';
