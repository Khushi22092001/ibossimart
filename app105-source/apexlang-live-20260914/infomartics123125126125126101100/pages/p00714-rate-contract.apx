    button addnew (
        buttonName: AddNew
        label: Add New
        layout {
            sequence: 210
            region: @buttons
            slot: change
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pillEnd
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: &APP_PAGE_ID.
                clearCache: &APP_PAGE_ID.
            }
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Want to Add New Record?
        }
    )

    button addnew-2 (
        buttonName: ADDNEW_1
        label: ADD NEW
        layout {
            sequence: 10
            region: @attachment
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 63
                items: {
                    P63_MODULETNO: &P714_TNO.
                }
                clearCache: 63
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 40
            region: @footerdetail
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 100
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 130
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: item=value
            item: P714_FORMSTATUS
            value: NEWRECORD
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 110
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P714_FORMSTATUS
            value: EDITRECORD
        }
    )

    button fail (
        buttonName: Fail
        label: Fail
        layout {
            sequence: 60
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-thumbs-o-down
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 163
                clearCache: 163
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P714_FORMSTATUS
            value: EDITRECORD
        }
    )

    button flow (
        buttonName: Flow
        label: FLow
        layout {
            sequence: 70
            region: @buttons
            slot: close
