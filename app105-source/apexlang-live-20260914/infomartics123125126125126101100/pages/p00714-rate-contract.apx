    dynamicAction set-dfamount (
        name: Set DFAMOUNT
        execution {
            sequence: 570
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @detail
            columns: AMOUNT
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                    TMP NUMBER;
                    begin
                     select count(*) into tmp from ratecontractdetailfooter
                     WHERE TNO = :TNO AND SNO = :SNO;
                    
                     if nvl(tmp,0) = 0 and :P714_FORMSTATUS = 'NEWRECORD' then
                    
                     --raise_application_error(-20000,'-'||:P714_HSNCODE||'-'||'HSN');
                    
                            DELETE FROM ratecontractDetailFooter WHERE TNO = :TNO AND SNO = :SNO;
                            commit;
                            for vTaxRule
                        				in (
                        					select
                        						rownum as slno,
                        						b.TNo,
                        						b.SNO,
                        						a.LegendsCode,
                        						c.FooterHeadCode,
                        						c.FooterHeadName,
                        						b.TaxRate as FooterPercent,
                                                (:P714_DFAMOUNT * B.TAXrATE) /100 AS FooterValue
                        					from TaxRuleDetail a, TaxRuleDetailFooter b, FooterHead c, TaxRule d, TaxRuleHSN e, party F
                        					where a.TNO = b.TNo
                        						and a.SNO = b.SNo
                        						and b.FooterHeadCode = c.FooterHeadCode
                        						and a.TNO = d.TNo
                                                and d.tno = e.tno
                                                and d.TaxRegistrationTypeCode = f.TaxRegistrationTypeCode
                                                and f.PartyCode = :P714_PARTYCODE
                                                And d.transactiontypecode = :P714_TRANSACTIONTYPECODE
                                                and e.HSNCODE =  :P714_HSNCODE
                        					order by b.SNo
                        				)
                        			loop
                               -- RAISE_APPLICATION_ERROR(-20000,'tAXRULE');
                                          -- 
                                          ----
                        			    Insert into ratecontractDetailFooter(tno,sno,sn,footerheadcode,footerpercent,footervalue,serialno,legendscode)
                        				values(:TNO,:SNO,globaltno.nextval,vTaxRule.FooterHeadCode,vTaxRule.FooterPercent,vTaxRule.FooterValue,vTaxRule.Slno,vTaxRule.LegendsCode);
                        				
                        			end loop; -- for vTaxRule
                                    COMMIT;
                        end if;
                    end;
                    ```
                itemsToSubmit: [
                    TNO
                    SNO
                    P714_HSNCODE
                    P714_TRANSACTIONTYPECODE
                    P714_DFAMOUNT
                    P714_PARTYCODE
                    ITEMCODE
                    ITEMSPECIFICATIONCODE
                    P714_FORMSTATUS
                ]
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @footerdetail
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select hsncode from itemspecification where itemspecificationcode = :itemspecificationcode;
                itemsToSubmit: ITEMSPECIFICATIONCODE
            }
            affectedElements {
                selectionType: items
                items: P714_HSNCODE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-set-value-2 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select :AMOUNT, :SNO from dual
                itemsToSubmit: [
                    AMOUNT
                    SNO
                ]
            }
            affectedElements {
                selectionType: items
                items: [
                    P714_DFAMOUNT
                    P714_SNO
                ]
            }
            execution {
