    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P672_Tno is null then
                        Select GlobalTno.NextVal into :P672_Tno From Dual;
                     end if;
                    ----
                    if :P672_ASSETDISCARDNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P672_LocationCode,
                					:P672_DocTypeCode,
                					NULL,
                					TO_DATE(:P672_ASSETDISCARDDATE, 'DD-MM-RRRR')
                				);
                        :P672_ASSETDISCARDNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P672_LocationCode,
                                    :P672_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P672_ASSETDISCARDDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 32689906599250198
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P672_TNO is null then
                    :P672_TNO := GlobalTNo.nextval;
                    :P672_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P672_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P672_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P672_TNO), 'Status');
                
                begin
                select TNO into :P672_VOUCHERTNO from voucher 
                        where moduletno = :P672_TNO
                          AND MODULECODE='ASSETDISCARD';
                exception when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32681330814214837
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P672_MODULEFLOW := 'YES';
                   else
                       :P672_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P672_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P672_ONTHETABLE := 'YES' ;
                   else
                       :P672_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 32681617390215747
        }
    )

