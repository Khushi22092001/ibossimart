    process set-sum-values (
        name: set sum values
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    pAssetvalue number:=0;
                    pDepreciatedvalue number:=0;
                    pNetvalue number:=0;
                begin
                
                    select sum(nvl(ASSETVALUE,0)), sum(nvl(DEPRECIATEDAMOUNT,0)), sum(nvl(NETVALUE,0)) 
                        into pAssetvalue , pDepreciatedvalue , pNetvalue
                    from ASSETDISCARDDETAIL 
                    where tno = :P672_TNO;
                  
                    update assetdiscard set assetvalue = pAssetvalue , DEPRECIATEDAMOUNT = pDepreciatedvalue , NETVALUE = pNetvalue
                    where tno = :P672_TNO;
                
                    exception when others then
                        null;
                
                end;
                ```
        }
        execution {
            sequence: 70
        }
        advanced {
            executionMappingIdentifier: 83953228528008248
        }
    )

