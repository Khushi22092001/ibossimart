    pageItem P672_STATUSRIGHT (
        type: hidden
        layout {
            sequence: 10
            region: @common-fields
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select B.STATUSPRIVILEGE
                  From module a, moduleprivilege b, bossuser c
                 Where a.modulecode = b.modulecode
                   And b.bossusercode = c.bossusercode
                   And c.loginname = :GLOBAL_LOGINNAME
                   And A.ENTRYPAGENO = :APP_PAGE_ID
                   AND B.COMPANYCODE = :GLOBAL_COMPANYCODE
                ```
        }
    )

    pageItem P672_STOCKACCOUNTCODE (
        type: popupLov
        label {
            label: Stock/Expense
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	A.PARTYNAME as AccountName,
                	a.PartyCode as AccountCode
                from Party a, Item b
                where  :P672_DocTypeCode != 'DISPOSEOFF'
                and a.PartyCode = b.StockAccountCode
                and b.ItemCode = :P672_ToItemCode 
                union all
                select
                	distinct
                	A.PARTYNAME as AccountName,
                	a.PartyCode as AccountCode
                from Party a, MyAccountInclude b, PartyCompany c, DocumentStatusDetail dsd
                where a.PartyCode = b.ChildCode
                	and b.AccountCode = 'EXPENDITURES'
                	and a.TNo = c.TNo
                	and c.CompanyCode = :global_CompanyCode
                	and a.TNo = dsd.ModuleTNo
                	and dsd.DocumentStatusCode ='ACTIVE'
                	and a.PartyTypeCode = 'ACCOUNT'
                	and :P672_DocTypeCode = 'DISPOSEOFF'
                order by 1
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: [
                P672_DOCTYPECODE
                P672_TOITEMCODE
            ]
            itemsToSubmit: [
                P672_DOCTYPECODE
                P672_TOITEMCODE
            ]
            parentRequired: false
        }
        layout {
            sequence: 120
            region: @asset-discard
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        source {
            formRegion: @asset-discard
            column: STOCKACCOUNTCODE
            dataType: varchar2
        }
    )

