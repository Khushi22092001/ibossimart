    dynamicAction insert-into-detail (
        name: Insert into detail
        execution {
            sequence: 140
        }
        when {
            event: click
            selectionType: button
            button: @getcode
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLaRE
                    tAssetValue             Number;
                    tDepreciatedAmount1     Number;
                    tDepreciatedAmount2     Number;
                    sn                      number:=0;
                    BEGIN
                    delete from ASSETDISCARDDETAIL where tno = :P672_TNO;
                    
                    for vAsset
                    				in (
                    						select
                    							b.AssetCode || ' (' || a.AssetNo || ' )' as AssetCodeAndAssetNo,
                    							a.TNo, 
                    							b.AssetCode 
                    						from Asset a, AssetCodeDetail b, AssetWorkCentre c
                    						where a.TNo = b.TNo(+)
                    							and b.AssetCode = c.AssetCode(+)
                    							and b.TNO = c.ModuleTNo(+)
                    							and a.AssetDate <= :P672_AssetDiscardDate
                    							and a.AccountCode = :P672_AssetAccountCode
                    							--and c.WorkCentreCode = :P672_FromWorkCentreCode(+)
                    							and a.LocationCode = :P672_LocationCode
                    							--and a.ItemCode = :P672_ToItemCode
                    							--and a.ItemSpecificationCode = :P672_ToItemSpecificationCode
                    					    and a.CompanyCode = :global_CompanyCode
                    							and not exists(
                    								select
                    									aa.tno
                    								from AssetSaleDetail aa
                    								where aa.AssetCode = b.AssetCode
                    									and aa.AssetTNo = b.TNo
                    							)
                    							and not exists(
                    								select
                    									aa.tno
                    								from AssetDiscardDetail aa
                    								where aa.AssetCode = b.AssetCode
                    									and aa.AssetTNo = b.TNo
                    							)	
                    							/*and not exists(
                    								select
                    									aa.tno
                    								from AssetTransferFromAsset aa
                    								where aa.AssetCode = b.AssetCode
                    									and aa.AssetTNo = b.TNo
                    							)	*/
                    						order by b.AssetCode
                    				
                    				)
                    		loop
                    			sn := sn+1;
                    
                                    insert into ASSETDISCARDDETAIL
                                    (
                                        tno,
                                        sno,
                                        serialno,
                                        assettno,
                                        assetcode
                                    )
                                    values
                                    (
                                        :P672_TNO,
                                        globaltno.nextval,
                                        sn,
                                        vAsset.TNo,
                                        vAsset.AssetCode
                                    );
                    		end loop;
                    ---- dt 10-apr-2024
                    for vDet in (
                     select * from ASSETDISCARDDETAIL where tno = :P672_TNO
                    )loop
                    select
                    				sum(a.AssetValue),
                    				sum(a.DepreciatedAmount) 
                    						into tAssetValue, tDepreciatedAmount1
                    		from AssetCodeDetail a
                    		where a.TNo = vDet.AssetTNo
                    		  and a.AssetCode = vDet.AssetCode
                    		;
                    		select
                    				sum(a.DepreciationAmount) into tDepreciatedAmount2
                    		from DepreciationDetail a
                    		where a.AssetTNo = vDet.AssetTNo
                    				and a.AssetCode = vDet.AssetCode
                    		;
                    		
                            update AssetDiscardDetail a
                               set a.AssetValue = tAssetValue,
                                   a.DepreciatedAmount = nvl(tDepreciatedAmount1, 0) + nvl(tDepreciatedAmount2, 0),
                                   a.netvalue = nvl(tAssetValue,0) - (nvl(tDepreciatedAmount1, 0) + nvl(tDepreciatedAmount2, 0))
                            where Tno = :P672_TNO
                              and AssetTNo = vDet.AssetTNo
                    		  and a.AssetCode = vDet.AssetCode
                             ;
                    
                    end loop;
                    END;
                    ```
                itemsToSubmit: [
                    P672_TNO
                    P672_ASSETDISCARDDATE
                    P672_ASSETACCOUNTCODE
                    P672_FROMWORKCENTRECODE
                    P672_LOCATIONCODE
                    P672_TOITEMCODE
                    P672_TOITEMSPECIFICATIONCODE
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @detail
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select sum(nvl(ASSETVALUE,0)), sum(nvl(DEPRECIATEDAMOUNT,0)), sum(nvl(NETVALUE,0)) from ASSETDISCARDDETAIL 
                    where tno = :P672_TNO
                    ```
                itemsToSubmit: P672_TNO
            }
            affectedElements {
                selectionType: items
                items: [
                    P672_ASSETVALUE
                    P672_DEPRECIATEDAMOUNT
                    P672_NETVALUE
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

