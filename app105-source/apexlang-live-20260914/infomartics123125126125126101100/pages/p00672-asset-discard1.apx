                sequence: 60
                fireOnInit: false
            }
            clientSideCondition {
                type: item!=value
                item: P672_STATUS
                value: ACTIVE
            }
        )

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
