    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from ASSETDISCARDDETAIL a
                        where not exists (
                            select 1 from ASSETDISCARD  aa  
                            where aa.tno = a.tno
                        );
                    ```
