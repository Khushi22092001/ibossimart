                       MAXLOANAMOUNT,
                       MAXMULTIPLEOFBASIC,
                       DOCSUBMISSIONWITHINDAYS,
                       MINGUARANTOR,
                       NEXTREQUESTAFTERDAYS,
                       REMARK,
                       CREATOR,
                       CREATIONTIME,
                       NVL(GETDOCUMENTSTATUSCODE(GETMODULECODEFORPAGENO(:APP_PAGE_ID),A.TNO),'STATUS') AS STATUS
                  from LOANSCHEME A
