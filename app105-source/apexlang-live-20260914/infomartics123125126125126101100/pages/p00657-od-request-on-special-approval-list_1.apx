    region od-request-on-special-approval-list (
        name: OD Request On Special Approval List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                        COMPANYCODE,
                        FINANCIALYEARCODE,
                        LOCATIONCODE,
                        DOCTYPECODE,
                        TOURREQONSPECIALAPPROVALNO,
                        TOURREQONSPECIALAPPROVALDATE,
                        TOURREQUESTTNO,
                        HOTELNAME,
                        HOTELDETAIL,
                        TOTALEXPENSEAMOUNT,
                        BALANCEAMOUNT,
                        TOTALSELFAMOUNT,
                        TOTALCOMPANYAMOUNT,
                        REMARK,
                        CREATOR,
                        CREATIONTIME,
                        CONVEYANCESCHEMETNO,
                        '<a href="'||APEX_UTIL.PREPARE_URL('f?p='||:APP_ID||':'||9993||':'||:APP_SESSION||'::::'||'P9993_TNO,P9993_REPNAME'||':'||Tno||','||'ODRequestOnSpecialApproval'||':NO')||'"><span aria-label="Action"><span class="fa fa-print"  aria-hidden="true" title="Action"></span</span></a>' AS Print
                
                  from TOURREQUESTONSPECIALAPPROVAL
                  where TOURREQONSPECIALAPPROVALDATE  between :P657_FROMDATE and :P657_TODATE
                  and   ( :P657_COMPANY IS NULL OR instr(':'||:P657_COMPANY||':',':'||COMPANYCODE||':') > 0 )
                  and   ( :P657_LOCATION IS NULL OR instr(':'||:P657_LOCATION||':',':'||LOCATIONCODE||':') > 0 )
                  and   ( :P657_DOCTYPE IS NULL OR instr(':'||:P657_DOCTYPE||':',':'||DOCTYPECODE||':') > 0 )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 658
                items: {
                    P658_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 52349856150300012
        }

