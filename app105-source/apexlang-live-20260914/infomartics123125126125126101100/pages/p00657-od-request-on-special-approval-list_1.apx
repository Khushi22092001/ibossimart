    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P657_BIREPORTURL').val()
              var reportName = 'IRONMART/REPORT/ODRequestOnSpecialApprovalRegister.xdo';
              var outputFormat = 'pdf';
              var fromDate = new Date($('#P657_FROMDATE').val());
              var toDate = new Date($('#P657_TODATE').val());
              var companycode ,global_companycode;
              var arraCom = [];
              try
              {
              arraCom = $('#P657_COMPANY').val().split(":");
              }catch(ex){
            
              }
             
              if($('#P657_COMPANY').val() ==="" || $('#P657_COMPANY').val() ===null)
              {
                 companycode='&GLOBAL_COMPANYCODE.';
                 global_companycode='&GLOBAL_COMPANYCODE.';
              } else if(arraCom.length>1)
              {
                  companycode = $('#P657_COMPANY').val(); 
                  global_companycode='&GLOBAL_COMPANYCODE.';
                  
              }
              else{
                  companycode = $('#P657_COMPANY').val();
                   global_companycode= $('#P657_COMPANY').val();
              }  
            
                 var reportParams = 
                 '&P_COMPANY='+ companycode +     
                  '&P_FROMDATE=' +$('#P657_FROMDATE').val() + 
                  '&P_TODATE=' +$('#P657_TODATE').val() + 
                  '&P_LOCATION=' + $('#P657_LOCATION').val() + 
                  '&P_DOCTYPE=' +$('#P657_DOCTYPE').val()  +
                  '&GLOBAL_COMPANYCODE=' +global_companycode
                   
                  ;
              
            
             
                    var reportURL = bireporturl+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P657_BIREPORTURL').val()
              var reportName =  'ODRequestOnSpecialApprovalRegister.xdo';
              var outputFormat = 'pdf';
            var companycode ,global_companycode;
              var arraCom = [];
              try
              {
              arraCom = $('#P657_COMPANY').val().split(":");
              }catch(ex){
            
              }
             
              if($('#P657_COMPANY').val() ==="" || $('#P657_COMPANY').val() ===null)
              {
                 companycode='&GLOBAL_COMPANYCODE.';
                 global_companycode='&GLOBAL_COMPANYCODE.';
              } else if(arraCom.length>1)
              {
                  companycode = $('#P657_COMPANY').val(); 
                  global_companycode='&GLOBAL_COMPANYCODE.';
                  
              }
              else{
                  companycode = $('#P657_COMPANY').val();
                   global_companycode= $('#P657_COMPANY').val();
              }  
            
            
            //   var reportParams = 
            //     '"_paramsP_TNO":"' + $('#P657_TNO').val() 
            //       ;
            
            var reportParams = 
                  '"_paramsP_COMPANY":"'+ companycode + '",' +
                  '"_paramsP_FROMDATE":"' +$('#P657_FROMDATE').val() + '",' + 
                  '"_paramsP_TODATE":"' +$('#P657_TODATE').val() + '",' + 
            	  '"_paramsP_LOCATION":"' + $('#P657_LOCATION').val() + '",' + 
            	  '"_paramsP_DOCTYPE":"' +$('#P657_DOCTYPE').val() + '",' +
                  '"_paramsGLOBAL_COMPANYCODE":"' +global_companycode;
                 
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            
            ```
