    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: custom
            customEvent: contextmenu
            selectionType: jsExpression
            javaScriptExpression: document
        }

        action plugin-com-pretius-apex-contextmenu (
            action: plugin/pretiusApexContextMenu
            settings {
                listName: trial_context
                settings: [
                    displayAtMousePosition
                    stopEventPropagation
                ]
            }
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: [
                P401_WITHINDENT
                P401_LEDGERONLY
                P401_LOCATIONCODE
                P401_ACCOUNTCODE
                P401_INCLUDECHILD
                P401_INCLUDEZEROTRANSACTION
                P401_ACCOUNTLEVEL
                P401_EXCLUDE0CLOSING
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @new
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: New
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                 if :p401_accountcode is not null then
                   :P401_ACCOUNTLEVEL := to_number(:P401_ACCOUNTLEVEL)  + 1;
                 end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 18306039225264610
        }
    )

)

