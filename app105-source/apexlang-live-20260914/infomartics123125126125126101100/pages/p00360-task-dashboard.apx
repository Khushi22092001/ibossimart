    )

    dynamicAction new-5 (
        name: New_2
        execution {
            sequence: 50
        }
        when {
            event: region/interactiveGrid/interactivegridselectionchange
            selectionType: region
            region: @task-grid
        }
    )

    process new-save-interactive-grid-data (
        name: New - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @task-grid
        lockRow {
            preventLostUpdates: false
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 13275536658191127
        }
    )

