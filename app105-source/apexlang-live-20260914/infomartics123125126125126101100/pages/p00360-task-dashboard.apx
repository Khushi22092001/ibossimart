                JOIN taskassignment ta ON t.assignment_id = ta.assignment_id
                WHERE t.TaskStatus = 'Pending'
                AND ta.employeecode = :GLOBAL_BOSSUSERCODE
                
                ```
            pageItemsToSubmit: P360_CARD_TITLE
        }
        orderBy {
            type: item
            item: {
                itemName: P360_ORDER_BY
                orderBys: {
                    CARD_TITLE: "CARD_TITLE" asc
                }
            }
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: [
                im-stat-card
                im-stat-pending-exec
            ]
        }
        componentAppearance {
            cssClasses: &CARD_CLASS.
        }
        card {
            cssClasses: &CARD_CLASS.
            primaryKeyColumn1: CARD_TITLE
        }
        title {
            column: CARD_TITLE
            cssClasses: &CARD_CLASS.
        }
        secondaryBody {
            advancedFormatting: true
            htmlExpression:
                ```html
                <span class="im-card-num">&CARD_TEXT.</span>
                
                ```
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 360
                    items: {
                        P360_CARD_TITLE: &CARD_TITLE.
                    }
                    clearCache: 360
                }
            }
        )

    )

    region pending-verification (
        name: Pending Verification
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 'Pending Verification' AS card_title,
                       COUNT(*) AS card_text
                FROM taskinstance t
                JOIN taskassignment ta ON t.assignment_id = ta.assignment_id
                WHERE t.TaskStatus = 'Completed' 
                AND t.VerificationStatus = 'Pending Verification'
                AND ta.assigned_by = :GLOBAL_BOSSUSERCODE
                ```
            pageItemsToSubmit: P360_CARD_TITLE
        }
        orderBy {
            type: item
            item: {
                itemName: P360_ORDER_BY
                orderBys: {
                    CARD_TITLE: "CARD_TITLE" asc
                }
            }
        }
        layout {
            sequence: 50
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
            cssClasses: [
                im-stat-card
                im-stat-pending-verif
            ]
        }
        componentAppearance {
            cssClasses: &CARD_CLASS.
        }
        card {
            cssClasses: &CARD_CLASS.
            primaryKeyColumn1: CARD_TITLE
        }
        title {
            column: CARD_TITLE
            cssClasses: &CARD_CLASS.
        }
        secondaryBody {
            advancedFormatting: true
            htmlExpression:
                ```html
                <span class="im-card-num">&CARD_TEXT.</span>
                
                ```
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 360
                    items: {
                        P360_CARD_TITLE: &CARD_TITLE.
                    }
                    clearCache: 360
                }
            }
        )

    )

    region task-grid (
        name: Task Grid
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT t.Instance_id,
                       t.Assignment_id,
                       t.TaskCode,
                       t.Instance_Date,
                       t.TargetDate,
                       t.Completed_Date,
                       t.TaskStatus,
                       t.VerificationStatus,
                       t.MarksObtained_Employee,
                       t.MarksObtained_Verifier,
                       t.Comments,
                       t.Verified_By,
                       t.Verified_Date,
                       t.EmployeeCode
                FROM taskinstance t
                JOIN taskassignment ta ON t.assignment_id = ta.assignment_id
                WHERE (
                    (ta.employeecode = :GLOBAL_BOSSUSERCODE AND (
                        (:P360_CARD_TITLE = 'Pending Execution' AND t.TaskStatus = 'Pending')
                        OR
                        (:P360_CARD_TITLE = 'Completed' AND t.TaskStatus = 'Completed' AND t.VerificationStatus = 'Verified')
                    ))
                    OR
                    (ta.assigned_by = :GLOBAL_BOSSUSERCODE AND (
                        (:P360_CARD_TITLE = 'Pending Verification' AND t.TaskStatus = 'Completed' AND t.VerificationStatus = 'Pending Verification')
                        OR
                        (:P360_CARD_TITLE = 'Completed' AND t.TaskStatus = 'Completed' AND t.VerificationStatus = 'Verified')
                    ))
                )
                ```
            pageItemsToSubmit: P360_CARD_TITLE
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
            cssClasses: im-task-table
        }
        advanced {
            htmlDomId: im-task-table
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        componentAppearance {
            selectFirstRow: false
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 33544082253634131
        }

        savedReport 94656 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ASSIGNMENT_ID
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @TASKCODE
                layout {
                    width: 173
                    sequence: 3
                }
            )

            displayColumn (
                column: @INSTANCE_ID
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @INSTANCE_DATE
                layout {
                    width: 129
                    sequence: 10
                }
            )

            displayColumn (
                column: @TARGETDATE
                layout {
                    width: 136
                    sequence: 11
                }
            )

            displayColumn (
                column: @TASKSTATUS
                layout {
                    width: 125
                    sequence: 7
                }
            )

            displayColumn (
                column: @COMPLETED_DATE
                layout {
                    width: 165
                    sequence: 12
                }
            )

            displayColumn (
                column: @VERIFICATIONSTATUS
                layout {
                    width: 186
                    sequence: 8
                }
            )

            displayColumn (
                column: @MARKSOBTAINED_EMPLOYEE
                layout {
                    width: 224
                    sequence: 14
                }
            )

            displayColumn (
                column: @MARKSOBTAINED_VERIFIER
                layout {
                    width: 209
                    sequence: 15
                }
            )

            displayColumn (
                column: @COMMENTS
                layout {
                    width: 69
                    sequence: 16
                }
            )

            displayColumn (
                column: @VERIFIED_BY
                layout {
                    width: 206
                    sequence: 9
                }
            )

            displayColumn (
                column: @VERIFIED_DATE
                layout {
                    width: 133
                    sequence: 13
                }
            )

            displayColumn (
                column: @EMPLOYEECODE
                layout {
                    width: 170
                    sequence: 6
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 83
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column ASSIGNMENT_ID (
            type: numberField
            heading {
                heading: Assignment Id
                alignment: end
            }
            layout {
                sequence: 180
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ASSIGNMENT_ID
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column COMMENTS (
            type: textarea
            heading {
                heading: Comments
            }
            layout {
                sequence: 280
            }
            validation {
                maxLength: 500
            }
            source {
                databaseColumn: COMMENTS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column COMPLETED_DATE (
            type: displayOnly
            heading {
                heading: Completed Date
            }
            layout {
                sequence: 240
            }
            source {
                databaseColumn: COMPLETED_DATE
                dataType: date
            }
            default {
                type: expression
                plsqlExpression: CASE WHEN :TaskStatus = 'Completed' THEN TRUNC(SYSDATE) ELSE :Completed_Date END
            }
        )

        column EMPLOYEECODE (
            type: popupLov
            heading {
                heading: Employee
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT e.employeename AS d,
                           e.employeecode AS r
                    FROM employee e
                    JOIN taskassignment b
                         ON e.employeecode = b.employeecode
                    WHERE b.assignment_id = :assignment_id;
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ASSIGNMENT_ID
                itemsToSubmit: EMPLOYEECODE
            }
            layout {
                sequence: 310
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: EMPLOYEECODE
                dataType: varchar2
            }
        )

        column INSTANCE_DATE (
            type: datePicker
            heading {
                heading: Instance Date
            }
            layout {
                sequence: 210
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: INSTANCE_DATE
                dataType: date
            }
        )

        column INSTANCE_ID (
            type: hidden
            layout {
                sequence: 200
            }
            source {
                databaseColumn: INSTANCE_ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column MARKSOBTAINED_EMPLOYEE (
            type: numberField
            heading {
                heading: Marksobtained Employee
                alignment: end
            }
            layout {
                sequence: 260
                columnAlignment: end
            }
            source {
                databaseColumn: MARKSOBTAINED_EMPLOYEE
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column MARKSOBTAINED_VERIFIER (
            type: numberField
            heading {
                heading: Marksobtained Verifier
                alignment: end
            }
            layout {
                sequence: 270
                columnAlignment: end
            }
            source {
                databaseColumn: MARKSOBTAINED_VERIFIER
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column TARGETDATE (
            type: datePicker
            heading {
                heading: Target Date
            }
            layout {
                sequence: 220
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: TARGETDATE
                dataType: date
            }
        )

        column TASKCODE (
            type: popupLov
            heading {
                heading: Task
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT a.taskname AS d,
                           a.taskcode AS r
                    FROM task a
                    LEFT JOIN taskassignment b
                           ON a.taskcode = b.taskcode
                    WHERE b.assignment_id = :assignment_id;
                    
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ASSIGNMENT_ID
                itemsToSubmit: TASKCODE
            }
            layout {
                sequence: 190
            }
            validation {
                valueRequired: true
                maxLength: 50
            }
            source {
                databaseColumn: TASKCODE
                dataType: varchar2
            }
        )

        column TASKSTATUS (
            type: checkbox
            heading {
                heading: Task Status
            }
            settings {
                useDefaults: false
                checkedValue: Completed
                uncheckedValue: Pending
            }
            layout {
                sequence: 230
                stretch: always
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: TASKSTATUS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                exactMatch: false
            }
            serverSideCondition {
                type: item=value
                item: P360_CARD_TITLE
                value: Pending Execution
            }
        )

        column VERIFICATIONSTATUS (
            type: radioGroup
            heading {
                heading: Verification Status
            }
            lov {
                type: staticValues
                staticValues: STATIC:Verified;Verified,Rejected;Rejected,Pending Verification;Pending Verification
                displayNullValue: false
            }
            layout {
                sequence: 250
                columnAlignment: center
                stretch: always
            }
            source {
                databaseColumn: VERIFICATIONSTATUS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
            serverSideCondition {
                type: item=value
                item: P360_CARD_TITLE
                value: Pending Verification
            }
        )

        column VERIFIED_BY (
            type: popupLov
            heading {
                heading: Verified By
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT e.employeename AS d,
                           e.employeecode AS r
                    FROM employee e
                    JOIN taskassignment b
                         ON e.employeecode = b.assigned_by
                    WHERE b.assignment_id = :assignment_id;
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ASSIGNMENT_ID
                itemsToSubmit: VERIFIED_BY
            }
            layout {
                sequence: 290
            }
            source {
                databaseColumn: VERIFIED_BY
                dataType: number
            }
        )

        column VERIFIED_DATE (
            type: displayOnly
            heading {
                heading: Verified Date
            }
            layout {
                sequence: 300
            }
            source {
                databaseColumn: VERIFIED_DATE
                dataType: date
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            font: courier
        }
        columnHeadings {
            backgroundColor: #dde5ff
        }
        columns {
            backgroundColor: #010106
        }
    )

    pageItem P360_CARD_TITLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            slot: body
        }
    )

    pageItem P360_ORDER_BY (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: body
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: CARD_TITLE
        }
    )

    button assigntask (
        buttonName: AssignTask
        label: Assign Task
        layout {
            sequence: 30
            slot: beforeNavigationBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 356
                clearCache: 356
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button createtask (
        buttonName: CreateTask
        label: Create Task
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 355
                clearCache: 355
            }
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Do You Want to crete a task?
            style: information
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            selectionType: columns
            interactiveGrid: @task-grid
            columns: TASKSTATUS
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: TRUNC(SYSDATE)
                itemsToSubmit: TASKSTATUS
            }
            affectedElements {
                selectionType: columns
                columns: COMPLETED_DATE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            clientSideCondition {
                type: itemColumn=value
                column: TASKSTATUS
                value: Completed
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: region
            region: @pending-execution
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @task-grid
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @task-grid
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P360_CARD_TITLE
                value: Pending Execution
            }
        )

    )

    dynamicAction new-3 (
        name: New_1_1
        execution {
            sequence: 30
        }
