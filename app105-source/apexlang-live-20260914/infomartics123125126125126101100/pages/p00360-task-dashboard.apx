                region: @task-grid
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P360_CARD_TITLE
                value: Pending Verification
            }
        )

    )

    dynamicAction new-4 (
        name: New_1_1_1
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: region
            region: @completed
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @task-grid
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @task-grid
            }
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P360_CARD_TITLE
