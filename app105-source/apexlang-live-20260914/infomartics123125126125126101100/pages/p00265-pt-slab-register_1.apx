    region pt-slab-register (
        name: PT Slab Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       PTSLABNO,
                       PTSLABDATE,
                       DATEONWARD,
                       STATECODE,
                       MONTHSFORSLAB,
                       FIRSTMONTH,
                       NOOFDEDUCTIONPERYEAR,
                       REMARK,
                       CREATOR,
                       CREATIONTIME
                  from PTSLAB A
                  WHERE A.COMPANYCODE = :P265_COMPANY
                    AND ( :P265_LOCATION IS NULL OR A.LOCATIONCODE = :P265_LOCATION)
                    AND (:P265_DOCTYPE IS NULL OR A.DOCTYPECODE = :P265_DOCTYPE)
                ```
            pageItemsToSubmit: [
                P265_COMPANY
                P265_LOCATION
                P265_DOCTYPE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: MYID
        }
        link {
            linkColumn: customTarget
            target: {
                page: 266
                items: {
                    P266_TNO: #TNO#
                }
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
