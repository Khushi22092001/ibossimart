    dynamicAction check-indent-and-sanction-qty (
        name: check Indent and sanction qty
        execution {
            sequence: 440
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @item-detail
            columns: QUANTITY1
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Get the sanctioned quantity and indent quantity values for the current row
                    var sanctionedQty = apex.region("Detail").widget().interactiveGrid("getSelectedRecords")[0]['INDENTQUANTITY1'];
                    var indentQty = apex.region("Detail").widget().interactiveGrid("getSelectedRecords")[0]['QUANTITY1'];
                    
                    // Check if the sanctioned quantity is greater than the indent quantity
                    if(parseFloat(sanctionedQty) > parseFloat(indentQty)) {
                        // Display an alert message
                        alert("Sanctioned quantity cannot be greater than indent quantity.");
                    
                        // Set focus back to the sanctioned quantity field
                        apex.region("Detail").widget().interactiveGrid("getActions").focus('QUANTITY1');
                    }
                    
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

    )

    dynamicAction checkduplicate (
        name: checkDuplicate
        execution {
            sequence: 360
        }
        when {
            event: focusout
            selectionType: columns
            interactiveGrid: @item-detail
            columns: ITEMSPECIFICATIONCODE
        }
        serverSideCondition {
            type: never
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $te = $(this.triggeringElement);
                    
                    var cur_rowId = $te.closest('tr').data('id');
                    
                    var cur_item_num = apex.item( 'ITEMSPECIFICATIONCODE' ).getValue().toUpperCase();
                    
                    var widget = apex.region('Detail').widget();
                    
                    var grid = widget.interactiveGrid('getViews', 'grid');
                    
                    var model = grid.model;
                    
                    apex.message.clearErrors();
                    
                    model.forEach(function(record) {
                    
                    if (cur_rowId != model.getValue(record, 'ITEMSPECIFICATIONCODE')) {
                    
                    if (cur_item_num == model.getValue(record, 'ITEMSPECIFICATIONCODE').toUpperCase()) {
                    
                    apex.item( 'ITEMSPECIFICATIONCODE' ).setValue( '' );
                    
                    apex.message.showErrors([{
                    
                    type: 'error',
                    
                    location: 'page',
                    
                    message: Item Specification already exists. Please select other specification or use this Item Number -'+model.getValue(record, 'ITEMSPECIFICATIONCODE'),
                    
                    unsafe: false
                    
                    }]);
                    
                    }}})
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
        )

        action native-javascript-code-2 (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    varmodel = apex.region("Detail").widget().interactiveGrid("getViews","grid").model;
                    var v_spname, v_spcode;
                    var val = $v("ITEMSPECIFICATIONCODE");
                    var num = [];
                    v_spcode = MODEL.GETfIELDKEY("ITEMSPECIVICATIONCODE");
                    model.forEach(function(igrow) {
                        num.unshift(igrow[v_spcode]);
                        console.log(num);
                        console.log(num.indexof(val));
                        if(num.indexof(val) >-1){
                            letresponse = prompt("Duplicate","");
                            if (response == null||response==""){
                                $("#ITEMSPECIFICATIONCODE").val('test')
                            }else{
                                $(#ITEMSPECIFICATIONCODE").val(response);
                            }
                                
                            }
                        });
                    
                    }
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-button-for-updateprivillege (
        name: DISABLE DELETE BUTTON FOR UPDATEPRIVILLEGE
        execution {
            sequence: 220
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      tmp number;
                    begin
                         for vloop in (
                            
                            Select 1
                              From MODULEPRIVILEGE A
                             Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                               And a.bossusercode = :GLOBAL_BOSSUSERCODE
                               And a.companycode = :GLOBAL_COMPANYCODE
                               AND A.DELETEPRIVILEGE = 'NO'
                         ) loop
                               tmp := 1;
                               exit;
                         end loop;
                    
                         select count(*) into tmp from purchaseorder a where a.indenttno = :P108_TNO ;
                         if nvl(tmp,0) = 0 then
                            return false;
                         else
                            return true;
                         end if;
                    end;
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 40
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    select 1 from purchaseorder
                    where indenttno = :P108_TNO;
                    ```
            }
        )

        action native-disable-3 (
            action: disable
            affectedElements {
                selectionType: button
                button: @save
            }
            execution {
                sequence: 50
            }
            serverSideCondition {
                type: never
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 30
            }
            serverSideCondition {
                type: functionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      tmp number;
                      tmp1 number;
                    begin
                         for vloop in (
                                   Select 1
                              From MODULEPRIVILEGE A
                             Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                               And a.bossusercode = :GLOBAL_BOSSUSERCODE
                               And a.companycode = :GLOBAL_COMPANYCODE
                               AND A.DELETEPRIVILEGE = 'YES'
                         ) loop
                               tmp1 := 1;
                               exit;
                         end loop;
                    
                         select count(*) into tmp from purchaseorder a where a.indenttno = :P108_TNO ;
                         if nvl(tmp,0) > 0 then
                            return false;
                         else
                            if nvl(tmp1,0) > 0 then
                               return true;
                            else 
                                return false;
                            end if;
                         end if;
                    end;
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
        execution {
            sequence: 240
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @print
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.PRINTPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @print
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
