    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P108_Tno is null then
                        Select GlobalTno.NextVal into :P108_Tno From Dual;
                     end if;
                    ----
                    if :P108_INDENTNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P108_LocationCode,
                					:P108_DocTypeCode,
                					NULL,
                					TO_DATE(:P108_INDENTDATE, 'DD-MM-RRRR')
                				);
                        :P108_INDENTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P108_LocationCode,
                                    :P108_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P108_INDENTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 6602586301015112
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P108_TNO is null then
                    :P108_TNO := GlobalTNo.nextval;
                    :P108_FORMSTATUS := 'NEWRECORD';
                else
                    :P108_FORMSTATUS := 'EDITRECORD';
                End if;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6601380552015112
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P108_MODULEFLOW := 'YES';
                   else
                       :P108_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P108_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P108_ONTHETABLE := 'YES' ;
                   else
                       :P108_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6602187569015112
        }
    )

