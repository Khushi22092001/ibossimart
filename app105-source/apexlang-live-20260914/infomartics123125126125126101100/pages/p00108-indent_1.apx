    pageItem P108_DEPARTMENTCODE (
        type: popupLov
        label {
            label: Department
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                       a.DepartmentName,
                       a.Departmentcode
                from 
                       Department a
                where getdocumentstatuscode('DEPARTMENT',A.TNO) = 'ACTIVE'
                
                ```
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @general
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 1
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 100
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @indent
            column: DEPARTMENTCODE
            dataType: varchar2
        }
    )

    pageItem P108_DOCTYPECODE (
        type: popupLov
        label {
            label: Doc Type
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	a.DocTypeName as d,
                	a.DocTypeCode as r
                from DocType a, ModuleDocTypeDetail b , ModuleDocType c, Module d
                where a.DocTypeCode = b.DocTypeCode
                	and b.tno = c.tno
                	and c.ModuleCode = d.ModuleCode
                    and d.EntryPageNo = :APP_PAGE_ID
                    AND getdocumentstatuscode('DOCTYPE',A.TNO) = 'ACTIVE'
                ```
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @general
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 1
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 100
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @indent
            column: DOCTYPECODE
            dataType: varchar2
        }
    )

