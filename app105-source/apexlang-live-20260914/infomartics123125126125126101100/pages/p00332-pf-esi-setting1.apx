    pageItem P332_ESICDAMAGESACCR (
        type: popupLov
        label {
            label: Esicdamagesaccr
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                a.PartyName as Account,
                a.PartyCode as AccountCode
                From Party a, DocumentStatusDetail dsd
                Where a.Tno = dsd.ModuleTno
                and dsd.DocumentStatusCode = 'ACTIVE'
                and a.PartyTypeCode = 'ACCOUNT'
                Order by a.PartyName
                ```
        }
        layout {
            sequence: 280
            region: @esic-settings
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @pf-settings
            column: ESICDAMAGESACCR
            dataType: varchar2
        }
    )

