page 332 (
    name: PF & ESI Setting
    alias: PF-ESI-SETTING1
    title: PF & ESI Setting
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region commonfields (
        name: CommonFields
        type: staticContent
        layout {
            sequence: 20
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region esic-settings (
        name: ESIC Settings
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
    )

    region flow-buttons (
        name: Flow Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
    )

    region pf-settings (
        name: PF Settings
        type: form
        source {
            location: localDatabase
            tableName: PFANDESICSETTING
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
    )

    pageItem ESIC (
        type: displayOnly
        label {
            label: PF
            alignment: left
        }
        settings {
            showLineBreaks: false
            sendOnPageSubmit: false
        }
        layout {
            sequence: 60
            region: @esic-settings
            slot: regionBody
            alignment: left
            columnSpan: 1
            labelColumnSpan: 0
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        default {
