    process set-doc-no (
        name: Set Doc No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    --tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tModuleCode varchar2(30) := 'MATERIALIN';
                    tmp         number ;
                begin
                     if :P332_TNO is null then
                        Select GlobalTno.NextVal into :P332_TNO From Dual;
                     end if;
                    ----
                    if :P332_CHEQUERECEIPTCODE is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					null,
                					null,
                					NULL,
                					TO_DATE(:P332_CHEQUERECEIPTDATE, 'DD-MM-RRRR')
                				);
                        :P332_CHEQUERECEIPTCODE := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    null,
                                    null,
                                    NULL,
                                    TO_DATE(:P332_CHEQUERECEIPTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 41511666989355312
        }
    )

