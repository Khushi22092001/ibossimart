        action set-round-off-amount (
            name: set round off amount
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    DECLARE
                      rtvalue number;
                    BEGIN
                      if :P221_BILLINROUNDFIGURE = 'YES' then
                            rtvalue := round(:P221_JBPASSAMOUNTBEFOREROUND,0) - :P221_JBPASSAMOUNTBEFOREROUND ;
                      end if;
                      return(rtvalue);
                    
                    END;
                    ```
                itemsToSubmit: [
                    P221_BILLINROUNDFIGURE
                    P221_JBPASSAMOUNTBEFOREROUND
                ]
            }
            affectedElements {
                selectionType: items
                items: P221_ROUNDOFF
            }
