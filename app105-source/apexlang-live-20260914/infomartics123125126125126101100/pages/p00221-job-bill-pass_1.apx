    region tds (
        name: TDS
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       FOOTERHEADCODE,
                       FOOTERPERCENT,
                       FOOTERVALUE,
                       NARRATION,
                       SERIALNO,
                       SNO,
                       TNO
                  from JBPASSTDSDETAIL
                  where tno = :P221_TNO
                ```
            pageItemsToSubmit: P221_TNO
        }
        layout {
            sequence: 40
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 12598471700617436
        }

        savedReport 126649 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ROWID
