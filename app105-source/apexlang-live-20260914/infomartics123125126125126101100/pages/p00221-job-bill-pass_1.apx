                                b.FOOTERHEADCODE,
                                b.FOOTERPERCENT,
                                b.FOOTERVALUE,
                                b.LEGENDSCODE,
                                'IS'
                            from jobbilldetail a ,jobbilldetailfooter b ,  jbpassdetail c
                            where a.tno = :P221_JOBBILLTNO
