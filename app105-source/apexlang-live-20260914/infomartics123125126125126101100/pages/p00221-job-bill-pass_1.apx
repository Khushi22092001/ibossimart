    dynamicAction set-rcm-no (
        name: set rcm no
        execution {
            sequence: 440
        }
        when {
            event: ready
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: select tno,reversechargeno from reversecharge where moduletno = :P221_TNO
                itemsToSubmit: P221_TNO
                escapeSpecialChars: false
