                sequence: 110
                fireOnInit: false
            }
        )

        action update-master-amount (
            name: Update master amount
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    declare
                        pamount number;
                        pfamount number;
                        ptamount number;
                    begin
                        select sum(nvl(amount,0)) , sum(nvl(footeramount,0)) , sum(nvl(totalamount,0))
                            into :P221_SUMOFAMOUNT , :P221_SUMOFFOOTERAMOUNT , :P221_JBPASSAMOUNT 
                        from jbpassdetail where tno = :P221_TNO
                        group by tno;
                    
                        
                    
                    end;
                    ```
                itemsToSubmit: [
                    P221_SUMOFAMOUNT
                    P221_SUMOFFOOTERAMOUNT
                    P221_JBPASSAMOUNT
                    P221_TNO
                ]
                itemsToReturn: [
                    P221_SUMOFAMOUNT
                    P221_SUMOFFOOTERAMOUNT
                    P221_JBPASSAMOUNT
                ]
                showProcessing: true
            }
            execution {
                sequence: 90
                fireOnInit: false
            }
            serverSideCondition {
                type: never
            }
