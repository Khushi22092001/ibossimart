                    SELECT GETPARTYATTRIBUTENAME(A.ATTRIBUTECODE)  CATEGORYNAME,
                    A.ATTRIBUTECODE CATEGROYCODE
                    FROM
                    travelingmodedetail A, TRAVELINGMODE B
                    WHERE
                    A.TNO=B.TNO
                    AND B.TRAVELINGMODECODE=:MODEOFTRAVELCODE
                    ```
                displayNullValue: false
