    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into TOUREXPENSEDETAIL (                 
                                    TNO,
                SNO,
                EXPENSEDATE,
                ACCOUNTCODE,
                MODEOFTRAVELCODE,
                CATEGORYCODE,
                CLASSOFCITYCODE,
                MEASURINGUNITCODE,
                QUANTITY,
                RATE,
                AMOUNT,
                EXPENSEDETAIL,
                BILLSTATUSTYPECODE,
                REMARK,
                ATTACHMENTBLOB,
                FILENAME,
                POLICYRATE,
                POLICYAMOUNT,
                APPROVEDAMOUNT
                            )
                            Values (
                                :TNO,
                :SNO,
                :EXPENSEDATE,
                :ACCOUNTCODE,
                :MODEOFTRAVELCODE,
                :CATEGORYCODE,
                :CLASSOFCITYCODE,
                :MEASURINGUNITCODE,
                :QUANTITY,
                :RATE,
                :AMOUNT,
                :EXPENSEDETAIL,
                :BILLSTATUSTYPECODE,
                :REMARK,
                :ATTACHMENTBLOB,
                :FILENAME,
                :POLICYRATE,
                :POLICYAMOUNT,
                :APPROVEDAMOUNT
                
                            );
                        
                        when 'U' then
                            update TOUREXPENSEDETAIL Set
                                  TNO=:TNO,
                SNO=:SNO,
                EXPENSEDATE=:EXPENSEDATE,
                ACCOUNTCODE=:ACCOUNTCODE,
                MODEOFTRAVELCODE=:MODEOFTRAVELCODE,
                CATEGORYCODE=:CATEGORYCODE,
                CLASSOFCITYCODE=:CLASSOFCITYCODE,
                MEASURINGUNITCODE=:MEASURINGUNITCODE,
                QUANTITY=:QUANTITY,
                RATE=:RATE,
                AMOUNT=:AMOUNT,
                EXPENSEDETAIL=:EXPENSEDETAIL,
                BILLSTATUSTYPECODE=:BILLSTATUSTYPECODE,
                REMARK=:REMARK,
                ATTACHMENTBLOB=:ATTACHMENTBLOB,
                FILENAME=:FILENAME,
                POLICYRATE=:POLICYRATE,
                POLICYAMOUNT=:POLICYAMOUNT,
                APPROVEDAMOUNT=:APPROVEDAMOUNT
                
                
                            WHERE TNO = :P660_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From TOUREXPENSEDETAIL
                            Where TNo = :P660_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 27170923363681237
        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P660_Tno is null then
                        Select GlobalTno.NextVal into :P660_Tno From Dual;
                     end if;
                    ----
                    if :P660_TOUREXPENSENO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P660_LocationCode,
                					:P660_DocTypeCode,
                					NULL,
                					TO_DATE(:P660_TOUREXPENSEDATE, 'DD-MM-RRRR')
                				);
                        :P660_TOUREXPENSENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P660_LocationCode,
                                    :P660_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P660_TOUREXPENSEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 27092213511080234
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P660_TNO is null then
                    :P660_TNO := GlobalTNo.nextval;
                    :P660_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P660_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P660_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P660_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 27064059650040851
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P660_MODULEFLOW := 'YES';
                   else
                       :P660_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P660_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P660_ONTHETABLE := 'YES' ;
                   else
                       :P660_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 27064375648041807
        }
    )

