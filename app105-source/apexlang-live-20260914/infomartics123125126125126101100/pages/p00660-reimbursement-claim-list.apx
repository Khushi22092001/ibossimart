    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from TOUREXPENSEDETAIL a
                        where not exists (
                            select 1 from TOUREXPENSE  aa  
                            where aa.tno = a.tno
                        )and a.tno = :P660_TNO;
                    
                    
                    ```
                itemsToSubmit: P660_TNO
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var x = apex.item('P660_CALLEDFROMPAGE').getValue();
                    var y = apex.item('P660_CALLEDFROMTNO').getValue();
                    
                    //var url = "f?p=#APP_ID#:80:#SESSION#::NO:RP,80:P156_TNO,P156_CALLEDFROMPAGE,P156_FORMSTATUS:#P156_TNO#,#P156_CALLEDFROMPAGE#,#P156_FORMSTATUS#";
                    
                    
                    var url = "f?p=#APP_ID#:#2002#:#SESSION#::NO:RP,#2002#:P#2002#_TNO:#P2002_TNO#";
                    //:P2002_TNO:#P2002_TNO#";
                    
                    url = url.replace("#APP_ID#", $v("pFlowId"));
                    url = url.replace("#SESSION#", $v("pInstance"));
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    url = url.replace("#2002#", x);
                    
                    url = url.replace("#P2002_TNO#", y);
                    //window.alert(x);
                    //window.alert(y);
                    //window.alert(url);
                    
                    
                    //call
                    apex.server.process("PREPARE_URL", {
                    x01: url
                      }, {
                      success: function(pData) {
                       if (pData.success === true) {
                         apex.navigation.redirect(pData.url);
                       } else {
                         console.log("FALSE");
                       }
                     },
                    error: function(request, status, error) {
                    console.log("status---" + status + " error----" + error);
                      }
                    });
                    
                    ```
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction delete-unsaved-record-from-detail-table (
        name: delete unsaved record from detail table
        execution {
            sequence: 110
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from TOUREXPENSEDETAIL a
                        where not exists (
                            select 1 from TOUREXPENSE  aa  
                            where aa.tno = a.tno
                        ) and a.tno=:P660_TNO;
                    
                    ```
                itemsToSubmit: P660_TNO
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P660_STATUS
                value: ACTIVE
            }
        )

        action native-disable-3 (
            action: disable
            execution {
                sequence: 70
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from loadingadvice aa where aa.purchaseordertno = :P660_TNO;
            }
        )

        action native-disable-4 (
            action: disable
            execution {
                sequence: 80
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery: select 1 from paymentadvice aa where aa.moduletno = :P660_TNO;
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                       and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
        execution {
            sequence: 100
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       AND A.PRINTPRIVILEGE= 'NO'
                    and a.CompanyCode = :global_CompanyCode
                    ```
            }
        )

        action native-enable (
            action: enable
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
