        column ACCOUNTCODE (
            type: popupLov
            heading {
                heading: Expense Head
            }
            settings {
                popupWidth: 200
            }
            lov {
                type: sqlQuery
                sqlQuery: select JOBTYPENAME , JOBTYPECODE from jobtype
                displayNullValue: false
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: ACCOUNTCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column AMOUNT (
            type: numberField
