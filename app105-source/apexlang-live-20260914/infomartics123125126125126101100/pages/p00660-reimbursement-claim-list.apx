page 660 (
    name: Reimbursement Claim
    alias: REIMBURSEMENT-CLAIM-LIST
    title: Reimbursement Claim
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
               var bireporturl = $('#P660_BIREPORTURL').val()
              var reportName = 'IRONMART/REPORT/ReimbursementClaim.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '&P_TNO=' + $('#P660_TNO').val() 
                  ;
            
             
                    var reportURL = bireporturl+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P660_BIREPORTURL').val()
              var reportName =  'ReimbursementClaim.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '"_paramsP_TNO":"' + $('#P660_TNO').val() 
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            ```
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 30
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       EXPENSEDATE,
                       ACCOUNTCODE,
                       MODEOFTRAVELCODE,
                       CATEGORYCODE,
                       CLASSOFCITYCODE,
                       MEASURINGUNITCODE,
                       QUANTITY,
                       RATE,
                       AMOUNT,
                       EXPENSEDETAIL,
                       BILLSTATUSTYPECODE,
                       REMARK,
                       ATTACHMENTBLOB,
                       FILENAME,
                       POLICYRATE,
                       POLICYAMOUNT,
                       APPROVEDAMOUNT,
                       abs(nvl(RATE,0)-nvl(POLICYRATE,0)) as DiffRate,
                       abs(nvl(AMOUNT,0)-nvl(POLICYAMOUNT,0)) as DiffAmount,
                      -- 'Upload/DnLoad' as Attachment
                      '<a href="' || APEX_PAGE.GET_URL(
                    p_page => '63',
                    p_items => 'P63_MODULETNO,P63_MODULESNO',
                    p_values => to_char(a.tno) || ',' || to_char(a.sno)
                ) || '"><span aria-label="Action"><span class="fa-plus-square fa-flip-vertical"  aria-hidden="true" title="Action"></span</span></a>' as attachment
                  from TOUREXPENSEDETAIL a
                  where tno = :P660_TNO
                ```
            pageItemsToSubmit: P660_TNO
        }
        layout {
            sequence: 20
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 27168787793681215
        }

