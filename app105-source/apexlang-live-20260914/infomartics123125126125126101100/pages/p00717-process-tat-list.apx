page 717 (
    name: Process TAT List
    alias: PROCESS-TAT-LIST
    title: Process TAT List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            #abc .t-fht-thead{
            overflow: auto !important;
            }
            
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region process-tat-master (
        name: Process TAT Master
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       PROCESSTATCODE,
                       PROCESSTATNAME,
                       PROCESSROUTINGTNO,
                       EFFECTIVEFROMDATE,
                       REMARK,
                       CREATOR,
                       CREATIONTIME
                  from PROCESSTAT
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: abc
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 718
                items: {
                    P718_TNO: #TNO#
                }
                clearCache: 718
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 716613971187569546
        }

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 370
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: BU
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 300
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Y
            }
        )

        column EFFECTIVEFROMDATE (
            type: plainText
            heading {
                heading: Effective From Date
            }
            layout {
                sequence: 340
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: BT
            }
        )

        column PROCESSROUTINGTNO (
            type: plainText
            heading {
                heading: Process Routing Tno
                alignment: end
            }
            layout {
                sequence: 330
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: BV
            }
        )

        column PROCESSTATCODE (
            type: plainText
            heading {
                heading: Process TAT Code
            }
            layout {
                sequence: 310
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BR
            }
        )

        column PROCESSTATNAME (
            type: plainText
            heading {
                heading: Process TAT Name
            }
            layout {
                sequence: 320
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: BS
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 350
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 170
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Location Master
        }

        savedReport 153825 (
            visibility: primaryDefault
            view {
                rowsPerPage: 100000
            }

            displayColumn CREATIONTIME (
                sequence: 4
            )

            displayColumn CREATOR (
                sequence: 5
            )

            displayColumn PROCESSROUTINGTNO (
                sequence: 3
            )

            displayColumn PROCESSTATCODE (
                sequence: 1
            )

            displayColumn PROCESSTATNAME (
                sequence: 2
            )

            displayColumn REMARK (
                sequence: 6
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @process-tat-master
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 718
                clearCache: 718
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @process-tat-master
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction ir-pagination (
        name: IR_Pagination
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

