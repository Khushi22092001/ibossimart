page 288 (
    name: Outward Freight Rate Approval
    alias: OUTWARD-FREIGHT-RATE-APPROVAL
    title: Outward Freight Rate Approval
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideShowIconsMath
                is-collapsed
                t-Region--accent15
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region outward-freight-rate-approval (
        name: Outward Freight Rate Approval
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select NVL(getdocumentstatuscode(GetModuleCodeForPageNo(:APP_PAGE_ID),A.TNO),'STATUS') AS Status ,
                a.TNO,
                       a.COMPANYCODE,
                       a.FINANCIALYEARCODE,
                       a.LOCATIONCODE,
                       a.DOCTYPECODE,
                       a.OUTWARDFRANO,
                       a.OUTWARDFRADATE,
                       a.APPROVEDFREIGHTRATE,
                       a.SALESORDERTNO,
                       a.APPROVEDQUANTITY1,
                       a.APPROVEDREFERENCENO,
                       a.APPROVEDREFERENCEDATE,
                       a.REMARK,
                       a.CREATOR,
                       a.CREATIONTIME,
                       a.PREVIOUSOUTWARDFRATNO,
                       a.QUANTITY1,
                       a.PREVIOUSBALANCEQUANTITY1,
                       b.salesorderno
                  from OUTWARDFRA a , SALESORDER B
                  where a.salesordertno = b.tno(+)
                ```
            pageItemsToSubmit: [
                P288_COMPANY
                P288_LOCATION
                P288_DEPARTMENT
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 289
                items: {
                    P289_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 269772698602577551
        }

        column APPROVEDFREIGHTRATE (
            type: plainText
            heading {
                heading: Approvedfreightrate
                alignment: end
            }
            layout {
                sequence: 83
