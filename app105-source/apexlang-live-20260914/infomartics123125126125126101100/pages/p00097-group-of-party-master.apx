    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       SERIALNO,
                       PARTYCODE,
                       REMARK
                  from GROUPOFPARTYDETAIL
                  WHERE TNO = :P97_TNO
                ```
            pageItemsToSubmit: P97_TNO
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 151876580925981435
        }

        savedReport 1531622 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TNO
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @SNO
                layout {
                    show: false
                    sequence: 3
                }
            )

            displayColumn (
                column: @SERIALNO
                layout {
                    show: false
                    sequence: 4
                }
            )

            displayColumn (
                column: @PARTYCODE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ROWID
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column PARTYCODE (
            type: popupLov
            heading {
                heading: Party
            }
            settings {
                fetchOnSearch: true
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    SELECT PARTYNAME , PARTYCODE FROM PARTY
                    where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
                    AND partytypecode = 'SUPPLIER'
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: PARTYCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column REMARK (
            type: textField
            heading {
                heading: Remark
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 1000
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column ROWID (
            type: hidden
            layout {
