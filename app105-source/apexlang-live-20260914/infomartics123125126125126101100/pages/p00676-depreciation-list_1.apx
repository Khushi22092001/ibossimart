page 676 (
    name: Depreciation List
    alias: DEPRECIATION-LIST
    title: Depreciation List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 0.90rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region depreciation-list (
        name: Depreciation List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       DEPRECIATIONNO,
                       DEPRECIATIONDATE,
                       TILLDATE,
                       ASSETWDV,
                       DEPRECIATIONAMOUNT,
                       NARRATION,
                       REMARK,
                       CREATIONTIME,
                       CREATOR
                  from DEPRECIATION
                  where DEPRECIATIONDATE  between :P676_FROMDATE and :P676_TODATE
                  and ( :P676_LOCATION IS NULL OR instr(':'||:P676_LOCATION||':',':'||LOCATIONCODE||':') > 0 )
                and ( :P676_DOCTYPE IS NULL OR instr(':'||:P676_DOCTYPE||':',':'||DOCTYPECODE||':') > 0 )
                and ( :P676_COMPANY IS NULL OR instr(':'||:P676_COMPANY||':',':'||COMPANYCODE||':') > 0 )
                
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 677
                items: {
                    P677_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 33538284245319093
        }

