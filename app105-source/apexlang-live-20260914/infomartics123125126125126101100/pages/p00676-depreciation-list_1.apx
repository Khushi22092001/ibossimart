    region filter (
        name: Filter
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
    )

    pageItem P676_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @filter
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P676_COMPANY (
        type: plugin/pretiusApexEnhancedLovItem
        label {
            label: Company
            alignment: left
        }
        settings {
            generalSettings: [
                autocomplete
                popupReport
                multipleSelection
            ]
            autocompleteSettings: rapidSelection
            popupSettings: [
                clickingOnRowSelectsIt
                resizable
                draggable
                closeOnEscape
                rowsPerPage
                searchInAllColumns
            ]
            reportBasicConfiguration: [
                displayDisplayColumn
                displayReturnColumn
            ]
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      c.CompanyName d,
                      a.CompanyCode r
                From  ModulePrivilege a, BossUser bu, Company c
                Where a.ModuleCode = GetModuleCodeForPageNo(:APP_PAGE_ID)
                  and a.viewprivilege = 'YES'
                  and a.BossUserCode = bu.BossUserCode
                  and a.CompanyCode = c.CompanyCode
                  and bu.BossUserName =  '&APP_USER.'
                Order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
    )

    pageItem P676_DOCTYPE (
        type: popupLov
        label {
            label: Doctype
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct
                      dt.DocTypeName d,
                      dt.DocTypeCode r
                From  ModulePrivilege a, ModulePrivilegeDocType b, DocType dt, BossUser bu, ModuleDocType md, ModuleDocTypeDetail mdd
                Where a.TNo = b.TNo(+)
                  and (b.DocTypeCode = dt.DocTypeCode or b.DocTypeCode is null)
                  and a.ModuleCode = md.ModuleCode
                  and md.TNo = mdd.TNo
                  and mdd.DocTypeCode = dt.DocTypeCode
                  and a.ModuleCode = GetModuleCodeForPageNo(:APP_PAGE_ID)
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                  and instr(':'||:P676_COMPANY||':',':'||a.CompanyCode||':') > 0
                Order by 1
                ;
                ```
            nullDisplayValue: -Select-
        }
        cascadingLov {
            parentItems: P676_COMPANY
        }
        layout {
            sequence: 50
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P676_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select sysdate-7 from dual
        }
    )

    pageItem P676_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select distinct
                      l.LocationName d,
                      l.LocationCode r
                From  ModulePrivilege a, ModulePrivilegeLocation b, Location l, BossUser bu, MODULELOCATION ML, MODULELOCATIONDETAIL MD
                Where a.TNo = b.TNo(+)
                  AND A.MODULECODE = ML.MODULECODE
                  AND ML.TNO = MD.TNO
                  AND (B.LOCATIONCODE = L.LOCATIONCODE OR B.LOCATIONCODE IS NULL)
                  and (MD.LocationCode = l.LocationCode )
                  and a.ModuleCode = GetModuleCodeForPageNo(:APP_PAGE_ID)
                  and a.BossUserCode = bu.BossUserCode
                  and bu.BossUserName =  '&APP_USER.'
                 and instr(':'||:P676_COMPANY||':',':'||a.CompanyCode||':') > 0
                Order By 1
                ;
                
                ```
            nullDisplayValue: -Select-
        }
        cascadingLov {
            parentItems: P676_COMPANY
        }
        layout {
            sequence: 40
            region: @filter
            slot: regionBody
            alignment: left
            columnSpan: 4
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
    )

    pageItem P676_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @/title
            slot: regionBody
        }
    )

    pageItem P676_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @filter
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select sysdate from dual
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @depreciation-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 677
                clearCache: 677
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @depreciation-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button refresh (
        buttonName: Refresh
        label: Refresh
        layout {
            sequence: 70
            region: @filter
            slot: regionBody
            column: 12
            columnSpan: 1
        }
        appearance {
