    region my-photos (
        name: My Photos
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select photos.seq_id,
                       photos.seq_id as view_photo
                from apex_collections photos
                where photos.collection_name = 'PHOTOS'
                ```
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
