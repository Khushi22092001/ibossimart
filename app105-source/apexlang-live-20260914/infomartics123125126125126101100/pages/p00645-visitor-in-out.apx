    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       ITEMDESCRIPTION,
                       INQUANTITY1,
                       MEASURINGUNITCODE1,
                       OUTQUANTITY1,
                       REMARK,
                       DOCNO,
                       PARTYCODE
                  from VISITORINOUTDETAIL
                  where tno = :P645_TNO
                ```
            pageItemsToSubmit: P645_TNO
        }
        layout {
            sequence: 50
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 24777609099840515
        }

