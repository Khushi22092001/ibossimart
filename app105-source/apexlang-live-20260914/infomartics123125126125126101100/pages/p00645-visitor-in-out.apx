                        :P645_VISITORINOUTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P645_LocationCode,
                                    :P645_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P645_VISITORINDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
