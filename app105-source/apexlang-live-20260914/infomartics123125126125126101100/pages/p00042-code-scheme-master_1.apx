page 42 (
    name: Code Scheme Master
    alias: CODE-SCHEME-MASTER
    title: Code Scheme Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region code-scheme-details (
        name: Code Scheme Details
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select MODULECODE,
                       CODESCHEME,
                       STARTNO,
                       LASTNO,
                       CREATOR,
                       CREATIONTIME,
                       NVL(getdocumentstatuscode('CODESCHEMEMASTER',''),'STATUS') AS Status
                  from CODESCHEMEMASTER
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region commonfields (
        name: CommonFields
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    pageItem P42_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            region: @commonfields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 91
        }
        sessionState {
            storage: request
        }
    )

    pageItem P42_CODESCHEME (
        type: textField
        label {
            label: Code Scheme
            alignment: left
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 20
            region: @code-scheme-details
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @code-scheme-details
            column: CODESCHEME
            dataType: varchar2
        }
    )

    pageItem P42_CREATIONTIME (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @code-scheme-details
            slot: regionBody
        }
        appearance {
            formatMask: DD-MM-YYYY HH24:MI:SS
        }
        source {
            formRegion: @code-scheme-details
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MM-YYYY HH24:MI:SS') from dual
        }
    )

    pageItem P42_CREATOR (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @code-scheme-details
            slot: regionBody
        }
        source {
            formRegion: @code-scheme-details
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: item
            item: GLOBAL_LOGINNAME
        }
    )

    pageItem P42_FORMSTATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            region: @commonfields
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P42_LASTNO (
        type: numberField
        label {
            label: Last No
            alignment: left
        }
        layout {
            sequence: 40
            region: @code-scheme-details
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @code-scheme-details
            column: LASTNO
            dataType: number
        }
    )

    pageItem P42_MODULECODE (
        type: textField
        label {
            label: Module Code
            alignment: left
        }
        layout {
            sequence: 10
            region: @code-scheme-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @code-scheme-details
            column: MODULECODE
            dataType: varchar2
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P42_MODULEFLOW (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 60
            region: @commonfields
            slot: regionBody
        }
        default {
            type: static
            staticValue: NO
        }
    )

    pageItem P42_ONTHETABLE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            region: @commonfields
            slot: regionBody
        }
        default {
            type: static
            staticValue: NO
        }
    )

    pageItem P42_PASSFAILREMARK (
        type: hidden
        layout {
            sequence: 20
            region: @commonfields
            slot: regionBody
        }
    )

    pageItem P42_STARTNO (
        type: numberField
        label {
            label: Start No
            alignment: left
        }
        layout {
            sequence: 30
            region: @code-scheme-details
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @code-scheme-details
            column: STARTNO
            dataType: number
        }
    )

    pageItem P42_STATUS (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 70
            region: @code-scheme-details
            slot: regionBody
        }
        source {
            formRegion: @code-scheme-details
            column: STATUS
            dataType: varchar2
            queryOnly: true
        }
        default {
            type: static
            staticValue: STATUS
        }
    )

    pageItem P42_STATUSRIGHT (
        type: hidden
        layout {
            sequence: 10
            region: @commonfields
            slot: regionBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select B.STATUSPRIVILEGE
                  From module a, moduleprivilege b, bossuser c
                 Where a.modulecode = b.modulecode
                   And b.bossusercode = c.bossusercode
                   And c.loginname = :GLOBAL_LOGINNAME
                   And A.ENTRYPAGENO = :APP_PAGE_ID
                   AND B.COMPANYCODE = :GLOBAL_COMPANYCODE
                ```
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 60
            region: @code-scheme-details
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 90
            region: @code-scheme-details
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P42_MODULECODE
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 70
            region: @code-scheme-details
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-trash-o
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P42_MODULECODE
        }
    )

    button fail (
        buttonName: Fail
        label: Fail
        layout {
            sequence: 20
            region: @code-scheme-details
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--pill
            ]
            icon: fa-thumbs-o-down
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 163
                clearCache: 163
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P42_MODULECODE
        }
    )

    button flow (
        buttonName: Flow
        label: FLow
        layout {
            sequence: 30
            region: @code-scheme-details
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
            icon: fa-workflow
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 162
                items: {
                    P162_TNO: &P42_TNO.
                }
                clearCache: 162
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P42_MODULECODE
        }
    )

    button pass (
        buttonName: Pass
        label: Pass
        layout {
            sequence: 10
            region: @code-scheme-details
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-thumbs-o-up
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 163
                clearCache: 163
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P42_MODULECODE
        }
    )

    button print (
        buttonName: Print
        label: Print
        layout {
            sequence: 50
            region: @code-scheme-details
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pill
            ]
            icon: fa-print
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P8_FORMSTATUS
            value: EDITRECORD
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 80
            region: @code-scheme-details
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--success
                t-Button--pill
            ]
            icon: fa-save-as
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P42_MODULECODE
        }
    )

    button status (
        buttonName: Status
        label: &P92_STATUS.
        layout {
            sequence: 40
            region: @code-scheme-details
            slot: top
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--pill
            ]
            icon: fa-comments-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 164
                clearCache: 164
            }
            warnOnUnsavedChanges: doNotCheck
        }
        advanced {
            htmlDomId: STATUS
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P42_MODULECODE
        }
    )

    dynamicAction check-module-code (
        name: Check Module code
        execution {
            sequence: 60
        }
        when {
            event: focusout
            selectionType: items
            items: P42_MODULECODE
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     if (Object.keys($v("P42_MODULECODE")).length===0 ) {
                        showError("Module Code Should Not Empty", 'P42_MODULECODE');
                    } else {
                        apex.message.clearErrors();
                    }
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 80
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 20
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'NO'
                    ```
            }
        )

        action native-disable-2 (
            action: disable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 60
            }
            serverSideCondition {
                type: item=value
                item: P42_STATUS
                value: ACTIVE
            }
        )

        action native-enable (
            action: enable
            affectedElements {
                selectionType: button
                button: @delete
            }
            execution {
                sequence: 10
            }
            serverSideCondition {
                type: rowsReturned
                sqlQuery:
                    ```sql
                    Select 1 From MODULEPRIVILEGE A
                     Where A.MODULECODE = GetModuleCodeForPageNo(:APP_PAGE_ID)
                       And a.bossusercode = :GLOBAL_BOSSUSERCODE
                       And a.companycode = :GLOBAL_COMPANYCODE
                       AND A.DELETEPRIVILEGE= 'YES'
                    ```
            }
        )

    )

    dynamicAction disable-print-button (
        name: Disable Print Button
