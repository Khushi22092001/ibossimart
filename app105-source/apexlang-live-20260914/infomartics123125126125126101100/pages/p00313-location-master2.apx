page 313 (
    name: location master
    alias: LOCATION-MASTER2
    title: location master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 30
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region location-master (
        name: location master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select LOCATIONCODE,
                       LOCATIONNAME,
                       LOCATIONSHORTNAME,
                       TNO,
                       REMARK,
                       DATECREATED,
                       DATEMODIFY,
                       PARENTCODE,
                       CREATOR,
                       ISDIVISION,
                       CREATIONTIME,
                       PARTYCODE,
                       DESTINATIONCODE,
                       TRACKINGREQUIRED,
                       LATITUDE,
                       LONGITUDE,
                       PETTYCASHACCOUNTCODE,
                       ZONECODE,
                       TRANSACTIONALCYCLECOUNT,
                       STORAGERESERVATIONREQUIRED,
                       LRENTRYITEMWISE,
                       FSABILLWITHCODE,
                       PREMISESCODE,
                       ISPREMISESOFMULTIPLEWAREHOUSE,
                       VEHICLEPLANNING,
                       PODPERCENTFORTRANSPORTERBILL,
                       OPERATIONBOSSUSERCODE,
                       TRANSPORTATIONBOSSUSERCODE,
                       LRENTRYSLIPPRINTGROUPWISE,
                       WAREHOUSEBOSSUSERCODE,
                       PRINTGATEPASSWITHDISPATCHSLIP,
                       OVERTIMEFORSANCTIONEDDAY,
                       GATEENTRYREQUIRED,
                       AVERAGEWEIGHTPERNOS,
                       STATECODE,
                       SHIPMENTDOCNOINDISPATCHSLIP,
                       PAIDBILTYCLAIMIMMEDIATE,
                       CITYCODE,
                       ASSETACCOUNTCODE,
                       BRANCHACCOUNTCODE,
                       COMPANYCODE,
                       ISITBRANCH,
                       FRANCHISEID,
                       FRANCHISENAME,
                       ACCOUNTCODE,
                       STATUS,
                       ADDRESS1,
                       ADDRESS2,
                       ADDRESS3,
                       BRANCHTYPECODE,
                       PINCODE,
                       GSTINNO,
                       MOBILENO,
                       EMAILID
                  from LOCATION
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P313_ACCOUNTCODE (
        type: textField
        label {
            label: Accountcode
            alignment: right
        }
        settings {
            trimSpaces: none
        }
        layout {
            sequence: 450
            region: @location-master
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
