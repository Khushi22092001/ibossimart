    dynamicAction enable-disable-pass-fail-flow (
        name: Enable Disable Pass/Fail/Flow
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
                sequence: 10
            }
            clientSideCondition {
                type: item=value
                item: P313_ONTHETABLE
                value: NO
            }
        )

        action native-disable-2 (
            action: disable
            execution {
                sequence: 20
            }
            clientSideCondition {
                type: item=value
                item: P313_ONTHETABLE
                value: NO
            }
        )

        action native-disable-3 (
            action: disable
            execution {
                sequence: 30
            }
            clientSideCondition {
                type: item=value
                item: P313_MODULEFLOW
                value: NO
            }
        )

    )

    dynamicAction pass (
        name: Pass
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @pass
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    DECLARE
                      tModuleCode  Varchar2(30);
                      TMP          vARCHAR2(100) := :P313_PURCHASEORDERNO;
                    cursor cPassFail is
                    		select
                    				a.TNo
                    		from PassFail a, ModuleFlow b, ModuleFlowUser c, BossUser d
                    		where a.ModuleFlowTNo = b.TNo
                    				and b.TNo = c.TNo
                    				and a.BossUserCode = c.BossUserCode
                    				and c.BossUserCode = d.BossUserCode
                    				and a.ModuleTNo = :P313_TNO --':P'||:APP_PAGE_ID||'_TNo'
                    				--and d.LoginName = User
                                    AND D.BOSSUSERNAME = :APP_USER
                    				and a.isPass is null
                    				and a.IsFail is null
                    				and a.IsForwarded is null
                    				and a.IsRebounded is null										
                    ;
                    vPassFail cPassFail%rowtype;
                    BEGIN
                    
                        /*select
                        	d.ModuleCode, ':P'||:APP_PAGE_ID||'_'||labelcolumnname 
                                    into tModuleCode,tmp
                        from Location a, ModuleLocationDetail b , ModuleLocation c, Module d 
                        where a.LocationCode = b.LocationCode
                        	and b.tno = c.tno
                        	and c.ModuleCode = d.ModuleCode --'DELIVERYCHALLANRETURN'
                        	and c.CompanyCode = :global_CompanyCode
                            and d.EntryPageNo = :APP_PAGE_ID
                            ;
                        */
                    			
                    	open cPassFail;
                    	fetch cPassFail into vPassFail;
                    	if cPassFail%FOUND then
                    			
                    		
                    			update PassFail a
                    			set a.IsPass = 'YES',
                    				a.remark = :P313_PASSFAILREMARK
                    			where a.TNo = vPassFail.TNo;
                    			COMMIT;
                    			close cPassFail;
                    			
                    			
                    			SendPassFailForward(getModuleCodeForPageNo(:APP_PAGE_ID), :P313_TNO , TMP, :global_CompanyCode );
                    
                        end if;
                    END;
                    ```
                itemsToSubmit: [
                    P313_TNO
                    P313_COMPANYCODE
                    P313_PURCHASEORDERNO
                    P313_PASSFAILREMARK
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: location.reload()
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action native-refresh (
            action: refresh
            execution {
                sequence: 70
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                type: dialogReturnItem
                returnItem: P163_REMARK
            }
            affectedElements {
                selectionType: items
                items: P313_PASSFAILREMARK
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action update-documentstatus-of-detail (
            name: update documentstatus of detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    update indentdetail a set documentstatuscode = getdocumentstatuscode('INDENT',:P313_TNO)
                    WHERE TNO = :P313_TNO
                    ;
                    ```
                itemsToSubmit: P313_TNO
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P313_Tno is null then
                        Select GlobalTno.NextVal into :P313_Tno From Dual;
                     end if;
                    ----
                    if :P313_INDENTNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P313_LocationCode,
                					:P313_DocTypeCode,
                					NULL,
                					TO_DATE(:P313_INDENTDATE, 'DD-MM-RRRR')
                				);
                        :P313_INDENTNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P313_LocationCode,
                                    :P313_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P313_INDENTDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 24242508933946414
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P313_TNO is null then
                    :P313_TNO := GlobalTNo.nextval;
                    :P313_FORMSTATUS := 'NEWRECORD';
                else
                    :P313_FORMSTATUS := 'EDITRECORD';
                End if;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 24245273467984973
        }
    )

