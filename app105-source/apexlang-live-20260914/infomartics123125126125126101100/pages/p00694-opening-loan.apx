    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P694_Tno is null then
                        Select GlobalTno.NextVal into :P694_Tno From Dual;
                     end if;
                    ----
                    if :P694_OPENINGLOANNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P694_LocationCode,
                					:P694_DocTypeCode,
                					NULL,
                					TO_DATE(:P694_OPENINGLOANDATE, 'DD-MM-RRRR')
                				);
                        :P694_OPENINGLOANNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P694_LocationCode,
                                    :P694_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P694_OPENINGLOANDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 49173272909392354
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P694_TNO is null then
                    :P694_TNO := GlobalTNo.nextval;
                    :P694_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P694_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P694_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P694_TNO), 'Status');
                
                begin
                select TNO into :P694_VOUCHERTNO from voucher 
                        where moduletno = :P694_TNO
                          AND MODULECODE='SALARYVOUCHER';
                exception when others then 
                    null;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 49146082825339238
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P694_MODULEFLOW := 'YES';
                   else
                       :P694_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P694_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P694_ONTHETABLE := 'YES' ;
                   else
                       :P694_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 49146381747340373
        }
    )

