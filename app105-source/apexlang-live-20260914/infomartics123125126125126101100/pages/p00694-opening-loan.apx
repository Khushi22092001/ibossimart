    dynamicAction delete-detail-data (
        name: Delete detail data
        execution {
            sequence: 120
        }
        when {
            event: ready
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from salaryvoucherdetail a
                        where not exists (
                            select 1 from salaryvoucher  aa  
                            where aa.tno = a.tno
                        );
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction delete-unsaved-data (
        name: Delete unsaved data
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from salaryvoucherdetail a
                        where not exists (
                            select 1 from salaryvoucher  aa  
                            where aa.tno = a.tno
                        );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction disable-delete-update-if-status-is-active (
        name: DISABLE DELETE UPDATE IF STATUS IS ACTIVE
        execution {
            sequence: 70
        }
        when {
            event: ready
        }

        action native-disable (
            action: disable
            execution {
