    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 100
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--warning
                t-Button--pill
            ]
