    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P649_Tno is null then
                        Select GlobalTno.NextVal into :P649_Tno From Dual;
                     end if;
                    ----
                    if :P649_CONVEYANCESCHEMENO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P649_LocationCode,
                					:P649_DocTypeCode,
                					NULL,
                					TO_DATE(:P649_CONVEYANCESCHEMEDATE, 'DD-MM-RRRR')
                				);
                        :P649_CONVEYANCESCHEMENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P649_LocationCode,
                                    :P649_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P649_CONVEYANCESCHEMEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 25878925035100613
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P649_TNO is null then
                    :P649_TNO := GlobalTNo.nextval;
                    :P649_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P649_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P649_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P649_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25847048110052754
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P649_MODULEFLOW := 'YES';
                   else
                       :P649_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P649_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P649_ONTHETABLE := 'YES' ;
                   else
                       :P649_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 25847342936054743
        }
    )

