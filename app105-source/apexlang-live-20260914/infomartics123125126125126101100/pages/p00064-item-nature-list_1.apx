                heading: Item Nature Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column LASTNO (
            type: plainText
            heading {
                heading: Last No
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: Q
            }
        )

        column ORDERINGPOLICY (
            type: plainText
            heading {
                heading: Ordering Policy
