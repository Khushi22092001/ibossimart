page 64 (
    name: Item Nature List
    alias: ITEM-NATURE-LIST
    title: Item Nature List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region item-nature-list (
        name: Item Nature List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       A.ITEMNATURECODE,
                       A.ITEMNATURENAME,
                       A.REMARK,
                       A.STOCKACCOUNTCODE,
                       A.CONSUMPTIONACCOUNTCODE,
                       A.CWIPACCOUNTCODE,
                       A.PROCUREMENTSTRATEGY,
                       A.ORDERINGPOLICY,
                       A.PURCHASEPRIFRENCELOCATIONCODE,
                       a.CODEPREFIX,
                       A.CODERANGEFROM,
                       A.CODERANGETO,
                       A.LASTNO,
                       to_char(A.CREATIONTIME,'DD-MM-YYYY HH24:MI:SS') CREATIONTIME,
                       A.CREATOR
                  from ITEMNATURE A
                  Order By A.TNO DESC
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 65
                items: {
                    P65_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 142384544751825530
        }

        column CODEPREFIX (
            type: plainText
            heading {
                heading: Codeprefix
                alignment: center
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column CODERANGEFROM (
            type: plainText
            heading {
                heading: Code Range From
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: O
            }
        )

        column CODERANGETO (
            type: plainText
            heading {
                heading: Code Range To
                alignment: center
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: P
            }
        )

        column CONSUMPTIONACCOUNTCODE (
            type: plainText
            heading {
                heading: Consumption Account Code
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column CWIPACCOUNTCODE (
            type: plainText
            heading {
                heading: CWIP Account Code
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column ITEMNATURECODE (
            type: plainText
            heading {
                heading: Item Nature Code
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column ITEMNATURENAME (
            type: plainText
