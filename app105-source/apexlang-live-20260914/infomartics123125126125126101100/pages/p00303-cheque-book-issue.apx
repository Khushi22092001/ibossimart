                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column CHEQUENO (
            type: textField
            heading {
                heading: Chequeno
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: CHEQUENO
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
