    process set-doc-no (
        name: Set Doc No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    --tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tModuleCode varchar2(30) := 'CHEQUEBOOKISSUE';
                    tmp         number ;
                begin
                     if :P303_TNO is null then
                        Select GlobalTno.NextVal into :P303_TNO From Dual;
                     end if;
                    ----
                    if :P303_CHEQUEBOOKISSUENO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P303_LOCATIONCODE,
                					:P303_DOCTYPECODE,
                					NULL,
                					TO_DATE(:P303_CHEQUEBOOKISSUEDATE, 'DD-MM-RRRR')
                				);
                        :P303_CHEQUEBOOKISSUENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P303_LOCATIONCODE,
                                    :P303_DOCTYPECODE,
                                    NULL,
                                    TO_DATE(:P303_CHEQUEBOOKISSUEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
