    pageItem P303_BOOKNO (
        type: popupLov
        label {
            label: Book No
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                	distinct
                	
                	a.BookNo,
                    a.Tno
                from ChequeReceipt a, ChequeReceiptDetail b
                where a.TNO = b.TNO
                	and a.BankCode = :P303_BankCode
                	and a.ChequeReceiptDate <= trunc(sysdate)
                	and a.CompanyCode = :global_CompanyCode
                	and b.Status is null	
                    and nvl(b.IsLocked,'NO') = 'NO'
                /*--- Remarked on dt.16-03-2024	 because use is not understand
                   and exists(
                		select
                			aa.TNo
                		from BossUser aa
                		where aa.BossUserCode = b.InHandOfBossuserCode
                			and aa.LoginName = :global_loginname
                	)
                */
                	and not exists(
                		select
                			aa.TNO
                		from LoanSanction aa
                		where aa.CreditAccountCode = :P303_BankCode
                			and nvl(aa.MoneyTransferModeCode, 'fd23S') in ('CH', 'CHEQUE')
                			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
                			and aa.MONEYTRANSFERREFERENCENO  is not null
                	)
                	and not exists(
                		select
                			aa.TNO
                		from PaymentAdvice aa
                		where aa.AccountCode = :P303_BankCode
                			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
                			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
                			and aa.MONEYTRANSFERREFERENCENO  is not null
                	)		
                	/*and not exists(
                		select
                			aa.TNO
                		from DutyAndTaxChallan aa
                		where aa.AccountCode = :P303_BankCode
                			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
                			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
                			and aa.MONEYTRANSFERREFERENCENO  is not null
                	)	*/	
                	and not exists(
                		select
                			aa.TNO
                		from Challan aa
                		where aa.AccountCode = :P303_BankCode
                			and aa.MoneyTransferModeCode in ('CH', 'CHEQUE')
                			and aa.MONEYTRANSFERREFERENCENO = b.ChequeNO
                			and aa.MONEYTRANSFERREFERENCENO  is not null
                	)			
                order by 1
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P303_BANKCODE
            itemsToSubmit: P303_BANKCODE
            parentRequired: false
        }
        layout {
            sequence: 100
            region: @cheque-book-issue
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @cheque-book-issue
            column: BOOKNO
            dataType: varchar2
        }
    )

