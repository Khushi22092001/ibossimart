    process update-in-cheque-receipt-detail (
        name: update in cheque receipt detail
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for i in (
                    select chequeno from CHEQUEBOOKISSUEDETAIL where tno = :P303_TNO
                )
                loop
                    update CHEQUERECEIPTDETAIL set INHANDOFBOSSUSERCODE = :P303_BOSSUSERCODE , 
                                                    CHEQUEISSUEDATE = sysdate
                    where chequeno = i.chequeno;
                end loop;
