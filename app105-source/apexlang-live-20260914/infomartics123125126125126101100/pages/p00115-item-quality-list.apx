        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Item Quality List
        }

        savedReport 1485564 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BONUSONBILL (
                sequence: 14
            )

            displayColumn CREATIONTIME (
                sequence: 19
