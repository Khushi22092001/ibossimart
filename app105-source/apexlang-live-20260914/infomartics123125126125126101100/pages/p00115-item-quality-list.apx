    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @item-quality-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 116
                clearCache: 116
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @item-quality-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-quality-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @item-quality-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @item-quality-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

