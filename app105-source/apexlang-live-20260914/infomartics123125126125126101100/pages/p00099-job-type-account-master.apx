page 99 (
    name: Service Type Account Master
    alias: JOB-TYPE-ACCOUNT-MASTER
    title: Service Type Account Master
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region fields (
        name: Fields
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
    )

    region service-type-account-master (
        name: Service Type Account Master
        type: form
        source {
            location: localDatabase
            tableName: JOBTYPEACCOUNT
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: [
                #DEFAULT#
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P99_ACCOUNTCODE (
        type: popupLov
        label {
            label: "Account "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT PARTYNAME D, PARTYCODE R
                FROM PARTY WHERE PARTYTYPECODE='ACCOUNT'
                ```
        }
        layout {
            sequence: 90
            region: @service-type-account-master
            slot: regionBody
            alignment: left
            columnSpan: 6
            labelColumnSpan: 2
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @service-type-account-master
            column: ACCOUNTCODE
            dataType: varchar2
        }
    )

    pageItem P99_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P99_COMPANYCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            region: @service-type-account-master
            slot: regionBody
        }
        source {
            formRegion: @service-type-account-master
            column: COMPANYCODE
            dataType: varchar2
        }
        default {
            type: item
            item: GLOBAL_COMPANYCODE
        }
    )

    pageItem P99_DOCTYPECODE (
        type: popupLov
        label {
            label: "Doc Type "
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                        A.DOCTYPENAME, 
                        A.DOCTYPECODE 
                        FROM DOCTYPE A 
                        ORDER BY A.TNO DESC
                ```
        }
        layout {
            sequence: 70
            region: @service-type-account-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @service-type-account-master
            column: DOCTYPECODE
            dataType: varchar2
        }
    )

    pageItem P99_FORMSTATUS (
