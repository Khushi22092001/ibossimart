            formRegion: @service-type-account-master
            column: JOBTYPEACCOUNTCODE
            dataType: varchar2
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'JOBTYPEACCOUNT'
                       and a.CodeScheme = 'AUTO'
                ```
        }
    )

