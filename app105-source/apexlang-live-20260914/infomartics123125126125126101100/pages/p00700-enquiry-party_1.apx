page 700 (
    name: Enquiry Party
    alias: ENQUIRY-PARTY
    title: Enquiry Party
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 450
        height: 200
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    pageItem P700_PARTYFORENQUIRY (
        type: popupLov
        label {
            label: Party For Enquiry
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select partyname,partycode from party where partytypecode='SUPPLIER'
                and getdocumentstatuscode('PARTY',TNO)='ACTIVE'
                ```
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
            labelColumnSpan: 2
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 20
            region: @new
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process new (
        name: New
        type: closeDialog
        settings {
            itemsToReturn: P700_PARTYFORENQUIRY
            showSuccessMessages: false
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 59747162858854076
        }
    )

)

