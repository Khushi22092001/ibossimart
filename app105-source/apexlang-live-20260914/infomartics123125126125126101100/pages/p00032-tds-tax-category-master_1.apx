                    width: 91.625
                    sequence: 8
                }
            )

            displayColumn (
                column: @SURCHARGEPERCENTWITHOUTPAN
                layout {
                    width: 87.625
                    sequence: 12
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    sequence: 20
                }
            )

            displayColumn (
                column: @TOTALTDSPERCENTWITHPAN
                layout {
                    width: 84.6406
                    sequence: 9
                }
            )

            displayColumn (
                column: @TOTALTDSPERCENTWITHOUTPAN
                layout {
                    width: 84.6562
                    sequence: 13
                }
            )

            displayColumn (
                column: @TRANSACTIONTHRESHOLD
