            column: TDSNATURECODE
            dataType: varchar2
        }
    )

    pageItem P32_TDSTAXCATEGORYCODE (
        type: textField
        label {
            label: TDS Tax Category Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @tds-tax-category-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @tds-tax-category-master
            column: TDSTAXCATEGORYCODE
            dataType: varchar2
        }
        readOnly {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1
                      from codeschememaster a
                     where a.modulecode = 'TDSTAXCATEGORY'
                       and a.CodeScheme = 'AUTO'
                ```
        }
    )

    pageItem P32_TDSTAXCATEGORYNAME (
        type: textField
        label {
            label: TDS Tax Category Name
            alignment: left
        }
