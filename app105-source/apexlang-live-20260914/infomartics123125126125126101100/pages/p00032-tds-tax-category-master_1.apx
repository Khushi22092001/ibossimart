                    width: 152
                    sequence: 4
                }
            )

            displayColumn (
                column: @THRESHOLD
                layout {
                    show: false
                    sequence: 5
                }
            )

            displayColumn (
                column: @TDSPERCENTWITHPAN
                layout {
                    width: 54.625
                    sequence: 6
                }
            )

            displayColumn (
                column: @TDSPERCENTWITHOUTPAN
                layout {
                    width: 53.625
                    sequence: 10
                }
            )

            displayColumn (
                column: @CESSPERCENTWITHPAN
                layout {
                    width: 52.625
                    sequence: 7
                }
            )

            displayColumn (
                column: @CESSPERCENTWITHOUTPAN
                layout {
                    width: 56.625
                    sequence: 11
                }
            )

            displayColumn (
                column: @SURCHARGEPERCENTWITHPAN
