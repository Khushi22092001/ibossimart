        }
        pageHeader {
            pageHeaderText: Detail
        }
    )

    region new (
        name: New
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
    )

    region tds-tax-category-master (
        name: TDS Tax Category Master
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       TDSTAXCATEGORYCODE,
                       TDSTAXCATEGORYNAME,
                       TDSNATURECODE,
                       TAXSECTIONCODE,
                       EFFECTIVEFROM,
                       REMARK,
                       CREATOR,
                       CREATIONTIME,
                       YEARSWITHOUTRETURN
                  from TDSTAXCATEGORY
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P32_CALLEDFROMPAGE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 160
            region: @common-fields
            slot: regionBody
        }
        default {
            type: static
            staticValue: 2
        }
    )

    pageItem P32_CREATIONTIME (
        type: hidden
        layout {
            sequence: 100
            region: @tds-tax-category-master
            slot: regionBody
        }
        source {
            formRegion: @tds-tax-category-master
            column: CREATIONTIME
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select to_char(sysdate,'DD-MM-YYYY HH24:MI:SS') from dual
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P32_TDSTAXCATEGORYCODE
        }
    )

    pageItem P32_CREATOR (
        type: hidden
        layout {
            sequence: 90
            region: @tds-tax-category-master
            slot: regionBody
        }
        source {
            formRegion: @tds-tax-category-master
            column: CREATOR
            dataType: varchar2
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select :GLOBAL_LOGINNAME from Dual
        }
    )

    pageItem P32_EFFECTIVEFROM (
        type: datePicker
