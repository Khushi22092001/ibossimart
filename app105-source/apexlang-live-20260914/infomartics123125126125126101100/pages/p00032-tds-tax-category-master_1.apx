                    show: false
                    sequence: 14
                }
            )

            displayColumn (
                column: @DEDUCTIONSTARTABOVEAMOUNT
                layout {
                    width: 143
                    sequence: 19
                }
            )

            displayColumn (
                column: @TDSPERCENTWITHOUTRETURN
