            valueProtected: false
        }
        layout {
            sequence: 220
            region: @common-fields
            slot: regionBody
        }
        default {
            type: expression
            plsqlExpression: nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P32_TNO), 'Status')
        }
        sessionState {
            storage: request
        }
    )

    pageItem P32_STATUSRIGHT (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 170
            region: @common-fields
            slot: regionBody
        }
    )

    pageItem P32_TAXSECTIONCODE (
        type: popupLov
        label {
            label: Tax Section Code
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT 
                    A.TAXSECTIONNAME, 
                    A.TAXSECTIONCODE 
                    FROM TAXSECTION A 
                    ORDER BY A.TAXSECTIONCODE DESC
                ```
        }
        layout {
            sequence: 50
            region: @tds-tax-category-master
            slot: regionBody
            alignment: left
            startNewRow: false
            labelColumnSpan: 3
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @tds-tax-category-master
            column: TAXSECTIONCODE
            dataType: varchar2
        }
    )

    pageItem P32_TDSNATURECODE (
        type: popupLov
        label {
            label: TDS Nature Code
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select 
                    A.TDSNATURENAME,
                    A.TDSNATURECODE 
                    from TDSNATURE A 
                    ORDER BY A.TDSNATURECODE DESC
                ```
        }
        layout {
            sequence: 40
            region: @tds-tax-category-master
            slot: regionBody
            alignment: left
            labelColumnSpan: 3
        }
        appearance {
