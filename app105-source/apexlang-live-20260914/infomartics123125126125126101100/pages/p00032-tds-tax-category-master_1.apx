                    sequence: 17
                }
            )

            displayColumn (
                column: @TOTALTDSPERCENTWITHOUTRETURN
                layout {
                    width: 85.6562
                    sequence: 18
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    sequence: 1
                }
            )

        )

        columnGroup with-pan (
            heading: With PAN
        )

        columnGroup without-pan (
            heading: Without PAN
        )

        columnGroup without-return (
            heading: Without Return
        )

        column APEX$ROW_ACTION (
