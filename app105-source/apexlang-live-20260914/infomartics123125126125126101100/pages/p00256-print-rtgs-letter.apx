    }
    security {
        formAutoComplete: false
    }

    pageItem P256_BIREPORTURL (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 75
            slot: contentBody
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select getmyparametervalue('BIREPORTURL') FROM dual
        }
    )

    pageItem P256_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 65
            slot: contentBody
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 55
            slot: contentBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--small
                t-Button--warning
                t-Button--iconLeft
            ]
            icon: fa-arrow-circle-o-left
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button chq-fundtransfer (
        buttonName: CHQ-FundTransfer
        label: CHQ-FundTransfer
        layout {
            sequence: 45
            slot: contentBody
            column: 5
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button chq-rtgs (
        buttonName: CHQ-RTGS
        label: CHQ-RTGS
        layout {
            sequence: 35
            slot: contentBody
            column: 5
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button fundtransfer (
        buttonName: FundTransfer
        label: Fund Transfer
        layout {
            sequence: 25
            slot: contentBody
            column: 5
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--pillEnd
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button partywise (
        buttonName: PartyWise
        label: Party Wise
        layout {
            sequence: 10
            slot: contentBody
            column: 5
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--pillStart
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button rtgsletter (
        buttonName: RTGSLetter
        label: RTGS Letter
        layout {
            sequence: 15
            slot: contentBody
            column: 5
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--pill
                t-Button--stretch
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction close (
        name: close
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction generate-pdf (
        name: Generate PDF
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @chq-rtgs
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: CHQRTGS();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @partywise
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: PDF_new();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-2 (
        name: New_1
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @rtgsletter
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: generatePDF_new();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-3 (
        name: New_2
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @fundtransfer
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: GPDF_new();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new-4 (
        name: New33
        execution {
            sequence: 60
        }
        when {
            event: click
            selectionType: button
            button: @chq-fundtransfer
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: CHQFUND();
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

