    process getdocno (
        name: getdocno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getmodulecodeforpageno(:APP_PAGE_ID);
                
                    tmp         number ;
                begin
                    select count(*) into tmp
                      from codeschememaster a
                     where a.modulecode = tModuleCode
                       and a.CodeScheme = 'AUTO'
                     ;
                     
                     if nvl(tmp,0) > 0 and :P716_PROCESSROUTINGCODE is null then
                            setCodeNext(tModuleCode);
                	  		:P716_PROCESSROUTINGCODE := getCode(tModuleCode) ;
                     end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 61251637746510490
        }
    )

    process getformstatus (
        name: GetFormStatus
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :P716_TNO is null then
                        :P716_FORMSTATUS := 'NEWRECORD';
                    else
                        :P716_FORMSTATUS := 'EDITRECORD';
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
