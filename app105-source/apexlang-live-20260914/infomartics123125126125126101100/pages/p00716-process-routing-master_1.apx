    process process-routing-detail-save-interactive-grid-data (
        name: Process Routing Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @process-routing-detail
        source {
            plsqlCode:
                ```plsql
                Begin
                     if :MODULECODE is not null then
                            case :APEX$ROW_STATUS
                                when 'C' then
                                    if :SNO IS NULL THEN
                                        select globaltno.nextval into :SNO from dual;
                                    end if;
                                    Insert Into PROCESSROUTINGDETAIL (   
                                        TNO,
                                        SNO,
                                        MODULECODE
                                    ) VALUES
                                    (
                                        :TNO,
                                        :SNO,
                                        :MODULECODE
                                    ) ;
                           
                                when 'U' then
                                    update PROCESSROUTINGDETAIL 
                                      set modulecode = :MODULECODE
                                    where tno = :TNO
                                      AND sno = :SNO
                                      ;
                            
                                when 'D' then
                                    Delete from PROCESSROUTINGDETAIL where tno = :TNO AND SNO = :SNO;
                                
                            END CASE;
                   end if;
                 end ;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 61244841939510484
        }
    )

