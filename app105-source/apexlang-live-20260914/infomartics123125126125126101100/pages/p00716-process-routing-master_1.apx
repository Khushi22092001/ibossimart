page 716 (
    name: Process Routing Master
    alias: PROCESS-ROUTING-MASTER
    title: Process Routing Master
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#myfunctions#MIN#.js
    }
    css {
        inline:
            ```css
            
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            
            .cc-object-style {
                width: 100%;
                height: 800px;
            }
            
            .cc-actions-column {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 10px;
            }
            
            .t-Button--noUI:hover {
                --a-button-type-shadow: none;
                --a-button-type-background-color: transparent;
                --a-button-type-border-color: transparent;
                --a-button-type-text-color: inherit;
                color: inherit;
                background-color: transparent;
                text-shadow: none;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region attachment (
        name: Attachment
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.TNO,
                       --A.SNO,
                       --DESCRIPTION,
                       B.PARTYATTRIBUTENAME,
                       A.ATTRIBUTEVALUE,
                       A.ATTACHMENTBLOB,
                       A.FILENAME,
                       A.ATTRIBUTECODE,
                       A.moduletno,
                       A.modulesno
                  from MODULEATTACHMENT A, PARTYATTRIBUTE B
                  Where A.ATTRIBUTECODE = PARTYATTRIBUTECODE
                    AND A.moduletno = :P716_TNO;
                ```
            pageItemsToSubmit: P716_TNO
        }
        layout {
            sequence: 50
            parentRegion: @process-routing
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: never
        }
        link {
            linkColumn: customTarget
            target: {
                page: 63
                items: {
                    P63_MODULESNO: #MODULESNO#
                    P63_MODULETNO: #MODULETNO##SNO#
                }
                clearCache: 63
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 1049818628104299112
        }

        column ATTACHMENTBLOB (
            type: downloadBlob
            heading {
                heading: Attachmentblob
            }
            layout {
                sequence: 150
            }
            blobAttributes {
                tableName: MODULEATTACHMENT
                blobColumn: ATTACHMENTBLOB
                primaryKeyColumn1: ROWID
                mimeTypeColumn: MIMETYPE
                filenameColumn: FILENAME
            }
            source {
                primaryKey: true
                dataType: OTHER
            }
            columnFilter {
                type: none
            }
            advanced {
                endUserAlias: R
            }
            enableUsersTo {
                sort: false
                filter: false
                highlight: false
                controlBreak: false
                aggregate: false
                compute: false
                chart: false
                groupBy: false
                pivot: false
            }
        )

        column ATTRIBUTECODE (
            type: plainText
            heading {
                heading: Attributecode
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

