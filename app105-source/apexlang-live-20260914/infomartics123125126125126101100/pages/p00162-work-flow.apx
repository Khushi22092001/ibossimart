page 162 (
    name: Work Flow
    alias: WORK-FLOW
    title: Work Flow
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 900
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region work-flow (
        name: Work Flow
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tokenno,
                       B.BOSSUSERNAME,
                       C.EMPLOYEENAME,
                       A.ISPASS,
                       A.ISFAIL,
                       A.ISREBOUNDED,
                       A.ISFORWARDED,
                       A.REMARK,
                       TO_CHAR(A.QUEUEDATE,'DD-MM-RRRR HH:MI AM') AS QUEUDATE,
                       TO_CHAR(A.PASSFAILDATE,'DD-MM-RRRR HH:MI AM') AS PASSFAILDATE
                  From passfail a, bossuser b, employee c
                 Where a.bossusercode = b.bossusercode
                   And b.employeecode = c.employeecode(+)
                   And a.moduletno = :P162_TNO
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        toolbar {
            show: false
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 420308433904014530
        }

        savedReport 410472 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @TOKENNO
                layout {
                    width: 86
                    sequence: 1
                }
            )

            displayColumn (
                column: @BOSSUSERNAME
                layout {
                    width: 152
                    sequence: 2
                }
            )

            displayColumn (
                column: @EMPLOYEENAME
                layout {
                    width: 135
                    sequence: 3
                }
            )

            displayColumn (
                column: @ISPASS
                layout {
                    width: 56
                    sequence: 4
                }
            )

            displayColumn (
                column: @ISFAIL
                layout {
                    width: 50
                    sequence: 5
                }
            )

            displayColumn (
                column: @ISREBOUNDED
                layout {
                    width: 97
                    sequence: 8
                }
            )

            displayColumn (
                column: @ISFORWARDED
                layout {
                    width: 93
                    sequence: 9
                }
            )

            displayColumn (
                column: @REMARK
                layout {
                    width: 500
                    sequence: 10
                }
            )

            displayColumn (
                column: @QUEUDATE
                layout {
                    width: 143
                    sequence: 6
                }
            )

            displayColumn (
                column: @PASSFAILDATE
                layout {
                    width: 141
                    sequence: 7
                }
            )

            sort (
                column: @TOKENNO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

        )

        column BOSSUSERNAME (
            type: textField
            heading {
                heading: Boss User Name
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: BOSSUSERNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column EMPLOYEENAME (
            type: textField
            heading {
                heading: Employee Name
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: EMPLOYEENAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ISFAIL (
            type: textField
            heading {
                heading: Is Fail
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 3
            }
            source {
                databaseColumn: ISFAIL
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ISFORWARDED (
            type: textField
            heading {
                heading: Is Forwarded
            }
            layout {
                sequence: 70
            }
            validation {
                maxLength: 3
            }
            source {
                databaseColumn: ISFORWARDED
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ISPASS (
            type: textField
            heading {
                heading: Is Pass
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 3
            }
            source {
                databaseColumn: ISPASS
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ISREBOUNDED (
            type: textField
            heading {
                heading: Is Rebounded
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 3
            }
            source {
                databaseColumn: ISREBOUNDED
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column PASSFAILDATE (
            type: textField
            heading {
                heading: Pass Fail Date & Time
            }
            layout {
                sequence: 100
            }
            validation {
                maxLength: 19
            }
            source {
                databaseColumn: PASSFAILDATE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column QUEUDATE (
            type: textField
            heading {
                heading: Queue Date & Time
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 19
            }
            source {
                databaseColumn: QUEUDATE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column REMARK (
            type: textarea
            heading {
                heading: Remark
            }
            layout {
                sequence: 80
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: REMARK
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column TOKENNO (
            type: numberField
            heading {
                heading: Token No
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                databaseColumn: TOKENNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Work Flow
        }
    )

    pageItem P162_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @work-flow
            slot: regionBody
        }
    )

    button back (
        buttonName: Back
        label: Back
        layout {
            sequence: 20
            region: @work-flow
            slot: belowBox
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--warning
            ]
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    dynamicAction back (
        name: Back
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @back
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

