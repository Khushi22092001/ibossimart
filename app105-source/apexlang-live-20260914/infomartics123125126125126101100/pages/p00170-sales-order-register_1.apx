                  '&P_STATUS=' +$('#P170_STATUS').val()  +
                  '&GLOBAL_COMPANYCODE=' +global_companycode 
                  ;
              
            
             
                    var reportURL = bireporturl+ reportName +
                          '?id='+ username +
