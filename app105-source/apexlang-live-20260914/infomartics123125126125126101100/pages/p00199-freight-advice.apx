                					BILLEDTOTALAMOUNT=:BILLEDTOTALAMOUNT,
                					BILLEDFOOTERAMOUNT=:BILLEDFOOTERAMOUNT , 
                                    VEHICLENO = :VEHICLENO
                     
                            WHERE TNO = :P199_TNO
                            and sno = :SNO;
                
                        when 'D' then
                            Delete From freightadvicedetail 
                            Where TNo = :P199_TNO
                            and sno = :SNO;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                ```
