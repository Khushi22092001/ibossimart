    dynamicAction calculate-deduction-amount (
        name: calculate deduction amount
        execution {
            sequence: 497
        }
        when {
            selectionType: columns
            interactiveGrid: @detail
            columns: [
                SHORTAGEQUANTITY1
                DEDUCTIONRATE
            ]
        }
