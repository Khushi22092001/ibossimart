        action native-set-value-3 (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery: SELECT nvl(:P199_SUMOFAMOUNT,0) + NVL(:P199_SUMOFFOOTERAMOUNT,0) - ( NVL(:P199_SUMOFTDSAMOUNT,0) + NVL(:P199_SUMOFADVANCEAMOUNT,0) + NVL(:P199_SUMOFDEDUCTIONAMOUNT,0)) AS AMT FROM DUAL
                itemsToSubmit: [
                    P199_SUMOFAMOUNT
                    P199_SUMOFFOOTERAMOUNT
