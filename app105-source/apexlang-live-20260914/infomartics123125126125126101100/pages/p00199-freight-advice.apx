    region detail-footer (
        name: Detail Footer
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rowid,
                        a.TNO,
                       a.SNO,
                       a.SN,
                       a.SERIALNO,
                       a.FOOTERHEADCODE,
                       a.FOOTERPERCENT,
                       a.FOOTERVALUE,
                       a.LEGENDSCODE,
                       ' ' as includewithtaxableamount
                  from FREIGHTADVICEDETAILFOOTER a
                  Where a.TNo = :P199_TNO
                  and a.sno = :P199_SNO
                ```
            pageItemsToSubmit: [
                P199_TNO
                P199_SNO
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/inline-dialog
            templateOptions: [
                #DEFAULT#
                js-dialog-autoheight
                js-dialog-nosize
            ]
            cssClasses: js-dialog-size900x500
        }
        masterDetail {
            masterRegion: @detail
        }
        advanced {
            htmlDomId: Detail_Footer
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        enableUsersTo {
            flashback: false
            defineChartView: false
            download: false
        }
        advanced {
            savedReportMappingIdentifier: 482797498842695161
        }

