        column MODULETNO (
            type: popupLov
            heading {
                heading: Module No
            }
            settings {
                fetchOnSearch: true
                popupWidth: 1000
                popupHeight: 300
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    Select 
                           b.RefNo,
                    			 a.TNo
                    
                      From FreightGRNCCInvoiceQty a,
                           FreightGRNCCInvoice    b,
                           GRNforFreight          c,
                           --companyvehicle d,
                           (Select CC.REFERENCEMODULETNO As MODULETNO,
                                   Sum(CC.TDSDEDUCTABLEAMOUNT) As TDSDEDUCTABLEAMOUNT,
                                   Sum(CC.AMOUNT) As ADVANCEAMOUNT
                            
                              From paymentadvice          aa,
                                   paymentadvicedetail    bb,
                                   paymentadvicereference cc
                             Where aa.tno = bb.tno(+)
                               And aa.tno = cc.tno(+)
                               And bb.footerheadcode = '.TDS.'
                            -- And CC.REFERENCEMODULETNO = 26390
                             Group By CC.REFERENCEMODULETNO) e
                     Where 1 = 1
                       And a.TNO = b.TNO
                       and b.companycode = :global_companycode
                       And a.tno = c.TNo(+)
                       And a.tno = e.moduletno(+)
                    
                    ```
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: TNO
                itemsToSubmit: [
                    P199_DOCTYPECODE
                    P199_FREIGHTTYPECODE
                    P199_FORMSTATUS
                    P199_TRANSPORTERCODE
                    P199_TNO
                ]
                parentRequired: false
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: MODULETNO
                dataType: number
            }
            advanced {
                htmlDomId: MODULETNO
                customAttributes: readonly=true
            }
        )

