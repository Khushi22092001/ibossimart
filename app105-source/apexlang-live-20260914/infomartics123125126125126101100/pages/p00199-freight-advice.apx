            type: never
        }

        action native-set-value (
            action: setValue
            settings {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select nvl(:SHORTAGEQUANTITY1,0)*NVL(:DEDUCTIONRATE,0)
                    FROM DUAL
                    ```
                itemsToSubmit: [
                    SHORTAGEQUANTITY1
                    DEDUCTIONRATE
                ]
            }
