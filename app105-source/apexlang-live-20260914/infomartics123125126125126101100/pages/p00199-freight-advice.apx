page 199 (
    name: Freight Advice
    alias: FREIGHT-ADVICE
    title: Freight Advice
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatDate(date) {
              var monthNames = [
                "JAN", "FEB", "MAR",
                "APR", "MAY", "JUN", "JUL",
                "AUG", "SEP", "OCT",
                "NOV", "DEC"
              ];
            
              var day = date.getDate();
              var monthIndex = date.getMonth();
              var year = date.getFullYear();
            
              return day + '-' + monthNames[monthIndex] + '-' + year;
            }
            
            function generatePDF() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P199_BIREPORTURL').val()
              var reportName = 'IRONMART/REPORT/FreightAdvice1.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '&P_TNO=' + $('#P199_TNO').val() 
                  ;
            
             
                    var reportURL = bireporturl+ reportName +
                          '?id='+ username +
                          '&passwd='+ password +
                          '&_xpt=0&_xmode=1&_xf=pdf'+reportParams
              window.open(reportURL, '_blank');
            }
            
            
            function generatePDF_new() {
              var username = 'weblogic';
              var password = 'webboss123';
              var bireporturl = $('#P199_BIREPORTURL').val()
              var reportName =  'FreightAdvice1.xdo';
              var outputFormat = 'pdf';
            
              var reportParams = 
                '"_paramsP_TNO":"' + $('#P199_TNO').val() 
                  ;
            //alert($('#P9993_TNO').val());
             
                    var reportURL = bireporturl+ reportName +
                          '&nQUser='+ username +
                          '&nQPassword='+ password +
                          '&bipParams={"_xmode":"1","_xpf":"","_xf":"pdf","_xpt":"1",'+reportParams+'"}'
            //alert(reportURL);
              window.open(reportURL, '_blank');
            }
            
            
            
            
            ```
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            /* Match GRN's breathing space between the hero and step navigation. */
            #tabcontainer { margin-top: 12px !important; }
            /* Forms do not expose the register/report filter action. */
            .t-Body-title .hspl-filter-trigger { display: none !important; }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region amount-summary (
        name: Amount Summary
        type: staticContent
        layout {
            sequence: 810
            parentRegion: @detail
            slot: subRegions
            startNewRow: false
            column: 9
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 840
            slot: beforeNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region common-fields (
        name: Common Fields
        type: staticContent
        layout {
            sequence: 850
            slot: afterNavigationBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noBorder
            ]
        }
        accessibility {
            landmarkType: region
        }
    )

    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       MODULECODE,
                       MODULETNO,
                       QUANTITY1,
                       NOS,
                       RATE,
                       RATEMEASURINGUNITCODE,
                       AMOUNT,
                       FOOTERAMOUNT,
                       TOTALAMOUNT,
                       TDSALREADYDEDUCTEDON,
                       TDSDEDUCTABLEAMOUNT,
                       TDSAMOUNT,
                       DEDUCTIONBASISCODE,
                       TOLERANCEMETHODCODE,
                       TOLERANCE,
                       SHORTAGEQUANTITY1,
                       SHORTAGENOS,
                       DEDUCTIONRATE,
                       DEDUCTIONAMOUNT,
                       NETFREIGHTAMOUNT,
                       ADVANCEAMOUNT,
                       PAYMENTCOMMISSION,
                       NETPAYABLEAMOUNT,
                       REMARK,
                       REACHEDQUANTITY1,
                       REACHEDDATE,
                       MINIMUMQUANTITY1,
                       ISDEDUCTIONONFULL,
                       GPSDEDUCTIONAMOUNT,
                       RECEIVEDQUANTITY1,
                       FREIGHTRATE,
                       CHALANQUANTITY1,
                       LOANAMOUNT,
                       OLDLANDINGRATE,
                       NEWLANDINGRATE,
                       BALANCEQUANTITY1,
                       BALANCEQUANTITY2,
                       BILLEDQUANTITY1,
                       BILLEDAMOUNT,
                       FREIGHTDEDUCTIONAMOUNT,
                       BILLEDTOTALAMOUNT,
                       BILLEDFOOTERAMOUNT,
                       VEHICLENO,
                       'FD' as FD,
                       null as doctype,
                       null as freighttype
                  from FREIGHTADVICEDETAIL
                  where tno = :P199_TNO
                ```
            pageItemsToSubmit: P199_TNO
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail_Region
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 300
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                    //Tab and Shift-Tab will skip over cells that are read-only
                    options.defaultGridViewOptions = {  
                        skipReadonlyCells: true  
                    };
                    return options;
                }
                ```
        }
        advanced {
            savedReportMappingIdentifier: 426487837244134723
        }

