                					TDSDEDUCTABLEAMOUNT=:TDSDEDUCTABLEAMOUNT,
                					TDSAMOUNT=TTDSAMOUNT,
                					DEDUCTIONBASISCODE=:DEDUCTIONBASISCODE,
