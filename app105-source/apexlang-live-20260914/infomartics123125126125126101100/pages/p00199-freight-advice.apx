        action set-net-payable (
            name: set net payable
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: NVL(:P199_SUMOFAMOUNT,0)+NVL(:P199_SUMOFFOOTERAMOUNT,0)-NVL(:P199_SUMOFTDSAMOUNT,0)-NVL(:P199_SUMOFADVANCEAMOUNT,0)-NVL(:P199_SUMOFDEDUCTIONAMOUNT,0)
                itemsToSubmit: [
                    P199_SUMOFAMOUNT
                    P199_SUMOFFOOTERAMOUNT
                    P199_SUMOFTDSAMOUNT
                    P199_SUMOFADVANCEAMOUNT
                    P199_SUMOFDEDUCTIONAMOUNT
                ]
            }
            affectedElements {
                selectionType: items
                items: P199_SUMOFNETPAYABLEAMOUNT
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

        action set-net-payable-before-round (
            name: set net payable before round
            action: setValue
            settings {
                type: plsqlExpression
                plsqlExpression: NVL(:P199_SUMOFAMOUNT,0)+NVL(:P199_SUMOFFOOTERAMOUNT,0)-NVL(:P199_SUMOFTDSAMOUNT,0)-NVL(:P199_SUMOFADVANCEAMOUNT,0)-NVL(:P199_SUMOFDEDUCTIONAMOUNT,0)
                itemsToSubmit: [
                    P199_SUMOFAMOUNT
