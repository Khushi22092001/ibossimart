page 609 (
    name: Loan Type List
    alias: LOAN-TYPE-LIST
    title: Loan Type List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important;
              
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region loan-type-list (
        name: Loan Type List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,
                       a.loantypecode,
                       a.loantypename,
                       a.loancategorycode,
                       b.loancategoryname,
                       a.salaryheadcode,
                       c.salaryheadname,
                       a.deductionsalaryheadcode,
                       d.salaryheadname As deductionsalaryheadname,
                       a.remark,
                       a.creator,
                       to_char(A.CREATIONTIME,'DD-MM-YYYY HH24:MI:SS') CREATIONTIME
                  From loantype a, Loancategory b, Salaryhead c, Salaryhead d
                 Where a.loancategorycode = b.loancategorycode(+)
                   And a.salaryheadcode = c.salaryheadcode(+)
                   And a.deductionsalaryheadcode = d.salaryheadcode(+)
                
                  Order By A.TNO Desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 610
                items: {
                    P610_TNO: \#TNO#\
                }
                clearCache: 610
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 190945396665568653
        }

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 100
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column DEDUCTIONSALARYHEADCODE (
            type: plainText
            heading {
                heading: Deduction Salary Head Code
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column DEDUCTIONSALARYHEADNAME (
            type: plainText
            heading {
                heading: Deduction Salary Head Name
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column LOANCATEGORYCODE (
            type: plainText
            heading {
                heading: Loan Category Code
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column LOANCATEGORYNAME (
            type: plainText
            heading {
                heading: Loan Category Name
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column LOANTYPECODE (
            type: plainText
            heading {
                heading: Loan Type Code
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        column LOANTYPENAME (
            type: plainText
            heading {
                heading: Loan Type Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: P
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column SALARYHEADCODE (
            type: plainText
            heading {
                heading: Salary Head Code
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: Q
            }
        )

        column SALARYHEADNAME (
            type: plainText
            heading {
                heading: Salary Head Name
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: R
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Designation List
        }

        savedReport 1443940 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATIONTIME (
                sequence: 11
            )

            displayColumn CREATOR (
                sequence: 10
            )

            displayColumn DEDUCTIONSALARYHEADCODE (
                sequence: 5
            )

            displayColumn DEDUCTIONSALARYHEADNAME (
                sequence: 6
            )

            displayColumn LOANCATEGORYCODE (
                sequence: 7
            )

            displayColumn LOANCATEGORYNAME (
                sequence: 8
            )

            displayColumn LOANTYPECODE (
                sequence: 1
            )

            displayColumn LOANTYPENAME (
                sequence: 2
            )

            displayColumn REMARK (
                sequence: 9
            )

            displayColumn SALARYHEADCODE (
                sequence: 3
            )

            displayColumn SALARYHEADNAME (
                sequence: 4
            )

        )

    )

    pageItem P609_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @loan-type-list
            slot: regionBody
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @loan-type-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 610
                clearCache: 610
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @loan-type-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @loan-type-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @loan-type-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @loan-type-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction pagination (
        name: pagination
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action plugin-ir-pagination (
            action: plugin/addPaginationToIr
            settings {
                labelOfTotalNumbers: Total number of rows:
                titleOfFirstPage: First page
                titleOfLastPage: Last page
            }
            execution {
                sequence: 10
            }
        )

    )

)

