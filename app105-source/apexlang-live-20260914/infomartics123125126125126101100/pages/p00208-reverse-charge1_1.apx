    process pre-rendering-tno (
        name: Pre Rendering Tno
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE 
                    tTNo Number;
                BEGIN
                    IF :P208_TNO IS NULL THEN 
                        SELECT GLOBALTNO.NEXTVAL INTO tTNo FROM DUAL;
                        :P208_TNO := tTNo;
                        :P208_FORMSTATUS := 'NEWRECORD';
                    else 
                         :P208_FORMSTATUS := 'EDITRECORD';
                    END IF;
                     --- Get Voucher No
                    for vloop in ( select * from voucher where moduletno = :P208_TNO) loop
                        :P208_VOUCHERNO := VLOOP.VOUCHERNO;
                        :P208_VOUCHERTNO := VLOOP.TNO;
                    end loop;
                    
                END;
                ```
