    process detail-process-from (
        name: Detail process from
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into REVERSECHARGEDETAIL (                 
                                    TNO,
                                    SNO,
                                    JOBTYPECODE,
                                    ITEMCODE,
                                    ITEMSPECIFICATIONCODE,
                                    VEHICLENECESSITYCODE,
                                    DESCRIPTION,
                                    QUANTITY1,
                                    QUANTITY2,
                                    RATE,
                                    RATEMEASURINGUNITCODE,
                                    AMOUNT,
                                    FOOTERAMOUNT,
                                    TOTALAMOUNT,
                                    REMARK,
                                    TAXRULECODE,
                                    ACCOUNTCODE,
                                    HSNCODE
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :JOBTYPECODE,
                                :ITEMCODE,
                                :ITEMSPECIFICATIONCODE,
                                :VEHICLENECESSITYCODE,
                                :DESCRIPTION,
                                :QUANTITY1,
                                :QUANTITY2,
                                :RATE,
                                :RATEMEASURINGUNITCODE,
                                :AMOUNT,
                                :FOOTERAMOUNT,
                                :TOTALAMOUNT,
                                :REMARK,
                                :TAXRULECODE,
                                :ACCOUNTCODE,
                                :HSNCODE
                
                            );
                        
                        when 'U' then
                            update REVERSECHARGEDETAIL Set
                                  TNO=:TNO,
                                    SNO=:SNO,
                                    JOBTYPECODE=:JOBTYPECODE,
                                    ITEMCODE=:ITEMCODE,
                                    ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                                    VEHICLENECESSITYCODE=:VEHICLENECESSITYCODE,
                                    DESCRIPTION=:DESCRIPTION,
                                    QUANTITY1=:QUANTITY1,
                                    QUANTITY2=:QUANTITY2,
                                    RATE=:RATE,
                                    RATEMEASURINGUNITCODE=:RATEMEASURINGUNITCODE,
                                    AMOUNT=:AMOUNT,
                                    FOOTERAMOUNT=:FOOTERAMOUNT,
                                    TOTALAMOUNT=:TOTALAMOUNT,
                                    REMARK=:REMARK,
                                    TAXRULECODE=:TAXRULECODE,
                                    ACCOUNTCODE=:ACCOUNTCODE,
                                    HSNCODE=:HSNCODE
                            WHERE TNO = :P208_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From REVERSECHARGEDETAIL
                            Where TNo = :P208_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 10329092782883324
        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P208_Tno is null then
                        Select GlobalTno.NextVal into :P208_Tno From Dual;
                     end if;
                    ----
                    if :P208_REVERSECHARGENO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P208_LocationCode,
                					:P208_DocTypeCode,
                					NULL,
                					TO_DATE(:P208_REVERSECHARGEDATE, 'DD-MM-RRRR')
                				);
                        :P208_REVERSECHARGENO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P208_LocationCode,
                                    :P208_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P208_REVERSECHARGEDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10439273664024079
        }
    )

