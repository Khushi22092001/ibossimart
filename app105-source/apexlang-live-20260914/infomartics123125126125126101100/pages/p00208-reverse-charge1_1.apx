    region reverse-charge (
        name: Reverse Charge
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       PARTYCODE,
                       SUMOFAMOUNT,
                       SUMOFFOOTERAMOUNT,
                       REVERSECHARGEAMOUNT,
                       REMARK,
                       ITEMWISEFOOTER,
                       REVERSECHARGEDATE,
                       REVERSECHARGENO,
                       TRANSACTIONTYPECODE,
                       CREATOR,
                       MODULECODE,
                       MODULETNO,
                       NATUREOFSUPPLYCODE,
                       FOOTERNATURECODE,
                       SUPPLIERCODE,
                       SUPPLIERNAME,
                       REVERSECHARGEFOOTERNATURECODE,
                       NVL(GETDOCUMENTSTATUSCODE('REVERSECHARGE',TNO),'Status') as Status 
                  from REVERSECHARGE
                ```
        }
        layout {
            sequence: 10
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

