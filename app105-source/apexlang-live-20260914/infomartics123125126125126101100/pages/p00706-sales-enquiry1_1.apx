    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    if :ITEMCODE is not null then
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into salesenquirydetail (                 
                                    tno                    ,
                                    sno                    ,
                                    itemcode               ,
                                    itemspecificationcode  ,
                                    description            ,
                                    quantity1              ,
                                    quantity2              ,
                                    ratemeasuringunitcode  ,
                                    
                                  
                                    rate                   ,
                                    amount                 ,
                                    footeramount           ,
                                    totalamount            ,
                                    remark                 ,
                                    lowertolerancepercent  ,
                                    highertolerancepercent 
                                     
                                    --taxrulecode            
                            )
                            Values (
                                :tno                    ,
                                :sno                    ,
                                :itemcode               ,
                                :itemspecificationcode  ,
                                :description            ,
                                :quantity1              ,
                                :quantity2              ,
                                :ratemeasuringunitcode  ,
                              
                             
                                :rate                   ,
                                :amount                 ,
                                :footeramount           ,
                                :totalamount            ,
                                :remark                 ,
                                :lowertolerancepercent  ,
                                :highertolerancepercent 
                                   
                                  
                            );
                        
                        when 'U' then
                            update salesenquirydetail Set
                                    tno                     =		:tno                    ,
                                    sno                     =		:sno                    ,
                                    itemcode                =		:itemcode               ,
                                    itemspecificationcode   =		:itemspecificationcode  ,
                                    description             =		:description            ,
                                    quantity1               =		:quantity1              ,
                                    quantity2               =		:quantity2              ,
                                    ratemeasuringunitcode   =		:ratemeasuringunitcode  ,
                                
                                    rate                    =		:rate                   ,
                                    amount                  =		:amount                 ,
                                    footeramount            =		:footeramount           ,
                                    totalamount             =		:totalamount            ,
                                    remark                  =		:remark                 ,
                                    lowertolerancepercent   =		:lowertolerancepercent  ,
                                    highertolerancepercent  =		:highertolerancepercent 
                                  
                            WHERE TNO = :P706_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From salesenquirydetail
                            Where TNo = :P706_TNO
                              and SNO = :SNO
                              ;
                    end case;
                    end if;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 60186695684924053
        }
    )

