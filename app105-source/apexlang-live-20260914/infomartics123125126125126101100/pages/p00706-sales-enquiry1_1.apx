    process savesalesenquiryfooter (
        name: SaveSalesEnquiryFooter
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    delete from salesenquiryfooter where tno = :P706_TNO;
                    insert into salesenquiryfooter
                        (tno ,
                        SNO,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   SELECT X.TNO,
                                   GLOBALTNO.NEXTVAL,
                                   X.FOOTERHEADCODE,
                                   X.SUMOFVALUE
                             FROM 
                            (select 
                                :P706_TNO AS TNO ,               
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from salesenquirydetailfooter
                            where tno = :P706_TNO
                            group by FOOTERHEADCODE
                            ) X
                        );
                end;
                ```
        }
        execution {
            sequence: 110
        }
        advanced {
            executionMappingIdentifier: 60256058352924096
        }
    )

