        type: popupLov
        label {
            label: Agent
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName as AgentName,
                a.PartyCode as AgentCode
                from Party a
                where a.PartyTypeCode = 'AGENT'
                and GetDocumentStatusCode('PARTY', A.TNO) = 'ACTIVE'
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 640
