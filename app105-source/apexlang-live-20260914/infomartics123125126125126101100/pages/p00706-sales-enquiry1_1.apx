        name: Delete unsaved data
        execution {
            sequence: 58
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action check-detail (
            name: check detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
