    region e-mail (
        name: E-Mail
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       MODULETNO,
                       MODULESNO,
                       MODULESN,
                       MODULECODE,
                      -- MODULETABLENAME,
                      -- MODULESERIALNO,
                       ATTRIBUTECODE,
                       ATTRIBUTEVALUE,
                      -- DESCRIPTION,
                      -- ATTACHMENTBLOB,
                      decode( nvl(FileName, 'NULL'), 'NULL', 'NO', 'YES') as FILENAME,
                      -- MIMETYPE,
                       REMARK
                  from MODULEATTACHMENT 
                  where tno = :P706_TNO
                ```
            pageItemsToSubmit: P706_TNO
        }
        layout {
