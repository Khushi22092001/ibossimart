    dynamicAction initialize-sno-sequence (
        name: Initialize SNO Sequence1
        execution {
            sequence: 330
        }
        when {
            event: region/interactiveGrid/apexbeginrecordedit
            selectionType: region
            region: @special-note
        }

        action native-set-value (
            action: setValue
            settings {
                type: plsqlFunctionBody
                plsqlFunctionBody:
                    ```plsql
                    Declare
                    mysno number;
                    Begin
                    If :SNO is null then
                        Select GlobalTNo.nextval into mysno from dual;
                    else MYSNO := :SNO;
                    end if;
                    return mysno;
                    end;
                    ```
                itemsToSubmit: SNO
            }
            affectedElements {
                selectionType: columns
                columns: SNO
