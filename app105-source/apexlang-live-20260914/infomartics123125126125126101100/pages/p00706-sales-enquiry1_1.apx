    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P706_Tno is null then
                        Select GlobalTno.NextVal into :P706_Tno From Dual;
                     end if;
                    ----
                    if :P706_SALESENQUIRYNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P706_LocationCode,
                					:P706_DocTypeCode,
                					NULL,
                					TO_DATE(:P706_SALESENQUIRYDATE, 'DD-MM-RRRR')
                				);
                        :P706_SALESENQUIRYNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P706_LocationCode,
                                    :P706_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P706_SALESENQUIRYDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 60254498437924096
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P706_TNO is null then
                    :P706_TNO := GlobalTNo.nextval;
                    :P706_FORMSTATUS := 'NEWRECORD';
                else
                    
                    :P706_FORMSTATUS := 'EDITRECORD';
                End if;
                
                :P706_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P706_TNO), 'Status');
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
