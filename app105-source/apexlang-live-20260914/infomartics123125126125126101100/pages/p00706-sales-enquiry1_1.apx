            settings {
                plsqlCode:
                    ```plsql
                    begin
                    --raise_application_error(-20002,'called');
                        if :P706_PARTYFORENQUIRY is not null then
                    --raise_application_error(-20002,'called');
                            createindentfromSalesEnquiry(:P706_TNO);
                    
                            createEnquiryfromSalesEnquiry(:P706_TNO,:P706_PARTYFORENQUIRY);
                        end if;
