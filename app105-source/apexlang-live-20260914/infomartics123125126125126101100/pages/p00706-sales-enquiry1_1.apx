    pageItem P706_CONSIGNEECODE (
        type: popupLov
        label {
            label: Consignee
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select partyname , partycode from party
                where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
                and partytypecode in ('CUSTOMER','AGENT')
                and :P706_DOCTYPECODE = 'SALE'
                union all   
                select partyname , partycode from party
                where getdocumentstatuscode('PARTY',TNO) = 'ACTIVE'
                and partytypecode in ('SUPPLIER','AGENT')
                and :P706_DOCTYPECODE = 'PURCHASERETURN'
                ```
            displayNullValue: false
        }
        cascadingLov {
            parentItems: P706_DOCTYPECODE
            itemsToSubmit: P706_DOCTYPECODE
        }
        layout {
            sequence: 80
            region: @general-2
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/required
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 30
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @general
            column: CONSIGNEECODE
            dataType: varchar2
        }
    )

