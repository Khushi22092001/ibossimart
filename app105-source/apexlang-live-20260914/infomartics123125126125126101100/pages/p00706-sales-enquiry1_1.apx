    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select A.ROWID,
                       A.TNO,
                       A.SNO,
                       A.ITEMCODE,
                       A.ITEMSPECIFICATIONCODE,
                       A.DESCRIPTION,
                       A.QUANTITY1,
                       A.QUANTITY2,
                       A.RATEMEASURINGUNITCODE,
                       A.RATE,
                       A.AMOUNT,
                       A.FOOTERAMOUNT,
                       A.TOTALAMOUNT,
                       A.REMARK,
                       A.LOWERTOLERANCEPERCENT,
                       A.HIGHERTOLERANCEPERCENT,
                      
                       GetMeasuringUnitNameFromItem(itemcode) as unit1,
                       GetMeasuringUnit2NameFromItem(itemcode) as unit2,
                       'FD' as FD
                  from SALESENQUIRYDETAIL A
                  where A.tno = :P706_TNO
                    --AND A.ITEMCODE = B.ITEMCODE
                ```
            pageItemsToSubmit: P706_TNO
        }
        layout {
            sequence: 30
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail
        }
