    process detail-save-interactive-grid-data (
        name: Detail - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into PROCESSESCALATIONDETAIL (                 
                                    TNO,
                                    SNO,
                                    FROMMODULECODE,
                                    TOMODULECODE,
                                    TIMEINTERVALUUOM,
                                    DELAYTIMEFROM,
                                    DELAYTIMETO
                            )
                            Values (
                               :TNO,
                                :SNO,
                                :FROMMODULECODE,
                                :TOMODULECODE,
                                :TIMEINTERVALUUOM,
                                :DELAYTIMEFROM,
                                :DELAYTIMETO
                            );
                        
                        when 'U' then
                            update PROCESSESCALATIONDETAIL Set
                                 TNO=:TNO,
                                    SNO=:SNO,
                                    FROMMODULECODE=:FROMMODULECODE,
                                    TOMODULECODE=:TOMODULECODE,
                                    TIMEINTERVALUUOM=:TIMEINTERVALUUOM,
                                    DELAYTIMEFROM=:DELAYTIMEFROM,
                                    DELAYTIMETO=:DELAYTIMETO
                            WHERE TNO = :P720_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From PROCESSESCALATIONDETAIL
                            Where TNo = :P720_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 61365673529524231
        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P720_Tno is null then
                        Select GlobalTno.NextVal into :P720_Tno From Dual;
                     end if;
                    ----
                    if :P720_PROCESSESCALATIONCODE is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					null,
                					null,
                					NULL,
                					TO_DATE(sysdate, 'DD-MM-RRRR')
                				);
                        :P720_PROCESSESCALATIONCODE := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    null,
                                    null,
                                    NULL,
                                    TO_DATE(:date, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 61386378154524243
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P720_TNO is null then
                    :P720_TNO := GlobalTNo.nextval;
                    :P720_FORMSTATUS := 'NEWRECORD';
                    
                  
                else
                    :P720_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P720_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P720_TNO), 'Status');
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 61385539127524243
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P720_MODULEFLOW := 'YES';
                   else
                       :P720_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P720_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P720_ONTHETABLE := 'YES' ;
                   else
                       :P720_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 61385944394524243
        }
    )

