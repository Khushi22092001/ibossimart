    dynamicAction insert-into-detail (
        name: insert into detail
        execution {
            sequence: 130
        }
        when {
            event: click
            selectionType: button
            button: @getdata
        }

        action insert-detail (
            name: insert detail
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    delete from processescalationdetail where tno = :P720_TNO;
                    
                    insert into processescalationdetail
                    (
                        tno,
                        sno,
                        FROMMODULECODE
                    )
                    (
                        select
                            :P720_TNO,
                            globaltno.nextval,
                            modulecode
                        from PROCESSROUTINGDETAIL
                        where tno = :P720_PROCESSROUTINGTNO
                    
                    );
                    ```
                itemsToSubmit: [
                    P720_TNO
