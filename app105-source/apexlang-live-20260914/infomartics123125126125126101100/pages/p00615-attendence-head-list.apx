page 615 (
    name: Attendence Head List
    alias: ATTENDENCE-HEAD-LIST
    title: Attendence Head List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important;
              
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region attendence-head-list (
        name: Attendence Head List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select a.tno,
                       a.Attendenceheadcode,
                       a.Attendenceheadname,
                       a.Attendenceheadshortname,
                       a.salaryheadcode,
                       B.SALARYHEADNAME,
                       a.attendenceunit,
                       a.creator,
                       to_char(A.CREATIONTIME, 'DD-MM-YYYY HH24:MI:SS') CREATIONTIME
                  From ATTENDENCEHEAD a, SALARYHEAD B
                  WHERE A.SALARYHEADCODE = B.SALARYHEADCODE(+)
                  Order By A.TNO Desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 616
                items: {
                    P616_TNO: \#TNO#\
                }
                clearCache: 616
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 191007144006910275
        }

        column ATTENDENCEHEADCODE (
            type: plainText
            heading {
                heading: Attendence Head Code
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: S
            }
        )

        column ATTENDENCEHEADNAME (
            type: plainText
            heading {
                heading: Attendence Head Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: T
            }
        )

        column ATTENDENCEHEADSHORTNAME (
            type: plainText
            heading {
                heading: Attendence Head Short Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

        column ATTENDENCEUNIT (
            type: plainText
            heading {
                heading: Attendenceunit
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: V
            }
        )

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creation Time
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: J
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column SALARYHEADCODE (
            type: plainText
            heading {
                heading: Salary Head Code
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: M
            }
        )

        column SALARYHEADNAME (
            type: plainText
            heading {
                heading: Salary Head Name
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: W
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Designation List
        }

        savedReport 1443940 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ATTENDENCEHEADCODE (
                sequence: 1
            )

            displayColumn ATTENDENCEHEADNAME (
                sequence: 2
            )

            displayColumn ATTENDENCEHEADSHORTNAME (
                sequence: 3
            )

            displayColumn ATTENDENCEUNIT (
                sequence: 6
            )

            displayColumn CREATIONTIME (
                sequence: 8
            )

            displayColumn CREATOR (
                sequence: 7
            )

            displayColumn SALARYHEADCODE (
                sequence: 5
            )

            displayColumn SALARYHEADNAME (
                sequence: 4
            )

        )

    )

    pageItem P615_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 10
            region: @attendence-head-list
            slot: regionBody
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @attendence-head-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 616
                clearCache: 616
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @attendence-head-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction close-dialog (
        name: Close Dialog
        execution {
            sequence: 20
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @create
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attendence-head-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @attendence-head-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @attendence-head-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

)

