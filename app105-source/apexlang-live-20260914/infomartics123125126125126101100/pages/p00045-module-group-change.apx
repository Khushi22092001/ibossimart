page 45 (
    name: Module Group Change
    alias: MODULE-GROUP-CHANGE
    title: Module Group Change
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region module (
        name: Module
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.ModuleCode,
                a.ModuleName,
                a.ModuleGroupCode,
                b.SerialNo as GroupSerialNo,
                a.SerialNo,
                a.isactive,
                A.ICONNAME,
                A.MODULESHORTNAME
                from Module a, ModuleGroup b
                where a.ModuleGroupCode = b.ModuleGroupCode(+)
                  and a.PageNo is not null
                  AND A.PAGENO != 1
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        edit {
            enabled: true
            allowedOperations: update
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                excel
                pdf
            ]
        }
        advanced {
            savedReportMappingIdentifier: 478145351000852663
        }

        savedReport 816423 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @GROUPSERIALNO
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @SERIALNO
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @ISACTIVE
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @ICONNAME
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @MODULESHORTNAME
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @MODULECODE
                layout {
                    show: false
                    sequence: 2
                }
            )

            displayColumn (
                column: @MODULENAME
                layout {
                    width: 201
                    sequence: 3
                }
            )

            displayColumn (
                column: @MODULEGROUPCODE
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    frozen: true
                    width: 40
                    sequence: 1
                }
            )

            sort (
                column: @GROUPSERIALNO
                sort {
                    nulls: last
                    sequence: 1
                }
            )

            sort (
                column: @SERIALNO
                sort {
                    nulls: last
                    sequence: 2
                }
            )

            controlBreak (
                column: @MODULEGROUPCODE
                sort {
                    nulls: last
                }
                layout {
                    sequence: 5
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column GROUPSERIALNO (
            type: numberField
            heading {
                heading: Group Serial No
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: GROUPSERIALNO
                dataType: number
                queryOnly: true
            }
            columnFilter {
                lovType: none
            }
        )

        column ICONNAME (
            type: textField
            heading {
                heading: Iconname
            }
            layout {
                sequence: 90
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: ICONNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column ISACTIVE (
            type: checkbox
            heading {
                heading: Is Active
            }
            settings {
                useDefaults: false
                checkedValue: YES
                uncheckedValue: NO
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ISACTIVE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column MODULECODE (
            type: textField
            heading {
                heading: Module Code
            }
            layout {
                sequence: 30
            }
            validation {
                valueRequired: true
                maxLength: 30
            }
            source {
                databaseColumn: MODULECODE
                dataType: varchar2
                primaryKey: true
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column MODULEGROUPCODE (
            type: popupLov
            heading {
                heading: Module Group
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select
                    a.ModuleGroupName as d,
                    a.ModuleGroupCode as r 
                    from ModuleGroup a
                    order by 1
                    ```
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 30
            }
            source {
                databaseColumn: MODULEGROUPCODE
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: useLov
            }
        )

        column MODULENAME (
            type: textarea
            heading {
                heading: Module Name
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: MODULENAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column MODULESHORTNAME (
            type: textField
            heading {
                heading: Short Name
            }
            layout {
                sequence: 100
            }
            validation {
                maxLength: 10
            }
            source {
                databaseColumn: MODULESHORTNAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
            }
        )

        column SERIALNO (
            type: numberField
            heading {
                heading: Module Serial No
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: SERIALNO
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Module
        }
    )

    process module-save-interactive-grid-data (
        name: Module - Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @module
        target {
            targetType: tableView
            tableName: MODULE
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 138626853319792583
        }
    )

)

