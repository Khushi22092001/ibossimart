page 41 (
    name: Code Scheme Master Report
    alias: CODE-SCHEME-MASTER-REPORT
    title: Code Scheme Master Report
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            :root{
                --a-menu-font-size: 1.25rem !important;
            }
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region code-scheme-master-report (
        name: Code Scheme Master Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select  A.MODULECODE,A.STARTNO, a.lastno,B.MODULENAME
                  from CodeSchememaster  A, MODULE B
                  where A.MODULECODE = B.MODULECODE(+)
                    --and A.FINANCIALYEARCODE = :P41_FINANCIALYEARCODE
                  --order by CREATIONTIME desc
                ```
            pageItemsToSubmit: [
                P41_FINANCIALYEARCODE
                P41_MODULECODE
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 42
                items: {
                    P42_MODULECODE: #MODULECODE#
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 405559172717759237
        }

        column LASTNO (
            type: plainText
            heading {
                heading: Last No
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column MODULECODE (
            type: plainText
            heading {
                heading: Modulecode
            }
            layout {
                sequence: 14
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column MODULENAME (
            type: plainText
            heading {
                heading: Modulename
            }
            layout {
                sequence: 34
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column STARTNO (
            type: plainText
            heading {
                heading: Startno
                alignment: end
            }
            layout {
                sequence: 24
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: M
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Code Scheme Master Report
        }

        savedReport 222801 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn LASTNO (
                sequence: 3
            )

            displayColumn MODULENAME (
                sequence: 1
            )

            displayColumn STARTNO (
                sequence: 2
            )

        )

    )

    pageItem P41_COMPANYCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 40
            slot: body
        }
    )

    pageItem P41_FINANCIALYEARCODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 30
            slot: body
        }
    )

    pageItem P41_MODULECODE (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 20
            slot: body
        }
    )

    pageItem P41_TNO (
        type: hidden
        settings {
            valueProtected: false
        }
        layout {
            sequence: 50
            slot: body
        }
    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @code-scheme-master-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 42
                clearCache: 42
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @code-scheme-master-report
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @code-scheme-master-report
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @code-scheme-master-report
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

