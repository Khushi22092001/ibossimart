    region un-hold-salary (
        name: Un-Hold Salary
        type: form
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       COMPANYCODE,
                       FINANCIALYEARCODE,
                       LOCATIONCODE,
                       DOCTYPECODE,
                       UNHOLDSALARYNO,
                       UNHOLDSALARYDATE,
                       SALARYFROMDATE,
                       SALARYTODATE,
                       EMPLOYEECODE,
                       REASON,
                       REMARK,
                       CREATOR,
                       CREATIONTIME,
                       HOLDSALARYTNO
                  from UNHOLDSALARY
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--accent15
                t-Region--scrollBody
                t-Form--slimPadding
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

