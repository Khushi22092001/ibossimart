    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P688_Tno is null then
                        Select GlobalTno.NextVal into :P688_Tno From Dual;
                     end if;
                    ----
                    if :P688_UNHOLDSALARYNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P688_LocationCode,
                					:P688_DocTypeCode,
                					NULL,
                					TO_DATE(:P688_UNHOLDSALARYDATE, 'DD-MM-RRRR')
                				);
                        :P688_UNHOLDSALARYNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P688_LocationCode,
                                    :P688_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P688_UNHOLDSALARYDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 44209883134656528
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                If :P688_TNO is null then
                    :P688_TNO := GlobalTNo.nextval;
                    :P688_FORMSTATUS := 'NEWRECORD';
                  
                else
                    :P688_FORMSTATUS := 'EDITRECORD';
                   
                End if;
                
                :P688_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P688_TNO), 'Status');
                
                 begin
                select TNO into :P688_VOUCHERTNO from voucher 
                        where moduletno = :P688_TNO
                          AND MODULECODE='SALARYPAYMENTADVICE';
                exception when others then 
                    null;
                end; 
                end;
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44184357981632151
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P688_MODULEFLOW := 'YES';
                   else
                       :P688_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P688_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P688_ONTHETABLE := 'YES' ;
                   else
                       :P688_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 44184630859633074
        }
    )

