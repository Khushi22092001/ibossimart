page 613 (
    name: Qualification Type List
    alias: QUALIFICATION-TYPE-LIST1
    title: Qualification Type List
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        fileUrls: #APP_FILES#mycss/MyIR (2)#MIN#.css
        inline:
            ```css
            .t-TreeNav--styleA .a-TreeView-node--topLevel ul,
            .t-TreeNav--styleB .a-TreeView-node--topLevel ul {
              --a-treeview-node-padding-y: 0.40rem !important;
              --a-treeview-node-font-size: 1.00rem !important; 
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region qualification-type-list (
        name: Qualification Type List
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select TNO,
                       QUALIFICATIONTYPECODE,
                       QUALIFICATIONTYPENAME,
                       REMARK,
                       DATECREATED,
                       DATEMODIFY,
                       CREATIONTIME,
                       CREATOR
                  from QUALIFICATIONTYPE
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 614
                items: {
                    P614_TNO: \#TNO#\
                }
                action: resetPagination
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        advanced {
            savedReportMappingIdentifier: 15378803709218274
        }

        column CREATIONTIME (
            type: plainText
            heading {
                heading: Creationtime
            }
            layout {
                sequence: 7
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column CREATOR (
            type: plainText
            heading {
                heading: Creator
            }
            layout {
                sequence: 8
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column DATECREATED (
            type: plainText
            heading {
                heading: Datecreated
            }
            layout {
                sequence: 5
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: E
            }
        )

        column DATEMODIFY (
            type: plainText
            heading {
                heading: Datemodify
            }
            layout {
                sequence: 6
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: F
            }
        )

        column QUALIFICATIONTYPECODE (
            type: plainText
            heading {
                heading: Qualificationtypecode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column QUALIFICATIONTYPENAME (
            type: plainText
            heading {
                heading: Qualificationtypename
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column REMARK (
            type: plainText
            heading {
                heading: Remark
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TNO (
            type: hidden
            heading {
                heading: Tno
            }
            layout {
                sequence: 0
            }
            source {
                primaryKey: true
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Qualification Type List
        }

        savedReport 153859 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATIONTIME (
                sequence: 7
            )

            displayColumn CREATOR (
                sequence: 8
            )

            displayColumn DATECREATED (
                sequence: 5
            )

            displayColumn DATEMODIFY (
                sequence: 6
            )

            displayColumn QUALIFICATIONTYPECODE (
                sequence: 2
            )

            displayColumn QUALIFICATIONTYPENAME (
                sequence: 3
            )

            displayColumn REMARK (
                sequence: 4
            )

            displayColumn TNO (
                sequence: 1
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Add New
        layout {
            sequence: 20
            region: @qualification-type-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--primary
                t-Button--iconLeft
            ]
            icon: fa-plus-square-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 614
                clearCache: 614
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button home (
        buttonName: Home
        label: Home
        layout {
            sequence: 10
            region: @qualification-type-list
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-window-close-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @qualification-type-list
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @qualification-type-list
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction hide-nav (
        name: hide nav
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: $("body").removeClass("js-navExpanded").addClass("js-navCollapsed");
            }
            execution {
                sequence: 10
            }
        )

    )

)

