    region detail (
        name: Detail
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ROWID,
                       TNO,
                       SNO,
                       SERIALNO,
                       ITEMCODE,
                       ITEMSPECIFICATIONCODE,
                       DESCRIPTION,
                       QUANTITY1,
                       QUANTITY2,
                       RATEMEASURINGUNITCODE,
                       RATE,
                       AMOUNT,
                       FOOTERAMOUNT,
                       TOTALAMOUNT,
                       REMARK,
                       PACKINGTYPECODE,
                       PACKINGNOS,
                       GetMeasuringUnitNameFromItem(itemcode) as unit1,
                       GetMeasuringUnit2NameFromItem(itemcode) as unit2,
                       'FD' as FD
                  from SALESQUOTATIONDETAIL
                  where tno=:P705_TNO
                ```
            pageItemsToSubmit: P705_TNO
        }
        layout {
            sequence: 35
            parentRegion: @new
            slot: tabs
        }
        appearance {
            template: @myirr
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Detail
        }
