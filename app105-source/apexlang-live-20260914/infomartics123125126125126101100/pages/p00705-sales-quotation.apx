    process save-detail (
        name: save detail
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into SALESQUOTATIONDETAIL (                 
                                    TNO,
                SNO,
                SERIALNO,
                ITEMCODE,
                ITEMSPECIFICATIONCODE,
                DESCRIPTION,
                QUANTITY1,
                QUANTITY2,
                RATEMEASURINGUNITCODE,
                RATE,
                AMOUNT,
                FOOTERAMOUNT,
                TOTALAMOUNT,
                REMARK,
                PACKINGTYPECODE,
                PACKINGNOS
                            )
                            Values (
                                :TNO,
                :SNO,
                :SERIALNO,
                :ITEMCODE,
                :ITEMSPECIFICATIONCODE,
                :DESCRIPTION,
                :QUANTITY1,
                :QUANTITY2,
                :RATEMEASURINGUNITCODE,
                :RATE,
                :AMOUNT,
                :FOOTERAMOUNT,
                :TOTALAMOUNT,
                :REMARK,
                :PACKINGTYPECODE,
                :PACKINGNOS
                
                            );
                        
                        when 'U' then
                            update SALESQUOTATIONDETAIL Set
                                  TNO=:TNO,
                SNO=:SNO,
                SERIALNO=:SERIALNO,
                ITEMCODE=:ITEMCODE,
                ITEMSPECIFICATIONCODE=:ITEMSPECIFICATIONCODE,
                DESCRIPTION=:DESCRIPTION,
                QUANTITY1=:QUANTITY1,
                QUANTITY2=:QUANTITY2,
                RATEMEASURINGUNITCODE=:RATEMEASURINGUNITCODE,
                RATE=:RATE,
                AMOUNT=:AMOUNT,
                FOOTERAMOUNT=:FOOTERAMOUNT,
                TOTALAMOUNT=:TOTALAMOUNT,
                REMARK=:REMARK,
                PACKINGTYPECODE=:PACKINGTYPECODE,
                PACKINGNOS=:PACKINGNOS
                
                
                            WHERE TNO = :P705_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From SALESQUOTATIONDETAIL
                            Where TNo = :P705_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 8842942652508813
        }
    )

    process savesalesquotationfooter (
        name: SaveSalesquotationFooter
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    delete from SALESquotationFOOTER where tno = :P705_TNO;
                    insert into SALESquotationFOOTER
                        (tno ,
                        SNO,
                        FOOTERHEADCODE , 
                        FOOTERVALUE )
                        (   SELECT X.TNO,
                                   GLOBALTNO.NEXTVAL,
                                   X.FOOTERHEADCODE,
                                   X.SUMOFVALUE
                             FROM 
                            (select 
                                :P705_TNO AS TNO ,               
                                FOOTERHEADCODE , 
                                sum(FOOTERVALUE) as sumofvalue 
                            from SALESquotationDETAILFOOTER
                            where tno = :P705_TNO
                            group by FOOTERHEADCODE
                            ) X
                        );
                end;
                ```
        }
        execution {
            sequence: 80
        }
        advanced {
            executionMappingIdentifier: 8902239106508838
        }
    )

