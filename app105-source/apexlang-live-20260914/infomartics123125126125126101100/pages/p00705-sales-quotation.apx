    process terms-and-conditions-save-interactive-grid-data (
        name: Terms and Conditions - Save Interactive Grid Data
        type: executeCode
        editableRegion: @terms-and-conditions
        source {
            plsqlCode:
                ```plsql
                Begin
                    if :TERMSANDCONDITIONHEADCODE is not null then
                        if :sno is null then
                            select globaltno.nextval into :sno from dual;
                        end if;
                    case :APEX$ROW_STATUS
                        when 'C' then
                            Insert Into salesquotationtac (                 
                                   TNO,
                                   SNO,
                                   TERMSANDCONDITIONHEADCODE,
                                   TERMSANDCONDITION
                                    --taxrulecode            
                            )
                            Values (
                                :tno                    ,
                                :sno                    ,
                                :TERMSANDCONDITIONHEADCODE               ,
                                :TERMSANDCONDITION                    
                            );
                        
                        when 'U' then
                            update salesquotationtac Set
                                   TNO              = :tno,
                                   SNO              = :sno,
                                   TERMSANDCONDITIONHEADCODE = :TERMSANDCONDITIONHEADCODE,
                                   TERMSANDCONDITION = :TERMSANDCONDITION
                                  
                            WHERE TNO = :P705_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From salesquotationtac
                            Where TNo = :P705_TNO
                              and SNO = :SNO
                              ;
                    end case;
                    end if;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 60
        }
        advanced {
            executionMappingIdentifier: 8874444743508827
        }
    )

