    pageItem P705_AGENTCODE (
        type: popupLov
        label {
            label: Agent
            alignment: left
        }
        settings {
            fetchOnSearch: true
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select
                a.PartyName as AgentName,
                a.PartyCode as AgentCode
                from Party a
                where a.PartyTypeCode = 'AGENT'
                and GetDocumentStatusCode('PARTY', A.TNO) = 'ACTIVE'
                And Exists (Select 1
                      From partycompany aa
                     Where aa.tno = a.tno
                       And aa.companycode = :GLOBAL_COMPANYCODE)
                order by 1
                ```
            displayNullValue: false
        }
        layout {
            sequence: 90
            region: @general-2
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--stretchInputs
            ]
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
