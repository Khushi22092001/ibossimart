    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(100) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P705_Tno is null then
                        Select GlobalTno.NextVal into :P705_Tno From Dual;
                     end if;
                    ----
                    if :P705_SALESQUOTATIONNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P705_LocationCode,
                					:P705_DocTypeCode,
                					NULL,
                					TO_DATE(:P705_SALESQUOTATIONDATE, 'DD-MM-RRRR')
                				);
                        :P705_SALESQUOTATIONNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P705_LocationCode,
                                    :P705_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P705_SALESQUOTATIONDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8900600308508838
        }
    )

    process get-tno (
        name: Get TNo
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                If :P705_TNO is null then
                    :P705_TNO := GlobalTNo.nextval;
                    :P705_FORMSTATUS := 'NEWRECORD';
                else
                    
                    :P705_FORMSTATUS := 'EDITRECORD';
                    select 
                GetTransactionTypeCodeFor(:P705_PARTYCODE , :P705_LOCATIONCODE , :P705_DOCTYPECODE , :P705_COMPANYCODE , :P705_SALESQUOTATIONDATE) as A INTO :P705_TRANSACTIONTYPECODE  
                from dual ;
                End if;
                
                :P705_STATUS := nvl(GetDocumentStatusCode(getModuleCodeForPageNo(:APP_PAGE_ID), :P705_TNO), 'Status');
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8899844226508838
        }
    )

    process getonthetable (
        name: GetOnTheTable
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                tmp  number;
                tmp1 number;
                begin
                 -------- Checking Module Flow Prepared Or Not 
                   select count(*) into tmp1 from moduleflow where modulecode = getModuleCodeForPageNo(:APP_PAGE_ID) and getdocumentstatuscode('MODULEFLOW',TNO)='ACTIVE';
                   if nvl(tmp1,0) > 0 then
                       :P705_MODULEFLOW := 'YES';
                   else
                       :P705_MODULEFLOW := 'NO';
                   end if;
                  
                  ----- Checking On The Table 
                   select count(*) into tmp from onthetable_apex where moduletno = :P705_TNO and loginname = :GLOBAL_LOGINNAME;
                   if nvl(tmp,0) > 0 then
                      :P705_ONTHETABLE := 'YES' ;
                   else
                       :P705_ONTHETABLE := 'NO';
                   end if;
                end;
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8900296425508838
        }
    )

