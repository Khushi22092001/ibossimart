            )

            displayColumn SREQUESTQUANTITY (
                sequence: 13
            )

            displayColumn SUOM (
                sequence: 15
            )

            sort (
                column: ISSUEDATE
                sort {
                    direction: desc
                    sequence: 1
                }
            )

            sort (
                column: DEPARTMENTNAME
                sort {
                    sequence: 2
                }
            )

            aggregate (
                column: PISSUEQUANTITY
            )

            aggregate (
                column: PREQUESTQUANTITY
            )

            aggregate (
                column: AMOUNT
            )

        )

        savedReport 44705 (
            visibility: alternativeDefault
            name: Group by Item/Department
            view {
                groupBy: true
                default: groupBy
                rowsPerPage: 50
            }

            displayColumn AMOUNT (
                sequence: 16
            )

            displayColumn CREATIONTIME (
                sequence: 20
            )

            displayColumn CREATOR (
                sequence: 19
            )

            displayColumn DEPARTMENTNAME (
                sequence: 1
            )

            displayColumn DIFFERENCEPQUANTITY (
                sequence: 17
            )

            displayColumn DIFFERENCESQUANTITY (
                sequence: 18
            )

            displayColumn ISSUEDATE (
                sequence: 2
            )

            displayColumn ISSUEDTO (
                sequence: 5
            )

