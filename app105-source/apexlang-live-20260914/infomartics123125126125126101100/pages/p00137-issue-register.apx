                sort {
                    sequence: 1
                }
            )

            sort (
                column: ISSUEDATE
                sort {
                    sequence: 2
                }
            )

            groupByColumn (
                column: MATERIALDETAIL
                layout {
                    sequence: 1
                }
            )

            groupByColumn (
                column: DEPARTMENTNAME
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: Total Primary Qty
                aggregate {
                    column: PISSUEQUANTITY
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 1
                }
            )

            groupByAggregate (
                heading: Total Secondary Qty
                aggregate {
                    column: SISSUEQUANTITY
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 2
                }
            )

            groupByAggregate (
                heading: Avg Rate
                aggregate {
                    function: average
                    column: RATE
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 3
                }
            )

            groupByAggregate (
                heading: Total Amount
                aggregate {
                    column: AMOUNT
                    displaySum: true
                }
                appearance {
                    formatMask: 999G999G999G999G990D00
                }
                layout {
                    sequence: 4
                }
            )

        )

