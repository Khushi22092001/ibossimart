            )

            displayColumn MATERIALDETAIL (
                sequence: 9
            )

            displayColumn PISSUEQUANTITY (
                sequence: 11
            )

            displayColumn PREQUESTQUANTITY (
                sequence: 10
            )

            displayColumn PRINT (
