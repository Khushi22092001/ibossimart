        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct  PAGETNO,
                       TNO,
                       PARTYNAME,
                       ITEMNATURE,
                       ITEMNAME,
                       UNLOADINGDATE,
                       PARTYCODE,
                       REFERENCEMODULECODE,
                       REFERENCEMODULENO,
                       PODETAIL,
                       PONO,
                       PASSQUANTITY,
                       PARTYBILLDATE,
                       AGENTNAME,
                       REFERENCEMODULEAMOUNT,
                       PURCHASEBILLAMOUNT,
                       PAIDAMOUNT,
                       BALANCEAMOUNT,
                       DUEDATE,
                       REFERENCEMODULETNO,
                       SELECTED
                  from PAYBLEBILLS_TEMP
                  where pagetno = :P251_TNO
                    
                ```
            pageItemsToSubmit: P251_TNO
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
