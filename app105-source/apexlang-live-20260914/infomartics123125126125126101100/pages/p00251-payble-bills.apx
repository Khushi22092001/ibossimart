    process detail-save-interactive-grid-data (
        name: DETAIL - Save Interactive Grid Data
        type: executeCode
        editableRegion: @detail
        source {
            plsqlCode:
                ```plsql
                Begin
                    case :APEX$ROW_STATUS
                        when 'C' then
                            if :SNO is null then
                                select globaltno.nextval into :sno from dual;
                            end if;
                            Insert Into RTGSLETTERDETAIL  (                 
                                    TNO,
                                    SNO,
                                    PAYMENTADVICETNO,
                                    AMOUNT,
                                    REMARK
                
                            )
                            Values (
                                :TNO,
                                :SNO,
                                :PAYMENTADVICETNO,
                                :AMOUNT,
                                :REMARK
                
                            );
                        
                        when 'U' then
                            update RTGSLETTERDETAIL  Set
                                 TNO=:TNO,
                                SNO=:SNO,
                                PAYMENTADVICETNO=:PAYMENTADVICETNO,
                                AMOUNT=:AMOUNT,
                                REMARK=:REMARK
                
                            WHERE TNO = :P251_TNO
                              and rowid = :ROWID;
                
                        when 'D' then
                            Delete From RTGSLETTERDETAIL 
                            Where TNo = :P251_TNO
                              and SNO = :SNO
                              ;
                    end case;
                exception when others then
                    raise_application_error(-20010, sqlerrm);
                End;
                
                
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 78669535998742432
        }
    )

    process get-document-no (
        name: Get Document No
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    tModuleCode varchar2(30) := getModuleCodeForPageNo(:APP_PAGE_ID);
                    tmp         number ;
                begin
                     if :P251_Tno is null then
                        Select GlobalTno.NextVal into :P251_Tno From Dual;
                     end if;
                    ----
                    if :P251_RTGSLETTERNO is null then
                            SetDocNoNext(
                					tModuleCode,
                					:global_CompanyCode,
                					:global_FinancialYearCode,
                					:P251_LocationCode,
                					:P251_DocTypeCode,
                					NULL,
                					TO_DATE(:P251_RTGSLETTERDATE, 'DD-MM-RRRR')
                				);
                        :P251_RTGSLETTERNO := GetDocNo(
                                    tModuleCode,
                                    :global_CompanyCode,
                                    :global_FinancialYearCode,
                                    :P251_LocationCode,
                                    :P251_DocTypeCode,
                                    NULL,
                                    TO_DATE(:P251_RTGSLETTERDATE, 'DD-MM-RRRR')
                                    );
                    end if;
                    
                end;
                ```
        }
