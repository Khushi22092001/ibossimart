page 681 (
    name: Specification 360
    alias: SPECIFICATION-360
    title: Specification 360
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }
    advanced {
        reloadOnSubmit: always
    }
    help {
        helpText:
            ```html
            SPECIFICATION 360 — data contract.
            
            THE SMALLEST PAGE IN THE SUITE, DELIBERATELY. It answers exactly one question:
            who supplies this exact specification of this item, and at what rate. No chart,
            no master record, no trend — those live on Item 360 (page 679), which is where
            this page is reached from. Six regions is the whole design, not an unfinished
            one.
            
            GRAIN: ITEM *AND* SPECIFICATION. The subject is the pair
            (P681_ITEMCODE, P681_SPEC). Both arrive fixed from the Specification Mix report
            on page 679 and are NOT switchable here — you change specification by going back
            and clicking a different row, which keeps the reconciliation honest.
            P681_UOM is an optional narrowing carried through from the parent page.
            
            THE ~NONE~ SENTINEL. A line booked with no specification recorded is its own
            group, arriving as the literal '~NONE~', never as NULL:
                nvl(d.ItemSpecificationCode,'~NONE~') = :P681_SPEC
            A NULL would be read as "all specifications" and would total the wrong
            population — this page would show more than the row that was clicked. The same
            applies to P681_UOM.
            
            RECONCILIATION CONTRACT. The base query is the SAME three-level realised-rate
            ladder as page 679, so Purchase Value and Avg Realised Rate here must equal the
            Spend and Avg Rate on the specification row that was clicked. If they differ, the
            two copies of the ladder have drifted apart.
            
            THIS LADDER IS COPIED, NOT SHARED. APEXlang has no shared-SQL construct, so 679
            and 681 each carry an inlined copy. They MUST be kept in sync by discipline. In
            any rebuild, factor this into a database view or function so they cannot drift.
            
            PREMIUM IS ARITHMETIC ONLY. Suppliers are ranked cheapest first and the premium
            is measured against the best source. It is NOT quality-adjusted — this ERP holds
            no quality or service rating to adjust with.
            
            PANEL SECURITY. Scalar-subquery form on every region, as elsewhere in the suite.
            
            READ-ONLY. Every region is a SELECT.
            ```
    }

    region command-header (
        name: Specification 360
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  '<div class="ds-purchase-head">'
                  || '<div class="ds-purchase-head-eyebrow">Specification 360</div>'
                  || '<h1 class="ds-purchase-head-title">'
                     || apex_escape.html(
                          Case When :P681_SPEC = '~NONE~' Then 'No specification recorded'
                               Else nvl((Select s.ItemSpecificationName
                                           From ItemSpecification s
                                          Where s.ItemSpecificationCode = :P681_SPEC),
                                        nvl(:P681_SPEC,'No specification selected')) End)
                     || '</h1>'
                  || '<p class="ds-purchase-head-sub">Every supplier of this exact '
                  || 'specification, on one realised-rate basis, so cheapest and dearest '
                  || 'source are directly comparable.</p>'
                  || '<div class="ds-purchase-head-context">'
                  -- The parent item is context, not the subject, so it follows the spec.
                  || '<span class="ds-purchase-head-chip">Item <b>'
                     || apex_escape.html(nvl((Select i.ItemName From Item i
                                               Where i.ItemCode = :P681_ITEMCODE),
                                             nvl(:P681_ITEMCODE,'not set')))
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Unit <b>'
                     || apex_escape.html(
                          Case When :P681_UOM = '~NONE~' Then 'No unit recorded'
                               Else nvl((Select m.MeasuringUnitName From MeasuringUnit m
                                          Where m.MeasuringUnitCode = :P681_UOM),
                                        nvl(:P681_UOM,'All units')) End)
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Period <b>'
                     || apex_escape.html(:P681_FROMDATE) || ' &rarr; '
                     || apex_escape.html(:P681_TODATE) || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Company <b>'
                     || apex_escape.html(nvl(GetCompanyName(:P681_COMPANY),'All companies'))
                     || '</b></span>'
                  || '<span class="ds-purchase-head-chip">Location <b>'
                     || apex_escape.html(nvl(GetLocationName(:P681_LOCATION),'All locations'))
                     || '</b></span>'
                  || Case
                       When (Select GetUserPanelAB_apex() From dual) Is Not Null
                       Then '<span class="ds-purchase-head-chip">Panel <b>'
                            || apex_escape.html((Select GetUserPanelAB_apex() From dual))
                            || ' (enforced)</b></span>'
                       Else '<span class="ds-purchase-head-chip">Panel <b>'
                            || apex_escape.html(nvl(:P681_PANEL,'A + B')) || '</b></span>'
                     End
                  || '</div></div>' As HEAD
                From dual
                ```
            pageItemsToSubmit: [
                P681_ITEMCODE
                P681_SPEC
                P681_UOM
                P681_FROMDATE
                P681_TODATE
                P681_COMPANY
                P681_LOCATION
                P681_PANEL
            ]
        }
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: ds-purchase-headregion
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: Header unavailable.
        }

        column HEAD (
            reportColumnQueryId: 1
            derivedColumn: N
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Whole header as one HTML string. Both sentinels are decoded to readable phrases rather than printed raw.
            }
        )

    )

