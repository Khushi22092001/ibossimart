                comments: Technical drill key. Never displayed.
            }
        )

        column PREMIUM_PCT (
            type: plainText
            heading {
                heading: Premium vs Best %
            }
            layout {
                sequence: 90
                columnAlignment: end
            }
            appearance {
                formatMask: FM9990D0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: J
            }
            comments {
                comments: How much dearer than the cheapest source of this exact specification. Zero marks the best source. Arithmetic only — not quality-adjusted.
            }
        )

        column QUANTITY (
            type: plainText
            heading {
                heading: Quantity
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G990D000
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Quantity in the carried unit. Comparable down the column only because the unit is fixed for the page.
            }
        )

        column SHARE_PCT (
            type: plainText
            heading {
                heading: Share of Spend %
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            appearance {
                formatMask: FM990D0
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: K
            }
            comments {
                comments: How much of this specification's spend goes to each source. A high share on a high-premium supplier is the finding worth acting on.
            }
        )

        column SPEND (
            type: plainText
            heading {
                heading: Spend
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Money booked with this supplier. Summing this column reproduces the Purchase Value KPI.
            }
        )

        column SUPPLIER (
            type: link
            heading {
                heading: Supplier
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 669
                    items: {
                        P669_SUPPLIER: #PARTYCODE#
                        P669_FROMDATE: &P681_FROMDATE.
                        P669_TODATE: &P681_TODATE.
                        P669_COMPANY: &P681_COMPANY.
                        P669_LOCATION: &P681_LOCATION.
                        P669_PANEL: &P681_PANEL.
                    }
                    clearCache: 669
                    debug: NO
                }
                linkText: #SUPPLIER#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            comments {
                comments: Drills to Supplier 360 for the whole supplier. The item and specification are deliberately not carried — that page is a supplier dossier.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    pageItem P681_COMPANY (
        type: popupLov
        label {
            label: Company
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select c.CompanyName d, c.CompanyCode r
                  From Company c
                 Where Exists (Select 1 From PurchaseBill h
                                Where h.CompanyCode = c.CompanyCode
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or h.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All companies
        }
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 5
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Narrows both regions to one company.
        }
    )

    pageItem P681_FROMDATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 40
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                Select to_char(FinancialYearBegin,'DD-MM-RRRR')
                  From FinancialYear
                 Where trunc(sysdate) Between FinancialYearBegin And FinancialYearEnd
                   And rownum = 1
                ```
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Start of the reporting period. Arrives from Item 360.
        }
    )

    pageItem P681_ITEMCODE (
        type: hidden
        layout {
            sequence: 10
            region: @filter-bar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Half the subject of this page, fixed on arrival from Item 360. To change item, go back rather than editing this — it keeps the reconciliation honest.
        }
    )

    pageItem P681_LOCATION (
        type: popupLov
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select l.LocationName d, l.LocationCode r
                  From Location l
                 Where Exists (Select 1 From PurchaseBill fb
                                Where fb.LocationCode = l.LocationCode
                                  And (:P681_COMPANY Is Null
                                       Or fb.CompanyCode = :P681_COMPANY)
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or fb.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All locations
        }
        cascadingLov {
            parentItems: P681_COMPANY
            itemsToSubmit: P681_COMPANY
        }
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 7
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Cascades from Company.
        }
    )

    pageItem P681_PANEL (
        type: selectList
        label {
            label: Panel
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:A;A,B;B
            nullDisplayValue: A + B
        }
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 9
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: GetUserPanelAB_apex() Is Null
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Hidden when your login is already bound to a panel. The select list is the control; the SQL predicate on every region is the enforcement.
        }
    )

    pageItem P681_SPEC (
        type: hidden
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: The other half of the subject, sentinel-aware. A line with no specification arrives as the literal ~NONE~ so it forms its own group instead of being read as "all specifications".
        }
    )

    pageItem P681_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 50
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: End of the reporting period.
        }
    )

    pageItem P681_UOM (
        type: hidden
        layout {
            sequence: 30
            region: @filter-bar
            slot: regionBody
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Optional unit narrowing carried through from Item 360. Also sentinel-aware. When empty the rates mix units and are not comparable, and the Quantity card says so.
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 90
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back-to-item (
        buttonName: BACKTOITEM
        label: Item 360
        layout {
            sequence: 100
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-arrow-left
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 679
                items: {
                    P679_ITEMCODE: &P681_ITEMCODE.
                    P679_UOM: &P681_UOM.
                    P679_FROMDATE: &P681_FROMDATE.
                    P679_TODATE: &P681_TODATE.
                    P679_COMPANY: &P681_COMPANY.
                    P679_LOCATION: &P681_LOCATION.
                    P679_PANEL: &P681_PANEL.
                }
                clearCache: 679
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

