    region purchase-by-fy (
        name: Purchase by Financial Year
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select fy.FinancialYearCode As FIN_YEAR,
                       Round(Sum(d.Amount) / 10000000, 2) As VALUE_CR,
                       Min(fy.FinancialYearBegin) As SORT_KEY
                  From PurchaseBill h
                  Join PurchaseBillDetail d On d.TNo = h.TNo
                  Join FinancialYear fy
                    On h.PurchaseBillDate Between fy.FinancialYearBegin
                                              And fy.FinancialYearEnd
                 Where ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                   And (:P668_COMPANY  Is Null Or h.CompanyCode  = :P668_COMPANY)
                   And (:P668_LOCATION Is Null Or h.LocationCode = :P668_LOCATION)
                   And (:P668_SUPPLIER Is Null Or h.PartyCode    = :P668_SUPPLIER)
                 Group By fy.FinancialYearCode
                 Order By SORT_KEY
                ```
            pageItemsToSubmit: [
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
                P668_SUPPLIER
            ]
        }
        layout {
            sequence: 53
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 270
        }
        messages {
            whenNoDataFound: No purchase bills exist for this company, location and panel in any financial year.
        }

        series by-fy (
            name: Purchase Value (Rs Cr)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: FIN_YEAR
                value: VALUE_CR
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Cr
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

