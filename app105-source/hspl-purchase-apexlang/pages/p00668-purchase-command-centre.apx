    region reg-e-billpass (
        name: Bill Pass Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select p.PBPassNo                      As PASS_NO,
                       p.PBPassDate                    As PASS_DATE,
                       GetPartyName(h.PartyCode)       As SUPPLIER,
                       p.PBPassAmount                  As PASS_AMOUNT,
                       p.PaidAmount                    As PAID,
                       p.DueDate                       As DUE_DATE
                  From PBPass p
                  Join PurchaseBill h On h.TNo = p.PurchaseBillTNo
                 Where p.PBPassNo Is Not Null
                   And p.PBPassDate Between to_date(:P668_FROMDATE,'DD-MM-RRRR') And to_date(:P668_TODATE,'DD-MM-RRRR')
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or p.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL    Is Null Or p.Panel        = :P668_PANEL)
                   And (:P668_COMPANY  Is Null Or p.CompanyCode  = :P668_COMPANY)
                   And (:P668_LOCATION Is Null Or p.LocationCode = :P668_LOCATION)
