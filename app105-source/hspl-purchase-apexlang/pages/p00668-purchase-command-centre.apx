            }
            comments {
                comments: "n of N" rather than a bare percentage, so the reader sees the population the share is drawn from.
            }
        )

        column MEASURE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Measure
            }
            layout {
                sequence: 10
            }
            comments {
                comments: What is being counted. Deliberately phrased as coverage, never as brokerage value.
            }
        )

        column MEASURED_FROM (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Measured From
            }
            layout {
                sequence: 40
            }
            comments {
                comments: Names the exact source column, and flags the agent column as a placeholder whenever only one distinct code is in use — a high coverage figure from a single repeated code is not attribution.
            }
        )

        column SEQ (
            reportColumnQueryId: 1
            derivedColumn: N
