    region reg-e-bill (
        name: Purchase Bill Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select b.PurchaseBillNo                As BILL_NO,
                       b.PurchaseBillDate              As BILL_DATE,
                       GetPartyName(b.PartyCode)       As SUPPLIER,
                       b.PartyBillNo                   As PARTY_BILL_NO,
                       b.PartyBillDate                 As PARTY_BILL_DATE,
                       b.PurchaseBillAmount            As BILL_AMOUNT,
                       GetLocationName(b.LocationCode) As LOCATION
                  From PurchaseBill b
                 Where b.PurchaseBillNo Is Not Null
                   And b.PurchaseBillDate Between to_date(:P668_FROMDATE,'DD-MM-RRRR') And to_date(:P668_TODATE,'DD-MM-RRRR')
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or b.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL    Is Null Or b.Panel        = :P668_PANEL)
                   And (:P668_COMPANY  Is Null Or b.CompanyCode  = :P668_COMPANY)
                   And (:P668_LOCATION Is Null Or b.LocationCode = :P668_LOCATION)
                   And (:P668_SUPPLIER Is Null Or b.PartyCode    = :P668_SUPPLIER)
                 Order By b.PurchaseBillDate Desc, b.PurchaseBillNo Desc
