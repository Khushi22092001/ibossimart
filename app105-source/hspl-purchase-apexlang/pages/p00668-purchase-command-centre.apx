    region exception-detail (
        name: Documents Behind the Exception
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P668_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P668_TODATE,'DD-MM-RRRR')   T
                         From dual)
                -- RULE 10 — bill booked but never passed.
                Select h.PurchaseBillNo As DOCUMENT_NO,
                       h.PurchaseBillDate As DOCUMENT_DATE,
                       GetPartyName(h.PartyCode) As PARTY,
                       GetLocationName(h.LocationCode) As LOCATION,
                       'Purchase Bill' As DOCUMENT_TYPE,
                       Round(Sum(d.Amount) / 100000, 2) As VALUE_LAC
                  From PurchaseBill h
                  Join PurchaseBillDetail d On d.TNo = h.TNo
                 Cross Join Win w
                 Where :P668_EXC_FOCUS = '10'
                   And h.PurchaseBillDate Between w.F And w.T
                   And Not Exists (Select 1 From PBPass p Where p.PurchaseBillTNo = h.TNo)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                   And (:P668_SUPPLIER Is Null Or h.PartyCode  = :P668_SUPPLIER)
                 Group By h.PurchaseBillNo, h.PurchaseBillDate, h.PartyCode, h.LocationCode
                Union All
                -- RULE 20 — paid more than passed.
                Select p.PBPassNo, p.PBPassDate, GetPartyName(h.PartyCode),
                       GetLocationName(h.LocationCode), 'Bill Pass',
                       Round((p.PaidAmount - p.PBPassAmount) / 100000, 2)
                  From PBPass p
                  Join PurchaseBill h On h.TNo = p.PurchaseBillTNo
                 Cross Join Win w
                 Where :P668_EXC_FOCUS = '20'
                   And h.PurchaseBillDate Between w.F And w.T
                   And nvl(p.PaidAmount,0) > nvl(p.PBPassAmount,0)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                Union All
                -- RULE 30 — passed, no settlement recorded on the bill.
                -- NOTE: the register does NOT filter this rule by supplier, so neither does
                -- this branch. The drill must never be shorter than the count.
                Select p.PBPassNo, p.PBPassDate, GetPartyName(h.PartyCode),
                       GetLocationName(h.LocationCode), 'Bill Pass',
                       Round(p.PBPassAmount / 100000, 2)
                  From PBPass p
                  Join PurchaseBill h On h.TNo = p.PurchaseBillTNo
                 Cross Join Win w
                 Where :P668_EXC_FOCUS = '30'
                   And h.PurchaseBillDate Between w.F And w.T
                   And nvl(p.PaidAmount,0) = 0
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                Union All
                -- RULE 40 — goods received, no bill. VALUE_LAC is NULL, not zero.
                Select g.GrnNo, g.GrnDate, GetPartyName(g.PartyCode),
                       GetLocationName(g.LocationCode), 'GRN', Null
                  From Grn g Cross Join Win w
                 Where :P668_EXC_FOCUS = '40'
                   And g.GrnDate Between w.F And w.T
                   And Not Exists (Select 1 From PurchaseBillGRNDetail pg
                                    Where pg.GRNTno = g.TNo)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or g.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or g.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or g.CompanyCode = :P668_COMPANY)
                Union All
                -- RULE 50 — receipts with a rejected quantity.
                Select g.GrnNo, g.GrnDate, GetPartyName(g.PartyCode),
                       GetLocationName(g.LocationCode), 'GRN', Null
                  From Grn g Cross Join Win w
                 Where :P668_EXC_FOCUS = '50'
                   And g.GrnDate Between w.F And w.T
                   And Exists (Select 1 From GrnDetail gd
                                Where gd.TNo = g.TNo And nvl(gd.RejectedQuantity1,0) > 0)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or g.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or g.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or g.CompanyCode = :P668_COMPANY)
                Union All
                -- RULE 60 — material in, receipt never prepared. Predicates repeated
                -- from the register verbatim, including the date window, so this drill can
                -- never be shorter than the count that opened it.
                Select mi.MaterialInNo, mi.MaterialInDate,
                       nvl(mi.VehicleNo,'no vehicle recorded'),
                       GetLocationName(mi.LocationCode),
                       'Material In (no GRN prepared)', Null
                  From MaterialIn mi Cross Join Win w
                 Where :P668_EXC_FOCUS = '60'
                   And mi.MaterialInDate Between w.F And w.T
                   And nvl(mi.IsGrnPrepared,'NO') <> 'YES'
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or mi.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or mi.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or mi.CompanyCode = :P668_COMPANY)
                Union All
                -- RULE 70 — enquiry with no quotation.
                Select e.EnquiryNo, e.EnquiryDate, nvl(e.Subject,'no subject recorded'),
                       GetLocationName(e.LocationCode), 'Enquiry', Null
                  From Enquiry e Cross Join Win w
                 Where :P668_EXC_FOCUS = '70'
                   And e.EnquiryDate Between w.F And w.T
                   And Not Exists (Select 1 From Quotation q Where q.EnquiryTno = e.TNo)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or e.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or e.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or e.CompanyCode = :P668_COMPANY)
                Union All
                -- RULE 80 — order raised with no credit terms.
                Select o.PurchaseOrderNo, o.PurchaseOrderDate,
                       GetPartyName(o.PartyCode), GetLocationName(o.LocationCode),
                       'Purchase Order', Round(Sum(od.Amount)/100000, 2)
                  From PurchaseOrder o
                  Join PurchaseOrderDetail od On od.TNo = o.TNo
                 Cross Join Win w
                 Where :P668_EXC_FOCUS = '80'
                   And o.PurchaseOrderDate Between w.F And w.T
                   And nvl(o.CreditDays,0) = 0
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or o.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or o.CompanyCode = :P668_COMPANY)
                   And (:P668_SUPPLIER Is Null Or o.PartyCode  = :P668_SUPPLIER)
                 Group By o.PurchaseOrderNo, o.PurchaseOrderDate, o.PartyCode, o.LocationCode
                Union All
                -- RULE 90 — open order not fully received.
                Select o.PurchaseOrderNo, o.PurchaseOrderDate,
                       GetPartyName(o.PartyCode), GetLocationName(o.LocationCode),
                       'Purchase Order',
                       Round(Sum(od.Amount * (od.Quantity1
                         - Least(nvl(od.ReceivedQuantity1,0), od.Quantity1))
                         / od.Quantity1) / 100000, 2)
                  From PurchaseOrder o
                  Join PurchaseOrderDetail od On od.TNo = o.TNo
                 Cross Join Win w
                 Where :P668_EXC_FOCUS = '90'
                   And o.PurchaseOrderDate Between w.F And w.T
                   And nvl(od.Quantity1,0) > 0
                   And nvl(od.ReceivedQuantity1,0) < od.Quantity1
                   And Not Exists (Select 1 From PurchaseOrderClose poc
                                    Where poc.PurchaseOrderTNo = o.TNo)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or o.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or o.CompanyCode = :P668_COMPANY)
                   And (:P668_SUPPLIER Is Null Or o.PartyCode  = :P668_SUPPLIER)
                 Group By o.PurchaseOrderNo, o.PurchaseOrderDate, o.PartyCode, o.LocationCode
                ```
            pageItemsToSubmit: [
                P668_EXC_FOCUS
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_PANEL
                P668_SUPPLIER
            ]
        }
        layout {
            sequence: 96
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                ds-register
                ds-exc-detailwrap
            ]
        }
        advanced {
            htmlDomId: p668ExcDetail
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Pick a count in the Exception Register above to list the documents behind it.
        }
        advanced {
            savedReportMappingIdentifier: 21518960243436136
        }

        column DOCUMENT_DATE (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            appearance {
                formatMask: DD-Mon-RRRR
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
            comments {
                comments: Document date, as recorded on the source document.
            }
        )

        column DOCUMENT_NO (
            type: plainText
            heading {
                heading: Document No
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
            comments {
                comments: The document's own business number. Internal TNo values are never shown.
            }
        )

        column DOCUMENT_TYPE (
            type: plainText
            heading {
                heading: Document Type
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Which document the branch returned, so mixed result sets stay readable.
            }
        )

        column LOCATION (
            type: plainText
            heading {
                heading: Location
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            comments {
                comments: Location that owns the document.
            }
        )

        column PARTY (
            type: plainText
            heading {
                heading: Party / Reference
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            comments {
                comments: Supplier for bill and GRN rules; vehicle or subject for the gate and enquiry rules.
            }
        )

        column VALUE_LAC (
            type: plainText
            heading {
                heading: Value (Rs Lac)
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
            comments {
                comments: NULL — not zero — on rules the ERP cannot quantify. Summing this column reproduces the register's Value at Stake for the quantifiable rules.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DOCUMENT_DATE (
                sequence: 2
            )

            displayColumn DOCUMENT_NO (
                sequence: 1
            )

            displayColumn DOCUMENT_TYPE (
                sequence: 5
            )

            displayColumn LOCATION (
                sequence: 4
            )

            displayColumn PARTY (
                sequence: 3
            )

            displayColumn VALUE_LAC (
                sequence: 6
            )

        )

    )

    region exceptions (
        name: Exception Register
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P668_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P668_TODATE,'DD-MM-RRRR')   T
                         From dual),
                Rules As (
                  -- 10. HIGH — bill booked but never passed.
                  Select 10 Seq, 'HIGH' Sev,
                         'Bill booked but never passed' Rule,
                         Count(Distinct h.TNo) Items,
                         Sum(d.Amount) Val,
                         'The liability is on the books but has not been approved, so it is '
                         || 'not yet in the ledger.' Impact
                    From PurchaseBill h
                    Join PurchaseBillDetail d On d.TNo = h.TNo
                   Cross Join Win w
                   Where h.PurchaseBillDate Between w.F And w.T
                     And Not Exists (Select 1 From PBPass p Where p.PurchaseBillTNo = h.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                     And (:P668_SUPPLIER Is Null Or h.PartyCode  = :P668_SUPPLIER)
                  Union All
                  -- 20. HIGH — paid more than the passed amount.
                  Select 20, 'HIGH',
                         'Paid more than the passed amount',
                         Count(*), Sum(p.PaidAmount - p.PBPassAmount),
                         'Settlement exceeds the approved figure on these bills.'
                    From PBPass p
                    Join PurchaseBill h On h.TNo = p.PurchaseBillTNo
                   Cross Join Win w
                   Where h.PurchaseBillDate Between w.F And w.T
                     And nvl(p.PaidAmount,0) > nvl(p.PBPassAmount,0)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                  Union All
                  -- 30. MEDIUM — passed with no settlement recorded ON THE BILL.
                  -- The impact text is a SENTENCE, not a number: PaidAmount is only written
                  -- for one settlement route, so a rupee figure here would assert more than
                  -- the data supports. Company-level truth is on the KPI strip.
                  Select 30, 'MEDIUM',
                         'Passed with no settlement recorded on the bill',
                         Count(*), Sum(p.PBPassAmount),
                         'No advice settlement against these bills. They may still have been '
                         || 'paid by direct voucher — check the supplier ledger.'
                    From PBPass p
                    Join PurchaseBill h On h.TNo = p.PurchaseBillTNo
                   Cross Join Win w
                   Where h.PurchaseBillDate Between w.F And w.T
                     And nvl(p.PaidAmount,0) = 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                  Union All
                  -- 40. MEDIUM — goods received but no purchase bill. NOT QUANTIFIABLE:
                  -- GrnDetail carries no value in this ERP, so there is no exposure figure.
                  -- Now QUANTIFIED: the receipt is priced from its order line, the same
                  -- way the GRN Receipts card is. Receipts with no traceable order still
                  -- contribute to the count but not to the value, so this is a floor.
                  Select 40, 'MEDIUM',
                         'Goods received but no purchase bill',
                         Count(Distinct g.TNo),
                         Sum(gd.ReceivedQuantity1 * od.Rate),
                         'Stock taken in with no supplier invoice against it. Valued at the '
                         || 'order-line rate; receipts with no traceable order add to the '
                         || 'count but not to the value.'
                    From Grn g
                    Join GrnDetail gd On gd.TNo = g.TNo
                    Left Join PurchaseOrderDetail od
                           On od.TNo = g.PurchaseOrderTNo And od.ItemCode = gd.ItemCode
                   Cross Join Win w
                   Where g.GrnDate Between w.F And w.T
                     And Not Exists (Select 1 From PurchaseBillGRNDetail pg
                                      Where pg.GRNTno = g.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or g.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or g.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or g.CompanyCode = :P668_COMPANY)
                  Union All
                  -- 50. MEDIUM — receipts carrying a rejected quantity.
                  Select 50, 'MEDIUM',
                         'Receipts with a rejected quantity',
                         Count(Distinct g.TNo), Null,
                         'Quality was rejected at receipt. Quantities cross incompatible '
                         || 'units, so no single exposure figure is possible.'
                    From Grn g
                    Join GrnDetail gd On gd.TNo = g.TNo
                   Cross Join Win w
                   Where g.GrnDate Between w.F And w.T
                     And nvl(gd.RejectedQuantity1,0) > 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or g.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or g.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or g.CompanyCode = :P668_COMPANY)
                  Union All
                  -- 60. LOW — material in, receipt never prepared.
                  -- This REPLACES a "vehicle still inside the premises" rule. That rule
                  -- needed GateInTime/GateOutTime, which are too sparsely populated to
                  -- support a control finding — see the Material In to Receipt panel, which
                  -- prints the measured coverage. The gate-to-receipt handover IS reliably
                  -- recorded, via MaterialIn.GRNTNo, so that is what is policed instead.
                  Select 60, 'LOW',
                         'Material In awaiting a receipt',
                         Count(*), To_Number(Null),
                         'Gate entry recorded but no GRN prepared against it. Stock may be '
                         || 'on site without being taken into books.'
                    From MaterialIn mi Cross Join Win w
                   Where mi.MaterialInDate Between w.F And w.T
                     And nvl(mi.IsGrnPrepared,'NO') <> 'YES'
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or mi.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or mi.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or mi.CompanyCode = :P668_COMPANY)
                  Union All
                  -- 70. LOW — enquiry floated, no quotation received.
                  Select 70, 'LOW',
                         'Enquiry floated, no quotation received',
                         Count(*), Null,
                         'The tender went unanswered. There is no value to attach to an '
                         || 'enquiry that produced nothing.'
                    From Enquiry e Cross Join Win w
                   Where e.EnquiryDate Between w.F And w.T
                     And Not Exists (Select 1 From Quotation q Where q.EnquiryTno = e.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or e.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or e.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or e.CompanyCode = :P668_COMPANY)
                  Union All
                  -- 80. HIGH — order raised with no credit terms.
                  -- This is the rule that makes bill ageing impossible, so it is graded HIGH
                  -- even though nothing is technically wrong with the order itself: without
                  -- credit days there is no due date, and without a due date "overdue"
                  -- cannot be computed for any bill against that order.
                  Select 80, 'HIGH',
                         'Order raised with no credit terms',
                         Count(Distinct o.TNo), Sum(od.Amount),
                         'Bill ageing cannot be derived without credit days, so none of the '
                         || 'spend behind these orders can ever be reported as overdue.'
                    From PurchaseOrder o
                    Join PurchaseOrderDetail od On od.TNo = o.TNo
                   Cross Join Win w
                   Where o.PurchaseOrderDate Between w.F And w.T
                     And nvl(o.CreditDays,0) = 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or o.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or o.CompanyCode = :P668_COMPANY)
                     And (:P668_SUPPLIER Is Null Or o.PartyCode  = :P668_SUPPLIER)
                  Union All
                  -- 90. MEDIUM — open order not fully received. Pending value is pro-rated
                  -- within the line; the ERP stores no pending-value column.
                  Select 90, 'MEDIUM',
                         'Open order not fully received',
                         Count(Distinct o.TNo),
                         Sum(od.Amount * (od.Quantity1
                           - Least(nvl(od.ReceivedQuantity1,0), od.Quantity1)) / od.Quantity1),
                         'Committed spend with material still outstanding. Pending value is '
                         || 'pro-rated within the line — the ERP stores no pending-value column.'
                    From PurchaseOrder o
                    Join PurchaseOrderDetail od On od.TNo = o.TNo
                   Cross Join Win w
                   Where o.PurchaseOrderDate Between w.F And w.T
                     And nvl(od.Quantity1,0) > 0
                     And nvl(od.ReceivedQuantity1,0) < od.Quantity1
                     And Not Exists (Select 1 From PurchaseOrderClose poc
                                      Where poc.PurchaseOrderTNo = o.TNo)
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or o.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or o.CompanyCode = :P668_COMPANY)
                     And (:P668_SUPPLIER Is Null Or o.PartyCode  = :P668_SUPPLIER))
                Select
                  r.Seq,
                  '<span class="ds-sev ds-sev--' || lower(r.Sev) || '">'
                  || apex_escape.html(initcap(r.Sev)) || '</span>' As SEVERITY,
                  apex_escape.html(r.Rule) As RULE_TEXT,
                  -- The drill anchor. Rule id travels in data-k, never the wording.
                  '<a class="ds-exc-drill" href="javascript:void(0);" data-k="' || r.Seq || '">'
                  || to_char(r.Items,'FM999G999G990') || '</a>' As ITEMS,
                  Case When r.Val Is Null
                       Then '<span class="ds-muted">not quantifiable</span>'
                       Else '<b>'
                            || Case When r.Val >= 10000000
                                    Then 'Rs ' || to_char(Round(r.Val/10000000,2),'FM99G990D00') || ' Cr'
                                    When r.Val >= 100000
                                    Then 'Rs ' || to_char(Round(r.Val/100000,2),'FM99G990D00') || ' L'
                                    Else 'Rs ' || to_char(r.Val,'FM99G99G990D00') End
                            || '</b>' End As VALUE_AT_STAKE,
                  '<span class="ds-muted">' || apex_escape.html(r.Impact) || '</span>' As IMPACT
                From Rules r
                Where r.Items > 0
                Order By r.Seq
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_PANEL
                P668_SUPPLIER
            ]
        }
