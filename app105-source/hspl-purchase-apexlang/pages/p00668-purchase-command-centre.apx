    pageItem P668_SUPPLIER (
        type: popupLov
        label {
            label: Supplier
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct GetPartyName(h.PartyCode) d, h.PartyCode r
                  From PurchaseBill h
                 Where ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All suppliers
        }
        layout {
            sequence: 10
            region: @filter-drawer
            slot: regionBody
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Narrows to one supplier. The concentration charts deliberately ignore this filter — a "top suppliers" chart narrowed to one supplier would leave a single bar.
        }
    )

    pageItem P668_TODATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 2
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: expression
            plsqlExpression: to_char(trunc(sysdate),'DD-MM-RRRR')
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: End of the reporting period. Defaults to today. The Order Book window is measured backwards from this date, not from the newest row in the table.
        }
    )

    pageItem P668_TRANSPORTER (
        type: popupLov
        label {
            label: Transporter
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Distinct t.TransporterName d, t.TransporterCode r
                  From Transporter t
                 Where Exists (Select 1 From FreightAdvice f
                                Where f.TransporterCode = t.TransporterCode
                                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                                       Or f.Panel = (Select GetUserPanelAB_apex() From dual)))
                 Order By 1
                ```
            displayExtraValues: false
            nullDisplayValue: All transporters
        }
        layout {
            sequence: 40
            region: @filter-drawer
            slot: regionBody
            column: 1
            columnSpan: 12
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
        }
        security {
            encryptSessionState: false
        }
        help {
            helpText: Affects freight only. Freight is not attributable to the material supplier, so the freight measures deliberately ignore the Supplier filter.
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 60
            region: @filter-bar
            slot: regionBody
            column: 1
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-refresh
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button open-filters (
        buttonName: OPENFILTERS
        label: More Filters
        layout {
            sequence: 70
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 3
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-sliders
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.theme.openRegion('p668Drawer');
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reset-filters (
        buttonName: RESETFILTERS
        label: Reset All Filters
        layout {
            sequence: 80
            region: @filter-bar
            slot: regionBody
            startNewRow: false
            column: 6
            columnSpan: 3
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 668
                clearCache: 668
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction install-drills (
        name: Install Drill Handlers
        execution {
            sequence: 10
        }
        when {
            event: ready
        }

        action bind (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    // Delegate on document: the drill anchors sit inside lazy-loaded
                    // reports, so a directly-bound handler would miss rows added later.
                    // One command header only: the app renders its own page-title card,
                    // and the hero band below repeats it. Fold them into one by removing
                    // the top card (CSS handles it too; this is the guaranteed fallback).
                    var _c = document.querySelector('.hspl-hero-card');
                    if (_c) { _c.style.setProperty('display', 'none', 'important'); }
                    // Navy sidebar: the theme paints the nav in a CSS layer no stylesheet
                    // can override, so set the gradient inline on the nav container.
                    var _nav = document.getElementById('t_Body_nav');
                    if (_nav) {
                      // keep the sidebar fixed while the page scrolls (it was position:relative
                      // and scrolled away with the content).
                      _nav.style.setProperty('position','sticky','important');
                      _nav.style.setProperty('top','50px','important');
                      _nav.style.setProperty('height','calc(100vh - 50px)','important');
                      _nav.style.setProperty('align-self','flex-start','important');
                      _nav.style.setProperty('overflow-y','auto','important');
                    }
                    // Quick-period chips: set the two date items and submit,
                    // just like typing the dates and pressing Apply.
                    // KPI cards drill in-page: scroll to and flash the region that
                    // holds the card's underlying data.
                    apex.jQuery(document).off('click.p668kpi')
                      .on('click.p668kpi', '.ds-kpi--clickable', function () {
                        var id = this.getAttribute('data-kpi-goto');
                        var t = id && document.getElementById(id);
                        if (!t) return;
                        t.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        t.classList.add('ds-flash');
                        setTimeout(function(){ t.classList.remove('ds-flash'); }, 1400);
                      });
                    apex.jQuery(document).off('click.p668period')
                      .on('click.p668period', '.ds-period', function () {
                        var r = this.getAttribute('data-range');
                        var now = new Date(), f, t = now;
                        var pad = function (n) { return ('0' + n).slice(-2); };
                        var fmt = function (d) {
                          return pad(d.getDate()) + '-' + pad(d.getMonth() + 1) + '-' + d.getFullYear();
                        };
                        if (r === 'month') { f = new Date(now.getFullYear(), now.getMonth(), 1); }
                        else if (r === 'quarter') { f = new Date(now.getFullYear(), Math.floor(now.getMonth() / 3) * 3, 1); }
                        else if (r === 'fy') { var y = now.getMonth() >= 3 ? now.getFullYear() : now.getFullYear() - 1; f = new Date(y, 3, 1); }
                        else if (r === 'd30') { f = new Date(now); f.setDate(f.getDate() - 29); }
                        else { f = new Date(now); f.setDate(f.getDate() - 89); }
                        apex.item('P668_FROMDATE').setValue(fmt(f));
                        apex.item('P668_TODATE').setValue(fmt(t));
                        apex.page.submit();
                      });
                    /* The stage / execution drill handler now lives in hspl-theme.js
                       (delegated on .ds-stage-drill/.ds-exec-drill/.ds-exc-drill). It is
                       kept out of this page's jsCode so the block stays under the 4000-byte
                       limit and can carry the dedicated-register show/hide logic. */
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

)

