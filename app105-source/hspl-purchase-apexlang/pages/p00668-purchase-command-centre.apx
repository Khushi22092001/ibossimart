    region reg-s-enquiry (
        name: Enquiry Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select e.EnquiryNo                    As ENQUIRY_NO,
                       e.EnquiryDate                  As ENQUIRY_DATE,
                       GetLocationName(e.LocationCode) As LOCATION,
                       e.Subject                      As SUBJECT,
                       e.Remark                       As REMARK
                  From Enquiry e
                 Where e.EnquiryNo Is Not Null
                   And e.EnquiryDate Between to_date(:P668_FROMDATE,'DD-MM-RRRR') And to_date(:P668_TODATE,'DD-MM-RRRR')
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or e.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL    Is Null Or e.Panel        = :P668_PANEL)
                   And (:P668_COMPANY  Is Null Or e.CompanyCode  = :P668_COMPANY)
