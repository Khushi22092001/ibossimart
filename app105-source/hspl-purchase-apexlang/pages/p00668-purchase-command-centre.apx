    region route-split (
        name: How Orders Were Sourced
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select Route, Count(*) Orders
                  From (
                    Select Case
                             When o.QuotationTno Is Not Null Then 'Tender'
                             When o.IndentTno    Is Not Null Then 'Direct indent'
                             Else 'Ad hoc'
                           End Route
                      From PurchaseOrder o
                     Where o.PurchaseOrderDate
                           Between to_date(:P668_FROMDATE,'DD-MM-RRRR')
                               And to_date(:P668_TODATE,'DD-MM-RRRR')
                       And ((Select GetUserPanelAB_apex() From dual) Is Null
                            Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                       And (:P668_PANEL Is Null Or o.Panel = :P668_PANEL)
                       And (:P668_COMPANY  Is Null Or o.CompanyCode  = :P668_COMPANY)
                       And (:P668_LOCATION Is Null Or o.LocationCode = :P668_LOCATION)
                       And (:P668_SUPPLIER Is Null Or o.PartyCode    = :P668_SUPPLIER))
                 Group By Route
                 Order By Orders Desc
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
                P668_SUPPLIER
            ]
        }
        layout {
            sequence: 32
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 270
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No purchase orders were raised in this period and scope.
        }

        series route (
            name: Orders
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: ROUTE
                value: ORDERS
            }
            label {
                show: true
                position: outsideSlice
            }
        )

    )

    region rule-exceptions (
        name: Exceptions and Control
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Exceptions &amp; Control</h2>
                  <p>Control failures worth acting on, each with a severity and the value at
                     stake. Click a count to list the documents behind it. Rules that would
                     fire on the whole population are deliberately absent — a rule that always
                     fires is noise, not control. Where the ERP cannot quantify the exposure,
                     the register says so instead of showing zero.</p>
                </div>
                ```
        }
        layout {
            sequence: 90
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-flow (
        name: Flow Over Time
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Flow Over Time</h2>
                  <p>Monthly purchase value, and the live position at the gate. The trend is a
                     single series by design — a count and a value never share an axis.</p>
                </div>
                ```
        }
        layout {
            sequence: 49
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-logistics (
        name: Logistics and Intermediaries
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Logistics &amp; Intermediaries</h2>
                  <p>Freight by transporter, and how much of the buying is routed through a
                     broker or agent. <strong>Brokerage value is not stored in this ERP</strong>
                     &mdash; only a commission <em>rate</em> exists &mdash; so coverage is
                     reported and never a rupee figure. Where a column turns out to be a
                     placeholder rather than real attribution, the panel says so.</p>
                </div>
                ```
        }
        layout {
            sequence: 80
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-material (
        name: What Is Being Bought
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>What Is Being Bought</h2>
                  <p>Top items by value, and the split by unit of measure. Quantity is
                     reported <em>within</em> each unit and is never totalled across the
                     report — showing that a cross-unit total is not available is the whole
                     point of the second panel.</p>
                </div>
                ```
        }
        layout {
            sequence: 70
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-orderbook (
        name: Order Book
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Order Book</h2>
                  <p>Orders raised in the last ten days, and the full order-to-payment cycle
                     per supplier. The ten-day window is measured backwards from the
                     <em>To&nbsp;Date</em> above, not from the newest row in the table &mdash;
                     order dates contain keying errors, and anchoring to the newest row would
                     land the window in empty space.</p>
                </div>
                ```
        }
        layout {
            sequence: 46
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-pipeline (
        name: Purchase-to-Pay
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Purchase-to-Pay Execution</h2>
                  <p>Document flow from order to payment, with conversion against the order
                     stage. Gate entry and goods receipt carry <em>no value</em> by design —
                     GrnDetail holds no usable rate or amount in this ERP — so those cells
                     render an en-dash rather than a zero.</p>
                  <p class="ds-clickhint"><span class="ds-clickhint-ic fa fa-hand-o-up"></span> Click any <strong>stage</strong> in the table below &mdash; its full register opens in <strong>&ldquo;Documents Behind the Execution Stage&rdquo;</strong> right underneath.</p>
                </div>
                ```
        }
        layout {
            sequence: 36
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-pulse (
        name: Procurement Pulse
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Procurement Pulse</h2>
                  <p>Where the period stands. Value is the taxable bill line
                     (PurchaseBillDetail.Amount) and reconciles to the Purchase Bill Register.
                     Each card compares against the immediately preceding period of equal
                     length, and says so plainly where there is no prior period.</p>
                </div>
                ```
        }
        layout {
            sequence: 15
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-quickreports (
        name: Quick Reports
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Quick Reports</h2>
                  <p>Every drill page and register this dashboard feeds, in one place. Each
                     opens carrying the period, company and location selected above, so you
                     land already scoped rather than re-entering the filters.</p>
                </div>
                ```
        }
        layout {
            sequence: 110
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-register (
        name: Purchase Bill Register
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Purchase Bill Register</h2>
                  <p>Every bill in scope, with its pass and settlement position. The
                     <em>supplier's own</em> bill number is shown — internal document keys
                     are never displayed. Summing Line Value here reproduces the Total
                     Purchase Value card at the top of the page.</p>
                </div>
                ```
        }
        layout {
            sequence: 100
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-sourcing (
        name: Sourcing Funnel
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Sourcing Funnel</h2>
                  <p>How demand became an order. Requisition is drawn as a standalone stage,
                     not as the head of the funnel — Indent.RequisitionTno is not populated,
                     and drawing the arrow would invent a relationship the data does not
                     support.</p>
                  <p class="ds-clickhint"><span class="ds-clickhint-ic fa fa-hand-o-up"></span> Click any <strong>stage</strong> in the table below &mdash; its full register opens in <strong>&ldquo;Documents Behind the Stage&rdquo;</strong> right underneath.</p>
                </div>
                ```
        }
        layout {
            sequence: 25
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region rule-supplier (
        name: Where the Money Goes
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="ds-purchase-section">
                  <h2>Where the Money Goes</h2>
                  <p>Concentration by supplier and by location, then the full supplier table
                     with an ABC classification. The two charts deliberately ignore the
                     supplier and location filters — a "value by supplier" chart narrowed to
                     one supplier would leave a single bar.</p>
                </div>
                ```
        }
        layout {
            sequence: 57
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region sourcing-funnel (
        name: Sourcing Stages
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P668_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P668_TODATE,'DD-MM-RRRR')   T
                         From dual),
                Stg As (
                  -- Requisition is NOT a stage here. Indent.RequisitionTno is not populated,
                  -- so a requisition cannot be tied to the indent that followed it — showing
                  -- it as the head of the funnel would draw a relationship the data does not
                  -- support. The funnel starts where demand becomes traceable.
                  Select 10 Seq, 'Indent' Stage, 'fa-list-alt' Ic, 'Direct route' Route,
                         Count(*) Docs,
                         'Internal demand for material. No supplier chosen yet. An indent '
                         || 'can go straight to a purchase order.' Meaning
                    From Indent x Cross Join Win w
                   Where x.IndentDate Between w.F And w.T
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                  Union All
                  Select 20, 'Enquiry', 'fa-question-circle-o', 'Tender route', Count(*),
                         'Formal tender floated to the market. Sent to several suppliers '
                         || 'at once.'
                    From Enquiry x Cross Join Win w
                   Where x.EnquiryDate Between w.F And w.T
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                  Union All
                  -- Quotations OUTNUMBER enquiries, and that is correct rather than a
                  -- defect: several suppliers quote against one enquiry. The meaning column
                  -- says so, because a reader watching a "funnel" widen will otherwise
                  -- assume the figures are wrong.
                  Select 30, 'Quotation', 'fa-comments-o', 'Tender route', Count(*),
                         'Supplier responses against an enquiry. Outnumbers enquiries '
                         || 'because several suppliers quote on each one.'
                    From Quotation x Cross Join Win w
                   Where x.QuotationDate Between w.F And w.T
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                  Union All
                  Select 40, 'Comparative Statement', 'fa-balance-scale', 'Tender route',
                         Count(*),
                         'Quotations set side by side so the buying decision is recorded '
                         || 'rather than assumed.'
                    From ComparativeStatement x Cross Join Win w
                   Where x.ComparativeStatementDate Between w.F And w.T
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                  Union All
                  Select 50, 'Purchase Order', 'fa-shopping-cart', 'Both routes', Count(*),
                         'The commitment placed on the supplier. Both routes converge here, '
                         || 'and everything downstream is measured from it.'
                    From PurchaseOrder x Cross Join Win w
                   Where x.PurchaseOrderDate Between w.F And w.T
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                     And (:P668_SUPPLIER Is Null Or x.PartyCode = :P668_SUPPLIER))
                Select
                  s.Seq,
                  -- Stage layout is an INLINE STYLE, not a stylesheet class. The label is an
                  -- anchor inside a report cell, and the theme's `td a` rules keep knocking
                  -- the icon chip out of the flex line. An inline style outranks any
                  -- stylesheet rule without needing !important.
                  '<a class="ds-stage-drill" href="javascript:void(0);" data-k="' || s.Seq || '"'
                  || ' style="display:inline-flex;align-items:center;'
                  || 'gap:9px;font-weight:600;text-decoration:none;">'
                  || '<span style="display:grid;place-items:center;width:26px;height:26px;'
                  || 'font-size:12px;border-radius:7px;color:var(--ds-dash-gold);background:var(--ds-dash-gold-bg);'
                  || 'flex:0 0 auto;"><span class="fa ' || s.Ic || '"></span></span>'
                  || apex_escape.html(s.Stage) || '</a>' As STAGE,
                  '<span class="ds-pill ds-pill--'
                  || Case s.Route When 'Tender route'  Then 'info'
                                  When 'Direct route'  Then 'accent'
                                  Else 'muted' End
                  || '">' || apex_escape.html(s.Route) || '</span>' As ROUTE,
                  s.Docs As DOCS,
                  -- Share against the LARGEST stage, not the first. These stages are not a
                  -- strict funnel, so a drop-off bar would misrepresent them.
                  '<span class="ds-sharecell"><span class="ds-bar ds-bar--gold"><i style="width:'
                  || to_char(Round(100 * s.Docs / Nullif(Max(s.Docs) Over (),0),1),'FM99999990D0')
                  || '%"></i></span></span>' As VOLUME,
                  '<span class="ds-muted">' || apex_escape.html(s.Meaning) || '</span>'
                    As MEANING
                From Stg s
                Order By s.Seq
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_PANEL
                P668_SUPPLIER
            ]
        }
        layout {
            sequence: 30
            slot: body
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No sourcing documents were raised in this period and scope.
        }

        column DOCS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Documents
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G990
            }
            comments {
                comments: COUNT(*) of documents raised in the period at this stage.
            }
        )

        column MEANING (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: What This Stage Means
            }
            layout {
                sequence: 50
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Plain-language reading guidance. Carries the explanation for why quotations exceed enquiries, which otherwise reads as a data error.
            }
        )

        column ROUTE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Route
            }
            layout {
                sequence: 20
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Which sourcing route the stage belongs to. Requisition is deliberately absent — Indent.RequisitionTno is not populated, so the link cannot be drawn honestly.
            }
        )

        column SEQ (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
            comments {
                comments: Sort key. MUST stay projected — APEX may eliminate an ORDER BY on a column absent from the select list, which silently reorders the funnel.
            }
        )

        column STAGE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Stage
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Stage name as a drill anchor to its own register. Flex layout is inline style because the theme's td a rules outrank stylesheet classes.
            }
        )

        column VOLUME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Relative Volume
            }
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Share bar against the LARGEST stage, not against the first. These stages are not a strict funnel — quotations outnumber enquiries by design — so a drop-off bar would misrepresent them.
            }
        )

    )

    region stage-detail (
        name: Documents Behind the Stage
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P668_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P668_TODATE,'DD-MM-RRRR')   T
                         From dual)
                -- Each branch repeats its stage's predicates from Sourcing Stages VERBATIM.
                -- A drill-down shorter than the count that opened it is the one failure mode
                -- that may never happen.
                Select x.IndentNo                                     As DOCUMENT_NO,
                       x.IndentDate                                   As DOCUMENT_DATE,
                       'Indent'                                       As STAGE,
                       GetLocationName(x.LocationCode)                As LOCATION,
                       Cast(Null As Varchar2(240))                    As PARTY,
                       'Department ' || x.DepartmentCode              As DETAIL,
                       Cast(Null As Number) As VALUE_RS
                  From Indent x Cross Join Win w
                 Where :P668_STAGE_FOCUS = '10'
                   And x.IndentDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                Union All
                Select x.EnquiryNo                                    As DOCUMENT_NO,
                       x.EnquiryDate                                  As DOCUMENT_DATE,
                       'Enquiry'                                      As STAGE,
                       GetLocationName(x.LocationCode)                As LOCATION,
                       Cast(Null As Varchar2(240))                    As PARTY,
                       'Generated for ' || x.GeneratedFor             As DETAIL,
                       Cast(Null As Number) As VALUE_RS
                  From Enquiry x Cross Join Win w
                 Where :P668_STAGE_FOCUS = '20'
                   And x.EnquiryDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                Union All
                Select x.QuotationNo                                  As DOCUMENT_NO,
                       x.QuotationDate                                As DOCUMENT_DATE,
                       'Quotation'                                    As STAGE,
                       GetLocationName(x.LocationCode)                As LOCATION,
                       GetPartyName(x.PartyCode)                      As PARTY,
                       'Valid to ' || to_char(x.ValidityDate,'DD-Mon-RRRR') As DETAIL,
                       x.QuotationAmount As VALUE_RS
                  From Quotation x Cross Join Win w
                 Where :P668_STAGE_FOCUS = '30'
                   And x.QuotationDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                Union All
                Select x.ComparativeStatementNo                       As DOCUMENT_NO,
                       x.ComparativeStatementDate                     As DOCUMENT_DATE,
                       'Comparative Statement'                        As STAGE,
                       GetLocationName(x.LocationCode)                As LOCATION,
                       Cast(Null As Varchar2(240))                    As PARTY,
                       'Against enquiry ' || to_char(x.EnquiryTNo)    As DETAIL,
                       Cast(Null As Number) As VALUE_RS
                  From ComparativeStatement x Cross Join Win w
                 Where :P668_STAGE_FOCUS = '40'
                   And x.ComparativeStatementDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                Union All
                Select x.PurchaseOrderNo                              As DOCUMENT_NO,
                       x.PurchaseOrderDate                            As DOCUMENT_DATE,
                       'Purchase Order'                               As STAGE,
                       GetLocationName(x.LocationCode)                As LOCATION,
                       GetPartyName(x.PartyCode)                      As PARTY,
                       'Delivery ' || to_char(x.DeliveryDate,'DD-Mon-RRRR') As DETAIL,
                       x.PurchaseOrderAmount As VALUE_RS
                  From PurchaseOrder x Cross Join Win w
                 Where :P668_STAGE_FOCUS = '50'
                   And x.PurchaseOrderDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                   And (:P668_SUPPLIER Is Null Or x.PartyCode = :P668_SUPPLIER)
                Order By 2 Desc, 1
                ```
            pageItemsToSubmit: [
                P668_STAGE_FOCUS
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
                P668_SUPPLIER
            ]
        }
        layout {
            sequence: 35
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                ds-register
                ds-exc-detailwrap
            ]
        }
        advanced {
            htmlDomId: p668StageDetail
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: Click a stage in Sourcing Stages above to list its documents here.
        }
        advanced {
            savedReportMappingIdentifier: 22811790511443110
        }

        column DETAIL (
            type: plainText
            heading {
                heading: Reference
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
