    region quick-reports (
        name: Quick Reports
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Ctx As (
                       Select :P668_FROMDATE F, :P668_TODATE T,
                              :P668_COMPANY C, :P668_LOCATION L, :P668_PANEL P
                         From dual),
                Tile As (
                  -- Suite pages: full context, including panel.
                  Select 10 Seq, 'Supplier 360' Nm, 'fa-user-circle-o' Ic,
                         'One supplier: ordered, received, billed, passed, paid, outstanding' D,
                         apex_page.get_url(
                           p_page => 669, p_clear_cache => '669',
                           p_items => 'P669_FROMDATE,P669_TODATE,P669_COMPANY,P669_LOCATION,P669_PANEL',
                           p_values => F||','||T||','||C||','||L||','||P) Url
                    From Ctx
                  Union All
                  Select 20, 'Item 360', 'fa-cube',
                         'One item and unit: realised rate, specification mix, vendor comparison',
                         apex_page.get_url(
                           p_page => 679, p_clear_cache => '679',
                           p_items => 'P679_FROMDATE,P679_TODATE,P679_COMPANY,P679_LOCATION,P679_PANEL',
                           p_values => F||','||T||','||C||','||L||','||P)
                    From Ctx
                  Union All
                  Select 30, 'Purchase Order 360', 'fa-shopping-cart',
                         'One order: lines, receipts, bills and what is still pending',
                         apex_page.get_url(p_page => 682, p_clear_cache => '682')
                    From dual
                  Union All
                  Select 40, 'Purchase Analytics', 'fa-line-chart',
                         'Spend by grain and dimension, vendor scorecard, price movement, executive exceptions',
                         apex_page.get_url(
                           p_page => 683, p_clear_cache => '683',
                           p_items => 'P683_FROMDATE,P683_TODATE,P683_COMPANY,P683_LOCATION,P683_PANEL',
                           p_values => F||','||T||','||C||','||L||','||P)
                    From Ctx
                  Union All
                  Select 35, 'Purchase Bill 360', 'fa-file-text-o',
                         'One supplier invoice: lines, pass, settlement and the receipts behind it',
                         apex_page.get_url(p_page => 680, p_clear_cache => '680')
                    From dual
                  Union All
                  -- Legacy registers: each takes only the items it actually defines.
                  Select 50, 'Purchase Bill Register', 'fa-file-text-o',
                         'Supplier invoices booked against receipts',
                         apex_page.get_url(
                           p_page => 73, p_clear_cache => '73',
                           p_items => 'P73_FROMDATE,P73_TODATE,P73_COMPANY,P73_LOCATION',
                           p_values => F||','||T||','||C||','||L)
                    From Ctx
                  Union All
                  Select 60, 'Purchase Order Register', 'fa-list-alt',
                         'Every order raised in the period',
                         apex_page.get_url(
                           p_page => 27, p_clear_cache => '27',
                           p_items => 'P27_FROMDATE,P27_TODATE,P27_COMPANY,P27_LOCATION',
                           p_values => F||','||T||','||C||','||L)
                    From Ctx
                  Union All
                  Select 70, 'Bill Pass Register', 'fa-check-square-o',
                         'Bills approved for payment and posted to the ledger',
                         apex_page.get_url(p_page => 75, p_clear_cache => '75')
                    From dual
                  Union All
                  Select 80, 'GRN Register', 'fa-truck',
                         'Material accepted into stock',
                         apex_page.get_url(p_page => 37, p_clear_cache => '37')
                    From dual
                  Union All
                  Select 90, 'Material In Register', 'fa-sign-in',
                         'Vehicles booked in at the gate',
                         apex_page.get_url(p_page => 36, p_clear_cache => '36')
                    From dual
                  Union All
                  Select 100, 'Indent Register', 'fa-file-o',
                         'Internal demand raised before a supplier is chosen',
                         apex_page.get_url(p_page => 15, p_clear_cache => '15')
                    From dual
                  Union All
                  Select 110, 'Quotation Register', 'fa-comments-o',
                         'Supplier responses against enquiries',
                         apex_page.get_url(p_page => 72, p_clear_cache => '72')
                    From dual
                  Union All
                  Select 120, 'Comparative Statement Register', 'fa-balance-scale',
                         'Quotations set side by side before the buying decision',
                         apex_page.get_url(p_page => 497, p_clear_cache => '497')
                    From dual
                  Union All
                  Select 130, 'Freight Advice Register', 'fa-road',
                         'The transporter billing document, the only defensible freight figure',
                         apex_page.get_url(p_page => 172, p_clear_cache => '172')
                    From dual
                  Union All
                  Select 140, 'Account Ledger', 'fa-book',
                         'The supplier ledger — the settled position that survives every route',
                         apex_page.get_url(
                           p_page => 178, p_clear_cache => '178',
                           p_items => 'P178_FROMDATE,P178_TODATE,P178_LOCATION',
                           p_values => F||','||T||','||L)
                    From Ctx)
                Select
                  t.Seq,
                  '<a class="ds-gateway" href="' || t.Url || '">'
                  || '<span class="ds-gateway-ic"><span class="fa ' || t.Ic || '"></span></span>'
                  || '<span class="ds-gateway-body">'
                  || '<span class="ds-gateway-t">' || apex_escape.html(t.Nm) || '</span>'
                  || '<span class="ds-gateway-d">' || apex_escape.html(t.D) || '</span>'
                  || '</span>'
                  || '<span class="ds-gateway-go"><span class="fa fa-chevron-right"></span></span>'
                  || '</a>' As TILE
                From Tile t
                Order By t.Seq
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
            ]
        }
        layout {
            sequence: 112
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-kpiwrap
                ds-kpiwrap--cols
                ds-kpiwrap--gateway
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: Quick reports unavailable.
        }

        column SEQ (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
            comments {
                comments: Tile order — suite 360 pages first, then the registers. Must stay projected so APEX cannot eliminate the ORDER BY.
            }
        )

        column TILE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Report
            }
            layout {
                sequence: 10
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: One gateway card per destination. Built with apex_page.get_url in SQL because every row targets a different page, which a classic-report link column cannot do. Each URL passes only the items its target actually defines.
            }
        )

    )

    region recent-orders (
        name: Orders in the Last 10 Days
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                  o.PurchaseOrderNo As ORDER_NO,
                  o.PurchaseOrderDate As ORDER_DATE,
                  GetPartyName(o.PartyCode) As SUPPLIER,
                  GetLocationName(o.LocationCode) As LOCATION,
                  nvl((Select dt.DocTypeName From DocType dt
                        Where dt.DocTypeCode = o.DocTypeCode), o.DocTypeCode) As TYPE,
                  Count(*) As LINES,
                  Sum(od.Amount) As ORDER_VALUE,
                  '<span class="ds-pill ds-pill--'
                  || Case
                       When Sum(Case When nvl(od.Quantity1,0) > 0
                                      And nvl(od.ReceivedQuantity1,0) >= od.Quantity1
                                     Then 1 Else 0 End) = Count(*) Then 'good'
                       When Sum(nvl(od.ReceivedQuantity1,0)) > 0 Then 'warn'
                       Else 'muted' End
                  || '">'
                  || Case
                       When Sum(Case When nvl(od.Quantity1,0) > 0
                                      And nvl(od.ReceivedQuantity1,0) >= od.Quantity1
                                     Then 1 Else 0 End) = Count(*) Then 'Fully received'
                       When Sum(nvl(od.ReceivedQuantity1,0)) > 0 Then 'Part received'
                       Else 'Awaiting material' End
                  || '</span>' As STATUS,
                  o.PartyCode As PARTYCODE,
                  o.TNo As PO_TNO
                From PurchaseOrder o
                Join PurchaseOrderDetail od On od.TNo = o.TNo
                Where o.PurchaseOrderDate
                      >  to_date(:P668_TODATE,'DD-MM-RRRR') - 10
                  And o.PurchaseOrderDate <= to_date(:P668_TODATE,'DD-MM-RRRR')
                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                       Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                  And (:P668_PANEL Is Null Or o.Panel = :P668_PANEL)
                  And (:P668_COMPANY  Is Null Or o.CompanyCode  = :P668_COMPANY)
                  And (:P668_LOCATION Is Null Or o.LocationCode = :P668_LOCATION)
                  And (:P668_SUPPLIER Is Null Or o.PartyCode    = :P668_SUPPLIER)
                Group By o.PurchaseOrderNo, o.PurchaseOrderDate, o.PartyCode,
                         o.LocationCode, o.DocTypeCode, o.TNo
                Order By o.PurchaseOrderDate Desc, o.PurchaseOrderNo Desc
                ```
            pageItemsToSubmit: [
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
                P668_SUPPLIER
            ]
        }
        layout {
            sequence: 47
            slot: body
            columnSpan: 12
        }
