    region transporter-bar (
        name: Top 10 Transporters by Freight Billed
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select * From (
                  Select nvl((Select t.TransporterName From Transporter t
                               Where t.TransporterCode = f.TransporterCode),
                             'No transporter recorded') TRANSPORTER,
                         Round(Sum(f.FreightAdviceAmount) / 100000, 2) FREIGHT_LAC
                    From FreightAdvice f
                   Where f.FreightAdviceDate
                         Between to_date(:P668_FROMDATE,'DD-MM-RRRR')
                             And to_date(:P668_TODATE,'DD-MM-RRRR')
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or f.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or f.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or f.CompanyCode = :P668_COMPANY)
                     And (:P668_TRANSPORTER Is Null
                          Or f.TransporterCode = :P668_TRANSPORTER)
                   Group By f.TransporterCode
                   Order By Sum(f.FreightAdviceAmount) Desc)
                 Where rownum <= 10
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_PANEL
                P668_TRANSPORTER
            ]
        }
        layout {
            sequence: 85
            slot: body
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-dash-panel
        }
        advanced {
            htmlDomId: p668Transporter
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 380
        }
        messages {
            whenNoDataFound: No freight was billed in this period and scope.
        }

        series freight (
            name: Freight Billed (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: TRANSPORTER
                value: FREIGHT_LAC
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region trend-chart (
        name: Monthly Purchase Value
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ItemTree As (
                       Select ItemCode From Item
                        Where :P668_ITEMGROUP Is Not Null
                        Start With ItemCode = :P668_ITEMGROUP
                      Connect By Prior ItemCode = ParentCode
                       Union All
                       Select ItemCode From Item Where :P668_ITEMGROUP Is Null)
                Select
                  to_char(Trunc(h.PurchaseBillDate,'MM'),'Mon-RR') MONTH_LABEL,
                  Round(Sum(d.Amount) / 100000, 2) VALUE_LAC,
                  -- Projected so a bar click can rescope the whole dashboard to that month.
                  to_char(Trunc(h.PurchaseBillDate,'MM'),'DD-MM-RRRR') MONTH_FROM,
                  to_char(Last_Day(h.PurchaseBillDate),'DD-MM-RRRR')   MONTH_TO,
                  Trunc(h.PurchaseBillDate,'MM') SORT_KEY
                From PurchaseBill h
                Join PurchaseBillDetail d On d.TNo = h.TNo
                Where h.PurchaseBillDate
                      Between to_date(:P668_FROMDATE,'DD-MM-RRRR')
                          And to_date(:P668_TODATE,'DD-MM-RRRR')
                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                       Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                  And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                  And (:P668_COMPANY  Is Null Or h.CompanyCode  = :P668_COMPANY)
                  And (:P668_LOCATION Is Null Or h.LocationCode = :P668_LOCATION)
                  And (:P668_SUPPLIER Is Null Or h.PartyCode    = :P668_SUPPLIER)
                  And (:P668_ITEM     Is Null Or d.ItemCode     = :P668_ITEM)
                  And d.ItemCode In (Select ItemCode From ItemTree)
                Group By Trunc(h.PurchaseBillDate,'MM'), Last_Day(h.PurchaseBillDate)
                Order By SORT_KEY
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
                P668_SUPPLIER
                P668_ITEMGROUP
                P668_ITEM
            ]
        }
        layout {
            sequence: 50
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 270
        }
        messages {
            whenNoDataFound: No bills were booked in this period and scope, so there is nothing to plot.
        }

        series monthly-value (
            name: Purchase Value (Rs Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: MONTH_LABEL
                value: VALUE_LAC
            }
            link {
                type: redirectThisApp
                target: {
                    page: 668
                    items: {
                        P668_FROMDATE: &MONTH_FROM.
                        P668_TODATE: &MONTH_TO.
                        P668_COMPANY: &P668_COMPANY.
                        P668_LOCATION: &P668_LOCATION.
                        P668_PANEL: &P668_PANEL.
                        P668_SUPPLIER: &P668_SUPPLIER.
                        P668_ITEMGROUP: &P668_ITEMGROUP.
                        P668_ITEM: &P668_ITEM.
                    }
                }
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Rs Lac
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region uom-mix (
        name: Purchase Value by Unit of Measure
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ItemTree As (
                       Select ItemCode From Item
                        Where :P668_ITEMGROUP Is Not Null
                        Start With ItemCode = :P668_ITEMGROUP
                      Connect By Prior ItemCode = ParentCode
                       Union All
                       Select ItemCode From Item Where :P668_ITEMGROUP Is Null)
                Select
                  nvl(m.MeasuringUnitName,'No unit recorded') As UOM,
                  Sum(d.Amount) As VALUE_RS,
                  Sum(d.Quantity1) As QTY,
                  '<span class="ds-sharecell"><span class="ds-bar ds-bar--teal"><i style="width:'
                  || to_char(Round(100 * Sum(d.Amount)
                                 / Nullif(Sum(Sum(d.Amount)) Over (),0),1),'FM99999990D0')
                  || '%"></i></span><b>'
                  || to_char(Round(100 * Sum(d.Amount)
                                 / Nullif(Sum(Sum(d.Amount)) Over (),0),1),'FM99999990D0')
                  || '%</b></span>' As SHARE_PCT
                From PurchaseBill h
                Join PurchaseBillDetail d On d.TNo = h.TNo
                Left Join MeasuringUnit m
                       On m.MeasuringUnitCode = d.RateMeasuringUnitCode
                Where h.PurchaseBillDate
                      Between to_date(:P668_FROMDATE,'DD-MM-RRRR')
                          And to_date(:P668_TODATE,'DD-MM-RRRR')
                  And ((Select GetUserPanelAB_apex() From dual) Is Null
                       Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                  And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                  And (:P668_COMPANY  Is Null Or h.CompanyCode  = :P668_COMPANY)
                  And (:P668_LOCATION Is Null Or h.LocationCode = :P668_LOCATION)
                  And (:P668_SUPPLIER Is Null Or h.PartyCode    = :P668_SUPPLIER)
                  And d.ItemCode In (Select ItemCode From ItemTree)
                Group By nvl(m.MeasuringUnitName,'No unit recorded')
                Order By Sum(d.Amount) Desc
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
                P668_SUPPLIER
                P668_ITEMGROUP
            ]
        }
        layout {
            sequence: 77
            slot: body
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No billed lines in this period and scope.
        }

        column QTY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Quantity (within this unit)
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G990D000
            }
            comments {
                comments: Quantity is meaningful ONLY within its own row. Never sum this column — the units are incompatible.
            }
        )

        column SHARE_PCT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Share of Value
            }
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Share bar computed on value, which is the only additive measure here.
            }
        )

        column UOM (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Unit of Measure
            }
            layout {
                sequence: 10
            }
            comments {
                comments: Rate unit from PurchaseBillDetail.RateMeasuringUnitCode. Lines with no unit form their own group rather than being folded in.
            }
        )

        column VALUE_RS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Purchase Value
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            appearance {
                formatMask: FM999G999G999G990D00
            }
            comments {
                comments: Value is additive across units and therefore safe to total.
            }
        )

    )

