                ```sql
                Select
                  '<a class="ds-gateway" href="'
                  || apex_page.get_url(
                       p_page        => 683,
                       p_clear_cache => '683',
                       p_items       => 'P683_FROMDATE,P683_TODATE,P683_COMPANY,P683_LOCATION,P683_PANEL,P683_SUPPLIER,P683_ITEM,P683_ITEMGROUP',
                       p_values      =>    :P668_FROMDATE ||','|| :P668_TODATE
