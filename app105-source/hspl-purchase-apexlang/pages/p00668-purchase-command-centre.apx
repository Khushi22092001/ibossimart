    region material-in-receipt (
        name: Material In &rarr; Receipt
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P668_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P668_TODATE,'DD-MM-RRRR')   T
                         From dual),
                Mi As (
                  Select Count(*) Docs,
                         -- Measured: IsGrnPrepared carries YES / NO, nothing else.
                         Count(Case When mi.IsGrnPrepared = 'YES' Then 1 End) Booked,
                         Count(Case When nvl(mi.IsGrnPrepared,'NO') <> 'YES' Then 1 End) Awaiting,
                         Count(Distinct mi.VehicleNo) Vehicles,
                         Count(mi.VehicleNo) WithVehicle,
                         Count(mi.GateInTime) WithGateIn,
                         Count(Case When mi.GateInTime Is Not Null
                                     And mi.GateOutTime Is Null Then 1 End) OnSite
                    From MaterialIn mi Cross Join Win w
                   Where mi.MaterialInDate Between w.F And w.T
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or mi.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or mi.Panel = :P668_PANEL)
                     And (:P668_COMPANY  Is Null Or mi.CompanyCode  = :P668_COMPANY)
                     And (:P668_LOCATION Is Null Or mi.LocationCode = :P668_LOCATION))
                Select 10 Seq,
                       'Material In documents' As MEASURE,
                       to_char(Docs,'FM999G999G990') As FIGURE,
                       'Gate entries recorded in the period' As BASIS
                  From Mi
                Union All
                Select 20, 'Booked as a receipt',
                       to_char(Booked,'FM999G999G990')
                       || Case When Docs > 0
                               Then ' (' || to_char(Round(100*Booked/Docs,1),'FM99999990D0') || '%)'
                               Else '' End,
                       'MaterialIn.IsGrnPrepared = YES'
                  From Mi
                Union All
                Select 30, 'Awaiting a receipt',
                       to_char(Awaiting,'FM999G999G990'),
                       'Material taken in at the gate, GRN not yet prepared'
                  From Mi
                Union All
                Select 40, 'Distinct vehicles',
                       to_char(Vehicles,'FM999G999G990'),
                       'VehicleNo is populated on '
                       || Case When Docs > 0
                               Then to_char(Round(100*WithVehicle/Docs,3),'FM990D000') || '%'
                               Else 'no' End
                       || ' of gate entries'
                  From Mi
                Union All
                -- The self-disclosing row. Below 50% coverage the figure is suppressed and
                -- the reason is printed instead, because a confident-looking count drawn
                -- from a near-empty column is worse than no count at all.
                Select 50, 'Live gate occupancy',
                       Case When Docs > 0 And WithGateIn / Docs >= 0.5
                            Then to_char(OnSite,'FM999G999G990') || ' on site now'
                            Else '<span class="ds-muted">not recorded by this ERP</span>'
                       End,
                       'GateInTime populated on ' || to_char(WithGateIn,'FM999G999G990')
                       || ' of ' || to_char(Docs,'FM999G999G990') || ' rows in this window'
                  From Mi
                 Order By 1
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
            ]
        }
        layout {
            sequence: 52
            slot: body
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: [
                ds-dash-panel
                ds-register
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No material was booked in at the gate in this period and scope.
        }

        column BASIS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Basis
            }
            layout {
                sequence: 30
            }
            comments {
                comments: Names the exact column each figure comes from, and states the measured population so a reader can judge how much weight the figure carries.
            }
        )

        column FIGURE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Figure
                alignment: end
            }
            layout {
                sequence: 20
                columnAlignment: end
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Live gate occupancy renders "not recorded by this ERP" whenever GateInTime coverage falls below half the rows — the threshold is evaluated at run time, so the row starts reporting a real number if the column is ever populated properly.
            }
        )

        column MEASURE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Measure
            }
            layout {
                sequence: 10
            }
            comments {
                comments: What is being counted at the gate-to-receipt handover.
            }
        )

        column SEQ (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
            comments {
                comments: Row order. Must stay projected so APEX cannot eliminate the ORDER BY.
            }
        )

    )

    region order-cycle (
        name: Supplier Order-to-Payment Cycle
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P668_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P668_TODATE,'DD-MM-RRRR')   T
                         From dual),
                -- Unit comes from the ITEM master: PurchaseOrderDetail carries no rate-unit
                -- column in this application.
                Lines As (
                  Select o.PartyCode,
                         nvl((Select m.MeasuringUnitName From MeasuringUnit m
                               Where m.MeasuringUnitCode = i.MeasuringUnitCode1),
                             'no unit') Uom,
                         od.Quantity1 Qty,
                         Least(nvl(od.ReceivedQuantity1,0), od.Quantity1) Recd,
                         od.Amount Amt
                    From PurchaseOrder o
                    Join PurchaseOrderDetail od On od.TNo = o.TNo
                    Left Join Item i On i.ItemCode = od.ItemCode
                   Cross Join Win w
                   Where o.PurchaseOrderDate Between w.F And w.T
                     And nvl(od.Quantity1,0) > 0
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or o.Panel = :P668_PANEL)
                     And (:P668_COMPANY  Is Null Or o.CompanyCode  = :P668_COMPANY)
                     And (:P668_LOCATION Is Null Or o.LocationCode = :P668_LOCATION)
                     And (:P668_SUPPLIER Is Null Or o.PartyCode    = :P668_SUPPLIER)),
                PerUom As (
                  Select PartyCode, Uom, Sum(Qty) Qty, Sum(Recd) Recd
                    From Lines Group By PartyCode, Uom),
                Agg As (
                  Select PartyCode,
                         Count(*) UomCount,
                         listagg(to_char(Qty,'FM999G999G990') || ' ' || Uom, ' &middot; ')
                           Within Group (Order By Qty Desc) QtyText,
                         Sum(Qty) TotQty, Sum(Recd) TotRecd
                    From PerUom Group By PartyCode),
                Val As (
                  Select PartyCode, Sum(Amt) Ordered From Lines Group By PartyCode),
                Pss As (
                  Select h.PartyCode, Sum(p.PBPassAmount) Passed, Sum(p.PaidAmount) PaidAdv
                    From PBPass p
                    Join PurchaseBill h On h.TNo = p.PurchaseBillTNo
                   Cross Join Win w
                   Where h.PurchaseBillDate Between w.F And w.T
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                     And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                   Group By h.PartyCode)
                Select
                  a.PartyCode As PARTYCODE,
                  GetPartyName(a.PartyCode) As SUPPLIER,
                  a.QtyText As QUANTITY_ORDERED,
                  -- Suppressed on multi-unit suppliers: a ratio across incompatible units
                  -- would be arithmetic without meaning.
                  Case When a.UomCount = 1 And a.TotQty > 0
                       Then '<span class="ds-sharecell"><span class="ds-bar ds-bar--teal"><i style="width:'
                            || to_char(Least(Round(100*a.TotRecd/a.TotQty,1),100),'FM99999990D0')
                            || '%"></i></span><b>'
                            || to_char(Round(100*a.TotRecd/a.TotQty,1),'FM99999990D0') || '%</b></span>'
                       Else '<span class="ds-muted">mixed units</span>' End As RECEIVED,
                  v.Ordered As ORDERED,
                  p.Passed As PASSED,
                  p.PaidAdv As PAID,
                  Case When p.Passed Is Not Null
                       Then nvl(p.Passed,0) - nvl(p.PaidAdv,0) End As OUTSTANDING
                From Agg a
                Join Val v On v.PartyCode = a.PartyCode
                Left Join Pss p On p.PartyCode = a.PartyCode
                Order By v.Ordered Desc
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
                P668_SUPPLIER
            ]
        }
        layout {
            sequence: 48
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: ds-register
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: No supplier had orders in this period and scope.
        }
        advanced {
            savedReportMappingIdentifier: 21510741252436105
        }

        column ORDERED (
            type: plainText
            heading {
                heading: Ordered
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
            comments {
                comments: Committed order value in the period.
            }
        )

        column OUTSTANDING (
            type: plainText
            heading {
                heading: Outstanding
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
            comments {
                comments: Passed less paid on the advice basis. Null rather than zero where nothing has been passed, so an unpassed supplier does not read as fully settled.
            }
        )

        column PAID (
            type: plainText
            heading {
                heading: Paid (via advice)
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
            comments {
                comments: PBPass.PaidAmount. The heading names the basis because this column covers only the Payment Advice route — the ledger figure is on the KPI strip.
            }
        )

        column PARTYCODE (
            type: hidden
            heading {
                heading: Party Code
            }
            layout {
                sequence: 5
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
            comments {
                comments: Technical drill key. Never displayed.
            }
        )

        column PASSED (
            type: plainText
            heading {
                heading: Passed
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            appearance {
                formatMask: FM99G99G99G990D00
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
            comments {
                comments: SUM(PBPass.PBPassAmount) on bills dated in the period. Ordered and Passed are different populations — an order placed now may be billed next period — so the two columns are not expected to agree.
            }
        )

        column QUANTITY_ORDERED (
            type: plainText
            heading {
                heading: Quantity Ordered (per unit)
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Listagg of quantity PER UNIT, largest first. Never a single total — the units are incompatible and adding them would be meaningless.
            }
        )

        column RECEIVED (
            type: plainText
            heading {
                heading: Received
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Shown only where the supplier's orders use ONE unit. Multi-unit suppliers render "mixed units" rather than a ratio built from incompatible bases.
            }
        )

        column SUPPLIER (
            type: link
            heading {
                heading: Supplier
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 669
                    items: {
                        P669_SUPPLIER: #PARTYCODE#
                        P669_FROMDATE: &P668_FROMDATE.
                        P669_TODATE: &P668_TODATE.
                        P669_COMPANY: &P668_COMPANY.
                        P669_LOCATION: &P668_LOCATION.
                        P669_PANEL: &P668_PANEL.
                    }
                    clearCache: 669
                    debug: NO
                }
                linkText: #SUPPLIER#
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            comments {
                comments: Drills to Supplier 360 with the full filter context.
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ORDERED (
                sequence: 5
            )

            displayColumn OUTSTANDING (
                sequence: 8
            )

