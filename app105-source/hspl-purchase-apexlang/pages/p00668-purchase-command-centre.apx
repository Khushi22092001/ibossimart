    region reg-e-paid (
        name: Payment Register
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select v.VoucherNo                     As VOUCHER_NO,
                       v.VoucherDate                   As VOUCHER_DATE,
                       v.Narration                     As NARRATION,
                       Sum(-vd.Amount)                 As AMOUNT
                  From Voucher v
                  Join VoucherDetail vd On vd.TNo = v.TNo
                 Where v.DocTypeCode = 'PAYMENT'
                   And vd.Amount < 0
                   And v.VoucherDate Between to_date(:P668_FROMDATE,'DD-MM-RRRR') And to_date(:P668_TODATE,'DD-MM-RRRR')
                   And ((Select GetUserPanelAB_apex() From dual) Is Null Or v.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL    Is Null Or v.Panel        = :P668_PANEL)
                   And (:P668_COMPANY  Is Null Or v.CompanyCode  = :P668_COMPANY)
                 Group By v.VoucherNo, v.VoucherDate, v.Narration
                 Order By v.VoucherDate Desc, v.VoucherNo Desc
                ```
            pageItemsToSubmit: [
