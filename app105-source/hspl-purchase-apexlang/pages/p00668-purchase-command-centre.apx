                type: redirectUrl
                targetUrl: javascript:apex.item('P668_PIPE_FOCUS').setValue('&BUCKET_KEY.');apex.region('p668PipeOrders').refresh();document.getElementById('p668PipeOrders').scrollIntoView({behavior:'smooth',block:'start'});
