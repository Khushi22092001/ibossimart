    region category-spend (
        name: Purchase Value by Item Category
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                /* Item Category is an HSPL master dimension. Billed purchase value by category
                   for the selected period/scope. */
                Select CATEGORY, CATCODE, VALUE_LAC
                  From (Select Case When i.ItemCategoryCode Is Null Then 'Uncategorised'
                                    Else nvl(GetItemCategoryName(i.ItemCategoryCode), i.ItemCategoryCode) End CATEGORY,
                               nvl(i.ItemCategoryCode,'') CATCODE,
                               Round(Sum(d.Amount)/100000,2) VALUE_LAC
                          From PurchaseBill h
                          Join PurchaseBillDetail d On d.TNo = h.TNo
                          Left Join Item i On i.ItemCode = d.ItemCode
                         Where h.PurchaseBillDate Between to_date(:P668_FROMDATE,'DD-MM-RRRR') And to_date(:P668_TODATE,'DD-MM-RRRR')
                           And ((Select GetUserPanelAB_apex() From dual) Is Null Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                           And (:P668_PANEL    Is Null Or h.Panel        = :P668_PANEL)
                           And (:P668_COMPANY  Is Null Or h.CompanyCode  = :P668_COMPANY)
                           And (:P668_LOCATION Is Null Or h.LocationCode = :P668_LOCATION)
                           And (:P668_SUPPLIER Is Null Or h.PartyCode    = :P668_SUPPLIER)
                         Group By i.ItemCategoryCode
                        Having Sum(d.Amount) > 0)
                 Order By VALUE_LAC Desc
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
                P668_SUPPLIER
            ]
        }
        layout {
            sequence: 54
            slot: body
            column: 1
            columnSpan: 6
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: ds-dash-panel
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 320
        }
        value {
            format: decimal
            decimalPlaces: 2
            formatScaling: none
        }
        legend {
            position: bottom
        }
        messages {
            whenNoDataFound: No billed purchase value by category in this scope.
        }

        series cat (
            name: Purchase (₹ Lac)
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: CATEGORY
                value: VALUE_LAC
            }
        )

    )

    region command-header (
        name: Purchase Command Centre
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                Select
                                  '<div class="ds-hero">'
                                  || '<div class="ds-hero-row">'
                                  || '<span class="ds-hero-icon"><span class="fa fa-shopping-cart"></span></span>'
                                  || '<span class="ds-hero-text">'
                                  || '<span class="ds-hero-eyebrow">Procurement Intelligence</span>'
                                  || '<span class="ds-hero-title">Purchase Command Centre</span>'
                                  || '<span class="ds-hero-sub">Gain complete visibility across the '
                                  || 'purchase-to-pay chain. Track, analyse and act on procurement metrics '
                                  || 'in real time.</span>'
                                  || '<a class="ds-hero-cta" href="' || apex_page.get_url(
                                       p_page        => 683,
                                       p_clear_cache => '683',
                                       p_items       => 'P683_FROMDATE,P683_TODATE,P683_COMPANY,P683_LOCATION,P683_PANEL,P683_SUPPLIER,P683_ITEM,P683_ITEMGROUP',
                                       p_values      =>    :P668_FROMDATE ||','|| :P668_TODATE
                                                    ||','|| :P668_COMPANY  ||','|| :P668_LOCATION
                                                    ||','|| :P668_PANEL    ||','|| :P668_SUPPLIER
                                                    ||','|| :P668_ITEM     ||','|| :P668_ITEMGROUP)
                                     || '">Purchase Analytics <span class="fa fa-arrow-right"></span></a>'
                                  || '</span></div>'
                                  || '<div class="ds-hero-art"></div>'
                                  || '<div class="ds-hero-chips">'
                                  || '<span class="ds-chip"><span class="fa fa-calendar ds-chip-ic"></span>'
                                     || '<span class="ds-chip-k">Period</span><b>'
                                     || apex_escape.html(:P668_FROMDATE) || ' &ndash; '
                                     || apex_escape.html(:P668_TODATE) || '</b>'
                                     || '<i class="ds-chip-sub">'
                                     || to_char(to_date(:P668_TODATE,'DD-MM-RRRR')
                                             - to_date(:P668_FROMDATE,'DD-MM-RRRR') + 1) || ' days</i></span>'
                                  || '<span class="ds-chip"><span class="fa fa-building-o ds-chip-ic"></span>'
                                     || '<span class="ds-chip-k">Company</span><b>'
                                     || apex_escape.html(nvl(GetCompanyName(:P668_COMPANY),'All companies'))
                                     || '</b></span>'
                                  || '<span class="ds-chip"><span class="fa fa-map-marker ds-chip-ic"></span>'
                                     || '<span class="ds-chip-k">Location</span><b>'
                                     || apex_escape.html(nvl(GetLocationName(:P668_LOCATION),'All locations'))
                                     || '</b></span>'
                                  || Case
                                       When (Select GetUserPanelAB_apex() From dual) Is Not Null
                                       Then '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                                            || '<span class="ds-chip-k">Panel</span><b>'
                                            || apex_escape.html((Select GetUserPanelAB_apex() From dual))
                                            || ' (enforced)</b></span>'
                                       Else '<span class="ds-chip"><span class="fa fa-th-large ds-chip-ic"></span>'
                                            || '<span class="ds-chip-k">Panel</span><b>'
                                            || apex_escape.html(nvl(:P668_PANEL,'A + B')) || '</b></span>'
                                     End
                                  || Case When :P668_SUPPLIER Is Not Null
                                          Then '<span class="ds-chip"><span class="fa fa-user-o ds-chip-ic"></span>'
                                               || '<span class="ds-chip-k">Supplier</span><b>'
                                               || apex_escape.html(GetPartyName(:P668_SUPPLIER)) || '</b></span>'
                                          Else '' End
                                  || Case When :P668_ITEMGROUP Is Not Null
                                          Then '<span class="ds-chip"><span class="fa fa-sitemap ds-chip-ic"></span>'
                                               || '<span class="ds-chip-k">Item group</span><b>'
                                               || apex_escape.html(:P668_ITEMGROUP) || '</b></span>'
                                          Else '' End
                                  || Case When :P668_ITEM Is Not Null
                                          Then '<span class="ds-chip"><span class="fa fa-cube ds-chip-ic"></span>'
                                               || '<span class="ds-chip-k">Item</span><b>'
                                               || apex_escape.html(:P668_ITEM) || '</b></span>'
                                          Else '' End
                                  || '<span class="ds-chip ds-chip--live"><span class="fa fa-calendar-check-o ds-chip-ic"></span>'
                                     || '<span class="ds-chip-k">Bills as of</span><b>'
                                     || apex_escape.html(nvl(to_char(
                                          (Select Max(h.PurchaseBillDate) From PurchaseBill h
                                            Where ((Select GetUserPanelAB_apex() From dual) Is Null
                                                   Or h.Panel = (Select GetUserPanelAB_apex() From dual))),
                                          'DD-Mon-RRRR'),'no bills visible'))
                                     || '</b></span>'
                                  || '</div></div>' As HEAD
                                From dual
                                
                ```
            pageItemsToSubmit: [
