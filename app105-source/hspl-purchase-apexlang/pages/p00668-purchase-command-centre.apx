    region exec-detail (
        name: Documents Behind the Execution Stage
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With Win As (
                       Select to_date(:P668_FROMDATE,'DD-MM-RRRR') F,
                              to_date(:P668_TODATE,'DD-MM-RRRR')   T
                         From dual)
                -- Each branch repeats its stage's predicates from the Execution Pipeline
                -- VERBATIM, including the panel function and the location filter.
                Select o.PurchaseOrderNo                              As DOCUMENT_NO,
                       o.PurchaseOrderDate                            As DOCUMENT_DATE,
                       'Purchase Order'                               As STAGE,
                       GetLocationName(o.LocationCode)                As LOCATION,
                       GetPartyName(o.PartyCode)                      As PARTY,
                       'Delivery ' || to_char(o.DeliveryDate,'DD-Mon-RRRR') As DETAIL,
                       o.PurchaseOrderAmount As VALUE_RS
                  From PurchaseOrder o Cross Join Win w
                 Where :P668_EXEC_FOCUS = '10'
                   And o.PurchaseOrderDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or o.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or o.CompanyCode = :P668_COMPANY)
                   And (:P668_LOCATION Is Null Or o.LocationCode = :P668_LOCATION)
                   And (:P668_SUPPLIER Is Null Or o.PartyCode = :P668_SUPPLIER)
                Union All
                Select x.MaterialInNo                                 As DOCUMENT_NO,
                       x.MaterialInDate                               As DOCUMENT_DATE,
                       'Material In / Gate Entry'                     As STAGE,
                       GetLocationName(x.LocationCode)                As LOCATION,
                       GetPartyName(x.PartyCode)                      As PARTY,
                       'Vehicle ' || x.VehicleNo                      As DETAIL,
                       x.RefDocAmount As VALUE_RS
                  From MaterialIn x Cross Join Win w
                 Where :P668_EXEC_FOCUS = '20'
                   And x.MaterialInDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                   And (:P668_LOCATION Is Null Or x.LocationCode = :P668_LOCATION)
                Union All
                Select x.GrnNo                                        As DOCUMENT_NO,
                       x.GrnDate                                      As DOCUMENT_DATE,
                       'GRN (Goods Received)'                         As STAGE,
                       GetLocationName(x.LocationCode)                As LOCATION,
                       GetPartyName(x.PartyCode)                      As PARTY,
                       'Against order ' || to_char(x.PurchaseOrderTNo) As DETAIL,
                       Cast(Null As Number) As VALUE_RS
                  From Grn x Cross Join Win w
                 Where :P668_EXEC_FOCUS = '30'
                   And x.GrnDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or x.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or x.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or x.CompanyCode = :P668_COMPANY)
                   And (:P668_LOCATION Is Null Or x.LocationCode = :P668_LOCATION)
                Union All
                Select h.PurchaseBillNo                               As DOCUMENT_NO,
                       h.PurchaseBillDate                             As DOCUMENT_DATE,
                       'Purchase Bill'                                As STAGE,
                       GetLocationName(h.LocationCode)                As LOCATION,
                       GetPartyName(h.PartyCode)                      As PARTY,
                       'Supplier bill ' || h.PartyBillNo              As DETAIL,
                       h.PurchaseBillAmount As VALUE_RS
                  From PurchaseBill h Cross Join Win w
                 Where :P668_EXEC_FOCUS = '40'
                   And h.PurchaseBillDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                   And (:P668_LOCATION Is Null Or h.LocationCode = :P668_LOCATION)
                   And (:P668_SUPPLIER Is Null Or h.PartyCode = :P668_SUPPLIER)
                Union All
                Select p.PBPassNo                                     As DOCUMENT_NO,
                       p.PBPassDate                                   As DOCUMENT_DATE,
                       'Bill Pass'                                    As STAGE,
                       GetLocationName(h.LocationCode)                As LOCATION,
                       GetPartyName(h.PartyCode)                      As PARTY,
                       'Against bill ' || h.PurchaseBillNo            As DETAIL,
                       h.PurchaseBillAmount As VALUE_RS
                  From PBPass p Join PurchaseBill h On h.TNo = p.PurchaseBillTNo Cross Join Win w
                 Where :P668_EXEC_FOCUS = '50'
                   And h.PurchaseBillDate Between w.F And w.T
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or h.CompanyCode = :P668_COMPANY)
                   And (:P668_LOCATION Is Null Or h.LocationCode = :P668_LOCATION)
                   And (:P668_SUPPLIER Is Null Or h.PartyCode = :P668_SUPPLIER)
                Union All
                Select v.VoucherNo                                    As DOCUMENT_NO,
                       v.VoucherDate                                  As DOCUMENT_DATE,
                       'Paid'                                         As STAGE,
                       GetLocationName(v.LocationCode)                As LOCATION,
                       Cast(Null As Varchar2(240))                    As PARTY,
                       'Payment voucher'                              As DETAIL,
                       (Select Sum(Abs(vd.Amount)) From VoucherDetail vd Where vd.TNo = v.TNo And vd.Amount < 0) As VALUE_RS
                  From Voucher v Cross Join Win w
                 Where :P668_EXEC_FOCUS = '60'
                   And v.VoucherDate Between w.F And w.T
                   And v.DocTypeCode = 'PAYMENT'
                   And Exists (Select 1 From VoucherDetail vd
                                Where vd.TNo = v.TNo And vd.Amount < 0)
                   And ((Select GetUserPanelAB_apex() From dual) Is Null
                        Or v.Panel = (Select GetUserPanelAB_apex() From dual))
                   And (:P668_PANEL Is Null Or v.Panel = :P668_PANEL)
                   And (:P668_COMPANY Is Null Or v.CompanyCode = :P668_COMPANY)
                Order By 2 Desc, 1
                ```
            pageItemsToSubmit: [
                P668_EXEC_FOCUS
                P668_FROMDATE
                P668_TODATE
                P668_COMPANY
                P668_LOCATION
                P668_PANEL
                P668_SUPPLIER
            ]
        }
        layout {
            sequence: 44
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
            cssClasses: [
                ds-register
                ds-exc-detailwrap
            ]
