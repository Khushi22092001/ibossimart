    region supplier-table (
        name: Supplier Performance
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                With ItemTree As (
                       Select ItemCode From Item
                        Where :P668_ITEMGROUP Is Not Null
                        Start With ItemCode = :P668_ITEMGROUP
                      Connect By Prior ItemCode = ParentCode
                       Union All
                       Select ItemCode From Item Where :P668_ITEMGROUP Is Null),
                Val As (
                  Select h.PartyCode,
                         Sum(d.Amount) Val,
                         Count(Distinct h.TNo) Bills,
                         Count(Distinct d.ItemCode) Items,
                         Max(h.PurchaseBillDate) LastBill
                    From PurchaseBill h
                    Join PurchaseBillDetail d On d.TNo = h.TNo
                   Where h.PurchaseBillDate
                         Between to_date(:P668_FROMDATE,'DD-MM-RRRR')
                             And to_date(:P668_TODATE,'DD-MM-RRRR')
                     And ((Select GetUserPanelAB_apex() From dual) Is Null
                          Or h.Panel = (Select GetUserPanelAB_apex() From dual))
                     And (:P668_PANEL Is Null Or h.Panel = :P668_PANEL)
                     And (:P668_COMPANY  Is Null Or h.CompanyCode  = :P668_COMPANY)
                     And (:P668_LOCATION Is Null Or h.LocationCode = :P668_LOCATION)
                     And (:P668_SUPPLIER Is Null Or h.PartyCode    = :P668_SUPPLIER)
                     And d.ItemCode In (Select ItemCode From ItemTree)
                   Group By h.PartyCode),
                -- DELIVERY, at ORDER grain. GrnDetail carries no order reference in this
                -- application, so a receipt is matched to its order on the GRN HEADER
                -- (Grn.PurchaseOrderTNo) and the earliest receipt per order is compared with
                -- the promised date. Orders with no delivery date or no receipt are EXCLUDED
                -- rather than counted as late — counting them would flatter the figure.
                Deliv As (
                  Select PartyCode,
                         Count(*) Legs,
                         Sum(Case When DeliveryDate >= FirstGrn Then 1 Else 0 End) OnTime,
                         Avg(DeliveryDate - FirstGrn) AvgDays
                    From (
                      Select o.PartyCode, o.DeliveryDate,
                             (Select Min(g.GrnDate) From Grn g
                               Where g.PurchaseOrderTNo = o.TNo) FirstGrn
                        From PurchaseOrder o
                       Where o.PurchaseOrderDate
                             Between to_date(:P668_FROMDATE,'DD-MM-RRRR')
                                 And to_date(:P668_TODATE,'DD-MM-RRRR')
                         And o.DeliveryDate Is Not Null
                         And ((Select GetUserPanelAB_apex() From dual) Is Null
                              Or o.Panel = (Select GetUserPanelAB_apex() From dual))
                         And (:P668_PANEL Is Null Or o.Panel = :P668_PANEL)
                         And (:P668_COMPANY Is Null Or o.CompanyCode = :P668_COMPANY))
                   Where FirstGrn Is Not Null
                   Group By PartyCode)
                Select
                  v.PartyCode As PARTYCODE,
                  GetPartyName(v.PartyCode) As SUPPLIER,
                  v.Val As PURCHASE_VALUE,
                  v.Bills As BILLS,
                  v.Items As ITEMS,
                  dl.Legs As ORDER_LEGS,
                  Case When dl.Legs > 0
                       Then Round(100 * dl.OnTime / dl.Legs, 1) End As ONTIME_PCT,
                  Round(dl.AvgDays, 1) As AVG_DELIVERY_DAYS,
                  v.LastBill As LAST_BILL,
                  Round(100 * v.Val / Sum(v.Val) Over (), 2) As SHARE_PCT,
                  Round(100 * Sum(v.Val) Over (Order By v.Val Desc, v.PartyCode
                                               Rows Between Unbounded Preceding
                                                        And Current Row)
                            / Sum(v.Val) Over (), 2) As CUMULATIVE_PCT,
                  Case
                    When 100 * Sum(v.Val) Over (Order By v.Val Desc, v.PartyCode
                                                Rows Between Unbounded Preceding
                                                         And Current Row)
                             / Sum(v.Val) Over () <= 80 Then 'A'
                    When 100 * Sum(v.Val) Over (Order By v.Val Desc, v.PartyCode
                                                Rows Between Unbounded Preceding
                                                         And Current Row)
                             / Sum(v.Val) Over () <= 95 Then 'B'
                    Else 'C'
                  End As ABC_CLASS
                From Val v
                Left Join Deliv dl On dl.PartyCode = v.PartyCode
                Order By v.Val Desc
                ```
            pageItemsToSubmit: [
                P668_FROMDATE
