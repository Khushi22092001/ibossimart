lov item-list (
    name: "ITEM LIST "
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select
                  a.ItemCode,
                  a.ItemName,
                  GetItemName(a.ParentCode)GroupName,
                  a.ParentCode,
                  a.MeasuringUnitCode1 PUOM,
                  a.MeasuringUnitCode2 SUOM
            From  Item a
            --Where exists (Select 1 From SalesorderDetail b Where a.ItemCode = b.ItemCode)
            ```
    }
    columnMapping {
        return: ITEMCODE
        display: ITEMNAME
        defaultSort: ITEMNAME
    }
)

lov login-remember-username (
    name: LOGIN_REMEMBER_USERNAME
    source {
        location: staticValues
    }

    entry remember-username (
        sequence: 10
        display: Remember username
        return: Y
    )

)

lov month (
    name: MONTH
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select Distinct
                  a.Fin_Month_Name,
                  a.Fin_Month,
                  To_char(a.Fin_date,'MON-YYYY')as MONYYYY,
                  To_char(a.Fin_date,'YYYYMM')as YYYYMM
            From  BI_DateTime a
            ```
    }
    columnMapping {
        return: YYYYMM
        display: MONYYYY
        defaultSort: MONYYYY
    }
)

lov party-list (
    name: PARTY LIST
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select
                  a.PartyName,
                  a.PartyCode,
                  a.OfficeCityCode,
                  GetCityName(a.OfficeCityCode)CityName,
                  a.OfficeStateCode,
                  GetStateName(a.OfficeStateCode)StateName
            From  Party a
            --Where exists (Select 1 From SalesOrder b Where a.partyCode = b.PartyCode)
            ```
    }
    columnMapping {
        return: PARTYCODE
        display: PARTYNAME
        defaultSort: PARTYNAME
    }
)

lov year (
    name: YEAR
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            Select Distinct
                 To_Char(a.Fin_date,'YYYY') YYYY,
                 a.Fin_Year
            From BI_DateTime a  
            ```
    }
    columnMapping {
        return: YYYY
        display: FIN_YEAR
        defaultSort: FIN_YEAR
    }
)

